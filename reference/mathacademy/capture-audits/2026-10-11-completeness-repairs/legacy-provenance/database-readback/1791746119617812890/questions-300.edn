b/id #edb/ref 17592186184232 :knowledge-point/id #uuid "c872e855-895e-5369-8a79-cbdf21133548" :knowledge-point/title "Solving a Quadratic Equation Given a Corresponding Perfect Square"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5c9dab48-f4ec-50d5-997f-66003dcb0d90" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=-\\frac{1}{2},\\,\\frac{3}{2}" :db/id #edb/ref 17592186388843} {:answer/id #uuid "78463560-21e0-5b25-866c-e90cd7340bbc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=-3\\pm \\frac{1}{\\sqrt{2}}" :db/id #edb/ref 17592186388844} {:answer/id #uuid "b9db4f34-08d3-52b7-b130-1953818d1cdb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=-\\frac{11}{2},\\,\\frac{3}{2}" :db/id #edb/ref 17592186388845} {:answer/id #uuid "ef8898ba-df5f-5bff-a12b-8e45e358e308" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=-\\frac{11}{2},\\,-\\frac{1}{2}" :db/id #edb/ref 17592186388846} {:answer/id #uuid "cdcc5cac-e58c-525f-92e0-44013ae6b5ae" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=-3\\pm \\frac{5}{\\sqrt{2}}" :db/id #edb/ref 17592186388847}] :answer-field/correct {:answer/id #uuid "ef8898ba-df5f-5bff-a12b-8e45e358e308" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=-\\frac{11}{2},\\,-\\frac{1}{2}" :db/id #edb/ref 17592186388846} :answer-field/id #uuid "32deee12-64c9-53b5-a191-c9595d854af8" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186388842}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "6cd3a3fd-0ec4-5982-bdba-cd236ee44004" :question/math-academy-id "q-141811" :question/problem "Solve the equation $4{x}^{2}+24x=-11.$ \n\n*Hint: Use the fact that ${x}^{2}+6x+9$ is a perfect square.*" :question/worked-solution "Using the hint, we have\n\n$$\n{x}^{2}+6x+9=(x+3)^{2}.\n$$\n\nFirst, we complete the square on the left-hand side:\n\n$$\n\\begin{aligned}4{x}^{2}+24x & =-11 \\\\ 4({x}^{2}+6x) & =-11 \\\\ 4({x}^{2}+2\\cdot 3x) & =-11 \\\\ 4({x}^{2}+2\\cdot 3x+{3}^{2}-{3}^{2}) & =-11 \\\\ 4[(x+3)^{2}-{3}^{2}] & =-11 \\\\ 4[(x+3)^{2}-9] & =-11 \\\\ 4(x+3)^{2}-36 & =-11\\end{aligned}\n$$\n\nIsolating the perfect square by adding $36$ to both sides and then dividing by $4,$ we get\n\n$$\n\\begin{aligned}4(x+3)^{2}-36 & =-11 \\\\ 4(x+3)^{2}-36+36 & =-11+36 \\\\ 4(x+3)^{2} & =25 \\\\ (x+3)^{2} & =\\frac{25}{4}.\\end{aligned}\n$$\n\nWe now solve the equation using the square root method:\n\n$$\n\\begin{aligned}(x+3)^{2} & =\\frac{25}{4} \\\\ \\sqrt{(x+3)^{2}} & =\\sqrt{\\frac{25}{4}} \\\\ |x+3| & =\\frac{5}{2} \\\\ x+3 & =\\pm \\frac{5}{2} \\\\ x & =-3\\pm \\frac{5}{2} \\\\ x & =-\\frac{11}{2},\\,-\\frac{1}{2}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186272309 :knowledge-point/_questions [{:db/id #edb/ref 17592186068827 :knowledge-point/id #uuid "c3e24f9c-d383-5b77-a22a-8e142a072f0a" :knowledge-point/title "Solving a Quadratic Equation Given a Corresponding Perfect Square"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "33162c16-a26a-585b-b93a-caff202d8543" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "80" :db/id #edb/ref 17592186269736} {:answer/id #uuid "472c723c-83ab-5626-ad0b-8949bf5249de" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "90" :db/id #edb/ref 17592186269915} {:answer/id #uuid "929563b1-603a-55ce-b34f-10a3c1c67754" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "104" :db/id #edb/ref 17592186270550} {:answer/id #uuid "dbafdf59-1e66-5dce-9f48-65bc473487a2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "100" :db/id #edb/ref 17592186271191} {:answer/id #uuid "f1de299d-a3c5-5ebc-80da-bb0051f2d8ec" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "109" :db/id #edb/ref 17592186271392}] :answer-field/correct {:answer/id #uuid "929563b1-603a-55ce-b34f-10a3c1c67754" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "104" :db/id #edb/ref 17592186270550} :answer-field/id #uuid "16c6ad9b-646e-5a06-a5b2-bcae2f52ebb1" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186271547}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "f0de10d9-8ebd-58e0-b040-9c2f5e59c9c7" :question/math-academy-id "q-141812" :question/problem "Let ${x}_{1}$ and ${x}_{2}$ be the solutions of the equation ${x}^{2}-8x=20.$ Find the value ${x}_{1}^{2}+{x}_{2}^{2}.$ \n\n*Hint: Use the fact that ${x}^{2}-8x+16$ is a perfect square.*" :question/worked-solution "Using the hint, we have\n\n$$\n{x}^{2}-8x+16=(x-4{)}^{2}.\n$$\n\nFirst, we complete the square on the left-hand side:\n\n$$\n\\begin{aligned}{x}^{2}-8x & =20 \\\\ {x}^{2}-2\\cdot 4\\cdot x & =20 \\\\ {x}^{2}-2\\cdot 4\\cdot x+{4}^{2}-{4}^{2} & =20 \\\\ (x-4{)}^{2}-16 & =20\\end{aligned}\n$$\n\nNext, we isolate the perfect square by adding $16$ to both sides:\n\n$$\n\\begin{aligned}(x-4{)}^{2}-16+16 & =20+16 \\\\ (x-4{)}^{2} & =36\\end{aligned}\n$$\n\nWe now solve the equation using the square root method:\n\n$$\n\\begin{aligned}(x-4{)}^{2} & =36 \\\\ \\sqrt{(x-4{)}^{2}} & =\\sqrt{36} \\\\ |x-4| & =6 \\\\ x-4 & =\\pm 6 \\\\ x & =4\\pm 6\\end{aligned}\n$$\n\nFinally, we simplify the two solutions:\n\n$$\n\\begin{aligned}{x}_{1} & =4-6=-2 \\\\ {x}_{2} & =4+6=10\\end{aligned}\n$$\n\nTherefore, \n\n$$\n{x}_{1}^{2}+{x}_{2}^{2}=(-2{)}^{2}+{10}^{2}=104.\n$$"}] [{:db/id #edb/ref 17592186272310 :knowledge-point/_questions [{:db/id #edb/ref 17592186184232 :knowledge-point/id #uuid "c872e855-895e-5369-8a79-cbdf21133548" :knowledge-point/title "Solving a Quadratic Equation Given a Corresponding Perfect Square"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "241b1404-c2aa-575d-8065-ec106981f5a3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=-4\\pm \\frac{\\sqrt{2}}{5}" :db/id #edb/ref 17592186269585} {:answer/id #uuid "7919a728-b543-536d-8054-0a184713c2b0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=2\\pm \\frac{\\sqrt{5}}{2}" :db/id #edb/ref 17592186270341} {:answer/id #uuid "c82102a0-f740-5514-9212-0b3cd8c1d0c6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=4\\pm \\frac{2}{\\sqrt{5}}" :db/id #edb/ref 17592186271031} {:answer/id #uuid "e3105ac8-37d5-5739-abc9-4ef7c2fc18d5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=4\\pm \\frac{5}{\\sqrt{2}}" :db/id #edb/ref 17592186271267} {:answer/id #uuid "f25bf37e-9c95-5124-b37f-32e6744d69d1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=2\\pm \\frac{2}{\\sqrt{5}}" :db/id #edb/ref 17592186271399}] :answer-field/correct {:answer/id #uuid "c82102a0-f740-5514-9212-0b3cd8c1d0c6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=4\\pm \\frac{2}{\\sqrt{5}}" :db/id #edb/ref 17592186271031} :answer-field/id #uuid "fbe18474-5ded-5269-8f07-0ba5488b85e6" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186271944}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "7c3581b3-19ec-58f3-879c-94addceac5e6" :question/math-academy-id "q-141817" :question/problem "Solve the equation $5{y}^{2}-40y=-76.$ \n\n*Hint: Use the fact that ${y}^{2}-8y+16$ is a perfect square.*" :question/worked-solution "Using the hint, we have\n\n$$\n{y}^{2}-8y+16=(y-4)^{2}.\n$$\n\nFirst, we complete the square on the left-hand side:\n\n$$\n\\begin{aligned}5{y}^{2}-40y & =-76 \\\\ 5({y}^{2}-8y) & =-76 \\\\ 5({y}^{2}-2\\cdot 4y) & =-76 \\\\ 5({y}^{2}-2\\cdot 4y+{4}^{2}-{4}^{2}) & =-76 \\\\ 5[(y-4)^{2}-{4}^{2}] & =-76 \\\\ 5[(y-4)^{2}-16] & =-76 \\\\ 5(y-4)^{2}-80 & =-76\\end{aligned}\n$$\n\nIsolating the perfect square by adding $80$ to both sides and then dividing by $5,$ we get\n\n$$\n\\begin{aligned}5(y-4)^{2}-80 & =-76 \\\\ 5(y-4)^{2}-80+80 & =-76+80 \\\\ 5(y-4)^{2} & =4 \\\\ (y-4)^{2} & =\\frac{4}{5}.\\end{aligned}\n$$\n\nWe now solve the equation using the square root method:\n\n$$\n\\begin{aligned}(y-4)^{2} & =\\frac{4}{5} \\\\ \\sqrt{(y-4)^{2}} & =\\sqrt{\\frac{4}{5}} \\\\ |y-4| & =\\frac{2}{\\sqrt{5}} \\\\ y-4 & =\\pm \\frac{2}{\\sqrt{5}} \\\\ y & =4\\pm \\frac{2}{\\sqrt{5}}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186272314 :knowledge-point/_questions [{:db/id #edb/ref 17592186096707 :knowledge-point/id #uuid "ddc6c4b1-b4c4-52f8-9f25-feda3130e358" :knowledge-point/title "Calculating the Intercepts of a Parabola Given Its Equation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "05c261f4-b523-5e38-b911-79bebe41075e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(21,0)" :db/id #edb/ref 17592186269321} {:answer/id #uuid "b0e7353a-2dd4-5608-ac70-fe6d8e0291e6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(0,21)" :db/id #edb/ref 17592186270848} {:answer/id #uuid "bbe132bb-0af0-51c8-afe2-8c3302082c29" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-21,0)" :db/id #edb/ref 17592186270925} {:answer/id #uuid "bc901ce9-1a00-525b-a2cd-700e1bd17ebd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-12,0)" :db/id #edb/ref 17592186270928} {:answer/id #uuid "c301dd7e-cbc1-5a8b-80c7-f2bfe83da7ba" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(12,0)" :db/id #edb/ref 17592186270994}] :answer-field/correct {:answer/id #uuid "05c261f4-b523-5e38-b911-79bebe41075e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(21,0)" :db/id #edb/ref 17592186269321} :answer-field/id #uuid "7e2b396b-77e2-5134-94df-60067b3ce9c0" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186271732}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "08773f73-4575-52a7-9948-7d0d1e95d791" :question/math-academy-id "q-14185" :question/problem "Find the point of intersection of the parabola ${y}^{2}-x+10y+21=0$ with the $x$-axis." :question/worked-solution "When the parabola intersects the $x$-axis, we must have $y=0.$ So, we set $y=0$ and solve the resulting equation for $x:$\n\n$$\n\\begin{aligned}{y}^{2}-x+10y+21 & =0 \\\\ (0)^{2}-x+10(0)+21 & =0 \\\\ -x+21 & =0 \\\\ x & =21\\end{aligned}\n$$\n\nTherefore, the parabola intersects the $x$-axis at $(21,0).$"}] [{:db/id #edb/ref 17592186398466 :knowledge-point/_questions [{:db/id #edb/ref 17592186184148 :knowledge-point/id #uuid "dac9c72b-c23f-56fa-b939-6e3b56d3a13b" :knowledge-point/title "Identifying the Horizontal Stretch and Vertical Shift of a Transformed Cotangent Curve"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "accd213e-a18c-57f9-a2cf-0e3297615ffe" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186398468} {:answer/id #uuid "bd8269e6-822d-57d9-a7d5-81b77feea90f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186398469} {:answer/id #uuid "b6d90684-6641-5156-b37c-32b02b1bdd9f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186398470} {:answer/id #uuid "21d7fa3c-5da8-50fa-8d80-231c8289856a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186398471} {:answer/id #uuid "70cad25b-cabf-5869-8148-7ca6a521ce0d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186398472}] :answer-field/correct {:answer/id #uuid "bd8269e6-822d-57d9-a7d5-81b77feea90f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186398469} :answer-field/id #uuid "412e6109-4d77-5424-95b6-1257add5ac9c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186398467}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "b85652aa-105e-56e5-bee4-742b27b9d838" :question/math-academy-id "q-141999" :question/problem "![](images/8b/8b237f9e857b1ed87de447aa79c14d359429e71d8afe7ab8eab201eba7ffb6af.png)\n\nThe graph above shows the function $y=\\operatorname{cot}⁡(Bx)+D,$ where $B$ and $D$ are constants. What is  $B+2D?$" :question/worked-solution "The period $T$ of the function is $\\frac{\\pi }{2}.$\n\nThe formula for the period $T$ of the function $y=A\\operatorname{cot}⁡(Bx+C)+D$ is given by \n\n$$\nT=\\frac{\\pi }{B}.\n$$\n\nApplying the formula of the period, we get\n\n$$\n\\frac{\\pi }{2}=\\frac{\\pi }{B}\\,⟹\\,B=\\frac{\\pi }{(\\frac{\\pi }{2})}=2.\n$$\n\nThe parameter $D$ represents the vertical shift of the cotangent function. We see that the function has been translated by $1$ unit up. Therefore, $D=1.$\n\nTherefore, $B+2D=2+2\\cdot (1)=2+2=4.$  \n\nFinally, the equation of the curve is\n\n$$\ny=\\operatorname{cot}⁡(2x)+1.\n$$"}] [{:db/id #edb/ref 17592186272321 :knowledge-point/_questions [{:db/id #edb/ref 17592186068827 :knowledge-point/id #uuid "c3e24f9c-d383-5b77-a22a-8e142a072f0a" :knowledge-point/title "Solving a Quadratic Equation Given a Corresponding Perfect Square"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "08658d01-89d0-5f4d-8f01-ca95f49a8f8e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "68" :db/id #edb/ref 17592186269345} {:answer/id #uuid "91635a34-3072-5810-bbe9-632fc13648c7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "58" :db/id #edb/ref 17592186270534} {:answer/id #uuid "b63daf1b-11dc-55f7-bcdf-962180261257" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "52" :db/id #edb/ref 17592186270887} {:answer/id #uuid "c16cb9a6-c3c8-5125-ae28-f529c2244338" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "40" :db/id #edb/ref 17592186270983} {:answer/id #uuid "f5121dc9-a221-5173-bccc-27c79eacbf3a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "50" :db/id #edb/ref 17592186271416}] :answer-field/correct {:answer/id #uuid "91635a34-3072-5810-bbe9-632fc13648c7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "58" :db/id #edb/ref 17592186270534} :answer-field/id #uuid "3f3ef694-6ed8-54b6-8d68-ea9692dda819" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186271625}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "36afe386-dcce-5814-bb16-64bd8f39ae6b" :question/math-academy-id "q-142015" :question/problem "Let ${x}_{1}$ and ${x}_{2}$ be the solutions of the equation ${x}^{2}-10x=-21.$ Find the value ${x}_{1}^{2}+{x}_{2}^{2}.$ \n\n*Hint: Use the fact that ${x}^{2}-10x+25$ is a perfect square.*" :question/worked-solution "Using the hint, we have\n\n$$\n{x}^{2}-10x+25=(x-5{)}^{2}.\n$$\n\nFirst, we complete the square on the left-hand side:\n\n$$\n\\begin{aligned}{x}^{2}-10x & =-21 \\\\ {x}^{2}-2\\cdot 5\\cdot x & =-21 \\\\ {x}^{2}-2\\cdot 5\\cdot x+{5}^{2}-{5}^{2} & =-21 \\\\ (x-5{)}^{2}-25 & =-21\\end{aligned}\n$$\n\nNext, we isolate the perfect square by adding $25$ to both sides: \n\n$$\n\\begin{aligned}(x-5{)}^{2}-25+25 & =-21+25 \\\\ (x-5{)}^{2} & =4\\end{aligned}\n$$\n\nWe now solve the equation using the square root method:\n\n$$\n\\begin{aligned}(x-5{)}^{2} & =4 \\\\ \\sqrt{(x-5{)}^{2}} & =\\sqrt{4} \\\\ |x-5| & =2 \\\\ x-5 & =\\pm 2 \\\\ x & =5\\pm 2\\end{aligned}\n$$\n\nFinally, we simplify the two solutions:\n\n$$\n\\begin{aligned}{x}_{1} & =5-2=3 \\\\ {x}_{2} & =5+2=7\\end{aligned}\n$$\n\nTherefore, \n\n$$\n{x}_{1}^{2}+{x}_{2}^{2}={3}^{2}+{7}^{2}=58.\n$$"}] [{:db/id #edb/ref 17592186272331 :knowledge-point/_questions [{:db/id #edb/ref 17592186059821 :knowledge-point/id #uuid "c6a58962-cb06-519a-8c64-0dfa3b9c14d7" :knowledge-point/title "Simplifying Expressions in Degrees Using the Sum and Difference Formulas"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "090d142f-f7f9-5a7b-b72e-52a078df1eaf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{2}(\\sqrt{3}\\operatorname{sin}⁡x+\\operatorname{cos}⁡x)" :db/id #edb/ref 17592186269350} {:answer/id #uuid "1d201ccd-85fb-549a-9e9c-531394fc50aa" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}(\\sqrt{3}\\operatorname{cos}⁡x+\\operatorname{sin}⁡x)" :db/id #edb/ref 17592186269507} {:answer/id #uuid "76ee6731-902a-5dee-b46b-c4380fed56c0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{2}(\\sqrt{3}\\operatorname{cos}⁡x+\\operatorname{sin}⁡x)" :db/id #edb/ref 17592186270319} {:answer/id #uuid "b75c049c-a748-56a4-b205-01a20869b559" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}(\\sqrt{3}\\operatorname{sin}⁡x+\\operatorname{cos}⁡x)" :db/id #edb/ref 17592186270893} {:answer/id #uuid "c3f5c1f2-a0ab-5100-8db9-3071ee8511c6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}(\\sqrt{3}\\operatorname{sin}⁡x-\\operatorname{cos}⁡x)" :db/id #edb/ref 17592186271000}] :answer-field/correct {:answer/id #uuid "76ee6731-902a-5dee-b46b-c4380fed56c0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{2}(\\sqrt{3}\\operatorname{cos}⁡x+\\operatorname{sin}⁡x)" :db/id #edb/ref 17592186270319} :answer-field/id #uuid "a8980b78-b788-5d75-b585-9a0b63595d13" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186271815}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "a1de0aea-4bea-5c0c-94bb-b2903c951763" :question/math-academy-id "q-142142" :question/problem "$\\operatorname{cos}⁡(x-{210}^{∘})=$" :question/worked-solution "First, we recall the difference formula for cosine:\n\n$$\n\\operatorname{cos}⁡(u-v)=\\operatorname{cos}⁡u\\operatorname{cos}⁡v+\\operatorname{sin}⁡u\\operatorname{sin}⁡v\n$$\n\nApplying the difference formula for cosine with $u=x$ and $v={210}^{∘},$ we get\n\n$$\n\\begin{aligned}\\operatorname{cos}⁡(x-{210}^{∘}) & =\\operatorname{cos}⁡x\\operatorname{cos}⁡{210}^{∘}+\\operatorname{sin}⁡x\\operatorname{sin}⁡{210}^{∘} \\\\  & =\\operatorname{cos}⁡x\\cdot (-\\frac{\\sqrt{3}}{2})+\\operatorname{sin}⁡x\\cdot (-\\frac{1}{2}) \\\\  & =-\\frac{1}{2}(\\sqrt{3}\\operatorname{cos}⁡x+\\operatorname{sin}⁡x).\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186272366 :knowledge-point/_questions [{:db/id #edb/ref 17592186110553 :knowledge-point/id #uuid "03491655-9b81-5fc0-bf20-e4f74a9c72ad" :knowledge-point/title "Simplifying an Expression Using the Secant-Tangent Identity: Replacing a Squared Tangent"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4d148a20-6732-5181-8bc1-8502aefbed4c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{sec}^{2}⁡\\theta +2" :db/id #edb/ref 17592186269961} {:answer/id #uuid "8c4f6e86-481a-56ab-9316-dbe29ee9a431" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2{sec}^{3}⁡\\theta " :db/id #edb/ref 17592186270484} {:answer/id #uuid "a1948bb4-ba66-523b-85c0-dc26ae8fc9fc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\operatorname{sec}⁡\\theta +1" :db/id #edb/ref 17592186270703} {:answer/id #uuid "a5d68be5-ce6f-591b-8232-480ac7934752" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{sec}^{2}⁡\\theta " :db/id #edb/ref 17592186270753} {:answer/id #uuid "d82cd36e-e05b-529e-bdd4-c33af7e11490" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{sec}^{3}⁡\\theta " :db/id #edb/ref 17592186271167}] :answer-field/correct {:answer/id #uuid "d82cd36e-e05b-529e-bdd4-c33af7e11490" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{sec}^{3}⁡\\theta " :db/id #edb/ref 17592186271167} :answer-field/id #uuid "13271a5c-0f37-525d-add3-244c00c711ee" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186271541}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "2d7d6733-f73e-5b97-aa59-836de3d2a188" :question/math-academy-id "q-142764" :question/problem "$\\operatorname{sec}⁡\\theta {tan}^{2}⁡\\theta +\\operatorname{sec}⁡\\text{ }\\theta =$" :question/worked-solution "First, let's recall the secant-tangent identity:\n\n$$\n1+{tan}^{2}⁡\\theta ={sec}^{2}⁡\\theta \n$$\n\nWe rewrite the given expression using the secant-tangent identity as follows:\n\n$$\n\\begin{aligned}\\operatorname{sec}⁡\\theta {tan}^{2}⁡\\theta +\\operatorname{sec}⁡\\text{ }\\theta  & =\\operatorname{sec}⁡\\theta \\text{ }\\,({tan}^{2}⁡\\theta +1) \\\\  & =\\operatorname{sec}⁡\\theta \\text{ }\\,({sec}^{2}⁡\\theta ) \\\\  & ={sec}^{3}⁡\\theta \\end{aligned}\n$$\n\nTherefore, we conclude that\n\n$$\n\\operatorname{sec}⁡\\theta {tan}^{2}⁡\\theta +\\operatorname{sec}⁡\\text{ }\\theta ={sec}^{3}⁡\\theta .\n$$"}] [{:db/id #edb/ref 17592186272371 :knowledge-point/_questions [{:db/id #edb/ref 17592186110666 :knowledge-point/id #uuid "7640012b-79f9-5f6b-a26b-a7f4fe8c0e7b" :knowledge-point/title "Simplifying an Expression Using the Secant-Tangent Identity: Replacing a Squared Secant"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0e50294c-f2fb-5493-b386-188a5e5c6454" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2+\\operatorname{tan}⁡x" :db/id #edb/ref 17592186269396} {:answer/id #uuid "10c68d72-483e-5e6f-bc5d-9a17b61d2b2c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2{tan}^{2}⁡x" :db/id #edb/ref 17592186269418} {:answer/id #uuid "8e8a5799-d4bb-5fa0-acc3-0994f9a11a15" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2+{tan}^{2}⁡x" :db/id #edb/ref 17592186270507} {:answer/id #uuid "c15bb409-c8b2-5599-90d8-2cde8b83b9b0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2-\\operatorname{tan}⁡x" :db/id #edb/ref 17592186270981} {:answer/id #uuid "d3274d62-cd90-5dd9-a3e7-e8835fdd2082" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2{tan}^{2}⁡x+1" :db/id #edb/ref 17592186271128}] :answer-field/correct {:answer/id #uuid "8e8a5799-d4bb-5fa0-acc3-0994f9a11a15" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2+{tan}^{2}⁡x" :db/id #edb/ref 17592186270507} :answer-field/id #uuid "b35fc1c6-91c7-5f33-8f19-88ce55beb8ae" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186271838}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "c559d29c-6df4-58e1-9d14-484afb67e84e" :question/math-academy-id "q-142822" :question/problem "${(\\operatorname{sec}⁡x+1)}^{2}-2\\operatorname{sec}⁡x=$" :question/worked-solution "First, let's recall the secant-tangent identity:\n\n$$\n1+{tan}^{2}⁡x={sec}^{2}⁡x\n$$\n\nWe rewrite the given expression using the secant-tangent identity as follows:\n\n$$\n\\begin{aligned}{(\\operatorname{sec}⁡x+1)}^{2}-2\\operatorname{sec}⁡x & ={sec}^{2}⁡x+2\\operatorname{sec}⁡x+1-2\\operatorname{sec}⁡x \\\\  & =1+{tan}^{2}⁡x+2\\operatorname{sec}⁡x+1-2\\operatorname{sec}⁡x \\\\  & =2+{tan}^{2}⁡x\\end{aligned}\n$$\n\nTherefore, we conclude that\n\n$$\n{(\\operatorname{sec}⁡x+1)}^{2}-2\\operatorname{sec}⁡x=2+{tan}^{2}⁡x.\n$$"}] [{:db/id #edb/ref 17592186272380 :knowledge-point/_questions [{:db/id #edb/ref 17592186110666 :knowledge-point/id #uuid "7640012b-79f9-5f6b-a26b-a7f4fe8c0e7b" :knowledge-point/title "Simplifying an Expression Using the Secant-Tangent Identity: Replacing a Squared Secant"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "304dde44-20c4-5678-a462-a143bc700873" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186269703} {:answer/id #uuid "5f4d7ccb-6a93-5802-9236-ce06491ed8c0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\operatorname{tan}⁡x" :db/id #edb/ref 17592186270113} {:answer/id #uuid "a402cd41-72cf-556c-91b9-7acf338994ea" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1+\\operatorname{tan}⁡x" :db/id #edb/ref 17592186270734} {:answer/id #uuid "c912289d-9629-527c-9f02-70c6112b4b91" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2+\\operatorname{tan}⁡x" :db/id #edb/ref 17592186271034} {:answer/id #uuid "fb01e43c-7b1f-5d18-ad5c-c9badf476f9e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1-\\operatorname{tan}⁡x" :db/id #edb/ref 17592186271462}] :answer-field/correct {:answer/id #uuid "5f4d7ccb-6a93-5802-9236-ce06491ed8c0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\operatorname{tan}⁡x" :db/id #edb/ref 17592186270113} :answer-field/id #uuid "fea27859-5aac-55b2-ac2f-7db0b1bf734f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186271953}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "c7824f8f-c1b4-50c2-a8cc-85b1111053c3" :question/math-academy-id "q-142839" :question/problem "$\\frac{1-{sec}^{2}⁡x}{\\operatorname{tan}⁡x}=$" :question/worked-solution "First, let's recall the secant-tangent identity:\n\n$$\n1+{tan}^{2}⁡x={sec}^{2}⁡x\n$$\n\nWe rewrite the given expression using the secant-tangent identity as follows:\n\n$$\n\\begin{aligned}\\frac{1-{sec}^{2}⁡x}{\\operatorname{tan}⁡x} & =\\frac{1-(1+{tan}^{2}⁡x)}{\\operatorname{tan}⁡x} \\\\  & =\\frac{-{tan}^{2}⁡x}{\\operatorname{tan}⁡x} \\\\  & =-\\frac{\\operatorname{tan}⁡x\\cdot \\operatorname{tan}⁡x}{\\operatorname{tan}⁡x} \\\\  & =-\\frac{\\operatorname{tan}⁡x\\cdot \\cancel{\\operatorname{tan}⁡x}}{\\cancel{\\operatorname{tan}⁡x}} \\\\  & =-\\operatorname{tan}⁡x\\end{aligned}\n$$\n\nTherefore, we conclude that\n\n$$\n\\frac{1-{sec}^{2}⁡x}{\\operatorname{tan}⁡x}=-\\operatorname{tan}⁡x.\n$$"}] [{:db/id #edb/ref 17592186272382 :knowledge-point/_questions [{:db/id #edb/ref 17592186110665 :knowledge-point/id #uuid "91100afb-9a36-57c0-9f30-4692cfef0b93" :knowledge-point/title "Simplifying an Expression Using the Secant-Tangent and Other Identities"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "53a1afef-ab20-5945-b76e-734ddce1d287" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1+2{sin}^{2}⁡x" :db/id #edb/ref 17592186270013} {:answer/id #uuid "640b4baa-bd5a-5438-8ead-3ad792f8ca79" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1-2{sin}^{2}⁡x" :db/id #edb/ref 17592186270156} {:answer/id #uuid "9f59147e-3b45-5292-abf8-9bd74860dab6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1-\\operatorname{sin}⁡x" :db/id #edb/ref 17592186270682} {:answer/id #uuid "dcc3cba1-26e2-5c14-abf1-4ce11a76db7a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2-{sin}^{2}⁡x" :db/id #edb/ref 17592186271204} {:answer/id #uuid "f7d608dc-7308-59e2-ad6e-96afa80f19bd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2-\\operatorname{sin}⁡x" :db/id #edb/ref 17592186271442}] :answer-field/correct {:answer/id #uuid "640b4baa-bd5a-5438-8ead-3ad792f8ca79" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1-2{sin}^{2}⁡x" :db/id #edb/ref 17592186270156} :answer-field/id #uuid "bb5b09ad-bc1f-512d-8096-60f9e316d665" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186271850}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "fc757669-b204-5044-83d4-679ef2bca4ac" :question/math-academy-id "q-142871" :question/problem "${cos}^{2}⁡x\\text{ }\\,({sec}^{2}⁡x-2{tan}^{2}⁡x)=$" :question/worked-solution "First, let's recall the secant-tangent identity:\n\n$$\n1+{tan}^{2}⁡x={sec}^{2}⁡x\n$$\n\nWe rewrite the given expression using the secant-tangent identity as follows:\n\n$$\n\\begin{aligned}{cos}^{2}⁡x\\text{ }\\,({sec}^{2}⁡x-2{tan}^{2}⁡x) & ={cos}^{2}⁡x\\text{ }\\,(1+{tan}^{2}⁡x-2{tan}^{2}⁡x) \\\\  & ={cos}^{2}⁡x(1-{tan}^{2}⁡x) \\\\  & ={cos}^{2}⁡x-{cos}^{2}⁡x\\cdot {tan}^{2}⁡x\\end{aligned}\n$$\n\nNext, we recall the identities:\n\n$$\n\\operatorname{tan}⁡x=\\frac{\\operatorname{sin}⁡x}{\\operatorname{cos}⁡x},\\,{cos}^{2}⁡x=1-{sin}^{2}⁡x\n$$\n\n \n\nUsing the above identities, we can further simplify our expression as follows:\n\n$$\n\\begin{aligned}{cos}^{2}⁡x-{cos}^{2}⁡x\\cdot {tan}^{2}⁡x & ={cos}^{2}⁡x-{cos}^{2}⁡x\\cdot \\frac{{sin}^{2}⁡x}{{cos}^{2}⁡x} \\\\  & ={cos}^{2}⁡x-\\cancel{{cos}^{2}⁡x}\\cdot \\frac{{sin}^{2}⁡x}{\\cancel{{cos}^{2}⁡x}} \\\\  & ={cos}^{2}⁡x-{sin}^{2}⁡x \\\\  & =1-{sin}^{2}⁡x-{sin}^{2}⁡x \\\\  & =1-2{sin}^{2}⁡x\\end{aligned}\n$$\n\nTherefore, we conclude that\n\n$$\n{cos}^{2}⁡x\\text{ }\\,({sec}^{2}⁡x-2{tan}^{2}⁡x)=1-2{sin}^{2}⁡x.\n$$"}] [{:db/id #edb/ref 17592186275126 :knowledge-point/_questions [{:db/id #edb/ref 17592186184149 :knowledge-point/id #uuid "84355770-5926-5be6-9b9f-c13bb05599ae" :knowledge-point/title "Identifying the Horizontal Shift of a Horizontally Stretched Tangent or Cotangent Curve"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "27dd6c2e-56f6-5224-a92d-a900e47fbf5d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{\\pi }{12}" :db/id #edb/ref 17592186272740} {:answer/id #uuid "4d20665a-d072-5d38-bc2e-83cd6ab4dfd7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{3\\pi }{4}" :db/id #edb/ref 17592186273035} {:answer/id #uuid "69b8a942-cc3f-5887-9b9a-88358ec6410d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186273298} {:answer/id #uuid "a7e2122f-6484-54b6-b0a8-b983751ab3ed" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\pi }{4}" :db/id #edb/ref 17592186273841} {:answer/id #uuid "dc531f8c-0ec3-5820-905b-629562f0fa99" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\pi }{3}" :db/id #edb/ref 17592186274322}] :answer-field/correct {:answer/id #uuid "27dd6c2e-56f6-5224-a92d-a900e47fbf5d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{\\pi }{12}" :db/id #edb/ref 17592186272740} :answer-field/id #uuid "b21fc2a6-944a-50a1-a0fa-69bde4da9e7f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186274944}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "bdfc61bf-0fdc-5699-9c08-0b5a229a8b71" :question/math-academy-id "q-143670" :question/problem "![](images/c2/c2e5b01cf03f1f9d82562ee51fc484448e90b74dd2584daf18a499849ca36bff.png)\n\nThe graph above shows the function $y=\\operatorname{cot}⁡(\\frac{x}{3}+C),$ where $C$ is a constant. Given that $-\\frac{\\pi }{2}<C<\\frac{\\pi }{2},$ what is the value of $C?$" :question/worked-solution "The parameter $C$ represents a horizontal shift of the function.\n\nFirst, we rewrite the function by factoring the horizontal stretch factor, as follows:\n\n$$\n\\begin{aligned}y & =\\operatorname{cot}⁡(\\frac{x}{3}+C) \\\\  & =\\operatorname{cot}⁡(\\frac{1}{3}(x+3C))\\end{aligned}\n$$\n\nThe factor $x+3C$ indicates that the graph of $y=\\operatorname{cot}⁡(\\frac{1}{3}(x+3C))$ is a horizontal translation of $y=\\operatorname{cot}⁡(\\frac{x}{3}).$ Comparing the two graphs below allows us to determine the amount of this shift.\n\n![](images/29/29346a073d6a22f0bab74eeac86431e8c761c9ed21a005ec6965f71e6436c117.png)\n\nFrom the diagram, we see that our curve has been obtained by shifting $y=\\operatorname{cot}⁡(\\frac{x}{3})$ by $\\frac{7\\pi }{4}-\\frac{3\\pi }{2}=\\frac{\\pi }{4}$ units to the right. Therefore:\n\n$$\n3C=-\\frac{\\pi }{4}\\,⟹\\,C=-\\frac{\\pi }{12}\n$$\n\nSince $-\\frac{\\pi }{2}<C<\\frac{\\pi }{2}$ and $-\\frac{\\pi }{12}$ is in this interval, the value of $C$ is $-\\frac{\\pi }{12}.$"}] [{:db/id #edb/ref 17592186275128 :knowledge-point/_questions [{:db/id #edb/ref 17592186184149 :knowledge-point/id #uuid "84355770-5926-5be6-9b9f-c13bb05599ae" :knowledge-point/title "Identifying the Horizontal Shift of a Horizontally Stretched Tangent or Cotangent Curve"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0fb8c6d5-62f2-5f9e-9dff-a6c6cf210773" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{\\pi }{8}" :db/id #edb/ref 17592186272526} {:answer/id #uuid "3d8111fb-6012-56e0-a9b6-3275417d9a31" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\pi }{4}" :db/id #edb/ref 17592186272916} {:answer/id #uuid "8340b495-0e27-5ab2-8265-89b8a8f42f44" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3\\pi }{4}" :db/id #edb/ref 17592186273514} {:answer/id #uuid "ceceedd5-348a-5f86-9a42-9b4e036292b7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\pi }{2}" :db/id #edb/ref 17592186274185} {:answer/id #uuid "ed397ac8-10b1-54c0-9046-d661bdad85ca" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{\\pi }{3}" :db/id #edb/ref 17592186274484}] :answer-field/correct {:answer/id #uuid "3d8111fb-6012-56e0-a9b6-3275417d9a31" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\pi }{4}" :db/id #edb/ref 17592186272916} :answer-field/id #uuid "b42dc950-3ab6-53ee-bb79-c0cd1d57e61e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186274946}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "587d6141-4c7d-5ff0-9ea2-3cc64d30a411" :question/math-academy-id "q-143672" :question/problem "![](images/6a/6a90f799d2dfd2dbd971e15eb195f4109ab7b6ceb204943a8ed2fd6c83bb620c.png)\n\nThe graph above shows the function $y=\\operatorname{cot}⁡(\\frac{x}{2}+C),$ where $C$ is a constant. Given that $-\\frac{\\pi }{2}<C<\\frac{\\pi }{2},$ what is the value of $C?$" :question/worked-solution "The parameter $C$ represents a horizontal shift of the function.\n\nFirst, we rewrite the function by factoring the horizontal stretch factor, as follows:\n\n$$\n\\begin{aligned}y & =\\operatorname{cot}⁡(\\frac{x}{2}+C) \\\\  & =\\operatorname{cot}⁡(\\frac{1}{2}(x+2C))\\end{aligned}\n$$\n\nThe factor $x+2C$ indicates that the graph of $y=\\operatorname{cot}⁡(\\frac{1}{2}(x+2C))$ is a horizontal translation of $y=cot\\,(\\frac{x}{2}).$ Comparing the two graphs below allows us to determine the amount of this shift.\n\n![](images/0e/0e94fbec60ae4d47d3a4fba50f8a875d9bb3938776940cc9688413d2cb22aa9e.png)\n\nFrom the diagram, we see that our curve has been obtained by shifting $y=\\operatorname{cot}⁡(\\frac{x}{2})$ by $\\frac{\\pi }{2}$ units to the left. Therefore:\n\n$$\n2C=\\frac{\\pi }{2}\\,⟹\\,C=\\frac{\\pi }{4}\n$$"}] [{:db/id #edb/ref 17592186275132 :knowledge-point/_questions [{:db/id #edb/ref 17592186184149 :knowledge-point/id #uuid "84355770-5926-5be6-9b9f-c13bb05599ae" :knowledge-point/title "Identifying the Horizontal Shift of a Horizontally Stretched Tangent or Cotangent Curve"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "38f5df54-de20-581a-a052-687662bac099" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{\\pi }{4}" :db/id #edb/ref 17592186272886} {:answer/id #uuid "59ea7cd8-2c89-5af6-9951-0c58c07e0a6f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\pi }{6}" :db/id #edb/ref 17592186273157} {:answer/id #uuid "98bf869f-24f8-50f3-ac5e-4060bb11e000" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{3\\pi }{8}" :db/id #edb/ref 17592186273712} {:answer/id #uuid "b3d9faeb-5941-52e8-928f-04d747d92a64" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\pi }{3}" :db/id #edb/ref 17592186273945} {:answer/id #uuid "c58db38f-c8f1-5754-b80e-2298972c7447" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\pi }{8}" :db/id #edb/ref 17592186274101}] :answer-field/correct {:answer/id #uuid "59ea7cd8-2c89-5af6-9951-0c58c07e0a6f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\pi }{6}" :db/id #edb/ref 17592186273157} :answer-field/id #uuid "20a99701-dbbe-534f-a0ce-166bf09e58cf" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186274695}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "7239e789-03d0-5ec3-8e95-e5eb72761b2a" :question/math-academy-id "q-143677" :question/problem "![](images/76/7602d1695610361f28613d8bf3542056b2624f9b6b8980873f6fdebf802c6750.png)\n\nThe graph above shows the function $y=\\operatorname{cot}⁡(\\frac{2x}{3}+C),$ where $C$ is a constant. Given that $-\\frac{\\pi }{2}<C<\\frac{\\pi }{2},$ what is the value of $C?$" :question/worked-solution "The parameter $C$ represents a horizontal shift of the function.\n\nFirst, we rewrite the function by factoring the horizontal stretch factor, as follows:\n\n$$\n\\begin{aligned}y & =\\operatorname{cot}⁡(\\frac{2x}{3}+C) \\\\  & =\\operatorname{cot}⁡(\\frac{2}{3}(x+\\frac{3C}{2}))\\end{aligned}\n$$\n\nThe factor $x+\\frac{3C}{2}$ indicates that the graph of $y=\\operatorname{cot}⁡(\\frac{2}{3}(x+\\frac{3C}{2}))$ is a horizontal translation of $y=\\operatorname{cot}⁡(\\frac{2x}{3}).$ Comparing the two graphs below allows us to determine the amount of this shift.\n\n![](images/01/015ca9336646a7545de842414ace2c2a695688e30653b2ed019000d69609d56d.png)\n\nFrom the diagram, we see that our curve has been obtained by shifting $y=\\operatorname{cot}⁡(\\frac{2x}{3})$ by $\\frac{3\\pi }{4}-\\frac{\\pi }{2}=\\frac{\\pi }{4}$ units to the left. Therefore:\n\n$$\n\\frac{3C}{2}=\\frac{\\pi }{4}\\,⟹\\,C=(\\frac{\\pi }{4})(\\frac{2}{3})\\,⟹\\,C=\\frac{\\pi }{6}\n$$\n\nSince $-\\frac{\\pi }{2}<C<\\frac{\\pi }{2}$ and $\\frac{\\pi }{6}$ is in this interval, the value of $C$ is $\\frac{\\pi }{6}.$"}] [{:db/id #edb/ref 17592186060060 :knowledge-point/_questions [{:db/id #edb/ref 17592186059852 :knowledge-point/id #uuid "82f31c6e-f9df-5e0a-88a4-a8ccfca00258" :knowledge-point/title "Calculating the Cross Product of Two Parallel Vectors"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0f27867c-9451-52d4-9675-56489e7ec374" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3a" :db/id #edb/ref 17592186272522} {:answer/id #uuid "21cb1b31-bd6b-5005-a1c7-224eb791a510" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "12a" :db/id #edb/ref 17592186272688} {:answer/id #uuid "28a3f458-1cec-5fd4-b797-aa052f1583df" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "12b" :db/id #edb/ref 17592186272746} {:answer/id #uuid "90858102-719e-537c-b0af-d447bb858e94" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186273645} {:answer/id #uuid "cee5ad2a-4949-58a7-a470-aefe6d88d424" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4a" :db/id #edb/ref 17592186274186}] :answer-field/correct {:answer/id #uuid "90858102-719e-537c-b0af-d447bb858e94" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186273645} :answer-field/id #uuid "931ce724-c38c-5e87-8825-093612bce144" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186274886}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "57870dea-e562-5a28-b808-03713548edd9" :question/math-academy-id "q-146263" :question/problem "The vector $a$ has magnitude $3,$ the vector $b$ has magnitude $4,$ and the angle between the vectors is ${0}^{∘}.$ What is $a\\times b?$" :question/worked-solution "Suppose $a$ and $b$ are nonzero vectors. Then, $a\\times b=0$ if and only if $a∥b.$\n\nSince the angle between $a$ and $b$ is ${0}^{∘},$ our vectors must be parallel. \n\nTherefore, $a\\times b=0.$"}] [{:db/id #edb/ref 17592186275161 :knowledge-point/_questions [{:db/id #edb/ref 17592186059852 :knowledge-point/id #uuid "82f31c6e-f9df-5e0a-88a4-a8ccfca00258" :knowledge-point/title "Calculating the Cross Product of Two Parallel Vectors"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0082e7c0-3530-59f2-ba9a-26fd87e6a277" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2b" :db/id #edb/ref 17592186272389} {:answer/id #uuid "301e0cb5-f0c5-55af-95b8-6ed70646dde2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.5b" :db/id #edb/ref 17592186272816} {:answer/id #uuid "350e615d-c623-5564-ac9d-ffb3c30557ae" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4a" :db/id #edb/ref 17592186272857} {:answer/id #uuid "df92c914-2528-5ddf-b643-174e4b67bf24" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186274362} {:answer/id #uuid "e0ecc418-2211-5616-8595-997d18836cc6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2a" :db/id #edb/ref 17592186274369}] :answer-field/correct {:answer/id #uuid "df92c914-2528-5ddf-b643-174e4b67bf24" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186274362} :answer-field/id #uuid "c74d0c4d-b64a-5315-b450-169a43626632" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186274982}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "8bdbd966-3687-51c3-b475-48a8cfb9ac99" :question/math-academy-id "q-146313" :question/problem "The vector $a$ has magnitude $0.5,$ the vector $b$ has magnitude $4,$ and $a∥b.$ Find $a\\times b.$" :question/worked-solution "Suppose $a$ and $b$ are nonzero vectors. Then, $a\\times b=0$ if and only if $a∥b.$\n\nTherefore, $a\\times b=0.$"}] [{:db/id #edb/ref 17592186275170 :knowledge-point/_questions [{:db/id #edb/ref 17592186179817 :knowledge-point/id #uuid "0e44aa33-0aca-5cb2-8c89-6391240beed8" :knowledge-point/title "Calculating an Amount Given a Ratio"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "201ea477-cfbb-5f47-92d8-dc7ab1342bc4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "15" :db/id #edb/ref 17592186272673} {:answer/id #uuid "2b57bfac-cdba-593c-86e4-d93e44b16ef6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "14" :db/id #edb/ref 17592186272771} {:answer/id #uuid "44918779-d648-5cb8-a83b-46a4969515c6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "12" :db/id #edb/ref 17592186272971} {:answer/id #uuid "4eb55ef9-c91f-56ec-913b-115fefd7cb4f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "21" :db/id #edb/ref 17592186273049} {:answer/id #uuid "c116cfdc-8bb2-558b-b986-5301e129ea0e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "17" :db/id #edb/ref 17592186274065}] :answer-field/correct {:answer/id #uuid "2b57bfac-cdba-593c-86e4-d93e44b16ef6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "14" :db/id #edb/ref 17592186272771} :answer-field/id #uuid "73405daf-413c-5bec-8a42-da73312272db" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186274831}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "3b96e560-1c90-5b2e-af2d-315e053698f7" :question/math-academy-id "q-147075" :question/problem "Jack writes down a number with multiple digits.\nThe ratio of even digits in the number to the total number of digits is $1:3.$\nIf the number has $7$ even digits, how many odd digits are there?" :question/worked-solution "We start with the ratio $1:3$ and write it as a fraction:\n\n$$\n\\frac{1}{3}\n$$\n\nIn this fraction, the numerator represents the number of even digits, and the denominator represents the total number of digits.\n\nWe can make a numerator of $7$ by multiplying the numerator and denominator by $7:$\n\n$$\n\\frac{1\\times 7}{3\\times 7}=\\frac{7}{21}\n$$\n\nTherefore, there are $21$ digits in total. \nSo, the number of odd digits in the number is\n\n$$\n21-7=14.\n$$"}] [{:db/id #edb/ref 17592186275171 :knowledge-point/_questions [{:db/id #edb/ref 17592186179818 :knowledge-point/id #uuid "b5406de3-483e-56c2-b9c6-73de6769552e" :knowledge-point/title "Calculating an Amount Given a Ratio as a Fraction"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5e386632-6bbd-5c36-98fa-049cc3dd31da" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "20" :db/id #edb/ref 17592186273197} {:answer/id #uuid "869c4a2e-ea2b-57a2-b90e-0f986f3e14b2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "18" :db/id #edb/ref 17592186273540} {:answer/id #uuid "bcc9068e-4b2f-5fd2-897c-8be458301e7c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "12" :db/id #edb/ref 17592186274020} {:answer/id #uuid "cd8b4bed-983d-5530-acd8-9b1fde3874d7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "24" :db/id #edb/ref 17592186274174} {:answer/id #uuid "cdb8a89b-d875-5f41-a673-bf64066fc559" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "16" :db/id #edb/ref 17592186274178}] :answer-field/correct {:answer/id #uuid "bcc9068e-4b2f-5fd2-897c-8be458301e7c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "12" :db/id #edb/ref 17592186274020} :answer-field/id #uuid "edfe2202-722d-50d6-b0a7-c6f0eb1f0e39" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186275056}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "c52ba104-2b78-5501-930a-80e292c504e3" :question/math-academy-id "q-147076" :question/problem "In a table, each cell was colored either yellow or green. The ratio of yellow cells to the total number of cells is $2:3.$ If there are $24$ yellow cells, how many cells were colored green?" :question/worked-solution "We are given that the ratio of yellow cells to the total number of cells is $\\frac{2}{3}.$ \n\nIn this fraction, the numerator represents the number of yellow cells, and the denominator represents the total number of cells.\n\nWe can make a numerator of $24$ by multiplying the numerator and denominator by $12:$\n\n$$\n\\frac{2\\times 12}{3\\times 12}=\\frac{24}{36}\n$$\n\nTherefore, there are a total of $36$ cells in the table. \nSo, the number of green cells is\n\n$$\n36-24=12.\n$$"}] [{:db/id #edb/ref 17592186275172 :knowledge-point/_questions [{:db/id #edb/ref 17592186179818 :knowledge-point/id #uuid "b5406de3-483e-56c2-b9c6-73de6769552e" :knowledge-point/title "Calculating an Amount Given a Ratio as a Fraction"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0a71d876-052d-58a1-b34d-f38c05859375" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "42" :db/id #edb/ref 17592186272482} {:answer/id #uuid "1262f3a1-1ef9-5e94-acf7-e2e3dabf8d81" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "45" :db/id #edb/ref 17592186272552} {:answer/id #uuid "3a1181eb-e541-5a91-b732-f8477165807d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "35" :db/id #edb/ref 17592186272891} {:answer/id #uuid "4c474222-0096-5a01-bdfc-a46a7d6adee5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "49" :db/id #edb/ref 17592186273028} {:answer/id #uuid "97cd86eb-fc0b-59f4-bd1d-84c292397d8b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "37" :db/id #edb/ref 17592186273704}] :answer-field/correct {:answer/id #uuid "3a1181eb-e541-5a91-b732-f8477165807d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "35" :db/id #edb/ref 17592186272891} :answer-field/id #uuid "d7177293-97a8-5f50-a884-9c2e6ddbf2a1" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186275014}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "d66fb6cc-b6c6-55ab-abc9-f32c6026bbc2" :question/math-academy-id "q-147213" :question/problem "A bag contains blue and green buttons. The ratio of blue buttons to the total number of buttons is $2:7.$ If there are $14$ blue buttons,  how many green buttons are in the bag?" :question/worked-solution "We are given that the ratio of blue buttons to the total number of buttons is $\\frac{2}{7}.$ \n\nIn this fraction, the numerator represents the number of blue buttons, and the denominator represents the total number of buttons.\n\nWe can make a numerator of $14$ by multiplying the numerator and denominator by $7:$\n\n$$\n\\frac{2\\times 7}{7\\times 7}=\\frac{14}{49}\n$$\n\nTherefore, there are a total of $49$ buttons in the bag. \nSo, the number of green buttons is\n\n$$\n49-14=35.\n$$"}] [{:db/id #edb/ref 17592186275174 :knowledge-point/_questions [{:db/id #edb/ref 17592186068881 :knowledge-point/id #uuid "beab791b-0819-5768-9e5f-0dc621d5a462" :knowledge-point/title "Solving Rational Equations Containing Two Distinct Linear Denominators"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0d20b2d7-4733-5936-9c3a-2f0704ddc6a6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "No solution" :db/id #edb/ref 17592186272502} {:answer/id #uuid "54635df5-994b-51cb-96f0-37e6e995aef8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186273107} {:answer/id #uuid "6a941009-01a5-5c91-81cc-405b46567d7f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186273305} {:answer/id #uuid "7b64782b-7e43-5ae2-acc0-148d438df071" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186273445} {:answer/id #uuid "ca8b3aae-9565-57f8-8a10-92c739f72903" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "9" :db/id #edb/ref 17592186274147}] :answer-field/correct {:answer/id #uuid "0d20b2d7-4733-5936-9c3a-2f0704ddc6a6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "No solution" :db/id #edb/ref 17592186272502} :answer-field/id #uuid "14f6ad54-8307-56a0-b43c-b5954262007f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186274672}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "2428d6ad-8fe9-5fa9-afc9-78f5bade1f4b" :question/math-academy-id "q-14738" :question/problem "Solve for $p$ where $\\frac{1}{p}=\\frac{10}{9p}+\\frac{p-1}{9p}.$" :question/worked-solution "We note that $p=0$ cannot be a solution since division by $0$ is undefined.\n\nThe equation has the denominators $p$ and $9p.$ So first, we find the least common multiple (or $\\text{LCM}$) of the denominators. We find that\n\n$$\n\\text{LCM}(p,9p)=9p.\n$$\n\nSo, we multiply both sides of the equation by $9p,$ and simplify:\n\n$$\n\\begin{aligned}\\frac{1}{p} & =\\frac{10}{9p}+\\frac{p-1}{9p} \\\\ 9p\\cdot (\\frac{1}{p}) & =9p\\cdot (\\frac{10}{9p}+\\frac{p-1}{9p}) \\\\ 9p\\cdot \\frac{1}{p} & =9p\\cdot \\frac{10}{9p}+9p\\cdot \\frac{p-1}{9p} \\\\ 9\\cancel{p}\\cdot \\frac{1}{\\cancel{p}} & =\\cancel{9p}\\cdot \\frac{10}{\\cancel{9p}}+\\cancel{9p}\\cdot \\frac{p-1}{\\cancel{9p}} \\\\ 9\\cdot (1) & =10+p-1 \\\\ 9 & =10+p-1\\end{aligned}\n$$\n\nWe now have a linear equation in $p,$ and we can solve this using the addition and multiplication principles:\n\n$$\n\\begin{aligned}9 & =10+p-1 \\\\ 9 & =p+9 \\\\ p & =0\\end{aligned}\n$$\n\nFinally, we recall that we cannot allow $p=0$ as a solution. Since $p=0,$ we conclude that there is no solution."}] [{:db/id #edb/ref 17592186275190 :knowledge-point/_questions [{:db/id #edb/ref 17592186087860 :knowledge-point/id #uuid "e75012ec-8203-574b-ba07-0a26e4cf4691" :knowledge-point/title "Finding the Equation of a Circle Given Endpoints of a Diameter"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "100d8b6a-4304-5a97-b783-491ca5587789" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{x}^{2}+{y}^{2}=34" :db/id #edb/ref 17592186272529} {:answer/id #uuid "68c327c6-fcd3-5d82-9078-88a0cd7c63a4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{x}^{2}+{y}^{2}=\\sqrt{34}" :db/id #edb/ref 17592186273293} {:answer/id #uuid "7485bcc8-199f-58fe-93a7-0e43b0d5dd41" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{x}^{2}+{y}^{2}=68" :db/id #edb/ref 17592186273383} {:answer/id #uuid "bbf1d11e-710b-57a0-bc7a-00dcc060cb84" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{x}^{2}+{y}^{2}=2\\sqrt{34}" :db/id #edb/ref 17592186274014} {:answer/id #uuid "fa3977b0-78d4-53bd-bf40-eb66c27dee2d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{x}^{2}+{y}^{2}=136" :db/id #edb/ref 17592186274581}] :answer-field/correct {:answer/id #uuid "100d8b6a-4304-5a97-b783-491ca5587789" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{x}^{2}+{y}^{2}=34" :db/id #edb/ref 17592186272529} :answer-field/id #uuid "55053428-8241-5558-92ff-9ce80dd3d9f2" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186274777}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "7bc89cdc-6ea1-5b85-ac05-a5453131372d" :question/math-academy-id "q-14793" :question/problem "![](images/88/883828970a6deca7d7efdc201da679324f17ec916ba0b44b76f5af2718ead2b9.png)\n\nGiven that the points $A$ and $B$ with coordinates $(3,5)$ and $(-3,-5),$ respectively, are the endpoints of a diameter of a circle centered at the origin, what is the equation of the circle?" :question/worked-solution "The equation of a circle with radius $r,$ centered at the origin, is \n\n$$\n{x}^{2}+{y}^{2}={r}^{2}.\n$$\n\nFirst, we calculate the length of the diameter $\\overset{―}{AB}:$\n\n \n\n$$\n\\begin{aligned}AB & =\\sqrt{{(5-(-5))}^{2}+{(3-(-3))}^{2}} \\\\  & =\\sqrt{{10}^{2}+{6}^{2}} \\\\  & =\\sqrt{136} \\\\  & =\\sqrt{4\\cdot 34} \\\\  & =2\\sqrt{34}\\end{aligned}\n$$\n\nSince $\\overset{―}{AB}$ is a diameter, the radius is\n\n$$\nr=\\frac{AB}{2}=\\frac{2\\sqrt{34}}{2}=\\sqrt{34}.\n$$\n\nSo, the equation of the circle is\n\n$$\n\\begin{aligned}{x}^{2}+{y}^{2} & ={r}^{2} \\\\ {x}^{2}+{y}^{2} & =(\\sqrt{34})^{2} \\\\ {x}^{2}+{y}^{2} & =34.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186275206 :knowledge-point/_questions [{:db/id #edb/ref 17592186175937 :knowledge-point/id #uuid "cee807c1-dd86-5b0e-a595-5c5754c47e4c" :knowledge-point/title "Computing Covariance in Context"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1ae360b9-cddd-560a-a2f3-3d0a0df3d66e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6.5" :db/id #edb/ref 17592186272617} {:answer/id #uuid "2432f107-2df5-570e-a7d2-e105cbdf0fa0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "7" :db/id #edb/ref 17592186272701} {:answer/id #uuid "aa206143-ba38-50e9-969f-1c702fa9ebf7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186273856} {:answer/id #uuid "e53b5013-4bd4-50ab-a579-e394db626861" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186274411} {:answer/id #uuid "fafaa6d6-5066-503a-bbb0-029f6c067eb5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5.5" :db/id #edb/ref 17592186274589}] :answer-field/correct {:answer/id #uuid "fafaa6d6-5066-503a-bbb0-029f6c067eb5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5.5" :db/id #edb/ref 17592186274589} :answer-field/id #uuid "878e7bba-a984-5f22-8624-0c0e558f18ba" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186274867}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "e6f10932-80ef-5d89-b920-551222224129" :question/math-academy-id "q-149561" :question/problem "| **Age, in years ($x$)** | $12$ | $12$ | $14$ | $14$ |\n| --- | --- | --- | --- | --- |\n| **Weight, in lbs ($y$)** | $85$ | $90$ | $97$ | $100$ |\n\nMike plays baseball. The table above shows the ages and corresponding weights of four of Mike's teammates.\nCompute the covariance of the data sets." :question/worked-solution "The (population) covariance of the data sets $x={{x}_{1},{x}_{2},…,{x}_{n}}$ and $y={{y}_{1},{y}_{2},…,{y}_{n}}$ is given by \n\n$$\n\\text{Cov}(x,y)=\\frac{1}{n}{\\sum }_{i=1}^{n}({x}_{i}-\\overset{―}{x})({y}_{i}-\\overset{―}{y}),\n$$\n\nwhere $\\overset{―}{x}=\\frac{1}{n}{\\sum }_{i=1}^{n}{x}_{i}$ and $\\overset{―}{y}=\\frac{1}{n}{\\sum }_{i=1}^{n}{y}_{i}$ are the means of the data sets.\n\nFirst, we need to compute the means: \n\n$$\n\\begin{aligned}\\overset{―}{x} & =\\frac{1}{n}{\\sum }_{i=1}^{n}{x}_{i} \\\\  & =\\frac{1}{4}\\cdot (12+12+14+14) \\\\  & =\\frac{1}{4}\\cdot 52 \\\\  & =13 \\\\ \\overset{―}{y} & =\\frac{1}{n}{\\sum }_{i=1}^{n}{y}_{i} \\\\  & =\\frac{1}{4}\\cdot (85+90+97+100) \\\\  & =\\frac{1}{4}\\cdot 372 \\\\  & =93\\end{aligned}\n$$\n\nTherefore, the covariance of our data sets is\n\n$$\n\\begin{aligned}\\text{Cov}(x,y) & =\\frac{1}{n}{\\sum }_{i=1}^{n}({x}_{i}-\\overset{―}{x})({y}_{i}-\\overset{―}{y}) \\\\  & =\\frac{1}{4}[(12\\,-\\,13)(85\\,-\\,93)+(12\\,-\\,13)(90\\,-\\,93)+(14\\,-\\,13)(97\\,-\\,93)+(14\\,-\\,13)(100\\,-\\,93)] \\\\  & =\\frac{1}{4}[(-1)(-8)+(-1)(-3)+(1)(4)+(1)(7)] \\\\  & =\\frac{1}{4}[8+3+4+7] \\\\  & =\\frac{1}{4}\\cdot 22 \\\\  & =5.5.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186275213 :knowledge-point/_questions [{:db/id #edb/ref 17592186175936 :knowledge-point/id #uuid "a2ac0065-9315-547a-a9cf-c6a5abea1aed" :knowledge-point/title "Computing Covariance"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1499dc15-38f5-5d95-918a-72ffb6809888" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186272571} {:answer/id #uuid "762be50a-18a9-51c8-a54f-ca9f26009a41" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186273392} {:answer/id #uuid "94928e78-723e-558e-8935-de7f73fdfbcf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186273681} {:answer/id #uuid "d1650319-7a64-53ee-ad96-ad0f30650ea0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186274213} {:answer/id #uuid "e3444b21-54ff-574a-baf1-e04c118fe0b3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-8" :db/id #edb/ref 17592186274396}] :answer-field/correct {:answer/id #uuid "762be50a-18a9-51c8-a54f-ca9f26009a41" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186273392} :answer-field/id #uuid "988def41-f2b9-537a-bb4c-556b664be748" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186274902}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "66fe2369-0f88-574b-b368-3759760d7d2e" :question/math-academy-id "q-149616" :question/problem "Consider the following data sets:\n\n$$\nx={12,\\,7,\\,6,\\,3},\\,y={-4,\\,-6,\\,-4,\\,-2}\n$$\n\nYou're given that $\\overset{―}{x}=7$ and $\\overset{―}{y}=-4.$ Calculate $\\text{Cov}(x,y).$" :question/worked-solution "The (population) covariance of the data sets $x={{x}_{1},{x}_{2},…,{x}_{n}}$ and $y={{y}_{1},{y}_{2},…,{y}_{n}}$ is given by \n\n$$\n\\text{Cov}(x,y)=\\frac{1}{n}{\\sum }_{i=1}^{n}({x}_{i}-\\overset{―}{x})({y}_{i}-\\overset{―}{y}),\n$$\n\nwhere $\\overset{―}{x}=\\frac{1}{n}{\\sum }_{i=1}^{n}{x}_{i}$ and $\\overset{―}{y}=\\frac{1}{n}{\\sum }_{i=1}^{n}{y}_{i}$ are the means of the data sets.\n\nTherefore, the covariance of our data sets is\n\n$$\n\\begin{aligned}\\text{Cov}(x,y) & =\\frac{1}{n}{\\sum }_{i=1}^{n}({x}_{i}-\\overset{―}{x})({y}_{i}-\\overset{―}{y}) \\\\  & =\\frac{1}{4}[(12-7)(-4-(-4))+(7-7)(-6-(-4)) \\\\  & \\,\\,\\,+(6-7)(-4-(-4))+(3-7)(-2-(-4))] \\\\  & =\\frac{1}{4}[(5)(0)+(0)(-2)+(-1)(0)+(-4)(2)] \\\\  & =\\frac{1}{4}[0+0+0-8] \\\\  & =\\frac{1}{4}\\cdot (-8) \\\\  & =-2.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186275326 :knowledge-point/_questions [{:db/id #edb/ref 17592186078390 :knowledge-point/id #uuid "697f9bd8-9edf-5643-8cdb-a821b6dce09c" :knowledge-point/title "Finding the Center and Radius of a Circle by Completing the Square"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1e85bc55-e02c-54fc-8122-557e2841e870" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-11" :db/id #edb/ref 17592186272659} {:answer/id #uuid "bdd36a44-0719-5e42-b8ba-c592a0f863c2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-12" :db/id #edb/ref 17592186274031} {:answer/id #uuid "cf716e16-5a7b-58d5-bd95-468707fb3db2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-10" :db/id #edb/ref 17592186274193} {:answer/id #uuid "ee3f9ff3-e21e-5c4d-8faf-b3e8f4725a52" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-9" :db/id #edb/ref 17592186274496} {:answer/id #uuid "f301e76e-2941-5fe9-867b-3eea69dc0dc1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-14" :db/id #edb/ref 17592186274533}] :answer-field/correct {:answer/id #uuid "1e85bc55-e02c-54fc-8122-557e2841e870" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-11" :db/id #edb/ref 17592186272659} :answer-field/id #uuid "3da9ef7a-cbe1-5227-9f80-59ed9e88f81a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186274741}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "7f46ab27-790f-5c57-b1be-51cd554f05c2" :question/math-academy-id "q-15456" :question/problem "A circle in the Cartesian plane is given by the equation \n$137+6y=-{y}^{2}-{x}^{2}-24x.$ If the circle is written in the standard form $(x-a)^{2}+(y-b)^{2}={r}^{2},$ then $a+b+r=$" :question/worked-solution "To find the standard form of the circle, we need to group $x$ and $y$ terms and complete the squares.\n\n$$\n\\begin{aligned}137+6y & =-{y}^{2}-{x}^{2}-24x \\\\ {x}^{2}+24x+{y}^{2}+6y & =-137 \\\\ ({x}^{2}+24x)+({y}^{2}+6y) & =-137 \\\\ ({x}^{2}+2\\cdot 12x+{12}^{2})+({y}^{2}+2\\cdot 3y+{3}^{2}) & =-137+{12}^{2}+{3}^{2} \\\\ ({x}^{2}+2\\cdot 12x+{12}^{2})+({y}^{2}+2\\cdot 3y+{3}^{2}) & =16\\end{aligned}\n$$\n\nNow, we can factor the perfect squares and get\n\n$$\n\\begin{aligned}(x+12)^{2}+(y+3)^{2} & ={4}^{2} \\\\ (x-(-12))^{2}+(y-(-3))^{2} & ={4}^{2}.\\end{aligned}\n$$\n\nTherefore, $a=-12,b=-3$ and $r=4,$  and\n\n$$\na+b+r=-12-3+4=-11.\n$$"}] [{:db/id #edb/ref 17592186401062 :knowledge-point/_questions [{:db/id #edb/ref 17592186083243 :knowledge-point/id #uuid "d0bda136-40a9-576a-b85c-4d4ebefaeb27" :knowledge-point/title "Calculating the Slope of the Tangent to a Parametric Curve at a Given Point"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "bead1cb0-40bc-5682-8aea-b1306552b221" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{2}" :db/id #edb/ref 17592186401064} {:answer/id #uuid "86056585-0e06-5b86-b0c0-36b6f0375c43" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186401065} {:answer/id #uuid "7c15ff06-b974-57e0-9d0d-91476444df9d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186401066} {:answer/id #uuid "552b9d8c-6c80-5fa5-9717-bf514c6bbbca" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{\\sqrt{2}}" :db/id #edb/ref 17592186401067} {:answer/id #uuid "65a93180-72f9-5046-97f5-9cb178f53496" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186401068}] :answer-field/correct {:answer/id #uuid "65a93180-72f9-5046-97f5-9cb178f53496" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186401068} :answer-field/id #uuid "4182a726-9587-5280-b0ae-9a47c4e9e265" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186401063}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "16fc9f31-33f6-5972-9529-3afa5f1e1dc8" :question/math-academy-id "q-15465" :question/problem "For the parametric curve \n\n$$\nx=t+\\operatorname{sin}⁡t,\\,y=t+\\operatorname{cos}⁡t,\\,0\\le t<2\\pi ,\n$$\n\ncalculate the slope of the tangent to the curve at the point where $t=\\frac{\\pi }{2}.$" :question/worked-solution "We will use the formula\n\n$$\n\\frac{dy}{dx}=\\frac{{y}^{′}(t)}{{x}^{′}(t)}.\n$$\n\nDifferentiating $x$ and $y,$ we get\n\n$$\n{x}^{′}(t)=1+\\operatorname{cos}⁡t,\\,{y}^{′}(t)=1-\\operatorname{sin}⁡t.\n$$\n\n \n\nSo we have\n\n$$\n\\begin{aligned}\\frac{dy}{dx} & =\\frac{1-\\operatorname{sin}⁡t}{1+\\operatorname{cos}⁡t}.\\end{aligned}\n$$\n\nTherefore, when $t=\\frac{\\pi }{2},$ the slope of the tangent to the curve is\n\n$$\n\\begin{aligned}\\frac{dy}{dx} & =\\frac{1-\\operatorname{sin}⁡(\\frac{\\pi }{2})}{1+\\operatorname{cos}⁡(\\frac{\\pi }{2})} \\\\  & =\\frac{1-1}{1+0} \\\\  & =0\\,.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186275360 :knowledge-point/_questions [{:db/id #edb/ref 17592186096807 :knowledge-point/id #uuid "0e274fe1-7242-5a6c-8351-eeff9877d2bf" :knowledge-point/title "Computing the Derivative of a Quotient of Functions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5a9a5d2e-53a9-565b-a1fc-8cd26f86a3d7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{5}{2}" :db/id #edb/ref 17592186273163} {:answer/id #uuid "b701a9a5-29bb-5708-a957-88c300832439" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{2}" :db/id #edb/ref 17592186273973} {:answer/id #uuid "e6a1fc64-941c-5d5b-ab84-b99a95f4f1dd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186274425} {:answer/id #uuid "e9dc9ac0-b688-5b5c-9541-86b4f9ef8848" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{7}{2}" :db/id #edb/ref 17592186274457} {:answer/id #uuid "f3d6ceb2-4c78-5a7d-9d25-5474bd89a51c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5}{4}" :db/id #edb/ref 17592186274539}] :answer-field/correct {:answer/id #uuid "f3d6ceb2-4c78-5a7d-9d25-5474bd89a51c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5}{4}" :db/id #edb/ref 17592186274539} :answer-field/id #uuid "ececad6e-65a0-55c7-b5bb-cd62a469aefa" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186275053}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "d8bc070b-a1af-5473-852c-4d138913925e" :question/math-academy-id "q-15664" :question/problem "![](images/e4/e4b9bd92b63d85b0336974285b6aa7a8a7beb8348cf368f65d805f7b4b70ffa2.png)\n\nGiven the plots of $y=f(x)$ and $y=g(x)$ above, find ${h}^{′}(1)$ where $h(x)=\\frac{f(x)}{g(x)}.$" :question/worked-solution "The quotient rule for derivatives gives\n\n$$\n{h}^{′}(x)=\\frac{{f}^{′}(x)\\cdot g(x)-f(x)\\cdot {g}^{′}(x)}{(g(x))^{2}}.\n$$\n\nAs a result, we have that\n\n$$\n{h}^{′}(1)=\\frac{{f}^{′}(1)\\cdot g(1)-f(1)\\cdot {g}^{′}(1)}{(g(1))^{2}}.\n$$\n\nFrom the graph above, we obtain that $f(1)=3$ and $g(1)=2.$\n\nAdditionally:\n\n- The slope of $f(x)$ on $x\\in (0,2)$ equals $1.$ So, ${f}^{′}(1)=1.$\n\n- The slope of $g(x)$ on $x\\in (0,3)$ equals $-1.$ So, ${g}^{′}(1)=-1.$\n\nFinally, we have\n\n$$\n\\begin{aligned}{h}^{′}(1) & =\\frac{{f}^{′}(1)\\cdot g(1)-f(1)\\cdot {g}^{′}(1)}{(g(1))^{2}} \\\\  & =\\frac{1\\cdot 2-3\\cdot (-1)}{{2}^{2}} \\\\  & =\\frac{5}{4}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186396080 :knowledge-point/_questions [{:db/id #edb/ref 17592186087658 :knowledge-point/id #uuid "8b022811-fdd6-56a1-92ee-388e7ea53a4c" :knowledge-point/title "Calculating the Intersection of a Circle With the X-Axis"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "aa5e115e-6cbc-5411-ae18-a29ea605510e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$(-9,0)$ and $(1.5,0)$" :db/id #edb/ref 17592186396082} {:answer/id #uuid "066ae657-b48f-5dee-bdbe-90b25f7241eb" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$(-8,0)$ and $(1,0)$" :db/id #edb/ref 17592186396083} {:answer/id #uuid "49c35dab-c634-555f-891f-064bee97693f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$(-9,0)$ and $(1,0)$" :db/id #edb/ref 17592186396084} {:answer/id #uuid "4a4a908f-0a56-517f-bdb8-64d7225e46c2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$(-10,0)$ and $(1,0)$" :db/id #edb/ref 17592186396085} {:answer/id #uuid "d3ca94c7-3047-533b-8a37-cf3312b8643d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$(-9,0)$ and $(0.8,0)$" :db/id #edb/ref 17592186396086}] :answer-field/correct {:answer/id #uuid "49c35dab-c634-555f-891f-064bee97693f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$(-9,0)$ and $(1,0)$" :db/id #edb/ref 17592186396084} :answer-field/id #uuid "0f0feeb3-b4ef-50dc-a4d4-f6cc9bb23002" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186396081}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "128b9cef-763e-5aac-a6f0-9eae06355cd4" :question/math-academy-id "q-15681" :question/problem "![](images/13/13b9598c77cd522d0d3aeee4f5abd2390822431aa49ed787b73a110113ab821c.png)\n\nFind the $x$-intercepts of the circle $(x+4)^{2}+{y}^{2}=25,$ shown above." :question/worked-solution "We must have $y=0$ at the $x$-intercepts. \n\nSo, we need to substitute $y=0$ into the equation of the circle and solve for $x,$ as follows:\n\n$$\n\\begin{aligned}(x+4)^{2}+{y}^{2} & =25 \\\\ (x+4)^{2}+{0}^{2} & =25 \\\\ (x+4)^{2} & =25 \\\\ x+4 & =\\pm \\sqrt{25} \\\\ x+4 & =\\pm 5 \\\\ x & =-4\\pm 5\\end{aligned}\n$$\n\nTherefore, the $x$-intercepts occur at the points $(-9,0)$ and $(1,0).$"}] [{:db/id #edb/ref 17592186396087 :knowledge-point/_questions [{:db/id #edb/ref 17592186087658 :knowledge-point/id #uuid "8b022811-fdd6-56a1-92ee-388e7ea53a4c" :knowledge-point/title "Calculating the Intersection of a Circle With the X-Axis"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b6302339-3d66-5e7b-88a3-48ff6e08f3e0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$(-5,0)$ and $(8,0)$" :db/id #edb/ref 17592186396089} {:answer/id #uuid "bd167719-ad84-5223-8f5d-835bbaa95ad2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$(-5.5,0)$ and $(7.5,0)$" :db/id #edb/ref 17592186396090} {:answer/id #uuid "30ea2584-387d-5bad-8718-caaee9f8c176" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$(-6,0)$ and $(8,0)$" :db/id #edb/ref 17592186396091} {:answer/id #uuid "0bca8a34-0b3e-5171-929c-8b379129db00" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$(-5,0)$ and $(7,0)$" :db/id #edb/ref 17592186396092} {:answer/id #uuid "2d1c78a6-2f99-5181-bd25-00d1a3010a31" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$(-6,0)$ and $(7,0)$" :db/id #edb/ref 17592186396093}] :answer-field/correct {:answer/id #uuid "0bca8a34-0b3e-5171-929c-8b379129db00" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$(-5,0)$ and $(7,0)$" :db/id #edb/ref 17592186396092} :answer-field/id #uuid "d7f39783-8476-55ac-a74e-97c264bb6280" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186396088}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "1d50f11f-d6f2-5605-88f1-8c45f7404cb9" :question/math-academy-id "q-15684" :question/problem "![](images/c6/c6d356b443128da569a6b60065769cdb56e2e0059db7b146a3c4035d18a32228.png)\n\nFind the $x$-intercepts of the circle $(x-1)^{2}+(y-3)^{2}=45,$ shown above." :question/worked-solution "We must have $y=0$ at the $x$-intercepts. \n\nSo, we need to substitute $y=0$ into the equation of the circle and solve for $x,$ as follows:\n\n$$\n\\begin{aligned}(x-1)^{2}+(y-3)^{2} & =45 \\\\ (x-1)^{2}+(0-3)^{2} & =45 \\\\ (x-1)^{2}+9 & =45 \\\\ (x-1)^{2} & =36 \\\\ x-1 & =\\pm \\sqrt{36} \\\\ x & =1\\pm 6\\end{aligned}\n$$\n\nTherefore, the $x$-intercepts occur at the points $(-5,0)$ and $(7,0).$"}] [{:db/id #edb/ref 17592186401076 :knowledge-point/_questions [{:db/id #edb/ref 17592186087660 :knowledge-point/id #uuid "e6f0c89e-fe19-5aaf-9f85-b5f0ff7a344e" :knowledge-point/title "Calculating the Intersection of a Circle With the Y-Axis"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d256b930-0dee-50c4-bd81-41d64217fa7f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$(0,4-\\sqrt{3})$ and $(0,4+\\sqrt{3})$" :db/id #edb/ref 17592186401078} {:answer/id #uuid "2759b4ff-6fe0-5744-9043-700096ff43f0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$(0,6-\\sqrt{3})$ and $(0,6+\\sqrt{3})$" :db/id #edb/ref 17592186401079} {:answer/id #uuid "0e3a7f86-7353-5871-ab3c-151f2b4eb6c7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$(0,5-\\sqrt{3})$ and $(0,5+\\sqrt{3})$" :db/id #edb/ref 17592186401080} {:answer/id #uuid "4fc673dc-55ce-532c-a658-37120012f1ee" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$(0,5-\\sqrt{5})$ and $(0,5+\\sqrt{5})$" :db/id #edb/ref 17592186401081} {:answer/id #uuid "01d470c7-780c-5f9a-a462-fc902c6b68dd" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$(0,4-\\sqrt{5})$ and $(0,4+\\sqrt{5})$" :db/id #edb/ref 17592186401082}] :answer-field/correct {:answer/id #uuid "01d470c7-780c-5f9a-a462-fc902c6b68dd" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$(0,4-\\sqrt{5})$ and $(0,4+\\sqrt{5})$" :db/id #edb/ref 17592186401082} :answer-field/id #uuid "62252cab-6046-5d37-8592-a5f805f44339" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186401077}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "b39c00d5-06a8-557a-8fa0-abcc975f62c0" :question/math-academy-id "q-15692" :question/problem "![](images/18/185393f07b920bf9b72799f1c17c4245017b500ff1ca92a0104fe95ce621bde4.png)\n\nFind the $y$-intercepts of the circle $(x-2)^{2}+(y-4)^{2}=9,$ shown above." :question/worked-solution "We must have $x=0$ at the $y$-intercepts. \n\nSo, we need to substitute $x=0$ into the equation of the circle and solve for $y,$ as follows:\n\n$$\n\\begin{aligned}(x-2)^{2}+(y-4)^{2} & =9 \\\\ (0-2)^{2}+(y-4)^{2} & =9 \\\\ 4+(y-4)^{2} & =9 \\\\ (y-4)^{2} & =9-4 \\\\ (y-4)^{2} & =5 \\\\ y-4 & =\\pm \\sqrt{5} \\\\ y & =4\\pm \\sqrt{5}\\end{aligned}\n$$\n\nTherefore, the $y$-intercepts occur at the points $(0,4-\\sqrt{5})$ and $(0,4+\\sqrt{5}).$"}] [{:db/id #edb/ref 17592186064521 :knowledge-point/_questions [{:db/id #edb/ref 17592186064206 :knowledge-point/id #uuid "fc4294d6-3d60-5c9e-a862-863e1d129049" :knowledge-point/title "Integrating a Linear Rational Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "074cbeeb-ceea-5d3a-b261-66c040d68ae2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}\\operatorname{ln}⁡|x+1|+C" :db/id #edb/ref 17592186272451} {:answer/id #uuid "55a8292a-df16-5981-a5ea-00451577d189" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\operatorname{ln}⁡|x+1|+C" :db/id #edb/ref 17592186273116} {:answer/id #uuid "c05838da-c78f-5df1-9575-655f840fa6b9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2\\operatorname{ln}⁡|x+1|+C" :db/id #edb/ref 17592186274053} {:answer/id #uuid "d783c2de-76be-5361-adef-4dddf883917b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{2}\\operatorname{ln}⁡|x+1|+C" :db/id #edb/ref 17592186274273} {:answer/id #uuid "fb4ef98e-f7e7-56cd-950d-8eb83c1a8061" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{ln}⁡|x+1|+C" :db/id #edb/ref 17592186274591}] :answer-field/correct {:answer/id #uuid "55a8292a-df16-5981-a5ea-00451577d189" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\operatorname{ln}⁡|x+1|+C" :db/id #edb/ref 17592186273116} :answer-field/id #uuid "b72a5c10-3eed-5cd1-8364-3fce07a4be90" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186274951}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "0fe299cc-e2f3-5032-a27f-6865f6c34c09" :question/math-academy-id "q-15707" :question/problem "$\\int \\frac{2}{x+1}\\,\\text{d}x=$" :question/worked-solution "First, let $u=x+1.$ Then differentiating with respect to $x$ gives\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=1\\,⟹\\,\\text{d}u=\\text{d}x.\n$$\n\nWe can now rewrite the integral in terms of $u,$ solve it, and write the final answer in terms of $x$ as follows:\n\n$$\n\\begin{aligned}\\int \\frac{2}{x+1}\\,\\text{d}x & =2\\int \\frac{1}{x+1}\\,\\text{d}x \\\\  & =2\\int \\frac{1}{u}\\,\\text{d}u \\\\  & =2\\operatorname{ln}⁡|u|+C \\\\  & =2\\operatorname{ln}⁡|x+1|+C\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186275429 :knowledge-point/_questions [{:db/id #edb/ref 17592186176059 :knowledge-point/id #uuid "d4b378b0-30e5-59a8-b9f7-882b5e226a2e" :knowledge-point/title "Utilizing the Evenness Property of the Secant Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5853255d-444b-562b-bf17-f13ce1a296c2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{7}}{7}" :db/id #edb/ref 17592186273145} {:answer/id #uuid "60d72189-d83a-5207-899f-d9efeb80163a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{7}" :db/id #edb/ref 17592186273223} {:answer/id #uuid "9e8ce348-c0e6-5db4-aad5-d94aea1f6bd1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\sqrt{7}" :db/id #edb/ref 17592186273756} {:answer/id #uuid "a7a91683-6c61-50b8-ad58-3b8483a81bb0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "7" :db/id #edb/ref 17592186273838} {:answer/id #uuid "e066a281-d3ca-591f-b3a6-a1f3553eab86" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-7" :db/id #edb/ref 17592186274368}] :answer-field/correct {:answer/id #uuid "60d72189-d83a-5207-899f-d9efeb80163a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{7}" :db/id #edb/ref 17592186273223} :answer-field/id #uuid "29c0579e-93c1-5f6a-b530-c6c2b74ddb44" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186274707}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "dc90373f-5a39-5101-be93-517f135c4a77" :question/math-academy-id "q-158049" :question/problem "If $\\operatorname{sec}⁡a=\\sqrt{7},$ then $\\operatorname{sec}⁡(-a+20\\pi )=$" :question/worked-solution "First, let's recall the graph of $y=\\operatorname{sec}⁡x.$\n\n![](images/fb/fbf6ef1ca91f998ab4dc2dda1890ffc8a713f2eeff19e5569351b2466256d63a.png)\n\nFrom the graph, we note the following:\n\n- The period of $\\operatorname{sec}⁡x$ is $2\\pi .$\n\n- Our graph is symmetric about the $y$-axis. This means that $\\operatorname{sec}⁡x$ is an *even* function, and we have\n\n$$\n\\operatorname{sec}⁡(-x)=\\operatorname{sec}⁡x.\n$$\n\nLet's now evaluate our expression:\n\n- Firstly, using the periodicity of $\\operatorname{sec}⁡x,$ we have\n\n$$\n\\begin{aligned}\\operatorname{sec}⁡(-a+20\\pi ) & =\\operatorname{sec}⁡(-a+2\\pi \\cdot 10) \\\\  & =\\operatorname{sec}⁡(-a).\\end{aligned}\n$$\n\n- Secondly, using the evenness of $\\operatorname{sec}⁡x,$ we have\n\n$$\n\\begin{aligned}\\operatorname{sec}⁡(-a) & =\\operatorname{sec}⁡a \\\\  & =\\sqrt{7}.\\end{aligned}\n$$\n\nTherefore, $\\operatorname{sec}⁡(-a+20\\pi )=\\sqrt{7}.$"}] [{:db/id #edb/ref 17592186275432 :knowledge-point/_questions [{:db/id #edb/ref 17592186176061 :knowledge-point/id #uuid "b0251566-4dfc-5786-b00a-ce609e5b2698" :knowledge-point/title "Utilizing the Oddness Property of the Cotangent Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1308c252-3f5f-5a02-be87-52593ac89917" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5}{2}" :db/id #edb/ref 17592186272558} {:answer/id #uuid "33cb8823-ce66-5677-84d7-89e4c81c03e0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{2}{5}" :db/id #edb/ref 17592186272846} {:answer/id #uuid "9ccbdf46-9ee5-5738-a68a-6a4c7e94d746" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2}{5}" :db/id #edb/ref 17592186273746} {:answer/id #uuid "c35f06e3-925e-57a7-8e44-c7ad3fa649fc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186274082} {:answer/id #uuid "e42382ea-4217-5fb3-b74a-833c31fad439" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{5}{2}" :db/id #edb/ref 17592186274404}] :answer-field/correct {:answer/id #uuid "e42382ea-4217-5fb3-b74a-833c31fad439" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{5}{2}" :db/id #edb/ref 17592186274404} :answer-field/id #uuid "d811a9a8-c409-5b01-851f-64933cb4d3b5" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186275015}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "0221b117-6ad9-5a2f-80bb-79e143dc5ca6" :question/math-academy-id "q-158055" :question/problem "If $cot⁡x=\\frac{5}{2},$ then $cot⁡(-x)=$" :question/worked-solution "First, let's recall the graph of $y=cot⁡x.$\n\n![](images/6e/6eb672fe024f024f20c7c3c80947d1b47bade8f998e705d6f411ae3f298ecde2.png)\n\nOur graph has rotational symmetry of order $2$ about the origin. If we rotate the graph ${180}^{∘}$ around the origin, we get the same picture. This means that $cot⁡x$ is an *odd* function, and we have\n\n$$\ncot⁡(-x)=-cot⁡x.\n$$\n\nTherefore, \n\n$$\n\\begin{aligned}cot⁡(-x) & =-cot⁡x \\\\  & =-\\frac{5}{2}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186275434 :knowledge-point/_questions [{:db/id #edb/ref 17592186176057 :knowledge-point/id #uuid "94645507-186a-54a7-a96b-ccfb0fb1f769" :knowledge-point/title "Utilizing the Evenness Property of the Cosine Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "275f4184-6614-5fb5-b945-c0a925615360" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186272735} {:answer/id #uuid "8a7df9b3-60b6-5ef6-8973-d6465d2aa3e2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\pi -\\frac{1}{2}" :db/id #edb/ref 17592186273582} {:answer/id #uuid "8f1e5805-1c6c-5d57-b929-84303eb5f147" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186273626} {:answer/id #uuid "ae068c2c-1302-562e-8e3f-5924d2a8dd0c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\pi " :db/id #edb/ref 17592186273888} {:answer/id #uuid "b395db12-bd50-557e-ae1c-0cff707eab03" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{2}" :db/id #edb/ref 17592186273938}] :answer-field/correct {:answer/id #uuid "b395db12-bd50-557e-ae1c-0cff707eab03" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{2}" :db/id #edb/ref 17592186273938} :answer-field/id #uuid "ea032dc8-afc8-5574-9882-b42bbb63200d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186275047}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "a595d8eb-425e-5670-9569-3c6cc685c869" :question/math-academy-id "q-158059" :question/problem "If $cos⁡x=0,$ then $\\pi cos⁡(-x+18\\pi )-\\frac{1}{2}=$" :question/worked-solution "First, let's recall the graph of $y=cos⁡x.$\n\n![](images/23/2373daf4b5fd26f098bf90e998e2685db6a8b793e94ac9d80b08ea423cb535c0.png)\n\nFrom the graph, we note the following:\n\n- The period of $cos⁡x$ is $2\\pi .$\n\n- Our graph is symmetric over the $y$-axis. This means that $cos⁡x$ is an *even* function, and we have\n\n$$\ncos⁡(-x)=cos⁡x.\n$$\n\nLet's now evaluate our expression:\n\n- Firstly, using the periodicity of $cos⁡x,$ we have\n\n$$\n\\begin{aligned}cos⁡(-x+18\\pi ) & =cos⁡(-x+2\\pi \\cdot 9) \\\\  & =cos⁡(-x).\\end{aligned}\n$$\n\n- Secondly, using the evenness of $cos⁡x,$ we have\n\n$$\n\\begin{aligned}cos⁡(-x) & =cos⁡x \\\\  & =0.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\pi cos⁡(-x+18\\pi )-\\frac{1}{2} & =\\pi \\cdot 0-\\frac{1}{2} \\\\  & =0-\\frac{1}{2} \\\\  & =-\\frac{1}{2}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186275436 :knowledge-point/_questions [{:db/id #edb/ref 17592186176061 :knowledge-point/id #uuid "b0251566-4dfc-5786-b00a-ce609e5b2698" :knowledge-point/title "Utilizing the Oddness Property of the Cotangent Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0b4110e0-8cbe-509f-8768-e57ad22b3e55" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186272490} {:answer/id #uuid "0dfc4511-a4c7-5555-89b3-9b7095440042" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "10" :db/id #edb/ref 17592186272509} {:answer/id #uuid "8fd51020-1a5c-56db-8c08-63b63d83c079" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186273636} {:answer/id #uuid "bf721ced-4517-5626-a108-41e175743956" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186274043} {:answer/id #uuid "e6d362da-9dbc-5d76-bebd-946b5b66ed7d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-9" :db/id #edb/ref 17592186274426}] :answer-field/correct {:answer/id #uuid "0dfc4511-a4c7-5555-89b3-9b7095440042" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "10" :db/id #edb/ref 17592186272509} :answer-field/id #uuid "2b3c6ee6-6e94-558d-95c0-4e54abe1c6d9" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186274710}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "2a79aaf7-1dcc-57ab-a0b7-6d93a2b468da" :question/math-academy-id "q-158064" :question/problem "If $cot⁡x=-6,$ then $\\frac{1}{2}cot⁡(-x+15\\pi )+7=$" :question/worked-solution "First, let's recall the graph of $y=cot⁡x.$\n\n![](images/6e/6eb672fe024f024f20c7c3c80947d1b47bade8f998e705d6f411ae3f298ecde2.png)\n\nFrom the graph, we note the following:\n\n- The period of $cot⁡x$ is $\\pi .$\n\n- Our graph has rotational symmetry of order $2$ about the origin. This means that $cot⁡x$ is an *odd* function, and we have\n\n$$\ncot⁡(-x)=-cot⁡x.\n$$\n\nLet's now evaluate our expression:\n\n- Firstly, using the periodicity of $cot⁡x,$ we have\n\n$$\n\\begin{aligned}cot⁡(-x+15\\pi ) & =cot⁡(-x+\\pi \\cdot 15) \\\\  & =cot⁡(-x).\\end{aligned}\n$$\n\n- Secondly, using the oddness of $cot⁡x,$ we have\n\n$$\n\\begin{aligned}cot⁡(-x) & =-cot⁡x \\\\  & =-(-6) \\\\  & =6.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\frac{1}{2}cot⁡(-x+15\\pi )+7 & =\\frac{1}{2}\\cdot 6+7 \\\\  & =\\frac{6}{2}+7 \\\\  & =3+7 \\\\  & =10.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186275437 :knowledge-point/_questions [{:db/id #edb/ref 17592186176060 :knowledge-point/id #uuid "48a710f9-fed1-5fdb-b4c0-fd3ae2d4d8a4" :knowledge-point/title "Utilizing the Oddness Property of the Cosecant Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1c7814cb-8a14-543c-b191-090e1d7ec186" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{7}{4}" :db/id #edb/ref 17592186272638} {:answer/id #uuid "912d0bf4-9153-5eaf-8129-ed93f063eca1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{4}{11}" :db/id #edb/ref 17592186273648} {:answer/id #uuid "979f59c9-f61f-5d15-890f-5f7e912c17f4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{7}{4}" :db/id #edb/ref 17592186273701} {:answer/id #uuid "e9c841e0-0d84-5ffb-afef-0ed443247d86" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{11}{4}" :db/id #edb/ref 17592186274456} {:answer/id #uuid "fb39b869-1aff-5ccd-a39a-e66bfc83a392" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{11}{4}" :db/id #edb/ref 17592186274590}] :answer-field/correct {:answer/id #uuid "e9c841e0-0d84-5ffb-afef-0ed443247d86" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{11}{4}" :db/id #edb/ref 17592186274456} :answer-field/id #uuid "ca6a7db3-5479-511f-aa28-280da1724856" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186274989}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "990fed19-47aa-5e1c-b060-215e7bc1b3ed" :question/math-academy-id "q-158065" :question/problem "If $\\operatorname{csc}⁡a=\\frac{11}{4},$ then $\\operatorname{csc}⁡(-a)=$" :question/worked-solution "First, let's recall the graph of $y=\\operatorname{csc}⁡x.$\n\n![](images/a8/a8e7894ea970c539ca59a73713fa15450f4361b3fc8bc22183e3fe84946411bd.png)\n\nOur graph has rotational symmetry of order $2$ about the origin. If we rotate the graph ${180}^{∘}$ around the origin, we get the same picture. This means that $\\operatorname{csc}⁡x$ is an *odd* function, and we have\n\n$$\n\\operatorname{csc}⁡(-x)=-\\operatorname{csc}⁡x.\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\operatorname{csc}⁡(-a) & =-\\operatorname{csc}⁡a \\\\  & =-\\frac{11}{4}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186275440 :knowledge-point/_questions [{:db/id #edb/ref 17592186176060 :knowledge-point/id #uuid "48a710f9-fed1-5fdb-b4c0-fd3ae2d4d8a4" :knowledge-point/title "Utilizing the Oddness Property of the Cosecant Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6ce714d8-554b-5354-a70c-c88220f6cb42" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{11}{3}" :db/id #edb/ref 17592186273331} {:answer/id #uuid "a1025211-77b5-5b03-8606-c8562215708e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{6}" :db/id #edb/ref 17592186273783} {:answer/id #uuid "a5e066f7-00a4-56e3-bec2-634660c4b3dd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{17}{3}" :db/id #edb/ref 17592186273822} {:answer/id #uuid "cf0b140a-f05b-50c4-992b-d9f86cd91f5f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{5}{2}" :db/id #edb/ref 17592186274189} {:answer/id #uuid "ed579fc1-af8b-5a45-be91-452681696d91" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{5}{6}" :db/id #edb/ref 17592186274486}] :answer-field/correct {:answer/id #uuid "6ce714d8-554b-5354-a70c-c88220f6cb42" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{11}{3}" :db/id #edb/ref 17592186273331} :answer-field/id #uuid "cbe91a72-b803-5369-bdce-e9dc3475245a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186274992}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "52fb1c00-a770-5c09-ab79-cdf019b59f0c" :question/math-academy-id "q-158071" :question/problem "If $\\operatorname{csc}⁡x=\\frac{7}{6},$ then $4\\operatorname{csc}⁡(-x+6\\pi )+1=$" :question/worked-solution "First, let's recall the graph of $y=\\operatorname{csc}⁡x.$\n\n![](images/a8/a8e7894ea970c539ca59a73713fa15450f4361b3fc8bc22183e3fe84946411bd.png)\n\nFrom the graph, we note the following:\n\n- The period of $\\operatorname{csc}⁡x$ is $2\\pi .$\n\n- Our graph has rotational symmetry of order $2$ about the origin. This means that $\\operatorname{csc}⁡x$ is an *odd* function, and we have\n\n$$\n\\operatorname{csc}⁡(-x)=-\\operatorname{csc}⁡x.\n$$\n\nLet's now evaluate our expression:\n\n- Firstly, using the periodicity of $\\operatorname{csc}⁡x,$ we have\n\n$$\n\\begin{aligned}\\operatorname{csc}⁡(-x+6\\pi ) & =\\operatorname{csc}⁡(-x+2\\pi \\cdot 3) \\\\  & =\\operatorname{csc}⁡(-x).\\end{aligned}\n$$\n\n- Secondly, using the oddness of $\\operatorname{csc}⁡x,$ we have\n\n$$\n\\begin{aligned}\\operatorname{csc}⁡(-x) & =-\\operatorname{csc}⁡x \\\\  & =-\\frac{7}{6}.\\end{aligned}\n$$\n\nTherefore, \n\n$$\n\\begin{aligned}4\\operatorname{csc}⁡(-x+6\\pi )+1 & =4(-\\frac{7}{6})+1 \\\\  & =-\\frac{14}{3}+1 \\\\  & =-\\frac{11}{3}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186275457 :knowledge-point/_questions [{:db/id #edb/ref 17592186059651 :knowledge-point/id #uuid "23637774-8d69-500d-8cb0-5e41a0207542" :knowledge-point/title "Simplifying Rational Expressions Using an Alternate Form of the Pythagorean Identity"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "43fdec51-bb15-58a1-ac35-a4628bdaa895" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186272966} {:answer/id #uuid "7bc399b8-24ed-566b-807a-98321753ba77" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186273449} {:answer/id #uuid "c672699b-78d4-5fd4-9230-acc5ec657314" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{2}" :db/id #edb/ref 17592186274108} {:answer/id #uuid "e7b57a70-f0e5-5f77-8a9c-b1e730d2744a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186274436} {:answer/id #uuid "e9793388-0d77-54db-82ac-a9919ac4db9c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186274452}] :answer-field/correct {:answer/id #uuid "43fdec51-bb15-58a1-ac35-a4628bdaa895" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186272966} :answer-field/id #uuid "80c6b84b-18ea-5a42-80cf-65bc4466c515" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186274854}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "d8d55196-4015-578e-afc9-4c54361316e6" :question/math-academy-id "q-1583" :question/problem "$\\frac{1}{{cos}^{2}⁡A}-\\frac{1}{{cot}^{2}⁡A}=$" :question/worked-solution "First, we use the definition of $\\operatorname{cot}⁡A$ to rewrite the second term:\n\n$$\n\\begin{aligned}\\frac{1}{{cos}^{2}⁡A}-\\frac{1}{{cot}^{2}⁡A} & =\\frac{1}{{cos}^{2}⁡A}-{tan}^{2}⁡A \\\\  & =\\frac{1}{{cos}^{2}⁡A}-\\frac{{sin}^{2}⁡A}{{cos}^{2}⁡A} \\\\  & =\\frac{1-{sin}^{2}⁡A}{{cos}^{2}⁡A}\\end{aligned}\n$$\n\nNow, we can use the identity $1-{sin}^{2}⁡A={cos}^{2}⁡A$:\n\n$$\n\\begin{aligned}\\frac{1-{sin}^{2}⁡A}{{cos}^{2}⁡A} & =\\frac{{cos}^{2}⁡A}{{cos}^{2}⁡A}=1\\end{aligned}\n$$\n\nTherefore, we conclude that:\n\n$$\n\\frac{1}{{cos}^{2}⁡A}-\\frac{1}{{cot}^{2}⁡A}=1\n$$"}] [{:db/id #edb/ref 17592186278256 :knowledge-point/_questions [{:db/id #edb/ref 17592186087847 :knowledge-point/id #uuid "64cd3ef1-6d41-50c6-b09d-cb709d89281f" :knowledge-point/title "Calculating the Product of a Complex Number and Its Conjugate"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4ad4c242-5100-5001-bbf2-14af7ad8a88e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "90" :db/id #edb/ref 17592186276136} {:answer/id #uuid "67bacfa4-b2c2-5dbf-ad5b-83815a9bf78a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "81" :db/id #edb/ref 17592186276405} {:answer/id #uuid "68f08005-6fd5-5cb7-985f-df65b93a27a3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "12" :db/id #edb/ref 17592186276421} {:answer/id #uuid "9755f0c3-83bf-5c35-8244-3f96fda89a5d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "12\\text{i}" :db/id #edb/ref 17592186276837} {:answer/id #uuid "eb1e92ef-5e38-51fa-88c2-36429f6dcafd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "18\\text{i}" :db/id #edb/ref 17592186277531}] :answer-field/correct {:answer/id #uuid "4ad4c242-5100-5001-bbf2-14af7ad8a88e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "90" :db/id #edb/ref 17592186276136} :answer-field/id #uuid "02caf819-53ad-50d7-90fb-0558ee92f886" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186277729}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "ba737df7-5524-50ff-9af1-1507a3bfabf5" :question/math-academy-id "q-159758" :question/problem "Given that $z=9+3\\text{i},$ calculate $z\\overset{―}{z}.$" :question/worked-solution "**Method 1**\n\nWhen we multiply a complex number and its conjugate, the result is always the sum of squares of the real part and the imaginary part.\n\nFor the given complex number $z=9+3\\text{i},$ the real part is $\\text{Re}(z)=9,$ and the imaginary part is $\\text{Im}(z)=3,$ so we have\n\n$$\n\\begin{aligned}z\\overset{―}{z} & =(\\text{Re}(z))^{2}+(\\text{Im}(z))^{2} \\\\  & ={9}^{2}+{3}^{2} \\\\  & =81+9 \\\\  & =90.\\end{aligned}\n$$\n\n**Method 2**\n\nAlternatively, we can actually carry out the process of multiplying the complex number and its conjugate.\n\nTo obtain the conjugate of the complex number $z=9+3\\text{i},$ we flip the sign of the imaginary part and get $\\overset{―}{z}=9-3\\text{i}.$\n\nMultiplying, we get\n\n$$\n\\begin{aligned}z\\overset{―}{z} & =(9+3\\text{i})(9-3\\text{i}) \\\\  & ={9}^{2}+(9)(3)\\text{i}+(-3)(9)\\text{i}-{\\text{i}}^{2}(3)^{2} \\\\  & =81+27\\text{i}-27\\text{i}-(-1)(9) \\\\  & =81+9 \\\\  & =90.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186278271 :knowledge-point/_questions [{:db/id #edb/ref 17592186115305 :knowledge-point/id #uuid "b346e7e1-b641-5a97-9677-84a0ff6ab2dc" :knowledge-point/title "Finding Missing Values in a Data Set Given the Mean"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1ed36547-96e7-5784-9a0e-cef5f230e794" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "12" :db/id #edb/ref 17592186275755} {:answer/id #uuid "60b2eba2-e4ea-55fb-b0a5-7949921702ae" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "15" :db/id #edb/ref 17592186276344} {:answer/id #uuid "90863935-708d-5d8a-9767-701612197aa6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "14" :db/id #edb/ref 17592186276786} {:answer/id #uuid "a7774b83-c8c2-533c-9b91-ea243dc329ac" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "16" :db/id #edb/ref 17592186276988} {:answer/id #uuid "b652cf44-f298-51b1-9814-ea015f204d32" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "10" :db/id #edb/ref 17592186277099}] :answer-field/correct {:answer/id #uuid "a7774b83-c8c2-533c-9b91-ea243dc329ac" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "16" :db/id #edb/ref 17592186276988} :answer-field/id #uuid "bba5517c-87f3-5296-8e79-3699c931499e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186278056}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "88fbb37a-350b-51de-9b64-f5ff2acb9c93" :question/math-academy-id "q-160026" :question/problem "Given that the mean of the following data set is $10,$ find the value of $b:$ \n\n$$\nb,\\,1,\\,b,\\,1,\\,b\n$$" :question/worked-solution "If we have a data set that consists of the points ${x}_{1},{x}_{2},…,{x}_{n},$ then the mean is denoted by $\\overset{―}{x}$ and is given by the following formula:\n\n$$\n\\overset{―}{x}=\\frac{1}{n}{\\sum }_{i=1}^{n}{x}_{i}\n$$\n\nHere, there are $n=5$ data points. Adding up all the points in the data set, we get\n\n$$\n\\begin{aligned}{\\sum }_{i=1}^{5}{x}_{i} & =b+1+b+1+b \\\\  & =2+3b.\\end{aligned}\n$$\n\nTherefore, the mean is given by the expression\n\n$$\n\\begin{aligned}\\overset{―}{x} & =\\frac{1}{n}{\\sum }_{i=1}^{n}{x}_{i} \\\\  & =\\frac{1}{5}\\cdot (2+3b) \\\\  & =\\frac{2+3b}{5}.\\end{aligned}\n$$\n\nFinally, since we're told that $\\overset{―}{x}=10,$ we have\n\n$$\n\\begin{aligned}10 & =\\frac{2+3b}{5} \\\\ 50 & =2+3b \\\\ 48 & =3b \\\\ b & =16.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186278272 :knowledge-point/_questions [{:db/id #edb/ref 17592186115305 :knowledge-point/id #uuid "b346e7e1-b641-5a97-9677-84a0ff6ab2dc" :knowledge-point/title "Finding Missing Values in a Data Set Given the Mean"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2b5e32c7-6b89-5822-855f-1dfb6a5a9745" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "18" :db/id #edb/ref 17592186275870} {:answer/id #uuid "2d86a5a3-7293-5268-b8e4-2c73a0117d10" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "13" :db/id #edb/ref 17592186275888} {:answer/id #uuid "4248bdf2-7c80-5f67-8d39-490fc7fd9035" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "10" :db/id #edb/ref 17592186276057} {:answer/id #uuid "6a4c24fa-3a89-5653-8566-bcbe05f0a9ba" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "12" :db/id #edb/ref 17592186276432} {:answer/id #uuid "ff2ae68b-d06f-52a1-8b62-ccf349b47446" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "15" :db/id #edb/ref 17592186277719}] :answer-field/correct {:answer/id #uuid "ff2ae68b-d06f-52a1-8b62-ccf349b47446" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "15" :db/id #edb/ref 17592186277719} :answer-field/id #uuid "fe8dea39-9fe7-5d93-8b7f-3596ae2988dd" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186278175}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "2ae95412-5543-5cd6-a29d-d4219b71ef9a" :question/math-academy-id "q-160028" :question/problem "Given that the mean of the following data set is $11,$ find the value of $c:$ \n\n$$\n(c-3),\\,6,\\,3,\\,c,\\,10,\\,20\n$$" :question/worked-solution "If we have a data set that consists of the points ${x}_{1},{x}_{2},…,{x}_{n},$ then the mean is denoted by $\\overset{―}{x}$ and is given by the following formula:\n\n$$\n\\overset{―}{x}=\\frac{1}{n}{\\sum }_{i=1}^{n}{x}_{i}\n$$\n\nHere, there are $n=6$ data points. Adding up all the points in the data set, we get\n\n$$\n\\begin{aligned}{\\sum }_{i=1}^{6}{x}_{i} & =(c-3)+6+3+c+10+20 \\\\  & =36+2c\\end{aligned}\n$$\n\nTherefore, the mean is given by the expression\n\n$$\n\\begin{aligned}\\overset{―}{x} & =\\frac{1}{n}{\\sum }_{i=1}^{n}{x}_{i} \\\\  & =\\frac{1}{6}\\cdot (36+2c) \\\\  & =\\frac{36+2c}{6}.\\end{aligned}\n$$\n\nFinally, since we're told that $\\overset{―}{x}=11,$ we have\n\n$$\n\\begin{aligned}11 & =\\frac{36+2c}{6} \\\\ 66 & =36+2c \\\\ 30 & =2c \\\\ c & =15.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186278276 :knowledge-point/_questions [{:db/id #edb/ref 17592186115304 :knowledge-point/id #uuid "adfc527d-4347-5741-a81c-fa91c50d5d74" :knowledge-point/title "Computing the Mean of a Data Set"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5be0bc62-d602-5b32-8a2e-36d125dbe0bf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "12" :db/id #edb/ref 17592186276301} {:answer/id #uuid "c0a1d8a5-8c5d-5e57-a888-62ddebfefa97" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "10" :db/id #edb/ref 17592186277188} {:answer/id #uuid "e71d3129-f92a-5c5b-837b-240366c795c7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "9.5" :db/id #edb/ref 17592186277496} {:answer/id #uuid "faed2406-8996-50c6-b0ef-9ef87571e4b2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "11.5" :db/id #edb/ref 17592186277675} {:answer/id #uuid "fcb5e3e3-e49d-5444-9e56-c411ae1a8e1a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "11" :db/id #edb/ref 17592186277691}] :answer-field/correct {:answer/id #uuid "c0a1d8a5-8c5d-5e57-a888-62ddebfefa97" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "10" :db/id #edb/ref 17592186277188} :answer-field/id #uuid "ad91c49c-4a4d-571c-acb9-c533b9863422" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186278024}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "b4975910-186b-51eb-8386-78fc12db0a69" :question/math-academy-id "q-160052" :question/problem "A college basketball player scored the following number of points in the last five games he played:\n\n$$\n9,\\,11,\\,12,\\,8,\\,10\n$$\n\nWhat is the mean of these scores?" :question/worked-solution "If we have a data set that consists of the points ${x}_{1},{x}_{2},…,{x}_{n},$ then the mean is denoted by $\\overset{―}{x}$ and is given by the following formula:\n\n$$\n\\overset{―}{x}=\\frac{1}{n}{\\sum }_{i=1}^{n}{x}_{i}\n$$\n\nHere, there are $n=5$ data points. Adding up all the points in the data set, we get\n\n$$\n\\begin{aligned}{\\sum }_{i=1}^{5}{x}_{i} & =9+11+12+8+10 \\\\  & =50.\\end{aligned}\n$$\n\nTherefore, the mean is\n\n$$\n\\begin{aligned}\\overset{―}{x} & =\\frac{1}{n}{\\sum }_{i=1}^{n}{x}_{i} \\\\  & =\\frac{1}{5}\\cdot 50 \\\\  & =10.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186278277 :knowledge-point/_questions [{:db/id #edb/ref 17592186115304 :knowledge-point/id #uuid "adfc527d-4347-5741-a81c-fa91c50d5d74" :knowledge-point/title "Computing the Mean of a Data Set"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0e67b2a5-0f28-5b12-888c-9ffba56fdcc9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186275597} {:answer/id #uuid "53c635b2-f846-551d-b578-e72691826950" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186276220} {:answer/id #uuid "67146a85-6286-573e-a37d-2c1c8f8de67c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5.5" :db/id #edb/ref 17592186276398} {:answer/id #uuid "c72cf84a-4573-550f-a9d6-4a4ad1b52ddf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186277247} {:answer/id #uuid "e5554f5b-a5a2-59e4-88ec-a1c9997632f1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6.8" :db/id #edb/ref 17592186277480}] :answer-field/correct {:answer/id #uuid "53c635b2-f846-551d-b578-e72691826950" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186276220} :answer-field/id #uuid "23112a7c-974e-57c0-ab45-efd0be8b2843" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186277785}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "ac9d78d0-acf8-5125-b9f8-810932b0249e" :question/math-academy-id "q-160054" :question/problem "A car salesman has sold the following quantities of a particular model of car in the last few weeks:\n\n$$\n3,\\,5,\\,6,\\,8,\\,5,\\,3\n$$\n\nWhat is the mean of these figures?" :question/worked-solution "If we have a data set that consists of the points ${x}_{1},{x}_{2},…,{x}_{n},$ then the mean is denoted by $\\overset{―}{x}$ and is given by the following formula:\n\n$$\n\\overset{―}{x}=\\frac{1}{n}{\\sum }_{i=1}^{n}{x}_{i}\n$$\n\nHere, there are $n=6$ data points. Adding up all the points in the data set, we get\n\n$$\n\\begin{aligned}{\\sum }_{i=1}^{6}{x}_{i} & =3+5+6+8+5+3 \\\\  & =30.\\end{aligned}\n$$\n\nTherefore, the mean is\n\n$$\n\\begin{aligned}\\overset{―}{x} & =\\frac{1}{n}{\\sum }_{i=1}^{n}{x}_{i} \\\\  & =\\frac{1}{6}\\cdot 30 \\\\  & =5.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186278383 :knowledge-point/_questions [{:db/id #edb/ref 17592186105904 :knowledge-point/id #uuid "cafdb077-0e02-5e7a-bf78-c3a8aacfb6f7" :knowledge-point/title "Calculating an Angle or Side of a Triangle Given the Area of a Triangle"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1a92871f-5bd5-581e-ac06-dbd13021c053" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "7\\,\\text{cm}" :db/id #edb/ref 17592186275724} {:answer/id #uuid "299f96e2-93fa-5d8f-ab41-fc313dbd3222" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "7.5\\,\\text{cm}" :db/id #edb/ref 17592186275854} {:answer/id #uuid "4f831c2c-96bc-514e-94a8-9c7ae9a2e9a3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6\\,\\text{cm}" :db/id #edb/ref 17592186276188} {:answer/id #uuid "7bb62d91-e7c1-5a0b-9594-0da656f39663" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6.5\\,\\text{cm}" :db/id #edb/ref 17592186276601} {:answer/id #uuid "a89eff61-0284-58bc-8453-86df1e739eb6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8\\,\\text{cm}" :db/id #edb/ref 17592186276998}] :answer-field/correct {:answer/id #uuid "1a92871f-5bd5-581e-ac06-dbd13021c053" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "7\\,\\text{cm}" :db/id #edb/ref 17592186275724} :answer-field/id #uuid "e821e218-a2a4-5efe-86d2-0f9a4556c28f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186278132}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "43fd23a0-08b8-58ee-b7e6-43240cfa05d7" :question/math-academy-id "q-161109" :question/problem "![](images/b9/b95571772af958b4f7b7dcdbba630b78e029c838340dc272809a6c7915dc9c90.png)\n\nThe area of ​​the triangle $△ABC$ is $\\frac{21\\sqrt{2}}{2}{\\text{ cm}}^{2}.$ Find $AC.$" :question/worked-solution "The formula for the area of the triangle is \n\n$$\nA=\\frac{1}{2}bc\\operatorname{sin}⁡A,\n$$\n\nwhere $∠A$ is between the sides of lengths $b$ and $c.$ \n\nHere\n\n$$\n\\begin{aligned}c & =AB=6\\text{ cm}, \\\\ b & =AC, \\\\ m∠A & ={45}^{∘}.\\end{aligned}\n$$\n\nSince \n\n$$\n\\operatorname{sin}⁡{45}^{∘}=\\frac{\\sqrt{2}}{2},\n$$\n\nwe can calculate $b=AC,$ as follows:\n\n$$\n\\begin{aligned}A & =\\frac{1}{2}\\cdot b\\cdot c\\cdot \\operatorname{sin}⁡A \\\\ \\frac{21\\sqrt{2}}{2} & =\\frac{1}{2}\\cdot b\\cdot 6\\cdot \\operatorname{sin}⁡{45}^{∘} \\\\ \\frac{21\\sqrt{2}}{2} & =\\frac{1}{2}\\cdot b\\cdot 6\\cdot (\\frac{\\sqrt{2}}{2}) \\\\ \\frac{21\\sqrt{2}}{2} & =\\frac{3\\sqrt{2}\\,b}{2} \\\\ \\frac{21\\cancel{\\sqrt{2}}}{\\cancel{2}} & =\\frac{3\\cancel{\\sqrt{2}}\\,b}{\\cancel{2}} \\\\ 3b & =21 \\\\ b & =7\\text{ cm}.\\end{aligned}\n$$\n\nWe conclude that $AC=7\\,\\text{cm}.$"}] [{:db/id #edb/ref 17592186278534 :knowledge-point/_questions [{:db/id #edb/ref 17592186068859 :knowledge-point/id #uuid "26571ec1-e645-5f07-ba4e-75c22558394a" :knowledge-point/title "Evaluating a Three-Component Vector-Valued Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "316c6519-33d0-5d06-8c56-11f7bf0b4373" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}0 \\\\ 5 \\\\ -9\\end{aligned}]" :db/id #edb/ref 17592186275916} {:answer/id #uuid "5ee1594c-242f-5c6e-8ccb-7753c2f977cb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 \\\\ 10 \\\\ 11\\end{aligned}]" :db/id #edb/ref 17592186276326} {:answer/id #uuid "87b72340-754d-5c38-825f-f706fe102839" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}0 \\\\ 25 \\\\ -9\\end{aligned}]" :db/id #edb/ref 17592186276702} {:answer/id #uuid "a81d69a1-0e67-528e-a140-9b036a2f9545" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 \\\\ 25 \\\\ 9\\end{aligned}]" :db/id #edb/ref 17592186276995} {:answer/id #uuid "bbe6423b-37c2-58f2-9d91-6a6e0ba76b6f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}\\operatorname{ln}⁡4 \\\\ 10 \\\\ 9\\end{aligned}]" :db/id #edb/ref 17592186277148}] :answer-field/correct {:answer/id #uuid "87b72340-754d-5c38-825f-f706fe102839" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}0 \\\\ 25 \\\\ -9\\end{aligned}]" :db/id #edb/ref 17592186276702} :answer-field/id #uuid "222d139b-3747-5f53-a722-938109511712" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186277783}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "10894d9f-77c7-5720-8c2d-f5aa520bb510" :question/math-academy-id "q-161507" :question/problem "What is the value of $f(t)=[\\begin{aligned}\\operatorname{ln}⁡(t-4) \\\\ 5t \\\\ 1-2t\\end{aligned}]$ at $t=5?$" :question/worked-solution "To evaluate, we substitute $t=5$ into the function, as follows:\n\n$$\n\\begin{aligned}f(5) & =[\\begin{aligned}\\operatorname{ln}⁡(5-4) \\\\ 5(5) \\\\ 1-2(5)\\end{aligned}] \\\\  & =[\\begin{aligned}\\operatorname{ln}⁡1 \\\\ {5}^{2} \\\\ 1-10\\end{aligned}] \\\\  & =[\\begin{aligned}0 \\\\ 25 \\\\ -9\\end{aligned}]\\end{aligned}\n$$\n\nSo the value of $f(t)$ at $t=5$ is the vector $[\\begin{aligned}0 \\\\ 25 \\\\ -9\\end{aligned}].$"}] [{:db/id #edb/ref 17592186389223 :knowledge-point/_questions [{:db/id #edb/ref 17592186087721 :knowledge-point/id #uuid "e0dc11d5-8eda-52b1-b7b1-42b481813ff4" :knowledge-point/title "Graphing a Curve Defined Parametrically"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e9372202-4293-501e-b9c6-fc83f9060b82" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/1e/1e44005cfe46b507a2b02eec16db0a724c5844497b993fe0d2f7d16fcc758b1c.png" :db/id #edb/ref 17592186389225} {:answer/id #uuid "d106a59b-3d70-5c0f-a823-6ee899c7b211" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/21/21cb936268e88d0e69e8244c6429cf8e6dd4881cc471c3496290b9f2eb233efe.png" :db/id #edb/ref 17592186389226} 