 #edb/ref 17592186401915 :knowledge-point/_questions [{:db/id #edb/ref 17592186068900 :knowledge-point/id #uuid "66ade855-4b16-514b-b44a-1d6b9d61ef28" :knowledge-point/title "Identifying the Shift Applied to an Exponential Decay Curve"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3c3666f3-ba98-51a9-b678-f25e043d3a37" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y={(\\frac{1}{9})}^{x}+3.5" :db/id #edb/ref 17592186401917} {:answer/id #uuid "e8039e0c-f293-5ce4-b395-a4064a0685bd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y={(\\frac{1}{9})}^{x}-2.5" :db/id #edb/ref 17592186401918} {:answer/id #uuid "a5f24666-89d0-5332-bb2a-21f966094be5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y={(\\frac{1}{9})}^{x}-3.5" :db/id #edb/ref 17592186401919} {:answer/id #uuid "a479a80c-f0e1-5b4f-9f67-06b99cd086bd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y={(\\frac{1}{9})}^{x}+1.5" :db/id #edb/ref 17592186401920} {:answer/id #uuid "266f8f59-63e6-5980-a4b9-749b4fb8201c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y={(\\frac{1}{9})}^{x}+2.5" :db/id #edb/ref 17592186401921}] :answer-field/correct {:answer/id #uuid "266f8f59-63e6-5980-a4b9-749b4fb8201c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y={(\\frac{1}{9})}^{x}+2.5" :db/id #edb/ref 17592186401921} :answer-field/id #uuid "828a7f8a-1289-571e-8aa4-3a396be14d44" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186401916}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "6948e752-4360-51fe-b06f-c6885f4f282f" :question/math-academy-id "q-27482" :question/problem "![](images/c0/c091fc5d742ddca3090725974f00ff7da77b1530d601bb82e288518b27970b0a.png)\n\nThe graph above shows the curve $y={(\\frac{1}{9})}^{x}+c.$ Determine the value of $c$ and find the equation of the curve." :question/worked-solution "The horizontal asymptote of $y={(\\frac{1}{9})}^{x}$ is $y=0.$\n\nThe vertical translation $y={(\\frac{1}{9})}^{x}+c$ shifts the asymptote to $y=c.$\n\nIn the graph above, the horizontal asymptote is $y=2.5.$ Therefore, $c=2.5.$"}] [{:db/id #edb/ref 17592186390538 :knowledge-point/_questions [{:db/id #edb/ref 17592186068830 :knowledge-point/id #uuid "617f0fe6-7998-5d77-b11f-55a0eca11440" :knowledge-point/title "Identifying a Vertically Shifted and Stretched Exponential Decay Curve"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "11991a9d-264d-57e7-9fdd-da7348694651" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/77/77ddeefbcbd24c80f6ed0bb7a29d2a43e3151436b0a60b56686b1c67ca31c738.png" :db/id #edb/ref 17592186390540} {:answer/id #uuid "f32fd0b0-49ce-539d-9672-8d020e261fbb" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/f7/f73be44a90c4a240b316bcf7ac5586b54ed1ca4cdedfac42f055cd39086ffe2d.png" :db/id #edb/ref 17592186390541} {:answer/id #uuid "407fad6c-67c3-5a63-bb5b-a49d0b7c8b56" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/f4/f405cfe76e1d69d7ecad35e96ced1c76c1b64130a118d881d331bcb0b119068c.png" :db/id #edb/ref 17592186390542} {:answer/id #uuid "a9519e6c-79f2-5f62-a983-2670eb2a7aba" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/33/33f78e0590a7039f0e2e17d5bc871e0503dd3526d282b5fb76e4ef0f3b78cc28.png" :db/id #edb/ref 17592186390543} {:answer/id #uuid "29d4d4e8-fe84-544d-8606-3bfce7839133" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/9d/9d332fa8d3d8ef65daaf34bf906c5ca7cd7e2edaf562386ed4e0ebc4555b0a64.png" :db/id #edb/ref 17592186390544}] :answer-field/correct {:answer/id #uuid "29d4d4e8-fe84-544d-8606-3bfce7839133" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/9d/9d332fa8d3d8ef65daaf34bf906c5ca7cd7e2edaf562386ed4e0ebc4555b0a64.png" :db/id #edb/ref 17592186390544} :answer-field/id #uuid "49a74683-a726-5cb6-b2c2-b253e72cf78d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186390539}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "b5e7ffcf-d49d-5dfe-9c73-ca9c0369ba7d" :question/math-academy-id "q-27538" :question/problem "Which of the following is the graph of  $y=3{(\\frac{1}{6})}^{x}-1?$" :question/worked-solution "We start with plotting the graph of $y={(\\frac{1}{6})}^{x}:$\n\n![](images/4c/4cdc9e4fa78513bca01fa10242ba6c3f12b31c262448a8edf350c76e84b188b8.png)\n\nNext, we plot the graph of $y=3{(\\frac{1}{6})}^{x}.$ To do this, we scale the graph above by a factor of $3.$ The $y$-intercept moves from $(0,1)$ to $(0,3)$ but the horizontal asymptote stays at $y=0.$\n\n![](images/8e/8e7d6c5eb931f55a9f94ac33382c0e1ec9e9e49f50b3ab538d9848d6a77be665.png)\n\nFinally, we plot the graph of $y=3{(\\frac{1}{6})}^{x}-1.$ To do this, we shift the above graph $1$ unit down. The $y$-intercept moves from $(0,3)$ to $(0,2)$ and the horizontal asymptote moves from $y=0$ to $y=-1.$\n\n![](images/9d/9d332fa8d3d8ef65daaf34bf906c5ca7cd7e2edaf562386ed4e0ebc4555b0a64.png)"}] [{:db/id #edb/ref 17592186390545 :knowledge-point/_questions [{:db/id #edb/ref 17592186068830 :knowledge-point/id #uuid "617f0fe6-7998-5d77-b11f-55a0eca11440" :knowledge-point/title "Identifying a Vertically Shifted and Stretched Exponential Decay Curve"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0f70e31a-a6d8-57be-8930-fe9e46798cf1" :answer/type {:db/id #edb/ref 17592186045497 :db/ident 