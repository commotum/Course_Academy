#{[{:db/id #edb/ref 17592186253474 :knowledge-point/_questions [{:db/id #edb/ref 17592186059763 :knowledge-point/id #uuid "64edd709-3f6c-59e1-ae1f-bca25eca0483" :knowledge-point/title "Identifying the Reflection of a Sine Curve Over the Horizontal Axis"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4755537d-9558-58e3-b1fb-e15adf27ad35" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=-sin⁡(x-\\frac{1}{4})" :db/id #edb/ref 17592186251146} {:answer/id #uuid "4f6bddc5-a5cd-5875-abbb-9f22efb60464" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=-sin⁡(\\frac{x}{4})" :db/id #edb/ref 17592186251203} {:answer/id #uuid "6b736f08-32b3-5af6-a82e-5816f1c230a0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=\\frac{1}{4}-sin⁡x" :db/id #edb/ref 17592186251431} {:answer/id #uuid "790ade44-b249-5c2c-8b0f-5e62399db5ad" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=-\\frac{1}{4}sin⁡x" :db/id #edb/ref 17592186251558} {:answer/id #uuid "cdec9314-5fd3-5b0f-8a26-a6c75f8c9e96" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=-sin⁡x-\\frac{1}{4}" :db/id #edb/ref 17592186252370}] :answer-field/correct {:answer/id #uuid "790ade44-b249-5c2c-8b0f-5e62399db5ad" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=-\\frac{1}{4}sin⁡x" :db/id #edb/ref 17592186251558} :answer-field/id #uuid "5268f851-1f31-5f10-a461-a1a9a49c25a0" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186252950}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "c5a416a1-a537-5d81-9140-46bc32e0a299" :question/math-academy-id "q-118350" :question/problem "![](images/a0/a065146d50b16eade39c758b59e13994272cf7180aaa662008a1865e4160421e.png)\n\nWhat is the equation of the graph shown above?" :question/worked-solution "![](images/46/46e8f92e758c7f4643b64c05d0b457f7b99b6723ddf9be9cd63da28079b89618.png)\n\nTo plot the given curve, we follow these steps:\n\n- Start with the graph of $y=sin⁡x.$\n\n- Then, reflect it in the $x$-axis to give $y=-sin⁡x.$\n\n- Finally, compress it parallel to the $y$-axis by a stretch factor of $\\frac{1}{4}$ to give $y=-\\frac{1}{4}sin⁡x.$\n\nTherefore, the given curve is the graph of $y=-\\frac{1}{4}sin⁡x.$"}] [{:db/id #edb/ref 17592186398186 :knowledge-point/_questions [{:db/id #edb/ref 17592186059764 :knowledge-point/id #uuid "85090bdf-4f1b-5f79-a751-48521ad98895" :knowledge-point/title "Identifying the Reflection of a Sine or Cosine Curve Over the Vertical Axis"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "bddbf7dd-8781-50a4-b250-66fd8e233371" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=\\frac{1}{5}sin⁡(-x)" :db/id #edb/ref 17592186398188} {:answer/id #uuid "7f35edde-ed58-55bc-8274-99043f11903d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=sin⁡(-x)-5" :db/id #edb/ref 17592186398189} {:answer/id #uuid "e98140d9-64d1-5b2b-87eb-6cb37aace0e8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=sin⁡(-\\frac{x}{5})" :db/id #edb/ref 17592186398190} {:answer/id #uuid "1866cc81-a61e-52b4-828e-7f095d95514b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=sin⁡(-5x)" :db/id #edb/ref 17592186398191} {:answer/id #uuid "76a9807d-df1a-5832-b429-0890d06c222f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=5sin⁡(-x)" :db/id #edb/ref 17592186398192}] :answer-field/correct {:answer/id #uuid "76a9807d-df1a-5832-b429-0890d06c222f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=5sin⁡(-x)" :db/id #edb/ref 17592186398192} :answer-field/id #uuid "0aeaedd6-8135-5962-8437-2a69c460095e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186398187}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "e694bf71-afc9-51ff-82ce-ddde47237115" :question/math-academy-id "q-118442" :question/problem "![](images/99/997eb5cc08dcff78cb32f5b47b5d066546854b05f3b066953772e456e713d773.png)\n\nWhich of the following equations could be used to describe the graph shown above?" :question/worked-solution "![](images/1e/1e532c806d81c3c4015d78f814dc4ea3fc3483f22d34ade385894df2e8e7e3c5.png)\n\nTo plot the given curve, we follow these steps:\n\n- Start with the graph of $y=sin⁡x.$\n\n- Then, reflect it across the $y$-axis.\n\n- Finally, stretch it parallel to the $y$-axis by a stretch factor of $5.$\n\nTherefore, the given curve is the graph of $y=5sin⁡(-x).$\n\nNotice that, because the sine function is odd, the $y$-axis reflection has the same effect as the $x$-axis reflection, i.e.,\n\n$$\n5sin⁡(-x)=-5sin⁡x.\n$$\n\nSo the graph could also be viewed as $y=-5sin⁡x.$ However, $y=-5sin⁡x$ is not among the given options."}] [{:db/id #edb/ref 17592186398193 :knowledge-point/_questions [{:db/id #edb/ref 17592186059764 :knowledge-point/id #uuid "85090bdf-4f1b-5f79-a751-48521ad98895" :knowledge-point/title "Identifying the Reflection of a Sine or Cosine Curve Over the Vertical Axis"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "62375a92-edd9-5873-9edf-ef0ddd9dccaf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=6sin⁡(-x)" :db/id #edb/ref 17592186398195} {:answer/id #uuid "1f1a872d-3b88-5a7f-8b75-ab249c2d63b9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=sin⁡(-x)+6" :db/id #edb/ref 17592186398196} {:answer/id #uuid "839a4786-7b8b-587f-884b-34a3e1fb530a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=sin⁡(-\\frac{x}{6})" :db/id #edb/ref 17592186398197} {:answer/id #uuid "fbef0156-6d81-5b0b-80b2-e4c086df567d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=\\frac{1}{6}sin⁡(-x)" :db/id #edb/ref 17592186398198} {:answer/id #uuid "ab0aa795-c7d5-534e-922f-0ead75cd6cdc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=sin⁡(-6x)" :db/id #edb/ref 17592186398199}] :answer-field/correct {:answer/id #uuid "62375a92-edd9-5873-9edf-ef0ddd9dccaf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=6sin⁡(-x)" :db/id #edb/ref 17592186398195} :answer-field/id #uuid "1f0f56dd-8c86-5cbb-8889-d10079bd9452" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186398194}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "ef71e5dd-2133-5139-bcc4-313a9e867ac5" :question/math-academy-id "q-118443" :question/problem "![](images/f0/f012ee5880b4ec6c4c2cad4aa44da672b789f21c7f9969dcec50a25596e47c4b.png)\n\nWhich of the following equations could be used to describe the graph shown above?" :question/worked-solution "![](images/bc/bc61bf27fb210e0dc849829d5c287936fcb3f73bc279e98af8a64ba4085b8309.png)\n\nTo plot the given curve, we follow these steps:\n\n- Start with the graph of $y=sin⁡x.$\n\n- Then, reflect it across the $y$-axis.\n\n- Finally, stretch it parallel to the $y$-axis by a stretch factor of $6.$\n\nTherefore, the given curve is the graph of $y=6sin⁡(-x).$\n\nNotice that, because the sine function is odd, the $y$-axis reflection has the same effect as the $x$-axis reflection, i.e.,\n\n$$\n6sin⁡(-x)=-6sin⁡x.\n$$\n\nSo the graph could also be viewed as $y=-6sin⁡x.$ However, $y=-6sin⁡x$ is not among the given options."}] [{:db/id #edb/ref 17592186253480 :knowledge-point/_questions [{:db/id #edb/ref 17592186059765 :knowledge-point/id #uuid "1fe335eb-dc4a-5ea0-83cf-ad929e19b908" :knowledge-point/title "Identifying the Reflection and Shifting of a Sine or Cosine Curve"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "31777cec-aa4a-531c-8f91-1af7a0f66a13" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=-cos⁡x" :db/id #edb/ref 17592186250973} {:answer/id #uuid "3c737870-c937-5be1-9306-cc57cf97a411" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=-sin⁡x-1" :db/id #edb/ref 17592186251056} {:answer/id #uuid "4c303ce3-dff7-58a3-b70c-6bed684870f3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=-cos⁡x-1" :db/id #edb/ref 17592186251183} {:answer/id #uuid "b4c0f728-a1b5-55fd-890b-dbd31577858c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=sin⁡(1-x)" :db/id #edb/ref 17592186252145} {:answer/id #uuid "e3100428-23e3-5316-a71c-cc8576b92026" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=-sin⁡(1-x)" :db/id #edb/ref 17592186252551}] :answer-field/correct {:answer/id #uuid "3c737870-c937-5be1-9306-cc57cf97a411" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=-sin⁡x-1" :db/id #edb/ref 17592186251056} :answer-field/id #uuid "011a22c2-f8f2-5ad2-9c5f-c7e5ef1ebd65" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186252807}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "e1484f94-afd5-5ba7-9351-7b1e33dca84c" :question/math-academy-id "q-118450" :question/problem "![](images/98/98e3dc2a664f5096d2b7c9ba7bf7fc56faa189cd573a3de462e0b249fbc90af6.png)\n\nIdentify the equation that generated the graph above." :question/worked-solution "![](images/84/8499856915baa0bf144561dd35143e024586f4d417ac4f9c1ee48d7586e0f26c.png)\n\nTo plot the given curve, we follow these steps:\n\n- Start with the graph of $y=sin⁡x.$\n\n- Then, reflect it in the $x$-axis to give $y=-sin⁡x.$\n\n- Finally, translate it by $1$ unit **down** to give $y=-sin⁡x-1.$\n\nTherefore, the given curve is the graph of $y=-sin⁡x-1.$"}] [{:db/id #edb/ref 17592186253482 :knowledge-point/_questions [{:db/id #edb/ref 17592186096711 :knowledge-point/id #uuid "61861939-69d4-5b1e-a0f0-6a1b383b775b" :knowledge-point/title "Identifying the Vertex of a Horizontal Parabola Given Its Graph"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2ed39256-683e-5ef6-a893-2ffd1ac7cfd0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(1,0)" :db/id #edb/ref 17592186250952} {:answer/id #uuid "3bcffef7-c4e0-5618-a54c-3d0b1bd5feba" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(0,2)" :db/id #edb/ref 17592186251053} {:answer/id #uuid "5a24d0d7-0cee-5b3c-8d59-814969cbbcad" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(0,0)" :db/id #edb/ref 17592186251294} {:answer/id #uuid "b9016ea9-a887-53a4-97d6-743534d4d445" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(2,0)" :db/id #edb/ref 17592186252181} {:answer/id #uuid "e8a06d70-c6d7-5b07-b5fa-a43959fc8051" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(0,1)" :db/id #edb/ref 17592186252588}] :answer-field/correct {:answer/id #uuid "b9016ea9-a887-53a4-97d6-743534d4d445" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(2,0)" :db/id #edb/ref 17592186252181} :answer-field/id #uuid "736e577a-1579-5c66-a73e-dca1bc5214d5" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186253011}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "054b33c1-48d0-5971-9cd6-626efbf760f9" :question/math-academy-id "q-11854" :question/problem "![](images/af/af896b84fd035bc81e97ab6214858ec7627c12b7b9ff25f18483839f4e389ba7.png)\n\nWhat is the vertex of the parabola shown above?" :question/worked-solution "The vertex of a left-opening parabola is the right-most point of the parabola.\n\n![](images/54/5410d736f7bae2f5c968d52083745b91279913045405ad75d154cf6b05bba4bd.png)\n\nTherefore, the coordinates of the vertex are $(2,0).$"}] [{:db/id #edb/ref 17592186386882 :knowledge-point/_questions [{:db/id #edb/ref 17592186115409 :knowledge-point/id #uuid "f7e817a0-edcf-54ca-ba4c-ffe91af04675" :knowledge-point/title "Finding a Height of a Triangle"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b161b259-2a2c-531b-b051-34dd949dc4d6" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/16/16c9990277df1c1b212ff154c4951b59301ef5b7f8360f82b041e73a5a3a984b.png" :db/id #edb/ref 17592186386884} {:answer/id #uuid "e0792fd2-fe4a-5351-bd8d-d02531595632" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/10/10e9f5a6af4d6d2b9c6392de91432b09620107d3dc645fc6ca65fdbda52f7c83.png" :db/id #edb/ref 17592186386885} {:answer/id #uuid "b85c7ea1-4023-5d0d-86b4-0459134b26d0" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/ce/ce3493e78660cfa84515970053105b95df5542eafbc4630c1e5b0afe9f658036.png" :db/id #edb/ref 17592186386886} {:answer/id #uuid "6c9daab7-90f4-5583-88a7-85210ed3b622" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/16/168ba7b705d9a579dc11408cc7bf60fb13249c5d4c6a25c3c490c09cfc77ec38.png" :db/id #edb/ref 17592186386887} {:answer/id #uuid "26d31697-89a3-57f9-9d21-e473be574ab7" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/30/301c31fa98ce5c016337f422566b94a742e3da126b76f9060e4b13d6a8e86358.png" :db/id #edb/ref 17592186386888}] :answer-field/correct {:answer/id #uuid "26d31697-89a3-57f9-9d21-e473be574ab7" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/30/301c31fa98ce5c016337f422566b94a742e3da126b76f9060e4b13d6a8e86358.png" :db/id #edb/ref 17592186386888} :answer-field/id #uuid "05bed876-047b-5aad-854a-94fee100e605" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186386883}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "3f1782d4-ceb0-5897-9f90-478b4c1242ae" :question/math-academy-id "q-118692" :question/problem "![](images/55/5548481ccbe3aee88fd4b346ad53777b7101223c19f7e8408c8ef85bb0d9df25.png)\n\nGiven the right triangle $△PQR$ shown above, which of the following diagrams represents the height corresponding to $\\overset{―}{PR}?$" :question/worked-solution "The height (or altitude) corresponding to $\\overset{―}{PR}$ is a line segment that \n\n- runs from the opposite vertex $Q$ to the line $\\overset{⟷}{PR},$ and\n\n- is perpendicular to $\\overset{⟷}{PR}.$\n\nThe correct diagram is shown below.\n\n![](images/30/301c31fa98ce5c016337f422566b94a742e3da126b76f9060e4b13d6a8e86358.png)"}] [{:db/id #edb/ref 17592186253503 :knowledge-point/_questions [{:db/id #edb/ref 17592186115336 :knowledge-point/id #uuid "6a916099-a237-5612-b7f1-3679b7ff069d" :knowledge-point/title "Calculating an Unknown Angle"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "37f6e98b-9e74-5362-9415-76b0e5788bd8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{26}^{∘}" :db/id #edb/ref 17592186251016} {:answer/id #uuid "412b51d2-1c6c-5e96-b7f4-3a46ab2a6b3d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{28}^{∘}" :db/id #edb/ref 17592186251093} {:answer/id #uuid "5df0c213-f26e-5d44-b086-a8082f8ff356" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{22}^{∘}" :db/id #edb/ref 17592186251329} {:answer/id #uuid "6a726442-67f6-5b29-aa0d-827d6fcd828e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{18}^{∘}" :db/id #edb/ref 17592186251427} {:answer/id #uuid "b7d0d4d2-0d27-5b44-a286-f8c17048fc8d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{32}^{∘}" :db/id #edb/ref 17592186252172}] :answer-field/correct {:answer/id #uuid "412b51d2-1c6c-5e96-b7f4-3a46ab2a6b3d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{28}^{∘}" :db/id #edb/ref 17592186251093} :answer-field/id #uuid "fd987d2b-51a1-5e48-9b29-2cadc9f301dc" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186253251}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "574c517e-3266-5464-9df0-9e740c923895" :question/math-academy-id "q-118757" :question/problem "![](images/95/95b534f8c159b37884e32b730d9aa502565ff4971cd7d08903ffbfaa94b76623.png)\n\nConsider $△PQR$ shown above. The line segment $\\overset{―}{RH}$ is the altitude corresponding to $\\overset{―}{PQ}.$ If $m∠PQR={118}^{∘},$ calculate $m∠QRH.$" :question/worked-solution "Since the straight angle must have a measure of ${180}^{∘},$ we have\n\n$$\n\\begin{aligned}m∠HQR+m∠PQR & ={180}^{∘} \\\\ m∠HQR+{118}^{∘} & ={180}^{∘} \\\\ m∠HQR & ={62}^{∘}.\\end{aligned}\n$$\n\nNote that $△QHR$ is a right triangle. Since its interior angles must sum to ${180}^{∘},$ we have\n\n$$\n\\begin{aligned}m∠QRH+m∠HQR+m∠RHQ & ={180}^{∘} \\\\ m∠QRH+{62}^{∘}+{90}^{∘} & ={180}^{∘} \\\\ m∠QRH+{152}^{∘} & ={180}^{∘} \\\\ m∠QRH & ={28}^{∘}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186253509 :knowledge-point/_questions [{:db/id #edb/ref 17592186096761 :knowledge-point/id #uuid "d27b85e4-ddae-5b5f-965a-5dff51b8449b" :knowledge-point/title "Identifying the Vertex of a Vertical Parabola Given Its Graph"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "270439e3-e2ab-5a45-87bf-95f9becc4e56" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-8,-4)" :db/id #edb/ref 17592186250889} {:answer/id #uuid "463b87ff-48d0-5886-a575-321db25afa2d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(8,4)" :db/id #edb/ref 17592186251134} {:answer/id #uuid "68421f23-fdb5-513b-aad2-454ec11b2707" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(4,8)" :db/id #edb/ref 17592186251407} {:answer/id #uuid "6c15702c-4ffc-5fc6-bfbe-fc6f04ea6b2c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(4,6)" :db/id #edb/ref 17592186251437} {:answer/id #uuid "88b53079-b103-5a08-a70c-3440fd7a01bc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-4,-8)" :db/id #edb/ref 17592186251705}] :answer-field/correct {:answer/id #uuid "68421f23-fdb5-513b-aad2-454ec11b2707" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(4,8)" :db/id #edb/ref 17592186251407} :answer-field/id #uuid "835c1580-a670-5c3e-b1f5-64dbfd79c4e9" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186253026}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "acdf7c4b-4f3a-5142-ba6b-26da51bdc76a" :question/math-academy-id "q-11878" :question/problem "![](images/2b/2b78b376173589b18d5e8da73897d9552f41a00aab523c0e76892623b586eb53.png)\n\nWhat is the vertex of the parabola shown above?" :question/worked-solution "The vertex of a downward-opening parabola is the highest point of the parabola.\n\n![](images/3c/3c547f893dc1cf2e71c17022ea7c81034214d7aedabe78bf719ebd44b96da329.png)\n\n \n\nTherefore, the coordinates of the vertex are $(4,8).$"}] [{:db/id #edb/ref 17592186253529 :knowledge-point/_questions [{:db/id #edb/ref 17592186096615 :knowledge-point/id #uuid "5856f3cc-5423-5a97-b2fd-7f44e0797ec7" :knowledge-point/title "Differentiating a Logarithmic Function With a General Base"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "010fae26-d218-5d85-80be-b5da7fa03138" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{xln⁡4}" :db/id #edb/ref 17592186250562} {:answer/id #uuid "1d7274d3-9d6c-566f-8ab0-5d6dadc206db" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5}{4x}" :db/id #edb/ref 17592186250801} {:answer/id #uuid "3fea77d7-dd38-54a3-ab38-de4a5e6af670" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5}{xln⁡5}" :db/id #edb/ref 17592186251082} {:answer/id #uuid "90d31982-431c-5c96-9fd1-28cbe6930c37" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5}{xln⁡4}" :db/id #edb/ref 17592186251788 :task-item/_responses [{:db/id #edb/ref 17592186409265}]} {:answer/id #uuid "e56177c0-fb1c-54a8-8c75-934ef63a1c08" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5}{x}" :db/id #edb/ref 17592186252561}] :answer-field/correct {:answer/id #uuid "90d31982-431c-5c96-9fd1-28cbe6930c37" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5}{xln⁡4}" :db/id #edb/ref 17592186251788} :answer-field/id #uuid "35ef16c9-7f8c-57e6-86fd-b4dbee5a6bfa" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186252894}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "b9de855f-8e10-5bff-89a6-c3649ce380b6" :question/math-academy-id "q-11900" :question/problem "Given that $y=5{log}_{4}⁡x$, find $\\frac{\\text{d}y}{\\text{d}x}.$" :question/worked-solution "To differentiate a logarithm with base $a,$ we use the formula\n\n$$\n\\frac{\\text{d}}{\\text{d}x}({log}_{a}⁡x)=\\frac{1}{xln⁡a}.\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}}{\\text{d}x}(5{log}_{4}⁡x) \\\\  & =5\\frac{\\text{d}}{\\text{d}x}({log}_{4}⁡x) \\\\  & =5\\cdot \\frac{1}{xln⁡4} \\\\  & =\\frac{5}{xln⁡4}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186253547 :knowledge-point/_questions [{:db/id #edb/ref 17592186096614 :knowledge-point/id #uuid "83ce3c28-857b-5538-b362-cf52526e3688" :knowledge-point/title "Differentiating a Sum Containing a Natural Logarithm Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "26bf5cf8-eaf1-5b10-8d2a-662c31b3b508" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2}{x}" :db/id #edb/ref 17592186250885} {:answer/id #uuid "783b0f4c-199c-5928-b08e-dcb4df838be4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2+\\frac{2}{x}" :db/id #edb/ref 17592186251549} {:answer/id #uuid "89f1e417-01f6-5b82-ba77-84fd142edcc2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2x}" :db/id #edb/ref 17592186251714} {:answer/id #uuid "e0afa8a6-a60b-5d30-b8a6-b2c64b3b9e85" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2x+\\frac{1}{x}" :db/id #edb/ref 17592186252532} {:answer/id #uuid "fe2d11d8-637f-5d1f-abb2-68fd4be88574" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2+\\frac{1}{x}" :db/id #edb/ref 17592186252782 :task-item/_responses [{:db/id #edb/ref 17592186409245}]}] :answer-field/correct {:answer/id #uuid "fe2d11d8-637f-5d1f-abb2-68fd4be88574" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2+\\frac{1}{x}" :db/id #edb/ref 17592186252782} :answer-field/id #uuid "ef06db64-440f-52c2-ab98-0824b44d15d2" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186253222}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "2a7a5557-d240-5298-a285-f0853a897b06" :question/math-academy-id "q-11911" :question/problem "Given that $y=2x+ln⁡x$, find $\\frac{\\text{d}y}{\\text{d}x}.$" :question/worked-solution "Taking the derivative, we have\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}}{\\text{d}x}(2x+ln⁡x) \\\\  & =2+\\frac{1}{x}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186253566 :knowledge-point/_questions [{:db/id #edb/ref 17592186059669 :knowledge-point/id #uuid "38b450bd-b43a-507c-9bbe-0aaf7a64a3ed" :knowledge-point/title "Finding a Point That Lies on a Transformed Curve Given Another Transformed Curve"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "42a70a80-9905-5343-a34c-136a375e25ef" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(2,-1)" :db/id #edb/ref 17592186251108} {:answer/id #uuid "9d7c8745-888b-5fc6-9d1a-fc1686129698" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(2,0)" :db/id #edb/ref 17592186251913} {:answer/id #uuid "a8ce837a-8964-565e-9e2d-f825bac56dba" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(2,2)" :db/id #edb/ref 17592186252014} {:answer/id #uuid "d6b4c14b-cbd8-5494-b7e3-3692ec97eb35" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(2,1)" :db/id #edb/ref 17592186252455} {:answer/id #uuid "e0fa8370-7c51-5755-8595-d094b48e3a78" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(2,-3)" :db/id #edb/ref 17592186252534}] :answer-field/correct {:answer/id #uuid "9d7c8745-888b-5fc6-9d1a-fc1686129698" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(2,0)" :db/id #edb/ref 17592186251913} :answer-field/id #uuid "2019c876-575f-5be0-a410-079acd66193f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186252863}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "4d38949b-9d50-5e0f-bb63-ea8ff36967c0" :question/math-academy-id "q-119308" :question/problem "The point $(2,3)$ lies on the curve $y=f(x)-1.$ Which of the following points **must** lie on $y=-f(x)+4?$" :question/worked-solution "**Method 1**\n\nTo plot $y=-f(x)+4,$ we apply the following steps:\n\n- First, take the graph $y=f(x)-1.$\n\n- Then, we shift the graph vertically by $1$ unit up and get the graph of $y=f(x).$ After this transformation, the point $(2,3)$ will be mapped to the point\n\n$$\n(2,3+1)=(2,4).\n$$\n\n- Next, we reflect the result across the $x$-axis and get the graph of $y=-f(x).$ After this transformation, the point $(2,4)$ will be mapped  to the point\n\n$$\n(2,-(4))=(2,-4).\n$$\n\n- Finally, shift the result vertically by $4$ units up and obtain the graph of $y=-f(x)+4.$ After this transformation, the point $(2,-4)$ will be mapped to the point \n\n$$\n(2,-4+4)=(2,0).\n$$\n\n**Method 2**\n\nSince the point $(2,3)$ lies on the graph of $y=f(x)-1$, we have that \n\n$$\nf(2)-1=3\\,⟹\\,f(2)=4.\n$$\n\nNow consider the graph of $y=-f(x)+4.$ Substituting $x=2$, we get\n\n$$\n\\begin{aligned}y & =-f(2)+4 \\\\  & =-4+4 \\\\  & =0.\\end{aligned}\n$$\n\nTherefore, the point $(2,0)$ must lie on $y=-f(x)+4.$"}] [{:db/id #edb/ref 17592186253574 :knowledge-point/_questions [{:db/id #edb/ref 17592186059641 :knowledge-point/id #uuid "3332b534-bd04-5e86-995e-1e6d691d8e1b" :knowledge-point/title "Simplifying an Expression by Factoring and Using the Pythagorean Identity"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1815e8ee-c289-5f64-9f4d-5df43b4aab39" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{sin}⁡\\theta +1" :db/id #edb/ref 17592186250764} {:answer/id #uuid "25423e87-2e31-52ea-9bed-9680a8ad4d75" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1-\\operatorname{sin}⁡\\theta " :db/id #edb/ref 17592186250872} {:answer/id #uuid "380b2f49-3850-505e-a125-48611fc7669a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\operatorname{sin}⁡\\theta " :db/id #edb/ref 17592186251019} {:answer/id #uuid "b6fc9b1c-0a28-54c2-82c9-b8ff1ad7eae4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{sin}⁡\\theta " :db/id #edb/ref 17592186252166} {:answer/id #uuid "bb0ddaa2-dc14-5f83-8293-f70b43e52381" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\operatorname{sin}⁡\\theta +1" :db/id #edb/ref 17592186252200}] :answer-field/correct {:answer/id #uuid "380b2f49-3850-505e-a125-48611fc7669a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\operatorname{sin}⁡\\theta " :db/id #edb/ref 17592186251019} :answer-field/id #uuid "a308e80e-fc90-57c9-9815-5d63c4e60f59" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186253090}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "1e264613-6b71-5c6c-b1c0-6da9257b1f1a" :question/math-academy-id "q-119371" :question/problem "Simplify the trigonometric expression ${sin}^{3}⁡\\theta +\\operatorname{sin}⁡\\theta {cos}^{2}⁡\\theta +\\operatorname{sin}⁡\\theta .$" :question/worked-solution "First, we factor the expression:\n\n$$\n{sin}^{3}⁡\\theta +\\operatorname{sin}⁡\\theta {cos}^{2}⁡\\theta +\\operatorname{sin}⁡\\theta =\\operatorname{sin}⁡\\theta ({sin}^{2}⁡\\theta +{cos}^{2}⁡\\theta )+\\operatorname{sin}⁡\\theta \n$$\n\nThen, we use ${sin}^{2}⁡\\theta +{cos}^{2}⁡\\theta =1$ to simplify the expression in the parentheses:\n\n$$\n\\begin{aligned}\\operatorname{sin}⁡\\theta ({sin}^{2}⁡\\theta +{cos}^{2}⁡\\theta )+\\operatorname{sin}⁡\\theta  & =\\operatorname{sin}⁡\\theta \\cdot 1+\\operatorname{sin}⁡\\theta  \\\\  & =\\operatorname{sin}⁡\\theta +\\operatorname{sin}⁡\\theta  \\\\  & =2\\operatorname{sin}⁡\\theta \\end{aligned}\n$$\n\nHence, we conclude that\n\n$$\n{sin}^{3}⁡\\theta +\\operatorname{sin}⁡\\theta {cos}^{2}⁡\\theta +\\operatorname{sin}⁡\\theta =2\\operatorname{sin}⁡\\theta .\n$$"}] [{:db/id #edb/ref 17592186253577 :knowledge-point/_questions [{:db/id #edb/ref 17592186059642 :knowledge-point/id #uuid "868125f0-22e0-57fc-9620-f3242419a689" :knowledge-point/title "Simplifying a Rational Expression Using the Pythagorean Identity"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "08ed664b-fff1-5712-ac2e-5525f9cdacef" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{cot}⁡\\theta " :db/id #edb/ref 17592186250634} {:answer/id #uuid "3b69e247-6d23-5ff1-a976-eb6503b80dcc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{cot}⁡\\theta +1" :db/id #edb/ref 17592186251045} {:answer/id #uuid "58c39cbe-5a9b-575c-ae8a-d7f92d34e4dc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2\\operatorname{cot}⁡\\theta " :db/id #edb/ref 17592186251282} {:answer/id #uuid "923c3e09-f2e0-5124-82ce-83280737e8aa" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1-\\operatorname{cot}⁡\\theta " :db/id #edb/ref 17592186251804} {:answer/id #uuid "b061ebd1-c842-5f84-80fa-eec468f6b43d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{cot}⁡\\theta -1" :db/id #edb/ref 17592186252093}] :answer-field/correct {:answer/id #uuid "08ed664b-fff1-5712-ac2e-5525f9cdacef" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{cot}⁡\\theta " :db/id #edb/ref 17592186250634} :answer-field/id #uuid "89a2bbe3-2ba2-5a56-9f75-7bcd2efd08bd" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186253041}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "e604df29-4056-5a18-af72-ee9756feedd1" :question/math-academy-id "q-119387" :question/problem "$\\frac{{sin}^{2}⁡\\theta \\operatorname{cos}⁡\\theta }{{sin}^{5}⁡\\theta +{sin}^{3}⁡\\theta {cos}^{2}⁡\\theta }=$" :question/worked-solution "First, we factor the denominator:\n\n$$\n\\frac{{sin}^{2}⁡\\theta \\operatorname{cos}⁡\\theta }{{sin}^{5}⁡\\theta +{sin}^{3}⁡\\theta {cos}^{2}⁡\\theta }=\\frac{{sin}^{2}⁡\\theta \\operatorname{cos}⁡\\theta }{{sin}^{3}⁡\\theta \\cdot ({sin}^{2}⁡\\theta +{cos}^{2}⁡\\theta )}\n$$\n\nNext, we use the Pythagorean identity to rewrite the expression in the parentheses, and then we simplify the resulting expression as much as possible.\n\n$$\n\\begin{aligned}\\frac{{sin}^{2}⁡\\theta \\operatorname{cos}⁡\\theta }{{sin}^{3}⁡\\theta \\cdot ({sin}^{2}⁡\\theta +{cos}^{2}⁡\\theta )} & =\\frac{{sin}^{2}⁡\\theta \\operatorname{cos}⁡\\theta }{{sin}^{3}⁡\\theta \\cdot 1} \\\\  & =\\frac{{sin}^{2}⁡\\theta \\operatorname{cos}⁡\\theta }{{sin}^{3}⁡\\theta } \\\\  & =\\frac{{sin}^{2}⁡\\theta \\operatorname{cos}⁡\\theta }{{sin}^{2}⁡\\theta \\cdot \\operatorname{sin}⁡\\theta } \\\\  & =\\frac{\\cancel{{sin}^{2}⁡\\theta }\\operatorname{cos}⁡\\theta }{\\cancel{{sin}^{2}⁡\\theta }\\cdot \\operatorname{sin}⁡\\theta } \\\\  & =\\frac{\\operatorname{cos}⁡\\theta }{\\operatorname{sin}⁡\\theta } \\\\  & =\\operatorname{cot}⁡\\theta \\end{aligned}\n$$\n\nHence, we conclude that\n\n$$\n\\frac{{sin}^{2}⁡\\theta \\operatorname{cos}⁡\\theta }{{sin}^{5}⁡\\theta +{sin}^{3}⁡\\theta {cos}^{2}⁡\\theta }=\\operatorname{cot}⁡\\theta .\n$$"}] [{:db/id #edb/ref 17592186253581 :knowledge-point/_questions [{:db/id #edb/ref 17592186059666 :knowledge-point/id #uuid "283415d8-47d7-5d42-8836-0c0b0c4efc85" :knowledge-point/title "Finding Exact Values Using the Sum and Difference Formulas"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "33c614c8-e574-54c4-afe7-ea7cbe93a089" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{3}-\\sqrt{6}}{4}" :db/id #edb/ref 17592186250984} {:answer/id #uuid "82138ae6-184b-5b43-9d31-1dafcb47b464" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{\\sqrt{2}+\\sqrt{6}}{4}" :db/id #edb/ref 17592186251649} {:answer/id #uuid "866785b4-4b0d-5ed0-ab10-df319b0d8757" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{2}-\\sqrt{6}}{4}" :db/id #edb/ref 17592186251680} {:answer/id #uuid "cb17904f-e9e2-5ce4-ac6b-159a7742e47c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{2}+\\sqrt{6}}{4}" :db/id #edb/ref 17592186252351} {:answer/id #uuid "f85fd59f-f673-55d7-9727-39ba21278ce9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{\\sqrt{3}+\\sqrt{6}}{4}" :db/id #edb/ref 17592186252727}] :answer-field/correct {:answer/id #uuid "82138ae6-184b-5b43-9d31-1dafcb47b464" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{\\sqrt{2}+\\sqrt{6}}{4}" :db/id #edb/ref 17592186251649} :answer-field/id #uuid "307233f6-b9b3-54e3-9937-9c7b41e5ed35" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186252888}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "9b9e46d2-105c-587e-ad59-8da071cc7eea" :question/math-academy-id "q-119479" :question/problem "Find the exact value of  $\\operatorname{cos}⁡{195}^{∘}.$\n\n*Hint: Use the fact that ${195}^{∘}={135}^{∘}+{60}^{∘}.$*" :question/worked-solution "Recall the sum formula for cosine:\n\n$$\n\\operatorname{cos}⁡(x+y)=\\operatorname{cos}⁡x\\operatorname{cos}⁡y-\\operatorname{sin}⁡x\\operatorname{sin}⁡y\n$$\n\nApplying the sum formula for cosine with $x={135}^{∘}$ and $y={60}^{∘}$, we get\n\n$$\n\\begin{aligned}\\operatorname{cos}⁡({195}^{∘}) & =\\operatorname{cos}⁡({135}^{∘}+{60}^{∘}) \\\\  & =\\operatorname{cos}⁡{135}^{∘}\\operatorname{cos}⁡{60}^{∘}-\\operatorname{sin}⁡{135}^{∘}\\operatorname{sin}⁡{60}^{∘} \\\\  & =(-\\frac{\\sqrt{2}}{2})\\cdot \\frac{1}{2}-\\frac{\\sqrt{2}}{2}\\cdot \\frac{\\sqrt{3}}{2} \\\\  & =-\\frac{\\sqrt{2}}{4}-\\frac{\\sqrt{6}}{4} \\\\  & =-\\frac{\\sqrt{2}+\\sqrt{6}}{4}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186253582 :knowledge-point/_questions [{:db/id #edb/ref 17592186059821 :knowledge-point/id #uuid "c6a58962-cb06-519a-8c64-0dfa3b9c14d7" :knowledge-point/title "Simplifying Expressions in Degrees Using the Sum and Difference Formulas"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "046c3fff-e187-5d6d-817c-fcad26542595" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}(\\operatorname{cos}⁡x+\\sqrt{3}\\operatorname{sin}⁡x)" :db/id #edb/ref 17592186250586} {:answer/id #uuid "4206c502-18de-5733-a8cd-4790cc23f4b8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}(\\sqrt{3}\\operatorname{cos}⁡x+\\operatorname{sin}⁡x)" :db/id #edb/ref 17592186251105} {:answer/id #uuid "459effbf-a2af-5f96-b9e0-38a98c849e15" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{3}}{2}(\\operatorname{cos}⁡x+\\operatorname{sin}⁡x)" :db/id #edb/ref 17592186251129} {:answer/id #uuid "6c93157b-2ac8-5521-831f-507d005bc1c6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{3}\\operatorname{cos}⁡x-\\operatorname{sin}⁡x" :db/id #edb/ref 17592186251447} {:answer/id #uuid "7d8d63a7-52ee-5a72-956d-4feb52257b50" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}(\\sqrt{3}\\operatorname{cos}⁡x-\\operatorname{sin}⁡x)" :db/id #edb/ref 17592186251603}] :answer-field/correct {:answer/id #uuid "4206c502-18de-5733-a8cd-4790cc23f4b8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}(\\sqrt{3}\\operatorname{cos}⁡x+\\operatorname{sin}⁡x)" :db/id #edb/ref 17592186251105} :answer-field/id #uuid "af98a692-a950-5516-913c-d1527e2c4e36" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186253111}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "24fefd74-9f51-579d-ab19-a20613b6de76" :question/math-academy-id "q-119482" :question/problem "$\\operatorname{cos}⁡(x-{30}^{∘})=$" :question/worked-solution "First, we recall the difference formula for cosine:\n\n$$\n\\operatorname{cos}⁡(u-v)=\\operatorname{cos}⁡u\\operatorname{cos}⁡v+\\operatorname{sin}⁡u\\operatorname{sin}⁡v\n$$\n\nApplying the difference formula for cosine with $u=x$ and $v={30}^{∘},$ we get\n\n$$\n\\begin{aligned}\\operatorname{cos}⁡(x-{30}^{∘}) & =\\operatorname{cos}⁡x\\operatorname{cos}⁡{30}^{∘}+\\operatorname{sin}⁡x\\operatorname{sin}⁡{30}^{∘} \\\\  & =\\operatorname{cos}⁡x\\cdot \\frac{\\sqrt{3}}{2}+\\operatorname{sin}⁡x\\cdot \\frac{1}{2} \\\\  & =\\frac{1}{2}(\\sqrt{3}\\operatorname{cos}⁡x+\\operatorname{sin}⁡x).\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186253590 :knowledge-point/_questions [{:db/id #edb/ref 17592186096622 :knowledge-point/id #uuid "af269509-92c0-5a82-b828-e8626f8e8eda" :knowledge-point/title "Differentiating a Quotient Using Leibniz Notation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0b89321c-e3ba-5c4f-81cd-a7cbf23d72d1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{9}{{(9-2x)}^{2}}" :db/id #edb/ref 17592186250653} {:answer/id #uuid "0fbd81fe-3865-51f1-85e7-89c40d3f7b84" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{9}{{(9-2x)}^{2}}" :db/id #edb/ref 17592186250690} {:answer/id #uuid "3a22468e-a8b9-5374-a6b1-4af81ef69538" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{4x-9}{{(9-2x)}^{2}}" :db/id #edb/ref 17592186251034} {:answer/id #uuid "bd9f93f8-6285-5333-9fbc-0e76b0bb68f3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{2x-9}{{(9-2x)}^{2}}" :db/id #edb/ref 17592186252231} {:answer/id #uuid "e86a868c-0137-5698-8032-3302efc36e18" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{4x-9}{{(9-2x)}^{2}}" :db/id #edb/ref 17592186252584}] :answer-field/correct {:answer/id #uuid "0fbd81fe-3865-51f1-85e7-89c40d3f7b84" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{9}{{(9-2x)}^{2}}" :db/id #edb/ref 17592186250690} :answer-field/id #uuid "05c220dd-0a63-5428-9d3d-76e098f2cb6c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186252820}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "4ae64d20-c5b4-50bb-94bc-ab5da04017e1" :question/math-academy-id "q-11969" :question/problem "Given that $y=\\frac{-x}{9-2x}$, find $\\frac{\\text{d}y}{\\text{d}x}.$" :question/worked-solution "Let $u=-x$ and $v=9-2x.$ Then\n\n$$\n\\begin{aligned}\\frac{\\text{d}u}{\\text{d}x} & =-1\\,\\text{and}\\,\\frac{\\text{d}v}{\\text{d}x}=-2.\\end{aligned}\n$$\n\nUsing the quotient rule, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{v\\frac{\\text{d}u}{\\text{d}x}-u\\frac{\\text{d}v}{\\text{d}x}}{{v}^{2}} \\\\  & =\\frac{(9-2x)\\cdot (-1)-(-x)\\cdot (-2)}{{(9-2x)}^{2}} \\\\  & =\\frac{-9+2x-2x}{{(9-2x)}^{2}} \\\\  & =-\\frac{9}{{(9-2x)}^{2}}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186097026 :knowledge-point/_questions [{:db/id #edb/ref 17592186096844 :knowledge-point/id #uuid "261910cd-a1a4-5c90-8caa-238208558458" :knowledge-point/title "Calculating a Derivative Using the Chain and Quotient Rules"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "39a5acaf-0b97-5eec-b5dc-80f14127936e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{6x}{{(3x+5)}^{3}}" :db/id #edb/ref 17592186251028} {:answer/id #uuid "5fc87138-62df-5eac-9d34-752a109148de" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{x}{{(3x+5)}^{4}}" :db/id #edb/ref 17592186251338} {:answer/id #uuid "794835b2-c8d2-5e60-99aa-d141cf6639aa" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{30x}{{(3x+5)}^{3}}" :db/id #edb/ref 17592186251559} {:answer/id #uuid "80538af1-96e8-546c-8e04-53ab4e77cd46" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2x}{{(3x+5)}^{4}}" :db/id #edb/ref 17592186251634} {:answer/id #uuid "e543d792-894d-58ae-966d-434f788becaa" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5x}{{(3x+5)}^{4}}" :db/id #edb/ref 17592186252560}] :answer-field/correct {:answer/id #uuid "794835b2-c8d2-5e60-99aa-d141cf6639aa" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{30x}{{(3x+5)}^{3}}" :db/id #edb/ref 17592186251559} :answer-field/id #uuid "dcc00428-34a0-5c80-bcd3-256eb4ce28ac" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186253182}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "4603accf-ccdb-5030-90b8-c9b568c4df0b" :question/math-academy-id "q-11973" :question/problem "Given that $y=\\frac{3{x}^{2}}{(3x+5)^{2}}$, find $\\frac{\\text{d}y}{\\text{d}x}.$" :question/worked-solution "We use the quotient rule with the numerator $u(x)=3{x}^{2}$ and the denominator $v(x)=(3x+5)^{2}.$ \n\nDifferentiating $u(x)$ and $v(x),$ we have\n\n$$\n{u}^{′}(x)=6x,\\,{v}^{′}(x)=6(3x+5).\n$$\n\nNote that we used the chain rule to differentiate $v.$\n\nNow, applying the quotient rule and simplifying, we have\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{{u}^{′}(x)\\cdot v(x)-u(x)\\cdot {v}^{′}(x)}{[v(x)]^{2}} \\\\  & =\\frac{(6x){(3x+5)}^{2}-(3{x}^{2})\\cdot 6(3x+5)}{{((3x+5)^{2})}^{2}} \\\\  & =\\frac{6x(3x+5)(3x+5-3x)}{{(3x+5)}^{4}} \\\\  & =\\frac{6x(3x+5)(5)}{{(3x+5)}^{4}} \\\\  & =\\frac{30x}{{(3x+5)}^{3}}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186253599 :knowledge-point/_questions [{:db/id #edb/ref 17592186059643 :knowledge-point/id #uuid "1bc8c875-3393-5fd6-90cf-87737e16f2f2" :knowledge-point/title "Simplifying a Trigonometric Expression Using a Common Denominator and the Pythagorean Identity"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "55eb6103-d65c-564e-8146-1b697fcf6114" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{cos}⁡x+1" :db/id #edb/ref 17592186251257} {:answer/id #uuid "9c494cc4-f14a-523f-afab-b55ead4e2206" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\operatorname{sin}⁡x" :db/id #edb/ref 17592186251902} {:answer/id #uuid "9cabf4a9-d334-52aa-94a3-29c1226a338c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1-\\operatorname{sin}⁡x" :db/id #edb/ref 17592186251905} {:answer/id #uuid "ac59de0c-94ce-555a-a9af-0f345fa9844c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186252052} {:answer/id #uuid "cdfac5b4-b918-541c-bab0-02afa81cd836" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{cos}⁡x" :db/id #edb/ref 17592186252374}] :answer-field/correct {:answer/id #uuid "ac59de0c-94ce-555a-a9af-0f345fa9844c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186252052} :answer-field/id #uuid "5889b846-4b45-54d4-a4c7-1acb0782d3ec" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186252962}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "8a4d16bb-7544-56af-8e64-b1dbb3f56d7c" :question/math-academy-id "q-119770" :question/problem "Simplify the trigonometric expression $\\frac{{cos}^{2}⁡x}{1+\\operatorname{sin}⁡x}+\\operatorname{sin}⁡x.$" :question/worked-solution "We put both terms over a common denominator, and combine the two fractions:\n\n$$\n\\begin{aligned}\\frac{{cos}^{2}⁡x}{1+\\operatorname{sin}⁡x}+\\operatorname{sin}⁡x & =\\frac{{cos}^{2}⁡x}{1+\\operatorname{sin}⁡x}+\\frac{\\operatorname{sin}⁡x}{1} \\\\  & =\\frac{{cos}^{2}⁡x}{1+\\operatorname{sin}⁡x}+\\frac{\\operatorname{sin}⁡x(1+\\operatorname{sin}⁡x)}{1(1+\\operatorname{sin}⁡x)} \\\\  & =\\frac{{cos}^{2}⁡x+\\operatorname{sin}⁡x(1+\\operatorname{sin}⁡x)}{1+\\operatorname{sin}⁡x}\\end{aligned}\n$$\n\nFinally, we simplify using the Pythagorean identity, as follows:\n\n$$\n\\begin{aligned}\\frac{{cos}^{2}⁡x+\\operatorname{sin}⁡x(1+\\operatorname{sin}⁡x)}{1+\\operatorname{sin}⁡x} & =\\frac{{cos}^{2}⁡x+\\operatorname{sin}⁡x+{sin}^{2}⁡x}{1+\\operatorname{sin}⁡x} \\\\  & =\\frac{({sin}^{2}⁡x+{cos}^{2}⁡x)+\\operatorname{sin}⁡x}{1+\\operatorname{sin}⁡x} \\\\  & =\\frac{1+\\operatorname{sin}⁡x}{1+\\operatorname{sin}⁡x} \\\\  & =1\\end{aligned}\n$$\n\nTherefore, we conclude that\n\n$$\n\\frac{{cos}^{2}⁡x}{2+\\operatorname{sin}⁡x}+\\operatorname{sin}⁡x=1.\n$$"}] [{:db/id #edb/ref 17592186253603 :knowledge-point/_questions [{:db/id #edb/ref 17592186096844 :knowledge-point/id #uuid "261910cd-a1a4-5c90-8caa-238208558458" :knowledge-point/title "Calculating a Derivative Using the Chain and Quotient Rules"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "010ec989-6a70-5560-8c6d-96bcabcf07f3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{(1-x)^{2}}{{({x}^{2}+1)}^{2}}" :db/id #edb/ref 17592186250561} {:answer/id #uuid "185de746-f2a2-5bc0-a895-8eef91887f33" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2(x+1)}{{({x}^{2}+1)}^{2}}" :db/id #edb/ref 17592186250767} {:answer/id #uuid "5cf0aeab-facc-582b-9a39-b2c196aead5d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2(1-{x}^{2})}{{({x}^{2}+1)}^{2}}" :db/id #edb/ref 17592186251320} {:answer/id #uuid "c4f44c2b-b5c6-5adc-a37b-c3386048fc4e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2(1-x)}{{({x}^{2}+1)}^{2}}" :db/id #edb/ref 17592186252297} {:answer/id #uuid "e2b8be0a-88c7-5856-ade3-8586c358ec8b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{(1-2{x}^{2})}{{({x}^{2}+1)}^{2}}" :db/id #edb/ref 17592186252547}] :answer-field/correct {:answer/id #uuid "5cf0aeab-facc-582b-9a39-b2c196aead5d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2(1-{x}^{2})}{{({x}^{2}+1)}^{2}}" :db/id #edb/ref 17592186251320} :answer-field/id #uuid "910e876b-71ca-514d-ad43-ceb4c9229334" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186253056}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "3000a138-321d-511f-bb2f-c25bd88c5e97" :question/math-academy-id "q-11978" :question/problem "Given that $y=\\frac{(x+1)^{2}}{{x}^{2}+1},$ find $\\frac{\\text{d}y}{\\text{d}x}.$" :question/worked-solution "We use the quotient rule with the numerator $u(x)=(x+1)^{2}$ and the denominator $v(x)={x}^{2}+1.$ \n\nDifferentiating $u(x)$ and $v(x),$ we have\n\n$$\n{u}^{′}(x)=2(x+1),\\,{v}^{′}(x)=2x.\n$$\n\nNote that we used the chain rule to differentiate $u.$\n\nNow, applying the quotient rule and simplifying, we have\n\n$$\n\\begin{aligned}\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{{u}^{′}(x)\\cdot v(x)-u(x)\\cdot {v}^{′}(x)}{[v(x)]^{2}} \\\\  & =\\frac{(2(x+1))({x}^{2}+1)-((x+1)^{2})(2x)}{({x}^{2}+1)^{2}} \\\\  & =\\frac{2(x+1)({x}^{2}+1)-2x(x+1)^{2}}{({x}^{2}+1)^{2}} \\\\  & =\\frac{2(x+1)(({x}^{2}+1)-x(x+1))}{({x}^{2}+1)^{2}} \\\\  & =\\frac{2(x+1)({x}^{2}+1-{x}^{2}-x)}{({x}^{2}+1)^{2}} \\\\  & =\\frac{2(x+1)(1-x)}{({x}^{2}+1)^{2}} \\\\  & =\\frac{2(1-{x}^{2})}{({x}^{2}+1)^{2}}.\\end{aligned}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186253617 :knowledge-point/_questions [{:db/id #edb/ref 17592186059652 :knowledge-point/id #uuid "b05f4be1-95d4-5137-bbaa-71c95862bb59" :knowledge-point/title "Simplifying Expressions by Factoring an Alternate Form of the Pythagorean Identity"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "00677872-7616-5c6b-bc06-e85a41bca0b0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{sin}⁡x+1" :db/id #edb/ref 17592186250553} {:answer/id #uuid "60dff4f9-0626-5330-99dd-f03bb2eb6f7e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1-\\operatorname{sin}⁡x" :db/id #edb/ref 17592186251345} {:answer/id #uuid "a43f7607-4390-56c0-ba26-6beaa6359216" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\operatorname{sin}⁡x" :db/id #edb/ref 17592186251971} {:answer/id #uuid "bbc2c36b-5bb0-5f2e-8ad7-e904eb5d214b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-(1+\\operatorname{sin}⁡x)" :db/id #edb/ref 17592186252208} {:answer/id #uuid "bc732a44-7bfc-58d9-95fa-404ba29a3bd3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{sin}⁡x-1" :db/id #edb/ref 17592186252217}] :answer-field/correct {:answer/id #uuid "bbc2c36b-5bb0-5f2e-8ad7-e904eb5d214b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-(1+\\operatorname{sin}⁡x)" :db/id #edb/ref 17592186252208} :answer-field/id #uuid "68996742-5572-5673-a555-2490c8c236c3" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186252995}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "a1b437a5-869a-5ccd-aeb4-884c52b20f38" :question/math-academy-id "q-119864" :question/problem "Simplify the expression $\\frac{{cos}^{2}⁡x}{\\operatorname{sin}⁡x-1}.$" :question/worked-solution "First, we rewrite the numerator using $1-{sin}^{2}⁡x={cos}^{2}⁡x.$\n\n$$\n\\frac{{cos}^{2}⁡x}{\\operatorname{sin}⁡x-1}=\\frac{1-{sin}^{2}⁡x}{\\operatorname{sin}⁡x-1}\n$$\n\nNext, we factor the numerator as a difference of squares, and simplify:\n\n$$\n\\begin{aligned}\\frac{1-{sin}^{2}⁡x}{\\operatorname{sin}⁡x-1} & =\\frac{(1+\\operatorname{sin}⁡x)(1-\\operatorname{sin}⁡x)}{\\operatorname{sin}⁡x-1} \\\\  & =-\\frac{(1+\\operatorname{sin}⁡x)(1-\\operatorname{sin}⁡x)}{1-\\operatorname{sin}⁡x} \\\\  & =-\\frac{(1+\\operatorname{sin}⁡x)\\cancel{(1-\\operatorname{sin}⁡x)}}{\\cancel{1-\\operatorname{sin}⁡x}} \\\\  & =-\\frac{1+\\operatorname{sin}⁡x}{1} \\\\  & =-(1+\\operatorname{sin}⁡x)\\end{aligned}\n$$\n\nTherefore, we conclude that\n\n$$\n\\frac{{cos}^{2}⁡x}{\\operatorname{sin}⁡x-1}=-(1+\\operatorname{sin}⁡x).\n$$"}] [{:db/id #edb/ref 17592186253621 :knowledge-point/_questions [{:db/id #edb/ref 17592186110560 :knowledge-point/id #uuid "35fe6748-f040-5318-84e0-f3f76c9c7250" :knowledge-point/title "Simplifying an Expression Using the Cotangent-Cosecant Identity"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "27f0a8ce-4aec-512b-a809-fe80d7a37254" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{cot}⁡z+2" :db/id #edb/ref 17592186250896} {:answer/id #uuid "383e056a-7d1a-580d-8144-5ce601bf73a1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1-2{cot}^{2}⁡z" :db/id #edb/ref 17592186251020} {:answer/id #uuid "449a0196-c334-57cc-9c6b-f43d1c3715ce" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}{cot}^{2}⁡z" :db/id #edb/ref 17592186251123} {:answer/id #uuid "978b01e0-91fd-53a4-93a7-f12af31fb3e3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{cot}^{2}⁡z" :db/id #edb/ref 17592186251854} {:answer/id #uuid "d552fd33-bdd6-5221-8186-0acd1c018978" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-{cot}^{2}⁡z" :db/id #edb/ref 17592186252441}] :answer-field/correct {:answer/id #uuid "978b01e0-91fd-53a4-93a7-f12af31fb3e3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{cot}^{2}⁡z" :db/id #edb/ref 17592186251854} :answer-field/id #uuid "f3ef446b-20ba-56ee-b042-97aed74369c7" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186253233}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "d3d698d1-fddf-50d2-9b5a-51d1e576d1b5" :question/math-academy-id "q-119904" :question/problem "Simplify ${cos}^{2}⁡z\\,({cot}^{2}⁡z+1).$" :question/worked-solution "Using the identity $1+{cot}^{2}⁡z={csc}^{2}⁡z,$ we rewrite and simplify the expression as follows:\n\n$$\n\\begin{aligned}{cos}^{2}⁡z\\,({cot}^{2}⁡z+1) & ={cos}^{2}⁡z\\cdot {csc}^{2}⁡z \\\\  & ={cos}^{2}⁡z\\cdot {(\\frac{1}{\\operatorname{sin}⁡z})}^{2} \\\\  & ={cos}^{2}⁡z\\cdot \\frac{1}{{sin}^{2}⁡z} \\\\  & =\\frac{{cos}^{2}⁡z}{{sin}^{2}⁡z} \\\\  & ={(\\frac{\\operatorname{cos}⁡z}{\\operatorname{sin}⁡z})}^{2} \\\\  & ={cot}^{2}⁡z\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186253627 :knowledge-point/_questions [{:db/id #edb/ref 17592186059673 :knowledge-point/id #uuid "5f9683d9-05b9-5a42-9f81-0170a15dfac1" :knowledge-point/title "Using the Double-Angle Formula to Simplify Ratios"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0abdcc32-cc35-5670-9c83-c4cbe912eee6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}\\operatorname{csc}⁡(\\frac{\\pi }{6})" :db/id #edb/ref 17592186250650} {:answer/id #uuid "57edb35e-9370-5374-9e06-ccc1975123a2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\operatorname{sec}⁡(\\frac{\\pi }{6})" :db/id #edb/ref 17592186251271} {:answer/id #uuid "882f41e4-7a0d-5ac6-8538-7f29f7c131ca" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{csc}⁡(\\frac{\\pi }{6})" :db/id #edb/ref 17592186251701} {:answer/id #uuid "d69eebe4-9936-53c3-8b7b-de492f9722de" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}\\operatorname{sec}⁡(\\frac{\\pi }{6})" :db/id #edb/ref 17592186252454} {:answer/id #uuid "ff3248bd-252a-5193-96ee-ea1bc9f698ff" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}\\operatorname{sin}⁡(\\frac{\\pi }{6})" :db/id #edb/ref 17592186252795}] :answer-field/correct {:answer/id #uuid "0abdcc32-cc35-5670-9c83-c4cbe912eee6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}\\operatorname{csc}⁡(\\frac{\\pi }{6})" :db/id #edb/ref 17592186250650} :answer-field/id #uuid "cf9019c2-6685-5469-b58a-01ed2b00e34b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186253164}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "1a84df43-c63e-5997-bb62-0b42cedd5faa" :question/math-academy-id "q-120017" :question/problem "$\\operatorname{cos}⁡(\\frac{\\pi }{6})\\operatorname{csc}⁡(\\frac{\\pi }{3})=$" :question/worked-solution "First, let's recall the double-angle formula for sine: \n\n$$\n\\operatorname{sin}⁡2x=2\\operatorname{sin}⁡x\\operatorname{cos}⁡x\n$$\n\nSubstituting $x=\\frac{\\pi }{6}$ into the above, we get\n\n$$\n\\operatorname{sin}⁡(2\\cdot \\frac{\\pi }{6})=2\\operatorname{sin}⁡(\\frac{\\pi }{6})\\operatorname{cos}⁡(\\frac{\\pi }{6})\n$$\n\nwhich simplifies as\n\n$$\n\\operatorname{sin}⁡(\\frac{\\pi }{3})=2\\operatorname{sin}⁡(\\frac{\\pi }{6})\\operatorname{cos}⁡(\\frac{\\pi }{6}).\n$$\n\nRewriting the given expression using the above, we get\n\n$$\n\\begin{aligned}\\operatorname{cos}⁡(\\frac{\\pi }{6})\\operatorname{csc}⁡(\\frac{\\pi }{3}) & =\\operatorname{cos}⁡(\\frac{\\pi }{6})\\cdot \\frac{1}{\\operatorname{sin}⁡(\\frac{\\pi }{3})} \\\\  & =\\operatorname{cos}⁡(\\frac{\\pi }{6})\\cdot \\frac{1}{2\\operatorname{sin}⁡(\\frac{\\pi }{6})\\operatorname{cos}⁡(\\frac{\\pi }{6})} \\\\  & =\\cancel{\\operatorname{cos}⁡(\\frac{\\pi }{6})}\\cdot \\frac{1}{2\\operatorname{sin}⁡(\\frac{\\pi }{6})\\cancel{\\operatorname{cos}⁡(\\frac{\\pi }{6})}} \\\\  & =\\frac{1}{2\\operatorname{sin}⁡(\\frac{\\pi }{6})} \\\\  & =\\frac{1}{2}\\operatorname{csc}⁡(\\frac{\\pi }{6}).\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186253628 :knowledge-point/_questions [{:db/id #edb/ref 17592186059673 :knowledge-point/id #uuid "5f9683d9-05b9-5a42-9f81-0170a15dfac1" :knowledge-point/title "Using the Double-Angle Formula to Simplify Ratios"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "024f4b95-a6a5-5f2d-a751-2755ac5cce12" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{csc}⁡(\\frac{\\pi }{8})" :db/id #edb/ref 17592186250575} {:answer/id #uuid "0e20a623-1450-54d0-9595-8a7aa3109a42" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}\\operatorname{sin}⁡(\\frac{\\pi }{8})" :db/id #edb/ref 17592186250675} {:answer/id #uuid "3a0ea007-0dad-5df4-93e4-28082fff80d0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\operatorname{csc}⁡(\\frac{\\pi }{4})" :db/id #edb/ref 17592186251033} {:answer/id #uuid "8f9f6191-c575-5400-985e-09588bd93769" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\operatorname{sin}⁡(\\frac{\\pi }{4})" :db/id #edb/ref 17592186251773} {:answer/id #uuid "adab3445-9088-5485-a515-0fc08abd7e3b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}\\operatorname{csc}⁡(\\frac{\\pi }{8})" :db/id #edb/ref 17592186252067}] :answer-field/correct {:answer/id #uuid "adab3445-9088-5485-a515-0fc08abd7e3b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}\\operatorname{csc}⁡(\\frac{\\pi }{8})" :db/id #edb/ref 17592186252067} :answer-field/id #uuid "8a4e8fb7-0cf4-569d-9a43-083899802b06" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186253044}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "11defe63-9b06-5fba-87b6-5807bf8b34d3" :question/math-academy-id "q-120018" :question/problem "$\\frac{\\operatorname{cos}⁡(\\frac{\\pi }{8})}{\\operatorname{sin}⁡(\\frac{\\pi }{4})}=$" :question/worked-solution "First, let's recall the double-angle formula for sine: \n\n$$\n\\operatorname{sin}⁡2x=2\\operatorname{sin}⁡x\\operatorname{cos}⁡x\n$$\n\nSubstituting $x=\\frac{\\pi }{8}$ into the above, we get\n\n$$\n\\operatorname{sin}⁡(2\\cdot \\frac{\\pi }{8})=2\\operatorname{sin}⁡(\\frac{\\pi }{8})\\operatorname{cos}⁡(\\frac{\\pi }{8})\n$$\n\nwhich simplifies as\n\n$$\n\\operatorname{sin}⁡(\\frac{\\pi }{4})=2\\operatorname{sin}⁡(\\frac{\\pi }{8})\\operatorname{cos}⁡(\\frac{\\pi }{8}).\n$$\n\nTherefore, we can simplify the given expression by rewriting the $\\operatorname{sin}⁡(\\frac{\\pi }{4})$ in the denominator, as follows:\n\n$$\n\\begin{aligned}\\frac{\\operatorname{cos}⁡(\\frac{\\pi }{8})}{\\operatorname{sin}⁡(\\frac{\\pi }{4})} & =\\frac{\\operatorname{cos}⁡(\\frac{\\pi }{8})}{2\\operatorname{sin}⁡(\\frac{\\pi }{8})\\operatorname{cos}⁡(\\frac{\\pi }{8})} \\\\  & =\\frac{\\cancel{\\operatorname{cos}⁡(\\frac{\\pi }{8})}}{2\\operatorname{sin}⁡(\\frac{\\pi }{8})\\cancel{\\operatorname{cos}⁡(\\frac{\\pi }{8})}} \\\\  & =\\frac{1}{2\\operatorname{sin}⁡(\\frac{\\pi }{8})} \\\\  & =\\frac{1}{2}\\operatorname{csc}⁡(\\frac{\\pi }{8}).\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186395991 :knowledge-point/_questions [{:db/id #edb/ref 17592186087746 :knowledge-point/id #uuid "d8c04b23-e341-57e9-a072-985e4b536e5a" :knowledge-point/title "Identifying Linear Transformations"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "af31ad74-3d71-5216-82f4-241c0fe0d883" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I, II, and III" :db/id #edb/ref 17592186395993} {:answer/id #uuid "55344227-ef64-559d-b72e-d67580b900d1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186395994} {:answer/id #uuid "8c8d3009-744a-5594-85d0-81623acfa040" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186395995} {:answer/id #uuid "1acecbea-2330-5d66-8f7e-c711b7d73ea2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "None" :db/id #edb/ref 17592186395996} {:answer/id #uuid "cabd1c0f-3241-5f02-a31b-66428bbc54cc" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186395997}] :answer-field/correct {:answer/id #uuid "af31ad74-3d71-5216-82f4-241c0fe0d883" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I, II, and III" :db/id #edb/ref 17592186395993} :answer-field/id #uuid "e3af571d-ad32-5475-bbe0-4ca42f82e8b5" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186395992}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "d2b3861b-a381-5b7c-bc56-9232209a631c" :question/math-academy-id "q-12008" :question/problem "Let \n$T:[\\begin{aligned}x \\\\ y\\end{aligned}]⟶[\\begin{aligned}x+y \\\\ 4x+3y\\end{aligned}].$\nWhich of the following statements are true?\n\nI. $T(kv)=kT(v)$ for any real $2\\times 1$ column vector $v$ and real scalar $k$\nII. $T({v}_{1}+{v}_{2})=T({v}_{1})+T({v}_{2})$ for any real $2\\times 1$ column vectors ${v}_{1}$ and ${v}_{2}$\nIII. $T$ is a linear transformation" :question/worked-solution "A linear transformation $T$ satisfies two properties:\n\n$$\n\\begin{aligned} & T[\\begin{aligned}kx \\\\ ky\\end{aligned}]=kT[\\begin{aligned}x \\\\ y\\end{aligned}], \\\\  & T[\\begin{aligned}{x}_{1}+{x}_{2} \\\\ {y}_{1}+{y}_{2}\\end{aligned}]=T[\\begin{aligned}{x}_{1} \\\\ {y}_{1}\\end{aligned}]+T[\\begin{aligned}{x}_{2} \\\\ {y}_{2}\\end{aligned}].\\end{aligned}\n$$\n\n- Checking the first condition, we have\n\n$$\n\\begin{aligned}T[\\begin{aligned}kx \\\\ ky\\end{aligned}] & =[\\begin{aligned}kx+ky \\\\ 4kx+3ky\\end{aligned}] \\\\  & =k[\\begin{aligned}x+y \\\\ 4x+3y\\end{aligned}] \\\\  & =kT[\\begin{aligned}x \\\\ y\\end{aligned}].\\,✓\\end{aligned}\n$$\n\n- Checking the second condition, we have\n\n$$\n\\begin{aligned}T[\\begin{aligned}{x}_{1}+{x}_{2} \\\\ {y}_{1}+{y}_{2}\\end{aligned}] & =[\\begin{aligned}{x}_{1}+{x}_{2}+{y}_{1}+{y}_{2} \\\\ 4({x}_{1}+{x}_{2})+3({y}_{1}+{y}_{2})\\end{aligned}] \\\\  & =[\\begin{aligned}{x}_{1}+{y}_{1} \\\\ 4{x}_{1}+3{y}_{1}\\end{aligned}]+[\\begin{aligned}{x}_{2}+{y}_{2} \\\\ 4{x}_{2}+3{y}_{2}\\end{aligned}] \\\\  & =T[\\begin{aligned}{x}_{1} \\\\ {y}_{1}\\end{aligned}]+T[\\begin{aligned}{x}_{2} \\\\ {y}_{2}\\end{aligned}].\\,✓\\end{aligned}\n$$\n\nTherefore, $\\text{T}$ is a linear transformation.\n\nAs a result, all three statements are true."}] [{:db/id #edb/ref 17592186386987 :knowledge-point/_questions [{:db/id #edb/ref 17592186092220 :knowledge-point/id #uuid "c4034e61-63dc-5f72-8275-e9c81290767d" :knowledge-point/title "Identifying the Graph of a Polar Circle"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a6979975-c4fc-5dd6-a7c2-9f66b3cec100" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/9d/9d77180cde3a0c2ca1ad5187a6b64c6b7d0d282b0e673e24c50132d7e3d91ce3.png" :db/id #edb/ref 17592186386989} {:answer/id #uuid "3aebcf64-2103-5b69-9394-e1bc7f1d2130" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/72/725d3670d3f2e50a9359e1573b3acf3d947b75f231