swer.type/image} :answer/value "images/9d/9d77180cde3a0c2ca1ad5187a6b64c6b7d0d282b0e673e24c50132d7e3d91ce3.png" :db/id #edb/ref 17592186386989} {:answer/id #uuid "3aebcf64-2103-5b69-9394-e1bc7f1d2130" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/72/725d3670d3f2e50a9359e1573b3acf3d947b75f2318b8f84687a19d3f3182565.png" :db/id #edb/ref 17592186386990} {:answer/id #uuid "00e21cf7-1e3e-5ee9-9e9d-d78979ba3a63" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/0a/0a6fc2c09a48ff2b3ff05cee80fe2192b3c4df73349cb9aca0ca85bb63f4b7a3.png" :db/id #edb/ref 17592186386991} {:answer/id #uuid "7a7a85e1-b3d8-533d-87ab-76a9deb58d4e" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/85/8542e401ead2affa416f1094b01012f6cb5b1e885abb73a08c0beb81805c5f95.png" :db/id #edb/ref 17592186386992} {:answer/id #uuid "f4fdcf46-e742-5684-b33f-a377c0fd9066" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/14/141ad1c2adb9ac4f098887a82beb041c087a717686f72aa4e2c632066775f740.png" :db/id #edb/ref 17592186386993}] :answer-field/correct {:answer/id #uuid "3aebcf64-2103-5b69-9394-e1bc7f1d2130" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/72/725d3670d3f2e50a9359e1573b3acf3d947b75f2318b8f84687a19d3f3182565.png" :db/id #edb/ref 17592186386990} :answer-field/id #uuid "472a64e6-0ae4-5eb4-904b-1786b1d5396b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186386988}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "dc3ee50e-9f02-59b6-9819-5a8625491ef3" :question/math-academy-id "q-120161" :question/problem "Which of the following is the graph of the polar curve $r=9?$" :question/worked-solution "The polar curve defined by the equation $r=9$ is a circle of radius $9$ centered at the origin. Its graph is given below.\n\n![](images/72/725d3670d3f2e50a9359e1573b3acf3d947b75f2318b8f84687a19d3f3182565.png)"}] [{:db/id #edb/ref 17592186253654 :knowledge-point/_questions [{:db/id #edb/ref 17592186092221 :knowledge-point/id #uuid "93f33baf-c3b5-549a-8eb7-1ab370e9c62b" :knowledge-point/title "Finding the Intersection of a Polar Circle With an Axis"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "155caee8-0023-56b3-b370-2fd485d05fc6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(0,-3)" :db/id #edb/ref 17592186250738} {:answer/id #uuid "3fc099f5-307d-559c-9a46-d23e6c48c70c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(0,3)" :db/id #edb/ref 17592186251081} {:answer/id #uuid "487f3e5a-7c1a-5b15-8ae9-ef95b5f4ca2e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(0,-9)" :db/id #edb/ref 17592186251159} {:answer/id #uuid "bb0229c3-2f5b-56be-ae65-467349c66a08" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-3,0)" :db/id #edb/ref 17592186252199} {:answer/id #uuid "f3293cbf-6c9f-5280-b328-d11aba972662" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(3,0)" :db/id #edb/ref 17592186252687}] :answer-field/correct {:answer/id #uuid "bb0229c3-2f5b-56be-ae65-467349c66a08" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-3,0)" :db/id #edb/ref 17592186252199} :answer-field/id #uuid "f0ed6a2b-c5aa-54ac-b872-3f04189b642e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186253226}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "c538a2a9-f441-50c2-b2b2-9978dbea640e" :question/math-academy-id "q-120169" :question/problem "Find the Cartesian coordinates of the point where the polar curve $r=3$ intersects the negative $x$-axis." :question/worked-solution "The polar curve $r=3$ is a circle of radius $3$ centered at the origin. It crosses the negative $x$-axis at the point $(-3,0),$ as shown below. \n\n![](images/19/19c6d04de928de62e63fb949cfcd770d130f8836a0bf0da06d90e7d3cb5915b2.png)\n\nTherefore, the point of intersection is $(-3,0).$"}] [{:db/id #edb/ref 17592186386994 :knowledge-point/_questions [{:db/id #edb/ref 17592186092222 :knowledge-point/id #uuid "47358248-2067-590e-80e1-5d20796434c5" :knowledge-point/title "Finding the Polar Equation of a Circle Given a Point on the Circumference"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "473c3565-ec6d-5c40-a350-40f0312960f3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "r=16" :db/id #edb/ref 17592186386996} {:answer/id #uuid "d3843fbf-dbb3-51fd-b094-4879dedfdc5d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "r=5" :db/id #edb/ref 17592186386997} {:answer/id #uuid "3f73c315-1a02-5816-92bb-a7fa09cc60a9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "r=4" :db/id #edb/ref 17592186386998} {:answer/id #uuid "3649883e-f058-534a-86c9-ca7394593491" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "r=17" :db/id #edb/ref 17592186386999} {:answer/id #uuid "790f3473-6c69-5eb8-806a-d6f5325589db" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "r=\\sqrt{17}" :db/id #edb/ref 17592186387000}] :answer-field/correct {:answer/id #uuid "790f3473-6c69-5eb8-806a-d6f5325589db" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "r=\\sqrt{17}" :db/id #edb/ref 17592186387000} :answer-field/id #uuid "1b530f70-0684-540c-a40c-457b7450f149" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186386995}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "fd205798-6e48-5e7d-a533-4f8c8e3d8f17" :question/math-academy-id "q-120182" :question/problem "![](images/d9/d9b356319065128b1b509a35c57020db0aa18b0096be170afe0fd1738a59040c.png)\n\nFind the polar equation of the circle centered at the origin that passes through the point $A(-1,4)$, as shown above." :question/worked-solution "A circle of radius $k$ centered at the origin has the polar equation $r=k.$\n\nWe can compute the radius $k$ of our circle using the Pythagorean theorem, as follows:\n\n$$\n\\begin{aligned}k & =\\sqrt{{x}^{2}+{y}^{2}} \\\\  & =\\sqrt{(-1)^{2}+{4}^{2}} \\\\  & =\\sqrt{17}\\end{aligned}\n$$\n\nTherefore, the equation of the circle is $r=\\sqrt{17}.$"}] [{:db/id #edb/ref 17592186253662 :knowledge-point/_questions [{:db/id #edb/ref 17592186092222 :knowledge-point/id #uuid "47358248-2067-590e-80e1-5d20796434c5" :knowledge-point/title "Finding the Polar Equation of a Circle Given a Point on the Circumference"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "500cff87-8b2a-5870-88e7-a6c045cafa6b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "r=\\sqrt{2}" :db/id #edb/ref 17592186251210} {:answer/id #uuid "951f9a13-1357-5138-88ce-cc8d213adbba" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "r=4" :db/id #edb/ref 17592186251833} {:answer/id #uuid "bc35ee41-4106-5339-93ca-9d0eee337eaf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "r=2\\sqrt{2}" :db/id #edb/ref 17592186252215} {:answer/id #uuid "d33fc7ff-85d0-5239-8273-1cd18c6bbb61" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "r=3" :db/id #edb/ref 17592186252424} {:answer/id #uuid "f94fef92-646e-50c7-857f-2df18669976e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "r=2" :db/id #edb/ref 17592186252736}] :answer-field/correct {:answer/id #uuid "500cff87-8b2a-5870-88e7-a6c045cafa6b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "r=\\sqrt{2}" :db/id #edb/ref 17592186251210} :answer-field/id #uuid "8cf0b0d5-ec7a-5bf5-8b89-71870acdb90a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186253048}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "b3691fe4-f7f9-5f4e-89c5-6571f374e002" :question/math-academy-id "q-120186" :question/problem "![](images/f8/f8b8c044d79ce592089365b3918dfae0afc52ef86a71c899abe823c828ab23b0.png)\n\nFind the polar equation of the circle centered at the origin that passes through the point $A(1,-1)$, as shown above." :question/worked-solution "A circle of radius $k$ centered at the origin has the polar equation $r=k.$\n\nWe can compute the radius $k$ of our circle using the Pythagorean theorem, as follows:\n\n$$\n\\begin{aligned}k & =\\sqrt{{x}^{2}+{y}^{2}} \\\\  & =\\sqrt{{1}^{2}+(-1)^{2}} \\\\  & =\\sqrt{2}.\\end{aligned}\n$$\n\nTherefore, the equation of the circle is $r=\\sqrt{2}.$"}] [{:db/id #edb/ref 17592186253666 :knowledge-point/_questions [{:db/id #edb/ref 17592186092351 :knowledge-point/id #uuid "6b04084c-8e69-5f53-a95d-664aba54aec9" :knowledge-point/title "Converting from Cartesian Coordinates to Polar Coordinates: Second or Third Quadrant"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2c6f4f87-1ccd-589c-90e1-8890c55c15eb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(2,\\frac{7\\pi }{4})" :db/id #edb/ref 17592186250932} {:answer/id #uuid "62a869bc-7ad8-5514-a78a-02dff1b40c81" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(4,\\frac{5\\pi }{4})" :db/id #edb/ref 17592186251359} {:answer/id #uuid "89286d84-c732-59b4-956d-104585bfdb9a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(\\sqrt{2},\\frac{5\\pi }{4})" :db/id #edb/ref 17592186251711} {:answer/id #uuid "94083696-43f4-54f2-b3f6-a3866a469f41" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(\\sqrt{2},\\frac{\\pi }{4})" :db/id #edb/ref 17592186251825} {:answer/id #uuid "a5579b86-e0b3-519e-954e-6b1008604303" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(2,\\frac{3\\pi }{4})" :db/id #edb/ref 17592186251978}] :answer-field/correct {:answer/id #uuid "a5579b86-e0b3-519e-954e-6b1008604303" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(2,\\frac{3\\pi }{4})" :db/id #edb/ref 17592186251978} :answer-field/id #uuid "cd003bc0-32be-5a18-932b-9a7f1e93dea2" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186253158}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "0eb4fa3e-52f2-52cc-a5b3-7f2b007d645a" :question/math-academy-id "q-120234" :question/problem "A point $P$ has Cartesian coordinates $(-\\sqrt{2},\\sqrt{2}).$ What are the polar coordinates of $P?$" :question/worked-solution "First, we determine $r:$\n\n$$\n\\begin{aligned}r & =\\sqrt{{x}^{2}+{y}^{2}} \\\\  & =\\sqrt{(-\\sqrt{2})^{2}+(\\sqrt{2})^{2}} \\\\  & =\\sqrt{2+2} \\\\  & =\\sqrt{4} \\\\  & =2\\end{aligned}\n$$\n\nFor the reference angle, we get\n\n$$\n\\begin{aligned}{\\theta }_{R} & =|\\operatorname{arctan}⁡(\\frac{y}{x})| \\\\  & =|\\operatorname{arctan}⁡(\\frac{\\sqrt{2}}{-\\sqrt{2}})| \\\\  & =|-\\operatorname{arctan}⁡(1)| \\\\  & =\\frac{\\pi }{4}.\\end{aligned}\n$$\n\nSince the point $P$ lies in the second quadrant, we subtract the reference angle from $\\pi ,$ and we get\n\n$$\n\\begin{aligned}\\theta  & =\\pi -{\\theta }_{R} \\\\  & =\\pi -\\frac{\\pi }{4} \\\\  & =\\frac{3\\pi }{4}.\\end{aligned}\n$$\n\nTherefore, the polar coordinates of $P$ are  $(2,\\frac{3\\pi }{4}).$"}] [{:db/id #edb/ref 17592186256370 :knowledge-point/_questions [{:db/id #edb/ref 17592186096701 :knowledge-point/id #uuid "2fbb8f19-f35a-59c4-9b77-8f6c3542ef28" :knowledge-point/title "Finding a Scalar Factor in a Linear Combination"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0f58b1f0-a1f2-5152-8b50-a3b88cfa03ea" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186253806} {:answer/id #uuid "28d1e0c0-6ce0-5a30-b308-d0185860ae28" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186254035} {:answer/id #uuid "86b0f05f-4928-50e1-9fee-05c5f1c722c5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186254862} {:answer/id #uuid "c1aa28fa-00bb-55da-83ba-fd94389b454c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2.5" :db/id #edb/ref 17592186255398} {:answer/id #uuid "f72b66ba-7fc3-5027-b7a4-6cc62030c64e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1.5" :db/id #edb/ref 17592186255836}] :answer-field/correct {:answer/id #uuid "0f58b1f0-a1f2-5152-8b50-a3b88cfa03ea" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186253806} :answer-field/id #uuid "1bffb12d-46cf-5b60-8dd5-5eb835abe4b0" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186255967}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "701d4729-670a-58df-8c65-907d28621390" :question/math-academy-id "q-120244" :question/problem "![](images/9e/9e595809380e3067934b9f8c86933dd5300fcfb54ce4202eddc0e4196b74cf00.png)\n\nConsider the picture above. Given that $c=a+\\lambda b,$ find $\\lambda .$" :question/worked-solution "To find $\\lambda ,$ we want to match the expression\n\n$$\nc=a+\\lambda b.\n$$\n\nWe are given that one of the components is $a.$ So, we begin with the vector $a,$ and then find the remaining vector needed to reach the point $C.$\n\n![](images/0c/0c785e189beebb0a803bceba272db156af6d3b47c690ee9527876f77c65d1891.png)\n\nNote that in $△OAC,$ we have:\n\n- $AC=2|b|$\n\n- $\\overset{\\to }{AC}$ and $b$ have the same direction\n\nHence, $\\overset{\\to }{AC}=2b.$\n\nAdditionally,\n\n$$\n\\begin{aligned}c & =\\overset{\\to }{OA}+\\overset{\\to }{AC} \\\\  & =a+2b.\\end{aligned}\n$$\n\nConsequently, $c=a+\\lambda b=a+2b.$\n\nSince $a∦b,$ the linear combination can only be written in one way. Equating the coefficients of $b,$ we get:\n\n$$\n\\lambda =2\n$$"}] [{:db/id #edb/ref 17592186235344 :knowledge-point/_questions [{:db/id #edb/ref 17592186235285 :knowledge-point/id #uuid "58a49d00-cc58-5228-af38-9369cf31d8c8" :knowledge-point/title "Finding a Scalar Factor When Direction Reverses"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3cdd0854-261d-5ed4-92ef-477febc75b21" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186234639} {:answer/id #uuid "3eab765d-2302-5205-b5fd-0ada1e027409" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186234642} {:answer/id #uuid "6e5da092-7603-5a36-a455-4137459af1b7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186234713} {:answer/id #uuid "dde73660-f588-5765-aec3-a2559c655608" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186234894} {:answer/id #uuid "e5f2c8c3-d49b-55df-8a1c-5ef41ca2446f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{2}" :db/id #edb/ref 17592186234905}] :answer-field/correct {:answer/id #uuid "e5f2c8c3-d49b-55df-8a1c-5ef41ca2446f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{2}" :db/id #edb/ref 17592186234905} :answer-field/id #uuid "959370f5-d157-5592-9470-19e5d767b960" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186235154}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "16c001cc-439d-56cc-834f-f6d6a747b8e6" :question/math-academy-id "q-120257" :question/problem "![](images/55/551316d1e36175ca302c5c472d4109a9bc9cadf32cc85d2a1751424a386070cc.png)\n\nConsider the picture above. Given that $c=\\lambda a-2b,$ find $\\lambda .$" :question/worked-solution "To find $\\lambda ,$ we want to match the expression\n\n$$\nc=\\lambda a-2b.\n$$\n\nWe are given that one of the components is $-2b.$ So, we first draw the vector $-2b$ from the origin. Then we complete the path to the point $C.$\n\n![](images/40/40a0137d6227212db9b7ef9f349029838f3f51398790ec5e1c304e12c3743a0f.png)\n\nLet $P$ be the endpoint of the vector $-2b.$ Then\n\n$$\nc=\\overset{\\to }{OP}+\\overset{\\to }{PC}.\n$$\n\nIn $△OPC,$ we have:\n\n- $PC=\\frac{1}{2}|a|$\n\n- $\\overset{\\to }{PC}$ and $a$ have opposite directions\n\nHence, $\\overset{\\to }{PC}=-\\frac{1}{2}a.$\n\nAdditionally,\n\n$$\n\\begin{aligned}c & =\\overset{\\to }{OP}+\\overset{\\to }{PC} \\\\  & =-2b-\\frac{1}{2}a.\\end{aligned}\n$$\n\nConsequently, $c=\\lambda a-2b=-\\frac{1}{2}a-2b.$\n\nSince $a∦b,$ the linear combination can only be written in one way. Equating the coefficients of $a,$ we get:\n\n$$\n\\lambda =-\\frac{1}{2}\n$$"}] [{:db/id #edb/ref 17592186235345 :knowledge-point/_questions [{:db/id #edb/ref 17592186235285 :knowledge-point/id #uuid "58a49d00-cc58-5228-af38-9369cf31d8c8" :knowledge-point/title "Finding a Scalar Factor When Direction Reverses"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0f9a6c9b-836b-5e25-9560-a76d555bd2ff" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1.5" :db/id #edb/ref 17592186234563} {:answer/id #uuid "511f739e-027e-56d9-a3e1-c31426592471" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2.5" :db/id #edb/ref 17592186234671} {:answer/id #uuid "a66f9626-a549-5ae7-8d06-4cfb6ab29c1b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186234795} {:answer/id #uuid "c1efac91-7f8d-5ea4-a7ef-83e55e07f3e3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186234848} {:answer/id #uuid "c74cfa2b-3621-5ace-b7aa-47f1de8073f3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186234858}] :answer-field/correct {:answer/id #uuid "c1efac91-7f8d-5ea4-a7ef-83e55e07f3e3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186234848} :answer-field/id #uuid "dbe75fa5-1b4a-5d31-b779-8b1e6ef4db9c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186235241}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "67eef7d0-d993-5f1c-ad25-dae49fa99a98" :question/math-academy-id "q-120260" :question/problem "![](images/73/73e0ac67304b5e7682abddb59fcd01a9e8aca88831a303bf5b31a72ff772228d.png)\n\nConsider the picture above. Given that $c=\\lambda a-3b,$ find $\\lambda .$" :question/worked-solution "To find $\\lambda ,$ we want to match the expression\n\n$$\nc=\\lambda a-3b.\n$$\n\nWe are given that one of the components is $-3b.$ So, we first draw the vector $-3b$ from the origin. Then we complete the path to the point $C.$\n\n![](images/24/2484cf9fdda85c5c516babe6814f34c369ebdd91d6f100f0ce0fe4102e3c90a6.png)\n\nLet $P$ be the endpoint of the vector $-3b.$ Then\n\n$$\nc=\\overset{\\to }{OP}+\\overset{\\to }{PC}.\n$$\n\nIn $△OPC,$ we have:\n\n- $PC=3|a|$\n\n- $\\overset{\\to }{PC}$ and $a$ have opposite directions\n\nHence, $\\overset{\\to }{PC}=-3a.$\n\nAdditionally,\n\n$$\n\\begin{aligned}c & =\\overset{\\to }{OP}+\\overset{\\to }{PC} \\\\  & =-3b-3a.\\end{aligned}\n$$\n\nConsequently, $c=\\lambda a-3b=-3a-3b.$\n\nSince $a∦b,$ the linear combination can only be written in one way. Equating the coefficients of $a,$ we get:\n\n$$\n\\lambda =-3\n$$"}] [{:db/id #edb/ref 17592186256378 :knowledge-point/_questions [{:db/id #edb/ref 17592186096652 :knowledge-point/id #uuid "45b6a076-8795-5510-aabc-62a925826dd0" :knowledge-point/title "Finding Two Scalar Factors in a Linear Combination"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3720d5ea-8c76-53f9-b41b-1454af520571" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$\\lambda =-2$ and $\\mu =-1$" :db/id #edb/ref 17592186254146} {:answer/id #uuid "61a80033-8bee-5b84-b56a-7cb802b9895a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$\\lambda =2$ and $\\mu =1$" :db/id #edb/ref 17592186254544} {:answer/id #uuid "649996fe-b9a2-51bc-9110-e9d71b6a1d00" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$\\lambda =1$ and $\\mu =-2$" :db/id #edb/ref 17592186254571} {:answer/id #uuid "af5d8017-d027-550d-b7c5-936f4606ab26" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$\\lambda =-1$ and $\\mu =-2$" :db/id #edb/ref 17592186255212} {:answer/id #uuid "e69bcee0-66da-5af1-bec9-f709395b6bab" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$\\lambda =1$ and $\\mu =2$" :db/id #edb/ref 17592186255700}] :answer-field/correct {:answer/id #uuid "af5d8017-d027-550d-b7c5-936f4606ab26" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$\\lambda =-1$ and $\\mu =-2$" :db/id #edb/ref 17592186255212} :answer-field/id #uuid "e43afca9-d6cc-50ae-85ea-bc2853cb618f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186256326}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "281f178c-d09e-5385-8ce5-3504549094a9" :question/math-academy-id "q-120279" :question/problem "![](images/fc/fc7d37da99173b7fa99f2f5f0bbf1478a54505628ed827488a18b3d01535f81f.png)\n\nConsider the picture above. Given that $l=\\lambda j+\\mu k$, find $\\lambda $ and $\\mu .$" :question/worked-solution "![](images/6c/6c9273c0b89d4c06c8a8591b8e8e94b0c83b2d1d4bd04b64ed8cb0a185619b5f.png)\n\nIn $△OJL$ shown above, we have \n\n- $OJ=|j|$\n\n- $\\overset{\\to }{OJ}$ has the opposite direction to $j$\n\nHence, $\\overset{\\to }{OJ}=-j.$\n\nSimilarly:\n\n- $JL=2|k|$\n\n- $\\overset{\\to }{JL}$ has the opposite direction to $k$\n\nHence, $\\overset{\\to }{JL}=-2k.$\n\nAdditionally, \n\n$$\n\\begin{aligned}l & =\\overset{\\to }{OJ}+\\overset{\\to }{JL} \\\\  & =-j-2k.\\end{aligned}\n$$\n\nConsequently, $l=\\lambda j+\\mu k=-j-2k.$\n\nSince $j∦k,$ the linear combination can only be written in one way. Equating the coefficients, we get:\n\n- $\\lambda =-1$ and $\\mu =-2$"}] [{:db/id #edb/ref 17592186256384 :knowledge-point/_questions [{:db/id #edb/ref 17592186092352 :knowledge-point/id #uuid "49bf1f94-d992-511d-9016-d471f2ad4358" :knowledge-point/title "Converting from Cartesian Coordinates to Polar Coordinates for a Point on an Axis"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "564dfea9-94e5-5b80-a36f-acd4fd995ebb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(3,0)" :db/id #edb/ref 17592186254429} {:answer/id #uuid "59863691-0352-5356-82d2-ab1834b6534d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(3,\\pi )" :db/id #edb/ref 17592186254453} {:answer/id #uuid "6e48c846-1d99-5e8c-8b19-40423da09a39" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(\\sqrt{3},\\frac{\\pi }{3})" :db/id #edb/ref 17592186254648} {:answer/id #uuid "a4a8930c-8a49-51c4-b618-54b52edceb02" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(9,\\pi )" :db/id #edb/ref 17592186255123} {:answer/id #uuid "c876366e-402d-54a4-88fc-773f4c49db04" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(3,\\frac{\\pi }{2})" :db/id #edb/ref 17592186255455}] :answer-field/correct {:answer/id #uuid "564dfea9-94e5-5b80-a36f-acd4fd995ebb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(3,0)" :db/id #edb/ref 17592186254429} :answer-field/id #uuid "d14ab8bb-c93e-58c9-a40e-c0d3ca59cde8" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186256295}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "f6623b3b-0ac5-59c1-a0a1-f8ed0a13b015" :question/math-academy-id "q-120295" :question/problem "A point $P$ has Cartesian coordinates $(3,0).$ What are the polar coordinates of $P?$" :question/worked-solution "First, we determine $r:$\n\n$$\n\\begin{aligned}r & =\\sqrt{{x}^{2}+{y}^{2}} \\\\  & =\\sqrt{{3}^{2}+{0}^{2}} \\\\  & =3\\end{aligned}\n$$\n\nSince the point $P$ lies on the positive half of the $x$-axis, we have $\\theta =0.$ \n\nTherefore, the polar coordinates of $P$ are $(3,0).$"}] [{:db/id #edb/ref 17592186387001 :knowledge-point/_questions [{:db/id #edb/ref 17592186096653 :knowledge-point/id #uuid "feae36e7-ae88-5f3a-957f-e65a92e399ad" :knowledge-point/title "Expressing a Vector That Satisfies a Ratio in Terms of Known Vectors"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "20a4ecfa-47e2-56f4-a423-468e55f93529" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\overset{\\to }{OJ}=\\frac{1}{2}h+\\frac{1}{2}i" :db/id #edb/ref 17592186387003} {:answer/id #uuid "e23408c0-6a35-5afe-abe2-00bbdaf4622a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\overset{\\to }{OJ}=\\frac{3}{4}h+\\frac{1}{4}i" :db/id #edb/ref 17592186387004} {:answer/id #uuid "a498dbcf-0f77-508b-9c07-efe06b97d9ed" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\overset{\\to }{OJ}=\\frac{5}{8}h+\\frac{3}{8}i" :db/id #edb/ref 17592186387005} {:answer/id #uuid "748b1bc5-d773-5fa4-a285-111048597c9c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\overset{\\to }{OJ}=\\frac{1}{8}h+\\frac{3}{4}i" :db/id #edb/ref 17592186387006} {:answer/id #uuid "86f8cb36-0676-5c61-8d2f-37ebe1006578" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\overset{\\to }{OJ}=\\frac{3}{8}h+\\frac{5}{8}i" :db/id #edb/ref 17592186387007}] :answer-field/correct {:answer/id #uuid "86f8cb36-0676-5c61-8d2f-37ebe1006578" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\overset{\\to }{OJ}=\\frac{3}{8}h+\\frac{5}{8}i" :db/id #edb/ref 17592186387007} :answer-field/id #uuid "3c4f4208-0c8e-57ef-ad8c-1decee05823d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186387002}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "c0b691a2-9da7-5f9d-b601-8f5daf61f352" :question/math-academy-id "q-120304" :question/problem "![](images/65/6560a7f05ae95638cbfe902dfa022b2d8de6b07c6e1e6f85051ccf87b92ec338.png)\n\nConsider the diagram above, where $\\overset{\\to }{OH}=h,$ $\\overset{\\to }{OI}=i$ and $J$ divides $\\overset{―}{HI}$ in the ratio $HJ:JI=5:3.$ Find $\\overset{\\to }{OJ}.$" :question/worked-solution "From the diagram, we see that\n\n$$\n\\overset{\\to }{OJ}=\\overset{\\to }{OH}+\\overset{\\to }{HJ}.\n$$\n\nWe're told that $\\overset{\\to }{OH}=h,$ so we just need to work out $\\overset{\\to }{HJ}.$\n\nFirst, from $△OHI,$ we have\n\n$$\n\\begin{aligned}\\overset{\\to }{HI} & =\\overset{\\to }{HO}+\\overset{\\to }{OI} \\\\  & =-\\overset{\\to }{OH}+\\overset{\\to }{OI} \\\\  & =-h+i \\\\  & =i-h.\\end{aligned}\n$$\n\nSince $HJ:JI=5:3,$ we have\n\n$$\n\\overset{\\to }{HJ}=\\frac{5}{8}\\overset{\\to }{HI}=\\frac{5}{8}(i-h).\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\overset{\\to }{OJ} & =\\overset{\\to }{OH}+\\overset{\\to }{HJ} \\\\  & =h+\\frac{5}{8}(i-h) \\\\  & =\\frac{3}{8}h+\\frac{5}{8}i.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186256387 :knowledge-point/_questions [{:db/id #edb/ref 17592186092217 :knowledge-point/id #uuid "7f65d032-9acc-5fe6-b7c2-b8293576cb4c" :knowledge-point/title "Finding the Cartesian Coordinates of a Point Given in Polar Coordinates"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2075c86f-b918-575b-95e8-97859e70f90d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-2,-\\sqrt{2})" :db/id #edb/ref 17592186253951} {:answer/id #uuid "52496fb6-06f9-54e1-953b-c03cfcd9334c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-2\\sqrt{2},-2\\sqrt{2})" :db/id #edb/ref 17592186254387} {:answer/id #uuid "6724825c-031e-5303-abbe-a1eba30f6cba" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-2,2)" :db/id #edb/ref 17592186254603} {:answer/id #uuid "8470b6c3-3213-5f69-8af6-c90604195120" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(2\\sqrt{2},-1)" :db/id #edb/ref 17592186254848} {:answer/id #uuid "b04df24b-bdd0-5a86-9ea8-ddd583bd9c28" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(2\\sqrt{2},-2)" :db/id #edb/ref 17592186255221}] :answer-field/correct {:answer/id #uuid "52496fb6-06f9-54e1-953b-c03cfcd9334c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-2\\sqrt{2},-2\\sqrt{2})" :db/id #edb/ref 17592186254387} :answer-field/id #uuid "5736a212-726e-5d37-950e-cb5984448244" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186256090}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "cffd31fb-6e24-58d9-bedb-a4c483fcb431" :question/math-academy-id "q-120311" :question/problem "The point $P$ has polar coordinates $(4,{225}^{∘}).$ Find the Cartesian coordinates of $P.$" :question/worked-solution "To convert from polar coordinates to Cartesian coordinates, we use\n\n$$\nx=r\\operatorname{cos}⁡\\theta ,\\,y=r\\operatorname{sin}⁡\\theta .\n$$\n\nFirst, we calculate the $x$-coordinate of $P:$\n\n$$\n\\begin{aligned}x & =r\\operatorname{cos}⁡\\theta  \\\\  & =4\\operatorname{cos}⁡({225}^{∘}) \\\\  & =4(-\\frac{\\sqrt{2}}{2}) \\\\  & =-2\\sqrt{2}\\end{aligned}\n$$\n\nThen, we calculate the $y$-coordinate of $P:$\n\n$$\n\\begin{aligned}y & =r\\operatorname{sin}⁡\\theta  \\\\  & =4\\operatorname{sin}⁡({225}^{∘}) \\\\  & =4(-\\frac{\\sqrt{2}}{2}) \\\\  & =-2\\sqrt{2}\\end{aligned}\n$$\n\nTherefore, the Cartesian coordinates of $P$ are $(-2\\sqrt{2},-2\\sqrt{2}).$"}] [{:db/id #edb/ref 17592186256393 :knowledge-point/_questions [{:db/id #edb/ref 17592186087669 :knowledge-point/id #uuid "5ec37c5e-8a40-58a7-8af3-4457cd5da43f" :knowledge-point/title "Using the Double-Angle Formula to Simplify Expressions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "05d4fe96-e437-5459-b90d-0a3bdfc1825d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\sqrt{3}\\operatorname{cos}⁡{70}^{∘}" :db/id #edb/ref 17592186253714} {:answer/id #uuid "60f62d48-049d-5a6d-a9e6-66749d676bd2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{3}}{2}\\operatorname{cos}⁡{35}^{∘}" :db/id #edb/ref 17592186254537} {:answer/id #uuid "988c0b62-37ae-5848-98ed-b1e6c7c32632" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{3}\\operatorname{cos}⁡{35}^{∘}" :db/id #edb/ref 17592186255019} {:answer/id #uuid "a00792a6-ab66-5c63-99fe-0e99a6d1bfd9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{3}}{2}\\operatorname{cos}⁡{70}^{∘}" :db/id #edb/ref 17592186255080} {:answer/id #uuid "d0cd2ac8-79c2-55c9-8923-9989a38dea95" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{3}\\operatorname{cos}⁡{70}^{∘}" :db/id #edb/ref 17592186255532}] :answer-field/correct {:answer/id #uuid "d0cd2ac8-79c2-55c9-8923-9989a38dea95" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{3}\\operatorname{cos}⁡{70}^{∘}" :db/id #edb/ref 17592186255532} :answer-field/id #uuid "88f8237f-b76a-5905-b3b4-ed1d154b073e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186256175}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "cf1faff6-afe0-59ea-a58f-f8289c637840" :question/math-academy-id "q-120348" :question/problem "Express $\\sqrt{3}{cos}^{2}⁡{35}^{∘}-\\sqrt{3}{sin}^{2}⁡{35}^{∘}$ as a single trigonometric ratio." :question/worked-solution "Our expression can be factored as follows:\n\n$$\n\\sqrt{3}({cos}^{2}⁡{35}^{∘}-{sin}^{2}⁡{35}^{∘})\n$$\n\nNow, let's recall the double-angle formula for cosine:\n\n$$\n{cos}^{2}⁡x-{sin}^{2}⁡x=\\operatorname{cos}⁡2x\n$$\n\nSubstituting $x={35}^{∘}$ into the above, we get\n\n$$\n\\begin{aligned}{cos}^{2}⁡{35}^{∘}-{sin}^{2}⁡{35}^{∘} & =\\operatorname{cos}⁡(2\\cdot {35}^{∘})=\\operatorname{cos}⁡{70}^{∘}.\\end{aligned}\n$$\n\nFinally, we obtain \n\n$$\n\\begin{aligned}\\sqrt{3}({cos}^{2}⁡{35}^{∘}-{sin}^{2}⁡{35}^{∘})=\\sqrt{3}\\operatorname{cos}⁡{70}^{∘}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186256398 :knowledge-point/_questions [{:db/id #edb/ref 17592186087670 :knowledge-point/id #uuid "12ff17ae-9319-5498-a5e0-1d49ddbef50a" :knowledge-point/title "Using Alternative Forms of Double-Angle Formula to Simplify Expressions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "157cee2f-b39d-5759-8141-9311f65baea4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{2}\\operatorname{cos}⁡{110}^{∘}" :db/id #edb/ref 17592186253857} {:answer/id #uuid "b658d1bf-666b-53ab-86f3-7ef9d39e3d7b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{2}}{2}\\operatorname{cos}⁡{55}^{∘}" :db/id #edb/ref 17592186255284} {:answer/id #uuid "d6a267b4-b9d7-542f-b375-9cbb1aec3915" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\sqrt{2}\\operatorname{cos}⁡{110}^{∘}" :db/id #edb/ref 17592186255571} {:answer/id #uuid "f1c24ae1-987c-52e7-81fe-5a16178072dc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{2}\\operatorname{cos}⁡{55}^{∘}" :db/id #edb/ref 17592186255782} {:answer/id #uuid "f3389054-48e3-5025-9361-e8574b467c1d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}\\operatorname{cos}⁡{110}^{∘}" :db/id #edb/ref 17592186255799}] :answer-field/correct {:answer/id #uuid "157cee2f-b39d-5759-8141-9311f65baea4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{2}\\operatorname{cos}⁡{110}^{∘}" :db/id #edb/ref 17592186253857} :answer-field/id #uuid "20eaadd3-fcd2-5ba3-9fe8-b461ce34013a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186255977}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "de163629-b9d5-5fdd-bc23-30faf9d38fa4" :question/math-academy-id "q-120362" :question/problem "Express $\\sqrt{2}-2\\sqrt{2}{sin}^{2}⁡{55}^{∘}$ as a single trigonometric ratio." :question/worked-solution "Our expression can be factored as follows:\n\n$$\n\\sqrt{2}(1-2{sin}^{2}⁡{55}^{∘})\n$$\n\nNow, let's recall the double-angle formula for cosine:\n\n$$\n1-2{sin}^{2}⁡x=\\operatorname{cos}⁡2x\n$$\n\nSubstituting $x={55}^{∘}$ into the above, we get\n\n$$\n\\begin{aligned}1-2{sin}^{2}⁡{55}^{∘} & =\\operatorname{cos}⁡(2\\cdot {55}^{∘})=\\operatorname{cos}⁡{110}^{∘}.\\end{aligned}\n$$\n\nFinally, we obtain \n\n$$\n\\begin{aligned}\\sqrt{2}(1-2{sin}^{2}⁡{55}^{∘}) & =\\sqrt{2}\\operatorname{cos}⁡{110}^{∘}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186256401 :knowledge-point/_questions [{:db/id #edb/ref 17592186087671 :knowledge-point/id #uuid "2902b205-4508-55c6-9a68-f57d3afc9eab" :knowledge-point/title "Finding Exact Values of Trigonometric Expressions Using the Double-Angle Formula"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0efb571c-483a-563e-90d9-cb87e72aef2d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{3}}{2}" :db/id #edb/ref 17592186253800} {:answer/id #uuid "936a3292-3003-538b-ac5a-bdafbe5c67b4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{\\sqrt{2}}{2}" :db/id #edb/ref 17592186254964} {:answer/id #uuid "ac064fe8-638c-5851-b167-3a2d65119de0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{\\sqrt{3}}{2}" :db/id #edb/ref 17592186255189} {:answer/id #uuid "e2d28c64-588e-564f-b3a3-554152e0f434" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{2}" :db/id #edb/ref 17592186255678} {:answer/id #uuid "f5362cb5-e5e6-5977-80e9-1d87eb6ccfaa" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{2}}{2}" :db/id #edb/ref 17592186255818}] :answer-field/correct {:answer/id #uuid "ac064fe8-638c-5851-b167-3a2d65119de0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{\\sqrt{3}}{2}" :db/id #edb/ref 17592186255189} :answer-field/id #uuid "3966172c-baa0-58e5-bb01-12250853b673" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186256026}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "f9ed8218-8b72-5f11-b5f2-bf16df5e7136" :question/math-academy-id "q-120369" :question/problem "Find the exact value of $1-2{sin}^{2}⁡({75}^{∘}).$" :question/worked-solution "First, let's recall the double-angle formula for cosine:\n\n$$\n1-2{sin}^{2}⁡x=\\operatorname{cos}⁡2x\n$$\n\nSubstituting $x={75}^{∘}$ into the above, we get\n\n$$\n\\begin{aligned}1-2{sin}^{2}⁡({75}^{∘}) & =\\operatorname{cos}⁡(2\\cdot {75}^{∘}) \\\\  & =\\operatorname{cos}⁡{150}^{∘} \\\\  & =-\\frac{\\sqrt{3}}{2}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186395998 :knowledge-point/_questions [{:db/id #edb/ref 17592186087751 :knowledge-point/id #uuid "cf99414e-f1cf-528f-adbb-407cf6e82c4c" :knowledge-point/title "Identifying the Linear Transformation Represented by a Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "015f808a-c2bc-507e-8f20-bbd2cb4811ff" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "Reflection across the $y$-axis" :db/id #edb/ref 17592186396000} {:answer/id #uuid "63d77cc9-bcd1-5fdf-b729-52e06ccab36b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "Dilation with scale factor $12$" :db/id #edb/ref 17592186396001} {:answer/id #uuid "2b02233e-2dae-5a79-9684-11c096b79aaf" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "Reflection in the line $y=12$" :db/id #edb/ref 17592186396002} {:answer/id #uuid "90b07ab8-256d-5a91-b9cc-79d3fb993b83" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "Dilation with scale factor $\\frac{1}{12}$" :db/id #edb/ref 17592186396003} {:answer/id #uuid "c91805f4-1cf7-5369-8fb0-b501bd5870f1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "Reflection in the line $x=12$" :db/id #edb/ref 17592186396004}] :answer-field/correct {:answer/id #uuid "63d77cc9-bcd1-5fdf-b729-52e06ccab36b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "Dilation with scale factor $12$" :db/id #edb/ref 17592186396001} :answer-field/id #uuid "853df19f-413a-5dcd-bd31-575962ee5db9" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186395999}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "0591c45f-50ff-5065-b712-d7946fc4e140" :question/math-academy-id "q-12043" :question/problem "What linear transformation $T$ is represented by the matrix $T=[\\begin{aligned}12 & 0 \\\\ 0 & 12\\end{aligned}]?$" :question/worked-solution "Recall that a dilation of scale factor $k$ is represented by the matrix\n\n$$\n[\\begin{aligned}k & 0 \\\\ 0 & k\\end{aligned}].\n$$\n\nHere, we have $k=12.$ Therefore, the matrix represents a dilation with a scale factor of $12.$"}] [{:db/id #edb/ref 17592186106035 :knowledge-point/_questions [{:db/id #edb/ref 17592186105766 :knowledge-point/id #uuid "c36ce626-1562-51f8-b3fd-d7dc7ce8659c" :knowledge-point/title "Identifying a Shear or Stretch Transformation Represented by a Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "81b8ead8-163c-55e6-afa2-95af3681a7e9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "A horizontal shear with a shear factor of $10$" :db/id #edb/ref 17592186102097} {:answer/id #uuid "9095931b-ff08-5a54-a2fb-955f264244c0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "A stretch of scale factor $10$ in the $x$-direction" :db/id #edb/ref 17592186102098} {:answer/id #uuid "955f0cc5-43f6-5a0e-af94-704b0c7a58c9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "A vertical shear with a shear factor of $1$" :db/id #edb/ref 17592186102099} {:answer/id #uuid "b0555da6-a04e-5144-979c-b0a96959fdd0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "A stretch of scale factor $10$ in the $y$-direction" :db/id #edb/ref 17592186102100} {:answer/id #uuid "273e7475-d054-5f26-b9f1-7bb8aa9231b2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "A vertical shear with a shear factor of $10$" :db/id #edb/ref 17592186102101}] :answer-field/id #uuid "3e5573e5-02b4-5a74-83f5-8f8e0b6b8adb" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186102096} {:answer-field/choices [{:answer/id #uuid "1e0d6486-d718-528b-bd33-68b4cd544cdb" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "A stretch of scale factor $10$ in the $y$-direction" :db/id #edb/ref 17592186396006} {:answer/id #uuid "2ec8852b-bfa4-53a1-8fe2-e8c75b78fa64" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "A vertical shear with a shear factor of $1$" :db/id #edb/ref 17592186396007} {:answer/id #uuid "8c271403-1e23-550b-9359-7ec7a8d9dd0b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "A horizontal shear with a shear factor of $10$" :db/id #edb/ref 17592186396008} {:answer/id #uuid "1e78af7e-059a-524f-9ce9-77e30b3e4934" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "A stretch of scale factor $10$ in the $x$-direction" :db/id #edb/ref 17592186396009} {:answer/id #uuid "db26a554-6026-5b02-9aa7-d6f9e0ad3b18" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "A vertical shear with a shear factor of $10$" :db/id #edb/ref 17592186396010}] :answer-field/correct {:answer/id #uuid "8c271403-1e23-550b-9359-7ec7a8d9dd0b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "A horizontal shear with a shear factor of $10$" :db/id #edb/ref 17592186396008} :answer-field/id #uuid "e17cbcad-7731-506c-bd2a-44566af3416a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186396005}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "6ec67f6b-b339-5863-9fd2-be6322d61819" :question/math-academy-id "q-12044" :question/problem "What linear transformation is represented by the following matrix\n$[\\begin{aligned}1 & 10 \\\\ 0 & 1\\end{aligned}]?$" :question/worked-solution "We can find the images of the standard basis vectors $i$ and $j$ under the action of  $T,$ as follows:\n\n$$\n\\begin{aligned}T(i) & =[\\begin{aligned}1 & 10 \\\\ 0 & 1\\end{aligned}][\\begin{aligned}1 \\\\ 0\\end{aligned}]=[\\begin{aligned}1 \\\\ 0\\end{aligned}]=i \\\\ T(j) & =[\\begin{aligned}1 & 10 \\\\ 0 & 1\\end{aligned}][\\begin{aligned}0 \\\\ 1\\end{aligned}]=[\\begin{aligned}10 \\\\ 1\\end{aligned}]=10i+j\\end{aligned}\n$$\n\nTherefore, the matrix represents a *horizontal* shear with a shear factor of $10.$"}] [{:db/id #edb/ref 17592186256407 :knowledge-point/_questions [{:db/id #edb/ref 17592186092219 :knowledge-point/id #uuid "ad049d53-af38-5917-b9d0-be965cadabcb" :knowledge-point/title "Finding the Cartesian Coordinates of a Point Given Some Information About Another Point"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0a155516-d839-587a-bed9-42b9a2e072c9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(6\\sqrt{3},-6)" :db/id #edb/ref 17592186253747} {:answer/id #uuid "1129da34-d7d1-5e9f-8843-f5403e6bf93a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-\\sqrt{3},-2\\sqrt{3})" :db/id #edb/ref 17592186253820} {:answer/id #uuid "12c049a4-b3f5-57ad-8839-06ff45915613" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(\\sqrt{3},-6)" :db/id #edb/ref 17592186253833} {:answer/id #uuid "4009cc1a-951f-501b-bdc2-6e69fb5a6357" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(4\\sqrt{3},-\\sqrt{3})" :db/id #edb/ref 17592186254222} {:answer/id #uuid "a9834412-7636-54d2-8673-12769dbe9d79" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(6,-6)" :db/id #edb/ref 17592186255166}] :answer-field/correct {:answer/id #uuid "0a155516-d839-587a-bed9-42b9a2e072c9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(6\\sqrt{3},-6)" :db/id #edb/ref 17592186253747} :answer-field/id #uuid "e4d936aa-147e-55d6-93f2-fbed67c48196" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186256328}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "b0e5e2dd-de81-57dc-8848-06ae6eac4cea" :question/math-academy-id "q-120455" :question/problem "The point $A$ has polar coordinates $(r,\\frac{5\\pi }{6})$ and the point $B$ has polar coordinates $({r}^{2},\\frac{11\\pi }{6}).$ Find the Cartesian coordinates of $B$ given that the Cartesian coordinates of $A$ are $(-3,\\sqrt{3}).$" :question/worked-solution "First, we use the Cartesian coordinates of $A$ to find $r,$ the distance between $A$ and the origin:\n\n$$\n\\begin{aligned}r & =\\sqrt{{x}^{2}+{y}^{2}} \\\\  & =\\sqrt{(-3)^{2}+(\\sqrt{3})^{2}} \\\\  & =\\sqrt{12}\\end{aligned}\n$$\n\nConsequently, the polar coordinates of $B$ are\n\n$$\n((\\sqrt{12})^{2},\\frac{11\\pi }{6})=(12,\\frac{11\\pi }{6}).\n$$\n\n \n\nNow, we convert $B$ to Cartesian coordinates. To convert from polar coordinates to Cartesian coordinates, we use\n\n$$\nx=r\\operatorname{cos}⁡\\theta ,\\,y=r\\operatorname{sin}⁡\\theta .\n$$\n\nFirst, we calculate the $x$-coordinate of $B:$\n\n$$\n\\begin{aligned}x & =r\\operatorname{cos}⁡\\theta  \\\\  & =12\\operatorname{cos}⁡(\\frac{11\\pi }{6}) \\\\  & =12(\\frac{\\sqrt{3}}{2}) \\\\  & =6\\sqrt{3}\\end{aligned}\n$$\n\nThen, we calculate the $y$-coordinate of $B:$\n\n$$\n\\begin{aligned}y & =r\\operatorname{sin}⁡\\theta  \\\\  & =12\\operatorname{sin}⁡(\\frac{11\\pi }{6}) \\\\  & =12(-\\frac{1}{2}) \\\\  & =-6\\end{aligned}\n$$\n\nTherefore, the Cartesian coordinates of $B$ are $(6\\sqrt{3},-6).$"}] [{:db/id #edb/ref 17592186256409 :knowledge-point/_questions [{:db/id #edb/ref 17592186092219 :knowledge-point/id #uuid "ad049d53-af38-5917-b9d0-be965cadabcb" :knowledge-point/title "Finding the Cartesian Coordinates of a Point Given Some Information About Another Point"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "15a02ee7-0c84-56f1-bbf0-ebb90394da60" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-2,-2\\sqrt{3})" :db/id #edb/ref 17592186253859} {:answer/id #uuid "39bbabdf-ded0-54de-9bce-39f8a04d806d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(0,-4)" :db/id #edb/ref 17592186254176} {:answer/id #uuid "6f9d34e5-3a45-5295-96d7-05130d5b7bc6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-4,0)" :db/id #edb/ref 17592186254659} {:answer/id #uuid "7a7d44b2-7e30-57fa-9135-30c7aad08a99" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(2\\sqrt{3},-2)" :db/id #edb/ref 17592186254758} {:answer/id #uuid "c869f985-2a3d-5a8b-ba06-6ea45dcdacab" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(1,3)" :db/id #edb/ref 17592186255454}] :answer-field/correct {:answer/id #uuid "39bbabdf-ded0-54de-9bce-39f8a04d806d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(0,-4)" :db/id #edb/ref 17592186254176} :answer-field/id #uuid "8600f656-d47f-52c4-96f7-5d633c8eeb59" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186256169}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "6d3f790c-6d1a-5380-94bb-56056dda53c1" :question/math-academy-id "q-120468" :question/problem "The point $A$ has polar coordinates $(2,\\theta )$ and the point $B$ has polar coordinates $(4,\\theta +\\frac{\\pi }{3}).$ Find the Cartesian coordinates of $B$ given that the Cartesian coordinates of $A$ are $(-\\sqrt{3},-1).$" :question/worked-solution "First, we use the Cartesian coordinates of $A$ to find its reference angle ${\\theta }_{R}:$\n\n$$\n\\begin{aligned}{\\theta }_{R} & =\\operatorname{arctan}⁡(\\frac{-1}{-\\sqrt{3}}) \\\\  & =\\operatorname{arctan}⁡(1/\\sqrt{3}) \\\\  & =\\frac{\\pi }{6}.\\end{aligned}\n$$\n\nSince the point $A$ lies in the third quadrant, we have $\\theta =\\pi +{\\theta }_{R}=\\frac{7\\pi }{6}.$ Consequently, the polar coordinates of $B$ are\n\n$$\n(4,\\frac{7\\pi }{6}+\\frac{\\pi }{3})=(4,\\frac{3\\pi }{2}).\n$$\n\nNow, we convert $B$ to Cartesian coordinates. To convert from polar coordinates to Cartesian coordinates, we use\n\n$$\nx=r\\operatorname{cos}⁡\\theta ,\\,y=r\\operatorname{sin}⁡\\theta .\n$$\n\nFirst, we calculate the $x$-coordinate of $B:$\n\n$$\n\\begin{aligned}x & =r\\operatorname{cos}⁡\\theta  \\\\  & =4\\cdot \\operatorname{cos}⁡(\\frac{3\\pi }{2}) \\\\  & =0\\end{aligned}\n$$\n\nThen, we calculate the $y$-coordinate of $B:$\n\n$$\n\\begin{aligned}y & =r\\operatorname{sin}⁡\\theta  \\\\  & =4\\cdot \\operatorname{sin}⁡(\\frac{3\\pi }{2}) \\\\  & =-4\\end{aligned}\n$$\n\nTherefore, the Cartesian coordinates of $B$ are $(0,-4).$"}] [{:db/id #edb/ref 17592186400003 :knowledge-point/_questions [{:db/id #edb/ref 17592186115181 :knowledge-point/id #uuid "a9a3d8db-a6e0-5c96-9c75-415d4a75cf4d" :knowledge-point/title "Identifying Equations With No Solutions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "36bbe8cc-ddc2-5919-b270-7b19d0e48220" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186400005} {:answer/id #uuid "0cb03412-8e94-5385-8192-91a634686b1d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186400006} {:answer/id #uuid "00f5a9e7-5ff9-5cab-b4da-0f197eec9b0b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186400007} {:answer/id #uuid "7e59753b-1300-571d-af93-523d0d3e5ed0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186400008} {:answer/id #uuid "7632167a-b938-5b51-97c0-caab71755856" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186400009}] :answer-field/correct {:answer/id #uuid "00f5a9e7-5ff9-5cab-b4da-0f197eec9b0b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186400007} :answer-field/id #uuid "2b975aa1-8b82-5577-bfb9-2e2bcc3315d9" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186400004}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "a9e6cde4-30d8-5716-a4a4-97a88908653f" :question/math-academy-id "q-120485" :question/problem "Which of the following equations has no solutions for ${0}^{∘}\\le x<{360}^{∘}?$\n\nI. $\\operatorname{sec}⁡x=7$ $$\nII. $\\sqrt{3}\\operatorname{sec}⁡x+2=2\\sqrt{3}\\operatorname{sec}⁡x$ $$\nIII. $7\\operatorname{sec}⁡x=-5$" :question/worked-solution "We first simplify the given equations, and get\n\n- $\\operatorname{sec}⁡x=7$ $$\n- $\\operatorname{sec}⁡x=\\frac{2}{\\sqrt{3}}$\n- $\\operatorname{sec}⁡x=-\\frac{5}{7}$\n\nNow, recall that the range of $\\operatorname{sec}⁡x$ for ${0}^{∘}\\le x<{360}^{∘}$ is given by\n\n$$\n\\operatorname{sec}⁡x\\in (-\\infty ,-1]\\cup [1,\\infty ).\n$$\n\nSo, the equation $\\operatorname{sec}⁡x=k$ has no solutions for $k\\in (-1,1).$ \n\nTherefore, of the given equations, only equation III has no solutions."}] [{:db/id #edb/ref 17592186387008 :knowledge-point/_questions [{:db/id #edb/ref 17592186096794 :knowledge-point/id #uuid "66c43200-991b-5854-be1d-fa9db80f3725" :knowledge-point/title "Expressing a Vector as a Sum or Difference of Two Known Vectors"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "60fa9802-8c91-55e9-84a5-e1363e2e7308" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\overset{\\to }{QT}=b-c" :db/id #edb/ref 17592186387010} {:answer/id #uuid "9d30e4cd-7866-5dc8-9d17-e3603b0e1d04" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\overset{\\to }{QT}=b+c" :db/id #edb/ref 17592186387011} {:answer/id #uuid "0e6b1f27-9577-571f-a402-5318532c66a7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\overset{\\to }{QT}=a-b" :db/id #edb/ref 17592186387012} {:answer/id #uuid "6efc2e18-f131-54ef-8b65-97d65d26fb87" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\overset{\\to }{QT}=a+b" :db/id #edb/ref 17592186387013} {:answer/id #uuid "4939a251-4f3d-5483-a371-05ba68aaf27c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\overset{\\to }{QT}=a+d" :db/id #edb/ref 17592186387014}] :answer-field/correct {:answer/id #uuid "0e6b1f27-9577-571f-a402-5318532c66a7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\overset{\\to }{QT}=a-b" :db/id #edb/ref 17592186387012} :answer-field/id #uuid "80e3c074-2fe2-56ad-8be9-99fa6a58e9b4" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186387009}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "b958283a-525c-51ab-a33e-68049ee3df0d" :question/math-academy-id "q-12049" :question/problem "![](images/2f/2f9e6eff196e24ddabca8d778d27e499fc1b856ef7169257a31a7cbaca8b564b.png)\n\nConsider the diagram shown above, where $\\overset{\\to }{QP}=a,$ $\\overset{\\to }{TP}=b,$ $\\overset{\\to }{TS}=c,$ and $\\overset{\\to }{RS}=d.$ Find $\\overset{\\to }{QT}$ in terms of $a,b,c,$ and $d.$" :question/worked-solution "We want to find a \"path\" from $Q$ to $T$ consisting only of the vectors $a,b,c,$ and $d.$\n\nAccording to the triangle law of addition,\n\n$$\n\\overset{\\to }{QT}=\\overset{\\to }{QP}+\\overset{\\to }{PT},\n$$\n\nas shown below.\n\n![](images/e1/e1d5eb2f392332f69fa1507899b30b838a42ebd1c40dacddeca4edcf0f7aa8c2.png)\n\n \n\nNow, from the original diagram, we have that\n\n$$\n\\overset{\\to }{QP}=a,\\,\\overset{\\to }{PT}=-b.\n$$\n\nLet's add these to our diagram.\n\n![](images/0e/0e8e24968141284550fac7d4e5c63333789f30ade8f7d5dd8b87fae4e012673a.png)\n\n \n\nTherefore, we obtain\n\n$$\n\\begin{aligned}\\overset{\\to }{QT} & =\\overset{\\to }{QP}+\\overset{\\to }{PT} \\\\  & =a+(-b) \\\\  & =a-b\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186387015 :knowledge-point/_questions [{:db/id #edb/ref 17592186115182 :knowledge-point/id #uuid "145bdcf2-b1d5-54a8-bd95-4b054d7a33f0" :knowledge-point/title "Solving Trigonometric Equations Involving Cosecant with Special Angles"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8af1639e-fabe-50f7-9169-1b4edc031f7c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "36\\,000" :db/id #edb/ref 17592186387017} {:answer/id #uuid "606b60d6-6925-52a7-9990-45232a53c94a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "69\\,300" :db/id #edb/ref 17592186387018} {:answer/id #uuid "a7eef4c8-eeed-522e-a869-4cc328c34fe0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "49\\,500" :db/id #edb/ref 17592186387019} {:answer/id #uuid "b67293a3-a05b-5dd0-b551-121096a709c3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "79\\,200" :db/id #edb/ref 17592186387020} {:answer/id #uuid "d14149ef-09e5-57ac-afbe-9dbe9e2ee161" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "63\\,000" :db/id #edb/ref 17592186387021}] :answer-field/correct {:answer/id #uuid "606b60d6-6925-52a7-9990-45232a53c94a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "69\\,300" :db/id #edb/ref 17592186387018} :answer-field/id #uuid "96f86185-7829-51c3-a1ea-36683535a8d5" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186387016}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "398ff4f2-a514-55ba-ad0a-235934ea5e85" :question/math-academy-id "q-120532" :question/problem "Given that ${x}_{1}$ and ${x}_{2}$ are the solutions to the equation $\\operatorname{csc}⁡x+3=-1-\\operatorname{csc}⁡x$ for ${0}^{∘}\\le x<{360}^{∘},$ what is the numerical value of ${x}_{1}\\cdot {x}_{2}?$" :question/worked-solution "First, we rearrange the equation, isolating $\\operatorname{csc}⁡x:$\n\n$$\n\\begin{aligned}\\operatorname{csc}⁡x+3 & =-1-\\operatorname{csc}⁡x \\\\ 2\\operatorname{csc}⁡x & =-4 \\\\ \\operatorname{csc}⁡x & =-2\\end{aligned}\n$$\n\nRecall that $\\operatorname{csc}⁡x=\\frac{1}{\\operatorname{sin}⁡x},$ therefore the given equation is equivalent to\n\n$$\n\\operatorname{sin}⁡x=-\\frac{1}{2}.\n$$\n\nNow, we find the principal value: \n\n$$\nx=\\text{arcsin}(-\\frac{1}{2})=-{30}^{∘}\n$$\n\nThis value is outside the required domain. To get a value inside the range, we add ${360}^{∘}.$ \n\n$$\n{x}_{1}=x+{360}^{∘}=-{30}^{∘}+{360}^{∘}={330}^{∘}.\n$$\n\nSo,  our first solution is ${x}_{1}={330}^{∘}.$\n\nOur first solution lies in the fourth quadrant and has a reference angle of ${\\theta }_{R}={30}^{∘}.$ Since $\\operatorname{sin}⁡x<0,$ the second solution must lie in the third quadrant, and it also has a reference angle ${\\theta }_{R}={30}^{∘}.$\n\n![](images/b3/b3c523e882baf0b3a105e10131091e40de686b4c1483f46e7bdc235e30743a6d.png)\n\nSince the second solution ${x}_{2}$ lies in the $3$rd quadrant, we can find it using the reference angle as follows:\n\n$$\n\\begin{aligned}{x}_{2} & ={180}^{∘}+{\\theta }_{R} \\\\  & ={180}^{∘}+{30}^{∘} \\\\  & ={210}^{∘}\\end{aligned}\n$$\n\nSo, the solutions are $x={210}^{∘},{330}^{∘}.$\n\nFinally,\n\n$$\n{x}_{1}\\cdot {x}_{2}=210\\cdot 330=69\\,300.\n$$"}] [{:db/id #edb/ref 17592186256417 :knowledge-point/_questions [{:db/id #edb/ref 17592186105727 :knowledge-point/id #uuid "d766de83-9394-57be-84a4-bb88f5ddf792" :knowledge-point/title "Calculating the Magnitude of a Vector Given in Component Form"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4ad94684-b259-5c68-93b3-6c670af48230" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "10" :db/id #edb/ref 17592186254313} {:answer/id #uuid "51c9cf4e-46c9-5836-96a4-58587a21fa7e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{10}" :db/id #edb/ref 17592186254379} {:answer/id #uuid "81b1e638-bbdb-5d08-96e3-a8f22fe6ada5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{2}" :db/id #edb/ref 17592186254818} {:answer/id #uuid "c146863e-e23b-597a-ac92-8a57382b02e2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186255392} {:answer/id #uuid "c1b70220-563a-503e-8ef2-47cc62c99cf4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\sqrt{2}" :db/id #edb/ref 17592186255399}] :answer-field/correct {:answer/id #uuid "51c9cf4e-46c9-5836-96a4-58587a21fa7e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{10}" :db/id #edb/ref 17592186254379} :answer-field/id #uuid "f33f2913-d760-5769-a653-4234851581ce" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186256352}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "10010191-d9e5-5c11-888d-317965c9e088" :question/math-academy-id "q-120543" :question/problem "Given that $w=⟨-1,0,3⟩$, find $|\\,w\\,|.$" :question/worked-solution "Using the formula, we have\n\n$$\n\\begin{aligned}|\\,w\\,| & =\\sqrt{{w}_{x}^{2}+{w}_{y}^{2}+{w}_{z}^{2}} \\\\  & =\\sqrt{(-1)^{2}+{0}^{2}+{3}^{2}} \\\\  & =\\sqrt{1+0+9} \\\\  & =\\sqrt{10}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186256418 :knowledge-point/_questions [{:db/id #edb/ref 17592186096725 :knowledge-point/id #uuid "ef975f49-bb8f-5493-abff-225d8d5be778" :knowledge-point/title "Computing a Probability Involving Mutually Exclusive Events: Word Problems"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0936487e-5454-5687-83ed-78621369891c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{20}" :db/id #edb/ref 17592186253738} {:answer/id #uuid "271a98c1-94c5-5941-aecb-d70ee45a1503" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{13}{19}" :db/id #edb/ref 17592186254015} {:answer/id #uuid "571b3010-4986-52e5-9a8d-af6f49a1d619" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{10}" :db/id #edb/ref 17592186254437} {:answer/id #uuid "6ee09344-02ed-5cb5-a0be-840c3cbd118a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{10}" :db/id #edb/ref 17592186254655} {:answer/id #uuid "8237f27f-12e1-578d-9a70-e5d888405c93" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2}{19}" :db/id #edb/ref 17592186254825}] :answer-field/correct {:answer/id #uuid "271a98c1-94c5-5941-aecb-d70ee45a1503" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{13}{19}" :db/id #edb/ref 17592186254015} :answer-field/id #uuid "c7e2bb51-d59c-5d36-9863-91fcad8a3f21" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186256273}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "ef44a98c-d5e4-53f7-ad1a-45b75b68cb54" :question/math-academy-id "q-120545" :question/problem "On a shelf, there are $11$ novels and $9$ science books. $1$ of the novels and $3$ of the science books are illustrated. The illustrated novel is taken from the shelf and set apart. If a single book is selected at random, what is the probability that it is a novel or an illustrated book?" :question/worked-solution "Let $I$ be the event that the selected book is an illustrated book, and let $N$ be the event that it is a novel. Then the probability that the selected book is a novel or an illustrated book is given by $P(I\\cup N).$\n\nSince the only illustrated novel was removed, there are no novels left on the shelf that are also illustrated. Therefore, $I$ and $N$ are mutually exclusive events, i.e., $P(I\\cap N)=0.$\n\nSince the illustrated novel was set apart, there are $10+9=19$ books remaining, of which $10$ are novels and $3$ are illustrated. Therefore,\n\n$$\n\\begin{aligned}P(I) & =\\frac{3}{19}, \\\\ P(N) & =\\frac{10}{19}.\\end{aligned}\n$$\n\nFinally, by the addition law, we have\n\n$$\n\\begin{aligned}P(I\\cup N) & =P(I)+P(N)-P(I\\cap N) \\\\  & =\\frac{3}{19}+\\frac{10}{19}-0 \\\\  & =\\frac{3+10}{19} \\\\  & =\\frac{13}{19}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186256422 :knowledge-point/_questions [{:db/id #edb/ref 17592186115221 :knowledge-point/id #uuid "f9ccf6b5-e087-5f7b-88e3-3767efbdcc26" :knowledge-point/title "Solving Trigonometric Equations Involving Cosecant with Non-Special Angles"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "02ff9959-ca10-5d50-995e-9e7fc0a2ad71" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "21.6" :db/id #edb/ref 17592186253691} {:answer/id #uuid "1e6614a7-5303-5a86-b8cd-80177e3f6c89" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "18.3" :db/id #edb/ref 17592186253927} {:answer/id #uuid "cf956aba-0090-5814-94bf-4c8327470726" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "19.5" :db/id #edb/ref 17592186255518} {:answer/id #uuid "de82359d-710c-5888-a2ae-b5acf0631f1f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "22.4" :db/id #edb/ref 17592186255645} {:answer/id #uuid "fc2b8802-7b55-5d8a-a56d-40851bbbb9e7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "20.2" :db/id #edb/ref 17592186255886}] :answer-field/correct {:answer/id #uuid "fc2b8802-7b55-5d8a-a56d-40851bbbb9e7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "20.2" :db/id #edb/ref 17592186255886} :answer-field/id #uuid "dad99ebe-2b05-56c4-9d59-745b53b7613f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186256311}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "18ab8ec6-b553-56a9-a2fc-b97b7ef3fec1" :question/math-academy-id "q-120556" :question/problem "Given that ${x}_{1}$ and ${x}_{2}$ are the solutions to the equation $\\operatorname{csc}⁡x=-6$ for $0\\le x<2\\pi ,$ what is the value of ${x}_{1}\\cdot {x}_{2},$ rounded to one decimal place?" :question/worked-solution "Recall that $\\operatorname{csc}⁡x=\\frac{1}{\\operatorname{sin}⁡x},$ therefore the given equation is equivalent to\n\n$$\n\\operatorname{sin}⁡x=-\\frac{1}{6}.\n$$\n\nNow, we find the principal value:\n\n$$\nx=\\operatorname{arcsin}⁡(-\\frac{1}{6})=-0.167\\,448…≈-0.167\\,4\n$$\n\nThis value is outside the required domain. To get a value inside the range, we add $2\\pi .$\n\n$$\n{x}_{1}=-0.167\\,4+2\\pi =6.115\\,785…≈6.115\\,8\n$$\n\nOur first solution lies in the fourth quadrant and has a reference angle of ${\\theta }_{R}=0.167\\,4.$ Since $\\operatorname{sin}⁡x<0,$ the second solution must lie in the third quadrant, and it also has a reference angle ${\\theta }_{R}=0.167\\,4.$\n\n![](images/f6/f6f08d799cd2d2e80494d94cc3b18a61f73227b88b25d79c926d65e161d4ce3a.png)\n\nSince the second solution ${x}_{2}$ lies in the $3$rd quadrant, we can find it using the reference angle as follows:\n\n$$\n\\begin{aligned}{x}_{2} & =\\pi +{\\theta }_{R} \\\\  & =\\pi +0.167\\,4 \\\\  & ≈3.309\\,0\\end{aligned}\n$$\n\nFinally,\n\n$$\n{x}_{1}\\cdot {x}_{2}=6.115\\,8\\cdot 3.309\\,0=20.2\n$$\n\nrounded to one decimal place."}] [{:db/id #edb/ref 17592186256425 :knowledge-point/_questions [{:db/id #edb/ref 17592186092273 :knowledge-point/id #uuid "386a4f1a-4ee5-5bf7-aff2-e190c83f4529" :knowledge-point/title "Finding the Cartesian Coordinates of a Point Using a Diagram"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0484ad77-2f99-5c81-a6cb-a1158be44d88" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-2,-2)" :db/id #edb/ref 17592186253704} {:answer/id #uuid "15246ab6-3ecb-5633-9b4e-b73f8ed07f54" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-4\\sqrt{2},-4)" :db/id #edb/ref 17592186253853} {:answer/id #uuid "31095a2e-0934-55af-abe5-a2f05014f85f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(4,-4)" :db/id #edb/ref 17592186254098} {:answer/id #uuid "3f307f37-58c4-56a4-a6dd-e9b99b686e71" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(4,4\\sqrt{2})" :db/id #edb/ref 17592186254213} {:answer/id #uuid "e1629e74-354a-56e5-bbe5-bfd524f9a56f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(2,-2\\sqrt{2})" :db/id #edb/ref 17592186255670}] :answer-field/correct {:answer/id #uuid "31095a2e-0934-55af-abe5-a2f05014f85f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(4,-4)" :db/id #edb/ref 17592186254098} :answer-field/id #uuid "e62cfd60-2bdd-5ae1-8632-0391624de18c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186256330}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "4cadc848-bed5-5538-a431-ac83515fffa4" :question/math-academy-id "q-120597" :question/problem "![](images/fd/fd38e4bed4f11f07f2c6901a74c7543655f5ff8a95b8b049e54ff4ff4dd409ee.png)\n\nThe diagram above shows a circle of radius $r$ centered at the origin. If the polar coordinates of the point $A$ are $(4\\sqrt{2},{150}^{∘})$ and $m∠AOB={165}^{∘},$ what are the Cartesian coordinates of $B?$" :question/worked-solution "First, since $A$ has polar coordinates $(4\\sqrt{2},{150}^{∘}),$ we must have $r=4\\sqrt{2}.$ Also, since the points $A$ and $B$ both lie on a circle of radius $4\\sqrt{2},$ the $r$-coordinate of $B$ must also be $4\\sqrt{2}.$  \n\nNotice that one must traverse the circle counterclockwise to move from the point $A$ to point $B.$ Since the $\\theta $-coordinate of $A$ is ${150}^{∘},$ the $\\theta $-coordinate of $B$ must be\n\n$$\n{\\theta }_{B}={150}^{∘}+{165}^{∘}={315}^{∘}.\n$$\n\nSo, the polar coordinates of $B$ are $(4\\sqrt{2},{315}^{∘})$\n\nNow, we convert $B$ to Cartesian coordinates. To convert from polar coordinates to Cartesian coordinates, we use\n\n$$\nx=r\\operatorname{cos}⁡\\theta ,\\,y=r\\operatorname{sin}⁡\\theta .\n$$\n\nFirst, we calculate the $x$-coordinate of $B:$\n\n$$\n\\begin{aligned}x & =r\\operatorname{cos}⁡\\theta  \\\\  & =4\\sqrt{2}\\operatorname{cos}⁡({315}^{∘}) \\\\  & =4\\sqrt{2}\\cdot \\frac{\\sqrt{2}}{2} \\\\  & =4\\end{aligned}\n$$\n\nThen, we calculate the $y$-coordinate of $B:$\n\n$$\n\\begin{aligned}y & =r\\operatorname{sin}⁡\\theta  \\\\  & =4\\sqrt{2}\\operatorname{sin}⁡({315}^{∘}) \\\\  & =4\\sqrt{2}(-\\frac{\\sqrt{2}}{2}) \\\\  & =-4\\end{aligned}\n$$\n\nTherefore, the Cartesian coordinates of $B$ are $(4,-4).$"}] [{:db/id #edb/ref 17592186256426 :knowledge-point/_questions [{:db/id #edb/ref 17592186092273 :knowledge-point/id #uuid "386a4f1a-4ee5-5bf7-aff2-e190c83f4529" :knowledge-point/title "Finding the Cartesian Coordinates of a Point Using a Diagram"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9724a5f6-c9f4-536a-a17b-5425407b9c7d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(1,1)" :db/id #edb/ref 17592186255002} {:answer/id #uuid "ea54590c-b0df-5003-9417-4c09af7236b1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(\\sqrt{2},\\sqrt{2})" :db/id #edb/ref 17592186255723} {:answer/id #uuid "eb87a981-771e-5056-8d37-a93f3b1e2bef" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(2,2)" :db/id #edb/ref 17592186255730} {:answer/id #uuid "feab8e4b-ee4c-5116-8ef8-f1f48cf2bd2f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(\\sqrt{2},2)" :db/id #edb/ref 17592186255909} {:answer/id #uuid "ff088a24-bea8-531d-8f92-d5dff5c8b72a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(2,\\sqrt{2})" :db/id #edb/ref 17592186255913}] :answer-field/correct {:answer/id #uuid "ea54590c-b0df-5003-9417-4c09af7236b1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(\\sqrt{2},\\sqrt{2})" :db/id #edb/ref 17592186255723} :answer-field/id #uuid "47c6223c-72f8-56bd-b93f-b161db175405" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186256059}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "1f77f386-bd94-517d-b58d-73799834bcb9" :question/math-academy-id "q-120598" :question/problem "![](images/47/475bda1ee758774ec9b07ec12a0ed92e56c4b571fd39f6e1ecca439278106ea6.png)\n\nThe diagram above shows a circle of radius $r$ centered at the origin. If the polar coordinates of the point $A$ are $(2,{240}^{∘})$ and $m∠AOB={195}^{∘},$ what are the Cartesian coordinates of $B?$" :question/worked-solution "First, since $A$ has polar coordinates $(2,{240}^{∘}),$ we must have $r=2.$ Also, since the points $A$ and $B$ both lie on a circle of radius $2,$ the $r$-coordinate of $B$ must also be $2.$\n\nNotice that one must traverse the circle clockwise to move from the point $A$ to point $B.$ Since the $\\theta $-coordinate of $A$ is ${240}^{∘},$ the $\\theta $-coordinate of $B$ must be\n\n$$\n{\\theta }_{B}={240}^{∘}-{195}^{∘}={45}^{∘}.\n$$\n\nSo, the polar coordinates of $B$ are $(2,{45}^{∘})$\n\nNow, we convert $B$ to Cartesian coordinates. To convert from polar coordinates to Cartesian coordinates, we use\n\n$$\nx=r\\operatorname{cos}⁡\\theta ,\\,y=r\\operatorname{sin}⁡\\theta .\n$$\n\nFirst, we calculate the $x$-coordinate of $B:$\n\n$$\n\\begin{aligned}x & =r\\operatorname{cos}⁡\\theta  \\\\  & =2\\operatorname{cos}⁡({45}^{∘}) \\\\  & =2(\\frac{\\sqrt{2}}{2}) \\\\  & =\\sqrt{2}\\end{aligned}\n$$\n\nThen, we calculate the $y$-coordinate of $B:$\n\n$$\n\\begin{aligned}y & =r\\operatorname{sin}⁡\\theta  \\\\  & =2\\operatorname{sin}⁡({45}^{∘}) \\\\  & =2\\cdot \\frac{\\sqrt{2}}{2} \\\\  & =\\sqrt{2}\\end{aligned}\n$$\n\nTherefore, the Cartesian coordinates of $B$ are $(\\sqrt{2},\\sqrt{2}).$"}] [{:db/id #edb/ref 17592186387022 :knowledge-point/_questions [{:db/id #edb/ref 17592186133750 :knowledge-point/id #uuid "407616a9-e448-5652-9882-a1edf19600f8" :knowledge-point/title "Identifying a Radial Line Given Its Polar Equation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "eeb3ea5c-e17a-5133-8dd6-69250aaec174" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/47/479df1b8aafdc4c061d221cbf5079958289178d982a33bb118934850ff889373.png" :db/id #edb/ref 17592186387024} {:answer/id #uuid "ab5ee7f1-310c-57d0-a498-f20e66ba5c3d" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/f5/f548b48d223ba5164e8e7335b67dc27dd89347bc368be0cc992c456fe5360b85.png" :db/id #edb/ref 17592186387025} {:answer/id #uuid "e3fa4b48-3218-5177-81c4-7d373df6d679" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/82/82bf2fb643852163329b767d2cf8767c9ed8411060092f1652143e3842727ca2.png" :db/id #edb/ref 17592186387026} {:answer/id #uuid "fd8981da-b767-535a-87cb-a0ffd8c2a5bc" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/79/7931fc318d080dbace3b1fea585f5d31449fc2dd4ceda000d659cacb43096beb.png" :db/id #edb/ref 17592186387027} {:answer/id #uuid "0fe59ba9-dbba-5706-910e-8bda39e456c1" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/42/423d9cb637371b49b351145113d40905ea786029c244ac949ee5059ea5c7315b.png" :db/id #edb/ref 17592186387028}] :answer-field/correct {:answer/id #uuid "ab5ee7f1-310c-57d0-a498-f20e66ba5c3d" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/f5/f548b48d223ba5164e8e7335b67dc27dd89347bc368be0cc992c456fe5360b85.png" :db/id #edb/ref 17592186387025} :answer-field/id #uuid "c381b20e-76c5-566c-ad47-b7731e93267b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186387023}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "e4c78c8d-b767-562b-87b5-e9b873530467" :question/math-academy-id "q-120607" :question/problem "Which of the following is the graph of the polar curve  $\\theta =\\frac{5\\pi }{6}?$" :question/worked-solution "The polar curve defined by the equation $\\theta =\\frac{5\\pi }{6}$ is the ray that starts at the origin and makes a counterclockwise angle of $\\frac{5\\pi }{6}$ with the positive $x$-axis.\n\nThe correct answer is shown below.\n\n![](images/f5/f548b48d223ba5164e8e7335b67dc27dd89347bc368be0cc992c456fe5360b85.png)"}] [{:db/id #edb/ref 17592186400010 :knowledge-point/_questions [{:db/id #edb/ref 17592186115222 :knowledge-point/id #uuid "80449399-3ae4-593f-8c3b-00bcdcc99727" :knowledge-point/title "Solving Trigonometric Equations Outside of the Range of Cosecant"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3e99f652-e012-503c-97ae-9e43e478b1cb" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186400012} {:answer/id #uuid "c83a4309-acbf-5679-9e28-465cf4e9d799" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186400013} {:answer/id #uuid "6f833c32-c9f2-5bff-b68d-05c9a5598f8c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186400014} {:answer/id #uuid "8444d1db-6a27-52c8-bd42-58d682c3d6b1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186400015} {:answer/id #uuid "68a0723d-e0c2-5c94-b776-962ebe8b99f2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186400016}] :answer-field/correct {:answer/id #uuid "3e99f652-e012-503c-97ae-9e43e478b1cb" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186400012} :answer-field/id #uuid "70f71519-cda9-5a9b-a1db-b744f73d4f1a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186400011}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "93bbf63d-41f5-5cec-8b52-34cf770cf20e" :question/math-academy-id "q-120614" :question/problem "Which of the following equations has no solutions for $0\\le x<2\\pi ?$\n\nI. $5-\\operatorname{csc}⁡x=4\\operatorname{csc}⁡x$\nII. $\\sqrt{2}\\operatorname{csc}⁡x=2-\\sqrt{2}\\operatorname{csc}⁡x$\nIII. $5\\operatorname{csc}⁡x-3=-2$" :question/worked-solution "We first simplify the given equations, and get\n\n- $\\operatorname{csc}⁡x=1$\n- $\\operatorname{csc}⁡x=\\frac{\\sqrt{2}}{2}$\n- $\\operatorname{csc}⁡x=\\frac{1}{5}$\n\nNow, recall that the range of $\\operatorname{csc}⁡x$ for $0\\le x<2\\pi $ is given by\n\n$$\n\\operatorname{csc}⁡x\\in (-\\infty ,-1]\\cup [1,\\infty ).\n$$\n\nSo, the equation $\\operatorname{csc}⁡x=k$ has no solutions for $k\\in (-1,1).$ \n\nTherefore, of the given equations, only equations II and III has no solutions."}] [{:db/id #edb/ref 17592186256434 :knowledge-point/_questions [{:db/id #edb/ref 17592186110665 :knowledge-point/id #uuid "91100afb-9a36-57c0-9f30-4692cfef0b93" :knowledge-point/title "Simplifying an Expression Using the Secant-Tangent and Other Identities"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0563d615-ffa2-5a2e-a34a-325a3b3cd4b8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{cot}⁡x" :db/id #edb/ref 17592186253709} {:answer/id #uuid "4c3a13ca-0c91-59ed-aa40-aec07d5043d7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{cot}⁡x+1" :db/id #edb/ref 17592186254324} {:answer/id #uuid "79b3ea54-b3ba-5165-91dc-a1dbc40be7c4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{cot}^{2}⁡x" :db/id #edb/ref 17592186254747} {:answer/id #uuid "7b13a578-e470-566f-813b-75474312fb7d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1-{cot}^{2}⁡x" :db/id #edb/ref 17592186254763} {:answer/id #uuid "a2fe877d-f681-58d7-ad42-7a9c39a14713" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2-\\operatorname{cot}⁡x" :db/id #edb/ref 17592186255107}] :answer-field/correct {:answer/id #uuid "79b3ea54-b3ba-5165-91dc-a1dbc40be7c4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{cot}^{2}⁡x" :db/id #edb/ref 17592186254747} :answer-field/id #uuid "460c587f-198c-589f-9fc8-f74bfbf671fa" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186256051}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "93375bd6-9a3b-584f-abb5-493a4e9eddf0" :question/math-academy-id "q-120631" :question/problem "$\\frac{1}{(1-{cos}^{2}⁡x)(1+{tan}^{2}⁡x)}=$" :question/worked-solution "First, let's recall the secant-tangent identity:\n\n$$\n1+{tan}^{2}⁡\\theta ={sec}^{2}⁡\\theta \n$$\n\nWe rewrite the given expression using the secant-tangent identity as follows:\n\n$$\n\\begin{aligned}\\frac{1}{(1-{cos}^{2}⁡x)(1+{tan}^{2}⁡x)} & =\\frac{1}{(1-{cos}^{2}⁡x)\\cdot ({sec}^{2}⁡x)}\\end{aligned}\n$$\n\n \n\nNext, we recall the following identities:\n\n$$\n1-{cos}^{2}⁡x={sin}^{2}⁡x,\\,\\operatorname{sec}⁡x=\\frac{1}{\\operatorname{cos}⁡x},\\,\\operatorname{tan}⁡\\theta =\\frac{\\operatorname{sin}⁡x}{\\operatorname{cos}⁡x},\\,\\operatorname{cot}⁡x=\\frac{1}{\\operatorname{tan}⁡x}\n$$\n\n \n\nUsing the above identities, we can further simplify our expression as follows:\n\n$$\n\\begin{aligned}\\frac{1}{(1-{cos}^{2}⁡x)\\cdot ({sec}^{2}⁡x)} & =\\frac{1}{({sin}^{2}⁡x\\cdot \\frac{1}{{cos}^{2}⁡x})} \\\\  & =\\frac{1}{(\\frac{{sin}^{2}⁡x}{{cos}^{2}⁡x})} \\\\  & =\\frac{1}{{(\\frac{\\operatorname{sin}⁡x}{\\operatorname{cos}⁡x})}^{2}} \\\\  & =\\frac{1}{{tan}^{2}⁡x} \\\\  & ={cot}^{2}⁡x\\end{aligned}\n$$\n\nTherefore, we conclude that\n\n$$\n\\frac{1}{(1-{cos}^{2}⁡x)(1+{tan}^{2}⁡x)}={cot}^{2}⁡x.\n$$"}] [{:db/id #edb/ref 17592186256437 :knowledge-point/_questions [{:db/id #edb/ref 17592186110666 :knowledge-point/id #uuid "7640012b-79f9-5f6b-a26b-a7f4fe8c0e7b" :knowledge-point/title "Simplifying an Expression Using the Secant-Tangent Identity: Replacing a Squared Secant"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "14d2b769-b7bb-53fc-b947-c01c1ce161df" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2-{tan}^{2}⁡\\theta " :db/id #edb/ref 17592186253851} {:answer/id #uuid "78a4b292-89ce-53d4-8475-fdda7bfe40c6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{tan}⁡\\theta " :db/id #edb/ref 17592186254736} {:answer/id #uuid "a7224c22-fb60-5cd3-8f52-95f22c5e7f2f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{tan}^{2}⁡\\theta " :db/id #edb/ref 17592186255146} {:answer/id #uuid "bd06b950-4b37-5d7d-b639-ef073390a2b0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\operatorname{tan}⁡\\theta " :db/id #edb/ref 17592186255361} {:answer/id #uuid "f8e3c92f-f95d-57db-a7ca-85394f5ddfcb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2{tan}^{2}⁡\\theta " :db/id #edb/ref 17592186255850}] :answer-field/correct {:answer/id #uuid "f8e3c92f-f95d-57db-a7ca-85394f5ddfcb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2{tan}^{2}⁡\\theta " :db/id #edb/ref 17592186255850} :answer-field/id #uuid "7edb85ea-33a3-57f0-b0e9-29b6a66d467c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186256159}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "7483b5c0-3dc3-538f-b1c8-e2da92110f3a" :question/math-academy-id "q-120637" :question/problem "${tan}^{2}⁡\\theta -1+{sec}^{2}⁡\\theta =$" :question/worked-solution "First, let's recall the secant-tangent identity:\n\n$$\n1+{tan}^{2}⁡\\theta ={sec}^{2}⁡\\theta \n$$\n\nWe rewrite the given expression using the secant-tangent identity as follows:\n\n$$\n\\begin{aligned}{tan}^{2}⁡\\theta -1+{sec}^{2}⁡\\theta  & ={tan}^{2}⁡\\theta -1+1+{tan}^{2}⁡\\theta  \\\\  & =2{tan}^{2}⁡\\theta \\end{aligned}\n$$\n\nTherefore, we conclude that\n\n$$\n{tan}^{2}⁡\\theta -1+{sec}^{2}⁡\\theta =2{tan}^{2}⁡\\theta .\n$$"}] [{:db/id #edb/ref 17592186387036 :knowledge-point/_questions [{:db/id #edb/ref 17592186115309 :knowledge-point/id #uuid "6e126b20-0507-5f22-ba34-a55157ca7fa1" :knowledge-point/title "Solving a Trigonometric Equation When the Cotangent Function Equals Zero"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6712c057-d325-5087-b265-9e611b0283bf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "24\\,300" :db/id #edb/ref 17592186387038} {:answer/id #uuid "4452d378-3fea-57aa-ad62-dddc038b7c95" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "16\\,200" :db/id #edb/ref 17592186387039} {:answer/id #uuid "c49e8952-c40a-5925-9655-9513fef89265" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "37\\,800" :db/id #edb/ref 17592186387040} {:answer/id #uuid "b2e4311a-dd4f-5e64-911c-b5db5bfadeac" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "27\\,000" :db/id #edb/ref 17592186387041} {:answer/id #uuid "ac4ac064-11fb-5475-9f74-b2e7190d838c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "18\\,900" :db/id #edb/ref 17592186387042}] :answer-field/correct {:answer/id #uuid "6712c057-d325-5087-b265-9e611b0283bf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "24\\,300" :db/id #edb/ref 17592186387038} :answer-field/id #uuid "b941e16d-5be1-50c8-953e-51bfad0efd5b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186387037}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "1e429c53-db66-50b4-900e-8aac7266bdd4" :question/math-academy-id "q-120646" :question/problem "Given that ${x}_{1}$ and ${x}_{2}$ are the solutions to the equation $7-\\sqrt{2}\\operatorname{cot}⁡x=3\\sqrt{2}\\operatorname{cot}⁡x+7$ for ${0}^{∘}<x<{360}^{∘},$ what is the numerical value of ${x}_{1}\\cdot {x}_{2}?$" :question/worked-solution "First, we rearrange the equation to isolate $\\operatorname{cot}⁡x:$\n\n$$\n\\begin{aligned}7-\\sqrt{2}\\operatorname{cot}⁡x & =3\\sqrt{2}\\operatorname{cot}⁡x+7 \\\\ -4\\sqrt{2}\\operatorname{cot}⁡x & =0 \\\\ \\operatorname{cot}⁡x & =0\\end{aligned}\n$$\n\nWe can't find an equivalent equation involving tangent, since this would lead to us dividing by $0:$\n\n$$\n\\operatorname{tan}⁡x=\\frac{1}{0}=\\text{undefined}\n$$\n\nHowever, we can instead find an equivalent equation using the fact that $\\operatorname{cot}⁡x=\\frac{\\operatorname{cos}⁡x}{\\operatorname{sin}⁡x}:$\n\n$$\n\\frac{\\operatorname{cos}⁡x}{\\operatorname{sin}⁡x}=0\n$$\n\nIn this case, we can find the principal solution as follows:\n\n$$\n\\begin{aligned}\\operatorname{cos}⁡x & =0 \\\\ x & =\\operatorname{arccos}⁡0 \\\\ x & ={90}^{∘}\\end{aligned}\n$$\n\nSince this value lies inside the desired domain, our first solution is ${x}_{1}={90}^{∘}.$\n\nTo find more solutions, we add integer multiples of ${180}^{∘}$ as follows:\n\n$$\n\\begin{aligned}{x}_{2} & ={x}_{1}+{180}^{∘} \\\\  & ={90}^{∘}+{180}^{∘} \\\\  & ={270}^{∘}\\end{aligned}\n$$\n\nSo, our solutions are $x={90}^{∘},{270}^{∘}.$\n\nFinally, the numerical value of ${x}_{1}\\cdot {x}_{2}$ is \n\n$$\n90\\cdot 270=24\\,300.\n$$"}] [{:db/id #edb/ref 17592186256442 :knowledge-point/_questions [{:db/id #edb/ref 17592186188221 :knowledge-point/id #uuid "eda44360-52ec-59f7-98b4-f8d866a465e9" :knowledge-point/title "Simplifying an Expression Using the Alternate Forms of the Secant-Tangent Identity"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "46c1a484-6908-532c-aead-33b816e61909" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2\\operatorname{cos}⁡x" :db/id #edb/ref 17592186254267} {:answer/id #uuid "90079a6b-99a3-58e1-ba8f-4b3406cda978" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2-\\operatorname{cos}⁡x" :db/id #edb/ref 17592186254935} {:answer/id #uuid "a99148bc-1b88-5e2f-b08f-0fc60dd809e0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{cos}⁡x" :db/id #edb/ref 17592186255167} {:answer/id #uuid "b54f4930-c7c7-5a78-8cae-4edc271582ca" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{cos}^{2}⁡x+1" :db/id #edb/ref 17592186255268} {:answer/id #uuid "e5bfeaa7-27c9-5375-a531-9b28a3d3f21a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1-2{cos}^{2}⁡x" :db/id #edb/ref 17592186255697}] :answer-field/correct {:answer/id #uuid "e5bfeaa7-27c9-5375-a531-9b28a3d3f21a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1-2{cos}^{2}⁡x" :db/id #edb/ref 17592186255697} :answer-field/id #uuid "12c1913c-48ce-5922-b686-38b55407977e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186255949}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "c59c3ea2-945d-5573-80ad-ccc1ae2f546f" :question/math-academy-id "q-120652" :question/problem "$\\frac{{tan}^{2}⁡x}{{sec}^{2}⁡x}-1+{sin}^{2}⁡x=$" :question/worked-solution "First, we recall the different forms of the secant-tangent Identity:\n\n$$\n\\begin{aligned} & (1) & 1+{tan}^{2}⁡x={sec}^{2}⁡x \\\\  & (2) & {tan}^{2}⁡x={sec}^{2}⁡x-1 \\\\  & (3) & {sec}^{2}⁡x-{tan}^{2}⁡x=1\\end{aligned}\n$$\n\nTherefore, we can rewrite our expression using $(2),$ as follows:\n\n$$\n\\frac{{tan}^{2}⁡x}{{sec}^{2}⁡x}-1+{sin}^{2}⁡x=\\frac{{sec}^{2}⁡x-1}{{sec}^{2}⁡x}-1+{sin}^{2}⁡x\n$$\n\nNext, we recall the following identity: \n\n$$\n1-{sin}^{2}⁡x={cos}^{2}⁡x\n$$\n\nUsing the above identity, we can further simplify our expression as follows:\n\n$$\n\\begin{aligned}\\frac{{sec}^{2}⁡x-1}{{sec}^{2}⁡x}-1+{sin}^{2}⁡x & =\\frac{{sec}^{2}⁡x-1}{{sec}^{2}⁡x}-(1-{sin}^{2}⁡x) \\\\  & =\\frac{{sec}^{2}⁡x-1}{{sec}^{2}⁡x}-{cos}^{2}⁡x \\\\  & =\\frac{{sec}^{2}⁡x}{{sec}^{2}⁡x}-\\frac{1}{{sec}^{2}⁡x}-{cos}^{2}⁡x \\\\  & =\\frac{\\cancel{{sec}^{2}⁡x}}{\\cancel{{sec}^{2}⁡x}}-\\frac{1}{{sec}^{2}⁡x}-{cos}^{2}⁡x \\\\  & =1-\\frac{1}{{sec}^{2}⁡x}-{cos}^{2}⁡x \\\\  & =1-{cos}^{2}⁡x-{cos}^{2}⁡x \\\\  & =1-2{cos}^{2}⁡x\\end{aligned}\n$$\n\nTherefore, we conclude that\n\n$$\n\\frac{{tan}^{2}⁡x}{{sec}^{2}⁡x}-1+{sin}^{2}⁡x=1-2{cos}^{2}⁡x.\n$$"}] [{:db/id #edb/ref 17592186256445 :knowledge-point/_questions [{:db/id #edb/ref 17592186188222 :knowledge-point/id #uuid "141d61c7-1d82-52fe-b977-19daa910da9b" :knowledge-point/title "Simplifying an Expression by Factoring Alternative Forms of the Secant-Tangent Identity"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0ce8fd15-b91e-59d1-81c9-58484689b5d6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\operatorname{sec}⁡\\theta " :db/id #edb/ref 17592186253776} {:answer/id #uuid "0eba9484-8340-5e15-861e-9c9af85a9097" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{sec}⁡\\theta " :db/id #edb/ref 17592186253797} {:answer/id #uuid "426cdd7e-6f1c-501f-9e15-f8954d1d45c9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{sec}⁡\\theta -1" :db/id #edb/ref 17592186254236} {:answer/id #uuid "4e0f5c03-c859-58db-8cab-b40af3b4dbd5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\operatorname{sec}⁡\\theta " :db/id #edb/ref 17592186254342} {:answer/id #uuid "e8ef8d91-6b04-56af-97d6-aafedb51fd25" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1-\\operatorname{sec}⁡\\theta " :db/id #edb/ref 17592186255715}] :answer-field/correct {:answer/id #uuid "426cdd7e-6f1c-501f-9e15-f8954d1d45c9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{sec}⁡\\theta -1" :db/id #edb/ref 17592186254236} :answer-field/id #uuid "83a7647a-f01a-56fa-ba8f-a9dac8ad5b07" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186256168}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "c1861048-306a-5c9d-bc3a-136c2abd3f1d" :question/math-academy-id "q-120657" :question/problem "Simplify $\\frac{{tan}^{2}⁡\\theta }{\\operatorname{sec}⁡\\theta +1}.$" :question/worked-solution "First, we recall the different forms of the secant-tangent Identity:\n\n$$\n\\begin{aligned} & (1) & 1+{tan}^{2}⁡\\theta ={sec}^{2}⁡\\theta  \\\\  & (2) & {tan}^{2}⁡\\theta ={sec}^{2}⁡\\theta -1 \\\\  & (3) & {sec}^{2}⁡\\theta -{tan}^{2}⁡\\theta =1\\end{aligned}\n$$\n\nTherefore, we can rewrite our expression using $(2),$ as follows:\n\n$$\n\\frac{{tan}^{2}⁡\\theta }{\\operatorname{sec}⁡\\theta +1}=\\frac{{sec}^{2}⁡\\theta -1}{\\operatorname{sec}⁡\\theta +1}\n$$\n\nFinally, we can further simplify our expression by factoring the numerator as a difference of squares, as follows:\n\n$$\n\\begin{aligned}\\frac{{sec}^{2}⁡\\theta -1}{\\operatorname{sec}⁡\\theta +1} & =\\frac{(\\operatorname{sec}⁡\\theta -1)(\\operatorname{sec}⁡\\theta +1)}{\\operatorname{sec}⁡\\theta +1} \\\\  & =\\frac{(\\operatorname{sec}⁡\\theta -1)\\cancel{(\\operatorname{sec}⁡\\theta +1)}}{\\cancel{(\\operatorname{sec}⁡\\theta +1)}} \\\\  & =\\operatorname{sec}⁡\\theta -1\\end{aligned}\n$$\n\nTherefore, we conclude that\n\n$$\n\\frac{{tan}^{2}⁡\\theta }{\\operatorname{sec}⁡\\theta +1}=\\operatorname{sec}⁡\\theta -1.\n$$"}] [{:db/id #edb/ref 17592186256449 :knowledge-point/_questions [{:db/id #edb/ref 17592186188217 :knowledge-point/id #uuid "9b14ef98-8122-512a-9cce-6e44392959d8" :knowledge-point/title "Simplifying an Expression by Factoring and Using Various Forms of the Secant-Tangent Identity"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "05207395-02f1-5d5f-9dc3-81acf6c01fd8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-{sec}^{2}⁡\\theta " :db/id #edb/ref 17592186253706} {:answer/id #uuid "295e109a-6294-5fe6-9b3a-bf16636fb649" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{sec}⁡\\theta " :db/id #edb/ref 17592186254040} {:answer/id #uuid "851af266-742f-54a9-a2c7-0b59d5c8ba4b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{sec}^{2}⁡\\theta -2" :db/id #edb/ref 17592186254852} {:answer/id #uuid "93aa7902-3669-5423-ac92-e34b15e642b6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1-\\operatorname{sec}⁡\\theta " :db/id #edb/ref 17592186254967} {:answer/id #uuid "fa687d80-88a9-583e-b3f7-707957e10df3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{sec}⁡\\theta +2" :db/id #edb/ref 17592186255866}] :answer-field/correct {:answer/id #uuid "851af266-742f-54a9-a2c7-0b59d5c8ba4b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{sec}^{2}⁡\\theta -2" :db/id #edb/ref 17592186254852} :answer-field/id #uuid "ef30c5cd-87ee-54bb-9ffe-d545fe802caa" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186256345}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "b8a55c6e-077f-5804-ac89-ec1be2eb0726" :question/math-academy-id "q-120666" :question/problem "Which of the following is equivalent to $\\frac{{tan}^{4}⁡\\theta -{sec}^{2}⁡\\theta +1}{{tan}^{2}⁡\\theta }?$" :question/worked-solution "First, we recall the different forms of the secant-tangent Identity:\n\n$$\n\\begin{aligned} & (1) & 1+{tan}^{2}⁡\\theta ={sec}^{2}⁡\\theta  \\\\  & (2) & {tan}^{2}⁡\\theta ={sec}^{2}⁡\\theta -1 \\\\  & (3) & {sec}^{2}⁡\\theta -{tan}^{2}⁡\\theta =1\\end{aligned}\n$$\n\nTherefore, we can rewrite our expression using $(2),$ as follows:\n\n$$\n\\begin{aligned}\\frac{{tan}^{4}⁡\\theta -{sec}^{2}⁡\\theta +1}{{tan}^{2}⁡\\theta } & =\\frac{{tan}^{4}⁡\\theta -({sec}^{2}⁡\\theta -1)}{{tan}^{2}⁡\\theta } \\\\  & =\\frac{{tan}^{4}⁡\\theta -{tan}^{2}⁡\\theta }{{tan}^{2}⁡\\theta }\\end{aligned}\n$$\n\nFinally, we can further simplify our expression and use again $(2)$, as follows:\n\n$$\n\\begin{aligned}\\frac{{tan}^{4}⁡\\theta -{tan}^{2}⁡\\theta }{{tan}^{2}⁡\\theta } & =\\frac{{tan}^{2}⁡\\theta ({tan}^{2}⁡\\theta -1)}{{tan}^{2}⁡\\theta } \\\\  & =\\frac{\\cancel{{tan}^{2}⁡\\theta }({tan}^{2}⁡\\theta -1)}{\\cancel{{tan}^{2}⁡\\theta }} \\\\  & ={tan}^{2}⁡\\theta -1 \\\\  & =({sec}^{2}⁡\\theta -1)-1 \\\\  & ={sec}^{2}⁡\\theta -2\\end{aligned}\n$$\n\nTherefore, we conclude that\n\n$$\n\\frac{{tan}^{4}⁡\\theta -{sec}^{2}⁡\\theta +1}{{tan}^{2}⁡\\theta }={sec}^{2}⁡\\theta -2.\n$$"}] [{:db/id #edb/ref 17592186256452 :knowledge-point/_questions [{:db/id #edb/ref 17592186133752 :knowledge-point/id #uuid "d90b9572-cdac-51f7-b386-81b750642585" :knowledge-point/title "Finding the Polar Equation of a Radial Line That Passes Through a Given Point"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "17f00b72-9daa-5a34-a8b3-6a2e5fa1dff2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\theta =\\frac{6\\pi }{5}" :db/id #edb/ref 17592186253878} {:answer/id #uuid "86521eb5-22cc-53a1-b524-b9ff1c2e311a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\theta =\\frac{5\\pi }{4}" :db/id #edb/ref 17592186254859} {:answer/id #uuid "9a84e848-6840-5e58-bc55-0334ef160334" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\theta =\\frac{5\\pi }{8}" :db/id #edb/ref 17592186255033} {:answer/id #uuid "ad70fad3-8d19-5e8f-8a88-ee9f19172dd0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\theta =\\frac{7\\pi }{6}" :db/id #edb/ref 17592186255199} {:answer/id #uuid "afd98217-57eb-5e73-ad53-c1c9d3a58fb1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\theta =\\frac{4\\pi }{3}" :db/id #edb/ref 17592186255216}] :answer-field/correct {:answer/id #uuid "ad70fad3-8d19-5e8f-8a88-ee9f19172dd0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\theta =\\frac{7\\pi }{6}" :db/id #edb/ref 17592186255199} :answer-field/id #uuid "7360892e-3cc3-5430-8827-7517c29afa89" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186256131}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "6e7c36f9-b648-5bd3-b641-575b95a2bb92" :question/math-academy-id "q-120704" :question/problem "![](images/03/03814c00b9e29f8a05507616ed08e3fe3daa484336e461012dc6c80799efc9e0.png)\n\nGiven that the ray above passes through the point with Cartesian coordinates $(-\\sqrt{6},-\\sqrt{2})$, find the polar equation of the ray." :question/worked-solution "First, we find the reference angle associated with the point:\n\n$$\n\\begin{aligned}{\\theta }_{R} & =\\operatorname{arctan}⁡|\\frac{y}{x}| \\\\  & =\\operatorname{arctan}⁡|\\frac{-\\sqrt{2}}{-\\sqrt{6}}| \\\\  & =\\operatorname{arctan}⁡(\\frac{1}{\\sqrt{3}}) \\\\  & =\\operatorname{arctan}⁡(\\frac{\\sqrt{3}}{3}) \\\\  & =\\frac{\\pi }{6}\\end{aligned}\n$$\n\nNow, notice that the ray lies in the third quadrant. So, we find the angle in the third quadrant that has a reference angle ${\\theta }_{R}=\\frac{\\pi }{6},$ as follows:\n\n$$\n\\begin{aligned}\\theta  & =\\pi +{\\theta }_{R} \\\\  & =\\pi +\\frac{\\pi }{6} \\\\  & =\\frac{7\\pi }{6}\\end{aligned}\n$$\n\nTherefore, the polar equation of the ray is \n\n$$\n\\theta =\\frac{7\\pi }{6}.\n$$"}] [{:db/id #edb/ref 17592186256455 :knowledge-point/_questions [{:db/id #edb/ref 17592186133753 :knowledge-point/id #uuid "fc8d4944-9005-5712-ad88-744dac83603e" :knowledge-point/title "Finding the Point of Intersection of a Circle and a Radial Line"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0e6d12e2-e094-56bb-aad7-4875408f1a4e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-6\\sqrt{3},-6)" :db/id #edb/ref 17592186253794} {:answer/id #uuid "30cf8320-5fd5-5b11-82e3-deaed3de2914" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-12\\sqrt{3},-12)" :db/id #edb/ref 17592186254096} {:answer/id #uuid "5e5579c2-3d6f-5c86-bb18-f4835d982390" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-6\\sqrt{2},-8)" :db/id #edb/ref 17592186254508} {:answer/id #uuid "7b5c3da8-df30-5fe1-bff4-b1a94f639b67" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-4\\sqrt{3},-4)" :db/id #edb/ref 17592186254767} {:answer/id #uuid "df0dcfd3-b874-5c42-adc8-6f258f9c28bf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-8\\sqrt{3},-8)" :db/id #edb/ref 17592186255650}] :answer-field/correct {:answer/id #uuid "0e6d12e2-e094-56bb-aad7-4875408f1a4e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-6\\sqrt{3},-6)" :db/id #edb/ref 17592186253794} :answer-field/id #uuid "504a5f08-c553-5514-84d8-de8398b03057" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186256079}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "cae813d1-464d-5870-965e-a7cef5a78bcf" :question/math-academy-id "q-120719" :question/problem "![](images/3b/3b1318b156281c7bc8724f988545d9f5c9fab2bda4ed88c387f051dbe5bece1e.png)\n\nThe polar curve $r=12$ and the ray $\\theta =\\frac{7\\pi }{6}$ intersect at the point $P,$ as shown above. What are the Cartesian coordinates of $P?$" :question/worked-solution "The polar coordinates of $P$ are $(r,\\theta )=(12,\\frac{7\\pi }{6}).$ We can convert the polar coordinates of $P$ to Cartesian coordinates, as follows:\n\n$$\n\\begin{aligned}x & =r\\operatorname{cos}⁡\\theta  \\\\  & =12\\operatorname{cos}⁡(\\frac{7\\pi }{6}) \\\\  & =12\\cdot (-\\frac{\\sqrt{3}}{2}) \\\\  & =-6\\sqrt{3} \\\\ y & =r\\operatorname{sin}⁡\\theta  \\\\  & =12\\operatorname{sin}⁡(\\frac{7\\pi }{6}) \\\\  & =12\\cdot (-\\frac{1}{2}) \\\\  & =-6\\end{aligned}\n$$\n\nTherefore, the Cartesian coordinates of $P$ are $(-6\\sqrt{3},-6).$"}] [{:db/id #edb/ref 17592186256459 :knowledge-point/_questions [{:db/id #edb/ref 17592186083205 :knowledge-point/id #uuid "f87bc14d-5e68-5a5e-bec8-f1b5b21c02e8" :knowledge-point/title "Calculating the Arc Length of a Smooth Curve Using the Arc Length Formula"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "742d9c7f-d4ee-56e4-91a5-257220e81235" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{2}}{3}" :db/id #edb/ref 17592186254697} {:answer/id #uuid "77fef0cd-a14d-513e-a983-57f641d81912" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{8}" :db/id #edb/ref 17592186254731} {:answer/id #uuid "be8416e5-45aa-50f0-ad1e-e88defc465b1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\pi }{4}" :db/id #edb/ref 17592186255371} {:answer/id #uuid "cde2b163-41b2-5e57-b80d-41b421c63e78" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{2}-1" :db/id #edb/ref 17592186255499} {:answer/id #uuid "d8d5128f-097e-53b2-b6f7-370f46fe6294" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\pi }{2}" :db/id #edb/ref 17592186255592}] :answer-field/correct {:answer/id #uuid "be8416e5-45aa-50f0-ad1e-e88defc465b1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\pi }{4}" :db/id #edb/ref 17592186255371} :answer-field/id #uuid "8e160d2d-13f1-551b-bfa1-abe0c5a5a564" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186256183}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "38924e39-789b-5c5e-b0d2-35b2ccc7c0f1" :question/math-academy-id "q-120752" :question/problem "Compute the arc length of $y=\\sqrt{1-{x}^{2}}$ for $x\\in [\\frac{\\sqrt{2}}{2},1].$" :question/worked-solution "The arc length of a curve $y=f(x)$ between $x=a$ and $x=b$ can be found using the formula\n\n$$\nL={\\int }_{a}^{b}\\sqrt{1+[{f}^{′}(x)]^{2}}\\,\\text{d}x.\n$$\n\nIn our case, $f(x)=\\sqrt{1-{x}^{2}},$ $a=\\frac{\\sqrt{2}}{2}$ and $b=1.$\n\nFirst, we find the derivative of $f(x):$\n\n$$\n{f}^{′}(x)=-\\frac{x}{\\sqrt{1-{x}^{2}}}\n$$\n\nNow, let's compute $\\sqrt{1+[{f}^{′}(x)]^{2}}:$\n\n$$\n\\begin{aligned}\\sqrt{1+[{f}^{′}(x)]^{2}} & =\\sqrt{1+{(-\\frac{x}{\\sqrt{1-{x}^{2}}})}^{2}} \\\\  & =\\sqrt{1+\\frac{{x}^{2}}{1-{x}^{2}}} \\\\  & =\\sqrt{\\frac{1-{x}^{2}+{x}^{2}}{1-{x}^{2}}} \\\\  & =\\sqrt{\\frac{1}{1-{x}^{2}}} \\\\  & =\\frac{1}{\\sqrt{1-{x}^{2}}}\\end{aligned}\n$$\n\nSubstituting $\\sqrt{1+[{f}^{′}(x)]^{2}}=\\frac{1}{\\sqrt{1-{x}^{2}}}$ to the formula for the arc length, we get\n\n$$\n\\begin{aligned}L & ={\\int }_{\\sqrt{2}/2}^{1}\\sqrt{1+[{f}^{′}(x)]^{2}}\\,\\text{d}x \\\\  & ={\\int }_{\\sqrt{2}/2}^{1}\\frac{1}{\\sqrt{1-{x}^{2}}}\\,\\text{d}x \\\\  & =(\\operatorname{arcsin}⁡x){|}_{\\sqrt{2}/2}^{1} \\\\  & =\\frac{\\pi }{2}-\\frac{\\pi }{4} \\\\  & =\\frac{\\pi }{4}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186256461 :knowledge-point/_questions [{:db/id #edb/ref 17592186175925 :knowledge-point/id #uuid "32c0fb55-c598-521f-aab9-72efc6b70789" :knowledge-point/title "Finding the Time Intervals on which a Particle is Moving in a Particular Direction"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "11d29184-04d5-5e64-b721-11e975a66d87" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1<t<4" :db/id #edb/ref 17592186253825} {:answer/id #uuid "1f2923a4-2cfe-51d5-9d0c-af9991f774bd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0<t<4" :db/id #edb/ref 17592186253940} {:answer/id #uuid "4671b0ff-41cd-5f29-8cd1-adc76d89cf12" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0<t<3" :db/id #edb/ref 17592186254265} {:answer/id #uuid "5aee5a13-875a-5366-a7ef-97e0d91957bb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "t>0" :db/id #edb/ref 17592186254474} {:answer/id #uuid "7a121bfb-71cf-5c69-9229-38ac03dbb917" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "t>4" :db/id #edb/ref 17592186254752}] :answer-field/correct {:answer/id #uuid "1f2923a4-2cfe-51d5-9d0c-af9991f774bd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0<t<4" :db/id #edb/ref 17592186253940} :answer-field/id #uuid "7fb74cb4-ecab-5eeb-a1bf-a8f61a275a06" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186256161}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "4aa695f4-838a-57f2-9880-ccc487720d4e" :question/math-academy-id "q-120757" :question/problem "A particle moves along a straight line relative to a fixed origin $O$ with acceleration, measured in $\\text{m}/{\\text{s}}^{2},$ given by the function $a(t)=3{t}^{2}-6t-4,$ where $t>0$ is the time in seconds.  The positive direction is left to right. If the particle is stationary when $t=4\\,\\text{s},$ determine the time intervals in which the particle moves to the left." :question/worked-solution "First, we find $v(t)$ by integrating the acceleration with respect to time:\n\n$$\n\\begin{aligned}v(t) & =\\int a(t)\\text{d}t \\\\  & =\\int (3{t}^{2}-6t-4)\\text{d}t \\\\  & ={t}^{3}-3{t}^{2}-4t+C\\end{aligned}\n$$\n\nTo determine $C,$ we use the fact that $v(0)=0.$ Substituting this into the above gives\n\n$$\n\\begin{aligned}0 & =(4)^{3}-3(4)^{2}-4(4)+C \\\\ C & =0.\\end{aligned}\n$$\n\nTherefore, the velocity $v$ of the particle at time $t$ is $v(t)={t}^{3}-3{t}^{2}-4t.$\n\nTo find the time interval in which the particle is moving to the *left*, we must solve the inequality $v<0.$ This gives\n\n$$\n{t}^{3}-3{t}^{2}-4t=t(t-4)(t+1)<0.\n$$\n\nPlotting the graph of $v(t)$, we get the following picture.\n\n![](images/00/002f547b882940d087d6ed9d228334ec163931cfea0665eafdfe8b6ec8d863da.png)\n\nFrom the graph, we see that $v<0$ whenever $0<t<4.$"}] [{:db/id #edb/ref 17592186256463 :knowledge-point/_questions [{:db/id #edb/ref 17592186100819 :knowledge-point/id #uuid "a32f8ec3-ac69-5b6a-9937-1093556d24d7" :knowledge-point/title "Finding the General Solution to a Trigonometric Equation Containing Sine or Cosine"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "01457f0f-a114-52b0-8b99-dee62a99298a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x={45}^{∘}+n\\cdot {360}^{∘},\\,x={315}^{∘}+n\\cdot {360}^{∘}" :db/id #edb/ref 17592186253678} {:answer/id #uuid "39ee2c07-1e95-56ac-b29f-2d31814338ac" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x={120}^{∘}+n\\cdot {360}^{∘},\\,x={240}^{∘}+n\\cdot {360}^{∘}" :db/id #edb/ref 17592186254179} {:answer/id #uuid "521095f0-b468-5460-9697-086df948f5bb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x={60}^{∘}+n\\cdot {360}^{∘},\\,x={300}^{∘}+n\\cdot {360}^{∘}" :db/id #edb/ref 17592186254384} {:answer/id #uuid "c0dea304-43bd-5722-b88c-ba6c94f87993" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x={150}^{∘}+n\\cdot {360}^{∘},\\,x={210}^{∘}+n\\cdot {360}^{∘}" :db/id #edb/ref 17592186255389} {:answer/id #uuid "cbcc9c58-d321-5486-b9e1-4ca234472367" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x={30}^{∘}+n\\cdot {360}^{∘},\\,x={330}^{∘}+n\\cdot {360}^{∘}" :db/id #edb/ref 17592186255480}] :answer-field/correct {:answer/id #uuid "01457f0f-a114-52b0-8b99-dee62a99298a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x={45}^{∘}+n\\cdot {360}^{∘},\\,x={315}^{∘}+n\\cdot {360}^{∘}" :db/id #edb/ref 17592186253678} :answer-field/id #uuid "a776a03b-bf9d-569f-a094-dda88cdd9e58" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186256231}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "b2a17c10-d59a-5539-82f1-c464939b55af" :question/math-academy-id "q-120762" :question/problem "In degrees, what is the general solution to the equation $\\operatorname{cos}⁡x=\\frac{\\sqrt{2}}{2}?$ Assume that $n$ is an integer." :question/worked-solution "First, we find the principal value:\n\n$$\n{x}_{1}=\\operatorname{arccos}⁡(\\frac{\\sqrt{2}}{2})={45}^{∘}\n$$\n\nOur first solution lies in the $1$st quadrant and has a reference angle of ${\\theta }_{R}={45}^{∘}.$ Since $\\operatorname{cos}⁡x>0,$ the second solution must lie in the fourth quadrant, and it also has ${\\theta }_{R}={45}^{∘}.$\n\n![](images/c7/c722d4fa2b77011e4df5b086c19bb09943446941484cfaf87559ca39a52183bc.png)\n\nSince the second solution ${x}_{2}$  lies in the $4$th quadrant, we can find it using the reference angle as follows:\n\n$$\n\\begin{aligned}{x}_{2} & ={360}^{∘}-{\\theta }_{R} \\\\  & ={360}^{∘}-{45}^{∘} \\\\  & ={315}^{∘}\\end{aligned}\n$$\n\nTherefore, the general solution for the given equation is\n\n$$\nx={45}^{∘}+n\\cdot {360}^{∘},\\,x={315}^{∘}+n\\cdot {360}^{∘}.\n$$"}] [{:db/id #edb/ref 17592186256465 :knowledge-point/_questions [{:db/id #edb/ref 17592186100821 :knowledge-point/id #uuid "6a231e4f-d6b3-549f-81d4-30c0a883f9b4" :knowledge-point/title "Finding the General Solution to a Trigonometric Equation Containing Secant or Cosecant"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0e43c895-6027-5cd9-9531-b87e49246459" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=\\frac{\\pi }{6}+2n\\pi ,\\,x=\\frac{5\\pi }{6}+2n\\pi " :db/id #edb/ref 17592186253793} {:answer/id #uuid "1f44fb9c-996a-5031-9466-77d33cafff38" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=\\frac{\\pi }{3}+2n\\pi ,\\,x=\\frac{4\\pi }{3}+2n\\pi " :db/id #edb/ref 17592186253942} {:answer/id #uuid "78089320-37af-59db-ad4c-cbdf0b14c2e0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=\\frac{\\pi }{3}+2n\\pi ,\\,x=\\frac{2\\pi }{3}+2n\\pi " :db/id #edb/ref 17592186254732} {:answer/id #uuid "f199d7d2-b656-500b-b205-701c1444dbad" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=\\frac{\\pi }{4}+2n\\pi ,\\,x=\\frac{3\\pi }{4}+2n\\pi " :db/id #edb/ref 17592186255780} {:answer/id #uuid "fcec6c04-971e-5821-b58b-21c7ccfb8873" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=\\frac{\\pi }{4}+2n\\pi ,\\,x=\\frac{5\\pi }{4}+2n\\pi " :db/id #edb/ref 17592186255892}] :answer-field/correct {:answer/id #uuid "f199d7d2-b656-500b-b205-701c1444dbad" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=\\frac{\\pi }{4}+2n\\pi ,\\,x=\\frac{3\\pi }{4}+2n\\pi " :db/id #edb/ref 17592186255780} :answer-field/id #uuid "a7caaf7c-63ba-5300-b937-e172c9f59ffb" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186256233}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "dbeced00-09aa-5843-8bf0-6c51146e3b55" :question/math-academy-id "q-120771" :question/problem "What is the general solution to the equation $\\operatorname{csc}⁡x=\\sqrt{2}?$ Assume that $n$ is an integer." :question/worked-solution "Recall that $\\operatorname{csc}⁡x=\\frac{1}{\\operatorname{sin}⁡x}.$ Therefore, the given equation is equivalent to\n\n$$\n\\operatorname{sin}⁡x=\\frac{\\sqrt{2}}{2}.\n$$\n\nNow, we find the principal value:\n\n$$\n{x}_{1}=\\text{arcsin}(\\frac{\\sqrt{2}}{2})=\\frac{\\pi }{4}\n$$\n\nOur first solution lies in the $1$st quadrant and has a reference angle of ${\\theta }_{R}=\\frac{\\pi }{4}.$ Since $\\operatorname{sin}⁡x>0,$ the second solution must lie in the second quadrant, and it also has ${\\theta }_{R}=\\frac{\\pi }{4}.$\n\n![](images/26/269d503189ab1027c3d8028542ef0c6a0e2f146aef0f7916691428866ce1b894.png)\n\nSince the second solution ${x}_{2}$  lies in the $2$nd quadrant, we can find it using the reference angle as follows:\n\n$$\n\\begin{aligned}{x}_{2} & =\\pi -{\\theta }_{R} \\\\  & =\\pi -\\frac{\\pi }{4} \\\\  & =\\frac{3\\pi }{4}\\end{aligned}\n$$\n\nTherefore, the general solution to the given equation is\n\n$$\nx=\\frac{\\pi }{4}+2n\\pi ,\\,x=\\frac{3\\pi }{4}+2n\\pi .\n$$"}] [{:db/id #edb/ref 17592186256468 :knowledge-point/_questions [{:db/id #edb/ref 17592186100820 :knowledge-point/id #uuid "aa20dbfa-3f6f-5caf-9c10-906f2422f161" :knowledge-point/title "Finding the General Solution to a Trigonometric Equation Containing Tangent or Cotangent"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "02e27451-1c93-5939-a2aa-3ad5c9f224d1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=\\frac{7\\pi }{6}+n\\pi " :db/id #edb/ref 17592186253689} {:answer/id #uuid "30717d72-cb50-585d-851e-60f14a0b4511" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=-\\frac{5\\pi }{6}+n\\pi " :db/id #edb/ref 17592186254095} {:answer/id #uuid "521cc7bf-20a7-57c9-8c21-bdb3841f5227" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=\\frac{4\\pi }{3}+n\\pi " :db/id #edb/ref 17592186254385} {:answer/id #uuid "64b5019a-5776-596d-a112-a4958d9feb0f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=-\\frac{\\pi }{6}+n\\pi " :db/id #edb/ref 17592186254574} {:answer/id #uuid "ed14bb3c-d140-54cd-ba45-9419f18b4a9d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=-\\frac{2\\pi }{3}+n\\pi " :db/id #edb/ref 17592186255742}] :answer-field/correct {:answer/id #uuid "64b5019a-5776-596d-a112-a4958d9feb0f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=-\\frac{\\pi }{6}+n\\pi " :db/id #edb/ref 17592186254574} :answer-field/id #uuid "c9eeed47-fcc7-52c7-8d0d-8d13e6f5b0d8" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186256280}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "994feea1-4e21-534e-9a72-c1ddab9354dc" :question/math-academy-id "q-120782" :question/problem "Find the general solution to the equation $\\operatorname{cot}⁡x=-\\sqrt{3}.$ Assume that $n$ is an integer." :question/worked-solution "Recall that $\\operatorname{cot}⁡x=\\frac{1}{\\operatorname{tan}⁡x}.$ Therefore, the given equation is equivalent to\n\n$$\n\\begin{aligned}\\frac{1}{\\operatorname{tan}⁡x} & =-\\sqrt{3} \\\\ \\operatorname{tan}⁡x & =-\\frac{\\sqrt{3}}{3}.\\end{aligned}\n$$\n\nNow, we find the principal value:\n\n$$\n{x}_{1}=\\operatorname{arctan}⁡(-\\frac{\\sqrt{3}}{3})=-\\frac{\\pi }{6}\n$$\n\nThe tangent function has a period of $\\pi .$  Hence, the general solution for the given equation is\n\n$$\nx=-\\frac{\\pi }{6}+n\\pi .\n$$"}] [{:db/id #edb/ref 17592186364887 :knowledge-point/_questions [{:db/id #edb/ref 17592186175926 :knowledge-point/id #uuid "b0a81fe3-c8f1-58ec-ba93-116997b15f1c" :knowledge-point/title "Finding the Times at Which a Particle Reaches Its Maximum Velocity"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9aeba58e-2480-5903-9203-c20e42f54324" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{v}_{\\text{max}}=37.5\\,\\text{m}/\\text{s},\\,t=5\\,\\text{s}" :db/id #edb/ref 17592186364889} {:answer/id #uuid "8a0694e3-2d64-5b6e-8fdf-99e203f46da9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{v}_{\\text{max}}=38\\,\\text{m}/\\text{s},\\,t=5\\,\\text{s}" :db/id #edb/ref 17592186364890} {:answer/id #uuid "145e16e0-16a5-5047-a144-2563881addf1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{v}_{\\text{max}}=14\\,\\text{m}/\\text{s},\\,t=1\\,\\text{s}" :db/id #edb/ref 17592186364891} {:answer/id #uuid "dcd66380-ff8b-5bf8-a8b5-4ec3bda201de" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{v}_{\\text{max}}=24.5\\,\\text{m}/\\text{s},\\,t=2\\,\\text{s}" :db/id #edb/ref 17592186364892} {:answer/id #uuid "8d9f848b-1702-55cc-8d51-da43e9b161cf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{v}_{\\text{max}}=75\\,\\text{m}/\\text{s},\\,t=5\\,\\text{s}" :db/id #edb/ref 17592186364893}] :answer-field/correct {:answer/id #uuid "8a0694e3-2d64-5b6e-8fdf-99e203f46da9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{v}_{\\text{max}}=38\\,\\text{m}/\\text{s},\\,t=5\\,\\text{s}" :db/id #edb/ref 17592186364890} :answer-field/id #uuid "3d2fe126-317a-5c9d-9ee4-ef8f3e825381" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186364888}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "3b21641d-ae30-55b8-ba2d-d86f82ac4d9c" :question/math-academy-id "q-120784" :question/problem "A particle moves along a straight line relative to a fixed origin $O$ with acceleration, measured in $\\text{m}/{\\text{s}}^{2},$ given by the function $a(t)=15-3t,$ where $t>0$ is the time in seconds. If the particle has velocity $v=14\\,\\text{m}/\\text{s}$ when $t=1\\,\\text{s},$ calculate the maximum velocity ${v}_{\\text{max}}$ of the particle and determine the time when the particle reaches its maximum velocity." :question/worked-solution "The extrema of the velocity $v$ occur at the critical points of $v.$\n\nSince $\\frac{\\text{d}v}{\\text{d}t}=a(t),$ to find the times where $v$ is a maximum, we just need to solve $a(t)=0$ and test each solution using the first or second derivative test.\n\nSolving $a(t)=0$ gives\n\n$$\n\\begin{aligned}a(t) & =0 \\\\ 15-3t & =0 \\\\ t & =5.\\end{aligned}\n$$\n\nHence, the extremum of the velocity function occurs when $t=5\\,\\text{s}.$\n\nWe now test the extreme value using the second derivative test. For this, we find the second derivative of $v(t):$\n\n$$\n\\begin{aligned}\\frac{{\\text{d}}^{2}v}{\\text{d}{t}^{2}} & =\\frac{\\text{d}}{\\text{d}t}(\\frac{\\text{d}v}{\\text{d}t}) \\\\  & =\\frac{\\text{d}}{\\text{d}t}(a(t)) \\\\  & =\\frac{\\text{d}}{\\text{d}t}(15-3t) \\\\  & =-3\\end{aligned}\n$$\n\nSince ${v}^{″}(5)<0,$ we conclude that the velocity is maximized when $t=5\\,\\text{s}.$\n\nNow, we find $v(t)$ by integrating the acceleration with respect to time:\n\n$$\n\\begin{aligned}v(t) & =\\int a(t)\\text{d}t \\\\  & =\\int (15-3t)\\text{d}t \\\\  & =15t-\\frac{3}{2}{t}^{2}+C\\end{aligned}\n$$\n\nTo determine $C,$ we use the fact that $v(1)=14.$ Substituting this into the above gives\n\n$$\n\\begin{aligned}15(1)-\\frac{3}{2}(1)^{2}+C & =14 \\\\ C & =\\frac{3}{2}-1\\,⟹\\,C=\\frac{1}{2}.\\end{aligned}\n$$\n\nTherefore, the velocity $v$ of the particle at time $t$ is $v(t)=\\frac{1}{2}+15t-\\frac{3}{2}{t}^{2}.$\n\nFinally, we calculate the maximum velocity:\n\n$$\n{v}_{\\text{max}}=v(5)=\\frac{1}{2}+15(5)-\\frac{3}{2}(5)^{2}=38\\,\\text{m}/\\text{s}\n$$"}] [{:db/id #edb/ref 17592186395721 :knowledge-point/_questions [{:db/id #edb/ref 17592186054631 :knowledge-point/id #uuid "9b7f1d12-3335-5dd7-bf36-e07077d0c45d" :knowledge-point/title "Identifying Subsets of Special Sets"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6bd69dee-1a90-5731-909e-bf193606c3f1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "R⊆R" :db/id #edb/ref 17592186395723} {:answer/id #uuid "ef9e9860-9681-5612-8906-739b929d5dd1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "Q⊆R" :db/id #edb/ref 17592186395724} {:answer/id #uuid "326b432e-d3d4-56b8-9641-51af48c34b1e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{Z}^{+}⊆Z" :db/id #edb/ref 17592186395725} {:answer/id #uuid "1d8512ed-f553-5147-af6d-509a075c0b1e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "Z⊆R" :db/id #edb/ref 17592186395726} {:answer/id #uuid "0d38cc69-4692-5308-aef1-5edd65a60ef8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "C⊆Z" :db/id #edb/ref 17592186395727}] :answer-field/correct {:answer/id #uuid "0d38cc69-4692-5308-aef1-5edd65a60ef8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "C⊆Z" :db/id #edb/ref 17592186395727} :answer-field/id #uuid "2de47cf9-4ba6-564d-8b13-dc2ae4c1b836" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186395722}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "23e8510c-99c3-539c-9c30-63245db2572b" :question/math-academy-id "q-1208" :question/problem "Which statement is **not** true?" :question/worked-solution "If $A⊆B,$ then $A$ is a subset of $B,$ meaning that every element of $A$ is an element of $B.$\n\nAmong the given choices, only $C⊆Z$ is not true. This statement is not true because not every complex is an integer number. For example, we have $2\\text{i}\\in C$ but $2\\text{i}\\notin Z.$"}] [{:db/id #edb/ref 17592186256472 :knowledge-point/_questions [{:db/id #edb/ref 17592186188217 :knowledge-point/id #uuid "9b14ef98-8122-512a-9cce-6e44392959d8" :knowledge-point/title "Simplifying an Expression by Factoring and Using Various Forms of the Secant-Tangent Identity"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "03f6f627-2f5f-5347-9503-ff016a5b6080" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{cos}⁡x+1" :db/id #edb/ref 17592186253702} {:answer/id #uuid "0dc1c20c-56c7-5e18-9f59-20d43cd28e89" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-{cos}^{2}⁡x" :db/id #edb/ref 17592186253786} {:answer/id #uuid "314c66e0-d6ef-5926-95cd-7d162c322e96" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1-\\operatorname{cos}⁡x" :db/id #edb/ref 17592186254100} {:answer/id #uuid "391480c9-2b7d-5c4c-af59-42877898e593" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{cos}^{2}⁡x" :db/id #edb/ref 17592186254165} {:answer/id #uuid "7a7a2ee0-bb9d-53c4-bd98-ed75d405853a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{cos}⁡x-1" :db/id #edb/ref 17592186254757}] :answer-field/correct {:answer/id #uuid "391480c9-2b7d-5c4c-af59-42877898e593" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{cos}^{2}⁡x" :db/id #edb/ref 17592186254165} :answer-field/id #uuid "77493d8d-47a6-584a-b0bf-26e515610f6a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186256141}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "93b7d709-aec4-5e7c-b981-7907596e3508" :question/math-academy-id "q-120807" :question/problem "Which of the following is equivalent to $\\frac{1}{{tan}^{2}⁡x{sec}^{2}⁡x-{tan}^{4}⁡x+1}?$" :question/worked-solution "First, we recall the different forms of the secant-tangent Identity:\n\n$$\n\\begin{aligned} & (1) & 1+{tan}^{2}⁡x={sec}^{2}⁡x \\\\  & (2) & {tan}^{2}⁡x={sec}^{2}⁡x-1 \\\\  & (3) & {sec}^{2}⁡x-{tan}^{2}⁡x=1\\end{aligned}\n$$\n\nTherefore, we can rewrite our expression using $(3),$ as follows:\n\n$$\n\\begin{aligned}\\frac{1}{{tan}^{2}⁡x{sec}^{2}⁡x-{tan}^{4}⁡x+1} & =\\frac{1}{{tan}^{2}⁡x({sec}^{2}⁡x-{tan}^{2}⁡x)+1} \\\\  & =\\frac{1}{{tan}^{2}⁡x\\cdot 1+1} \\\\  & =\\frac{1}{{tan}^{2}⁡x+1}\\end{aligned}\n$$\n\nFinally, we can use $(1),$ as follows:\n\n$$\n\\begin{aligned}\\frac{1}{{tan}^{2}⁡x+1} & =\\frac{1}{{sec}^{2}⁡x} \\\\  & ={(\\frac{1}{\\operatorname{sec}⁡x})}^{2} \\\\  & ={cos}^{2}⁡x\\end{aligned}\n$$\n\nTherefore, we conclude that\n\n$$\n\\frac{1}{{tan}^{2}⁡x{sec}^{2}⁡x-{tan}^{4}⁡x+1}={cos}^{2}⁡x.\n$$"}] [{:db/id #edb/ref 17592186256473 :knowledge-point/_questions [{:db/id #edb/ref 17592186188217 :knowledge-point/id #uuid "9b14ef98-8122-512a-9cce-6e44392959d8" :knowledge-point/title "Simplifying an Expression by Factoring and Using Various Forms of the Secant-Tangent Identity"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "72ec5f68-9728-531c-a5ac-13c79f005e24" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(\\operatorname{sec}⁡\\theta +1)\\operatorname{sec}⁡\\theta " :db/id #edb/ref 17592186254688} {:answer/id #uuid "94b3e784-be6b-57fa-81c2-67618b3ed429" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\operatorname{sec}⁡\\theta " :db/id #edb/ref 17592186254976} {:answer/id #uuid "aa29f67a-9529-55c6-826f-4b22638ea11f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{sec}^{2}⁡\\theta +1" :db/id #edb/ref 17592186255174} {:answer/id #uuid "cb767150-a33c-5e2f-9db5-2a5e59fdef7d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "({sec}^{2}⁡\\theta -1)\\operatorname{sec}⁡\\theta " :db/id #edb/ref 17592186255477} {:answer/id #uuid "ec5f93ec-a0fa-5b8d-8457-2f8b02e7dfd4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(1-\\operatorname{sec}⁡\\theta )\\operatorname{sec}⁡\\theta " :db/id #edb/ref 17592186255736}] :answer-field/correct {:answer/id #uuid "cb767150-a33c-5e2f-9db5-2a5e59fdef7d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "({sec}^{2}⁡\\theta -1)\\operatorname{sec}⁡\\theta " :db/id #edb/ref 17592186255477} :answer-field/id #uuid "74b1f671-fc3b-5f37-ac21-8a3aecfff2fa" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186256137}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "38275387-16ad-5210-9a86-c85c7908724b" :question/math-academy-id "q-120808" :question/problem "Which of the following is equivalent to ${tan}^{3}⁡\\theta \\operatorname{sin}⁡\\theta +\\operatorname{tan}⁡\\theta \\operatorname{sin}⁡\\theta ?$" :question/worked-solution "First, we recall the different forms of the secant-tangent Identity:\n\n$$\n\\begin{aligned} & (1) & 1+{tan}^{2}⁡\\theta ={sec}^{2}⁡\\theta  \\\\  & (2) & {tan}^{2}⁡\\theta ={sec}^{2}⁡\\theta -1 \\\\  & (3) & {sec}^{2}⁡\\theta -{tan}^{2}⁡\\theta =1\\end{aligned}\n$$\n\nTherefore, we can rewrite our expression using $(1),$ as follows:\n\n$$\n\\begin{aligned}{tan}^{3}⁡\\theta \\operatorname{sin}⁡\\theta +\\operatorname{tan}⁡\\theta \\operatorname{sin}⁡\\theta  & =\\operatorname{tan}⁡\\theta \\operatorname{sin}⁡\\theta \\,({tan}^{2}⁡\\theta +1) \\\\  & =\\operatorname{tan}⁡\\theta \\operatorname{sin}⁡\\theta \\,{sec}^{2}⁡\\theta \\end{aligned}\n$$\n\nFinally, we can further simplify and use $(2),$ as follows:\n\n$$\n\\begin{aligned}\\operatorname{tan}⁡\\theta \\operatorname{sin}⁡\\theta {sec}^{2}⁡\\theta  & =\\operatorname{tan}⁡\\theta \\cdot \\operatorname{sin}⁡\\theta \\cdot \\frac{1}{{cos}^{2}⁡\\theta } \\\\  & =\\operatorname{tan}⁡\\theta \\cdot \\frac{\\operatorname{sin}⁡\\theta }{\\operatorname{cos}⁡\\theta }\\cdot \\frac{1}{\\operatorname{cos}⁡\\theta } \\\\  & =\\operatorname{tan}⁡\\theta \\cdot \\operatorname{tan}⁡\\theta \\cdot \\frac{1}{\\operatorname{cos}⁡\\theta } \\\\  & ={tan}^{2}⁡\\theta \\cdot \\operatorname{sec}⁡\\theta  \\\\  & =({sec}^{2}⁡\\theta -1)\\operatorname{sec}⁡\\theta \\end{aligned}\n$$\n\nTherefore, we conclude that\n\n$$\n{tan}^{3}⁡\\theta \\operatorname{sin}⁡\\theta +\\operatorname{tan}⁡\\theta \\operatorname{sin}⁡\\theta =({sec}^{2}⁡\\theta -1)\\operatorname{sec}⁡\\theta .\n$$"}] [{:db/id #edb/ref 17592186256476 :knowledge-point/_questions [{:db/id #edb/ref 17592186092166 :knowledge-point/id #uuid "aecfac4d-b8c4-5591-b623-0fa8c192ac80" :knowledge-point/title "Solving a Trigonometric Equation Involving Sine with Non-Special Angles"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "06f638f4-f86a-515f-9f34-79bab5aed9d8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x={28}^{∘},{132}^{∘}" :db/id #edb/ref 17592186253720} {:answer/id #uuid "224f6339-4d6f-5e84-b12e-6e6df9f718ed" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x={52}^{∘},{138}^{∘}" :db/id #edb/ref 17592186253977} {:answer/id #uuid "8a43384c-d861-5f3a-b84c-c613ddd7827e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x={32}^{∘},{128}^{∘}" :db/id #edb/ref 17592186254892} {:answer/id #uuid "a13e94d6-c61b-5c3f-aae3-300caad1d7da" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x={42}^{∘},{158}^{∘}" :db/id #edb/ref 17592186255089} {:answer/id #uuid "d940938c-d2de-57cd-9c70-133a3360d2a9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x={42}^{∘},{138}^{∘}" :db/id #edb/ref 17592186255594}] :answer-field/correct {:answer/id #uuid "d940938c-d2de-57cd-9c70-133a3360d2a9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x={42}^{∘},{138}^{∘}" :db/id #edb/ref 17592186255594} :answer-field/id #uuid "7908722b-df99-5603-8d9c-625d78a85041" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186256143}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "722c6645-d9eb-5787-9276-c39131ce1533" :question/math-academy-id "q-120828" :question/problem "Calculate, in degrees, rounded to the nearest integer, the solutions to the equation $\\operatorname{sin}⁡x=\\frac{2}{3}$ for ${0}^{∘}\\le x<{360}^{∘}.$" :question/worked-solution "First, we find the principal value:\n\n$$\n\\begin{aligned}x=\\operatorname{arcsin}⁡(\\frac{2}{3})=41.810{…}^{∘}≈{41.81}^{∘}\\end{aligned}\n$$\n\nSince ${41.81}^{∘}$ lies inside the range, our first solution is ${x}_{1}={41.81}^{∘}.$\n\nOur first solution lies in the first quadrant and has a reference angle of ${\\theta }_{R}={41.81}^{∘}.$ Since $\\operatorname{sin}⁡x>0,$ the second solution must lie in the second quadrant, and it also has a reference angle ${\\theta }_{R}={41.81}^{∘}.$\n\n![](images/bc/bc0c031fe6ccbb40dc77474582b301456f537ee2a649ba2d5b3bca9b1240618f.png)\n\nSince the second solution ${x}_{2}$ lies in the $2$nd quadrant, we can find it using the reference angle as follows:\n\n$$\n\\begin{aligned}{x}_{2} & ={180}^{∘}-{\\theta }_{R} \\\\  & ={180}^{∘}-{41.81}^{∘} \\\\  & ={138.19}^{∘}\\end{aligned}\n$$\n\nSo, the solutions (rounded to the nearest integer) are $x={42}^{∘},{138}^{∘}.$"}] [{:db/id #edb/ref 17592186256478 :knowledge-point/_questions [{:db/id #edb/ref 17592186092166 :knowledge-point/id #uuid "aecfac4d-b8c4-5591-b623-0fa8c192ac80" :knowledge-point/title "Solving a Trigonometric Equation Involving Sine with Non-Special Angles"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "464e7f61-ecbe-5d92-a768-bdba96ba66de" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x={41}^{∘},{139}^{∘}" :db/id #edb/ref 17592186254263} {:answer/id #uuid "69d72443-b15d-5420-872d-20cf241c18f2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x={59}^{∘},{121}^{∘}" :db/id #edb/ref 17592186254622} {:answer/id #uuid "7e19217d-64a1-5640-bcbd-4834c9ad3d04" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x={33}^{∘},{147}^{∘}" :db/id #edb/ref 17592186254788} {:answer/id #uuid "9b2bbeef-4a86-5df0-80c1-4741f9633531" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x={49}^{∘},{131}^{∘}" :db/id #edb/ref 17592186255037} {:answer/id #uuid "f21259fd-d614-5577-a3a5-f9fb03962578" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x={39}^{∘},{141}^{∘}" :db/id #edb/ref 17592186255785}] :answer-field/correct {:answer/id #uuid "f21259fd-d614-5577-a3a5-f9fb03962578" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x={39}^{∘},{141}^{∘}" :db/id #edb/ref 17592186255785} :answer-field/id #uuid "9540c28b-d25c-5852-ad5d-ea5925808fa0" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186256196}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "5d378f08-b29e-5a1d-8989-f385e5bd482e" :question/math-academy-id "q-120835" :question/problem "Calculate, in degrees, rounded to the nearest integer, the solutions to the equation $\\operatorname{sin}⁡x=\\frac{5}{8}$ for ${0}^{∘}\\le x<{360}^{∘}.$" :question/worked-solution "First, we find the principal value:\n\n$$\n\\begin{aligned}x=\\operatorname{arcsin}⁡(\\frac{5}{8})=38.682{…}^{∘}≈{38.68}^{∘}\\end{aligned}\n$$\n\nSince ${38.68}^{∘}$ lies inside the range, our first solution is ${x}_{1}={38.68}^{∘}.$\n\nOur first solution lies in the first quadrant and has a reference angle of ${\\theta }_{R}={38.68}^{∘}.$ Since $\\operatorname{sin}⁡x>0,$ the second solution must lie in the second quadrant, and it also has a reference angle ${\\theta }_{R}={38.68}^{∘}.$\n\n![](images/12/12b17e3994be5e45af3aca185b22618dd0ec7288fba18a4131387783323247a0.png)\n\nSince the second solution ${x}_{2}$ lies in the $2$nd quadrant, we can find it using the reference angle as follows:\n\n$$\n\\begin{aligned}{x}_{2} & ={180}^{∘}-{\\theta }_{R} \\\\  & ={180}^{∘}-{38.68}^{∘} \\\\  & ={141.32}^{∘}\\end{aligned}\n$$\n\nSo, the solutions (rounded to the nearest integer) are $x={39}^{∘},{141}^{∘}.$"}] [{:db/id #edb/ref 17592186256487 :knowledge-point/_questions [{:db/id #edb/ref 17592186092171 :knowledge-point/id #uuid "5f607558-5a7f-52df-b344-57f2f84791e9" :knowledge-point/title "Solving a Trigonometric Equation Involving Cosine with Non-Special Angles"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2e6148f0-c0ef-5ec8-84fa-96f7399895bc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3.1" :db/id #edb/ref 17592186254084} {:answer/id #uuid "aa374c04-93de-5b00-a6c3-ee0239b5dbe0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2.8" :db/id #edb/ref 17592186255176} {:answer/id #uuid "c3ec00b1-8b3d-578e-aa9d-b52b625b0b7e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2.7" :db/id #edb/ref 17592186255422} {:answer/id #uuid "e0199b8f-172f-517c-8832-b2230b1dbb50" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2.9" :db/id #edb/ref 17592186255662} {:answer/id #uuid "f9df6008-3042-5fe7-bfd0-7945f4fd4d90" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3.0" :db/id #edb/ref 17592186255860}] :answer-field/correct {:answer/id #uuid "e0199b8f-172f-517c-8832-b2230b1dbb50" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2.9" :db/id #edb/ref 17592186255662} :answer-field/id #uuid "b8ca042d-c28f-56ba-b846-2e285284fac0" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186256252}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "814abbe2-963b-55aa-99fd-84de01c3f66e" :question/math-academy-id "q-120893" :question/problem "Given that ${x}_{1}$ and ${x}_{2}$ are the solutions to the equation $\\operatorname{cos}⁡x=\\frac{7}{8}$ for $0\\le x<2\\pi ,$ what is the value of ${x}_{1}\\cdot {x}_{2},$ rounded to one decimal place?" :question/worked-solution "First, we find the principal value:\n\n$$\n\\begin{aligned}x=\\operatorname{arccos}⁡(\\frac{7}{8})=0.505\\,360…≈0.505\\,4\\end{aligned}\n$$\n\nSince $0.505\\,4$ lies inside the specified domain, our first solution is ${x}_{1}=0.505\\,4.$\n\nOur first solution lies in the first quadrant and has a reference angle of ${\\theta }_{R}=0.505\\,4.$ Since $\\operatorname{cos}⁡x>0,$ the second solution must lie in the fourth quadrant, and it also has a reference angle ${\\theta }_{R}=0.505\\,4.$\n\n![](images/49/4979d3f7031e70a642e6995c3eb819d2238281c1312a3a32c2eb4fe8dd576c24.png)\n\nSince the second solution ${x}_{2}$ lies in the $4$th quadrant, we can find it using the reference angle as follows:\n\n$$\n\\begin{aligned}{x}_{2} & =2\\pi -{\\theta }_{R} \\\\  & =2\\pi -0.505\\,4 \\\\  & ≈5.777\\,8\\end{aligned}\n$$\n\nFinally,\n\n$$\n{x}_{1}\\cdot {x}_{2}=0.505\\,4\\cdot 5.777\\,8≈2.9\n$$\n\nrounded to one decimal place."}] [{:db/id #edb/ref 17592186256488 :knowledge-point/_questions [{:db/id #edb/ref 17592186092171 :knowledge-point/id #uuid "5f607558-5a7f-52df-b344-57f2f84791e9" :knowledge-point/title "Solving a Trigonometric Equation Involving Cosine with Non-Special Angles"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "51288993-1186-54f7-b8f9-c3dedec828cd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186254373} {:answer/id #uuid "6636f841-f6b2-5a4a-8b18-128444b21885" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "7" :db/id #edb/ref 17592186254587} {:answer/id #uuid "a7ed8e9d-6c96-5472-ab47-f9b913bb9f05" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "10" :db/id #edb/ref 17592186255152} {:answer/id #uuid "a96a54c4-bfd5-505c-91fe-009524c103c4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186255163} {:answer/id #uuid "eac5a2ac-906b-5eeb-80d9-346addcba2be" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "9" :db/id #edb/ref 17592186255725}] :answer-field/correct {:answer/id #uuid "eac5a2ac-906b-5eeb-80d9-346addcba2be" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "9" :db/id #edb/ref 17592186255725} :answer-field/id #uuid "b53684b1-60b5-56d0-bc46-63f1c5c26e72" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186256247}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "70af0da8-cc0a-5a44-abbf-395198d56bd5" :question/math-academy-id "q-120896" :question/problem "Given that ${x}_{1}$ and ${x}_{2}$ are the solutions of the equation $\\operatorname{cos}⁡x=-\\frac{7}{9}$ for $0\\le x<2\\pi ,$ what is the value of ${x}_{1}\\cdot {x}_{2}$ to the nearest integer?" :question/worked-solution "First, we find the principal value:\n\n$$\n\\begin{aligned}x=\\operatorname{arccos}⁡(-\\frac{7}{9}) & =2.461\\,918…≈2.461\\,9\\end{aligned}\n$$\n\nSince $2.461\\,9$ lies inside the required domain, our first solution is ${x}_{1}=2.461\\,9.$\n\nOur first solution lies in the second quadrant and has a reference angle of \n\n$$\n\\begin{aligned}{\\theta }_{R}=\\pi -2.461\\,9 & ≈0.679\\,7.\\end{aligned}\n$$\n\n Since $\\operatorname{cos}⁡x<0,$ the second solution must lie in the third quadrant, and it also has a reference angle ${\\theta }_{R}=0.679\\,7.$\n\n![](images/ea/eafc9be7094c9c0ccdf167cc737d494efec40014a89ad793f7ed34ea5eed94ae.png)\n\nSince the second solution ${x}_{2}$ lies in the $3$rd quadrant, we can find it using the reference angle as follows:\n\n$$\n\\begin{aligned}{x}_{2} & =\\pi +{\\theta }_{R} \\\\  & =\\pi +0.679\\,7 \\\\  & ≈3.821\\,3\\end{aligned}\n$$\n\nFinally,\n\n$$\n{x}_{1}\\cdot {x}_{2}=2.461\\,9\\cdot 3.821\\,3≈9\n$$\n\nto the nearest integer."}] [{:db/id #edb/ref 17592186398214 :knowledge-point/_questions [{:db/id #edb/ref 17592186176017 :knowledge-point/id #uuid "16629348-2577-5c39-8c8c-0f24dbb52c87" :knowledge-point/title "Approximating the Solution to an Initial Value Problem Using Euler's Method With Three Steps"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "111eb72f-77db-56c0-809e-6b4a599df81c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4\\sqrt{2}" :db/id #edb/ref 17592186398216} {:answer/id #uuid "197ae8e0-022c-5701-9bc2-270d31cca02d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2+2\\sqrt{2}" :db/id #edb/ref 17592186398217} {:answer/id #uuid "d99dcb4d-2a83-549a-b986-4a60429f6baa" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186398218} {:answer/id #uuid "631461f4-e54f-5325-b27b-475e158a4548" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\sqrt{2}" :db/id #edb/ref 17592186398219} {:answer/id #uuid "98436ba7-22e8-5883-92bc-f2a392e4c571" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186398220}] :answer-field/correct {:answer/id #uuid "197ae8e0-022c-5701-9bc2-270d31cca02d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2+2\\sqrt{2}" :db/id #edb/ref 17592186398217} :answer-field/id #uuid "34d0bc62-23d7-51e0-a40e-82b353c65411" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186398215}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "13b68e5e-22d6-5fa0-a4a4-6c5d1f4c0a70" :question/math-academy-id "q-120911" :question/problem "Consider the following initial value problem:\n\n$$\n{y}^{′}=x\\sqrt{y},\\,y(0)=1\n$$\n\nUse Euler's method with three steps of equal size to approximate $y(3).$" :question/worked-solution "First, note that we are given $y(0)$ and asked to find $y(3).$ The distance from $x=0$ and $x=3$ is $3,$ and since we are asked to use three steps of equal size, our step size must be\n\n$$\nΔx=\\frac{3-0}{3}=\\frac{3}{3}=1.\n$$\n\nNow, let's proceed with Euler's method. We'll start by creating a table that includes the initial condition data $y(0)=1.$\n\n| $\\,x\\,$ | $\\,y\\,$ | $\\,{y}^{′}\\,$ | $\\,Δy\\,$ |\n| --- | --- | --- | --- |\n| $0$ | $1$ | $$ | $$ |\n\n**Step 1.** We compute ${y}^{′}$ and $Δy$ (using the values of $x$ and $y$ in the first row) and the values of ${x}_{\\text{new}}$ and ${y}_{\\text{new}}$ using Euler's method:\n\n$$\n\\begin{aligned}{y}^{′} & =x\\sqrt{y}=0\\cdot 1=0 \\\\ Δy & ={y}^{′}\\cdot Δx=0\\cdot 1=0 \\\\ {x}_{\\text{new}} & =x+Δx=0+1=1 \\\\ {y}_{\\text{new}} & =y+Δy=1+0=1\\end{aligned}\n$$\n\nWe add this to our table.\n\n| $\\,x\\,$ | $\\,y\\,$ | $\\,{y}^{′}\\,$ | $\\,Δy\\,$ |\n| --- | --- | --- | --- |\n| $0$ | $1$ | $0$ | $0$ |\n| $1$ | $1$ | $$ | $$ |\n\n**Step 2.** We compute ${y}^{′}$ and $Δy$ (using the values of $x$ and $y$ in the second row) and new values of ${x}_{\\text{new}}$ and ${y}_{\\text{new}}$ using Euler's method:\n\n$$\n\\begin{aligned}{y}^{′} & =x\\sqrt{y}=1\\cdot \\sqrt{1}=1 \\\\ Δy & ={y}^{′}\\cdot Δx=1\\cdot 1=1 \\\\ {x}_{\\text{new}} & =x+Δx=2+1=2 \\\\ {y}_{\\text{new}} & =y+Δy=1+1=2\\end{aligned}\n$$\n\nWe add this to our table.\n\n| $\\,x\\,$ | $\\,y\\,$ | $\\,{y}^{′}\\,$ | $\\,Δy\\,$ |\n| --- | --- | --- | --- |\n| $0$ | $1$ | $0$ | $0$ |\n| $1$ | $1$ | $1$ | $1$ |\n| $2$ | $2$ | $$ | $$ |\n\n**Step 3.** We compute ${y}^{′}$ and $Δy$ (using the values of $x$ and $y$ in the third row) and new values of ${x}_{\\text{new}}$ and ${y}_{\\text{new}}$ using Euler's method:\n\n$$\n\\begin{aligned}{y}^{′} & =x\\sqrt{y}=2\\sqrt{2} \\\\ Δy & ={y}^{′}\\cdot Δx=2\\sqrt{2}\\cdot 1=2\\sqrt{2} \\\\ {x}_{\\text{new}} & =x+Δx=2+1=3 \\\\ {y}_{\\text{new}} & =y+Δy=2+2\\sqrt{2}\\end{aligned}\n$$\n\nWe add this to our table.\n\n| $\\,x\\,$ | $\\,y\\,$ | $\\,{y}^{′}\\,$ | $\\,Δy\\,$ |\n| --- | --- | --- | --- |\n| $0$ | $1$ | $0$ | $0$ |\n| $1$ | $1$ | $1$ | $1$ |\n| $2$ | $2$ | $2\\sqrt{2}$ | $2\\sqrt{2}$ |\n| $3$ | $2+2\\sqrt{2}$ |  |  |\n\nTherefore, we conclude that $y(3)≈2+2\\sqrt{2}.$"}] [{:db/id #edb/ref 17592186256493 :knowledge-point/_questions [{:db/id #edb/ref 17592186176017 :knowledge-point/id #uuid "16629348-2577-5c39-8c8c-0f24dbb52c87" :knowledge-point/title "Approximating the Solution to an Initial Value Problem Using Euler's Method With Three Steps"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1beb1460-5a9d-5c09-9b3b-2e0b4ddaf401" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "12" :db/id #edb/ref 17592186253904} {:answer/id #uuid "36da961c-7070-5c7e-a1f8-392f2b069620" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "11" :db/id #edb/ref 17592186254142} {:answer/id #uuid "517e430a-634f-5708-9d27-1aa7f50f0988" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "15" :db/id #edb/ref 17592186254376} {:answer/id #uuid "86b231eb-df60-5b58-86ea-0c5183114af6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "9" :db/id #edb/ref 17592186254863} {:answer/id #uuid "e8d5d610-6f81-55d4-94c4-7726640fd64f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "10" :db/id #edb/ref 17592186255714}] :answer-field/correct {:answer/id #uuid "1beb1460-5a9d-5c09-9b3b-2e0b4ddaf401" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "12" :db/id #edb/ref 17592186253904} :answer-field/id #uuid "cfbd05a9-c8e1-5aa9-a21e-478096d5daed" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186256293}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "4031e085-738d-5b9f-898b-4694f1a9c939" :question/math-academy-id "q-120940" :question/problem "Consider the following initial value problem:\n\n$$\n{y}^{′}=y(x-1),\\,y(1)=2\n$$\n\nUse Euler's method with three steps of equal size to approximate $y(4).$" :question/worked-solution "First, note that we are given $y(1)$ and asked to find $y(4).$ The distance from $x=1$ and $x=4$ is $3,$ and since we are asked to use three steps of equal size, our step size must be\n\n$$\nΔx=\\frac{4-1}{3}=\\frac{3}{3}=1.\n$$\n\nNow, let's proceed with Euler's method. We'll start by creating a table that includes the initial condition data $y(1)=2.$\n\n| $\\,x\\,$ | $\\,y\\,$ | $\\,{y}^{′}\\,$ | $\\,Δy\\,$ |\n| --- | --- | --- | --- |\n| $1$ | $2$ | $$ | $$ |\n\n**Step 1.** We compute ${y}^{′}$ and $Δy$ (using the values of $x$ and $y$ in the first row) and the values of ${x}_{\\text{new}}$ and ${y}_{\\text{new}}$ using Euler's method:\n\n$$\n\\begin{aligned}{y}^{′} & =y(x-1)=2\\cdot (1-1)=0 \\\\ Δy & ={y}^{′}\\cdot Δx=0\\cdot 1=0 \\\\ {x}_{\\text{new}} & =x+Δx=1+1=2 \\\\ {y}_{\\text{new}} & =y+Δy=2+0=2\\end{aligned}\n$$\n\nWe add this to our table.\n\n| $\\,x\\,$ | $\\,y\\,$ | $\\,{y}^{′}\\,$ | $\\,Δy\\,$ |\n| --- | --- | --- | --- |\n| $1$ | $2$ | $0$ | $0$ |\n| $2$ | $2$ | $$ | $$ |\n\n**Step 2.** We compute ${y}^{′}$ and $Δy$ (using the values of $x$ and $y$ in the second row) and new values of ${x}_{\\text{new}}$ and ${y}_{\\text{new}}$ using Euler's method:\n\n$$\n\\begin{aligned}{y}^{′} & =y(x-1)=2\\cdot (2-1)=2 \\\\ Δy & ={y}^{′}\\cdot Δx=2\\cdot 1=2 \\\\ {x}_{\\text{new}} & =x+Δx=2+1=3 \\\\ {y}_{\\text{new}} & =y+Δy=2+2=4\\end{aligned}\n$$\n\nWe add this to our table.\n\n| $\\,x\\,$ | $\\,y\\,$ | $\\,{y}^{′}\\,$ | $\\,Δy\\,$ |\n| --- | --- | --- | --- |\n| $1$ | $2$ | $0$ | $0$ |\n| $2$ | $2$ | $2$ | $2$ |\n| $3$ | $4$ | $$ | $$ |\n\n**Step 3.** We compute ${y}^{′}$ and $Δy$ (using the values of $x$ and $y$ in the third row) and new values of ${x}_{\\text{new}}$ and ${y}_{\\text{new}}$ using Euler's method:\n\n$$\n\\begin{aligned}{y}^{′} & =y(x-1)=4\\cdot (3-1)=8 \\\\ Δy & ={y}^{′}\\cdot Δx=8\\cdot 1=8 \\\\ {x}_{\\text{new}} & =x+Δx=3+1=4 \\\\ {y}_{\\text{new}} & =y+Δy=4+8=12\\end{aligned}\n$$\n\nWe add this to our table. \n\n| $\\,x\\,$ | $\\,y\\,$ | $\\,{y}^{′}\\,$ | $\\,Δy\\,$ |\n| --- | --- | --- | --- |\n| $1$ | $2$ | $0$ | $0$ |\n| $2$ | $2$ | $2$ | $2$ |\n| $3$ | $4$ | $8$ | $8$ |\n| $4$ | $12$ |  |  |\n\nTherefore, we conclude that $y(4)≈12.$"}] [{:db/id #edb/ref 17592186256495 :knowledge-point/_questions [{:db/id #edb/ref 17592186092171 :knowledge-point/id #uuid "5f607558-5a7f-52df-b344-57f2f84791e9" :knowledge-point/title "Solving a Trigonometric Equation Involving Cosine with Non-Special Angles"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0a1b4c3b-0872-5484-846b-7c31f075326b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4.1" :db/id #edb/ref 17592186253748} {:answer/id #uuid "5d66023e-f256-5b13-916d-42dcaa6c013c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4.2" :db/id #edb/ref 17592186254497} {:answer/id #uuid "791eb4cd-5e49-57d9-b7e6-a52a40c5e041" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3.4" :db/id #edb/ref 17592186254743} {:answer/id #uuid "7ff67ebc-3568-54d4-9dbc-25c3ce24692f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3.5" :db/id #edb/ref 17592186254803} {:answer/id #uuid "be503456-5109-5ce6-90f6-46f497a9e83d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3.7" :db/id #edb/ref 17592186255368}] :answer-field/correct {:answer/id #uuid "7ff67ebc-3568-54d4-9dbc-25c3ce24692f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3.5" :db/id #edb/ref 17592186254803} :answer-field/id #uuid "ee3993dd-3a89-5d8f-8088-b70e6d9fbfde" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186256342}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "1acd4d45-a455-5e34-97cf-5720edb8c513" :question/math-academy-id "q-120981" :question/problem "Given that ${x}_{1}$ and ${x}_{2}$ are the solutions to the equation $\\operatorname{cos}⁡x=\\frac{9}{11}$ for $0\\le x<2\\pi ,$ what is the value of ${x}_{1}\\cdot {x}_{2},$ rounded to one decimal place?" :question/worked-solution "First, we find the principal value:\n\n$$\n\\begin{aligned}x=\\operatorname{arccos}⁡(\\frac{9}{11})=0.612\\,554…≈0.612\\,6\\end{aligned}\n$$\n\nSince $0.612\\,6$ lies inside the specified domain, our first solution is ${x}_{1}=0.612\\,6.$\n\nOur first solution lies in the first quadrant and has a reference angle of ${\\theta }_{R}=0.612\\,6.$ Since $\\operatorname{cos}⁡x>0,$ the second solution must lie in the fourth quadrant, and it also has a reference angle ${\\theta }_{R}=0.612\\,6.$\n\n![](images/23/23712114dae7013de5786e51b99cbd0857c41ed6443e0cb6a9f54aa4ba00dcbb.png)\n\nSince the second solution ${x}_{2}$ lies in the $4$th quadrant, we can find it using the reference angle as follows:\n\n$$\n\\begin{aligned}{x}_{2} & =2\\pi -{\\theta }_{R} \\\\  & =2\\pi -0.612\\,6 \\\\  & ≈5.670\\,6\\end{aligned}\n$$\n\nFinally,\n\n$$\n{x}_{1}\\cdot {x}_{2}=0.612\\,6\\cdot 5.670\\,6≈3.5\n$$\n\nrounded to one decimal place."}] [{:db/id #edb/ref 17592186256500 :knowledge-point/_questions [{:db/id #edb/ref 17592186175952 :knowledge-point/id #uuid "be9ac99c-424e-5e90-b26f-c26e4da704d7" :knowledge-point/title "Finding the Final Position of a Particle"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4855a8b7-7a6b-58fd-bfcb-512c8d36c92c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{e}^{5}" :db/id #edb/ref 17592186254289} {:answer/id #uuid "4ddb2256-cdec-5fd5-b64a-ffbc48c96995" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{e}^{2}+{e}^{5}}{2}" :db/id #edb/ref 17592186254340} {:answer/id #uuid "b63f2399-b1ef-59c8-be8b-f72934d61b0c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{e}^{5}}{2}" :db/id #edb/ref 17592186255283} {:answer/id #uuid "ef612402-f1a0-55cb-8215-9500ae958c47" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{e}^{2}+{e}^{5}" :db/id #edb/ref 17592186255762} {:answer/id #uuid "faccb7a5-43af-5b0a-8c12-37d5995f9f8b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{e}^{2}}{2}" :db/id #edb/ref 17592186255871}] :answer-field/correct {:answer/id #uuid "4ddb2256-cdec-5fd5-b64a-ffbc48c96995" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{e}^{2}+{e}^{5}}{2}" :db/id #edb/ref 17592186254340} :answer-field/id #uuid "73fd2e63-bc3b-516e-aa50-4cef260983d7" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186256133}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "3ad853df-f7ff-5b1c-95e8-898b94e2247f" :question/math-academy-id "q-120998" :question/problem "A particle $P$ moves along the $x$-axis and its velocity at time $t>0$ is given by $v(t)={e}^{2t+1}.$ At time $t=0.5$ the particle is located at the position $x={e}^{2}.$ What is the position of the particle at time $t=2?$" :question/worked-solution "The position of the particle at $t=2$ is equal to its position at $t=0.5$ plus the total displacement over $t\\in [0.5,2].$ Therefore, we can calculate it as follows:\n\n$$\nx(2)=x(0.5)+{\\int }_{0.5}^{2}v(t)\\,\\text{d}t\n$$\n\nCarrying out the computations, we get\n\n$$\n\\begin{aligned}x(2) & ={e}^{2}+{\\int }_{0.5}^{2}{e}^{2t+1}\\,\\text{d}t \\\\  & ={e}^{2}+{[\\frac{1}{2}{e}^{2t+1}]}_{0.5}^{2} \\\\  & ={e}^{2}+(\\frac{1}{2}{e}^{2(2)+1}-\\frac{1}{2}{e}^{2(0.5)+1}) \\\\  & ={e}^{2}+(\\frac{1}{2}{e}^{5}-\\frac{1}{2}{e}^{2}) \\\\  & =\\frac{1}{2}{e}^{2}+\\frac{1}{2}{e}^{5} \\\\  & =\\frac{{e}^{2}+{e}^{5}}{2}.\\end{aligned}\n$$\n\nSo, the position of the particle at $t=2$ is $x=\\frac{{e}^{2}+{e}^{5}}{2}.$"}] [{:db/id #edb/ref 17592186256511 :knowledge-point/_questions [{:db/id #edb/ref 17592186100843 :knowledge-point/id #uuid "97786302-e865-5581-b08e-8da7c6b7a01b" :knowledge-point/title "Finding the General Solution to an Equation Containing a Transformed Tangent or Cotangent Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4658f5ed-bea8-55d3-a5c8-e35701a6a2f1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{3}" :db/id #edb/ref 17592186254264} {:answer/id #uuid "98577715-7654-563c-bb0e-d13248802bc3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{9}" :db/id #edb/ref 17592186255018} {:answer/id #uuid "b8b96a5b-8ec0-5a2c-b97f-ec596610936d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{18}" :db/id #edb/ref 17592186255310} {:answer/id #uuid "d7eeb10e-7c5a-5705-a0a6-9546f983b82d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{5}{18}" :db/id #edb/ref 17592186255585} {:answer/id #uuid "e4cee127-4c04-5f38-b790-e5f2e404fedf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{4}{9}" :db/id #edb/ref 17592186255693}] :answer-field/correct {:answer/id #uuid "b8b96a5b-8ec0-5a2c-b97f-ec596610936d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{18}" :db/id #edb/ref 17592186255310} :answer-field/id #uuid "82979c27-ebd4-5fae-902f-a919bb5b2e12" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186256165}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "c6a9809a-4ab2-58a8-8350-cebc2231a946" :question/math-academy-id "q-121066" :question/problem "Consider the following trigonometric equation: \n\n$$\n\\operatorname{cot}⁡(3x)=-\\sqrt{3}\n$$\n\nThe general solution of this equation can be expressed as \n\n$$\nx=a\\pi +\\frac{n\\pi }{3},\n$$\n\nwhere $n$ is any integer. Which of the following could be the value of $a?$" :question/worked-solution "The given equation is equivalent to \n\n$$\n\\operatorname{tan}⁡3x=-\\frac{\\sqrt{3}}{3}.\n$$\n\nSo, the general solution to our equation is\n\n$$\n\\begin{aligned}3x & =-\\frac{\\pi }{6}+n\\pi .\\end{aligned}\n$$\n\nSolving the above equation for $x,$ we get\n\n$$\n\\begin{aligned}x & =-\\frac{\\pi }{18}+\\frac{n\\pi }{3}.\\end{aligned}\n$$\n\nTherefore, we have that $a=-\\frac{1}{18}.$"}] [{:db/id #edb/ref 17592186256518 :knowledge-point/_questions [{:db/id #edb/ref 17592186092167 :knowledge-point/id #uuid "d8c7ab50-5a8b-5bcd-8483-cec8bf6bd3ce" :knowledge-point/title "Solving a Trigonometric Equation Involving Tangent with Non-Special Angles"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0a65183c-2bf9-5a8f-ab7a-90a1855419e2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x={83}^{∘},{263}^{∘}" :db/id #edb/ref 17592186253750} {:answer/id #uuid "13ce42f3-cac8-5bb4-9066-effdabcf2334" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x={63}^{∘},{243}^{∘}" :db/id #edb/ref 17592186253840} {:answer/id #uuid "38b6122c-c8d7-5ed6-b92c-eefe16988d2e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x={76}^{∘},{256}^{∘}" :db/id #edb/ref 17592186254163} {:answer/id #uuid "748b63c3-6f43-569d-9e36-9b9a22a9eb61" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x={70}^{∘},{250}^{∘}" :db/id #edb/ref 17592186254700} {:answer/id #uuid "96a15fbc-f4a7-5fd5-b3c5-d8d3244e644a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x={88}^{∘},{268}^{∘}" :db/id #edb/ref 17592186254995}] :answer-field/correct {:answer/id #uuid "0a65183c-2bf9-5a8f-ab7a-90a1855419e2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x={83}^{∘},{263}^{∘}" :db/id #edb/ref 17592186253750} :answer-field/id #uuid "409bc980-f28a-5a07-b298-2291184f8da2" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186256040}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "c1252830-b58d-56d0-beaa-bb7162765f44" :question/math-academy-id "q-121127" :question/problem "Solve the equation $\\operatorname{tan}⁡x=8$ for ${0}^{∘}\\le x<{360}^{∘},$ rounded to the nearest integer." :question/worked-solution "First, we find the principal value:\n\n$$\n\\begin{aligned}x=\\operatorname{arctan}⁡(8)=82.874\\,983{…}^{∘}≈{82.87}^{∘}\\end{aligned}\n$$\n\nSince ${82.87}^{∘}$ lies inside the given domain, our first solution is ${x}_{1}={82.87}^{∘}.$\n\nTo generate more solutions, we add integer multiples of ${180}^{∘}.$ Hence,\n\n$$\n\\begin{aligned}{x}_{2}={180}^{∘}+{82.87}^{∘}={262.87}^{∘}.\\end{aligned}\n$$\n\nSo, the solutions are\n\n$$\nx={83}^{∘},{263}^{∘}\n$$\n\nrounded to the nearest integer."}] [{:db/id #edb/ref 17592186060004 :knowledge-point/_questions [{:db/id #edb/ref 17592186059670 :knowledge-point/id #uuid "e6eef35a-3502-5429-bd71-fb5bd0e8efc8" :knowledge-point/title "Identifying Extrema on Transformed Curves"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0737c6dd-2968-5cc9-a8f8-c0079a8268a8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(3,5)" :db/id #edb/ref 17592186253724} {:answer/id #uuid "2173f031-3969-54c9-823a-49ff47d49386" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(4,4)" :db/id #edb/ref 17592186253967} {:answer/id #uuid "75bbd111-a6df-57f9-ac2f-45af1364cecd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(5,3)" :db/id #edb/ref 17592186254712} {:answer/id #uuid "8398ba0c-a692-519d-9e74-4243e928998b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(3,2)" :db/id #edb/ref 17592186254841} {:answer/id #uuid "acc2456f-4e14-5655-aa35-0e7518c63750" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(0,4)" :db/id #edb/ref 17592186255193}] :answer-field/correct {:answer/id #uuid "2173f031-3969-54c9-823a-49ff47d49386" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(4,4)" :db/id #edb/ref 17592186253967} :answer-field/id #uuid "7037b1e7-eb89-5813-ae66-13b1ef312f28" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186256125}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "bce89a1c-1788-5140-a53a-cfabf6eebe67" :question/math-academy-id "q-121221" :question/problem "![](images/1e/1eb29eb3eb3627e24a23d7315295a1d889308d67895f9b798dbf9dd71ba226df.png)\n\nThe diagram above shows the local minimum and maximum of the function $y=f(x).$ What is the local maximum of $y=f(x-2)+1?$" :question/worked-solution "Notice that the graph of $y=f(x-2)+1$ can be obtained from the graph of $y=f(x)$ by \n\n- translating it by $2$ units to the right, and then\n\n- translating it by $1$ unit up.\n\nSince these transformations do not flip the graph across the $x$-axis, the combined transformation maps the local maximum of $y=f(x)$ to the local maximum of $y=f(x-2)+1.$ So, we need to find the image of $(2,3),$ the local maximum of $y=f(x),$ under the transformation. \n\nTo plot $y=f(x-2)+1,$ we apply the following steps: \n\n- First, we take the graph $y=f(x)$ that passes through $(2,3).$\n\n- Then, we shift the graph horizontally by $2$ units to the right and get the graph of $y=f(x-2).$ After this transformation, the point $(2,3)$ will be mapped to the point\n\n$$\n(2+2,3)=(4,3).\n$$\n\n- Finally, we shift the result vertically by $1$ unit upward and get the graph of $y=f(x-2)+1.$ After this transformation, the point $(4,3)$ will be mapped to the point\n\n$$\n(4,3+1)=(4,4).\n$$\n\nTherefore, the local maximum of $y=f(x-2)+1$ is $(4,4).$"}] [{:db/id #edb/ref 17592186129420 :knowledge-point/_questions [{:db/id #edb/ref 17592186129218 :knowledge-point/id #uuid "798800a5-255a-5738-91d2-21c2a78e4fb5" :knowledge-point/title "Identifying Quadrants Where a Function Is Positive or Negative Using a Sign Table"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9540b1c6-1f60-5074-bc72-614497b1d511" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "| $+$ | $-$ |\n| --- | ---: |\n| $+$ | $-$ |" :db/id #edb/ref 17592186126021} {:answer/id #uuid "225ef1cc-e171-581b-9168-b62af522eaaf" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "| $+$ | $+$ |\n| --- | ---: |\n| $-$ | $-$ |" :db/id #edb/ref 17592186126022} {:answer/id #uuid "474e66ca-38c6-57e5-867b-dc2131699afc" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "| $-$ | $-$ |\n| --- | ---: |\n| $+$ | $+$ |" :db/id #edb/ref 17592186126023} {:answer/id #uuid "4da82025-9d7b-5d93-8eaa-aa9a7a748046" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "| $-$ | $+$ |\n| --- | ---: |\n| $+$ | $-$ |" :db/id #edb/ref 17592186126024} {:answer/id #uuid "7e15f2e9-414c-53a7-b3cf-a14270732414" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "| $+$ | $-$ |\n| --- | ---: |\n| $-$ | $+$ |" :db/id #edb/ref 17592186126025}] :answer-field/id #uuid "8c61e26d-991b-5668-80f7-0785c37f283e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186126020} {:answer-field/choices [{:answer/id #uuid "c4dbf705-cee3-5a2c-9125-3946c564ec00" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "| $-$ | $+$ |\n| --- | --- |\n| $+$ | $-$ |" :db/id #edb/ref 17592186400025} {:answer/id #uuid "1d6f1d85-455b-54c4-a553-d7027285c20a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "| $-$ | $-$ |\n| --- | --- |\n| $+$ | $+$ |" :db/id #edb/ref 17592186400026} {:answer/id #uuid "66162eee-8604-5475-b382-dcc21d8d4509" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "| $+$ | $-$ |\n| --- | --- |\n| $-$ | $+$ |" :db/id #edb/ref 17592186400027} {:answer/id #uuid "93c145eb-e6c5-52ce-992a-13b9093a7cfe" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "| $+$ | $+$ |\n| --- | --- |\n| $-$ | $-$ |" :db/id #edb/ref 17592186400028} {:answer/id #uuid "6d391ad0-bc16-5e16-b69b-8ee83a3c5a5f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "| $+$ | $-$ |\n| --- | --- |\n| $+$ | $-$ |" :db/id #edb/ref 17592186400029}] :answer-field/correct {:answer/id #uuid "93c145eb-e6c5-52ce-992a-13b9093a7cfe" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "| $+$ | $+$ |\n| --- | --- |\n| $-$ | $-$ |" :db/id #edb/ref 17592186400028} :answer-field/id #uuid "fb437352-abc5-5152-9f74-63b63fa11e03" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186400024}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "044d4f72-bfa3-5995-a255-529e2a3f6304" :question/math-academy-id "q-121237" :question/problem "Consider the expression $f(x,y)=2{x}^{2}y.$ What are the missing entries in the following sign table of $f(x,y)?$\n\n| $y>0$ |  |  |\n| --- | --- | --- |\n| $y<0$ |  |  |\n|  | $x<0$ | $x>0$ |" :question/worked-solution "Notice that $f(x,y)$ equals zero when $x=0$ and $y=0.$ These lines divide the $xy$-plane into four regions, as shown below.\n\n![](images/c3/c35c98904d2a0d0d6d49c582cd9f9dba9d96e91ae0da5deb2d329f38f77532e3.png)\n\nTo determine the sign of $f(x,y)$ in each region, we pick four test points, one for each region.\n\n![](images/93/9340582eaad37c4ce1e0c8cbcdce48faec1e36c3c05adbedd61aa2de7168fd2f.png)\n\nNext, we calculate the sign of $f(x,y)$ in each region using a sign table:\n\n|  | Test point | $2{x}^{2}$ | $y$ | $f(x,y)$ |\n| --- | --- | --- | --- | --- |\n| Top-Left | $(-1,1)$ | $+$ | $+$ | $+$ |\n| Top-Right | $(1,1)$ | $+$ | $+$ | $+$ |\n| Bottom-Left | $(-1,-1)$ | $+$ | $-$ | $-$ |\n| Bottom-Right | $(1,-1)$ | $+$ | $-$ | $-$ |\n\n \nUsing the *last* column of the table above, we get the following picture:\n\n![](images/7c/7c851189a040934728e1b312706b4727c141cc678a4be870b6057e281be6e0fd.png)\n\nFinally, we fill in the required sign table.\n\n| $y>0$ | $+$ | $+$ |\n| --- | --- | --- |\n| $y<0$ | $-$ | $-$ |\n|  | $x<0$ | $x>0$ |"}] [{:db/id #edb/ref 17592186400030 :knowledge-point/_questions [{:db/id #edb/ref 17592186129218 :knowledge-point/id #uuid "798800a5-255a-5738-91d2-21c2a78e4fb5" :knowledge-point/title "Identifying Quadrants Where a Function Is Positive or Negative Using a Sign Table"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "72671465-7b70-5773-80b4-e4cedde69295" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "| $-$ | $+$ |\n| --- | --- |\n| $+$ | $-$ |" :db/id #edb/ref 17592186400032} {:answer/id #uuid "d80b0c36-be04-51cf-8639-70c95928c94e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "| $-$ | $+$ |\n| --- | --- |\n| $-$ | $+$ |" :db/id #edb/ref 17592186400033} {:answer/id #uuid "c0ceb13e-795b-566d-a074-cc3058ffcb4b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "| $+$ | $-$ |\n| --- | --- |\n| $-$ | $+$ |" :db/id #edb/ref 17592186400034} {:answer/id #uuid "a4f650b5-c800-5fef-8eca-7813662228d9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "| $+$ | $+$ |\n| --- | --- |\n| $-$ | $-$ |" :db/id #edb/ref 17592186400035} {:answer/id #uuid "441241b7-ff8b-5666-a6d2-1c4ef23106d0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "| $+$ | $-$ |\n| --- | --- |\n| $+$ | $-$ |" :db/id #edb/ref 17592186400036}] :answer-field/correct {:answer/id #uuid "441241b7-ff8b-5666-a6d2-1c4ef23106d0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "| $+$ | $-$ |\n| --- | --- |\n| $+$ | $-$ |" :db/id #edb/ref 17592186400036} :answer-field/id #uuid "e39c30c9-b895-523a-b8e2-967f711214ea" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186400031}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "9c438b33-3425-556a-afd9-37441982ae3b" :question/math-academy-id "q-121242" :question/problem "Consider the expression $f(x,y)=-5x{y}^{2}.$ What are the missing entries in the following sign table of $f(x,y)?$\n\n| $y>0$ |  |  |\n| --- | --- | --- |\n| $y<0$ |  |  |\n|  | $x<0$ | $x>0$ |" :question/worked-solution "Notice that $f(x,y)$ equals zero when $x=0$ and $y=0.$ These lines divide the $xy$-plane into four regions, as shown below.\n\n![](images/c3/c35c98904d2a0d0d6d49c582cd9f9dba9d96e91ae0da5deb2d329f38f77532e3.png)\n\nTo determine the sign of $f(x,y)$ in each region, we pick four test points, one for each region.\n\n![](images/93/9340582eaad37c4ce1e0c8cbcdce48faec1e36c3c05adbedd61aa2de7168fd2f.png)\n\nNext, we calculate the sign of $f(x,y)$ in each region using a sign table:\n\n|  | Test point | $-5x$ | ${y}^{2}$ | $f(x,y)$ |\n| --- | --- | --- | --- | --- |\n| Top-Left | $(-1,1)$ | $+$ | $+$ | $+$ |\n| Top-Right | $(1,1)$ | $-$ | $+$ | $-$ |\n| Bottom-Left | $(-1,-1)$ | $+$ | $+$ | $+$ |\n| Bottom-Right | $(1,-1)$ | $-$ | $+$ | $-$ |\n\n \nUsing the *last* column of the table above, we get the following picture:\n\n![](images/74/743df5f5c9232346866a01aed9afa3d41fff0f61bf7812b7ae5db9a43efe59f4.png)\n\nFinally, we fill in the required sign table.\n\n| $y>0$ | $+$ | $-$ |\n| --- | --- | --- |\n| $y<0$ | $+$ | $-$ |\n|  | $x<0$ | $x>0$ |"}] [{:db/id #edb/ref 17592186387049 :knowledge-point/_questions [{:db/id #edb/ref 17592186129219 :knowledge-point/id #uuid "490982ac-6197-58eb-8d94-2ef28d659d50" :knowledge-point/title "Identifying Quadrants Where a Function Is Positive or Negative"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "cd7c1dad-91bd-57f7-a2d3-c2ad5a59757b" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/29/29cf79e3f216a3b33656473fd98bd04252e2abd6304fdd575ee56cd33e1f4c3d.png" :db/id #edb/ref 17592186387051} {:answer/id #uuid "e74fba45-c345-5136-9ccf-dd0ff41294b9" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/e4/e4fb6cb6b35a80a392e6f5091fddb7c136996927ea1810f0dd1db5d0e263996c.png" :db/id #edb/ref 17592186387052} {:answer/id #uuid "9d8aeec8-7b9a-5de3-8c61-a2066893fe39" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/05/058a4ec5eba7a1ada3fc5b89ada73819672a19f88fbf4450d1b2c04a4b0db498.png" :db/id #edb/ref 17592186387053} {:answer/id #uuid "d5709ac7-9b29-5da3-9010-4706154f5280" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/ba/ba965b75553f65311903910e182eac9c7b