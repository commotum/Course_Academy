#{[{:db/id #edb/ref 17592186329846 :knowledge-point/_questions [{:db/id #edb/ref 17592186059675 :knowledge-point/id #uuid "0de0627b-2568-5c02-8928-d14344df5a2f" :knowledge-point/title "Finding the Derivative of an Expression With Sine or Cosine Trigonometric Functions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "58178d4f-4abd-58b7-80f3-235da8563710" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2sin⁡x-2{x}^{-1}" :db/id #edb/ref 17592186327707} {:answer/id #uuid "6e8ba3a3-8163-54a7-a89c-617f3758ea02" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2sin⁡x-2{x}^{-3}" :db/id #edb/ref 17592186327890} {:answer/id #uuid "abf48582-4f98-5a96-ba7c-6645540d8053" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2sin⁡x-2{x}^{-3}" :db/id #edb/ref 17592186328424} {:answer/id #uuid "b8c3ad30-bf9c-5740-9f1f-85721ef68822" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2sin⁡x+2{x}^{-3}" :db/id #edb/ref 17592186328543} {:answer/id #uuid "fb5d65e6-8cdc-5871-afa6-4d5b3c079a97" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2sin⁡x-2{x}^{-2}" :db/id #edb/ref 17592186329139}] :answer-field/correct {:answer/id #uuid "abf48582-4f98-5a96-ba7c-6645540d8053" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2sin⁡x-2{x}^{-3}" :db/id #edb/ref 17592186328424} :answer-field/id #uuid "fa72fd76-960d-5bcb-9cf5-7f47b8602241" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186329616}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "f32d0b6b-0338-505d-81ba-ba8c8d1669de" :question/math-academy-id "q-47985" :question/problem "Find the derivative of $y=-2cos⁡x+{x}^{-2}.$" :question/worked-solution "We know that $\\frac{\\text{d}}{\\text{d}x}(cos⁡x)=-sin⁡x.$ Applying this formula, we have\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}}{\\text{d}x}(-2cos⁡x+{x}^{-2}) \\\\  & =-2(-sin⁡x)+(-2){x}^{-2-1} \\\\  & =2sin⁡x-2{x}^{-3}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186329847 :knowledge-point/_questions [{:db/id #edb/ref 17592186119978 :knowledge-point/id #uuid "8c0b7d95-c699-5762-aa44-449712f035c7" :knowledge-point/title "Calculating the Derivative of the Inverse of a Polynomial Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "38ba450c-d188-5534-a6ad-9cafd867771b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{2{({g}^{-1}(x))}^{2}}{{({g}^{-1}(x))}^{3}+1}" :db/id #edb/ref 17592186327431} {:answer/id #uuid "5ac51d0f-a480-5257-9373-a102ae71dd07" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{{g}^{-1}(x)}{2{g}^{-1}(x)+2}" :db/id #edb/ref 17592186327728} {:answer/id #uuid "750ebad7-1376-571e-b002-d5de0ee49d71" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{2{g}^{-1}(x)}{{({g}^{-1}(x))}^{2}+2}" :db/id #edb/ref 17592186327940} {:answer/id #uuid "b6596677-9e79-5e4d-84e5-b8e191d29f04" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{{({g}^{-1}(x))}^{2}}{2{({g}^{-1}(x))}^{3}+2}" :db/id #edb/ref 17592186328519} {:answer/id #uuid "f6eb08b3-97ab-5448-916e-1bc51afd4120" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{{g}^{-1}(x)}{{({g}^{-1}(x))}^{3}+2}" :db/id #edb/ref 17592186329100}] :answer-field/correct {:answer/id #uuid "b6596677-9e79-5e4d-84e5-b8e191d29f04" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{{({g}^{-1}(x))}^{2}}{2{({g}^{-1}(x))}^{3}+2}" :db/id #edb/ref 17592186328519} :answer-field/id #uuid "fc99300b-987e-5768-8111-394ddb19ea49" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186329622}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "22ff07e4-057d-5a67-9809-969ec3b995f3" :question/math-academy-id "q-47990" :question/problem "If $g(x)=-{x}^{2}+\\frac{2}{x},$ find ${({g}^{-1})}^{′}(x)$ as a function of ${g}^{-1}(x).$" :question/worked-solution "**Step 1:** First, we write the inverse function implicitly. The given function is $y=-{x}^{2}+\\frac{2}{x},$ and to write the inverse function implicitly, we swap $x$ and $y$ as follows:\n\n$$\nx=-{y}^{2}+\\frac{2}{y}\n$$\n\nNote that in the equation above, we have $y={g}^{-1}(x).$\n\n**Step 2:** Next, we differentiate. The overall goal is to find $\\frac{\\text{d}y}{\\text{d}x},$ but the equation is already solved for $x,$ so we compute $\\frac{\\text{d}x}{\\text{d}y}$ and then take the reciprocal:\n\n$$\n\\begin{aligned}\\frac{\\text{d}x}{\\text{d}y} & =\\frac{\\text{d}}{\\text{d}y}(-{y}^{2}+\\frac{2}{y}) \\\\ \\frac{\\text{d}x}{\\text{d}y} & =-2y-\\frac{2}{{y}^{2}} \\\\ \\frac{\\text{d}x}{\\text{d}y} & =-\\frac{2{y}^{3}+2}{{y}^{2}} \\\\ \\frac{\\text{d}y}{\\text{d}x} & =-\\frac{{y}^{2}}{2{y}^{3}+2}\\end{aligned}\n$$\n\n**Step 3:** Lastly, we write the result in terms of ${g}^{-1}(x).$ Since $y={g}^{-1}(x),$ we have\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}[{g}^{-1}(x)] & =-\\frac{({g}^{-1}(x))^{2}}{2({g}^{-1}(x))^{3}+2} \\\\ {({g}^{-1})}^{′}(x) & =-\\frac{({g}^{-1}(x))^{2}}{2({g}^{-1}(x))^{3}+2}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186329849 :knowledge-point/_questions [{:db/id #edb/ref 17592186096621 :knowledge-point/id #uuid "3c547746-49c8-5a4a-85fe-c6b75493a354" :knowledge-point/title "Differentiating a Quotient Containing Other Functions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5d04b0f4-3b5e-5a83-ab7c-fadd2fae0aa3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{xcos⁡x+2sin⁡x}{{x}^{3}}" :db/id #edb/ref 17592186327753} {:answer/id #uuid "79438a62-c77a-5744-9802-65b0e97ef42c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{cos⁡x-2xsin⁡x}{{x}^{4}}" :db/id #edb/ref 17592186327973} {:answer/id #uuid "85f38040-e7a5-59fd-a359-c862f85f6a27" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{xcos⁡x-2sin⁡x}{{x}^{3}}" :db/id #edb/ref 17592186328088} {:answer/id #uuid "a8c4ce4c-f609-552a-9123-d8fd254ccab0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2xcos⁡x-xsin⁡x}{{x}^{3}}" :db/id #edb/ref 17592186328396} {:answer/id #uuid "c0e8be1f-f487-5a62-b564-e74b12097ed9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{xsin⁡x-2cos⁡x}{{x}^{4}}" :db/id #edb/ref 17592186328619}] :answer-field/correct {:answer/id #uuid "85f38040-e7a5-59fd-a359-c862f85f6a27" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{xcos⁡x-2sin⁡x}{{x}^{3}}" :db/id #edb/ref 17592186328088} :answer-field/id #uuid "9f86cadc-4440-532f-bf1a-6161f5f6bfb9" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186329450}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "b3c4b5b5-b682-57e6-baf5-0601260b1ed0" :question/math-academy-id "q-47998" :question/problem "If $f(x)=\\frac{sin⁡x}{{x}^{2}},$ find ${f}^{′}(x).$" :question/worked-solution "In this case, the expression for $f(x)$ is a quotient $\\frac{u(x)}{v(x)}$ with $u(x)=sin⁡x$ and $v(x)={x}^{2}.$ \n\nTherefore, we apply the quotient rule as follows:\n\n$$\n\\begin{aligned}\\begin{aligned}{f}^{′}(x) & =\\frac{{u}^{′}(x)\\cdot v(x)-u(x)\\cdot {v}^{′}(x)}{[v(x)]^{2}} \\\\  & =\\frac{(sin⁡x)^{′}\\cdot {x}^{2}-sin⁡x\\cdot ({x}^{2})^{′}}{({x}^{2})^{2}} \\\\  & =\\frac{{x}^{2}cos⁡x-2xsin⁡x}{{x}^{4}} \\\\  & =\\frac{x(xcos⁡x-2sin⁡x)}{{x}^{4}} \\\\  & =\\frac{xcos⁡x-2sin⁡x}{{x}^{3}}\\end{aligned}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186329850 :knowledge-point/_questions [{:db/id #edb/ref 17592186092260 :knowledge-point/id #uuid "a83f86ab-a008-5487-b118-f1495a0fe4d6" :knowledge-point/title "Differentiating an Exponential Function with a Linear Exponent"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "016b59fa-7dd1-5430-8a0d-9d17b256b87e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-8{e}^{4x-1}+3" :db/id #edb/ref 17592186326950} {:answer/id #uuid "1a09b33b-87d5-53a9-afee-f8e02962d4c3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}{e}^{4x-1}" :db/id #edb/ref 17592186327160} {:answer/id #uuid "35f572ac-b945-560e-89f5-d45ed6858e1a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8{e}^{4x-1}+3" :db/id #edb/ref 17592186327403} {:answer/id #uuid "bab77687-86e3-5b97-960a-d832566921c3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-8{e}^{4x-2}" :db/id #edb/ref 17592186328563} {:answer/id #uuid "bfa829b5-29ee-5ba4-a1c8-72e5faa0588a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-8{e}^{4x-1}" :db/id #edb/ref 17592186328611}] :answer-field/correct {:answer/id #uuid "bfa829b5-29ee-5ba4-a1c8-72e5faa0588a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-8{e}^{4x-1}" :db/id #edb/ref 17592186328611} :answer-field/id #uuid "a2f4dd66-f6d3-5f50-8ce9-b004c416733f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186329462}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "dd0c521a-06b7-559f-8b78-1152ec8cbcd7" :question/math-academy-id "q-48007" :question/problem "Calculate ${f}^{′}(x)$ if $f(x)=-2{e}^{4x-1}+3.$" :question/worked-solution "First, we express $f(x)$ as the composite function\n\n$$\nf=-2{e}^{u}+3,\\,u=4x-1.\n$$\n\nDifferentiating gives\n\n$$\n\\frac{\\text{d}f}{\\text{d}u}=-2{e}^{u},\\,\\frac{\\text{d}u}{\\text{d}x}=4.\n$$\n\nWe now apply the chain rule, and get\n\n$$\n\\begin{aligned}\\frac{\\text{d}f}{\\text{d}x} & =\\frac{\\text{d}f}{\\text{d}u}\\cdot \\frac{\\text{d}u}{\\text{d}x} \\\\  & =-2{e}^{u}\\cdot 4 \\\\  & =-8{e}^{u} \\\\  & =-8{e}^{4x-1}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186392602 :knowledge-point/_questions [{:db/id #edb/ref 17592186068696 :knowledge-point/id #uuid "31eacf5a-75a5-5b38-8c24-4b1598ecf3a7" :knowledge-point/title "Identifying Points of Discontinuity"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d495799e-2f9d-5146-a399-506d9d32ad84" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/c9/c9ba1e63c665ad63597c822828fdf26ec0fefade083df5ea828f57a49d3aa149.png" :db/id #edb/ref 17592186392604} {:answer/id #uuid "c796e42f-5eb7-5d3a-900e-6d5fb58916e3" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/fc/fc1d428500558ed62fbf5f7e0c13604cbc759629cedb63a8f9c2f7fc0b412480.png" :db/id #edb/ref 17592186392605} {:answer/id #uuid "742220de-47f9-5f30-8679-f64626ac489f" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/d9/d9185fb471c9806d490133c6ea5a54ef69878f89ca0e0be66008ec3626bfe346.png" :db/id #edb/ref 17592186392606} {:answer/id #uuid "11ce7ab1-ca48-5c69-b7f7-b7ff62f3ea3d" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/49/49e7b3c3cd4e6410b95a307f74c90079ec61c2d3540f86a357db88c77039ca44.png" :db/id #edb/ref 17592186392607