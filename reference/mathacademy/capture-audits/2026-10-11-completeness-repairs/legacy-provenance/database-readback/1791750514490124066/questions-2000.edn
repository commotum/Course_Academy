:knowledge-point/title "Estimating the Value of a Function at a Point Given its Derivative"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "45fe17a1-d11e-5ef2-a485-5fbcd2100bcc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5.5" :db/id #edb/ref 17592186364228} {:answer/id #uuid "d516aced-a928-5914-9082-f564a782a28b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186364229} {:answer/id #uuid "f4ba16b8-0f05-5dd7-b702-a0bd9e5f4c67" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186364230} {:answer/id #uuid "34896b00-823a-5083-8e9e-bc2fc0d9d7c5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3.5" :db/id #edb/ref 17592186364231} {:answer/id #uuid "effc20e5-6c6d-58bc-9b08-56dab08a74ec" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186364232}] :answer-field/correct {:answer/id #uuid "f4ba16b8-0f05-5dd7-b702-a0bd9e5f4c67" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186364230} :answer-field/id #uuid "496c5022-25df-547f-b02e-e179117a549f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186364227}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "7c05a076-435e-50b5-bc51-d3ae092e8ee4" :question/math-academy-id "q-4814" :question/problem "Let $f$ be a function such that ${f}^{′}(x)=12{x}^{2}-6$ and $f(1)=-2.$ Use the tangent line approximation of $f(x)$ at $x=1$ to estimate the value of $f(2).$" :question/worked-solution "The tangent line approximation of $f(x)$ at the point $a=1$ is\n\n$$\n\\begin{aligned}L(x) & =f(a)+{f}^{′}(a)(x-a) \\\\  & =f(1)+{f}^{′}(1)(x-1).\\end{aligned}\n$$\n\nWe're told that $f(1)=-2,$ and since ${f}^{′}(x)=12{x}^{2}-6,$ then ${f}^{′}(1)=12(1)^{2}-6=6.$ So, the tangent line approximation is given by\n\n$$\nL(x)=-2+6(x-1).\n$$\n\nNow, we can approximate $f(2)$ by evaluating the tangent line approximation at $x=2.$ We get\n\n$$\n\\begin{aligned}f(2) & ≈L(2) \\\\  & =-2+6(2-1) \\\\  & =-2+6(1) \\\\  & =-2+6 \\\\  & =4.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186329876 :knowledge-point/_questions [{:db/id #edb/ref 17592186078618 :knowledge-point/id #uuid "c538b0a9-a084-5a83-a5fa-eca4e0270a93" :knowledge-point/title "Comparing an Exponential Function and a Logarithmic Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5591b8c8-3047-562b-8ef4-8361d55d25b9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186327673} {:answer/id #uuid "5c302237-b94a-5fe0-81b1-2587947f173d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "e+5" :db/id #edb/ref 17592186327742} {:answer/id #uuid "86671781-4a8f-573e-8fe7-aaff83f7332d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\operatorname{ln}⁡(5)}{e}+5" :db/id #edb/ref 17592186328093} {:answer/id #uuid "ad75e9f7-6e31-5997-8593-a8ef1838747e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186328440} {:answer/id #uuid "d3b4ca71-189f-58de-8fcc-5367fa284f35" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\infty " :db/id #edb/ref 17592186328793}] :answer-field/correct {:answer/id #uuid "ad75e9f7-6e31-5997-8593-a8ef1838747e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186328440} :answer-field/id #uuid "314cef58-95bb-572e-a378-8e9c798f6f07" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186329275}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "fb78782d-135f-57ce-a3ed-0b840f2e8d22" :question/math-academy-id "q-48212" :question/problem "Evaluate ${lim}_{x\\to \\infty }(\\operatorname{ln}⁡(5x){e}^{-x}+5).$" :question/worked-solution "Notice that we can rewrite the first term as\n\n$$\n\\operatorname{ln}⁡(5x){e}^{-x}=\\frac{\\operatorname{ln}⁡(5x)}{{e}^{x}}.\n$$\n\nBoth the numerator and denominator approach $\\infty $ as $x\\to \\infty .$ However, since ${e}^{x}≫\\operatorname{ln}⁡(5x)$ for large values of $x,$ the denominator is growing much faster than the numerator. Consequently, we conclude that\n\n$$\n{lim}_{x\\to \\infty }\\frac{\\operatorname{ln}⁡(5x)}{{e}^{x}}=0.\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}{lim}_{x\\to \\infty }(\\operatorname{ln}⁡(5x){e}^{-x}+5) & ={lim}_{x\\to \\infty }(\\frac{\\operatorname{ln}⁡(5x)}{{e}^{x}}+5) \\\\  & =0+5 \\\\  & =5.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186329877 :knowledge-point/_questions [{:db/id #edb/ref 17592186078617 :knowledge-point/id #uuid "433ac237-32ff-591c-ab0d-e271f5beda30" :knowledge-point/title "Comparing a Polynomial Function and a Logarithmic Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "385935e5-40b2-5cdf-a2a7-ac3e7865d543" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\text{DNE}" :db/id #edb/ref 17592186327426} {:answer/id #uuid "814d202d-efc4-5b86-b450-3050ed558ec6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\infty " :db/id #edb/ref 17592186328048} {:answer/id #uuid "afe78bc0-6b9b-58bb-a6b3-3d1ea65b8862" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186328457} {:answer/id #uuid "c4ec75bd-d3c7-56b5-bdc5-8279661cd6b5" :answer/type {:db/id #edb/ref 17592186045498 :db/i