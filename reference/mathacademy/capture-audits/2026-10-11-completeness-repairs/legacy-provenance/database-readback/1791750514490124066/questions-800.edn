b0-bb4d-51362a133037" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "47.3n" :db/id #edb/ref 17592186260367} {:answer/id #uuid "38babf1b-826f-5f7d-a5cd-3ac67c6c5c4b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "44.4n" :db/id #edb/ref 17592186260379} {:answer/id #uuid "4020c8b3-0933-50e3-8a2f-bd114983e935" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "41.9n" :db/id #edb/ref 17592186260437} {:answer/id #uuid "77a304a4-bd09-5a24-a472-c61bed5b5391" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "43.7n" :db/id #edb/ref 17592186260918} {:answer/id #uuid "a65f2a98-d121-53e8-add6-b9485d0b2eb3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "40.1n" :db/id #edb/ref 17592186261324}] :answer-field/correct {:answer/id #uuid "77a304a4-bd09-5a24-a472-c61bed5b5391" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "43.7n" :db/id #edb/ref 17592186260918} :answer-field/id #uuid "28f46a5e-81da-5c5a-894d-5420cf6156b8" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186262200}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "dec81709-4d57-533e-9540-a3bae9092291" :question/math-academy-id "q-127849" :question/problem "The vector $u$ has magnitude $7$, the vector $v$ has magnitude $7,$ the angle between $u$ and $v$ is ${117}^{∘}$ and $n$ is the unit vector that points in the direction of $u\\times v.$ Find $u\\times v$ in terms of $n.$ Round your final answer to one decimal place where appropriate." :question/worked-solution "We use the formula for the cross product and obtain\n\n$$\n\\begin{aligned}u\\times v & =|u|\\cdot |v|\\cdot \\operatorname{sin}⁡\\theta \\cdot n \\\\  & =7\\cdot 7\\cdot \\operatorname{sin}⁡{117}^{∘}\\cdot n \\\\  & =49\\cdot (0.891\\,00…)\\cdot n \\\\  & =(43.659\\,31…)\\cdot n \\\\  & ≈43.7n.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186262838 :knowledge-point/_questions [{:db/id #edb/ref 17592186119830 :knowledge-point/id #uuid "b0d93156-f9be-5e6e-976a-bef30dc892ee" :knowledge-point/title "Finding a Vector That Is Parallel To a Plane"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "28523b60-9c94-5e08-8811-eeb6c2c8385b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186260229} {:answer/id #uuid "4f6f925d-2385-5203-beed-2ae656f27e99" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186260554} {:answer/id #uuid "71ffe7bc-2035-50b5-afb6-f098f001c957" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{2}" :db/id #edb/ref 17592186260872} {:answer/id #uuid "c1024317-bb4d-5e9d-b670-c092e80227c9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{2}}{3}" :db/id #edb/ref 17592186261578} {:answer/id #uuid "fbc3f903-0607-5523-bb23-e9a27fc580dd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186262077}] :answer-field/correct {:answer/id #uuid "28523b60-9c94-5e08-8811-eeb6c2c8385b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186260229} :answer-field/id #uuid "9e71e846-7ac8-5f2e-bf8c-340173700a84" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186262406}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "1298261d-fd1d-57fd-8c0d-689d1739fab9" :question/math-academy-id "q-127888" :question/problem "A nonzero vector $⟨0,\\,b,\\,c⟩$ is parallel to the plane $r\\cdot ⟨3,2,-1⟩=\\sqrt{2}.$ What is the value of $\\frac{b}{c}?$" :question/worked-solution "We need a vector $v=⟨{t}_{1},{t}_{2},{t}_{3}⟩$ that is parallel to the given plane. \n\nFrom the equation $r\\cdot ⟨3,2,-1⟩=\\sqrt{2}$ of the plane, we get the normal vector $n=⟨3,2,-1⟩.$ So, $v⊥n$ and we have the following:\n\n$$\n\\begin{aligned}v\\cdot n & =0 \\\\ ⟨{t}_{1},{t}_{2},{t}_{3}⟩\\cdot ⟨3,2,-1⟩ & =0 \\\\ 3{t}_{1}+2{t}_{2}-{t}_{3} & =0 \\\\ {t}_{3} & =3{t}_{1}+2{t}_{2}\\end{aligned}\n$$\n\nHence, we obtain \n\n$$\nv=⟨{t}_{1},\\,{t}_{2},\\,3{t}_{1}+2{t}_{2}⟩,\n$$\n\nwhere ${t}_{1},{t}_{2}\\in (-\\infty ,\\infty ).$ \n\nWe are told that the first component of $v$ equals $0.$ So, we must set ${t}_{1}=0.$ \n\nSince $v$ is nonzero, we can pick any ${t}_{2}\\ne 0.$ For example, setting ${t}_{2}=1$, we get\n\n$$\nv=⟨0,\\,1,\\,2⟩.\n$$\n\nTherefore, $\\frac{b}{c}=\\frac{1}{2}.$"}] [{:db/id #edb/ref 17592186262841 :knowledge-point/_questions [{:db/id #edb/ref 17592186087703 :knowledge-point/id #uuid "4e64e0c3-f8f5-5c38-ae75-1aed92e0ac01" :knowledge-point/title "Solving for a Variable in a Singular Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0694821e-0afc-5a6f-9ac3-c60009288f14" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "a=\\pm 12" :db/id #edb/ref 17592186259936} {:answer/id #uuid "82ad1107-f4f2-56fb-a170-26080bfb5a58" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "a=\\pm 9" :db/id #edb/ref 17592186261009} {:answer/id #uuid "93eed24a-7d3e-5252-8646-ba1e56d6756f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "a=1" :db/id #edb/ref 17592186261161} {:answer/id #uuid "acb60d02-9af1-5edb-8a62-0a7f615d8394" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "a=\\pm 4" :db/id #edb/ref 17592186261386} {:answer/id #uuid "f1b9c926-8614-5473-84ac-a0af3c07259f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "a=2" :db/id #edb/ref 17592186261991}] :answer-field/correct {:answer/id #uuid "0694821e-0afc-5a6f-9ac3-c60009288f14" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "a=\\pm 12" :db/id #edb/ref 17592186259936} :answer-field/id #uuid "b5f9163f-3e19-52b4-9fae-e228093cfe55" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186262453}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "54a4b93b-d93e-5ce6-98ac-7b0ed79d28ef" :question/math-academy-id "q-127901" :question/problem "If $A=[\\begin{aligned}48 & a \\\\ a & 3\\end{aligned}]$ is a singular matrix, calculate the value(s) of $a.$" :question/worked-solution "The matrix $A$ is singular if and only if $det(A)=0.$ Calculating the determinant, we get\n\n$$\n\\begin{aligned}det(A) & =48\\cdot 3-a\\cdot a \\\\  & =144-{a}^{2}.\\end{aligned}\n$$\n\nNow, we set the determinant equal to $0$ and solve for $a:$\n\n$$\n\\begin{aligned}144-{a}^{2} & =0 \\\\ {a}^{2} & =144 \\\\ a & =\\pm 12\\end{aligned}\n$$\n\nTherefore, the values of $a$ are $a=\\pm 12.$"}] [{:db/id #edb/ref 17592186262842 :knowledge-point/_questions [{:db/id #edb/ref 17592186087703 :knowledge-point/id #uuid "4e64e0c3-f8f5-5c38-ae75-1aed92e0ac01" :knowledge-point/title "Solving for a Variable in a Singular Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "03e10364-a8ca-5a9b-8ec9-fb274ee07c3b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "t=9" :db/id #edb/ref 17592186259910} {:answer/id #uuid "64215484-b9df-5191-b8c1-9280990fe3aa" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "t=4" :db/id #edb/ref 17592186260740} {:answer/id #uuid "b5950187-60d8-50ca-a7cc-6a821b22c615" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "t=0" :db/id #edb/ref 17592186261470} {:answer/id #uuid "cec39778-4048-5806-ae58-6218823c031b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "k=\\pm 7" :db/id #edb/ref 17592186261705} {:answer/id #uuid "d2a62acf-b03a-52a7-ab5a-7633988a7413" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "k=\\pm 10" :db/id #edb/ref 17592186261728}] :answer-field/correct {:answer/id #uuid "b5950187-60d8-50ca-a7cc-6a821b22c615" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "t=0" :db/id #edb/ref 17592186261470} :answer-field/id #uuid "cfd7d4c7-e60d-5c53-95c8-2c7046132a9a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186262488}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "a4d5dba8-4e64-55e3-a838-e85b88eeb6cd" :question/math-academy-id "q-127903" :question/problem "If $M=[\\begin{aligned}t & 5 \\\\ t & 9\\end{aligned}]$ is a singular matrix, calculate the value(s) of $t.$" :question/worked-solution "The matrix $M$ is singular if and only if $det(M)=0.$ Calculating the determinant, we get\n\n$$\n\\begin{aligned}det(M) & =t\\cdot 9-t\\cdot 5 \\\\  & =9t-5t \\\\  & =4t\\end{aligned}\n$$\n\nNow, we set the determinant equal to $0$ and solve for $t:$\n\n$$\n\\begin{aligned}4t & =0 \\\\ t & =0\\end{aligned}\n$$\n\nTherefore, the value of $t$ is $t=0.$"}] [{:db/id #edb/ref 17592186262848 :knowledge-point/_questions [{:db/id #edb/ref 17592186105733 :knowledge-point/id #uuid "7c30217a-484c-5c31-a2bf-413f04e0edea" :knowledge-point/title "Calculating the Area of a Triangle Given Its Vertices"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "622785b6-0e5a-504c-8ba7-61c896b4597d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{2}" :db/id #edb/ref 17592186260722} {:answer/id #uuid "679872d9-fa42-5cab-a5a3-e29f317c39aa" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{21\\sqrt{2}}{2}" :db/id #edb/ref 17592186260780} {:answer/id #uuid "8c028d49-b914-543f-9314-9b33da7f6f9b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{86}}{2}" :db/id #edb/ref 17592186261098} {:answer/id #uuid "c1ddb50b-ce6a-5a57-9ddd-5fad6c4d0a87" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3\\sqrt{13}}{2}" :db/id #edb/ref 17592186261586} {:answer/id #uuid "cd0039be-579d-518d-a9d0-03877c66d22e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{43}" :db/id #edb/ref 17592186261681}] :answer-field/correct {:answer/id #uuid "8c028d49-b914-543f-9314-9b33da7f6f9b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{86}}{2}" :db/id #edb/ref 17592186261098} :answer-field/id #uuid "8005319e-8e8b-5ab9-a565-7a8f41f83817" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186262339}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "ef5f09ae-6eb9-5c04-9bb6-e694acc7855a" :question/math-academy-id "q-127913" :question/problem "Calculate the area of the $△\\,PQR,$ if $P(6,1,5),$ $Q(5,1,7),$ $R(4,2,0).$" :question/worked-solution "First, we find the vectors $\\overset{\\to }{PQ}$ and $\\overset{\\to }{PR}:$\n\n$$\n\\begin{aligned}\\overset{\\to }{PQ} & =q-p \\\\  & =(5i+j+7k)-(6i+j+5k) \\\\  & =-i+2k \\\\  & =⟨-1,0,2⟩ \\\\ \\overset{\\to }{PR} & =r-p \\\\  & =(4i+2j)-(6i+j+5k) \\\\  & =-2i+j-5k \\\\  & =⟨-2,1,-5⟩\\end{aligned}\n$$\n\nNow, using the formula to compute the cross product, we get\n\n$$\n\\begin{aligned}\\overset{\\to }{PQ}\\times \\overset{\\to }{PR} & =|\\begin{aligned}i & j & k \\\\ -1 & 0 & 2 \\\\ -2 & 1 & -5\\end{aligned}| \\\\  & =|\\begin{aligned}0 & 2 \\\\ 1 & -5\\end{aligned}|i-|\\begin{aligned}-1 & 2 \\\\ -2 & -5\\end{aligned}|j+|\\begin{aligned}-1 & 0 \\\\ -2 & 1\\end{aligned}|k \\\\  & =(0\\cdot (-5)-1\\cdot 2)i-((-1)\\cdot (-5)-(-2)\\cdot 2)j+((-1)\\cdot 1-(-2)\\cdot 0)k \\\\  & =-2i-9j-k \\\\  & =⟨-2,-9,-1⟩.\\end{aligned}\n$$\n\nTherefore, the area of the parallelogram spanned by $\\overset{\\to }{PQ}$ and $\\overset{\\to }{PR}$ is\n\n$$\n\\begin{aligned}A & =|\\overset{\\to }{PQ}\\times \\overset{\\to }{PR}| \\\\  & =\\sqrt{(-2)^{2}+(-9)^{2}+(-1)^{2}} \\\\  & =\\sqrt{86}.\\end{aligned}\n$$\n\nFinally, the area of the triangle is half of the area of the respective parallelogram. So, the area of $△\\,PQR$ is\n\n$$\n{A}_{△}=\\frac{1}{2}A=\\frac{\\sqrt{86}}{2}.\n$$"}] [{:db/id #edb/ref 17592186262851 :knowledge-point/_questions [{:db/id #edb/ref 17592186115234 :knowledge-point/id #uuid "d49a7b78-bea1-54e5-8232-3fea0d4eb5a3" :knowledge-point/title "Identifying a True Statement Concerning a 2x2 System of Equations"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0f450702-acf4-58a7-b147-c031752d7027" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186260019} {:answer/id #uuid "2ad1ab5b-2c16-5891-9da0-a94103b6a01f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186260253} {:answer/id #uuid "5af29382-2f60-52d5-be29-c6245e488118" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186260652} {:answer/id #uuid "add041e3-1b6e-56a8-8215-74a07df2021a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186261404} {:answer/id #uuid "b915bc94-a723-5075-99fa-b4d05aa76a1c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186261497}] :answer-field/correct {:answer/id #uuid "0f450702-acf4-58a7-b147-c031752d7027" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186260019} :answer-field/id #uuid "1208d2a6-3b36-508a-a51f-4ba90eaa7fa7" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186262155}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "cd31265e-20ac-5d02-8e25-ee3bd3fdfd6c" :question/math-academy-id "q-127919" :question/problem "Consider a system of two linear equations in two variables, represented by the matrix equation $Ax=b$ in the usual way. Given that the system has exactly one solution, which of the following statements are true?\n\n- $det(A)\\ne 0$\n- $A$ is  invertible\n- $Ax=0$ has a nonzero solution" :question/worked-solution "Recall that given $A=[\\begin{aligned}{a}_{11} & {a}_{12} \\\\ {a}_{21} & {a}_{22}\\end{aligned}]$, then according to the invertible matrix theorem the following statements are equivalent:    \n\n- $A$ is invertible.\n\n- The system $Ax=b$ has exactly one solution for any $2\\times 1$ column vector $b.$\n\n- The system $Ax=0$ has the unique zero solution.\n\n- The lines ${a}_{11}x+{a}_{12}y={b}_{1}$ and ${a}_{21}x+{a}_{22}y={b}_{2}$ intersect at exactly one point.\n\n- $det(A)\\ne 0.$\n\nAlso, we are told that the second part of the invertible matrix theorem is true. So, all the other parts of the theorem are true too. Therefore, according to the theorem:\n\n- Statement I is true by the fifth part of the invertible matrix theorem.\n\n- Statement II is true by the first part of the invertible matrix theorem.\n\n- Statement III is false by the third part of the invertible matrix theorem.\n\nTherefore, only statements I and II are true."}] [{:db/id #edb/ref 17592186387859 :knowledge-point/_questions [{:db/id #edb/ref 17592186115390 :knowledge-point/id #uuid "49b54258-61d2-549c-94e4-a251f6d2a656" :knowledge-point/title "Using the Sum and Constant Multiple Rules for Differentiation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a768cdba-762c-56fa-9c5a-e7c147a0278c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨-2,\\,-2t,\\,2t-2⟩" :db/id #edb/ref 17592186387861} {:answer/id #uuid "308ec3e7-64ed-53d8-95f6-4019058929dd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨-1,\\,2t,\\,{t}^{2}⟩" :db/id #edb/ref 17592186387862} {:answer/id #uuid "c6683669-2c03-5f5d-9b0c-ade45ed8142d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨-3,\\,2t+1,\\,3{t}^{2}+2t⟩" :db/id #edb/ref 17592186387863} {:answer/id #uuid "76309ab8-5db5-5655-9fd2-0aa6a5daad69" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨-1,\\,2t-2,\\,3{t}^{2}⟩" :db/id #edb/ref 17592186387864} {:answer/id #uuid "3051e681-37d6-5351-a17b-b57925e0ca74" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨-1,\\,2t-2,\\,3{t}^{2}+2t-2⟩" :db/id #edb/ref 17592186387865}] :answer-field/correct {:answer/id #uuid "3051e681-37d6-5351-a17b-b57925e0ca74" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨-1,\\,2t-2,\\,3{t}^{2}+2t-2⟩" :db/id #edb/ref 17592186387865} :answer-field/id #uuid "437f6985-a5fd-5604-8d5e-718379fa984b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186387860}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "1e49dfe3-04a3-591e-9ea0-48737f115840" :question/math-academy-id "q-127998" :question/problem "Differentiate $f(t)+g(t)$ with respect to $t$, given that \n\n$$\n\\begin{aligned}f(t) & =⟨1-2t,\\,{t}^{2},\\,(t-1)^{2}⟩, \\\\ g(t) & =⟨t+1,\\,1-2t,\\,{t}^{3}⟩\\end{aligned}\n$$" :question/worked-solution "By the sum rule, we have\n\n$$\n(f(t)+g(t))^{′}={f}^{′}(t)+{g}^{′}(t).\n$$\n\nLet's find the derivatives of each function:\n\n$$\n\\begin{aligned}{f}^{′}(t) & =⟨\\frac{\\text{d}}{\\text{d}t}(1-2t),\\,\\frac{\\text{d}}{\\text{d}t}({t}^{2}),\\,\\frac{\\text{d}}{\\text{d}t}((t-1)^{2})⟩ \\\\  & =⟨-2,\\,2t,\\,2(t-1)⟩ \\\\ {g}^{′}(t) & =⟨\\frac{\\text{d}}{\\text{d}t}(t+1),\\,\\frac{\\text{d}}{\\text{d}t}(1-2t),\\,\\frac{\\text{d}}{\\text{d}t}({t}^{3})⟩ \\\\  & =⟨1,\\,-2,\\,3{t}^{2}⟩\\end{aligned}\n$$\n\nTherefore, we obtain\n\n$$\n\\begin{aligned}(f(t)+g(t))^{′} & ={f}^{′}(t)+{g}^{′}(t) \\\\  & =⟨-2,\\,2t,\\,2t-2⟩+⟨1,\\,-2,\\,3{t}^{2}⟩ \\\\  & =⟨-1,\\,2t-2,\\,3{t}^{2}+2t-2⟩.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186262864 :knowledge-point/_questions [{:db/id #edb/ref 17592186105734 :knowledge-point/id #uuid "9331987e-8676-5bdb-b4ce-2129b1b09a8c" :knowledge-point/title "Calculating the Altitude of a Triangle Given Its Vertices"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "17263848-7dad-541b-ad58-74745572f296" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3\\sqrt{38}}{38}" :db/id #edb/ref 17592186260076} {:answer/id #uuid "1dfb5bcd-7bf0-53b0-a60b-2f17c4f73037" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3\\sqrt{38}}{19}" :db/id #edb/ref 17592186260133} {:answer/id #uuid "4c0f2dce-a930-5b09-bde7-49e546203c40" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186260526} {:answer/id #uuid "803e61e6-6963-5b24-9fb8-5a3e08371ece" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{6\\sqrt{38}}{19}" :db/id #edb/ref 17592186260987} {:answer/id #uuid "8d500b7a-085a-5399-943c-18364bfccf23" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186261108}] :answer-field/correct {:answer/id #uuid "803e61e6-6963-5b24-9fb8-5a3e08371ece" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{6\\sqrt{38}}{19}" :db/id #edb/ref 17592186260987} :answer-field/id #uuid "c8984f2f-6da2-54bf-9096-9f18e7aa0c0c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186262479}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "dbbc0374-2f40-56ea-b57e-f5227b194e10" :question/math-academy-id "q-128008" :question/problem "Calculate the length of the altitude $RH$ of the $△\\,PRQ,$ if $P(3,0,4),$ $Q(2,3,1),$ $R(0,3,1).$" :question/worked-solution "Note that the length of the altitude $RH$ can be related to the area of $△\\,PQR$ as follows:\n\n$$\n{A}_{△}=\\frac{1}{2}RH\\cdot PQ\n$$\n\nSo, to find $RH,$ we first find ${A}_{△}.$ To start, we find the vectors $\\overset{\\to }{PQ}$ and $\\overset{\\to }{PR}:$\n\n$$\n\\begin{aligned}\\overset{\\to }{PQ} & =q-p \\\\  & =(2i+3j+k)-(3i+4k) \\\\  & =-i+3j-3j \\\\  & =⟨-1,3,-3⟩ \\\\ \\overset{\\to }{PR} & =r-p \\\\  & =(3j+k)-(3i+4k) \\\\  & =-3i+3j-3k \\\\  & =⟨-3,3,-3⟩\\end{aligned}\n$$\n\nNow, we have\n\n$$\n\\begin{aligned}\\overset{\\to }{PQ}\\times \\overset{\\to }{PR} & =|\\begin{aligned}i & j & k \\\\ -1 & 3 & -3 \\\\ -3 & 3 & -3\\end{aligned}| \\\\  & =|\\begin{aligned}3 & -3 \\\\ 3 & -3\\end{aligned}|i-|\\begin{aligned}-1 & -3 \\\\ -3 & -3\\end{aligned}|j+|\\begin{aligned}-1 & 3 \\\\ -3 & 3\\end{aligned}|k \\\\  & =(3\\cdot (-3)-3\\cdot (-3))i-((-1)\\cdot (-3)-(-3)\\cdot (-3))j+((-1)\\cdot 3-(-3)\\cdot 3)k \\\\  & =6j+6k \\\\  & =⟨0,6,6⟩.\\end{aligned}\n$$\n\nTherefore, the area of the parallelogram spanned by $\\overset{\\to }{PQ}$ and $\\overset{\\to }{PR}$ is\n\n$$\n\\begin{aligned}A & =|\\overset{\\to }{PQ}\\times \\overset{\\to }{PR}| \\\\  & =\\sqrt{{0}^{2}+{6}^{2}+{6}^{2}} \\\\  & =\\sqrt{72} \\\\  & =6\\sqrt{2}.\\end{aligned}\n$$\n\nThe area of the triangle is half of the area of the respective parallelogram. So, the area of $△\\,PQR$ is\n\n$$\n{A}_{△}=\\frac{1}{2}A=\\frac{6\\sqrt{2}}{2}=3\\sqrt{2}.\n$$\n\nLet's also compute $PQ$ since it appears in the formula:\n\n$$\n\\begin{aligned}PQ & =|\\overset{\\to }{PQ}| \\\\  & =\\sqrt{(-1)^{2}+{3}^{2}+(-3)^{2}} \\\\  & =\\sqrt{19}\\end{aligned}\n$$\n\n \n\nFinally, using the formula ${A}_{△}=\\frac{1}{2}RH\\cdot PQ,$ we get\n\n$$\n\\begin{aligned}{A}_{△} & =\\frac{1}{2}RH\\cdot PQ \\\\ 3\\sqrt{2} & =\\frac{1}{2}RH\\cdot \\sqrt{19} \\\\ 6\\sqrt{2} & =RH\\cdot \\sqrt{19} \\\\ RH & =\\frac{6\\sqrt{2}}{\\sqrt{19}} \\\\ RH & =\\frac{6\\sqrt{38}}{19}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186262868 :knowledge-point/_questions [{:db/id #edb/ref 17592186059752 :knowledge-point/id #uuid "1ff88785-9281-5431-86d8-95fd89866787" :knowledge-point/title "Calculating a Minor in a 3x3 Matrix With Variable Entries"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "319c26d8-cd1f-558f-b9ba-62aa42d75694" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3pr-{r}^{2}" :db/id #edb/ref 17592186260320} {:answer/id #uuid "40b4c3b9-0dac-5605-872f-1102d7173aa3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5pq+6r" :db/id #edb/ref 17592186260441} {:answer/id #uuid "881fbb24-f9f1-530b-a99b-b89149717875" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "36pq" :db/id #edb/ref 17592186261063} {:answer/id #uuid "c6bda17d-cd64-5edb-96bc-38c5f28be06f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6qr-p" :db/id #edb/ref 17592186261630} {:answer/id #uuid "ce8ee965-ac75-5b84-9499-54ea2fa7c3fa" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186261703}] :answer-field/correct {:answer/id #uuid "881fbb24-f9f1-530b-a99b-b89149717875" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "36pq" :db/id #edb/ref 17592186261063} :answer-field/id #uuid "0fd151a3-11e8-54c3-8e7e-17ed85ea5842" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186262153}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "ab657870-efc9-54fa-b807-10ebb4cc9089" :question/math-academy-id "q-128024" :question/problem "What is the minor of ${t}_{22}$ in the matrix\n$T=[\\begin{aligned}3p & r & 3p \\\\ q & r & -q \\\\ -6q & -p & 6q\\end{aligned}]?$" :question/worked-solution "First, we remove the second row and the second column:\n\n$$\nT=[\\begin{aligned}3p & ∗ & 3p \\\\ ∗ & r & ∗ \\\\ -6q & ∗ & 6q\\end{aligned}]\n$$\n\n \n\nNext, we calculate the determinant:\n\n$$\n\\begin{aligned}det[\\begin{aligned}3p & 3p \\\\ -6q & 6q\\end{aligned}] & =|\\begin{aligned}3p & 3p \\\\ -6q & 6q\\end{aligned}| \\\\  & =3p\\cdot 6q-3p\\cdot (-6q) \\\\  & =18pq+18pq \\\\  & =36pq\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186387866 :knowledge-point/_questions [{:db/id #edb/ref 17592186115390 :knowledge-point/id #uuid "49b54258-61d2-549c-94e4-a251f6d2a656" :knowledge-point/title "Using the Sum and Constant Multiple Rules for Differentiation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a16c9dc1-0124-53fd-9b82-d496e53dbcff" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨0,-7,0⟩" :db/id #edb/ref 17592186387868} {:answer/id #uuid "f616ca61-be0f-5144-b6c8-08476269dd60" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨-2,-5,0⟩" :db/id #edb/ref 17592186387869} {:answer/id #uuid "309785b0-a118-5c93-829d-4b1bec8533d7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨2,7,0⟩" :db/id #edb/ref 17592186387870} {:answer/id #uuid "a99725fb-c5ed-5e02-9f65-da1970e78632" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨4,7,9⟩" :db/id #edb/ref 17592186387871} {:answer/id #uuid "69eaec62-e0f1-50fe-ae12-fb1a693cb8d5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨0,-5,1⟩" :db/id #edb/ref 17592186387872}] :answer-field/correct {:answer/id #uuid "69eaec62-e0f1-50fe-ae12-fb1a693cb8d5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨0,-5,1⟩" :db/id #edb/ref 17592186387872} :answer-field/id #uuid "f682f616-b62a-5bba-8f73-0577cd6f697d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186387867}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "998ff16d-b6a6-5973-8b01-9ee14eef7c71" :question/math-academy-id "q-128144" :question/problem "Find the value of $(f(t)-2g(t))^{′}$ at $t=1,$ if \n\n$$\n\\begin{aligned}f(t) & =⟨{t}^{2},\\,\\operatorname{ln}⁡t,\\,{e}^{t-1}⟩, \\\\ g(t) & =⟨2\\sqrt{t},\\,{t}^{3},\\,3⟩.\\end{aligned}\n$$" :question/worked-solution "First, notice that\n\n$$\n(f(t)-2g(t))^{′}={f}^{′}(t)-2{g}^{′}(t).\n$$\n\nLet's now find the derivatives of each function.\n\n$$\n\\begin{aligned}{f}^{′}(t) & =⟨\\frac{\\text{d}}{\\text{d}t}({t}^{2}),\\,\\frac{\\text{d}}{\\text{d}t}(\\operatorname{ln}⁡t),\\,\\frac{\\text{d}}{\\text{d}t}({e}^{t-1})⟩ \\\\  & =⟨2t,\\,\\frac{1}{t},\\,{e}^{t-1}⟩ \\\\ {g}^{′}(t) & =⟨\\frac{\\text{d}}{\\text{d}t}(2\\sqrt{t}),\\,\\frac{\\text{d}}{\\text{d}t}({t}^{3}),\\,\\frac{\\text{d}}{\\text{d}t}(3)⟩ \\\\  & =⟨\\frac{1}{\\sqrt{t}},\\,3{t}^{2},\\,0⟩\\end{aligned}\n$$\n\nTherefore, we obtain\n\n$$\n\\begin{aligned}(f(1)-2g(1))^{′} & ={f}^{′}(1)-2{g}^{′}(1) \\\\  & =⟨2(1),\\,\\frac{1}{1},\\,{e}^{1-1}⟩-2⟨\\frac{1}{\\sqrt{1}},\\,3(1)^{2},\\,0⟩ \\\\  & =⟨2,1,1⟩-2⟨1,3,0⟩ \\\\  & =⟨2,1,1⟩-⟨2,6,0⟩ \\\\  & =⟨0,-5,1⟩.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186364948 :knowledge-point/_questions [{:db/id #edb/ref 17592186059847 :knowledge-point/id #uuid "979859e4-b60c-548d-8da6-b180400e1b07" :knowledge-point/title "Calculating the Determinant of a 3x3 Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8b194044-2804-5fcf-a8b9-85153f639110" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "12" :db/id #edb/ref 17592186364950} {:answer/id #uuid "54638e37-8e75-56d4-9a53-7e2c86da678b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186364951} {:answer/id #uuid "c81acd3d-ac95-59d4-82b7-c347ecf84382" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186364952} {:answer/id #uuid "0c9c5b60-f770-5f9a-ba14-7c25357899e4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186364953} {:answer/id #uuid "00b39530-0e0b-51c1-a111-9de7ad7bbe3b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-19" :db/id #edb/ref 17592186364954}] :answer-field/correct {:answer/id #uuid "0c9c5b60-f770-5f9a-ba14-7c25357899e4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186364953} :answer-field/id #uuid "edaea1a1-bae4-5261-82aa-d4974642b5d8" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186364949}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "16690ec9-e7e6-5efe-838c-d6c519315582" :question/math-academy-id "q-128308" :question/problem "Find the value of $|\\begin{aligned}7 & 1 & -3 \\\\ 0 & 3 & 1 \\\\ -3 & 1 & 2\\end{aligned}|.$" :question/worked-solution "Using the formula, we take the alternating sum of the entries in the top row of the matrix, multiplied by their respective minors, as follows:\n\n$$\n\\begin{aligned}|\\begin{aligned}7 & 1 & -3 \\\\ 0 & 3 & 1 \\\\ -3 & 1 & 2\\end{aligned}| & =7|\\begin{aligned}3 & 1 \\\\ 1 & 2\\end{aligned}|-1|\\begin{aligned}0 & 1 \\\\ -3 & 2\\end{aligned}|-3|\\begin{aligned}0 & 3 \\\\ -3 & 1\\end{aligned}| \\\\  & =7(6-1)-1(0+3)-3(0+9) \\\\  & =7\\cdot 5-1\\cdot 3-3\\cdot 9 \\\\  & =35-3-27 \\\\  & =5\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186262882 :knowledge-point/_questions [{:db/id #edb/ref 17592186059847 :knowledge-point/id #uuid "979859e4-b60c-548d-8da6-b180400e1b07" :knowledge-point/title "Calculating the Determinant of a 3x3 Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1682dd1e-6a3e-585a-b8de-5b23b7ea94c4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "20" :db/id #edb/ref 17592186260072} {:answer/id #uuid "1689a068-b51c-5ee0-8061-d29ddb153fe2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-5" :db/id #edb/ref 17592186260073} {:answer/id #uuid "1d2470ac-dd54-5b59-9478-94b73932f435" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "12" :db/id #edb/ref 17592186260124} {:answer/id #uuid "7d4bbf76-c7a5-5145-83ec-650fb6db1e65" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186260964} {:answer/id #uuid "de38351b-baf5-5a90-a6e5-ee73c0a46168" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-32" :db/id #edb/ref 17592186261839}] :answer-field/correct {:answer/id #uuid "de38351b-baf5-5a90-a6e5-ee73c0a46168" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-32" :db/id #edb/ref 17592186261839} :answer-field/id #uuid "b65a4ca0-f974-538c-8c68-2ae22626c269" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186262454}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "94e0f9cc-6b5b-54e5-ac6a-648684ded023" :question/math-academy-id "q-128309" :question/problem "Find the value of $|\\begin{aligned}-2 & 1 & 1 \\\\ 1 & 4 & 0 \\\\ 5 & -3 & 1\\end{aligned}|.$" :question/worked-solution "Using the formula, we take the alternating sum of the entries in the top row of the matrix, multiplied by their respective minors, as follows:\n\n$$\n\\begin{aligned}|\\begin{aligned}-2 & 1 & 1 \\\\ 1 & 4 & 0 \\\\ 5 & -3 & 1\\end{aligned}| & =-2|\\begin{aligned}4 & 0 \\\\ -3 & 1\\end{aligned}|-1|\\begin{aligned}1 & 0 \\\\ 5 & 1\\end{aligned}|+1|\\begin{aligned}1 & 4 \\\\ 5 & -3\\end{aligned}| \\\\  & =-2(4-0)-1(1-0)-1(-3-20) \\\\  & =-2\\cdot 4-1\\cdot 1+1\\cdot (-23) \\\\  & =-8-1-23 \\\\  & =-32\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186262886 :knowledge-point/_questions [{:db/id #edb/ref 17592186105737 :knowledge-point/id #uuid "3e0b4d33-7699-5068-90f1-663534cd662d" :knowledge-point/title "Calculating Scalar Triple Products Using Its Properties"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ac9f5fa0-b5b6-5984-816e-05ebf16c604e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186261385} {:answer/id #uuid "d3e506eb-0c73-54cd-bea5-69edf125c21e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186261741} {:answer/id #uuid "daff916a-8d3a-5192-a81e-8d54ac5e6b90" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186261811} {:answer/id #uuid "f263a5a4-8c23-5633-8f3f-d1dee00dda4b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186261994} {:answer/id #uuid "f3a8659d-0b1d-58eb-a190-a4dc181002b1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186262004}] :answer-field/correct {:answer/id #uuid "f3a8659d-0b1d-58eb-a190-a4dc181002b1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186262004} :answer-field/id #uuid "9d44782d-0883-5e02-9033-b08b78209c43" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186262403}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "6324ef53-4779-5e72-aa0d-0e3d70a28579" :question/math-academy-id "q-128356" :question/problem "Find $c\\cdot (b\\times a),$ if $b\\times c=⟨6,-1,3⟩$ and $a=⟨3,5,-4⟩.$" :question/worked-solution "First, we compute the triple scalar product \n\n$$\n\\begin{aligned}a\\cdot (b\\times c) & =⟨3,5,-4⟩\\cdot ⟨6,-1,3⟩ \\\\  & =3\\cdot 6+5\\cdot (-1)+(-4)\\cdot 3 \\\\  & =18-5-12 \\\\  & =1.\\end{aligned}\n$$\n\nThen, we swap $a$ and $c$ to get\n\n$$\n\\begin{aligned}c\\cdot (b\\times a)=-1.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186363024 :knowledge-point/_questions [{:db/id #edb/ref 17592186119834 :knowledge-point/id #uuid "80c443e5-a0b2-5aae-ac8d-27449a8049a3" :knowledge-point/title "Finding the Vector Equation of a Plane Given Its Cartesian Equation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c5e34802-4e03-501d-b655-3f42e2ddfc64" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(r-⟨0,-3,0⟩)\\cdot ⟨3,5,0⟩=0" :db/id #edb/ref 17592186363026} {:answer/id #uuid "bec5e5a9-a073-528d-9ae3-9bfe40a3b19e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(r-⟨0,0,-3⟩)\\cdot ⟨5,3,0⟩=0" :db/id #edb/ref 17592186363027} {:answer/id #uuid "0d1df4cb-44e6-56d3-a196-44308fd4a048" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(r-⟨0,3,0⟩)\\cdot ⟨3,5,-1⟩=0" :db/id #edb/ref 17592186363028} {:answer/id #uuid "e6bc49eb-5a6c-5d63-a2d4-86976bd7f8e5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(r-⟨0,0,3⟩)\\cdot ⟨5,3,0⟩=0" :db/id #edb/ref 17592186363029} {:answer/id #uuid "76481902-4242-5eb8-a9a5-98cb5658a19f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(r-⟨0,-3,1⟩)\\cdot ⟨3,0,5⟩=0" :db/id #edb/ref 17592186363030}] :answer-field/correct {:answer/id #uuid "c5e34802-4e03-501d-b655-3f42e2ddfc64" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(r-⟨0,-3,0⟩)\\cdot ⟨3,5,0⟩=0" :db/id #edb/ref 17592186363026} :answer-field/id #uuid "62d8e0de-bd79-5989-ac01-8e91264eb204" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186363025}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "375a2ad1-dda0-51b8-a824-e404e34a60e1" :question/math-academy-id "q-128382" :question/problem "Given the Cartesian equation $3x+5y+15=0$ of the plane $Π$, find an equation of $Π$ in the form $(r-p)\\cdot n=0.$" :question/worked-solution "First, from the equation of the plane we get that the normal vector of $Π$ is $n=⟨3,5,0⟩.$\n\nNow, we solve the Cartesian equation of $Π$ for $y$:\n\n$$\n\\begin{aligned}3x+5y+15 & =0 \\\\ 5y & =-3x-15 \\\\ y & =-\\frac{3}{5}x-3.\\end{aligned}\n$$\n\nIf we put, say, $x=0$, we get $y=-3.$ Hence, the point $P(0,-3,0)$ lies on $Π.$ Note that the position vector of $P$ is $p=⟨0,-3,0⟩.$\n\nFinally, we obtain\n\n$$\n\\begin{aligned}(r-p)\\cdot n & =0 \\\\ (r-⟨0,-3,0⟩)\\cdot ⟨3,5,0⟩ & =0.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186387873 :knowledge-point/_questions [{:db/id #edb/ref 17592186119834 :knowledge-point/id #uuid "80c443e5-a0b2-5aae-ac8d-27449a8049a3" :knowledge-point/title "Finding the Vector Equation of a Plane Given Its Cartesian Equation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1e8820fb-a6d0-5faf-9981-71cb5d041f29" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(r-⟨0,-3,0⟩)\\cdot ⟨7,-1,0⟩=0" :db/id #edb/ref 17592186387875} {:answer/id #uuid "6c78dd0f-845d-5bcb-9b44-79f85c755d47" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(r-⟨0,9,0⟩)\\cdot ⟨-7,0,1⟩=0" :db/id #edb/ref 17592186387876} {:answer/id #uuid "d00473ec-47a7-55f6-8a63-b87befe37369" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(r-⟨0,6,0⟩)\\cdot ⟨0,7,1⟩=0" :db/id #edb/ref 17592186387877} {:answer/id #uuid "d3744926-06d2-5a5f-a5e2-07abcc77fabc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(r-⟨0,3,0⟩)\\cdot ⟨7,1,0⟩=0" :db/id #edb/ref 17592186387878} {:answer/id #uuid "47647d85-f672-5262-8d4f-f0d7a9258831" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(r-⟨0,-6,0⟩)\\cdot ⟨7,0,1⟩=0" :db/id #edb/ref 17592186387879}] :answer-field/correct {:answer/id #uuid "d3744926-06d2-5a5f-a5e2-07abcc77fabc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(r-⟨0,3,0⟩)\\cdot ⟨7,1,0⟩=0" :db/id #edb/ref 17592186387878} :answer-field/id #uuid "eab2fab9-a504-560f-bbc5-2ac638b9790f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186387874}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "a275fd86-a21a-5ef1-ae5c-9df806e069b0" :question/math-academy-id "q-128400" :question/problem "Given the Cartesian equation $7x+y-3=0$ of the plane $Π$, find an equation of $Π$ in the form $(r-p)\\cdot n=0.$" :question/worked-solution "First, from the equation of the plane we get that the normal vector of $Π$ is $n=⟨7,1,0⟩.$\n\nNow, we solve the Cartesian equation of $Π$ for $y$:\n\n$$\n\\begin{aligned}7x+y-3 & =0 \\\\ y & =3-7x.\\end{aligned}\n$$\n\nIf we put, say, $x=0$, we get $y=3.$ Hence, the point $P(0,3,0)$ lies on $Π.$ Note that the position vector of $P$ is $p=⟨0,3,0⟩.$\n\nFinally, we obtain\n\n$$\n\\begin{aligned}(r-p)\\cdot n & =0 \\\\ (r-⟨0,3,0⟩)\\cdot ⟨7,1,0⟩ & =0.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186262893 :knowledge-point/_questions [{:db/id #edb/ref 17592186105907 :knowledge-point/id #uuid "fe9711f6-e2ad-5eed-8ded-a6153b0322bd" :knowledge-point/title "Calculating the Volume of a Parallelepiped Spanned by Three Vectors"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5cc0cb83-5eb1-5dd9-af9f-ee8ca5368146" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "66" :db/id #edb/ref 17592186260669} {:answer/id #uuid "788bb643-f360-5e75-ad92-1f1daf3b6599" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "7" :db/id #edb/ref 17592186260931} {:answer/id #uuid "c59fb9ed-aa8c-55a3-8bca-ec58a0283bdb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "38" :db/id #edb/ref 17592186261618} {:answer/id #uuid "ccb90a7b-e64c-5bcf-9e83-02b231607e75" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "26" :db/id #edb/ref 17592186261678} {:answer/id #uuid "fede5c03-7967-5771-bc19-dd1e5e5a6385" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186262109}] :answer-field/correct {:answer/id #uuid "ccb90a7b-e64c-5bcf-9e83-02b231607e75" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "26" :db/id #edb/ref 17592186261678} :answer-field/id #uuid "e0a92faf-5d71-5f25-92c3-12fac1bc6f1b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186262516}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "8f9b021c-bf51-5fc5-8b75-b8c974a0fbe9" :question/math-academy-id "q-128433" :question/problem "Calculate the volume of the parallelepiped spanned by $a=⟨0,-1,4⟩,$ $b=⟨3,9,2⟩,$ and $c=⟨2,7,6⟩.$" :question/worked-solution "The volume of the parallelepiped spanned by three vectors is given by the absolute value of their triple product.\n\nFirst, we compute the triple product:\n\n$$\n\\begin{aligned}a\\cdot (b\\times c) & =|\\begin{aligned}0 & -1 & 4 \\\\ 3 & 9 & 2 \\\\ 2 & 7 & 6\\end{aligned}| \\\\  & =0\\cdot |\\begin{aligned}9 & 2 \\\\ 7 & 6\\end{aligned}|-(-1)\\cdot |\\begin{aligned}3 & 2 \\\\ 2 & 6\\end{aligned}|+4\\cdot |\\begin{aligned}3 & 9 \\\\ 2 & 7\\end{aligned}| \\\\  & =0+(3\\cdot 6-2\\cdot 2)+4(3\\cdot 7-2\\cdot 9) \\\\  & =14+12 \\\\  & =26\\end{aligned}\n$$\n\n    \n\nFinally, we take the absolute value. So the volume of the corresponding parallelepiped is\n\n$$\nV=|26|=26.\n$$"}] [{:db/id #edb/ref 17592186262898 :knowledge-point/_questions [{:db/id #edb/ref 17592186105908 :knowledge-point/id #uuid "26c84e5b-97a7-5116-a90c-e4f011e87cf0" :knowledge-point/title "Determining Whether Three Vectors are Coplanar"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "22a7c5d9-8dc5-5287-9189-8dca5356aa94" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186260178} {:answer/id #uuid "5ed1a437-b5e4-5a5b-a1d5-378ea7dd2b92" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186260693} {:answer/id #uuid "9ff60d17-d510-5a62-8746-39d3d4fdeede" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186261263} {:answer/id #uuid "c622ad11-5bd8-50ea-9342-3a5d4042082b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186261620} {:answer/id #uuid "c6e3045d-1419-56b9-bd4b-6b851cebb90e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186261633}] :answer-field/correct {:answer/id #uuid "c622ad11-5bd8-50ea-9342-3a5d4042082b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186261620} :answer-field/id #uuid "3c52dcf6-c646-5640-b426-05ef9c526397" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186262232}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "ff1c8b22-7226-5d88-9238-4a3a4ca77456" :question/math-academy-id "q-128454" :question/problem "Find $t$ given that the vectors $p=⟨t,t,1⟩,$ $q=⟨3,2,6⟩,$ and $r=⟨3,4,0⟩$ are coplanar." :question/worked-solution "Computing the triple product, we get\n\n$$\n\\begin{aligned}p\\cdot (q\\times r) & =|\\begin{aligned}t & t & 1 \\\\ 3 & 2 & 6 \\\\ 3 & 4 & 0\\end{aligned}| \\\\  & =t\\cdot |\\begin{aligned}2 & 6 \\\\ 4 & 0\\end{aligned}|-t\\cdot |\\begin{aligned}3 & 6 \\\\ 3 & 0\\end{aligned}|+1\\cdot |\\begin{aligned}3 & 2 \\\\ 3 & 4\\end{aligned}| \\\\  & =t(2\\cdot 0-4\\cdot 6)-t(3\\cdot 0-3\\cdot 6)+(3\\cdot 4-3\\cdot 2) \\\\  & =-24t+18t+6 \\\\  & =-6t+6 \\\\  & =6(1-t).\\end{aligned}\n$$\n\n    \n\nThree vectors are coplanar if and only if their triple product is zero:\n\n$$\n\\begin{aligned}p\\cdot (q\\times r) & =0 \\\\ 6(1-t) & =0 \\\\ 1-t & =0 \\\\ t & =1\\end{aligned}\n$$\n\nTherefore, the three vectors are coplanar if and only if $t=1.$"}] [{:db/id #edb/ref 17592186262907 :knowledge-point/_questions [{:db/id #edb/ref 17592186105909 :knowledge-point/id #uuid "57c790ad-c7fb-596c-8b60-cddd9b4e2165" :knowledge-point/title "Calculating the Volume of a Parallelepiped Spanned by Three Position Vectors Given Their Coordinates"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "196c7bb9-2703-5d83-8058-24be71bcb43b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "32" :db/id #edb/ref 17592186260097} {:answer/id #uuid "44662d03-7907-5288-b2f2-17f084b58313" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "22" :db/id #edb/ref 17592186260471} {:answer/id #uuid "5d8121de-a71a-5f79-841e-03f4c4d8f85c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "26" :db/id #edb/ref 17592186260679} {:answer/id #uuid "c69b8832-1644-5736-8a79-f96a8d866802" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "11" :db/id #edb/ref 17592186261625} {:answer/id #uuid "fba18045-5247-5864-b09c-6d2f59aad9bf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "14" :db/id #edb/ref 17592186262075}] :answer-field/correct {:answer/id #uuid "44662d03-7907-5288-b2f2-17f084b58313" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "22" :db/id #edb/ref 17592186260471} :answer-field/id #uuid "00e3b359-0ccd-5626-ac16-03a3053097e9" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186262125}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "1edaed17-510c-5349-a80b-092dc57c864f" :question/math-academy-id "q-128475" :question/problem "Calculate the volume of the parallelepiped spanned by $\\overset{\\to }{AB},$ $\\overset{\\to }{AC}$ and $\\overset{\\to }{AD},$ given the points $A(7,6,4),$ $B(8,5,9),$ $C(7,4,2),$ and $D(5,7,4).$" :question/worked-solution "First, we find the displacement vectors $\\overset{\\to }{AB},$ $\\overset{\\to }{AC},$ and $\\overset{\\to }{AD}$ that span the parallelepiped:\n\n$$\n\\begin{aligned}\\overset{\\to }{AB} & =b-a \\\\  & =(8i+5j+9k)-(7i+6j+4k) \\\\  & =i-j+5k \\\\  & =⟨1,-1,5⟩ \\\\ \\overset{\\to }{AC} & =c-a \\\\  & =(7i+4j+2k)-(7i+6j+4k) \\\\  & =-2j-2k \\\\  & =⟨0,-2,-2⟩ \\\\ \\overset{\\to }{AD} & =d-a \\\\  & =(5i+7j+4k)-(7i+6j+4k) \\\\  & =-2i+j \\\\  & =⟨-2,1,0⟩\\end{aligned}\n$$\n\nNow, to find the volume of the parallelepiped, we need to take the absolute value of the triple product of the above vectors.\n\nComputing the triple product, we have\n\n$$\n\\begin{aligned}\\overset{\\to }{AB}\\cdot (\\overset{\\to }{AC}\\times \\overset{\\to }{AD}) & =|\\begin{aligned}1 & -1 & 5 \\\\ 0 & -2 & -2 \\\\ -2 & 1 & 0\\end{aligned}| \\\\  & =1\\cdot |\\begin{aligned}-2 & -2 \\\\ 1 & 0\\end{aligned}|-(-1)\\cdot |\\begin{aligned}0 & -2 \\\\ -2 & 0\\end{aligned}|+5\\cdot |\\begin{aligned}0 & -2 \\\\ -2 & 1\\end{aligned}| \\\\  & =((-2)\\cdot 0-1\\cdot (-2))+(0\\cdot 0-(-2)\\cdot (-2))+5(0\\cdot 1-(-2)\\cdot (-2)) \\\\  & =2-4-20 \\\\  & =-22.\\end{aligned}\n$$\n\nTherefore, the volume of the corresponding parallelepiped spanned by $\\overset{\\to }{AB},$ $\\overset{\\to }{AC},$ and $\\overset{\\to }{AD}$ is\n\n$$\nV=|-22|=22.\n$$"}] [{:db/id #edb/ref 17592186400345 :knowledge-point/_questions [{:db/id #edb/ref 17592186059848 :knowledge-point/id #uuid "32df8909-a239-5167-b8ea-412f7cdaea93" :knowledge-point/title "Identifying Singular Matrices"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "cb84a0af-37c3-5e79-8fbe-6fd632ddb2cc" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186400347} {:answer/id #uuid "b60f5982-25f6-5113-a631-31fd99ad2f88" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "None of the given statements are true" :db/id #edb/ref 17592186400348} {:answer/id #uuid "fb9065e0-e068-5eb5-b990-475fc14cbafa" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186400349} {:answer/id #uuid "bd0c4e4c-9e20-52e5-834a-7448ac684aba" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186400350} {:answer/id #uuid "1cba16a2-864c-5c7f-8ff6-84d5ef21e54e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186400351}] :answer-field/correct {:answer/id #uuid "1cba16a2-864c-5c7f-8ff6-84d5ef21e54e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186400351} :answer-field/id #uuid "2b0b1a47-2ce3-5fbf-9d46-ef1b2e6548de" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186400346}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "af5c321a-ef93-52c0-aab1-818de4211e7b" :question/math-academy-id "q-128478" :question/problem "Which of the following statements are true regarding the matrix $F$ given below?\n\nI. $det(F)=-7$\nII. $F$ is **not** a singular matrix\nIII. $det(F)=-2$\n\n$$\nF=[\\begin{aligned}2 & 8 & 3 \\\\ -1 & 2 & 1 \\\\ 5 & 3 & 1\\end{aligned}]\n$$" :question/worked-solution "Remember that a square matrix is singular if its determinant is equal to $0.$\n\nUsing the formula, we take the alternating sum of the entries in the top row of the matrix, multiplied by their respective minors, as follows:\n\n$$\n\\begin{aligned}det(F) & =|\\begin{aligned}2 & 8 & 3 \\\\ -1 & 2 & 1 \\\\ 5 & 3 & 1\\end{aligned}| \\\\  & =2|\\begin{aligned}2 & 1 \\\\ 3 & 1\\end{aligned}|-8|\\begin{aligned}-1 & 1 \\\\ 5 & 1\\end{aligned}|+3|\\begin{aligned}-1 & 2 \\\\ 5 & 3\\end{aligned}| \\\\  & =2(2-3)-8(-1-5)+3(-3-10) \\\\  & =2\\cdot (-1)-8\\cdot (-6)+3\\cdot (-13) \\\\  & =-2+48-39 \\\\  & =7\\end{aligned}\n$$\n\nSince $det(F)=7$, the matrix is **not** singular. \n\nTherefore, only statement II is true."}] [{:db/id #edb/ref 17592186400352 :knowledge-point/_questions [{:db/id #edb/ref 17592186059848 :knowledge-point/id #uuid "32df8909-a239-5167-b8ea-412f7cdaea93" :knowledge-point/title "Identifying Singular Matrices"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4ffbd8f5-0ee6-5cad-88b8-2877cefd01dc" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186400354} {:answer/id #uuid "6c4b7403-5eeb-50d7-a4bd-09fe3acc71a2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186400355} {:answer/id #uuid "21613f83-4258-54f4-a9b2-387b0255c0f6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186400356} {:answer/id #uuid "1db912cd-3357-5080-a6af-3948ea9b0a17" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186400357} {:answer/id #uuid "ee547a84-a761-5ce9-84b8-e2abf25059e2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186400358}] :answer-field/correct {:answer/id #uuid "4ffbd8f5-0ee6-5cad-88b8-2877cefd01dc" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186400354} :answer-field/id #uuid "2c8cea4c-0392-5f09-b624-e7c6aa7142b0" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186400353}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "04472571-0a00-5fac-9502-9b8f8afd8c8a" :question/math-academy-id "q-128480" :question/problem "Which of the following statements are true regarding the matrix $D$ given below?\n\nI. $D$ is a singular matrix\nII. $det(D)=1$\nIII. $det(D)=0$\n\n$$\nD=[\\begin{aligned}2 & -3 & 1 \\\\ -1 & 2 & 3 \\\\ -3 & 5 & 2\\end{aligned}]\n$$" :question/worked-solution "Remember that a square matrix is singular if its determinant is equal to $0.$\n\nUsing the formula, we take the alternating sum of the entries in the top row of the matrix, multiplied by their respective minors, as follows:\n\n$$\n\\begin{aligned}det(D) & =|\\begin{aligned}2 & -3 & 1 \\\\ -1 & 2 & 3 \\\\ -3 & 5 & 2\\end{aligned}| \\\\  & =2|\\begin{aligned}2 & 3 \\\\ 5 & 2\\end{aligned}|+3|\\begin{aligned}-1 & 3 \\\\ -3 & 2\\end{aligned}|+1|\\begin{aligned}-1 & 2 \\\\ -3 & 5\\end{aligned}| \\\\  & =2(4-15)+3(-2+9)+1(-5+6) \\\\  & =2\\cdot (-11)+3\\cdot 7+1\\cdot 1 \\\\  & =-22+21+1 \\\\  & =0\\end{aligned}\n$$\n\n \n\nSince $det(D)=0$, the matrix is singular. \n\nTherefore, only statements I and III are true."}] [{:db/id #edb/ref 17592186262912 :knowledge-point/_questions [{:db/id #edb/ref 17592186105909 :knowledge-point/id #uuid "57c790ad-c7fb-596c-8b60-cddd9b4e2165" :knowledge-point/title "Calculating the Volume of a Parallelepiped Spanned by Three Position Vectors Given Their Coordinates"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2758af71-201a-5743-a5ec-86afd2e415e2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "12" :db/id #edb/ref 17592186260219} {:answer/id #uuid "2d261462-d03d-544c-a8a9-5aadec24e0f3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186260283} {:answer/id #uuid "329c90d2-6fee-5509-8239-ab93f795292c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "15" :db/id #edb/ref 17592186260332} {:answer/id #uuid "7f3acf1f-c9af-515f-b70d-f86b50febc38" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "14" :db/id #edb/ref 17592186260981} {:answer/id #uuid "ebd8e8e6-f4f4-53d7-b173-9afee1bb078b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "10" :db/id #edb/ref 17592186261944}] :answer-field/correct {:answer/id #uuid "ebd8e8e6-f4f4-53d7-b173-9afee1bb078b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "10" :db/id #edb/ref 17592186261944} :answer-field/id #uuid "e4794f4f-7acb-5b9b-a59f-bc47efacaf2d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186262529}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "86e3bae5-31f6-5b6c-93f8-27d7bdeaa8bf" :question/math-academy-id "q-128483" :question/problem "Calculate the volume of the parallelepiped spanned by $\\overset{\\to }{AB},$ $\\overset{\\to }{AC}$ and $\\overset{\\to }{AD},$ given the points $A(5,1,4),$ $B(4,1,7),$ $C(3,1,5),$ and $D(2,3,3).$" :question/worked-solution "First, we find the displacement vectors $\\overset{\\to }{AB},$ $\\overset{\\to }{AC},$ and $\\overset{\\to }{AD}$ that span the parallelepiped:\n\n$$\n\\begin{aligned}\\overset{\\to }{AB} & =b-a \\\\  & =(4i+j+7k)-(5i+j+4k) \\\\  & =-i+3k \\\\  & =⟨-1,0,3⟩ \\\\ \\overset{\\to }{AC} & =c-a \\\\  & =(3i+j+5k)-(5i+j+4k) \\\\  & =-2i+k \\\\  & =⟨-2,0,1⟩ \\\\ \\overset{\\to }{AD} & =d-a \\\\  & =(2i+3j+3k)-(5i+j+4k) \\\\  & =-3i+2j-k \\\\  & =⟨-3,2,-1⟩\\end{aligned}\n$$\n\nNow, to find the volume of the parallelepiped, we need to take the absolute value of the triple product of the above vectors.\n\nComputing the triple product, we have\n\n$$\n\\begin{aligned}\\overset{\\to }{AB}\\cdot (\\overset{\\to }{AC}\\times \\overset{\\to }{AD}) & =|\\begin{aligned}-1 & 0 & 3 \\\\ -2 & 0 & 1 \\\\ -3 & 2 & -1\\end{aligned}| \\\\  & =(-1)\\cdot |\\begin{aligned}0 & 1 \\\\ 2 & -1\\end{aligned}|-0\\cdot |\\begin{aligned}-2 & 1 \\\\ -3 & -1\\end{aligned}|+3\\cdot |\\begin{aligned}-2 & 0 \\\\ -3 & 2\\end{aligned}| \\\\  & =-(0\\cdot (-1)-2\\cdot 1)-0+3((-2)\\cdot 2-(-3)\\cdot 0) \\\\  & =2-12 \\\\  & =-10.\\end{aligned}\n$$\n\nTherefore, the volume of the corresponding parallelepiped spanned by $\\overset{\\to }{AB},$ $\\overset{\\to }{AC},$ and $\\overset{\\to }{AD}$ is\n\n$$\nV=|-10|=10.\n$$"}] [{:db/id #edb/ref 17592186400359 :knowledge-point/_questions [{:db/id #edb/ref 17592186059848 :knowledge-point/id #uuid "32df8909-a239-5167-b8ea-412f7cdaea93" :knowledge-point/title "Identifying Singular Matrices"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f0d86b56-15a8-5ce5-87a3-79892a8fcb59" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186400361} {:answer/id #uuid "72d6cc07-52e5-5150-a7c0-2f37168a2e72" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186400362} {:answer/id #uuid "c359f024-e80b-583a-9ec0-eb3841869630" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186400363} {:answer/id #uuid "ad585491-6925-5efe-a231-7cc8caa22373" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186400364} {:answer/id #uuid "ffccfcfd-c978-5441-bcf2-9a8dfaace8a6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186400365}] :answer-field/correct {:answer/id #uuid "ffccfcfd-c978-5441-bcf2-9a8dfaace8a6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186400365} :answer-field/id #uuid "f4cb87f6-39a9-56d2-9818-a6028ef6c858" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186400360}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "5bcc7af8-2cd5-53ed-a962-12d9bd009077" :question/math-academy-id "q-128491" :question/problem "Which of the following statements are true regarding the matrix $S$ given below?\n\nI. $S$ is a singular matrix\nII. $S$ is **not** a singular matrix\nIII. $det(S)=5+2\\sqrt{7}$\n\n$$\nS=[\\begin{aligned}2\\sqrt{7} & 0 & \\frac{1}{2} \\\\ -\\sqrt{7} & 2 & 0 \\\\ 5 & 0 & \\sqrt{7}\\end{aligned}]\n$$" :question/worked-solution "Remember that a square matrix is singular if its determinant is equal to $0.$\n\nUsing the formula, we take the alternating sum of the entries in the top row of the matrix, multiplied by their respective minors, as follows:\n\n$$\n\\begin{aligned}det(S) & =|\\begin{aligned}2\\sqrt{7} & 0 & \\frac{1}{2} \\\\ -\\sqrt{7} & 2 & 0 \\\\ 5 & 0 & \\sqrt{7}\\end{aligned}| \\\\  & =2\\sqrt{7}|\\begin{aligned}2 & 0 \\\\ 0 & \\sqrt{7}\\end{aligned}|-0|\\begin{aligned}-\\sqrt{7} & 0 \\\\ 5 & \\sqrt{7}\\end{aligned}|+\\frac{1}{2}|\\begin{aligned}-\\sqrt{7} & 2 \\\\ 5 & 0\\end{aligned}| \\\\  & =2\\sqrt{7}(2\\sqrt{7}-0)-0+\\frac{1}{2}(0-10) \\\\  & =2\\sqrt{7}\\cdot 2\\sqrt{7}+\\frac{1}{2}\\cdot (-10) \\\\  & =28-5 \\\\  & =23\\end{aligned}\n$$\n\nSince $det(S)=23\\ne 0$, the matrix is **not ** singular. \n\nTherefore, only statement II is true."}]}
