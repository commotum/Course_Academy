#{[{:db/id #edb/ref 17592186390360 :knowledge-point/_questions [{:db/id #edb/ref 17592186059736 :knowledge-point/id #uuid "733eab11-2a26-5402-8df5-bba50c9beaf9" :knowledge-point/title "Calculating the Cross Product Using Determinants"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "52a2ecca-4420-5a73-85e5-d8fd94cb2fdf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨-15,5,3⟩" :db/id #edb/ref 17592186390362} {:answer/id #uuid "37f1f0b7-f7d0-59d9-b906-b1e9b3bc1438" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨-15,3,5⟩" :db/id #edb/ref 17592186390363} {:answer/id #uuid "1b801238-dd43-58b7-a037-5fb7adad9f3a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨-3,-15,5⟩" :db/id #edb/ref 17592186390364} {:answer/id #uuid "b9a830dc-88d1-5eec-a445-b8adc0a5469e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨15,5,3⟩" :db/id #edb/ref 17592186390365} {:answer/id #uuid "3abd8bb4-bf5c-5575-bf37-b9815f3df034" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨3,5,12⟩" :db/id #edb/ref 17592186390366}] :answer-field/correct {:answer/id #uuid "37f1f0b7-f7d0-59d9-b906-b1e9b3bc1438" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨-15,3,5⟩" :db/id #edb/ref 17592186390363} :answer-field/id #uuid "9ba37642-671c-52eb-9ccf-cac56d58f19b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186390361}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "765f0999-da93-5e44-b207-672576084830" :question/math-academy-id "q-19779" :question/problem "Let $a=⟨1,0,3⟩$ and $b=⟨2,5,3⟩.$ Find $a\\times b.$" :question/worked-solution "Using the determinant formula, we get\n\n$$\n\\begin{aligned}a\\times b & =|\\begin{aligned}i & j & k \\\\ 1 & 0 & 3 \\\\ 2 & 5 & 3\\end{aligned}| \\\\  & =|\\begin{aligned}0 & 3 \\\\ 5 & 3\\end{aligned}|i-|\\begin{aligned}1 & 3 \\\\ 2 & 3\\end{aligned}|j+|\\begin{aligned}1 & 0 \\\\ 2 & 5\\end{aligned}|k \\\\  & =(0\\cdot 3-3\\cdot 5)i-(1\\cdot 3-2\\cdot 3)j+(1\\cdot 5-2\\cdot 0)k \\\\  & =(0-15)i-(3-6)j+(5-0)k \\\\  & =⟨-15,3,5⟩.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186233619 :knowledge-point/_questions [{:db/id #edb/ref 17592186179660 :knowledge-point/id #uuid "644b7f09-7f66-50f2-8eba-ef6e009429d0" :knowledge-point/title "Simplifying a Variable Expression Containing a Quotient With Many Factorials"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "22766496-0abf-50a1-80d1-5c3aa17a5c49" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(n-8)(n+8)(n+9)" :db/id #edb/ref 17592186285095} {:answer/id #uuid "2decc5e8-9169-5cef-a48f-c52612fb5bb9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(n+8)(n+9)" :db/id #edb/ref 17592186285195} {:answer/id #uuid "68bba672-b656-58bd-ab7d-b6d8e1d686e5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(n+7)(n+8)(n+9)" :db/id #edb/ref 17592186285750} {:answer/id #uuid "96c58f78-9e89-5c29-947e-3e0a3eea9a98" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{(n+8)(n+9)}{n-9}" :db/id #edb/ref 17592186286158} {:answer/id #uuid "bd10a16d-830d-53c9-ba1c-682004537a80" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{n+9}{n-9}" :db/id #edb/ref 17592186286513}] :answer-field/correct {:answer/id #uuid "22766496-0abf-50a1-80d1-5c3aa17a5c49" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(n-8)(n+8)(n+9)" :db/id #edb/ref 17592186285095} :answer-field/id #uuid "12acb7ca-836f-551c-8db4-207dc9c189b1" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186287179}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "f3ef0665-6f2a-5dd9-af17-7da892c3b332" :question/math-academy-id "q-19882" :question/problem "Given that $n\\ge 9$ is an integer, simplify $\\frac{(n-8)!\\,(n+9)!}{(n-9)!\\,(n+7)!}.$" :question/worked-solution "First, we notice that\n\n$$\n\\begin{aligned}(n+9)! & =(n+9)(n+8)(n+7)! \\\\ (n-8)! & =(n-8)(n-9)!\\end{aligned}\n$$\n\nThen, we can cancel the $(n+7)!$ and $(n-9)!$ that occur in both the numerator and the denominator:\n\n$$\n\\begin{aligned}\\frac{(n-8)!\\,(n+9)!}{(n-9)!\\,(n+7)!} & =\\frac{[(n-8)\\cdot (n-9)!]\\cdot [(n+9)\\cdot (n+8)\\cdot (n+7)!]}{(n-9)!\\cdot (n+7)!} \\\\  & =\\frac{(n-8)\\cdot \\cancel{(n-9)!}\\cdot (n+9)\\cdot (n+8)\\cdot \\cancel{(n+7)!}}{\\cancel{(n-9)!}\\cdot \\cancel{(n+7)!}} \\\\  & =(n-8)\\cdot (n+8)\\cdot (n+9) \\\\  & =(n-8)(n+8)(n+9)\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186287964 :knowledge-point/_questions [{:db/id #edb/ref 17592186179660 :knowledge-point/id #uuid "644b7f09-7f66-50f2-8eba-ef6e009429d0" :knowledge-point/title "Simplifying a Variable Expression Containing a Quotient With Many Factorials"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0cdf387f-3a0b-57c6-89ff-676228ded636" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2m}{m+5}" :db/id #edb/ref 17592186284894} {:answer/id #uuid "1b734ea2-a219-577a-8568-20df8a2e2919" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{m+5}" :db/id #edb/ref 17592186285031} {:answer/id #uuid "1e6ad601-4800-552a-b12e-a5b40856f5ab" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2m}{m+4}" :db/id #edb/ref 17592186285058} {:answer/id #uuid "4334150f-17b3-522c-8a54-1ba9d10b279e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2m" :db/id #edb/ref 17592186285408} {:answer/id #uuid "c780a0ee-f288-5cb4-974a-df2c2b28d6ed" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{m}{m+4}" :db/id #edb/ref 17592186286616}] :answer-field/correct {:answer/id #uuid "0cdf387f-3a0b-57c6-89ff-676228ded636" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2m}{m+5}" :db/id #edb/ref 17592186284894} :answer-field/id #uuid "30b22a75-1b58-5fe1-bc2a-8eed1972c5c4" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186287251}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "ae781a4d-b2cf-5568-b0a5-f23d5dc664e6" :question/math-academy-id "q-19887" :question/problem "Given that $m\\ge 1$ is an integer, simplify $\\frac{(2m)!\\,(m+4)!}{(m+5)!\\,(2m-1)!}.$" :question/worked-solution "First, we notice that\n\n$$\n\\begin{aligned}(m+5)! & =(m+5)(m+4)! \\\\ 2m! & =2m(2m-1)!\\end{aligned}\n$$\n\nThen, we can cancel the $(m+4)!$ and $(2m-1)!$ that occur in both the numerator and the denominator:\n\n$$\n\\begin{aligned}\\frac{(2m)!\\,(m+4)!}{(m+5)!\\,(2m-1)!} & =\\frac{(2m)\\,\\cdot (2m-1)!\\cdot (m+4)!}{(m+5)\\cdot (m+4)!\\cdot (2m-1)!} \\\\  & =\\frac{(2m)\\,\\cdot \\cancel{(2m-1)!}\\cdot \\cancel{(m+4)!}}{(m+5)\\cdot \\cancel{(m+4)!}\\cdot \\cancel{(2m-1)!}} \\\\  & =\\frac{2m}{m+5}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186287965 :knowledge-point/_questions [{:db/id #edb/ref 17592186083220 :knowledge-point/id #uuid "e49e2595-62a1-595a-8df9-99541bccbdf5" :knowledge-point/title "Calculating Permutations"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "110abfe8-256f-586f-8c14-cdbacbf98aa0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "48" :db/id #edb/ref 17592186284936} {:answer/id #uuid "6a8cbe92-7d56-57d4-ac77-8dcc36070b12" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "24" :db/id #edb/ref 17592186285763} {:answer/id #uuid "75559a19-2283-512d-bed1-5bd115893a57" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "12" :db/id #edb/ref 17592186285871} {:answer/id #uuid "7c34d0e6-2814-5d2f-be61-88b870668d34" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186285933} {:answer/id #uuid "a1f7b5bb-d5a9-5ca5-9642-1dbe2e08c1b8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186286271}] :answer-field/correct {:answer/id #uuid "a1f7b5bb-d5a9-5ca5-9642-1dbe2e08c1b8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186286271} :answer-field/id #uuid "29d5b268-f0c4-5b8e-8047-2fa1728600f0" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186287239}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "b4641263-8717-5c07-a2d0-51003a352849" :question/math-academy-id "q-19899" :question/problem "Michael goes to a restaurant and orders a sandwich, a salad, and a muffin. In how many different orders can he decide to eat his food?" :question/worked-solution "There are $3$ foods, so there are $3!$ ways of ordering them:\n\n$$\n\\begin{aligned}3! & =3\\times 2\\times 1 \\\\  & =6.\\end{aligned}\n$$\n\nTherefore, there are 6 possible arrangements."}] [{:db/id #edb/ref 17592186106124 :knowledge-point/_questions [{:db/id #edb/ref 17592186105734 :knowledge-point/id #uuid "9331987e-8676-5bdb-b4ce-2129b1b09a8c" :knowledge-point/title "Calculating the Altitude of a Triangle Given Its Vertices"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3b1cac9a-d8ad-501d-b0a6-a0a1bebe9636" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2\\sqrt{6}}{3}" :db/id #edb/ref 17592186285345} {:answer/id #uuid "3cf88e45-9bac-51c6-a90f-f80f508a8095" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{6}}{3}" :db/id #edb/ref 17592186285363} {:answer/id #uuid "46574c64-b2d9-52a5-ba20-5c4e8f687459" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2\\sqrt{3}}{3}" :db/id #edb/ref 17592186285432} {:answer/id #uuid "61a98581-4f83-59f8-a0f9-f6ec11524a8d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2\\sqrt{2}}{3}" :db/id #edb/ref 17592186285684} {:answer/id #uuid "6cd903e1-1e62-5f4c-86df-6c375dc3361d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3\\sqrt{6}}{2}" :db/id #edb/ref 17592186285787}] :answer-field/correct {:answer/id #uuid "3b1cac9a-d8ad-501d-b0a6-a0a1bebe9636" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2\\sqrt{6}}{3}" :db/id #edb/ref 17592186285345} :answer-field/id #uuid "c5b8bbd2-699b-5127-b6f0-02f2e8c72c29" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186287551}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "95f6f3a1-caa9-5902-b6fb-cb14398f3fb9" :question/math-academy-id "q-20027" :question/problem "Calculate the length of the altitude $CH$ of the $△\\,ABC$, if $A(2,1,2)$, $B(1,2,1)$, $C(3,2,3).$" :question/requires-calculator true :question/worked-solution "Note that the length of the altitude $CH$ can be related to the area of $△\\,ABC$ as follows:\n\n$$\n{A}_{△}=\\frac{1}{2}CH\\cdot AB\n$$\n\nSo, to find $CH,$ we first find ${A}_{△}.$ To start, we find the vectors $\\overset{\\to }{AB}$ and $\\overset{\\to }{AC}:$\n\n$$\n\\begin{aligned}\\overset{\\to }{AB} & =b-a \\\\  & =(i+2j+k)-(2i+j+2k) \\\\  & =-i+j-k \\\\  & =⟨-1,1,-1⟩ \\\\ \\overset{\\to }{AC} & =c-a \\\\  & =(3i+2j+3k)-(2i+j+2k) \\\\  & =i+j+k \\\\  & =⟨1,1,1⟩\\end{aligned}\n$$\n\nNow, we have\n\n$$\n\\begin{aligned}\\overset{\\to }{AB}\\times \\overset{\\to }{AC} & =|\\begin{aligned}i & j & k \\\\ -1 & 1 & -1 \\\\ 1 & 1 & 1\\end{aligned}| \\\\  & =|\\begin{aligned}1 & -1 \\\\ 1 & 1\\end{aligned}|i-|\\begin{aligned}-1 & -1 \\\\ 1 & 1\\end{aligned}|j+|\\begin{aligned}-1 & 1 \\\\ 1 & 1\\end{aligned}|k \\\\  & =(1\\cdot 1-1\\cdot (-1))i-((-1)\\cdot 1-1\\cdot (-1))j+((-1)\\cdot 1-1\\cdot 1)k \\\\  & =2i-2k \\\\  & =⟨2,0,-2⟩.\\end{aligned}\n$$\n\nTherefore, the area of the parallelogram spanned by $\\overset{\\to }{AB}$ and $\\overset{\\to }{AC}$ is\n\n$$\n\\begin{aligned}A & =|\\overset{\\to }{AB}\\times \\overset{\\to }{AC}| \\\\  & =\\sqrt{{2}^{2}+{0}^{2}+(-2)^{2}} \\\\  & =\\sqrt{8} \\\\  & =2\\sqrt{2}.\\end{aligned}\n$$\n\nThe area of the triangle is half of the area of the respective parallelogram. So, the area of $△\\,ABC$ is\n\n$$\n{A}_{△}=\\frac{1}{2}A=\\frac{2\\sqrt{2}}{2}=\\sqrt{2}.\n$$\n\nLet's also compute $AB$ since it appears in the formula:\n\n$$\n\\begin{aligned}AB & =|\\overset{\\to }{AB}| \\\\  & =\\sqrt{(-1)^{2}+{1}^{2}+(-1)^{2}} \\\\  & =\\sqrt{3}.\\end{aligned}\n$$\n\n \n\nFinally, using the formula ${A}_{△}=\\frac{1}{2}CH\\cdot AB,$ we get\n\n$$\n\\begin{aligned}{A}_{△} & =\\frac{1}{2}CH\\cdot AB \\\\ \\sqrt{2} & =\\frac{1}{2}CH\\cdot \\sqrt{3} \\\\ 2\\sqrt{2} & =CH\\cdot \\sqrt{3} \\\\ CH & =\\frac{2\\sqrt{2}}{\\sqrt{3}} \\\\ CH & =\\frac{2\\sqrt{6}}{3}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186287973 :knowledge-point/_questions [{:db/id #edb/ref 17592186105736 :knowledge-point/id #uuid "ff317cd2-0896-5134-b3a3-4e9f84e22b68" :knowledge-point/title "Calculating the Scalar Triple Product Using a Determinant"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "300c21b4-1756-505c-8887-69d902ae3677" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186285224} {:answer/id #uuid "8ae0a167-e7b0-520f-9327-565bd22dde8c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186286063} {:answer/id #uuid "b624085b-014c-5e50-8b4b-f36fd36a52f4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186286450} {:answer/id #uuid "c2e671b4-92f5-5e79-bde0-a4e9c92974ce" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-12" :db/id #edb/ref 17592186286575} {:answer/id #uuid "fb65991f-7c1a-5dcd-bc51-9c721902f012" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186287082}] :answer-field/correct {:answer/id #uuid "b624085b-014c-5e50-8b4b-f36fd36a52f4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186286450} :answer-field/id #uuid "43229f82-3e46-5de5-bed3-19f2997ba66e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186287295}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "5d05a20b-4c69-5e8d-bc26-f4e99fd04a4c" :question/math-academy-id "q-20054" :question/problem "Let $a=⟨1,-1,2⟩$, $b=⟨2,0,3⟩$ and $c=⟨2,4,2⟩.$ Find $a\\cdot (b\\times c).$" :question/worked-solution "Remember that the scalar triple product $a\\cdot (b\\times c)$ is just the determinant of the matrix whose rows are given by $a,$ $b,$ and $c.$\n\nSo, we have\n\n$$\n\\begin{aligned}a\\cdot (b\\times c) & =|\\begin{aligned}1 & -1 & 2 \\\\ 2 & 0 & 3 \\\\ 2 & 4 & 2\\end{aligned}| \\\\  & =1\\cdot |\\begin{aligned}0 & 3 \\\\ 4 & 2\\end{aligned}|-(-1)\\cdot |\\begin{aligned}2 & 3 \\\\ 2 & 2\\end{aligned}|+2\\cdot |\\begin{aligned}2 & 0 \\\\ 2 & 4\\end{aligned}| \\\\  & =(0\\cdot 2-4\\cdot 3)+(2\\cdot 2-2\\cdot 3)+2(2\\cdot 4-2\\cdot 0) \\\\  & =-12-2+16 \\\\  & =2.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186287975 :knowledge-point/_questions [{:db/id #edb/ref 17592186105737 :knowledge-point/id #uuid "3e0b4d33-7699-5068-90f1-663534cd662d" :knowledge-point/title "Calculating Scalar Triple Products Using Its Properties"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "343abe13-b014-58c0-913d-2fc9f7a11d8e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186285270} {:answer/id #uuid "4c3b1e45-a9c8-5b28-b558-ec4bc793eb4e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\sqrt{2}" :db/id #edb/ref 17592186285496} {:answer/id #uuid "a878dcad-4ddf-585b-a29e-6f1bfa1aa273" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3\\sqrt{2}" :db/id #edb/ref 17592186286324} {:answer/id #uuid "c9e6bcc3-f1d7-59c6-953b-c03961aeaf47" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{2}" :db/id #edb/ref 17592186286630} {:answer/id #uuid "fbedc400-7438-5567-8dfa-d1cfcb39be79" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186287087}] :answer-field/correct {:answer/id #uuid "fbedc400-7438-5567-8dfa-d1cfcb39be79" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186287087} :answer-field/id #uuid "42a770db-2d9f-5df9-858e-0db4cb77fe94" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186287293}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "ae812812-92a4-5aa7-85f9-50adcd0043cf" :question/math-academy-id "q-20059" :question/problem "Find $c\\cdot (a\\times b)$, if $3a\\cdot (\\sqrt{2}b\\times 3c)=18\\sqrt{2}.$" :question/worked-solution "First, we factor out the constants and get\n\n$$\n\\begin{aligned}3a\\cdot (\\sqrt{2}b\\times 3c) & =18\\sqrt{2} \\\\ 3\\cdot \\sqrt{2}\\cdot 3\\cdot [a\\cdot (b\\times c)] & =18\\sqrt{2} \\\\ a\\cdot (b\\times c) & =2.\\end{aligned}\n$$\n\nThen, we swap $c$ and $b$ to get\n\n$$\n\\begin{aligned}a\\cdot (c\\times b) & =-2,\\end{aligned}\n$$\n\nand again we swap $c$ and $a$ to get\n\n$$\n\\begin{aligned}c\\cdot (a\\times b) & =2.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186287976 :knowledge-point/_questions [{:db/id #edb/ref 17592186105737 :knowledge-point/id #uuid "3e0b4d33-7699-5068-90f1-663534cd662d" :knowledge-point/title "Calculating Scalar Triple Products Using Its Properties"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2871030f-535f-5bad-960f-2518315ab868" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186285139} {:answer/id #uuid "395873e5-15bd-53dd-8303-0a9cb00704ce" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186285327} {:answer/id #uuid "4c9995e8-b44e-5b2b-a77c-68b604f74177" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "18" :db/id #edb/ref 17592186285501} {:answer/id #uuid "c2f44045-fc84-58ca-8c0c-ea930c16cece" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-5" :db/id #edb/ref 17592186286576} {:answer/id #uuid "dc4e1f02-b381-51f4-825c-11efa8be82bc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186286791}] :answer-field/correct {:answer/id #uuid "c2f44045-fc84-58ca-8c0c-ea930c16cece" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-5" :db/id #edb/ref 17592186286576} :answer-field/id #uuid "e0ca935c-f519-5702-93c9-2f479ee86077" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186287606}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "2054ccd0-385b-55a1-9e4b-6c29d327d7d8" :question/math-academy-id "q-20061" :question/problem "Find $c\\cdot (b\\times a)$, if $3a\\cdot (6b\\times c)=90.$" :question/worked-solution "First, we factor out the constants and get\n\n$$\n\\begin{aligned}3a\\cdot (6b\\times c) & =90 \\\\ 3\\cdot 6\\cdot [a\\cdot (b\\times c)] & =90 \\\\ a\\cdot (b\\times c) & =5.\\end{aligned}\n$$\n\nThen, we swap $a$ and $c$ to get\n\n$$\n\\begin{aligned}c\\cdot (b\\times a) & =-5.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186287980 :knowledge-point/_questions [{:db/id #edb/ref 17592186092165 :knowledge-point/id #uuid "26666440-d376-5cb6-b922-9850e5c42eb3" :knowledge-point/title "Solving a Trigonometric Equation Involving Cosine Under a Modified Domain"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "471b8112-fe03-5559-8fd9-7d262e3aacb2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{{\\pi }^{2}}{16}" :db/id #edb/ref 17592186285445} {:answer/id #uuid "51beac23-bf68-50c9-952d-653cee2aa6dc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{25{\\pi }^{2}}{36}" :db/id #edb/ref 17592186285540} {:answer/id #uuid "71ac35f1-a93a-56ba-81c5-2d2d400444ea" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{5{\\pi }^{2}}{36}" :db/id #edb/ref 17592186285834} {:answer/id #uuid "82f17c2a-2ee4-5365-bf0f-241c55acae58" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{{\\pi }^{2}}{36}" :db/id #edb/ref 17592186285989} {:answer/id #uuid "aa74e9c4-0cc5-5f42-a6c7-ce6192d80edf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{4{\\pi }^{2}}{9}" :db/id #edb/ref 17592186286341}] :answer-field/correct {:answer/id #uuid "51beac23-bf68-50c9-952d-653cee2aa6dc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{25{\\pi }^{2}}{36}" :db/id #edb/ref 17592186285540} :answer-field/id #uuid "8be7a502-2728-5180-92ba-ee5a5a51b7d0" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186287439}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "fe360508-b564-5f2e-8656-ff74569f459b" :question/math-academy-id "q-20214" :question/problem "Given that ${x}_{1}$ and ${x}_{2}$ are the solutions of the equation $2\\sqrt{3}\\operatorname{cos}⁡x+3=0$ for $-\\pi <x\\le \\pi ,$ what is the value of ${x}_{1}\\cdot {x}_{2}?$" :question/worked-solution "First, we rearrange the equation, isolating $\\operatorname{cos}⁡x:$\n\n$$\n\\begin{aligned}2\\sqrt{3}\\operatorname{cos}⁡x+3 & =0 \\\\ 2\\sqrt{3}\\operatorname{cos}⁡x & =-3 \\\\ \\operatorname{cos}⁡x & =-\\frac{3}{2\\sqrt{3}} \\\\ \\operatorname{cos}⁡x & =-\\frac{\\sqrt{3}}{2}\\end{aligned}\n$$\n\nNow, we find the principal value:\n\n$$\n\\begin{aligned}x=\\operatorname{arccos}⁡(-\\frac{\\sqrt{3}}{2})=\\frac{5\\pi }{6}\\end{aligned}\n$$\n\nSince $\\frac{5\\pi }{6}$ lies inside the required domain, our first solution is ${x}_{1}=\\frac{5\\pi }{6}.$\n\nOur first solution lies in the second quadrant and has a reference angle of ${\\theta }_{R}=\\frac{\\pi }{6}.$ Since $\\operatorname{cos}⁡x<0,$ the second solution must lie in the third quadrant, and it also has a reference angle ${\\theta }_{R}=\\frac{\\pi }{6}.$\n\n![](images/6b/6bc5aed39e6421b8ff2416edb75dc888c8f38ae14f99b3d6e28d8e4c9302908f.png)\n\nA second solution $X$ lies in the $3$rd quadrant, and we can find it using the reference angle, as follows:\n\n$$\n\\begin{aligned}X & =\\pi +{\\theta }_{R} \\\\  & =\\pi +\\frac{\\pi }{6} \\\\  & =\\frac{7\\pi }{6}\\end{aligned}\n$$\n\nHowever, this value is not in the required domain. To get a second solution that's within the required domain, we simply subtract $2\\pi $ from $X:$\n\n$$\n\\begin{aligned}{x}_{2} & =X-2\\pi  \\\\  & =\\frac{7\\pi }{6}-2\\pi  \\\\  & =-\\frac{5\\pi }{6}\\end{aligned}\n$$\n\nSo, the solutions are $x=\\pm \\frac{5\\pi }{6}.$\n\nFinally,\n\n$$\n{x}_{1}{x}_{2}=\\frac{5\\pi }{6}\\cdot (-\\frac{5\\pi }{6})=-\\frac{25{\\pi }^{2}}{36}.\n$$"}] [{:db/id #edb/ref 17592186287987 :knowledge-point/_questions [{:db/id #edb/ref 17592186064179 :knowledge-point/id #uuid "e617f241-254b-5f70-9937-5883b6f28c4f" :knowledge-point/title "Integrating Secant-Tangent and Cosecant-Cotangent"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "16d4843e-1503-5b14-9ef4-6d9bd866b768" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "sec⁡\\theta +C" :db/id #edb/ref 17592186284994} {:answer/id #uuid "5f513476-ecb1-5481-9bb0-8cd729eba6f2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "csc⁡xcot⁡x+C" :db/id #edb/ref 17592186285660} {:answer/id #uuid "c159be5b-9ba9-50ec-90b5-6beba2ba516f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "csc⁡\\theta +C" :db/id #edb/ref 17592186286558} {:answer/id #uuid "dbdb10ca-14c4-5f21-a345-f92c3250e22c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-sec⁡\\theta +C" :db/id #edb/ref 17592186286788} {:answer/id #uuid "f5a909e4-a442-5f93-bb1c-8af5b5eeb86f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-csc⁡\\theta +C" :db/id #edb/ref 17592186287037}] :answer-field/correct {:answer/id #uuid "dbdb10ca-14c4-5f21-a345-f92c3250e22c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-sec⁡\\theta +C" :db/id #edb/ref 17592186286788} :answer-field/id #uuid "f5759735-03db-58c8-afc1-42a56314fd9a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186287647}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "8eefdd68-c49a-5b6b-9578-f46e438f3aac" :question/math-academy-id "q-2038" :question/problem "$\\int (-sec⁡\\theta tan⁡\\theta )\\text{d}\\theta =$" :question/worked-solution "Recall that\n\n$$\n\\int sec⁡\\theta tan⁡\\theta \\,\\text{d}\\theta =sec⁡\\theta +C.\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}\\begin{aligned}\\int (-sec⁡\\theta tan⁡\\theta )\\text{d}\\theta  & =-\\int sec⁡\\theta tan⁡\\theta \\,\\text{d}\\theta  \\\\  & =-(sec⁡\\theta )+C \\\\  & =-sec⁡\\theta +C.\\end{aligned}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186287989 :knowledge-point/_questions [{:db/id #edb/ref 17592186059773 :knowledge-point/id #uuid "691b9107-a935-5965-b3ac-0f3a193ce9bd" :knowledge-point/title "Identifying the Appropriate Row Operation To Transform One Matrix Into Another"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0f5c7599-29ce-5dfb-b9ba-7e6fb2bf85d8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{R}_{1}:={R}_{1}-\\frac{1}{2}{R}_{3}" :db/id #edb/ref 17592186284920} {:answer/id #uuid "3a3de505-4af9-587f-bcca-65ed2365b867" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{R}_{1}:=-\\frac{1}{4}{R}_{1}" :db/id #edb/ref 17592186285336} {:answer/id #uuid "5495a455-efc7-5ebe-b382-a6c7dce1ea64" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{R}_{1}:=\\frac{1}{4}{R}_{1}" :db/id #edb/ref 17592186285564} {:answer/id #uuid "f489821f-daaf-5cd9-bdf8-076fa189ac14" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{R}_{1}:=(-2){R}_{1}" :db/id #edb/ref 17592186287030} {:answer/id #uuid "fd46554d-54cc-5fd1-8d36-7125d02933cd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{R}_{1}:={R}_{1}+\\frac{1}{4}{R}_{2}" :db/id #edb/ref 17592186287104}] :answer-field/correct {:answer/id #uuid "5495a455-efc7-5ebe-b382-a6c7dce1ea64" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{R}_{1}:=\\frac{1}{4}{R}_{1}" :db/id #edb/ref 17592186285564} :answer-field/id #uuid "5b9e0856-cd52-5230-aead-a0e0ab0fa9b3" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186287343}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "bf5f9366-1ce3-5395-93b6-14a04149ebc4" :question/math-academy-id "q-20387" :question/problem "Which of the following elementary row operations transforms the matrix $S$ into the matrix $T$, where\n\n$$\nS=[\\begin{aligned}60 & 0 & 120 \\\\ 20 & 0 & 40 \\\\ 15 & 0 & 30\\end{aligned}],\\,T=[\\begin{aligned}15 & 0 & 30 \\\\ 20 & 0 & 40 \\\\ 15 & 0 & 30\\end{aligned}]?\n$$" :question/worked-solution "First, notice that the $2$nd and $3$rd rows are the same in both matrices. The only row that has changed is the $1$st row. \n\nBy considering the given row operations that changes the $1$st  row, we notice that\n\n$$\n\\begin{aligned}S & =[\\begin{aligned}60 & 0 & 120 \\\\ 20 & 0 & 40 \\\\ 15 & 0 & 30\\end{aligned}] & \\,{R}_{1}:=\\frac{1}{4}\\cdot {R}_{1} \\\\  & ∼[\\begin{aligned}15 & 0 & 30 \\\\ 20 & 0 & 40 \\\\ 15 & 0 & 30\\end{aligned}] \\\\  & =T.\\end{aligned}\n$$\n\nTherefore, the required row operation is\n\n$$\n{R}_{1}:=\\frac{1}{4}{R}_{1}.\n$$"}] [{:db/id #edb/ref 17592186092624 :knowledge-point/_questions [{:db/id #edb/ref 17592186092170 :knowledge-point/id #uuid "a71da663-e7a4-5781-973c-5dc7e4deb83f" :knowledge-point/title "Finding the Points of Intersection of a Horizontal Line and a Tangent Curve"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "06a9c8d8-68c5-587e-838a-4a7f7a9f44bb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2\\pi }{3}" :db/id #edb/ref 17592186284840} {:answer/id #uuid "269e3329-f871-5045-88f0-2b40179a9752" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{7\\pi }{6}" :db/id #edb/ref 17592186285128} {:answer/id #uuid "725d36f9-f189-56dd-98a0-db99c79bb457" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5\\pi }{6}" :db/id #edb/ref 17592186285840} {:answer/id #uuid "b3b81c32-7857-5a5e-80e1-2d918aea9dd6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3\\pi }{4}" :db/id #edb/ref 17592186286425} {:answer/id #uuid "fdd63f8c-9c63-51fb-b9ec-35a75373c9c1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5\\pi }{9}" :db/id #edb/ref 17592186287109}] :answer-field/correct {:answer/id #uuid "725d36f9-f189-56dd-98a0-db99c79bb457" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5\\pi }{6}" :db/id #edb/ref 17592186285840} :answer-field/id #uuid "7c0b2d2e-e7a6-5a1c-bd3e-245bfcd76f6c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186287407}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "fc963679-7e9a-589a-a899-b98503fae964" :question/math-academy-id "q-20414" :question/problem "![](images/f0/f00d8bd6cbd1f113df7f023e161e4d79e2f4a81157d1ac9a8ab65e70b4959221.png)\n\nThe graph above shows the curve $y=\\operatorname{tan}⁡x$ and the line $y=-\\frac{\\sqrt{3}}{3}.$  Find the $x$-coordinate of the point $B.$" :question/worked-solution "The $y$-values of both functions are the same at the intersection point. Equating the two equations gives: \n\n$$\n\\operatorname{tan}⁡x=-\\frac{\\sqrt{3}}{3}\n$$\n\n Now, we find the principal value:\n\n$$\n\\begin{aligned}x=\\operatorname{arctan}⁡(-\\frac{\\sqrt{3}}{3})=-\\frac{\\pi }{6}\\end{aligned}\n$$\n\nThis value lies inside $-\\pi \\le x<\\pi $ hence, our first solution is ${x}_{1}=-\\frac{\\pi }{6}.$ This is the $x$ coordinate of $A.$\n\nTo get another solution, we add $\\pi $ to the principal value. Thus,\n\n$$\n{x}_{2}=\\pi +x=\\pi -\\frac{\\pi }{6}=\\frac{5\\pi }{6}.\n$$\n\nSo, the $x$-coordinate of $B$ is $\\frac{5\\pi }{6}.$"}] [{:db/id #edb/ref 17592186097181 :knowledge-point/_questions [{:db/id #edb/ref 17592186096701 :knowledge-point/id #uuid "2fbb8f19-f35a-59c4-9b77-8f6c3542ef28" :knowledge-point/title "Finding a Scalar Factor in a Linear Combination"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2cc5590c-f5cf-5e21-9a2e-5e31772b304d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186285183} {:answer/id #uuid "35a20bbd-e86d-5f6e-907f-c57e5562aefc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186285280} {:answer/id #uuid "531f071e-da47-5a18-876a-8d7ce3863d67" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186285552} {:answer/id #uuid "80ddc038-3db7-5447-8486-3d32260a66f8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{2}" :db/id #edb/ref 17592186285973} {:answer/id #uuid "b9a429df-36c3-50d3-a2b3-d9bf1a44b2dd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186286477}] :answer-field/correct {:answer/id #uuid "b9a429df-36c3-50d3-a2b3-d9bf1a44b2dd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186286477} :answer-field/id #uuid "7fd9a91d-854c-5377-a157-19bd44fd94f1" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186287416}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "7a4f66a0-1cfd-52d9-be40-ea47c3b77cf3" :question/math-academy-id "q-20435" :question/problem "![](images/4b/4b7c8c679171c1dcb6ef44b33696ba2ccce87b3f690643af979476d8dfb285ce.png)\n\nConsider the picture above. Given that $c=\\lambda a+3b$, find $\\lambda .$" :question/worked-solution "To find $\\lambda ,$ we want to match the expression\n\n$$\nc=\\lambda a+3b.\n$$\n\nWe are given that one of the components is $3b.$ So, we first draw the vector $3b$ from the origin. Then we complete the path to the point $C.$\n\n![](images/f6/f67af4512a7ab61f862932a60dafc25ef62bc46335b7d7df323fe889f8728e6b.png)\n\nLet $P$ be the endpoint of the vector $3b.$ Then\n\n$$\nc=\\overset{\\to }{OP}+\\overset{\\to }{PC}.\n$$\n\nIn $△OPC,$ we have:\n\n- $PC=\\frac{1}{2}|a|$\n\n- $\\overset{\\to }{PC}$ and $a$ have the same direction\n\nHence, $\\overset{\\to }{PC}=\\frac{1}{2}a.$\n\nAdditionally, \n\n$$\n\\begin{aligned}c & =\\overset{\\to }{OP}+\\overset{\\to }{PC} \\\\  & =3b+\\frac{1}{2}a.\\end{aligned}\n$$\n\nConsequently, $c=\\lambda a+3b=\\frac{1}{2}a+3b.$\n\nSince $a∦b,$ the linear combination can only be written in one way. Equating the coefficients of $a,$ we get:\n\n$$\n\\lambda =\\frac{1}{2}\n$$"}] [{:db/id #edb/ref 17592186287990 :knowledge-point/_questions [{:db/id #edb/ref 17592186096670 :knowledge-point/id #uuid "de05090a-2461-514a-971d-b83c7cea124e" :knowledge-point/title "Solving a System of Equations Using Back Substitution Given an Augmented Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5ae30bba-5530-5871-9ea8-4343da788a3c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}3 \\\\ 4 \\\\ -3\\end{aligned}]" :db/id #edb/ref 17592186285617} {:answer/id #uuid "84ac8a3e-9db1-5899-a94c-f1d8a6b9f8d7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 \\\\ -4 \\\\ -3\\end{aligned}]" :db/id #edb/ref 17592186286009} {:answer/id #uuid "9dcb2df3-855d-5d8c-a44e-0d9a80e2da45" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}-1 \\\\ 5 \\\\ -3\\end{aligned}]" :db/id #edb/ref 17592186286231} {:answer/id #uuid "b551c659-6a03-59d6-a275-55b8eeb6c65e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}-2 \\\\ 5 \\\\ -3\\end{aligned}]" :db/id #edb/ref 17592186286438} {:answer/id #uuid "ea0025fc-ffa4-5c23-9ca1-fc484cd0db28" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}0 \\\\ 4 \\\\ -3\\end{aligned}]" :db/id #edb/ref 17592186286929}] :answer-field/correct {:answer/id #uuid "ea0025fc-ffa4-5c23-9ca1-fc484cd0db28" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}0 \\\\ 4 \\\\ -3\\end{aligned}]" :db/id #edb/ref 17592186286929} :answer-field/id #uuid "99080949-e49d-5bbc-ac7f-90d7689382a9" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186287462}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "1a5ebda6-bb81-57c5-aa1e-8e3aa3418e26" :question/math-academy-id "q-20452" :question/problem "Solve the system of equations represented by the augmented matrix\n\n$$\n[\\begin{aligned}1 & 2 & 3 & -1 \\\\ 0 & 1 & 2 & -2 \\\\ 0 & 0 & 1 & -3\\end{aligned}].\n$$" :question/worked-solution "The matrix represents a system of three linear equations in three variables, say,  ${x}_{1}$, ${x}_{2}$, and ${x}_{3}.$ We obtain the following system of linear equations:\n\n$$\n{\\begin{aligned} & {x}_{1}+2{x}_{2}+3{x}_{3}=-1 \\\\  & {x}_{2}+2{x}_{3}=-2 \\\\  & {x}_{3}=-3\\end{aligned}\n$$\n\nThe third equation states that  ${x}_{3}=-3.$ Substituting this into the second equation,  we get\n\n$$\n{x}_{2}+2(-3)=-2\\,⟹\\,{x}_{2}=-2-2(-3)=-2+6=4.\n$$\n\nNow, we substitute ${x}_{3}=-3$ and ${x}_{2}=4$ into the first equation to get\n\n$$\n{x}_{1}+2(4)+3(-3)=-1\\,⟹\\,{x}_{1}=-1-8+9=0.\n$$\n\nTherefore, the solution is ${x}_{1}=0$, ${x}_{2}=4$, and ${x}_{3}=-3.$ In vector form, the solution can be written as\n$[\\begin{aligned}0 \\\\ 4 \\\\ -3\\end{aligned}].$"}] [{:db/id #edb/ref 17592186193232 :knowledge-point/_questions [{:db/id #edb/ref 17592186192837 :knowledge-point/id #uuid "808894a0-c611-5eb7-bd57-7f7029f0ef0c" :knowledge-point/title "Calculating Improper Integrals Involving Arctangent Using Substitution"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2d7c9656-50c7-5f2f-a75f-303286f63722" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{3}\\pi }{3}" :db/id #edb/ref 17592186285192} {:answer/id #uuid "48d663a7-0d4d-5e1a-829c-702875e8fa20" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2\\sqrt{3}\\pi }{3}" :db/id #edb/ref 17592186285457} {:answer/id #uuid "71ebd32d-bc3e-5795-a3f3-f25bd368644f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{3}\\pi }{6}" :db/id #edb/ref 17592186285836} {:answer/id #uuid "adc96207-8393-5f0a-a5c6-a03c114c44e5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The integral diverges" :db/id #edb/ref 17592186286374} {:answer/id #uuid "f74274cd-f977-54ba-8234-27fbf9f752cb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{3}\\pi }{18}" :db/id #edb/ref 17592186287052}] :answer-field/correct {:answer/id #uuid "f74274cd-f977-54ba-8234-27fbf9f752cb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{3}\\pi }{18}" :db/id #edb/ref 17592186287052} :answer-field/id #uuid "db798c01-6b38-52e4-923a-3271058a473d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186287596}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "86974777-e957-5007-90f0-8770ec52a454" :question/math-academy-id "q-20502" :question/problem "Use the substitution $u={e}^{x}$ to evaluate ${\\int }_{0}^{\\infty }\\frac{{e}^{x}}{1+3{e}^{2x}}\\,\\text{d}x.$" :question/worked-solution "First, we substitute $u={e}^{x}.$ Differentiating, we get\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}={e}^{x}\\,⟹\\,\\text{d}u={e}^{x}\\text{d}x.\n$$\n\nSince $u\\to \\infty $ when $x\\to \\infty ,$ the table for the limits of integration using the rule $u={e}^{x}$ is as follows:\n\n| $x$ | $0$ | $\\infty $ |\n| --- | --- | --- |\n| $u$ | $1$ | $\\infty $ |\n\nSo, the integral in terms of the new variable $u$ is\n\n$$\n\\begin{aligned}{\\int }_{0}^{\\infty }\\frac{{e}^{x}}{1+3{e}^{2x}}\\,\\text{d}x & ={\\int }_{1}^{\\infty }\\frac{1}{1+3{u}^{2}}\\,\\text{d}u.\\end{aligned}\n$$\n\nNow, we proceed by setting the upper bound equal to some parameter $a,$ integrating as usual, and then taking the limit as $a\\to \\infty .$\n\n$$\n\\begin{aligned}{\\int }_{0}^{\\infty }\\frac{{e}^{x}}{1+3{e}^{2x}}\\,\\text{d}x & ={\\int }_{1}^{\\infty }\\frac{1}{1+3{u}^{2}}\\,\\text{d}u \\\\  & ={lim}_{a\\to \\infty }{\\int }_{1}^{a}\\frac{1}{1+3{u}^{2}}\\,\\text{d}x \\\\  & ={lim}_{a\\to \\infty }{[\\frac{1}{\\sqrt{3}}\\cdot \\operatorname{arctan}⁡(\\sqrt{3}u)]}_{1}^{a} \\\\  & =\\frac{1}{\\sqrt{3}}\\cdot {lim}_{a\\to \\infty }{[\\operatorname{arctan}⁡(\\sqrt{3}u)]}_{1}^{a} \\\\  & =\\frac{1}{\\sqrt{3}}\\cdot {lim}_{a\\to \\infty }[\\operatorname{arctan}⁡(\\sqrt{3}a)-\\operatorname{arctan}⁡(\\sqrt{3})] \\\\  & =\\frac{1}{\\sqrt{3}}\\cdot ({lim}_{a\\to \\infty }[\\operatorname{arctan}⁡(\\sqrt{3}a)]-\\frac{\\pi }{3})\\end{aligned}\n$$\n\nFinally, recall the end behavior of the function $y=\\operatorname{arctan}⁡(\\sqrt{3}x),$ shown in the graph below:\n\n- ${lim}_{x\\to -\\infty }[\\operatorname{arctan}⁡(\\sqrt{3}x)]=-\\frac{\\pi }{2}$\n\n- ${lim}_{x\\to \\infty }[\\operatorname{arctan}⁡(\\sqrt{3}x)]=\\frac{\\pi }{2}$\n\n![](images/f5/f55b37b456a6ab60c495c64be5f7afe510dc0889890ed2a070b371f9bbe69c1a.png)\n\nUsing this to evaluate our integral, we conclude that\n\n$$\n\\begin{aligned}{\\int }_{0}^{\\infty }\\frac{{e}^{x}}{1+3{e}^{2x}}\\,\\text{d}x & =\\frac{1}{\\sqrt{3}}\\cdot ({lim}_{a\\to \\infty }[\\operatorname{arctan}⁡(\\sqrt{3}a)]-\\frac{\\pi }{3}) \\\\  & =\\frac{1}{\\sqrt{3}}\\cdot (\\frac{\\pi }{2}-\\frac{\\pi }{3}) \\\\  & =\\frac{1}{\\sqrt{3}}\\cdot \\frac{\\pi }{6} \\\\  & =\\frac{\\sqrt{3}\\pi }{18}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186395769 :knowledge-point/_questions [{:db/id #edb/ref 17592186096672 :knowledge-point/id #uuid "739b1cbc-c1a7-547d-a9fb-1f244bd36827" :knowledge-point/title "Solving a 3x3 System of Equations Using Standard Gaussian Elimination"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "23b6f110-fbc4-5322-8a05-6366ff4c13c0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨1,4,-2⟩" :db/id #edb/ref 17592186395771} {:answer/id #uuid "e6302263-6554-5d2f-bdfe-094ceb26b042" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨3,2,-2⟩" :db/id #edb/ref 17592186395772} {:answer/id #uuid "337c9891-a990-5356-ae53-39e28e060932" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨5,4,-4⟩" :db/id #edb/ref 17592186395773} {:answer/id #uuid "12ab6864-c814-589e-8f72-328eeae44af0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨13,-4,-4⟩" :db/id #edb/ref 17592186395774} {:answer/id #uuid "fa67123d-ee59-563d-90e5-5d86c85b1243" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨-11,4,4⟩" :db/id #edb/ref 17592186395775}] :answer-field/correct {:answer/id #uuid "337c9891-a990-5356-ae53-39e28e060932" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨5,4,-4⟩" :db/id #edb/ref 17592186395773} :answer-field/id #uuid "2a758e48-dc27-560b-a0af-fd01b7ea572b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186395770}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "3437106d-95df-5058-942b-4f64c5179bc5" :question/math-academy-id "q-20512" :question/problem "Consider the system of linear equations\n\n$$\n{\\begin{aligned} & x+y+2z=1 \\\\  & 2x+3y+4z=6 \\\\  & 3x+3y+4z=11\\end{aligned}\n$$\n\nUse the standard method of Gaussian elimination to reduce the augmented matrix $M$ of the system to row echelon form, and hence solve the linear system." :question/worked-solution "The augmented matrix for this system is\n\n$$\nM=[\\begin{aligned}1 & 1 & 2 & 1 \\\\ 2 & 3 & 4 & 6 \\\\ 3 & 3 & 4 & 11\\end{aligned}].\n$$\n\nReducing $M$ to row echelon form, we have\n\n$$\n\\begin{aligned}M & ∼[\\begin{aligned}1 & 1 & 2 & 1 \\\\ 2 & 3 & 4 & 6 \\\\ 3 & 3 & 4 & 11\\end{aligned}] & {R}_{2} & :={R}_{2}+(-2){R}_{1} \\\\  & ∼[\\begin{aligned}1 & 1 & 2 & 1 \\\\ 0 & 1 & 0 & 4 \\\\ 3 & 3 & 4 & 11\\end{aligned}] & {R}_{3} & :={R}_{3}+(-3){R}_{1} \\\\  & ∼[\\begin{aligned}1 & 1 & 2 & 1 \\\\ 0 & 1 & 0 & 4 \\\\ 0 & 0 & -2 & 8\\end{aligned}] & {R}_{3} & :=-\\frac{1}{2}{R}_{3} \\\\  & ∼[\\begin{aligned}1 & 1 & 2 & 1 \\\\ 0 & 1 & 0 & 4 \\\\ 0 & 0 & 1 & -4\\end{aligned}].\\end{aligned}\n$$\n\nThe system is now\n\n$$\n{\\begin{aligned} & x+y+2z=1 \\\\  & y=4 \\\\  & z=-4\\end{aligned}\n$$\n\nand we can apply back substitution. Substituting both $y=4$ and $z=-4$ into the first equation, we get\n\n$$\nx+(4)+2(-4)=1\\,⟹\\,x=5.\n$$\n\nTherefore, the solution is $x=5,y=4$, and $z=-4.$ Or, in vector form, $⟨5,4,-4⟩.$"}] [{:db/id #edb/ref 17592186287997 :knowledge-point/_questions [{:db/id #edb/ref 17592186096672 :knowledge-point/id #uuid "739b1cbc-c1a7-547d-a9fb-1f244bd36827" :knowledge-point/title "Solving a 3x3 System of Equations Using Standard Gaussian Elimination"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "15719692-f572-52e2-92ef-7c37695a20ac" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "M∼[\\begin{aligned}1 & 0 & 1 & 4 \\\\ 0 & 1 & -1 & -4 \\\\ 0 & 0 & 1 & 0\\end{aligned}]" :db/id #edb/ref 17592186284977} {:answer/id #uuid "8eb9ba6d-8ad5-5004-96ed-80c84894925e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "M∼[\\begin{aligned}1 & 0 & 1 & 4 \\\\ 0 & 1 & -1 & -4 \\\\ 0 & 0 & 1 & -2\\end{aligned}]" :db/id #edb/ref 17592186286091} {:answer/id #uuid "bc5c7bb0-6725-548b-b664-64d4ff92c96b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "M∼[\\begin{aligned}1 & 0 & 1 & 4 \\\\ 0 & 1 & -1 & -4 \\\\ 0 & 0 & 1 & 1\\end{aligned}]" :db/id #edb/ref 17592186286504} {:answer/id #uuid "d6bbdd67-60e8-56e1-96f6-8012386dd066" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "M∼[\\begin{aligned}1 & 0 & 1 & 4 \\\\ 0 & 1 & -1 & -4 \\\\ 0 & 0 & 1 & 2\\end{aligned}]" :db/id #edb/ref 17592186286742} {:answer/id #uuid "f2e5b59d-43dc-5f6c-8987-626af7040c4d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "M∼[\\begin{aligned}1 & 0 & 1 & 4 \\\\ 0 & 1 & -1 & -4 \\\\ 0 & 0 & 1 & -1\\end{aligned}]" :db/id #edb/ref 17592186287014}] :answer-field/correct {:answer/id #uuid "bc5c7bb0-6725-548b-b664-64d4ff92c96b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "M∼[\\begin{aligned}1 & 0 & 1 & 4 \\\\ 0 & 1 & -1 & -4 \\\\ 0 & 0 & 1 & 1\\end{aligned}]" :db/id #edb/ref 17592186286504} :answer-field/id #uuid "28841267-b70d-52db-841b-c4f0d84407a2" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186287232}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "e202a5f2-1485-54d2-ad75-6c42b9340de9" :question/math-academy-id "q-20524" :question/problem "Consider the augmented matrix $M$ given by\n\n$$\nM=[\\begin{aligned}1 & 0 & 1 & 4 \\\\ 0 & 1 & -1 & -4 \\\\ 5 & 0 & 6 & 21\\end{aligned}].\n$$\n\nUse the standard method of Gaussian elimination to reduce the augmented matrix $M$ of the system to row echelon form." :question/worked-solution "Reducing $M$ to row echelon form, we have\n\n$$\n\\begin{aligned}M & ∼[\\begin{aligned}1 & 0 & 1 & 4 \\\\ 0 & 1 & -1 & -4 \\\\ 5 & 0 & 6 & 21\\end{aligned}] & {R}_{3} & :={R}_{3}-5{R}_{1} \\\\  & ∼[\\begin{aligned}1 & 0 & 1 & 4 \\\\ 0 & 1 & -1 & -4 \\\\ 0 & 0 & 1 & 1\\end{aligned}].\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186390374 :knowledge-point/_questions [{:db/id #edb/ref 17592186096672 :knowledge-point/id #uuid "739b1cbc-c1a7-547d-a9fb-1f244bd36827" :knowledge-point/title "Solving a 3x3 System of Equations Using Standard Gaussian Elimination"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8326c365-38e8-509f-ba26-6de3d26a5411" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "M∼[\\begin{aligned}1 & 3 & 4 & -6 \\\\ 0 & 1 & 1 & -1 \\\\ 0 & 0 & 1 & -1\\end{aligned}]" :db/id #edb/ref 17592186390376} {:answer/id #uuid "f0893938-c4dc-5b69-ac7a-20d7546db3b9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "M∼[\\begin{aligned}1 & 3 & 4 & -6 \\\\ 0 & 1 & 1 & -1 \\\\ 0 & 0 & 1 & -2\\end{aligned}]" :db/id #edb/ref 17592186390377} {:answer/id #uuid "98de7d9c-ac96-50b3-a7cd-2e1f0a084bca" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "M∼[\\begin{aligned}1 & 3 & 4 & -6 \\\\ 0 & 1 & 1 & -1 \\\\ 0 & 0 & 1 & 1\\end{aligned}]" :db/id #edb/ref 17592186390378} {:answer/id #uuid "5d46c30a-315a-5f3c-9e1c-febc548b0a21" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "M∼[\\begin{aligned}1 & 3 & 4 & -6 \\\\ 0 & 1 & 1 & -1 \\\\ 0 & 0 & 1 & 0\\end{aligned}]" :db/id #edb/ref 17592186390379} {:answer/id #uuid "c961a688-8a1a-5a32-8996-3f5dbb760b72" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "M∼[\\begin{aligned}1 & 3 & 4 & -6 \\\\ 0 & 1 & 1 & -1 \\\\ 0 & 0 & 1 & 2\\end{aligned}]" :db/id #edb/ref 17592186390380}] :answer-field/correct {:answer/id #uuid "f0893938-c4dc-5b69-ac7a-20d7546db3b9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "M∼[\\begin{aligned}1 & 3 & 4 & -6 \\\\ 0 & 1 & 1 & -1 \\\\ 0 & 0 & 1 & -2\\end{aligned}]" :db/id #edb/ref 17592186390377} :answer-field/id #uuid "1a2efbab-ca3d-5dfb-bdbf-f29fc5964e47" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186390375}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "4b0ab2ea-5bc8-5361-b6e4-ca31cdf1350a" :question/math-academy-id "q-20539" :question/problem "Consider the augmented matrix $M$ given by \n\n$$\nM=[\\begin{aligned}1 & 3 & 4 & -6 \\\\ 2 & 7 & 9 & -13 \\\\ 4 & 12 & 17 & -26\\end{aligned}].\n$$\n\nUse the standard method of Gaussian elimination to reduce the augmented matrix $M$ of the system to row echelon form." :question/worked-solution "Reducing $M$ to row echelon form, we have\n\n$$\n\\begin{aligned}M & ∼[\\begin{aligned}1 & 3 & 4 & -6 \\\\ 2 & 7 & 9 & -13 \\\\ 4 & 12 & 17 & -26\\end{aligned}] & {R}_{2} & :={R}_{2}-2{R}_{1} \\\\  & ∼[\\begin{aligned}1 & 3 & 4 & -6 \\\\ 0 & 1 & 1 & -1 \\\\ 4 & 12 & 17 & -26\\end{aligned}] & {R}_{3} & :={R}_{3}-4{R}_{1} \\\\  & ∼[\\begin{aligned}1 & 3 & 4 & -6 \\\\ 0 & 1 & 1 & -1 \\\\ 0 & 0 & 1 & -2\\end{aligned}].\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186390381 :knowledge-point/_questions [{:db/id #edb/ref 17592186096674 :knowledge-point/id #uuid "7294399b-b139-5ee6-824c-5e28e4fc49ff" :knowledge-point/title "Finding the Reduced Row Echelon Form of a 3x3 System That Is Already in Row Echelon Form"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a91e48e3-62ec-5edb-bcf7-03d4a5806e0a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "M∼[\\begin{aligned}1 & 0 & 0 & 0 \\\\ 0 & 1 & 0 & -2 \\\\ 0 & 0 & 1 & 1\\end{aligned}]" :db/id #edb/ref 17592186390383} {:answer/id #uuid "5461c0a1-245b-5870-8efa-189453e52726" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "M∼[\\begin{aligned}1 & 0 & 0 & 0 \\\\ 0 & 1 & 0 & 2 \\\\ 0 & 0 & 1 & 1\\end{aligned}]" :db/id #edb/ref 17592186390384} {:answer/id #uuid "0327ce18-3178-58df-99a3-60dc77f9fed2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "M∼[\\begin{aligned}1 & 0 & 0 & 0 \\\\ 0 & 1 & 0 & -2 \\\\ 0 & 0 & 1 & -1\\end{aligned}]" :db/id #edb/ref 17592186390385} {:answer/id #uuid "fabd327a-4307-5856-a87b-ef1b6f25459d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "M∼[\\begin{aligned}1 & 0 & 0 & 0 \\\\ 0 & 1 & 0 & -3 \\\\ 0 & 0 & 1 & 4\\end{aligned}]" :db/id #edb/ref 17592186390386} {:answer/id #uuid "91ef62e9-3380-521c-8cbb-38d749ba6534" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "M∼[\\begin{aligned}1 & 0 & 0 & 1 \\\\ 0 & 1 & 0 & -2 \\\\ 0 & 0 & 1 & 1\\end{aligned}]" :db/id #edb/ref 17592186390387}] :answer-field/correct {:answer/id #uuid "a91e48e3-62ec-5edb-bcf7-03d4a5806e0a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "M∼[\\begin{aligned}1 & 0 & 0 & 0 \\\\ 0 & 1 & 0 & -2 \\\\ 0 & 0 & 1 & 1\\end{aligned}]" :db/id #edb/ref 17592186390383} :answer-field/id #uuid "13da932e-9b2a-5e64-abc3-8e5afbbc90ed" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186390382}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "9f45c2e0-9678-5cdd-b7f1-5fd5cc96fa80" :question/math-academy-id "q-20590" :question/problem "Consider the following system of linear equations:\n\n$$\n{\\begin{aligned} & x+y+2z=0 \\\\  & y+2z=0 \\\\  & z=1\\end{aligned}\n$$\n\nUse the standard Gauss-Jordan method to reduce the augmented matrix $M$ of the system to reduced row echelon form." :question/worked-solution "The augmented matrix for this system is\n\n$$\nM=[\\begin{aligned}1 & 1 & 2 & 0 \\\\ 0 & 1 & 2 & 0 \\\\ 0 & 0 & 1 & 1\\end{aligned}].\n$$\n\nNotice that the matrix $M$ is already in row echelon form.\n\nTransforming $M$ to reduced row echelon form, we have\n\n$$\n\\begin{aligned}M & ∼[\\begin{aligned}1 & 1 & 2 & 0 \\\\ 0 & 1 & 2 & 0 \\\\ 0 & 0 & 1 & 1\\end{aligned}] & {R}_{2} & :={R}_{2}+(-2){R}_{3} \\\\  & ∼[\\begin{aligned}1 & 1 & 2 & 0 \\\\ 0 & 1 & 0 & -2 \\\\ 0 & 0 & 1 & 1\\end{aligned}] & {R}_{1} & :={R}_{1}+(-2){R}_{3} \\\\  & ∼[\\begin{aligned}1 & 1 & 0 & -2 \\\\ 0 & 1 & 0 & -2 \\\\ 0 & 0 & 1 & 1\\end{aligned}] & {R}_{1} & :={R}_{1}+(-1){R}_{2} \\\\  & ∼[\\begin{aligned}1 & 0 & 0 & 0 \\\\ 0 & 1 & 0 & -2 \\\\ 0 & 0 & 1 & 1\\end{aligned}].\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186288006 :knowledge-point/_questions [{:db/id #edb/ref 17592186083201 :knowledge-point/id #uuid "dc6d9b69-0459-515a-ba7b-c62cab96ca00" :knowledge-point/title "Identifying Divergent Improper Integrals"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3447b210-752f-58bc-ae21-6727e68e220b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The integral is divergent" :db/id #edb/ref 17592186285271} {:answer/id #uuid "68cdc6da-3b7a-57fc-8b9f-cd3018eea1a4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{e}^{2}" :db/id #edb/ref 17592186285751} {:answer/id #uuid "6d97721e-a156-5007-a747-5f849a77796c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\operatorname{ln}⁡(2)" :db/id #edb/ref 17592186285798} {:answer/id #uuid "888fbc31-5edc-5fc6-ba9c-9dca4d6a73b8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{ln}⁡(2)" :db/id #edb/ref 17592186286040} {:answer/id #uuid "ed4d35d0-edf6-5b04-974a-d41a0d358490" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{\\operatorname{ln}⁡(2)}" :db/id #edb/ref 17592186286963}] :answer-field/correct {:answer/id #uuid "3447b210-752f-58bc-ae21-6727e68e220b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The integral is divergent" :db/id #edb/ref 17592186285271} :answer-field/id #uuid "43979b98-c797-55a1-8e56-30f10ae875af" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186287297}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "c15a1f53-63be-5a09-b32e-0a9e0c9c95b6" :question/math-academy-id "q-20700" :question/problem "Evaluate the integral ${\\int }_{2}^{\\infty }\\frac{1}{x\\operatorname{ln}⁡x}\\,\\text{d}x.$" :question/worked-solution "First, we substitute $u=\\operatorname{ln}⁡x.$ Differentiating, we get\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=\\frac{1}{x}\\,⟹\\,\\text{d}u=\\frac{1}{x}\\text{d}x.\n$$\n\nSince $u\\to \\infty $ when $x\\to \\infty ,$ the table for the limits of integration using the rule $u=\\operatorname{ln}⁡x$ is as follows:\n\n$$\n\\begin{aligned}x & 2 & \\infty  \\\\ u & \\operatorname{ln}⁡2 & \\infty \\end{aligned}\n$$\n\nSo, the integral in terms of the new variable $u$ is\n\n$$\n\\begin{aligned}{\\int }_{2}^{\\infty }\\frac{1}{x\\operatorname{ln}⁡(x)}\\,\\text{d}x & ={\\int }_{\\operatorname{ln}⁡2}^{\\infty }\\frac{1}{u}\\,\\text{d}u.\\end{aligned}\n$$\n\nFinally, we proceed by setting the upper bound equal to some parameter $a,$ integrating as usual, and then taking the limit as $a\\to \\infty .$\n\n$$\n\\begin{aligned}{\\int }_{2}^{\\infty }\\frac{1}{x\\operatorname{ln}⁡x}\\,\\text{d}x & ={lim}_{a\\to \\infty }{\\int }_{\\operatorname{ln}⁡2}^{a}\\frac{1}{u}\\,\\text{d}u \\\\  & ={lim}_{a\\to \\infty }{[\\operatorname{ln}⁡u]}_{\\operatorname{ln}⁡2}^{a} \\\\  & ={lim}_{a\\to \\infty }[\\operatorname{ln}⁡a-\\operatorname{ln}⁡(\\operatorname{ln}⁡2)] \\\\  & =\\infty -\\operatorname{ln}⁡(\\operatorname{ln}⁡2) \\\\  & =\\infty .\\end{aligned}\n$$\n\nTherefore, the integral is divergent."}] [{:db/id #edb/ref 17592186288007 :knowledge-point/_questions [{:db/id #edb/ref 17592186105924 :knowledge-point/id #uuid "d083b53b-8c39-5785-a250-5649001e822b" :knowledge-point/title "Finding the Area of an Unbounded Region"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "463bda05-30a6-5f43-9fe8-a6e053505a9c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186285430} {:answer/id #uuid "62a7dfb9-8e2d-5329-a19a-e69dfd7a639a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186285691} {:answer/id #uuid "8562f479-b79c-5bfc-9052-d2dd00d037d0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186286013} {:answer/id #uuid "8f788f95-a115-5ce9-ab9e-1c9905482ec7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "7" :db/id #edb/ref 17592186286097} {:answer/id #uuid "a1ec5508-5b77-5348-9a3d-570f81c31d60" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186286268}] :answer-field/correct {:answer/id #uuid "8562f479-b79c-5bfc-9052-d2dd00d037d0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186286013} :answer-field/id #uuid "d9e36243-4323-5e17-ae45-dac66122d031" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186287590}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "7b7327d0-ac78-5202-8dce-774362ca097e" :question/math-academy-id "q-20701" :question/problem "![](images/d1/d1318686a66856057fb04027ac52ff20266e628a498458b283ee93df1e4294eb.png)\n\nFind the total area of the region bounded by the graph of the curve $y={e}^{-|x|}$ and the $x$-axis, as shown above." :question/worked-solution "We find the area of the region bounded by the graph of the curve and the $x$-axis by calculating the integral\n\n$$\nA={\\int }_{-\\infty }^{\\infty }{e}^{-|x|}\\,\\text{d}x.\n$$\n\nWe break up the integral as follows:\n\n$$\n{\\int }_{-\\infty }^{\\infty }{e}^{-|x|}\\,\\text{d}x={\\int }_{-\\infty }^{0}{e}^{-|x|}\\,\\text{d}x+{\\int }_{0}^{\\infty }{e}^{-|x|}\\,\\text{d}x\n$$\n\nEvaluating the first of these integrals, we get\n\n$$\n\\begin{aligned}{\\int }_{-\\infty }^{0}{e}^{-|x|}\\,\\text{d}x & ={\\int }_{-\\infty }^{0}{e}^{x}\\,\\text{d}x \\\\  & ={lim}_{a\\to -\\infty }{\\int }_{a}^{0}{e}^{x}\\,\\text{d}x \\\\  & ={lim}_{a\\to -\\infty }({e}^{x}{|}_{a}^{0}) \\\\  & ={lim}_{a\\to -\\infty }({e}^{0}-{e}^{a}) \\\\  & =1+0 \\\\  & =1.\\end{aligned}\n$$\n\nNow, notice that the integrand ${e}^{-|x|}$ is an **even** function. This means that we can immediately deduce that \n\n$$\n{\\int }_{0}^{\\infty }{e}^{-|x|}\\,\\text{d}x=1.\n$$\n\nTherefore, since both improper integrals exist, we conclude that \n\n$$\n\\begin{aligned}{\\int }_{-\\infty }^{\\infty }{e}^{-|x|}\\,\\text{d}x & ={\\int }_{-\\infty }^{0}{e}^{-|x|}\\,\\text{d}x+{\\int }_{0}^{\\infty }{e}^{-|x|}\\,\\text{d}x \\\\  & =1+1 \\\\  & =2.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186288013 :knowledge-point/_questions [{:db/id #edb/ref 17592186105923 :knowledge-point/id #uuid "3fe1f468-9e8d-58fc-bd61-cfe1191a5a19" :knowledge-point/title "Calculating an Improper Integral With Unbounded Limits"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0234256b-4322-512e-92e1-be78bf6561a7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\pi }{2}" :db/id #edb/ref 17592186284806} {:answer/id #uuid "0d4341c5-a3c5-51c6-96a4-fdaf4711e8db" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186284897} {:answer/id #uuid "ae40fe8f-38e8-5ed6-9c7d-2ed99ccf3fe1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186286379} {:answer/id #uuid "c4ca9b83-4a3a-557d-a4a4-e2331cb89ede" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186286589} {:answer/id #uuid "e8ffcac9-a482-5c55-8c94-0e7d4ace356c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The integral is divergent" :db/id #edb/ref 17592186286918}] :answer-field/correct {:answer/id #uuid "c4ca9b83-4a3a-557d-a4a4-e2331cb89ede" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186286589} :answer-field/id #uuid "a50f08d1-2237-56c5-a8d0-686d44fe95f8" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186287480}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "f51d9ec2-7cd0-5c01-b675-e7bf731d23db" :question/math-academy-id "q-20804" :question/problem "Evaluate ${\\int }_{-\\infty }^{\\infty }\\frac{2x}{{x}^{4}+9}\\,\\text{d}x.$" :question/worked-solution "We break up the integral as follows:\n\n$$\n{\\int }_{-\\infty }^{\\infty }\\frac{2x}{{x}^{4}+9}\\,\\text{d}x={\\int }_{-\\infty }^{0}\\frac{2x}{{x}^{4}+9}\\,\\text{d}x+{\\int }_{0}^{\\infty }\\frac{2x}{{x}^{4}+9}\\,\\text{d}x.\n$$\n\nFirst, we calculate the antiderivative using a substitution. Let  $u={x}^{2}$,  then $\\text{d}u=2x\\text{d}x.$ Hence,\n\n$$\n\\begin{aligned}\\int \\frac{2x}{{x}^{4}+9}\\,\\text{d}x & =\\int \\frac{1}{9+{u}^{2}}\\,\\text{d}u \\\\  & =\\frac{1}{3}\\operatorname{arctan}⁡\\frac{u}{3}+C \\\\  & =\\frac{1}{3}\\operatorname{arctan}⁡\\frac{{x}^{2}}{3}+C.\\end{aligned}\n$$\n\nWe now evaluate the first of the improper integrals, as follows:\n\n$$\n\\begin{aligned}{\\int }_{-\\infty }^{0}\\frac{2x}{{x}^{4}+9}\\,\\text{d}x & ={lim}_{a\\to -\\infty }{\\int }_{a}^{0}\\frac{2x}{{x}^{4}+9}\\,\\text{d}x \\\\  & ={lim}_{a\\to -\\infty }{(\\frac{1}{3}\\operatorname{arctan}⁡\\frac{{x}^{2}}{3})|}_{a}^{0} \\\\  & =-{lim}_{a\\to -\\infty }(\\frac{1}{3}\\operatorname{arctan}⁡\\frac{{0}^{2}}{3}-\\frac{1}{3}\\operatorname{arctan}⁡\\frac{{a}^{2}}{3}) \\\\  & =-{lim}_{a\\to -\\infty }(0-\\frac{1}{3}\\operatorname{arctan}⁡\\frac{{a}^{2}}{3}) \\\\  & =0-\\frac{\\pi }{6} \\\\  & =-\\frac{\\pi }{6}\\end{aligned}\n$$\n\nNow, notice that the integrand is an **odd** function. This means that we can immediately deduce that \n\n$$\n{\\int }_{0}^{\\infty }\\frac{2x}{{x}^{4}+9}\\,\\text{d}x=\\frac{\\pi }{6}.\n$$\n\nTherefore, since both improper integrals exist, we conclude that \n\n$$\n\\begin{aligned}{\\int }_{-\\infty }^{\\infty }\\frac{2x}{{x}^{4}+9}\\,\\text{d}x & ={\\int }_{-\\infty }^{0}\\frac{2x}{{x}^{4}+9}\\,\\text{d}x+{\\int }_{0}^{\\infty }\\frac{2x}{{x}^{4}+9}\\,\\text{d}x \\\\  & =-\\frac{\\pi }{6}+\\frac{\\pi }{6} \\\\  & =0.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186395776 :knowledge-point/_questions [{:db/id #edb/ref 17592186083240 :knowledge-point/id #uuid "8922ab07-5ac7-5f85-bfee-c30de7f4024a" :knowledge-point/title "Finding the Derivative of a Parametric Curve"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "05fd7882-e12b-5d1e-bda2-674211a5aad1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186395778} {:answer/id #uuid "61e0f80f-69b1-578c-857a-82bc0682835a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186395779} {:answer/id #uuid "26a77c96-4bef-5e82-8889-1c4a9ce7d523" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186395780} {:answer/id #uuid "9c9b090b-3cbc-511c-95ab-35fc8c1fc057" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186395781} {:answer/id #uuid "d1c50146-0d7c-501d-bf37-4d8d838c3cef" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186395782}] :answer-field/correct {:answer/id #uuid "9c9b090b-3cbc-511c-95ab-35fc8c1fc057" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186395781} :answer-field/id #uuid "56d7a736-a513-51fb-b585-d99caa2d0531" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186395777}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "45b1f64f-9248-57a2-a310-050eb4c80ee5" :question/math-academy-id "q-20849" :question/problem "![](images/c9/c9371d5e2bb921b4f5e58423bbce492f2b555122ee42bd861040b57d01070353.png)\n\nFor the parametric curve (shown above)\n\n$$\nx=2(t+1),\\,y=4{t}^{2},\\,-1\\le t<1,\n$$\n\n find the derivative $\\frac{dy}{dx}$ at the point $P$ on the curve where $t=0.$" :question/worked-solution "We will use the formula\n\n$$\n\\frac{dy}{dx}=\\frac{{y}^{′}(t)}{{x}^{′}(t)}.\n$$\n\nDifferentiating $x$ and $y,$ we get\n\n$$\n{x}^{′}(t)=2,\\,{y}^{′}(t)=8t.\n$$\n\n \n\nTherefore,\n\n$$\n\\frac{dy}{dx}=\\frac{8t}{2}=4t.\n$$\n\nAt the point where $t=0$ we have\n\n$$\n\\begin{aligned}\\frac{dy}{dx} & =4(0) \\\\  & =0\\,.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186401840 :knowledge-point/_questions [{:db/id #edb/ref 17592186083240 :knowledge-point/id #uuid "8922ab07-5ac7-5f85-bfee-c30de7f4024a" :knowledge-point/title "Finding the Derivative of a Parametric Curve"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1e5ec4eb-fb50-5d50-87c7-e15a073c23f5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "12" :db/id #edb/ref 17592186401842} {:answer/id #uuid "7b15bc55-e6d8-5c21-b55e-568e588591b8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "10" :db/id #edb/ref 17592186401843} {:answer/id #uuid "2c8c26cd-3204-5045-8920-160928c0068e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186401844} {:answer/id #uuid "7828179c-427e-5c33-a7ae-bd0edbe05cfe" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "15" :db/id #edb/ref 17592186401845} {:answer/id #uuid "db0ee922-0122-505b-abc7-21b2699ea220" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "7" :db/id #edb/ref 17592186401846}] :answer-field/correct {:answer/id #uuid "1e5ec4eb-fb50-5d50-87c7-e15a073c23f5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "12" :db/id #edb/ref 17592186401842} :answer-field/id #uuid "0ec6f4c2-cef2-5136-bda0-046075ea56a5" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186401841}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "a11f695c-004e-57f4-b1f5-cd09434f69e2" :question/math-academy-id "q-20851" :question/problem "For the parametric curve \n\n$$\nx=2\\sqrt{t},\\,y=12t+1,\\,0\\le t<\\infty ,\n$$\n\n find the derivative $\\frac{dy}{dx}$ at the point $P$ on the curve where $t=1.$" :question/worked-solution "We will use the formula\n\n$$\n\\frac{dy}{dx}=\\frac{{y}^{′}(t)}{{x}^{′}(t)}.\n$$\n\nDifferentiating $x$ and $y,$ we get\n\n$$\n{x}^{′}(t)=\\frac{1}{\\sqrt{t}},\\,{y}^{′}(t)=12.\n$$\n\n \n\nTherefore,\n\n$$\n\\frac{dy}{dx}=\\frac{12}{\\frac{1}{\\sqrt{t}}}=12\\sqrt{t}.\n$$\n\nAt the point where $t=1$ we have\n\n$$\n\\begin{aligned}\\frac{dy}{dx} & =12\\sqrt{1} \\\\  & =12\\,.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186369971 :knowledge-point/_questions [{:db/id #edb/ref 17592186083200 :knowledge-point/id #uuid "39a476b5-eacc-59c1-9d16-fc0675e3bc12" :knowledge-point/title "Calculating Improper Integrals With an Unbounded Lower Limit"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8cf43324-c63f-59fe-a56a-d4b9b0b7048c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The integral diverges" :db/id #edb/ref 17592186369973} {:answer/id #uuid "d31fde31-428f-55b0-b1d5-e09807d05e60" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{2}" :db/id #edb/ref 17592186369974} {:answer/id #uuid "1e516990-d1af-5886-b235-bc549708f3f5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186369975} {:answer/id #uuid "a9eb22e6-abf7-597f-994c-d38d0bf975fb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{4}" :db/id #edb/ref 17592186369976} {:answer/id #uuid "04436aad-8c02-5516-88b3-fa9120784970" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186369977}] :answer-field/correct {:answer/id #uuid "d31fde31-428f-55b0-b1d5-e09807d05e60" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{2}" :db/id #edb/ref 17592186369974} :answer-field/id #uuid "2cbdfe1c-d664-50dc-a125-12450a2859e4" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186369972}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "14405449-2d85-5d75-b26c-28e2f262eedb" :question/math-academy-id "q-20869" :question/problem "${\\int }_{-\\infty }^{0}\\frac{4{x}^{3}}{{(2+{x}^{4})}^{2}}\\,\\text{d}x=$" :question/worked-solution "First, we substitute $u=2+{x}^{4}.$ Differentiating, we get\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=4{x}^{3}\\,⟹\\,\\text{d}u=4{x}^{3}\\text{d}x.\n$$\n\nSince $u\\to \\infty $ when $x\\to -\\infty ,$ the table for the limits of integration using the rule $u=2+{x}^{4}$ is as follows:\n\n| $x$ | $0$ | $-\\infty $ |\n| --- | --- | --- |\n| $u$ | $2$ | $\\infty $ |\n\nSo, the integral in terms of the new variable $u$ is\n\n$$\n\\begin{aligned}{\\int }_{-\\infty }^{0}\\frac{4{x}^{3}}{{(2+{x}^{4})}^{2}}\\,\\text{d}x & ={\\int }_{\\infty }^{2}\\frac{1}{{u}^{2}}\\,\\text{d}u \\\\  & =-{\\int }_{2}^{\\infty }\\frac{1}{{u}^{2}}\\,\\text{d}u.\\end{aligned}\n$$\n\nFinally, we proceed by setting the lower bound equal to some parameter $a,$ integrating as usual, and then taking the limit as $a\\to -\\infty .$\n\n$$\n\\begin{aligned}{\\int }_{-\\infty }^{0}\\frac{4{x}^{3}}{{(2+{x}^{4})}^{2}}\\,\\text{d}x & =-{lim}_{a\\to \\infty }{\\int }_{2}^{a}\\frac{1}{{u}^{2}}\\,\\text{d}u \\\\  & =-{lim}_{a\\to \\infty }{[-\\frac{1}{u}]}_{2}^{a} \\\\  & =-{lim}_{a\\to \\infty }(-\\frac{1}{a}+\\frac{1}{2}) \\\\  & =-\\frac{1}{2}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186193237 :knowledge-point/_questions [{:db/id #edb/ref 17592186192716 :knowledge-point/id #uuid "cc1fbb99-83e1-52ba-83f1-367de07351a6" :knowledge-point/title "Calculating an Improper Integral Using a Substitution"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2c9dd871-8794-5940-9040-b45ed2aefb11" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{2}}{2}" :db/id #edb/ref 17592186285178} {:answer/id #uuid "37603a20-d773-5b54-9dfb-a98db3280a5c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The integral diverges" :db/id #edb/ref 17592186285306} {:answer/id #uuid "9631e71c-c418-589d-aaaa-92ecad6c3df5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186286151} {:answer/id #uuid "e87a202e-4f0f-552e-a281-207262f89759" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{2}" :db/id #edb/ref 17592186286915} {:answer/id #uuid "f5eb99fe-c43e-5a78-a679-aa67521ebfd0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186287039}] :answer-field/correct {:answer/id #uuid "e87a202e-4f0f-552e-a281-207262f89759" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{2}" :db/id #edb/ref 17592186286915} :answer-field/id #uuid "9ea5ef19-3af1-5414-9744-b16864d7b309" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186287468}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "826720bb-562f-595c-b16e-c49b0073360a" :question/math-academy-id "q-20891" :question/problem "Evaluate the integral ${\\int }_{0}^{\\infty }\\frac{{e}^{-\\sqrt{2x}}}{\\sqrt{x}}\\,\\text{d}x.$" :question/worked-solution "First, we substitute $u=\\sqrt{x}.$ Differentiating, we get\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=\\frac{1}{2\\sqrt{x}}\\,⟹\\,2\\text{d}u=\\frac{1}{\\sqrt{x}}\\text{d}x.\n$$\n\nSince $u\\to \\infty $ when $x\\to \\infty ,$ the table for the limits of integration using the rule $u=\\sqrt{x}$ is as follows:\n\n| $x$ | $0$ | $\\infty $ |\n| --- | --- | --- |\n| $u$ | $0$ | $\\infty $ |\n\nSo, the integral in terms of the new variable $u$ is\n\n$$\n\\begin{aligned}{\\int }_{0}^{\\infty }\\frac{{e}^{-\\sqrt{2x}}}{\\sqrt{x}}\\,\\text{d}x & =2{\\int }_{0}^{\\infty }{e}^{-\\sqrt{2}u}\\,\\text{d}u.\\end{aligned}\n$$\n\nNow, we proceed by setting the upper bound equal to some parameter $a,$ integrating as usual, and then taking the limit as $a\\to \\infty .$\n\n$$\n\\begin{aligned}{\\int }_{0}^{\\infty }\\frac{{e}^{-\\sqrt{2x}}}{\\sqrt{x}}\\,\\text{d}x & =2{\\int }_{0}^{\\infty }{e}^{-\\sqrt{2}u}\\,\\text{d}u \\\\  & =2\\cdot {lim}_{a\\to \\infty }{\\int }_{0}^{a}{e}^{-\\sqrt{2}u}\\,\\text{d}u \\\\  & =2\\cdot {lim}_{a\\to \\infty }{[-\\frac{{e}^{-\\sqrt{2}u}}{\\sqrt{2}}]}_{0}^{a} \\\\  & =-\\sqrt{2}\\cdot {lim}_{a\\to \\infty }{[{e}^{-\\sqrt{2}u}]}_{0}^{a} \\\\  & =-\\sqrt{2}\\cdot ({lim}_{a\\to \\infty }\\frac{1}{{e}^{\\sqrt{2}a}}-1)\\end{aligned}\n$$\n\nNext, recall the end behavior of the function $y=\\frac{1}{{e}^{\\sqrt{2}x}},$ shown in the graph below:\n\n- ${lim}_{x\\to -\\infty }\\frac{1}{{e}^{\\sqrt{2}x}}=\\infty $\n\n- ${lim}_{x\\to \\infty }\\frac{1}{{e}^{\\sqrt{2}x}}=0$\n\n![](images/5e/5e9932629e5a201c2ada61157fdfa39351962a55116e2980157b1823907159f2.png)\n\nUsing this to evaluate our integral, we conclude that\n\n$$\n\\begin{aligned}{\\int }_{0}^{\\infty }\\frac{{e}^{-\\sqrt{2x}}}{\\sqrt{x}}\\,\\text{d}x & =-\\sqrt{2}\\cdot ({lim}_{a\\to \\infty }\\frac{1}{{e}^{\\sqrt{2}a}}-1) \\\\  & =-\\sqrt{2}\\cdot (0-1) \\\\  & =\\sqrt{2}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186288018 :knowledge-point/_questions [{:db/id #edb/ref 17592186092376 :knowledge-point/id #uuid "ebd2a5c8-5d15-589d-81c9-9b67f4e8f0b3" :knowledge-point/title "Finding an Integral Expression For the Arc Length of a Parametric Curve Containing Special Functions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "042ce01d-341b-5a8f-b26c-2bae1091ffbb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{4}{\\int }_{0}^{1}\\sqrt{2{e}^{2t}+4}\\,\\text{d}t" :db/id #edb/ref 17592186284821} {:answer/id #uuid "085052cd-1f3e-5f31-9ff8-08a93c8512b0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}{\\int }_{0}^{1}\\sqrt{4{e}^{2t}+1}\\,\\text{d}t" :db/id #edb/ref 17592186284852} {:answer/id #uuid "2277789f-926a-5240-a07d-b7aedc65a771" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}{\\int }_{0}^{1}\\sqrt{{e}^{t}+1}\\,\\text{d}t" :db/id #edb/ref 17592186285096} {:answer/id #uuid "ca8848d4-7288-585c-b944-73aa40d45c9a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{4}{\\int }_{0}^{1}\\sqrt{{e}^{t}+4}\\,\\text{d}t" :db/id #edb/ref 17592186286635} {:answer/id #uuid "d0070ef7-3de9-5565-a190-4c165235a08f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}{\\int }_{0}^{1}\\sqrt{{e}^{2t}+1}\\,\\text{d}t" :db/id #edb/ref 17592186286682}] :answer-field/correct {:answer/id #uuid "085052cd-1f3e-5f31-9ff8-08a93c8512b0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}{\\int }_{0}^{1}\\sqrt{4{e}^{2t}+1}\\,\\text{d}t" :db/id #edb/ref 17592186284852} :answer-field/id #uuid "d0b9c64d-9e93-55fe-a0fb-bcc5981e0b91" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186287575}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "809a8d30-1507-55ed-ad1d-5fa778afd784" :question/math-academy-id "q-20909" :question/problem "![](images/59/59704c6b8e643337113ab99b22eaeaac8d59ac3c15042409e8a0a8eac6ee54fd.png)\n\nWhich of the following gives the length of the curve defined by the parametric equations\n$x=\\frac{t}{2},\\,y={e}^{t}$\nfrom $t=0$ to $t=1$ (shown above)?" :question/worked-solution "To compute the arc length $L$ of a parametrically defined curve, we use the formula\n\n$$\nL={\\int }_{{t}_{1}}^{{t}_{2}}\\sqrt{{(\\frac{\\text{d}x}{\\text{d}t})}^{2}+{(\\frac{\\text{d}y}{\\text{d}t})}^{2}}\\,\\text{d}t.\n$$\n\nComputing the derivatives of $x$ and $y,$ we have\nWe have\n\n$$\n\\begin{aligned}\\frac{\\text{d}x}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}(\\frac{t}{2})=\\frac{1}{2}\\end{aligned}\n$$\n\nand\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}({e}^{t})={e}^{t}\\,.\\end{aligned}\n$$\n\nWe substitute these derivatives in the formula for arc length, and we get\n\n$$\n\\begin{aligned}L & ={\\int }_{{t}_{1}}^{{t}_{2}}\\sqrt{{(\\frac{\\text{d}x}{\\text{d}t})}^{2}+{(\\frac{\\text{d}y}{\\text{d}t})}^{2}}\\,\\text{d}t \\\\  & ={\\int }_{0}^{1}\\sqrt{{(\\frac{1}{2})}^{2}+{({e}^{t})}^{2}}\\,\\text{d}t \\\\  & ={\\int }_{0}^{1}\\sqrt{({e}^{2t})+(\\frac{1}{4})}\\,\\text{d}t \\\\  & =\\frac{1}{2}{\\int }_{0}^{1}\\sqrt{4{e}^{2t}+1}\\,\\text{d}t\\,.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186390388 :knowledge-point/_questions [{:db/id #edb/ref 17592186105745 :knowledge-point/id #uuid "97cd9132-458b-5234-a3d2-22b633acb74c" :knowledge-point/title "Reducing an Augmented Matrix for a Singular 2x2 System to REF and Solving the Resulting System"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a9973610-47f9-5f62-a4ae-54d727ff19bb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}x \\\\ y\\end{aligned}]=[\\begin{aligned}-1-2y \\\\ y\\end{aligned}],\\,y\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186390390} {:answer/id #uuid "c2ddc9c8-cf3c-5347-a18e-5fc3f7cd82d4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}x \\\\ y\\end{aligned}]=[\\begin{aligned}-2-4y \\\\ y\\end{aligned}],\\,y\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186390391} {:answer/id #uuid "4142878a-1989-59e7-bb13-e08f2f47a895" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}x \\\\ y\\end{aligned}]=[\\begin{aligned}2-4y \\\\ y\\end{aligned}],\\,y\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186390392} {:answer/id #uuid "15cec20b-2ee9-50b2-83e8-5d388cb51a75" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}x \\\\ y\\end{aligned}]=[\\begin{aligned}1-2y \\\\ y\\end{aligned}],\\,y\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186390393} {:answer/id #uuid "2cc15e06-5b06-530d-86f3-88d4d6831e6f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}x \\\\ y\\end{aligned}]=[\\begin{aligned}1+2y \\\\ y\\end{aligned}],\\,y\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186390394}] :answer-field/correct {:answer/id #uuid "a9973610-47f9-5f62-a4ae-54d727ff19bb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}x \\\\ y\\end{aligned}]=[\\begin{aligned}-1-2y \\\\ y\\end{aligned}],\\,y\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186390390} :answer-field/id #uuid "5c5b0769-2362-5bb9-8ad0-cec516d68985" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186390389}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "f0787607-5bca-5e97-b7f4-40db59c2425f" :question/math-academy-id "q-20963" :question/problem "Consider the augmented matrix $M$ given by \n\n$$\nM=[\\begin{aligned}1 & 2 & -1 \\\\ 8 & 16 & -8\\end{aligned}].\n$$\n\nUse the standard method of Gaussian elimination to reduce $M$ to row echelon form, and then find the general solution of the linear system represented by the matrix." :question/worked-solution "Reducing $M$ to echelon form, we have\n\n$$\n\\begin{aligned}M & ∼[\\begin{aligned}1 & 2 & -1 \\\\ 8 & 16 & -8\\end{aligned}] & {R}_{2} & :={R}_{2}+(-8){R}_{1} \\\\  & ∼[\\begin{aligned}1 & 2 & -1 \\\\ 0 & 0 & 0\\end{aligned}].\\end{aligned}\n$$\n\nThe corresponding system is now\n\n$$\n{\\begin{aligned}x+2y=-1 \\\\ 0x+0y=0.\\end{aligned}\n$$\n\nSince any pair of numbers $x,y$ is a solution of the final equation $0x+0y=0,$ we can remove this equation from the system. So, our system now consists of a single equation\n\n$$\nx+2y=-1.\n$$\n\nThe first variable $(x)$ is the basic variable, and the second variable $(y)$ is the free variable. Solving for the basic variable $(x)$ in terms of the free variable $(y),$ we get $x=-1-2y,$ and the general solution is\n\n$$\n{\\begin{aligned}x=-1-2y \\\\ y=y\\end{aligned}\n$$\n\nwhere $y$ is an arbitrary number. \n\nIn vector form, the general solution can be written as\n\n$$\n\\begin{aligned}[\\begin{aligned}x \\\\ y\\end{aligned}]=[\\begin{aligned}-1-2y \\\\ y\\end{aligned}],\\,y\\in (-\\infty ,\\infty ).\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186401853 :knowledge-point/_questions [{:db/id #edb/ref 17592186083240 :knowledge-point/id #uuid "8922ab07-5ac7-5f85-bfee-c30de7f4024a" :knowledge-point/title "Finding the Derivative of a Parametric Curve"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "886ea0dd-2f3b-5230-a912-ca494bbb228c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2e}" :db/id #edb/ref 17592186401855} {:answer/id #uuid "1b58ab2c-a7ae-5296-9ea9-aaaf06b0d86c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{{e}^{2}}" :db/id #edb/ref 17592186401856} {:answer/id #uuid "3480faea-4f30-5410-8c55-291a77967982" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{3e}" :db/id #edb/ref 17592186401857} {:answer/id #uuid "1933a3b0-751e-5adc-a9a1-355a8352674b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{{e}^{3}}" :db/id #edb/ref 17592186401858} {:answer/id #uuid "f9dd7c11-42ae-55e1-8e09-7e1133cc18c2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{e}" :db/id #edb/ref 17592186401859}] :answer-field/correct {:answer/id #uuid "f9dd7c11-42ae-55e1-8e09-7e1133cc18c2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{e}" :db/id #edb/ref 17592186401859} :answer-field/id #uuid "532bfa22-570e-5521-a58b-09bf6df9181b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186401854}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "4c14e172-0d42-58ef-86b2-05fb93de9caa" :question/math-academy-id "q-20990" :question/problem "![](images/58/5855e92b04ffbf8447d32c7edb190cd16046a13e8808e6ffaade1f59e414c869.png)\n\nFor the parametric curve (shown above)\n\n$$\nx=2t{e}^{t},\\,y={t}^{2}+2t,\\,0\\le t<\\infty ,\n$$\n\n find the derivative $\\frac{dy}{dx}$ at the point $P$ on the curve where $t=1.$" :question/worked-solution "We will use the formula\n\n$$\n\\frac{dy}{dx}=\\frac{{y}^{′}(t)}{{x}^{′}(t)}.\n$$\n\nDifferentiating $x$ and $y,$ we get\n\n$$\n{x}^{′}(t)=2{e}^{t}(t+1),\\,{y}^{′}(t)=2t+2.\n$$\n\n \n\nTherefore,\n\n$$\n\\frac{dy}{dx}=\\frac{2t+2}{2{e}^{t}(t+1)}=\\frac{1}{{e}^{t}}.\n$$\n\nAt the point where $t=1$ we have\n\n$$\n\\begin{aligned}\\frac{dy}{dx} & =\\frac{1}{{e}^{1}} \\\\  & =\\frac{1}{e}\\,.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186290264 :knowledge-point/_questions [{:db/id #edb/ref 17592186096626 :knowledge-point/id #uuid "a363f215-ed40-504a-bcae-620b7d585678" :knowledge-point/title "Finding Points of Inflection Using Differentiation When Some Points Must Be Discarded"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3de5b190-61e1-55c7-ad40-59ab30d5118b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "There are no points of inflection" :db/id #edb/ref 17592186288455} {:answer/id #uuid "7cdd630b-7f02-55cb-a455-637e9e9813ac" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=4" :db/id #edb/ref 17592186288881} {:answer/id #uuid "c81726a9-d66e-5c13-b114-de88b510add5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=3" :db/id #edb/ref 17592186289357} {:answer/id #uuid "ec2f0b44-9c24-554f-a678-fdd6e954d8c4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=-4" :db/id #edb/ref 17592186289595} {:answer/id #uuid "fbea8c18-109f-5234-886b-a8d50ec8b96c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=2" :db/id #edb/ref 17592186289695}] :answer-field/correct {:answer/id #uuid "3de5b190-61e1-55c7-ad40-59ab30d5118b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "There are no points of inflection" :db/id #edb/ref 17592186288455} :answer-field/id #uuid "0da697a5-73b9-5115-a518-7f204fd9907e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186289761}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "f17a5b4b-0b74-571a-8e3d-75e6d31adccd" :question/math-academy-id "q-21035" :question/problem "Find the $x$-coordinate of the point of inflection for $f(x)=12x-7+\\frac{3}{x}.$" :question/worked-solution "For continuous, twice-differentiable functions, we can determine possible points of inflection by solving the equation ${f}^{″}(x)=0.$ However, we must be sure to check that the concavity does indeed change at whatever points we find.\n\nFirst, we calculate the second derivative:\n\n$$\n\\begin{aligned}{f}^{′}(x) & =12-\\frac{3}{{x}^{2}} \\\\ {f}^{″}(x) & =\\frac{6}{{x}^{3}}\\end{aligned}\n$$\n\nNext, we solve ${f}^{″}(x)=0:$ \n\n$$\n\\frac{6}{{x}^{3}}=0\n$$\n\nThe equation above has no real solutions, so there are no points of inflection."}] [{:db/id #edb/ref 17592186390402 :knowledge-point/_questions [{:db/id #edb/ref 17592186105894 :knowledge-point/id #uuid "7d1252e9-f2ac-5adf-9cf5-ef48e35fb747" :knowledge-point/title "Determining the Image of an Object Formed by a Singular Transformation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "cd55c037-00e6-5219-914e-9a5a9bd7534e" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/e6/e667849ed8a214e7d17871b0f96f73f83c59eec2677bfbaeaab589e04cc89e61.png" :db/id #edb/ref 17592186390404} {:answer/id #uuid "f174cb91-e1ee-5d6c-90ef-6029cbaebf29" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/52/52266ff97300b29c85ac14f5b60b308d9e8a0e2fe3a01e8e0431b643e6a28922.png" :db/id #edb/ref 17592186390405} {:answer/id #uuid "071cdea1-0dac-5f25-b6f4-63481ba1e33c" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/1a/1a027e19617c0c62fd8f5247c6d1bbac894f9522ec9e90aec5b7ed05b3996b37.png" :db/id #edb/ref 17592186390406} {:answer/id #uuid "dd9aba44-7003-5d32-9bce-752796690c23" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/ca/cac3c2b4fb6191aa9a523b445d8533774f438d24556ea79b8e67a4d6c3867526.png" :db/id #edb/ref 17592186390407} {:answer/id #uuid "38ce622d-f9f2-50a8-99cd-404657278c3a" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/f7/f7033ca262624a9723186563638f5ff006d4174a82349be0812ac3de4c25af5e.png" :db/id #edb/ref 17592186390408}] :answer-field/correct {:answer/id #uuid "f174cb91-e1ee-5d6c-90ef-6029cbaebf29" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/52/52266ff97300b29c85ac14f5b60b308d9e8a0e2fe3a01e8e0431b643e6a28922.png" :db/id #edb/ref 17592186390405} :answer-field/id #uuid "8cfcca37-0c5f-5e1f-94b7-02dbf414d41e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186390403}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "f7e170ff-3ef3-51ef-bb76-d32ad791f4a6" :question/math-academy-id "q-21058" :question/problem "![](images/fe/fee79ec0b214a4ba87400b4b8c9dab2c623878d067821c572b26ae241625c48a.png)\n\nConsider the linear transformation $T$ with matrix representation $T,$ given by\n\n$$\nT=[\\begin{aligned}2 & 1 \\\\ 10 & 5\\end{aligned}].\n$$\n\nWhich of the following is the image of the triangle shown above under the action of $T?$" :question/worked-solution "To find the image of the triangle under the action of $T$, we first create a matrix $X$ containing all of the vertices of the triangle:\n\n$$\nX=[\\begin{aligned}1 & 1 & 2 \\\\ 0 & 1 & 1\\end{aligned}].\n$$\n\nNow, we compute the image of $X$ under the action of $T$ by calculating the matrix product $TX:$\n\n$$\n\\begin{aligned}TX & =[\\begin{aligned}2 & 1 \\\\ 10 & 5\\end{aligned}][\\begin{aligned}1 & 1 & 2 \\\\ 0 & 1 & 1\\end{aligned}] \\\\  & =[\\begin{aligned}2 & 3 & 5 \\\\ 10 & 15 & 25\\end{aligned}].\\end{aligned}\n$$\n\nTherefore, the coordinates of the image's vertices are $(2,10)$, $(3,15)$, and  $(5,25).$  Notice that all three points lie on the same line.\n\n![](images/bf/bf5987fde11416780a6a599e3952db7319e1c0e859e2439b7df70c5659bc6839.png)"}] [{:db/id #edb/ref 17592186290269 :knowledge-point/_questions [{:db/id #edb/ref 17592186105894 :knowledge-point/id #uuid "7d1252e9-f2ac-5adf-9cf5-ef48e35fb747" :knowledge-point/title "Determining the Image of an Object Formed by a Singular Transformation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0b93f461-1c7c-56fa-9e47-cf342c2182e3" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/40/40f352980b38be63b071b160953eff23a98996dce58c5f616e10958a8a70182e.png" :db/id #edb/ref 17592186288119} {:answer/id #uuid "6d878e48-5182-54e0-9a21-7580d9175240" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/ee/ee4a96b2b1106fbd1a5ec222c3f7f2a5e5a9e84c9bfe539aeb29a1918943aef9.png" :db/id #edb/ref 17592186288798} {:answer/id #uuid "84bcd4c8-95e4-5ba2-812e-8d15253507a6" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/dc/dc5ad781e838e597706600633701871006cd59fd3db60344cf34aaddb4200da8.png" :db/id #edb/ref 17592186288924} {:answer/id #uuid "bae133f8-955a-587b-8e5f-630c8d7aa03e" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/92/92beb71e7d09cba01f2eeb82a60ca3b0b3929064e4f16da3af104db8c5eaa8df.png" :db/id #edb/ref 17592186289265} {:answer/id #uuid "be768ba3-bb22-5082-9403-9396a068e5ec" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/b4/b4d2150d92ff14a654fb7079a17d7bd75abe721c0d37d4075d5a92635bafc170.png" :db/id #edb/ref 17592186289285}] :answer-field/correct {:answer/id #uuid "6d878e48-5182-54e0-9a21-7580d9175240" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/ee/ee4a96b2b1106fbd1a5ec222c3f7f2a5e5a9e84c9bfe539aeb29a1918943aef9.png" :db/id #edb/ref 17592186288798} :answer-field/id #uuid "9224408d-95cf-5c4a-a8cc-58f66c41fcd9" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186290058}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "dcfd5567-90cc-5d33-9aaa-36581e272ed2" :question/math-academy-id "q-21063" :question/problem "![](images/65/6501b1a7e9429c786905c11835410111c32ac0337f1ba63bff130d327350316c.png)\n\nConsider the linear transformation $T$ with matrix representation $T,$ given by\n\n$$\nT=[\\begin{aligned}2 & 4 \\\\ 1 & 2\\end{aligned}]\n$$\n\nWhich of the following is the image of the triangle shown above under the action of $T?$" :question/worked-solution "To find the image of the triangle under the action of $T$, we first create a matrix $X$ containing all of the vertices of the triangle:\n\n$$\nX=[\\begin{aligned}1 & 2 & 1 \\\\ 1 & 1 & 2\\end{aligned}].\n$$\n\nNow, we compute the image of $X$ under the action of $T$ by calculating the matrix product $TX:$\n\n$$\n\\begin{aligned}TX & =[\\begin{aligned}2 & 4 \\\\ 1 & 2\\end{aligned}][\\begin{aligned}1 & 2 & 1 \\\\ 1 & 1 & 2\\end{aligned}] \\\\  & =[\\begin{aligned}6 & 8 & 10 \\\\ 3 & 4 & 5\\end{aligned}].\\end{aligned}\n$$\n\nTherefore, the coordinates of the image's vertices are $(6,3)$, $(8,4)$ and $(10,5).$ Notice that all three points lie on the same line.\n\n![](images/a9/a91af151d3dc0e48aef0eef58012f6c9f72aaff02aafae2d55fe0714c29c96e3.png)"}] [{:db/id #edb/ref 17592186290270 :knowledge-point/_questions [{:db/id #edb/ref 17592186105894 :knowledge-point/id #uuid "7d1252e9-f2ac-5adf-9cf5-ef48e35fb747" :knowledge-point/title "Determining the Image of an Object Formed by a Singular Transformation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "12965d46-110f-51d1-be49-c816e432974f" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/46/461ff9fb5ef66239eb81314f761fac9ceb32b3bc88df6940b61445c752fe3d0c.png" :db/id #edb/ref 17592186288163} {:answer/id #uuid "3aac1081-e617-52cc-948d-89da29406dee" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/ed/ed8a2354f8cc04f998875f599a52b50e6c64cafe8976f1bea176772543e295ac.png" :db/id #edb/ref 17592186288440} {:answer/id #uuid "430c8598-7cdf-553d-b43a-6da1aef94e4e" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/0a/0af059340bdef0548876baad9bcdf990f6bc92330617dde33c18c00578aecad1.png" :db/id #edb/ref 17592186288488} {:answer/id #uuid "845c793e-ffa5-5710-b7de-4b57f2fa8dca" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/da/da61a7fd99ce683be4e66d3708ddf15c969b038f0250dc4c024ace870c3f7544.png" :db/id #edb/ref 17592186288921} {:answer/id #uuid "8e357473-2063-5ea1-bd53-50d60adebac7" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/bf/bf7cc4e728cd1ade741c55b2fbb54720220e0e09a8521a150300532b4e3ee9ed.png" :db/id #edb/ref 17592186288984}] :answer-field/correct {:answer/id #uuid "430c8598-7cdf-553d-b43a-6da1aef94e4e" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/0a/0af059340bdef0548876baad9bcdf990f6bc92330617dde33c18c00578aecad1.png" :db/id #edb/ref 17592186288488} :answer-field/id #uuid "90738e29-17d5-5aba-96ca-bc4630f7480f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186290053}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "c723b05a-0b3d-5522-bbda-5b3f8ac9a3ef" :question/math-academy-id "q-21065" :question/problem "![](images/db/db7d2b33f2badad28b754d4482047a33bb37469ed8b7b17859b10552840e2f51.png)\n\nConsider the linear transformation $T$ with matrix representation $T,$ given by \n\n$$\nT=[\\begin{aligned}-2 & -1 \\\\ 4 & 2\\end{aligned}]\n$$\n\nWhich of the following is the image of the triangle shown above under the action of $T?$" :question/worked-solution "To find the image of the triangle under the action of $T$, we first create a matrix $X$ containing all of the vertices of the triangle:\n\n$$\nX=[\\begin{aligned}1 & 2 & 0 \\\\ 0 & 2 & 1\\end{aligned}].\n$$\n\nNow, we compute the image of $X$ under the action of $T$ by calculating the matrix product $TX:$\n\n$$\n\\begin{aligned}TX & =[\\begin{aligned}-2 & -1 \\\\ 4 & 2\\end{aligned}][\\begin{aligned}1 & 2 & 0 \\\\ 0 & 2 & 1\\end{aligned}] \\\\  & =[\\begin{aligned}-2 & -6 & -1 \\\\ 4 & 12 & 2\\end{aligned}].\\end{aligned}\n$$\n\nTherefore, the coordinates of the image's vertices are $(-2,4)$, \n$(-6,12)$ and $(-1,2).$ Notice that all three points lie on the same line.\n\n![](images/2e/2e1dde461c6244a59672fc28c842b70a30297ac7a8c7e7cf2095a973cd1860cd.png)"}] [{:db/id #edb/ref 17592186290275 :knowledge-point/_questions [{:db/id #edb/ref 17592186100816 :knowledge-point/id #uuid "41b7d83f-3b9b-556c-9e49-13df9c3b597e" :knowledge-point/title "Integrating Functions Containing the Natural Logarithm"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "03286992-4e5f-59a4-a2d5-770d425c81b4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}{ln}^{2}⁡({x}^{3})+C" :db/id #edb/ref 17592186288052} {:answer/id #uuid "6e81cefb-bd19-5b54-87e4-5853800e6eef" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{3}{ln}^{2}⁡({x}^{3})+C" :db/id #edb/ref 17592186288803} {:answer/id #uuid "743796f2-4839-5a83-98da-54020ef03b9f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2{ln}^{3}⁡({x}^{3})+C" :db/id #edb/ref 17592186288840} {:answer/id #uuid "e05b7865-c956-5c62-8883-4ec3a98f9db5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{ln}^{2}⁡({x}^{3})+C" :db/id #edb/ref 17592186289530} {:answer/id #uuid "e912ed20-701c-547f-810e-d68e4d482abc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3{ln}^{3}⁡({x}^{2})+C" :db/id #edb/ref 17592186289580}] :answer-field/correct {:answer/id #uuid "e05b7865-c956-5c62-8883-4ec3a98f9db5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{ln}^{2}⁡({x}^{3})+C" :db/id #edb/ref 17592186289530} :answer-field/id #uuid "1792ea8a-fc61-5c07-8c7f-9f2479778c97" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186289786}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "944eb4d2-a6ad-5507-ae41-f7e9e113c32b" :question/math-academy-id "q-210742" :question/problem "Calculate the integral $\\int \\frac{6\\operatorname{ln}⁡({x}^{3})}{x}\\,\\text{d}x.$" :question/worked-solution "Let's set $u=\\operatorname{ln}⁡({x}^{3}).$ Then, we have\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=\\frac{1}{{x}^{3}}\\cdot 3{x}^{2}=\\frac{3}{x}\\,⟹\\,\\frac{1}{3}\\text{d}u=\\frac{\\text{d}x}{x}.\n$$\n\nUsing the above, we can write the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}\\int \\frac{6\\operatorname{ln}⁡({x}^{3})}{x}\\,\\text{d}x & =6\\int \\operatorname{ln}⁡({x}^{3})\\cdot \\frac{\\text{d}x}{x}\\cdot  \\\\  & =6\\int u\\cdot (\\frac{1}{3}\\text{d}u) \\\\  & =\\frac{6}{3}\\int u\\,\\text{d}u \\\\  & =2\\cdot \\frac{{u}^{2}}{2}+C \\\\  & ={u}^{2}+C \\\\  & ={ln}^{2}⁡({x}^{3})+C\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186290279 :knowledge-point/_questions [{:db/id #edb/ref 17592186100813 :knowledge-point/id #uuid "a92cdaeb-45c3-50c5-aa7d-2d07f846ea55" :knowledge-point/title "Finding a Variable Point Closest to a Fixed Point"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "21bc8bbe-bd07-595d-b14a-d312b3d16353" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "10" :db/id #edb/ref 17592186288247} {:answer/id #uuid "60be61b3-26f0-5b06-816d-c071a4d9a7dd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186288709} {:answer/id #uuid "64047eab-4808-5b44-872f-676659d49d88" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186288734} {:answer/id #uuid "a99733d3-a16b-5b8f-8954-db9ac5952b85" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186289156} {:answer/id #uuid "fb69cfc1-2f09-50d7-be09-ec781bb293db" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-5" :db/id #edb/ref 17592186289691}] :answer-field/correct {:answer/id #uuid "60be61b3-26f0-5b06-816d-c071a4d9a7dd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186288709} :answer-field/id #uuid "5aa5427a-0b49-5a8f-ba1b-64703df4cffc" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186289922}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "e6097e0b-0323-55bb-85aa-6c1aebe888e3" :question/math-academy-id "q-210773" :question/problem "If the distance between the points $(3a-4,a+2)$ and $(-2,6)$ is minimized, then $a=$" :question/worked-solution "First, let's compute the *squared* distance $S(a)$ between the two points. We have\n\n$$\n\\begin{aligned}S(a) & ={(3a-4-(-2))}^{2}+{(a+2-6)}^{2} \\\\  & =(3a-2)^{2}+(a-4)^{2} \\\\  & =9{a}^{2}-12a+4+{a}^{2}-8a+16 \\\\  & =10{a}^{2}-20a+20.\\end{aligned}\n$$\n\nSince we want to minimize $S,$ we compute the derivative ${S}^{′}(a).$ This gives\n\n$$\n\\begin{aligned}{S}^{′}(a) & =20a-20.\\end{aligned}\n$$\n\nThe stationary points of $S(a)$ are the points where the derivative ${S}^{′}(a)=0.$ Solving this equation, we get\n\n$$\n\\begin{aligned}{S}^{′}(a) & =0 \\\\ 20a-20 & =0 \\\\ a & =1.\\end{aligned}\n$$\n\nWe can see that ${S}^{″}(1)=20>0.$ Therefore, the squared distance (and therefore the actual distance) reaches a minimum when $b=1.$"}] [{:db/id #edb/ref 17592186083613 :knowledge-point/_questions [{:db/id #edb/ref 17592186083278 :knowledge-point/id #uuid "3fc81cba-b997-54bc-9e11-0a4ff130833e" :knowledge-point/title "Determining the Points Where the Tangent is Horizontal or Vertical"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9a0fa5cb-58b2-5991-aeb3-3c72630b91f4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$t = \\frac{π}{2}$ only" :db/id #edb/ref 17592186080742} {:answer/id #uuid "d40ce140-4fa5-5e19-a6d2-c2ed4122946e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$t = \\frac{π}{2}$ and $t = \\frac{3π}{2}$" :db/id #edb/ref 17592186080743} {:answer/id #uuid "ebdb6ae8-5736-5ecb-a2b0-06e71866c8c9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$t = \\frac{3π}{2}$ only" :db/id #edb/ref 17592186080744} {:answer/id #uuid "1f118b88-363d-549d-8d78-43f7f7a3fe35" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$t = \\frac{π}{4}$ and $t = \\frac{3π}{4}$" :db/id #edb/ref 17592186080745} {:answer/id #uuid "416acf6e-914c-5f39-8409-93bf2a0d33b4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$t = \\frac{π}{4}$ only" :db/id #edb/ref 17592186080746}] :answer-field/id #uuid "b486e99f-74f6-58c2-873a-74bcf30e0b85" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186080741} {:answer-field/choices [{:answer/id #uuid "177fc0fe-e31a-5f41-9aab-356a0006fb3a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$t=\\frac{3\\pi }{2}$ only" :db/id #edb/ref 17592186401861} {:answer/id #uuid "10683790-7483-51aa-9bcd-7831b9d3d041" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$t=\\frac{\\pi }{2}$ and $t=\\frac{3\\pi }{2}$" :db/id #edb/ref 17592186401862} {:answer/id #uuid "1843433f-102c-52fd-970b-a78c3d6b3a06" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$t=\\frac{\\pi }{4}$ only" :db/id #edb/ref 17592186401863} {:answer/id #uuid "50097778-e660-56b2-929d-8baced007acc" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$t=\\frac{\\pi }{4}$ and $t=\\frac{3\\pi }{4}$" :db/id #edb/ref 17592186401864} {:answer/id #uuid "835e0688-6998-5bbb-863e-83fa6322632b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$t=\\frac{\\pi }{2}$ only" :db/id #edb/ref 17592186401865}] :answer-field/correct {:answer/id #uuid "10683790-7483-51aa-9bcd-7831b9d3d041" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$t=\\frac{\\pi }{2}$ and $t=\\frac{3\\pi }{2}$" :db/id #edb/ref 17592186401862} :answer-field/id #uuid "f9d95bd4-f167-53f1-8c45-da39995abe7c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186401860}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "fbd878d8-e318-5109-beb9-89ecefca7f9d" :question/math-academy-id "q-21081" :question/problem "A curve is defined by the parametric equations\n\n$$\nx=4\\operatorname{sin}⁡t+7,\\,y=4\\operatorname{cos}⁡t+10,\\,0\\le t<2\\pi .\n$$\n\nDetermine the values of $t$ at which the tangent to the curve is vertical." :question/worked-solution "The slope $m$ of a tangent line to a curve defined parametrically is given by\n\n$$\nm=\\frac{{y}^{′}(t)}{{x}^{′}(t)}.\n$$\n\nThe tangent line is vertical if ${x}^{′}(t)=0$ while ${y}^{′}(t)\\ne 0.$\n\nSo, we first find the derivatives of $x$ and $y:$\n\n$$\n{x}^{′}(t)=4\\operatorname{cos}⁡t,\\,{y}^{′}(t)=-4\\operatorname{sin}⁡t.\n$$\n\nSolving ${x}^{′}(t)=0$ gives\n\n$$\n4\\operatorname{cos}⁡t=0\\,⟹\\,t=\\frac{\\pi }{2},\\frac{3\\pi }{2}.\n$$\n\nNow, we note that \n\n$$\n\\begin{aligned}{y}^{′}(\\frac{\\pi }{2}) & =-4\\ne 0, \\\\ {y}^{′}(\\frac{3\\pi }{2}) & =4\\ne 0,\\end{aligned}\n$$\n\nwhich confirms that the tangent to the curve is indeed vertical when $t=\\frac{\\pi }{2}$ and $t=\\frac{3\\pi }{2}.$"}] [{:db/id #edb/ref 17592186290282 :knowledge-point/_questions [{:db/id #edb/ref 17592186198247 :knowledge-point/id #uuid "cbd4e2eb-d2c8-5447-9a28-4d7da6744712" :knowledge-point/title "Determining the Closest Points on a Curve to a Point"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0342ff8f-d439-5593-b5f6-c038919e39e4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=\\frac{7}{3}" :db/id #edb/ref 17592186288053} {:answer/id #uuid "3e1d37bb-15b5-5e2c-ad28-59b476dfddba" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=\\sqrt{5}" :db/id #edb/ref 17592186288457} {:answer/id #uuid "74e6fe07-2efb-5d94-8929-9c6790535033" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=\\frac{\\sqrt{2}+3}{2}" :db/id #edb/ref 17592186288845} {:answer/id #uuid "85338361-a595-5ae6-967f-ea8e643856dc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=2" :db/id #edb/ref 17592186288927} {:answer/id #uuid "97c7e2c1-5f02-59b5-8d8e-ad45dc736f11" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=\\frac{9}{4}" :db/id #edb/ref 17592186289051}] :answer-field/correct {:answer/id #uuid "85338361-a595-5ae6-967f-ea8e643856dc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=2" :db/id #edb/ref 17592186288927} :answer-field/id #uuid "a33d0e76-9951-5841-a985-3a0a11708843" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186290093}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "5031c299-7002-5210-9ac6-cb744b05632c" :question/math-academy-id "q-211191" :question/problem "![](images/4e/4e343d2884532c006e83cd4c90e70a6cd9af9247194c8a7f8832ef8cbaf293b5.png)\n\nFind the $x$-coordinate of the point on the curve $y=\\sqrt{{x}^{2}+2}$ that is closest to the point $(4,0).$" :question/worked-solution "Let us consider the *squared* distance $S$ between $(4,0)$ and a general point $P(x,y)$:\n\n$$\nS=(x-4)^{2}+(y)^{2}\n$$\n\nWe require that the point $P$ lies on the curve $y=\\sqrt{{x}^{2}+2}.$ Substituting this into the above gives\n\n$$\n\\begin{aligned}S(x) & =(x-4)^{2}+(y)^{2} \\\\  & =(x-4)^{2}+{(\\sqrt{{x}^{2}+2})}^{2} \\\\  & =(x-4)^{2}+{x}^{2}+2 \\\\  & ={x}^{2}-8x+16+{x}^{2}+2 \\\\  & =2{x}^{2}-8x+18.\\end{aligned}\n$$\n\nTo find the minimum distance, we take the first derivative of $S(x)$ and equate it to zero. This gives the following:\n\n$$\n\\begin{aligned}{S}^{′}(x)=4x-8 & =0 \\\\ 4x & =8 \\\\ x & =2\\end{aligned}\n$$\n\nWe can see that ${S}^{″}(x)=4>0.$ Therefore, $x=2$ is a minimum of $S.$\n\nSo, the squared distance (and therefore the actual distance) is minimized when $x=2.$"}] [{:db/id #edb/ref 17592186290283 :knowledge-point/_questions [{:db/id #edb/ref 17592186198247 :knowledge-point/id #uuid "cbd4e2eb-d2c8-5447-9a28-4d7da6744712" :knowledge-point/title "Determining the Closest Points on a Curve to a Point"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "16c5f668-99cc-57ae-9aa1-c42826108073" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=2\\sqrt{2}" :db/id #edb/ref 17592186288184} {:answer/id #uuid "198ad89c-6e8f-5eae-9cfe-e55c408928c9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=\\sqrt{5}" :db/id #edb/ref 17592186288195} {:answer/id #uuid "1cbd5568-6840-5618-99ef-43df7bb7a7de" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=\\frac{5}{2}" :db/id #edb/ref 17592186288217} {:answer/id #uuid "90e67383-12a4-5bfc-b46d-0b975463386c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=2" :db/id #edb/ref 17592186289003} {:answer/id #uuid "978d403e-cf60-5347-a7d6-7c079d3aaddc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=\\frac{\\sqrt{5}}{2}" :db/id #edb/ref 17592186289047}] :answer-field/correct {:answer/id #uuid "1cbd5568-6840-5618-99ef-43df7bb7a7de" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=\\frac{5}{2}" :db/id #edb/ref 17592186288217} :answer-field/id #uuid "17bd9008-7bf4-5734-b9a7-fdab0718b66f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186289788}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "0e8dbfeb-f356-5014-87e7-43786a605372" :question/math-academy-id "q-211194" :question/problem "Find the $x$-coordinate of the point on the curve $y=\\sqrt{x-2}+2$ that is closest to the point $(3,2).$" :question/worked-solution "Let us consider the *squared* distance $S$ between $(3,2)$ and a general point $P(x,y)$:\n\n$$\nS=(x-3)^{2}+(y-2)^{2}\n$$\n\nWe require that the point $P$ lies on the curve $y=\\sqrt{x-2}+2.$ Substituting this into the above gives\n\n$$\n\\begin{aligned}S(x) & =(x-3)^{2}+(y-2)^{2} \\\\  & =(x-3)^{2}+{(\\sqrt{x-2}+2-2)}^{2} \\\\  & ={x}^{2}-6x+9+x-2 \\\\  & ={x}^{2}-5x+7.\\end{aligned}\n$$\n\nTo find the minimum distance, we take the first derivative of $S(x)$ and equate it to zero. This gives the following:\n\n$$\n\\begin{aligned}{S}^{′}(x)=2x-5 & =0 \\\\ 2x & =5 \\\\ x & =\\frac{5}{2}\\end{aligned}\n$$\n\nWe can see that ${S}^{″}(\\frac{5}{2})=2>0.$ Therefore, $x=\\frac{5}{2}$ is a minimum of $S.$\n\nSo, the squared distance (and therefore the actual distance) is minimized when $x=\\frac{5}{2}.$"}] [{:db/id #edb/ref 17592186290284 :knowledge-point/_questions [{:db/id #edb/ref 17592186198248 :knowledge-point/id #uuid "2a7dfacc-de7b-555f-b83a-7b2c6faf69df" :knowledge-point/title "Determining the Smallest Distance From a Point to a Curve"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "074f716e-2e1b-5d2a-adf7-dac54c993fd3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\sqrt{5}" :db/id #edb/ref 17592186288089} {:answer/id #uuid "33906468-1f66-5e41-af17-836effeb6820" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "9" :db/id #edb/ref 17592186288370} {:answer/id #uuid "34d28119-6787-50e6-a07d-952c46b4a9a9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{5}" :db/id #edb/ref 17592186288383} {:answer/id #uuid "cc05eea3-2e99-5be5-8c48-6c4a43448f71" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186289387} {:answer/id #uuid "e3a89921-3e75-5a98-8e99-2b7de138d845" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\sqrt{2}" :db/id #edb/ref 17592186289544}] :answer-field/correct {:answer/id #uuid "cc05eea3-2e99-5be5-8c48-6c4a43448f71" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186289387} :answer-field/id #uuid "0a63764c-1a76-583d-8869-a2b58aa2a435" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186289750}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "70d7053b-bbdd-5456-80ff-2953b5e960e3" :question/math-academy-id "q-211282" :question/problem "What is the least distance between the curve $y=\\sqrt{2x}+2$ and the point $P(5,2)?$" :question/worked-solution "Let us consider the *squared* distance $S$ between $(5,2)$ and a general point $P(x,y)$:\n\n$$\n\\begin{aligned}S & =(x-5)^{2}+(y-2)^{2}\\end{aligned}\n$$\n\nWe require that the point $P$ lies on the curve $y=\\sqrt{2x}+2.$ Substituting this into the above gives\n\n$$\n\\begin{aligned}S & =(x-5)^{2}+(y-2)^{2} \\\\  & =(x-5)^{2}+(\\sqrt{2x}+2-2)^{2} \\\\  & =(x-5)^{2}+(\\sqrt{2x})^{2} \\\\  & ={x}^{2}-10x+25+2x \\\\  & ={x}^{2}-8x+25.\\end{aligned}\n$$\n\nTo find the minimum distance, we take the first derivative of $S(x)$ and equate it to zero. This gives the following:\n\n$$\n\\begin{aligned}{S}^{′}(x)=2x-8 & =0 \\\\ 2x & =8 \\\\ x & =\\frac{8}{2} \\\\ x & =4\\end{aligned}\n$$\n\nWe can see that ${S}^{″}(x)=2>0.$ Therefore, $x=4$ is a minimum of $S.$\n\nSince $S$ gives the squared distance between the two points, the actual distance $d$ between the two points when $x=4$ is given by\n\n$$\nd=\\sqrt{S(4)}.\n$$\n\nComputing this quantity, we get\n\n$$\n\\begin{aligned}d & =\\sqrt{S(4)} \\\\  & =\\sqrt{{4}^{2}-8(4)+25} \\\\  & =\\sqrt{16-32+25} \\\\  & =\\sqrt{9} \\\\  & =3.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186290287 :knowledge-point/_questions [{:db/id #edb/ref 17592186059670 :knowledge-point/id #uuid "e6eef35a-3502-5429-bd71-fb5bd0e8efc8" :knowledge-point/title "Identifying Extrema on Transformed Curves"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "01b3ee48-738d-5154-93f4-593da455f6f8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(4,6)" :db/id #edb/ref 17592186288038} {:answer/id #uuid "02202242-35fc-558e-b9c0-5e30f23f7048" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(4,0)" :db/id #edb/ref 17592186288042} {:answer/id #uuid "7017f50c-dcb4-516e-bbbc-55369bab2f30" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(1,0)" :db/id #edb/ref 17592186288810} {:answer/id #uuid "c4904f95-4b3c-5515-9fcf-0a99b245182b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(1,-3)" :db/id #edb/ref 17592186289330} {:answer/id #uuid "cbce72d8-a3b3-5305-909c-46fd579eba75" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(2,6)" :db/id #edb/ref 17592186289382}] :answer-field/correct {:answer/id #uuid "7017f50c-dcb4-516e-bbbc-55369bab2f30" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(1,0)" :db/id #edb/ref 17592186288810} :answer-field/id #uuid "09418823-c229-5178-abcd-3466929f3782" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186289745}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "c0430c7a-d01d-554d-86e5-a8ca9cccf773" :question/math-academy-id "q-211462" :question/problem "![](images/80/8000655c1943c60282d8844a2ae965b6415e21962c44309cd68806f04744b806.png)\n\nThe diagram above shows the global minimum and maximum of the function $y=f(x).$ What is the global maximum of $y=-f(2x)+3?$" :question/worked-solution "Notice that the graph of $y=-f(2x)+3$ can be obtained from the graph of $y=f(x)$ by \n\n- stretching it by a scale factor of $\\frac{1}{2}$ parallel to the $x$-axis,\n\n- flipping it across the $x$-axis, and finally\n\n- translating it by $3$ units up.\n\nSince one of these transformations flips the graph across the $x$-axis, the combined transformation maps the global **minimum** of $y=f(x)$ to the global **maximum** of $y=-f(2x)+3.$ So, we need to find the image of $(2,3),$ the global minimum of $y=f(x),$ under the transformation. \n\nTo plot $y=-f(2x)+3,$ we apply the following steps: \n\n- First, we take the graph $y=f(x)$ that passes through $(2,3).$\n\n- Then, we stretch the graph  along the $x$-axis by a scale factor of $\\frac{1}{2}$ and get the graph of $y=f(2x).$ After this transformation, the point $(2,3)$ will be mapped to the point\n\n$$\n(\\frac{1}{2}\\cdot 2,3)=(1,3).\n$$\n\n- Next, we flip the result across the $x$-axis and get the graph of $y=-f(2x).$ After this transformation, the point $(1,3)$ will be mapped to the point\n\n$$\n(1,-1\\cdot 3)=(1,-3).\n$$\n\n- Finally, we translate the result by $3$ units up and get the graph of $y=-f(2x)+3.$ After this transformation, the point $(1,-3)$ will be mapped to the point\n\n$$\n(1,-3+3)=(1,0).\n$$\n\nTherefore, the global maximum of $y=-f(2x)+3$ is $(1,0).$"}] [{:db/id #edb/ref 17592186083615 :knowledge-point/_questions [{:db/id #edb/ref 17592186083280 :knowledge-point/id #uuid "12a5ad95-0cc9-53c5-8e1c-dae35d1c4447" :knowledge-point/title "Determining the Points Where the Normal is Horizontal or Vertical"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0deb773d-8fd3-5717-8d81-b036329021ad" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "t=1" :db/id #edb/ref 17592186288130} {:answer/id #uuid "2b9ee4d4-6360-5ed2-836d-031b9471868c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "t=\\frac{1}{3}" :db/id #edb/ref 17592186288317} {:answer/id #uuid "cebe0140-f0cc-5ccb-ac3d-d23a3bad85d0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "t=2" :db/id #edb/ref 17592186289412} {:answer/id #uuid "d5e4345a-11f1-5c37-a93b-12a41d947a55" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "t=\\frac{1}{2}" :db/id #edb/ref 17592186289450} {:answer/id #uuid "e4544b18-b948-5075-9873-247a5ee72340" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "t=0" :db/id #edb/ref 17592186289547}] :answer-field/correct {:answer/id #uuid "e4544b18-b948-5075-9873-247a5ee72340" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "t=0" :db/id #edb/ref 17592186289547} :answer-field/id #uuid "ad14c4bb-1d4a-5d58-9bcb-70314b824013" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186290112}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "ad8de0d6-0fb0-5332-a3cd-f5bf44efff31" :question/math-academy-id "q-21207" :question/problem "A curve is defined by the parametric equations\n\n$$\nx={e}^{2t},\\,y={t}^{2},\\,0\\le t\\le 2.\n$$\n\nDetermine the value of the parameter $t$ at which the normal line to the curve is vertical." :question/worked-solution "The normal line is vertical when the tangent to the curve is horizontal. Therefore, we require ${y}^{′}(t)=0$ while ${x}^{′}(t)\\ne 0.$\n\nSo, we first find the derivatives of $x$ and $y:$\n\n$$\n{x}^{′}(t)=2{e}^{2t},\\,{y}^{′}(t)=2t\n$$\n\nSolving ${y}^{′}(t)=0$ gives\n\n$$\n2t=0\\,⟹\\,t=0.\n$$\n\nNow, we note that\n\n$$\n{x}^{′}(0)=2{e}^{0}=2\\ne 0,\\,\\,\n$$\n\nwhich confirms that the normal to the curve is indeed vertical when $t=0.$"}] [{:db/id #edb/ref 17592186290294 :knowledge-point/_questions [{:db/id #edb/ref 17592186105703 :knowledge-point/id #uuid "84c96375-27d5-5ada-a952-34e09b3e92bf" :knowledge-point/title "Perpendicular Vectors"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "05f5cec0-bb91-5c28-a043-4592ab711f53" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186288076} {:answer/id #uuid "5aa80b1b-8d9e-53e5-b4ff-3afd65b4f60b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-10" :db/id #edb/ref 17592186288664} {:answer/id #uuid "69174e17-b083-51ab-a263-552d37887450" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186288772} {:answer/id #uuid "7f12c795-1d8e-5fc7-8db2-9ce3db4be399" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-5" :db/id #edb/ref 17592186288894} {:answer/id #uuid "a9b8268e-e1e9-5fc0-968f-daa50516ca35" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186289158}] :answer-field/correct {:answer/id #uuid "5aa80b1b-8d9e-53e5-b4ff-3afd65b4f60b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-10" :db/id #edb/ref 17592186288664} :answer-field/id #uuid "9dafe033-6f62-51c0-aef0-ed6ade7a0953" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186290079}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "ff2e4ed3-b952-5f49-9d70-f52c7f12daca" :question/math-academy-id "q-212457" :question/problem "Let $a=⟨0,1,-5⟩$ and $b=⟨6,x,-2⟩.$ Given that the projection of $a$ onto $b$ is the zero vector, find the value of $x.$" :question/worked-solution "Since $a$ is a nonzero vector, its projection onto another nonzero vector $b$ equals the zero vector only when the vectors are perpendicular. \n\nSo, we must have\n\n$$\na⊥b\\,⟹\\,a\\cdot b=0.\n$$\n\nComputing the dot product, we obtain\n\n$$\n\\begin{aligned}a\\cdot b & ={a}_{x}\\cdot {b}_{x}+{a}_{y}\\cdot {b}_{y}+{a}_{z}\\cdot {b}_{z} \\\\  & =0\\cdot 6+1\\cdot x+(-5)\\cdot (-2) \\\\  & =x+10.\\end{aligned}\n$$\n\nSetting the dot product equal to $0,$ we get\n\n$$\n\\begin{aligned}a\\cdot b & =0 \\\\ x+10 & =0 \\\\ x & =-10.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186390409 :knowledge-point/_questions [{:db/id #edb/ref 17592186184139 :knowledge-point/id #uuid "ecbf45e4-67a6-58cd-9655-4a339de64db5" :knowledge-point/title "Inequalities Involving Horizontal and Vertical Lines"}] :que