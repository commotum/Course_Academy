nswer/id #uuid "3c3666f3-ba98-51a9-b678-f25e043d3a37" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y={(\\frac{1}{9})}^{x}+3.5" :db/id #edb/ref 17592186401917} {:answer/id #uuid "e8039e0c-f293-5ce4-b395-a4064a0685bd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y={(\\frac{1}{9})}^{x}-2.5" :db/id #edb/ref 17592186401918} {:answer/id #uuid "a5f24666-89d0-5332-bb2a-21f966094be5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y={(\\frac{1}{9})}^{x}-3.5" :db/id #edb/ref 17592186401919} {:answer/id #uuid "a479a80c-f0e1-5b4f-9f67-06b99cd086bd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y={(\\frac{1}{9})}^{x}+1.5" :db/id #edb/ref 17592186401920} {:answer/id #uuid "266f8f59-63e6-5980-a4b9-749b4fb8201c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y={(\\frac{1}{9})}^{x}+2.5" :db/id #edb/ref 17592186401921}] :answer-field/correct {:answer/id #uuid "266f8f59-63e6-5980-a4b9-749b4fb8201c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y={(\\frac{1}{9})}^{x}+2.5" :db/id #edb/ref 17592186401921} :answer-field/id #uuid "828a7f8a-1289-571e-8aa4-3a396be14d44" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186401916}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "6948e752-4360-51fe-b06f-c6885f4f282f" :question/math-academy-id "q-27482" :question/problem "![](images/c0/c091fc5d742ddca3090725974f00ff7da77b1530d601bb82e288518b27970b0a.png)\n\nThe graph above shows the curve $y={(\\frac{1}{9})}^{x}+c.$ Determine the value of $c$ and find the equation of the curve." :question/worked-solution "The horizontal asymptote of $y={(\\frac{1}{9})}^{x}$ is $y=0.$\n\nThe vertical translation $y={(\\frac{1}{9})}^{x}+c$ shifts the asymptote to $y=c.$\n\nIn the graph above, the horizontal asymptote is $y=2.5.$ Therefore, $c=2.5.$"}] [{:db/id #edb/ref 17592186292804 :knowledge-point/_questions [{:db/id #edb/ref 17592186064163 :knowledge-point/id #uuid "e901ea71-aeab-5e95-939e-2401558aa708" :knowledge-point/title "Finding the Global Extrema of a Function on a Given Interval"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2225758d-8dde-578c-a547-500b65f253b3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186290778} {:answer/id #uuid "3d7ed184-a058-5189-a723-395001836891" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5}{2}" :db/id #edb/ref 17592186290887} {:answer/id #uuid "5a80c147-1f17-5590-baeb-78228c37c97c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{7}{2}" :db/id #edb/ref 17592186291023} {:answer/id #uuid "7bb02329-a57e-526d-989d-b162a90d0227" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186291154} {:answer/id #uuid "db46b9ef-b0f7-5c48-b877-de4aa36c374a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186291549}] :answer-field/correct {:answer/id #uuid "db46b9ef-b0f7-5c48-b877-de4aa36c374a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186291549} :answer-field/id #uuid "26b8e670-86de-53ef-b5db-4451381e1cb4" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186291869}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "2a126432-a7f1-5215-9a02-985aac25ece8" :question/math-academy-id "q-2751" :question/problem "Find the global maximum value of the function $f(x)=\\sqrt{x}$ on the closed interval $4\\le x\\le 9.$" :question/worked-solution "Let's apply the candidates test step by step.\n\n**Step 1**: We find the critical points. Taking the derivative of $f(x)=\\sqrt{x},$ we get\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{1}{2\\sqrt{x}}.\\end{aligned}\n$$\n\nWe can see that ${f}^{′}(x)>0$ for all $x>0.$ So there is no solution for ${f}^{′}(x)=0.$\n\nSo, the only critical points are the endpoints $x=4,9$ (since the derivative is not defined at the endpoints).\n\n**Step 2**: We evaluate $f(x)$ at the critical points.\n\n$$\n\\begin{aligned}f(4) & =\\sqrt{4}=2 \\\\ f(9) & =\\sqrt{9}=3\\end{aligned}\n$$\n\n**Step 3**: We compare all of the values found in step $2.$\n\n- The greatest value is $f(9)=3,$ so the global maximum is $3.$\n\n- The least value is $f(4)=2,$ so the global minimum is $2.$\n\n![](images/c8/c8badccb8144447b5b57157308b5614293a54569f8247320a358dd20650d91a1.png)"}] [{:db/id #edb/ref 17592186390538 :knowledge-point/_questions [{:db/id #edb/ref 17592186068830 :knowledge-point/id #uuid "617f0fe6-7998-5d77-b11f-55a0eca11440" :knowledge-point/title "Identifying a Vertically Shifted and Stretched Exponential Decay Curve"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "11991a9d-264d-57e7-9fdd-da7348694651" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/77/77ddeefbcbd24c80f6ed0bb7a29d2a43e3151436b0a60b56686b1c67ca31c738.png" :db/id #edb/ref 17592186390540} {:answer/id #uuid "f32fd0b0-49ce-539d-9672-8d020e261fbb" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/f7/f73be44a90c4a240b316bcf7ac5586b54ed1ca4cdedfac42f055cd39086ffe2d.png" :db/id #edb/ref 17592186390541} {:answer/id #uuid "407fad6c-67c3-5a63-bb5b-a49d0b7c8b56" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/f4/f405cfe76e1d69d7ecad35e96ced1c76c1b64130a118d881d331bcb0b119068c.png" :db/id #edb/ref 17592186390542} {:answer/id #uuid "a9519e6c-79f2-5f62-a983-2670eb2a7aba" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/33/33f78e0590a7039f0e2e17d5bc871e0503dd3526d282b5fb76e4ef0f3b78cc28.png" :db/id #edb/ref 17592186390543} {:answer/id #uuid "29d4d4e8-fe84-544d-8606-3bfce7839133" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/9d/9d332fa8d3d8ef65daaf34bf906c5ca7cd7e2edaf562386ed4e0ebc4555b0a64.png" :db/id #edb/ref 17592186390544}] :answer-field/correct {:answer/id #uuid "29d4d4e8-fe84-544d-8606-3bfce7839133" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/9d/9d332fa8d3d8ef65daaf34bf906c5ca7cd7e2edaf562386ed4e0ebc4555b0a64.png" :db/id #edb/ref 17592186390544} :answer-field/id #uuid "49a74683-a726-5cb6-b2c2-b253e72cf78d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186390539}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "b5e7ffcf-d49d-5dfe-9c73-ca9c0369ba7d" :question/math-academy-id "q-27538" :question/problem "Which of the following is the graph of  $y=3{(\\frac{1}{6})}^{x}-1?$" :question/worked-solution "We start with plotting the graph of $y={(\\frac{1}{6})}^{x}:$\n\n![](images/4c/4cdc9e4fa78513bca01fa10242ba6c3f12b31c262448a8edf350c76e84b188b8.png)\n\nNext, we plot the graph of $y=3{(\\frac{1}{6})}^{x}.$ To do this, we scale the graph above by a factor of $3.$ The $y$-intercept moves from $(0,1)$ to $(0,3)$ but the horizontal asymptote stays at $y=0.$\n\n![](images/8e/8e7d6c5eb931f55a9f94ac33382c0e1ec9e9e49f50b3ab538d9848d6a77be665.png)\n\nFinally, we plot the graph of $y=3{(\\frac{1}{6})}^{x}-1.$ To do this, we shift the above graph $1$ unit down. The $y$-intercept moves from $(0,3)$ to $(0,2)$ and the horizontal asymptote moves from $y=0$ to $y=-1.$\n\n![](images/9d/9d332fa8d3d8ef65daaf34bf906c5ca7cd7e2edaf562386ed4e0ebc4555b0a64.png)"}] [{:db/id #edb/ref 17592186390545 :knowledge-point/_questions [{:db/id #edb/ref 17592186068830 :knowledge-point/id #uuid "617f0fe6-7998-5d77-b11f-55a0eca11440" :knowledge-point/title "Identifying a Vertically Shifted and Stretched Exponential Decay Curve"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0f70e31a-a6d8-57be-8930-fe9e46798cf1" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/e5/e545a84145ac0a139ee5ecdf9692c20837d211f9a70fd79ad33dd13f60c856f7.png" :db/id #edb/ref 17592186390547} {:answer/id #uuid "3dd43261-0c67-5dec-abd5-e030f8c694d1" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/f6/f63e49a2e8f4a0702841eb132093bf6f69b8405af25719ea8f5abbf2bd691122.png" :db/id #edb/ref 17592186390548} {:answer/id #uuid "c08648ea-dc6d-5578-89fa-a0be944fb62c" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/c6/c64e79b7c0069aaf7d4393a6879612f58f48103247b1ba7efef3531dc3986b93.png" :db/id #edb/ref 17592186390549} {:answer/id #uuid "84311dad-8f82-5f9c-ab3a-b304e0b27aae" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/57/571e2268e6b7f41e80b71c8764d321c298fe58232e5b4c5a84ce309fa0dd3530.png" :db/id #edb/ref 17592186390550} {:answer/id #uuid "8b546f29-cf64-542e-8f37-af2b900bcda8" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/3d/3d7af2718ba7c30956218a00da51e77db950183bd2a85dbe74107e493fd5f03b.png" :db/id #edb/ref 17592186390551}] :answer-field/correct {:answer/id #uuid "0f70e31a-a6d8-57be-8930-fe9e46798cf1" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/e5/e545a84145ac0a139ee5ecdf9692c20837d211f9a70fd79ad33dd13f60c856f7.png" :db/id #edb/ref 17592186390547} :answer-field/id #uuid "b29207c3-5e76-521f-8c52-fed97e9cf151" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186390546}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "ab17c05b-3a04-5ac4-9de0-6246c2badd83" :question/math-academy-id "q-27540" :question/problem "Which of the following is the graph of $y=\\frac{1}{2}{(\\frac{1}{4})}^{x}-3?$" :question/worked-solution "We start with plotting the graph of $y={(\\frac{1}{4})}^{x}:$\n\n![](images/e6/e648e3a5f0c844d6596d4848629c3e6749647228116bcc5da6fce250895141d5.png)\n\nNext, we plot the graph of $y=\\frac{1}{2}{(\\frac{1}{4})}^{x}.$ To do this, we scale the graph above by a factor of $\\frac{1}{2}.$ The $y$-intercept moves from $(0,1)$ to $(0,\\frac{1}{2})$ but the horizontal asymptote stays at $y=0.$\n\n![](images/37/378016bbd17371e3dfee1e80934e76b1357139d405cb320ac5befa252da82b28.png)\n\nFinally, we plot the graph of $y=\\frac{1}{2}{(\\frac{1}{4})}^{x}-3.$ To do this, we shift the above graph $3$ units down. The $y$-intercept moves from $(0,\\frac{1}{2})$ to $(0,-\\frac{5}{2})$ and the horizontal asymptote moves from $y=0$ to $y=-3.$\n\n![](images/e5/e545a84145ac0a139ee5ecdf9692c20837d211f9a70fd79ad33dd13f60c856f7.png)"}] [{:db/id #edb/ref 17592186292928 :knowledge-point/_questions [{:db/id #edb/ref 17592186184334 :knowledge-point/id #uuid "d88d6dd3-9da2-5bad-a373-7c62c3004b8b" :knowledge-point/title "Solving Quadratic “Or Equal To” Inequalities That Require Rearrangement"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "54d12cb1-0a5a-5c38-97b8-4d54f5aa860d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x\\in (-\\infty ,-1]\\cup [\\frac{3}{2},\\infty )" :db/id #edb/ref 17592186290995} {:answer/id #uuid "5cd78dac-f955-5375-bb59-91aaa1c937a0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x\\in [-\\frac{5}{2},1]" :db/id #edb/ref 17592186291028} {:answer/id #uuid "5fd6265f-10b4-537d-9516-c33843fa420f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x\\in (-\\infty ,-\\frac{3}{2}]\\cup [1,\\infty )" :db/id #edb/ref 17592186291040} {:answer/id #uuid "92c88b41-d059-5525-9e1c-d910a3361572" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x\\in [-1,\\frac{3}{2}]" :db/id #edb/ref 17592186291262} {:answer/id #uuid "a4a4b0f4-a605-5247-974e-025a7c5f9ade" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x\\in [-\\frac{5}{2},\\frac{3}{2}]" :db/id #edb/ref 17592186291351}] :answer-field/correct {:answer/id #uuid "92c88b41-d059-5525-9e1c-d910a3361572" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x\\in [-1,\\frac{3}{2}]" :db/id #edb/ref 17592186291262} :answer-field/id #uuid "757c6c46-429b-5897-854b-5908ad50a2ea" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186292100}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "6f9899c6-d34d-5a73-a0f2-23d88f582629" :question/math-academy-id "q-276407" :question/problem "Find the solution of $x+3\\ge 2{x}^{2}.$" :question/worked-solution "To solve this inequality using the graphical method, we first need to move all of the numbers to the left-hand side so that the right-hand side is $0.$ \n\n$$\n\\begin{aligned}x+3 & \\ge 2{x}^{2} \\\\ -2{x}^{2}+x+3 & \\ge 0.\\end{aligned}\n$$\n\nSo, we want to find the values of $x$ for which the parabola $y=-2{x}^{2}+x+3$ lies **above** the $x$-axis or touches this axis. Let's find the roots of the parabola by factoring:\n\n$$\n\\begin{aligned}-2{x}^{2}+x+3 & =0 \\\\ 2{x}^{2}-x-3 & =0 \\\\ (2{x}^{2}-3x)+(2x-3) & =0 \\\\ x(2x-3)+(2x-3) & =0 \\\\ (x+1)(2x-3) & =0 \\\\ 2(x+1)(x-\\frac{3}{2}) & =0\\end{aligned}\n$$\n\nWe see that the roots are $x=-1$ and $x=\\frac{3}{2},$ and we can graph the parabola as follows:\n\n![](images/86/86d7fbea75961bdb83c014ca9febb735e6a1745f71e8e094de416998b2072630.png)\n\nSince we are interested in solving \n\n$$\n-2{x}^{2}+x+3\\ge 0,\n$$\n\n \nwe look for the part of the parabola that is **above** the $x$-axis or touches this axis. \n\nBased on the graph, the solution is $-1\\le x\\le \\frac{3}{2}.$\n\nUsing interval notation, we write $x\\in [-1,\\frac{3}{2}].$"}] [{:db/id #edb/ref 17592186390558 :knowledge-point/_questions [{:db/id #edb/ref 17592186096653 :knowledge-point/id #uuid "feae36e7-ae88-5f3a-957f-e65a92e399ad" :knowledge-point/title "Expressing a Vector That Satisfies a Ratio in Terms of Known Vectors"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e6c08254-bcec-5457-b88b-bb1b31577752" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\overset{\\to }{OV}=\\frac{5}{6}r+\\frac{1}{6}s" :db/id #edb/ref 17592186390560} {:answer/id #uuid "86737275-5bda-5fe0-92b5-103129881f25" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\overset{\\to }{OV}=\\frac{6}{11}r+\\frac{5}{11}s" :db/id #edb/ref 17592186390561} {:answer/id #uuid "361d2b59-2e0b-5aa1-b524-15d353a4c2a5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\overset{\\to }{OV}=r+\\frac{5}{6}s" :db/id #edb/ref 17592186390562} {:answer/id #uuid "b20f5119-753b-5441-bf91-ce6580448a69" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\overset{\\to }{OV}=\\frac{5}{11}r+\\frac{6}{11}s" :db/id #edb/ref 17592186390563} {:answer/id #uuid "04d1bf75-797e-5041-b68d-706cd3bf0bc8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\overset{\\to }{OV}=\\frac{1}{11}r+s" :db/id #edb/ref 17592186390564}] :answer-field/correct {:answer/id #uuid "b20f5119-753b-5441-bf91-ce6580448a69" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\overset{\\to }{OV}=\\frac{5}{11}r+\\frac{6}{11}s" :db/id #edb/ref 17592186390563} :answer-field/id #uuid "48dac603-f4ce-5e8e-b8da-9de99fd610ae" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186390559}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "c822bdd5-b239-5109-a43e-980b6e32d798" :question/math-academy-id "q-278288" :question/problem "![](images/ba/ba82c6b68026b0f4339c1e4fa01c4b1aa1b7aee74b74176f81bba1c0e1de259f.png)\n\nConsider the diagram above, where $\\overset{\\to }{OR}=r,$ $\\overset{\\to }{OS}=s$ and $V$ divides $\\overset{―}{RS}$ in the ratio $RV:VS=6:5.$ Find $\\overset{\\to }{OV}.$" :question/worked-solution "From the diagram, we see that\n\n$$\n\\overset{\\to }{OV}=\\overset{\\to }{OR}+\\overset{\\to }{RV}.\n$$\n\nWe're told that $\\overset{\\to }{OR}=r,$ so we just need to work out $\\overset{\\to }{RV}.$\n\nFirst, from $△ORS,$ we have\n\n$$\n\\begin{aligned}\\overset{\\to }{RS} & =\\overset{\\to }{RO}+\\overset{\\to }{OS} \\\\  & =-\\overset{\\to }{OR}+\\overset{\\to }{OS} \\\\  & =-r+s \\\\  & =s-r.\\end{aligned}\n$$\n\nSince $RV:VS=6:5,$ we have\n\n$$\n\\overset{\\to }{RV}=\\frac{6}{11}\\overset{\\to }{RS}=\\frac{6}{11}(s-r).\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\overset{\\to }{OV} & =\\overset{\\to }{OR}+\\overset{\\to }{RV} \\\\  & =r+\\frac{6}{11}(s-r) \\\\  & =\\frac{5}{11}r+\\frac{6}{11}s.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186294980 :knowledge-point/_questions [{:db/id #edb/ref 17592186115336 :knowledge-point/id #uuid "6a916099-a237-5612-b7f1-3679b7ff069d" :knowledge-point/title "Calculating an Unknown Angle"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "250975f6-1855-51d4-855b-4756eab86379" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{30}^{∘}" :db/id #edb/ref 17592186293090} {:answer/id #uuid "74682fc2-217c-57f5-ab98-c931310e5466" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{18}^{∘}" :db/id #edb/ref 17592186293411} {:answer/id #uuid "7d0ac39b-3059-5c95-9035-fede9601ced2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{15}^{∘}" :db/id #edb/ref 17592186293433} {:answer/id #uuid "c8f82474-ac34-5dcf-9935-8a82efc05435" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{20}^{∘}" :db/id #edb/ref 17592186293712} {:answer/id #uuid "e390ae5f-9602-5bc0-bd7b-333ec91cd6ad" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{25}^{∘}" :db/id #edb/ref 17592186293825}] :answer-field/correct {:answer/id #uuid "c8f82474-ac34-5dcf-9935-8a82efc05435" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{20}^{∘}" :db/id #edb/ref 17592186293712} :answer-field/id #uuid "5dff0f5f-38be-5491-8c48-4be6dc5f48b4" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186294264}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "94753d7f-95e4-5b39-9c21-ede7ecea7547" :question/math-academy-id "q-27832" :question/problem "![](images/66/6665784a8ce048fd26fbd97038346e8e6fdf6800d645ea0488f1c18986f5864b.png)\n\nConsider the triangle $△ABC$ shown above. The line segment $\\overset{―}{CH}$ is the altitude corresponding to $\\overset{―}{AB}.$ If $m∠BAC={110}^{∘},$ calculate $m∠HCA.$" :question/worked-solution "Since the straight angle must have a measure of ${180}^{∘},$ we have\n\n$$\n\\begin{aligned}m∠HAC+m∠BAC & ={180}^{∘} \\\\ m∠HAC+{110}^{∘} & ={180}^{∘} \\\\ m∠HAC & ={70}^{∘}.\\end{aligned}\n$$\n\nNote that $△ACH$ is a right triangle. Since its interior angles must sum to ${180}^{∘},$ we have\n\n$$\n\\begin{aligned}m∠HCA+m∠HAC+m∠AHC & ={180}^{∘} \\\\ m∠HCA+{70}^{∘}+{90}^{∘} & ={180}^{∘} \\\\ m∠HCA+{160}^{∘} & ={180}^{∘} \\\\ m∠HCA & ={20}^{∘}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186295017 :knowledge-point/_questions [{:db/id #edb/ref 17592186054752 :knowledge-point/id #uuid "4b23c4da-7a8d-5076-a4e9-8bcde40bc088" :knowledge-point/title "Completing a Table of Signs"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "106fb349-820a-5251-96ec-f4b08bb679f3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "+" :db/id #edb/ref 17592186293004} {:answer/id #uuid "2343b405-bae0-509d-a49e-904f44bca880" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-" :db/id #edb/ref 17592186293081}] :answer-field/correct {:answer/id #uuid "2343b405-bae0-509d-a49e-904f44bca880" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-" :db/id #edb/ref 17592186293081} :answer-field/id #uuid "08b8eff7-0142-5b4f-9af9-4d3f76d36f53" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186293952} {:answer-field/choices [{:answer/id #uuid "037bdf92-391c-5583-ae6c-87ba5fc0121d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "+" :db/id #edb/ref 17592186292948} {:answer/id #uuid "c528fbff-0cfb-59b0-9361-4227766dbcbf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-" :db/id #edb/ref 17592186293698}] :answer-field/correct {:answer/id #uuid "c528fbff-0cfb-59b0-9361-4227766dbcbf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-" :db/id #edb/ref 17592186293698} :answer-field/id #uuid "36b2361e-1e38-51d0-9779-481665b6de1d" :answer-field/key "field-3" :answer-field/type {:db/id #ed