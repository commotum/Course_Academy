ns"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0d5689f5-3979-5ac6-845f-792062a15f7a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-" :db/id #edb/ref 17592186292992} {:answer/id #uuid "357e14ed-911d-5817-8fdc-5373a446bf5e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "+" :db/id #edb/ref 17592186293160}] :answer-field/correct {:answer/id #uuid "357e14ed-911d-5817-8fdc-5373a446bf5e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "+" :db/id #edb/ref 17592186293160} :answer-field/id #uuid "20a56fc5-da89-503d-b3fc-83bd481f98dd" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186294038} {:answer-field/choices [{:answer/id #uuid "4897f8a8-9042-5997-81d4-cc1c5451594f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "+" :db/id #edb/ref 17592186293230} {:answer/id #uuid "9bbd6db8-2667-557c-b594-34531eb30104" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-" :db/id #edb/ref 17592186293547}] :answer-field/correct {:answer/id #uuid "9bbd6db8-2667-557c-b594-34531eb30104" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-" :db/id #edb/ref 17592186293547} :answer-field/id #uuid "90716124-afaa-5fad-b484-c4b3ae01e055" :answer-field/key "field-3" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186294452} {:answer-field/choices [{:answer/id #uuid "5ca36bf8-ba4f-5b39-a9a3-69579e0327a6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-" :db/id #edb/ref 17592186293306} {:answer/id #uuid "f11e29e9-5a8c-5b31-8a05-aac895b8e8a3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "+" :db/id #edb/ref 17592186293868}] :answer-field/correct {:answer/id #uuid "5ca36bf8-ba4f-5b39-a9a3-69579e0327a6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-" :db/id #edb/ref 17592186293306} :answer-field/id #uuid "97c9536e-46f9-5cd5-9342-46511da7345e" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186294472}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "b62a3ee1-92b6-5cd1-8a67-1ee93c23fffd" :question/math-academy-id "q-278486" :question/problem "What are the missing entries in the sign table below?\n\n|  | $(-\\infty ,-5)$ | $(-5,1)$ | $(1,\\infty )$ |\n| --- | --- | --- | --- |\n| $x+5$ | $-$ | {{field-1}} | $+$ |\n| $x-1$ | $-$ | {{field-2}} | $+$ |\n| $(x+5)(x-1)$ | $+$ | {{field-3}} | $+$ |" :question/worked-solution "On the interval $(-5,1),$ we can choose a test point ${x}_{1}=0.$ Then we have\n\n$$\n\\begin{aligned}x+5 & =0+5=(+), \\\\ x-1 & =0-1=(-), \\\\ (x+5)(x-1) & =(+)\\times (-)=(-),\\end{aligned}\n$$\n\nand we fill in the table as follows:\n\n|  | $(-\\infty ,-5)$ | $(-5,1)$ | $(1,\\infty )$ |\n| --- | --- | --- | --- |\n| $x+5$ | $-$ | $+$ | $+$ |\n| $x-1$ | $-$ | $-$ | $+$ |\n| $(x+5)(x-1)$ | $+$ | $-$ | $+$ |"}] [{:db/id #edb/ref 17592186295220 :knowledge-point/_questions [{:db/id #edb/ref 17592186083238 :knowledge-point/id #uuid "70c149d8-3739-564c-97c5-6636860ad0c4" :knowledge-point/title "Finding a Quadratic Polynomial Given Two Imaginary or Complex Roots"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0fc3c4bb-149f-5ffc-97a4-e605c569a112" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{x}^{2}-36" :db/id #edb/ref 17592186293002} {:answer/id #uuid "7c847aab-bc5d-5c8a-bb64-e369f3e92041" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{x}^{2}-16" :db/id #edb/ref 17592186293431} {:answer/id #uuid "891b7b21-3dd3-5a5b-a070-71b374f714a7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{x}^{2}+6x" :db/id #edb/ref 17592186293465} {:answer/id #uuid "c769df52-89b1-54df-9eee-1096ad11021a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{x}^{2}+36" :db/id #edb/ref 17592186293704} {:answer/id #uuid "f3affec0-5e08-51d1-8608-2d04df1b9df5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{x}^{2}+6" :db/id #edb/ref 17592186293884}] :answer-field/correct {:answer/id #uuid "c769df52-89b1-54df-9eee-1096ad11021a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{x}^{2}+36" :db/id #edb/ref 17592186293704} :answer-field/id #uuid "6e0f07fa-3f4d-54bc-a756-d828cde31d9f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186294314}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "5595fbd6-585b-5625-b1c7-99ec2edfefea" :question/math-academy-id "q-28185" :question/problem "The quadratic polynomial $f(x)$ has real coefficients, has roots ${x}_{1}=6\\text{i}$ and ${x}_{2}=-6\\text{i},$ and the coefficient of the quadratic term is $1.$ Find $f(x).$" :question/worked-solution "Since our quadratic polynomial has roots ${x}_{1}=6\\text{i}$ and ${x}_{2}=-6\\text{i},$ and the coefficient of the quadratic term is $a=1,$ we can write the polynomial as follows:\n\n$$\n\\begin{aligned}a(x-{x}_{1})(x-{x}_{2}) & =(1)(x-6\\text{i})(x-(-6\\text{i})) \\\\  & =(x-6\\text{i})(x+6\\text{i})\\end{aligned}\n$$\n\nExpanding the parentheses, we obtain\n\n$$\n\\begin{aligned}(x-6\\text{i})(x+6\\text{i}) & ={x}^{2}-(6\\text{i})^{2} \\\\  & ={x}^{2}-36{\\text{i}}^{2} \\\\  & ={x}^{2}+36.\\end{aligned}\n$$\n\nTherefore, $f(x)={x}^{2}+36.$"}] [{:db/id #edb/ref 17592186115669 :knowledge-point/_questions [{:db/id #edb/ref 17592186115286 :knowledge-point/id #uuid "0236acfd-59d1-5bc8-9e60-1c76ddc536f5" :knowledge-point/title "Finding a Quadratic Equation Given a Complex Root and Its Leading Coefficient"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "09b58c2a-9453-5ba0-8e30-d7ef6f50f331" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{x}^{2}-2x=0" :db/id #edb/ref 17592186292973} {:answer/id #uuid "1fe3b0ab-4035-5215-83f4-f675f25dae49" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{x}^{2}+2x+2=0" :db/id #edb/ref 17592186293065} {:answer/id #uuid "990cf70d-51d7-5d57-8f12-e3cb78178131" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{x}^{2}-x+1=0" :db/id #edb/ref 17592186293536} {:answer/id #uuid "c3e7310d-cf13-5cce-ad72-793eca71cfde" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{x}^{2}+2=0" :db/id #edb/ref 17592186293693} {:answer/id #uuid "cf236c96-ad3b-54fe-bf77-4c695ec85331" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{x}^{2}+x-2=0" :db/id #edb/ref 17592186293734}] :answer-field/correct {:answer/id #uuid "1fe3b0ab-4035-5215-83f4-f675f25dae49" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{x}^{2}+2x+2=0" :db/id #edb/ref 17592186293065} :answer-field/id #uuid "e5b5aedb-f997-5a0b-816b-7a74825693b3" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186294742}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "8b3e3d2a-46f3-5327-8b01-7846488f9aea" :question/math-academy-id "q-28215" :question/problem "A quadratic equation in the variable $x$ with real coefficients has a root $x=-1+\\text{i}.$ Given that the coefficient of ${x}^{2}$ in the equation is $1,$ find the equation." :question/worked-solution "Since the quadratic equation has real coefficients and $x=-1+\\text{i}$ is a root, its conjugate $x=-1-\\text{i}$ must also be a root. Therefore, using the zero product property, we can write a quadratic equation with the required roots as follows:\n\n$$\n(x-(-1+\\text{i}))(x-(-1-\\text{i}))=0\n$$\n\nBy expanding the parentheses, we can write the equation in standard form as follows:\n\n$$\n\\begin{aligned}{x}^{2}-x(-1+\\text{i})-x(-1-\\text{i})+(-1+\\text{i})(-1-\\text{i}) & =0 \\\\ {x}^{2}+x-x\\text{i}+x+x\\text{i}+1-{\\text{i}}^{2} & =0 \\\\ {x}^{2}+2x+1+1 & =0 \\\\ {x}^{2}+2x+2 & =0\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186295233 :knowledge-point/_questions [{:db/id #edb/ref 17592186115286 :knowledge-point/id #uuid "0236acfd-59d1-5bc8-9e60-1c76ddc536f5" :knowledge-point/title "Finding a Quadratic Equation Given a Complex Root and Its Leading Coefficient"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1bb60b0b-3bce-5f93-b41e-299f9f8e1c0e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2{x}^{2}+8x-10=0" :db/id #edb/ref 17592186293045} {:answer/id #uuid "2390c3f2-91e2-5b1e-a4af-01ff2490072a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2{x}^{2}-4x+5=0" :db/id #edb/ref 17592186293082} {:answer/id #uuid "49105bbc-e18b-5eaf-bb6d-2ca97cfe4526" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2{x}^{2}-8x+5=0" :db/id #edb/ref 17592186293232} {:answer/id #uuid "8b67390d-4d7d-5202-a4d0-85bdb5b66a87" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2{x}^{2}-2x+10=0" :db/id #edb/ref 17592186293472} {:answer/id #uuid "e6d7eed6-b78d-5f9a-88c7-01cb6601a943" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2{x}^{2}-8x+10=0" :db/id #edb/ref 17592186293835}] :answer-field/correct {:answer/id #uuid "e6d7eed6-b78d-5f9a-88c7-01cb6601a943" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2{x}^{2}-8x+10=0" :db/id #edb/ref 17592186293835} :answer-field/id #uuid "163732be-245a-5974-a487-877ec7f851b3" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186294000}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "1863d55d-bd95-51d5-93ce-914cc34a24ab" :question/math-academy-id "q-28219" :question/problem "A quadratic equation in the variable $x$ with real coefficients has a root $x=2-\\text{i}.$ Given that the coefficient of ${x}^{2}$ in the equation is $2$, find the equation." :question/worked-solution "Since the quadratic equation has real coefficients and $x=2-\\text{i}$ is a root, its conjugate $x=2+\\text{i}$ must also be a root. Therefore, using the zero product property, we can write a quadratic equation with the required roots as follows:\n\n$$\n(x-(2-\\text{i}))(x-(2+\\text{i}))=0\n$$\n\nBy expanding the parentheses, we can write the equation in standard form as follows:\n\n$$\n\\begin{aligned}{x}^{2}-x(2+\\text{i})-x(2-\\text{i})+(2-\\text{i})(2+\\text{i}) & =0 \\\\ {x}^{2}-2x-x\\text{i}-2x+x\\text{i}+4-{\\text{i}}^{2} & =0 \\\\ {x}^{2}-4x+4+1 & =0 \\\\ {x}^{2}-4x+5 & =0\\end{aligned}\n$$\n\nThis equation has roots $x=2\\pm \\text{i},$ but the coefficient of ${x}^{2}$ is not $2.$ Therefore, to find the desired equation, we multiply the equation above by $2.$ This gives\n\n$$\n\\begin{aligned}2({x}^{2}-4x+5) & =0 \\\\ 2{x}^{2}-8x+10 & =0.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186115676 :knowledge-point/_questions [{:db/id #edb/ref 17592186115358 :knowledge-point/id #uuid "51739685-2d53-5c9b-870b-b557ffdf2768" :knowledge-point/title "Finding the Area of a Triangle by Solving for a Variable Given a Trigonometric Ratio of One Angle"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1757e5f4-54b5-5159-9ab2-49bce96f3df1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "10" :db/id #edb/ref 17592186293023} {:answer/id #uuid "9cbbe909-d185-59d0-b912-c153b5d3e71b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "20" :db/id #edb/ref 17592186293549} {:answer/id #uuid "a10e5fb3-4c1c-5b66-89cd-0598cd19bb77" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186293566} {:answer/id #uuid "a838bda5-a5e8-5f6a-a576-b0a05239ea5d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "16" :db/id #edb/ref 17592186293599} {:answer/id #uuid "ac38d79d-d749-555c-aea9-60b199533b57" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "12" :db/id #edb/ref 17592186293606}] :answer-field/correct {:answer/id #uuid "1757e5f4-54b5-5159-9ab2-49bce96f3df1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "10" :db/id #edb/ref 17592186293023} :answer-field/id #uuid "331c0849-08b7-58b1-a991-ead4ea6bc11c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186294107}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "f0a77aee-e012-5d50-a91c-7eccfeb5ef38" :question/math-academy-id "q-28266" :question/problem "![](images/48/48cb6a248ab3ce706f26dc2e84e2feb337d509041c8b9756ea32fb3817aa097f.png)\n\nGiven that $\\operatorname{tan}⁡(m∠A)=5,$ calculate the area (in square units) of $△ABC$ shown above." :question/worked-solution "In this case, the area of the right triangle is\n\n$$\nA=\\frac{1}{2}AC\\cdot BC.\n$$\n\nWe are given that $\\operatorname{tan}⁡(m∠A)=5.$ Notice that relative to $∠A,$ we have expressions for the lengths of the opposite side $\\overset{―}{BC}$ and adjacent side $\\overset{―}{AC}.$ Hence, we can use the tangent ratio to solve for $x:$\n\n$$\n\\begin{aligned}\\operatorname{tan}⁡(m∠A) & =\\frac{BC}{AC} \\\\ 5 & =\\frac{2x+4}{x-1} \\\\ 5(x-1) & =2x+4 \\\\ 5x-5 & =2x+4 \\\\ 3x & =9 \\\\ x & =3\\end{aligned}\n$$\n\nSo, the side lengths are\n\n$$\n\\begin{aligned}BC & =2x+4=2(3)+4=10, \\\\ AC & =x-1=3-1=2.\\end{aligned}\n$$\n\nTherefore, the area of $△ABC$ is\n\n$$\n\\begin{aligned}A & =\\frac{1}{2}AC\\cdot BC \\\\  & =\\frac{1}{2}\\cdot 2\\cdot 10 \\\\  & =10.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186115677 :knowledge-point/_questions [{:db/id #edb/ref 17592186115360 :knowledge-point/id #uuid "fe83dedc-3034-5e3a-b546-dd57c0ccc6e8" :knowledge-point/title "Finding the Area of a Triangle by Solving for a Variable Given an Angle"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "62fd2e1e-c894-56ff-bdad-a3d722d754fe" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3.8" :db/id #edb/ref 17592186293336} {:answer/id #uuid "a43f1763-d348-5fc3-86bb-5b3eb6a7220d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4.2" :db/id #edb/ref 17592186293576} {:answer/id #uuid "adfca619-4c50-55cf-bc35-84d9301f25e1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4.7" :db/id #edb/ref 17592186293613} {:answer/id #uuid "c6b3bb07-e05e-5205-a1c1-5734a8c0a9eb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5.3" :db/id #edb/ref 17592186293701} {:answer/id #uuid "f997b95f-a99a-5b77-b147-99948a12e498" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6.3" :db/id #edb/ref 17592186293913}] :answer-field/correct {:answer/id #uuid "a43f1763-d348-5fc3-86bb-5b3eb6a7220d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4.2" :db/id #edb/ref 17592186293576} :answer-field/id #uuid "4675c8e0-ebf4-57e8-b4fe-9fcb51121df9" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186294179}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "e988752b-e095-56b3-bad9-106f43a3e05c" :question/math-academy-id "q-28271" :question/problem "![](images/7d/7dc806c646f1e9f5edbfef789fbdc9dfca2745c637906bd61eccb8072440e8c0.png)\n\nIn square units rounded to one decimal place, find the area of $△ABC$ shown above." :question/requires-calculator true :question/worked-solution "In this case, the area of the right triangle is\n\n$$\nA=\\frac{1}{2}AC\\cdot BC.\n$$\n\nWe are given that $m∠A={63}^{∘}.$ Notice that relative to $∠A,$ we have expressions for the lengths of the opposite side $\\overset{―}{BC}$ and adjacent side $\\overset{―}{AC}.$ Hence, we can use the tangent ratio to solve for $x:$\n\n$$\n\\begin{aligned}\\operatorname{tan}⁡(m∠A) & =\\frac{BC}{AC} \\\\ \\operatorname{tan}⁡({63}^{∘}) & =\\frac{3x+2}{3x} \\\\ 3x\\cdot \\operatorname{tan}⁡({63}^{∘}) & =3x+2 \\\\ 3x\\cdot \\operatorname{tan}⁡({63}^{∘})-3x & =2 \\\\ 3x(\\operatorname{tan}⁡({63}^{∘})-1) & =2 \\\\ x & =\\frac{2}{3(\\operatorname{tan}⁡({63}^{∘})-1)} \\\\ x & =0.692\\,5…\\end{aligned}\n$$\n\nSo, the side lengths are \n\n$$\n\\begin{aligned}BC & =3x+2=3(0.692\\,5…)+2=4.077\\,6…, \\\\ AC & =3x=3(0.692\\,5…)=2.077\\,6….\\end{aligned}\n$$\n\nTherefore, the area of $△ABC$ is\n\n$$\n\\begin{aligned}A & =\\frac{1}{2}(2.077\\,6…)(4.077\\,6…) \\\\  & =4.236\\,0… \\\\  & ≈4.2,\\end{aligned}\n$$\n\nrounded to the one decimal place."}] [{:db/id #edb/ref 17592186295248 :knowledge-point/_questions [{:db/id #edb/ref 17592186115286 :knowledge-point/id #uuid "0236acfd-59d1-5bc8-9e60-1c76ddc536f5" :knowledge-point/title "Finding a Quadratic Equation Given a Complex Root and Its Leading Coefficient"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "31d81fe9-d8bf-5033-a531-4c38c16343bc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4{x}^{2}+16x-8=0" :db/id #edb/ref 17592186293143} {:answer/id #uuid "51e57fe8-9a16-5417-bb16-0d24dc3d0496" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4{x}^{2}-2x-16=0" :db/id #edb/ref 17592186293263} {:answer/id #uuid "a7fc5ffa-e73f-568f-8fcc-6c7ef5303257" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4{x}^{2}+8x+16=0" :db/id #edb/ref 17592186293596} {:answer/id #uuid "cc23f64d-4c7f-5fcd-bb63-861fe1040ea8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4{x}^{2}-16x-8=0" :db/id #edb/ref 17592186293721} {:answer/id #uuid "f7afe0ce-d392-5bc0-8fdd-9a850ab8beec" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4{x}^{2}-2x+4=0" :db/id #edb/ref 17592186293900}] :answer-field/correct {:answer/id #uuid "a7fc5ffa-e73f-568f-8fcc-6c7ef5303257" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4{x}^{2}+8x+16=0" :db/id #edb/ref 17592186293596} :answer-field/id #uuid "7ced79ac-f453-56c8-9912-7f811ed8d885" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186294370}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "132a855d-cb67-58ff-b1b4-66591e373ee1" :question/math-academy-id "q-28273" :question/problem "A quadratic equation in the variable $x$ with real coefficients has a root $x=-1+\\sqrt{3}\\text{i}.$ Given that the coefficient of ${x}^{2}$ in the equation is $4$, find the equation." :question/worked-solution "Since the quadratic equation has real coefficients and $x=-1+\\sqrt{3}\\text{i}$ is a root, its conjugate $x=-1-\\sqrt{3}\\text{i}$ must also be a root. Therefore, using the zero product property, we can write a quadratic equation with the required roots as follows:\n\n$$\n(x-(-1+\\sqrt{3}\\text{i}))(x-(-1-\\sqrt{3}\\text{i}))=0\n$$\n\nBy expanding the parentheses, we can write the equation in standard form as follows:\n\n$$\n\\begin{aligned}{x}^{2}-x(-1-\\sqrt{3}\\text{i})-x(-1+\\sqrt{3}\\text{i})+(-1-\\sqrt{3}\\text{i})(-1+\\sqrt{3}\\text{i}) & =0 \\\\ {x}^{2}+x+\\sqrt{3}x\\text{i}+x-\\sqrt{3}x\\text{i}+1-3{\\text{i}}^{2} & =0 \\\\ {x}^{2}+2x+1+3 & =0 \\\\ {x}^{2}+2x+4 & =0\\end{aligned}\n$$\n\nThis equation has roots $x=-1\\pm \\sqrt{3}\\text{i},$ but the coefficient of ${x}^{2}$ is not $4.$ Therefore, to find the desired equation, we multiply the equation above by $4.$ This gives\n\n$$\n\\begin{aligned}4({x}^{2}+2x+4) & =0 \\\\ 4{x}^{2}+8x+16 & =0.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186295268 :knowledge-point/_questions [{:db/id #edb/ref 17592186110601 :knowledge-point/id #uuid "6f3d7d62-686b-59c4-9ea1-695c6be3180b" :knowledge-point/title "Determining Unknown Parameters Given Two Perpendicular Lines"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "55f88508-da2b-5f50-bc9a-a9d26b49e411" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-12" :db/id #edb/ref 17592186293282} {:answer/id #uuid "a5105cfc-01bb-5d42-a770-d43d047ecbd1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{3}" :db/id #edb/ref 17592186293581} {:answer/id #uuid "c8156b99-af7d-5f7b-b0a7-f383c4b1a5c3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{15}" :db/id #edb/ref 17592186293707} {:answer/id #uuid "c91b613b-66f6-5d95-9a11-12d165d11100" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186293713} {:answer/id #uuid "f1ecb80b-49f9-59d8-9960-66dfad7c060e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{2}{15}" :db/id #edb/ref 17592186293875}] :answer-field/correct {:answer/id #uuid "c8156b99-af7d-5f7b-b0a7-f383c4b1a5c3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{15}" :db/id #edb/ref 17592186293707} :answer-field/id #uuid "e2a93840-02de-536d-9650-a5ee63bece85" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186294727}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "fe99c4a9-356e-5f86-a2a8-a7dd24fba9f7" :question/math-academy-id "q-28328" :question/problem "Given that the lines $y=5qx+9$ and $y=-3x-8$ are perpendicular, what is the value of $q?$" :question/worked-solution "For the two lines to be perpendicular, their slopes must multiply to $-1.$\n\nBoth lines are slope-intercept form, and the slope is the $x$-coefficient. \n\n- The slope of the line $y=5qx+9$ is $5q.$\n\n- The slope of the line $y=-3x-8$ is $-3.$\n\nMultiplying the slopes together, we have\n\n$$\n5q\\cdot (-3)=-1\\,⟹\\,q=\\frac{1}{15}.\n$$"}] [{:db/id #edb/ref 17592186295269 :knowledge-point/_questions [{:db/id #edb/ref 17592186110600 :knowledge-point/id #uuid "e732f270-1d6f-5ff8-8792-d9b329ea858d" :knowledge-point/title "Determining Whether Two Lines in Standard Form are Perpendicular"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "96da5639-b1ab-5764-ba59-7e12ce5f9525" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=-\\frac{2}{5}x+4" :db/id #edb/ref 17592186293524} {:answer/id #uuid "c3c3ebe1-76b4-534e-ac97-16940002c63a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=\\frac{2}{5}x-\\frac{3}{2}" :db/id #edb/ref 17592186293692} {:answer/id #uuid "d426e426-55ae-5a3a-aa02-c573670e3364" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=\\frac{5}{2}x-4" :db/id #edb/ref 17592186293751} {:answer/id #uuid "d741d61c-f686-5e74-9421-30cd24022c0b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=-\\frac{1}{2}x+\\frac{16}{5}" :db/id #edb/ref 17592186293765} {:answer/id #uuid "fcbe027c-6c76-580a-9173-eaad9074aa07" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=-\\frac{5}{2}x+\\frac{12}{5}" :db/id #edb/ref 17592186293920}] :answer-field/correct {:answer/id #uuid "d426e426-55ae-5a3a-aa02-c573670e3364" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=\\frac{5}{2}x-4" :db/id #edb/ref 17592186293751} :answer-field/id #uuid "9c87e56a-6a3b-50b2-a894-d68a942d6fc2" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186294494}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "7542d07b-ac7a-53fd-84e7-5ac011364c8c" :question/math-academy-id "q-28338" :question/problem "Which of the following lines is perpendicular to $4x+10y=20?$" :question/worked-solution "For the two lines to be perpendicular, their slopes must multiply to $-1.$\n\nTo find the slope of the given line $4x+10y=20,$ we convert to slope-intercept form:\n\n$$\n\\begin{aligned}4x+10y & =20 \\\\ 10y & =-4x+20 \\\\ y & =-\\frac{4}{10}x+\\frac{20}{10} \\\\ y & =-\\frac{2}{5}x+2\\end{aligned}\n$$\n\nIn slope-intercept form, the slope is the $x$-coefficient. So, the slope of the given line is $-\\frac{2}{5}.$\n\nLooking at the answer choices, the line $y=\\frac{5}{2}x-4$ has a slope of $\\frac{5}{2}.$\n\nMultiplying the slopes together, we have\n\n$$\n(-\\frac{2}{5})\\cdot \\frac{5}{2}=-1.\n$$\n\nSince the slopes multiply to $-1,$ we conclude that the line $y=\\frac{5}{2}x-4$ is perpendicular to the given line."}] [{:db/id #edb/ref 17592186297157 :knowledge-point/_questions [{:db/id #edb/ref 17592186115284 :knowledge-point/id #uuid "66534e01-fdc6-522f-b90a-59a8118bc67b" :knowledge-point/title "Finding the Second Complex Root of a Quadratic Equation Given the First Root"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "074e1768-bc8a-50d9-b53c-43bd12be6b05" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{-2-7\\text{i}}{-2}" :db/id #edb/ref 17592186295303} {:answer/id #uuid "26f0903e-3e78-51bc-b188-e2eb5a092c40" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2-7\\text{i}}{2}" :db/id #edb/ref 17592186295479} {:answer/id #uuid "d6e89224-8057-5f39-9fb8-31f4cb3fe5a0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{-7-2\\text{i}}{2}" :db/id #edb/ref 17592186296398} {:answer/id #uuid "da9cbed8-b43d-563e-851e-a996cab9c5de" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{-2-7\\text{i}}{2}" :db/id #edb/ref 17592186296420} {:answer/id #uuid "f9b95dbe-7364-5af0-8a0d-dc48365dde9a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{-7+2\\text{i}}{2}" :db/id #edb/ref 17592186296593}] :answer-field/correct {:answer/id #uuid "da9cbed8-b43d-563e-851e-a996cab9c5de" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{-2-7\\text{i}}{2}" :db/id #edb/ref 17592186296420} :answer-field/id #uuid "49a20f34-443b-55d2-af98-8273be8b8ace" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186296771}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "179b51f5-6286-53a0-bd97-91549ab321d7" :question/math-academy-id "q-28519" :question/problem "A quadratic equation with real coefficients has a root $x=\\frac{-2+7\\text{i}}{2}.$ What is the other root?" :question/worked-solution "We're given that the quadratic equation has real coefficients and that $x=\\frac{-2+7\\text{i}}{2}=-1+\\frac{7}{2}\\text{i}$ is a root. Therefore, its complex conjugate $x=-1-\\frac{7}{2}\\text{i}=\\frac{-2-7\\text{i}}{2}$ is also a root."}] [{:db/id #edb/ref 17592186115693 :knowledge-point/_questions [{:db/id #edb/ref 17592186115285 :knowledge-point/id #uuid "0db14c2a-b6c3-5550-8ff6-c1a9e2b4ea5d" :knowledge-point/title "Finding a Quadratic Equation Given an Imaginary Root and Its Leading Coefficient"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0bad7587-7ec6-57a4-a5f4-b297e751b2e2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3{x}^{2}+4=0" :db/id #edb/ref 17592186295331} {:answer/id #uuid "651357c3-155d-5e2b-8229-a2f0c8d73b99" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3{x}^{2}+12=0" :db/id #edb/ref 17592186295843} {:answer/id #uuid "afeb9aa0-d6c7-567a-841d-74f1e5863e87" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3{x}^{2}-12=0" :db/id #edb/ref 17592186296194} {:answer/id #uuid "bdeabb6f-d608-5568-a961-832dfff28339" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3{x}^{2}+6=0" :db/id #edb/ref 17592186296268} {:answer/id #uuid "f775651a-d43f-5122-bc88-ae7cb6a50b17" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3{x}^{2}-4=0" :db/id #edb/ref 17592186296582}] :answer-field/correct {:answer/id #uuid "651357c3-155d-5e2b-8229-a2f0c8d73b99" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3{x}^{2}+12=0" :db/id #edb/ref 17592186295843} :answer-field/id #uuid "5098eb42-9a92-5a11-971d-950db7f70c28" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186296791}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "d6f01fd2-19c8-5c6d-b91d-8da801444f5f" :question/math-academy-id "q-28523" :question/problem "A quadratic equation in the variable $x$ with real coefficients has a root $x=2\\text{i}.$ Given that the coefficient of ${x}^{2}$ in the equation is $3$, find the equation." :question/worked-solution "Since the quadratic equation has real coefficients and  $x=2\\text{i}$ is a root, its conjugate  $x=-2\\text{i}$ must also be a root. Therefore, using the zero product property, we can write a quadratic equation with the required roots as follows:\n\n$$\n(x-2\\text{i})(x+2\\text{i})=0\n$$\n\nMultiplying out the parentheses and simplifying gives\n\n$$\n\\begin{aligned}{x}^{2}-(2\\text{i})^{2} & =0 \\\\ {x}^{2}-4(-1) & =0 \\\\ {x}^{2}+4 & =0.\\end{aligned}\n$$\n\nThis equation has roots $x=\\pm 2\\text{i},$ but the coefficient of ${x}^{2}$ is not $3.$ Therefore, to find the desired equation, we multiply the equation above by $3.$ This gives\n\n$$\n\\begin{aligned}3({x}^{2}+4) & =0 \\\\ 3{x}^{2}+12 & =0.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186115694 :knowledge-point/_questions [{:db/id #edb/ref 17592186115285 :knowledge-point/id #uuid "0db14c2a-b6c3-5550-8ff6-c1a9e2b4ea5d" :knowledge-point/title "Finding a Quadratic Equation Given an Imaginary Root and Its Leading Coefficient"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4d747e8f-1516-5356-a68e-3242c2e0b5c5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2{x}^{2}+1=0" :db/id #edb/ref 17592186295712} {:answer/id #uuid "86d21581-634d-520e-8cb4-2207578681e8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2{x}^{2}+x-2=0" :db/id #edb/ref 17592186295990} {:answer/id #uuid "9d8e57d3-8e34-5211-9924-d6901cc31ecc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2{x}^{2}-1=0" :db/id #edb/ref 17592186296109} {:answer/id #uuid "ac9ffb89-8c4c-5fe6-8e49-f98e29efbb0c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2{x}^{2}-2=0" :db/id #edb/ref 17592186296177} {:answer/id #uuid "ff61b11b-058e-5e5d-bffb-2f5d498f1498" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2{x}^{2}+x-4=0" :db/id #edb/ref 17592186296632}] :answer-field/correct {:answer/id #uuid "ac9ffb89-8c4c-5fe6-8e49-f98e29efbb0c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2{x}^{2}-2=0" :db/id #edb/ref 17592186296177} :answer-field/id #uuid "c9184891-8e98-571c-9abe-4db062243382" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186297049}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "ca36dd1b-a9c8-5277-83cd-01acbe618070" :question/math-academy-id "q-28524" :question/problem "A quadratic equation in the variable $x$ with real coefficients has a root $x=-\\text{i}.$ Given that the coefficient of ${x}^{2}$ in the equation is $-2$, find the equation." :question/worked-solution "Since the quadratic equation has real coefficients and  $x=-\\text{i}$ is a root, its conjugate  $x=\\text{i}$ must also be a root. Therefore, using the zero product property, we can write a quadratic equation with the required roots as follows:\n\n$$\n(x-\\text{i})(x+\\text{i})=0\n$$\n\nMultiplying out the parentheses and simplifying gives\n\n$$\n\\begin{aligned}{x}^{2}-(\\text{i})^{2} & =0 \\\\ {x}^{2}-(-1) & =0 \\\\ {x}^{2}+1 & =0.\\end{aligned}\n$$\n\nThis equation has roots $x=\\pm \\text{i},$ but the coefficient of ${x}^{2}$ is not $-2.$ Therefore, to find the desired equation, we multiply the equation above by $-2.$ This gives\n\n$$\n\\begin{aligned}-2({x}^{2}+1) & =0 \\\\ -2{x}^{2}-2 & =0.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186297159 :knowledge-point/_questions [{:db/id #edb/ref 17592186059677 :knowledge-point/id #uuid "89f65f58-bd3d-5c3f-b9e0-462d74d75b59" :knowledge-point/title "Computing Second Order Derivatives"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2b268833-a892-5a14-ab75-38558f16bc57" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "60" :db/id #edb/ref 17592186295511} {:answer/id #uuid "bf7be3a8-94b4-5a24-adb6-b753140ab093" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "45" :db/id #edb/ref 17592186296278} {:answer/id #uuid "d19d31e7-9654-53a0-8391-14a1f9103d85" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "120" :db/id #edb/ref 17592186296372} {:answer/id #uuid "d427a2bc-12c0-5bdc-b3d1-7a4dbeb358d1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "30" :db/id #edb/ref 17592186296383} {:answer/id #uuid "edf73d42-1443-5359-8707-64a0a6a850c6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "75" :db/id #edb/ref 17592186296527}] :answer-field/correct {:answer/id #uuid "d427a2bc-12c0-5bdc-b3d1-7a4dbeb358d1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "30" :db/id #edb/ref 17592186296383} :answer-field/id #uuid "e0375b64-7629-58c5-bdc5-3b40af6de210" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186297096}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "88cefa50-35a4-5398-bbcf-d41d22641c1f" :question/math-academy-id "q-28556" :question/problem "Find ${g}^{″}(4)$ if $g(x)=4{x}^{2}\\sqrt{x}-2x+7.$" :question/worked-solution "Computing the first derivative, we have\n\n$$\n\\begin{aligned}{g}^{′}(x) & ={(4{x}^{2}\\sqrt{x}-2x+7)}^{′} \\\\  & ={(4{x}^{5/2}-2x+7)}^{′} \\\\  & =4(\\frac{5}{2}){x}^{3/2}-2+0 \\\\  & =10{x}^{3/2}-2.\\end{aligned}\n$$\n\nComputing the second derivative, we have\n\n$$\n\\begin{aligned}{g}^{″}(x) & ={(10{x}^{3/2}-2)}^{′} \\\\  & =10(\\frac{3}{2}){x}^{1/2}-0 \\\\  & =15{x}^{1/2} \\\\  & =15\\sqrt{x}.\\end{aligned}\n$$\n\nFinally, evaluating the second derivative at $x=4$, we obtain\n\n$$\n\\begin{aligned}{g}^{″}(4) & =15\\sqrt{4} \\\\  & =15(2) \\\\  & =30.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186390565 :knowledge-point/_questions [{:db/id #edb/ref 17592186217153 :knowledge-point/id #uuid "b4b5807f-a10a-518a-84fa-907bf699884c" :knowledge-point/title "Exponential Functions With Vertical Reflections and Horizontal Shifts"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c4654041-212f-58fc-a04c-d501e2de17cc" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/01/01cc790392c233d00b4ab30e939230a0e7ac31708a0f568557a3e36e2cf04d67.png" :db/id #edb/ref 17592186390567} {:answer/id #uuid "7f249571-f46d-5f5e-8ba5-21a7346da5bf" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/b8/b83ad0f69e6d4a61227c77b3dede3632accdceaa59c1bf63da8ca8bc3fe5a7f9.png" :db/id #edb/ref 17592186390568} {:answer/id #uuid "27020075-3047-50b4-b5b4-e09fd55e5be8" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/be/be39498e5ad2c3148b254844722af707d721d7447a393a2341c6c0f6690c603e.png" :db/id #edb/ref 17592186390569} {:answer/id #uuid "ba442e50-a7b9-57fb-81af-102c16ff13ef" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/2e/2ebda1ba75caec9c62a9758696d2c4c45b452c29088e3811edfacd03acf3cd70.png" :db/id #edb/ref 17592186390570} {:answer/id #uuid "0daced82-677b-5026-9394-ec442ba5f4f7" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/28/28e24035715baa30e89392408359033dc402264c0fdcdc5968addaa615aedf81.png" :db/id #edb/ref 17592186390571}] :answer-field/correct {:answer/id #uuid "7f249571-f46d-5f5e-8ba5-21a7346da5bf" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/b8/b83ad0f69e6d4a61227c77b3dede3632accdceaa59c1bf63da8ca8bc3fe5a7f9.png" :db/id #edb/ref 17592186390568} :answer-field/id #uuid "72c70cfb-3f20-5e8d-948c-ddc2a3a7f35d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186390566}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "3efff02b-520d-5e70-beb3-91f843801d1a" :question/math-academy-id "q-28595" :question/problem "Which of the following is the graph of $y=-{e}^{x}+5?$" :question/worked-solution "To plot the given function, we follow these steps:\n\n- We take the curve $y={e}^{x}.$\n\n![](images/f5/f5983db4731c3fde0899ffc7afd602c7c82502f581742b62e69e8e6cf2d99e93.png)\n\n \n\n- Reflect it on the $x$-axis to give $y=-{e}^{x}.$ The $y$-intercept moves from $(0,1)$ to $(0,-1)$ but the horizontal asymptote stays at $y=0.$\n\n![](images/84/844a32e9d3640f9244b867c7411241171902c848defa0bf653b3820c3850238d.png)\n\n \n\n- Then, vertically shift it by $5$ units up to give $y=-{e}^{x}+5.$ The point $(0,-1)$ moves to $(0,4)$ and the horizontal asymptote moves from from $y=0$ to $y=5.$\n\n![](images/c4/c4cd8597702179629617890fce31272aa447a3227b74231e787a61eb4e770589.png)"}] [{:db/id #edb/ref 17592186111134 :knowledge-point/_questions [{:db/id #edb/ref 17592186110720 :knowledge-point/id #uuid "c6cd2f04-e0d5-5df0-8e74-ea737501cdf8" :knowledge-point/title "Solving For an Unknown Parameter"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "16ca1cf7-eae8-588f-b62e-92e2eed7ae06" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{2}" :db/id #edb/ref 17592186295403} {:answer/id #uuid "5f7c70a7-d1b8-56a0-9961-6101a0fea82a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2}{3}" :db/id #edb/ref 17592186295813} {:answer/id #uuid "89099718-058c-53aa-ac2e-3dc7b59c4b5b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{2}{3}" :db/id #edb/ref 17592186296004} {:answer/id #uuid "a1cb3a02-6977-565b-8c6f-64a04e91a8d4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186296129} {:answer/id #uuid "fcf45a98-a317-5ebe-a0ee-d58863e54e01" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186296613}] :answer-field/correct {:answer/id #uuid "16ca1cf7-eae8-588f-b62e-92e2eed7ae06" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{2}" :db/id #edb/ref 17592186295403} :answer-field/id #uuid "78f9540e-726b-5906-87cd-68bbcee4ccc9" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186296880}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "573bc8f1-012d-5d7e-834a-c6ec17bb0b63" :question/math-academy-id "q-287970" :question/problem "Consider the equation\n\n$$\n2px=3x\n$$\n\nwhere $p$ is a constant. Given that this equation has infinitely many solutions, what is the value of $p?$" :question/worked-solution "Suppose we have an equation of the form\n\n$$\nax=bx\n$$\n\nwhere $a$ and $b$ are constants. If $a=b,$ then the equation has infinitely many solutions.\n\nNotice that this equation is in the form $ax=bx.$ In this case, \n\n$$\na=2p,\\,b=3.\n$$\n\nTherefore, the equation has infinitely many solutions if\n\n$$\n2p=3.\n$$\n\nSolving this for $p,$ we get\n\n$$\np=\\frac{3}{2}.\n$$"}] [{:db/id #edb/ref 17592186297178 :knowledge-point/_questions [{:db/id #edb/ref 17592186204090 :knowledge-point/id #uuid "c0e7426e-553d-5f20-811f-15f3a5ea0056" :knowledge-point/title "Solving For an Unknown Parameter"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0a9cd574-87f6-5684-a4a2-52f23dcc4f6d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186295323} {:answer/id #uuid "4512c30d-0418-5d1a-a9a4-5767ffaddbf8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186295659} {:answer/id #uuid "4e445b8e-50d5-51d4-9056-86f12aba889d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186295718} {:answer/id #uuid "967246bb-eb10-50c8-9141-55173f83e32f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186296068} {:answer/id #uuid "b2ae615f-ae70-595f-a21b-63e9d4cc1379" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186296210}] :answer-field/correct {:answer/id #uuid "b2ae615f-ae70-595f-a21b-63e9d4cc1379" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186296210} :answer-field/id #uuid "078b8df7-1fda-503a-8213-ba030a04d1b7" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186296656}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "9d84e977-5f76-5e6a-86a0-a01877993e64" :question/math-academy-id "q-288143" :question/problem "Consider the equation in the variable $x,$ given by\n\n$$\n-3(q+4)x=6\n$$\n\nwhere $q$ is a constant. Given that this equation has no solution, what is the value of $q?$" :question/worked-solution "Suppose we have an equation of the form\n\n$$\nax=b\n$$\n\nwhere $a$ and $b$ are constants, and $b\\ne 0.$ If $a=0,$ then the equation has no solution.\n\nNotice that this equation is in the form $ax=b.$ In this case, \n\n$$\na=-3(q+4),\\,b=6.\n$$\n\nTherefore, the equation has no solution if\n\n$$\n-3(q+4)=0.\n$$\n\nSolving this for $q,$ we get\n\n$$\n\\begin{aligned}-3(q+4) & =0 \\\\ \\frac{-3(q+4)}{-3} & =\\frac{0}{-3} \\\\ q+4 & =0 \\\\ q & =-4.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186297180 :knowledge-point/_questions [{:db/id #edb/ref 17592186213003 :knowledge-point/id #uuid "5cf64df7-0abb-5b42-bed6-b3664c2de89a" :knowledge-point/title "Matching a Single Coefficient"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "381c6cc6-b38f-5f53-b305-453281ca3851" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-5" :db/id #edb/ref 17592186295581} {:answer/id #uuid "60e8b5fe-246c-568f-92d9-946f0504fb9c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186295824} {:answer/id #uuid "77d2ee40-a49f-5b7b-8c75-007236a13614" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186295922} {:answer/id #uuid "93a6f32e-a6a3-5689-96e3-737573f92b3f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186296057} {:answer/id #uuid "c4c8bcbd-fd03-58ad-896a-0505d8219e4e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186296304}] :answer-field/correct {:answer/id #uuid "c4c8bcbd-fd03-58ad-896a-0505d8219e4e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186296304} :answer-field/id #uuid "a549f3f8-6e62-5582-a6e8-36a320f44157" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186296984}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "7d2e83b2-fdb4-5969-995c-ff8567f8cf5b" :question/math-academy-id "q-288406" :question/problem "The following equation is true for all values of $x.$\n\n$$\n-5{x}^{2}+mx-6=-5{x}^{2}-3x-6\n$$\n\nWhat is the value of the constant $m?$" :question/worked-solution "Since the equation is true for all values of $x,$ the expressions on both sides must be exactly the same. That means the coefficients of the matching powers of $x$ must be equal.\n\nWe compare the linear terms on both sides. On the left-hand side, the coefficient of $x$ is $m.$ On the right-hand side, the coefficient of $x$ is $-3.$\n\nSo, we have\n\n$$\nm=-3.\n$$"}] [{:db/id #edb/ref 17592186297183 :knowledge-point/_questions [{:db/id #edb/ref 17592186110720 :knowledge-point/id #uuid "c6cd2f04-e0d5-5df0-8e74-ea737501cdf8" :knowledge-point/title "Solving For an Unknown Parameter"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "45491d55-84a5-5641-85ee-02ca1a1e90b2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186295660} {:answer/id #uuid "7b982f8e-1429-5175-9e47-06c33c917451" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5}{2}" :db/id #edb/ref 17592186295944} {:answer/id #uuid "9130ffb1-ff3d-56f6-b44a-a46263f888e3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186296047} {:answer/id #uuid "9540e0f1-3b23-5210-976d-85a05ecc13df" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186296063} {:answer/id #uuid "f61f19b9-1bc9-5327-81ed-c1e60a23106f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "10" :db/id #edb/ref 17592186296576}] :answer-field/correct {:answer/id #uuid "9540e0f1-3b23-5210-976d-85a05ecc13df" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186296063} :answer-field/id #uuid "057a3936-10b0-5e7b-83aa-558ff78363fc" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186296650}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "556d6e5b-c151-55e9-9606-63f27cad6bd7" :question/math-academy-id "q-288436" :question/problem "Consider the equation\n\n$$\n5px=10x\n$$\n\nwhere $p$ is a constant. Given that this equation has infinitely many solutions, what is the value of $p?$" :question/worked-solution "Suppose we have an equation of the form\n\n$$\nax=bx\n$$\n\nwhere $a$ and $b$ are constants. If $a=b,$ then the equation has infinitely many solutions.\n\nNotice that this equation is in the form $ax=bx.$ In this case, \n\n$$\na=5p,\\,b=10.\n$$\n\nTherefore, the equation has infinitely many solutions if\n\n$$\n5p=10.\n$$\n\nSolving this for $p,$ we get\n\n$$\np=2.\n$$"}] [{:db/id #edb/ref 17592186297189 :knowledge-point/_questions [{:db/id #edb/ref 17592186213004 :knowledge-point/id #uuid "b2caeb2c-39cf-595a-8105-67d11bf0e45e" :knowledge-point/title "Solving for Two Coefficients"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3a121ddd-d30b-57ab-802c-d2a28aedc332" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-20" :db/id #edb/ref 17592186295598} {:answer/id #uuid "3d2d0db4-00f9-5688-a436-3938b8bbd7af" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186295617} {:answer/id #uuid "902f311b-9a33-5eca-947d-790debf8ade1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-12" :db/id #edb/ref 17592186296040} {:answer/id #uuid "93583915-e4a1-5ab4-acc2-719563e5af95" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186296056} {:answer/id #uuid "bf2391b3-6270-5d08-8a37-4f5e7d3097e6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186296276}] :answer-field/correct {:answer/id #uuid "3a121ddd-d30b-57ab-802c-d2a28aedc332" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-20" :db/id #edb/ref 17592186295598} :answer-field/id #uuid "8913da08-c2a3-53da-a58d-4cb84b000f0c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186296916}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "12cdfe66-5367-5a52-9239-ea7358c10305" :question/math-academy-id "q-288452" :question/problem "The equation\n\n$$\n{x}^{2}+nx+d={x}^{2}-12x-8\n$$\n\nis true for all values of $x,$ where $n$ and $d$ are constants. What is the value of $n+d?$" :question/worked-solution "Since the equation is true for all values of $x,$ the expressions on both sides must be exactly the same. That means the coefficients of the matching powers of $x$ must be equal.\n\nLet's compare the coefficients:\n\n- The coefficient of $x$ on the left-hand side is $n,$ and on the right-hand side it is $-12.$ So, we have \n\n$$\nn=-12.\n$$\n\n- The constant term on the left-hand side is $d,$ and on the right-hand side it is $-8.$ So, we have \n\n$$\nd=-8.\n$$\n\nNow, we compute the sum:\n\n$$\n\\begin{aligned}n+d & =-12+(-8) \\\\  & =-12-8 \\\\  & =-20\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186297193 :knowledge-point/_questions [{:db/id #edb/ref 17592186213005 :knowledge-point/id #uuid "46822f28-8863-5150-a420-09c61a5c28b1" :knowledge-point/title "Comparing Factored Forms"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "02184017-3e72-54aa-bfde-e944921a8b7b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186295273} {:answer/id #uuid "16eb5901-201a-51bf-b087-292957bc4fd4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186295404} {:answer/id #uuid "6c4db019-1fa9-5008-a1ff-18e087f00500" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186295869} {:answer/id #uuid "afa15348-38f9-5b8f-840e-cdf2428bbe13" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186296192} {:answer/id #uuid "e425cd77-1bed-5dc0-8e91-a77932df18a5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186296485}] :answer-field/correct {:answer/id #uuid "afa15348-38f9-5b8f-840e-cdf2428bbe13" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186296192} :answer-field/id #uuid "1f05b554-7726-5f32-a015-9268ca6b0c9e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186296692}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "58c900de-ded0-51c6-94b4-0ca8530168c9" :question/math-academy-id "q-288468" :question/problem "The equation\n\n$$\nt(2{x}^{2}-3x+1)=-6{x}^{2}+9x-3\n$$\n\nis true for all values of $x,$ where $t$ is a constant. What is the value of $t?$" :question/worked-solution "Since the equation is true for all values of $x,$ the expressions on both sides must be exactly the same. That means that after distributing $t$ on the left-hand side, the coefficients of the matching powers of $x$ must be equal.\n\nLet's expand the left-hand side:\n\n$$\nt(2{x}^{2}-3x+1)=2t{x}^{2}-3tx+t\n$$\n\nThis must equal the right-hand side. So, we have\n\n$$\n2t{x}^{2}-3tx+t=-6{x}^{2}+9x-3.\n$$\n\nNow, we compare the coefficients of corresponding terms. \n\nComparing the ${x}^{2}$ terms, we have\n\n$$\n2t=-6\\,⇒\\,t=-3.\n$$\n\nLet's verify that value $t=-3$ produces the correct linear coefficient and constant term:\n\n- $-3t=(-3)(-3)=9\\,✓$\n\n- $t=-3\\,✓$\n\nSo, our solution is valid."}] [{:db/id #edb/ref 17592186297197 :knowledge-point/_questions [{:db/id #edb/ref 17592186204090 :knowledge-point/id #uuid "c0e7426e-553d-5f20-811f-15f3a5ea0056" :knowledge-point/title "Solving For an Unknown Parameter"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "298bad1f-9367-5a05-95d2-933a09daee2e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{9}" :db/id #edb/ref 17592186295501} {:answer/id #uuid "3dad73b7-975d-5246-83b7-9657d612712e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-6" :db/id #edb/ref 17592186295623} {:answer/id #uuid "a52921f6-35e3-5fd6-831b-5c76a68fe597" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-9" :db/id #edb/ref 17592186296138} {:answer/id #uuid "c10c0188-b833-5221-be57-af73a4dae17b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186296286} {:answer/id #uuid "f34978c9-f088-5aab-b438-960ba47ee1ba" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{6}" :db/id #edb/ref 17592186296559}] :answer-field/correct {:answer/id #uuid "a52921f6-35e3-5fd6-831b-5c76a68fe597" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-9" :db/id #edb/ref 17592186296138} :answer-field/id #uuid "aab0add4-30b0-59ee-8400-8a7cc1beaf29" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186296994}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "1328ee8c-fdcc-59c5-a877-6291af207d84" :question/math-academy-id "q-288596" :question/problem "Consider the equation in the variable $y,$ given by\n\n$$\n(q+9)y=-6\n$$\n\nwhere $q$ is a constant. Given that this equation has no solution, what is the value of $q?$" :question/worked-solution "Suppose we have an equation of the form\n\n$$\nax=b\n$$\n\nwhere $a$ and $b$ are constants, and $b\\ne 0.$ If $a=0,$ then the equation has no solution.\n\nNotice that this equation is in the form $ay=b.$ In this case,\n\n$$\na=q+9,\\,b=-6.\n$$\n\nTherefore, the equation has no solution if\n\n$$\nq+9=0.\n$$\n\nSolving this for $q,$ we get\n\n$$\n\\begin{aligned}q+9 & =0 \\\\ q & =-9.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186297198 :knowledge-point/_questions [{:db/id #edb/ref 17592186110721 :knowledge-point/id #uuid "4b1fd794-f42b-5316-80e9-0698cb1f8b87" :knowledge-point/title "Solving a General Equation With Infinitely Many Solutions For Unknown Parameters"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "26dea449-5daa-571d-bc24-21b16885571b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "15" :db/id #edb/ref 17592186295478} {:answer/id #uuid "46ff9640-80f1-5703-b7a0-6219bb604868" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186295672} {:answer/id #uuid "7f368c30-e2fd-5534-8546-adacd3bdc62c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186295955} {:answer/id #uuid "bb0e5e07-5208-59c1-8031-79b63eb57a08" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186296248} {:answer/id #uuid "e8efa7fd-e32d-5724-96bb-c481dd8ea2c4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "7" :db/id #edb/ref 17592186296507}] :answer-field/correct {:answer/id #uuid "46ff9640-80f1-5703-b7a0-6219bb604868" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186295672} :answer-field/id #uuid "049c5b1b-3107-5777-ad7f-5a1a5ac925c9" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186296646}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "afc322c5-285c-5560-a114-d1da26bf18af" :question/math-academy-id "q-288622" :question/problem "Consider the equation\n\n$$\n(m+2)x+5n=7x+15\n$$\n\nwhere $m$ and $n$ are constants. Given that this equation has infinitely many solutions, what is the value of $m+n?$" :question/worked-solution "Suppose we have an equation of the form\n\n$$\nax+b=cx+d\n$$\n\nwhere $a,b,c,$ and $d$ are constants. This equation has infinitely many solutions if \n\n$$\na=c\\,\\text{and}\\,b=d.\n$$\n\nTo determine the values of $m$ and $n$ such that the equation\n\n$$\n(m+2)x+5n=7x+15\n$$\n\nhas infinitely many solutions, we equate the coefficients of $x,$ and we equate the constants:\n\n- Equating the coefficients of $x,$ we have\n\n$$\nm+2=7.\n$$\n\nSolving this equation for $m,$ we get\n\n$$\n\\begin{aligned}m & =5.\\end{aligned}\n$$\n\n- Equating the constants, we have\n\n$$\n5n=15.\n$$\n\nSolving this equation for $n,$ we get\n\n$$\n\\begin{aligned}n & =3.\\end{aligned}\n$$\n\nFinally, since $m=5$ and $n=3,$ we have\n\n$$\nm+n=5+3=8.\n$$"}] [{:db/id #edb/ref 17592186297200 :knowledge-point/_questions [{:db/id #edb/ref 17592186110721 :knowledge-point/id #uuid "4b1fd794-f42b-5316-80e9-0698cb1f8b87" :knowledge-point/title "Solving a General Equation With Infinitely Many Solutions For Unknown Parameters"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "28da790f-20c9-5875-b417-1be764fa2aeb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "24" :db/id #edb/ref 17592186295496} {:answer/id #uuid "8db21277-c307-578a-8ebf-d5c8733da1ec" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "28" :db/id #edb/ref 17592186296020} {:answer/id #uuid "c24c121c-9aae-5ae4-989f-173c011f7cdc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "14" :db/id #edb/ref 17592186296294} {:answer/id #uuid "c7c8cfa6-04bf-59ad-b50b-09698209ddbc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "20" :db/id #edb/ref 17592186296316} {:answer/id #uuid "e7994d65-33f9-5bec-9e19-0969a17a2b2b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "30" :db/id #edb/ref 17592186296497}] :answer-field/correct {:answer/id #uuid "8db21277-c307-578a-8ebf-d5c8733da1ec" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "28" :db/id #edb/ref 17592186296020} :answer-field/id #uuid "a71ebbc6-abec-50c8-b8f1-d671ed8c0cf9" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186296986}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "9f55693d-3dd0-5310-a538-5dcb7f69af97" :question/math-academy-id "q-288627" :question/problem "Consider the equation\n\n$$\n\\frac{p}{2}x+q=4x+20\n$$\n\nwhere $p$ and $q$ are constants. Given that this equation has infinitely many solutions, what is the value of $p+q?$" :question/worked-solution "Suppose we have an equation of the form\n\n$$\nax+b=cx+d\n$$\n\nwhere $a,b,c,$ and $d$ are constants. This equation has infinitely many solutions if \n\n$$\na=c\\,\\text{and}\\,b=d.\n$$\n\nTo determine the values of $p$ and $q$ such that the equation\n\n$$\n\\frac{p}{2}x+q=4x+20\n$$\n\nhas infinitely many solutions, we equate the coefficients of $x,$ and we equate the constants:\n\n- Equating the coefficients of $x,$ we have\n\n$$\n\\frac{p}{2}=4.\n$$\n\nSolving this equation for $p,$ we get\n\n$$\n\\begin{aligned}p & =8.\\end{aligned}\n$$\n\n- Equating the constants, we get\n\n$$\nq=20.\n$$\n\nFinally, since $p=8$ and $q=20,$ we have\n\n$$\np+q=8+20=28.\n$$"}] [{:db/id #edb/ref 17592186233744 :knowledge-point/_questions [{:db/id #edb/ref 17592186083388 :knowledge-point/id #uuid "c16a30bc-0c1a-54f2-95d6-47edb0c85736" :knowledge-point/title "Determining the Product of the Roots of a Quadratic Equation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "119dc29c-b137-50a6-9c2e-9ac8d5e9af59" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{2}{7}" :db/id #edb/ref 17592186295367} {:answer/id #uuid "3082a4a4-01f9-5e69-8589-4ae793f7d894" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186295545} {:answer/id #uuid "60e31fc5-d679-52f0-8403-e834f9c90e53" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186295823} {:answer/id #uuid "e3fabf97-650c-5f20-8a3e-869f773274b5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5}{7}" :db/id #edb/ref 17592186296483} {:answer/id #uuid "eb5f880e-5916-5bea-a034-1eba1b1f15a5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2}{7}" :db/id #edb/ref 17592186296519}] :answer-field/correct {:answer/id #uuid "60e31fc5-d679-52f0-8403-e834f9c90e53" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186295823} :answer-field/id #uuid "888fe82e-2f83-5273-a943-a23e7c4d783d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186296915}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "8ed9536d-f38c-5295-8805-abb310c76773" :question/math-academy-id "q-288814" :question/problem "Consider the quadratic equation\n\n$$\n7{x}^{2}-5x-14=0.\n$$\n\n**Without** solving the equation, determine the product of its solutions." :question/worked-solution "Suppose the quadratic equation\n\n$$\na{x}^{2}+bx+c=0\n$$\n\nhas the solutions $x={x}_{1}$ and $x={x}_{2},$ where $a\\ne 0.$ \n\nThen, Vieta's formulas state the following:\n\n- The sum of the solutions is given by\n\n$$\n{x}_{1}+{x}_{2}=-\\frac{b}{a}.\n$$\n\n- The product of the solutions is given by\n\n$$\n{x}_{1}\\cdot {x}_{2}=\\frac{c}{a}.\n$$\n\nFor the given quadratic equation, we have\n\n$$\na=7,\\,b=-5,\\,c=-14.\n$$\n\nTherefore, the product of the solutions is\n\n$$\n\\begin{aligned}\\frac{c}{a} & =\\frac{(-14)}{7}=-2.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186083649 :knowledge-point/_questions [{:db/id #edb/ref 17592186083388 :knowledge-point/id #uuid "c16a30bc-0c1a-54f2-95d6-47edb0c85736" :knowledge-point/title "Determining the Product of the Roots of a Quadratic Equation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "00d74572-6c12-570d-b5b4-46d60457646d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{7}{9}" :db/id #edb/ref 17592186295271} {:answer/id #uuid "19213a87-0bbb-5148-95b8-feaba74b4642" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{3}{9}" :db/id #edb/ref 17592186295415} {:answer/id #uuid "411e71ab-c2ca-55a2-b282-fec52773fc0e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186295640} {:answer/id #uuid "d5ca4c2e-cc61-5e4f-9b7c-53692845d61c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186296390} {:answer/id #uuid "daf7dbe6-df28-5cec-bd96-e118b9a97488" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{9}" :db/id #edb/ref 17592186296423}] :answer-field/correct {:answer/id #uuid "d5ca4c2e-cc61-5e4f-9b7c-53692845d61c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186296390} :answer-field/id #uuid "0b1e993e-30b6-5f0e-8d28-4a1411fe2c2b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186296663}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "2145d449-33d6-569e-b25a-b8ddea914c99" :question/math-academy-id "q-288815" :question/problem "Consider the quadratic equation\n\n$$\n9{x}^{2}+7x-27=0.\n$$\n\n**Without** solving the equation, determine the product of its solutions." :question/worked-solution "Suppose the quadratic equation\n\n$$\na{x}^{2}+bx+c=0\n$$\n\nhas the solutions $x={x}_{1}$ and $x={x}_{2},$ where $a\\ne 0.$ \n\nThen, Vieta's formulas state the following:\n\n- The sum of the solutions is given by\n\n$$\n{x}_{1}+{x}_{2}=-\\frac{b}{a}.\n$$\n\n- The product of the solutions is given by\n\n$$\n{x}_{1}\\cdot {x}_{2}=\\frac{c}{a}.\n$$\n\nFor the given quadratic equation, we have\n\n$$\na=9,\\,b=7,\\,c=-27.\n$$\n\nTherefore, the product of the solutions is\n\n$$\n\\begin{aligned}\\frac{c}{a} & =\\frac{(-27)}{9}=-3.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186297213 :knowledge-point/_questions [{:db/id #edb/ref 17592186083388 :knowledge-point/id #uuid "c16a30bc-0c1a-54f2-95d6-47edb0c85736" :knowledge-point/title "Determining the Product of the Roots of a Quadratic Equation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "79894418-732c-58c9-9ddb-c28b8aa917f3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{17}{6}" :db/id #edb/ref 17592186295931} {:answer/id #uuid "c7374353-ec78-5263-b05c-f6719c421c59" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5}{6}" :db/id #edb/ref 17592186296313} {:answer/id #uuid "dcff367f-1190-560a-bb1e-d83c05126b52" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186296439} {:answer/id #uuid "fb46df49-667f-5745-8cbf-7537238ae05d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{5}{6}" :db/id #edb/ref 17592186296604} {:answer/id #uuid "fef8aec2-f84b-51b7-bcb0-0ca5c486d888" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-5" :db/id #edb/ref 17592186296625}] :answer-field/correct {:answer/id #uuid "fef8aec2-f84b-51b7-bcb0-0ca5c486d888" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-5" :db/id #edb/ref 17592186296625} :answer-field/id #uuid "d1dc5883-eb26-5861-aa29-b6e4365854e8" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186297070}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "f379d5ac-6fe2-5ce8-b120-ae7f8d1580fe" :question/math-academy-id "q-288816" :question/problem "Consider the quadratic equation\n\n$$\n6{x}^{2}-17x-30=0.\n$$\n\n**Without** solving the equation, determine the product of its solutions." :question/worked-solution "Suppose the quadratic equation\n\n$$\na{x}^{2}+bx+c=0\n$$\n\nhas the solutions $x={x}_{1}$ and $x={x}_{2},$ where $a\\ne 0.$ \n\nThen, Vieta's formulas state the following:\n\n- The sum of the solutions is given by\n\n$$\n{x}_{1}+{x}_{2}=-\\frac{b}{a}.\n$$\n\n- The product of the solutions is given by\n\n$$\n{x}_{1}\\cdot {x}_{2}=\\frac{c}{a}.\n$$\n\nFor the given quadratic equation, we have\n\n$$\na=6,\\,b=-17,\\,c=-30.\n$$\n\nTherefore, the product of the solutions is\n\n$$\n\\begin{aligned}\\frac{c}{a} & =\\frac{(-30)}{6}=-5.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186390572 :knowledge-point/_questions [{:db/id #edb/ref 17592186083388 :knowledge-point/id #uuid "c16a30bc-0c1a-54f2-95d6-47edb0c85736" :knowledge-point/title "Determining the Product of the Roots of a Quadratic Equation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2a1d95b8-6f28-5ebe-ae92-d043359fa511" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8\\,395" :db/id #edb/ref 17592186390574} {:answer/id #uuid "eed1e1d6-f081-50ba-9a0f-960b330272be" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-2)\\cdot 8\\,395" :db/id #edb/ref 17592186390575} {:answer/id #uuid "28190f64-9c46-5f7f-af80-807614a00568" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{146}{2}" :db/id #edb/ref 17592186390576} {:answer/id #uuid "6125f799-589f-5f34-b51a-3dae9be8eba0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-8\\,395" :db/id #edb/ref 17592186390577} {:answer/id #uuid "9b4ae3e2-672a-57a7-8dcb-1c4b9825daed" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{-8\\,395}{146}" :db/id #edb/ref 17592186390578}] :answer-field/correct {:answer/id #uuid "6125f799-589f-5f34-b51a-3dae9be8eba0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-8\\,395" :db/id #edb/ref 17592186390577} :answer-field/id #uuid "e368a500-4f4d-5598-bf19-014504f88343" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186390573}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "a60a042a-0631-504b-9c2c-28fdb04eadac" :question/math-academy-id "q-288819" :question/problem "Consider the quadratic equation\n\n$$\n{x}^{2}+146x-8\\,395=0.\n$$\n\n**Without** solving the equation, determine the product of its solutions." :question/worked-solution "Suppose the quadratic equation\n\n$$\na{x}^{2}+bx+c=0\n$$\n\nhas the solutions $x={x}_{1}$ and $x={x}_{2},$ where $a\\ne 0.$ \n\nThen, Vieta's formulas state the following:\n\n- The sum of the solutions is given by\n\n$$\n{x}_{1}+{x}_{2}=-\\frac{b}{a}.\n$$\n\n- The product of the solutions is given by\n\n$$\n{x}_{1}\\cdot {x}_{2}=\\frac{c}{a}.\n$$\n\nFor the given quadratic equation, we have\n\n$$\na=1,\\,b=146,\\,c=-8\\,395.\n$$\n\nTherefore, the product of the solutions is\n\n$$\n\\begin{aligned}\\frac{c}{a} & =\\frac{(-8\\,395)}{1}=-8\\,395.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186297216 :knowledge-point/_questions [{:db/id #edb/ref 17592186083388 :knowledge-point/id #uuid "c16a30bc-0c1a-54f2-95d6-47edb0c85736" :knowledge-point/title "Determining the Product of the Roots of a Quadratic Equation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2567084b-b026-5eb4-b95e-0227a0635f61" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "391" :db/id #edb/ref 17592186295471} {:answer/id #uuid "32c4576b-1351-5ac7-8694-de0426c7c366" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-391" :db/id #edb/ref 17592186295554} {:answer/id #uuid "71a3851f-e88d-5f38-b01f-fcaaad95d68b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{-391}{41}" :db/id #edb/ref 17592186295893} {:answer/id #uuid "922397a2-e0b6-58f1-bde5-54e22966b2c9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-2)\\cdot 391" :db/id #edb/ref 17592186296054} {:answer/id #uuid "abf37a1f-02b7-5b10-aaaf-f70acb95ee5b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{41}{2}" :db/id #edb/ref 17592186296172}] :answer-field/correct {:answer/id #uuid "32c4576b-1351-5ac7-8694-de0426c7c366" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-391" :db/id #edb/ref 17592186295554} :answer-field/id #uuid "29b0ff42-3a4a-57e5-b225-3f319bf73f19" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186296715}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "edeac1f1-6a23-50a2-b07f-f8b62b91f0ee" :question/math-academy-id "q-288825" :question/problem "Consider the quadratic equation\n\n$$\n{x}^{2}+41x-391=0.\n$$\n\n**Without** solving the equation, determine the product of its solutions." :question/worked-solution "Suppose the quadratic equation\n\n$$\na{x}^{2}+bx+c=0\n$$\n\nhas the solutions $x={x}_{1}$ and $x={x}_{2},$ where $a\\ne 0.$ \n\nThen, Vieta's formulas state the following:\n\n- The sum of the solutions is given by\n\n$$\n{x}_{1}+{x}_{2}=-\\frac{b}{a}.\n$$\n\n- The product of the solutions is given by\n\n$$\n{x}_{1}\\cdot {x}_{2}=\\frac{c}{a}.\n$$\n\nFor the given quadratic equation, we have\n\n$$\na=1,\\,b=41,\\,c=-391.\n$$\n\nTherefore, the product of the solutions is\n\n$$\n\\begin{aligned}\\frac{c}{a} & =\\frac{(-391)}{1}=-391.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186297221 :knowledge-point/_questions [{:db/id #edb/ref 17592186115179 :knowledge-point/id #uuid "ec3e2ddd-4937-5837-a03a-b7568bff9b87" :knowledge-point/title "Solving a Trigonometric Equation Involving Secant with Special Angles"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0b7eb7a0-9e0b-5f24-9b6e-32d423c91838" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{\\pi }^{2}}{4}" :db/id #edb/ref 17592186295328} {:answer/id #uuid "23b932bc-94d0-5090-8141-409a5663c61e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5{\\pi }^{2}}{4}" :db/id #edb/ref 17592186295461} {:answer/id #uuid "4b71a211-d079-5dee-8bfc-012004c98779" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5{\\pi }^{2}}{9}" :db/id #edb/ref 17592186295696} {:answer/id #uuid "a88803b8-c592-548a-a2d0-3411a63af750" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5{\\pi }^{2}}{3}" :db/id #edb/ref 17592186296152} {:answer/id #uuid "fb317109-fe2c-5752-aced-8c8fe96089ba" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{\\pi }^{2}}{9}" :db/id #edb/ref 17592186296603}] :answer-field/correct {:answer/id #uuid "4b71a211-d079-5dee-8bfc-012004c98779" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5{\\pi }^{2}}{9}" :db/id #edb/ref 17592186295696} :answer-field/id #uuid "36407ae9-d72f-5658-821c-790738a7cf02" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186296733}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "b48b10b3-0d9d-5485-bda2-3198c7563d19" :question/math-academy-id "q-28902" :question/problem "Given that ${x}_{1}$ and ${x}_{2}$ are the solutions to the equation $2\\operatorname{sec}⁡x-1=3$ for $0\\le x<2\\pi ,$ what is ${x}_{1}\\cdot {x}_{2}?$" :question/worked-solution "First, we rearrange the equation, isolating $\\operatorname{sec}⁡x:$\n\n$$\n\\begin{aligned}2\\operatorname{sec}⁡x-1 & =3 \\\\ 2\\operatorname{sec}⁡x & =4 \\\\ \\operatorname{sec}⁡x & =2\\end{aligned}\n$$\n\nRecall that $\\operatorname{sec}⁡x=\\frac{1}{\\operatorname{cos}⁡x}.$ Therefore, the given equation is equivalent to\n\n$$\n\\operatorname{cos}⁡x=\\frac{1}{2}.\n$$\n\nFirst, we find the principal value:\n\n$$\n\\begin{aligned}x=\\operatorname{arccos}⁡(\\frac{1}{2})=\\frac{\\pi }{3}\\end{aligned}\n$$\n\nSince $\\frac{\\pi }{3}$ lies inside the required domain, our first solution is ${x}_{1}=\\frac{\\pi }{3}.$\n\nOur first solution lies in the first quadrant and has a reference angle of ${\\theta }_{R}=\\frac{\\pi }{3}.$ Since $\\operatorname{cos}⁡x>0,$ the second solution must lie in the fourth quadrant, and it also has a reference angle ${\\theta }_{R}=\\frac{\\pi }{3}.$\n\n![](images/31/318eba038feb091d6e3adb80ddf325de6039bb331a7713cf1e2c02171a6388d4.png)\n\nSince the second solution ${x}_{2}$ lies in the $4$th quadrant, we can find it using the reference angle as follows:\n\n$$\n\\begin{aligned}{x}_{2} & =2\\pi -{\\theta }_{R} \\\\  & =2\\pi -\\frac{\\pi }{3} \\\\  & =\\frac{5\\pi }{3}\\end{aligned}\n$$\n\nSo, the solutions are $x=\\frac{\\pi }{3},\\frac{5\\pi }{3}.$\n\nFinally,\n\n$$\n{x}_{1}\\cdot {x}_{2}=\\frac{\\pi }{3}\\cdot \\frac{5\\pi }{3}=\\frac{5{\\pi }^{2}}{9}.\n$$"}] [{:db/id #edb/ref 17592186111141 :knowledge-point/_questions [{:db/id #edb/ref 17592186110667 :knowledge-point/id #uuid "ce7ef1dd-58cc-57f5-9ff9-fc997f4280ee" :knowledge-point/title "Identifying True Statements Regarding an Exponential Decay Curve"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "14d716c0-c74a-57f6-833b-a5816bf99cd8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I, II, and III" :db/id #edb/ref 17592186295386} {:answer/id #uuid "67139bf8-96d1-5cee-b658-3ffcabbeb7f8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186295848} {:answer/id #uuid "68c9ab76-11b5-597a-b277-a022ff7d7ce0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186295856} {:answer/id #uuid "8406301a-c3a9-5c90-b099-4f4b2c78ba3c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186295973} {:answer/id #uuid "c5a38ae3-a755-5134-b132-4a013f680737" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186296308}] :answer-field/correct {:answer/id #uuid "14d716c0-c74a-57f6-833b-a5816bf99cd8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I, II, and III" :db/id #edb/ref 17592186295386} :answer-field/id #uuid "3cc8c0d6-c061-513b-98bf-4315a1ac025c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186296752}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "c4102b2c-f2ad-56ac-9dd6-7dd59719b972" :question/math-academy-id "q-28973" :question/problem "Which of the following statements are true in relation to the function $f(x)={(\\frac{2}{7})}^{x}?$\n\nI. Its domain is $x\\in (-\\infty ,\\infty )$\n\nII. Its range is $y\\in (0,\\infty )$\n\nIII. It is a decreasing function" :question/worked-solution "Let's start by recalling the graph of ${(\\frac{2}{7})}^{x}.$\n\n![](images/c1/c1bbffed32708d30355ed3592deae845d1a84cd1f1772ef1d0fae7ac39518295.png)\n\nLet's go through the statements one by one.\n\n- Statement I is true. The function $f(x)={(\\frac{2}{7})}^{x}$ is defined for all input values $x.$\n\n- Statement II is true. The set of possible outputs of $f(x)={(\\frac{2}{7})}^{x}$ consists of all the positive numbers.\n\n- Statement III is true. For $x\\in (-\\infty ,\\infty ),$ the graph of $y=f(x)$ falls. Therefore, $y=f(x)$ is a decreasing function.\n\nIn conclusion, statements I, II, and III are true."}] [{:db/id #edb/ref 17592186297222 :knowledge-point/_questions [{:db/id #edb/ref 17592186110667 :knowledge-point/id #uuid "ce7ef1dd-58cc-57f5-9ff9-fc997f4280ee" :knowledge-point/title "Identifying True Statements Regarding an Exponential Decay Curve"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3d7bb9f1-b157-599d-93ed-6607f6670caf" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186295620} {:answer/id #uuid "57f33323-a574-5d3a-9709-4eb09849a56b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186295774} {:answer/id #uuid "a8d54f7c-6d02-5810-afd3-16ba3cfaf37c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186296154} {:answer/id #uuid "bba10e7d-2cc2-5341-a2f3-b9fb123d6f6f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186296250} {:answer/id #uuid "e870b774-8e7e-5746-ab82-10ba9e3d3195" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186296503}] :answer-field/correct {:answer/id #uuid "3d7bb9f1-b157-599d-93ed-6607f6670caf" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186295620} :answer-field/id #uuid "543e005e-a445-5e44-847a-061f1c3bcb23" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186296804}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "7c7808ae-1f8f-5217-b026-8ee08973156b" :question/math-academy-id "q-28981" :question/problem "Which of the following statements are true in relation to the function $f(x)=(0.08)^{x}?$\n\nI. Its range is $y>0$\n\nII. It is an increasing function\n\nIII. $f(x)\\to 0$ as $x\\to \\infty $" :question/worked-solution "Let's start by recalling the graph of ${(0.08)}^{x}.$\n\n![](images/b4/b4e3b5119c92d02bbceb786fefd238182c7c84ca0f4abc85a19f2df86a6ba267.png)\n\nLet's go through the statements one by one.\n\n- Statement I is true. The set of possible outputs of $f(x)={(0.08)}^{x}$ consists of all the positive numbers.\n\n- Statement II is false. For $x\\in (-\\infty ,\\infty ),$ the graph of $y=f(x)$ falls. Therefore, $y=f(x)$ is a decreasing function.\n\n- Statement III is true. As $x$ increases, the function value gets smaller and smaller, approaching zero. Therefore $f(x)\\to 0$ as $x\\to \\infty .$\n\nIn conclusion, only statements I and III are true."}] [{:db/id #edb/ref 17592186115701 :knowledge-point/_questions [{:db/id #edb/ref 17592186115182 :knowledge-point/id #uuid "145bdcf2-b1d5-54a8-bd95-4b054d7a33f0" :knowledge-point/title "Solving Trigonometric Equations Involving Cosecant with Special Angles"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1368cfff-7db3-5254-96f3-07c2d868775c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5{\\pi }^{2}}{9}" :db/id #edb/ref 17592186295373} {:answer/id #uuid "5d31a2e7-f845-5d6f-84d8-734c7f9fdf5b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2{\\pi }^{2}}{9}" :db/id #edb/ref 17592186295805} {:answer/id #uuid "6430dd94-cdd6-5b7c-a6ed-698e9ed44979" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2{\\pi }^{2}}{3}" :db/id #edb/ref 17592186295838} {:answer/id #uuid "b6bfc3d8-2c65-5bf3-b9cc-a536405604d3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{4{\\pi }^{2}}{9}" :db/id #edb/ref 17592186296226} {:answer/id #uuid "dc4268bd-fe81-503e-a2c7-155bbc6c537d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{\\pi }^{2}}{3}" :db/id #edb/ref 17592186296436}] :answer-field/correct {:answer/id #uuid "5d31a2e7-f845-5d6f-84d8-734c7f9fdf5b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2{\\pi }^{2}}{9}" :db/id #edb/ref 17592186295805} :answer-field/id #uuid "52eff59e-5bce-5d06-bed1-69123a95aebf" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186296802}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "710ba61e-2523-50bc-83d0-e27883d20d99" :question/math-academy-id "q-29004" :question/problem "Given that ${x}_{1}$ and ${x}_{2}$ are the solutions to the equation $\\operatorname{csc}⁡x=\\frac{2\\sqrt{3}}{3}$ for $0\\le x<2\\pi ,$ what is the value of ${x}_{1}\\cdot {x}_{2}?$" :question/requires-calculator true :question/worked-solution "Recall that $\\operatorname{csc}⁡x=\\frac{1}{\\operatorname{sin}⁡x},$ therefore the given equation is equivalent to\n\n$$\n\\operatorname{sin}⁡x=\\frac{3}{2\\sqrt{3}}=\\frac{\\sqrt{3}}{2}.\n$$\n\nFirst, we find the principal value:\n\n$$\nx=\\text{arcsin}(\\frac{\\sqrt{3}}{2})=\\frac{\\pi }{3}.\n$$\n\nSince $\\frac{\\pi }{3}$ lies inside the required domain, our first solution is ${x}_{1}=\\frac{\\pi }{3}.$\n\nOur first solution lies in the  first quadrant and has a reference angle of ${\\theta }_{R}=\\frac{\\pi }{3}.$ Since $\\operatorname{sin}⁡x>0,$ the second solution must lie in the second quadrant, and it also has a reference angle ${\\theta }_{R}=\\frac{\\pi }{3}.$\n\n![](images/4c/4cbf970747a9eddbcffe6fd3ba46d13c43e5f17ca56e52747c797229dbc74d48.png)\n\nSince the second solution ${x}_{2}$ lies in the $2$nd quadrant, we can find it using the reference angle as follows:\n\n$$\n\\begin{aligned}{x}_{2} & =\\pi -{\\theta }_{R} \\\\  & =\\pi -\\frac{\\pi }{3} \\\\  & =\\frac{2\\pi }{3}\\end{aligned}\n$$\n\nSo, the solutions are $x=\\frac{\\pi }{3},\\frac{2\\pi }{3}.$\n\nFinally,\n\n$$\n{x}_{1}\\cdot {x}_{2}=\\frac{\\pi }{3}\\cdot \\frac{2\\pi }{3}=\\frac{2{\\pi }^{2}}{9}.\n$$"}] [{:db/id #edb/ref 17592186204605 :knowledge-point/_questions [{:db/id #edb/ref 17592186203961 :knowledge-point/id #uuid "58c7cd44-30a9-5f61-822c-13640ad41c93" :knowledge-point/title "Finding the Zeros of a Transformed Sine or Cosine Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0b1117d8-3922-58c9-9530-2863e9f66fdc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=-{45}^{∘}+n\\cdot {180}^{∘}" :db/id #edb/ref 17592186295326} {:answer/id #uuid "1bf04524-d8f1-5e7a-91a7-879af77ff5ba" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x={45}^{∘}" :db/id #edb/ref 17592186295431} {:answer/id #uuid "3c4a9f04-2536-5359-9635-1fd6075b188e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=n\\cdot {180}^{∘}" :db/id #edb/ref 17592186295612} {:answer/id #uuid "94fd6bb9-96bf-57e3-9aa7-5130e61029b4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x={90}^{∘}+n\\cdot {360}^{∘}" :db/id #edb/ref 17592186296062} {:answer/id #uuid "d478ba2a-8dd5-55b8-a559-1c7c60934547" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x={45}^{∘}+n\\cdot {180}^{∘}" :db/id #edb/ref 17592186296386}] :answer-field/correct {:answer/id #uuid "d478ba2a-8dd5-55b8-a559-1c7c60934547" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x={45}^{∘}+n\\cdot {180}^{∘}" :db/id #edb/ref 17592186296386} :answer-field/id #uuid "a9270dcb-2a83-5da1-b03e-a2f7992cae9b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186296992}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "6cc77154-ecae-5ece-8bcc-9eb3f418b440" :question/math-academy-id "q-29132" :question/problem "Which expression gives all of the zeros of $y=3\\operatorname{cos}⁡(x+{45}^{∘})?$ Assume that $n$ is an integer." :question/worked-solution "First, let's start by defining a new variable $X$ as\n\n$$\nX=x+{45}^{∘}.\n$$\n\nSo, we need to calculate the zeros of \n\n$$\ny=3\\operatorname{cos}⁡X.\n$$\n\nThe zeros of this function are given by the following expression:\n\n$$\nX={90}^{∘}+n\\cdot {180}^{∘}\n$$\n\nwhere $n$ is an integer.\n\nTo find the zeros of our original function, we rewrite $X$ in terms of the original variable $x$ and solve the resulting equation for $x:$\n\n$$\n\\begin{aligned}X & ={90}^{∘}+n\\cdot {180}^{∘} \\\\ x+{45}^{∘} & ={90}^{∘}+n\\cdot {180}^{∘} \\\\ x+{45}^{∘}-{45}^{∘} & ={90}^{∘}+n\\cdot {180}^{∘}-{45}^{∘} \\\\ x & ={45}^{∘}+n\\cdot {180}^{∘}\\end{aligned}\n$$\n\nTherefore, we conclude that the zeros are $x={45}^{∘}+n\\cdot {180}^{∘},$ where $n$ is any integer."}] [{:db/id #edb/ref 17592186115705 :knowledge-point/_questions [{:db/id #edb/ref 17592186115181 :knowledge-point/id #uuid "a9a3d8db-a6e0-5c96-9c75-415d4a75cf4d" :knowledge-point/title "Identifying Equations With No Solutions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f6d89388-dd26-59c2-b62c-aef3350e1be1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186113197} {:answer/id #uuid "11d216c9-6d94-57de-b115-a304334c27d7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I, II, and III" :db/id #edb/ref 17592186113198} {:answer/id #uuid "2dfd62a7-b472-54ac-a2ee-4b72cf5d625f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186113199} {:answer/id #uuid "3d0a8a4e-9945-5e0d-aa15-36e66b5ab94e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186113200} {:answer/id #uuid "5bf0683d-0d8a-5267-b81d-502d2a83be7a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186113201}] :answer-field/id #uuid "4977aa86-5719-5551-a348-c70c6f677e2a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186113196} {:answer-field/choices [{:answer/id #uuid "6e366677-1acc-548b-9d8a-043caa67d076" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I, II, and III" :db/id #edb/ref 17592186401923} {:answer/id #uuid "34c4cf88-6a77-5dc4-9298-de12464e93a4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186401924} {:answer/id #uuid "fc388d3c-f7de-526c-bae0-44297aa5c1a7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186401925} {:answer/id #uuid "8e52e4ac-f6da-59c1-9b6c-569b5c0f46d4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186401926} {:answer/id #uuid "87f49733-d7a3-52db-ba58-c47681214494" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186401927}] :answer-field/correct {:answer/id #uuid "fc388d3c-f7de-526c-bae0-44297aa5c1a7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186401925} :answer-field/id #uuid "ae9fdfce-f210-5819-a39f-6d6ef14bee25" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186401922}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "fcb31a9b-9679-5d24-8bf7-7929bd2e8a6c" :question/math-academy-id "q-29163" :question/problem "Which of the following equations has no solutions for $0\\le x<2\\pi ?$\n\nI. $\\operatorname{sec}⁡x=1$\nII. $\\operatorname{sec}⁡x=2$\nIII. $\\operatorname{sec}⁡x=\\frac{1}{2}$" :question/worked-solution "Recall that the range of $\\operatorname{sec}⁡x$ for $0\\le x<2\\pi $ is given by\n\n$$\n\\operatorname{sec}⁡x\\in (-\\infty ,-1]\\cup [1,\\infty ).\n$$\n\nSo, the equation $\\operatorname{sec}⁡x=k$ has no solutions for $k\\in (-1,1).$ \n\nTherefore, of the given equations, only equation III has no solutions."}] [{:db/id #edb/ref 17592186115707 :knowledge-point/_questions [{:db/id #edb/ref 17592186115180 :knowledge-point/id #uuid "28062dbf-815b-5221-ae86-1050e106c5ea" :knowledge-point/title "Solving a Trigonometric Equation Involving Secant Under a Modified Domain"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "88a2376c-dc19-5dd0-a77a-56366a05b81d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-12000" :db/id #edb/ref 17592186113209} {:answer/id #uuid "c5a28036-b367-589e-9512-aab611b56f04" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "36000" :db/id #edb/ref 17592186113210} {:answer/id #uuid "d3998ecb-9d96-51bb-a80c-b98dba07a111" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "18000" :db/id #edb/ref 17592186113211} {:answer/id #uuid "1afc57e2-95e9-5005-8244-a42d7d643df9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-18000" :db/id #edb/ref 17592186113212} {:answer/id #uuid "64c56874-5776-54fe-a57b-179c6f752f5e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "12000" :db/id #edb/ref 17592186113213}] :answer-field/id #uuid "4e1aae67-1413-5c52-92c2-e130fc7ee0d4" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186113208} {:answer-field/choices [{:answer/id #uuid "b0c131ae-15e2-51d9-b981-699dd3822a8e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "36\\,000" :db/id #edb/ref 17592186390580} {:answer/id #uuid "4abb149a-acd5-5b9b-b236-51b85d318980" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-18\\,000" :db/id #edb/ref 17592186390581} {:answer/id #uuid "ea956b89-f42b-52b5-a970-4a7cbdfbbbcd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-12\\,000" :db/id #edb/ref 17592186390582} {:answer/id #uuid "b1c1bdc4-e73b-5851-82fe-a8e4df60d98d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "18\\,000" :db/id #edb/ref 17592186390583} {:answer/id #uuid "ea082471-0a98-54a0-9c3f-4a9fcbd75fcd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "12\\,000" :db/id #edb/ref 17592186390584}] :answer-field/correct {:answer/id #uuid "b1c1bdc4-e73b-5851-82fe-a8e4df60d98d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "18\\,000" :db/id #edb/ref 17592186390583} :answer-field/id #uuid "974b5aa7-9854-5922-a33e-647715b7b09b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186390579}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "20eb540b-84ee-5a09-81e9-e0f110dad1d7" :question/math-academy-id "q-29179" :question/problem "Given that ${x}_{1}$ and ${x}_{2}$ are the solutions to the equation $\\operatorname{sec}⁡x=2$ for $-{360}^{∘}\\le x<{0}^{∘},$ what is the numerical value of ${x}_{1}\\cdot {x}_{2}?$" :question/requires-calculator true :question/worked-solution "Recall that $\\operatorname{sec}⁡x=\\frac{1}{\\operatorname{cos}⁡x}.$ Therefore, the given equation is equivalent to\n\n$$\n\\operatorname{cos}⁡x=\\frac{1}{2}.\n$$\n\nFirst, we find the principal value:\n\n$$\nx=\\operatorname{arccos}⁡(\\frac{1}{2})={60}^{∘}\n$$\n\nNote that $x={60}^{∘}$ is not in the domain $-{360}^{∘}\\le x<{0}^{∘}.$ To get a solution within the required domain, we subtract ${360}^{∘}:$\n\n$$\n\\begin{aligned}{x}_{1} & ={60}^{∘}-{360}^{∘}=-{300}^{∘}\\end{aligned}\n$$\n\n \n\nOur first solution lies in the first quadrant and has a reference angle of ${\\theta }_{R}={60}^{∘}.$ Since $\\operatorname{cos}⁡x>0,$ the second solution must lie in the fouth quadrant, and it also has a reference angle ${\\theta }_{R}={60}^{∘}.$\n\n![](images/9c/9c8adbb0a1594ae5bacfab7f1f92993c67659839599e10ab46d5cf98896e3ec7.png)\n\nA second solution $X$ lies in the $4$th quadrant, and we can find it using the reference angle as follows:\n\n$$\n\\begin{aligned}X & ={360}^{∘}-{\\theta }_{R} \\\\  & ={360}^{∘}-{60}^{∘} \\\\  & ={300}^{∘}\\end{aligned}\n$$\n\nNote that $X={300}^{∘}$ is not in the domain $-{360}^{∘}\\le x<{0}^{∘}.$ To get a solution within the required domain, we subtract ${360}^{∘}:$\n\n$$\n\\begin{aligned}{x}_{3} & ={300}^{∘}-{360}^{∘}=-{60}^{∘}\\end{aligned}\n$$\n\n \n\nTherefore, the solutions are $x=-{60}^{∘},-{300}^{∘}.$\n\nFinally,\n\n$$\n{x}_{1}\\cdot {x}_{2}=-60\\cdot (-300)=18\\,000\n$$"}] [{:db/id #edb/ref 17592186390585 :knowledge-point/_questions [{:db/id #edb/ref 17592186115180 :knowledge-point/id #uuid "28062dbf-815b-5221-ae86-1050e106c5ea" :knowledge-point/title "Solving a Trigonometric Equation Involving Secant Under a Modified Domain"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b21c9bca-5889-5378-95f5-dc19174253a3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "7\\,600" :db/id #edb/ref 17592186390587} {:answer/id #uuid "5637088d-2110-5861-a9e4-5418d97814d6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "14\\,175" :db/id #edb/ref 17592186390588} {:answer/id #uuid "98625043-9024-52ca-9b27-4d102460e169" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "9\\,900" :db/id #edb/ref 17592186390589} {:answer/id #uuid "a3127733-14dd-544e-9920-fd0e17095202" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "15\\,150" :db/id #edb/ref 17592186390590} {:answer/id #uuid "510c63c8-8440-585e-ac63-db0b2b6359b8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "18\\,000" :db/id #edb/ref 17592186390591}] :answer-field/correct {:answer/id #uuid "98625043-9024-52ca-9b27-4d102460e169" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "9\\,900" :db/id #edb/ref 17592186390589} :answer-field/id #uuid "c557a89c-b4c6-5e67-988d-6c588aefa937" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186390586}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "23dbd8da-da31-5df7-bb91-fad8d1a7bceb" :question/math-academy-id "q-29182" :question/problem "Given that ${x}_{1}$ and ${x}_{2}$ are the solutions to the equation $\\operatorname{sec}⁡x=\\frac{2}{\\sqrt{3}}$ for $-{360}^{∘}\\le x<{0}^{∘},$ what is the numerical value of ${x}_{1}\\cdot {x}_{2}?$" :question/worked-solution "Recall that $\\operatorname{sec}⁡x=\\frac{1}{\\operatorname{cos}⁡x}.$ Therefore, the given equation is equivalent to\n\n$$\n\\operatorname{cos}⁡x=\\frac{\\sqrt{3}}{2}.\n$$\n\nFirst, we find the principal value:\n\n$$\nx=\\operatorname{arccos}⁡(\\frac{\\sqrt{3}}{2})={30}^{∘}\n$$\n\nNote that $x={30}^{∘}$ is not in the domain $-{360}^{∘}\\le x<{0}^{∘}.$ To get a solution within the required domain, we subtract ${360}^{∘}:$\n\n$$\n\\begin{aligned}{x}_{1} & ={30}^{∘}-{360}^{∘}=-{330}^{∘}\\end{aligned}\n$$\n\n \n\nOur first solution lies in the first quadrant and has a reference angle of ${\\theta }_{R}={30}^{∘}.$ Since $\\operatorname{cos}⁡x>0,$ the second solution must lie in the fouth quadrant, and it also has a reference angle ${\\theta }_{R}={30}^{∘}.$\n\n![](images/8c/8c6e3ae6bdbfb1c66aee719f77225453992fffe6f3c6e3dfdc3f1ff92c59863a.png)\n\nA second solution $X$ lies in the $4$th quadrant, and we can find it using the reference angle as follows:\n\n$$\n\\begin{aligned}X & ={360}^{∘}-{\\theta }_{R} \\\\  & ={360}^{∘}-{30}^{∘} \\\\  & ={330}^{∘}\\end{aligned}\n$$\n\nNote that $X={330}^{∘}$ is not in the domain $-{360}^{∘}\\le x<{0}^{∘}.$ To get a solution within the required dommain, we subtract ${360}^{∘}:$\n\n$$\n\\begin{aligned}{x}_{2} & ={330}^{∘}-{360}^{∘}=-{30}^{∘}\\end{aligned}\n$$\n\n \n\nTherefore, the solutions are $x=-{30}^{∘},-{330}^{∘}.$\n\nFinally,\n\n$$\n{x}_{1}\\cdot {x}_{2}=-30\\cdot (-330)=9\\,900\n$$"}] [{:db/id #edb/ref 17592186297228 :knowledge-point/_questions [{:db/id #edb/ref 17592186115184 :knowledge-point/id #uuid "ba963ded-e9ff-5324-9d22-acb6b7a85e10" :knowledge-point/title "Solving a Trigonometric Equation Involving Cotangent with Special Angles"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "285b16e3-c1a0-528c-aa3c-6503ddc7d9c2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5{\\pi }^{2}}{4}" :db/id #edb/ref 17592186295491} {:answer/id #uuid "87b96519-0b71-53f7-a2a8-38e23e3ed540" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{7{\\pi }^{2}}{4}" :db/id #edb/ref 17592186295998} {:answer/id #uuid "8dc605ec-311a-5e45-aa11-fa47080ee6c4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5{\\pi }^{2}}{16}" :db/id #edb/ref 17592186296021} {:answer/id #uuid "a73b3e93-a76c-5d8c-952d-0ca55c712a69" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3{\\pi }^{2}}{16}" :db/id #edb/ref 17592186296147} {:answer/id #uuid "dbc07055-c07b-591e-bb1f-6c27db9c5cff" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{\\pi }^{2}}{16}" :db/id #edb/ref 17592186296429}] :answer-field/correct {:answer/id #uuid "8dc605ec-311a-5e45-aa11-fa47080ee6c4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5{\\pi }^{2}}{16}" :db/id #edb/ref 17592186296021} :answer-field/id #uuid "38ba5974-6a88-54e6-877e-8ae9daa987cd" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186296741}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "2e82d568-df50-578f-b07c-119397489f57" :question/math-academy-id "q-29207" :question/problem "Given that ${x}_{1}$ and ${x}_{2}$ are the solutions to the equation $\\operatorname{cot}⁡x=1$ for $0\\le x<2\\pi ,$ what is the value of ${x}_{1}\\cdot {x}_{2}?$" :question/worked-solution "Recall that $\\operatorname{cot}⁡x=\\frac{1}{\\operatorname{tan}⁡x}.$ Therefore, the given equation is equivalent to\n\n$$\n\\operatorname{tan}⁡x=1\n$$\n\nFirst, we find the principal value:\n\n$$\n\\begin{aligned}x=\\text{arctan}(1)=\\frac{\\pi }{4}\\end{aligned}\n$$\n\nSince $\\frac{\\pi }{4}$ lies inside the given domain, our first solution is ${x}_{1}=\\frac{\\pi }{4}.$\n\nTo generate more solutions, we add integer multiples of $\\pi .$ Hence,\n\n$$\n\\begin{aligned}{x}_{2}=\\pi +\\frac{\\pi }{4}=\\frac{5\\pi }{4}.\\end{aligned}\n$$\n\nSo, the solutions are $x=\\frac{\\pi }{4},\\frac{5\\pi }{4}.$\n\nFinally,\n\n$$\n{x}_{1}\\cdot {x}_{2}=\\frac{\\pi }{4}\\cdot \\frac{5\\pi }{4}=\\frac{5{\\pi }^{2}}{16}.\n$$"}] [{:db/id #edb/ref 17592186297232 :knowledge-point/_questions [{:db/id #edb/ref 17592186129101 :knowledge-point/id #uuid "8854eaba-96c7-5ea8-a071-7ff7c954f943" :knowledge-point/title "Finding a General Expression for the Asymptotes of a Transformed Tangent or Cotangent Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8266d9da-29ef-5142-889c-67032e696941" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x={30}^{∘}+n\\cdot {180}^{∘}" :db/id #edb/ref 17592186295969} {:answer/id #uuid "8f36dd3b-18aa-5423-9a63-6be24cb45a5d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x={60}^{∘}+n\\cdot {45}^{∘}" :db/id #edb/ref 17592186296030} {:answer/id #uuid "b9a3b5aa-10fe-59e1-8b60-91383fc7c7a1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x={45}^{∘}+n\\cdot {90}^{∘}" :db/id #edb/ref 17592186296242} {:answer/id #uuid "ce3fe793-587a-5cb1-82ef-b60494e08387" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x={90}^{∘}+n\\cdot {180}^{∘}" :db/id #edb/ref 17592186296347} {:answer/id #uuid "f5728d81-5718-5a99-b836-93226b4b6cc2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=n\\cdot {180}^{∘}" :db/id #edb/ref 17592186296569}] :answer-field/correct {:answer/id #uuid "b9a3b5aa-10fe-59e1-8b60-91383fc7c7a1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x={45}^{∘}+n\\cdot {90}^{∘}" :db/id #edb/ref 17592186296242} :answer-field/id #uuid "3d308903-8122-5b47-a276-3957b8fde22e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186296754}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "493ac61e-d5aa-548d-a691-2dfa99e52431" :question/math-academy-id "q-29349" :question/problem "Which of the following expressions gives all of the vertical asymptotes of the function $y=\\operatorname{tan}⁡(2x)-2,$ where $x$ is measured in degrees? Assume that $n$ is an integer." :question/worked-solution "The asymptotes of $y=\\operatorname{tan}⁡x$ are given by the following expression:\n\n$$\nx={90}^{∘}+n\\cdot {180}^{∘}\n$$\n\nTo find the asymptotes of $\\operatorname{tan}⁡(2x)-2,$ we replace the $x$ on the left-hand side of the above with $(2x).$ This gives:\n\n$$\n2x={90}^{∘}+n\\cdot {180}^{∘}\n$$\n\nSolving this for $x$ gives:\n\n$$\n\\begin{aligned}x & ={45}^{∘}+n\\cdot {90}^{∘}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186401928 :knowledge-point/_questions [{:db/id #edb/ref 17592186110652 :knowledge-point/id #uuid "a258070e-5c3c-595e-81d6-3e0f9b9a5daf" :knowledge-point/title "Working With Systems Containing Mixed Inequalities"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c28cb971-d849-577e-9682-a8890d4ae773" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\begin{aligned}y\\le x+2 \\\\ y>-x+1\\end{aligned}" :db/id #edb/ref 17592186401930} {:answer/id #uuid "d4c91422-9ef9-5a21-a3cd-6168971db223" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\begin{aligned}y\\ge x+2 \\\\ y\\ge -x+1\\end{aligned}" :db/id #edb/ref 17592186401931} {:answer/id #uuid "928ea34b-f94c-5914-8894-15d7edbe4d92" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\begin{aligned}y>x+2 \\\\ y\\ge -x+1\\end{aligned}" :db/id #edb/ref 17592186401932} {:answer/id #uuid "129beb51-d7c5-5a45-86b1-53f54c6e7926" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\begin{aligned}y\\ge x+2 \\\\ y<-x+1\\end{aligned}" :db/id #edb/ref 17592186401933} {:answer/id #uuid "1f5ea53c-6d9f-56de-99b0-c8f54f45ac23" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\begin{aligned}y\\le x+2 \\\\ y<-x+1\\end{aligned}" :db/id #edb/ref 17592186401934}] :answer-field/correct {:answer/id #uuid "928ea34b-f94c-5914-8894-15d7edbe4d92" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\begin{aligned}y>x+2 \\\\ y\\ge -x+1\\end{aligned}" :db/id #edb/ref 17592186401932} :answer-field/id #uuid "210acf01-110f-53da-bf3c-8725abe1a7d8" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186401929}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "5cb8229e-2a6a-582b-a6c3-627b88cf6816" :question/math-academy-id "q-29384" :question/problem "![](images/a7/a740aafbb9f74e2681506d3027f848fa92e7eea2bac3e08ccaf3fc7e0acf8fa1.png)\n\nWhich of the following systems of inequalities defines the shaded region shown in the graph above?" :question/worked-solution "Consider the line $y=x+2.$ Since the line is dashed, the inequality is strict. Also, since the shaded region lies *above* the line, the inequality is a \"greater than\" inequality. So the corresponding inequality is\n\n$$\ny>x+2.\n$$\n\n    \n\nNow consider the line $y=-x+1.$ Since the line is solid, the inequality is an \"or equal to\" inequality. Also, since the shaded region lies *above* the line, the inequality is a \"greater than\" inequality. So the corresponding inequality is\n\n$$\ny\\ge -x+1.\n$$\n\nTherefore, the system of inequalities that defines the shaded region is\n\n$$\n{\\begin{aligned}y>x+2 \\\\ y\\ge -x+1.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186401935 :knowledge-point/_questions [{:db/id #edb/ref 17592186064382 :knowledge-point/id #uuid "3497c02b-4c62-58d9-8c73-ee1a1142c429" :knowledge-point/title "Calculating the Rate of Change of a Leg Using the Pythagorean Theorem"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "074992e8-e1fa-5890-859b-ab91c898befa" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "61\\text{ km/h}" :db/id #edb/ref 17592186401937} {:answer/id #uuid "95aa0b04-7251-5fbf-b2eb-66bafc65e559" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "65.5\\text{ km/h}" :db/id #edb/ref 17592186401938} {:answer/id #uuid "336d2d1d-872d-56d4-a5f4-5bec78ef5250" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "60\\text{ km/h}" :db/id #edb/ref 17592186401939} {:answer/id #uuid "35306f0e-0e84-5e47-a2f4-679a063c0acb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "70\\text{ km/h}" :db/id #edb/ref 17592186401940} {:answer/id #uuid "f0f8d307-81e4-50be-9385-c254d6f22bfb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "75.2\\text{ km/h}" :db/id #edb/ref 17592186401941}] :answer-field/correct {:answer/id #uuid "35306f0e-0e84-5e47-a2f4-679a063c0acb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "70\\text{ km/h}" :db/id #edb/ref 17592186401940} :answer-field/id #uuid "6827bd64-2698-5152-a010-779141f5c62e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186401936}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "507fbe2b-2f95-5bfa-be32-3403810daadf" :question/math-academy-id "q-2939" :question/problem "![](images/92/9283bcc77ac8e63c1ba00f9a81e659bcbcf41bc98b94a1a0617b02feab71cf0a.png)\n\nCar $B$ is being driven due south toward Caltech at a speed of $60\\,\\text{km/h},$ while car $A$ is being driven due east away from Caltech. When car $B$ is $0.6\\,\\text{km}$ away from Caltech, car $A$ is $0.8\\,\\text{km}$ from Caltech. If the distance between the two vehicles is increasing at a rate of $20\\,\\text{km/h},$ what is the speed of car $A?$" :question/worked-solution "![](images/6e/6e7ef0d4665710a31c1c601048498f20ad6b3099769c1d140320074805964ec7.png)\n\nIn the diagram,\n\n- $x$ is the distance between Caltech and car $A$,\n\n- $y$ is the distance between Caltech and car $B$,\n\n- $z$ is the distance between the two cars.\n\nAs shown in the diagram, $x,$ $y,$ and $z$ form a right triangle with $z$ as the hypotenuse. We wish to find the rate of change of $x,$ which is $\\frac{\\text{d}x}{\\text{d}t}.$ \n\nWe know that $x=0.8\\,\\text{km}$ and $y=0.6\\,\\text{km}.$ We can find $z$ using the Pythagorean Theorem, as follows:\n\n$$\n\\begin{aligned}{x}^{2}+{y}^{2} & ={z}^{2} \\\\ {0.8}^{2}+{0.6}^{2} & ={z}^{2} \\\\ {z}^{2} & =1 \\\\ z & =1\\,\\text{km}\\end{aligned}\n$$\n\nWe also know that:\n\n- $\\frac{\\text{d}y}{\\text{d}t}=-60\\,\\text{km}/\\text{h},$\n\n- $\\frac{\\text{d}z}{\\text{d}t}=20\\,\\text{km}/\\text{h}.$\n\nFinally, we differentiate both sides of ${x}^{2}+{y}^{2}={z}^{2}$ with respect to $t$ and then substitute in the known values, as follows:\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}t}({x}^{2}+{y}^{2}) & =\\frac{\\text{d}}{\\text{d}t}({z}^{2}) \\\\ 2x\\frac{\\text{d}x}{\\text{d}t}+2y\\frac{\\text{d}y}{\\text{d}t} & =2z\\frac{\\text{d}z}{\\text{d}t} \\\\ 2(0.8)\\frac{\\text{d}x}{\\text{d}t}+2(0.6)(-60) & =2(1)(20) \\\\ 1.6\\frac{\\text{d}x}{\\text{d}t} & =40+72 \\\\ \\frac{\\text{d}x}{\\text{d}t} & =\\frac{112}{1.6} \\\\ \\frac{\\text{d}x}{\\text{d}t} & =70.\\end{aligned}\n$$\n\nTherefore, the speed of the car $A$ is $70\\,\\text{km}/\\text{h}.$"}] [{:db/id #edb/ref 17592186064705 :knowledge-point/_questions [{:db/id #edb/ref 17592186064382 :knowledge-point/id #uuid "3497c02b-4c62-58d9-8c73-ee1a1142c429" :knowledge-point/title "Calculating the Rate of Change of a Leg Using the Pythagorean Theorem"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9dc9e1e5-11ce-551d-97de-0eca949cc8ac" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1350km/h" :db/id #edb/ref 17592186062288} {:answer/id #uuid "c6cc7f50-9e41-5b9f-864d-0e28be15a521" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1000km/h" :db/id #edb/ref 17592186062289} {:answer/id #uuid "cd8734e2-d020-5c3d-a702-dca63ef20d08" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "975km/h" :db/id #edb/ref 17592186062290} {:answer/id #uuid "e7ff4680-bdaf-5954-b0ff-5d1660a2bbd2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1250km/h" :db/id #edb/ref 17592186062291} {:answer/id #uuid "270d7699-bf39-50bb-b2d0-bfe7bfa68dff" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "750m/h" :db/id #edb/ref 17592186062292}] :answer-field/id #uuid "940ab7e7-9338-589e-a3c0-36ebb036a673" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186062287} {:answer-field/choices [{:answer/id #uuid "5e61c15b-79c7-5166-b178-3747e17866dd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1\\,000\\,\\text{km/h}" :db/id #edb/ref 17592186401943} {:answer/id #uuid "b14cf7b0-2299-5e5f-b5c6-d5c85c148877" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1\\,250\\text{km/h}" :db/id #edb/ref 17592186401944} {:answer/id #uuid "b8011803-44bb-5708-a342-7bae100244be" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1\\,350\\,\\text{km/h}" :db/id #edb/ref 17592186401945} {:answer/id #uuid "e2f10350-a4ef-5fe3-aef8-799220547f92" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "975\\,\\text{km/h}" :db/id #edb/ref 17592186401946} {:answer/id #uuid "062254bd-0f6e-5f77-8e3b-5a1990d9eb27" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "750\\,\\text{m/h}" :db/id #edb/ref 17592186401947}] :answer-field/correct {:answer/id #uuid "b14cf7b0-2299-5e5f-b5c6-d5c85c148877" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1\\,250\\text{km/h}" :db/id #edb/ref 17592186401944} :answer-field/id #uuid "81478755-4be2-5ae2-9535-e8dd0fd9f860" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186401942}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "216f383a-6fa0-5f0b-b2c6-22682df9e591" :question/math-academy-id "q-2941" :question/problem "A rocket that is launched vertically is tracked by a radar station located on\nthe ground $3\\,\\text{km}$ from the launch site. What is the vertical speed of the rocket at the instant when its distance from the radar station is $5\\,\\text{km}$ and this distance is increasing at a rate of $1\\,000\\,\\text{km/h}?$" :question/requires-calculator true :question/worked-solution "We start by drawing a diagram of the problem.\n\n![](images/7a/7af033f137fd76e5e3003926a598e695f4e0852b11dc27dfa84d58040144972b.png)\n\nIn the diagram,\n\n- $x$ is the distance between the radar station and the launch point,\n\n- $y$ is the distance between the launch point and the rocket, and\n\n- $z$ is the distance between the radar station and the rocket.\n\nAs shown in the diagram, $x,$ $y,$ and $z$ form a right triangle with $z$ as the hypotenuse. We wish to find the rate of change of $y,$ which is $\\frac{\\text{d}y}{\\text{d}t}.$ \n\nWe know that $x=3\\,\\text{km}$ and $z=5\\,\\text{km}.$ We can find $y$ using the Pythagorean Theorem, as follows:\n\n$$\n\\begin{aligned}{x}^{2}+{y}^{2} & ={z}^{2} \\\\ {3}^{2}+{y}^{2} & ={5}^{2} \\\\ {y}^{2} & =16 \\\\ y & =4\\,\\text{km}\\end{aligned}\n$$\n\nWe also know that:\n\n- $\\frac{\\text{d}z}{\\text{d}t}=1\\,000\\,\\text{km}/\\text{h},$\n\n- the distance between the radar station and the launch point ($x$) remains the same, so $\\frac{\\text{d}x}{\\text{d}t}=0.$\n\nFinally, we differentiate both sides of ${x}^{2}+{y}^{2}={z}^{2}$ with respect to $t$ and then substitute in the known values:\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}t}({x}^{2}+{y}^{2}) & =\\frac{\\text{d}}{\\text{d}t}({z}^{2}) \\\\ 2x\\frac{\\text{d}x}{\\text{d}t}+2y\\frac{\\text{d}y}{\\text{d}t} & =2z\\frac{\\text{d}z}{\\text{d}t} \\\\ 2(3)(0)+2(4)\\frac{\\text{d}y}{\\text{d}t} & =2(5)(1\\,000) \\\\ \\frac{\\text{d}y}{\\text{d}t} & =\\frac{10\\,000}{8} \\\\ \\frac{\\text{d}y}{\\text{d}t} & =1\\,250\\end{aligned}\n$$\n\nTherefore, the vertical speed of the rocket is $1\\,250\\,\\text{km}/\\text{h}.$"}] [{:db/id #edb/ref 17592186297236 :knowledge-point/_questions [{:db/id #edb/ref 17592186129100 :knowledge-point/id #uuid "fabd8865-cc14-508a-aa81-4ba147f7f8d4" :knowledge-point/title "Finding a General Expression for the Zeros of a Transformed Tangent or Cotangent Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "64fab536-011b-5495-af75-b22e97ee61ff" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=\\frac{5\\pi }{6}+n\\pi " :db/id #edb/ref 17592186295842} {:answer/id #uuid "87e9cce5-fd91-5d27-9de1-74ed14eca40d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=\\frac{5\\pi }{3}+n\\pi " :db/id #edb/ref 17592186296000} {:answer/id #uuid "a1e90731-2073-5376-a7f3-d74585469490" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=\\frac{5\\pi }{6}+2n\\pi " :db/id #edb/ref 17592186296130} {:answer/id #uuid "d917947c-0694-5b63-b083-5660cef98161" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=\\frac{\\pi }{6}+n\\pi " :db/id #edb/ref 17592186296412} {:answer/id #uuid "fe2df703-693b-5e97-a3f0-fa4ca9c37fb9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=\\frac{\\pi }{3}+n\\pi " :db/id #edb/ref 17592186296620}] :answer-field/correct {:answer/id #uuid "64fab536-011b-5495-af75-b22e97ee61ff" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=\\frac{5\\pi }{6}+n\\pi " :db/id #edb/ref 17592186295842} :answer-field/id #uuid "ae41aa8c-95fb-5956-b88c-4aa3ce7bb65c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186297000}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "97f191d4-6a4f-5a4f-8505-bbd4c324e609" :question/math-academy-id "q-29438" :question/problem "Which of the following expressions gives all of the zeros of the function $f(x)=2\\operatorname{cot}⁡(x-\\frac{\\pi }{3})?$ Assume that $n$ is an integer." :question/worked-solution "The zeros of $y=\\operatorname{cot}⁡x$ are given by\n\n$$\nx=\\frac{\\pi }{2}+n\\pi ,\n$$\n\nwhere $n$ is an integer.\n\nTo find the zeros of $f(x)=2\\operatorname{cot}⁡(x-\\frac{\\pi }{3}),$ we replace the $x$ on the left-hand side of the above with $(x-\\frac{\\pi }{3}).$ This gives\n\n$$\nx-\\frac{\\pi }{3}=\\frac{\\pi }{2}+n\\pi .\n$$\n\nSolving for $x,$ we get\n\n$$\n\\begin{aligned}x-\\frac{\\pi }{3} & =\\frac{\\pi }{2}+n\\pi  \\\\ x & =\\frac{\\pi }{2}+n\\pi +\\frac{\\pi }{3} \\\\ x & =\\frac{5\\pi }{6}+n\\pi .\\end{aligned}\n$$\n\nTherefore, we conclude that the zeros are $x=\\frac{5\\pi }{6}+n\\pi ,$ where $n$ is an integer."}] [{:db/id #edb/ref 17592186401948 :knowledge-point/_questions [{:db/id #edb/ref 17592186115222 :knowledge-point/id #uuid "80449399-3ae4-593f-8c3b-00bcdcc99727" :knowledge-point/title "Solving Trigonometric Equations Outside of the Range of Cosecant"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b53db17c-c360-5669-8f88-e93f4bdbd8fb" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186401950} {:answer/id #uuid "25dcd0ff-82e2-5596-97c0-808147eeda5b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186401951} {:answer/id #uuid "c06a013e-9247-5fe8-9462-4797376bce04" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186401952} {:answer/id #uuid "5d5c203d-08c8-5beb-ba1e-76f154f20aea" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186401953} {:answer/id #uuid "12121f61-eccf-5393-b245-c6404140579b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186401954}] :answer-field/correct {:answer/id #uuid "25dcd0ff-82e2-5596-97c0-808147eeda5b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186401951} :answer-field/id #uuid "8895f00a-eea4-5d81-b69d-a26ada8cb409" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186401949}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "2c11092b-9e53-51e1-b299-c5287bf677e1" :question/math-academy-id "q-29477" :question/problem "Which of the following equations has no solutions for $0\\le x<2\\pi ?$\n\nI. $\\operatorname{csc}⁡x=\\frac{1}{3}$\nII. $\\operatorname{csc}⁡x=3$\nIII. $\\operatorname{csc}⁡x=1$" :question/worked-solution "Recall that the range of $\\operatorname{csc}⁡x$ for $0\\le x<2\\pi $ is given by\n\n$$\n\\operatorname{csc}⁡x\\in (-\\infty ,-1]\\cup [1,\\infty ).\n$$\n\nSo, the equation $\\operatorname{csc}⁡x=k$ has no solutions for $k\\in (-1,1).$ \n\nTherefore, of the given equations, only equation I has no solutions."}] [{:db/id #edb/ref 17592186297237 :knowledge-point/_questions [{:db/id #edb/ref 17592186129100 :knowledge-point/id #uuid "fabd8865-cc14-508a-aa81-4ba147f7f8d4" :knowledge-point/title "Finding a General Expression for the Zeros of a Transformed Tangent or Cotangent Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "53c921c9-46e0-5bef-95de-0f5b588ebca5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=\\frac{\\pi }{6}+\\frac{n\\pi }{2}" :db/id #edb/ref 17592186295749} {:answer/id #uuid "85d07a4f-56af-578a-a679-6e632e293884" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=\\frac{\\pi }{12}+n\\pi " :db/id #edb/ref 17592186295983} {:answer/id #uuid "8c7e58fb-f78c-5c59-97d6-77d4f59a186a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=\\frac{\\pi }{4}+\\frac{n\\pi }{2}" :db/id #edb/ref 17592186296016} {:answer/id #uuid "ab14ced1-375e-5455-909c-7a3ced2bd998" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=\\frac{\\pi }{12}+\\frac{n\\pi }{2}" :db/id #edb/ref 17592186296164} {:answer/id #uuid "ee73340c-4d12-5b82-9ec4-7452a202940f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=\\frac{\\pi }{6}+n\\pi " :db/id #edb/ref 17592186296533}] :answer-field/correct {:answer/id #uuid "ab14ced1-375e-5455-909c-7a3ced2bd998" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=\\frac{\\pi }{12}+\\frac{n\\pi }{2}" :db/id #edb/ref 17592186296164} :answer-field/id #uuid "79362fdd-d341-5e89-bee7-6cb695806517" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186296881}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "670b4725-4f5f-5e5b-81ee-7bebf6dbdf85" :question/math-academy-id "q-29556" :question/problem "Which of the following expressions gives all of the zeros of the function $f(x)=2\\operatorname{tan}⁡(2x-\\frac{\\pi }{6})?$ Assume that $n$ is an integer." :question/worked-solution "The zeros of $y=\\operatorname{tan}⁡x$ are given by\n\n$$\nx=n\\pi ,\n$$\n\nwhere $n$ is an integer.\n\nTo find the zeros of $f(x)=2\\operatorname{tan}⁡(2x-\\frac{\\pi }{6}),$ we replace the $x$ on the left-hand side of the above with $(2x-\\frac{\\pi }{6}).$ This gives\n\n$$\n2x-\\frac{\\pi }{6}=n\\pi .\n$$\n\nSolving for $x,$ we get\n\n$$\n\\begin{aligned}2x-\\frac{\\pi }{6} & =n\\pi  \\\\ 2x & =n\\pi +\\frac{\\pi }{6} \\\\ x & =\\frac{\\pi }{12}+\\frac{n\\pi }{2}.\\end{aligned}\n$$\n\nTherefore, we conclude that the zeros are $x=\\frac{\\pi }{12}+\\frac{n\\pi }{2},$ where $n$ is an integer."}] [{:db/id #edb/ref 17592186297238 :knowledge-point/_questions [{:db/id #edb/ref 17592186176049 :knowledge-point/id #uuid "4241c7bd-4a2b-556f-be9f-8a884addebb9" :knowledge-point/title "Describing Properties of the Tangent Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "064a647e-d06a-50bb-9cbc-0f17389eca42" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186295298} {:answer/id #uuid "1066d92d-62c9-5dad-8b4c-dbbe71386d05" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186295362} {:answer/id #uuid "3f3a0291-6ad9-5566-9fd5-0de08933b4a6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186295630} {:answer/id #uuid "8e8ba8e5-5fce-5a75-b9a3-f9b2aab87da3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186296026} {:answer/id #uuid "bb2ff4e9-ee34-51e6-b267-06c09d19013f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186296249}] :answer-field/correct {:answer/id #uuid "8e8ba8e5-5fce-5a75-b9a3-f9b2aab87da3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186296026} :answer-field/id #uuid "b1618392-44be-533c-81a8-efd84eeee3ac" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186297006}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "c5a3a079-0ec8-5b33-84d2-568517288149" :question/math-academy-id "q-29608" :question/problem "Which of the following statements are true regarding the function $y=tan⁡x?$ Assume that $n$ represents any integer.\n\n- The function has asymptotes at $x=n\\pi .$\n- $tan⁡(x)=tan⁡(x+2n\\pi ).$\n- The range of the function is $[-1,1].$" :question/worked-solution "Let's recall the graph of $y=tan⁡x.$\n\n![](images/31/31b430f003171dcc04a8f17402d6035fbbc305c244d3676bbf5da83fa447bd50.png)\n\nLet's examine each statement.\n\n- Statement I is false. The function $y=tan⁡x$ has asymptotes at $x=\\frac{\\pi }{2}+\\pi n.$\n\n- Statement II is true. The function has period $\\pi .$ So, $tan⁡(x+2n\\pi )=tan⁡(x+n\\pi +n\\pi )=tan⁡(x+n\\pi )=tan⁡(x).$\n\n- Statement III is false. The range of $y=tan⁡x$ is $(-\\infty ,+\\infty ).$"}] [{:db/id #edb/ref 17592186395804 :knowledge-point/_questions [{:db/id #edb/ref 17592186115185 :knowledge-point/id #uuid "74c9c0f6-034c-5d9c-935a-ca27dec1a648" :knowledge-point/title "Solving a Trigonometric Equation Involving Cotangent Under a Modified Domain"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "35051668-a56c-5024-9510-5bb50d0360fc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-6\\,741" :db/id #edb/ref 17592186395806} {:answer/id #uuid "9c07c6a6-5b40-55a4-9250-674b5ab51617" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-6\\,731" :db/id #edb/ref 17592186395807} {:answer/id #uuid "0d4cbb58-b903-5380-9c08-172acb79c3a7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-6\\,631" :db/id #edb/ref 17592186395808} {:answer/id #uuid "6fbfb4e9-a306-5d6f-a040-1f5b9ed69042" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-6\\,851" :db/id #edb/ref 17592186395809} {:answer/id #uuid "8c3be72d-8de9-5e24-a778-ee5537402bbc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-6\\,561" :db/id #edb/ref 17592186395810}] :answer-field/correct {:answer/id #uuid "35051668-a56c-5024-9510-5bb50d0360fc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-6\\,741" :db/id #edb/ref 17592186395806} :answer-field/id #uuid "4440a234-4417-5c7c-aab8-361ac22515f6" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186395805}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "0fa4866c-44a3-53be-9ea4-1b3c073da31b" :question/math-academy-id "q-29664" :question/problem "Given that ${x}_{1}$ and ${x}_{2}$ are the solutions to the equation $\\operatorname{cot}⁡x=-\\frac{3}{4}$ for $-{180}^{∘}<x<{180}^{∘},$ what is the numerical value of ${x}_{1}\\cdot {x}_{2},$ rounded to the nearest integer?" :question/worked-solution "Recall that $\\operatorname{cot}⁡x=\\frac{1}{\\operatorname{tan}⁡x}.$ Therefore, the given equation is equivalent to\n\n$$\n\\operatorname{tan}⁡x=-\\frac{4}{3}\n$$\n\nNow, we find the principal value:\n\n$$\n\\begin{aligned}x & =\\operatorname{arctan}⁡(-\\frac{4}{3})=(-53.130\\,1…)^{∘}≈-{53.130}^{∘}\\end{aligned}\n$$\n\nSince $-{53.130}^{∘}$ lies inside the given domain, our first solution is ${x}_{1}=-{53.130}^{∘}.$\n\nTo generate more solutions, we add and subtract integer multiples of ${180}^{∘}.$ Hence,\n\n$$\n\\begin{aligned}{x}_{2} & ={180}^{∘}+x={180}^{∘}-{53.130}^{∘}={126.870}^{∘}.\\end{aligned}\n$$\n\nSo, the solutions are $x=-{53.130}^{∘},{126.870}^{∘}.$\n\nFinally, the numerical value of ${x}_{1}\\cdot {x}_{2}$ is \n\n$$\n-53.130\\cdot 126.870≈-6\\,741\n$$\n\nrounded to the nearest integer."}] [{:db/id #edb/ref 17592186297239 :knowledge-point/_questions [{:db/id #edb/ref 17592186064198 :knowledge-point/id #uuid "1113b2b6-ac10-5599-9e94-5bbed95e32a5" :knowledge-point/title "Evaluating the Definite Integral of a Radical Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "144a6036-1a43-5c55-bd4d-8c3b921ab81d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{4-\\sqrt{2}}{6}" :db/id #edb/ref 17592186295382} {:answer/id #uuid "1a4bc189-56e8-506b-afae-8c32583fd169" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{4+\\sqrt{2}}{6}" :db/id #edb/ref 17592186295423} {:answer/id #uuid "4809f8aa-d435-582b-a813-64757ceea05b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{4-\\sqrt{2}}{3}" :db/id #edb/ref 17592186295678} {:answer/id #uuid "598e8e48-0407-5a12-b4c7-8a90c76b22d2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2+\\sqrt{2}}{3}" :db/id #edb/ref 17592186295784} {:answer/id #uuid "addb0989-293c-52f5-817b-1eac8428806e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{4+\\sqrt{2}}{6}" :db/id #edb/ref 17592186296181}] :answer-field/correct {:answer/id #uuid "144a6036-1a43-5c55-bd4d-8c3b921ab81d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{4-\\sqrt{2}}{6}" :db/id #edb/ref 17592186295382} :answer-field/id #uuid "f0a2dd69-37ef-5e8e-92ea-d1b66a49d028" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186297125}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "380886ef-0fbf-54bc-9579-e4e21dd4f7ae" :question/math-academy-id "q-29673" :question/problem "${\\int }_{1}^{2}\\frac{1}{\\sqrt{{x}^{5}}}\\,\\text{d}x=$" :question/worked-solution "Taking the antiderivative and evaluating the difference at the bounds, we get\n\n$$\n\\begin{aligned}{\\int }_{1}^{2}\\frac{1}{\\sqrt{{x}^{5}}}\\,\\text{d}x & ={\\int }_{1}^{2}{x}^{-5/2}\\,\\text{d}x \\\\  & =\\frac{{x}^{-5/2+1}}{-\\frac{5}{2}+1}{|}_{1}^{2} \\\\  & =-\\frac{2}{3}{x}^{-3/2}{|}_{1}^{2} \\\\  & =-\\frac{2}{3}\\cdot \\frac{1}{{(\\sqrt{x})}^{3}}{|}_{1}^{2} \\\\  & =-\\frac{2}{3}(\\frac{1}{(\\sqrt{2})^{3}}-\\frac{1}{(\\sqrt{1})^{3}}) \\\\  & =-\\frac{2}{3}(\\frac{\\sqrt{2}}{4}-1) \\\\  & =-\\frac{2}{3}(\\frac{\\sqrt{2}-4}{4}) \\\\  & =\\frac{4-\\sqrt{2}}{6}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186297242 :knowledge-point/_questions [{:db/id #edb/ref 17592186078597 :knowledge-point/id #uuid "ec980fcb-97ed-5c60-94de-0521d9d7df27" :knowledge-point/title "Calculating the Definite Integral of a Piecewise Continuous Function Given the Function Expression"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0c9d9c4e-2687-5a00-b777-4684cc0de27f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "50" :db/id #edb/ref 17592186295338} {:answer/id #uuid "3ffdef35-a30a-5f30-99b8-4a995eac8ffb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-500" :db/id #edb/ref 17592186295632} {:answer/id #uuid "a6bb394a-fe2f-5d30-b8bc-9546189fbccc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186296144} {:answer/id #uuid "c0eee9c9-1fa3-56af-a61c-95a972738e2a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-50" :db/id #edb/ref 17592186296285} {:answer/id #uuid "e36988ba-6cfe-5f34-b0a1-f31a0c88f51b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "500" :db/id #edb/ref 17592186296479}] :answer-field/correct {:answer/id #uuid "c0eee9c9-1fa3-56af-a61c-95a972738e2a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-50" :db/id #edb/ref 17592186296285} :answer-field/id #uuid "e17078ea-5afe-5ed2-9a45-a07ca7d4a2b4" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186297099}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "7ee241ee-6c9b-581f-8e3e-00ecaf1e5967" :question/math-academy-id "q-29734" :question/problem "The function $f(x)$ is defined below. What is the value of \n${\\int }_{0}^{10}f(x)\\,\\text{d}x\\,?$\n\n$$\nf(x)={\\begin{aligned}x-9, & x<5 \\\\ \\frac{x}{5}-5, & x\\ge 5\\end{aligned}\n$$" :question/worked-solution "By the additive property of the definite integral, we have\n\n$$\n\\begin{aligned}{\\int }_{0}^{10}f(x)\\,\\text{d}x & ={\\int }_{0}^{5}(x-9)\\,\\text{d}x+{\\int }_{5}^{10}(\\frac{x}{5}-5)\\,\\text{d}x \\\\  & ={(\\frac{{x}^{2}}{2}-9x)|}_{0}^{5}+{(\\frac{{x}^{2}}{10}-5x)|}_{5}^{10} \\\\  & =[\\frac{(5)^{2}}{2}-9(5)-\\frac{(0)^{2}}{2}+9(0)]+[\\frac{(10)^{2}}{10}-5(10)-\\frac{(5)^{2}}{10}+5(5)] \\\\  & =[\\frac{25}{2}-45]+[10-50-\\frac{25}{10}+25] \\\\  & =-50.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186297244 :knowledge-point/_questions [{:db/id #edb/ref 17592186078597 :knowledge-point/id #uuid "ec980fcb-97ed-5c60-94de-0521d9d7df27" :knowledge-point/title "Calculating the Definite Integral of a Piecewise Continuous Function Given the Function Expression"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "021675ce-f69e-5717-beee-62f1b55fe9a1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "24" :db/id #edb/ref 17592186295272} {:answer/id #uuid "3e46952e-9cec-5cb5-af26-701cae6d5879" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-33" :db/id #edb/ref 17592186295626} {:answer/id #uuid "6dcb4361-9b61-51c7-9aaf-35ffbda245cc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-48" :db/id #edb/ref 17592186295875} {:answer/id #uuid "e3676b27-8ef7-5622-91a9-2bca7ef2dc81" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-12" :db/id #edb/ref 17592186296478} {:answer/id #uuid "fd2022c7-8746-55e0-8d32-73482f73ca68" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "15" :db/id #edb/ref 17592186296614}] :answer-field/correct {:answer/id #uuid "e3676b27-8ef7-5622-91a9-2bca7ef2dc81" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-12" :db/id #edb/ref 17592186296478} :answer-field/id #uuid "66c909a9-c1e8-56c3-a557-6fc2fdb9e1a8" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186296847}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "598039da-8879-5b3c-ab71-e359f8b00731" :question/math-academy-id "q-29742" :question/problem "The function $f(x)$ is defined below. What is the value of \n${\\int }_{0}^{6}f(x)\\,\\text{d}x\\,?$\n\n$$\nf(x)={\\begin{aligned}3x-9, & x<3 \\\\ \\frac{x}{3}-1, & x\\ge 3\\end{aligned}\n$$" :question/worked-solution "By the additive property of the definite integral, we have\n\n$$\n\\begin{aligned}{\\int }_{0}^{6}f(x)\\,\\text{d}x & ={\\int }_{0}^{3}(3x-9)\\,\\text{d}x+{\\int }_{3}^{6}(\\frac{x}{3}-1)\\,\\text{d}x \\\\  & ={(\\frac{3{x}^{2}}{2}-9x)|}_{0}^{3}+{(\\frac{{x}^{2}}{6}-x)|}_{3}^{6} \\\\  & =[\\frac{3(3)^{2}}{2}-9(3)-\\frac{3(0)^{2}}{2}+9(0)]+[\\frac{(6)^{2}}{6}-6-\\frac{(3)^{2}}{6}+3] \\\\  & =[\\frac{27}{2}-27]+[6-6-\\frac{3}{2}+3] \\\\  & =-\\frac{27}{2}+\\frac{3}{2} \\\\  & =-12.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186064716 :knowledge-point/_questions [{:db/id #edb/ref 17592186064196 :knowledge-point/id #uuid "67bbd172-1940-5a1e-82f8-ffc73058f009" :knowledge-point/title "Evaluating the Definite Integral of a Polynomial Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0a6f3f8e-0c5f-5742-981c-efe44d651035" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "189" :db/id #edb/ref 17592186295321} {:answer/id #uuid "7306755f-204c-5784-9675-85e4c40d4fec" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "63" :db/id #edb/ref 17592186295896} {:answer/id #uuid "97ff1ca8-cab0-5552-a6be-a28c36723d02" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{125}{3}" :db/id #edb/ref 17592186296080} {:answer/id #uuid "9cbdd0be-cf59-5728-817c-107e52a30f10" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{189}{2}" :db/id #edb/ref 17592186296104} {:answer/id #uuid "ce989bf2-91f9-5cfb-894e-5fff41cce741" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{64}{3}" :db/id #edb/ref 17592186296349}] :answer-field/correct {:answer/id #uuid "7306755f-204c-5784-9675-85e4c40d4fec" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "63" :db/id #edb/ref 17592186295896} :answer-field/id #uuid "29935fac-8196-589a-b966-f9c10dd6483e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186296714}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "1ea9ad4a-c4e1-5eef-bc95-8f5cd98ebf22" :question/math-academy-id "q-29744" :question/problem "Evaluate  ${\\int }_{-5}^{4}{x}^{2}\\,\\text{d}x.$" :question/worked-solution "Taking the antiderivative and evaluating the difference at the bounds, we get\n\n$$\n\\begin{aligned}{\\int }_{-5}^{4}{x}^{2}\\,\\text{d}x & =\\frac{{x}^{2+1}}{2+1}{|}_{-5}^{4} \\\\  & =\\frac{{x}^{3}}{3}{|}_{-5}^{4} \\\\  & =\\frac{{4}^{3}}{3}-\\frac{(-5)^{3}}{3} \\\\  & =\\frac{64}{3}+\\frac{125}{3} \\\\  & =63.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186297247 :knowledge-point/_questions [{:db/id #edb/ref 17592186115212 :knowledge-point/id #uuid "66c5a147-0100-5f4b-a221-25b8674b2115" :knowledge-point/title "Evaluating the Integral of a Sum of Two Functions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2ac468f7-459a-524a-906d-0b77ce69c347" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "54" :db/id #edb/ref 17592186295509} {:answer/id #uuid "3866e65f-5a6b-5139-971d-78279fa95a54" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{128}{5}" :db/id #edb/ref 17592186295585} {:answer/id #uuid "3d776cfc-e9b5-5e0f-a90c-6c72a5495162" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5}{268}" :db/id #edb/ref 17592186295619} {:answer/id #uuid "4cdc102e-c773-5605-aa07-bee1b412e617" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "28" :db/id #edb/ref 17592186295706} {:answer/id #uuid "d67385d1-7806-5881-a583-0cce0325b5ec" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{268}{5}" :db/id #edb/ref 17592186296394}] :answer-field/correct {:answer/id #uuid "d67385d1-7806-5881-a583-0cce0325b5ec" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{268}{5}" :db/id #edb/ref 17592186296394} :answer-field/id #uuid "55e2b20e-f764-56d3-b81b-879a2eeacf48" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186296806}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "953eaea1-7562-55f0-8e7b-723ba8d5e0ae" :question/math-academy-id "q-29780" :question/problem "Evaluate ${\\int }_{0}^{4}(2\\sqrt{{x}^{3}}+3x+1)\\,\\text{d}x.$" :question/worked-solution "First, we rewrite the integral as\n\n$$\n{\\int }_{0}^{4}(2\\sqrt{{x}^{3}}+3x+1)\\,\\text{d}x={\\int }_{0}^{4}(2{x}^{3/2}+3x+1)\\,\\text{d}x.\n$$\n\nThen, we split the integral into the difference of three integrals and factor out the constants. We get\n\n$$\n\\begin{aligned}\\begin{aligned}{\\int }_{0}^{4}(2{x}^{3/2}+3x+1)\\,\\text{d}x & =2{\\int }_{0}^{4}{x}^{3/2}\\,\\text{d}x+3{\\int }_{0}^{4}x\\,\\text{d}x+{\\int }_{0}^{4}1\\,\\text{d}x \\\\  & =2\\cdot \\frac{2}{5}{x}^{5/2}{|}_{0}^{4}+3\\cdot \\frac{{x}^{2}}{2}{|}_{0}^{4}+x\\,{|}_{0}^{4} \\\\  & =\\frac{4}{5}{x}^{5/2}{|}_{0}^{4}+\\frac{3}{2}{x}^{2}{|}_{0}^{4}+x\\,{|}_{0}^{4} \\\\  & =\\frac{4}{5}({4}^{5/2}-{0}^{5/2})+\\frac{3}{2}({4}^{2}-{0}^{2})+(4-0) \\\\  & =\\frac{4}{5}\\cdot 32+\\frac{3}{2}\\cdot 16+4 \\\\  & =\\frac{128}{5}+28 \\\\  & =\\frac{268}{5}.\\end{aligned}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186297248 :knowledge-point/_questions [{:db/id #edb/ref 17592186105715 :knowledge-point/id #uuid "cf98ee24-7774-5674-8a1e-63f4f6d225c0" :knowledge-point/title "Integrating a Reciprocal Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "155da407-c8ba-5fa2-9127-413d6bff8d2a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3ln⁡x+C" :db/id #edb/ref 17592186295391} {:answer/id #uuid "2ca76ff5-0227-56f5-94be-d80b462a5d45" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{ln⁡x}+C" :db/id #edb/ref 17592186295528} {:answer/id #uuid "5c5899f6-d895-5413-bfee-0587b9cf1149" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3ln⁡|x|+C" :db/id #edb/ref 17592186295802} {:answer/id #uuid "705c2710-b928-5586-a10e-67ac7d7acb16" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3ln⁡|x|+C" :db/id #edb/ref 17592186295884} {:answer/id #uuid "bd595728-5d66-5fce-842a-829a9bf9e495" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{-3}{ln⁡|x|}+C" :db/id #edb/ref 17592186296265}] :answer-field/correct {:answer/id #uuid "705c2710-b928-5586-a10e-67ac7d7acb16" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3ln⁡|x|+C" :db/id #edb/ref 17592186295884} :answer-field/id #uuid "d6439f4c-9689-5960-aa2c-ca05e0a5ed1d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186297080}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "f3f7435c-4593-5eb7-979c-b6475dc0ac4f" :question/math-academy-id "q-29831" :question/problem "Calculate $\\int -\\frac{3}{x}\\,\\text{d}x=$" :question/worked-solution "First, we apply the constant factor rule and take the coefficient $-3$ out of the integral. Then we compute the integral of $\\frac{1}{x},$ and get\n\n$$\n\\begin{aligned}\\int -\\frac{3}{x}\\,\\text{d}x & =-3\\int \\frac{1}{x}\\,\\text{d}x \\\\  & =-3ln⁡|x|+C.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186297249 :knowledge-point/_questions [{:db/id #edb/ref 17592186105720 :knowledge-point/id #uuid "df7dddc6-a4fd-5b1b-9b73-8528e5224ca9" :knowledge-point/title "Integrating a Reciprocal Function and Simplifying the Arbitrary Constant Using the Laws of Logarithms"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0b9f3ccb-57a5-54e7-9651-cd8e38e071bb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}ln⁡(5K|x|)" :db/id #edb/ref 17592186295330} {:answer/id #uuid "137963fa-e7bf-5b99-b97d-16a6e2b83b62" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5}{2}ln⁡(K|x|)" :db/id #edb/ref 17592186295376} {:answer/id #uuid "3ba78d99-70e5-5576-9ab3-f6f5d63e5557" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{5}{2}ln⁡(K|x|)" :db/id #edb/ref 17592186295610} {:answer/id #uuid "ab6cacd1-8561-54df-98e0-e7424109595d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-ln⁡(\\frac{5}{2}K|x|)" :db/id #edb/ref 17592186296168} {:answer/id #uuid "e35e2f64-0c17-5dfe-a27c-81e2452e3e98" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{5}{2}ln⁡(|x|+K)" :db/id #edb/ref 17592186296477}] :answer-field/correct {:answer/id #uuid "3ba78d99-70e5-5576-9ab3-f6f5d63e5557" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{5}{2}ln⁡(K|x|)" :db/id #edb/ref 17592186295610} :answer-field/id #uuid "c450e82f-bb3f-51ae-bbf9-78580de51634" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186297036}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "eec65b66-7ead-5d6e-b179-5aacd453b9d8" :question/math-academy-id "q-29834" :question/problem "What is the antiderivative of $-\\frac{5}{2x}?$" :question/worked-solution "First, we apply the constant factor rule and take the coefficient $-\\frac{5}{2}$ out of the integral. Then we compute the integral of $\\frac{1}{x},$ and get\n\n$$\n\\begin{aligned}\\int -\\frac{5}{2x}\\,\\text{d}x & =-\\frac{5}{2}\\int \\frac{1}{x}\\,\\text{d}x \\\\  & =-\\frac{5}{2}ln⁡|x|+C.\\end{aligned}\n$$\n\nLastly, let's rewrite the constant so that we can combine it with the natural logarithm. For any constant $C,$ we can always write $C=-\\frac{5}{2}ln⁡K$ where $K$ is some other positive constant. Doing this allows us to combine the constant with $-\\frac{5}{2}ln⁡|x|$ term, and we get\n\n$$\n\\begin{aligned}\\int -\\frac{5}{2x}\\,\\text{d}x & =-\\frac{5}{2}ln⁡|x|-\\frac{5}{2}ln⁡K \\\\  & =-\\frac{5}{2}(ln⁡|x|+ln⁡K) \\\\  & =-\\frac{5}{2}ln⁡(K|x|).\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186297251 :knowledge-point/_questions [{:db/id #edb/ref 17592186105716 :knowledge-point/id #uuid "3c865ec2-5bed-5892-966b-a586097be923" :knowledge-point/title "Integrating the Sum of a Reciprocal Function and a Power Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "298a44ce-4517-57c9-8784-5136e6d9c6af" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{11}{5}{x}^{11/3}+\\sqrt{5}\\operatorname{ln}⁡|x|+C" :db/id #edb/ref 17592186295500} {:answer/id #uuid "2e55410d-693f-527e-b63c-efdd8027016a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{7}{5}{x}^{4/3}+2\\operatorname{ln}⁡|x|+C" :db/id #edb/ref 17592186295534} {:answer/id #uuid "91074ff5-3842-537b-b69c-20abfee3093d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3\\operatorname{ln}⁡x}{5}{x}^{5/3}+\\operatorname{ln}⁡|x|+C" :db/id #edb/ref 17592186296046} {:answer/id #uuid "ae484638-462d-55ee-b006-7e7f7e36be1e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{9}{5}{x}^{7/3}+\\sqrt{3}\\operatorname{ln}⁡|x|+C" :db/id #edb/ref 17592186296183} {:answer/id #uuid "d6b38dca-ffa5-5659-aa91-113d55a9cced" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{5}{x}^{5/3}+\\sqrt{2}\\operatorname{ln}⁡|x|+C" :db/id #edb/ref 17592186296395}] :answer-field/correct {:answer/id #uuid "d6b38dca-ffa5-5659-aa91-113d55a9cced" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{5}{x}^{5/3}+\\sqrt{2}\\operatorname{ln}⁡|x|+C" :db/id #edb/ref 17592186296395} :answer-field/id #uuid "d4ea97da-7b64-5d03-a1a8-9448f2925fe1" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186297075}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "a9a35970-b3a0-5bae-b863-30b3731d8d68" :question/math-academy-id "q-29885" :question/problem "Calculate $\\int ({x}^{2/3}+\\frac{\\sqrt{2}}{x})\\,\\text{d}x.$" :question/worked-solution "First, we apply the sum rule and get\n\n$$\n\\int ({x}^{2/3}+\\frac{\\sqrt{2}}{x})\\,\\text{d}x=\\int {x}^{2/3}\\,\\text{d}x+\\sqrt{2}\\int \\frac{1}{x}\\,\\text{d}x\n$$\n\nNow, using the power rule in the first term, and taking out the coefficient in the second term, we get\n\n$$\n\\begin{aligned}\\int {x}^{2/3}\\,\\text{d}x+\\sqrt{2}\\int \\frac{1}{x}\\,\\text{d}x & =\\frac{{x}^{2/3+1}}{\\frac{2}{3}+1}+\\sqrt{2}\\operatorname{ln}⁡|x|+C \\\\  & =\\frac{3}{5}{x}^{5/3}+\\sqrt{2}\\operatorname{ln}⁡|x|+C.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186297254 :knowledge-point/_questions [{:db/id #edb/ref 17592186105716 :knowledge-point/id #uuid "3c865ec2-5bed-5892-966b-a586097be923" :knowledge-point/title "Integrating the Sum of a Reciprocal Function and a Power Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0abba1e8-07a5-5982-8931-920e2b54ed11" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-5ln⁡|x|+C" :db/id #edb/ref 17592186295324} {:answer/id #uuid "14c3a82a-71bb-5b22-a1d7-5d3ffaa433a8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-4ln⁡|x|+C" :db/id #edb/ref 17592186295384} {:answer/id #uuid "218a6eff-a0a2-5775-878d-fb334d854a63" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4ln⁡|x|+C" :db/id #edb/ref 17592186295454} {:answer/id #uuid "5203ee4a-c762-565e-a1e7-1c414c5d786d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-6x+C" :db/id #edb/ref 17592186295738} {:answer/id #uuid "e96a5e23-083b-5d3f-bddc-50fd9a0aed8b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5x+C" :db/id #edb/ref 17592186296509}] :answer-field/correct {:answer/id #uuid "14c3a82a-71bb-5b22-a1d7-5d3ffaa433a8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-4ln⁡|x|+C" :db/id #edb/ref 17592186295384} :answer-field/id #uuid "65380cf5-c8c6-595a-9584-e99d721414af" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186296843}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "77e80b12-44f5-5ee6-b586-d6d7898a0c32" :question/math-academy-id "q-29915" :question/problem "Find the integral of $\\frac{\\sqrt{{x}^{3}}}{\\sqrt{{x}^{5}}}-5{x}^{-1}$ with respect to $x.$" :question/worked-solution "Simplifying the exponents and applying the sum and constant factor rules, we get\n\n$$\n\\begin{aligned}\\int (\\frac{\\sqrt{{x}^{3}}}{\\sqrt{{x}^{5}}}-5{x}^{-1})\\text{d}x & =\\int \\frac{1}{{x}^{5/2-3/2}}\\,\\text{d}x-5\\int \\frac{1}{x}\\,\\text{d}x \\\\  & =\\int \\frac{1}{x}\\,\\text{d}x-5\\int \\frac{1}{x}\\,\\text{d}x \\\\  & =-4\\int \\frac{1}{x}\\,\\text{d}x \\\\  & =-4ln⁡|x|+C.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186395811 :knowledge-point/_questions [{:db/id #edb/ref 17592186115183 :knowledge-point/id #uuid "65e15de1-ee72-55ea-accb-1124f3a0ac0c" :knowledge-point/title "Solving Trigonometric Equations Involving Cosecant Under a Modified Domain"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ab6f005d-5267-58e5-84bf-a80272331a4e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4\\,176" :db/id #edb/ref 17592186395813} {:answer/id #uuid "7e3a07e3-abf9-52a3-90a9-53487e034b7f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "7\\,641" :db/id #edb/ref 17592186395814} {:answer/id #uuid "ce65e29e-1b9d-54dc-94af-379795c62563" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6\\,741" :db/id #edb/ref 17592186395815} {:answer/id #uuid "198aafc0-07ef-5e53-9034-41f2a9658b0c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4\\,746" :db/id #edb/ref 17592186395816} {:answer/id #uuid "21c0594d-dee0-5fde-9687-2438c3bda33b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1\\,764" :db/id #edb/ref 17592186395817}] :answer-field/correct {:answer/id #uuid "ce65e29e-1b9d-54dc-94af-379795c62563" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6\\,741" :db/id #edb/ref 17592186395815} :answer-field/id #uuid "d68ef59f-9eeb-59d5-b977-da3a30f3eafc" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186395812}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "fa37b599-4ad5-59f0-a1aa-7677947192cf" :question/math-academy-id "q-29938" :question/problem "Given that ${x}_{1}$ and ${x}_{2}$ are the solutions to the equation $\\operatorname{csc}⁡x=\\frac{5}{4}$ for $-{180}^{∘}\\le x<{180}^{∘},$ what is the numerical value of ${x}_{1}\\cdot {x}_{2},$ rounded to the nearest integer?" :question/worked-solution "Recall that $\\operatorname{csc}⁡x=\\frac{1}{\\operatorname{sin}⁡x},$ therefore the given equation is equivalent to\n\n$$\n\\operatorname{sin}⁡x=\\frac{4}{5}.\n$$\n\nNow, we have to find the principal value:\n\n$$\nx=\\operatorname{arcsin}⁡(\\frac{4}{5})=(53.130\\,1…)^{∘}≈{53.130}^{∘}\n$$\n\nSince ${53.130}^{∘}$ lies inside the given domain, our first solution is ${x}_{1}={53.130}^{∘}.$\n\nOur first solution lies in the first quadrant and has a reference angle of ${\\theta }_{R}={53.130}^{∘}.$ Since $\\operatorname{sin}⁡x>0,$ the second solution must lie in the second quadrant, and it also has a reference angle ${\\theta }_{R}={53.130}^{∘}.$\n\n![](images/60/605af77803fb027c09833b50801fe4b8e6a42a2b623af94a732d0f2f222f9f4a.png)\n\nSince the second solution ${x}_{2}$ lies in the $2$nd quadrant, we can find it using the reference angle as follows:\n\n$$\n\\begin{aligned}{x}_{2} & ={180}^{∘}-{\\theta }_{R} \\\\  & ={180}^{∘}-{53.130}^{∘} \\\\  & ={126.870}^{∘}\\end{aligned}\n$$\n\nTherefore, the solutions are $x={53.130}^{∘},{126.870}^{∘}.$\n\nFinally,\n\n$$\n{x}_{1}\\cdot {x}_{2}≈53.130\\cdot 126.870≈6\\,741.\n$$\n\nrounded to the nearest integer."}] [{:db/id #edb/ref 17592186297256 :knowledge-point/_questions [{:db/id #edb/ref 17592186068760 :knowledge-point/id #uuid "f7614a05-f221-5fda-b491-6893f44a1a5f" :knowledge-point/title "Dividing Rational Expressions with Multiple Common Factors"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3c4f1d16-78b3-5045-8bb5-5579fec4543a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{11(k+2)}{{y}^{2}}" :db/id #edb/ref 17592186295613} {:answer/id #uuid "4d3602d9-f3c5-5344-8c7b-288df52749cd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{11{y}^{2}}{k+4}" :db/id #edb/ref 17592186295709} {:answer/id #uuid "93b20eed-4388-595a-84d8-977910934218" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{k+4}{{y}^{2}}" :db/id #edb/ref 17592186296058} {:answer/id #uuid "aa7ed919-742c-5a4c-b988-a4265e3f6f06" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{y}^{2}}{44(k+2)}" :db/id #edb/ref 17592186296162} {:answer/id #uuid "e8492be0-a6b9-5d09-afa1-2e0f3bbeb2cf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{22(k+2)}{{y}^{2}}" :db/id #edb/ref 17592186296502}] :answer-field/correct {:answer/id #uuid "e8492be0-a6b9-5d09-afa1-2e0f3bbeb2cf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{22(k+2)}{{y}^{2}}" :db/id #edb/ref 17592186296502} :answer-field/id #uuid "17d9d487-4676-539c-9b1c-0c3a024bdb73" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186296680}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "964f86e1-4f13-55f4-a1ab-8caf3da2db2d" :question/math-academy-id "q-29970" :question/problem "If $\\frac{2(k+2)}{121y}\\cdot Y=\\frac{4(k+2)^{2}}{11{y}^{3}},$ then what is $Y?$" :question/worked-solution "Since $\\frac{2(k+2)}{121y}\\cdot Y=\\frac{4(k+2)^{2}}{11{y}^{3}},$ we have\n\n$$\nY=\\frac{4(k+2)^{2}}{11{y}^{3}}÷\\frac{2(k+2)}{121y}.\n$$\n\nTo compute this quotient, we just need to multiply by the reciprocal of the divisor:\n\n$$\n\\begin{aligned}\\frac{4(k+2)^{2}}{11{y}^{3}}÷\\frac{2(k+2)}{121y} & = \\\\ \\frac{4(k+2)^{2}}{11{y}^{3}}\\cdot \\frac{121y}{2(k+2)} & = \\\\ \\frac{2\\cdot 2(k+2)\\cdot (k+2)}{11y\\cdot {y}^{2}}\\cdot \\frac{11\\cdot 11y}{2(k+2)} & = \\\\ \\frac{2\\cdot \\cancel{2(k+2)}\\cdot (k+2)}{\\cancel{11y}\\cdot {y}^{2}}\\cdot \\frac{11\\cdot \\cancel{11y}}{\\cancel{2(k+2)}} & = \\\\ \\frac{2(k+2)}{{y}^{2}}\\cdot 11 & = \\\\ \\frac{22(k+2)}{{y}^{2}}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186069217 :knowledge-point/_questions [{:db/id #edb/ref 17592186068860 :knowledge-point/id #uuid "9d78ba1c-5297-5540-afdc-d419d33e0cf7" :knowledge-point/title "Solving a Quadratic Equation When the Solutions Are Rational"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9253c945-96c0-5170-ab31-77a3ad0f24d4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "p + q = 7, x_{1} + x_{2} = 4" :db/id #edb/ref 17592186066485} {:answer/id #uuid "a2710526-3439-5d45-a3cb-b94809df5d4a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "p + q = 9, x_{1} + x_{2} = 4" :db/id #edb/ref 17592186066486} {:answer/id #uuid "b5eac8af-989a-5812-82cd-e6e80a244860" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "p + q = 7, x_{1} + x_{2} =-4" :db/id #edb/ref 17592186066487} {:answer/id #uuid "cec6266a-38e0-5082-ae2c-0c20a9b251e4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "p + q = 7, x_{1} + x_{2} = 6" :db/id #edb/ref 17592186066488} {:answer/id #uuid "d0b0d285-5968-53b9-b5b2-00fcaf5e3048" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "p + q =-11x_{1} + x_{2} = 4" :db/id #edb/ref 17592186066489}] :answer-field/id #uuid "d792d360-b68f-53ea-add1-82615c19183b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186066484} {:answer-field/choices [{:answer/id #uuid "76d7ebef-b52d-5f30-ac74-d49866c8f6a9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "p+q=7\\,,\\,\\,{x}_{1}+{x}_{2}=4" :db/id #edb/ref 17592186401956} {:answer/id #uuid "d00f8b18-cb37-5c31-961a-3438330ad683" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "p+q=7\\,,\\,\\,{x}_{1}+{x}_{2}=6" :db/id #edb/ref 17592186401957} {:answer/id #uuid "ae0444d5-a369-5e49-89bd-c5ebc8c0237a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "p+q=-11\\,\\,\\,{x}_{1}+{x}_{2}=4" :db/id #edb/ref 17592186401958} {:answer/id #uuid "44f7e400-b932-5f1e-a0ab-bdb9a22e3846" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "p+q=7\\,,\\,\\,{x}_{1}+{x}_{2}=-4" :db/id #edb/ref 17592186401959} {:answer/id #uuid "7d8857d6-881c-5549-bde0-3f1a4f61d2d7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "p+q=9\\,,\\,\\,{x}_{1}+{x}_{2}=4" :db/id #edb/ref 17592186401960}] :answer-field/correct {:answer/id #uuid "76d7ebef-b52d-5f30-ac74-d49866c8f6a9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "p+q=7\\,,\\,\\,{x}_{1}+{x}_{2}=4" :db/id #edb/ref 17592186401956} :answer-field/id #uuid "b5fa6494-6274-595a-88b0-e033638de4a2" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186401955}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "c02e0e4e-c511-5b9e-9632-6db46dfe1bf6" :question/math-academy-id "q-30052" :question/problem "The equation ${x}^{2}-4x+4=9$ can be written in the form $(x+p)^{2}=q.$ Find $\\,p+q,$ and the sum of the roots ${x}_{1}+{x}_{2}.$" :question/worked-solution "First, we move the constant term to the right-hand side and complete the square on the left-hand side:\n\n$$\n\\begin{aligned}{x}^{2}-4x+4 & =9 \\\\ {x}^{2}-4x & =5 \\\\ {x}^{2}-2\\cdot 2\\cdot x & =5 \\\\ {x}^{2}-2\\cdot 2\\cdot x+{2}^{2}-{2}^{2} & =5 \\\\ ({x}^{2}-2\\cdot 2\\cdot x+{2}^{2})-4 & =5 \\\\ (x-2)^{2}-4 & =5\\end{aligned}\n$$\n\nThen, we isolate the perfect square:\n\n$$\n\\begin{aligned}(x-2)^{2}-4 & =5 \\\\ (x-2)^{2} & =9\\end{aligned}\n$$\n\nSo, $p=-2,q=9,$ and $p+q=7.$\n\nNow, we solve the equation using the square-root method:\n\n$$\n\\begin{aligned}(x-2)^{2} & =9 \\\\ \\sqrt{(x-2)^{2}} & =\\sqrt{9} \\\\ x-2 & =\\pm 3 \\\\ x & =2\\pm 3\\end{aligned}\n$$\n\nWe simplify the two solutions:\n\n$$\n\\begin{aligned}{x}_{1} & =2+3=5 \\\\ {x}_{2} & =2-3=-1\\end{aligned}\n$$\n\nSo, the solutions are ${x}_{1}=-1$ and ${x}_{2}=5.$ Thus, the sum is $4.$"}] [{:db/id #edb/ref 17592186401961 :knowledge-point/_questions [{:db/id #edb/ref 17592186068860 :knowledge-point/id #uuid "9d78ba1c-5297-5540-afdc-d419d33e0cf7" :knowledge-point/title "Solving a Quadratic Equation When the Solutions Are Rational"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f24ab63d-b4d8-50ae-8389-5045b51319bb" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$pq=0\\,$ and $\\,{x}_{1}+{x}_{2}=2$" :db/id #edb/ref 17592186401963} {:answer/id #uuid "6c1507f7-b1b3-56e3-a38c-1b563d660137" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$pq=-1\\,$ and $\\,{x}_{1}+{x}_{2}=1$" :db/id #edb/ref 17592186401964} {:answer/id #uuid "b2d7f47d-c746-5735-9e9f-835593e46fab" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$pq=-1\\,$ and $\\,{x}_{1}+{x}_{2}=2$" :db/id #edb/ref 17592186401965} {:answer/id #uuid "aa922213-ad7d-513f-ad50-36362f5e8cc5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$pq=1\\,$ and $\\,{x}_{1}+{x}_{2}=2$" :db/id #edb/ref 17592186401966} {:answer/id #uuid "b9d50863-24e6-52af-928c-18cf82d1862f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$pq=-1\\,$ and $\\,{x}_{1}+{x}_{2}=-1$" :db/id #edb/ref 17592186401967}] :answer-field/correct {:answer/id #uuid "b2d7f47d-c746-5735-9e9f-835593e46fab" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$pq=-1\\,$ and $\\,{x}_{1}+{x}_{2}=2$" :db/id #edb/ref 17592186401965} :answer-field/id #uuid "5f724395-4532-5650-9bbb-1b5a58b225fd" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186401962}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "85741874-6828-5db4-a1ab-e8bb9b524df8" :question/math-academy-id "q-30055" :question/problem "The equation ${x}^{2}-2x+1=1$ can be written in the form $(x+p)^{2}=q.$ Find $\\,pq\\,,$ and the sum of the roots ${x}_{1}+{x}_{2}.$" :question/worked-solution "First, we move the constant term to the right-hand side and complete the square on the left-hand side:\n\n$$\n\\begin{aligned}{x}^{2}-2x+1 & =1 \\\\ {x}^{2}-2x & =0 \\\\ {x}^{2}-2\\cdot x\\cdot 1+{1}^{2}-{1}^{2} & =0 \\\\ (x-1)^{2}-{1}^{2} & =0 \\\\ (x-1)^{2} & =1\\end{aligned}\n$$\n\nHence, $p=-1$ and $q=1.$ Thus, $pq=-1.$\n\nWe now solve the equation using the square root method:\n\n$$\n\\begin{aligned}(x-1)^{2} & =1 \\\\ \\sqrt{(x-1)^{2}} & =\\sqrt{1} \\\\ |x-1| & =1 \\\\ x-1 & =\\pm 1 \\\\ x & =1\\pm 1\\end{aligned}\n$$\n\nWe simplify the two solutions:\n\n$$\n\\begin{aligned}{x}_{1} & =1-1=0 \\\\ {x}_{2} & =1+1=2\\end{aligned}\n$$\n\nTherefore, the sum is ${x}_{1}+{x}_{2}=2.$"}] [{:db/id #edb/ref 17592186297263 :knowledge-point/_questions [{:db/id #edb/ref 17592186064383 :knowledge-point/id #uuid "09a63d93-5813-5d72-8505-d2f327ab8df7" :knowledge-point/title "Calculating the Rate of Change of a Hypotenuse Using the Pythagorean Theorem"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "08810676-42bc-5443-a66e-fe0b75d16a37" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8.2\\text{ ft/s}" :db/id #edb/ref 17592186295309} {:answer/id #uuid "1163523e-ffc1-5258-a832-609cf6ca500a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "18.2\\text{ ft/s}" :db/id #edb/ref 17592186295366} {:answer/id #uuid "713eebca-b67d-5424-84ff-32ac69527be7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "28\\text{ ft/s}" :db/id #edb/ref 17592186295890} {:answer/id #uuid "97cc87e4-1ea3-5c54-b81a-3581f3f304d8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "9\\text{ ft/s}" :db/id #edb/ref 17592186296078} {:answer/id #uuid "f6718237-cd3c-51e1-8d8a-7dd3e545dc5c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2.8\\text{ ft/s}" :db/id #edb/ref 17592186296579}] :answer-field/correct {:answer/id #uuid "08810676-42bc-5443-a66e-fe0b75d16a37" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8.2\\text{ ft/s}" :db/id #edb/ref 17592186295309} :answer-field/id #uuid "a20649a5-6705-5b56-9e09-c13fa8269878" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186296977}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "ff7f5106-2da2-5fdb-b8a4-ffffc41203d1" :question/math-academy-id "q-30080" :question/problem "Two cars, $A$ and $B,$ are both initially at the point $O,$ and they both depart from $O$ at the same time. Car $A$ travels due east, and its distance from $O$ is given by $3t\\,\\text{ft}.$ Car $B$ travels due north, and its distance from $O$ is $2{t}^{2}\\,\\text{ft}.$ Here, $t$ is the time, measured in seconds. What is the rate of the change of the distance between the two cars after $2$ seconds?" :question/worked-solution "Let's draw a diagram of the problem.\n\n![](images/aa/aa3f39f65b0785cfca2d1545e4bf331281f523f5e19777372dbb44096bdb4223.png)\n\nIn the diagram,\n\n- $x$ is the distance between car $A$ and point $O$,\n\n- $y$ is the distance between car $B$ and point $O$, and\n\n- $z$ is the distance between car $A$ and car $B.$\n\nAs shown in the diagram, $x,$ $y,$ and $z$ form a right triangle with $z$ as the hypotenuse. We wish to find the rate of change of $z,$ which is $\\frac{\\text{d}z}{\\text{d}t}.$\n\nFirst, we determine the distance traveled by the cars after $2$ seconds. We get \n\n$$\nx=x(2)=3(2)=6\\text{ ft}\n$$\n\nand\n\n$$\ny=y(2)=2(2)^{2}=8\\text{ ft}.\n$$\n\nWe can find $z$ using the Pythagorean Theorem, as follows: \n\n$$\n\\begin{aligned}{x}^{2}+{y}^{2} & ={z}^{2} \\\\ {6}^{2}+{8}^{2} & ={z}^{2} \\\\ 100 & ={z}^{2} \\\\ z & =10\\,\\text{mi}\\end{aligned}\n$$\n\nThe velocity of the cars is given by $\\frac{\\text{d}x}{\\text{d}t}={x}^{′}(t)=3$ and $\\frac{\\text{d}y}{\\text{d}t}={y}^{′}(t)=4t.$ So, when $t=2$ their velocities are\n\n- $\\frac{\\text{d}y}{\\text{d}t}={y}^{′}(2)=8\\text{ ft/s}$ after $2$ seconds,\n\n- $\\frac{\\text{d}x}{\\text{d}t}={x}^{′}(2)=3\\text{ ft/s}$ after $2$ seconds.\n\nFinally, we differentiate both sides of ${x}^{2}+{y}^{2}={z}^{2}$ with respect to $t$ and then substitute the known values, as follows:\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}t}({x}^{2}+{y}^{2}) & =\\frac{\\text{d}}{\\text{d}t}({z}^{2}) \\\\ 2x\\frac{\\text{d}x}{\\text{d}t}+2y\\frac{\\text{d}y}{\\text{d}t} & =2z\\frac{\\text{d}z}{\\text{d}t} \\\\ 2(6)(3)+2(8)(8) & =2(10)\\frac{\\text{d}z}{\\text{d}t} \\\\ 164 & =20\\frac{\\text{d}z}{\\text{d}t} \\\\ \\frac{\\text{d}z}{\\text{d}t} & =8.2\\end{aligned}\n$$\n\nTherefore, the distance between the cars is changing at a rate of  $8.2\\text{ ft/s}$ after $2$ seconds."}] [{:db/id #edb/ref 17592186297279 :knowledge-point/_questions [{:db/id #edb/ref 17592186087823 :knowledge-point/id #uuid "40eeb5a8-3ffe-54d2-b263-f2b1c41fed93" :knowledge-point/title "Identifying a Vertically Shifted and Stretched Exponential Growth Curve"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0265ab4b-e69c-58cd-bb39-877b73f3298f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(0,11.5)" :db/id #edb/ref 17592186295275} {:answer/id #uuid "6ab493a4-b37f-5582-a8b9-4570920c001f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(10.5,0)" :db/id #edb/ref 17592186295861} {:answer/id #uuid "a1678182-8bd9-5b40-83a4-560b3c92dfe8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(0,10.5)" :db/id #edb/ref 17592186296126} {:answer/id #uuid "ecdd579a-68d8-530f-aec2-948295be5064" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(0,5.5)" :db/id #edb/ref 17592186296522} {:answer/id #uuid "f541b6c1-d1ab-5c71-9e34-c29b7b48861a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(5.5,0)" :db/id #edb/ref 17592186296566}] :answer-field/correct {:answer/id #uuid "a1678182-8bd9-5b40-83a4-560b3c92dfe8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(0,10.5)" :db/id #edb/ref 17592186296126} :answer-field/id #uuid "b0972749-6df3-5836-b156-61b2f017bcaf" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186297005}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "91d38446-45fe-5f55-b13c-726fa96fa8c7" :question/math-academy-id "q-30269" :question/problem "For the curve $y=2.5({1.5}^{x})+8$, find the point of intersection with the $y-$axis." :question/worked-solution "**Method 1**\n\n- For the curve $y={1.5}^{x},$ the point of intersection with the $y$-axis is $(0,1).$\n\n- For the scaled function $y=2.5({1.5}^{x}),$ the $y$-coordinate becomes\n\n$$\ny=2.5\\cdot 1=2.5.\n$$\n\n- Finally, after a vertical shift of $8$ units up, we get a point with the $y$-coordinate\n\n$$\ny=2.5+8=10.5.\n$$\n\n**Method 2** \n\nTo find the $y$-intercept, we substitute $x=0$ into the equation of the curve:\n\n$$\n\\begin{aligned}y & =2.5({1.5}^{0})+8 \\\\  & =2.5\\cdot 1+8 \\\\  & =2.5+8 \\\\  & =10.5\\end{aligned}\n$$\n\nTherefore, $y=2.5({1.5}^{x})+8$ intercepts the $y$-axis at $(0,10.5).$"}] [{:db/id #edb/ref 17592186297286 :knowledge-point/_questions [{:db/id #edb/ref 17592186064207 :knowledge-point/id #uuid "bdbfa506-08a1-5e43-b958-2ae373df775d" :knowledge-point/title "Integrating a Linear Rational Function and Simplifying the Arbitrary Constant"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0dbf09c3-18df-50a3-84f7-e6f47d2ef7a6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{4}{3}\\operatorname{ln}⁡(K|3x+4|)" :db/id #edb/ref 17592186295347} {:answer/id #uuid "6e3b22d0-1d8f-5569-b6bf-7b7599fb5580" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3\\operatorname{ln}⁡(K|3x+4|)" :db/id #edb/ref 17592186295876} {:answer/id #uuid "962c31da-ae4b-5022-8358-2aec9b89c95b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{4}\\operatorname{ln}⁡(K|3x+4|)" :db/id #edb/ref 17592186296067} {:answer/id #uuid "b8e4ad65-9186-54e0-8792-0e53759b7716" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{3}\\operatorname{ln}⁡(K|3x+4|)" :db/id #edb/ref 17592186296235} {:answer/id #uuid "fa999cda-1369-5935-898a-85571f00711c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{4}\\operatorname{ln}⁡(K|3x+4|)" :db/id #edb/ref 17592186296595}] :answer-field/correct {:answer/id #uuid "b8e4ad65-9186-54e0-8792-0e53759b7716" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{3}\\operatorname{ln}⁡(K|3x+4|)" :db/id #edb/ref 17592186296235} :answer-field/id #uuid "6dfec598-1f66-5fc7-8005-3949a52a7718" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186296863}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "60fb4a8e-0b44-516d-9ebb-a8d91494c67e" :question/math-academy-id "q-30368" :question/problem "Calculate $\\int \\frac{1}{3x+4}\\,\\text{d}x.$ Assume that $K$ is an arbitrary positive constant." :question/worked-solution "First, let $u=3x+4.$ Then differentiating with respect to $x$ gives\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=3\\,⟹\\,\\text{d}x=\\frac{1}{3}\\text{d}u.\n$$\n\nWe can now rewrite the integral in terms of $u,$ solve it, and write the final answer in terms of $x$ as follows:\n\n$$\n\\begin{aligned}\\int \\frac{1}{3x+4}\\,\\text{d}x & =\\int \\frac{1}{u}\\cdot \\frac{1}{3}\\,\\text{d}u \\\\  & =\\frac{1}{3}\\int \\frac{1}{u}\\,\\text{d}u \\\\  & =\\frac{1}{3}\\operatorname{ln}⁡|u|+C \\\\  & =\\frac{1}{3}\\operatorname{ln}⁡|3x+4|+C\\end{aligned}\n$$\n\nWe can further simplify the above by writing $C=\\frac{1}{3}\\operatorname{ln}⁡K$ for another arbitrary constant $K,$ and then we can combine the two terms using the laws of logarithms, as follows:\n\n$$\n\\begin{aligned}\\frac{1}{3}\\operatorname{ln}⁡|3x+4|+C & =\\frac{1}{3}\\operatorname{ln}⁡|3x+4|+\\frac{1}{3}\\operatorname{ln}⁡K \\\\  & =\\frac{1}{3}\\operatorname{ln}⁡(K|3x+4|)\\end{aligned}\n$$\n\nSo, we finally conclude that\n\n$$\n\\int \\frac{1}{3x+4}\\,\\text{d}x=\\frac{1}{3}\\operatorname{ln}⁡(K|3x+4|).\n$$"}] [{:db/id #edb/ref 17592186297298 :knowledge-point/_questions [{:db/id #edb/ref 17592186078438 :knowledge-point/id #uuid "cf94b5cf-6407-5931-92df-9f87818e8a71" :knowledge-point/title "Applying the Second Fundamental Theorem of Calculus"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "045a1df2-5456-559d-b823-6c723a28a7f8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2{x}^{3}+3{x}^{2}+1" :db/id #edb/ref 17592186295287} {:answer/id #uuid "58c766c3-0cc8-5b0f-adf2-345d1dfda737" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "a{x}^{3}+b{x}^{2}+1" :db/id #edb/ref 17592186295781} {:answer/id #uuid "6ea8dabc-09b8-5bbd-b06a-3504111d8ae3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "a{x}^{3}+{x}^{2}+1" :db/id #edb/ref 17592186295878} {:answer/id #uuid "ca41a65d-8d27-5fce-9087-4e74a76cce77" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3{x}^{3}+b{x}^{2}+1" :db/id #edb/ref 17592186296327} {:answer/id #uuid "e219f4dd-c8b7-5276-9ab5-d9d79f733318" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3{x}^{3}+2{x}^{2}+1" :db/id #edb/ref 17592186296470}] :answer-field/correct {:answer/id #uuid "58c766c3-0cc8-5b0f-adf2-345d1dfda737" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "a{x}^{3}+b{x}^{2}+1" :db/id #edb/ref 17592186295781} :answer-field/id #uuid "5b8778a9-6009-5602-aa9a-0b08ab64dd87" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186296820}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "be6bd7f3-2e23-5861-b95e-2eb6ae25ed99" :question/math-academy-id "q-30627" :question/problem "Calculate\n$\\frac{\\text{d}}{\\text{d}x}{\\int }_{-5}^{x}(a{s}^{3}+b{s}^{2}+1)\\,\\text{d}s$\nfor $x>-5,$ where $a$ and $b$ are constants." :question/worked-solution "The function $a{s}^{3}+b{s}^{2}+1$ is continuous on $[-5,x],$ where $x>-5.$ So, FTC II applies, and we get\n\n$$\n\\begin{aligned}\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}{\\int }_{-5}^{x}(a{s}^{3}+b{s}^{2}+1)\\text{ }\\,\\text{d}t & =a{x}^{3}+b{x}^{2}+1.\\end{aligned}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186101365 :knowledge-point/_questions [{:db/id #edb/ref 17592186101022 :knowledge-point/id #uuid "55fab3ac-cad3-54bd-b07b-9159554b634c" :knowledge-point/title "Finding the Average Value of a Function Over a Given Interval"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0a02b2ac-0bce-55b0-91e4-8c22b954741f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2}{\\pi }" :db/id #edb/ref 17592186295318} {:answer/id #uuid "235f22ad-40d0-5845-a702-3d539029c35e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2\\pi }" :db/id #edb/ref 17592186295459} {:answer/id #uuid "4c89d98a-c3be-5c94-8287-153667e67982" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{2}{\\pi }" :db/id #edb/ref 17592186295703} {:answer/id #uuid "bef48e4e-af97-5f81-86d0-5aaaffa9feb4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186296275} {:answer/id #uuid "d5db9937-d0be-5753-ac50-7bc02f351e36" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{2\\pi }" :db/id #edb/ref 17592186296391}] :answer-field/correct {:answer/id #uuid "0a02b2ac-0bce-55b0-91e4-8c22b954741f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2}{\\pi }" :db/id #edb/ref 17592186295318} :answer-field/id #uuid "4b70c271-15d7-5977-b27f-aeaabb026c4d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186296778}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "32d27667-c963-519c-a8ec-24392218b2f3" :question/math-academy-id "q-30752" :question/problem "What is the average value of $h(x)=\\operatorname{sin}⁡2x$ on the interval $[\\frac{\\pi }{4},\\frac{\\pi }{2}]?$" :question/requires-calculator true :question/worked-solution "Applying the average value formula, we find that the average value of the function is\n\n$$\n\\begin{aligned}{h}_{\\text{avg}} & =\\frac{1}{b-a}\\,{\\int }_{a}^{b}h(x)\\,\\text{d}x \\\\  & =\\frac{1}{(\\frac{\\pi }{2}-\\frac{\\pi }{4})}\\,{\\int }_{\\pi /4}^{\\pi /2}\\operatorname{sin}⁡2x\\,\\text{d}x \\\\  & =\\frac{4}{\\pi }\\,{\\int }_{\\pi /4}^{\\pi /2}\\operatorname{sin}⁡2x\\,\\text{d}x \\\\  & =\\frac{4}{\\pi }{(\\frac{1}{2})(-\\operatorname{cos}⁡(2x))|}_{\\pi /4}^{\\pi /2} \\\\  & =-\\frac{2}{\\pi }[\\operatorname{cos}⁡(2\\cdot \\frac{\\pi }{2})-\\operatorname{cos}⁡(2\\cdot \\frac{\\pi }{4})] \\\\  & =-\\frac{2}{\\pi }[\\operatorname{cos}⁡(\\pi )-\\operatorname{cos}⁡(\\frac{\\pi }{2})] \\\\  & =-\\frac{2}{\\pi }(-1-0) \\\\  & =\\frac{2}{\\pi }.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186297301 :knowledge-point/_questions [{:db/id #edb/ref 17592186101022 :knowledge-point/id #uuid "55fab3ac-cad3-54bd-b07b-9159554b634c" :knowledge-point/title "Finding the Average Value of a Function Over a Given Interval"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "095165cd-68cc-5092-a541-017374c5c841" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-8" :db/id #edb/ref 17592186295315} {:answer/id #uuid "391a79ba-1514-5b3d-a0fb-45581aae517b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186295593} {:answer/id #uuid "5a9c65aa-a057-5380-ab7e-6c41fff6e617" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186295789} {:answer/id #uuid "841eb217-bc22-5ed1-82f6-7e5a037937c9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186295974} {:answer/id #uuid "beb18a80-31c2-5374-bb9e-11f4d64b5d4f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186296272}] :answer-field/correct {:answer/id #uuid "841eb217-bc22-5ed1-82f6-7e5a037937c9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186295974} :answer-field/id #uuid "3276f9cb-f55b-5959-8434-6aaa7aa3a121" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186296727}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "72cc8fee-c912-578c-b6ad-a221076e3800" :question/math-academy-id "q-30776" :question/problem "Find the average value of the function $g(x)=2{x}^{3}-x-1$ on the interval $[-2,0].$" :question/worked-solution "Applying the average value formula, we find that the average value of the function is\n\n$$\n\\begin{aligned}{g}_{\\text{avg}} & =\\frac{1}{b-a}{\\int }_{a}^{b}g(x)\\,\\text{d}x \\\\  & =\\frac{1}{0-(-2)}{\\int }_{-2}^{0}(2{x}^{3}-x-1)\\,\\text{d}x \\\\  & =\\frac{1}{2}{\\int }_{-2}^{0}(2{x}^{3}-x-1)\\,\\text{d}x \\\\  & ={\\frac{1}{2}(\\frac{1}{2}{x}^{4}-\\frac{1}{2}{x}^{2}-x)|}_{-2}^{0} \\\\  & =\\frac{1}{2}[(\\frac{1}{2}\\cdot {0}^{4}-\\frac{1}{2}\\cdot {0}^{2}-0)-(\\frac{1}{2}\\cdot (-2)^{4}-\\frac{1}{2}\\cdot (-2)^{2}-(-2))] \\\\  & =\\frac{1}{2}(0-(8-2+2)) \\\\  & =\\frac{1}{2}(-8) \\\\  & =-4.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186297305 :knowledge-point/_questions [{:db/id #edb/ref 17592186087823 :knowledge-point/id #uuid "40eeb5a8-3ffe-54d2-b263-f2b1c41fed93" :knowledge-point/title "Identifying a Vertically Shifted and Stretched Exponential Growth Curve"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5e5493f0-49e5-5ac0-a64b-444f26facf5e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(0,-10)" :db/id #edb/ref 17592186295811} {:answer/id #uuid "cedf3ffd-b468-57c5-a1fb-5644942d8367" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(0,7)" :db/id #edb/ref 17592186296352} {:answer/id #uuid "d228956c-dabb-5adf-b1f0-eea00077c044" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(0,-7)" :db/id #edb/ref 17592186296375} {:answer/id #uuid "e5e90daa-a470-5b92-aeb7-f90fc7f25a72" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(0,-6)" :db/id #edb/ref 17592186296492} {:answer/id #uuid "ec3169b4-14de-5f3c-837e-5d327959c0c6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(0,10)" :db/id #edb/ref 17592186296521}] :answer-field/correct {:answer/id #uuid "d228956c-dabb-5adf-b1f0-eea00077c044" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(0,-7)" :db/id #edb/ref 17592186296375} :answer-field/id #uuid "9ef5eb88-b39d-569b-bc4c-949ed152d723" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186296969}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "5fda2bca-a959-55aa-9acd-07aede112347" :question/math-academy-id "q-30873" :question/problem "For the curve $y=1.5({10}^{x})-8.5$, find the point of intersection with the $y-$axis." :question/worked-solution "**Method 1**\n\n- For the curve $y={10}^{x},$ the point of intersection with the $y$-axis is $(0,1).$\n\n- For the scaled function $y=1.5({10}^{x}),$ the $y$-coordinate becomes\n\n$$\ny=1.5\\cdot 1=1.5.\n$$\n\n- Finally, after a vertical shift of $8.5$ units down, we get a point with the $y$-coordinate\n\n$$\ny=1.5-8.5=-7.\n$$\n\n**Method 2** \n\nTo find the $y$-intercept, we substitute $x=0$ into the equation of the curve:\n\n$$\n\\begin{aligned}y & =1.5({10}^{0})-8.5 \\\\  & =1.5\\cdot 1-8.5 \\\\  & =1.5-8.5 \\\\  & =-7\\end{aligned}\n$$\n\nTherefore, $y=1.5({10}^{x})-8.5$ intercepts the $y$-axis at $(0,-7).$"}] [{:db/id #edb/ref 17592186097217 :knowledge-point/_questions [{:db/id #edb/ref 17592186096655 :knowledge-point/id #uuid "f4b340f6-0ac6-5bbf-a7d4-0088ca3c4e5e" :knowledge-point/title "Integrating the Exponential Function With a Linear Exponent"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "07313f55-5d1b-57b8-a58b-0fd2285fb384" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{e}" :db/id #edb/ref 17592186295301} {:answer/id #uuid "302be2db-4e95-585b-828f-222678bc2c13" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "e-1" :db/id #edb/ref 17592186295541} {:answer/id #uuid "4e91aacd-fda2-5f11-90aa-6106b854beaa" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "e" :db/id #edb/ref 17592186295720} {:answer/id #uuid "6803b977-2128-5c3c-8a0c-1019fb07b1f6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186295852} {:answer/id #uuid "73ac26ff-08d4-5c73-9841-6e57a53e85a8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{3}" :db/id #edb/ref 17592186295901}] :answer-field/correct {:answer/id #uuid "302be2db-4e95-585b-828f-222678bc2c13" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "e-1" :db/id #edb/ref 17592186295541} :answer-field/id #uuid "942489c8-b11e-5069-8ed0-9bf73a6a722c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186296942}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "68ba7826-02c2-5b69-a594-6dc133f00570" :question/math-academy-id "q-30923" :question/problem "${\\int }_{0}^{3}\\frac{1}{3}{e}^{x/3}\\,\\text{d}x=$" :question/worked-solution "If we let $u=\\frac{x}{3},$ then\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=\\frac{1}{3}\\,⟹\\,\\text{d}u=\\frac{1}{3}\\text{d}x.\n$$\n\nComputing our limits of integration, we get the following:\n\n| $x$ | $0$ | $3$ |\n| --- | --- | --- |\n| $u$ | $0$ | $1$ |\n\nThen, we can write the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}{\\int }_{0}^{3}\\frac{1}{3}{e}^{x/3}\\,\\text{d}x & ={\\int }_{0}^{3}{e}^{x/3}\\cdot \\frac{1}{3}\\text{d}x \\\\  & ={\\int }_{0}^{1}{e}^{u}\\,\\text{d}u \\\\  & =({e}^{u}){|}_{0}^{1} \\\\  & ={e}^{1}-{e}^{0} \\\\  & =e-1\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186297314 :knowledge-point/_questions [{:db/id #edb/ref 17592186096656 :knowledge-point/id #uuid "19fd901f-e08d-54c5-9cda-68543a3d71a9" :knowledge-point/title "Integrating a General Exponential Function With a Linear Exponent"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "02b95ba0-8776-5e87-8a07-fb4dd6e251e3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{728}{\\operatorname{ln}⁡3}" :db/id #edb/ref 17592186295276} {:answer/id #uuid "36229afc-ab9a-5470-be3f-a37b681ee81b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{364}{3}" :db/id #edb/ref 17592186295571} {:answer/id #uuid "43ef6c71-98a2-5c12-8945-04c4d08e3cc6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{364}{\\operatorname{ln}⁡3}" :db/id #edb/ref 17592186295649} {:answer/id #uuid "72e3fae5-ccad-59b0-8fc0-ac0e46bfbfb5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{364}{3\\operatorname{ln}⁡3}" :db/id #edb/ref 17592186295895} {:answer/id #uuid "8fc47e71-ee79-5542-acba-c30ea159db79" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{121}{\\operatorname{ln}⁡3}" :db/id #edb/ref 17592186296034}] :answer-field/correct {:answer/id #uuid "72e3fae5-ccad-59b0-8fc0-ac0e46bfbfb5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{364}{3\\operatorname{ln}⁡3}" :db/id #edb/ref 17592186295895} :answer-field/id #uuid "dcf773c9-a379-54a1-a3f0-7de93b756309" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186297089}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "34a4e0e2-73c5-54dc-8277-4607c07e4179" :question/math-academy-id "q-30973" :question/problem "Evaluate the integral ${\\int }_{0}^{1}{3}^{6x}\\,\\text{d}x.$" :question/worked-solution "If we let $u=6x,$ then\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=6\\,⟹\\,\\frac{1}{6}\\,\\text{d}u=\\text{d}x.\n$$\n\nComputing our limits of integration, we get the following:\n\n| $x$ | $0$ | $1$ |\n| --- | --- | --- |\n| $u$ | $0$ | $6$ |\n\nThen, we can write the integral in terms of  $u$ and evaluate:\n\n$$\n\\begin{aligned}{\\int }_{0}^{1}{3}^{6x}\\,\\text{d}x & ={\\int }_{0}^{6}{3}^{u}\\cdot \\frac{1}{6}\\,\\text{d}u \\\\  & =\\frac{1}{6}{\\int }_{0}^{6}{3}^{u}\\,\\text{d}u \\\\  & =\\frac{1}{6}(\\frac{{3}^{u}}{\\operatorname{ln}⁡3}){|}_{0}^{6} \\\\  & =\\frac{1}{6\\operatorname{ln}⁡3}(729-1) \\\\  & =\\frac{728}{6\\operatorname{ln}⁡3} \\\\  & =\\frac{364}{3\\operatorname{ln}⁡3}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186069230 :knowledge-point/_questions [{:db/id #edb/ref 17592186068823 :knowledge-point/id #uuid "3eec195c-6549-5de2-b3f0-0417e5f518e7" :knowledge-point/title "Solving a \"Greater Than\" Inequality Given the Graph of the Corresponding Parabola"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3924a0d6-844d-5dc6-83c6-7db4a2fb4e17" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$x<2$ or $x>4$" :db/id #edb/ref 17592186295594} {:answer/id #uuid "440955b3-6ad7-5734-9cd2-e9f88aa0e954" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2<x<4" :db/id #edb/ref 17592186295651} {:answer/id #uuid "77034500-21c2-52e9-9478-7a3d41623c6f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$x<-4$ or $x>-2$" :db/id #edb/ref 17592186295916} {:answer/id #uuid "7798a310-53c1-5f5f-8d13-7e74a6c7123a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-4<x<-2" :db/id #edb/ref 17592186295919} {:answer/id #uuid "ef80a80c-3c32-544a-b833-12476f1cf9e6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x>2" :db/id #edb/ref 17592186296540}] :answer-field/correct {:answer/id #uuid "440955b3-6ad7-5734-9cd2-e9f88aa0e954" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2<x<4" :db/id #edb/ref 17592186295651} :answer-field/id #uuid "41198266-3a32-5b6f-aeaf-82b61bfcb718" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186296757}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "8b9f08f5-9d21-5599-bebd-c942241b0925" :question/math-academy-id "q-31015" :question/problem "![](images/11/1126d885ff5000b4afdadffef7b47dec3b2932322dfa7b75d16bc00993218a0e.png)\n\nGiven the graph above, solve the inequality $-(x-2)(x-4)>0.$" :question/worked-solution "Notice that our inequality\n\n$$\n-(x-2)(x-4)>0,\n$$\n\nis a \"*greater than*\" inequality. Therefore, we need to find the values of $x$ for which the parabola \n\n$$\ny=-(x-2)(x-4)\n$$\n\nis *above* the $x$-axis. We mark these values of $x$ in blue in the diagram below.\n\n![](images/dc/dc39c970e292e38519e609367c9f4a3d810aaca99e7040bb6227ff45401b2efc.png)\n\nSo, the solution to the inequality is $2<x<4.$"}]}
