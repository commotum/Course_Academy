#{[{:db/id #edb/ref 17592186290579 :knowledge-point/_questions [{:db/id #edb/ref 17592186115400 :knowledge-point/id #uuid "905d1f6a-72aa-5984-8c7d-920497fd58e4" :knowledge-point/title "Differentiating Inverse Reciprocal Trigonometric Functions Using the Product Rule"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "111f643e-21fe-5850-a34c-7e75f866dffd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2x}{|x|\\sqrt{{x}^{2}-1}}" :db/id #edb/ref 17592186288160} {:answer/id #uuid "5476c042-8711-54ab-b3d4-eadca3ea72e5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2arccscx}{|x|\\sqrt{{x}^{2}-1}}" :db/id #edb/ref 17592186288614} {:answer/id #uuid "6427fa83-3424-5638-881a-1b75c59158ff" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2arcsecx}{|x|\\sqrt{{x}^{2}-1}}" :db/id #edb/ref 17592186288737} {:answer/id #uuid "8d34a562-2280-5df3-b021-0fc8376c8ba7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{arccscx-arcsecx}{|x|\\sqrt{{x}^{2}-1}}" :db/id #edb/ref 17592186288975} {:answer/id #uuid "f32241a6-5d82-568c-bcfd-3f92960cb105" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{arccscx+arcsecx}{|x|\\sqrt{{x}^{2}-1}}" :db/id #edb/ref 17592186289638}] :answer-field/correct {:answer/id #uuid "8d34a562-2280-5df3-b021-0fc8376c8ba7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{arccscx-arcsecx}{|x|\\sqrt{{x}^{2}-1}}" :db/id #edb/ref 17592186288975} :answer-field/id #uuid "352c605b-c2ce-576c-94c4-6d4a6fa3df72" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186289846}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "fabb0dc5-fadf-5950-bf52-26606893c541" :question/math-academy-id "q-2484" :question/problem "Find ${f}^{′}(x)$ for $f(x)=arccscx\\cdot arcsecx$" :question/worked-solution "The formulae for the derivatives of $arccsc$ and $arcsec$ are\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}(arccscx) & =-\\frac{1}{|x|\\sqrt{{x}^{2}-1}}, \\\\ \\frac{\\text{d}}{\\text{d}x}(arcsecx) & =\\frac{1}{|x|\\sqrt{{x}^{2}-1}}.\\end{aligned}\n$$\n\nUsing the product rule and the formulae above, we obtain\n\n$$\n\\begin{aligned}{f}^{′}(x) & =arcsecx\\cdot \\frac{\\text{d}}{\\text{d}x}(arccscx)+arccscx\\cdot \\frac{\\text{d}}{\\text{d}x}(arcsecx) \\\\  & =arcsecx\\cdot (-\\frac{1}{|x|\\sqrt{{x}^{2}-1}})+arccscx\\cdot (\\frac{1}{|x|\\sqrt{{x}^{2}-1}}) \\\\  & =-\\frac{arcsecx}{|x|\\sqrt{{x}^{2}-1}}+\\frac{arccscx}{|x|\\sqrt{{x}^{2}-1}} \\\\  & =\\frac{arccscx-arcsecx}{|x|\\sqrt{{x}^{2}-1}}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186060250 :knowledge-point/_questions [{:db/id #edb/ref 17592186059810 :knowledge-point/id #uuid "9e89b620-641a-5dbf-85f6-ca0f7a2fad80" :knowledge-point/title "Evaluating Arcsine or Arccosine"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "02f71a90-9f0c-57a8-8d03-9d9eeaccc52b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\pi }{6}" :db/id #edb/ref 17592186288051} {:answer/id #uuid "443aa495-57ed-5721-9745-6ff07a7e846d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\pi }{3}" :db/id #edb/ref 17592186288496} {:answer/id #uuid "81913624-dd8d-5e6e-a115-a31409962017" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5\\pi }{4}" :db/id #edb/ref 17592186288905} {:answer/id #uuid "8bd93056-9bf4-54d1-81ae-7be48a7ed21a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3\\pi }{4}" :db/id #edb/ref 17592186288965} {:answer/id #uuid "df916113-228a-55af-a94b-2a8acc6b6b99" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\pi }{4}" :db/id #edb/ref 17592186289523}] :answer-field/correct {:answer/id #uuid "8bd93056-9bf4-54d1-81ae-7be48a7ed21a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3\\pi }{4}" :db/id #edb/ref 17592186288965} :answer-field/id #uuid "574749d6-30f1-54d9-a75b-edfe46306402" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186289913}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "d044bebd-f049-585d-81d1-00fe08c3d294" :question/math-academy-id "q-24911" :question/problem "$\\operatorname{arccos}⁡(-\\frac{\\sqrt{2}}{2})=$" :question/worked-solution "The range of $\\theta =\\operatorname{arccos}⁡x$ is given by\n\n$$\n0\\le \\theta \\le \\pi .\n$$\n\nNote that the angle $\\theta $ spans the first and second quadrants.\n\nSince $-\\frac{\\sqrt{2}}{2}$ is negative, our answer is an angle that lies in the second quadrant, where cosine is negative.\n\n![](images/db/dbf36192ac332dc49ed75278838e989a37ac7d888311be1b8b059a7b59667aa6.png)\n\nFrom the values in the second quadrant, we see that\n\n$$\n\\operatorname{cos}⁡(\\frac{3\\pi }{4})=-\\frac{\\sqrt{2}}{2}.\n$$\n\nTherefore,\n\n$$\n\\operatorname{arccos}⁡(-\\frac{\\sqrt{2}}{2})=\\frac{3\\pi }{4}.\n$$"}] [{:db/id #edb/ref 17592186290586 :knowledge-point/_questions [{:db/id #edb/ref 17592186064218 :knowledge-point/id #uuid "de1e3f3a-5a64-573f-8fb1-9952fa36a839" :knowledge-point/title "Calculating Indefinite Integrals Using Substitution with Inverse Sine"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1a8e08bb-1b37-5cf6-86db-c3ef539c1d7c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{3}\\,\\operatorname{arccos}⁡(\\frac{x}{3})+C" :db/id #edb/ref 17592186288202} {:answer/id #uuid "45dc7c37-051d-511b-9e8a-aec010663441" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{arcsin}⁡(\\frac{x}{3})+C" :db/id #edb/ref 17592186288507} {:answer/id #uuid "58113f3e-82c1-5ec1-9b67-5669fee9fd01" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{arccos}⁡({x}^{2})+C" :db/id #edb/ref 17592186288647} {:answer/id #uuid "978f50c6-52a3-5c94-9441-ace404075a2b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "9\\operatorname{arcsin}⁡({x}^{2})+C" :db/id #edb/ref 17592186289048} {:answer/id #uuid "99ed0e47-4a7c-5b89-9c0b-8ff18f3172b5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "9\\operatorname{arcsin}⁡(\\frac{{x}^{2}}{9})+C" :db/id #edb/ref 17592186289060}] :answer-field/correct {:answer/id #uuid "45dc7c37-051d-511b-9e8a-aec010663441" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{arcsin}⁡(\\frac{x}{3})+C" :db/id #edb/ref 17592186288507} :answer-field/id #uuid "f07d43ea-d249-5835-9f11-f5ac2c8850b3" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186290229}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "2b7a5d31-b8c0-5e03-b3eb-62f1624001b3" :question/math-academy-id "q-2503" :question/problem "$\\int \\frac{1}{\\sqrt{9-{x}^{2}}}\\text{d}x=$" :question/worked-solution "Let's rewrite our integral as follows:\n\n$$\n\\begin{aligned}\\int \\frac{1}{\\sqrt{9-{x}^{2}}}\\,\\text{d}x & =\\int \\frac{1}{\\sqrt{9\\cdot (1-{x}^{2}/9)}}\\,\\text{d}x \\\\  & =\\frac{1}{3}\\int \\frac{1}{\\sqrt{1-{x}^{2}/9}}\\,\\text{d}x \\\\  & =\\frac{1}{3}\\int \\frac{1}{\\sqrt{1-(x/3)^{2}}}\\,\\text{d}x\\end{aligned}\n$$\n\n \n\nThis integral resembles the basic integral for inverse sine,\n\n$$\n\\int \\frac{1}{\\sqrt{1-{u}^{2}}}\\,\\text{d}u=\\operatorname{arcsin}⁡(u)+C.\n$$\n\nThe only difference is that instead of ${u}^{2}$ as the variable, we have ${(\\frac{x}{3})}^{2}.$  \n\nSo, let's substitute $u=\\frac{x}{3}.$ Differentiating, we get \n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=\\frac{1}{3}\\,⟹\\,\\text{d}x=3\\,\\text{d}u.\n$$\n\nUsing the above, we can write the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}\\begin{aligned}\\int \\frac{1}{\\sqrt{9-{x}^{2}}}\\,\\text{d}x & =\\frac{1}{3}\\int \\frac{1}{\\sqrt{1-(x/3)^{2}}}\\,\\text{d}x \\\\  & =\\frac{1}{3}\\int \\frac{1}{\\sqrt{1-{u}^{2}}}\\cdot (3\\,\\text{d}u) \\\\  & =\\int \\frac{\\text{d}u}{\\sqrt{1-{u}^{2}}} \\\\  & =\\operatorname{arcsin}⁡u+C \\\\  & =\\operatorname{arcsin}⁡(\\frac{x}{3})+C\\end{aligned}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186290600 :knowledge-point/_questions [{:db/id #edb/ref 17592186064219 :knowledge-point/id #uuid "227abe29-6e31-5afd-b0ca-3b8ed7d8c287" :knowledge-point/title "Calculating Indefinite Integrals Using Substitution with Inverse Tangent"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "15325872-4e2f-544f-9dec-000683e3691e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\operatorname{arctan}⁡(x)}{25}+C" :db/id #edb/ref 17592186288177} {:answer/id #uuid "164243e9-717c-580d-9d74-331ac357f68c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\operatorname{arctan}⁡(5x)}{5}+C" :db/id #edb/ref 17592186288180} {:answer/id #uuid "6b7d4913-276e-5926-8683-f107a4d1158c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\text{arcsec}(25x)}{25}+C" :db/id #edb/ref 17592186288790} {:answer/id #uuid "87403b08-b913-5b5b-af1b-47f906da3828" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\operatorname{arcsin}⁡(5x)}{5}+C" :db/id #edb/ref 17592186288944} {:answer/id #uuid "90b08433-72df-5a70-8a55-aec7b22f8981" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\operatorname{arctan}⁡(25x)}{25}+C" :db/id #edb/ref 17592186289001}] :answer-field/correct {:answer/id #uuid "164243e9-717c-580d-9d74-331ac357f68c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\operatorname{arctan}⁡(5x)}{5}+C" :db/id #edb/ref 17592186288180} :answer-field/id #uuid "589b96c3-feba-5f82-b690-a05fef9d4fc1" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186289916}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "d025ad08-0459-5553-af22-02ed776a0b57" :question/math-academy-id "q-2507" :question/problem "$\\int \\frac{1}{1+25{x}^{2}}\\,\\text{d}x=$" :question/worked-solution "This integral resembles the basic integral for inverse tangent,\n\n$$\n\\int \\frac{1}{1+{u}^{2}}\\text{d}u=\\operatorname{arctan}⁡u+C.\n$$\n\nThe only difference is that instead of ${u}^{2}$ as the variable, we have $25{x}^{2}=(5x)^{2}.$\n\nSo, let's substitute $u=5x.$ Differentiating, we get\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=5\\,⟹\\,\\frac{1}{5}\\,\\text{d}u=\\text{d}x.\n$$\n\nUsing the above, we can write the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}\\begin{aligned}\\int \\frac{1}{1+25{x}^{2}}\\,\\text{d}x & =\\int \\frac{1}{1+(5x)^{2}}\\,\\text{d}x \\\\  & =\\int \\frac{1}{1+{u}^{2}}\\,\\cdot (\\frac{1}{5}\\text{d}u) \\\\  & =\\frac{1}{5}\\int \\frac{1}{1+{u}^{2}}\\,\\text{d}u \\\\  & =\\frac{1}{5}\\operatorname{arctan}⁡u+C \\\\  & =\\frac{\\operatorname{arctan}⁡(5x)}{5}+C\\end{aligned}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186292541 :knowledge-point/_questions [{:db/id #edb/ref 17592186175924 :knowledge-point/id #uuid "c52fd5dd-780e-5dab-805f-561383873dd4" :knowledge-point/title "Finding the Equation of a Line Perpendicular to a Line in Standard Form"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "222e0bdd-c45c-5f9b-ae54-71cdb6646a9d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2x-y=2" :db/id #edb/ref 17592186290780} {:answer/id #uuid "93fc4b47-47c7-5ebf-9229-bb1de3d6fc45" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2x+5y=26" :db/id #edb/ref 17592186291272} {:answer/id #uuid "96366abc-617a-5664-be0a-124e181d78a4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2x+y=10" :db/id #edb/ref 17592186291284} {:answer/id #uuid "d0dd3655-249b-55c7-ad7e-aa78ebaf2966" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x+2y=11" :db/id #edb/ref 17592186291519} {:answer/id #uuid "d8c2f176-99d3-5c0e-91c7-0a77ab6cde83" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x+4y=19" :db/id #edb/ref 17592186291538}] :answer-field/correct {:answer/id #uuid "d0dd3655-249b-55c7-ad7e-aa78ebaf2966" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x+2y=11" :db/id #edb/ref 17592186291519} :answer-field/id #uuid "f929ad97-39dd-50e0-b2f2-34f577615f96" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186292514}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "9bf24f67-6184-5bd5-8b16-92247aa73ac4" :question/math-academy-id "q-252524" :question/problem "Find the equation of the line that passes through the point $(3,4)$ and is perpendicular to the line passing through the points $(2,2)$ and $(5,8).$" :question/worked-solution "Perpendicular lines have slopes, which are negative reciprocals of each other.\n\nFirst, let's find the slope ${m}_{1}$ of the line passing through the points $(2,2)$ and $(5,8):$\n\n$$\n\\begin{aligned}{m}_{1} & =\\frac{{y}_{2}-{y}_{1}}{{x}_{2}-{x}_{1}} \\\\  & =\\frac{8-2}{5-2} \\\\  & =\\frac{6}{3} \\\\  & =2\\end{aligned}\n$$\n\nSince we want a perpendicular line, the slope $m$ of the line we're trying to find must satisfy\n\n$$\nm\\cdot (2)=-1\\,⇒\\,m=-\\frac{1}{2}.\n$$\n\nWe know that the line passes through the point $(3,4).$ Using point-slope form and simplifying, we obtain the equation of the line:\n\n$$\n\\begin{aligned}y-{y}_{1} & =m(x-{x}_{1}) \\\\ y-4 & =-\\frac{1}{2}(x-3) \\\\ 2(y-4) & =-(x-3) \\\\ 2y-8 & =-x+3 \\\\ 2y & =-x+11 \\\\ y & =-\\frac{1}{2}x+\\frac{11}{2}\\end{aligned}\n$$\n\nHowever, we want to write the equation in standard form. So, we will bring the $x$ term to the left-hand side and multiply both sides of the equation by $2:$\n\n$$\n\\begin{aligned}y & =-\\frac{1}{2}x+\\frac{11}{2} \\\\ \\frac{1}{2}x+y & =\\frac{11}{2} \\\\ 2\\cdot (\\frac{1}{2}x+y) & =2\\cdot \\frac{11}{2} \\\\ x+2y & =11\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186292607 :knowledge-point/_questions [{:db/id #edb/ref 17592186064210 :knowledge-point/id #uuid "2feb2115-bd75-5c09-87cc-f10cf46c182f" :knowledge-point/title "Calculating Indefinite Integrals of Algebraic Functions Using Substitution"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0823988f-305f-5042-86ff-7315214a31b5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{(z+4)^{3}}}{2}+\\frac{1}{2\\sqrt{z+4}}+C" :db/id #edb/ref 17592186290675} {:answer/id #uuid "a9614fed-ed70-5eeb-8b61-ef77a1571c6c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt[3]{(z+4)^{2}}}{3}+2\\sqrt{z+4}+C" :db/id #edb/ref 17592186291371} {:answer/id #uuid "e171b6e4-226a-545c-8c9d-45a8021fc3ff" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2\\sqrt{(z+4)^{3}}}{3}+2\\sqrt{z+4}+C" :db/id #edb/ref 17592186291576} {:answer/id #uuid "e8550de6-d465-50e3-8f25-691b00066a39" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2\\sqrt[3]{(z+4)^{2}}}{3}+\\sqrt{z+4}+C" :db/id #edb/ref 17592186291604} {:answer/id #uuid "ea441298-6bab-5b87-8ecb-0704d0aba5b8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2\\sqrt[3]{(z+4)^{2}}}{3}+\\frac{1}{2\\sqrt{z+4}}+C" :db/id #edb/ref 17592186291611}] :answer-field/correct {:answer/id #uuid "e171b6e4-226a-545c-8c9d-45a8021fc3ff" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2\\sqrt{(z+4)^{3}}}{3}+2\\sqrt{z+4}+C" :db/id #edb/ref 17592186291576} :answer-field/id #uuid "0207284d-a167-59ba-b0a2-915166f15039" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186291738}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "7de83625-3bca-5002-8a64-075a352f81b8" :question/math-academy-id "q-2592" :question/problem "Find the integral of $\\frac{z+5}{\\sqrt{z+4}}.$" :question/worked-solution "Let $u=z+4.$ Then, we have\n\n$$\n\\frac{\\text{d}u}{\\text{d}z}=1\\,⟹\\,\\text{d}z=\\text{d}u.\n$$\n\nWe also note that\n$z+5=u+1.$\n\nNow we can solve the integral in terms of $u,$ and then express our final answer in terms of $z:$\n\n$$\n\\begin{aligned}\\int \\frac{z+5}{\\sqrt{z+4}}\\,\\text{d}z & =\\int \\frac{u+1}{\\sqrt{u}}\\,\\text{d}z \\\\  & =\\int \\frac{u}{\\sqrt{u}}+\\frac{1}{\\sqrt{u}}\\,\\text{d}z \\\\  & =\\int \\sqrt{u}\\,\\text{d}u+\\int \\frac{1}{\\sqrt{u}}\\,\\text{d}u \\\\  & =\\int {u}^{1/2}\\,\\text{d}u+\\int {u}^{-1/2}\\,\\text{d}u \\\\  & =\\frac{2{u}^{3/2}}{3}+2\\sqrt{u}+C \\\\  & =\\frac{2\\sqrt{(z+4)^{3}}}{3}+2\\sqrt{z+4}+C\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186292608 :knowledge-point/_questions [{:db/id #edb/ref 17592186129102 :knowledge-point/id #uuid "bd6703d2-36f6-5665-90e3-f75aea5f663b" :knowledge-point/title "Finding a General Expression for the Domain of a Transformed Tangent or Cotangent Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0247856b-a519-56dd-a2b1-a1b70c9b2dd7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x\\ne \\frac{\\pi }{6}+\\frac{n\\pi }{3}" :db/id #edb/ref 17592186290651} {:answer/id #uuid "6880d187-a9df-5074-bc5d-223d72e1916c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x\\ne \\frac{\\pi }{6}+\\frac{n\\pi }{2}" :db/id #edb/ref 17592186291077} {:answer/id #uuid "d2246bcc-e2cc-5d62-bed2-bbaf586f4fa8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x\\ne \\frac{\\pi }{8}+\\frac{n\\pi }{2}" :db/id #edb/ref 17592186291520} {:answer/id #uuid "de5d79b6-0b6d-56b2-b4b8-34d1931786d7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x\\ne \\frac{\\pi }{8}+n\\pi " :db/id #edb/ref 17592186291565} {:answer/id #uuid "e45c748f-05b7-55c6-9a75-1f27a3900067" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x\\ne \\frac{\\pi }{4}+\\frac{n\\pi }{2}" :db/id #edb/ref 17592186291587}] :answer-field/correct {:answer/id #uuid "e45c748f-05b7-55c6-9a75-1f27a3900067" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x\\ne \\frac{\\pi }{4}+\\frac{n\\pi }{2}" :db/id #edb/ref 17592186291587} :answer-field/id #uuid "7482ef83-edf6-558f-8523-f7d7648ec139" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186292094}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "6007df97-7592-55f0-9719-8190411bf59a" :question/math-academy-id "q-26063" :question/problem "What is the domain of the function $f(x)=\\operatorname{tan}⁡(2x)?$  Assume that $n$ is an integer." :question/worked-solution "The domain of $y=\\operatorname{tan}⁡x$ is given by\n\n$$\nx\\ne \\frac{\\pi }{2}+n\\pi ,\n$$\n\nwhere $n$ is an integer.\n\nTo find the domain of $\\operatorname{tan}⁡(2x),$ we replace the $x$ on the left-hand side of the above with $(2x).$ This gives\n\n$$\n2x\\ne \\frac{\\pi }{2}+n\\pi .\n$$\n\nSolving for $x,$ we get\n\n$$\n\\begin{aligned}2x & \\ne \\frac{\\pi }{2}+n\\pi  \\\\ x & \\ne \\frac{\\pi }{2\\cdot 2}+\\frac{n\\pi }{2} \\\\ x & \\ne \\frac{\\pi }{4}+\\frac{n\\pi }{2}.\\end{aligned}\n$$\n\nTherefore, the domain of the function is $x\\ne \\frac{\\pi }{4}+\\frac{n\\pi }{2},$ where $n$ is an integer."}] [{:db/id #edb/ref 17592186292609 :knowledge-point/_questions [{:db/id #edb/ref 17592186096636 :knowledge-point/id #uuid "90455606-1080-552e-a825-0cc7054b4be3" :knowledge-point/title "Solving a System Containing Fractions in One Equation Using Substitution"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "83f90f5e-a59d-5dbb-b7bc-2235614d11e5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=4,\\,y=4" :db/id #edb/ref 17592186291191} {:answer/id #uuid "88278ddc-f2aa-572e-bfa1-75529cee7a88" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=-4,\\,y=6" :db/id #edb/ref 17592186291213} {:answer/id #uuid "8b6b2395-ed33-5ae6-ab41-6b9f005b95ce" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=2,\\,y=2" :db/id #edb/ref 17592186291224} {:answer/id #uuid "a00f19d2-18a2-58fa-85b9-7734b7ab495a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=-3,\\,y=3" :db/id #edb/ref 17592186291328} {:answer/id #uuid "ae7b1a51-3e08-5e97-9ce6-48f66f412876" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=3,\\,y=-15" :db/id #edb/ref 17592186291389}] :answer-field/correct {:answer/id #uuid "a00f19d2-18a2-58fa-85b9-7734b7ab495a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=-3,\\,y=3" :db/id #edb/ref 17592186291328} :answer-field/id #uuid "64524a94-87ea-54e7-b6ab-78b313a3c370" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186292039}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "35a25c61-ba3b-5b21-8d90-ee3bc07b7267" :question/math-academy-id "q-26094" :question/problem "Find the solution to the following system of equations.\n\n$$\n{\\begin{aligned}\\frac{x}{6}+\\frac{5y}{6}-2=0 \\\\ 3x+y+6=0\\end{aligned}\n$$" :question/worked-solution "To get rid of the fractions in the first equation, we must multiply the first equation by the lowest common denominator of the fractions, which is $6.$\n\n$$\n{\\begin{aligned}\\frac{x}{6}+\\frac{5y}{6}-2=0 & |\\,\\times 6 \\\\ 3x+y+6=0\\end{aligned}\\,⟹\\,{\\begin{aligned}x+5y-12=0 \\\\ 3x+y+6=0\\end{aligned}\n$$\n\nWe will use the substitution method to solve the system. Notice that the second equation can easily be solved for $y:$\n\n$$\n\\begin{aligned}3x+y+6 & =0 \\\\ y & =-3x-6\\end{aligned}\n$$\n\nWe substitute $y=-3x-6$ into the first equation and then solve for $x:$\n\n$$\n\\begin{aligned}x+5y-12 & =0 \\\\ x+5(-3x-6)-12 & =0 \\\\ x-15x-30-12 & =0 \\\\ -14x-42 & =0 \\\\ -14x & =42 \\\\ x & =-3\\end{aligned}\n$$\n\nFinally, to find the value of $y,$ we substitute $x=-3$ into the equation $y=-3x-6$ as follows:\n\n$$\n\\begin{aligned}y & =-3x-6 \\\\  & =-3(-3)-6 \\\\  & =9-6 \\\\  & =3\\end{aligned}\n$$\n\nThus, the solution to the system of equations is $x=-3,\\,y=3.$"}] [{:db/id #edb/ref 17592186292611 :knowledge-point/_questions [{:db/id #edb/ref 17592186064210 :knowledge-point/id #uuid "2feb2115-bd75-5c09-87cc-f10cf46c182f" :knowledge-point/title "Calculating Indefinite Integrals of Algebraic Functions Using Substitution"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1d6d8f53-a600-58bb-9317-00c4a396aa39" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-6\\sqrt{(4-x)^{3}}+\\frac{4}{5}\\sqrt{(4-x)^{5}}+C" :db/id #edb/ref 17592186290754} {:answer/id #uuid "25d24972-54bd-5282-81f4-d205290af08a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\sqrt{(4-x)^{3}}+\\frac{1}{5}\\sqrt{(4-x)^{5}}+C" :db/id #edb/ref 17592186290790} {:answer/id #uuid "333c2baf-7288-5195-91b2-e899a0052507" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3\\sqrt[3]{4-x}-\\frac{4}{5}\\sqrt{(4-x)^{3}}+C" :db/id #edb/ref 17592186290837} {:answer/id #uuid "45750a92-c47c-5aea-bf8b-0739cb26aa37" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-8\\sqrt{(2x+1)^{3}}+\\frac{4}{5}\\sqrt{(2x+1)^{3}}+C" :db/id #edb/ref 17592186290918} {:answer/id #uuid "6e50a711-1c63-5b6e-8f33-5faec0a6f08b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6\\sqrt{(2x+1)^{3}}-\\frac{1}{5}\\sqrt{(2x+1)^{5}}+C" :db/id #edb/ref 17592186291106}] :answer-field/correct {:answer/id #uuid "1d6d8f53-a600-58bb-9317-00c4a396aa39" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-6\\sqrt{(4-x)^{3}}+\\frac{4}{5}\\sqrt{(4-x)^{5}}+C" :db/id #edb/ref 17592186290754} :answer-field/id #uuid "78a48d79-4b02-5ea6-ba8f-a1a025670875" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186292115}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "a9848d15-ae9b-5ed7-b76d-7cc1c522f111" :question/math-academy-id "q-2621" :question/problem "Calculate the integral of $(2x+1)\\sqrt{4-x}.$" :question/worked-solution "Let $u=4-x.$ Then, we have\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=-1\\,⟹\\,\\text{d}x=-\\text{d}u.\n$$\n\nWe also note that\n$x=4-u.$\n\nNow we can solve the integral in terms of $u,$ and then express our final answer in terms of $x:$\n\n$$\n\\begin{aligned}\\int (2x+1)\\sqrt{4-x}\\,\\text{d}x & =\\int (2(4-u)+1)\\sqrt{u}(-\\text{d}u) \\\\  & =-\\int (9-2u)\\sqrt{u}\\,\\text{d}u \\\\  & =-\\int (9{u}^{1/2}-2{u}^{3/2})\\text{d}u \\\\  & =-(6{u}^{3/2}-\\frac{4}{5}{u}^{5/2})+C \\\\  & =-6\\sqrt{(4-x)^{3}}+\\frac{4}{5}\\sqrt{(4-x)^{5}}+C\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186401908 :knowledge-point/_questions [{:db/id #edb/ref 17592186096785 :knowledge-point/id #uuid "cc62d8df-450f-5f7a-b647-b53c051f8339" :knowledge-point/title "Solving a System Containing Decimals in Both Equations"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c29c57bf-e265-52a1-bca7-e9f5dad2f3f4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$x=\\frac{4}{3},$ $y=-2$" :db/id #edb/ref 17592186401910} {:answer/id #uuid "211a2e7b-9745-58a0-94ae-5560db869797" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$x=1,$ $y=-3$" :db/id #edb/ref 17592186401911} {:answer/id #uuid "862aa3fb-5e83-5622-8209-8caba2d722df" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$x=\\frac{7}{3},$ $y=1$" :db/id #edb/ref 17592186401912} {:answer/id #uuid "30d0a7a2-ddd3-5355-ab33-3b6c7d057ae2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$x=2,$ $y=0$" :db/id #edb/ref 17592186401913} {:answer/id #uuid "0284c37f-87d7-5181-9665-5eb50a2bc860" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$x=\\frac{5}{3},$ $y=-1$" :db/id #edb/ref 17592186401914}] :answer-field/correct {:answer/id #uuid "0284c37f-87d7-5181-9665-5eb50a2bc860" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$x=\\frac{5}{3},$ $y=-1$" :db/id #edb/ref 17592186401914} :answer-field/id #uuid "e422abe5-7836-5aa6-bfb2-34896476a4d7" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186401909}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "3d7c59ff-df86-5863-a05a-c20fb84b2ead" :question/math-academy-id "q-26223" :question/problem "Solve the following system of equations:\n\n$$\n{\\begin{aligned}0.3x-0.1y=0.6 \\\\ 0.6x+0.8y=0.2\\end{aligned}\n$$" :question/worked-solution "To get rid of the decimals, we multiply both equations by $10,$ as follows:\n\n$$\n{\\begin{aligned}0.3x-0.1y=0.6 & |\\,\\times 10 \\\\ 0.6x+0.8y=0.2 & |\\,\\times 10\\end{aligned}\\,⟹\\,{\\begin{aligned}3x-y=6 \\\\ 6x+8y=2\\end{aligned}\n$$\n\nNotice that if we divide the second equation by $(-2),$ we will get a $-3x$ term in the second equation that can cancel with the $3x$ term in the first equation:\n\n$$\n{\\begin{aligned}3x-y=6 &  \\\\ 6x+8y=2 & |\\,÷(-2)\\end{aligned}\\,⟹\\,{\\begin{aligned}3x-y=6 \\\\ -3x-4y=-1\\end{aligned}\n$$\n\nAdding the two equations eliminates the $x$-variable and allows us to solve for $y:$\n\n$$\n\\begin{aligned}\\cancel{3x}-y & =6 \\\\ -\\cancel{3x}-4y & =-1 \\\\ (-y-4y) & =(6-1) \\\\ -5y & =5 \\\\ y & =-1\\end{aligned}\n$$\n\nFinally, we can substitute $y=-1$ into the equation $3x-y=6$ to solve for $x:$\n\n$$\n\\begin{aligned}3x-y & =6 \\\\ 3x-(-1) & =6 \\\\ 3x & =5 \\\\ x & =\\frac{5}{3}\\end{aligned}\n$$\n\nThus, the solution to the system of equations is $x=\\frac{5}{3}$ and $y=-1.$"}] [{:db/id #edb/ref 17592186292646 :knowledge-point/_questions [{:db/id #edb/ref 17592186179787 :knowledge-point/id #uuid "7e37891e-d24f-53cd-ba74-d887fa99aa3b" :knowledge-point/title "Finding Exact Solutions of Exponential Equations"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "47fe5df5-7916-5060-8fbe-5ad8b202e09b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{1+2\\operatorname{log}⁡(7)}" :db/id #edb/ref 17592186290928} {:answer/id #uuid "6566b744-0a39-5a79-adc4-eb963875b944" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{1-\\operatorname{log}⁡(7)}" :db/id #edb/ref 17592186291063} {:answer/id #uuid "84375010-b552-520c-9e30-6bce98e9d946" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1-\\operatorname{log}⁡(7)" :db/id #edb/ref 17592186291193} {:answer/id #uuid "a942eb9e-20af-5ce8-bcb0-edde94e6b8d5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{\\operatorname{log}⁡(7)}" :db/id #edb/ref 17592186291370} {:answer/id #uuid "da13d7a6-842f-5188-995b-f601e0fb9261" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{3}{\\operatorname{log}⁡(7)}" :db/id #edb/ref 17592186291544}] :answer-field/correct {:answer/id #uuid "6566b744-0a39-5a79-adc4-eb963875b944" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{1-\\operatorname{log}⁡(7)}" :db/id #edb/ref 17592186291063} :answer-field/id #uuid "480c9754-f2a3-545e-b087-84a9e0daed41" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186291963}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "3565dc73-156f-57ee-a4a3-9af19402d1e5" :question/math-academy-id "q-26385" :question/problem "Expressed in terms of common logarithms, what value of $x$ satisfies the equation ${10}^{x-3}={7}^{x}?$" :question/worked-solution "First, we take the common logarithm $(log)$ of both sides of the equation:\n\n$$\n\\begin{aligned}{10}^{x-3} & ={7}^{x} \\\\ \\operatorname{log}⁡({10}^{x-3}) & =\\operatorname{log}⁡({7}^{x})\\end{aligned}\n$$\n\nNow, we use the fact that ${log}_{b}⁡({b}^{c})=c$ to simplify the left-hand side. This gives:\n\n$$\n\\begin{aligned}x-3 & =\\operatorname{log}⁡({7}^{x})\\end{aligned}\n$$\n\nNext, we use the power law of logarithms to simplify the right-hand side:\n\n$$\n\\begin{aligned}x-3 & =x\\operatorname{log}⁡(7)\\end{aligned}\n$$\n\nFinally, we solve for $x,$ as follows:\n\n$$\n\\begin{aligned}x-x\\operatorname{log}⁡(7) & =3 \\\\ x(1-\\operatorname{log}⁡(7)) & =3 \\\\ x & =\\frac{3}{1-\\operatorname{log}⁡(7)}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186292672 :knowledge-point/_questions [{:db/id #edb/ref 17592186059668 :knowledge-point/id #uuid "0bd940e7-fccc-5811-b07a-11e4843b1785" :knowledge-point/title "Finding a Point That Lies on a Transformed Curve"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "33c00c15-b13b-5bcc-8be2-21e93f4c417e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(3,-2)" :db/id #edb/ref 17592186290839} {:answer/id #uuid "487a2755-1c9b-50dc-a9ef-825d319c08d1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-3,-2)" :db/id #edb/ref 17592186290930} {:answer/id #uuid "5a5b7f1c-6ca6-519d-9324-afd97504caa0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(3,2)" :db/id #edb/ref 17592186291021} {:answer/id #uuid "bfbeb462-5ad4-5751-9859-039c2c20e85a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-3,-3)" :db/id #edb/ref 17592186291457} {:answer/id #uuid "f4debbbb-a978-5aa2-807b-d09d5e6771d0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(3,-3)" :db/id #edb/ref 17592186291662}] :answer-field/correct {:answer/id #uuid "33c00c15-b13b-5bcc-8be2-21e93f4c417e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(3,-2)" :db/id #edb/ref 17592186290839} :answer-field/id #uuid "337977c2-17f5-5416-91d9-a9bbf15f1e4e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186291907}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "6eb852b1-3670-5b7e-89d9-1b29c405f01a" :question/math-academy-id "q-26594" :question/problem "The point  $(3,1)$ lies on the curve $y=f(x).$ Which of the following points **must** lie on $y=-f(x)-1?$" :question/worked-solution "**Method 1**\n\nTo plot $y=-f(x)-1,$ we apply the following steps: \n\n- First, we take the graph $y=f(x).$\n\n- Then, we reflect the graph across the $x$-axis and get the graph of $y=-f(x).$ After this transformation, the point $(3,1)$ will be mapped to the point\n\n$$\n(3,-(1))=(3,-1).\n$$\n\n- Finally, we shift the result vertically by $1$ unit down and obtain the graph of $y=-f(x)-1.$ After this transformation, the point $(3,-1)$ will be mapped to the point\n\n$$\n(3,-1-1)=(3,-2).\n$$\n\n**Method 2**\n\nSince the point $(3,1)$ lies on the graph of $y=f(x)$, we have that $f(3)=1.$\n\nNow consider the graph of $y=-f(x)-1.$ Substituting $x=3$, we get\n\n$$\n\\begin{aligned}y & =-f(3)-1 \\\\  & =-(1)-1 \\\\  & =-1-1 \\\\  & =-2.\\end{aligned}\n$$\n\nTherefore, the point $(3,-2)$ must lie on $y=-f(x)-1.$"}] [{:db/id #edb/ref 17592186292673 :knowledge-point/_questions [{:db/id #edb/ref 17592186059669 :knowledge-point/id #uuid "38b450bd-b43a-507c-9bbe-0aaf7a64a3ed" :knowledge-point/title "Finding a Point That Lies on a Transformed Curve Given Another Transformed Curve"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2f5bb3ff-2bf2-59a6-a9dc-028e36b29e5f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(3,0)" :db/id #edb/ref 17592186290821} {:answer/id #uuid "6a0dffee-d291-5706-b099-bf26056b0a79" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(3,4)" :db/id #edb/ref 17592186291085} {:answer/id #uuid "745f11b3-4abb-5778-b95c-05bfed92c9ad" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(3,2)" :db/id #edb/ref 17592186291130} {:answer/id #uuid "add1ba6b-56e1-507d-81c4-d7cc7dd66d71" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(3,-2)" :db/id #edb/ref 17592186291387} {:answer/id #uuid "f811fc7c-86fc-528d-a6a8-cba9ceee139f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-3,-2)" :db/id #edb/ref 17592186291677}] :answer-field/correct {:answer/id #uuid "add1ba6b-56e1-507d-81c4-d7cc7dd66d71" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(3,-2)" :db/id #edb/ref 17592186291387} :answer-field/id #uuid "e46bb93d-f096-5e20-be4c-e4f183d28feb" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186292449}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "4ee92c98-a45f-55db-8092-7db7c00e5a4e" :question/math-academy-id "q-26596" :question/problem "The point  $(3,2)$ lies on the curve $y=f(x)-2.$ Which of the following points **must** lie on $y=-f(x)+2?$" :question/worked-solution "**Method 1**\n\nWe first find a point corresponding to $(3,2)$ on $y=f(x).$ Then, we find a corresponding point on $y=-f(x)+2:$\n\n- To plot the graph of $y=f(x),$ we apply the following steps:\n\n- First, take the graph $y=f(x)-2.$\n\n- Then, we shift the graph vertically by $2$ units up and get the graph of $y=f(x).$ After this transformation, the point $(3,2)$ will be mapped to the point\n\n$$\n(3,2+2)=(3,4).\n$$\n\n- Next, to plot the graph of $y=-f(x)+2,$ we apply the following steps:\n\n- First, take the graph $y=f(x).$\n\n- Then, we reflect the result across the $x$-axis and get the graph of $y=-f(x).$ After this transformation, the point $(3,4)$ will be mapped  to the point\n\n$$\n(3,-(4))=(3,-4).\n$$\n\n- Next, we shift the result vertically by $2$ units up and obtain the graph of $y=-f(x)+2.$ After this transformation, the point $(3,-4)$ will be mapped to the point \n\n$$\n(3,-4+2)=(3,-2).\n$$\n\n**Method 2**\n\nSince the point $(3,2)$ lies on the graph of $y=f(x)-2$, we have that \n\n$$\nf(3)-2=2\\,⟹\\,f(3)=4.\n$$\n\nNow consider the graph of $y=-f(x)+2.$ Substituting $x=3$, we get\n\n$$\n\\begin{aligned}y & =-f(3)+2 \\\\  & =-4+2 \\\\  & =-2.\\end{aligned}\n$$\n\nTherefore, the point $(3,-2)$ must lie on $y=-f(x)+2.$"}] [{:db/id #edb/ref 17592186390514 :knowledge-point/_questions [{:db/id #edb/ref 17592186087821 :knowledge-point/id #uuid "dd63cb30-a236-546e-82ac-08bce09c88f7" :knowledge-point/title "Identifying a Vertically Shifted Exponential Growth Curve"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1db17739-2def-5e37-af22-164593bd5829" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/61/61cd6304483770e91658f37cd8ac3dbf57c58f25c9a631ab45a56cd706d381ee.png" :db/id #edb/ref 17592186390516} {:answer/id #uuid "9904a233-df69-591c-90af-01e22fb617bb" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/31/31f0d95293939e141e0ebff2aaad6223a9a82188e892441906ae09c530919b1d.png" :db/id #edb/ref 17592186390517} {:answer/id #uuid "acd865cc-8ca0-5df0-b0c5-c2cd29210f44" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/df/dfb46737087c1196ce079607220107a88857d6ca139d0d5c53b181795fe1344a.png" :db/id #edb/ref 17592186390518} {:answer/id #uuid "ddc2a988-d900-5cd3-a9a0-9a6ecf303b6b" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/ee/eef682605cf7486a9d8fa23cd508705e70443622164eeb2c253ca342bbce92cb.png" :db/id #edb/ref 17592186390519} {:answer/id #uuid "fffb642d-e2f2-5134-92b3-6bde0b2a9298" :answer/type {: