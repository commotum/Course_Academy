#{[{:db/id #edb/ref 17592186275409 :knowledge-point/_questions [{:db/id #edb/ref 17592186068840 :knowledge-point/id #uuid "16f0876a-33f0-5c6b-9195-8b9a0a550655" :knowledge-point/title "Finding a General Solution in Explicit Form"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "18e3c6b0-0e58-5c33-8744-40f2dcdff54e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=K{e}^{\\operatorname{sin}⁡x}" :db/id #edb/ref 17592186272603} {:answer/id #uuid "78f4f93b-be8f-5c4d-a519-6d99d4fba770" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=K{e}^{-2\\operatorname{sin}⁡x}" :db/id #edb/ref 17592186273424} {:answer/id #uuid "8883ebfa-4000-5edd-9354-c90407ee9c40" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y={e}^{-\\operatorname{cos}⁡x}+K" :db/id #edb/ref 17592186273559} {:answer/id #uuid "952e6dd1-43ff-54f6-9de1-fd7289574d4c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=K{e}^{\\operatorname{cos}⁡x}" :db/id #edb/ref 17592186273685} {:answer/id #uuid "e21a3412-a805-5477-baaf-507c3b52c7c9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y={e}^{\\operatorname{sin}⁡x}+K" :db/id #edb/ref 17592186274386}] :answer-field/correct {:answer/id #uuid "18e3c6b0-0e58-5c33-8744-40f2dcdff54e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=K{e}^{\\operatorname{sin}⁡x}" :db/id #edb/ref 17592186272603} :answer-field/id #uuid "379ffcc8-e905-5697-a128-ee6a8efb7a2d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186274732}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "2c6ab8c9-fca1-56b1-82a8-98c4fa9f8c2c" :question/math-academy-id "q-158014" :question/problem "Find the general solution to the differential equation ${y}^{′}=y\\operatorname{cos}⁡x$ for $y\\ne 0.$" :question/worked-solution "To find the general solution, we first separate the variables:\n\n$$\n\\begin{aligned}{y}^{′} & =y\\operatorname{cos}⁡x \\\\ \\frac{\\text{d}y}{\\text{d}x} & =y\\operatorname{cos}⁡x \\\\ \\frac{1}{y}\\,\\frac{\\text{d}y}{\\text{d}x} & =\\operatorname{cos}⁡x\\end{aligned}\n$$\n\nThen, we integrate both sides with respect to $x:$\n\n$$\n\\begin{aligned}\\int \\frac{1}{y}\\,\\frac{\\text{d}y}{\\text{d}x}\\,\\text{d}x & =\\int \\operatorname{cos}⁡x\\,\\text{d}x \\\\ \\int \\frac{1}{y}\\,\\frac{\\text{d}y}{\\cancel{\\text{d}x}}\\,\\cancel{\\text{d}x} & =\\int \\operatorname{cos}⁡x\\,\\text{d}x \\\\ \\int \\frac{1}{y}\\,\\text{d}y & =\\int \\operatorname{cos}⁡x\\,\\text{d}x \\\\ \\operatorname{ln}⁡|y| & =\\operatorname{sin}⁡x+C\\end{aligned}\n$$\n\nTherefore, the general solution to the differential equation (in implicit form) is\n\n$$\n\\operatorname{ln}⁡|y|=\\operatorname{sin}⁡x+C.\n$$\n\nWe're required to write the solution in the form $y=y(x).$ By doing this, we get\n\n$$\n\\begin{aligned}{e}^{\\operatorname{ln}⁡|y|} & ={e}^{\\operatorname{sin}⁡x+C} \\\\ |y| & ={e}^{\\operatorname{sin}⁡x+C} \\\\ |y| & ={e}^{\\operatorname{sin}⁡x}\\cdot {e}^{C} \\\\ |y| & =K{e}^{\\operatorname{sin}⁡x},\\end{aligned}\n$$\n\nwhere $K={e}^{C}$ and $K>0.$\n\nWe can drop the absolute value bars by allowing $K$ to be either positive or negative. Therefore, the most general solution is\n\n$$\ny=K{e}^{\\operatorname{sin}⁡x}.\n$$"}] [{:db/id #edb/ref 17592186275414 :knowledge-point/_questions [{:db/id #edb/ref 17592186068842 :knowledge-point/id #uuid "c0d908f1-591e-5cb6-afc5-fa7ec44ec326" :knowledge-point/title "Separating the Variables in a Differential Equation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "494ae645-dd79-56e3-beb4-47a6995c7d8c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y\\cdot \\frac{\\text{d}y}{\\text{d}x}={e}^{x}" :db/id #edb/ref 17592186273011} {:answer/id #uuid "531a24d3-1d14-5b43-9a4f-2e858901dbc2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{e}^{-x}}{y}\\cdot \\frac{\\text{d}y}{\\text{d}x}=1" :db/id #edb/ref 17592186273093} {:answer/id #uuid "6dd02c4a-ba52-56b7-a30a-66ebd3e84513" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{e}^{-x}\\cdot \\frac{\\text{d}y}{\\text{d}x}=y" :db/id #edb/ref 17592186273339} {:answer/id #uuid "98601ac4-2a74-546e-8308-acabc08e7566" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{e}^{x}\\cdot \\frac{\\text{d}y}{\\text{d}x}=y" :db/id #edb/ref 17592186273709} {:answer/id #uuid "a8ffb26a-9163-59ae-8b17-526b2d86e380" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{y}\\cdot \\frac{\\text{d}y}{\\text{d}x}={e}^{x}" :db/id #edb/ref 17592186273847}] :answer-field/correct {:answer/id #uuid "a8ffb26a-9163-59ae-8b17-526b2d86e380" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{y}\\cdot \\frac{\\text{d}y}{\\text{d}x}={e}^{x}" :db/id #edb/ref 17592186273847} :answer-field/id #uuid "21ba5489-b345-5d21-a343-3f8e76c8cf24" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186274699}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "4c68a380-7f42-5c23-811b-3bce1cfeb2f0" :question/math-academy-id "q-158022" :question/problem "Separate the variables in the following differential equation: \n\n$$\n\\frac{\\text{d}y}{\\text{d}x}=y{e}^{x}\n$$" :question/worked-solution "A differentiable equation is *separable* if it can be written in the form\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}=h(x)g(y).\n$$\n\nIf an equation is separable, we say that the variables are *separated* when it is written in the form\n\n$$\n\\frac{1}{g(y)}\\cdot \\frac{\\text{d}y}{\\text{d}x}=h(x).\n$$\n\nNotice that our differentiable equation is separable since it can be written as\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}={e}^{x}\\cdot y.\n$$\n\nTherefore, we separate the variables as follows:\n\n$$\n\\frac{1}{y}\\cdot \\frac{\\text{d}y}{\\text{d}x}={e}^{x}\n$$"}] [{:db/id #edb/ref 17592186275429 :knowledge-point/_questions [{:db/id #edb/ref 17592186176059 :knowledge-point/id #uuid "d4b378b0-30e5-59a8-b9f7-882b5e226a2e" :knowledge-point/title "Utilizing the Evenness Property of the Secant Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5853255d-444b-562b-bf17-f13ce1a296c2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{7}}{7}" :db/id #edb/ref 17592186273145} {:answer/id #uuid "60d72189-d83a-5207-899f-d9efeb80163a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{7}" :db/id #edb/ref 17592186273223} {:answer/id #uuid "9e8ce348-c0e6-5db4-aad5-d94aea1f6bd1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\sqrt{7}" :db/id #edb/ref 17592186273756} {:answer/id #uuid "a7a91683-6c61-50b8-ad58-3b8483a81bb0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "7" :db/id #edb/ref 17592186273838} {:answer/id #uuid "e066a281-d3ca-591f-b3a6-a1f3553eab86" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-7" :db/id #edb/ref 17592186274368}] :answer-field/correct {:answer/id #uuid "60d72189-d83a-5207-899f-d9efeb80163a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{7}" :db/id #edb/ref 17592186273223} :answer-field/id #uuid "29c0579e-93c1-5f6a-b530-c6c2b74ddb44" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186274707}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "dc90373f-5a39-5101-be93-517f135c4a77" :question/math-academy-id "q-158049" :question/problem "If $\\operatorname{sec}⁡a=\\sqrt{7},$ then $\\operatorname{sec}⁡(-a+20\\pi )=$" :question/worked-solution "First, let's recall the graph of $y=\\operatorname{sec}⁡x.$\n\n![](images/fb/fbf6ef1ca91f998ab4dc2dda1890ffc8a713f2eeff19e5569351b2466256d63a.png)\n\nFrom the graph, we note the following:\n\n- The period of $\\operatorname{sec}⁡x$ is $2\\pi .$\n\n- Our graph is symmetric about the $y$-axis. This means that $\\operatorname{sec}⁡x$ is an *even* function, and we have\n\n$$\n\\operatorname{sec}⁡(-x)=\\operatorname{sec}⁡x.\n$$\n\nLet's now evaluate our expression:\n\n- Firstly, using the periodicity of $\\operatorname{sec}⁡x,$ we have\n\n$$\n\\begin{aligned}\\operatorname{sec}⁡(-a+20\\pi ) & =\\operatorname{sec}⁡(-a+2\\pi \\cdot 10) \\\\  & =\\operatorname{sec}⁡(-a).\\end{aligned}\n$$\n\n- Secondly, using the evenness of $\\operatorname{sec}⁡x,$ we have\n\n$$\n\\begin{aligned}\\operatorname{sec}⁡(-a) & =\\operatorname{sec}⁡a \\\\  & =\\sqrt{7}.\\end{aligned}\n$$\n\nTherefore, $\\operatorname{sec}⁡(-a+20\\pi )=\\sqrt{7}.$"}] [{:db/id #edb/ref 17592186401104 :knowledge-point/_questions [{:db/id #edb/ref 17592186087782 :knowledge-point/id #uuid "e44305e5-b7e3-5ae2-925c-9329f37823b8" :knowledge-point/title "Finding the Points of Intersection of a Circle with a Line"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "21c893f0-7ed9-50d0-9479-4bfb6c5c6906" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$(-4,-2)$ and $(1,0)$" :db/id #edb/ref 17592186401106} {:answer/id #uuid "5e681a2e-8cd8-5ca9-b5d3-8777f4728c3e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$(-4,-2)$ and $(2,0)$" :db/id #edb/ref 17592186401107} {:answer/id #uuid "075c1360-2993-54ea-a5ab-60fe6486955e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$(-3,-1)$ and $(1,0)$" :db/id #edb/ref 17592186401108} {:answer/id #uuid "fa1e5ed6-4c6c-5020-bbc5-7c83a63fb116" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$(-3,-1)$ and $(2,0)$" :db/id #edb/ref 17592186401109} {:answer/id #uuid "d396b6f8-3098-5eff-a463-bdfe23d65067" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$(-4,-1)$ and $(2,0)$" :db/id #edb/ref 17592186401110}] :answer-field/correct {:answer/id #uuid "5e681a2e-8cd8-5ca9-b5d3-8777f4728c3e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$(-4,-2)$ and $(2,0)$" :db/id #edb/ref 17592186401107} :answer-field/id #uuid "0c104c61-200a-5174-998d-683d5dd55c83" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186401105}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "cfa05974-d33e-5f3c-90f3-bf0b329bfc3f" :question/math-academy-id "q-15805" :question/problem "![](images/de/de12c0b5be8318cc21c62615d24125998c22d55d37abafdee37c103c3840cb71.png)\n\nFind the points where the circle ${x}^{2}+(y+4)^{2}=20$ intersects the line $x-3y=2$ (sketched above)." :question/worked-solution "First, we rearrange the equation $x-3y=2,$ as follows:\n\n$$\ny=\\frac{x}{3}-\\frac{2}{3}\n$$\n\nTo find $x$-coordinates of the intersection points, we need to substitute $y=\\frac{x}{3}-\\frac{2}{3}$ into the equation of the circle and solve the resulting equation for $x:$ \n\n$$\n\\begin{aligned}{x}^{2}+(y+4)^{2} & =20 \\\\ {x}^{2}+{(\\frac{x}{3}-\\frac{2}{3}+4)}^{2} & =20 \\\\ {x}^{2}+{(\\frac{x}{3}+\\frac{10}{3})}^{2} & =20 \\\\ {x}^{2}+\\frac{{x}^{2}}{9}+\\frac{20x}{9}+\\frac{100}{9} & =20 \\\\ \\frac{10{x}^{2}}{9}+\\frac{20x}{9}+\\frac{100}{9} & =20 \\\\ {x}^{2}+2x+10 & =18 \\\\ {x}^{2}+2x-8 & =0 \\\\ (x+4)(x-2) & =0 \\\\ x & =-4,2.\\end{aligned}\n$$\n\nTo find the $y$-coordinates of the intersection points, we need to substitute $x=-4,2$ into the equation of the line and compute $y$-values. Start with $x=-4$:\n\n$$\n\\begin{aligned}y & =\\frac{x}{3}-\\frac{2}{3} \\\\  & =-\\frac{4}{3}-\\frac{2}{3} \\\\  & =-2.\\end{aligned}\n$$\n\nTherefore, the first intersection point is $(-4,-2).$ Next, we plug in $x=2$:\n\n$$\n\\begin{aligned}y & =\\frac{x}{3}-\\frac{2}{3} \\\\  & =\\frac{2}{3}-\\frac{2}{3} \\\\  & =0.\\end{aligned}\n$$\n\nSo, the second intersection point is $(2,0).$\n\nTherefore, the line $x-3y=2$ intersects the circle ${x}^{2}+(y+4)^{2}=20$ at the points $(-4,-2)$ and $(2,0).$"}] [{:db/id #edb/ref 17592186275432 :knowledge-point/_questions [{:db/id #edb/ref 17592186176061 :knowledge-point/id #uuid "b0251566-4dfc-5786-b00a-ce609e5b2698" :knowledge-point/title "Utilizing the Oddness Property of the Cotangent Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1308c252-3f5f-5a02-be87-52593ac89917" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5}{2}" :db/id #edb/ref 17592186272558} {:answer/id #uuid "33cb8823-ce66-5677-84d7-89e4c81c03e0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{2}{5}" :db/id #edb/ref 17592186272846} {:answer/id #uuid "9ccbdf46-9ee5-5738-a68a-6a4c7e94d746" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2}{5}" :db/id #edb/ref 17592186273746} {:answer/id #uuid "c35f06e3-925e-57a7-8e44-c7ad3fa649fc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186274082} {:answer/id #uuid "e42382ea-4217-5fb3-b74a-833c31fad439" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{5}{2}" :db/id #edb/ref 17592186274404}] :answer-field/correct {:answer/id #uuid "e42382ea-4217-5fb3-b74a-833c31fad439" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{5}{2}" :db/id #edb/ref 17592186274404} :answer-field/id #uuid "d811a9a8-c409-5b01-851f-64933cb4d3b5" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186275015}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "0221b117-6ad9-5a2f-80bb-79e143dc5ca6" :question/math-academy-id "q-158055" :question/problem "If $cot⁡x=\\frac{5}{2},$ then $cot⁡(-x)=$" :question/worked-solution "First, let's recall the graph of $y=cot⁡x.$\n\n![](images/6e/6eb672fe024f024f20c7c3c80947d1b47bade8f998e705d6f411ae3f298ecde2.png)\n\nOur graph has rotational symmetry of order $2$ about the origin. If we rotate the graph ${180}^{∘}$ around the origin, we get the same picture. This means that $cot⁡x$ is an *odd* function, and we have\n\n$$\ncot⁡(-x)=-cot⁡x.\n$$\n\nTherefore, \n\n$$\n\\begin{aligned}cot⁡(-x) & =-cot⁡x \\\\  & =-\\frac{5}{2}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186275434 :knowledge-point/_questions [{:db/id #edb/ref 17592186176057 :knowledge-point/id #uuid "94645507-186a-54a7-a96b-ccfb0fb1f769" :knowledge-point/title "Utilizing the Evenness Property of the Cosine Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "275f4184-6614-5fb5-b945-c0a925615360" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186272735} {:answer/id #uuid "8a7df9b3-60b6-5ef6-8973-d6465d2aa3e2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\pi -\\frac{1}{2}" :db/id #edb/ref 17592186273582} {:answer/id #uuid "8f1e5805-1c6c-5d57-b929-84303eb5f147" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186273626} {:answer/id #uuid "ae068c2c-1302-562e-8e3f-5924d2a8dd0c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\pi " :db/id #edb/ref 17592186273888} {:answer/id #uuid "b395db12-bd50-557e-ae1c-0cff707eab03" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{2}" :db/id #edb/ref 17592186273938}] :answer-field/correct {:answer/id #uuid "b395db12-bd50-557e-ae1c-0cff707eab03" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{2}" :db/id #edb/ref 17592186273938} :answer-field/id #uuid "ea032dc8-afc8-5574-9882-b42bbb63200d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186275047}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "a595d8eb-425e-5670-9569-3c6cc685c869" :question/math-academy-id "q-158059" :question/problem "If $cos⁡x=0,$ then $\\pi cos⁡(-x+18\\pi )-\\frac{1}{2}=$" :question/worked-solution "First, let's recall the graph of $y=cos⁡x.$\n\n![](images/23/2373daf4b5fd26f098bf90e998e2685db6a8b793e94ac9d80b08ea423cb535c0.png)\n\nFrom the graph, we note the following:\n\n- The period of $cos⁡x$ is $2\\pi .$\n\n- Our graph is symmetric over the $y$-axis. This means that $cos⁡x$ is an *even* function, and we have\n\n$$\ncos⁡(-x)=cos⁡x.\n$$\n\nLet's now evaluate our expression:\n\n- Firstly, using the periodicity of $cos⁡x,$ we have\n\n$$\n\\begin{aligned}cos⁡(-x+18\\pi ) & =cos⁡(-x+2\\pi \\cdot 9) \\\\  & =cos⁡(-x).\\end{aligned}\n$$\n\n- Secondly, using the evenness of $cos⁡x,$ we have\n\n$$\n\\begin{aligned}cos⁡(-x) & =cos⁡x \\\\  & =0.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\pi cos⁡(-x+18\\pi )-\\frac{1}{2} & =\\pi \\cdot 0-\\frac{1}{2} \\\\  & =0-\\frac{1}{2} \\\\  & =-\\frac{1}{2}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186275436 :knowledge-point/_questions [{:db/id #edb/ref 17592186176061 :knowledge-point/id #uuid "b0251566-4dfc-5786-b00a-ce609e5b2698" :knowledge-point/title "Utilizing the Oddness Property of the Cotangent Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0b4110e0-8cbe-509f-8768-e57ad22b3e55" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186272490} {:answer/id #uuid "0dfc4511-a4c7-5555-89b3-9b7095440042" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "10" :db/id #edb/ref 17592186272509} {:answer/id #uuid "8fd51020-1a5c-56db-8c08-63b63d83c079" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186273636} {:answer/id #uuid "bf721ced-4517-5626-a108-41e175743956" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186274043} {:answer/id #uuid "e6d362da-9dbc-5d76-bebd-946b5b66ed7d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-9" :db/id #edb/ref 17592186274426}] :answer-field/correct {:answer/id #uuid "0dfc4511-a4c7-5555-89b3-9b7095440042" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "10" :db/id #edb/ref 17592186272509} :answer-field/id #uuid "2b3c6ee6-6e94-558d-95c0-4e54abe1c6d9" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186274710}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "2a79aaf7-1dcc-57ab-a0b7-6d93a2b468da" :question/math-academy-id "q-158064" :question/problem "If $cot⁡x=-6,$ then $\\frac{1}{2}cot⁡(-x+15\\pi )+7=$" :question/worked-solution "First, let's recall the graph of $y=cot⁡x.$\n\n![](images/6e/6eb672fe024f024f20c7c3c80947d1b47bade8f998e705d6f411ae3f298ecde2.png)\n\nFrom the graph, we note the following:\n\n- The period of $cot⁡x$ is $\\pi .$\n\n- Our graph has rotational symmetry of order $2$ about the origin. This means that $cot⁡x$ is an *odd* function, and we have\n\n$$\ncot⁡(-x)=-cot⁡x.\n$$\n\nLet's now evaluate our expression:\n\n- Firstly, using the periodicity of $cot⁡x,$ we have\n\n$$\n\\begin{aligned}cot⁡(-x+15\\pi ) & =cot⁡(-x+\\pi \\cdot 15) \\\\  & =cot⁡(-x).\\end{aligned}\n$$\n\n- Secondly, using the oddness of $cot⁡x,$ we have\n\n$$\n\\begin{aligned}cot⁡(-x) & =-cot⁡x \\\\  & =-(-6) \\\\  & =6.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\frac{1}{2}cot⁡(-x+15\\pi )+7 & =\\frac{1}{2}\\cdot 6+7 \\\\  & =\\frac{6}{2}+7 \\\\  & =3+7 \\\\  & =10.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186275437 :knowledge-point/_questions [{:db/id #edb/ref 17592186176060 :knowledge-point/id #uuid "48a710f9-fed1-5fdb-b4c0-fd3ae2d4d8a4" :knowledge-point/title "Utilizing the Oddness Property of the Cosecant Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1c7814cb-8a14-543c-b191-090e1d7ec186" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{7}{4}" :db/id #edb/ref 17592186272638} {:answer/id #uuid "912d0bf4-9153-5eaf-8129-ed93f063eca1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{4}{11}" :db/id #edb/ref 17592186273648} {:answer/id #uuid "979f59c9-f61f-5d15-890f-5f7e912c17f4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{7}{4}" :db/id #edb/ref 17592186273701} {:answer/id #uuid "e9c841e0-0d84-5ffb-afef-0ed443247d86" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{11}{4}" :db/id #edb/ref 17592186274456} {:answer/id #uuid "fb39b869-1aff-5ccd-a39a-e66bfc83a392" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{11}{4}" :db/id #edb/ref 17592186274590}] :answer-field/correct {:answer/id #uuid "e9c841e0-0d84-5ffb-afef-0ed443247d86" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{11}{4}" :db/id #edb/ref 17592186274456} :answer-field/id #uuid "ca6a7db3-5479-511f-aa28-280da1724856" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186274989}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "990fed19-47aa-5e1c-b060-215e7bc1b3ed" :question/math-academy-id "q-158065" :question/problem "If $\\operatorname{csc}⁡a=\\frac{11}{4},$ then $\\operatorname{csc}⁡(-a)=$" :question/worked-solution "First, let's recall the graph of $y=\\operatorname{csc}⁡x.$\n\n![](images/a8/a8e7894ea970c539ca59a73713fa15450f4361b3fc8bc22183e3fe84946411bd.png)\n\nOur graph has rotational symmetry of order $2$ about the origin. If we rotate the graph ${180}^{∘}$ around the origin, we get the same picture. This means that $\\operatorname{csc}⁡x$ is an *odd* function, and we have\n\n$$\n\\operatorname{csc}⁡(-x)=-\\operatorname{csc}⁡x.\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\operatorname{csc}⁡(-a) & =-\\operatorname{csc}⁡a \\\\  & =-\\frac{11}{4}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186275440 :knowledge-point/_questions [{:db/id #edb/ref 17592186176060 :knowledge-point/id #uuid "48a710f9-fed1-5fdb-b4c0-fd3ae2d4d8a4" :knowledge-point/title "Utilizing the Oddness Property of the Cosecant Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6ce714d8-554b-5354-a70c-c88220f6cb42" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{11}{3}" :db/id #edb/ref 17592186273331} {:answer/id #uuid "a1025211-77b5-5b03-8606-c8562215708e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{6}" :db/id #edb/ref 17592186273783} {:answer/id #uuid "a5e066f7-00a4-56e3-bec2-634660c4b3dd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{17}{3}" :db/id #edb/ref 17592186273822} {:answer/id #uuid "cf0b140a-f05b-50c4-992b-d9f86cd91f5f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{5}{2}" :db/id #edb/ref 17592186274189} {:answer/id #uuid "ed579fc1-af8b-5a45-be91-452681696d91" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{5}{6}" :db/id #edb/ref 17592186274486}] :answer-field/correct {:answer/id #uuid "6ce714d8-554b-5354-a70c-c88220f6cb42" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{11}{3}" :db/id #edb/ref 17592186273331} :answer-field/id #uuid "cbe91a72-b803-5369-bdce-e9dc3475245a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186274992}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "52fb1c00-a770-5c09-ab79-cdf019b59f0c" :question/math-academy-id "q-158071" :question/problem "If $\\operatorname{csc}⁡x=\\frac{7}{6},$ then $4\\operatorname{csc}⁡(-x+6\\pi )+1=$" :question/worked-solution "First, let's recall the graph of $y=\\operatorname{csc}⁡x.$\n\n![](images/a8/a8e7894ea970c539ca59a73713fa15450f4361b3fc8bc22183e3fe84946411bd.png)\n\nFrom the graph, we note the following:\n\n- The period of $\\operatorname{csc}⁡x$ is $2\\pi .$\n\n- Our graph has rotational symmetry of order $2$ about the origin. This means that $\\operatorname{csc}⁡x$ is an *odd* function, and we have\n\n$$\n\\operatorname{csc}⁡(-x)=-\\operatorname{csc}⁡x.\n$$\n\nLet's now evaluate our expression:\n\n- Firstly, using the periodicity of $\\operatorname{csc}⁡x,$ we have\n\n$$\n\\begin{aligned}\\operatorname{csc}⁡(-x+6\\pi ) & =\\operatorname{csc}⁡(-x+2\\pi \\cdot 3) \\\\  & =\\operatorname{csc}⁡(-x).\\end{aligned}\n$$\n\n- Secondly, using the oddness of $\\operatorname{csc}⁡x,$ we have\n\n$$\n\\begin{aligned}\\operatorname{csc}⁡(-x) & =-\\operatorname{csc}⁡x \\\\  & =-\\frac{7}{6}.\\end{aligned}\n$$\n\nTherefore, \n\n$$\n\\begin{aligned}4\\operatorname{csc}⁡(-x+6\\pi )+1 & =4(-\\frac{7}{6})+1 \\\\  & =-\\frac{14}{3}+1 \\\\  & =-\\frac{11}{3}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186275446 :knowledge-point/_questions [{:db/id #edb/ref 17592186119932 :knowledge-point/id #uuid "3118d2af-771f-54c9-b18e-5196b87b6dca" :knowledge-point/title "Computing the Volume of an N-Dimensional Parallelepiped"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2d8d63a0-e6e8-5621-b14e-0a6afb7468b1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "112" :db/id #edb/ref 17592186272792} {:answer/id #uuid "4e356ba3-0766-580b-b544-969b6db926d9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "93" :db/id #edb/ref 17592186273046} {:answer/id #uuid "6a9af943-2e3a-56aa-a3d4-69f1c9aa6ac3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "105" :db/id #edb/ref 17592186273306} {:answer/id #uuid "7b178126-366e-5772-8fae-0734a917447f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "81" :db/id #edb/ref 17592186273443} {:answer/id #uuid "e3683848-ab39-5f23-91ed-e22f1d4d80fc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "72" :db/id #edb/ref 17592186274398}] :answer-field/correct {:answer/id #uuid "6a9af943-2e3a-56aa-a3d4-69f1c9aa6ac3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "105" :db/id #edb/ref 17592186273306} :answer-field/id #uuid "16f94c49-7116-5254-8071-00edbc36756c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186274676}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "32e6e8c1-9b26-5825-ac5f-18dfd683a674" :question/math-academy-id "q-158108" :question/problem "Calculate the volume of the $4$-dimensional parallelepiped spanned by the vectors\n\n$$\na=[\\begin{aligned}7 \\\\ -2 \\\\ 5 \\\\ 3\\end{aligned}],\\,b=[\\begin{aligned}0 \\\\ 3 \\\\ 4 \\\\ -2\\end{aligned}],\\,c=[\\begin{aligned}0 \\\\ 0 \\\\ -1 \\\\ 2\\end{aligned}],\\,d=[\\begin{aligned}0 \\\\ 0 \\\\ 0 \\\\ 5\\end{aligned}].\n$$" :question/worked-solution "First, let's construct the matrix $M,$ whose columns are the coordinates of our vectors $a,$ $b,$ $c,$ and  $d:$\n\n$$\nM=[\\begin{aligned}7 & 0 & 0 & 0 \\\\ -2 & 3 & 0 & 0 \\\\ 5 & 4 & -1 & 0 \\\\ 3 & -2 & 2 & 5\\end{aligned}]\n$$\n\nThe volume of the parallelepiped spanned by these vectors equals the absolute value of the determinant of $M:$\n\n$$\nV=|det(M)|\n$$\n\nThe determinant of a triangular matrix is equal to the product of the entries on the main diagonal. So, we have\n\n$$\ndet(M)=[\\begin{aligned}7 & 0 & 0 & 0 \\\\ -2 & 3 & 0 & 0 \\\\ 5 & 4 & -1 & 0 \\\\ 3 & -2 & 2 & 5\\end{aligned}]=7\\cdot 3\\cdot (-1)\\cdot 5=-105.\n$$\n\nTherefore, the volume is\n\n$$\nV=|det(M)|=|-105|=105.\n$$"}] [{:db/id #edb/ref 17592186275457 :knowledge-point/_questions [{:db/id #edb/ref 17592186059651 :knowledge-point/id #uuid "23637774-8d69-500d-8cb0-5e41a0207542" :knowledge-point/title "Simplifying Rational Expressions Using an Alternate Form of the Pythagorean Identity"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "43fdec51-bb15-58a1-ac35-a4628bdaa895" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186272966} {:answer/id #uuid "7bc399b8-24ed-566b-807a-98321753ba77" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186273449} {:answer/id #uuid "c672699b-78d4-5fd4-9230-acc5ec657314" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{2}" :db/id #edb/ref 17592186274108} {:answer/id #uuid "e7b57a70-f0e5-5f77-8a9c-b1e730d2744a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186274436} {:answer/id #uuid "e9793388-0d77-54db-82ac-a9919ac4db9c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186274452}] :answer-field/correct {:answer/id #uuid "43fdec51-bb15-58a1-ac35-a4628bdaa895" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186272966} :answer-field/id #uuid "80c6b84b-18ea-5a42-80cf-65bc4466c515" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186274854}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "d8d55196-4015-578e-afc9-4c54361316e6" :question/math-academy-id "q-1583" :question/problem "$\\frac{1}{{cos}^{2}⁡A}-\\frac{1}{{cot}^{2}⁡A}=$" :question/worked-solution "First, we use the definition of $\\operatorname{cot}⁡A$ to rewrite the second term:\n\n$$\n\\begin{aligned}\\frac{1}{{cos}^{2}⁡A}-\\frac{1}{{cot}^{2}⁡A} & =\\frac{1}{{cos}^{2}⁡A}-{tan}^{2}⁡A \\\\  & =\\frac{1}{{cos}^{2}⁡A}-\\frac{{sin}^{2}⁡A}{{cos}^{2}⁡A} \\\\  & =\\frac{1-{sin}^{2}⁡A}{{cos}^{2}⁡A}\\end{aligned}\n$$\n\nNow, we can use the identity $1-{sin}^{2}⁡A={cos}^{2}⁡A$:\n\n$$\n\\begin{aligned}\\frac{1-{sin}^{2}⁡A}{{cos}^{2}⁡A} & =\\frac{{cos}^{2}⁡A}{{cos}^{2}⁡A}=1\\end{aligned}\n$$\n\nTherefore, we conclude that:\n\n$$\n\\frac{1}{{cos}^{2}⁡A}-\\frac{1}{{cot}^{2}⁡A}=1\n$$"}] [{:db/id #edb/ref 17592186369845 :knowledge-point/_questions [{:db/id #edb/ref 17592186119932 :knowledge-point/id #uuid "3118d2af-771f-54c9-b18e-5196b87b6dca" :knowledge-point/title "Computing the Volume of an N-Dimensional Parallelepiped"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4ca3fc2b-bad0-5b4b-bc00-408085561cc9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "12" :db/id #edb/ref 17592186369847} {:answer/id #uuid "a6c7791b-9b12-5dd6-9d19-547ef87dd6a8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186369848} {:answer/id #uuid "c232025a-ca14-5a4a-9e9f-a8ff81b74a6d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "24" :db/id #edb/ref 17592186369849} {:answer/id #uuid "9e6c71c2-2201-52f2-abf4-3b33cdc6feea" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-12" :db/id #edb/ref 17592186369850} {:answer/id #uuid "1571cd95-16d4-5e7a-a516-2378f040ff5c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-6" :db/id #edb/ref 17592186369851}] :answer-field/correct {:answer/id #uuid "4ca3fc2b-bad0-5b4b-bc00-408085561cc9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "12" :db/id #edb/ref 17592186369847} :answer-field/id #uuid "10725161-b676-53dc-8bff-5c967c1e8dfa" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186369846}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "9fc304b0-a53d-5a62-b8cd-1ca341a43179" :question/math-academy-id "q-158367" :question/problem "Calculate the volume of the $4$-dimensional parallelepiped spanned by the vectors\n\n$$\na=[\\begin{aligned}4 \\\\ -5 \\\\ 2 \\\\ 0\\end{aligned}],\\,b=[\\begin{aligned}5 \\\\ 7 \\\\ -2 \\\\ -1\\end{aligned}],\\,c=[\\begin{aligned}0 \\\\ 3 \\\\ 2 \\\\ 0\\end{aligned}],\\,d=[\\begin{aligned}0 \\\\ 0 \\\\ 1 \\\\ 0\\end{aligned}].\n$$" :question/worked-solution "First, let's construct the matrix $M,$ whose columns are the coordinates of our vectors $a,$ $b,$ $c,$ and  $d:$\n\n$$\nM=[\\begin{aligned}4 & 5 & 0 & 0 \\\\ -5 & 7 & 3 & 0 \\\\ 2 & -2 & 2 & 1 \\\\ 0 & -1 & 0 & 0\\end{aligned}]\n$$\n\nThe volume of the parallelepiped spanned by these vectors equals the absolute value of the determinant of $M:$\n\n$$\nV=|det(M)|\n$$\n\nNotice that the $4$th row of the determinant contains three zeros. So, using Laplace expansion along the $4$th row, we have\n\n$$\n\\begin{aligned}det(M) & =|\\begin{aligned}4 & 5 & 0 & 0 \\\\ -5 & 7 & 3 & 0 \\\\ 2 & -2 & 2 & 1 \\\\ 0 & -1 & 0 & 0\\end{aligned}| \\\\  & =-1\\cdot (-1)^{4+2}|\\begin{aligned}4 & 0 & 0 \\\\ -5 & 3 & 0 \\\\ 2 & 2 & 1\\end{aligned}| \\\\  & =-|\\begin{aligned}4 & 0 & 0 \\\\ -5 & 3 & 0 \\\\ 2 & 2 & 1\\end{aligned}|.\\end{aligned}\n$$\n\nThe determinant of a triangular matrix is equal to the product of the entries on the main diagonal. Therefore, we have\n\n$$\n\\begin{aligned}det(M) & =-|\\begin{aligned}4 & 0 & 0 \\\\ -5 & 3 & 0 \\\\ 2 & 2 & 1\\end{aligned}| \\\\  & =-1\\cdot 4\\cdot 3\\cdot 1 \\\\  & =-12\\end{aligned}\n$$\n\nTherefore, the volume is\n\n$$\nV=|det(M)|=|-12|=12.\n$$"}] [{:db/id #edb/ref 17592186275470 :knowledge-point/_questions [{:db/id #edb/ref 17592186119932 :knowledge-point/id #uuid "3118d2af-771f-54c9-b18e-5196b87b6dca" :knowledge-point/title "Computing the Volume of an N-Dimensional Parallelepiped"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1cb8b630-1858-5675-a8ea-afd745123540" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "64" :db/id #edb/ref 17592186272641} {:answer/id #uuid "25136c9e-920f-566e-a408-ea4a7af1ef37" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "352" :db/id #edb/ref 17592186272712} {:answer/id #uuid "28f41079-6423-5124-b7dd-2b748bc5ac50" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "16" :db/id #edb/ref 17592186272753} {:answer/id #uuid "37c41e9d-c90b-5532-80b8-70fb57bf191a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "176" :db/id #edb/ref 17592186272875} {:answer/id #uuid "39e96dc4-16ab-55e3-b742-85d0597e033b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "128" :db/id #edb/ref 17592186272890}] :answer-field/correct {:answer/id #uuid "39e96dc4-16ab-55e3-b742-85d0597e033b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "128" :db/id #edb/ref 17592186272890} :answer-field/id #uuid "2a3f55ee-40e6-566b-9375-89a8f6437390" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186274708}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "94fb05dd-7b6c-5fef-becd-0abc3ccf0dc9" :question/math-academy-id "q-158371" :question/problem "Calculate the volume of the $4$-dimensional parallelepiped spanned by the vectors\n\n$$\na=[\\begin{aligned}0 \\\\ -2 \\\\ 0 \\\\ -3\\end{aligned}],\\,b=[\\begin{aligned}2 \\\\ 7 \\\\ 5 \\\\ 5\\end{aligned}],\\,c=[\\begin{aligned}0 \\\\ 10 \\\\ 0 \\\\ 7\\end{aligned}],\\,d=[\\begin{aligned}0 \\\\ 3 \\\\ 4 \\\\ 2\\end{aligned}].\n$$" :question/worked-solution "First, let's construct the matrix $M,$ whose columns are the coordinates of our vectors $a,$ $b,$ $c,$ and  $d:$\n\n$$\nM=[\\begin{aligned}0 & 2 & 0 & 0 \\\\ -2 & 7 & 10 & 3 \\\\ 0 & 5 & 0 & 4 \\\\ -3 & 5 & 7 & 2\\end{aligned}]\n$$\n\nThe volume of the parallelepiped spanned by these vectors equals the absolute value of the determinant of $M:$\n\n$$\nV=|det(M)|\n$$\n\nNotice that the $1$st row of the determinant contains three zeros. So, using Laplace expansion along the $1$st row, we have\n\n$$\n\\begin{aligned}det(M) & =|\\begin{aligned}0 & 2 & 0 & 0 \\\\ -2 & 7 & 10 & 3 \\\\ 0 & 5 & 0 & 4 \\\\ -3 & 5 & 7 & 2\\end{aligned}| \\\\  & =2\\cdot (-1)^{1+2}|\\begin{aligned}-2 & 10 & 3 \\\\ 0 & 0 & 4 \\\\ -3 & 7 & 2\\end{aligned}| \\\\  & =-2|\\begin{aligned}-2 & 10 & 3 \\\\ 0 & 0 & 4 \\\\ -3 & 7 & 2\\end{aligned}|.\\end{aligned}\n$$\n\nNow, notice that the $2$nd row of the $3\\times 3$ determinant contains two zeros. So, using Laplace expansion along the $2$nd row, we have\n\n$$\n\\begin{aligned}det(M) & =-2|\\begin{aligned}-2 & 10 & 3 \\\\ 0 & 0 & 4 \\\\ -3 & 7 & 2\\end{aligned}| \\\\  & =-2\\cdot 4\\cdot (-1)^{2+3}|\\begin{aligned}-2 & 10 \\\\ -3 & 7\\end{aligned}| \\\\  & =8|\\begin{aligned}-2 & 10 \\\\ -3 & 7\\end{aligned}| \\\\  & =8(-14+30) \\\\  & =128.\\end{aligned}\n$$\n\nTherefore, the volume is\n\n$$\nV=|det(M)|=|128|=128.\n$$"}] [{:db/id #edb/ref 17592186278183 :knowledge-point/_questions [{:db/id #edb/ref 17592186152188 :knowledge-point/id #uuid "6e75170b-1e28-52c1-b0ab-f50ffde6c262" :knowledge-point/title "The Cartesian Equation of an Ellipse"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "044aa764-a402-587b-9d4c-b41637dfa030" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{y}^{2}}{36}-\\frac{{x}^{2}}{4}=1" :db/id #edb/ref 17592186275516} {:answer/id #uuid "8324a325-41e1-54bc-8b74-1c52b4799e1a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{x}^{2}}{4}+\\frac{{y}^{2}}{36}=1" :db/id #edb/ref 17592186276657} {:answer/id #uuid "c4127d31-6dc3-521f-8215-809b40a67775" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{x}^{2}}{6}+\\frac{{y}^{2}}{2}=1" :db/id #edb/ref 17592186277220} {:answer/id #uuid "d2c6cd3a-dd09-5f85-a646-0e12c483a833" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{x}^{2}}{4}-\\frac{{y}^{2}}{36}=1" :db/id #edb/ref 17592186277337} {:answer/id #uuid "e2c3aad5-29e3-5b96-b737-92612b8b8109" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{x}^{2}}{36}+\\frac{{y}^{2}}{4}=1" :db/id #edb/ref 17592186277461}] :answer-field/correct {:answer/id #uuid "e2c3aad5-29e3-5b96-b737-92612b8b8109" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{x}^{2}}{36}+\\frac{{y}^{2}}{4}=1" :db/id #edb/ref 17592186277461} :answer-field/id #uuid "17b8f849-09df-52e8-a517-f7b406de368f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186277767}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "48febb37-71be-5629-b005-ff375ac1902f" :question/math-academy-id "q-15843" :question/problem "Determine the Cartesian equation of the ellipse\n\n$$\nx=6\\operatorname{cos}⁡\\theta ,\\,y=2\\operatorname{sin}⁡\\theta ,\\,0\\le \\theta <2\\pi .\n$$" :question/worked-solution "To find the Cartesian equation of the ellipse, we need to eliminate the parameter $\\theta .$ We can do this using the Pythagorean theorem.\n\nBy isolating the $\\operatorname{cos}⁡\\theta $ term in the $x$-equation and squaring, we get\n\n$$\n\\begin{aligned}x & =6\\operatorname{cos}⁡\\theta  \\\\ \\frac{x}{6} & =\\operatorname{cos}⁡\\theta  \\\\ \\frac{{x}^{2}}{{6}^{2}} & ={cos}^{2}⁡\\theta  \\\\ \\frac{{x}^{2}}{36} & ={cos}^{2}⁡\\theta .\\end{aligned}\n$$\n\nBy isolating the $\\operatorname{sin}⁡\\theta $ term in the $y$-equation and squaring, we get\n\n$$\n\\begin{aligned}y & =2\\operatorname{sin}⁡\\theta  \\\\ \\frac{y}{2} & =\\operatorname{sin}⁡\\theta  \\\\ \\frac{{y}^{2}}{{2}^{2}} & ={sin}^{2}⁡\\theta  \\\\ \\frac{{y}^{2}}{4} & ={sin}^{2}⁡\\theta .\\end{aligned}\n$$\n\n \nAdding the two equations and using ${cos}^{2}⁡\\theta +{sin}^{2}⁡\\theta =1,$ we get\n\n$$\n\\begin{aligned}\\frac{{x}^{2}}{36}+\\frac{{y}^{2}}{4} & ={cos}^{2}⁡\\theta +{sin}^{2}⁡\\theta =1.\\end{aligned}\n$$\n\nSo the Cartesian equation of the ellipse is\n\n$$\n\\frac{{x}^{2}}{36}+\\frac{{y}^{2}}{4}=1.\n$$"}] [{:db/id #edb/ref 17592186106055 :knowledge-point/_questions [{:db/id #edb/ref 17592186105886 :knowledge-point/id #uuid "f59bd7df-afa9-5dcf-9dab-fc7f3cf291fa" :knowledge-point/title "Determining the Value of an Unknown Constant Given a PDF"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "21af3edc-3323-554a-bca0-c25456bef3a1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{2}" :db/id #edb/ref 17592186275782} {:answer/id #uuid "570dae43-0ab0-58ae-84d9-65901a7c41b7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{6}" :db/id #edb/ref 17592186276255} {:answer/id #uuid "900dc292-41a8-5398-9c59-94c9060331f9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{3}" :db/id #edb/ref 17592186276780} {:answer/id #uuid "9fe329c6-b978-58eb-96d6-ef0bb8c82ee6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186276918} {:answer/id #uuid "b3f3da64-a53b-5cfa-890d-f8da21171141" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186277087}] :answer-field/correct {:answer/id #uuid "570dae43-0ab0-58ae-84d9-65901a7c41b7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{6}" :db/id #edb/ref 17592186276255} :answer-field/id #uuid "73f910f0-310b-59fc-93fc-e2425f5aa705" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186277929}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "3535bc96-e0a2-5dcb-9a5f-4a6bf759302b" :question/math-academy-id "q-158437" :question/problem "Solve for $k$ given that the following function is a probability density function:\n\n$$\nf(x)={\\begin{aligned}\\frac{{x}^{2}}{4}+k,\\, & 0<x<2, \\\\ 0,\\, & \\text{otherwise.}\\end{aligned}\n$$" :question/worked-solution "For a function $f(x)$ to be a valid probability density function on a set $S,$ it must satisfy the following conditions:\n\n- $f(x)\\ge 0$ for all $x\\in S$\n\n- ${\\int }_{S}f(x)\\,\\text{d}x=1$\n\nFor the given function, the second condition states that\n\n$$\n{\\int }_{0}^{2}(\\frac{{x}^{2}}{4}+k)\\,\\text{d}x=1.\n$$\n\nComputing the integral on the left-hand side, we get\n\n$$\n\\begin{aligned}{\\int }_{0}^{2}(\\frac{{x}^{2}}{4}+k)\\,\\text{d}x & ={[\\frac{1}{12}{x}^{3}+kx]}_{0}^{2} \\\\  & =[\\frac{8}{12}+2k]-[0+0] \\\\  & =\\frac{2}{3}+2k.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\frac{2}{3}+2k=1\\,⟹\\,k=\\frac{1}{6}.\n$$"}] [{:db/id #edb/ref 17592186369859 :knowledge-point/_questions [{:db/id #edb/ref 17592186105886 :knowledge-point/id #uuid "f59bd7df-afa9-5dcf-9dab-fc7f3cf291fa" :knowledge-point/title "Determining the Value of an Unknown Constant Given a PDF"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5fa62dd2-b0c7-5d84-9d22-decbfe7c3d62" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186369861} {:answer/id #uuid "9a2809d5-b0a6-5909-8b19-67d21b2cf85d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186369862} {:answer/id #uuid "5acf1a1f-a6ef-514f-8acc-ff08cda8690f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186369863} {:answer/id #uuid "a4fd4552-6bd6-501b-be53-4c059be4aaf1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186369864} {:answer/id #uuid "9ea75817-ef2f-5f2f-9943-1818c631b13b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186369865}] :answer-field/correct {:answer/id #uuid "9ea75817-ef2f-5f2f-9943-1818c631b13b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186369865} :answer-field/id #uuid "527d4c6b-012b-5461-8a47-41cb9dad1d47" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186369860}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "4be0ea46-3e0b-59c9-8186-85d4514aa6ab" :question/math-academy-id "q-158440" :question/problem "Solve for $k$ given that the following function is a probability density function:\n\n$$\nf(x)={\\begin{aligned}\\frac{{x}^{3}}{k},\\, & 0\\le x<2, \\\\ 0,\\, & \\text{otherwise.}\\end{aligned}\n$$" :question/worked-solution "For a function $f(x)$ to be a valid probability density function on a set $S,$ it must satisfy the following conditions:\n\n- $f(x)\\ge 0$ for all $x\\in S$\n\n- ${\\int }_{S}f(x)\\,\\text{d}x=1$\n\nFor the given function, the second condition states that\n\n$$\n{\\int }_{0}^{2}\\frac{{x}^{3}}{k}\\,\\text{d}x=1.\n$$\n\nComputing the integral on the left-hand side, we get\n\n$$\n\\begin{aligned}{\\int }_{0}^{2}\\frac{{x}^{3}}{k}\\,\\text{d}x & ={[\\frac{{x}^{4}}{4k}]}_{0}^{2} \\\\  & =(\\frac{16}{4k}-0) \\\\  & =\\frac{4}{k}.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\frac{4}{k}=1\\,⟹\\,k=4.\n$$"}] [{:db/id #edb/ref 17592186278191 :knowledge-point/_questions [{:db/id #edb/ref 17592186105886 :knowledge-point/id #uuid "f59bd7df-afa9-5dcf-9dab-fc7f3cf291fa" :knowledge-point/title "Determining the Value of an Unknown Constant Given a PDF"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0d46a99b-9aed-5723-ae0f-4c64551e3f94" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186275588} {:answer/id #uuid "47db744f-f0b3-5760-896a-049544b6375a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186276112} {:answer/id #uuid "7a49c651-4a95-5c0c-b6a3-3b8cdc26b296" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "24" :db/id #edb/ref 17592186276587} {:answer/id #uuid "8415d956-a817-53c4-8f60-93416a12acc9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186276662} {:answer/id #uuid "9f3492e5-9010-5a95-8437-b5d792b01884" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "12" :db/id #edb/ref 17592186276909}] :answer-field/correct {:answer/id #uuid "7a49c651-4a95-5c0c-b6a3-3b8cdc26b296" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "24" :db/id #edb/ref 17592186276587} :answer-field/id #uuid "86517bcb-97bd-5ba9-8706-7572bc681126" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186277964}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "c1741b28-dd7a-521f-bff9-3881fb7d5bb4" :question/math-academy-id "q-158447" :question/problem "Solve for $k$ given that the following function is a probability density function:\n\n$$\nf(x)={\\begin{aligned}\\frac{{x}^{2}+1}{k},\\, & 1<x<4, \\\\ 0,\\, & \\text{otherwise.}\\end{aligned}\n$$" :question/worked-solution "For a function $f(x)$ to be a valid probability density function on a set $S,$ it must satisfy the following conditions:\n\n- $f(x)\\ge 0$ for all $x\\in S$\n\n- ${\\int }_{S}f(x)\\,\\text{d}x=1$\n\nFor the given function, the second condition states that\n\n$$\n{\\int }_{1}^{4}\\frac{{x}^{2}+1}{k}\\,\\text{d}x=1.\n$$\n\nComputing the integral on the left-hand side, we get\n\n$$\n\\begin{aligned}{\\int }_{1}^{4}\\frac{{x}^{2}+1}{k}\\,\\text{d}x & =\\frac{1}{k}{\\int }_{1}^{4}({x}^{2}+1)\\,\\text{d}x \\\\  & =\\frac{1}{k}{[\\frac{{x}^{3}}{3}+x]}_{1}^{4} \\\\  & =\\frac{1}{k}([\\frac{64}{3}+4]-[\\frac{1}{3}+1]) \\\\  & =\\frac{1}{k}(21+3) \\\\  & =\\frac{24}{k}.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\frac{24}{k}=1\\,⟹\\,k=24.\n$$"}] [{:db/id #edb/ref 17592186278255 :knowledge-point/_questions [{:db/id #edb/ref 17592186087846 :knowledge-point/id #uuid "37a4168b-1425-5f3a-a577-4b5884906a52" :knowledge-point/title "Calculating the Sum of a Complex Number and Its Conjugate"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3d79f35b-9c6f-5ea0-bc36-b70cf365f94b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-8\\text{i}" :db/id #edb/ref 17592186276011} {:answer/id #uuid "7f0ddcf9-5550-54e5-b71a-85b4e14d8483" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-8" :db/id #edb/ref 17592186276631} {:answer/id #uuid "93cec608-e557-5ec2-a838-72d1783b34ce" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-10" :db/id #edb/ref 17592186276815} {:answer/id #uuid "9dd9f428-0306-5272-8687-ba40f9700e5e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-18\\text{i}" :db/id #edb/ref 17592186276894} {:answer/id #uuid "ccc78b51-a3ef-5a56-85ea-de62572a4123" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-18" :db/id #edb/ref 17592186277297}] :answer-field/correct {:answer/id #uuid "ccc78b51-a3ef-5a56-85ea-de62572a4123" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-18" :db/id #edb/ref 17592186277297} :answer-field/id #uuid "227bfbb7-c8a5-52a9-9c16-7187fd6462d0" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186277784}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "2e339dfa-5444-5946-8701-7661eae41839" :question/math-academy-id "q-159757" :question/problem "If $z=-9-\\text{i}$, calculate $z+\\overset{―}{z}.$" :question/worked-solution "**Method 1**\n\nWhen we add a complex number and its conjugate, the result is always twice the real part of the complex number.\n\nFor the given complex number $z=-9-\\text{i},$ the real part is $Re(z)=-9,$ so we have\n\n$$\n\\begin{aligned}z+\\overset{―}{z} & =2\\text{Re}(z) \\\\  & =2(-9) \\\\  & =-18.\\end{aligned}\n$$\n\n**Method 2**\n\nAlternatively, we can actually carry out the process of adding the complex number and its conjugate.\n\nTo obtain the conjugate of the complex number $z=-9-\\text{i},$ we flip the sign of the imaginary part and get $\\overset{―}{z}=-9+\\text{i}.$\n\nAdding, we get\n\n$$\n\\begin{aligned}z+\\overset{―}{z} & =(-9-\\text{i})+(-9+\\text{i}) \\\\  & =(-9+(-9))+\\text{i}(-1+1) \\\\  & =-18+\\text{i}\\cdot 0 \\\\  & =-18.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186278256 :knowledge-point/_questions [{:db/id #edb/ref 17592186087847 :knowledge-point/id #uuid "64cd3ef1-6d41-50c6-b09d-cb709d89281f" :knowledge-point/title "Calculating the Product of a Complex Number and Its Conjugate"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4ad4c242-5100-5001-bbf2-14af7ad8a88e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "90" :db/id #edb/ref 17592186276136} {:answer/id #uuid "67bacfa4-b2c2-5dbf-ad5b-83815a9bf78a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "81" :db/id #edb/ref 17592186276405} {:answer/id #uuid "68f08005-6fd5-5cb7-985f-df65b93a27a3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "12" :db/id #edb/ref 17592186276421} {:answer/id #uuid "9755f0c3-83bf-5c35-8244-3f96fda89a5d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "12\\text{i}" :db/id #edb/ref 17592186276837} {:answer/id #uuid "eb1e92ef-5e38-51fa-88c2-36429f6dcafd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "18\\text{i}" :db/id #edb/ref 17592186277531}] :answer-field/correct {:answer/id #uuid "4ad4c242-5100-5001-bbf2-14af7ad8a88e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "90" :db/id #edb/ref 17592186276136} :answer-field/id #uuid "02caf819-53ad-50d7-90fb-0558ee92f886" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186277729}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "ba737df7-5524-50ff-9af1-1507a3bfabf5" :question/math-academy-id "q-159758" :question/problem "Given that $z=9+3\\text{i},$ calculate $z\\overset{―}{z}.$" :question/worked-solution "**Method 1**\n\nWhen we multiply a complex number and its conjugate, the result is always the sum of squares of the real part and the imaginary part.\n\nFor the given complex number $z=9+3\\text{i},$ the real part is $\\text{Re}(z)=9,$ and the imaginary part is $\\text{Im}(z)=3,$ so we have\n\n$$\n\\begin{aligned}z\\overset{―}{z} & =(\\text{Re}(z))^{2}+(\\text{Im}(z))^{2} \\\\  & ={9}^{2}+{3}^{2} \\\\  & =81+9 \\\\  & =90.\\end{aligned}\n$$\n\n**Method 2**\n\nAlternatively, we can actually carry out the process of multiplying the complex number and its conjugate.\n\nTo obtain the conjugate of the complex number $z=9+3\\text{i},$ we flip the sign of the imaginary part and get $\\overset{―}{z}=9-3\\text{i}.$\n\nMultiplying, we get\n\n$$\n\\begin{aligned}z\\overset{―}{z} & =(9+3\\text{i})(9-3\\text{i}) \\\\  & ={9}^{2}+(9)(3)\\text{i}+(-3)(9)\\text{i}-{\\text{i}}^{2}(3)^{2} \\\\  & =81+27\\text{i}-27\\text{i}-(-1)(9) \\\\  & =81+9 \\\\  & =90.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186278262 :knowledge-point/_questions [{:db/id #edb/ref 17592186087750 :knowledge-point/id #uuid "7c9849b9-397b-5fb9-bb4b-01f3d013c5c2" :knowledge-point/title "Computing the Image of a Polygon Under the Action of a Linear Transformation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2938b900-5a10-5191-b4e3-0c2006782d08" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/02/02b7a778b46085876e5269e0b088dde52293d5230cd0312459ec21c8b2600f71.png" :db/id #edb/ref 17592186275849} {:answer/id #uuid "8db7805c-42d8-5800-a53d-d307b137bae7" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/98/98150e2e7b7cb55643f588b885c3f57a34da186834dcbebd2cb7b35151317519.png" :db/id #edb/ref 17592186276763} {:answer/id #uuid "ac27feea-e70f-5759-9b05-555bf6691eda" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/54/5485aedcf92aca355118c8bd051f16a1436d5f955a0dde65c85eaa0398eb03b8.png" :db/id #edb/ref 17592186277025} {:answer/id #uuid "b3c5df52-e9e1-5791-b57d-7d0c965e423e" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/77/77829a2aeb4fd7209a5ab5abfe2f84ab2225fc37f1a84fd25a4883647cff5fe1.png" :db/id #edb/ref 17592186277085} {:answer/id #uuid "b4dd1b77-bf7b-5095-a2d8-db7122088c6f" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/4c/4c43c4c793924d4fde32b59c93b7a19be0109a389b126665868396b4c06d721e.png" :db/id #edb/ref 17592186277091}] :answer-field/correct {:answer/id #uuid "b4dd1b77-bf7b-5095-a2d8-db7122088c6f" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/4c/4c43c4c793924d4fde32b59c93b7a19be0109a389b126665868396b4c06d721e.png" :db/id #edb/ref 17592186277091} :answer-field/id #uuid "9d6eb348-74a0-5d55-93c9-930e4913eaa7" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186278005}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "1333855f-29ce-5600-8e32-dc2d38172ec9" :question/math-academy-id "q-159801" :question/problem "![](images/d9/d9ec98b03009d1023668aa12de88ed5515f0ea6df058d1b5d17804bf42082c5c.png)\n\nConsider the linear transformation $T$ with matrix representation $T,$ given by\n\n$$\nT=[\\begin{aligned}1 & 2 \\\\ 2 & 0\\end{aligned}].\n$$\n\nThe triangle $△ABC$ is shown above. Which of the following is $△{A}^{′}{B}^{′}{C}^{′},$ the image of $△ABC$ under the action of $T?$" :question/worked-solution "To find the image of $T$ under the action of $T$, we first create a matrix $X$ containing all of the vertices of $△ABC:$\n\n$$\nX=[\\begin{aligned}2 & -3 & 1 \\\\ 2 & 2 & -2\\end{aligned}]\n$$\n\nNow, we compute the image of $X$ under the action of $T$ by calculating the matrix product $TX:$\n\n$$\n\\begin{aligned}TX & =[\\begin{aligned}1 & 2 \\\\ 2 & 0\\end{aligned}][\\begin{aligned}2 & -3 & 1 \\\\ 2 & 2 & -2\\end{aligned}] \\\\  & =[\\begin{aligned}6 & 1 & -3 \\\\ 4 & -6 & 2\\end{aligned}].\\end{aligned}\n$$\n\nTherefore, the coordinates of the respective vertices of $△{A}^{′}{B}^{′}{C}^{′}$ are $(6,4),(1,-6),(-3,2)$, as shown below.\n\n![](images/4c/4c43c4c793924d4fde32b59c93b7a19be0109a389b126665868396b4c06d721e.png)"}] [{:db/id #edb/ref 17592186389016 :knowledge-point/_questions [{:db/id #edb/ref 17592186092225 :knowledge-point/id #uuid "d4daa6bc-1c9a-5c23-8032-4d70435d9388" :knowledge-point/title "Calculating a Vector Given Its Image Under a Linear Transformation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e6e33f13-bf32-57fc-9e33-1c3365d2b549" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}8 \\\\ -2\\end{aligned}]" :db/id #edb/ref 17592186389018} {:answer/id #uuid "45edddc3-4ab5-5f20-b063-71b14cfab775" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}8 \\\\ 4\\end{aligned}]" :db/id #edb/ref 17592186389019} {:answer/id #uuid "a609d06b-6fba-58d1-ac0c-77b3c30ee67f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}-2 \\\\ 4\\end{aligned}]" :db/id #edb/ref 17592186389020} {:answer/id #uuid "27df9d1e-2610-5e00-b40d-bca3d5157238" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}-4 \\\\ 8\\end{aligned}]" :db/id #edb/ref 17592186389021} {:answer/id #uuid "428468dc-0f82-5095-b6bf-387fc8aa1e4c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}4 \\\\ 8\\end{aligned}]" :db/id #edb/ref 17592186389022}] :answer-field/correct {:answer/id #uuid "428468dc-0f82-5095-b6bf-387fc8aa1e4c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}4 \\\\ 8\\end{aligned}]" :db/id #edb/ref 17592186389022} :answer-field/id #uuid "991862b1-972b-5127-a2c8-a89e2bc72fa1" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186389017}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "ede69c8f-2758-5c85-a62b-6b678eca588f" :question/math-academy-id "q-159976" :question/problem "The vector $v$ in the plane is mapped to the vector $[\\begin{aligned}4 \\\\ 0\\end{aligned}]$ under the action of the linear transformation $T$ whose matrix $T$ is given by\n\n$$\nT=[\\begin{aligned}3 & -1 \\\\ 4 & -2\\end{aligned}].\n$$\n\nWhat is the original vector $v?$" :question/worked-solution "From the given information, we have \n\n$$\nT\\cdot v=[\\begin{aligned}4 \\\\ 0\\end{aligned}].\n$$\n\nWe need to reverse the action of the matrix $T.$ So, we multiply the above equation by ${T}^{-1},$ and we get\n\n$$\n\\begin{aligned}{T}^{-1}\\cdot T\\cdot v & ={T}^{-1}\\cdot [\\begin{aligned}4 \\\\ 0\\end{aligned}] \\\\ v & ={T}^{-1}\\cdot [\\begin{aligned}4 \\\\ 0\\end{aligned}].\\end{aligned}\n$$\n\nNow, we need to calculate the inverse of $T$, which is\n\n$$\n\\begin{aligned}{T}^{-1} & =\\frac{1}{-6-(-4)}[\\begin{aligned}-2 & 1 \\\\ -4 & 3\\end{aligned}] \\\\  & =\\frac{1}{-2}[\\begin{aligned}-2 & 1 \\\\ -4 & 3\\end{aligned}] \\\\  & =\\frac{1}{2}[\\begin{aligned}2 & -1 \\\\ 4 & -3\\end{aligned}].\\end{aligned}\n$$\n\nTherefore, the original vector is\n\n$$\n\\begin{aligned}v & ={T}^{-1}\\cdot [\\begin{aligned}4 \\\\ 0\\end{aligned}] \\\\  & =\\frac{1}{2}[\\begin{aligned}2 & -1 \\\\ 4 & -3\\end{aligned}][\\begin{aligned}4 \\\\ 0\\end{aligned}] \\\\  & =[\\begin{aligned}4 \\\\ 8\\end{aligned}].\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186278269 :knowledge-point/_questions [{:db/id #edb/ref 17592186115286 :knowledge-point/id #uuid "0236acfd-59d1-5bc8-9e60-1c76ddc536f5" :knowledge-point/title "Finding a Quadratic Equation Given a Complex Root and Its Leading Coefficient"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "262c67b0-9dc3-5bb9-b23e-c4843109b272" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2{x}^{2}+8x+7=0" :db/id #edb/ref 17592186275823} {:answer/id #uuid "36536e52-de9d-5a68-88f6-2b843d2e1785" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2{x}^{2}-8x+14=0" :db/id #edb/ref 17592186275961} {:answer/id #uuid "960f5340-28b7-5541-85b8-e2062d1ddc56" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2{x}^{2}-4x+7=0" :db/id #edb/ref 17592186276827} {:answer/id #uuid "b1006f97-c825-512d-9ba5-921bfa86cefa" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2{x}^{2}-16x-14=0" :db/id #edb/ref 17592186277060} {:answer/id #uuid "c7ed3c1e-e5be-511c-9f4e-523ee7d6271f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2{x}^{2}+16x+14=0" :db/id #edb/ref 17592186277252}] :answer-field/correct {:answer/id #uuid "36536e52-de9d-5a68-88f6-2b843d2e1785" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2{x}^{2}-8x+14=0" :db/id #edb/ref 17592186275961} :answer-field/id #uuid "50d21184-0537-5f99-9ad1-5d14ed806095" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186277862}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "f58c3018-1078-5b3f-8bb8-2a1e7347605d" :question/math-academy-id "q-160008" :question/problem "A quadratic equation in the variable $x$ with real coefficients has a root $x=2+\\sqrt{3}\\text{i}.$ Given that the coefficient of ${x}^{2}$ in the equation is $2$, find the equation." :question/worked-solution "Since the quadratic equation has real coefficients and $x=2+\\sqrt{3}\\text{i}$ is a root, its conjugate $x=2-\\sqrt{3}\\text{i}$ must also be a root. Therefore, using the zero product property, we can write a quadratic equation with the required roots as follows:\n\n$$\n(x-(2+\\sqrt{3}\\text{i}))(x-(2-\\sqrt{3}\\text{i}))=0\n$$\n\nBy expanding the parentheses, we can write the equation in standard form as follows:\n\n$$\n\\begin{aligned}{x}^{2}-x(2-\\sqrt{3}\\text{i})-x(2+\\sqrt{3}\\text{i})+(2+\\sqrt{3}\\text{i})(2-\\sqrt{3}\\text{i}) & =0 \\\\ {x}^{2}-2x+\\sqrt{3}x\\text{i}-2x-\\sqrt{3}x\\text{i}+4-(\\sqrt{3}\\text{i})^{2} & =0 \\\\ {x}^{2}-4x+4+3 & =0 \\\\ {x}^{2}-4x+7 & =0\\end{aligned}\n$$\n\nThis equation has roots $x=2\\pm \\sqrt{3}\\text{i},$ but the coefficient of ${x}^{2}$ is not $2.$ Therefore, to find the desired equation, we multiply the equation above by $2.$ This gives\n\n$$\n\\begin{aligned}2({x}^{2}-4x+7) & =0 \\\\ 2{x}^{2}-8x+14 & =0.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186401151 :knowledge-point/_questions [{:db/id #edb/ref 17592186059799 :knowledge-point/id #uuid "1fe5d8aa-8a79-5de4-8566-1432a640d78f" :knowledge-point/title "Equating Real and Imaginary Parts of a Complex Number to Solve For an Unknown Quantity"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9b234a49-b204-5ed4-bfaa-41d6080ef1a7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "a=\\frac{3}{4},b=\\frac{\\sqrt{3}}{4}" :db/id #edb/ref 17592186401153} {:answer/id #uuid "ee6d77b0-4258-5c91-8afc-7ef838e14fcc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "a=\\sqrt{3},b=-\\frac{3}{4}" :db/id #edb/ref 17592186401154} {:answer/id #uuid "d2159356-f202-541b-9892-eebd1e60d1be" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "a=\\frac{3}{4},b=-\\sqrt{3}" :db/id #edb/ref 17592186401155} {:answer/id #uuid "d6145a7d-35ad-5386-85f1-fee66f6da6b7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "a=\\sqrt{3},b=\\frac{3}{4}" :db/id #edb/ref 17592186401156} {:answer/id #uuid "5360b829-a541-532f-8d6c-81155ed6dcd3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "a=\\frac{3}{4},b=\\sqrt{3}" :db/id #edb/ref 17592186401157}] :answer-field/correct {:answer/id #uuid "5360b829-a541-532f-8d6c-81155ed6dcd3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "a=\\frac{3}{4},b=\\sqrt{3}" :db/id #edb/ref 17592186401157} :answer-field/id #uuid "76c64cb5-e76d-53eb-a0e8-6195df2d94ac" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186401152}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "78111624-f670-5df8-b6e2-bb5a5dde19ff" :question/math-academy-id "q-160013" :question/problem "Given that $\\frac{3}{4}+\\sqrt{3}\\text{i}=a+b\\text{i}$, calculate the value of $a$ and the value of $b.$" :question/worked-solution "First, we equate the real parts:\n\n$$\n\\begin{aligned}\\frac{3}{4} & =a\\end{aligned}\n$$\n\nThen, we equate the imaginary parts:\n\n$$\n\\begin{aligned}\\sqrt{3} & =b\\end{aligned}\n$$\n\nTherefore, $a=\\frac{3}{4}$ and $b=\\sqrt{3}.$"}] [{:db/id #edb/ref 17592186278271 :knowledge-point/_questions [{:db/id #edb/ref 17592186115305 :knowledge-point/id #uuid "b346e7e1-b641-5a97-9677-84a0ff6ab2dc" :knowledge-point/title "Finding Missing Values in a Data Set Given the Mean"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1ed36547-96e7-5784-9a0e-cef5f230e794" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "12" :db/id #edb/ref 17592186275755} {:answer/id #uuid "60b2eba2-e4ea-55fb-b0a5-7949921702ae" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "15" :db/id #edb/ref 17592186276344} {:answer/id #uuid "90863935-708d-5d8a-9767-701612197aa6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "14" :db/id #edb/ref 17592186276786} {:answer/id #uuid "a7774b83-c8c2-533c-9b91-ea243dc329ac" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "16" :db/id #edb/ref 17592186276988} {:answer/id #uuid "b652cf44-f298-51b1-9814-ea015f204d32" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "10" :db/id #edb/ref 17592186277099}] :answer-field/correct {:answer/id #uuid "a7774b83-c8c2-533c-9b91-ea243dc329ac" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "16" :db/id #edb/ref 17592186276988} :answer-field/id #uuid "bba5517c-87f3-5296-8e79-3699c931499e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186278056}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "88fbb37a-350b-51de-9b64-f5ff2acb9c93" :question/math-academy-id "q-160026" :question/problem "Given that the mean of the following data set is $10,$ find the value of $b:$ \n\n$$\nb,\\,1,\\,b,\\,1,\\,b\n$$" :question/worked-solution "If we have a data set that consists of the points ${x}_{1},{x}_{2},…,{x}_{n},$ then the mean is denoted by $\\overset{―}{x}$ and is given by the following formula:\n\n$$\n\\overset{―}{x}=\\frac{1}{n}{\\sum }_{i=1}^{n}{x}_{i}\n$$\n\nHere, there are $n=5$ data points. Adding up all the points in the data set, we get\n\n$$\n\\begin{aligned}{\\sum }_{i=1}^{5}{x}_{i} & =b+1+b+1+b \\\\  & =2+3b.\\end{aligned}\n$$\n\nTherefore, the mean is given by the expression\n\n$$\n\\begin{aligned}\\overset{―}{x} & =\\frac{1}{n}{\\sum }_{i=1}^{n}{x}_{i} \\\\  & =\\frac{1}{5}\\cdot (2+3b) \\\\  & =\\frac{2+3b}{5}.\\end{aligned}\n$$\n\nFinally, since we're told that $\\overset{―}{x}=10,$ we have\n\n$$\n\\begin{aligned}10 & =\\frac{2+3b}{5} \\\\ 50 & =2+3b \\\\ 48 & =3b \\\\ b & =16.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186278272 :knowledge-point/_questions [{:db/id #edb/ref 17592186115305 :knowledge-point/id #uuid "b346e7e1-b641-5a97-9677-84a0ff6ab2dc" :knowledge-point/title "Finding Missing Values in a Data Set Given the Mean"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2b5e32c7-6b89-5822-855f-1dfb6a5a9745" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "18" :db/id #edb/ref 17592186275870} {:answer/id #uuid "2d86a5a3-7293-5268-b8e4-2c73a0117d10" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "13" :db/id #edb/ref 17592186275888} {:answer/id #uuid "4248bdf2-7c80-5f67-8d39-490fc7fd9035" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "10" :db/id #edb/ref 17592186276057} {:answer/id #uuid "6a4c24fa-3a89-5653-8566-bcbe05f0a9ba" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "12" :db/id #edb/ref 17592186276432} {:answer/id #uuid "ff2ae68b-d06f-52a1-8b62-ccf349b47446" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "15" :db/id #edb/ref 17592186277719}] :answer-field/correct {:answer/id #uuid "ff2ae68b-d06f-52a1-8b62-ccf349b47446" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "15" :db/id #edb/ref 17592186277719} :answer-field/id #uuid "fe8dea39-9fe7-5d93-8b7f-3596ae2988dd" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186278175}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "2ae95412-5543-5cd6-a29d-d4219b71ef9a" :question/math-academy-id "q-160028" :question/problem "Given that the mean of the following data set is $11,$ find the value of $c:$ \n\n$$\n(c-3),\\,6,\\,3,\\,c,\\,10,\\,20\n$$" :question/worked-solution "If we have a data set that consists of the points ${x}_{1},{x}_{2},…,{x}_{n},$ then the mean is denoted by $\\overset{―}{x}$ and is given by the following formula:\n\n$$\n\\overset{―}{x}=\\frac{1}{n}{\\sum }_{i=1}^{n}{x}_{i}\n$$\n\nHere, there are $n=6$ data points. Adding up all the points in the data set, we get\n\n$$\n\\begin{aligned}{\\sum }_{i=1}^{6}{x}_{i} & =(c-3)+6+3+c+10+20 \\\\  & =36+2c\\end{aligned}\n$$\n\nTherefore, the mean is given by the expression\n\n$$\n\\begin{aligned}\\overset{―}{x} & =\\frac{1}{n}{\\sum }_{i=1}^{n}{x}_{i} \\\\  & =\\frac{1}{6}\\cdot (36+2c) \\\\  & =\\frac{36+2c}{6}.\\end{aligned}\n$$\n\nFinally, since we're told that $\\overset{―}{x}=11,$ we have\n\n$$\n\\begin{aligned}11 & =\\frac{36+2c}{6} \\\\ 66 & =36+2c \\\\ 30 & =2c \\\\ c & =15.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186401158 :knowledge-point/_questions [{:db/id #edb/ref 17592186059801 :knowledge-point/id #uuid "1bbe2fe7-b69c-54f3-9f1c-3369e3f1395d" :knowledge-point/title "Solving for Unknowns By Computing a Product and Equating Real and Imaginary Parts"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "71361279-b548-5a5f-a16d-dcbf0424a5e1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$p=2$, $q=3$" :db/id #edb/ref 17592186401160} {:answer/id #uuid "76723f95-9757-537d-ba64-6f70bb2a0084" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$p=8$, $q=2$" :db/id #edb/ref 17592186401161} {:answer/id #uuid "2783fb88-e21b-5c34-a806-1f0e4be8a043" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$p=-4$, $q=2$" :db/id #edb/ref 17592186401162} {:answer/id #uuid "f9389cd2-410b-5bd7-bb2d-afd430456c2a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$p=-3$, $q=2$" :db/id #edb/ref 17592186401163} {:answer/id #uuid "6176aa1c-2946-59f3-b638-214d03147fc2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$p=2$, $q=1$" :db/id #edb/ref 17592186401164}] :answer-field/correct {:answer/id #uuid "76723f95-9757-537d-ba64-6f70bb2a0084" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$p=8$, $q=2$" :db/id #edb/ref 17592186401161} :answer-field/id #uuid "e20e0aba-a96a-54f7-bcde-ebba07a66ed9" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186401159}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "2bd6d81b-eb1e-5f54-9fb0-b04584c1dccf" :question/math-academy-id "q-160037" :question/problem "Given that $3+5\\text{i}=\\frac{p+\\text{i}q}{1-\\text{i}},$ calculate $p$ and $q.$" :question/worked-solution "First, we multiply both sides of the equation by $1-\\text{i}$ to get rid of the fraction and isolate the variables:\n\n$$\n\\begin{aligned}3+5\\text{i} & =\\frac{p+\\text{i}q}{1-\\text{i}} \\\\ (3+5\\text{i})(1-\\text{i}) & =p+\\text{i}q \\\\ 3-3\\text{i}+5\\text{i}-5{\\text{i}}^{2} & =p+\\text{i}q \\\\ 3+5+2\\text{i} & =p+\\text{i}q \\\\ 8+2\\text{i} & =p+\\text{i}q\\end{aligned}\n$$\n\nNow, we can equate the real parts and the imaginary parts separately.\n\n- Equating the real parts, we get\n\n$$\n8=p.\n$$\n\n- Equating the imaginary parts, we get\n\n$$\n\\begin{aligned}2 & =q.\\end{aligned}\n$$\n\nTherefore, $p=8$ and $q=2.$"}] [{:db/id #edb/ref 17592186401165 :knowledge-point/_questions [{:db/id #edb/ref 17592186059802 :knowledge-point/id #uuid "c9f40a0e-83f3-5814-b9a1-8b1265fe93cc" :knowledge-point/title "Solving for Unknowns By Computing a Quotient and Equating Real and Imaginary Parts"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f1d54338-26b9-548b-83c0-2a886b9ea3a6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "p=-\\frac{3}{2},q=\\frac{3}{5}" :db/id #edb/ref 17592186401167} {:answer/id #uuid "3d44482d-1c30-5ad6-854c-691cae820272" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "p=\\frac{3}{2},q=-\\frac{3}{5}" :db/id #edb/ref 17592186401168} {:answer/id #uuid "1b7850c0-574e-58be-a128-8a2349e114cc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "p=\\frac{3}{5},q=-\\frac{3}{2}" :db/id #edb/ref 17592186401169} {:answer/id #uuid "e5144ebf-c2b3-5349-b8ce-5873d55100c7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "p=\\frac{2}{5},q=-\\frac{1}{2}" :db/id #edb/ref 17592186401170} {:answer/id #uuid "930309ca-50d5-5254-aa8c-b2c15baae0ec" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "p=\\frac{3}{2},q=-\\frac{1}{2}" :db/id #edb/ref 17592186401171}] :answer-field/correct {:answer/id #uuid "930309ca-50d5-5254-aa8c-b2c15baae0ec" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "p=\\frac{3}{2},q=-\\frac{1}{2}" :db/id #edb/ref 17592186401171} :answer-field/id #uuid "56ae83c2-5ded-53be-a27e-61769cd01afe" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186401166}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "050685d3-106a-556e-94cf-f2ab6b33d435" :question/math-academy-id "q-160049" :question/problem "Given that $5=(p+q\\text{i})(3+\\text{i})$, calculate $p$ and $q.$" :question/worked-solution "First, we divide both sides of the equation by $3+\\text{i}$ to isolate the variables:\n\n$$\n\\begin{aligned}5 & =(p+q\\text{i})(3+\\text{i}) \\\\ \\frac{5}{3+\\text{i}} & =p+q\\text{i}\\end{aligned}\n$$\n\nNow, to simplify the fraction on the left-hand side, we multiply the numerator and denominator by the conjugate of the denominator:\n\n$$\n\\begin{aligned}\\frac{(5)(3-\\text{i})}{(3+\\text{i})(3-\\text{i})} & =p+q\\text{i} \\\\ \\frac{15-5\\text{i}}{{3}^{2}-(\\text{i})^{2}} & =p+q\\text{i} \\\\ \\frac{15-5\\text{i}}{9+1} & =p+q\\text{i} \\\\ \\frac{15-5\\text{i}}{10} & =p+q\\text{i} \\\\ \\frac{3}{2}-\\frac{1}{2}\\text{i} & =p+q\\text{i}\\end{aligned}\n$$\n\nNow, we can equate the real parts and the imaginary parts separately.\n\n- Equating the real parts, we get $\\frac{3}{2}=p.$\n\n- Equating the imaginary parts, we get $-\\frac{1}{2}=q.$\n\nTherefore, $p=\\frac{3}{2}$ and $q=-\\frac{1}{2}.$"}] [{:db/id #edb/ref 17592186278276 :knowledge-point/_questions [{:db/id #edb/ref 17592186115304 :knowledge-point/id #uuid "adfc527d-4347-5741-a81c-fa91c50d5d74" :knowledge-point/title "Computing the Mean of a Data Set"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5be0bc62-d602-5b32-8a2e-36d125dbe0bf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "12" :db/id #edb/ref 17592186276301} {:answer/id #uuid "c0a1d8a5-8c5d-5e57-a888-62ddebfefa97" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "10" :db/id #edb/ref 17592186277188} {:answer/id #uuid "e71d3129-f92a-5c5b-837b-240366c795c7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "9.5" :db/id #edb/ref 17592186277496} {:answer/id #uuid "faed2406-8996-50c6-b0ef-9ef87571e4b2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "11.5" :db/id #edb/ref 17592186277675} {:answer/id #uuid "fcb5e3e3-e49d-5444-9e56-c411ae1a8e1a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "11" :db/id #edb/ref 17592186277691}] :answer-field/correct {:answer/id #uuid "c0a1d8a5-8c5d-5e57-a888-62ddebfefa97" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "10" :db/id #edb/ref 17592186277188} :answer-field/id #uuid "ad91c49c-4a4d-571c-acb9-c533b9863422" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186278024}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "b4975910-186b-51eb-8386-78fc12db0a69" :question/math-academy-id "q-160052" :question/problem "A college basketball player scored the following number of points in the last five games he played:\n\n$$\n9,\\,11,\\,12,\\,8,\\,10\n$$\n\nWhat is the mean of these scores?" :question/worked-solution "If we have a data set that consists of the points ${x}_{1},{x}_{2},…,{x}_{n},$ then the mean is denoted by $\\overset{―}{x}$ and is given by the following formula:\n\n$$\n\\overset{―}{x}=\\frac{1}{n}{\\sum }_{i=1}^{n}{x}_{i}\n$$\n\nHere, there are $n=5$ data points. Adding up all the points in the data set, we get\n\n$$\n\\begin{aligned}{\\sum }_{i=1}^{5}{x}_{i} & =9+11+12+8+10 \\\\  & =50.\\end{aligned}\n$$\n\nTherefore, the mean is\n\n$$\n\\begin{aligned}\\overset{―}{x} & =\\frac{1}{n}{\\sum }_{i=1}^{n}{x}_{i} \\\\  & =\\frac{1}{5}\\cdot 50 \\\\  & =10.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186278277 :knowledge-point/_questions [{:db/id #edb/ref 17592186115304 :knowledge-point/id #uuid "adfc527d-4347-5741-a81c-fa91c50d5d74" :knowledge-point/title "Computing the Mean of a Data Set"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0e67b2a5-0f28-5b12-888c-9ffba56fdcc9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186275597} {:answer/id #uuid "53c635b2-f846-551d-b578-e72691826950" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186276220} {:answer/id #uuid "67146a85-6286-573e-a37d-2c1c8f8de67c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5.5" :db/id #edb/ref 17592186276398} {:answer/id #uuid "c72cf84a-4573-550f-a9d6-4a4ad1b52ddf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186277247} {:answer/id #uuid "e5554f5b-a5a2-59e4-88ec-a1c9997632f1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6.8" :db/id #edb/ref 17592186277480}] :answer-field/correct {:answer/id #uuid "53c635b2-f846-551d-b578-e72691826950" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186276220} :answer-field/id #uuid "23112a7c-974e-57c0-ab45-efd0be8b2843" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186277785}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "ac9d78d0-acf8-5125-b9f8-810932b0249e" :question/math-academy-id "q-160054" :question/problem "A car salesman has sold the following quantities of a particular model of car in the last few weeks:\n\n$$\n3,\\,5,\\,6,\\,8,\\,5,\\,3\n$$\n\nWhat is the mean of these figures?" :question/worked-solution "If we have a data set that consists of the points ${x}_{1},{x}_{2},…,{x}_{n},$ then the mean is denoted by $\\overset{―}{x}$ and is given by the following formula:\n\n$$\n\\overset{―}{x}=\\frac{1}{n}{\\sum }_{i=1}^{n}{x}_{i}\n$$\n\nHere, there are $n=6$ data points. Adding up all the points in the data set, we get\n\n$$\n\\begin{aligned}{\\sum }_{i=1}^{6}{x}_{i} & =3+5+6+8+5+3 \\\\  & =30.\\end{aligned}\n$$\n\nTherefore, the mean is\n\n$$\n\\begin{aligned}\\overset{―}{x} & =\\frac{1}{n}{\\sum }_{i=1}^{n}{x}_{i} \\\\  & =\\frac{1}{6}\\cdot 30 \\\\  & =5.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186278322 :knowledge-point/_questions [{:db/id #edb/ref 17592186092274 :knowledge-point/id #uuid "b4df33ff-e04e-55ec-b273-9eceff7db53b" :knowledge-point/title "Identifying Rotation Matrices"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "049a038d-3516-5ec2-be1b-4e635ba4b278" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/ba/ba328088ca187ea28b241a302a486da1145a51c7e134d8d4f529f5f4a916ddc1.png" :db/id #edb/ref 17592186275520} {:answer/id #uuid "14ebb756-3759-5271-b48e-6794e5fdec4a" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/ef/efb79fc1071f79597c81a0a974e7f6b21d361ac046f728625e2fe1c02bb507eb.png" :db/id #edb/ref 17592186275674} {:answer/id #uuid "743d0195-2c36-5bee-ab97-eb5a706e4262" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/2d/2da0ffb873eb230718aab29c7dd09e015a0801b7ecb3b7dea91102f30b3e8816.png" :db/id #edb/ref 17592186276527} {:answer/id #uuid "7c566f0e-0800-5761-9b82-b362366c548c" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/48/489bc530fc35e2e740038264f2be05bffb90214249ec5602591623d457325db3.png" :db/id #edb/ref 17592186276611} {:answer/id #uuid "c89d8c25-ddbe-5e3d-9e44-1ee0e28ea7dd" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/5b/5bd4d8cc2643767b82acc0e61d168f5b387be67a7ff96634604e0d6828cc288b.png" :db/id #edb/ref 17592186277262}] :answer-field/correct {:answer/id #uuid "049a038d-3516-5ec2-be1b-4e635ba4b278" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/ba/ba328088ca187ea28b241a302a486da1145a51c7e134d8d4f529f5f4a916ddc1.png" :db/id #edb/ref 17592186275520} :answer-field/id #uuid "7489f911-b3ed-5658-95a0-34d33dc19d87" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186277931}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "ecda41b1-c814-51d0-b755-d1273a4b443b" :question/math-academy-id "q-160619" :question/problem "![](images/f3/f3e31d1c15a97adea32790eafe75ad1bc9f70c854b516b98de6648ec8d7bcb87.png)\n\nConsider the vector $v$ shown above. Find the vector $Av$ given that \n\n$$\nA=[\\begin{aligned}-1 & 0 \\\\ 0 & -1\\end{aligned}].\n$$" :question/worked-solution "Consider the standard basis ${i,j}$ of the Euclidean plane ${R}^{2}$ and the unit square spanned by the vectors. Computing the images of ${i,j}$ under $A$, we get the following:\n\n$$\n\\begin{aligned}{i}^{′} & =A(i)=[\\begin{aligned}-1 & 0 \\\\ 0 & -1\\end{aligned}][\\begin{aligned}1 \\\\ 0\\end{aligned}]=[\\begin{aligned}-1 \\\\ 0\\end{aligned}]=-i \\\\ {j}^{′} & =A(j)=[\\begin{aligned}-1 & 0 \\\\ 0 & -1\\end{aligned}][\\begin{aligned}0 \\\\ 1\\end{aligned}]=[\\begin{aligned}0 \\\\ -1\\end{aligned}]=-j\\end{aligned}\n$$\n\nAs a result, we obtain the following diagram:\n\n![](images/9f/9fae3ec0ada3008937d88e4e76374a56da4369b1821cfee072c90d88b562df46.png)\n\nSo, the matrix represents a rotation of $\\pi $ radians (counterclockwise or clockwise) about the origin.\n\nTherefore, in order to find $Av$, we need to rotate $v$ (counterclockwise or clockwise) by an angle of $\\pi $ radians, as shown below.\n\n![](images/ae/ae800b271848948b5f60f5cd7c1cecd163c2aa7399e9a87e2a52d158857c6a42.png)"}] [{:db/id #edb/ref 17592186389042 :knowledge-point/_questions [{:db/id #edb/ref 17592186092274 :knowledge-point/id #uuid "b4df33ff-e04e-55ec-b273-9eceff7db53b" :knowledge-point/title "Identifying Rotation Matrices"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "87084364-abe0-5ffb-9ed0-31fcedec776e" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/05/05963ad5c8caadae06a2dd07faaf217f7927d0698eaff91a219837a4171e4de8.png" :db/id #edb/ref 17592186389044} {:answer/id #uuid "f8720d56-2e77-5486-97d7-955b4f4b682c" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/63/63d73b449ca97cfad5b54cad11e53b77554da361dbe3e33c5b6f58b23b802fec.png" :db/id #edb/ref 17592186389045} {:answer/id #uuid "a1071b7a-73e9-5844-9e1c-3d9330374aee" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/80/805c480c5341b6fbf3e8d5720187fead535db2a651939572a3a9faf453726087.png" :db/id #edb/ref 17592186389046} {:answer/id #uuid "41953237-f9fc-559c-82aa-b62b7ee3907a" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/db/db5060bb186aee7860ad69d8a5c4516aa3e01e43c8f42b98f2cf260eb606357e.png" :db/id #edb/ref 17592186389047} {:answer/id #uuid "b1243d75-3778-5b5c-9522-8c36c581f9c8" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/ba/ba328088ca187ea28b241a302a486da1145a51c7e134d8d4f529f5f4a916ddc1.png" :db/id #edb/ref 17592186389048}] :answer-field/correct {:answer/id #uuid "a1071b7a-73e9-5844-9e1c-3d9330374aee" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/80/805c480c5341b6fbf3e8d5720187fead535db2a651939572a3a9faf453726087.png" :db/id #edb/ref 17592186389046} :answer-field/id #uuid "e6a0e1aa-f1db-5de6-9ec9-bf93b2ab6a7b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186389043}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "c94ecad8-4e36-5921-9c83-d90975b4539d" :question/math-academy-id "q-160626" :question/problem "![](images/c3/c32886c161e347daa9bf6fa7215f8a09abc4334632c33020c31ade6dfc4e7315.png)\n\nConsider the vector $v$ shown above. Find the vector $Av$ given that \n\n$$\nA=[\\begin{aligned}0 & -1 \\\\ 1 & 0\\end{aligned}].\n$$" :question/worked-solution "Consider the standard basis ${i,j}$ of the Euclidean plane ${R}^{2}$ and the unit square spanned by the vectors. Computing the images of ${i,j}$ under $A$, we get the following:\n\n$$\n\\begin{aligned}{i}^{′} & =Ai=[\\begin{aligned}0 & -1 \\\\ 1 & 0\\end{aligned}][\\begin{aligned}1 \\\\ 0\\end{aligned}]=[\\begin{aligned}0 \\\\ 1\\end{aligned}]=j \\\\ {j}^{′} & =Aj=[\\begin{aligned}0 & -1 \\\\ 1 & 0\\end{aligned}][\\begin{aligned}0 \\\\ 1\\end{aligned}]=[\\begin{aligned}-1 \\\\ 0\\end{aligned}]=-i\\end{aligned}\n$$\n\nAs a result, we obtain the following diagram:\n\n![](images/f1/f154267ed0a528b1e9fbec40064b090560410fe76dab00070e13fb3d1978b59c.png)\n\nSo, the matrix represents a rotation of $\\frac{\\pi }{2}$ radians counterclockwise about the origin.\n\nTherefore, in order to find $Av$, we need to rotate $v$ counterclockwise by an angle of $\\frac{\\pi }{2}$ radians, as shown below.\n\n \n\n![](images/26/266af89426f86d22bc634a231c46a5ad89be14d06bc300a5fa20597998c826fd.png)"}] [{:db/id #edb/ref 17592186389049 :knowledge-point/_questions [{:db/id #edb/ref 17592186092274 :knowledge-point/id #uuid "b4df33ff-e04e-55ec-b273-9eceff7db53b" :knowledge-point/title "Identifying Rotation Matrices"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d8867d91-bcda-5489-8280-49d891cc31ab" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/ea/ead70b80d9256e1211addc404613f2dfe4a19baf822cbd77f429572ffc9a3a6d.png" :db/id #edb/ref 17592186389051} {:answer/id #uuid "48a91081-fad4-5761-a448-423550b39ed7" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/70/70dfc0c8412bfae3bdbb7128fc021199f11d63d6f4ee264bea20da70dd18316c.png" :db/id #edb/ref 17592186389052} {:answer/id #uuid "3faab04f-ba07-5e75-a43f-8198da358c66" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/5a/5a1923eec2b66ef4eb861ec42b00ea48a3285aaaf3255c42d12c001c9cde32f8.png" :db/id #edb/ref 17592186389053} {:answer/id #uuid "fe51163e-7d12-5501-9934-728d90d9412d" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/09/09b2ae9333118de0621a5f29610b6a83689fadaeb9c05e7a30b2799b12a1bd58.png" :db/id #edb/ref 17592186389054} {:answer/id #uuid "7c87cd81-f329-516d-8bf5-dc6b1dc8dca3" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/23/23f63717c8d356c698137359824112511b0bbd5ec04c59e47d22500d842d03b6.png" :db/id #edb/ref 17592186389055}] :answer-field/correct {:answer/id #uuid "48a91081-fad4-5761-a448-423550b39ed7" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/70/70dfc0c8412bfae3bdbb7128fc021199f11d63d6f4ee264bea20da70dd18316c.png" :db/id #edb/ref 17592186389052} :answer-field/id #uuid "328c6cdb-dc56-550a-b1a6-60351bc4df59" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186389050}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "04e79ef7-7090-527f-95f0-0f13ae5b3650" :question/math-academy-id "q-160627" :question/problem "![](images/0b/0bd98626bc49cc3c58e503d5a7373b6af0fcce721cfdf82ff372eaa57d157dda.png)\n\nConsider the vector $v$ shown above. Find the vector $Av$ given that \n\n$$\nA=[\\begin{aligned}0 & 1 \\\\ -1 & 0\\end{aligned}].\n$$" :question/worked-solution "Consider the standard basis ${i,j}$ of the Euclidean plane ${R}^{2}$ and the unit square spanned by the vectors. Computing the images of ${i,j}$ under $A$, we get the following:\n\n$$\n\\begin{aligned}{i}^{′} & =Ai=[\\begin{aligned}0 & 1 \\\\ -1 & 0\\end{aligned}][\\begin{aligned}1 \\\\ 0\\end{aligned}]=[\\begin{aligned}0 \\\\ -1\\end{aligned}]=-j \\\\ {j}^{′} & =Aj=[\\begin{aligned}0 & 1 \\\\ -1 & 0\\end{aligned}][\\begin{aligned}0 \\\\ 1\\end{aligned}]=[\\begin{aligned}1 \\\\ 0\\end{aligned}]=i\\end{aligned}\n$$\n\nAs a result, we obtain the following diagram:\n\n![](images/77/77936c4115b37d79ae301a93b218ecd23114ae4ad42d8298b8f058c1f50e82a2.png)\n\nSo, the matrix represents a rotation of $\\frac{\\pi }{2}$ radians **clockwise** about the origin.\n\nTherefore, in order to find $Av$, we need to rotate $v$ **clockwise** by an angle of $\\frac{\\pi }{2}$ radians, as shown below.\n\n![](images/d5/d5ff1c1a7c99b08d04d2ac58d9f8195ee29c8b564873a9abfb2635e93cec1968.png)"}] [{:db/id #edb/ref 17592186115511 :knowledge-point/_questions [{:db/id #edb/ref 17592186115354 :knowledge-point/id #uuid "461c0f55-cb85-511e-b8cb-be11f8a3c250" :knowledge-point/title "Domains of Functions With Reciprocal and Radical Components"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8b7c26a5-b179-5fa4-80bf-1c61cfe73961" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "t\\in (-\\infty ,-1)\\cup (-1,\\infty )" :db/id #edb/ref 17592186276744} {:answer/id #uuid "9c4d8231-1900-5e4d-93ea-adbad23077ae" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "t\\in (-2,3)\\cup (3,\\infty )" :db/id #edb/ref 17592186276880} {:answer/id #uuid "9cee549a-9a5f-5b5c-aa7a-2efb2ed679d7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "t\\in [-2,\\infty )" :db/id #edb/ref 17592186276887} {:answer/id #uuid "b52d3969-61c1-5058-85b1-1855191dad4b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "t\\in (-2,-1)\\cup (-1,\\infty )" :db/id #edb/ref 17592186277093} {:answer/id #uuid "c4e8c438-f45e-5188-b4c6-b57b88aeeefe" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "t\\in (-\\infty ,-3)\\cup (-3,-2)" :db/id #edb/ref 17592186277229}] :answer-field/correct {:answer/id #uuid "9cee549a-9a5f-5b5c-aa7a-2efb2ed679d7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "t\\in [-2,\\infty )" :db/id #edb/ref 17592186276887} :answer-field/id #uuid "f859f300-1c35-5cef-a858-4e363615bbec" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186278163}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "a468193a-ad5b-5942-ba5c-e4d6c31b221a" :question/math-academy-id "q-160771" :question/problem "Find the domain of the vector-valued function $f(t)=\\sqrt{2+t}\\,i+\\frac{1}{3+t}\\,j+(1+{t}^{2})\\,k.$" :question/worked-solution "To find the domain of $f$, we need the intersection of the domains of the individual components.\n\n- The domain of the 1st component $\\sqrt{2+t}$ is $t\\in [-2,\\infty ).$\n\n- The domain of the 2nd component $\\frac{1}{3+t}$ is $t\\in (-\\infty ,-3)\\cup (-3,\\infty ).$\n\n- The domain of the 3rd component $1+{t}^{2}$ is $t\\in (-\\infty ,\\infty ).$\n\nThe intersection is illustrated in the diagram below.\n\n![](images/01/01998bcc54d297275af928b2467e7bcc077c84fd595567f5b3ff5bf89d38ec7b.png)\n\nTherefore, the domain of the vector-valued function $f(t)$ is $t\\in [-2,\\infty ).$"}] [{:db/id #edb/ref 17592186115512 :knowledge-point/_questions [{:db/id #edb/ref 17592186115355 :knowledge-point/id #uuid "74a1499c-080d-5008-bcc3-492ef469d3dc" :knowledge-point/title "Domains of Functions With Exponential and Logarithmic Components"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "32535c3f-61ed-5f25-8197-6617098257db" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "t\\in (1,\\infty )" :db/id #edb/ref 17592186275922} {:answer/id #uuid "4b297d62-5e2b-5010-8a9c-255e9fc26f83" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "t\\in [-2,1)" :db/id #edb/ref 17592186276139} {:answer/id #uuid "7bd173d4-cbe6-5f62-8a8b-e79daafb4955" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "t\\in [2,\\infty )" :db/id #edb/ref 17592186276604} {:answer/id #uuid "a3e764d0-8597-5499-b3f2-c0d13b658393" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "t\\in (1,2]" :db/id #edb/ref 17592186276956} {:answer/id #uuid "fb100b03-5314-5d26-a423-fff6e2e8f76f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "t\\in [-2,\\infty )" :db/id #edb/ref 17592186277678}] :answer-field/correct {:answer/id #uuid "a3e764d0-8597-5499-b3f2-c0d13b658393" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "t\\in (1,2]" :db/id #edb/ref 17592186276956} :answer-field/id #uuid "ce14a927-c42a-513a-aaf5-9957db497289" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186278087}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "bb7e3a68-e14a-5c87-8890-f72233849744" :question/math-academy-id "q-160773" :question/problem "Find the domain of the vector-valued function $f(t)=\\sqrt{4-{t}^{2}}\\,i+\\operatorname{ln}⁡(t-1)\\,j+{e}^{t}\\,k.$" :question/worked-solution "To find the domain of $f$, we need the intersection of the domains of the individual components.\n\n- The domain of the 1st component $\\sqrt{4-{t}^{2}}$ is $t\\in [-2,2].$\n\n- The domain of the 2nd component $\\operatorname{ln}⁡(t-1)$ is $t\\in (1,\\infty ).$\n\n- The domain of the 3rd component ${e}^{t}$ is $t\\in (-\\infty ,\\infty ).$\n\nThe intersection is illustrated in the diagram below.\n\n![](images/d4/d43c856bf43fb3783a7ee34b2553879fdb99a791587f1c1e466bc135c868052d.png)\n\nTherefore, the domain of the vector-valued function $f(t)$ is $t\\in (1,2].$"}] [{:db/id #edb/ref 17592186278335 :knowledge-point/_questions [{:db/id #edb/ref 17592186068859 :knowledge-point/id #uuid "26571ec1-e645-5f07-ba4e-75c22558394a" :knowledge-point/title "Evaluating a Three-Component Vector-Valued Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "097dd637-ab1a-5934-879d-2dd76c1232d7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\,i+2\\,j+16\\,k" :db/id #edb/ref 17592186275558} {:answer/id #uuid "1cb2f958-aaa0-5019-a603-03c2e90484e8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\,i+2\\,j-16\\,k" :db/id #edb/ref 17592186275740} {:answer/id #uuid "4ae86899-68ab-5ebf-8303-5c97195d534c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\,k" :db/id #edb/ref 17592186276138} {:answer/id #uuid "92cf70ea-5afc-578e-928a-cf081f34d08e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\,i+16\\,k" :db/id #edb/ref 17592186276807} {:answer/id #uuid "d1c946eb-7ac6-5919-8566-652525f80736" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5\\,j" :db/id #edb/ref 17592186277330}] :answer-field/correct {:answer/id #uuid "097dd637-ab1a-5934-879d-2dd76c1232d7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\,i+2\\,j+16\\,k" :db/id #edb/ref 17592186275558} :answer-field/id #uuid "2ca443b4-52ae-5a4b-a2d1-8e70b0c18b56" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186277798}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "9415c537-2e54-5d27-abb1-94edbbabb029" :question/math-academy-id "q-160776" :question/problem "What is the value of $f(t)=2{e}^{t}\\,i+\\sqrt{t+4}\\,j+(t-2)^{4}\\,k$ at $t=0?$" :question/worked-solution "To evaluate, we substitute $t=0$ into the function, as follows:\n\n$$\n\\begin{aligned}f(0) & =2{e}^{0}\\,i+\\sqrt{0+4}\\,j+(0-2)^{4}\\,k \\\\  & =2\\,i+2\\,j+16\\,k\\end{aligned}\n$$\n\nSo, the value of $f(t)$ at $t=0$ is the vector $2\\,i+2\\,j+16\\,k.$"}] [{:db/id #edb/ref 17592186278337 :knowledge-point/_questions [{:db/id #edb/ref 17592186068859 :knowledge-point/id #uuid "26571ec1-e645-5f07-ba4e-75c22558394a" :knowledge-point/title "Evaluating a Three-Component Vector-Valued Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0b38275e-ec32-53d5-8840-056d2d509045" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}-2 \\\\ 0 \\\\ -1\\end{aligned}]" :db/id #edb/ref 17592186275571} {:answer/id #uuid "2de46e7c-59e5-5aea-9ff3-e5ce39e07827" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}0 \\\\ 2 \\\\ 1\\end{aligned}]" :db/id #edb/ref 17592186275891} {:answer/id #uuid "6f3ee1e6-5f7d-5eb3-9dcf-9daec5eb1e6a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 \\\\ 0 \\\\ 1\\end{aligned}]" :db/id #edb/ref 17592186276477} {:answer/id #uuid "a0b2432c-950c-5564-bfb4-7df3f5dccd36" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 \\\\ 1 \\\\ 0\\end{aligned}]" :db/id #edb/ref 17592186276924} {:answer/id #uuid "bb5a0b7e-8b16-55d5-b07d-ce33f5f7fc34" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}2 \\\\ 0 \\\\ 0\\end{aligned}]" :db/id #edb/ref 17592186277140}] :answer-field/correct {:answer/id #uuid "a0b2432c-950c-5564-bfb4-7df3f5dccd36" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 \\\\ 1 \\\\ 0\\end{aligned}]" :db/id #edb/ref 17592186276924} :answer-field/id #uuid "f8fd70ae-3807-50e4-99e4-a7531155f19c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186278165}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "b8df2535-af98-5f9d-b645-9edd76ae78d4" :question/math-academy-id "q-160788" :question/problem "What is the value of $f(t)=[\\begin{aligned}\\frac{1}{t+1} \\\\ 1-{t}^{2} \\\\ \\operatorname{tan}⁡t\\end{aligned}]$ at $t=0?$" :question/worked-solution "To evaluate, we substitute $t=0$ into the function, as follows:\n\n$$\n\\begin{aligned}f(0) & =[\\begin{aligned}\\frac{1}{(0)+1} \\\\ 1-(0)^{2} \\\\ \\operatorname{tan}⁡(0)\\end{aligned}] \\\\  & =[\\begin{aligned}\\frac{1}{1} \\\\ 1 \\\\ 0\\end{aligned}] \\\\  & =[\\begin{aligned}1 \\\\ 1 \\\\ 0\\end{aligned}]\\end{aligned}\n$$\n\nSo the value of $f(t)$ at $t=0$ is $[\\begin{aligned}1 \\\\ 1 \\\\ 0\\end{aligned}].$"}] [{:db/id #edb/ref 17592186278383 :knowledge-point/_questions [{:db/id #edb/ref 17592186105904 :knowledge-point/id #uuid "cafdb077-0e02-5e7a-bf78-c3a8aacfb6f7" :knowledge-point/title "Calculating an Angle or Side of a Triangle Given the Area of a Triangle"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1a92871f-5bd5-581e-ac06-dbd13021c053" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "7\\,\\text{cm}" :db/id #edb/ref 17592186275724} {:answer/id #uuid "299f96e2-93fa-5d8f-ab41-fc313dbd3222" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "7.5\\,\\text{cm}" :db/id #edb/ref 17592186275854} {:answer/id #uuid "4f831c2c-96bc-514e-94a8-9c7ae9a2e9a3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6\\,\\text{cm}" :db/id #edb/ref 17592186276188} {:answer/id #uuid "7bb62d91-e7c1-5a0b-9594-0da656f39663" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6.5\\,\\text{cm}" :db/id #edb/ref 17592186276601} {:answer/id #uuid "a89eff61-0284-58bc-8453-86df1e739eb6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8\\,\\text{cm}" :db/id #edb/ref 17592186276998}] :answer-field/correct {:answer/id #uuid "1a92871f-5bd5-581e-ac06-dbd13021c053" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "7\\,\\text{cm}" :db/id #edb/ref 17592186275724} :answer-field/id #uuid "e821e218-a2a4-5efe-86d2-0f9a4556c28f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186278132}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "43fd23a0-08b8-58ee-b7e6-43240cfa05d7" :question/math-academy-id "q-161109" :question/problem "![](images/b9/b95571772af958b4f7b7dcdbba630b78e029c838340dc272809a6c7915dc9c90.png)\n\nThe area of ​​the triangle $△ABC$ is $\\frac{21\\sqrt{2}}{2}{\\text{ cm}}^{2}.$ Find $AC.$" :question/worked-solution "The formula for the area of the triangle is \n\n$$\nA=\\frac{1}{2}bc\\operatorname{sin}⁡A,\n$$\n\nwhere $∠A$ is between the sides of lengths $b$ and $c.$ \n\nHere\n\n$$\n\\begin{aligned}c & =AB=6\\text{ cm}, \\\\ b & =AC, \\\\ m∠A & ={45}^{∘}.\\end{aligned}\n$$\n\nSince \n\n$$\n\\operatorname{sin}⁡{45}^{∘}=\\frac{\\sqrt{2}}{2},\n$$\n\nwe can calculate $b=AC,$ as follows:\n\n$$\n\\begin{aligned}A & =\\frac{1}{2}\\cdot b\\cdot c\\cdot \\operatorname{sin}⁡A \\\\ \\frac{21\\sqrt{2}}{2} & =\\frac{1}{2}\\cdot b\\cdot 6\\cdot \\operatorname{sin}⁡{45}^{∘} \\\\ \\frac{21\\sqrt{2}}{2} & =\\frac{1}{2}\\cdot b\\cdot 6\\cdot (\\frac{\\sqrt{2}}{2}) \\\\ \\frac{21\\sqrt{2}}{2} & =\\frac{3\\sqrt{2}\\,b}{2} \\\\ \\frac{21\\cancel{\\sqrt{2}}}{\\cancel{2}} & =\\frac{3\\cancel{\\sqrt{2}}\\,b}{\\cancel{2}} \\\\ 3b & =21 \\\\ b & =7\\text{ cm}.\\end{aligned}\n$$\n\nWe conclude that $AC=7\\,\\text{cm}.$"}] [{:db/id #edb/ref 17592186278534 :knowledge-point/_questions [{:db/id #edb/ref 17592186068859 :knowledge-point/id #uuid "26571ec1-e645-5f07-ba4e-75c22558394a" :knowledge-point/title "Evaluating a Three-Component Vector-Valued Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "316c6519-33d0-5d06-8c56-11f7bf0b4373" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}0 \\\\ 5 \\\\ -9\\end{aligned}]" :db/id #edb/ref 17592186275916} {:answer/id #uuid "5ee1594c-242f-5c6e-8ccb-7753c2f977cb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 \\\\ 10 \\\\ 11\\end{aligned}]" :db/id #edb/ref 17592186276326} {:answer/id #uuid "87b72340-754d-5c38-825f-f706fe102839" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}0 \\\\ 25 \\\\ -9\\end{aligned}]" :db/id #edb/ref 17592186276702} {:answer/id #uuid "a81d69a1-0e67-528e-a140-9b036a2f9545" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 \\\\ 25 \\\\ 9\\end{aligned}]" :db/id #edb/ref 17592186276995} {:answer/id #uuid "bbe6423b-37c2-58f2-9d91-6a6e0ba76b6f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}\\operatorname{ln}⁡4 \\\\ 10 \\\\ 9\\end{aligned}]" :db/id #edb/ref 17592186277148}] :answer-field/correct {:answer/id #uuid "87b72340-754d-5c38-825f-f706fe102839" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}0 \\\\ 25 \\\\ -9\\end{aligned}]" :db/id #edb/ref 17592186276702} :answer-field/id #uuid "222d139b-3747-5f53-a722-938109511712" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186277783}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "10894d9f-77c7-5720-8c2d-f5aa520bb510" :question/math-academy-id "q-161507" :question/problem "What is the value of $f(t)=[\\begin{aligned}\\operatorname{ln}⁡(t-4) \\\\ 5t \\\\ 1-2t\\end{aligned}]$ at $t=5?$" :question/worked-solution "To evaluate, we substitute $t=5$ into the function, as follows:\n\n$$\n\\begin{aligned}f(5) & =[\\begin{aligned}\\operatorname{ln}⁡(5-4) \\\\ 5(5) \\\\ 1-2(5)\\end{aligned}] \\\\  & =[\\begin{aligned}\\operatorname{ln}⁡1 \\\\ {5}^{2} \\\\ 1-10\\end{aligned}] \\\\  & =[\\begin{aligned}0 \\\\ 25 \\\\ -9\\end{aligned}]\\end{aligned}\n$$\n\nSo the value of $f(t)$ at $t=5$ is the vector $[\\begin{aligned}0 \\\\ 25 \\\\ -9\\end{aligned}].$"}] [{:db/id #edb/ref 17592186389223 :knowledge-point/_questions [{:db/id #edb/ref 17592186087721 :knowledge-point/id #uuid "e0dc11d5-8eda-52b1-b7b1-42b481813ff4" :knowledge-point/title "Graphing a Curve Defined Parametrically"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e9372202-4293-501e-b9c6-fc83f9060b82" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/1e/1e44005cfe46b507a2b02eec16db0a724c5844497b993fe0d2f7d16fcc758b1c.png" :db/id #edb/ref 17592186389225} {:answer/id #uuid "d106a59b-3d70-5c0f-a823-6ee899c7b211" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/21/21cb936268e88d0e69e8244c6429cf8e6dd4881cc471c3496290b9f2eb233efe.png" :db/id #edb/ref 17592186389226} {:answer/id #uuid "e7554ce7-0f4a-5750-969d-2c0e0dab35e2" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/0a/0a5bcbce0378b0a9aa47a