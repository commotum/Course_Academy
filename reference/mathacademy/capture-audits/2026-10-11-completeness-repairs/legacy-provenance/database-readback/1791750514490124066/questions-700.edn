/id #edb/ref 17592186257868} {:answer/id #uuid "91e40084-cac8-5469-9d49-d3b40442470e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x\\le 1" :db/id #edb/ref 17592186258070} {:answer/id #uuid "a2c1f09b-b855-5ca5-b0cd-fd5174673129" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x\\ge 0" :db/id #edb/ref 17592186258206}] :answer-field/correct {:answer/id #uuid "7aa68b07-b1f2-565e-b4ac-83291c10fccc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x\\ge 1" :db/id #edb/ref 17592186257867} :answer-field/id #uuid "cdbbffe9-ed9c-55ae-a19e-6378fc084daf" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186259395}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "2a66d510-dc6f-5140-8b85-a40c213c087f" :question/math-academy-id "q-123765" :question/problem "Given that a curve is defined parametrically as\n\n$$\nx=1-4t,\\,\\,\\,y={t}^{2}-1,\\,t\\le 0,\n$$\n\nwhat is the range of $x?$" :question/worked-solution "To find the range of $x,$ note that $x=1-4t\\ge 1$ for all $t\\le 0.$ \n\nConsequently, the range of $x$ is $x\\ge 1.$"}] [{:db/id #edb/ref 17592186400114 :knowledge-point/_questions [{:db/id #edb/ref 17592186087722 :knowledge-point/id #uuid "3cbf0ad0-a7c5-5c0f-a06c-9210fdc244ef" :knowledge-point/title "Determining the Range of a Parametric Equation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c848ce1a-65b8-563c-9fec-80599c592bcc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x\\le -3,\\,y\\ge 2" :db/id #edb/ref 17592186400116} {:answer/id #uuid "7f194208-efc2-515c-a071-37d890d6515f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x\\le 2,\\,y\\ge -3" :db/id #edb/ref 17592186400117} {:answer/id #uuid "2b898a9d-7842-5e4a-9365-22c2934152ca" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x\\le 2,\\,y\\ge 3" :db/id #edb/ref 17592186400118} {:answer/id #uuid "8a1c0d33-169a-5055-a64e-c6a8e8656c1e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x\\ge -1,\\,y\\ge 3" :db/id #edb/ref 17592186400119} {:answer/id #uuid "658dd7e1-62d5-534e-8c6f-6d03db279945" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x\\ge 3,\\,y\\le -2" :db/id #edb/ref 17592186400120}] :answer-field/correct {:answer/id #uuid "2b898a9d-7842-5e4a-9365-22c2934152ca" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x\\le 2,\\,y\\ge 3" :db/id #edb/ref 17592186400118} :answer-field/id #uuid "acb683db-68cc-56c9-829b-45a54bf4f29a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186400115}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "a3e9c6f6-566c-5162-9fe9-4d86fd16d1a4" :question/math-academy-id "q-123769" :question/problem "Given that a curve is defined parametrically as\n\n$$\nx=3-t,\\,\\,\\,y=t+2,\\,t\\ge 1,\n$$\n\ndetermine the ranges of $x$ and $y.$" :question/worked-solution "Let's consider each variable in turn.\n\n- To find the range of $x,$ note that $3-t\\le 2$ for all $t\\ge 1.$ Consequently, $x=3-t\\le 2.$\n\n- To find the range of $y,$ note that $t+2\\ge 3$ for all $t\\ge 1.$ Consequently, $y=t+2\\ge 3.$\n\nTherefore, the ranges are $x\\le 2$ and $y\\ge 3.$"}] [{:db/id #edb/ref 17592186400121 :knowledge-point/_questions [{:db/id #edb/ref 17592186087736 :knowledge-point/id #uuid "cddc940d-2185-569c-a62b-b507e95d3c35" :knowledge-point/title "Determining the Range of a Parametric Equation Defined in Terms of Trigonometric Functions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "befcfe4a-abd3-5984-a1a3-1a1bf2b0cd72" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2\\le x\\le 0,\\,-3\\le y\\le -1" :db/id #edb/ref 17592186400123} {:answer/id #uuid "9ee13255-e4e9-52e6-b06e-d0aeddb3bb38" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1\\le x\\le 1,\\,1\\le y\\le 3" :db/id #edb/ref 17592186400124} {:answer/id #uuid "c3236814-4c23-5fc9-a82d-b9432370c830" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1\\le x\\le 1,\\,-3\\le y\\le -1" :db/id #edb/ref 17592186400125} {:answer/id #uuid "bcd316cc-7219-5b56-b38c-fa0c32ea3d94" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0\\le x\\le 2,\\,-2\\le y\\le 2" :db/id #edb/ref 17592186400126} {:answer/id #uuid "5fb2b3dc-0e10-5966-a703-a0088b75ec08" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0\\le x\\le 2,\\,1\\le y\\le 3" :db/id #edb/ref 17592186400127}] :answer-field/correct {:answer/id #uuid "5fb2b3dc-0e10-5966-a703-a0088b75ec08" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0\\le x\\le 2,\\,1\\le y\\le 3" :db/id #edb/ref 17592186400127} :answer-field/id #uuid "806b0a66-23a8-530b-9fd2-35a679c8dd3c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186400122}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "42535d46-cb00-5afc-82ab-e62c0ea06521" :question/math-academy-id "q-123773" :question/problem "Given that a curve is defined parametrically as\n\n$$\nx=1-\\operatorname{cos}⁡\\theta ,\\,y=\\operatorname{sin}⁡\\theta +2,\\,0\\le \\theta <2\\pi ,\n$$\n\nwhat are the ranges of $x$ and $y?$" :question/worked-solution "Let's consider each variable in turn.\n\n- To find the range of $x,$ notice that for $0\\le \\theta <2\\pi ,$ we have $-1\\le \\operatorname{cos}⁡\\theta \\le 1.$ Consequently,\n\n$$\n\\begin{aligned}-1 & \\le \\operatorname{cos}⁡\\theta \\le 1 \\\\ 1 & \\text{ }\\ge -\\operatorname{cos}⁡\\theta \\text{ }\\ge -1 \\\\ -1 & \\le -\\operatorname{cos}⁡\\theta \\le 1 \\\\ 1-1 & \\le 1-\\operatorname{cos}⁡\\theta \\le 1+1 \\\\ 0 & \\le x\\le 2.\\end{aligned}\n$$\n\nSo, we can conclude that $0\\le x\\le 2.$\n\n- To find the range of $y,$ notice that for $0\\le \\theta <2\\pi ,$ we have $-1\\le \\operatorname{sin}⁡\\theta \\le 1.$ Consequently,\n\n$$\n\\begin{aligned}-1 & \\le \\operatorname{sin}⁡\\theta \\le 1 \\\\ -1+2 & \\le \\operatorname{sin}⁡\\theta +2\\le 1+2 \\\\ 1 & \\le y\\le 3.\\end{aligned}\n$$\n\nSo, we can conclude that $1\\le y\\le 3.$\n\nTherefore, the ranges are $0\\le x\\le 2$ and $1\\le y\\le 3.$"}] [{:db/id #edb/ref 17592186400128 :knowledge-point/_questions [{:db/id #edb/ref 17592186087736 :knowledge-point/id #uuid "cddc940d-2185-569c-a62b-b507e95d3c35" :knowledge-point/title "Determining the Range of a Parametric Equation Defined in Terms of Trigonometric Functions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "64998bfc-bfc7-5d3e-8ee6-300d3a38797d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2\\le x\\le 2,\\,-4\\le y\\le -2" :db/id #edb/ref 17592186400130} {:answer/id #uuid "42492b12-0052-541d-8cee-a36023e92984" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2\\le x\\le 2,\\,-3\\le y\\le 3" :db/id #edb/ref 17592186400131} {:answer/id #uuid "2c4ef62b-01d3-5f37-819a-bf2a72b19db1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{2}\\le x\\le \\frac{1}{2},\\,-3\\le y\\le 3" :db/id #edb/ref 17592186400132} {:answer/id #uuid "79eb9da7-f01c-5dfb-a236-47a585231977" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{2}\\le x\\le \\frac{1}{2},\\,2\\le y\\le 4" :db/id #edb/ref 17592186400133} {:answer/id #uuid "617de8a7-03f5-5305-95c8-3f2f2a0cf8cd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1\\le x\\le 3,\\,2\\le y\\le 4" :db/id #edb/ref 17592186400134}] :answer-field/correct {:answer/id #uuid "79eb9da7-f01c-5dfb-a236-47a585231977" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{2}\\le x\\le \\frac{1}{2},\\,2\\le y\\le 4" :db/id #edb/ref 17592186400133} :answer-field/id #uuid "ef6815f3-6a4d-5946-a00b-a698526a94b2" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186400129}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "df6cb91b-a536-5526-9dd6-80b470cc8a61" :question/math-academy-id "q-123775" :question/problem "Given that a curve is defined parametrically as\n\n$$\nx=\\frac{1}{2}\\operatorname{cos}⁡\\theta ,\\,y=\\operatorname{sin}⁡\\theta +3,\\,0\\le \\theta <2\\pi ,\n$$\n\nwhat are the ranges of $x$ and $y?$" :question/worked-solution "Let's consider each variable in turn.\n\n- To find the range of $x,$ notice that for $0\\le \\theta <2\\pi ,$ we have $-1\\le \\operatorname{cos}⁡\\theta \\le 1.$ Consequently,\n\n$$\n\\begin{aligned}-1 & \\le \\operatorname{cos}⁡\\theta \\le 1 \\\\ -\\frac{1}{2} & \\le \\frac{1}{2}\\operatorname{cos}⁡\\theta \\le \\frac{1}{2} \\\\ -\\frac{1}{2} & \\le x\\le \\frac{1}{2}.\\end{aligned}\n$$\n\nSo, we can conclude that $-\\frac{1}{2}\\le x\\le \\frac{1}{2}.$\n\n- To find the range of $y,$ notice that for $0\\le \\theta <2\\pi ,$ we have $-1\\le \\operatorname{sin}⁡\\theta \\le 1.$ Consequently,\n\n$$\n\\begin{aligned}-1 & \\le \\operatorname{sin}⁡\\theta \\le 1 \\\\ -1+3 & \\le \\operatorname{sin}⁡\\theta +3\\le 1+3 \\\\ 2 & \\le y\\le 4.\\end{aligned}\n$$\n\nSo, we can conclude that $2\\le y\\le 4.$\n\nTherefore, the ranges are $-\\frac{1}{2}\\le x\\le \\frac{1}{2}$ and $2\\le y\\le 4.$"}] [{:db/id #edb/ref 17592186387437 :knowledge-point/_questions [{:db/id #edb/ref 17592186087721 :knowledge-point/id #uuid "e0dc11d5-8eda-52b1-b7b1-42b481813ff4" :knowledge-point/title "Graphing a Curve Defined Parametrically"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e3809196-0e72-568a-acb4-8f1806b011f3" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/d1/d1cec5ea2da4a0b5f141bb24b4addc797defbc48e76cdfdbfab3a303e348b8cc.png" :db/id #edb/ref 17592186387439} {:answer/id #uuid "d44a46da-960a-5000-b573-28968c62249a" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/bc/bcb2b08bab14ce74347d37a0e896451750db0203ab830b835a83de6b7a81b61d.png" :db/id #edb/ref 17592186387440} {:answer/id #uuid "a8c8555e-f76d-58d2-98de-66b72a2089cb" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/02/02b248ea373f295fa4dbad215eba4c211ef18548dca4a56d57cb3f15424ad501.png" :db/id #edb/ref 17592186387441} {:answer/id #uuid "6dbecde8-5a29-5731-8756-dcd4a93b4487" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/09/097262c9e70a68d3a7ae1b1186bed57cefd7b99b0af2215d4ce6b08a086f90c6.png" :db/id #edb/ref 17592186387442} {:answer/id #uuid "63870ff1-4a2f-5845-b126-b062e8aa81ef" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/c4/c477137fe47dc3f0475f44658117545da3dae94f18e3bf2ce897d2a89fad2a37.png" :db/id #edb/ref 17592186387443}] :answer-field/correct {:answer/id #uuid "a8c8555e-f76d-58d2-98de-66b72a2089cb" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/02/02b248ea373f295fa4dbad215eba4c211ef18548dca4a56d57cb3f15424ad501.png" :db/id #edb/ref 17592186387441} :answer-field/id #uuid "533eaf8b-e6a9-5c0c-825d-2916