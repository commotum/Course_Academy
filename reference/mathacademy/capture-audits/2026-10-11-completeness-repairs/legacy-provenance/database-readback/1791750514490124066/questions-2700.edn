db/ref 17592186348343 :knowledge-point/_questions [{:db/id #edb/ref 17592186096606 :knowledge-point/id #uuid "74c40813-d2aa-5eff-b5dc-69a2f916f865" :knowledge-point/title "Finding the Phase for the Amplitude-Phase Form for Sine"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "77dc6fdd-2db7-55bf-abb5-b59442a1464c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{arctan}⁡(2)" :db/id #edb/ref 17592186346402} {:answer/id #uuid "b477c45c-b737-549b-91b5-d1091460ac32" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{arctan}⁡(\\frac{3}{2})" :db/id #edb/ref 17592186346923} {:answer/id #uuid "d114ac37-9962-5408-9d6e-05d942670183" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{arctan}⁡(4)" :db/id #edb/ref 17592186347182} {:answer/id #uuid "e341ede8-046b-52c2-b8b6-aa4cf9fe8ca2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{arctan}⁡(\\frac{5}{2})" :db/id #edb/ref 17592186347350} {:answer/id #uuid "fe903f8c-2fae-5ab6-9e3a-9928ee1b850e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{arctan}⁡(3)" :db/id #edb/ref 17592186347588}] :answer-field/correct {:answer/id #uuid "d114ac37-9962-5408-9d6e-05d942670183" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{arctan}⁡(4)" :db/id #edb/ref 17592186347182} :answer-field/id #uuid "6df7bc06-d4ba-5a57-ab49-fe4b9ffa350a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186347804}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "b478a4e0-e373-5d4c-8f17-c97eaae0c7f7" :question/math-academy-id "q-80136" :question/problem "Given that the expression $2\\operatorname{sin}⁡x-8\\operatorname{cos}⁡x$ can be written as $R\\operatorname{sin}⁡(x-ϕ)$ with ${0}^{∘}<ϕ<{90}^{∘}$ and $R>0$, what is the value of $ϕ?$" :question/worked-solution "The difference formula for sine gives\n\n$$\n\\begin{aligned}R\\operatorname{sin}⁡(x-ϕ) & =R(\\operatorname{sin}⁡x\\operatorname{cos}⁡ϕ-\\operatorname{cos}⁡x\\operatorname{sin}⁡ϕ) \\\\  & =R\\operatorname{cos}⁡ϕ\\operatorname{sin}⁡x-R\\operatorname{sin}⁡ϕ\\operatorname{cos}⁡x\\end{aligned}\n$$\n\nTherefore, by writing the given expression in the amplitude-phase form\n\n$$\n2\\operatorname{sin}⁡x-8\\operatorname{cos}⁡x=R\\operatorname{sin}⁡(x-ϕ),\n$$\n\nwe get the following identity:\n\n$$\n2\\operatorname{sin}⁡x-8\\operatorname{cos}⁡x=(R\\operatorname{cos}⁡ϕ)\\operatorname{sin}⁡x-(R\\operatorname{sin}⁡ϕ)\\operatorname{cos}⁡x\n$$\n\nEquating the coefficients of $\\operatorname{sin}⁡x$ and $\\operatorname{cos}⁡x,$ we get the following system of equations:\n\n$$\n{\\begin{aligned}R\\operatorname{cos}⁡ϕ=2 \\\\ R\\operatorname{sin}⁡ϕ=8\\end{aligned}\n$$\n\nDividing the second equation by the first, we get\n\n$$\n\\begin{aligned}\\frac{R\\operatorname{sin}⁡ϕ}{R\\operatorname{cos}⁡ϕ} & =\\frac{8}{2} \\\\ \\operatorname{tan}⁡ϕ & =4 \\\\ ϕ & =\\operatorname{arctan}⁡(4).\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186348344 :knowledge-point/_questions [{:db/id #edb/ref 17592186096608 :knowledge-point/id #uuid "65b4e8e7-e558-50e7-a1ec-37a6eff77e87" :knowledge-point/title "Finding the Amplitude-Phase Form for Sine"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "159c485c-001f-5031-b26e-f83f2bfeaf3d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4\\operatorname{sin}⁡(x-{45}^{∘})" :db/id #edb/ref 17592186345538} {:answer/id #uuid "8be5f15a-55d3-55ce-9ad8-ff6f91eee7c6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4\\sqrt{2}\\operatorname{sin}⁡(x-{45}^{∘})" :db/id #edb/ref 17592186346562} {:answer/id #uuid "936ec69f-b82c-51aa-b0f0-19d6eaccfe93" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{2}\\operatorname{sin}⁡(x-{30}^{∘})" :db/id #edb/ref 17592186346640} {:answer/id #uuid "940a0cb2-9a0f-54ac-81e8-736d1cba6508" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3\\sqrt{2}\\operatorname{sin}⁡(x-{60}^{∘})" :db/id #edb/ref 17592186346643} {:answer/id #uuid "ca9d53ec-b344-5b9f-8c8e-a292d0704445" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4\\sqrt{3}\\operatorname{sin}⁡(x-{45}^{∘})" :db/id #edb/ref 17592186347118}] :answer-field/correct {:answer/id #uuid "8be5f15a-55d3-55ce-9ad8-ff6f91eee7c6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4\\sqrt{2}\\operatorname{sin}⁡(x-{45}^{∘})" :db/id #edb/ref 17592186346562} :answer-field/id #uuid "419a1eeb-4e9d-5a0c-8435-a16640782af5" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186347715}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "c9f0ee2e-ecf1-5ebf-8f05-484d1b3df712" :question/math-academy-id "q-80138" :question/problem "$4\\operatorname{sin}⁡x-4\\operatorname{cos}⁡x=$" :question/worked-solution "The difference formula for sine gives\n\n$$\n\\begin{aligned}R\\operatorname{sin}⁡(x-ϕ) & =R(\\operatorname{sin}⁡x\\operatorname{cos}⁡ϕ-\\operatorname{cos}⁡x\\operatorname{sin}⁡ϕ) \\\\  & =R\\operatorname{cos}⁡ϕ\\operatorname{sin}⁡x-R\\operatorname{sin}⁡ϕ\\operatorname{cos}⁡x.\\end{aligned}\n$$\n\nTherefore, by writing the given expression in the amplitude-phase form\n\n$$\n4\\operatorname{sin}⁡x-4\\operatorname{cos}⁡x=R\\operatorname{sin}⁡(x-ϕ),\n$$\n\nwe get the following identity:\n\n$$\n4\\operatorname{sin}⁡x-4\\operatorname{cos}⁡x=(R\\operatorname{cos}⁡ϕ)\\operatorname{sin}⁡x-(R\\operatorname{sin}⁡ϕ)\\operatorname{cos}⁡x\n$$\n\nEquating the coefficients of $\\operatorname{sin}⁡x$ and $\\operatorname{cos}⁡x,$ we get the following system of equations:\n\n$$\n{\\begin{aligned}R\\operatorname{cos}⁡ϕ=4 \\\\ R\\operatorname{sin}⁡ϕ=4\\end{aligned}\n$$\n\nDividing the second equation by the first, we get\n\n$$\n\\begin{aligned}\\frac{R\\operatorname{sin}⁡ϕ}{R\\operatorname{cos}⁡ϕ} & =\\frac{4}{4} \\\\ \\operatorname{tan}⁡ϕ & =1 \\\\ ϕ & =\\operatorname{arctan}⁡(1) \\\\ ϕ & ={45}^{∘}.\\end{aligned}\n$$\n\nNow, we find the amplitude $R.$ Squaring the first and the second equations of the system and adding the results together, we get\n\n$$\n\\begin{aligned}{(R\\operatorname{cos}⁡ϕ)}^{2}+{(R\\operatorname{sin}⁡ϕ)}^{2} & ={4}^{2}+{4}^{2} \\\\ {R}^{2}({cos}^{2}⁡ϕ+{sin}^{2}⁡ϕ) & =16+16 \\\\ {R}^{2} & =32 \\\\ R & =4\\sqrt{2}.\\end{aligned}\n$$\n\nNote that we only consider the positive root since $R>0.$\n\nFinally, we can write the initial expression in amplitude-phase form as follows:\n\n$$\n4\\operatorname{sin}⁡x-4\\operatorname{cos}⁡x=4\\sqrt{2}\\operatorname{sin}⁡(x-{45}^{∘})\n$$"}] [{:db/id #edb/ref 17592186348348 :knowledge-point/_questions [{:db/id #edb/ref 17592186096608 :knowledge-point/id #uuid "65b4e8e7-e558-50e7-a1ec-37a6eff77e87" :knowledge-point/title "Finding the Amplitude-Phase Form for Sine"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "02915c82-8065-5e74-82a1-9495fe20c4bf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{6}\\operatorname{sin}⁡(5x-0.854)" :db/id #edb/ref 17592186345371} {:answer/id #uuid "053a825a-5e0a-5eee-97c6-c642f5c2abaa" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\sqrt{6}\\operatorname{sin}⁡(5x-0.955)" :db/id #edb/ref 17592186345397} {:answer/id #uuid "89addc54-f82c-5eac-8aae-245bc3c57ac1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\sqrt{6}\\operatorname{sin}⁡(5x-0.916)" :db/id #edb/ref 17592186346545} {:answer/id #uuid "8c7af4b8-beb1-58ef-8b7a-b1c7ae4dca86" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{2}\\operatorname{sin}⁡(5x-1.054)" :db/id #edb/ref 17592186346571} {:answer/id #uuid "90a16488-0e85-5bd0-9ee2-b77c876e71b3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\sqrt{3}\\operatorname{sin}⁡(5x-1.156)" :db/id #edb/ref 17592186346612}] :answer-field/correct {:answer/id #uuid "053a825a-5e0a-5eee-97c6-c642f5c2abaa" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\sqrt{6}\\operatorname{sin}⁡(5x-0.955)" :db/id #edb/ref 17592186345397} :answer-field/id #uuid "f38fa9b7-ea07-551f-b484-bf242ae05284" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186348032}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "b6b79f0a-30fd-5a34-a89c-78169fdf9be8" :question/math-academy-id "q-80147" :question/problem "$2\\sqrt{2}\\operatorname{sin}⁡(5x)-4\\operatorname{cos}⁡(5x)≈$" :question/worked-solution "The difference formula for sine gives\n\n$$\n\\begin{aligned}R\\operatorname{sin}⁡(5x-ϕ) & =R(\\operatorname{sin}⁡(5x)\\operatorname{cos}⁡ϕ-\\operatorname{cos}⁡(5x)\\operatorname{sin}⁡ϕ) \\\\  & =R\\operatorname{cos}⁡ϕ\\operatorname{sin}⁡(5x)-R\\operatorname{sin}⁡ϕ\\operatorname{cos}⁡(5x).\\end{aligned}\n$$\n\nTherefore, by writing the given expression in the amplitude-phase form\n\n$$\n2\\sqrt{2}\\operatorname{sin}⁡(5x)-4\\operatorname{cos}⁡(5x)=R\\operatorname{sin}⁡(5x-ϕ),\n$$\n\nwe get the following identity:\n\n$$\n2\\sqrt{2}\\operatorname{sin}⁡(5x)-4\\operatorname{cos}⁡(5x)=(R\\operatorname{cos}⁡ϕ)\\operatorname{sin}⁡(5x)-(R\\operatorname{sin}⁡ϕ)\\operatorname{cos}⁡(5x)\n$$\n\nEquating the coefficients of $\\operatorname{sin}⁡(5x)$ and $\\operatorname{cos}⁡(5x),$ we get the following system of equations:\n\n$$\n{\\begin{aligned}R\\operatorname{cos}⁡ϕ=2\\sqrt{2} \\\\ R\\operatorname{sin}⁡ϕ=4\\end{aligned}\n$$\n\nDividing the second equation by the first, we get\n\n$$\n\\begin{aligned}\\frac{R\\operatorname{sin}⁡ϕ}{R\\operatorname{cos}⁡ϕ} & =\\frac{4}{2\\sqrt{2}} \\\\ \\operatorname{tan}⁡ϕ & =\\sqrt{2} \\\\ ϕ & =\\operatorname{arctan}⁡(\\sqrt{2}) \\\\  & =0.955\\end{aligned}\n$$\n\nrounded to three decimal places.\n\nNow, we find the amplitude $R.$ Squaring the first and the second equations of the system and adding the results together, we get\n\n$$\n\\begin{aligned}{(R\\operatorname{cos}⁡ϕ)}^{2}+{(R\\operatorname{sin}⁡ϕ)}^{2} & =(2\\sqrt{2})^{2}+{4}^{2} \\\\ {R}^{2}({cos}^{2}⁡ϕ+{sin}^{2}⁡ϕ) & =8+16 \\\\ {R}^{2} & =24 \\\\ R & =2\\sqrt{6}.\\end{aligned}\n$$\n\nNote that we only consider the positive root since $R>0.$\n\nFinally, we can write the initial expression in amplitude-phase form as follows:\n\n$$\n2\\sqrt{2}\\operatorname{sin}⁡(5x)-4\\operatorname{cos}⁡(5x)=2\\sqrt{6}\\operatorname{sin}⁡(5x-0.955)\n$$"}] [{:db/id #edb/ref 17592186393989 :knowledge-point/_questions [{:db/id #edb/ref 17592186115309 :knowledge-point/id #uuid "6e126b20-0507-5f22-ba34-a55157ca7fa1" :knowledge-point/title "Solving a Trigonometric Equation When the Cotangent Function Equals Zero"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4b5b028d-56fd-576d-89ee-59e91162f77f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "32\\,400" :db/id #edb/ref 17592186393991} {:answer/id #uuid "dabad841-65b9-5a99-92af-ee6af4b2bb9f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-8\\,100" :db/id #edb/ref 17592186393992} {:answer/id #uuid "b4b7bd2e-cf2b-501c-a930-f8e0d6c3c9b3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-16\\,200" :db/id #edb/ref 17592186393993} {:answer/id #uuid "a24ed0ee-36ac-5c49-8a82-fcd6540637a8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "16\\,200" :db/id #edb/ref 17592186393994} {:answer/id #uuid "fb4ff660-aaf6-533d-85c7-62c6040e5245" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-24\\,300" :db/id #edb/ref 17592186393995}] :answer-field/correct {:answer/id #uuid "dabad841-65b9-5a99-92af-ee6af4b2bb9f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-8\\,100" :db/id #edb/ref 17592186393992} :answer-field/id #uuid "ec419c65-67ca-5aa8-82ad-a2c9fe852709" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186393990}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "936da1a3-12b9-5773-8bc1-7b9d9679b27f" :question/math-academy-id "q-80197" :question/problem "Given that ${x}_{1}$ and ${x}_{2}$ are the solutions to the equation $2=2-9\\operatorname{cot}⁡x$ for $-{180}^{∘}<x<{180}^{∘},$ what is the numerical value of ${x}_{1}\\cdot {x}_{2}?$" :question/worked-solution "First, we rearrange the equation to isolate $\\operatorname{cot}⁡x:$\n\n$$\n\\begin{aligned}2 & =2-9\\operatorname{cot}⁡x \\\\ 0 & =-9\\operatorname{cot}⁡x \\\\ \\operatorname{cot}⁡x & =0\\end{aligned}\n$$\n\nWe can't find an equivalent equation involving tangent, since this would lead to us dividing by $0:$\n\n$$\n\\operatorname{tan}⁡x=\\frac{1}{0}=\\text{undefined}\n$$\n\nHowever, we can instead find an equivalent equation using the fact that $\\operatorname{cot}⁡x=\\frac{\\operatorname{cos}⁡x}{\\operatorname{sin}⁡x}:$\n\n$$\n\\frac{\\operatorname{cos}⁡x}{\\operatorname{sin}⁡x}=0\n$$\n\nIn this case, we can find the principal solution as follows:\n\n$$\n\\begin{aligned}\\operatorname{cos}⁡x & =0 \\\\ x & =\\operatorname{arccos}⁡0 \\\\ x & ={90}^{∘}\\end{aligned}\n$$\n\nSince this value lies inside the desired domain, our first solution is ${x}_{1}={90}^{∘}.$\n\nTo find more solutions, we subtract integer multiples of ${180}^{∘}$ as follows:\n\n$$\n\\begin{aligned}{x}_{2} & ={x}_{1}-{180}^{∘} \\\\  & ={90}^{∘}-{180}^{∘} \\\\  & =-{90}^{∘}\\end{aligned}\n$$\n\nSo, our solutions are $x=-{90}^{∘},{90}^{∘}.$\n\nFinally, the numerical value of ${x}_{1}\\cdot {x}_{2}$ is \n\n$$\n90\\cdot (-90)=-8\\,100.\n$$"}] [{:db/id #edb/ref 17592186348354 :knowledge-point/_questions [{:db/id #edb/ref 17592186124512 :knowledge-point/id #uuid "e73b8bcf-79c2-5326-b396-d7d3e06badaa" :knowledge-point/title "Identifying the Standard Matrix of a Linear Transformation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8f9ea4b3-6eb3-5082-8914-c38bee676387" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}2 & -1 \\\\ 1 & -1\\end{aligned}]" :db/id #edb/ref 17592186346600} {:answer/id #uuid "a81dd2b8-40a6-5066-9db4-1ab9177b5325" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}2 & 1 \\\\ 1 & 1\\end{aligned}]" :db/id #edb/ref 17592186346814} {:answer/id #uuid "d900a914-eda6-5172-8d8d-8f38cd423706" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}2 & 1 \\\\ -1 & -1\\end{aligned}]" :db/id #edb/ref 17592186347264} {:answer/id #uuid "dd36e61a-1034-5c73-9d7e-707ff278bb68" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & 0 \\\\ 0 & 1\\end{aligned}]" :db/id #edb/ref 17592186347291} {:answer/id #uuid "de5af851-d906-5d9f-a62b-f9c3421ec820" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}0 & -1 \\\\ 3 & -1\\end{aligned}]" :db/id #edb/ref 17592186347308}] :answer-field/correct {:answer/id #uuid "8f9ea4b3-6eb3-5082-8914-c38bee676387" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}2 & -1 \\\\ 1 & -1\\end{aligned}]" :db/id #edb/ref 17592186346600} :answer-field/id #uuid "142b7324-aef0-53ea-9091-db8282ddff85" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186347643}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "68c48374-0bdd-59bd-ad8a-c986ebcde36e" :question/math-academy-id "q-8027" :question/problem "Find the standard matrix that  represents  the  linear  transformation $T$, where\n\n$$\nT:[\\begin{aligned}x \\\\ y\\end{aligned}]⟶[\\begin{aligned}2x-y \\\\ x-y\\end{aligned}].\n$$" :question/worked-solution "We require a $2\\times 2$ matrix $T$ such that\n    \n\n$$\nT\\cdot [\\begin{aligned}x \\\\ y\\end{aligned}]=[\\begin{aligned}2\\cdot x+(-1)\\cdot y \\\\ 1\\cdot x+(-1)\\cdot y\\end{aligned}].\n$$\n\nNotice that\n    \n\n$$\n[\\begin{aligned}2 & -1 \\\\ 1 & -1\\end{aligned}]\\cdot [\\begin{aligned}x \\\\ y\\end{aligned}]=[\\begin{aligned}2x-y \\\\ x-y\\end{aligned}].\n$$\n\n    Therefore, the matrix which represents the linear transformation $T$ is\n    \n\n$$\n[\\begin{aligned}2 & -1 \\\\ 1 & -1\\end{aligned}].\n$$"}] [{:db/id #edb/ref 17592186348357 :knowledge-point/_questions [{:db/id #edb/ref 17592186129154 :knowledge-point/id #uuid "a66188f6-3228-59e9-9766-0f9bacbe8443" :knowledge-point/title "Identifying True Statements Regarding the Graph of a Given Polynomial"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2b75e759-23b9-5a00-8a2f-7c0ca516d97a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186345736} {:answer/id #uuid "910cdafc-67fc-587c-87f0-bdba48190064" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186346616} {:answer/id #uuid "b75eed07-3b22-5842-aac1-37ec3c1762bd" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186346950} {:answer/id #uuid "c106e615-06ca-5d4a-9046-a19b20c78b0a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186347019} {:answer/id #uuid "d48896a5-f655-5550-962f-afc68a851fd0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186347213}] :answer-field/correct {:answer/id #uuid "910cdafc-67fc-587c-87f0-bdba48190064" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186346616} :answer-field/id #uuid "b0b44f15-bb40-5519-8a0c-c8353afc8e01" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186347910}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "9e0f13e6-ba4b-56eb-b269-f07bb6ae2732" :question/math-academy-id "q-80303" :question/problem "![](images/0a/0a7b19b50822235a2dcbfcdf74984735a1e26b2b775180b24bdc2bcbf24c588b.png)\n\nThe graph of a polynomial $p(x)$ is shown above. Which of the following statements are true?\n\nI. $x=-2$ is a root of even multiplicity.\n\nII. $x=1$ is **not** a simple root.\n\nIII. $x=1$ is a root of even multiplicity." :question/worked-solution "Let's analyze each statement in turn.\n\n- Statement I is false. The root $x=-2$ has an odd multiplicity because at $x=-2$ the graph passes through the $x$-axis at this point.\n\n- Statement II is true. The root $x=1$ is not a simple root because the graph crosses the $x$-axis at that point, and the curve is tangent to the $x$-axis at that point.\n\n- Statement III is false. The root $x=1$ has an odd multiplicity because at $x=1$ the graph passes through the $x$-axis at this point.\n\nTherefore, the correct answer is \"II only\"."}] [{:db/id #edb/ref 17592186348369 :knowledge-point/_questions [{:db/id #edb/ref 17592186129145 :knowledge-point/id #uuid "4fc09a0f-34d3-5ca9-9964-6cb00498bfa7" :knowledge-point/title "Identifying the Factored Polynomial Shown in a Graph"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "433015c8-b02a-5d3b-9bc4-7270edca0b40" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y={x}^{3}(x+1)(x-2)" :db/id #edb/ref 17592186345929} {:answer/id #uuid "444cadbf-3703-59f5-bad4-46404cc1a695" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y={x}^{2}(x+1){(x-2)}^{2}" :db/id #edb/ref 17592186345940} {:answer/id #uuid "654ada61-08a2-5d34-998b-5c8db9d07e87" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y={x}^{3}(x+1){(x-2)}^{3}" :db/id #edb/ref 17592186346234} {:answer/id #uuid "6dbb7820-ea22-5b52-910b-269aa2f0dbbf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y={x}^{5}{(x+1)}^{2}(x-2)" :db/id #edb/ref 17592186346310} {:answer/id #uuid "f282e323-500b-5dcf-a254-2d713e281555" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=x{(x+1)}^{2}(x-2)" :db/id #edb/ref 17592186347497}] :answer-field/correct {:answer/id #uuid "654ada61-08a2-5d34-998b-5c8db9d07e87" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y={x}^{3}(x+1){(x-2)}^{3}" :db/id #edb/ref 17592186346234} :answer-field/id #uuid "9d5873ca-3084-51bf-9b1d-3de807002492" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186347880}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "ad55c8cb-7248-5482-9f28-0afc365f8908" :question/math-academy-id "q-80348" :question/problem "![](images/8b/8b086759a25af7e464c0c8be78d36cd4d8458c5c25e7c84cb6ecb28b2d59e9df.png)\n\nWhich of the following could be the equation of the polynomial curve shown above?" :question/worked-solution "First, we notice that the function has precisely three distinct roots, $x=-1$, $x=0$ and $x=2.$\n\nBased on the graph, we can make the following conclusions about the multiplicities of the roots:\n\n- Since the graph is *not* tangent to the $x$-axis at $x=-1,$ this root is a simple root (the multiplicity equals $1$).\n\n- Since the graph passes through $x=0,$ this root has odd multiplicity, and since the graph is tangent to the $x$-axis at $x=0,$ the multiplicity must be greater than one.\n\n- Since the graph passes through $x=2,$ this root has odd multiplicity, and since the graph is tangent to the $x$-axis at $x=2,$ the multiplicity must be greater than one.\n\nFrom the given options, the only possible equation is $y={x}^{3}(x+1){(x-2)}^{3}.$"}] [{:db/id #edb/ref 17592186348371 :knowledge-point/_questions [{:db/id #edb/ref 17592186129145 :knowledge-point/id #uuid "4fc09a0f-34d3-5ca9-9964-6cb00498bfa7" :knowledge-point/title "Identifying the Factored Polynomial Shown in a Graph"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7b68fad9-861a-5a5d-b8d5-ff1e2fa15ab7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=-x(x+2)^{7}(x-1)" :db/id #edb/ref 17592186346430} {:answer/id #uuid "8724b35c-787a-52ef-80ff-eaf99f6a667a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=-x(x+2)^{5}(x-1)^{2}" :db/id #edb/ref 17592186346523} {:answer/id #uuid "94213796-5be7-57ae-81b2-17ed395cf18a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=-x(x+2)^{3}(x-1)^{3}" :db/id #edb/ref 17592186346645} {:answer/id #uuid "b2ec07fb-d5b8-585e-82ea-e6c5d87d6e70" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=-{x}^{3}(x+2)^{5}(x-1)" :db/id #edb/ref 17592186346910} {:answer/id #uuid "b5c1df98-76d9-50de-b003-8111fdce77bf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=-{x}^{2}(x+2)(x-1)^{7}" :db/id #edb/ref 17592186346933}] :answer-field/correct {:answer/id #uuid "94213796-5be7-57ae-81b2-17ed395cf18a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=-x(x+2)^{3}(x-1)^{3}" :db/id #edb/ref 17592186346645} :answer-field/id #uuid "db472ae2-2f21-533d-93c0-3a75b3b10cf1" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186347991}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "0154a31e-007f-558f-af24-913ca9813ba7" :question/math-academy-id "q-80352" :question/problem "![](images/19/1956e8c684cc03538877d3ec5d1e72d3d3f48b63341f7739b9a18962b080f1e3.png)\n\nWhich of the following could be the equation of the polynomial curve shown above?" :question/worked-solution "First, we notice that the function has precisely three distinct roots, $x=-2,x=0$ and $x=1.$\n\nBased on the graph, we can make the following conclusions about the multiplicities of the roots:\n\n- Since the graph passes through $x=-2,$ this root has odd multiplicity, and since the graph is tangent to the $x$-axis at $x=-2,$ the multiplicity must be greater than one.\n\n- Since the graph is *not* tangent to the $x$-axis at $x=0,$ this root is a simple root (the multiplicity equals $1$).\n\n- Since the graph passes through $x=1,$ this root has odd multiplicity, and since the graph is tangent to the $x$-axis at $x=1,$ the multiplicity must be greater than one.\n\nFrom the given options, the only possible equation is $y=-x(x+2)^{3}(x-1)^{3}.$"}] [{:db/id #edb/ref 17592186097370 :knowledge-point/_questions [{:db/id #edb/ref 17592186096837 :knowledge-point/id #uuid "9688df89-056e-59d7-869e-9841715b2aea" :knowledge-point/title "Finding the Antiderivative of a Vector-Valued Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a0580506-5e62-5af0-b3e6-9353b6e3a483" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨t^{3},-e^{t}⟩ + C" :db/id #edb/ref 17592186096145} {:answer/id #uuid "ff40ef8b-f310-58f1-8550-e3bacbd522af" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨t^{3}, e^{t}⟩ + C" :db/id #edb/ref 17592186096146} {:answer/id #uuid "078c6504-67e7-59f9-a84a-4f8effd83cd0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨t^{3},-te^{t}⟩ + C" :db/id #edb/ref 17592186096147} {:answer/id #uuid "2fd4ff92-eae2-5a08-baec-0b970b9dc151" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨\\frac{t^{3}}{3}, e^{t}⟩ + C" :db/id #edb/ref 17592186096148} {:answer/id #uuid "521fd3ba-e41e-5d76-b588-35b2fd32cd46" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨3t^{3}, te^{t}⟩ + C" :db/id #edb/ref 17592186096149}] :answer-field/id #uuid "382ef6af-e68a-5f50-9931-43fdb4f90540" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186096144} {:answer-field/choices [{:answer/id #uuid "980abdcc-03e8-5481-8470-6167a822e9b1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨{t}^{3},\\,-t{e}^{t}⟩+C" :db/id #edb/ref 17592186399119} {:answer/id #uuid "57f28662-75ae-5e7c-a727-6cc70f2a946d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨\\frac{{t}^{3}}{3},\\,{e}^{t}⟩+C" :db/id #edb/ref 17592186399120} {:answer/id #uuid "8625a627-3b15-58cf-ba3e-833914e69b06" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨3{t}^{3},\\,t{e}^{t}⟩+C" :db/id #edb/ref 17592186399121} {:answer/id #uuid "f022a8e1-f660-5e62-989c-eb808fd735df" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨{t}^{3},\\,-{e}^{t}⟩+C" :db/id #edb/ref 17592186399122} {:answer/id #uuid "b1bda4bf-9a89-5c13-9d41-84a013832509" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨{t}^{3},\\,{e}^{t}⟩+C" :db/id #edb/ref 17592186399123}] :answer-field/correct {:answer/id #uuid "b1bda4bf-9a89-5c13-9d41-84a013832509" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨{t}^{3},\\,{e}^{t}⟩+C" :db/id #edb/ref 17592186399123} :answer-field/id #uuid "5f4c5d2d-c5b6-5ecd-b722-b08fb64f2522" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186399118}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "22f82dbd-7046-58bc-9a39-900370a35623" :question/math-academy-id "q-80460" :question/problem "If ${F}^{′}(t)=⟨3{t}^{2},\\,{e}^{t}⟩,$ then $F(t)=$" :question/worked-solution "First, we note that \n\n$$\nF(t)=\\int {F}^{′}(t)\\,\\text{d}t=\\int ⟨3{t}^{2},\\,{e}^{t}⟩\\,\\text{d}t.\n$$\n\nTo integrate a vector-valued function, we integrate each component separately. So, we get\n\n$$\n\\begin{aligned}\\int ⟨3{t}^{2},\\,{e}^{t}⟩\\,\\text{d}t & =⟨\\int 3{t}^{2}\\,\\text{d}t,\\,\\int {e}^{t}\\,\\text{d}t⟩ \\\\  & =⟨{t}^{3}+{c}_{1},\\,{e}^{t}+{c}_{2}⟩ \\\\  & =⟨{t}^{3},\\,{e}^{t}⟩+⟨{c}_{1},\\,{c}_{2}⟩ \\\\  & =⟨{t}^{3},\\,{e}^{t}⟩+C,\\end{aligned}\n$$\n\nwhere $C$ is an arbitrary (vector) constant of integration."}] [{:db/id #edb/ref 17592186396183 :knowledge-point/_questions [{:db/id #edb/ref 17592186087751 :knowledge-point/id #uuid "cf99414e-f1cf-528f-adbb-407cf6e82c4c" :knowledge-point/title "Identifying the Linear Transformation Represented by a Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b95051d2-50e5-54f9-a671-a1d798db4c74" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "Dilation with scale factor $\\frac{1}{3}$" :db/id #edb/ref 17592186396185} {:answer/id #uuid "1a07ec2e-4723-50fa-a492-65d833fca2c4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "Reflection across the $y$-axis" :db/id #edb/ref 17592186396186} {:answer/id #uuid "72639a3d-6ded-5b32-8272-74477a63f9ae" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "Dilation with scale factor $3$" :db/id #edb/ref 17592186396187} {:answer/id #uuid "e8825cd3-515a-5a66-ba2f-f64d182752ed" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "Reflection in the line $x=3$" :db/id #edb/ref 17592186396188} {:answer/id #uuid "c2e9ced4-a3e4-50e4-8475-6ffa71f360f3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "Reflection in the line $y=3$" :db/id #edb/ref 17592186396189}] :answer-field/correct {:answer/id #uuid "72639a3d-6ded-5b32-8272-74477a63f9ae" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "Dilation with scale factor $3$" :db/id #edb/ref 17592186396187} :answer-field/id #uuid "daffb22d-4d43-548d-b3e0-44a4cfce0727" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186396184}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "3ddcb294-a508-54d0-bd15-63145db8f082" :question/math-academy-id "q-8054" :question/problem "What linear transformation $T$ is represented by the matrix $T=[\\begin{aligned}3 & 0 \\\\ 0 & 3\\end{aligned}]?$" :question/worked-solution "Recall that a dilation of scale factor $k$ is represented by the matrix\n\n$$\n[\\begin{aligned}k & 0 \\\\ 0 & k\\end{aligned}].\n$$\n\nHere, we have $k=3.$ Therefore, the matrix represents a dilation with a scale factor of $3.$"}] [{:db/id #edb/ref 17592186348431 :knowledge-point/_questions [{:db/id #edb/ref 17592186129188 :knowledge-point/id #uuid "8505beff-75b8-57bf-9312-e0fcf32f44fd" :knowledge-point/title "Using Additivity of Double Integrals"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "134124de-7bb5-583d-8268-6eb3bafe7fbc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-8" :db/id #edb/ref 17592186345518} {:answer/id #uuid "87554a50-11a6-5b25-94e7-2006d6ccdfde" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "28" :db/id #edb/ref 17592186346525} {:answer/id #uuid "a3d87198-8b27-581a-8546-b068e655ed3d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "48" :db/id #edb/ref 17592186346774} {:answer/id #uuid "ecc9ffca-cda6-5a04-bd09-cdffd86a6db8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "40" :db/id #edb/ref 17592186347440} {:answer/id #uuid "f7795d31-183d-5b9e-aef1-882627d90923" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186347543}] :answer-field/correct {:answer/id #uuid "f7795d31-183d-5b9e-aef1-882627d90923" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186347543} :answer-field/id #uuid "3085ef55-d31f-5e6a-9eee-f864976c417f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186347685}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "dfc30ed8-539a-5f2e-be5b-7fef09f28bdd" :question/math-academy-id "q-80657" :question/problem "Given that $C$ and $D$ are finite, non-overlapping regions and that\n\n$$\n{∬}_{C}f(x,y)\\text{ }\\text{d}A=-5,\\,{∬}_{D}f(x,y)\\text{ }\\text{d}A=7,\n$$\n\nfind the value of \n\n$$\n{∬}_{C\\cup D}4f(x,y)\\text{ }\\text{d}A.\n$$" :question/worked-solution "Using the linearity and additivity of double integrals, we get the following:\n\n$$\n\\begin{aligned}{∬}_{C\\cup D}4f(x,y)\\text{ }\\text{d}A & =4{∬}_{C\\cup D}f(x,y)\\text{ }\\text{d}A \\\\  & =4({∬}_{C}f(x,y)\\text{ }\\text{d}A+{∬}_{D}f(x,y)\\text{ }\\text{d}A) \\\\  & =4(-5+7) \\\\  & =8\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186394044 :knowledge-point/_questions [{:db/id #edb/ref 17592186184190 :knowledge-point/id #uuid "a832b1a2-e80e-53d0-bb64-03df0f1a209c" :knowledge-point/title "Obtaining a Higher-Order Derivative Of a Function Given its Higher-Degree Taylor Polynomial"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "87ce0934-02d4-5393-a820-a60747531d26" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1\\,560" :db/id #edb/ref 17592186394046} {:answer/id #uuid "55151c71-8b6d-58eb-a249-4eb4aac0d349" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "484" :db/id #edb/ref 17592186394047} {:answer/id #uuid "7f1eb3bb-51af-5134-8c24-9eaec350677e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "264" :db/id #edb/ref 17592186394048} {:answer/id #uuid "2fb5a83c-3187-5ca1-904d-ee6f8e47bd54" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "312" :db/id #edb/ref 17592186394049} {:answer/id #uuid "11a52e31-0b32-5adb-9e0e-67e9944070c7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1\\,320" :db/id #edb/ref 17592186394050}] :answer-field/correct {:answer/id #uuid "87ce0934-02d4-5393-a820-a60747531d26" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1\\,560" :db/id #edb/ref 17592186394046} :answer-field/id #uuid "303ca5d2-6f56-5888-a948-198bbe7b80f1" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186394045}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "0857096a-6a9d-5a2b-a489-d085d352c19a" :question/math-academy-id "q-80722" :question/problem "The fifth-degree Taylor polynomial of $f(x)$ about $x=-2$ is given by\n\n$$\n{P}_{5}(x)=-3+5(x+2)-7(x+2)^{2}+9(x+2)^{3}-11(x+2)^{4}+13(x+2)^{5}.\n$$\n\nWhat is ${f}^{(5)}(-2)?$" :question/worked-solution "The coefficient of $(x+2)^{5}$ is given by $\\frac{{f}^{(5)}(-2)}{5!}.$ Therefore,\n\n$$\n\\begin{aligned}\\frac{{f}^{(5)}(-2)}{5!} & =13 \\\\ \\frac{{f}^{(5)}(-2)}{120} & =13 \\\\ {f}^{(5)}(-2) & =1\\,560.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186106490 :knowledge-point/_questions [{:db/id #edb/ref 17592186105764 :knowledge-point/id #uuid "3105e8eb-010f-542b-9e40-12fda6ea00e7" :knowledge-point/title "Finding the Standard Matrix of a Stretch Transformation Given a Vector and its Image"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "89f93f56-ac75-57b5-95c1-f90f361f5930" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}6 & 0 \\\\ 0 & 1\\end{bmatrix}" :db/id #edb/ref 17592186105089} {:answer/id #uuid "b33af94e-420f-5cfd-b0af-f118b8697055" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 & 0 \\\\ 0 & 2\\end{bmatrix}" :db/id #edb/ref 17592186105090} {:answer/id #uuid "bf6bae65-78c2-5856-9f0b-163e1c048ff6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}2 & 0 \\\\ 0 & 1\\end{bmatrix}" :db/id #edb/ref 17592186105091} {:answer/id #uuid "fd0d689b-1c5e-51c2-88cc-ac6b5d900a1e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 & 0 \\\\ 0 & 3\\end{bmatrix}" :db/id #edb/ref 17592186105092} {:answer/id #uuid "2aff7b31-5277-574c-afb7-f649464edb91" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}3 & 0 \\\\ 0 & 1\\end{bmatrix}" :db/id #edb/ref 17592186105093}] :answer-field/id #uuid "637d172d-46f4-5b21-8f12-e315dda47530" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186105088} {:answer-field/choices [{:answer/id #uuid "2c397e37-1d42-5efe-81d5-6ff323b2d323" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}3 & 0 \\\\ 0 & 1\\end{aligned}]" :db/id #edb/ref 17592186394052} {:answer/id #uuid "6f6ed60d-2840-53c0-a19c-73a1c38e3ec0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}2 & 0 \\\\ 0 & 1\\end{aligned}]" :db/id #edb/ref 17592186394053} {:answer/id #uuid "38883822-19a8-50c5-ac70-21dd818b00e8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & 0 \\\\ 0 & 3\\end{aligned}]" :db/id #edb/ref 17592186394054} {:answer/id #uuid "75955132-8432-5b46-8ff2-1f131bf31dd6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}6 & 0 \\\\ 0 & 1\\end{aligned}]" :db/id #edb/ref 17592186394055} {:answer/id #uuid "48d10010-6d30-5ed7-a764-671a0140e320" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & 0 \\\\ 0 & 2\\end{aligned}]" :db/id #edb/ref 17592186394056}] :answer-field/correct {:answer/id #uuid "6f6ed60d-2840-53c0-a19c-73a1c38e3ec0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}2 & 0 \\\\ 0 & 1\\end{aligned}]" :db/id #edb/ref 17592186394053} :answer-field/id #uuid "78374675-6ad5-5e77-a243-9ee8ff3a2a6d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186394051}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "85f5eecb-79b7-5107-8347-e7d15fcb457b" :question/math-academy-id "q-80726" :question/problem "A linear transformation $T$ represents a stretch along the $x$-axis or $y$-axis. Given that $v=[\\begin{aligned}3 \\\\ -2\\end{aligned}]$ and $T(v)=[\\begin{aligned}6 \\\\ -2\\end{aligned}],$ what is the standard matrix of $T?$" :question/worked-solution "First, we are told that $T$ represents a stretch along the $x$-axis or $y$-axis.\n\nComparing the $x$- and $y$-components of $v$ and $T(v),$ we note the following:\n\n- the $x$-component of $T(v)$ is $2$ times the $x$-component of $v,$ while\n\n- the $y$-components of $v$ and $T(v)$ are the same.\n\nSo, we conclude that $T$ represents a stretch of scale factor $2$ in the $x$-direction. \n\nTherefore, the standard matrix of $T$ is\n\n$$\nT=[\\begin{aligned}2 & 0 \\\\ 0 & 1\\end{aligned}].\n$$"}] [{:db/id #edb/ref 17592186348446 :knowledge-point/_questions [{:db/id #edb/ref 17592186087735 :knowledge-point/id #uuid "01caf021-de3e-5e2a-89ce-ba289b65c0ff" :knowledge-point/title "Writing a Complex Number in Exponential Form"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "03d37a5d-f38e-5e9f-b4c2-8557a961d8e8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "z=\\sqrt{17}\\,{\\text{e}}^{6.086\\,\\text{i}}" :db/id #edb/ref 17592186345385} {:answer/id #uuid "21e41ad5-4ee1-5fe7-b639-bc9b977dc4fd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "z=\\sqrt{17}\\,{\\text{e}}^{3.338\\,\\text{i}}" :db/id #edb/ref 17592186345653} {:answer/id #uuid "2f556611-9499-54a3-9131-95ba2cbf06c2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "z=\\sqrt{26}\\,{\\text{e}}^{6.086\\,\\text{i}}" :db/id #edb/ref 17592186345767} {:answer/id #uuid "a3665dd9-b15a-5d76-8f3c-92d873804b55" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "z=\\sqrt{26}\\,{\\text{e}}^{3.338\\,\\text{i}}" :db/id #edb/ref 17592186346766} {:answer/id #uuid "d8ae151a-4d90-50cb-ad3c-f2ecfc64dcc9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "z=\\sqrt{26}\\,{\\text{e}}^{4.989\\,\\text{i}}" :db/id #edb/ref 17592186347261}] :answer-field/correct {:answer/id #uuid "2f556611-9499-54a3-9131-95ba2cbf06c2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "z=\\sqrt{26}\\,{\\text{e}}^{6.086\\,\\text{i}}" :db/id #edb/ref 17592186345767} :answer-field/id #uuid "e647b151-d969-5d70-9827-bf43ae96b615" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186348007}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "0a752e22-d98b-55fa-871d-a83c493259aa" :question/math-academy-id "q-8076" :question/problem "Write the complex number $z=5-\\text{i}$ in the form $r{e}^{\\text{i}\\theta },$ giving $\\theta $ in radians to $3$ decimal places." :question/worked-solution "To write our complex number in the form $z=r{\\text{e}}^{\\text{i}\\theta },$ where $r=|z|$ and $\\theta =\\operatorname{arg}⁡(z),$ we first calculate $r:$\n\n$$\n\\begin{aligned}r=|z| & =\\sqrt{{x}^{2}+{y}^{2}} \\\\  & =\\sqrt{{5}^{2}+(-1)^{2}} \\\\  & =\\sqrt{26}\\end{aligned}\n$$\n\nNow, since $z$ lies in the fourth quadrant, we can find the angle $\\theta $ as\n\n$$\n\\begin{aligned}\\theta =\\operatorname{arg}⁡(z) & =2\\pi -|\\operatorname{arctan}⁡(\\frac{y}{x})| \\\\  & =2\\pi -|\\operatorname{arctan}⁡(\\frac{-1}{5})| \\\\  & =2\\pi -|\\operatorname{arctan}⁡(-\\frac{1}{5})| \\\\  & ≈2\\pi -0.197\\,39… \\\\  & ≈6.086.\\end{aligned}\n$$\n\nFinally, substituting $r=\\sqrt{26}$ and $\\theta =6.086$ into $z=r{e}^{\\text{i}\\theta },$ we get\n\n$$\nz=\\sqrt{26}\\,{\\text{e}}^{6.086\\,\\text{i}}.\n$$"}] [{:db/id #edb/ref 17592186373250 :knowledge-point/_questions [{:db/id #edb/ref 17592186087735 :knowledge-point/id #uuid "01caf021-de3e-5e2a-89ce-ba289b65c0ff" :knowledge-point/title "Writing a Complex Number in Exponential Form"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1d7e6bee-930b-58e5-9902-60f3461386bc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "z=\\sqrt{2}\\,{\\text{e}}^{7\\pi \\text{i}/4}" :db/id #edb/ref 17592186373252} {:answer/id #uuid "4c342a2b-d916-53f7-a9d8-c2ab2e7c2311" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "z=\\sqrt{2}\\,{\\text{e}}^{5\\pi \\text{i}/4}" :db/id #edb/ref 17592186373253} {:answer/id #uuid "b81c73e2-cfb2-59ad-a7d9-25f41eadbcc9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "z=2\\sqrt{2}\\,{\\text{e}}^{\\pi \\text{i}/4}" :db/id #edb/ref 17592186373254} {:answer/id #uuid "e2330104-a769-597a-b5ae-98ab87dc43b2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "z=2\\sqrt{2}\\,{\\text{e}}^{7\\pi \\text{i}/4}" :db/id #edb/ref 17592186373255} {:answer/id #uuid "5579d141-794d-5790-8ca2-1a59cd2b9529" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "z=2\\sqrt{2}\\,{\\text{e}}^{5\\pi \\text{i}/4}" :db/id #edb/ref 17592186373256}] :answer-field/correct {:answer/id #uuid "e2330104-a769-597a-b5ae-98ab87dc43b2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "z=2\\sqrt{2}\\,{\\text{e}}^{7\\pi \\text{i}/4}" :db/id #edb/ref 17592186373255} :answer-field/id #uuid "03f91cb2-48b9-5a8d-938e-53bc25c6e30a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186373251}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "4b29385a-7bac-596f-b9c2-4aa83fc8914b" :question/math-academy-id "q-8077" :question/problem "Write the complex number $z=2-2\\text{i}$ in exponential form." :question/worked-solution "To write our complex number in the form $z=r{\\text{e}}^{\\text{i}\\theta },$ where $r=|z|$ and $\\theta =\\operatorname{arg}⁡(z),$ we first calculate $r:$\n\n$$\n\\begin{aligned}r=|z| & =\\sqrt{{x}^{2}+{y}^{2}} \\\\  & =\\sqrt{{2}^{2}+(-2)^{2}} \\\\  & =\\sqrt{8}=2\\sqrt{2}\\end{aligned}\n$$\n\nNow, since $z$ lies in the fourth quadrant, we can find the angle $\\theta $ as\n\n$$\n\\begin{aligned}\\theta =\\operatorname{arg}⁡(z) & =2\\pi -|\\operatorname{arctan}⁡(\\frac{y}{x})| \\\\  & =2\\pi -|\\operatorname{arctan}⁡(\\frac{-2}{2})| \\\\  & =2\\pi -|\\operatorname{arctan}⁡(-1)| \\\\  & =2\\pi -\\frac{\\pi }{4} \\\\  & =\\frac{7\\pi }{4}.\\end{aligned}\n$$\n\nFinally, substituting $r=2\\sqrt{2}$ and $\\theta =\\frac{7\\pi }{4}$ into $z=r{e}^{\\text{i}\\theta },$ we get\n\n$$\nz=2\\sqrt{2}\\,{\\text{e}}^{7\\pi \\text{i}/4}.\n$$"}]}
