710} {:answer/id #uuid "da3de159-0af1-5109-a432-7a259afa945f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{5}\\,\\text{arcsec}(\\sqrt{5}x)+C" :db/id #edb/ref 17592186249353} {:answer/id #uuid "f5ce8cb5-8424-5bdb-b48e-afc1856f992f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\text{arcsec}(5x)+C" :db/id #edb/ref 17592186249568}] :answer-field/correct {:answer/id #uuid "2557c8c9-61d4-546a-b12e-2149e3cb0784" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\text{arcsec}(\\sqrt{5}x)+C" :db/id #edb/ref 17592186247753} :answer-field/id #uuid "5bb9394d-1677-5845-bcf1-c7fd75b784b5" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186249835}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "721577ab-4fa8-5463-8c74-5d6cebd1decf" :question/math-academy-id "q-114051" :question/problem "Calculate $\\int \\frac{1}{|x|\\sqrt{5{x}^{2}-1}}\\,\\text{d}x.$" :question/worked-solution "Note that we can rewrite this integral as\n\n$$\n\\int \\frac{\\text{d}x}{|x|\\sqrt{5{x}^{2}-1}}=\\int \\frac{\\sqrt{5}}{|\\sqrt{5}x|\\sqrt{(\\sqrt{5}x)^{2}-1}}\\text{d}x.\n$$\n\nThis integral now resembles the basic one for $\\text{arcsec},$\n\n$$\n\\int \\frac{1}{|u|\\sqrt{{u}^{2}-1}}\\text{d}u=\\text{arcsec}(u)+C.\n$$\n\nThe only difference is that instead of $u$ as the variable, we have $\\sqrt{5}x.$\n\nSo, let's substitute $u=\\sqrt{5}x.$ Differentiating, we get\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=\\sqrt{5}\\,⟹\\,\\text{d}x=\\frac{1}{\\sqrt{5}}\\text{d}u.\n$$\n\nUsing the above, we can write the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}\\begin{aligned}\\int \\frac{1}{|x|\\sqrt{5{x}^{2}-1}}\\,\\text{d}x & =\\int \\frac{\\sqrt{5}}{|\\sqrt{5}x|\\sqrt{(\\sqrt{5}x)^{2}-1}}\\,\\text{d}x \\\\  & =\\sqrt{5}\\int \\frac{1}{|u|\\sqrt{{u}^{2}-1}}\\cdot (\\frac{1}{\\sqrt{5}}\\text{d}u) \\\\  & =\\sqrt{5}\\cdot \\frac{1}{\\sqrt{5}}\\int \\frac{\\text{d}u}{|u|\\sqrt{{u}^{2}-1}} \\\\  & =\\text{arcsec }u+C \\\\  & =\\text{arcsec}(\\sqrt{5}x)+C\\end{aligned}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186250174 :knowledge-point/_questions [{:db/id #edb/ref 17592186064250 :knowledge-point/id #uuid "8d18bdc7-9387-5b2d-98bd-015fa4a1eba7" :knowledge-point/title "Calculating Indefinite Integrals Using Substitution with Inverse Secant"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4d1c680b-da3e-532e-b768-23a73eed1830" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{2}\\,\\text{arcsec}(x)+C" :db/id #edb/ref 17592186248115} {:answer/id #uuid "76b64e00-cc9d-56bb-96a5-6ed308000d0f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\text{arcsec}(\\frac{x}{\\sqrt{2}})+C" :db/id #edb/ref 17592186248469} {:answer/id #uuid "81a2d087-34bd-5b98-b3f9-540414b7de9a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\text{arcsec}(\\sqrt{2}x)+C" :db/id #edb/ref 17592186248571} {:answer/id #uuid "a16a9266-9795-55dc-8015-252092435b4f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{2}\\,\\text{arcsec}(\\sqrt{2}x)+C" :db/id #edb/ref 17592186248867} {:answer/id #uuid "f738a875-32bb-5a84-9c85-9b96cb51105b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\,\\text{arcsec}(\\sqrt{2}x)+C" :db/id #edb/ref 17592186249583}] :answer-field/correct {:answer/id #uuid "81a2d087-34bd-5b98-b3f9-540414b7de9a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\text{arcsec}(\\sqrt{2}x)+C" :db/id #edb/ref 17592186248571} :answer-field/id #uuid "1add6643-9b56-5600-a0e9-cb809f1a9078" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186249716}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "087bd91d-1f6c-594e-8ca6-46ed6f38b1d4" :question/math-academy-id "q-114052" :question/problem "Calculate $\\int \\frac{1}{|x|\\sqrt{2{x}^{2}-1}}\\,\\text{d}x.$" :question/worked-solution "Note that we can rewrite this integral as\n\n$$\n\\int \\frac{\\text{d}x}{|x|\\sqrt{2{x}^{2}-1}}=\\int \\frac{\\sqrt{2}}{|\\sqrt{2}x|\\sqrt{(\\sqrt{2}x)^{2}-1}}\\text{d}x.\n$$\n\nThis integral now resembles the basic one for $\\text{arcsec},$\n\n$$\n\\int \\frac{1}{|u|\\sqrt{{u}^{2}-1}}\\text{d}u=\\text{arcsec}(u)+C.\n$$\n\nThe only difference is that instead of $u$ as the variable, we have $\\sqrt{2}x.$\n\nSo, let's substitute $u=\\sqrt{2}x.$ Differentiating, we get\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=\\sqrt{2}\\,⟹\\,\\text{d}x=\\frac{1}{\\sqrt{2}}\\text{d}u.\n$$\n\nUsing the above, we can write the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}\\begin{aligned}\\int \\frac{1}{|x|\\sqrt{2{x}^{2}-1}}\\,\\text{d}x & =\\int \\frac{\\sqrt{2}}{|\\sqrt{2}x|\\sqrt{(\\sqrt{2}x)^{2}-1}}\\,\\text{d}x \\\\  & =\\sqrt{2}\\int \\frac{1}{|u|\\sqrt{{u}^{2}-1}}\\cdot (\\frac{1}{\\sqrt{2}}\\text{d}u) \\\\  & =\\sqrt{2}\\cdot \\frac{1}{\\sqrt{2}}\\int \\frac{\\text{d}u}{|u|\\sqrt{{u}^{2}-1}} \\\\  & =\\text{arcsec }u+C \\\\  & =\\text{arcsec}(\\sqrt{2}x)+C\\end{aligned}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186250175 :knowledge-point/_questions [{:db/id #edb/ref 17592186064250 :knowledge-point/id #uuid "8d18bdc7-9387-5b2d-98bd-015fa4a1eba7" :knowledge-point/title "Calculating Indefinite Integrals Using Substitution with Inverse Secant"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "30f7223b-3eec-5940-8deb-7bc6e19cac0d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\text{arcsec}(\\frac{x}{\\sqrt{3}})+C" :db/id #edb/ref 17592186247868} {:answer/id #uuid "3d76b2e3-b64f-5ff7-9e80-9f8479c9c899" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\text{arcsec}(\\sqrt{3}x)+C" :db/id #edb/ref 17592186247967} {:answer/id #uuid "9bd42595-09d2-528a-bd27-8cbc87ecbf1d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{3}}{3}\\text{arcsec}(x)+C" :db/id #edb/ref 17592186248810} {:answer/id #uuid "def281e2-ae26-5545-95a5-a8332aa49347" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\text{arcsec}(3x)+C" :db/id #edb/ref 17592186249402} {:answer/id #uuid "f9f3a636-5c31-5b0d-9342-5cf8e8d5dd79" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{3}\\,\\text{arcsec}(x)+C" :db/id #edb/ref 17592186249601}] :answer-field/correct {:answer/id #uuid "3d76b2e3-b64f-5ff7-9e80-9f8479c9c899" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\text{arcsec}(\\sqrt{3}x)+C" :db/id #edb/ref 17592186247967} :answer-field/id #uuid "ad6f5e31-fa19-5c0b-8277-0506de476581" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186249977}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "c9656774-7502-5500-b821-e655b8cd94a0" :question/math-academy-id "q-114053" :question/problem "Calculate $\\int \\frac{1}{|x|\\sqrt{3{x}^{2}-1}}\\,\\text{d}x.$" :question/worked-solution "Note that we can rewrite this integral as\n\n$$\n\\int \\frac{\\text{d}x}{|x|\\sqrt{3{x}^{2}-1}}=\\int \\frac{\\sqrt{3}}{|\\sqrt{3}x|\\sqrt{(\\sqrt{3}x)^{2}-1}}\\text{d}x.\n$$\n\nThis integral now resembles the basic one for $\\text{arcsec},$\n\n$$\n\\int \\frac{1}{|u|\\sqrt{{u}^{2}-1}}\\text{d}u=\\text{arcsec}(u)+C.\n$$\n\nThe only difference is that instead of $u$ as the variable, we have $\\sqrt{3}x.$\n\nSo, let's substitute $u=\\sqrt{3}x.$ Differentiating, we get\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=\\sqrt{3}\\,⟹\\,\\text{d}x=\\frac{1}{\\sqrt{3}}\\text{d}u.\n$$\n\nUsing the above, we can write the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}\\begin{aligned}\\int \\frac{1}{|x|\\sqrt{3{x}^{2}-1}}\\,\\text{d}x & =\\int \\frac{\\sqrt{3}}{|\\sqrt{3}x|\\sqrt{(\\sqrt{3}x)^{2}-1}}\\,\\text{d}x \\\\  & =\\sqrt{3}\\int \\frac{1}{|u|\\sqrt{{u}^{2}-1}}\\cdot (\\frac{1}{\\sqrt{3}}\\text{d}u) \\\\  & =\\sqrt{3}\\cdot \\frac{1}{\\sqrt{3}}\\int \\frac{\\text{d}u}{|u|\\sqrt{{u}^{2}-1}} \\\\  & =\\text{arcsec }u+C \\\\  & =\\text{arcsec}(\\sqrt{3}x)+C\\end{aligned}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186250176 :knowledge-point/_questions [{:db/id #edb/ref 17592186064250 :knowledge-point/id #uuid "8d18bdc7-9387-5b2d-98bd-015fa4a1eba7" :knowledge-point/title "Calculating Indefinite Integrals Using Substitution with Inverse Secant"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "00c4a36b-1ea2-5c73-8a8e-897727eb8f12" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{6}}{6}\\,\\text{arcsec}(x)+C" :db/id #edb/ref 17592186247419} {:answer/id #uuid "1a99f5d4-adb5-558f-ab9d-871641a6895a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\text{arcsec}(\\sqrt{6}x)+C" :db/id #edb/ref 17592186247666} {:answer/id #uuid "473a1c85-0e25-55e8-9960-af9d6576e38d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6\\,\\text{arcsec}(\\sqrt{6}x)+C" :db/id #edb/ref 17592186248058} {:answer/id #uuid "612053c7-5fa5-581e-863a-77db7fe44da7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\text{arcsec}(\\frac{x}{\\sqrt{6}})+C" :db/id #edb/ref 17592186248304} {:answer/id #uuid "96a16219-09aa-5a3c-a6f7-b42ee02e1ec9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{6}\\,\\text{arcsec}(x)+C" :db/id #edb/ref 17592186248763}] :answer-field/correct {:answer/id #uuid "1a99f5d4-adb5-558f-ab9d-871641a6895a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\text{arcsec}(\\sqrt{6}x)+C" :db/id #edb/ref 17592186247666} :answer-field/id #uuid "8b28b499-c249-529d-8a2e-50e60f8a5000" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186249914}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "52263483-2d46-5846-98c2-2820b778b176" :question/math-academy-id "q-114054" :question/problem "Calculate $\\int \\frac{1}{|x|\\sqrt{6{x}^{2}-1}}\\,\\text{d}x.$" :question/worked-solution "Note that we can rewrite this integral as\n\n$$\n\\int \\frac{\\text{d}x}{|x|\\sqrt{6{x}^{2}-1}}=\\int \\frac{\\sqrt{6}}{|\\sqrt{6}x|\\sqrt{(\\sqrt{6}x)^{2}-1}}\\text{d}x.\n$$\n\nThis integral now resembles the basic one for $\\text{arcsec},$\n\n$$\n\\int \\frac{1}{|u|\\sqrt{{u}^{2}-1}}\\text{d}u=\\text{arcsec}(u)+C.\n$$\n\nThe only difference is that instead of $u$ as the variable, we have $\\sqrt{6}x.$\n\nSo, let's substitute $u=\\sqrt{6}x.$ Differentiating, we get\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=\\sqrt{6}\\,⟹\\,\\text{d}x=\\frac{1}{\\sqrt{6}}\\text{d}u.\n$$\n\nUsing the above, we can write the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}\\begin{aligned}\\int \\frac{1}{|x|\\sqrt{6{x}^{2}-1}}\\,\\text{d}x & =\\int \\frac{\\sqrt{6}}{|\\sqrt{6}x|\\sqrt{(\\sqrt{6}x)^{2}-1}}\\,\\text{d}x \\\\  & =\\sqrt{6}\\int \\frac{1}{|u|\\sqrt{{u}^{2}-1}}\\cdot (\\frac{1}{\\sqrt{6}}\\text{d}u) \\\\  & =\\sqrt{6}\\cdot \\frac{1}{\\sqrt{6}}\\int \\frac{\\text{d}u}{|u|\\sqrt{{u}^{2}-1}} \\\\  & =\\text{arcsec }u+C \\\\  & =\\text{arcsec}(\\sqrt{6}x)+C\\end{aligned}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186250180 :knowledge-point/_questions [{:db/id #edb/ref 17592186064285 :knowledge-point/id #uuid "51c15d7a-cd9c-58df-a750-97df0b695c64" :knowledge-point/title "Determining Intervals of Concavity From the Graph of a Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "00bb67d8-490a-5026-b8f6-d6d24d823e00" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$(0,1)$ and $(1,2)$" :db/id #edb/ref 17592186247417} {:answer/id #uuid "5c4bf796-d261-59b3-9d46-6345ce3a0508" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(2,3)" :db/id #edb/ref 17592186248262} {:answer/id #uuid "7a5f9851-c043-551b-ad46-3cc760c90e4c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(1,2)" :db/id #edb/ref 17592186248502} {:answer/id #uuid "a043d6bf-bf98-51e8-aeba-9de9d8535962" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(0,1)" :db/id #edb/ref 17592186248856} {:answer/id #uuid "f9a6cf01-cfd8-5038-b6ae-d2bd20d22650" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$(0,1)$ and $(2,3)$" :db/id #edb/ref 17592186249599}] :answer-field/correct {:answer/id #uuid "5c4bf796-d261-59b3-9d46-6345ce3a0508" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(2,3)" :db/id #edb/ref 17592186248262} :answer-field/id #uuid "c9466d60-ac02-5100-9e92-8f9eb453bc31" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186250016}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "c0c20158-ed7a-5907-95b8-7188f2ee33e1" :question/math-academy-id "q-114058" :question/problem "![](images/2c/2c9a731594d1c6a781543b5e5fad5b14e7905848ccf1d695cf2019bc931a8e78.png)\n\nThe graph above shows the function $y=f(x),$ defined on $[0,3].$ Find the intervals on which the function $f(x)$ is concave up." :question/worked-solution "The concavity of a function refers to the direction in which its graph curves.\n\n- If the graph curves upward, like a \"smile\" ($⌣$), then the graph is said to be *concave up*.\n\n- If the graph curves downward, like a \"frown\" ($⌢$), then the graph is said to be *concave down*.\n\nIt's helpful to remember the mnemonic \"concave down like a frown.\"\n\nWe can see that the function is curved upwards like a smile ($⌣$) over the interval $(2,3).$\n\n![](images/ec/ece77074a3d712b76ed55150910382ed5c0bb1ddf7d565bc2d2200a72394c4b1.png)"}] [{:db/id #edb/ref 17592186250181 :knowledge-point/_questions [{:db/id #edb/ref 17592186184152 :knowledge-point/id #uuid "d1b60735-9dae-5c23-991d-0241c208b1b7" :knowledge-point/title "Determining the Intervals of Concavity Given the Graph of the Second Derivative"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "26a67bc7-68a7-5819-a1c3-3a2bee77d521" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$(-\\infty ,-1)$ and  $(1,\\infty )$" :db/id #edb/ref 17592186247764} {:answer/id #uuid "3e41e42e-aea1-5df8-bf0e-9b00839675d3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(0,\\infty )" :db/id #edb/ref 17592186247975} {:answer/id #uuid "c72c297b-4901-5799-8ee6-ee138e527b52" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$(-1,0)$ and  $(0,1)$" :db/id #edb/ref 17592186249193} {:answer/id #uuid "cf5df821-8861-57b4-bf12-83159b4ff353" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-\\infty ,0)" :db/id #edb/ref 17592186249264} {:answer/id #uuid "dedf76cf-6c26-5c28-b590-5d8566d217cd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(0,1)" :db/id #edb/ref 17592186249401}] :answer-field/correct {:answer/id #uuid "c72c297b-4901-5799-8ee6-ee138e527b52" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$(-1,0)$ and  $(0,1)$" :db/id #edb/ref 17592186249193} :answer-field/id #uuid "5afa44c7-6905-57b5-a787-f25f359b6054" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186249833}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "ea7eabda-14a0-5474-9217-5f81cc639ac5" :question/math-academy-id "q-114060" :question/problem "![](images/c5/c528a8bdbb9bc6dd1a9895109fdc6818b70787c5024c78e06e2d2ec3997777d6.png)\n\nThe graph above shows $y={f}^{″}(x).$ Find the intervals on which the function $f(x)$ is concave up." :question/worked-solution "A function $f(x)$ is concave up over an interval $(a,b)$ if ${f}^{″}(x)>0$ for all $x\\in (a,b).$\n\nOn the given graph of $y={f}^{″}(x),$ we can see that ${f}^{″}(x)>0$ on the intervals  $(-1,0)$ and  $(0,1).$  Therefore, the function $f(x)$ is concave up on the intervals  $(-1,0)$ and  $(0,1).$"}] [{:db/id #edb/ref 17592186250186 :knowledge-point/_questions [{:db/id #edb/ref 17592186064220 :knowledge-point/id #uuid "f2f9806d-3a72-5f0a-a6f4-db8dad8871f6" :knowledge-point/title "Calculating Definite Integrals Using Substitution with Inverse Trigonometric Functions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "012323fc-4e7b-5948-bd33-ac6535cdacea" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\pi }{3}" :db/id #edb/ref 17592186247423} {:answer/id #uuid "275108dc-ba21-516f-8c42-bd8bf8d71064" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\pi }{8}" :db/id #edb/ref 17592186247772} {:answer/id #uuid "3ab5218b-e36e-59ff-8b03-f71a3f5c4374" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\pi }{24}" :db/id #edb/ref 17592186247944} {:answer/id #uuid "82b6c265-2f3d-5dbe-b622-87847517b9ff" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3\\pi }{8}" :db/id #edb/ref 17592186248580} {:answer/id #uuid "afcf5a5d-6b1c-5e07-b91a-41eca607a863" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{8\\pi }{3}" :db/id #edb/ref 17592186249002}] :answer-field/correct {:answer/id #uuid "afcf5a5d-6b1c-5e07-b91a-41eca607a863" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{8\\pi }{3}" :db/id #edb/ref 17592186249002} :answer-field/id #uuid "f5f84de4-1a81-5ce2-ac8e-5901c4a2a352" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186250104}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "c216ad6d-32f4-5235-ae6f-6f4e1e6db054" :question/math-academy-id "q-114080" :question/problem "Evaluate the integral ${\\int }_{0}^{\\sqrt{3}}\\frac{8}{\\sqrt{4-{x}^{2}}}\\,\\text{d}x.$" :question/worked-solution "Let's rewrite our integral as follows:\n\n$$\n\\begin{aligned}{\\int }_{0}^{\\sqrt{3}}\\frac{8}{\\sqrt{4-{x}^{2}}}\\,\\text{d}x & =8{\\int }_{0}^{\\sqrt{3}}\\frac{1}{\\sqrt{4\\cdot (1-{x}^{2}/4)}}\\,\\text{d}x \\\\  & =\\frac{8}{2}{\\int }_{0}^{\\sqrt{3}}\\frac{1}{\\sqrt{1-{x}^{2}/4}}\\,\\text{d}x \\\\  & =4{\\int }_{0}^{\\sqrt{3}}\\frac{1}{\\sqrt{1-(x/2)^{2}}}\\,\\text{d}x\\end{aligned}\n$$\n\n \n\nThis integral resembles the basic integral for inverse sine,\n\n$$\n\\int \\frac{1}{\\sqrt{1-{u}^{2}}}\\text{d}u=\\operatorname{arcsin}⁡(u)+C.\n$$\n\nThe only difference is that instead of ${u}^{2}$ as the variable, we have ${(\\frac{x}{2})}^{2}.$\n\nSo, let's substitute $u=\\frac{x}{2}.$ Differentiating, we get \n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=\\frac{1}{2}\\,⟹\\,\\text{d}x=2\\,\\text{d}u.\n$$\n\nBefore substituting, we use the table below to change the limits from $x$ to $u.$\n\n| $x$ | $0$ | $\\sqrt{3}$ |\n| --- | --- | --- |\n| $u$ | $0$ | $\\frac{\\sqrt{3}}{2}$ |\n\nUsing the above, we can now write the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}{\\int }_{0}^{\\sqrt{3}}\\frac{8}{\\sqrt{4-{x}^{2}}}\\,\\text{d}x & =4{\\int }_{0}^{\\sqrt{3}}\\frac{1}{\\sqrt{1-(x/2)^{2}}}\\,\\text{d}x \\\\  & =4{\\int }_{0}^{\\sqrt{3}/2}\\frac{1}{\\sqrt{1-{u}^{2}}}\\cdot (2\\,\\text{d}u) \\\\  & =8{\\int }_{0}^{\\sqrt{3}/2}\\frac{\\text{d}u}{\\sqrt{1-{u}^{2}}} \\\\  & =8\\operatorname{arcsin}⁡u{|}_{0}^{\\sqrt{3}/2} \\\\  & =8(\\operatorname{arcsin}⁡(\\frac{\\sqrt{3}}{2})-\\operatorname{arcsin}⁡(0)) \\\\  & =8(\\frac{\\pi }{3}-0) \\\\  & =\\frac{8\\pi }{3}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186250190 :knowledge-point/_questions [{:db/id #edb/ref 17592186078427 :knowledge-point/id #uuid "9693b76e-ba77-5314-bfbf-508b25bb1072" :knowledge-point/title "Evaluating a Definite Integral Given Integrals Over Adjacent Intervals"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1d4dade8-c306-59e4-8ab6-e64611a9e211" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-9" :db/id #edb/ref 17592186247683} {:answer/id #uuid "443f63f9-3b65-5679-822f-2f35b8463109" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186248033} {:answer/id #uuid "6b3ca7fb-1eff-56ad-8a61-b56c8914484f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186248376} {:answer/id #uuid "9775d4fa-e3a2-5916-bc76-53f1ed511a27" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-6" :db/id #edb/ref 17592186248774} {:answer/id #uuid "ab6739de-e79f-5a5f-b0c0-8d9dac58bc72" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186248947}] :answer-field/correct {:answer/id #uuid "1d4dade8-c306-59e4-8ab6-e64611a9e211" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-9" :db/id #edb/ref 17592186247683} :answer-field/id #uuid "9b1daf3a-4032-523b-95ec-f077f7015543" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186249943}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "5bcf812a-16bf-5de3-9c19-83208c1eff9c" :question/math-academy-id "q-114135" :question/problem "Given that ${\\int }_{3}^{4}f(x)\\,\\text{d}x=8$ and ${\\int }_{4}^{6}f(x)\\,\\text{d}x=4,$ then what is ${\\int }_{3}^{6}(5-2f(x))\\,\\text{d}x?$" :question/worked-solution "From the adjacent intervals rule, we know that\n\n$$\n\\begin{aligned}{\\int }_{3}^{4}f(x)\\,\\text{d}x+{\\int }_{4}^{6}f(x)\\,\\text{d}x={\\int }_{3}^{6}f(x)\\,\\text{d}x.\\end{aligned}\n$$\n\nPlugging in the known information into the above gives the following:\n\n$$\n\\begin{aligned}8+4 & ={\\int }_{3}^{6}f(x)\\,\\text{d}x \\\\ 12 & ={\\int }_{3}^{6}f(x)\\,\\text{d}x\\end{aligned}\n$$\n\nFinally, we compute the desired integral and get\n\n$$\n\\begin{aligned}{\\int }_{3}^{6}(5-2f(x))\\,\\text{d}x & =5{\\int }_{3}^{6}\\text{d}x-2{\\int }_{3}^{6}f(x)\\,\\text{d}x \\\\  & =5\\cdot x\\,{|}_{3}^{6}-2\\cdot 12 \\\\  & =5(6-3)-24 \\\\  & =5(3)-24 \\\\  & =-9.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186250192 :knowledge-point/_questions [{:db/id #edb/ref 17592186078428 :knowledge-point/id #uuid "1d752aac-6187-595d-8818-b0179fd7380e" :knowledge-point/title "Evaluating a Definite Integral Using Multiple Properties of Definite Integrals"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "160d12d8-38e1-5609-a441-2a225c1e71a3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2}{3}" :db/id #edb/ref 17592186247622} {:answer/id #uuid "20471a4e-c2c9-53d3-a62b-5ed8c6ec88ce" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186247708} {:answer/id #uuid "66404d0d-fd54-54bc-963f-980ca82233a1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{11}{3}" :db/id #edb/ref 17592186248344} {:answer/id #uuid "dd0eccb1-183e-5cda-8bbc-ee1e1c27ce9b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{7}{3}" :db/id #edb/ref 17592186249384} {:answer/id #uuid "e110522d-baf8-5a97-ac74-0339d4c806c6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186249415}] :answer-field/correct {:answer/id #uuid "dd0eccb1-183e-5cda-8bbc-ee1e1c27ce9b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{7}{3}" :db/id #edb/ref 17592186249384} :answer-field/id #uuid "34ea07a0-e03c-50f6-9fba-de7f207142ee" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186249766}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "ee7add6e-880a-5bf1-914a-15e4c6c7c466" :question/math-academy-id "q-114143" :question/problem "Suppose that $f(x)$ is a function such that ${\\int }_{8}^{5}3f(x)\\,\\text{d}x=-2$ and ${\\int }_{3}^{5}f(x)\\,\\text{d}x=-3.$ What is the value of ${\\int }_{3}^{8}f(x)\\,\\text{d}x?$" :question/worked-solution "Let's simplify one of the given integrals:\n\n$$\n\\begin{aligned}{\\int }_{8}^{5}3f(x)\\,\\text{d}x & =-2 \\\\ 3{\\int }_{8}^{5}f(x)\\,\\text{d}x & =-2 \\\\ -3{\\int }_{5}^{8}f(x)\\,\\text{d}x & =-2 \\\\ {\\int }_{5}^{8}f(x)\\,\\text{d}x & =\\frac{2}{3}\\end{aligned}\n$$\n\nThen, from the adjacent intervals rule, we get\n\n$$\n\\begin{aligned}{\\int }_{3}^{8}f(x)\\,\\text{d}x & ={\\int }_{3}^{5}f(x)\\,\\text{d}x+{\\int }_{5}^{8}f(x)\\,\\text{d}x \\\\  & =-3+\\frac{2}{3} \\\\  & =-\\frac{7}{3}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186250193 :knowledge-point/_questions [{:db/id #edb/ref 17592186078428 :knowledge-point/id #uuid "1d752aac-6187-595d-8818-b0179fd7380e" :knowledge-point/title "Evaluating a Definite Integral Using Multiple Properties of Definite Integrals"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4a2971b4-0f86-59a4-b5f1-da6e81b8c7de" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186248086} {:answer/id #uuid "8f3d81dc-d466-5734-94a6-5f005fd31f83" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-12" :db/id #edb/ref 17592186248698} {:answer/id #uuid "9756cdbe-a743-5718-a2df-d2e7c3028c7e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186248772} {:answer/id #uuid "a88f47ed-845f-58ab-8439-56dc099c5b68" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186248922} {:answer/id #uuid "fa376f04-8fe0-5275-bfe6-352ab76a7200" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186249604}] :answer-field/correct {:answer/id #uuid "a88f47ed-845f-58ab-8439-56dc099c5b68" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186248922} :answer-field/id #uuid "10a81741-3586-53a3-84e0-362f9c97ac7f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186249698}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "deaa32f0-67ca-5a9c-a850-d214c4a09844" :question/math-academy-id "q-114153" :question/problem "Suppose that $f(x)$ is a function such that ${\\int }_{4}^{1}\\frac{1}{3}f(x)\\,\\text{d}x=2$ and ${\\int }_{-1}^{1}f(x)\\,\\text{d}x=6.$ What is the value of ${\\int }_{-1}^{4}f(x)\\,\\text{d}x?$" :question/worked-solution "Let's simplify one of the given integrals:\n\n$$\n\\begin{aligned}{\\int }_{4}^{1}\\frac{1}{3}f(x)\\,\\text{d}x & =2 \\\\ \\frac{1}{3}{\\int }_{4}^{1}f(x)\\,\\text{d}x & =2 \\\\ -\\frac{1}{3}{\\int }_{1}^{4}f(x)\\,\\text{d}x & =2 \\\\ {\\int }_{1}^{4}f(x)\\,\\text{d}x & =-6\\end{aligned}\n$$\n\nThen, from the adjacent intervals rule, we get\n\n$$\n\\begin{aligned}{\\int }_{-1}^{4}f(x)\\,\\text{d}x & ={\\int }_{-1}^{1}f(x)\\,\\text{d}x+{\\int }_{1}^{4}f(x)\\,\\text{d}x \\\\  & =6+(-6) \\\\  & =0.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186250194 :knowledge-point/_questions [{:db/id #edb/ref 17592186064183 :knowledge-point/id #uuid "d7256d2e-7105-5a4e-8d0a-5e00dfc1e311" :knowledge-point/title "Integrating Using Arctangent"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "31bd6778-18b0-5ff5-8b99-5a553e76b73e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{x}^{2}}{2}-2\\operatorname{arcsin}⁡x+C" :db/id #edb/ref 17592186247877} {:answer/id #uuid "4a97465c-2eb1-5200-9609-a38e8e5419dd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{x}^{2}\\operatorname{arccos}⁡x+C" :db/id #edb/ref 17592186248089} {:answer/id #uuid "5170f02c-e217-5a70-9d06-19689007bd09" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{x}^{2}\\operatorname{arctan}⁡x+C" :db/id #edb/ref 17592186248155} {:answer/id #uuid "70c0b236-95a4-5fec-9b61-50baea92bf78" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{x}^{2}}{2}+2\\operatorname{arctan}⁡x+C" :db/id #edb/ref 17592186248412} {:answer/id #uuid "bb0c8113-6440-560f-bdcf-41c0564064c8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{x}^{2}}{2}+2\\operatorname{sec}⁡x+C" :db/id #edb/ref 17592186249095}] :answer-field/correct {:answer/id #uuid "70c0b236-95a4-5fec-9b61-50baea92bf78" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{x}^{2}}{2}+2\\operatorname{arctan}⁡x+C" :db/id #edb/ref 17592186248412} :answer-field/id #uuid "c16c266a-b08e-5ef0-9fc4-f4220c1b8349" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186250002}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "2a79dcdc-c1c8-5a71-9d84-cbbd212d39b8" :question/math-academy-id "q-114156" :question/problem "$\\int (x+\\frac{2}{1+{x}^{2}})\\text{d}x=$" :question/worked-solution "Recall that \n\n$$\n\\int \\frac{1}{1+{x}^{2}}\\text{d}x=\\operatorname{arctan}⁡x+C.\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}\\int (x+\\frac{2}{1+{x}^{2}})\\text{d}x & =\\int x\\,\\text{d}x+\\int \\frac{2}{1+{x}^{2}}\\,\\text{d}x \\\\  & =\\int x\\,\\text{d}x+2\\int \\frac{1}{1+{x}^{2}}\\,\\text{d}x \\\\  & =\\frac{{x}^{2}}{2}+2\\operatorname{arctan}⁡x+C.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186250196 :knowledge-point/_questions [{:db/id #edb/ref 17592186064170 :knowledge-point/id #uuid "67f41769-a0ff-5ecc-8b05-5890a7ac9fe3" :knowledge-point/title "Integrating Using Arcsecant"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "41556b45-6566-5d35-a32f-9aedd70af148" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-arcsec12x+C" :db/id #edb/ref 17592186248004} {:answer/id #uuid "a265277f-a558-5b79-8aaf-a6ba74ffc423" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-12arcsecx+C" :db/id #edb/ref 17592186248874} {:answer/id #uuid "d936202f-1fd4-5b76-893e-473a9d4de4ab" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-12arctanx+C" :db/id #edb/ref 17592186249341} {:answer/id #uuid "ede6325d-4880-5db4-a203-b3e4e58e2c5a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "arctan12x+C" :db/id #edb/ref 17592186249510} {:answer/id #uuid "fe6d4fa2-8f57-5607-990f-63d3e9fd166e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "12arcsinx+C" :db/id #edb/ref 17592186249650}] :answer-field/correct {:answer/id #uuid "a265277f-a558-5b79-8aaf-a6ba74ffc423" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-12arcsecx+C" :db/id #edb/ref 17592186248874} :answer-field/id #uuid "0b16d465-2ab3-5fbc-b5c1-6f20a32dcef9" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186249688}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "337f64c2-ac77-50d2-b155-e1f75e2f921e" :question/math-academy-id "q-114162" :question/problem "$\\int -\\frac{12}{|x|\\sqrt{{x}^{2}-1}}\\,\\text{d}x=$" :question/worked-solution "Recall that\n\n$$\n\\int \\frac{1}{|x|\\sqrt{{x}^{2}-1}}\\,\\text{d}x=\\text{arcsec}\\,x.\n$$\n\nThen we have\n\n$$\n\\begin{aligned}\\begin{aligned}\\int -\\frac{12}{|x|\\sqrt{{x}^{2}-1}}\\,\\text{d}x & =-12\\int \\frac{1}{|x|\\sqrt{{x}^{2}-1}}\\,\\text{d}x \\\\  & =-12arcsecx+C.\\end{aligned}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186250198 :knowledge-point/_questions [{:db/id #edb/ref 17592186115209 :knowledge-point/id #uuid "eaea1ecf-d6b9-5807-8776-17359e94336b" :knowledge-point/title "Evaluating a Definite Integral Using the Constant Multiple Rule"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "263a6676-bcc6-56f2-bf75-5b204a0665c3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{3}{2}" :db/id #edb/ref 17592186247761} {:answer/id #uuid "8afc0f1b-1e0c-5d92-a062-0d61fc9caadd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{2}" :db/id #edb/ref 17592186248663} {:answer/id #uuid "9369dced-f14b-556e-945e-9f6e682f7d8e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186248734} {:answer/id #uuid "945bb0e9-9cf8-5d4f-a7ae-aab444d3de81" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186248744} {:answer/id #uuid "f074aa68-1eb8-5f6d-8644-d4e407e90daf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186249535}] :answer-field/correct {:answer/id #uuid "f074aa68-1eb8-5f6d-8644-d4e407e90daf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186249535} :answer-field/id #uuid "916b2a0c-4759-5859-ac15-e71d9797d8fa" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186249929}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "ca385184-ef23-5e09-850b-a334c3c5908a" :question/math-academy-id "q-114168" :question/problem "${\\int }_{0}^{\\pi /2}(-3\\operatorname{sin}⁡\\theta )\\,\\text{d}\\theta =$" :question/worked-solution "Factoring the constant out of the integral, we have\n\n$$\n\\begin{aligned}{\\int }_{0}^{\\pi /2}(-3\\operatorname{sin}⁡\\theta )\\,\\text{d}\\theta  & =-3{\\int }_{0}^{\\pi /2}\\operatorname{sin}⁡\\theta \\,\\text{d}\\theta  \\\\  & =-3(-\\operatorname{cos}⁡\\theta )\\,{|}_{0}^{\\pi /2} \\\\  & =3(\\operatorname{cos}⁡\\theta )\\,{|}_{0}^{\\pi /2} \\\\  & =3[\\operatorname{cos}⁡(\\frac{\\pi }{2})-\\operatorname{cos}⁡0] \\\\  & =3(0-1) \\\\  & =-3.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186250202 :knowledge-point/_questions [{:db/id #edb/ref 17592186064185 :knowledge-point/id #uuid "8e6b5d85-0b53-580f-9520-6c33463231d5" :knowledge-point/title "Integrating Using Inverse Trigonometric Functions and Some Manipulations"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "573f0bf8-8c3a-5fd3-87b0-1f98d36645e3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x-5\\operatorname{arctan}⁡x+C" :db/id #edb/ref 17592186248215} {:answer/id #uuid "7df83fc4-3a1c-5b4e-9334-3a07c3e58e5f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5x-5\\operatorname{arctan}⁡x+C" :db/id #edb/ref 17592186248529} {:answer/id #uuid "857ce7ea-a4b4-5485-b3d8-49d024d15f0b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5x+5\\operatorname{arctan}⁡x+C" :db/id #edb/ref 17592186248613} {:answer/id #uuid "881c84d2-e368-5509-bb5a-80ca75c9ca6c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2x+3\\operatorname{arctan}⁡x+C" :db/id #edb/ref 17592186248639} {:answer/id #uuid "994d053b-d19e-559c-a29d-2a8054864f41" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x+5\\operatorname{arctan}⁡x+C" :db/id #edb/ref 17592186248792}] :answer-field/correct {:answer/id #uuid "7df83fc4-3a1c-5b4e-9334-3a07c3e58e5f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5x-5\\operatorname{arctan}⁡x+C" :db/id #edb/ref 17592186248529} :answer-field/id #uuid "7223fe64-f45f-5bb2-b016-eb100aa48182" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186249866}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "5d5fd5d6-3989-51af-a4dc-33f4a2f20e44" :question/math-academy-id "q-114183" :question/problem "$\\int \\frac{5{x}^{2}}{{x}^{2}+1}\\,\\text{d}x=$" :question/worked-solution "This integral doesn't look like one of the basic ones. However, we can manipulate the numerator a bit  to make it look more like the denominator, which reveals a more familiar expression:\n\n$$\n\\begin{aligned}\\frac{5{x}^{2}}{{x}^{2}+1} & =\\frac{5{x}^{2}+5-5}{{x}^{2}+1} \\\\  & =\\frac{5({x}^{2}+1)-5}{{x}^{2}+1} \\\\  & =\\frac{5({x}^{2}+1)}{{x}^{2}+1}-\\frac{5}{{x}^{2}+1} \\\\  & =\\frac{5\\cancel{({x}^{2}+1)}}{\\cancel{{x}^{2}+1}}-\\frac{5}{{x}^{2}+1} \\\\  & =5-\\frac{5}{{x}^{2}+1}\\end{aligned}\n$$\n\nRemembering that\n\n$$\n\\int \\frac{1}{{x}^{2}+1}\\text{d}x=\\operatorname{arctan}⁡x,\n$$\n\nwe can now calculate the integral and get\n\n$$\n\\begin{aligned}\\begin{aligned}\\int \\frac{5{x}^{2}}{{x}^{2}+1}\\,\\text{d}x & =\\int (5-\\frac{5}{{x}^{2}+1})\\text{d}x \\\\  & =5\\int \\text{d}x-5\\int \\frac{1}{{x}^{2}+1}\\,\\text{d}x \\\\  & =5x-5\\operatorname{arctan}⁡x+C.\\end{aligned}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186250204 :knowledge-point/_questions [{:db/id #edb/ref 17592186115211 :knowledge-point/id #uuid "5cff6bd5-aeb6-55ed-a44b-fca322e73dd8" :knowledge-point/title "Evaluating the Integral of a Polynomial Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2076931f-ac5e-5cb3-a7cd-949180c4937f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "14" :db/id #edb/ref 17592186247710} {:answer/id #uuid "20887d98-d353-5f28-a778-8bae080e7c16" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-6" :db/id #edb/ref 17592186247711} {:answer/id #uuid "7fbc9b8e-e983-580e-9c8c-6408375c1ec6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186248546} {:answer/id #uuid "9e7c6e6b-3281-55a1-b83d-a5e2c34be542" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-10" :db/id #edb/ref 17592186248832} {:answer/id #uuid "da211254-976d-5278-b7db-a5bac2c1e2f8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-15" :db/id #edb/ref 17592186249350}] :answer-field/correct {:answer/id #uuid "da211254-976d-5278-b7db-a5bac2c1e2f8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-15" :db/id #edb/ref 17592186249350} :answer-field/id #uuid "ea46bc64-ace8-597b-9f4a-c8d665331e51" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186250077}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "cb7aa667-7846-593b-9726-bcbf9d59d176" :question/math-academy-id "q-114190" :question/problem "${\\int }_{-2}^{1}(6{z}^{2}-5{z}^{4})\\,\\text{d}z=$" :question/worked-solution "Splitting up the difference and factoring out the constants, we have\n\n$$\n\\begin{aligned}{\\int }_{-2}^{1}(6{z}^{2}-5{z}^{4})\\,\\text{d}z & =6{\\int }_{-2}^{1}{z}^{2}\\,\\text{d}z-5{\\int }_{-2}^{1}{z}^{4}\\,\\text{d}z \\\\  & =6\\cdot \\frac{1}{3}{z}^{3}\\,{|}_{-2}^{1}-5\\cdot \\frac{1}{5}{z}^{5}\\,{|}_{-2}^{1} \\\\  & =2{z}^{3}\\,{|}_{-2}^{1}-{z}^{5}\\,{|}_{-2}^{1} \\\\  & =2({1}^{3}-(-2)^{3})-({1}^{5}-(-2)^{5}) \\\\  & =2(1+8)-(1+32) \\\\  & =18-33 \\\\  & =-15.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186250208 :knowledge-point/_questions [{:db/id #edb/ref 17592186068689 :knowledge-point/id #uuid "8a41d750-ffd9-5226-9bd7-b763575870c1" :knowledge-point/title "Calculating a Limit Using L'Hopital's Rule Twice"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "459929b5-16a5-5034-94f0-b9e58f15ceec" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186248048} {:answer/id #uuid "64343e0f-0dc4-59b1-9b42-e034415d89e2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186248328} {:answer/id #uuid "81c1316f-a38a-5e2e-b549-e63e68e66f54" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186248573} {:answer/id #uuid "a9fe39d8-722a-5b08-a7b5-69095e8360bf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{2}" :db/id #edb/ref 17592186248934} {:answer/id #uuid "bc7cabaa-8d3a-58ef-b215-67b7a26ae5ba" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186249104}] :answer-field/correct {:answer/id #uuid "459929b5-16a5-5034-94f0-b9e58f15ceec" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186248048} :answer-field/id #uuid "e640f0ef-8ce1-5b26-8c98-c9b2965485ad" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186250066}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "d22fa8db-1712-5866-9e2b-91e93589e8f9" :question/math-academy-id "q-114245" :question/problem "${lim}_{x\\to 1}\\frac{1-x+x\\operatorname{ln}⁡x}{{x}^{2}-2x+1}=$" :question/worked-solution "If we plug in $x=1$ we get the indeterminate form $\\frac{0}{0},$ so  we apply L'Hopital's rule to find the limit:\n\n$$\n\\begin{aligned}{lim}_{x\\to 1}\\frac{1-x+x\\operatorname{ln}⁡x}{{x}^{2}-2x+1} & ={lim}_{x\\to 1}\\frac{{[1-x+x\\operatorname{ln}⁡x]}^{′}}{{[{x}^{2}-2x+1]}^{′}} \\\\  & ={lim}_{x\\to 1}\\frac{\\operatorname{ln}⁡x}{2x-2}\\end{aligned}\n$$\n\nThis time, the resulting limit still gives the indeterminate form $\\frac{0}{0}.$ To find the limit, we apply L'Hopital's rule once again. We get\n\n$$\n\\begin{aligned}{lim}_{x\\to 1}\\frac{1-x+x\\operatorname{ln}⁡x}{{x}^{2}-2x+1} & ={lim}_{x\\to 1}\\frac{\\operatorname{ln}⁡x}{2x-2} \\\\  & ={lim}_{x\\to 1}\\frac{{[\\operatorname{ln}⁡x]}^{′}}{{[2x-2]}^{′}} \\\\  & ={lim}_{x\\to 1}\\frac{(\\frac{1}{x})}{2} \\\\  & ={lim}_{x\\to 1}\\frac{1}{2x} \\\\  & =\\frac{1}{2}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186250222 :knowledge-point/_questions [{:db/id #edb/ref 17592186096623 :knowledge-point/id #uuid "0099e032-f2ee-573a-a359-cf60e28bc89e" :knowledge-point/title "Identifying Points of Inflection From the Graph of a Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "06a09d68-fd5d-5774-860b-0fb512120f25" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$x=1$ only" :db/id #edb/ref 17592186247484} {:answer/id #uuid "1894b214-ce37-51c5-983d-3ece0e35644a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$x=-1$ only" :db/id #edb/ref 17592186247644} {:answer/id #uuid "4ab30c4f-3407-522e-9989-fa70717ad814" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$x=-2$ and $x=1$" :db/id #edb/ref 17592186248090} {:answer/id #uuid "4b57e9a7-f621-56bf-a53d-a6702706b4e4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$x=-1$ and $x=1$" :db/id #edb/ref 17592186248098} {:answer/id #uuid "f2e72f04-b8cb-52b5-82f4-54bc45fd6b54" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$x=-2$ and $x=-1$" :db/id #edb/ref 17592186249551}] :answer-field/correct {:answer/id #uuid "06a09d68-fd5d-5774-860b-0fb512120f25" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$x=1$ only" :db/id #edb/ref 17592186247484} :answer-field/id #uuid "827d40ee-03b7-57b0-870c-f6c6e54bc293" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186249897}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "572d008c-de8c-52c8-a2da-c20948cfcb3b" :question/math-academy-id "q-114280" :question/problem "![](images/4b/4bb767047996aad50a7991915c91774e0c19d9e5c1a7c60d66dd7a6afef0fa03.png)\n\nConsider the graph of $y=f(x)$ above. What are the points of inflection?" :question/worked-solution "The points of inflection are the points where\n\n- the function's concavity changes sign, and\n\n- the tangent line to the graph exists.\n\nWith that in mind, let's examine our graph.\n\n- The point $x=-2$ is *not* a point of inflection for two reasons. First, the function does not change concavity. It's concave down both to the left and to the right of $x=-2.$ Second, the tangent line does not exist at this point.\n\n- The point $x=-1$ is *not* a point of inflection. Although the graph changes concavity from concave down to concave up at $x=1,$   the tangent line does not exist at this point.\n\n- The point $x=1$ is a point of inflection. Indeed:\n\n- the graph changes concavity from concave up to concave down at $x=1,$ and\n\n- the tangent line exists at this point.\n\nTherefore, the point of inflection is $x=1$ only."}] [{:db/id #edb/ref 17592186250224 :knowledge-point/_questions [{:db/id #edb/ref 17592186064245 :knowledge-point/id #uuid "abe88143-989a-5967-bb08-16804e31d948" :knowledge-point/title "Using Integration by Parts to Compute an Indefinite Integral Containing an Exponential Expression"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3f62ef64-e190-59a0-80de-2a8c873c7f56" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{x{e}^{8x}}{2}-\\frac{{e}^{8x}}{4}+C" :db/id #edb/ref 17592186247983} {:answer/id #uuid "81cbaf36-0102-5b7f-97ff-d66d8054c9ac" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{x{e}^{8x}}{4}+\\frac{5{e}^{8x}}{16}+C" :db/id #edb/ref 17592186248574} {:answer/id #uuid "99e7a715-8634-5d28-bb4e-237d83c69b86" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{x{e}^{8x}}{8}-\\frac{{e}^{8x}}{16}+C" :db/id #edb/ref 17592186248798} {:answer/id #uuid "afef77b3-81af-530d-a6f6-eb398f03a3c3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{x{e}^{8x}}{2}-\\frac{{e}^{8x}}{16}+C" :db/id #edb/ref 17592186249004} {:answer/id #uuid "e249a080-5cfd-59dd-bdec-1e4e038339ad" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3x{e}^{8x}}{8}+\\frac{{e}^{8x}}{12}+C" :db/id #edb/ref 17592186249426}] :answer-field/correct {:answer/id #uuid "afef77b3-81af-530d-a6f6-eb398f03a3c3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{x{e}^{8x}}{2}-\\frac{{e}^{8x}}{16}+C" :db/id #edb/ref 17592186249004} :answer-field/id #uuid "1a43b96e-f2d9-52db-aaf6-60b9ffaaf8e3" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186249713}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "03919aa8-efb9-58ab-8664-d380cf005c1c" :question/math-academy-id "q-114288" :question/problem "$\\int 4x{e}^{8x}\\,\\text{d}x=$" :question/worked-solution "To solve this integral, we use the by-parts formula, given by\n\n$$\n\\int u{v}^{′}\\,\\text{d}x=uv-\\int v{u}^{′}\\,\\text{d}x.\n$$\n\nWe need to express $\\int 4x{e}^{8x}\\text{d}x$ as $\\int u{v}^{′}\\,\\text{d}x.$ Therefore, we set\n\n$$\n\\begin{aligned}u=4x\\, & ⟹\\,{u}^{′}=4 \\\\ {v}^{′}={e}^{8x}\\, & ⟹\\,v=\\frac{1}{8}{e}^{8x}.\\end{aligned}\n$$\n\nWe substitute the above into the integration by parts formula, and we get\n\n$$\n\\begin{aligned}\\int u{v}^{′}\\,\\text{d}x & =uv-\\int v{u}^{′}\\,\\text{d}x \\\\ \\int 4x\\cdot {e}^{8x}\\,\\text{d}x & =4x\\cdot \\frac{1}{8}{e}^{8x}-\\int \\frac{1}{8}{e}^{8x}\\cdot 4\\,\\text{d}x.\\end{aligned}\n$$\n\nFinally, we calculate the integral, as follows:\n\n$$\n\\begin{aligned}\\int 4x{e}^{8x}\\,\\text{d}x & =\\frac{1}{2}x{e}^{8x}-\\frac{1}{2}\\int {e}^{8x}\\,\\text{d}x \\\\  & =\\frac{x{e}^{8x}}{2}-\\frac{{e}^{8x}}{16}+C\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186250231 :knowledge-point/_questions [{:db/id #edb/ref 17592186064225 :knowledge-point/id #uuid "d7bd68b3-56ae-57e5-81ef-2370c96664c4" :knowledge-point/title "Integrating a Product of Trigonometric Functions Using Trigonometric Identities"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3878ae79-1e5e-59bf-8bb6-ae0cf3aaa4bf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2-\\sqrt{2}}{2}" :db/id #edb/ref 17592186247928} {:answer/id #uuid "5f75b493-3947-527e-a588-60cab80d2be3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1-\\sqrt{2}" :db/id #edb/ref 17592186248287} {:answer/id #uuid "74e4c221-78c2-5702-af4f-442e99facd40" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1-\\sqrt{2}}{2}" :db/id #edb/ref 17592186248451} {:answer/id #uuid "cef45258-9cb1-562e-a7e4-faf62bbc7406" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2(\\sqrt{2}-1)" :db/id #edb/ref 17592186249259} {:answer/id #uuid "e0dd153a-e09b-5898-9188-70f04b5e8044" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{2}+2" :db/id #edb/ref 17592186249413}] :answer-field/correct {:answer/id #uuid "3878ae79-1e5e-59bf-8bb6-ae0cf3aaa4bf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2-\\sqrt{2}}{2}" :db/id #edb/ref 17592186247928} :answer-field/id #uuid "d4b71088-363e-519b-b126-45df5c59e3e2" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186250039}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "40079a0f-e072-5ffd-a039-30e177ed76fb" :question/math-academy-id "q-114304" :question/problem "${\\int }_{0}^{\\pi /4}\\operatorname{cos}⁡x\\operatorname{tan}⁡x\\,\\text{d}x=$" :question/worked-solution "We use the identity $\\operatorname{tan}⁡x=\\frac{\\operatorname{sin}⁡x}{\\operatorname{cos}⁡x},$ as follows:\n\n$$\n\\begin{aligned}{\\int }_{0}^{\\pi /4}\\operatorname{cos}⁡x\\operatorname{tan}⁡x\\,\\text{d}x & ={\\int }_{0}^{\\pi /4}\\operatorname{cos}⁡x\\cdot \\frac{\\operatorname{sin}⁡x}{\\operatorname{cos}⁡x}\\,\\text{d}x \\\\  & ={\\int }_{0}^{\\pi /4}\\operatorname{sin}⁡x\\,\\text{d}x \\\\  & =-\\operatorname{cos}⁡x\\,{|}_{0}^{\\pi /4} \\\\  & =-(\\operatorname{cos}⁡(\\frac{\\pi }{4})-\\operatorname{cos}⁡0) \\\\  & =-(\\frac{\\sqrt{2}}{2}-1) \\\\  & =1-\\frac{\\sqrt{2}}{2} \\\\  & =\\frac{2-\\sqrt{2}}{2}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186250235 :knowledge-point/_questions [{:db/id #edb/ref 17592186064246 :knowledge-point/id #uuid "bc6023d1-1461-50d1-b939-7e08f2878df4" :knowledge-point/title "Using Integration by Parts to Compute an Indefinite Integral Containing a Trigonometric Expression"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7c09516b-ffde-5c4c-8dbe-564104924571" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{x\\operatorname{sin}⁡(5x)}{15}+\\frac{\\operatorname{cos}⁡(5x)}{5}+C" :db/id #edb/ref 17592186248513} {:answer/id #uuid "a581301a-72c3-5cfb-8ef1-56abefe481a9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\operatorname{sin}⁡(5x)}{25}+\\frac{x\\operatorname{cos}⁡(5x)}{5}+C" :db/id #edb/ref 17592186248900} {:answer/id #uuid "a5873c57-b416-5bd2-86d9-681f98615c39" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{x\\operatorname{sin}⁡(5x)}{5}-\\frac{2\\operatorname{cos}⁡(5x)}{25}+C" :db/id #edb/ref 17592186248901} {:answer/id #uuid "b120bf14-8c51-5072-89f4-30873910c7df" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{x\\operatorname{sin}⁡(5x)}{5}+\\frac{\\operatorname{cos}⁡(5x)}{25}+C" :db/id #edb/ref 17592186249011} {:answer/id #uuid "d4ae0e29-77f1-5100-a586-609d2c797e98" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2\\operatorname{sin}⁡(5x)}{5}-\\frac{x\\operatorname{cos}⁡(5x)}{15}+C" :db/id #edb/ref 17592186249307}] :answer-field/correct {:answer/id #uuid "b120bf14-8c51-5072-89f4-30873910c7df" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{x\\operatorname{sin}⁡(5x)}{5}+\\frac{\\operatorname{cos}⁡(5x)}{25}+C" :db/id #edb/ref 17592186249011} :answer-field/id #uuid "3ea192b1-985a-504b-a59a-fe45ed09d88a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186249781}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "6d0e94f6-1e93-555f-a728-ca5181d50236" :question/math-academy-id "q-114312" :question/problem "$\\int x\\operatorname{cos}⁡(5x)\\,\\text{d}x=$" :question/worked-solution "To solve this integral, we use the by-parts formula, given by\n\n$$\n\\int u{v}^{′}\\,\\text{d}x=uv-\\int v{u}^{′}\\,\\text{d}x.\n$$\n\nWe need to express $\\int x\\operatorname{cos}⁡(5x)\\text{d}x$ as $\\int u{v}^{′}\\,\\text{d}x.$ Therefore, we set\n\n$$\n\\begin{aligned}u=x\\, & ⟹\\,{u}^{′}=1 \\\\ {v}^{′}=\\operatorname{cos}⁡(5x)\\, & ⟹\\,v=\\frac{\\operatorname{sin}⁡(5x)}{5}.\\end{aligned}\n$$\n\nWe substitute the above into the integration by parts formula, and we get\n\n$$\n\\begin{aligned}\\int u{v}^{′}\\,\\text{d}x & =uv-\\int v{u}^{′}\\,\\text{d}x \\\\ \\int x\\cdot \\operatorname{cos}⁡(5x)\\,\\text{d}x & =x\\cdot (\\frac{\\operatorname{sin}⁡(5x)}{5})-\\int (\\frac{\\operatorname{sin}⁡(5x)}{5})\\cdot 1\\,\\text{d}x.\\end{aligned}\n$$\n\nFinally, we calculate the integral, as follows:\n\n$$\n\\begin{aligned}\\int x\\operatorname{cos}⁡(5x)\\,\\text{d}x & =\\frac{x\\operatorname{sin}⁡(5x)}{5}-\\frac{1}{5}\\int \\operatorname{sin}⁡(5x)\\,\\text{d}x \\\\  & =\\frac{x\\operatorname{sin}⁡(5x)}{5}+\\frac{\\operatorname{cos}⁡(5x)}{25}+C\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186250237 :knowledge-point/_questions [{:db/id #edb/ref 17592186064246 :knowledge-point/id #uuid "bc6023d1-1461-50d1-b939-7e08f2878df4" :knowledge-point/title "Using Integration by Parts to Compute an Indefinite Integral Containing a Trigonometric Expression"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1e07b070-117b-50c5-9563-364f2b472707" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x\\operatorname{tan}⁡x-\\operatorname{ln}⁡|\\operatorname{cos}⁡x|+C" :db/id #edb/ref 17592186247691} {:answer/id #uuid "55dba241-a0ad-5dd2-a193-a8f4b6a32a61" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-x\\operatorname{cot}⁡x+\\operatorname{ln}⁡|\\operatorname{sin}⁡x|+C" :db/id #edb/ref 17592186248201} {:answer/id #uuid "73e6af66-30b4-53c1-9d1f-0d00e757eaa3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-x\\operatorname{cot}⁡x-2\\operatorname{ln}⁡|\\operatorname{cos}⁡x|+C" :db/id #edb/ref 17592186248442} {:answer/id #uuid "80fe39bd-6730-5d90-8ec2-9b32e504d4a5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x\\operatorname{tan}⁡x-2\\operatorname{ln}⁡|\\operatorname{sin}⁡x|+C" :db/id #edb/ref 17592186248563} {:answer/id #uuid "fc349b75-7a3e-573b-affc-74cf566b5683" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2x\\operatorname{cot}⁡x-\\operatorname{ln}⁡|\\operatorname{sin}⁡x|+C" :db/id #edb/ref 17592186249622}] :answer-field/correct {:answer/id #uuid "55dba241-a0ad-5dd2-a193-a8f4b6a32a61" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-x\\operatorname{cot}⁡x+\\operatorname{ln}⁡|\\operatorname{sin}⁡x|+C" :db/id #edb/ref 17592186248201} :answer-field/id #uuid "c0fb41b9-ef63-543e-b53e-dffe53d28fbc" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186250000}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "ea7a186f-be1a-52b9-b47f-3320d955e3e8" :question/math-academy-id "q-114314" :question/problem "Calculate $\\int x{csc}^{2}⁡x\\,\\text{d}x.$" :question/worked-solution "To solve this integral, we use the by-parts formula, given by\n\n$$\n\\int u{v}^{′}\\,\\text{d}x=uv-\\int v{u}^{′}\\,\\text{d}x.\n$$\n\nWe need to express $\\int x{csc}^{2}⁡x\\text{d}x$ as $\\int u{v}^{′}\\,\\text{d}x.$ Therefore we set\n\n$$\n\\begin{aligned}u=x\\, & ⟹\\,{u}^{′}=1 \\\\ {v}^{′}={csc}^{2}⁡x\\, & ⟹\\,v=-\\operatorname{cot}⁡x.\\end{aligned}\n$$\n\nWe substitute the above into the integration by parts formula, and we get\n\n$$\n\\begin{aligned}\\int u{v}^{′}\\,\\text{d}x & =uv-\\int v{u}^{′}\\,\\text{d}x \\\\ \\int x\\cdot {csc}^{2}⁡x\\,\\text{d}x & =x\\cdot (-\\operatorname{cot}⁡x)-\\int (-\\operatorname{cot}⁡x)\\cdot 1\\,\\text{d}x \\\\  & =-x\\operatorname{cot}⁡x+\\int \\frac{\\operatorname{cos}⁡x}{\\operatorname{sin}⁡x}\\,\\text{d}x.\\end{aligned}\n$$\n\nFinally, we calculate the integral using the substitution $u=\\operatorname{sin}⁡x,$ where $\\text{d}u=\\operatorname{cos}⁡x\\,\\text{d}x,$ as follows:\n\n$$\n\\begin{aligned}\\int x{csc}^{2}⁡(x)\\,\\text{d}x & =-x\\operatorname{cot}⁡x+\\int \\frac{\\operatorname{cos}⁡x}{\\operatorname{sin}⁡x}\\,\\text{d}x \\\\  & =-x\\operatorname{cot}⁡x+\\int \\frac{1}{u}\\,\\text{d}u \\\\  & =-x\\operatorname{cot}⁡x+\\operatorname{ln}⁡|u|+C \\\\  & =-x\\operatorname{cot}⁡x+\\operatorname{ln}⁡|\\operatorname{sin}⁡x|+C\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186250241 :knowledge-point/_questions [{:db/id #edb/ref 17592186073810 :knowledge-point/id #uuid "522b66f4-8a46-5dd0-a9d7-3b081c0ed157" :knowledge-point/title "Finding the Distance Between a Point and a Horizontal or Vertical Line"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1b1feabb-d80c-59ec-8f66-d72d31498c1b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186247669} {:answer/id #uuid "42c0433e-7aaf-5761-81da-33fe01ca9740" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "7" :db/id #edb/ref 17592186248020} {:answer/id #uuid "84f2ec16-f076-58cc-9d96-6046d0c047cf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186248604} {:answer/id #uuid "a2228bab-407a-5173-8ec9-6f138869205f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186248871} {:answer/id #uuid "da8f8caf-52fa-57a4-9034-247fa54a5c3a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186249355}] :answer-field/correct {:answer/id #uuid "1b1feabb-d80c-59ec-8f66-d72d31498c1b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186247669} :answer-field/id #uuid "7bbc3278-eb17-5700-bb41-ce67c5754955" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186249883}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "a7327f68-1eda-5ad2-867d-ca3941f336b9" :question/math-academy-id "q-114323" :question/problem "Find the shortest distance between the point $(4,3)$ and the line $x=2.$" :question/worked-solution "Let's sketch the given situation.\n\n![](images/ea/ea64c0752738b0c917d897060351cdd43ed7bbf687cc20781b7241ee3be0ad3c.png)\n\nSince the line $x=2$ is a vertical line, the shortest distance between this line and the point $(4,3)$ is given by the absolute value of the difference between the $x$-coordinate of the point and $2.$ \n\nSo, the shortest distance is\n\n$$\nd=|4-2|=2.\n$$"}] [{:db/id #edb/ref 17592186250247 :knowledge-point/_questions [{:db/id #edb/ref 17592186073811 :knowledge-point/id #uuid "d7030a12-bd18-5f8b-84eb-28b6f216f972" :knowledge-point/title "Finding the Distance Between a Point and a Line"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0dc625ac-31af-5204-8aa1-d135161d7f0d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186247552} {:answer/id #uuid "0ef14e40-61a3-5e9d-8570-f753f7cc4507" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4\\sqrt{2}" :db/id #edb/ref 17592186247562} {:answer/id #uuid "17d12124-8c76-5d6d-96b2-2686e53d0068" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8\\sqrt{2}" :db/id #edb/ref 17592186247640} {:answer/id #uuid "2e6ebd32-522e-573e-b812-a47b4e052305" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186247836} {:answer/id #uuid "80085e2c-2862-5780-b8b7-faf2920e4807" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\sqrt{2}" :db/id #edb/ref 17592186248548}] :answer-field/correct {:answer/id #uuid "0ef14e40-61a3-5e9d-8570-f753f7cc4507" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4\\sqrt{2}" :db/id #edb/ref 17592186247562} :answer-field/id #uuid "54362198-2ea2-5313-8e36-1d82209afe8b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186249825}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "633d0fd6-e7a8-521b-a27a-54658471a6ed" :question/math-academy-id "q-114343" :question/problem "Find the shortest distance between the point $(-1,5)$ and the line $y=x-2.$" :question/worked-solution "Let's draw a diagram describing our situation. \n\n![](images/02/021b08ba0d14e40939103d6d3e9e2004d49e5d047a5f89677b3fe542aa866f82.png)\n\n \n\nFirst, we find the equation of the line that's perpendicular to $y=x-2$ and passes through the point $(-1,5).$\n\nThe given line has a slope of $1,$ so our perpendicular line must have a slope of $-1.$\n\nUsing point-slope form and simplifying, we obtain the equation of the perpendicular line:\n\n$$\n\\begin{aligned}y-{y}_{1} & =m(x-{x}_{1}) \\\\ y-5 & =-(x+1) \\\\ y & =-x-1+5 \\\\ y & =-x+4\\end{aligned}\n$$\n\nWe now find the point where the two lines intersect. To do this, we solve the following system of equations:\n\n$$\n{\\begin{aligned}y=x-2 \\\\ y=-x+4\\end{aligned}\n$$\n\nWe can solve this system by putting the two equations equal to one another and solving for $x.$ This gives\n\n$$\n\\begin{aligned}x-2 & =-x+4 \\\\ x+x & =4+2 \\\\ 2x & =6 \\\\ x & =3.\\end{aligned}\n$$\n\nSubstituting $x=3$ into either of the two equations gives $y=1.$ So, our solution is $x=3$ and $y=1.$ Therefore, the lines intersect at the point $(3,1).$\n\nFinally, we find the distance $d$ between the points $(-1,5)$ and $(3,1):$\n\n$$\n\\begin{aligned}d & =\\sqrt{({x}_{2}-{x}_{1})^{2}+({y}_{2}-{y}_{1})^{2}} \\\\  & =\\sqrt{(3+1)^{2}+(1-5)^{2}} \\\\  & =\\sqrt{(4)^{2}+(-4)^{2}} \\\\  & =\\sqrt{16+16} \\\\  & =4\\sqrt{2}\\end{aligned}\n$$\n\nTherefore, we conclude that the shortest distance between the point $(-1,5)$ and the line $y=x-2$ is $4\\sqrt{2}.$"}] [{:db/id #edb/ref 17592186250248 :knowledge-point/_questions [{:db/id #edb/ref 17592186073815 :knowledge-point/id #uuid "59d3a391-c163-5a04-944c-5d61a3950e03" :knowledge-point/title "Finding a Point on a Line That Is Closest to a Given Point"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "072e45bc-d35a-54a2-8ab9-5f295ebf110f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(\\frac{3}{13},\\frac{11}{13})" :db/id #edb/ref 17592186247490} {:answer/id #uuid "14581a73-ac53-505c-8447-0394a875fcd8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(\\frac{3}{13},-\\frac{11}{13})" :db/id #edb/ref 17592186247608} {:answer/id #uuid "6cb5a940-7e41-5de0-9f76-33adbc3d81da" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-\\frac{3}{13},\\frac{11}{13})" :db/id #edb/ref 17592186248386} {:answer/id #uuid "bd6d5bb5-c38f-58f9-bdcf-296b1625b1d6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(\\frac{11}{13},\\frac{3}{13})" :db/id #edb/ref 17592186249109} {:answer/id #uuid "de549bfd-d213-57c1-ad88-fadc596d833b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(3,11)" :db/id #edb/ref 17592186249395}] :answer-field/correct {:answer/id #uuid "072e45bc-d35a-54a2-8ab9-5f295ebf110f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(\\frac{3}{13},\\frac{11}{13})" :db/id #edb/ref 17592186247490} :answer-field/id #uuid "a5d3e168-c279-50d0-a119-0930eb63b6db" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186249960}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "dd8e8e07-0b88-58f7-806a-13412093afb7" :question/math-academy-id "q-114345" :question/problem "![](images/ff/ff9810290868f7fd465bc310c969255b92f646d6b59ad71a93a3dcc9c38ef49c.png)\n\nFind the point on the line $3y+2x=3$ that is closest to the point $(3,5).$" :question/worked-solution "First, we rewrite the equation of the given line in slope-intercept form:\n\n$$\n\\begin{aligned}3y+2x & =3 \\\\ 3y & =-2x+3 \\\\ y & =-\\frac{2}{3}x+1\\end{aligned}\n$$\n\nNext, we find the equation of the line that's perpendicular to $y=-\\frac{2}{3}x+1$ and passes through the point $(3,5).$\n\nThe given line has a slope of $-\\frac{2}{3},$ so our perpendicular line must have a slope of $\\frac{3}{2}.$\n\nUsing point-slope form and simplifying, we obtain the equation of the perpendicular line:\n\n$$\n\\begin{aligned}y-{y}_{1} & =m(x-{x}_{1}) \\\\ y-5 & =\\frac{3}{2}(x-3) \\\\ y & =\\frac{3}{2}x-\\frac{9}{2}+5 \\\\ y & =\\frac{3}{2}x+\\frac{1}{2}\\end{aligned}\n$$\n\nWe now find the point where the two lines intersect. To do this, we solve the following system of equations:\n\n$$\n{\\begin{aligned}y=-\\frac{2}{3}x+1 \\\\ y=\\frac{3}{2}x+\\frac{1}{2}\\end{aligned}\n$$\n\nWe can solve this system by putting the two equations equal to one another and solving for $x.$ This gives\n\n$$\n\\begin{aligned}-\\frac{2}{3}x+1 & =\\frac{3}{2}x+\\frac{1}{2} \\\\ -\\frac{2}{3}x-\\frac{3}{2}x & =\\frac{1}{2}-1 \\\\ -\\frac{13}{6}x & =-\\frac{1}{2} \\\\ x & =\\frac{3}{13}.\\end{aligned}\n$$\n\nSubstituting $x=\\frac{3}{13}$ into either of the two equations gives $y=\\frac{11}{13}.$ So, our solution is $x=\\frac{3}{13}$ and $y=\\frac{11}{13}.$ So, the lines intersect at the point $(\\frac{3}{13},\\frac{11}{13}).$\n\nTherefore, we conclude that the point on the line  $3y+2x=3$ that is closest to the point $(3,5)$ is  $(\\frac{3}{13},\\frac{11}{13}).$"}] [{:db/id #edb/ref 17592186250249 :knowledge-point/_questions [{:db/id #edb/ref 17592186073815 :knowledge-point/id #uuid "59d3a391-c163-5a04-944c-5d61a3950e03" :knowledge-point/title "Finding a Point on a Line That Is Closest to a Given Point"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1bf8bb55-4020-5f0b-bd59-42ee32fbb771" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(\\frac{7}{5},\\frac{1}{5})" :db/id #edb/ref 17592186247677} {:answer/id #uuid "506a9fe3-70ee-5719-9e0a-dcce648d0473" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(\\frac{1}{5},\\frac{7}{5})" :db/id #edb/ref 17592186248144} {:answer/id #uuid "9cf2ce60-0e78-5b08-b8b7-0a60d6e30d7f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-\\frac{1}{5},\\frac{7}{5})" :db/id #edb/ref 17592186248821} {:answer/id #uuid "bb02feef-1bc2-517b-96ff-29402a331b44" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-1,7)" :db/id #edb/ref 17592186249094} {:answer/id #uuid "dbb3d233-8364-50ab-b259-e0a0966e7b9a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-\\frac{1}{5},-\\frac{7}{5})" :db/id #edb/ref 17592186249364}] :answer-field/correct {:answer/id #uuid "9cf2ce60-0e78-5b08-b8b7-0a60d6e30d7f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-\\frac{1}{5},\\frac{7}{5})" :db/id #edb/ref 17592186248821} :answer-field/id #uuid "2932adcc-4eb8-504c-836b-faa4fbe63c1f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186249750}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "3954acb1-fda8-5e85-a442-60c3272bf340" :question/math-academy-id "q-114346" :question/problem "![](images/df/df3838ae44d1477a4a0de303972cd26a2ceaad9b213f1d8e4be3a53bd453aeb2.png)\n\nFind the point on the line $y-3x=2$ that is closest to the point $(4,0).$" :question/worked-solution "First, we rewrite the equation of the given line in slope-intercept form:\n\n$$\n\\begin{aligned}y-3x & =2 \\\\ y & =3x+2\\end{aligned}\n$$\n\nNext, we find the equation of the line that's perpendicular to $y=3x+2$ and passes through the point $(4,0).$\n\nThe given line has a slope of $3,$ so our perpendicular line must have a slope of $-\\frac{1}{3}.$\n\nUsing point-slope form and simplifying, we obtain the equation of the perpendicular line:\n\n$$\n\\begin{aligned}y-{y}_{1} & =m(x-{x}_{1}) \\\\ y-0 & =-\\frac{1}{3}(x-4) \\\\ y & =-\\frac{1}{3}x+\\frac{4}{3}\\end{aligned}\n$$\n\nWe now find the point where the two lines intersect. To do this, we solve the following system of equations:\n\n$$\n{\\begin{aligned}y=3x+2 \\\\ y=-\\frac{1}{3}x+\\frac{4}{3}\\end{aligned}\n$$\n\nWe can solve this system by putting the two equations equal to one another and solving for $x.$ This gives\n\n$$\n\\begin{aligned}3x+2 & =-\\frac{1}{3}x+\\frac{4}{3} \\\\ 3x+\\frac{1}{3}x & =\\frac{4}{3}-2 \\\\ \\frac{10}{3}x & =-\\frac{2}{3} \\\\ 10x & =-2 \\\\ x & =-\\frac{1}{5}.\\end{aligned}\n$$\n\nSubstituting $x=-\\frac{1}{5}$ into either of the two equations gives $y=\\frac{7}{5}.$ So, our solution is $x=-\\frac{1}{5}$ and $y=\\frac{7}{5}.$ So, the lines intersect at the point $(-\\frac{1}{5},\\frac{7}{5}).$\n\nTherefore, we conclude that the point on the line  $y-3x=2$ that is closest to the point $(4,0)$ is  $(-\\frac{1}{5},\\frac{7}{5}).$"}] [{:db/id #edb/ref 17592186399830 :knowledge-point/_questions [{:db/id #edb/ref 17592186096624 :knowledge-point/id #uuid "977a9b6e-744a-554b-92ee-0b6343041ecf" :knowledge-point/title "Identifying Points of Inflection From the Graph of the Second Derivative of a Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "60d399bd-315a-5c25-b63b-0a7391724a1e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$x=-3$ and $x=-1$ only" :db/id #edb/ref 17592186399832} {:answer/id #uuid "920e6436-61f2-5a55-8fd8-6326ab8c0807" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$x=-3$ and $x=1$ only" :db/id #edb/ref 17592186399833} {:answer/id #uuid "d4e096b7-2688-5afd-8241-00c938c02da0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$x=-1$ only" :db/id #edb/ref 17592186399834} {:answer/id #uuid "596b5a75-fa8d-518b-b2eb-9eb7b3a09dac" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$x=-3,$ $x=-1$ and $x=1$" :db/id #edb/ref 17592186399835} {:answer/id #uuid "c210c0cc-3f26-5461-99d3-ddbe6f537e73" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$x=-1$ and $x=1$ only" :db/id #edb/ref 17592186399836}] :answer-field/correct {:answer/id #uuid "c210c0cc-3f26-5461-99d3-ddbe6f537e73" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$x=-1$ and $x=1$ only" :db/id #edb/ref 17592186399836} :answer-field/id #uuid "04b865a5-78da-5138-9a6e-a4f61421c384" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186399831}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "959a29f9-94e3-5ec3-bf75-8100c4fac3c4" :question/math-academy-id "q-114399" :question/problem "![](images/8f/8f20b09e85ce71a1001e7c701ebfafa3e6ac6c8adb29e8dfd47f256f37a29f5f.png)\n\nThe function $h(x)$ is continuous and twice-differentiable for all $x$ in $(-4,1.5)$ The graph $y={h}^{″}(x)$ is shown above. At what value(s) of $x$ does $h(x)$ have a point of inflection?" :question/worked-solution "First, notice that since $h(x)$ is twice-differentiable, the tangent line to the graph exists for all real $x.$\n\nInflection points occur when a graph changes concavity. In order for the graph to change concavity, the value of the second derivative ${h}^{″}(x)$ must switch signs. So, we are looking for points where the graph of ${h}^{″}(x)$ crosses the $x$-axis.\n\nWe can see that the graph $y={h}^{″}(x)$ crosses the $x$-axis at $x=-1$ and $x=1.$ \n\nTherefore, $h(x)$ has points of inflection at $x=-1$ and $x=1.$"}] [{:db/id #edb/ref 17592186054967 :knowledge-point/_questions [{:db/id #edb/ref 17592186054648 :knowledge-point/id #uuid "9a248b79-7e8b-5ad8-b2e8-847ac2030783" :knowledge-point/title "Adding Square Matrices"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a55f584c-0261-59b4-bb28-5df04c5e5bd6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}6 & 6 \\\\ 1 & 3\\end{bmatrix}" :db/id #edb/ref 17592186051333} {:answer/id #uuid "df503ec5-393a-5e2d-b982-c56e35aaa181" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}5 & 2 \\\\ 1 & 3\\end{bmatrix}" :db/id #edb/ref 17592186051334} {:answer/id #uuid "03de6fb6-f81c-5d37-a647-7b5873b78089" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}5 & 5 \\\\ 5 & 5\\end{bmatrix}" :db/id #edb/ref 17592186051335} {:answer/id #uuid "423881fd-5f5f-52b5-95c3-bdb632772bba" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-6 & 6 \\\\ 1 & -3\\end{bmatrix}" :db/id #edb/ref 17592186051336} {:answer/id #uuid "4cb4b1ee-1844-5475-bfe1-7abebf91b3b8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}6 & 6 \\\\ 6 & 6\\end{bmatrix}" :db/id #edb/ref 17592186051337}] :answer-field/id #uuid "8876c980-9b7f-5aa5-b5a7-7c5722252f32" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186051332} {:answer-field/choices [{:answer/id #uuid "a6e60215-8077-5f8c-8c55-359a0a908320" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}5 & 2 \\\\ 1 & 3\\end{aligned}]" :db/id #edb/ref 17592186386738} {:answer/id #uuid "29d738c0-81db-5e6c-91c9-db679852e3b4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}-6 & 6 \\\\ 1 & -3\\end{aligned}]" :db/id #edb/ref 17592186386739} {:answer/id #uuid "20fa7a5b-5a7b-5d2e-91fe-afbafad3502d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}6 & 6 \\\\ 6 & 6\\end{aligned}]" :db/id #edb/ref 17592186386740} {:answer/id #uuid "f1d7ca1e-94f6-54ec-80f6-9ab401480cbc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}6 & 6 \\\\ 1 & 3\\end{aligned}]" :db/id #edb/ref 17592186386741} {:answer/id #uuid "8751a674-6cb2-575b-98a1-e1863e33ff8f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}5 & 5 \\\\ 5 & 5\\end{aligned}]" :db/id #edb/ref 17592186386742}] :answer-field/correct {:answer/id #uuid "f1d7ca1e-94f6-54ec-80f6-9ab401480cbc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}6 & 6 \\\\ 1 & 3\\end{aligned}]" :db/id #edb/ref 17592186386741} :answer-field/id #uuid "1ce63358-0fcc-55be-a22f-c3c4afd97cf2" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186386737}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "06528850-f3e1-5360-9392-bba2a3bf7deb" :question/math-academy-id "q-11440" :question/problem "Calculate $A+B$, where\n\n$$\nA=[\\begin{aligned}2 & 5 \\\\ 3 & 1\\end{aligned}],\\,B=[\\begin{aligned}4 & 1 \\\\ -2 & 2\\end{aligned}].\n$$" :question/worked-solution "We add the corresponding entries:\n\n$$\n\\begin{aligned}A+B & =[\\begin{aligned}2 & 5 \\\\ 3 & 1\\end{aligned}]+[\\begin{aligned}4 & 1 \\\\ -2 & 2\\end{aligned}] \\\\  & =[\\begin{aligned}2+4 & 5+1 \\\\ 3+(-2) & 1+2\\end{aligned}] \\\\  & =[\\begin{aligned}6 & 6 \\\\ 1 & 3\\end{aligned}]\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186096973 :knowledge-point/_questions [{:db/id #edb/ref 17592186096626 :knowledge-point/id #uuid "a363f215-ed40-504a-bcae-620b7d585678" :knowledge-point/title "Finding Points of Inflection Using Differentiation When Some Points Must Be Discarded"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "72ca8b06-839c-5a79-8f13-bfd3e81f274d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "There are no points of inflection" :db/id #edb/ref 17592186248427} {:answer/id #uuid "80ad0640-73d8-5d3e-b9fa-a9c339694856" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$x=0$ only" :db/id #edb/ref 17592186248555} {:answer/id #uuid "a93a1244-1995-5a3e-9c06-d9c2577285f7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$x=0$ and $x=2$" :db/id #edb/ref 17592186248928} {:answer/id #uuid "aa286d0f-9029-5195-8490-f15cd69893c6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$x=-2$ only" :db/id #edb/ref 17592186248937} {:answer/id #uuid "d36f3b7f-5175-5eed-9d05-0a7399612346" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$x=2$ only" :db/id #edb/ref 17592186249300}] :answer-field/correct {:answer/id #uuid "d36f3b7f-5175-5eed-9d05-0a7399612346" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$x=2$ only" :db/id #edb/ref 17592186249300} :answer-field/id #uuid "f3ab6ff5-c619-5f2b-be08-bbb90d33044d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186250098}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "c163d924-6190-52ae-9f3b-628d336cfc56" :question/math-academy-id "q-114407" :question/problem "Find the $x$-coordinates of all points of inflection for $g(x)={e}^{x}({x}^{3}-8{x}^{2}+26x-36).$" :question/requires-calculator true :question/worked-solution "For continuous, twice-differentiable functions, we can determine possible points of inflection by solving the equation ${g}^{″}(x)=0.$ However, we must be sure to check that the concavity does indeed change at whatever points we find. \n\nFirst, we calculate the second derivative:\n\n$$\n\\begin{aligned}{g}^{′}(x) & ={e}^{x}({x}^{3}-8{x}^{2}+26x-36)+{e}^{x}(3{x}^{2}-16x+26) \\\\  & ={e}^{x}({x}^{3}-5{x}^{2}+10x-10) \\\\ {g}^{″}(x) & ={e}^{x}({x}^{3}-5{x}^{2}+10x-10)+{e}^{x}(3{x}^{2}-10x+10) \\\\  & ={e}^{x}({x}^{3}-2{x}^{2})\\end{aligned}\n$$\n\nNext, we solve ${g}^{″}(x)=0,$ and get\n\n$$\n\\begin{aligned}{e}^{x}({x}^{3}-2{x}^{2}) & =0 \\\\ {x}^{3}-2{x}^{2} & =0 \\\\ {x}^{2}(x-2) & =0 \\\\ x & =0,2.\\end{aligned}\n$$\n\nFinally, we need to check that the concavity changes at $x=0$ and $x=2.$ So, we choose points around them, say, \n\n$\\,$ $x=-1,\\,$ $\\,x=1,\\,$ and $\\,x=3,$ \n\nand compute the sign of ${f}^{″}(x):$\n\n$$\n\\begin{aligned}{g}^{″}(-1) & ={e}^{-1}((-1)^{3}-2(-1)^{2})=-3{e}^{-1}<0 \\\\ {g}^{″}(1) & ={e}^{1}((1)^{3}-2(1)^{2})=-e<0 \\\\ {g}^{″}(3) & ={e}^{3}((3)^{3}-2(3)^{2})=9{e}^{3}>0\\end{aligned}\n$$\n\nNotice that:\n\n- The second derivative does not change the sign at $x=0.$ So, since the concavity does *not* change at $x=0,$ we conclude that $x=0$ is *not* a point of inflection.\n\n- The second derivative changes sign at $x=2.$ So, since the concavity changes at $x=2,$ we conclude that $x=2$ is indeed a point of inflection.\n\nTherefore, only $x=2$ is an inflection point."}] [{:db/id #edb/ref 17592186250257 :knowledge-point/_questions [{:db/id #edb/ref 17592186096625 :knowledge-point/id #uuid "841151db-1c26-5059-9796-75b70e41f659" :knowledge-point/title "Finding Points of Inflection Using Differentiation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2b8a986c-cba0-5a1f-aadc-de88039a0eaa" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=-1" :db/id #edb/ref 17592186247813} {:answer/id #uuid "b8bf2f8c-40ed-5174-b6a7-6789d9a98c7c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=1" :db/id #edb/ref 17592186249074} {:answer/id #uuid "da0a8da5-cc5f-52c9-9e6b-5ccebe789dfc" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$x=0$ and $x=1$" :db/id #edb/ref 17592186249348} {:answer/id #uuid "e2a58a1e-199c-5640-9e56-5a3e8e059665" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$x=-1$ and $x=1$" :db/id #edb/ref 17592186249428} {:answer/id #uuid "e87bff9e-e43c-51bf-9781-2b8ce81787dc" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$x=-1$ and $x=0$" :db/id #edb/ref 17592186249478}] :answer-field/correct {:answer/id #uuid "e2a58a1e-199c-5640-9e56-5a3e8e059665" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$x=-1$ and $x=1$" :db/id #edb/ref 17592186249428} :answer-field/id #uuid "b3f1998f-f9ac-5ab7-836a-24f19b7c1680" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186249985}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "2b32253a-ede8-5f55-9a10-7398b09c31f0" :question/math-academy-id "q-114409" :question/problem "Find the $x$-coordinates of the points of inflection for $f(x)=\\operatorname{ln}⁡({x}^{2}+1).$" :question/worked-solution "For continuous, twice-differentiable functions, we can determine possible points of inflection by solving the equation ${f}^{″}(x)=0.$ However, we must be sure to check that the concavity does indeed change at whatever points we find. \n\nFirst, we calculate the second derivative:\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{2x}{{x}^{2}+1} \\\\ {f}^{″}(x) & =\\frac{2\\cdot ({x}^{2}+1)-2x\\cdot 2x}{({x}^{2}+1)^{2}} \\\\  & =\\frac{2(1-{x}^{2})}{(1+{x}^{2})^{2}}\\end{aligned}\n$$\n\nNext, we solve ${f}^{″}(x)=0,$ and get\n\n$$\n\\begin{aligned}\\frac{2(1-{x}^{2})}{(1+{x}^{2})^{2}} & =0 \\\\ 1-{x}^{2} & =0 \\\\ (1-x)(1+x) & =0 \\\\ x & =\\pm 1.\\end{aligned}\n$$\n\n \n\nFinally, we need to check if the concavity changes at $x=-1$  and $x=1.$ So, we pick points around them, say $x=-2,$ $x=0$ and $x=2,$ and compute the sign of ${f}^{″}(x):$    \n\n$$\n\\begin{aligned}{f}^{″}(-2) & =\\frac{2(1-(-2)^{2})}{(1+(-2)^{2})^{2}} \\\\  & =-\\frac{6}{25}<0 \\\\ {f}^{″}(0) & =\\frac{2(1-(0)^{2})}{(1+(0)^{2})^{2}} \\\\  & =2>0 \\\\ {f}^{″}(2) & =\\frac{2(1-(2)^{2})}{(1+(2)^{2})^{2}} \\\\  & =-\\frac{6}{25}<0\\end{aligned}\n$$\n\nTherefore, since the concavity changes at $x=-1$ and $x=1,$ we conclude that $x=-1$ and $x=1$ are indeed points of inflection."}] [{:db/id #edb/ref 17592186162316 :knowledge-point/_questions [{:db/id #edb/ref 17592186162105 :knowledge-point/id #uuid "277b8807-fb74-5ad3-a89b-92dbf90bc075" :knowledge-point/title "Computing the Value of a Conditional Probability Mass Function at a Point"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a91e0391-1009-57c7-83df-9e3f663ac203" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.51" :db/id #edb/ref 17592186159099} {:answer/id #uuid "be0a07fa-ec69-5761-900d-161b6c8d4c75" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.33" :db/id #edb/ref 17592186159100} {:answer/id #uuid "1c03b6fe-9fd9-5620-912b-7eb92b504bf2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.25" :db/id #edb/ref 17592186159101} {:answer/id #uuid "42f60c07-4ed0-58f2-90d1-6dd88980a4a4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.63" :db/id #edb/ref 17592186159102} {:answer/id #uuid "4b769fa8-4d1a-51a0-bd17-002bf3451d30" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.30" :db/id #edb/ref 17592186159103}] :answer-field/id #uuid "f73bc72b-af2f-55be-9ef6-7bcdd7a295e3" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186159098} {:answer-field/choices [{:answer/id #uuid "8d6cdf7e-719f-5e35-bb95-592f15a97049" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.33" :db/id #edb/ref 17592186362875} {:answer/id #uuid "29267e46-690e-5cff-a9e9-e881ccc39574" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.25" :db/id #edb/ref 17592186362876} {:answer/id #uuid "1c9e8748-0173-5a17-8466-8d181f0ccd6e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.51" :db/id #edb/ref 17592186362877} {:answer/id #uuid "08ae1027-8d0c-5690-b41c-c794a2d00fa4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.63" :db/id #edb/ref 17592186362878} {:answer/id #uuid "239c7ae7-d607-56be-ba73-85609bfdfbe2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.30" :db/id #edb/ref 17592186362879}] :answer-field/correct {:answer/id #uuid "8d6cdf7e-719f-5e35-bb95-592f15a97049" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.33" :db/id #edb/ref 17592186362875} :answer-field/id #uuid "c8ca8cff-594a-5130-973f-ac01e472eb83" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186362874}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "e4cfc159-d36d-5d4f-9156-02dbd7e02b7b" :question/math-academy-id "q-114424" :question/problem "| $f$ | $Y=0$ | $Y=1$ | $Y=2$ |\n| --- | --- | --- | --- |\n| $X=0$ | $0.3$ | $0.2$ | $0.1$ |\n| $X=1$ | $0.1$ | $0.1$ | $0.2$ |\n\nCompute ${f}_{Y|X}(1\\,|\\,0)$ given that the discrete random variables $X$ and $Y$ have the joint probability mass function $f(x,y)$ shown in the table above. Round your answer to $2$ decimal places." :question/requires-calculator true :question/worked-solution "The conditional probability mass function ${f}_{Y|X}(y\\,|\\,x)$ is defined as\n\n$$\n{f}_{Y|X}(y\\,|\\,x)=P(Y=y\\,|\\,X=x).\n$$\n\nTherefore, we're required to compute the conditional probability\n\n$$\n{f}_{Y|X}(1\\,|\\,0)=P(Y=1\\,|\\,X=0).\n$$\n\nBy the multiplication law for conditional probability, we have\n\n$$\nP(Y=1\\,|\\,X=0)=\\frac{P(X=0,Y=1)}{P(X=0)}=\\frac{f(0,1)}{{f}_{X}(0)}\n$$\n\nwhere $f(x,y)$ is the joint probability mass function of $X$ and $Y,$ and ${f}_{X}(x)$ is the marginal distribution of $X.$\n\nRecall that the marginal distribution for $X$ corresponds to the row totals. Thus, \n\n$$\n\\begin{aligned}{f}_{X}(0) & =f(0,0)+f(0,1)+f(0,2) \\\\  & =0.3+0.2+0.1 \\\\  & =0.6.\\end{aligned}\n$$\n\nFrom the given table, $f(0,1)=0.2.$ \n\nFinally, substituting  ${f}_{X}(0)=0.6$ and $f(0,1)=0.2$ in our formula above, we obtain \n\n$$\n\\begin{aligned}{f}_{Y|X}(1\\,|\\,0) & =P(Y=1\\,|\\,X=0) \\\\  & =\\frac{f(0,1)}{{f}_{X}(0)} \\\\  & =\\frac{0.2}{0.6} \\\\  & ≈0.33.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186250265 :knowledge-point/_questions [{:db/id #edb/ref 17592186096831 :knowledge-point/id #uuid "9934a8da-2378-5019-a3a3-7cd66cbeeaa7" :knowledge-point/title "Integrating Using the Secant-Tangent Identity"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "029577c8-4387-5dce-abc1-e362769c0f29" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{\\sqrt{3}}{2}" :db/id #edb/ref 17592186247442} {:answer/id #uuid "4e18de69-f618-587b-a2ec-5220370f7b7e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5}{2}" :db/id #edb/ref 17592186248124} {:answer/id #uuid "8d733b4b-1dca-53a4-a8f8-a44dd6bcbc93" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3\\sqrt{3}-1" :db/id #edb/ref 17592186248683} {:answer/id #uuid "a03c6caa-d5e0-51d2-ab76-a5150a905444" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{2}-2" :db/id #edb/ref 17592186248854} {:answer/id #uuid "cbf847c0-a882-5640-8efa-f13f377ac775" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186249238}] :answer-field/correct {:answer/id #uuid "a03c6caa-d5e0-51d2-ab76-a5150a905444" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{2}-2" :db/id #edb/ref 17592186248854} :answer-field/id #uuid "e155ce82-9147-55f3-82af-e32fec80f54d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186250060}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "590fb4d1-46ef-5eb8-ba9c-0c9e6a8189ba" :question/math-academy-id "q-114429" :question/problem "Evaluate ${\\int }_{\\pi /4}^{\\pi /3}\\frac{\\operatorname{sec}⁡x-{sec}^{3}⁡x}{\\operatorname{tan}⁡x}\\,\\text{d}x.$" :question/worked-solution "First, we select the identity that contains a $\\operatorname{sec}⁡x$ term. So we can use the identity \n\n$$\n1+{tan}^{2}⁡x={sec}^{2}⁡x.\n$$\n\nRearranging the above identity gives\n\n$$\n{tan}^{2}⁡x={sec}^{2}⁡x-1.\n$$\n\nUsing the above, we compute the given integral as follows:\n\n$$\n\\begin{aligned}{\\int }_{\\pi /4}^{\\pi /3}\\frac{\\operatorname{sec}⁡x-{sec}^{3}⁡x}{\\operatorname{tan}⁡x}\\,\\text{d}x & ={\\int }_{\\pi /4}^{\\pi /3}\\frac{(-\\operatorname{sec}⁡x)({sec}^{2}⁡x-1)}{\\operatorname{tan}⁡x}\\text{d}x \\\\  & =-{\\int }_{\\pi /4}^{\\pi /3}\\frac{\\operatorname{sec}⁡x{tan}^{2}⁡x}{\\operatorname{tan}⁡x}\\,\\text{d}x \\\\  & =-{\\int }_{\\pi /4}^{\\pi /3}\\operatorname{sec}⁡x\\operatorname{tan}⁡x\\,\\text{d}x \\\\  & =-\\operatorname{sec}⁡x\\,{|}_{\\pi /4}^{\\pi /3} \\\\  & =-[\\operatorname{sec}⁡(\\frac{\\pi }{3})-\\operatorname{sec}⁡(\\frac{\\pi }{4})] \\\\  & =-[2-\\sqrt{2}] \\\\  & =\\sqrt{2}-2\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186250266 :knowledge-point/_questions [{:db/id #edb/ref 17592186096831 :knowledge-point/id #uuid "9934a8da-2378-5019-a3a3-7cd66cbeeaa7" :knowledge-point/title "Integrating Using the Secant-Tangent Identity"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0ba2385b-5f1b-5244-83c1-b965a5b9ded8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{cos}^{2}⁡x+x+C" :db/id #edb/ref 17592186247525} {:answer/id #uuid "a5fb6d50-8041-58e2-9f41-ffe56c4a155d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{tan}⁡x+{x}^{2}+C" :db/id #edb/ref 17592186248904} {:answer/id #uuid "b2498404-3d8c-5b85-8ac6-074b6583f6f8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{sec}⁡x+{x}^{2}+C" :db/id #edb/ref 17592186249021} {:answer/id #uuid "c54e170a-1b54-506c-a4cb-a0283c751651" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{tan}⁡x+x+C" :db/id #edb/ref 17592186249178} {:answer/id #uuid "d71dbf1d-cc4e-51d5-bf05-70348d2f6da1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{sec}^{2}⁡x+{x}^{2}+C" :db/id #edb/ref 17592186249326}] :answer-field/correct {:answer/id #uuid "a5fb6d50-8041-58e2-9f41-ffe56c4a155d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{tan}⁡x+{x}^{2}+C" :db/id #edb/ref 17592186248904} :answer-field/id #uuid "5248ab5e-7d44-531f-99b3-9b3a257a9ca0" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186249823}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "e264cd7f-f120-56f7-87e8-c3568e011399" :question/math-academy-id "q-114430" :question/problem "$\\int (1+2x+{tan}^{2}⁡x)\\text{d}x=$" :question/worked-solution "First, we select the identity that contains a ${tan}^{2}⁡x$ term. So we can use the identity \n\n$$\n1+{tan}^{2}⁡x={sec}^{2}⁡x.\n$$\n\nUsing the above, we compute the given integral as follows:\n\n$$\n\\begin{aligned}\\int (1+2x+{tan}^{2}⁡x)\\text{d}x & =\\int (1+{tan}^{2}⁡x+2x)\\text{d}x \\\\  & =\\int ({sec}^{2}⁡x+2x)\\text{d}x \\\\  & =\\operatorname{tan}⁡x+{x}^{2}+C\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186250271 :knowledge-point/_questions [{:db/id #edb/ref 17592186096832 :knowledge-point/id #uuid "d0ba6d15-a20e-5f16-b324-0bbead5458ca" :knowledge-point/title "Integrating Using the Cosecant-Cotangent Identity"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4c4e702e-9e65-5bfb-8a82-fdb2e6001009" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{sec}⁡x+C" :db/id #edb/ref 17592186248105} {:answer/id #uuid "73736be6-741e-5fcb-9832-64df98a54b0f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\operatorname{csc}⁡x+C" :db/id #edb/ref 17592186248435} {:answer/id #uuid "7c14fe49-14b9-5bf3-9972-457a5f71773c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{csc}^{2}⁡x+C" :db/id #edb/ref 17592186248515} {:answer/id #uuid "a0124f95-d6d1-5e40-a93d-70118a1d48a5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-{sec}^{2}⁡x+C" :db/id #edb/ref 17592186248851} {:answer/id #uuid "fbbf0464-a2cc-5e6f-b3e6-6072187e7744" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{csc}⁡x+C" :db/id #edb/ref 17592186249616}] :answer-field/correct {:answer/id #uuid "fbbf0464-a2cc-5e6f-b3e6-6072187e7744" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{csc}⁡x+C" :db/id #edb/ref 17592186249616} :answer-field/id #uuid "3db888f0-dcaf-55b2-a986-3a13d12ea097" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186249780}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "838376fb-3080-54c1-8fed-02688e1a872e" :question/math-academy-id "q-114457" :question/problem "Calculate $\\int \\frac{{cot}^{5}⁡x-\\operatorname{cot}⁡x}{(1-{cot}^{2}⁡x)\\operatorname{csc}⁡x}\\,\\text{d}x.$" :question/worked-solution "In this case, we have to use the identity  $1+{cot}^{2}⁡x={csc}^{2}⁡x.$ \n\nTherefore, we have\n\n$$\n\\begin{aligned}\\int \\frac{{cot}^{5}⁡x-\\operatorname{cot}⁡x}{(1-{cot}^{2}⁡x)\\operatorname{csc}⁡x}\\,\\text{d}x & =\\int \\frac{-\\operatorname{cot}⁡x(1-{cot}^{4}⁡x)}{(1-{cot}^{2}⁡x)\\operatorname{csc}⁡x}\\,\\text{d}x \\\\  & =\\int \\frac{-\\operatorname{cot}⁡x(1-{cot}^{2}⁡x)(1+{cot}^{2}⁡x)}{(1-{cot}^{2}⁡x)\\operatorname{csc}⁡x}\\,\\text{d}x \\\\  & =\\int \\frac{-\\operatorname{cot}⁡x{csc}^{2}⁡x}{\\operatorname{csc}⁡x}\\,\\text{d}x \\\\  & =\\int -\\operatorname{cot}⁡x\\operatorname{csc}⁡x\\,\\text{d}x \\\\  & =\\operatorname{csc}⁡x+C\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186250273 :knowledge-point/_questions [{:db/id #edb/ref 17592186096833 :knowledge-point/id #uuid "fe5822b4-c5d4-59a8-bd72-a41d3074e4e6" :knowledge-point/title "Integrating Trigonometric Expressions With Linear Arguments Using the Pythagorean Identities"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "01fdb005-8179-54c2-a098-7a92883a30b5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{3}\\operatorname{tan}⁡(3x+2)+C" :db/id #edb/ref 17592186247436} {:answer/id #uuid "339edf8e-b1b5-5c42-85d5-0ea922cac214" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3\\operatorname{cot}⁡(3x+2)+C" :db/id #edb/ref 17592186247890} {:answer/id #uuid "628f63d4-ac2f-5bae-a486-68847a2a7cf8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{3}{cot}^{2}⁡(3x+2)+C" :db/id #edb/ref 17592186248314} {:answer/id #uuid "a3803a20-435b-5eef-bd00-4200e4e0c33d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3{tan}^{2}⁡(3x+2)+C" :db/id #edb/ref 17592186248886} {:answer/id #uuid "c27eb4c6-5c1c-5c79-82eb-47c0d4c1cb3c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3\\operatorname{tan}⁡(3x+2)+C" :db/id #edb/ref 17592186249153}] :answer-field/correct {:answer/id #uuid "01fdb005-8179-54c2-a098-7a92883a30b5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{3}\\operatorname{tan}⁡(3x+2)+C" :db/id #edb/ref 17592186247436} :answer-field/id #uuid "b025cb0b-872f-5b78-9d55-94c0d0e6743d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186249980}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "35e08417-e875-5f7f-a591-7aa6eac3199b" :question/math-academy-id "q-114467" :question/problem "$\\int \\frac{1}{{cos}^{4}⁡(3x+2)+{cos}^{2}⁡(3x+2){sin}^{2}⁡(3x+2)}\\,\\text{d}x=$" :question/worked-solution "From the identity ${cos}^{2}⁡\\theta +{sin}^{2}⁡\\theta =1,$ with $\\theta =3x+2,$ we get \n\n$$\n\\begin{aligned}{cos}^{2}⁡(3x+2)+{sin}^{2}⁡(3x+2)=1.\\end{aligned}\n$$\n\nSubstituting the above into our integral gives\n\n$$\n\\begin{aligned}\\int \\frac{1}{{cos}^{4}⁡(3x+2)+{cos}^{2}⁡(3x+2){sin}^{2}⁡(3x+2)}\\,\\text{d}x & = \\\\ \\int \\frac{1}{{cos}^{2}⁡(3x+2)({cos}^{2}⁡(3x+2)+{sin}^{2}⁡(3x+2))}\\,\\text{d}x & = \\\\ \\int \\frac{1}{{cos}^{2}⁡(3x+2)}\\,\\text{d}x & = \\\\ \\int {sec}^{2}⁡(3x+2)\\,\\text{d}x & = \\\\ \\frac{1}{3}\\operatorname{tan}⁡(3x+2)+C & .\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186250281 :knowledge-point/_questions [{:db/id #edb/ref 17592186096835 :knowledge-point/id #uuid "6c987d6e-0dd9-50fa-85a0-905c93e07413" :knowledge-point/title "Using Integration by Parts to Compute an Integral Containing an Arbitrary Logarithm"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2c5cbeda-5851-54dc-91a4-2d9aacdf002d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{x}^{3}(2\\operatorname{ln}⁡x-3)+C" :db/id #edb/ref 17592186247818} {:answer/id #uuid "7a5b0e0a-fd54-5b17-a3f8-68c3d4c9b4f7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{x}^{3}(3\\operatorname{ln}⁡x-1)+C" :db/id #edb/ref 17592186248501} {:answer/id #uuid "96b8c9cb-a0af-5f33-8ac7-df6d00314b3a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2{x}^{3}(\\operatorname{ln}⁡x+1)+C" :db/id #edb/ref 17592186248766} {:answer/id #uuid "c123fc98-b30b-56eb-a634-b7c8f040d991" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{x}^{3}(\\operatorname{ln}⁡x-2)+C" :db/id #edb/ref 17592186249143} {:answer/id #uuid "ee783aa1-4fd7-5339-a5a6-8cb5d3ad68d0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2{x}^{3}(\\operatorname{ln}⁡x-3)+C" :db/id #edb/ref 17592186249517}] :answer-field/correct {:answer/id #uuid "7a5b0e0a-fd54-5b17-a3f8-68c3d4c9b4f7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{x}^{3}(3\\operatorname{ln}⁡x-1)+C" :db/id #edb/ref 17592186248501} :answer-field/id #uuid "390d5c78-f0af-5330-afda-79a10ff893e2" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186249772}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "3faaa55a-7a42-5cea-8d42-e9f7ac430290" :question/math-academy-id "q-114551" :question/problem "Calculate $\\int 9{x}^{2}\\operatorname{ln}⁡(x)\\,\\text{d}x.$" :question/worked-solution "We will solve this problem using integration by parts. We start by defining $u$ and ${v}^{′},$ as follows:\n\n$$\n\\begin{aligned}u=\\operatorname{ln}⁡(x)\\, & ⟹\\,{u}^{′}=\\frac{1}{x} \\\\ {v}^{′}=9{x}^{2}\\, & ⟹\\,v=\\int 9{x}^{2}\\,\\text{d}x=3{x}^{3}\\end{aligned}\n$$\n\nUsing the formula of integration by parts, we get\n\n$$\n\\begin{aligned}\\int 9{x}^{2}\\operatorname{ln}⁡(x)\\,\\text{d}x & =\\int u{v}^{′}\\,\\text{d}x \\\\  & =uv-\\int v{u}^{′}\\,\\text{d}x \\\\  & =\\operatorname{ln}⁡(x)(3{x}^{3})-\\int \\frac{3{x}^{3}}{x}\\,\\text{d}x \\\\  & =3{x}^{3}\\operatorname{ln}⁡(x)-3\\int {x}^{2}\\,\\text{d}x \\\\  & =3{x}^{3}\\operatorname{ln}⁡x-{x}^{3}+C \\\\  & ={x}^{3}(3\\operatorname{ln}⁡x-1)+C,\\end{aligned}\n$$\n\nwhere $C$ is an integral constant."}] [{:db/id #edb/ref 17592186250283 :knowledge-point/_questions [{:db/id #edb/ref 17592186096835 :knowledge-point/id #uuid "6c987d6e-0dd9-50fa-85a0-905c93e07413" :knowledge-point/title "Using Integration by Parts to Compute an Integral Containing an Arbitrary Logarithm"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0aec5f05-d22a-5c56-9672-60bc96c1bb04" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{x}^{2}}{\\operatorname{ln}⁡2}(4\\operatorname{ln}⁡x-1)+C" :db/id #edb/ref 17592186247519} {:answer/id #uuid "1f5abc59-c7e4-5c8a-87f4-b54b803742a9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{x}^{2}}{4\\operatorname{ln}⁡2}(\\operatorname{ln}⁡x+1)+C" :db/id #edb/ref 17592186247702} {:answer/id #uuid "35fbcfa4-611f-5481-a5a0-e26daf32fe8f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{x}^{2}}{4\\operatorname{ln}⁡2}(4\\operatorname{ln}⁡x+1)+C" :db/id #edb/ref 17592186247912} {:answer/id #uuid "3e70e2aa-5270-59bd-8d76-329cce6e0fdc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{x}^{2}}{4\\operatorname{ln}⁡2}(2\\operatorname{ln}⁡x-1)+C" :db/id #edb/ref 17592186247976} {:answer/id #uuid "e913e7e7-7377-58f1-a576-f2631769debf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{x}^{2}}{2\\operatorname{ln}⁡2}(\\operatorname{ln}⁡x-1)+C" :db/id #edb/ref 17592186249484}] :answer-field/correct {:answer/id #uuid "3e70e2aa-5270-59bd-8d76-329cce6e0fdc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{x}^{2}}{4\\operatorname{ln}⁡2}(2\\operatorname{ln}⁡x-1)+C" :db/id #edb/ref 17592186247976} :answer-field/id #uuid "258426ca-e1eb-5f21-b193-8a88f0107073" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186249736}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "0ce30fbb-1b42-559b-a553-f2eb05e4f3a4" :question/math-academy-id "q-114553" :question/problem "Calculate $\\int x{log}_{2}⁡(x)\\,\\text{d}x.$" :question/worked-solution "We will solve this problem using integration by parts. We start by defining $u$ and ${v}^{′},$ as follows:\n\n$$\n\\begin{aligned}u={log}_{2}⁡(x)\\, & ⟹\\,{u}^{′}=\\frac{1}{x\\operatorname{ln}⁡2} \\\\ {v}^{′}=x\\, & ⟹\\,v=\\int x\\,\\text{d}x=\\frac{{x}^{2}}{2}\\end{aligned}\n$$\n\nUsing the formula of integration by parts, we get\n\n$$\n\\begin{aligned}\\int x{log}_{2}⁡(x)\\,\\text{d}x & =\\int u{v}^{′}\\,\\text{d}x \\\\  & =uv-\\int v{u}^{′}\\,\\text{d}x \\\\  & ={log}_{2}⁡(x)(\\frac{{x}^{2}}{2})-\\int (\\frac{{x}^{2}}{2})(\\frac{1}{x\\operatorname{ln}⁡2})\\,\\text{d}x \\\\  & =\\frac{{x}^{2}{log}_{2}⁡(x)}{2}-\\frac{1}{2\\operatorname{ln}⁡2}\\int x\\,\\text{d}x \\\\  & =\\frac{{x}^{2}{log}_{2}⁡(x)}{2}-\\frac{1}{2\\operatorname{ln}⁡2}\\cdot \\frac{{x}^{2}}{2}+C \\\\  & =\\frac{{x}^{2}\\operatorname{ln}⁡x}{2\\operatorname{ln}⁡2}-\\frac{{x}^{2}}{4\\operatorname{ln}⁡2}+C \\\\  & =\\frac{{x}^{2}}{4\\operatorname{ln}⁡2}(2\\operatorname{ln}⁡x-1)+C,\\end{aligned}\n$$\n\nwhere $C$ is an integral constant.\n\nNote that in the above calculation we used the change of base formula ${log}_{2}⁡x=\\frac{\\operatorname{ln}⁡x}{\\operatorname{ln}⁡2}.$"}] [{:db/id #edb/ref 17592186250284 :knowledge-point/_questions [{:db/id #edb/ref 17592186096835 :knowledge-point/id #uuid "6c987d6e-0dd9-50fa-85a0-905c93e07413" :knowledge-point/title "Using Integration by Parts to Compute an Integral Containing an Arbitrary Logarithm"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "109b22a6-d3dd-5ed0-be45-6c1e67dc6541" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{x}^{4}(\\operatorname{ln}⁡(3x)-1)+C" :db/id #edb/ref 17592186247569} {:answer/id #uuid "229a39f8-42eb-5bb6-86d4-bbfff2c4c90a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{x}^{4}(2\\operatorname{ln}⁡(3x)-\\frac{1}{2})+C" :db/id #edb/ref 17592186247733} {:answer/id #uuid "506fd08e-5636-5073-8b9b-999fb05b57d5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{x}^{4}(\\frac{\\operatorname{ln}⁡(3x)}{3}-1)+C" :db/id #edb/ref 17592186248145} {:answer/id #uuid "7c2a25c7-9320-5224-a084-275ada01afa1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{x}^{2}(2\\operatorname{ln}⁡(3x)+1)+C" :db/id #edb/ref 17592186248516} {:answer/id #uuid "eccb6e3d-85c6-5f1b-b431-8c4a9a157def" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{x}^{2}(\\operatorname{ln}⁡(3x)+\\frac{1}{3})+C" :db/id #edb/ref 17592186249503}] :answer-field/correct {:answer/id #uuid "229a39f8-42eb-5bb6-86d4-bbfff2c4c90a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{x}^{4}(2\\operatorname{ln}⁡(3x)-\\frac{1}{2})+C" :db/id #edb/ref 17592186247733} :answer-field/id #uuid "2c8a9067-e08c-5e41-a1c1-212dc091969f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186249755}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "9fadab91-be05-5653-9838-592471a9067d" :question/math-academy-id "q-114555" :question/problem "Calculate $\\int 8{x}^{3}\\operatorname{ln}⁡(3x)\\,\\text{d}x.$" :question/worked-solution "We will solve this problem using integration by parts. We start by defining $u$ and ${v}^{′},$ as follows:\n\n$$\n\\begin{aligned}u=\\operatorname{ln}⁡(3x)\\, & ⟹\\,{u}^{′}=\\frac{1}{x} \\\\ {v}^{′}=8{x}^{3}\\, & ⟹\\,v=\\int 8{x}^{3}\\,\\text{d}x=2{x}^{4}\\end{aligned}\n$$\n\nUsing the formula of integration by parts, we get\n\n$$\n\\begin{aligned}\\int 8{x}^{3}\\operatorname{ln}⁡(3x)\\,\\text{d}x & =\\int u{v}^{′}\\,\\text{d}x \\\\  & =uv-\\int v{u}^{′}\\,\\text{d}x \\\\  & =\\operatorname{ln}⁡(3x)\\cdot (2{x}^{4})-\\int \\frac{2{x}^{4}}{x}\\,\\text{d}x \\\\  & =2{x}^{4}\\operatorname{ln}⁡(3x)-2\\int {x}^{3}\\,\\text{d}x \\\\  & =2{x}^{4}\\operatorname{ln}⁡(3x)-2\\cdot \\frac{{x}^{4}}{4}+C \\\\  & =2{x}^{4}\\operatorname{ln}⁡(3x)-\\frac{{x}^{4}}{2}+C \\\\  & ={x}^{4}(2\\operatorname{ln}⁡(3x)-\\frac{1}{2})+C,\\end{aligned}\n$$\n\nwhere $C$ is an integral constant."}] [{:db/id #edb/ref 17592186250287 :knowledge-point/_questions [{:db/id #edb/ref 17592186096836 :knowledge-point/id #uuid "4435e346-d6ad-58cd-97cb-bbd45e121759" :knowledge-point/title "Using Integration by Parts to Compute an Integral Containing a Single Logarithmic Factor"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "15cc7c1e-0aac-5e18-b3d0-b97a6a690932" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3x\\operatorname{ln}⁡({x}^{3})+x+C" :db/id #edb/ref 17592186247621} {:answer/id #uuid "6ea3301f-d688-59a3-950d-465f967b6bf0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x\\operatorname{ln}⁡({x}^{3})-x+C" :db/id #edb/ref 17592186248405} {:answer/id #uuid "70836d74-f57c-520e-9d55-15cbd7b1b85e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x\\operatorname{ln}⁡({x}^{3})-3x+C" :db/id #edb/ref 17592186248411} {:answer/id #uuid "e8dbf220-1331-5959-a25d-f91fae9d8fdd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x\\operatorname{ln}⁡({x}^{3})-\\frac{x}{3}+C" :db/id #edb/ref 17592186249481} {:answer/id #uuid "fcc00e49-cda4-5328-8957-960d8b8b119d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{3}x\\operatorname{ln}⁡({x}^{3})+x+C" :db/id #edb/ref 17592186249631}] :answer-field/correct {:answer/id #uuid "70836d74-f57c-520e-9d55-15cbd7b1b85e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x\\operatorname{ln}⁡({x}^{3})-3x+C" :db/id #edb/ref 17592186248411} :answer-field/id #uuid "9e710170-49ca-5826-8dbb-1a253c592fad" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186249947}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "ac6118b3-9859-5ff7-afb9-8425a21afcf2" :question/math-academy-id "q-114579" :question/problem "$\\int \\operatorname{ln}⁡({x}^{3})\\,\\text{d}x=$" :question/worked-solution "First, we write the integral as\n\n$$\n\\int \\operatorname{ln}⁡({x}^{3})\\,\\text{d}x=\\int \\operatorname{ln}⁡({x}^{3})\\cdot 1\\,\\text{d}x.\n$$\n\n \n\nWe will solve this problem using integration by parts. We start by defining $u$ and ${v}^{′},$ as follows:\n\n$$\n\\begin{aligned}u=\\operatorname{ln}⁡({x}^{3})\\, & ⟹\\,{u}^{′}=\\frac{1}{{x}^{3}}\\cdot 3{x}^{2}=\\frac{3}{x} \\\\ {v}^{′}=1\\, & ⟹\\,v=\\int \\,\\text{d}x=x\\end{aligned}\n$$\n\nUsing the formula of integration by parts, we get\n\n$$\n\\begin{aligned}\\int \\operatorname{ln}⁡({x}^{3})\\,\\text{d}x & =\\int u\\,{v}^{′}\\,\\text{d}x \\\\  & =uv-\\int v{u}^{′}\\,\\text{d}x \\\\  & =\\operatorname{ln}⁡({x}^{3})\\cdot x-\\int x\\cdot \\frac{3}{x}\\,\\text{d}x \\\\  & =x\\operatorname{ln}⁡({x}^{3})-3\\int \\,\\text{d}x \\\\  & =x\\operatorname{ln}⁡({x}^{3})-3x+C,\\end{aligned}\n$$\n\nwhere $C$ is an integral constant."}] [{:db/id #edb/ref 17592186250289 :knowledge-point/_questions [{:db/id #edb/ref 17592186096836 :knowledge-point/id #uuid "4435e346-d6ad-58cd-97cb-bbd45e121759" :knowledge-point/title "Using Integration by Parts to Compute an Integral Containing a Single Logarithmic Factor"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "169d00e9-ff9f-5c38-8f46-5de59c2888ad" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(2x-1)\\operatorname{ln}⁡(x-3)+C" :db/id #edb/ref 17592186247625} {:answer/id #uuid "252ae1f2-0ff5-5aea-9a8d-05890709bff4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(2x-1)\\operatorname{ln}⁡(x-3)-x+C" :db/id #edb/ref 17592186247749} {:answer/id #uuid "5e9299bd-e3da-5867-abbc-88541b7c723a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(x-3)\\operatorname{ln}⁡(x-3)+3x+C" :db/id #edb/ref 17592186248282} {:answer/id #uuid "7b2e9a70-c5d1-5444-9bd8-e35dad282469" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(x-3)\\operatorname{ln}⁡(x-3)-x+C" :db/id #edb/ref 17592186248505} {:answer/id #uuid "ee6d1432-6c74-5214-bc6f-8a0110973275" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(x-3)\\operatorname{ln}⁡(x-3)-6x+C" :db/id #edb/ref 17592186249516}] :answer-field/correct {:answer/id #uuid "7b2e9a70-c5d1-5444-9bd8-e35dad282469" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(x-3)\\operatorname{ln}⁡(x-3)-x+C" :db/id #edb/ref 17592186248505} :answer-field/id #uuid "5b67ce59-7c51-5b9e-99cb-913e6ac5b44b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186249834}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "eec9484d-20c7-527b-9679-505624b164e9" :question/math-academy-id "q-114592" :question/problem "$\\int \\operatorname{ln}⁡(x-3)\\,\\text{d}x=$" :question/worked-solution "First, we write the integral as\n\n$$\n\\int \\operatorname{ln}⁡(x-3)\\,\\text{d}x=\\int \\operatorname{ln}⁡(x-3)\\cdot 1\\cdot \\text{d}x.\n$$\n\n \n\nWe will solve this problem using integration by parts. We start by defining $u$ and ${v}^{′},$ as follows:\n\n$$\n\\begin{aligned}u=\\operatorname{ln}⁡(x-3)\\, & ⟹\\,{u}^{′}=\\frac{1}{x-3} \\\\ {v}^{′}=1\\, & ⟹\\,v=\\int \\,\\text{d}x=x\\end{aligned}\n$$\n\nUsing the formula of integration by parts, we get\n\n$$\n\\begin{aligned}\\int \\operatorname{ln}⁡(x-3)\\,\\text{d}x & =\\int u\\,{v}^{′}\\,\\text{d}x \\\\  & =uv-\\int v{u}^{′}\\,\\text{d}x \\\\  & =\\operatorname{ln}⁡(x-3)\\cdot x-\\int x\\cdot \\frac{1}{x-3}\\,\\text{d}x \\\\  & =x\\operatorname{ln}⁡(x-3)-\\int \\frac{x}{x-3}\\,\\text{d}x.\\end{aligned}\n$$\n\nNow, we use a substitution $x-3=u,$ thus $x=u+3$ and $\\text{d}x=\\text{d}u.$ Hence,\n\n$$\n\\begin{aligned}\\int \\operatorname{ln}⁡(x-3)\\,\\text{d}x & =x\\operatorname{ln}⁡(x-3)-\\int \\frac{x}{x-3}\\,\\text{d}x \\\\  & =x\\operatorname{ln}⁡(x-3)-\\int \\frac{u+3}{u}\\,\\text{d}u \\\\  & =x\\operatorname{ln}⁡(x-3)-\\int \\,\\text{d}u-3\\int \\frac{\\text{d}u}{u} \\\\  & =x\\operatorname{ln}⁡(x-3)-u-3\\operatorname{ln}⁡u+D \\\\  & =x\\operatorname{ln}⁡(x-3)-(x-3)-3\\operatorname{ln}⁡(x-3)+D \\\\  & =x\\operatorname{ln}⁡(x-3)-3\\operatorname{ln}⁡(x-3)-x+3+D \\\\  & =(x-3)\\operatorname{ln}⁡(x-3)-x+C,\\end{aligned}\n$$\n\nwhere $C=D+3$ is an integral constant."}] [{:db/id #edb/ref 17592186250291 :knowledge-point/_questions [{:db/id #edb/ref 17592186096665 :knowledge-point/id #uuid "c4c5541e-8195-53de-b604-e622c3b6a2e7" :knowledge-point/title "Integrating Expressions Using the Double-Angle Formula for Sine"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "54f9b9a3-311d-5712-b1f8-0b2cc2693c80" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{x}^{2}+\\frac{1}{4}\\operatorname{cos}⁡2x+C" :db/id #edb/ref 17592186248190} {:answer/id #uuid "819c9f6e-eee9-518f-ad4d-dab8c5f22481" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{x}^{2}+2\\operatorname{cos}⁡2x+C" :db/id #edb/ref 17592186248570} {:answer/id #uuid "966730f7-44f6-5c2d-8640-3e5f5ac629da" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2{x}^{2}-\\frac{1}{4}\\operatorname{cos}⁡2x+C" :db/id #edb/ref 17592186248761} {:answer/id #uuid "c3fb894f-898b-5b82-a4af-80883361e3b1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{x}^{2}-\\frac{1}{2}\\operatorname{cos}⁡2x+C" :db/id #edb/ref 17592186249164} {:answer/id #uuid "dab1de7d-e9e0-50f5-8b17-8824b9b35fd3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2{x}^{2}+\\frac{1}{2}\\operatorname{cos}⁡2x+C" :db/id #edb/ref 17592186249356}] :answer-field/correct {:answer/id #uuid "54f9b9a3-311d-5712-b1f8-0b2cc2693c80" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{x}^{2}+\\frac{1}{4}\\operatorname{cos}⁡2x+C" :db/id #edb/ref 17592186248190} :answer-field/id #uuid "41e34ed1-9695-54d8-96f0-fc2c12813104" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186249785}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "228e02d3-780d-535b-b966-624ae49969cb" :question/math-academy-id "q-114600" :question/problem "Calculate $\\int (2x-\\operatorname{sin}⁡x\\operatorname{cos}⁡x)\\,\\text{d}x.$" :question/worked-solution "In this case, we use the double-angle formula for sine:\n\n$$\n\\operatorname{sin}⁡2x=2\\operatorname{sin}⁡x\\operatorname{cos}⁡x\n$$\n\nRearranging the above formula, we get\n\n$$\n\\frac{1}{2}\\operatorname{sin}⁡2x=\\operatorname{sin}⁡x\\operatorname{cos}⁡x.\n$$\n\n \n\nTherefore, \n\n$$\n\\begin{aligned}\\int (2x-\\operatorname{sin}⁡x\\operatorname{cos}⁡x)\\,\\text{d}x & =\\int (2x-\\frac{1}{2}\\operatorname{sin}⁡2x)\\text{d}x \\\\  & =2(\\frac{1}{2}{x}^{2})-\\frac{1}{2}(-\\frac{1}{2}\\operatorname{cos}⁡2x)+C \\\\  & ={x}^{2}+\\frac{1}{4}\\operatorname{cos}⁡2x+C.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186250292 :knowledge-point/_questions [{:db/id #edb/ref 17592186059745 :knowledge-point/id #uuid "aa2418a8-b245-5600-8e7e-c54506e3f321" :knowledge-point/title "Determining the Dimensions of the Transpose of a Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "37d835b3-b8ec-5e89-ad21-f406e8245dff" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\times 2" :db/id #edb/ref 17592186247926} {:answer/id #uuid "4bdda686-568c-57f8-9c75-7de72c2fea13" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3\\times 3" :db/id #edb/ref 17592186248102} {:answer/id #uuid "64eae76e-3fa0-56bd-b6fd-8d334d54f4c0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3\\times 2" :db/id #edb/ref 17592186248335} {:answer/id #uuid "79c5da51-d030-5fc9-8362-a48f8dcd8a87" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1\\times 1" :db/id #edb/ref 17592186248496} {:answer/id #uuid "bc9d7200-797d-5c8c-84f8-e8dcce22f30c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1\\times 3" :db/id #edb/ref 17592186249106}] :answer-field/correct {:answer/id #uuid "37d835b3-b8ec-5e89-ad21-f406e8245dff" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\times 2" :db/id #edb/ref 17592186247926} :answer-field/id #uuid "1f3a2dfc-0a9b-5c06-be54-a964b9d31e22" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186249727}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "55ec6bf0-28c7-50e4-93fc-37f45d7409ca" :question/math-academy-id "q-11462" :question/problem "Consider the matrix\n    $C=[\\begin{aligned}1 & 3 \\\\ 2 & 4\\end{aligned}].$\nWhat are the dimensions of ${C}^{T}?$" :question/worked-solution "When a matrix is transposed, its dimensions switch from $m\\times n$ to $n\\times m.$\n\nSo, since $C$ is a $2\\times 2$ matrix, the transpose ${C}^{T}$ is a $2\\times 2$ matrix too."}]}
