t :answer.type/image} :answer/value "images/3a/3a8f77e96f836eadfdb1a0c73f35bad5e245b66df0f21daec6ac008fb69a4815.png" :db/id #edb/ref 17592186386685} {:answer/id #uuid "f85feca0-357a-5c74-8fde-4d7fdaa2cd0b" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/f5/f558777e9ec384bdd169cddefeac589861cae2568f130816c4bf7a1f4ee1e520.png" :db/id #edb/ref 17592186386686} {:answer/id #uuid "dba9cafa-0a6c-53c7-80a2-61fb5e35090a" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/8f/8f2a42430ac31a559e5f85c961579aa482280bd9b69ed5d948250f5fafce21a5.png" :db/id #edb/ref 17592186386687} {:answer/id #uuid "b0a9dbae-7498-55b8-b00b-07a41ab70457" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/0b/0bb082b243d961b45b63d352f84359d7022492df93e781f93114206e9924b5c2.png" :db/id #edb/ref 17592186386688}] :answer-field/correct {:answer/id #uuid "f85feca0-357a-5c74-8fde-4d7fdaa2cd0b" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/f5/f558777e9ec384bdd169cddefeac589861cae2568f130816c4bf7a1f4ee1e520.png" :db/id #edb/ref 17592186386686} :answer-field/id #uuid "1a9d5ff1-d590-522a-bcb5-31d743a32102" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186386683}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "110d0b81-fd68-5dac-ba01-18cdf7c4cb65" :question/math-academy-id "q-113463" :question/problem "Which of the following is the graph of $y=\\frac{3}{4(x-1)}?$" :question/worked-solution "To plot $y=\\frac{3}{4(x-1)},$ we apply the following steps:\n\n- Take the curve $y=\\frac{1}{x}.$\n\n![](images/e8/e80865b0f32a5473da27b39537034bcdabee0a6c24032f41413e20518642d3f4.png)\n\n- Translate it by $1$ unit to the right to get the graph of $y=\\frac{1}{x-1}.$\n\n![](images/8f/8f2a42430ac31a559e5f85c961579aa482280bd9b69ed5d948250f5fafce21a5.png)\n\n- Then, stretch the result by a scale factor of $\\frac{3}{4}$ parallel to the $y$-axis to get the graph of $y=\\frac{3}{4(x-1)}.$\n\n![](images/f5/f558777e9ec384bdd169cddefeac589861cae2568f130816c4bf7a1f4ee1e520.png)"}] [{:db/id #edb/ref 17592186247353 :knowledge-point/_questions [{:db/id #edb/ref 17592186068780 :knowledge-point/id #uuid "308f3685-0a90-56f3-9653-a83cec4286d2" :knowledge-point/title "Solving for Some Unknowns Given the Graph of a Transformed Reciprocal Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1f0f5357-6a5d-52cb-a0b3-8bb0331ee994" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186244583} {:answer/id #uuid "606311eb-894b-5b77-b109-e32e121ff8d3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1.5" :db/id #edb/ref 17592186245155} {:answer/id #uuid "6d13ff09-b329-5200-85b0-89687a5270ba" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186245277} {:answer/id #uuid "7f280c4b-6081-508f-8997-4749439fa6b4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-4.5" :db/id #edb/ref 17592186245435} {:answer/id #uuid "847e53f3-ba86-5571-b86e-1f4f19fe8930" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-0.5" :db/id #edb/ref 17592186245483}] :answer-field/correct {:answer/id #uuid "606311eb-894b-5b77-b109-e32e121ff8d3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1.5" :db/id #edb/ref 17592186245155} :answer-field/id #uuid "917d77c5-3e45-5592-bf27-58d3f7e98794" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186246797}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "3d881fc0-905f-5d7f-8a88-250eeb9291b8" :question/math-academy-id "q-113482" :question/problem "![](images/4d/4d2dec8a05bc9835693c1df9dbc54618fd39d77667cbbdcd5bb6d92bf25c0d97.png)\n\nThe graph represents the function $y=\\frac{a}{x-b}+k.$ What is the value of $a+b+k?$" :question/worked-solution "First, notice that the horizontal asymptote of the graph is $y=0.5,$ while the vertical asymptote is $x=3.$ This means that $k=0.5$ and $b=3,$ and we can re-write our function as\n\n$$\ny=\\frac{a}{x-3}+0.5.\n$$\n\nAlso, we are given that the point $(1,1.5)$ lies on the graph. Substituting its coordinates into the equation above, we obtain\n\n$$\n\\begin{aligned}y & =\\frac{a}{x-3}+0.5 \\\\ 1.5 & =\\frac{a}{1-3}+0.5 \\\\ 1 & =\\frac{a}{-2} \\\\ a & =-2.\\end{aligned}\n$$\n\nFinally, $a+b+k=-2+3+0.5=1.5.$"}] [{:db/id #edb/ref 17592186364852 :knowledge-point/_questions [{:db/id #edb/ref 17592186129303 :knowledge-point/id #uuid "bd0aa5fc-79de-525e-a688-a8a2d2fcf858" :knowledge-point/title "Solving for an Unknown Constant in a Transformed Reciprocal Function Given the Domain"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a2016816-28e8-5d51-9785-1496f42addb7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-5" :db/id #edb/ref 17592186364854} {:answer/id #uuid "a1103bae-8319-57e0-97ad-c5f4b71339b0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186364855} {:answer/id #uuid "58d4f932-503e-5417-a6ef-0f99b77003fd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186364856} {:answer/id #uuid "7872df49-3602-579a-81a7-9757623ee8c0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186364857} {:answer/id #uuid "51e49929-146d-5950-b7fb-a559e7e56524" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186364858}] :answer-field/correct {:answer/id #uuid "51e49929-146d-5950-b7fb-a559e7e56524" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186364858} :answer-field/id #uuid "6c3b44ec-e362-5848-b757-e1a30a3bc178" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186364853}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "ee16459a-bf12-529f-aa3b-cc89f5e9cb99" :question/math-academy-id "q-113501" :question/problem "The domain of the function $f(x)=\\frac{4x+3}{5x+2k}$ is $(-\\infty ,\\frac{2}{5})\\cup (\\frac{2}{5},\\infty ).$ What is the value of $k?$" :question/worked-solution "A reciprocal function is defined for all values of $x$ except for those that make the denominator zero. So, to find the domain, we must exclude all values that make the denominator zero.\n\nSetting the denominator equal to zero and solving, we get\n\n$$\n\\begin{aligned}5x+2k & =0 \\\\ 5x & =-2k \\\\ x & =-\\frac{2k}{5}.\\end{aligned}\n$$\n\nSo, the point that must be excluded from the domain is $x=-\\frac{2k}{5}.$ \n\nOn the other hand, we can see that $x=\\frac{2}{5}$ is excluded from the domain. Equating this to $-\\frac{2k}{5},$ we get\n\n$$\n\\begin{aligned}-\\frac{2k}{5} & =\\frac{2}{5} \\\\ \\frac{k}{5} & =-\\frac{1}{5} \\\\ k & =-1.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186398102 :knowledge-point/_questions [{:db/id #edb/ref 17592186064203 :knowledge-point/id #uuid "e2b47545-fdf1-5e6a-b0bb-bbbecb8067cc" :knowledge-point/title "Integrating an Algebraic Function With Positive Integer Exponent"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "326be129-c932-54e7-bd6e-d61f8a6c1750" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{18}{5}(2-5x)^{6}+C" :db/id #edb/ref 17592186398104} {:answer/id #uuid "d8f6915c-a30b-538c-be4c-c5d4feafc456" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{3}{5}(2-5x)^{6}+C" :db/id #edb/ref 17592186398105} {:answer/id #uuid "d929af17-b6b6-5bb1-9948-38e8c5714648" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{5}(2-5x)^{6}+C" :db/id #edb/ref 17592186398106} {:answer/id #uuid "e257789f-7b07-5075-adc9-57e60483dc0d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{18}{5}(2-5x)^{6}+C" :db/id #edb/ref 17592186398107} {:answer/id #uuid "65143245-b12a-5ed5-a1a3-dc55de2b261a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{15}(2-5x)^{6}+C" :db/id #edb/ref 17592186398108}] :answer-field/correct {:answer/id #uuid "d8f6915c-a30b-538c-be4c-c5d4feafc456" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{3}{5}(2-5x)^{6}+C" :db/id #edb/ref 17592186398105} :answer-field/id #uuid "0d582062-813e-5b4d-b116-6b4cb9d5d390" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186398103}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "201b1303-edfe-5a94-b70a-3687fd03d284" :question/math-academy-id "q-113502" :question/problem "$\\int 18(2-5x)^{5}\\,\\text{d}x=$" :question/worked-solution "Let $u=2-5x.$ Then differentiating with respect to $x$ gives\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=-5\\,⟹\\,\\text{d}x=-\\frac{1}{5}\\text{d}u.\n$$\n\nWe now write our integral in terms of $u,$ calculate the integral as normal, and write the final answer in terms of $x$ at the very end:\n\n$$\n\\begin{aligned}\\int 18(2-5x)^{5}\\,\\text{d}x & =\\int 18{u}^{5}\\cdot (-\\frac{1}{5})\\text{d}u \\\\  & =18\\cdot (-\\frac{1}{5})\\int {u}^{5}\\cdot \\,\\text{d}u \\\\  & =-\\frac{18}{5}\\int {u}^{5}\\,\\text{d}u \\\\  & =-\\frac{18}{5}\\cdot \\frac{{u}^{6}}{6}+C \\\\  & =-\\frac{3}{5}{u}^{6}+C \\\\  & =-\\frac{3}{5}(2-5x)^{6}+C\\end{aligned}\n$$\n\nLet's double-check that our result is correct. If we differentiate the result, then it should come out to the original integrand:\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}[-\\frac{3}{5}(2-5x)^{6}+C] & =-\\frac{\\text{d}}{\\text{d}x}[\\frac{3}{5}(2-5x)^{6}]+\\frac{\\text{d}}{\\text{d}x}(C) \\\\  & =-\\frac{18}{5}(2-5x)^{5}\\cdot \\frac{\\text{d}}{\\text{d}x}(2-5x)+0 \\\\  & =-\\frac{18}{5}(2-5x)^{5}\\cdot (-5) \\\\  & =18(2-5x)^{5}\\,✓\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186398109 :knowledge-point/_questions [{:db/id #edb/ref 17592186064204 :knowledge-point/id #uuid "387d85df-b839-5837-89b9-5e4bb4daa073" :knowledge-point/title "Integrating an Algebraic Function With Negative Integer Exponent"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "87bb5e34-8a7e-5077-9056-44171c31d68f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{2(x-2)^{4}}+C" :db/id #edb/ref 17592186398111} {:answer/id #uuid "73df82c1-76f6-50ea-99b9-53a33ba7607d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2(x-2)^{2}}+C" :db/id #edb/ref 17592186398112} {:answer/id #uuid "cfab3df7-4bb6-5eeb-9342-3841991827b8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{2}{(x-2)^{2}}+C" :db/id #edb/ref 17592186398113} {:answer/id #uuid "1e49762e-1e14-5248-8c9e-16a5e673bda1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{(x-2)^{2}}+C" :db/id #edb/ref 17592186398114} {:answer/id #uuid "15a56691-9975-5ae2-aa7b-fda010fe63b8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{2(x-2)^{2}}+C" :db/id #edb/ref 17592186398115}] :answer-field/correct {:answer/id #uuid "15a56691-9975-5ae2-aa7b-fda010fe63b8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{2(x-2)^{2}}+C" :db/id #edb/ref 17592186398115} :answer-field/id #uuid "c13dea0f-f218-5cd2-a503-c7b2250d51fb" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186398110}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "1948aa2d-5fbb-59f5-8ccc-6dd9cfd6ef51" :question/math-academy-id "q-113509" :question/problem "Calculate the integral $\\int \\frac{1}{(x-2)^{3}}\\,\\text{d}x.$" :question/worked-solution "First, we rewrite the integral as\n\n$$\n\\int (x-2)^{-3}\\,\\text{d}x.\n$$\n\nLet $u=x-2.$ Then differentiating with respect to $x$ gives\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=1\\,⟹\\,\\text{d}x=\\text{d}u.\n$$\n\nWe now write our integral in terms of $u,$ calculate the integral as normal, and write the final answer in terms of $x$ at the very end:\n\n$$\n\\begin{aligned}\\int (x-2)^{-3}\\,\\text{d}x & =\\int {u}^{-3}\\cdot \\text{d}u \\\\  & =-\\frac{1}{2}\\cdot {u}^{-2}+C \\\\  & =-\\frac{1}{2{u}^{2}}+C \\\\  & =-\\frac{1}{2(x-2)^{2}}+C\\end{aligned}\n$$\n\nLet's double-check that our result is correct. If we differentiate the result, then it should come out to the original integrand:\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}[-\\frac{1}{2(x-2)^{2}}+C] & =\\frac{\\text{d}}{\\text{d}x}[-\\frac{1}{2(x-2)^{2}}]+\\frac{\\text{d}}{\\text{d}x}(C) \\\\  & =-\\frac{1}{2}\\frac{\\text{d}}{\\text{d}x}[(x-2)^{-2}]+\\frac{\\text{d}}{\\text{d}x}(C) \\\\  & =-\\frac{1}{2}\\cdot (-2)\\cdot (x-2)^{-3}\\cdot \\frac{\\text{d}}{\\text{d}x}(x-2)+0 \\\\  & =1\\cdot \\frac{1}{(x-2)^{3}}\\cdot 1 \\\\  & =\\frac{1}{(x-2)^{3}}\\,✓\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186398116 :knowledge-point/_questions [{:db/id #edb/ref 17592186064204 :knowledge-point/id #uuid "387d85df-b839-5837-89b9-5e4bb4daa073" :knowledge-point/title "Integrating an Algebraic Function With Negative Integer Exponent"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "06f0d601-5b9e-5b34-b1e4-35332ff61132" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{20(9-5x)^{4}}+C" :db/id #edb/ref 17592186398118} {:answer/id #uuid "ae0f063f-eba9-55db-a617-104bbe47e493" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{5(9-5x)^{2}}+C" :db/id #edb/ref 17592186398119} {:answer/id #uuid "199a03cb-71ce-557c-b3af-135bd3564f86" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{10(9-5x)^{2}}+C" :db/id #edb/ref 17592186398120} {:answer/id #uuid "418bd3f4-e4c0-5bc7-b4ac-5541696af9d9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{10(9-5x)^{2}}+C" :db/id #edb/ref 17592186398121} {:answer/id #uuid "51978e0d-c725-5111-8fd8-58bfe89fa4d2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{2(9-5x)^{2}}+C" :db/id #edb/ref 17592186398122}] :answer-field/correct {:answer/id #uuid "418bd3f4-e4c0-5bc7-b4ac-5541696af9d9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{10(9-5x)^{2}}+C" :db/id #edb/ref 17592186398121} :answer-field/id #uuid "3b49b60e-8217-5844-bea9-fe48c12aaf25" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186398117}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "d34fadec-e1db-5f0e-b3fb-64f3326f1376" :question/math-academy-id "q-113517" :question/problem "$\\int \\frac{1}{(9-5x)^{3}}\\,\\text{d}x=$" :question/worked-solution "First, we rewrite the integral as\n\n$$\n\\int (9-5x)^{-3}\\,\\text{d}x.\n$$\n\nLet $u=9-5x.$ Then differentiating with respect to $x$ gives\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=-5\\,⟹\\,\\text{d}x=-\\frac{1}{5}\\text{d}u.\n$$\n\nWe now write our integral in terms of $u,$ calculate the integral as normal, and write the final answer in terms of $x$ at the very end:\n\n$$\n\\begin{aligned}\\int (9-5x)^{-3}\\text{d}x & =\\int {u}^{-3}\\cdot (-\\frac{1}{5})\\,\\text{d}u \\\\  & =-\\frac{1}{5}\\int {u}^{-3}\\,\\text{d}u \\\\  & =-\\frac{1}{5}\\cdot (-\\frac{1}{2}){u}^{-2}+C \\\\  & =\\frac{1}{10{u}^{2}}+C \\\\  & =\\frac{1}{10(9-5x)^{2}}+C\\end{aligned}\n$$\n\nLet's double-check that our result is correct. If we differentiate the result, then it should come out to the original integrand:\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}[\\frac{1}{10(9-5x)^{2}}+C] & =\\frac{\\text{d}}{\\text{d}x}[\\frac{1}{10(9-5x)^{2}}]+\\frac{\\text{d}}{\\text{d}x}(C) \\\\  & =\\frac{1}{10}\\frac{\\text{d}}{\\text{d}x}[(9-5x)^{-2}]+\\frac{\\text{d}}{\\text{d}x}(C) \\\\  & =\\frac{1}{10}\\cdot (-2)(9-5x)^{-3}\\cdot \\frac{\\text{d}}{\\text{d}x}(9-5x)+0 \\\\  & =-\\frac{1}{5}(9-5x)^{-3}\\cdot (-5) \\\\  & =(9-5x)^{-3} \\\\  & =\\frac{1}{{(9-5x)}^{3}}\\,✓\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186399795 :knowledge-point/_questions [{:db/id #edb/ref 17592186087844 :knowledge-point/id #uuid "b18ace11-d31c-5d5a-bd2e-32e1c28af2b9" :knowledge-point/title "Calculating Vertical Asymptotes When the Denominator Has Complex Roots"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5a12e93a-5479-5bc8-a172-5f001b81680d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$x=0$ and $x=2$" :db/id #edb/ref 17592186399797} {:answer/id #uuid "9bd56062-f5eb-5d51-97c9-2401cc2382c4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$x=6$ only" :db/id #edb/ref 17592186399798} {:answer/id #uuid "50434bd2-8dc8-5df0-b8fa-4d7fa1f9bf18" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$x=2$ only" :db/id #edb/ref 17592186399799} {:answer/id #uuid "060d6765-1a4c-5cef-9036-baa44df95b64" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$x=-6$ only" :db/id #edb/ref 17592186399800} {:answer/id #uuid "0532888d-2587-5d82-aa30-da64f92b3ef7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$x=2$ and $x=6$ only" :db/id #edb/ref 17592186399801}] :answer-field/correct {:answer/id #uuid "50434bd2-8dc8-5df0-b8fa-4d7fa1f9bf18" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$x=2$ only" :db/id #edb/ref 17592186399799} :answer-field/id #uuid "9de2cff7-92c8-5c70-9102-18ed3f31a5ce" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186399796}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "046b8096-a4b3-5639-81fd-05cfaf3fcc14" :question/math-academy-id "q-113527" :question/problem "Determine the vertical asymptotes of $f(x)=\\frac{{x}^{2}-9}{{x}^{3}-2{x}^{2}+6x-12}.$" :question/worked-solution "To find the vertical asymptotes of a rational function, we factor the numerator and denominator and cancel any common factors. Then, we set the denominator equal to zero and solve for $x:$\n\nFactoring the numerator and denominator, we get\n\n$$\n\\begin{aligned}f(x) & =\\frac{{x}^{2}-9}{{x}^{3}-2{x}^{2}+6x-12} \\\\  & =\\frac{(x+3)(x-3)}{{x}^{2}(x-2)+6(x-2)} \\\\  & =\\frac{(x+3)(x-3)}{({x}^{2}+6)(x-2)}\\end{aligned}\n$$\n\nThere are no common factors in the numerator and denominator, so we set the denominator equal to zero. This gives\n\n$$\n({x}^{2}+6)(x-2)=0.\n$$\n\nWe now solve the above equation using the zero product property:\n\n- Solving $x-2=0$ gives the solution $x=2.$\n\n- The equation ${x}^{2}+6=0$ has no real solutions.\n\nTherefore, the only vertical asymptote is $x=2.$"}] [{:db/id #edb/ref 17592186247369 :knowledge-point/_questions [{:db/id #edb/ref 17592186064208 :knowledge-point/id #uuid "af32f07f-fa65-5ede-a506-735dc2d3a5ef" :knowledge-point/title "Integrating a Combination of Linear Rational Functions Using the General Formula"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0bdfb622-49b8-594f-a384-42995cb2c4bc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}\\operatorname{ln}⁡(K|(3x+2)(3x-2)|)" :db/id #edb/ref 17592186244424} {:answer/id #uuid "44aada26-4d55-57df-82e1-467968cd4443" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{3}\\operatorname{ln}⁡(K|(3x+2)(3x-2)|)" :db/id #edb/ref 17592186244917} {:answer/id #uuid "5b7c324f-ce33-58d1-aeaf-8e1275376ed8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{ln}⁡(K|(3x+2)(3x-2)|)" :db/id #edb/ref 17592186245116} {:answer/id #uuid "96e82d2d-4206-5a6a-b1a4-4d0423e61b5e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}\\operatorname{ln}⁡(K|\\frac{3x+2}{3x-2}|)" :db/id #edb/ref 17592186245644} {:answer/id #uuid "cd50755b-b627-54de-8de5-5509a4cc9a9a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{3}\\operatorname{ln}⁡(K|\\frac{3x+2}{3x-2}|)" :db/id #edb/ref 17592186246145}] :answer-field/correct {:answer/id #uuid "44aada26-4d55-57df-82e1-467968cd4443" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{3}\\operatorname{ln}⁡(K|(3x+2)(3x-2)|)" :db/id #edb/ref 17592186244917} :answer-field/id #uuid "5b7ee80e-437d-599e-8d92-09c467d8e2c3" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186246709}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "8007e479-04c9-545e-b360-e628f7f99f22" :question/math-academy-id "q-113540" :question/problem "Calculate $\\int (\\frac{1}{3x+2}+\\frac{1}{3x-2})\\,\\text{d}x.$ Assume that $K$ is an arbitrary positive constant." :question/worked-solution "Let's solve this using the general formula:\n\n$$\n\\begin{aligned}\\int (\\frac{1}{3x+2}+\\frac{1}{3x-2})\\,\\text{d}x & =\\int \\frac{1}{3x+2}\\,\\text{d}x+\\int \\frac{1}{3x-2}\\,\\text{d}x \\\\  & =\\frac{1}{3}\\operatorname{ln}⁡|3x+2|+\\frac{1}{3}\\operatorname{ln}⁡|3x-2|+C \\\\  & =\\frac{1}{3}\\operatorname{ln}⁡|(3x+2)(3x-2)|+\\frac{1}{3}\\operatorname{ln}⁡K \\\\  & =\\frac{1}{3}\\operatorname{ln}⁡(K|(3x+2)(3x-2)|)\\end{aligned}\n$$\n\nNotice that we used the laws of logarithms to write the result as a single logarithm."}] [{:db/id #edb/ref 17592186399802 :knowledge-point/_questions [{:db/id #edb/ref 17592186087845 :knowledge-point/id #uuid "4b0b57da-f9af-5fab-a337-51ee4cb28f9e" :knowledge-point/title "Calculating Vertical Asymptotes With Common Factors When the Denominator Has Complex Roots"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ac9bdca2-12f3-5135-add9-f6cee60b6017" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$x=0$ and $x=\\sqrt{3}$" :db/id #edb/ref 17592186399804} {:answer/id #uuid "ea637b56-a1b6-530a-b8ad-0581d7725118" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$x=-\\sqrt{3},x=0$ and $x=\\sqrt{3}$" :db/id #edb/ref 17592186399805} {:answer/id #uuid "6caf38b1-8d42-5322-9446-2276f113b03b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$x=\\sqrt{3}$ only" :db/id #edb/ref 17592186399806} {:answer/id #uuid "88004c88-6f69-578a-840b-c594bbb79e81" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$x=0$ and $x=-3$" :db/id #edb/ref 17592186399807} {:answer/id #uuid "7aeb7239-f064-571a-82f0-341dafcdd4e5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The function has no vertical asymptotes" :db/id #edb/ref 17592186399808}] :answer-field/correct {:answer/id #uuid "7aeb7239-f064-571a-82f0-341dafcdd4e5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The function has no vertical asymptotes" :db/id #edb/ref 17592186399808} :answer-field/id #uuid "ce9f7db0-7e00-5308-89b8-2a0dcddb1466" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186399803}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "e0085fda-c140-5022-a903-4aa2d0060987" :question/math-academy-id "q-113554" :question/problem "Determine the vertical asymptotes of $f(x)=\\frac{2{x}^{2}-6}{{x}^{4}-9}.$" :question/worked-solution "To find the vertical asymptotes of a rational function, we factor the numerator and denominator and cancel any common factors. Then, we set the denominator equal to zero and solve for $x.$\n\nFactoring the numerator and denominator and canceling any common factors, we get\n\n$$\n\\begin{aligned}f(x) & =\\frac{2{x}^{2}-6}{{x}^{4}-9} \\\\  & =\\frac{2({x}^{2}-3)}{({x}^{2}-3)({x}^{2}+3)} \\\\  & =\\frac{2\\cancel{({x}^{2}-3)}}{\\cancel{({x}^{2}-3)}({x}^{2}+3)} \\\\  & =\\frac{2}{{x}^{2}+3}\\end{aligned}\n$$\n\nNext, we set the denominator equal to zero:\n\n$$\n{x}^{2}+3=0\n$$\n\nThis equation does not have any real solutions. Therefore, $f(x)$ has no vertical asymptotes."}] [{:db/id #edb/ref 17592186247383 :knowledge-point/_questions [{:db/id #edb/ref 17592186171957 :knowledge-point/id #uuid "9c976b6a-4523-51e1-a243-27aa8937db25" :knowledge-point/title "Expressing the Relationship Between the Rows of Pascal's Triangle in Terms of Binomial Coefficients"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8b3b1495-fd4e-590e-abf2-f1d01bed44e4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(\\frac{5}{3})" :db/id #edb/ref 17592186245535} {:answer/id #uuid "a6d0e7ca-9cf6-56d2-bd14-35cdeb9caa81" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(\\frac{4}{3})" :db/id #edb/ref 17592186245807} {:answer/id #uuid "c4a33636-8960-5f5f-8599-a5cf57881efe" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(\\frac{6}{5})" :db/id #edb/ref 17592186246060} {:answer/id #uuid "caa06872-b168-58f8-a4a8-ab8168991c78" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(\\frac{5}{5})" :db/id #edb/ref 17592186246113} {:answer/id #uuid "ce63f89f-656b-512a-96b3-aa29379755eb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(\\frac{4}{4})" :db/id #edb/ref 17592186246157}] :answer-field/correct {:answer/id #uuid "8b3b1495-fd4e-590e-abf2-f1d01bed44e4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(\\frac{5}{3})" :db/id #edb/ref 17592186245535} :answer-field/id #uuid "dafab0b3-0ea9-52f1-b23d-e401a912ba3a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186246939}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "b7e46def-b53d-544e-a445-f2ab7d8b4fbc" :question/math-academy-id "q-113611" :question/problem "Which expression is missing in the following equation?\n\n$$\n(\\frac{6}{4})=[]+(\\frac{5}{4})\n$$" :question/worked-solution "To find $(\\frac{6}{4}),$ we need to find the number that is located in row $6$ and position $4$ of Pascal's triangle. \n\n**Important**: When counting the rows and positions in Pascal's triangle, we always start counting from zero! Remember:\n\n- The top row of Pascal's triangle is row $0.$\n\n- The first position of each row (the one of the left) is position number $0.$\n\nThe location of $(\\frac{6}{4})$ in Pascal's triangle is highlighted below.\n\n$$\n\\begin{aligned} &  &  &  &  &  &  &  & (\\frac{0}{0}) \\\\  &  &  &  &  &  &  & (\\frac{1}{0}) &  & (\\frac{1}{1}) \\\\  &  &  &  &  &  & (\\frac{2}{0}) &  & (\\frac{2}{1}) &  & (\\frac{2}{2}) \\\\  &  &  &  &  & (\\frac{3}{0}) &  & (\\frac{3}{1}) &  & (\\frac{3}{2}) &  & (\\frac{3}{3}) \\\\  &  &  &  & (\\frac{4}{0}) &  & (\\frac{4}{1}) &  & (\\frac{4}{2}) &  & (\\frac{4}{3}) &  & (\\frac{4}{4}) \\\\  &  &  & (\\frac{5}{0}) &  & (\\frac{5}{1}) &  & (\\frac{5}{2}) &  & (\\frac{5}{3}) &  & (\\frac{5}{4}) &  & (\\frac{5}{5}) \\\\  &  & (\\frac{6}{0}) &  & (\\frac{6}{1}) &  & (\\frac{6}{2}) &  & (\\frac{6}{3}) &  & (\\frac{6}{4}) &  & (\\frac{6}{5}) &  & (\\frac{6}{6}) \\\\  & ⋮ &  & ⋮ &  & ⋮ &  & ⋮ &  & ⋮ &  & ⋮ &  & ⋮ &  & ⋮\\end{aligned}\n$$\n\nNow, $(\\frac{6}{4})$ is the sum of the two closest numbers located in the previous row. So,\n\n$$\n(\\frac{6}{4})=(\\frac{5}{3})+(\\frac{5}{4})\n$$\n\nTherefore, the missing expression is $(\\frac{5}{3}).$"}] [{:db/id #edb/ref 17592186247386 :knowledge-point/_questions [{:db/id #edb/ref 17592186171958 :knowledge-point/id #uuid "e5c108c0-f32a-5725-af3b-c3e747da09f2" :knowledge-point/title "Calculating Binomial Coefficients Using the Formula"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "636f8cd8-4302-5907-8b4c-9cc71b409de8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "45" :db/id #edb/ref 17592186245184} {:answer/id #uuid "8d6f224a-0caa-520d-ad3e-993bd26b1e43" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "20" :db/id #edb/ref 17592186245550} {:answer/id #uuid "8f9a6dca-cecb-5099-bca3-bbc8aacd9e89" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "10" :db/id #edb/ref 17592186245567} {:answer/id #uuid "c619693a-c3a7-5317-948a-2a458be487ab" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "15" :db/id #edb/ref 17592186246074} {:answer/id #uuid "caf7ba92-da92-5e6d-bf74-d3e00df8ce32" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "30" :db/id #edb/ref 17592186246121}] :answer-field/correct {:answer/id #uuid "c619693a-c3a7-5317-948a-2a458be487ab" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "15" :db/id #edb/ref 17592186246074} :answer-field/id #uuid "fcd4c2ff-b851-5eb6-ae43-13350a5efade" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186246998}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "a5b0a4bf-2ef4-500e-bc73-fda1cf537ad7" :question/math-academy-id "q-113617" :question/problem "Determine the value of $(\\frac{6}{2}).$" :question/worked-solution "The binomial coefficient $(\\frac{n}{r})$ is given by the formula\n\n$$\n(\\frac{n}{r})=\\frac{n!}{(n-r)!\\,r!}.\n$$\n\nIn this case, we have $n=6$ and $r=2.$ Therefore,\n\n$$\n\\begin{aligned}(\\frac{6}{2}) & =\\frac{6!}{(6-2)!\\cdot 2!} \\\\  & =\\frac{6\\cdot 5\\cdot 4!}{4!\\cdot 2!} \\\\  & =\\frac{6\\cdot 5\\cdot \\cancel{4!}}{\\cancel{4!}\\cdot 2} \\\\  & =\\frac{30}{2} \\\\  & =15.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186247387 :knowledge-point/_questions [{:db/id #edb/ref 17592186171958 :knowledge-point/id #uuid "e5c108c0-f32a-5725-af3b-c3e747da09f2" :knowledge-point/title "Calculating Binomial Coefficients Using the Formula"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "314d4276-e509-5164-9961-ca77aeaa8178" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "7" :db/id #edb/ref 17592186244754} {:answer/id #uuid "37d70a43-b1b3-54ec-a8e7-99f1791d767a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "15" :db/id #edb/ref 17592186244809} {:answer/id #uuid "53333cee-f6e2-59f6-aa51-70e6bcf82322" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "21" :db/id #edb/ref 17592186245049} {:answer/id #uuid "6ab8bbe4-9ce7-5266-afd4-ffc9546dd22f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "42" :db/id #edb/ref 17592186245258} {:answer/id #uuid "d49d5638-6eae-54be-bb6d-0d49474605da" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "35" :db/id #edb/ref 17592186246209}] :answer-field/correct {:answer/id #uuid "53333cee-f6e2-59f6-aa51-70e6bcf82322" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "21" :db/id #edb/ref 17592186245049} :answer-field/id #uuid "a552523c-10f5-578e-9b5d-bff02b6bd9d0" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186246839}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "b1f98a7a-f74d-5763-bfa6-f9be1199e7b5" :question/math-academy-id "q-113618" :question/problem "Determine the value of $(\\frac{7}{5}).$" :question/worked-solution "The binomial coefficient $(\\frac{n}{r})$ is given by the formula\n\n$$\n(\\frac{n}{r})=\\frac{n!}{(n-r)!\\,r!}.\n$$\n\nIn this case, we have $n=7$ and $r=5.$ Therefore,\n\n$$\n\\begin{aligned}(\\frac{7}{5}) & =\\frac{7!}{(7-5)!\\cdot 5!} \\\\  & =\\frac{7\\cdot 6\\cdot 5!}{2!\\cdot 5!} \\\\  & =\\frac{7\\cdot 6\\cdot \\cancel{5!}}{2\\cdot \\cancel{5!}} \\\\  & =\\frac{42}{2} \\\\  & =21.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186247389 :knowledge-point/_questions [{:db/id #edb/ref 17592186100892 :knowledge-point/id #uuid "8de0dd63-23c6-5926-9e33-71e517949af2" :knowledge-point/title "Finding the Coefficient of a Particular Term"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "08fce7bc-08d1-5e8b-bb40-8c4d517f4c4d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "420" :db/id #edb/ref 17592186244387} {:answer/id #uuid "1b9986ef-a167-5908-bb05-76132770f5af" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3\\,360" :db/id #edb/ref 17592186244558} {:answer/id #uuid "892b9d62-faf3-52d5-9abf-938f5096c36d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "210" :db/id #edb/ref 17592186245514} {:answer/id #uuid "d4f11da1-787c-53dc-9bda-8b355fb7c87c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5\\,040" :db/id #edb/ref 17592186246215} {:answer/id #uuid "e792fd70-e9d5-51b8-9049-70955fe9ebf9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1\\,680" :db/id #edb/ref 17592186246363}] :answer-field/correct {:answer/id #uuid "1b9986ef-a167-5908-bb05-76132770f5af" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3\\,360" :db/id #edb/ref 17592186244558} :answer-field/id #uuid "a671ebcc-fc71-5f4c-b050-211eca6acd49" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186246846}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "521595db-fa9d-5190-ad38-7460533af950" :question/math-academy-id "q-113621" :question/problem "The coefficient of ${x}^{18}$ in the expansion of ${(2+{x}^{3})}^{10}$ is" :question/worked-solution "The binomial theorem states that for any positive integer $n,$ we have\n \n\n$$\n(a+b)^{n}=(\\frac{n}{0}){a}^{n}{b}^{0}+(\\frac{n}{1}){a}^{n-1}{b}^{1}+(\\frac{n}{2}){a}^{n-2}{b}^{2}+…+(\\frac{n}{n}){a}^{0}{b}^{n}.\n$$\n\nIn the case of ${(2+{x}^{3})}^{10},$ we have $a=2,$ $b={x}^{3},$ and $n=10.$ Therefore,\n\n$$\n\\begin{aligned}{(2+{x}^{3})}^{10}=(\\frac{10}{0}){2}^{10}{({x}^{3})}^{0}+(\\frac{10}{1}){2}^{10-1}{({x}^{3})}^{1}+(\\frac{10}{2}){2}^{10-2}{({x}^{3})}^{2}+⋯+(\\frac{10}{10}){2}^{10-10}{({x}^{3})}^{10}.\\end{aligned}\n$$\n\nFrom here, we see that the ${x}^{18}$ term must be\n\n$$\n(\\frac{10}{6}){2}^{10-6}{({x}^{3})}^{6}.\n$$\n\nSimplifying this term, we get\n\n$$\n\\begin{aligned}(\\frac{10}{6}){2}^{10-6}{({x}^{3})}^{6} & =210\\cdot {2}^{4}\\cdot {x}^{18} \\\\  & =210\\cdot 16\\cdot {x}^{18} \\\\  & =3\\,360{x}^{18}.\\end{aligned}\n$$\n\nTherefore, the coefficient of ${x}^{18}$ is $3\\,360.$"}] [{:db/id #edb/ref 17592186247396 :knowledge-point/_questions [{:db/id #edb/ref 17592186068723 :knowledge-point/id #uuid "8fe2a279-0b92-561e-b17d-b902f43725ac" :knowledge-point/title "Integrating an Expression Involving a Power Function Multiplied by a Constant Multiple of Its Derivative"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5e32ff11-46c7-5e54-94bf-fdf37bd4e777" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{(4+{x}^{6})^{6}}{6}+C" :db/id #edb/ref 17592186245143} {:answer/id #uuid "61c7ef3d-13c8-5479-bf15-23c7156762ab" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{(4+{x}^{6})^{6}}{18}+C" :db/id #edb/ref 17592186245171} {:answer/id #uuid "90a0075f-a39c-584e-ab19-3bcdb240a499" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{(4+{x}^{6})^{6}}{3}+C" :db/id #edb/ref 17592186245575} {:answer/id #uuid "ad996ae5-8424-527c-80d5-4c89b95ad520" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{(4+{x}^{6})^{6}}{2}+C" :db/id #edb/ref 17592186245863} {:answer/id #uuid "c21643d0-8214-58cb-bb01-f4183d7d91a2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2(4+{x}^{6})^{6}+C" :db/id #edb/ref 17592186246045}] :answer-field/correct {:answer/id #uuid "61c7ef3d-13c8-5479-bf15-23c7156762ab" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{(4+{x}^{6})^{6}}{18}+C" :db/id #edb/ref 17592186245171} :answer-field/id #uuid "51b37ac4-75b0-5695-8c29-875df29f0437" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186246690}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "49e41322-d540-5688-b30a-e33aaf2dc9a7" :question/math-academy-id "q-113710" :question/problem "Calculate $\\int 2{x}^{5}(4+{x}^{6})^{5}\\,\\text{d}x.$" :question/worked-solution "In this case, the term $2{x}^{5}$ outside the parentheses isn't quite the derivative of $4+{x}^{6}.$ But the derivative is $6{x}^{5},$ so we're only out by a constant factor.\nSo we make the substitution\n\n$$\nu=4+{x}^{6}.\n$$\n\nIts derivative is given by\n\n$$\n\\begin{aligned}\\frac{\\text{d}u}{\\text{d}x} & =6{x}^{5}\\,⟹\\,\\frac{1}{3}\\text{d}u=2{x}^{5}\\,\\text{d}x,\\end{aligned}\n$$\n\nand we can now write our integral in terms of $u,$ as follows:\n\n$$\n\\begin{aligned}\\int 2{x}^{5}(4+{x}^{6})^{5}\\,\\text{d}x & =\\int (4+{x}^{6})^{5}\\cdot 2{x}^{5}\\,\\text{d}x \\\\  & =\\int {u}^{5}\\cdot \\frac{1}{3}\\text{d}u \\\\  & =\\frac{1}{3}\\int {u}^{5}\\,\\text{d}u\\end{aligned}\n$$\n\nFinally, we can solve the integral in terms of $u$ and then write the final result in terms of $x.$ We get\n\n$$\n\\begin{aligned}\\frac{1}{3}\\int {u}^{5}\\,\\text{d}u & =\\frac{1}{3}\\cdot \\frac{{u}^{6}}{6}+C \\\\  & =\\frac{1}{18}{u}^{6}+C \\\\  & =\\frac{1}{18}(4+{x}^{6})^{6}+C \\\\  & =\\frac{(4+{x}^{6})^{6}}{18}+C.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186247401 :knowledge-point/_questions [{:db/id #edb/ref 17592186068724 :knowledge-point/id #uuid "18ce1807-3a09-5ebd-b3cd-a91db8d2b4a8" :knowledge-point/title "Integrating a Rational Function Using Natural Logarithms"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7d5dafea-bf81-547d-bc49-424b9dda654f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\operatorname{ln}⁡|{x}^{2}+2x|}{2x+2}+C" :db/id #edb/ref 17592186245413} {:answer/id #uuid "99a2a79b-5577-502b-8046-72f844be5fb0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{ln}⁡|2x+2|+C" :db/id #edb/ref 17592186245676} {:answer/id #uuid "d24c27f7-0e1d-5d59-b35b-8372ae555f55" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{ln}⁡|{x}^{2}+2x|+C" :db/id #edb/ref 17592186246185} {:answer/id #uuid "f82296d1-fe61-58f2-9cf3-93e048824594" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{ln}⁡|\\frac{{x}^{2}+2x}{2x+2}|+C" :db/id #edb/ref 17592186246494} {:answer/id #uuid "fb9b4b11-e546-550e-884b-27bb9cfddd54" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{ln}⁡|\\frac{2x+2}{{x}^{2}+2x}|+C" :db/id #edb/ref 17592186246517}] :answer-field/correct {:answer/id #uuid "d24c27f7-0e1d-5d59-b35b-8372ae555f55" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{ln}⁡|{x}^{2}+2x|+C" :db/id #edb/ref 17592186246185} :answer-field/id #uuid "79f96c4c-101d-52fa-a1e7-55a417e265bc" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186246759}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "a444aaf3-15c5-5890-a26f-622f4c6bdbef" :question/math-academy-id "q-113721" :question/problem "Calculate $\\int \\frac{2x+2}{{x}^{2}+2x}\\,\\text{d}x.$" :question/worked-solution "Let $u={x}^{2}+2x.$ Then\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=2x+2\\,⟹\\,\\text{d}u=(2x+2)\\,\\text{d}x,\n$$\n\nand we can solve the resulting integral as follows:\n\n$$\n\\begin{aligned}\\int \\frac{2x+2}{{x}^{2}+2x}\\,\\text{d}x & =\\int \\frac{1}{{x}^{2}+2x}\\cdot (2x+2)\\,\\text{d}x \\\\  & =\\int \\frac{1}{u}\\,\\text{d}u \\\\  & =\\operatorname{ln}⁡|u|+C \\\\  & =\\operatorname{ln}⁡|{x}^{2}+2x|+C\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186247402 :knowledge-point/_questions [{:db/id #edb/ref 17592186068786 :knowledge-point/id #uuid "03e934c8-da65-5615-9717-a50eee3577fd" :knowledge-point/title "Integrating Other Fractional Expressions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "387b1fd3-d0b6-5a4f-9f87-df4622619640" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{7}{5(3-{x}^{5})^{5}}+C" :db/id #edb/ref 17592186244813} {:answer/id #uuid "5a108ad3-8f59-57fb-86b0-8078293f3c34" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{25}{7(3-{x}^{5})^{5}}+C" :db/id #edb/ref 17592186245104} {:answer/id #uuid "64849b83-6c8e-5754-857d-65fbc670429e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{7}{25(3-{x}^{5})^{5}}+C" :db/id #edb/ref 17592186245200} {:answer/id #uuid "92481de8-22aa-54dd-8e3e-03c362cb4b5f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{7}{25(3-{x}^{5})^{5}}+C" :db/id #edb/ref 17592186245589} {:answer/id #uuid "d7b59bc3-4c29-5982-981f-e767a487ae12" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5}{7(3-{x}^{5})^{5}}+C" :db/id #edb/ref 17592186246233}] :answer-field/correct {:answer/id #uuid "92481de8-22aa-54dd-8e3e-03c362cb4b5f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{7}{25(3-{x}^{5})^{5}}+C" :db/id #edb/ref 17592186245589} :answer-field/id #uuid "a5979b9c-8e33-51cf-9331-a30916482816" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186246840}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "14745f6d-a16a-5fbf-98d1-0322f61ed9f2" :question/math-academy-id "q-113726" :question/problem "Calculate $\\int \\frac{7{x}^{4}}{{(3-{x}^{5})}^{6}}\\,\\text{d}x.$" :question/worked-solution "Let $u=3-{x}^{5}.$ Then\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=-5{x}^{4}\\,⟹\\,-\\frac{7}{5}\\text{d}u=7{x}^{4}\\,\\text{d}x,\n$$\n\nand we can solve the resulting integral as follows:\n\n$$\n\\begin{aligned}\\int \\frac{7{x}^{4}}{{(3-{x}^{5})}^{6}}\\,\\text{d}x & =\\int \\frac{1}{{(3-{x}^{5})}^{6}}\\cdot 7{x}^{4}\\,\\text{d}x \\\\  & =\\int \\frac{1}{{u}^{6}}\\cdot (-\\frac{7}{5})\\,\\text{d}u \\\\  & =-\\frac{7}{5}\\int \\frac{1}{{u}^{6}}\\,\\text{d}u \\\\  & =-\\frac{7}{5}(-\\frac{1}{5{u}^{5}})+C \\\\  & =\\frac{7}{25{u}^{5}}+C \\\\  & =\\frac{7}{25(3-{x}^{5})^{5}}+C\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186247404 :knowledge-point/_questions [{:db/id #edb/ref 17592186068800 :knowledge-point/id #uuid "68e983da-1f69-5be1-8034-9422a84ce6be" :knowledge-point/title "Integrating Rational Functions With a Repeated Factor and Another Factor"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3aae1c51-6336-56ad-845f-d349e716fffd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{3}\\operatorname{ln}⁡|2x+3|+\\frac{3}{2x+3}-3\\operatorname{ln}⁡|x+3|+K" :db/id #edb/ref 17592186244831} {:answer/id #uuid "3b244173-c465-51c8-b37e-1749b67c141e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}\\operatorname{ln}⁡|2x+3|+\\frac{2}{2x+3}-\\operatorname{ln}⁡|x+3|+K" :db/id #edb/ref 17592186244835} {:answer/id #uuid "3c66c7a3-3b83-5786-a88f-d56d67df2559" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{3}\\operatorname{ln}⁡|2x+3|+\\frac{1}{2x+3}+\\operatorname{ln}⁡|x+3|+K" :db/id #edb/ref 17592186244844} {:answer/id #uuid "4cbe2891-3b58-5af9-8eb3-0222677fd2bf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{3}\\operatorname{ln}⁡|2x+3|-\\frac{3}{2x+3}+2\\operatorname{ln}⁡|x+3|+K" :db/id #edb/ref 17592186244999} {:answer/id #uuid "8b9f76d6-b65e-5a66-bf71-43ff996a8910" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}\\operatorname{ln}⁡|2x+3|-\\frac{1}{2x+3}+3\\operatorname{ln}⁡|x+3|+K" :db/id #edb/ref 17592186245538}] :answer-field/correct {:answer/id #uuid "8b9f76d6-b65e-5a66-bf71-43ff996a8910" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}\\operatorname{ln}⁡|2x+3|-\\frac{1}{2x+3}+3\\operatorname{ln}⁡|x+3|+K" :db/id #edb/ref 17592186245538} :answer-field/id #uuid "23193761-238a-5d34-9d64-1f4fd08dcceb" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186246603}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "ac06531e-6119-55f2-a664-c7ce48ffa7e1" :question/math-academy-id "q-11373" :question/problem "$\\int \\frac{14{x}^{2}+47x+42}{(2x+3)^{2}(x+3)}\\,\\text{d}x=$" :question/worked-solution "First, we convert the integrand into a sum of partial fractions:\n\n$$\n\\frac{14{x}^{2}+47x+42}{(2x+3)^{2}(x+3)}=\\frac{A}{(2x+3)}+\\frac{B}{(2x+3)^{2}}+\\frac{C}{(x+3)}\n$$\n\nTo determine the coefficients $A,$ $B,$ and $C,$ we first multiply both sides of the above equation by $(2x+3)^{2}(x+3)$ and get\n\n$$\n14{x}^{2}+47x+42=A(2x+3)(x+3)+B(x+3)+C(2x+3)^{2}.\n$$\n\nPlugging in $x=-\\frac{3}{2},$ we can eliminate $A$ and $C$ and solve for $B:$\n\n$$\n\\begin{aligned}14{(-\\frac{3}{2})}^{2}+47(-\\frac{3}{2})+42 & =A(2(-\\frac{3}{2})+3)(-\\frac{3}{2}+3) \\\\  & +B(-\\frac{3}{2}+3)+C{(2(-\\frac{3}{2})+3)}^{2} \\\\ \\frac{63}{2}-\\frac{141}{2}+42 & =B(\\frac{3}{2}) \\\\ \\frac{63-141+84}{2} & =B(\\frac{3}{2}) \\\\ B & =-\\frac{12}{6} \\\\ B & =2\\end{aligned}\n$$\n\nPlugging in $x=-3,$ we can eliminate $A$ and $B$ and solve for $C:$\n\n$$\n\\begin{aligned}14(-3)^{2}+47(-3)+42 & =A(2(-3)+3)(-3+3)+B(-3+3)+C(2(-3)+3)^{2} \\\\ 126-141+42 & =C{(-3)}^{2} \\\\ C & =\\frac{27}{9} \\\\ C & =3\\end{aligned}\n$$\n\nPlugging in $x=0$ and substituting the known values of $B$ and $C,$ we can solve for $A:$\n\n$$\n\\begin{aligned}14({0}^{2})+47(0)+42 & =A(2(0)+3)(0+3)+B(0+3)+C(2(0)+3)^{2} \\\\ 42 & =9A+3B+9C \\\\ 42 & =9A+3(2)+9(3) \\\\ 42 & =9A+33 \\\\ 9A & =42-33 \\\\ A & =\\frac{9}{9} \\\\ A & =1\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\frac{14{x}^{2}+47x+42}{(2x+3)^{2}(x+3)}=\\frac{1}{(2x+3)}+\\frac{2}{(2x+3)^{2}}+\\frac{3}{(x+3)}.\n$$\n\nFinally, we integrate this expression term by term, and get\n\n$$\n\\begin{aligned}\\int \\frac{14{x}^{2}+47x+42}{(2x+3)^{2}(x+3)}\\,\\text{d}x & =\\int (\\frac{1}{(2x+3)}+\\frac{2}{(2x+3)^{2}}+\\frac{3}{(x+3)})\\,\\text{d}x \\\\  & =\\int \\frac{1}{2x+3}\\,\\text{d}x+2\\int \\frac{1}{(2x+3)^{2}}\\,\\text{d}x+3\\int \\frac{1}{x+3}\\,\\text{d}x \\\\  & =\\frac{1}{2}\\operatorname{ln}⁡|2x+3|-\\frac{1}{2x+3}+3\\operatorname{ln}⁡|x+3|+K,\\end{aligned}\n$$\n\nwhere $K$ is an integral constant."}] [{:db/id #edb/ref 17592186247405 :knowledge-point/_questions [{:db/id #edb/ref 17592186054610 :knowledge-point/id #uuid "078c9361-898f-5b9f-889e-c92442f882d9" :knowledge-point/title "Using the Constant Factor Rule to Integrate a Constant Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6a047b88-d760-555b-9e93-164a62866d3b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2}{5y}+C" :db/id #edb/ref 17592186245252} {:answer/id #uuid "95a7a62a-096c-53a6-9e63-99bffb683248" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2}{y}+C" :db/id #edb/ref 17592186245622} {:answer/id #uuid "a51fd8e4-b513-5c94-9774-6b4bdb6b2119" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{y}{10}+C" :db/id #edb/ref 17592186245797} {:answer/id #uuid "b43d5d61-14e6-5d21-a689-c9df2d507f9f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5}{2}y+C" :db/id #edb/ref 17592186245921} {:answer/id #uuid "f824863b-216c-5fb2-8443-c7b2f37cefa1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2}{5}y+C" :db/id #edb/ref 17592186246495}] :answer-field/correct {:answer/id #uuid "f824863b-216c-5fb2-8443-c7b2f37cefa1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2}{5}y+C" :db/id #edb/ref 17592186246495} :answer-field/id #uuid "b72ce3d4-25eb-5424-b4ec-a1a9ca20b6ff" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186246880}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "1e9f7c60-e13f-56df-879c-69f076975c52" :question/math-academy-id "q-113743" :question/problem "Calculate $\\int \\frac{2}{5}\\,\\text{d}y.$" :question/worked-solution "We can just take the constant factor out of the integral, and then apply the power rule:\n\n$$\n\\begin{aligned}\\int \\frac{2}{5}\\,\\text{d}y & =\\frac{2}{5}\\int 1\\,\\text{d}y \\\\  & =\\frac{2}{5}\\int {y}^{0}\\,\\text{d}y \\\\  & =\\frac{2}{5}\\cdot \\frac{{y}^{0+1}}{0+1}+C \\\\  & =\\frac{2}{5}\\cdot y+C \\\\  & =\\frac{2}{5}y+C\\end{aligned}\n$$\n\nIn general, we can see that for any constant $k,$ we have $\\int k\\,\\text{d}x=kx+C.$"}] [{:db/id #edb/ref 17592186247407 :knowledge-point/_questions [{:db/id #edb/ref 17592186105709 :knowledge-point/id #uuid "33965139-0c6a-50fc-993a-e2acd6760212" :knowledge-point/title "Finding Local Minima and Local Maxima of Polynomials"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "552218aa-04cc-50d1-95d6-52030abe8e27" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186245062} {:answer/id #uuid "5577bb08-24dd-5e0d-a5be-9f1465de5c19" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186245064} {:answer/id #uuid "72d32f93-3a51-5866-a95b-081aabc3e133" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$f(x)$ does not have any local maxima" :db/id #edb/ref 17592186245339} {:answer/id #uuid "d6cfe7ae-8521-514d-940a-f2c9f5e64c20" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{2}" :db/id #edb/ref 17592186246226} {:answer/id #uuid "f299385a-3efa-5b82-ba49-f397e93548ec" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186246454}] :answer-field/correct {:answer/id #uuid "552218aa-04cc-50d1-95d6-52030abe8e27" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186245062} :answer-field/id #uuid "7b2e44dd-fbc1-5507-bdfc-23764274f469" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186246764}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "2776d562-24a8-5f0b-bcac-9739cc2c4ba2" :question/math-academy-id "q-113750" :question/problem "For which value of $x$ does the function $f(x)=12x+9{x}^{2}-4{x}^{3}$ have a local maximum?" :question/worked-solution "First, we find the stationary points. Differentiating $f(x)$ gives\n\n$$\n\\begin{aligned}{f}^{′}(x) & =12+18x-12{x}^{2} \\\\  & =-6(2{x}^{2}-3x-2) \\\\  & =-6(x-2)(2x+1).\\end{aligned}\n$$\n\nSolving ${f}^{′}(x)=0$ gives\n\n$$\n-6(x-2)(2x+1)=0\\,⟹\\,x=-\\frac{1}{2},2.\n$$\n\nSo we have two stationary points, $x=-\\frac{1}{2}$ and $x=2.$ Next, to determine whether these points are local maxima or minima, we use the first derivative test.\n\nLet's choose the test points $x=-1,0,3$ and evaluate the first derivative at these points.\n\n$$\n\\begin{aligned}{f}^{′}(-1) & =-6(-1-2)(2(-1)+1)=-18<0 \\\\ {f}^{′}(0) & =-6(0-2)(2(0)+1)=12>0 \\\\ {f}^{′}(3) & =-6(3-2)(2(3)+1)=-42<0\\end{aligned}\n$$\n\nWe summarize the information in a table, shown below.\n\n| $x$ | $(-\\infty ,-\\frac{1}{2})$ | $-\\frac{1}{2}$ | $(-\\frac{1}{2},2)$ | $2$ | $(2,\\infty )$ |\n| --- | --- | --- | --- | --- | --- |\n| Test Point | $-1$ |  | $0$ |  | $3$ |\n| ${f}^{′}$ | $-$ | $0$ | $+$ | $0$ | $-$ |\n| $f$ | $↘$ | min | $↗$ | max | $↘$ |\n\nFinally, let's use the table above to classify the critical points.\n\n- At $x=-\\frac{1}{2},$ the first derivative changes sign from negative to positive. Therefore, $x=-\\frac{1}{2}$ is a local minimum.\n\n- At $x=2,$ the first derivative changes sign from positive to negative. Therefore, $x=2$ is a local maximum.\n\nWe conclude that $f(x)$ has one local maximum at $x=2.$"}] [{:db/id #edb/ref 17592186247412 :knowledge-point/_questions [{:db/id #edb/ref 17592186105710 :knowledge-point/id #uuid "ff7c597d-d4a4-5567-add6-eac77475b0d6" :knowledge-point/title "Identifying Points That Are Neither Local Minima nor Local Maxima"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "316a7577-1eb5-5f57-a004-8b8add5750ed" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "There is a local maximum at $x=1$" :db/id #edb/ref 17592186244755} {:answer/id #uuid "897d9528-7ef6-5cb0-a87e-b7c0bb1b66db" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "There is a local minimum at $x=1$" :db/id #edb/ref 17592186245518} {:answer/id #uuid "a213afb2-9683-5aa1-93b1-85f2ffc8f990" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "There is a local minimum at $x=-1$" :db/id #edb/ref 17592186245759} {:answer/id #uuid "e027f807-a3c9-516f-bb7a-81503bf7b24a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "There is a local maximum at $x=-1$" :db/id #edb/ref 17592186246307} {:answer/id #uuid "f88462fe-abf7-5298-86e8-412193dbf76a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The function $f(x)$ has no local extrema" :db/id #edb/ref 17592186246501}] :answer-field/correct {:answer/id #uuid "f88462fe-abf7-5298-86e8-412193dbf76a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The function $f(x)$ has no local extrema" :db/id #edb/ref 17592186246501} :answer-field/id #uuid "5116a940-f969-5adf-a7ac-4fa404dd7f88" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186246687}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "fd95aa30-1ca2-5a62-b658-637d3382deaf" :question/math-academy-id "q-113763" :question/problem "Given the function $f(x)={x}^{3}+3{x}^{2}+3x-2,$ which of the following statements are true?" :question/worked-solution "First, we find the stationary points. Differentiating $f(x)$ gives\n\n$$\n\\begin{aligned}{f}^{′}(x) & =3{x}^{2}+6x+3 \\\\  & =3({x}^{2}+2x+1) \\\\  & =3(x+1)^{2}\\end{aligned}\n$$\n\nSolving ${f}^{′}(x)=0$ gives\n\n$$\n3(x+1)^{2}=0\\,⇒\\,x=-1.\n$$\n\nSo $x=-1$ is the only stationary point of $f(x).$ Next, to determine whether this point is local maximum or minimum, we use the first derivative test.\n\nLet's choose the test points $x=-2,0$ and evaluate the first derivative at these points.\n\n$$\n\\begin{aligned}{f}^{′}(-2) & =3(-2+1)^{2}=3>0 \\\\ {f}^{′}(0) & =3(0+1)^{2}=3>0\\end{aligned}\n$$\n\nWe summarize the information in a table shown below.\n\n| $x$ | $(-\\infty ,-1)$ | $-1$ | $(-1,\\infty )$ |\n| --- | --- | --- | --- |\n| Test Point | $-2$ |  | $0$ |\n| ${f}^{′}$ | $+$ | $0$ | $+$ |\n| $f$ | $↗$ |  | $↗$ |\n\nThe first derivative does not change sign at $x=-1.$ Therefore, we conclude that $x=-1$ is neither a minimum nor a maximum.\n\nHence, the first derivative test shows that the function has no local extrema."}] [{:db/id #edb/ref 17592186386710 :knowledge-point/_questions [{:db/id #edb/ref 17592186105710 :knowledge-point/id #uuid "ff7c597d-d4a4-5567-add6-eac77475b0d6" :knowledge-point/title "Identifying Points That Are Neither Local Minima nor Local Maxima"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ee62ed2b-3ad0-5e38-ae61-4bbccc602e50" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "There is a local maximum at $x=11$" :db/id #edb/ref 17592186386712} {:answer/id #uuid "779191ca-00c8-5693-910a-831c70bd7d46" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "There is a local minimum at $x=11$" :db/id #edb/ref 17592186386713} {:answer/id #uuid "61d766f1-e6b1-5341-a4d4-d213eed1d08d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "There is a local minimum at $x=0$" :db/id #edb/ref 17592186386714} {:answer/id #uuid "2e3d0ac1-d81a-5c65-9ab8-009b29188630" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The function $f(x)$ has no local extrema" :db/id #edb/ref 17592186386715} {:answer/id #uuid "19216037-df7a-53f0-9c94-0f1297c06adc" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "There is a local maximum at $x=0$" :db/id #edb/ref 17592186386716}] :answer-field/correct {:answer/id #uuid "2e3d0ac1-d81a-5c65-9ab8-009b29188630" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The function $f(x)$ has no local extrema" :db/id #edb/ref 17592186386715} :answer-field/id #uuid "1017debf-dce0-50cd-9947-574ee59f46fd" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186386711}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "b349904b-6249-5c3c-b3c7-bf9319607046" :question/math-academy-id "q-113766" :question/problem "Given the function $f(x)={x}^{11},$ which of the following statements are true?" :question/worked-solution "First, we find the stationary points. Differentiating $f(x)$ gives\n\n$$\n{f}^{′}(x)=11{x}^{10}.\n$$\n\nSolving ${f}^{′}(x)=0$ gives\n\n$$\n11{x}^{10}=0\\,⟹\\,x=0.\n$$\n\nSo $x=0$ is the only stationary point of $f(x).$ Next, to determine whether this point is local maximum or minimum, we use the first derivative test.\n\nLet's choose the test points $x=-1,1$ and evaluate the first derivative at these points.\n\n$$\n\\begin{aligned}{f}^{′}(-1) & =11(-1)^{10}=11>0 \\\\ {f}^{′}(1) & =11(1)^{10}=11>0\\end{aligned}\n$$\n\nWe summarize the information in a table shown below.\n\n| $x$ | $(-\\infty ,0)$ | $0$ | $(0,\\infty )$ |\n| --- | --- | --- | --- |\n| Test Point | $-1$ |  | $1$ |\n| ${f}^{′}$ | $+$ | $0$ | $+$ |\n| $f$ | $↗$ |  | $↗$ |\n\nThe first derivative does not change sign at $x=0.$ Therefore, we conclude that $x=0$ is neither a minimum nor a maximum.\n\nHence, the first derivative test shows that the function has no local extrema."}] [{:db/id #edb/ref 17592186250117 :knowledge-point/_questions [{:db/id #edb/ref 17592186068759 :knowledge-point/id #uuid "f149f8ef-dd7f-5f65-928e-534e1541f9b2" :knowledge-point/title "Dividing Rational Expressions with a Single Common Factor"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3138c09d-4d43-51c5-bead-0fdb778e1372" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5k}{2h}" :db/id #edb/ref 17592186247870} {:answer/id #uuid "31b53764-ce11-5727-886a-8d35ebdf717e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{kh}{2}" :db/id #edb/ref 17592186247876} {:answer/id #uuid "4536e350-3f2a-5750-abb4-9f26a11d9ba9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2hk}" :db/id #edb/ref 17592186248045} {:answer/id #uuid "a62285a7-f22e-5063-a1e7-ac6ebe678521" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{k}{5h}" :db/id #edb/ref 17592186248905} {:answer/id #uuid "eee7c8c3-97c8-59fa-9ad6-63ca4f761b48" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{k}{2h}" :db/id #edb/ref 17592186249521}] :answer-field/correct {:answer/id #uuid "eee7c8c3-97c8-59fa-9ad6-63ca4f761b48" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{k}{2h}" :db/id #edb/ref 17592186249521} :answer-field/id #uuid "1a8d3447-4499-5d0e-ad45-b2bcd7eff6ae" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186249715}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "d696dd66-1554-57e6-9d74-9c8f4a560ef5" :question/math-academy-id "q-113818" :question/problem "$\\frac{5}{h}÷\\frac{10}{k}=$" :question/worked-solution "To compute\n\n$$\n\\frac{5}{h}÷\\frac{10}{k},\n$$\n\nwe just need to multiply by the reciprocal of the divisor:\n\n$$\n\\begin{aligned}\\frac{5}{h}÷\\frac{10}{k} & = \\\\ \\frac{5}{h}\\cdot \\frac{k}{10} & = \\\\ \\frac{5k}{10h} & = \\\\ \\frac{\\cancel{5}\\cdot k}{\\cancel{5}\\cdot 2h} & = \\\\ \\frac{k}{2h} & \\end{aligned}\n$$\n\nNote that in the final step, we canceled out a common factor of $5$ in the numerator and denominator."}] [{:db/id #edb/ref 17592186250120 :knowledge-point/_questions [{:db/id #edb/ref 17592186068760 :knowledge-point/id #uuid "f7614a05-f221-5fda-b491-6893f44a1a5f" :knowledge-point/title "Dividing Rational Expressions with Multiple Common Factors"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "97c1c6ab-73c5-56f5-9fee-ca0a10e54db6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2(z-2)}{z+1}" :db/id #edb/ref 17592186248776} {:answer/id #uuid "a9625933-0685-5510-8621-3032717dd0ac" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{18(z-2)}{z+1}" :db/id #edb/ref 17592186248929} {:answer/id #uuid "b3efc6b8-c94f-51b9-8dc1-1921a321212b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{18}{z+1}" :db/id #edb/ref 17592186249034} {:answer/id #uuid "badd22b5-a641-5ad8-8db4-43458737b054" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{18(z+1)}{z-2}" :db/id #edb/ref 17592186249093} {:answer/id #uuid "ef35f532-0726-5061-9704-c32df9534b0c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2}{z+1}" :db/id #edb/ref 17592186249524}] :answer-field/correct {:answer/id #uuid "b3efc6b8-c94f-51b9-8dc1-1921a321212b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{18}{z+1}" :db/id #edb/ref 17592186249034} :answer-field/id #uuid "96e98c2b-f5b8-5971-a5f1-a27e14529d08" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186249939}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "fd3f875b-33f7-55de-93e3-693ddb1d2606" :question/math-academy-id "q-113826" :question/problem "Given that $\\frac{3(z-2)}{(z+1)^{2}}=a$ and $\\frac{z-2}{6(z+1)}=b,$ what is $a÷b?$" :question/worked-solution "To compute\n\n$$\na÷b=\\frac{3(z-2)}{(z+1)^{2}}÷\\frac{z-2}{6(z+1)},\n$$\n\nwe just need to multiply by the reciprocal of the divisor:\n\n$$\n\\begin{aligned}\\frac{3(z-2)}{(z+1)^{2}}÷\\frac{z-2}{6(z+1)} & = \\\\ \\frac{3(z-2)}{(z+1)^{2}}\\cdot \\frac{6(z+1)}{z-2} & = \\\\ \\frac{3\\cancel{(z-2)}}{(z+1)^{\\cancel{2}}}\\cdot \\frac{6\\cancel{(z+1)}}{\\cancel{(z-2)}} & = \\\\ \\frac{3}{z+1}\\cdot 6 & = \\\\ \\frac{18}{z+1}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186250122 :knowledge-point/_questions [{:db/id #edb/ref 17592186096655 :knowledge-point/id #uuid "f4b340f6-0ac6-5bbf-a7d4-0088ca3c4e5e" :knowledge-point/title "Integrating the Exponential Function With a Linear Exponent"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0609bfa0-feaa-5eb6-8746-b749fc1e9ec2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\,{e}^{x-1}+C" :db/id #edb/ref 17592186247477} {:answer/id #uuid "253a16d7-628b-53f9-a7b2-1f6c746a4abb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2\\,{e}^{x/2\\,-\\,1}+C" :db/id #edb/ref 17592186247750} {:answer/id #uuid "2d6d85b6-5dd0-5f4b-aa63-52da5bb8cf45" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\,{e}^{x/2\\,-\\,1}+C" :db/id #edb/ref 17592186247828} {:answer/id #uuid "3bc85c63-a410-59bf-afe3-e5c1937a752b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{e}^{x/2\\,-\\,1}}{2}+C" :db/id #edb/ref 17592186247953} {:answer/id #uuid "42a6cbcd-5218-511c-8178-7959687c4db1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{e}^{x/2\\,-\\,1}+C" :db/id #edb/ref 17592186248018}] :answer-field/correct {:answer/id #uuid "2d6d85b6-5dd0-5f4b-aa63-52da5bb8cf45" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\,{e}^{x/2\\,-\\,1}+C" :db/id #edb/ref 17592186247828} :answer-field/id #uuid "4c624ee9-f981-5550-b705-79dced8e3486" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186249811}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "0dd276ae-ab9b-5d13-9781-196a361b49ac" :question/math-academy-id "q-113833" :question/problem "Calculate $\\int {e}^{x/2\\,-\\,1}\\,\\text{d}x.$" :question/worked-solution "If we let $u=\\frac{x}{2}-1,$ then\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=\\frac{1}{2}\\,⟹\\,2\\,\\text{d}u=\\text{d}x.\n$$\n\nThen, we can write the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}\\int {e}^{x/2\\,-\\,1}\\,\\text{d}x & =\\int {e}^{u}\\cdot 2\\,\\text{d}u \\\\  & =2\\int {e}^{u}\\,\\text{d}u \\\\  & =2\\,{e}^{u}+C \\\\  & =2\\,{e}^{x/2\\,-\\,1}+C\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186250123 :knowledge-point/_questions [{:db/id #edb/ref 17592186184349 :knowledge-point/id #uuid "e803bd99-388f-5146-ab91-03fd7b658c2c" :knowledge-point/title "Integrating Products Containing the Exponential Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "02b84d7d-608c-57fe-ad2a-8d7b3223ebf1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2{e}^{4-{x}^{4}}+C" :db/id #edb/ref 17592186247443} {:answer/id #uuid "7b94e33e-8377-50fa-ba1a-01b0ed35414e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{{e}^{4-{x}^{4}}}{2}+C" :db/id #edb/ref 17592186248509} {:answer/id #uuid "86567d54-2455-5e0f-9993-5bd9586dbb63" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{e}^{4-{x}^{4}}+C" :db/id #edb/ref 17592186248624} {:answer/id #uuid "922418e0-e363-5310-a811-02c1d0ad7698" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2{e}^{4-{x}^{4}}+C" :db/id #edb/ref 17592186248720} {:answer/id #uuid "c9074ff3-7294-565a-b1f0-898bbb960848" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{e}^{4-{x}^{4}}}{2}+C" :db/id #edb/ref 17592186249212}] :answer-field/correct {:answer/id #uuid "02b84d7d-608c-57fe-ad2a-8d7b3223ebf1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2{e}^{4-{x}^{4}}+C" :db/id #edb/ref 17592186247443} :answer-field/id #uuid "a966ca4b-b482-5dc7-9dca-76ae5ec77a2b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186249969}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "cea6cfb7-b02b-5433-ac98-e8175ace7d35" :question/math-academy-id "q-113847" :question/problem "$\\int 8{x}^{3}{e}^{4-{x}^{4}}\\,\\text{d}x=$" :question/worked-solution "Let's introduce the new variable $u=4-{x}^{4}.$ Differentiating gives\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=-4{x}^{3}\\,⟹\\,-2\\text{d}u=8{x}^{3}\\text{d}x.\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\int 8{x}^{3}{e}^{4-{x}^{4}}\\,\\text{d}x & =\\int {e}^{4-{x}^{4}}\\cdot 8{x}^{3}\\,\\text{d}x \\\\  & =\\int {e}^{u}\\cdot (-2)\\,\\text{d}u \\\\  & =-2\\int {e}^{u}\\,\\text{d}u \\\\  & =-2{e}^{u}+C \\\\  & =-2{e}^{4-{x}^{4}}+C.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186250126 :knowledge-point/_questions [{:db/id #edb/ref 17592186096630 :knowledge-point/id #uuid "89902023-09e6-50cd-b08a-9d3e82d826c9" :knowledge-point/title "Writing the Area Bounded by a Curve as a Definite Integral"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3245c48f-1a4d-5b3a-9824-8d88eff85902" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "A={\\int }_{0}^{3}({x}^{2}-2x+2)\\,\\text{d}x" :db/id #edb/ref 17592186247883} {:answer/id #uuid "630663c5-73ef-581c-8f85-9dab63b65145" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "A={\\int }_{-1}^{0}(-{x}^{2}+2x-2)\\,\\text{d}x" :db/id #edb/ref 17592186248322} {:answer/id #uuid "78f4a7cf-7d63-5517-b755-104a70761128" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "A={\\int }_{-3}^{0}(-{x}^{2}+2x-2)\\,\\text{d}x" :db/id #edb/ref 17592186248484} {:answer/id #uuid "907fc2ff-2b6f-5b81-8ef6-ee353873c46f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "A={\\int }_{-3}^{0}({x}^{2}-2x+2)\\,\\text{d}x" :db/id #edb/ref 17592186248707} {:answer/id #uuid "e0f6fe33-4274-5a92-8a81-3a822cd289e6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "A={\\int }_{-1}^{3}({x}^{2}-2x+2)\\,\\text{d}x" :db/id #edb/ref 17592186249414}] :answer-field/correct {:answer/id #uuid "3245c48f-1a4d-5b3a-9824-8d88eff85902" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "A={\\int }_{0}^{3}({x}^{2}-2x+2)\\,\\text{d}x" :db/id #edb/ref 17592186247883} :answer-field/id #uuid "31720fdc-70b9-5d97-9b44-5f4fe1d54cab" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186249760}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "63bcbbf8-c502-5d3b-bd0e-da913f8e74d5" :question/math-academy-id "q-113868" :question/problem "![](images/14/149fd953075c1d9909e036d4935ccd4f17ad1734d86bba4a70254468cd2035d5.png)\n\nFor the function $f(x)={x}^{2}-2x+2$ shown above, what is the expression for the area $A$ as a definite integral?" :question/worked-solution "We want to express the area $A$ between the function $f(x)={x}^{2}-2x+2$ and the $x$-axis, between $x=0$ and $x=3.$\n\nThis can be expressed as the definite integral of $f(x)={x}^{2}-2x+2$ between the lower limit $x=0$ and the upper limit $x=3,$ as follows:\n\n$$\nA={\\int }_{0}^{3}({x}^{2}-2x+2)\\,\\text{d}x\n$$"}] [{:db/id #edb/ref 17592186386717 :knowledge-point/_questions [{:db/id #edb/ref 17592186096631 :knowledge-point/id #uuid "cdc82e49-5df6-5096-a8fd-e00017fb1e3a" :knowledge-point/title "Expressing a Definite Integral as the Limit of a Left Riemann Sum"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7d1a6ba2-db64-573f-8e5b-b88ea8981842" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{lim}_{n\\to \\infty }{\\sum }_{i=0}^{n-1}[{e}^{3i/n}\\cdot \\frac{1}{3n}]" :db/id #edb/ref 17592186386719} {:answer/id #uuid "beae40ea-5a16-56be-94c0-5c319be8f0a9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{lim}_{n\\to \\infty }{\\sum }_{i=0}^{n-1}[{e}^{3i/n}\\cdot \\frac{3}{n}]" :db/id #edb/ref 17592186386720} {:answer/id #uuid "d70342b7-9d3b-5244-a755-c5e40ee84a60" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{lim}_{n\\to \\infty }{\\sum }_{i=0}^{n-1}[{e}^{i/n}\\cdot \\frac{1}{n}]" :db/id #edb/ref 17592186386721} {:answer/id #uuid "7758f4a7-e843-5572-bd52-fd33dee0bce2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{lim}_{n\\to \\infty }{\\sum }_{i=0}^{n-1}[{e}^{3i/n}\\cdot \\frac{1}{n}]" :db/id #edb/ref 17592186386722} {:answer/id #uuid "8503faec-27f0-534a-a1ff-592a3f1183d0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{lim}_{n\\to \\infty }{\\sum }_{i=0}^{n-1}[{e}^{i/n}\\cdot \\frac{3}{n}]" :db/id #edb/ref 17592186386723}] :answer-field/correct {:answer/id #uuid "beae40ea-5a16-56be-94c0-5c319be8f0a9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{lim}_{n\\to \\infty }{\\sum }_{i=0}^{n-1}[{e}^{3i/n}\\cdot \\frac{3}{n}]" :db/id #edb/ref 17592186386720} :answer-field/id #uuid "81eaba12-1887-5376-9908-1a56c2da3284" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186386718}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "a0fbe66e-c44a-5c47-b716-80288ecee20d" :question/math-academy-id "q-113880" :question/problem "What is ${\\int }_{0}^{3}{e}^{x}\\,\\text{d}x$ expressed as the limit of a left Riemann sum?" :question/worked-solution "The definite integral can be defined in terms of the limit of a left Riemann sum as\n\n$$\n{\\int }_{a}^{b}f(x)\\,\\text{d}x={lim}_{n\\to \\infty }{\\sum }_{i=0}^{n-1}f({x}_{i})\\cdot Δx,\n$$\n\n    \n\nwhere $Δx=\\frac{b-a}{n}$ and ${x}_{i}=a+iΔx.$\n\nIn the definite integral\n\n$$\n{\\int }_{0}^{3}{e}^{x}\\,\\text{d}x,\n$$\n\nthe function is $f(x)={e}^{x},$ the lower bound is $a=0,$ and the upper bound is $b=3.$ So, we have\n\n$$\nΔx=\\frac{3-0}{n}=\\frac{3}{n},\n$$\n\nand therefore\n\n$$\n\\begin{aligned}{\\int }_{0}^{3}{e}^{x}\\,\\text{d}x & ={lim}_{n\\to \\infty }{\\sum }_{i=0}^{n-1}f({x}_{i})\\cdot Δx \\\\  & ={lim}_{n\\to \\infty }{\\sum }_{i=0}^{n-1}[f(0+i\\cdot \\frac{3}{n})\\,\\cdot \\frac{3}{n}] \\\\  & ={lim}_{n\\to \\infty }{\\sum }_{i=0}^{n-1}[f(\\frac{3i}{n})\\cdot \\frac{3}{n}] \\\\  & ={lim}_{n\\to \\infty }{\\sum }_{i=0}^{n-1}[{e}^{3i/n}\\cdot \\frac{3}{n}].\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186250130 :knowledge-point/_questions [{:db/id #edb/ref 17592186064172 :knowledge-point/id #uuid "8bd8c6d8-0b11-5735-88a1-9b12e6315401" :knowledge-point/title "Integrating an Exponential Function With a General Base"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0558a391-cdbf-584c-a0f0-8f221f341cae" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{5}^{x}ln⁡5+C" :db/id #edb/ref 17592186247467} {:answer/id #uuid "06607b0a-9d24-576c-adf1-bdc2e55f52bb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{5}^{x}+C" :db/id #edb/ref 17592186247482} {:answer/id #uuid "22d652bf-3b5e-5181-8f0c-7123f5c17343" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{ln⁡x}{ln⁡5}+C" :db/id #edb/ref 17592186247734} {:answer/id #uuid "68d69094-f985-5c03-a478-6c0269a3cc32" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{5}^{x}}{ln⁡5}+C" :db/id #edb/ref 17592186248365} {:answer/id #uuid "99a53d55-830f-55db-ac33-a12525e3cd5a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5ln⁡x+C" :db/id #edb/ref 17592186248795}] :answer-field/correct {:answer/id #uuid "68d69094-f985-5c03-a478-6c0269a3cc32" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{5}^{x}}{ln⁡5}+C" :db/id #edb/ref 17592186248365} :answer-field/id #uuid "3eca50b8-7630-5d78-accd-b706994b9510" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186249782}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "333b8bc2-8d50-5f18-bbc4-8fbfe08b346d" :question/math-academy-id "q-113887" :question/problem "Calculate $\\int {5}^{x}\\,\\text{d}x.$" :question/worked-solution "To compute the integral of a general exponential function, we just need to divide by the natural logarithm of the base of the exponential function:\n\n$$\n\\begin{aligned}\\int {5}^{x}\\,\\text{d}x & =\\frac{{5}^{x}}{ln⁡5}+C\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186250134 :knowledge-point/_questions [{:db/id #edb/ref 17592186064178 :knowledge-point/id #uuid "0cae5c1b-57bd-51f6-a360-db946d25532f" :knowledge-point/title "Integrating Sine and Cosine"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "271c490c-5a05-5e0a-9c8e-cee6e93cd8b5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{6}cos⁡\\theta +C" :db/id #edb/ref 17592186247771} {:answer/id #uuid "39e2cf43-8568-5bca-98a7-54e900afc4d6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6cos⁡\\theta +C" :db/id #edb/ref 17592186247936} {:answer/id #uuid "8369302d-e75e-5f17-a44e-47eda2ef57fa" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-6sin⁡\\theta +C" :db/id #edb/ref 17592186248585} {:answer/id #uuid "8f10e1a5-527b-5f97-860b-39eca916d8f7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6sin⁡\\theta +C" :db/id #edb/ref 17592186248696} {:answer/id #uuid "a8b91066-0304-5eec-9198-3b7d46a0b0c8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-6cos⁡\\theta +C" :db/id #edb/ref 17592186248923}] :answer-field/correct {:answer/id #uuid "39e2cf43-8568-5bca-98a7-54e900afc4d6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6cos⁡\\theta +C" :db/id #edb/ref 17592186247936} :answer-field/id #uuid "d679155c-4e3c-59a8-a851-7bdacacd637d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186250043}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "4099e9a0-92e6-5376-9bf3-b36d248db1d1" :question/math-academy-id "q-113907" :question/problem "$\\int (-6sin⁡\\theta )\\,\\text{d}\\theta =$" :question/worked-solution "Recall that\n\n$$\n\\int sin⁡\\theta \\,\\text{d}\\theta =-cos⁡\\theta +C.\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}\\begin{aligned}\\int (-6sin⁡\\theta )\\,\\text{d}\\theta  & =-6\\int sin⁡\\theta \\,\\text{d}\\theta  \\\\  & =-6(-cos⁡\\theta )+C \\\\  & =6cos⁡\\theta +C.\\end{aligned}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186250138 :knowledge-point/_questions [{:db/id #edb/ref 17592186064179 :knowledge-point/id #uuid "e617f241-254b-5f70-9937-5883b6f28c4f" :knowledge-point/title "Integrating Secant-Tangent and Cosecant-Cotangent"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2a6b2d77-6333-57e0-afd5-ae25cfed1172" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3sec⁡xcot⁡x+C" :db/id #edb/ref 17592186247800} {:answer/id #uuid "558aa8a6-6ebf-5d3f-a5a9-3b19d8e488c1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3csc⁡x+C" :db/id #edb/ref 17592186248195} {:answer/id #uuid "73fffa3b-03d4-5a40-b567-70c7ae4ccf96" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3csc⁡x+C" :db/id #edb/ref 17592186248445} {:answer/id #uuid "a4b2a2ae-e079-58a1-a369-536f12c56dbc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3sec⁡x+C" :db/id #edb/ref 17592186248893} {:answer/id #uuid "acbcb4c2-9b18-5aa7-84c2-3dabda9f77dd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3sec⁡x+C" :db/id #edb/ref 17592186248966}] :answer-field/correct {:answer/id #uuid "73fffa3b-03d4-5a40-b567-70c7ae4ccf96" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3csc⁡x+C" :db/id #edb/ref 17592186248445} :answer-field/id #uuid "c3fad684-5e9d-51a7-9e19-ea6cfd103f16" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186250006}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "0ba0c93b-e27b-584f-9b8e-5ad2b653f757" :question/math-academy-id "q-113920" :question/problem "$\\int -3csc⁡x\\,cot⁡x\\,\\text{d}x=$" :question/worked-solution "Recall that\n\n$$\n\\int csc⁡xcot⁡x\\,\\text{d}x=-csc⁡x+C.\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}\\begin{aligned}\\int -3csc⁡x\\,cot⁡x\\,\\text{d}x & =-3\\int csc⁡xcot⁡x\\,\\text{d}x \\\\  & =-3(-csc⁡x)+C \\\\  & =3csc⁡x+C.\\end{aligned}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186386730 :knowledge-point/_questions [{:db/id #edb/ref 17592186096633 :knowledge-point/id #uuid "29b136d3-69bc-51ef-a262-dbee8af377d2" :knowledge-point/title "Expressing a Definite Integral as the Limit of a Right Riemann Sum"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5e817c90-73b6-5e40-a4cb-de6f65f4e504" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{lim}_{n\\to \\infty }{\\sum }_{k=1}^{n}[\\operatorname{arctan}⁡(\\frac{k}{n})\\cdot \\frac{1}{n}]" :db/id #edb/ref 17592186386732} {:answer/id #uuid "eec77c43-6c27-5f35-9de9-91342da5f4f9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{lim}_{n\\to \\infty }{\\sum }_{k=1}^{n}[\\operatorname{arctan}⁡(\\frac{3k}{n})\\cdot \\frac{3}{n}]" :db/id #edb/ref 17592186386733} {:answer/id #uuid "f138b282-2b50-5da5-af3e-9f5891074c43" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{lim}_{n\\to \\infty }{\\sum }_{k=1}^{n}[\\operatorname{arctan}⁡(\\frac{k}{3n})\\cdot \\frac{3}{n}]" :db/id #edb/ref 17592186386734} {:answer/id #uuid "69e645c6-0c73-5a1c-a257-403a41a6eca2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{lim}_{n\\to \\infty }{\\sum }_{k=1}^{n}[\\operatorname{arctan}⁡(\\frac{3k}{n})\\cdot \\frac{1}{n}]" :db/id #edb/ref 17592186386735} {:answer/id #uuid "dce1be34-b20a-5bb8-891d-5f521a6ed79b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{lim}_{n\\to \\infty }{\\sum }_{k=1}^{n}[\\operatorname{arctan}⁡(\\frac{3k}{n})\\cdot \\frac{1}{3n}]" :db/id #edb/ref 17592186386736}] :answer-field/correct {:answer/id #uuid "eec77c43-6c27-5f35-9de9-91342da5f4f9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{lim}_{n\\to \\infty }{\\sum }_{k=1}^{n}[\\operatorname{arctan}⁡(\\frac{3k}{n})\\cdot \\frac{3}{n}]" :db/id #edb/ref 17592186386733} :answer-field/id #uuid "1438f8f6-1b0c-5edd-937f-a796652639f0" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186386731}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "0af12d5f-0f9a-59ff-b6c2-207d86cde81b" :question/math-academy-id "q-113929" :question/problem "What is ${\\int }_{0}^{3}\\operatorname{arctan}⁡x\\,\\text{d}x$ expressed as the limit of a right Riemann sum?" :question/worked-solution "The definite integral can be defined in terms of the limit of a right Riemann sum as\n\n$$\n{\\int }_{a}^{b}f(x)\\,\\text{d}x={lim}_{n\\to \\infty }{\\sum }_{k=1}^{n}f({x}_{k})\\cdot Δx,\n$$\n\nwhere ${x}_{k}=a+kΔx$ and $Δx=\\frac{b-a}{n}.$\n\nIn the definite integral\n\n$$\n{\\int }_{0}^{3}\\operatorname{arctan}⁡x\\,\\text{d}x,\n$$\n\nthe function is $f(x)=\\operatorname{arctan}⁡x,$ the lower bound is $a=0$ and the upper bound is $b=3.$ So, we have\n\n$$\nΔx=\\frac{3-0}{n}=\\frac{3}{n}.\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}{\\int }_{0}^{3}\\operatorname{arctan}⁡x\\,\\text{d}x & ={lim}_{n\\to \\infty }{\\sum }_{k=1}^{n}f({x}_{k})\\cdot Δx \\\\  & ={lim}_{n\\to \\infty }{\\sum }_{k=1}^{n}[f(0+k\\cdot \\frac{3}{n})\\cdot \\frac{3}{n}] \\\\  & ={lim}_{n\\to \\infty }{\\sum }_{k=1}^{n}[f(\\frac{3k}{n})\\cdot \\frac{3}{n}] \\\\  & ={lim}_{n\\to \\infty }{\\sum }_{k=1}^{n}[\\operatorname{arctan}⁡(\\frac{3k}{n})\\cdot \\frac{3}{n}].\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186250142 :knowledge-point/_questions [{:db/id #edb/ref 17592186064180 :knowledge-point/id #uuid "caf358b8-31fb-5587-8663-f414317c42be" :knowledge-point/title "Integrating Secant Squared"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0a394ebb-e724-5257-b2b3-c6ee24c9c0ee" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2sec⁡\\theta +C" :db/id #edb/ref 17592186247513} {:answer/id #uuid "645e7853-d773-51a7-97f0-145e363f5063" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2csc⁡\\theta +C" :db/id #edb/ref 17592186248330} {:answer/id #uuid "a159c48f-05f8-5b71-ac43-7e38b5032b08" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-{csc}^{2}⁡\\theta +C" :db/id #edb/ref 17592186248866} {:answer/id #uuid "cb0b4d51-0534-5643-95e4-f3c845c225d3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{tan}^{2}⁡\\theta +C" :db/id #edb/ref 17592186249233} {:answer/id #uuid "ee2434c9-75b3-5a4f-85a5-13b29917e9e5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2tan⁡\\theta +C" :db/id #edb/ref 17592186249513}] :answer-field/correct {:answer/id #uuid "ee2434c9-75b3-5a4f-85a5-13b29917e9e5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2tan⁡\\theta +C" :db/id #edb/ref 17592186249513} :answer-field/id #uuid "0726a333-67f4-5bae-9092-988faf871214" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186249681}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "1eae0c2a-9fbb-58f9-9e02-1ea035b71ceb" :question/math-academy-id "q-113936" :question/problem "$\\int 2{sec}^{2}⁡\\theta \\,\\text{d}\\theta =$" :question/worked-solution "Recall that \n\n$$\n\\int {sec}^{2}⁡\\theta \\,\\text{d}\\theta =tan⁡\\theta +C\n$$\n\nTherefore, we get\n\n$$\n\\begin{aligned}\\begin{aligned}\\int 2{sec}^{2}⁡\\theta \\,\\text{d}\\theta  & =2\\int {sec}^{2}⁡\\theta \\,\\text{d}\\theta  \\\\  & =2tan⁡\\theta +C.\\end{aligned}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186250147 :knowledge-point/_questions [{:db/id #edb/ref 17592186064197 :knowledge-point/id #uuid "15bd1f67-6361-55f7-ba25-07e54aad8f66" :knowledge-point/title "Evaluating the Definite Integral of a Rational Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "455009c1-cd1b-5980-bebc-005c166aaab0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{47}{243}" :db/id #edb/ref 17592186248047} {:answer/id #uuid "896f555a-8df1-54e2-8351-8c2d255e5f6f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{26}{81}" :db/id #edb/ref 17592186248645} {:answer/id #uuid "af350e46-2ecb-56b8-977a-f33f11df9722" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{26}{27}" :db/id #edb/ref 17592186248994} {:answer/id #uuid "c7fb154d-0bb2-50c5-a991-8b8bf26ab955" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{13}{27}" :db/id #edb/ref 17592186249203} {:answer/id #uuid "e7b780a7-5d64-5db2-a401-0d776743ab54" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{13}{81}" :db/id #edb/ref 17592186249470}] :answer-field/correct {:answer/id #uuid "896f555a-8df1-54e2-8351-8c2d255e5f6f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{26}{81}" :db/id #edb/ref 17592186248645} :answer-field/id #uuid "1c672aeb-3770-5ff7-9ee1-eb36a7e65af5" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186249719}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "e8ba6724-aa4a-53a8-8ea0-e040d768a286" :question/math-academy-id "q-113989" :question/problem "${\\int }_{-3}^{-1}{x}^{-4}\\,\\text{d}x=$" :question/worked-solution "Taking the antiderivative and evaluating the difference at the bounds, we get\n\n$$\n\\begin{aligned}{\\int }_{-3}^{-1}{x}^{-4}\\,\\text{d}x & =\\frac{{x}^{-4+1}}{(-4+1)}{|}_{-3}^{-1} \\\\  & =\\frac{{x}^{-3}}{(-3)}{|}_{-3}^{-1} \\\\  & =-\\frac{1}{3{x}^{3}}{|}_{-3}^{-1} \\\\  & =-(\\frac{1}{3(-1)^{3}}-\\frac{1}{3(-3)^{3}}) \\\\  & =-(-\\frac{1}{3}+\\frac{1}{81}) \\\\  & =-(-\\frac{26}{81}) \\\\  & =\\frac{26}{81}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186250150 :knowledge-point/_questions [{:db/id #edb/ref 17592186078425 :knowledge-point/id #uuid "7a2c6bf6-41f2-5f8d-8799-5664ba941dc8" :knowledge-point/title "Evaluating an Integral Over an Interval of Length Zero"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2f6a62be-4070-51cf-9b36-7684793bdb06" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186247851} {:answer/id #uuid "942fde67-385c-57f0-ad15-3cda49a1bd8a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{22}" :db/id #edb/ref 17592186248742} {:answer/id #uuid "9ee4a28f-adee-50d4-9b6e-6440a0d91678" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\sqrt{11}" :db/id #edb/ref 17592186248836} {:answer/id #uuid "bc473dbe-9496-56bc-b9e8-a89ab673b0e3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186249102} {:answer/id #uuid "dc51090f-6a53-57be-9a22-91c74a75f576" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\sqrt{22}" :db/id #edb/ref 17592186249372}] :answer-field/correct {:answer/id #uuid "2f6a62be-4070-51cf-9b36-7684793bdb06" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186247851} :answer-field/id #uuid "f8472bf4-a23b-537a-b2ef-e297c386cf18" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186250108}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "225b3ea5-bb8d-54c8-bae9-8867b13798a5" :question/math-academy-id "q-114007" :question/problem "Calculate ${\\int }_{3}^{3}\\sqrt{{x}^{2}+4x+1}\\,\\text{d}x.$" :question/worked-solution "Notice that the lower and upper limits are the same. So, the integral evaluates to zero:\n\n$$\n{\\int }_{3}^{3}\\sqrt{{x}^{2}+4x+1}\\,\\text{d}x=0\n$$"}] [{:db/id #edb/ref 17592186362825 :knowledge-point/_questions [{:db/id #edb/ref 17592186078425 :knowledge-point/id #uuid "7a2c6bf6-41f2-5f8d-8799-5664ba941dc8" :knowledge-point/title "Evaluating an Integral Over an Interval of Length Zero"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "96a5c90e-2415-5df3-b6e6-9a4a431c0c75" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186362827} {:answer/id #uuid "d793bc22-b945-5913-a75f-57c6774dde70" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186362828} {:answer/id #uuid "0ee542ca-902e-5c06-9a15-8eea7c54c6af" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186362829} {:answer/id #uuid "4a01d610-d5bb-5146-a1fc-fb4335faeae8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{17}" :db/id #edb/ref 17592186362830} {:answer/id #uuid "a1324da7-ae49-5e5c-93c5-7e25e78f5d5a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2}{17}" :db/id #edb/ref 17592186362831}] :answer-field/correct {:answer/id #uuid "0ee542ca-902e-5c06-9a15-8eea7c54c6af" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186362829} :answer-field/id #uuid "b6099044-0c64-5ec4-abe1-26afaf189be1" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186362826}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "9885c003-5b86-56da-914e-6c614476b5c1" :question/math-academy-id "q-114010" :question/problem "Calculate ${\\int }_{-2}^{-2}\\frac{1}{1+{x}