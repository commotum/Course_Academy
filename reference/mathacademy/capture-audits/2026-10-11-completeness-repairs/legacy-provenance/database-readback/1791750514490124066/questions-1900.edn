482e28f2f7eeeed89cbac5c.png" :db/id #edb/ref 17592186392479} {:answer/id #uuid "cc6b1ec5-18b5-59a6-ac35-d404b0b9f34b" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/32/326290611c8ca441f0d9bcc0439678f0c29302b2784ee4fe65e69a3008ec8fe3.png" :db/id #edb/ref 17592186392480}] :answer-field/correct {:answer/id #uuid "d4ef4dea-31e8-5828-8c0a-fbbd1f3e8b97" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/df/df22eea4331c47da3047381ca672fd80ebf75118054316fe88c0e2d96dae0d34.png" :db/id #edb/ref 17592186392477} :answer-field/id #uuid "9e05f68f-1fcc-5b0b-b66c-d5b388883e5c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186392475}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "6d5543e2-0abb-561e-9632-e9b1d00fcc94" :question/math-academy-id "q-42117" :question/problem "What is the graph of $y=\\operatorname{arcsin}⁡x?$" :question/worked-solution "Let's recall some of the basic properties of $y=\\operatorname{arcsin}⁡x$:\n\n- The domain of the function is $x\\in [-1,1].$\n\n- The range of the function is $y\\in [-\\frac{\\pi }{2},\\frac{\\pi }{2}].$\n\n- Its minimum value occurs at $x=-1.$\n\n- Its maximum value occurs at $x=1.$\n\n- Its zero occurs at $x=0.$\n\n- The function is strictly increasing on its entire domain.\n\nOf the given functions, the only one that has all of these properties is as follows:\n\n![](images/df/df22eea4331c47da3047381ca672fd80ebf75118054316fe88c0e2d96dae0d34.png)"}] [{:db/id #edb/ref 17592186392481 :knowledge-point/_questions [{:db/id #edb/ref 17592186105746 :knowledge-point/id #uuid "07f2ae4c-ff07-5b99-a7b0-90f460081eef" :knowledge-point/title "Solving a Singular 2x2 System of Equations Using Gaussian Elimination"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "656236ac-76c2-57ac-afcc-6fef3eee767b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}x \\\\ y\\end{aligned}]=[\\begin{aligned}1-3y \\\\ y\\end{aligned}],\\,y\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186392483} {:answer/id #uuid "21fc8fc7-0be2-53a6-99c7-2cb1e090034f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "No solution" :db/id #edb/ref 17592186392484} {:answer/id #uuid "cb7cc337-7043-5f29-9a9e-c853229ab133" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}x \\\\ y\\end{aligned}]=[\\begin{aligned}2-3y \\\\ y\\end{aligned}],\\,y\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186392485} {:answer/id #uuid "4cc5f9be-53a1-53b5-83eb-dd3ed1177b70" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}x \\\\ y\\end{aligned}]=[\\begin{aligned}2+3y \\\\ y\\end{aligned}],\\,y\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186392486} {:answer/id #uuid "a3cdc156-a512-50b5-bb71-be50d05948f6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}x \\\\ y\\end{aligned}]=[\\begin{aligned}1+3y \\\\ y\\end{aligned}],\\,y\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186392487}] :answer-field/correct {:answer/id #uuid "cb7cc337-7043-5f29-9a9e-c853229ab133" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}x \\\\ y\\end{aligned}]=[\\begin{aligned}2-3y \\\\ y\\end{aligned}],\\,y\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186392485} :answer-field/id #uuid "8ff50c54-cba8-5cc5-a898-6fa889298459" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186392482}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "653d2739-ff74-51ff-bc93-114e79b1a15b" :question/math-academy-id "q-42153" :question/problem "Consider the system of linear equations\n\n$$\n{\\begin{aligned}x+3y=2 \\\\ 3x+9y=6.\\end{aligned}\n$$\n\nUse the standard method of Gaussian elimination to reduce the augmented matrix $M$ of the system to row echelon form, and then find the general solution of the linear system." :question/worked-solution "First, we set up the augmented matrix for the system:\n\n$$\nM=[\\begin{aligned}1 & 3 & 2 \\\\ 3 & 9 & 6\\end{aligned}]\n$$\n\nReducing $M$ to row echelon form, we have\n\n$$\n\\begin{aligned}M & =[\\begin{aligned}1 & 3 & 2 \\\\ 3 & 9 & 6\\end{aligned}] & {R}_{2} & :={R}_{2}+(-3){R}_{1} \\\\  & ∼[\\begin{aligned}1 & 3 & 2 \\\\ 0 & 0 & 0\\end{aligned}].\\end{aligned}\n$$\n\nThe corresponding system is now\n\n$$\n{\\begin{aligned}x+3y=2 \\\\ 0x+0y=0.\\end{aligned}\n$$\n\nSince any pair of numbers $x,y$ is a solution of the final equation $0x+0y=0,$ we can remove this equation from the system. So, our system now consists of a single equation\n\n$$\nx+3y=2.\n$$\n\nThe first variable $(x)$ is the basic variable, and the second variable $(y)$ is the free variable. Solving for the basic variable $(x)$ in terms of the free variable $(y),$ we get $x=2-3y,$ and the general solution is\n\n$$\n{\\begin{aligned}x=2-3y \\\\ y=y\\end{aligned}\n$$\n\nwhere $y$ is an arbitrary number. \n\nIn vector form, the general solution can be written as\n\n$$\n\\begin{aligned}[\\begin{aligned}x \\\\ y\\end{aligned}]=[\\begin{aligned}2-3y \\\\ y\\end{aligned}],\\,y\\in (-\\infty ,\\infty ).\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186392501 :knowledge-point/_questions [{:db/id #edb/ref 17592186115227 :knowledge-point/id #uuid "8feeacff-b07d-5f98-a765-4d8571674a7a" :knowledge-point/title "Calculating a Matrix Product Using the Associative Law"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1e619a67-9c5c-5198-a6e6-8fe2cae308d5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}55 \\\\ -21 \\\\ 50\\end{aligned}]" :db/id #edb/ref 17592186392503} {:answer/id #uuid "26af411f-4369-55ad-9e9b-e90514a5bcc0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}-68 \\\\ -22 \\\\ 50\\end{aligned}]" :db/id #edb/ref 17592186392504} {:answer/id #uuid "d5580b66-a310-537c-a0c5-a20457678669" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}-68 \\\\ -22 \\\\ 0\\end{aligned}]" :db/id #edb/ref 17592186392505} {:answer/id #uuid "45d96025-8f3a-50af-9de9-cd071e5ec232" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}68 \\\\ -22 \\\\ 40\\end{aligned}]" :db/id #edb/ref 17592186392506} {:answer/id #uuid "a3df1fc7-14b6-532e-b12c-6343f041272c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}42 \\\\ -12 \\\\ 50\\end{aligned}]" :db/id #edb/ref 17592186392507}] :answer-field/correct {:answer/id #uuid "26af411f-4369-55ad-9e9b-e90514a5bcc0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}-68 \\\\ -22 \\\\ 50\\end{aligned}]" :db/id #edb/ref 17592186392504} :answer-field/id #uuid "ed3d0a23-eac0-554f-905e-6466f6601ed5" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186392502}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "4cbd1e16-e623-56fd-8563-e7c6cd4b5ff2" :question/math-academy-id "q-42258" :question/problem "Calculate $ABC$, where\n\n$$\nA=[\\begin{aligned}-1 & 6 \\\\ 1 & 3 \\\\ 5 & -1\\end{aligned}],\\,B=[\\begin{aligned}3 & 1 & 2 \\\\ 0 & -5 & 1\\end{aligned}],\\,C=[\\begin{aligned}2 \\\\ 2 \\\\ 0\\end{aligned}].\n$$" :question/worked-solution "First, recall the associative law\n\n$$\nABC=(AB)C=A(BC).\n$$\n\nNotice that $A$ is a $3\\times 2$ matrix, $B$ is a $2\\times 3$ matrix, and $C$ is a $3\\times 1$ matrix. Therefore, \n\n- multiplying $A$ by $B$, we will obtain a $3\\times 3$ matrix, which will require finding $9$ entries, while\n\n- multiplying $B$ by $C$, we will obtain a $2\\times 1$ matrix, which will require finding $2$ entries.\n\nSo, we find the product $BC$ first: \n\n$$\n\\begin{aligned}BC & =[\\begin{aligned}3 & 1 & 2 \\\\ 0 & -5 & 1\\end{aligned}]\\cdot [\\begin{aligned}2 \\\\ 2 \\\\ 0\\end{aligned}] \\\\  & =[\\begin{aligned}8 \\\\ -10\\end{aligned}]\\end{aligned}\n$$\n\nNow, we multiply $A$ by $BC:$\n\n$$\n\\begin{aligned}ABC & =A(BC) \\\\  & =[\\begin{aligned}-1 & 6 \\\\ 1 & 3 \\\\ 5 & -1\\end{aligned}]\\cdot [\\begin{aligned}8 \\\\ -10\\end{aligned}] \\\\  & =[\\begin{aligned}-68 \\\\ -22 \\\\ 50\\end{aligned}]\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186392508 :knowledge-point/_questions [{:db/id #edb/ref 17592186115227 :knowledge-point/id #uuid "8feeacff-b07d-5f98-a765-4d8571674a7a" :knowledge-point/title "Calculating a Matrix Product Using the Associative Law"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f0a43c89-29de-5118-a4d4-3f996c643cb5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}7 & -2 \\\\ 15 & -7 \\\\ 9 & 1\\end{aligned}]" :db/id #edb/ref 17592186392510} {:answer/id #uuid "c445d736-2b33-5a39-a7be-0a95976a8481" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}7 \\\\ 15 \\\\ 0\\end{aligned}]" :db/id #edb/ref 17592186392511} {:answer/id #uuid "cbc16d9e-74fc-598e-a8df-a8298f3cced4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}7 & -2 \\\\ -15 & 7 \\\\ 0 & 0\\end{aligned}]" :db/id #edb/ref 17592186392512} {:answer/id #uuid "b96c80d8-2ac1-5468-adbf-38acb2a30f63" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}-7 \\\\ 12 \\\\ 9\\end{aligned}]" :db/id #edb/ref 17592186392513} {:answer/id #uuid "49f1aa56-0832-5de3-ba9b-9f00b6b7f69f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}7 \\\\ 15 \\\\ 9\\end{aligned}]" :db/id #edb/ref 17592186392514}] :answer-field/correct {:answer/id #uuid "49f1aa56-0832-5de3-ba9b-9f00b6b7f69f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}7 \\\\ 15 \\\\ 9\\end{aligned}]" :db/id #edb/ref 17592186392514} :answer-field/id #uuid "c68e793c-51ab-520a-a8e9-a83467b6243d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186392509}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "72c2951d-d6a9-5cec-b270-d342a8fcfdc1" :question/math-academy-id "q-42259" :question/problem "Calculate $ABC$, where\n\n$$\nA=[\\begin{aligned}1 & 0 \\\\ 2 & 1 \\\\ 1 & 2\\end{aligned}],\\,B=[\\begin{aligned}3 & 1 & 2 \\\\ 0 & 1 & 1\\end{aligned}],\\,C=[\\begin{aligned}2 \\\\ 1 \\\\ 0\\end{aligned}].\n$$" :question/worked-solution "First, recall the associative law\n\n$$\nABC=(AB)C=A(BC).\n$$\n\nNotice that $A$ is a $3\\times 2$ matrix, $B$ is a $2\\times 3$ matrix, and $C$ is a $3\\times 1$ matrix. Therefore, \n\n- multiplying $A$ by $B$, we will obtain a $3\\times 3$ matrix, which will require finding $9$ entries, while\n\n- multiplying $B$ by $C$, we will obtain a $2\\times 1$ matrix, which will require finding $2$ entries.\n\nSo, we find the product $BC$ first:\n\n$$\n\\begin{aligned}BC & =[\\begin{aligned}3 & 1 & 2 \\\\ 0 & 1 & 1\\end{aligned}]\\cdot [\\begin{aligned}2 \\\\ 1 \\\\ 0\\end{aligned}] \\\\  & =[\\begin{aligned}7 \\\\ 1\\end{aligned}]\\end{aligned}\n$$\n\nNow, we multiply $A$ by $BC:$\n\n$$\n\\begin{aligned}ABC & =A(BC) \\\\  & =[\\begin{aligned}1 & 0 \\\\ 2 & 1 \\\\ 1 & 2\\end{aligned}]\\cdot [\\begin{aligned}7 \\\\ 1\\end{aligned}] \\\\  & =[\\begin{aligned}7 \\\\ 15 \\\\ 9\\end{aligned}]\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186329640 :knowledge-point/_questions [{:db/id #edb/ref 17592186115228 :knowledge-point/id #uuid "5a870c4a-daa5-5df2-8968-d8bf9ac0bd75" :knowledge-point/title "Identifying True Statements Regarding Matrix Multiplication"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "19c7b53a-701a-51a2-a16d-4e21a8a4cc1b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186327157} {:answer/id #uuid "52c48599-aa51-58b9-b7f4-01369eca46de" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186327652} {:answer/id #uuid "90f50a2a-111f-54d0-a288-d415a537c42d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186328199} {:answer/id #uuid "c36d0ce7-0114-5581-9387-0b4151c0500e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186328642} {:answer/id #uuid "ec160af8-f144-50c1-b2ac-330cdc7c76a8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186329001}] :answer-field/correct {:answer/id #uuid "c36d0ce7-0114-5581-9387-0b4151c0500e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186328642} :answer-field/id #uuid "1f303ed6-16a7-554a-b9b7-791202045199" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186329235}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "005a0156-3d99-59d1-ab99-adf9b9b4c7b4" :question/math-academy-id "q-42264" :question/problem "Given that $A,B,$ and $C$ are $2\\times 2$ matrices, which of the following statements are always true?\n\n- $AB=BA$\n- $(AB)C=A(BC)$\n- $A(B-C)=(B-C)A$" :question/worked-solution "Let's consider the statements one by one.\n\n- Statement I is false. Matrix multiplication is not commutative, so $AB\\ne BA$ in general.\n\n- Statement II is true. Matrix multiplication is associative, so $(AB)C=A(BC)$ in general.\n\n- Statement III is false. Matrix multiplication is not commutative, so $A(B-C)\\ne (B-C)A$ in general.\n\nTherefore, only statement II is true."}] [{:db/id #edb/ref 17592186329647 :knowledge-point/_questions [{:db/id #edb/ref 17592186100869 :knowledge-point/id #uuid "b494140f-206a-5317-8079-ff719a253140" :knowledge-point/title "Determining Whether Two Matrices Are Conformable for Multiplication"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "56c993a3-b521-5e4e-9b63-95377e12d7bd" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186327688} {:answer/id #uuid "a3940e2a-5e4d-5111-9aa8-655e9e0cdb0e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186328350} {:answer/id #uuid "a6e55bac-7903-58ed-9ab9-ceb90373ea31" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186328384} {:answer/id #uuid "c647be2e-8b5a-5ce5-9a50-22a814f61f15" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186328674} {:answer/id #uuid "d6a063c4-4c0d-5e6a-9d31-a7b0ca0d2115" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186328813}] :answer-field/correct {:answer/id #uuid "a3940e2a-5e4d-5111-9aa8-655e9e0cdb0e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186328350} :answer-field/id #uuid "3df7bbd7-c529-5b77-87d0-548dcad75995" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186329305}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "628bddc5-7db2-5c2d-bca2-c9a2f11c4f87" :question/math-academy-id "q-42381" :question/problem "$$\nO=[\\begin{aligned}1 & 2 \\\\ -4 & 3 \\\\ 0 & 4\\end{aligned}],\\,P=[\\begin{aligned}5 & 0 & 0 \\\\ -4 & 5 & 1\\end{aligned}],\\,R=[\\begin{aligned}2 & 0 & 5\\end{aligned}]\n$$\n\nWhich of the following statements are true regarding the matrices $O,P,$ and $R?$\n\nI. The product $OP$ is well defined\n\nII. The product $OR$ is well defined\n\nIII. The product $PR$ is well defined" :question/worked-solution "Notice that $O$ is a $3\\times 2$ matrix, $P$ is a $2\\times 3$ matrix, and $R$ is a $1\\times 3$ row vector.\n\nThere are $2$ columns in $O$ and $2$ rows in $P.$ Since the number of columns in $O$ equals the number of rows in $P,$ the matrices $O$ and $P$ are conformable for multiplication:\n\n$$\n{O}_{3\\times \\boxed{\\text{2}}}{\\times }_{✓}{P}_{\\boxed{\\text{2}}\\times 3}=\\text{well defined}\n$$\n\nOn the other hand, there are $2$ columns in $O$ and $1$ rows in $R.$ Since the number of columns in $O$ does **not** equal the number of rows in $R,$ the matrices $O$ and $R$ are **not** conformable for multiplication:\n\n$$\n{O}_{3\\times 2}{\\times }_{\\ne }{R}_{1\\times 3}=\\text{undefined}\n$$\n\nFinally, there are $3$ columns in $P$ and $1$ rows in $R.$ Since the number of columns in $P$ does **not** equal the number of rows in $R,$ the matrices $P$ and $R$ are **not** conformable for multiplication:\n\n$$\n{P}_{2\\times 3}{\\times }_{\\ne }{R}_{1\\times 3}=\\text{undefined}\n$$\n\nTherefore, statement I is true, while statements II and III are false."}] [{:db/id #edb/ref 17592186329650 :knowledge-point/_questions [{:db/id #edb/ref 17592186110574 :knowledge-point/id #uuid "2df217d3-d1d2-54cd-8c93-7925225bfdf3" :knowledge-point/title "Identifying Values in the Range of the Inverse Cosine Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "08020323-c5a9-5b42-9d0e-dd6a5b878b40" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-1,\\frac{\\pi }{2})" :db/id #edb/ref 17592186327000} {:answer/id #uuid "49001fd7-a2ca-5328-aca0-c6263276892c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(0,0)" :db/id #edb/ref 17592186327571} {:answer/id #uuid "6f7b2933-c87c-5869-886d-bd6249488566" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(1,\\pi )" :db/id #edb/ref 17592186327901} {:answer/id #uuid "7202ed4c-a3a4-5db0-bb3b-08b9f0401f66" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-1,\\pi )" :db/id #edb/ref 17592186327921} {:answer/id #uuid "98bd83f6-9a85-596c-88fa-8629f4a8ff28" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(1,\\frac{\\pi }{2})" :db/id #edb/ref 17592186328252}] :answer-field/correct {:answer/id #uuid "7202ed4c-a3a4-5db0-bb3b-08b9f0401f66" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-1,\\pi )" :db/id #edb/ref 17592186327921} :answer-field/id #uuid "9d81aa2a-bd62-55a7-ab1c-fab1facf05b1" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186329446}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "2388e5a3-ccc0-5a99-a06b-72ab673f984d" :question/math-academy-id "q-42433" :question/problem "Which of the following gives the coordinates of the maximum point of the function $y=\\operatorname{arccos}⁡x?$" :question/worked-solution "Let's recall the 