#{[{:db/id #edb/ref 17592186253291 :knowledge-point/_questions [{:db/id #edb/ref 17592186087860 :knowledge-point/id #uuid "e75012ec-8203-574b-ba07-0a26e4cf4691" :knowledge-point/title "Finding the Equation of a Circle Given Endpoints of a Diameter"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "58b042e9-ade1-5935-8496-7739089d2bbc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{x}^{2}+{y}^{2}=\\sqrt{10}" :db/id #edb/ref 17592186251280} {:answer/id #uuid "7dabc331-8583-5eea-8639-2e4e3b6c2e93" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{x}^{2}+{y}^{2}=10" :db/id #edb/ref 17592186251605} {:answer/id #uuid "b16389d5-034e-5416-a93f-c8ca3c3cb569" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{x}^{2}+{y}^{2}=5" :db/id #edb/ref 17592186252105} {:answer/id #uuid "cd64e8ae-6767-597d-94ad-605f327334be" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{x}^{2}+{y}^{2}=25" :db/id #edb/ref 17592186252363} {:answer/id #uuid "f51bee25-4a1e-5318-a9c6-0478a7be24bf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{x}^{2}+{y}^{2}=\\sqrt{5}" :db/id #edb/ref 17592186252701}] :answer-field/correct {:answer/id #uuid "b16389d5-034e-5416-a93f-c8ca3c3cb569" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{x}^{2}+{y}^{2}=5" :db/id #edb/ref 17592186252105} :answer-field/id #uuid "8d216b22-c302-5a1c-933a-a0dd19c71347" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186253049}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "7e38a793-c9a3-5cf1-9d57-1f88f87f48f2" :question/math-academy-id "q-116927" :question/problem "![](images/34/343897550f0f7b9e4a479e47c9191ababa31070dac79dbf4d54befe869661a48.png)\n\nGiven that the points $X$ and $Y$ with coordinates $(-1,2)$ and $(1,-2),$ respectively, are the endpoints of a diameter of a circle centered at the origin, what is the equation of the circle?" :question/worked-solution "The equation of a circle with radius $r,$ centered at the origin, is \n\n$$\n{x}^{2}+{y}^{2}={r}^{2}.\n$$\n\nFirst, we calculate the length of the diameter $\\overset{―}{XY}:$\n\n$$\n\\begin{aligned}XY & =\\sqrt{(-1-1)^{2}+(2-(-2))^{2}} \\\\  & =\\sqrt{(-2)^{2}+{4}^{2}} \\\\  & =\\sqrt{4+16} \\\\  & =2\\sqrt{5}\\end{aligned}\n$$\n\nSince $\\overset{―}{XY}$ is a diameter, the radius is\n\n$$\nr=\\frac{XY}{2}=\\frac{2\\sqrt{5}}{2}=\\sqrt{5}.\n$$\n\nSo, the equation of the circle is\n\n$$\n\\begin{aligned}{x}^{2}+{y}^{2} & ={r}^{2} \\\\ {x}^{2}+{y}^{2} & ={(\\sqrt{5})}^{2} \\\\ {x}^{2}+{y}^{2} & =5.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186386841 :knowledge-point/_questions [{:db/id #edb/ref 17592186110568 :knowledge-point/id #uuid "69d6ed5b-1c29-53a7-a37e-817042a02861" :knowledge-point/title "Graphing the Inverse Sine Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3e370276-dd3a-5964-9ce3-7cf246014e85" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/62/628d53eca69ad50cab7557ede3a7f418264203fefd54adac965a7f7f446ece6c.png" :db/id #edb/ref 17592186386843} {:answer/id #uuid "ffedee4a-7324-59fb-a847-2555b4c482e9" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/df/df22eea4331c47da3047381ca672fd80ebf75118054316fe88c0e2d96dae0d34.png" :db/id #edb/ref 17592186386844} {:answer/id #uuid "52d82c0b-587c-5e13-b7a8-b445f168e155" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/d1/d1cb152b659ff0b75f70c8c7235357790d81c673df270de6b8dcb44bced33f39.png" :db/id #edb/ref 17592186386845} {:answer/id #uuid "69cca405-61ef-5beb-98b6-f0ac8830d33e" :answer/type {:db/id