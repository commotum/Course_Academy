#{[{:db/id #edb/ref 17592186284771 :knowledge-point/_questions [{:db/id #edb/ref 17592186059676 :knowledge-point/id #uuid "711f198b-26b4-5185-812a-102329d49313" :knowledge-point/title "Finding the Derivative of an Expression With the Tangent Trigonometric Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7b4dddb2-8ce0-518b-941e-482ca5265f7c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186282747} {:answer/id #uuid "bc54686a-049f-5040-b7a9-b8062cc1c750" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\sqrt{2}" :db/id #edb/ref 17592186283321} {:answer/id #uuid "be37be01-215e-5391-bca4-f872aefba533" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{\\sqrt{3}}" :db/id #edb/ref 17592186283341} {:answer/id #uuid "ea403761-0f48-5b27-a322-4bdbfaf43080" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{2}" :db/id #edb/ref 17592186283735} {:answer/id #uuid "f3762c53-5b99-5615-8c9e-e78f50dd46f8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186283817}] :answer-field/correct {:answer/id #uuid "7b4dddb2-8ce0-518b-941e-482ca5265f7c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186282747} :answer-field/id #uuid "33d75bdd-6edb-5b58-9b7f-46c8d0ecd14e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186284025}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "a05f390f-2f4a-5c91-9fbd-0dbf4e6d9e1b" :question/math-academy-id "q-17912" :question/problem "Calculate the instantaneous rate of change of the function $f(x)=-tan⁡x$ when $x=\\pi .$" :question/worked-solution "The instantaneous rate of change  when $x=\\pi $ is given by the value of the derivative ${f}^{′}(x)$ at $x=\\pi .$ \n\nFirst, we compute the derivative, using the fact that $\\frac{\\text{d}}{\\text{d}x}(tan⁡x)={sec}^{2}⁡x.$ We get\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}(-tan⁡x) \\\\  & =-{sec}^{2}⁡x.\\end{aligned}\n$$\n\nEvaluating at $x=\\pi ,$ we get\n\n$$\n\\begin{aligned}{f}^{′}(\\pi ) & =-{sec}^{2}⁡\\pi  \\\\  & =-1\\cdot (-1)^{2} \\\\  & =-1.\\end{aligned}\n$$\n\nTherefore,  the instantaneous rate of change is $-1.$"}] [{:db/id #edb/ref 17592186284783 :knowledge-point/_questions [{:db/id #edb/ref 17592186105903 :knowledge-point/id #uuid "acc86fb6-2ef4-5f8f-b204-6e1fdbbf0530" :knowledge-point/title "Calculating the Area of a Triangle"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7be3af12-12f0-5cd1-bd3d-bc6bfd57dcfa" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "54.57" :db/id #edb/ref 17592186282757} {:answer/id #uuid "b9e5da06-d9ea-53d3-908e-6037028c09ba" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "49.76" :db/id #edb/ref 17592186283295} {:answer/id #uuid "bcbaee44-4ce0-5ebe-9ae5-2cef0ffbe0aa" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "62.75" :db/id #edb/ref 17592186283325} {:answer/id #uuid "f1468e3f-6f85-57ba-8382-a6a2597ecc6a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "51.12" :db/id #edb/ref 17592186283792} {:answer/id #uuid "fe0ba284-2705-5fc9-9538-675c4f9b88c9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "59.59" :db/id #edb/ref 17592186283918}] :answer-field/correct {:answer/id #uuid "7be3af12-12f0-5cd1-bd3d-bc6bfd57dcfa" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "54.57" :db/id #edb/ref 17592186282757} :answer-field/id #uuid "49f02eb2-409f-54e5-8bc0-c2750241a7a3" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186284055}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "a01c1b66-7a91-5db5-9419-74aedf0189de" :question/math-academy-id "q-18027" :question/problem "![](images/f1/f11e50891625fb39de472762aaaff23edf43372e37fcdf55d129da1125c0ff8a.png)\n\nFind the area of $△ABC.$ Round your answer to two decimal places." :question/worked-solution "The formula for the area of the triangle is \n\n$$\nA=\\frac{1}{2}bc\\operatorname{sin}⁡A,\n$$\n\nwhere $∠A$ is between the sides of lengths $b$ and $c.$ \n\nHere, we have\n\n$$\n\\begin{aligned}с & =AB=26, \\\\ b & =AC=22, \\\\ m∠A & ={11}^{∘}.\\end{aligned}\n$$\n\nSince \n\n$$\n\\operatorname{sin}⁡{11}^{∘}=0.190\\,809,\n$$\n\nrounded to six decimal places,  we calculate the area as follows:\n \n\n$$\n\\begin{aligned}A & =\\frac{1}{2}\\cdot 22\\cdot 26\\cdot \\operatorname{sin}⁡{11}^{∘} \\\\  & =286\\cdot (0.190\\,809) \\\\  & ≈54.57,\\end{aligned}\n$$\n\nrounded to two decimal places."}] [{:db/id #edb/ref 17592186284784 :knowledge-point/_questions [{:db/id #edb/ref 17592186083219 :knowledge-point/id #uuid "74677256-e307-5d49-b7e0-c3f4e79cf818" :knowledge-point/title "Calculating the Number of Ways That N Objects Can Be Arranged"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "08737316-aa20-5df6-851c-dce808b637e9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "120" :db/id #edb/ref 17592186281762} {:answer/id #uuid "18fd45dc-1ede-51cf-9585-369b367a8961" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "25" :db/id #edb/ref 17592186281914} {:answer/id #uuid "82a108e9-b949-5ec3-82d9-001193cc0c6f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "95" :db/id #edb/ref 17592186282820} 