495e56b3" :knowledge-point/title "Differentiating a Sum of Functions With Constant Factors"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5446db9d-f32b-503a-98c3-71bd4b13a940" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{4}{{x}^{3}}-\\frac{9{x}^{1/4}}{4}" :db/id #edb/ref 17592186285562} {:answer/id #uuid "72b849ec-c73e-51c6-8bd6-7d57955bf8d1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{4}{{x}^{3}}-\\frac{9}{4\\sqrt[3]{x}}" :db/id #edb/ref 17592186285843} {:answer/id #uuid "93d4bb13-717f-50aa-afa5-f6147b1c9f75" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{4}{{x}^{2}}-9{x}^{3}" :db/id #edb/ref 17592186286135} {:answer/id #uuid "a7da2020-89e3-5d5f-bbdb-6fb669e629c5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{4}{{x}^{3}}+\\frac{9{x}^{-1/4}}{4}" :db/id #edb/ref 17592186286320} {:answer/id #uuid "e9029ff2-9352-53d1-a4ea-86df802fa96d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{4}{{x}^{3}}-\\frac{9}{4\\sqrt[4]{x}}" :db/id #edb/ref 17592186286919}] :answer-field/correct {:answer/id #uuid "e9029ff2-9352-53d1-a4ea-86df802fa96d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{4}{{x}^{3}}-\\frac{9}{4\\sqrt[4]{x}}" :db/id #edb/ref 17592186286919} :answer-field/id #uuid "8320dfd3-7a24-5485-a9b9-30a0c49ac165" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186287423}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "76292ca7-955e-5da2-801e-cf1602a2e16d" :question/math-academy-id "q-1856" :question/problem "Calculate $\\frac{\\text{d}y}{\\text{d}x}$ for $y=\\frac{2}{{x}^{2}}-3{x}^{3/4}.$" :question/worked-solution "Here, we apply the addition, constant multiple, and power rules:\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}}{\\text{d}x}(\\frac{2}{{x}^{2}}-3{x}^{3/4}) \\\\  & =\\frac{\\text{d}}{\\text{d}x}(2{x}^{-2})-\\frac{\\text{d}}{\\text{d}x}(3{x}^{3/4}) \\\\  & =2\\cdot \\frac{\\text{d}}{\\text{d}x}({x}^{-2})-3\\cdot \\frac{\\text{d}}{\\text{d}x}({x}^{3/4}) \\\\  & =2\\cdot (-2){x}^{(-2-1)}-3\\cdot \\frac{3}{4}{x}^{(3/4-1)} \\\\  & =-4{x}^{-3}-\\frac{9}{4}{x}^{-1/4} \\\\  & =-\\frac{4}{{x}^{3}}-\\frac{9}{4\\sqrt[4]{x}}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186287893 :knowledge-point/_questions [{:db/id #edb/ref 17592186100892 :knowledge-point/id #uuid "8de0dd63-23c6-5926-9e33-71e517949af2" :knowledge-point/title "Finding the Coefficient of a Particular Term"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "46d28906-8490-5c29-b464-0d5c1a48004e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4\\,096" :db/id #edb/ref 17592186285441} {:answer/id #uuid "99a94d50-1eb7-5245-b930-e867aafb297a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3\\,640" :db/id #edb/ref 17592186286196} {:answer/id #uuid "9b9888fc-dc7e-5ae3-99b6-a76b342aa777" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5\\,480" :db/id #edb/ref 17592186286217} {:answer/id #uuid "cba56c64-acf9-5648-abc7-affc33124f5e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6\\,560" :db/id #edb/ref 17592186286645} {:answer/id #uuid "d952dfee-02a8-55ff-a0dc-3cc35185c0a4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\,868" :db/id #edb/ref 17592186286767}] :answer-field/correct {:answer/id #uuid "99a94d50-1eb7-5245-b930-e867aafb297a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3\\,640" :db/id #edb/ref 17592186286196} :answer-field/id #uuid "90078a64-d272-59e6-bb4a-64d828c75a76" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186287445}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "9fe2343c-e168-571c-8f87-3172e7d9973d" :question/math-academy-id "q-18624" :question/problem "The coefficient of ${x}^{12}$ in the expansion of ${(2+x)}^{15}$ is" :question/worked-solution "The binomial theorem states that for any positive integer $n,$ we have\n\n$$\n(a+b)^{n}=(\\frac{n}{0}){a}^{n}{b}^{0}+(\\frac{n}{1}){a}^{n-1}{b}^{1}+(\\frac{n}{2}){a}^{n-2}{b}^{2}+⋯+(\\frac{n}{n}){a}^{0}{b}^{n}.\n$$\n\nIn the case of ${(2+x)}^{15},$ we have $a=2,$ $b=x,$ and $n=15.$ Therefore,\n\n$$\n\\begin{aligned}(2+x)^{15}=(\\frac{15}{0}){2}^{15}{x}^{0}+(\\frac{15}{1}){2}^{15-1}{x}^{1}+(\\frac{15}{2}){2}^{15-2}{x}^{2}+⋯+(\\frac{15}{15}){2}^{15-15}{x}^{15}.\\end{aligned}\n$$\n\nFrom here, we see that the ${x}^{12}$ term must be\n\n$$\n(\\frac{15}{12}){2}^{15-12}{x}^{12}.\n$$\n\nEvaluating the coefficient, we get\n\n$$\n\\begin{aligned}(\\frac{15}{12}){2}^{15-12} & =455\\cdot {2}^{3} \\\\  & =455\\cdot 8 \\\\  & =3\\,640.\\end{aligned}\n$$\n\nTherefore, the coefficient of ${x}^{12}$ is $3\\,640.$"}] [{:db/id #edb/ref 17592186060177 :knowledge-point/_questions [{:db/id #edb/ref 17592186059670 :knowledge-point/id #uuid "e6eef35a-3502-5429-bd71-fb5bd0e8efc8" :knowledge-point/title "Identifying Extrema on Transformed Curves"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "132ada2d-225c-55ef-ad34-507a30f3f6af" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-2,-8)" :db/id #edb/ref 17592186284958} {:answer/id #uuid "874eb524-3ed8-5726-b354-81594d6ba038" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(3,-4)" :db/id #edb/ref 17592186286028} {:answer/id #uuid "8da77226-b79f-5aa1-9fbb-eff1ddcce302" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-2,8)." :db/id #edb/ref 17592186286083} {:answer/id #uuid "de9a3fa5-07d3-5f60-9264-81029b284219" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(0,-4)" :db/id #edb/ref 17592186286813} {:answer/id #uuid "e77beded-c213-529c-9af4-9172511b2a92" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(2,8)." :db/id #edb/ref 17592186286904}] :answer-field/correct {:answer/id #uuid "132ada2d-225c-55ef-ad34-507a30f3f6af" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-2,-8)" :db/id #edb/ref 17592186284958} :answer-field/id #uuid "e490dbf9-e5ff-5dfa-a559-074583566e32" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186287616}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "1c0bb866-f5d6-5c26-9148-409419fa5279" :question/math-academy-id "q-186866" :question/problem "![](images/f4/f4da78b7a12ed475b64c1f824e8cecdf36657c6d174f0db770219fd8dd6c0801.png)\n\nThe diagram above shows the global minimum and maximum of the function $y=f(x).$ What is the global minimum of $y=-2f(x+1)?$" :question/worked-solution "Notice that the graph of $y=-2f(x+1)$ can be obtained from the graph of $y=f(x)$ by \n\n- translating it by $1$ unit to the left, then\n\n- stretching it by a scale factor of $2$ parallel to the $y$-axis, and finally\n\n- flipping it across the $x$-axis.\n\nSince one of these transformations flips the graph across the $x$-axis, the combined transformation maps the global **maximum** of $y=f(x)$ to the global **minimum** of $y=-2f(x+1).$ So, we need to find the image of $(-1,4),$ the global maximum of $y=f(x),$ under the transformation. \n\nTo plot $y=-2f(x+1),$ we apply the following steps: \n\n- First, we take the graph $y=f(x)$ that passes through $(-1,4).$\n\n- Then, we shift the graph horizontally by $1$ unit to the left and get the graph of $y=f(x+1).$ After this transformation, the point $(-1,4)$ will be mapped to the point\n\n$$\n(-1-1,4)=(-2,4).\n$$\n\n- Next, we stretch the result by a scale factor of $2$ along the $y$-axis and get the graph of $y=2f(x+1).$ After this transformation, the point $(-2,4)$ will be mapped to the point\n\n$$\n(-2,2\\cdot 4)=(-2,8).\n$$\n\n- Finally, we flip the result vertically across the $x$-axis and get the graph of $y=-2f(x+1).$ After this transformation, the point $(-2,8)$ will be mapped to the point\n\n$$\n(-2,-1\\cdot 8)=(-2,-8).\n$$\n\nTherefore, the global minimum of $y=-2f(x+1)$ is $(-2,-8).$"}] [{:db/id #edb/ref 17592186401798 :knowledge-point/_questions [{:db/id #edb/ref 17592186096784 :knowledge-point/id #uuid "f7578c48-cc9e-5170-8ffe-5ebee6580677" :knowledge-point/title "Solving a System Containing Decimals in One Equation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c397f249-716c-58ab-a9bf-91bfc3f7d868" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "a=0.5,\\,b=-1.4" :db/id #edb/ref 17592186401800} {:answer/id #uuid "2dec0c3e-7449-5041-96b3-12d8ef936e1a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "a=1.5,\\,b=2.4" :db/id #edb/ref 17592186401801} {:answer/id #uuid "3cc082a1-ed8d-5fbd-b12d-2a2df6063e77" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "a=1.2,\\,b=1.4" :db/id #edb/ref 17592186401802} {:answer/id #uuid "3da6187f-1bd3-5425-a6fa-9cc0e764d299" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "a=-1.2,\\,b=0.4" :db/id #edb/ref 17592186401803} {:answer/id #uuid "ba8550aa-5225-5217-b55a-8b4d6c0d09f1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "a=0.2,\\,b=1.7" :db/id #edb/ref 17592186401804}] :answer-field/correct {:answer/id #uuid "3cc082a1-ed8d-5fbd-b12d-2a2df6063e77" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "a=1.2,\\,b=1.4" :db/id #edb/ref 17592186401802} :answer-field/id #uuid "4994c6c6-b044-5fa6-ae9d-9a350ba14b9d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186401799}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "8748ba37-2d9a-5451-b497-621aa22378b8" :question/math-academy-id "q-18688" :question/problem "Find the solution of the following system:\n\n$$\n{\\begin{aligned}b=2a-1 \\\\ 1.5a+0.5b=2.5\\end{aligned}\n$$" :question/worked-solution "To get rid of the decimals, we multiply the second equation by $10,$ as follows:\n\n$$\n{\\begin{aligned}b=2a-1 &  \\\\ 1.5a+0.5b=2.5 & |\\,\\times 10\\end{aligned}\\,⟹\\,{\\begin{aligned}b=2a-1 \\\\ 15a+5b=25\\end{aligned}\n$$\n\nNotice that the first equation is already solved for $b:$\n\n$$\nb=2a-1\n$$\n\nNow, to find the value of $a,$ we can substitute $b=2a-1$ into the second equation:\n\n$$\n\\begin{aligned}15a+5(2a-1) & =25 \\\\ 15a+10a-5 & =25 \\\\ 25a & =30 \\\\ a & =\\frac{30}{25} \\\\ a & =1.2\\end{aligned}\n$$\n\nFinally, we substitute $a=1.2$ into the  first equation to get:\n\n$$\n\\begin{aligned}b & =2(1.2)-1 \\\\  & =2.4-1 \\\\  & =1.4\\end{aligned}\n$$\n\nThus, the solution to the system of equations is $a=1.2$ and $b=1.4.$"}] [{:db/id #edb/ref 17592186287900 :knowledge-point/_questions [{:db/id #edb/ref 17592186096785 :knowledge-point/id #uuid "cc62d8df-450f-5f7a-b647-b53c051f8339" :knowledge-point/title "Solving a System Containing Decimals in Both Equations"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3e87017a-3d71-526f-882c-4c2dfef523bb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4.5" :db/id #edb/ref 17592186285378} {:answer/id #uuid "779e6eca-f602-5727-b029-1c18d87c1280" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-0.5" :db/id #edb/ref 17592186285898} {:answer/id #uuid "77d04a2c-eb10-5431-830c-d23e900376e0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "7" :db/id #edb/ref 17592186285903} {:answer/id #uuid "8a09092a-f7a8-583a-ab31-352d4e305731" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-5.5" :db/id #edb/ref 17592186286049} {:answer/id #uuid "d485a384-181e-5a8e-9b1f-2a7c89a1bcb3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186286717}] :answer-field/correct {:answer/id #uuid "77d04a2c-eb10-5431-830c-d23e900376e0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "7" :db/id #edb/ref 17592186285903} :answer-field/id #uuid "8315d25a-73c2-509a-9efb-209d1dae20b5" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186287422}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "afe3b13e-ab14-5340-83f7-304f398b7445" :question/math-academy-id "q-18720" :question/problem "Let $(p,q)$ be the solution of the following system. What is the value of $p+2q?$\n\n$$\n{\\begin{aligned}0.36p+1.2q=0.36 \\\\ -1.9p-7.6q=3.8\\end{aligned}\n$$" :question/worked-solution "To get rid of the decimals, we multiply the first equation by $100$ and the second equation by $10,$ as follows:\n\n$$\n{\\begin{aligned}0.36p+1.2q=0.36 & |\\times 100 \\\\ -1.9p-7.6q=3.8 & |\\times 10\\end{aligned}\\,⟹\\,{\\begin{aligned}36p+120q=36 \\\\ -19p-76q=38\\end{aligned}\n$$\n\nNotice that we can solve for $p$ in the second equation:\n\n$$\n\\begin{aligned}-19p-76q & =38 \\\\ -19p & =76q+38 \\\\ p & =\\frac{76q+38}{-19} \\\\ p & =-4q-2\\end{aligned}\n$$\n\nNow, to find the value of $q,$ we can substitute $p=-4q-2$ into the first equation:\n\n$$\n\\begin{aligned}36p+120q & =36 \\\\ 36(-4q-2)+120q & =36 \\\\ -144q-72+120q & =36 \\\\ -24q & =108 \\\\ q & =-\\frac{108}{24} \\\\ q & =-4.5\\end{aligned}\n$$\n\nFinally, we substitute $q=-4.5$ into the equation $p=-4q-2$ to get:\n\n$$\n\\begin{aligned}p & =-4q-2 \\\\ p & =-4(-4.5)-2 \\\\ p & =18-2 \\\\ p & =16\\end{aligned}\n$$\n\nTherefore, the solution to the system of equations is $p=16$ and $q=-4.5.$ So, \n\n$$\np+2q=16+2(-4.5)=16-9=7.\n$$"}] [{:db/id #edb/ref 17592186106101 :knowledge-point/_questions [{:db/id #edb/ref 17592186105729 :knowledge-point/id #uuid "83423c03-d314-5f78-9acf-58cbb6f7774b" :knowledge-point/title "Calculating a Unit Vector Parallel to a Given Vector"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "fe61b3a1-9e6d-55b4-b6b7-27c3bed2c392" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨ - \\frac{2}{\\sqrt{74}}, \\frac{8}{\\sqrt{74}}, \\frac{3}{\\sqrt{74}}⟩" :db/id #edb/ref 17592186102483} {:answer/id #uuid "186ff4db-a684-5234-a9fe-d4445b22cdd3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨\\frac{2}{\\sqrt{74}}, \\frac{8}{\\sqrt{74}}, \\frac{3}{\\sqrt{74}}⟩" :db/id #edb/ref 17592186102484} {:answer/id #uuid "22ad60e1-fb01-562a-88b8-08b42c1e9884" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨ - \\frac{2}{\\sqrt{77}},-\\frac{8}{\\sqrt{77}},-\\frac{3}{\\sqrt{77}}⟩" :db/id #edb/ref 17592186102485} {:answer/id #uuid "28b4bc21-f68e-5747-965e-a89aa5afb118" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨\\frac{2}{\\sqrt{77}}, \\frac{8}{\\sqrt{77}}, \\frac{3}{\\sqrt{77}}⟩" :db/id #edb/ref 17592186102486} {:answer/id #uuid "49474f4b-2912-595f-95b0-9e42acee4bb3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨ - \\frac{2}{\\sqrt{77}}, \\frac{8}{\\sqrt{77}}, \\frac{3}{\\sqrt{77}}⟩" :db/id #edb/ref 17592186102487}] :answer-field/id #uuid "9edea1ff-b532-59c5-b499-57648c90c425" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186102482} {:answer-field/choices [{:answer/id #uuid "5f99cbb1-2bbb-59be-947b-044557644091" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨-\\frac{2}{\\sqrt{77}},\\frac{8}{\\sqrt{77}},\\frac{3}{\\sqrt{77}}⟩" :db/id #edb/ref 17592186390348} {:answer/id #uuid "1a526c30-a852-56c6-b14c-c2025f540361" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨-\\frac{2}{\\sqrt{77}},-\\frac{8}{\\sqrt{77}},-\\frac{3}{\\sqrt{77}}⟩" :db/id #edb/ref 17592186390349} {:answer/id #uuid "ab385b24-8ef8-5f1a-bd08-498b2099ce33" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨\\frac{2}{\\sqrt{74}},\\frac{8}{\\sqrt{74}},\\frac{3}{\\sqrt{74}}⟩" :db/id #edb/ref 17592186390350} {:answer/id #uuid "585a8c8c-14a7-54a3-b24f-e4f0fbf0ee6e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨\\frac{2}{\\sqrt{77}},\\frac{8}{\\sqrt{77}},\\frac{3}{\\sqrt{77}}⟩" :db/id #edb/ref 17592186390351} {:answer/id #uuid "353305b2-1bf3-530e-9fe4-e18cf98ffcba" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨-\\frac{2}{\\sqrt{74}},\\frac{8}{\\sqrt{74}},\\frac{3}{\\sqrt{74}}⟩" :db/id #edb/ref 17592186390352}] :answer-field/correct {:answer/id #uuid "5f99cbb1-2bbb-59be-947b-044557644091" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨-\\frac{2}{\\sqrt{77}},\\frac{8}{\\sqrt{77}},\\frac{3}{\\sqrt{77}}⟩" :db/id #edb/ref 17592186390348} :answer-field/id #uuid "13eb807a-8732-502e-90a4-aea8f6fe280d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186390347}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "46dce84e-4f15-50e3-8511-5dd62cf1728a" :question/math-academy-id "q-18975" :question/problem "Let $a=⟨-2,8,3⟩.$ Find a unit vector that is parallel to $a.$" :question/worked-solution "Remember that to find a unit vector that is parallel to a given vector, we need to divide the given vector by its length:\n\n$$\nu=\\frac{a}{|\\,a\\,|}\n$$\n\nUsing the formula for the magnitude of a vector, we get\n\n$$\n\\begin{aligned}|\\,a\\,| & =\\sqrt{{a}_{x}^{2}+{a}_{y}^{2}+{a}_{z}^{2}} \\\\  & =\\sqrt{(-2)^{2}+{8}^{2}+{3}^{2}} \\\\  & =\\sqrt{4+64+9} \\\\  & =\\sqrt{77}.\\end{aligned}\n$$\n\nFinally, we divide $a$ by its length and get the following unit vector:\n\n$$\n\\begin{aligned}u & =\\frac{a}{|\\,a\\,|} \\\\  & =\\frac{1}{\\sqrt{77}}a \\\\  & =\\frac{1}{\\sqrt{77}}\\cdot ⟨-2,8,3⟩ \\\\  & =⟨-\\frac{2}{\\sqrt{77}},\\frac{8}{\\sqrt{77}},\\frac{3}{\\sqrt{77}}⟩\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186287913 :knowledge-point/_questions [{:db/id #edb/ref 17592186105730 :knowledge-point/id #uuid "a087e7bc-4e74-584d-af3b-bf6bee4b75ea" :knowledge-point/title "Finding the Angle Between Two Vectors Given Their Components"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0daa6c22-b6f3-51d9-a6de-9fda6e8596b8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{85.82}^{∘}" :db/id #edb/ref 17592186284905} {:answer/id #uuid "1abecb7e-2e0a-5388-81ae-f79fa8d93b52" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{79.76}^{∘}" :db/id #edb/ref 17592186285026} {:answer/id #uuid "2ac816ad-f66f-5fc9-a2a3-07c82119d299" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{82.28}^{∘}" :db/id #edb/ref 17592186285162} {:answer/id #uuid "69f3be6b-4783-52f4-84fe-9b95d561ffc8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{94.32}^{∘}" :db/id #edb/ref 17592186285757} {:answer/id #uuid "ee1020da-a591-5782-8a4a-25069e02b21f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{74.66}^{∘}" :db/id #edb/ref 17592186286970}] :answer-field/correct {:answer/id #uuid "0daa6c22-b6f3-51d9-a6de-9fda6e8596b8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{85.82}^{∘}" :db/id #edb/ref 17592186284905} :answer-field/id #uuid "cbf80208-e230-50e2-a705-9a72d129b4fc" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186287569}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "213ad054-3594-5fcc-a936-bdc01a05c42f" :question/math-academy-id "q-19036" :question/problem "Find the angle between $a=⟨4,-3,2⟩$ and $b=⟨3,4,1⟩.$ Round your answer to $2$ decimal places." :question/worked-solution "Rearranging the dot product formula, we have:\n\n$$\n\\begin{aligned}\\operatorname{cos}⁡\\theta  & =\\frac{a\\cdot b}{|\\,a\\,||\\,b\\,|} \\\\  & =\\frac{{a}_{x}{b}_{x}+{a}_{y}{b}_{y}+{a}_{z}{b}_{z}}{\\sqrt{{a}_{x}^{2}+{a}_{y}^{2}+{a}_{z}^{2}}\\sqrt{{b}_{x}^{2}+{b}_{y}^{2}+{b}_{z}^{2}}} \\\\  & =\\frac{4\\cdot 3+(-3)\\cdot 4+2\\cdot 1}{\\sqrt{{4}^{2}+(-3)^{2}+{2}^{2}}\\sqrt{{3}^{2}+{4}^{2}+{1}^{2}}} \\\\  & =\\frac{2}{\\sqrt{29}\\cdot \\sqrt{26}} \\\\  & =\\frac{2}{\\sqrt{754}}\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\theta =\\operatorname{arccos}⁡(\\frac{2}{\\sqrt{754}})≈{85.82}^{∘}.\n$$"}] [{:db/id #edb/ref 17592186287915 :knowledge-point/_questions [{:db/id #edb/ref 17592186105753 :knowledge-point/id #uuid "a418d9aa-d74d-58b1-a4c9-819f63593d50" :knowledge-point/title "Finding the Angle Between Two Vectors Given the Value of Their Dot Product"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0ad90516-6de3-5322-9799-56d50aedcba7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{104.5}^{∘}" :db/id #edb/ref 17592186284878} {:answer/id #uuid "2e4ce063-2662-501f-a7d4-6cffbba3f19a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{110.8}^{∘}" :db/id #edb/ref 17592186285201} {:answer/id #uuid "38a6c708-fe56-5283-a85a-91fad1eaa1c4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{92.3}^{∘}" :db/id #edb/ref 17592186285317} {:answer/id #uuid "5ba26421-66e7-5b20-882a-624c20d91ba3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{84.7}^{∘}" :db/id #edb/ref 17592186285628} {:answer/id #uuid "85ac83f4-5a71-50ed-ae67-c0b78cdc3044" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{132.4}^{∘}" :db/id #edb/ref 17592186286016}] :answer-field/correct {:answer/id #uuid "0ad90516-6de3-5322-9799-56d50aedcba7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{104.5}^{∘}" :db/id #edb/ref 17592186284878} :answer-field/id #uuid "7d084ddf-6dab-583a-a6fe-289d9ce77544" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186287409}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "024f1eea-1cf9-519a-baef-cf481604490c" :question/math-academy-id "q-19038" :question/problem "Given that $p\\cdot q=-5$, find the angle between $p=⟨4t,-2,t⟩$ and $q=⟨1,3,-3⟩.$ Round your answer to $1$ decimal place." :question/worked-solution "First, since $p\\cdot q=-5$, we can solve for $t$, as follows:\n\n$$\n\\begin{aligned}p\\cdot q & =-5 \\\\ 4t\\cdot 1+(-2)\\cdot 3+t\\cdot (-3) & =-5 \\\\ 4t-6-3t & =-5 \\\\ t & =1\\end{aligned}\n$$\n\nSo, \n\n$$\n\\begin{aligned}p & =⟨4(1),-2,1⟩ \\\\  & =⟨4,-2,1⟩.\\end{aligned}\n$$\n\nNow, the cosine of the angle between $p$ and $q$ is\n\n$$\n\\begin{aligned}\\operatorname{cos}⁡\\theta  & =\\frac{p\\cdot q}{|\\,p\\,||\\,q\\,|} \\\\  & =\\frac{{p}_{x}{q}_{x}+{p}_{y}{q}_{y}+{p}_{z}{q}_{z}}{\\sqrt{{p}_{x}^{2}+{p}_{y}^{2}+{p}_{z}^{2}}\\sqrt{{q}_{x}^{2}+{q}_{y}^{2}+{q}_{z}^{2}}} \\\\  & =\\frac{-5}{\\sqrt{{4}^{2}+(-2)^{2}+{1}^{2}}\\sqrt{{1}^{2}+{3}^{2}+(-3)^{2}}} \\\\  & =-\\frac{5}{\\sqrt{21}\\cdot \\sqrt{19}} \\\\  & =-\\frac{5}{\\sqrt{399}}.\\end{aligned}\n$$\n\nTHerefore,\n\n$$\n\\theta =\\operatorname{arccos}⁡(-\\frac{5}{\\sqrt{399}})≈{104.5}^{∘}.\n$$"}] [{:db/id #edb/ref 17592186287917 :knowledge-point/_questions [{:db/id #edb/ref 17592186115193 :knowledge-point/id #uuid "7995b377-1de4-5126-aa29-8cc30b4918f8" :knowledge-point/title "Finding the Slope of the Tangent at a Point of a Function Involving Reciprocal Trigonometric Functions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "04d15acc-1672-5ec4-bb78-f3474884b897" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{\\pi }{3}-5\\sqrt{3}" :db/id #edb/ref 17592186284830} {:answer/id #uuid "48fabaf5-be8a-589c-8cf0-074c455a9240" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\pi }{3}-10\\sqrt{3}" :db/id #edb/ref 17592186285458} {:answer/id #uuid "63f73e2e-4004-5fc8-9825-f8337f6c2b07" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{\\pi }{6}-10\\sqrt{3}" :db/id #edb/ref 17592186285697} {:answer/id #uuid "766bb2aa-4af5-5e09-aed3-a777505c1a5c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\pi }{3}+10\\sqrt{3}" :db/id #edb/ref 17592186285891} {:answer/id #uuid "e40e7c86-1ed2-5d5e-9940-61e65ceaec5c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{\\pi }{3}-10\\sqrt{3}" :db/id #edb/ref 17592186286873}] :answer-field/correct {:answer/id #uuid "e40e7c86-1ed2-5d5e-9940-61e65ceaec5c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{\\pi }{3}-10\\sqrt{3}" :db/id #edb/ref 17592186286873} :answer-field/id #uuid "e8570317-ecab-5ed9-a868-188d2c2ead8e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186287627}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "f9daa906-697e-5ad9-9a96-96e98679f403" :question/math-academy-id "q-1904" :question/problem "Find the slope of $y=f(x)$ at $x=\\frac{\\pi }{6}$ if $f(x)=-{x}^{2}+5csc⁡x.$" :question/worked-solution "First, we calculate the derivative using the sum rule:\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{d}{dx}(-{x}^{2}+5csc⁡x) \\\\  & =2\\cdot (-x)+5(-csc⁡xcot⁡x) \\\\  & =-2x-5csc⁡xcot⁡x\\end{aligned}\n$$\n\nThen, we substitute $x=\\frac{\\pi }{6}$ into the derivative and get:\n\n$$\n\\begin{aligned}{f}^{′}(\\frac{\\pi }{6}) & =-2(\\frac{\\pi }{6})-5csc⁡(\\frac{\\pi }{6})cot⁡(\\frac{\\pi }{6}) \\\\  & =-\\frac{\\pi }{3}-5\\cdot 2\\cdot \\sqrt{3} \\\\  & =-\\frac{\\pi }{3}-10\\sqrt{3}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186287920 :knowledge-point/_questions [{:db/id #edb/ref 17592186115400 :knowledge-point/id #uuid "905d1f6a-72aa-5984-8c7d-920497fd58e4" :knowledge-point/title "Differentiating Inverse Reciprocal Trigonometric Functions Using the Product Rule"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "08847216-8695-5c58-9c55-4efd9ea37cd7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(3{x}^{2}+2)arccotx-\\frac{{x}^{3}+2x}{{x}^{2}+1}" :db/id #edb/ref 17592186284855} {:answer/id #uuid "713ca5fb-8006-5933-96ce-17ac96219558" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(3{x}^{2}+2)arccotx-\\frac{1}{{x}^{2}+1}" :db/id #edb/ref 17592186285826} {:answer/id #uuid "75c3ab8f-18e2-59e5-b409-f23279f422cf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "arccotx-\\frac{({x}^{3}+2x)(3{x}^{2}+2)}{{x}^{2}+1}" :db/id #edb/ref 17592186285882} {:answer/id #uuid "a0bb6a0e-a3e1-53de-bf1c-a588c28c1165" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(3{x}^{2}+2)-\\frac{1}{{x}^{2}+1}" :db/id #edb/ref 17592186286254} {:answer/id #uuid "a3628ab9-5c34-5c92-bef6-1314d9e06e81" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "arccotx-\\frac{{x}^{3}+2x}{{x}^{2}+1}" :db/id #edb/ref 17592186286286}] :answer-field/correct {:answer/id #uuid "08847216-8695-5c58-9c55-4efd9ea37cd7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(3{x}^{2}+2)arccotx-\\frac{{x}^{3}+2x}{{x}^{2}+1}" :db/id #edb/ref 17592186284855} :answer-field/id #uuid "751d5f7c-e24c-5495-bd5f-426fdee41841" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186287394}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "dd1d008a-84eb-52df-bb09-d41421bc5f0f" :question/math-academy-id "q-19065" :question/problem "Calculate ${f}^{′}(x)$ for $f(x)=({x}^{3}+2x)arccotx.$" :question/worked-solution "The formula for the derivative of $arccot$ is\n\n$$\n\\frac{\\text{d}}{\\text{d}x}(arccotx)=-\\frac{1}{1+{x}^{2}}.\n$$\n\nUsing the product rule and the formula above, we obtain\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}(({x}^{3}+2x)arccotx) \\\\  & =arccotx\\cdot \\frac{\\text{d}}{\\text{d}x}({x}^{3}+2x)+({x}^{3}+2x)\\cdot \\frac{\\text{d}}{\\text{d}x}(arccotx) \\\\  & =arccotx\\cdot (3{x}^{2}+2)+({x}^{3}+2x)\\cdot (-\\frac{1}{1+{x}^{2}}) \\\\  & =(3{x}^{2}+2)arccotx-\\frac{{x}^{3}+2x}{{x}^{2}+1}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186064539 :knowledge-point/_questions [{:db/id #edb/ref 17592186064170 :knowledge-point/id #uuid "67f41769-a0ff-5ecc-8b05-5890a7ac9fe3" :knowledge-point/title "Integrating Using Arcsecant"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "46152cad-db26-5489-9885-4872107442fa" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "11arcsecx+C" :db/id #edb/ref 17592186285429} {:answer/id #uuid "729aed06-b282-521d-acb9-4668cd5b0175" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "arcsec(11x)+C" :db/id #edb/ref 17592186285842} {:answer/id #uuid "938eb1ee-7ab4-5c5a-9a1e-41f61385c5ef" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "arccsc(11x)+C" :db/id #edb/ref 17592186286131} {:answer/id #uuid "bacc3b3a-e948-590d-a0b3-c31bb9639de6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "arcsecx+C" :db/id #edb/ref 17592186286488} {:answer/id #uuid "cf0db5b1-a31d-566b-9b38-cd041089c3ff" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "11arccscx+C" :db/id #edb/ref 17592186286666}] :answer-field/correct {:answer/id #uuid "46152cad-db26-5489-9885-4872107442fa" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "11arcsecx+C" :db/id #edb/ref 17592186285429} :answer-field/id #uuid "01c584f0-c6ff-5109-ba98-24519ff2f970" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186287140}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "f5ca0aa8-06db-5c6f-bb07-38d950f613d0" :question/math-academy-id "q-19100" :question/problem "$\\int \\frac{11}{|x|\\sqrt{{x}^{2}-1}}\\,\\text{d}x=$" :question/worked-solution "Recall that\n\n$$\n\\int \\frac{1}{|x|\\sqrt{{x}^{2}-1}}\\,\\text{d}x=\\text{arcsec}\\,x.\n$$\n\nThen we have\n\n$$\n\\begin{aligned}\\begin{aligned}\\int \\frac{11}{|x|\\sqrt{{x}^{2}-1}}\\,\\text{d}x & =11\\int \\frac{1}{|x|\\sqrt{{x}^{2}-1}}\\,\\text{d}x \\\\  & =11arcsecx+C.\\end{aligned}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186064540 :knowledge-point/_questions [{:db/id #edb/ref 17592186064185 :knowledge-point/id #uuid "8e6b5d85-0b53-580f-9520-6c33463231d5" :knowledge-point/title "Integrating Using Inverse Trigonometric Functions and Some Manipulations"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "02d1fed6-2003-5f27-aae5-10563638a94a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3x-3\\operatorname{arctan}⁡x+C" :db/id #edb/ref 17592186284812} {:answer/id #uuid "4a505557-0c7c-5346-91d3-f43699946a4e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3\\,\\text{arccos}\\,x+C" :db/id #edb/ref 17592186285476} {:answer/id #uuid "857d016b-947d-51cc-a94f-504ff730be03" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3x-3\\operatorname{arctan}⁡x+C" :db/id #edb/ref 17592186286014} {:answer/id #uuid "95a187aa-f975-58a0-836c-3c543a56e0fc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3\\,\\text{arctan}\\,x+C" :db/id #edb/ref 17592186286147} {:answer/id #uuid "ea53131b-47dd-5ccd-bab6-9d3aa84dd5a6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3x+3\\operatorname{arcsin}⁡x+C" :db/id #edb/ref 17592186286933}] :answer-field/correct {:answer/id #uuid "857d016b-947d-51cc-a94f-504ff730be03" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3x-3\\operatorname{arctan}⁡x+C" :db/id #edb/ref 17592186286014} :answer-field/id #uuid "18a42158-518b-5329-b494-893d421c1e55" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186287191}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "2a43a9d4-962c-592e-be6c-4c9a905c5e08" :question/math-academy-id "q-19102" :question/problem "$\\int \\frac{3{x}^{2}}{{x}^{2}+1}\\,\\text{d}x=$" :question/worked-solution "This integral doesn't look like one of the basic ones. However, we can manipulate the numerator a bit  to make it look more like the denominator, which reveals a more familiar expression:\n\n$$\n\\begin{aligned}\\frac{3{x}^{2}}{{x}^{2}+1} & =\\frac{3{x}^{2}+3-3}{{x}^{2}+1} \\\\  & =\\frac{3({x}^{2}+1)-3}{{x}^{2}+1} \\\\  & =\\frac{3({x}^{2}+1)}{{x}^{2}+1}-\\frac{3}{{x}^{2}+1} \\\\  & =\\frac{3\\cancel{({x}^{2}+1)}}{\\cancel{{x}^{2}+1}}-\\frac{3}{{x}^{2}+1} \\\\  & =3-\\frac{3}{{x}^{2}+1}\\end{aligned}\n$$\n\nRemembering that\n\n$$\n\\int \\frac{1}{{x}^{2}+1}\\text{d}x=\\operatorname{arctan}⁡x,\n$$\n\nwe can now calculate the integral and get\n\n$$\n\\begin{aligned}\\begin{aligned}\\int \\frac{3{x}^{2}}{{x}^{2}+1}\\,\\text{d}x & =\\int (3-\\frac{3}{{x}^{2}+1})\\text{d}x \\\\  & =3\\int \\text{d}x-3\\int \\frac{1}{{x}^{2}+1}\\,\\text{d}x \\\\  & =3x-3\\operatorname{arctan}⁡x+C.\\end{aligned}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186106107 :knowledge-point/_questions [{:db/id #edb/ref 17592186105731 :knowledge-point/id #uuid "f7b1b8dc-bb50-59b4-8716-bdd6fbeada4f" :knowledge-point/title "Finding the Angle Between Two Vectors Given Three Points"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5ea29480-cac0-5cc3-8047-adc941fa21a3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{120}^{∘}" :db/id #edb/ref 17592186285655} {:answer/id #uuid "75622db7-e002-5c1b-9372-fa25bdc45120" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{90}^{∘}" :db/id #edb/ref 17592186285873} {:answer/id #uuid "b204700e-83e0-5a79-9f25-c452d7d023d7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{60}^{∘}" :db/id #edb/ref 17592186286416} {:answer/id #uuid "b826d348-d7ac-59b4-9416-af96b6d8c91e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{75}^{∘}" :db/id #edb/ref 17592186286469} {:answer/id #uuid "fc260a7d-4cf6-56c4-8c1c-5138b1ec36db" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{45}^{∘}" :db/id #edb/ref 17592186287092}] :answer-field/correct {:answer/id #uuid "75622db7-e002-5c1b-9372-fa25bdc45120" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{90}^{∘}" :db/id #edb/ref 17592186285873} :answer-field/id #uuid "7bd5b7c8-b33e-53f5-923e-d59cd403ae02" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186287406}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "f6f80f82-94f9-5bde-ac4d-44929ef66109" :question/math-academy-id "q-19110" :question/problem "Find $∠QPR$ given the points $P(0,4,5)$, $Q(1,5,4)$, and $R(2,3,6).$" :question/requires-calculator true :question/worked-solution "Note that the position vectors of the points $P$, $Q$, $R$ are\n\n$$\n\\begin{aligned}p=⟨0,4,5⟩,\\,q=⟨1,5,4⟩,\\,r=⟨2,3,6⟩.\\end{aligned}\n$$\n\nThe $△PQR$ is shown (schematically) in the diagram below, where we denote $∠QPR=\\theta .$ \n\n![](images/30/3003f0cb329a8f8ef9bc315c70df4773ac1f0c54843dea1208c68bd0f6227bd1.png)\n\nFirst, we find the components of $\\overset{\\to }{PQ}$ and $\\overset{\\to }{PR}$:\n\n$$\n\\begin{aligned}\\overset{\\to }{PQ} & =q-p \\\\  & =⟨1,5,4⟩-⟨0,4,5⟩ \\\\  & =⟨1,1,-1⟩ \\\\ \\overset{\\to }{PR} & =r-p \\\\  & =⟨2,3,6⟩-⟨0,4,5⟩ \\\\  & =⟨2,-1,1⟩\\end{aligned}\n$$\n\nNow, the cosine of the angle between $\\overset{\\to }{PQ}$ and $\\overset{\\to }{PR}$ is\n\n$$\n\\begin{aligned}\\operatorname{cos}⁡\\theta  & =\\frac{\\overset{\\to }{PQ}\\cdot \\overset{\\to }{PR}}{|\\overset{\\to }{PQ}||\\overset{\\to }{PR}|} \\\\  & =\\frac{1\\cdot 2+1\\cdot (-1)+(-1)\\cdot 1}{\\sqrt{{1}^{2}+{1}^{2}+(-1)^{2}}\\sqrt{{2}^{2}+(-1)^{2}+{1}^{2}}} \\\\  & =\\frac{0}{\\sqrt{3}\\cdot \\sqrt{6}} \\\\  & =0.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\theta =\\operatorname{arccos}⁡(0)={90}^{∘}.\n$$"}] [{:db/id #edb/ref 17592186401805 :knowledge-point/_questions [{:db/id #edb/ref 17592186115191 :knowledge-point/id #uuid "9699341b-c4e2-547f-8d98-bcda30567272" :knowledge-point/title "Differentiating Expressions Involving the Cotangent Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0a34f86b-faa2-5844-9680-3f6951dc4ecf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{x}^{4}{csc}^{2}⁡x+8{x}^{3}cot⁡x" :db/id #edb/ref 17592186401807} {:answer/id #uuid "63214331-a811-5bf2-8cb7-4da5c8c1d678" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2{x}^{4}{cot}^{2}⁡x-8{x}^{3}csc⁡x" :db/id #edb/ref 17592186401808} {:answer/id #uuid "2285f6af-f131-5a62-954e-164127014717" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2{x}^{4}{csc}^{2}⁡x-8{x}^{3}cot⁡x" :db/id #edb/ref 17592186401809} {:answer/id #uuid "5a35c415-50b4-5005-8173-6121abbd643e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2{x}^{2}csc⁡x-8{x}^{3}cot⁡x" :db/id #edb/ref 17592186401810} {:answer/id #uuid "cb8e226f-a28c-5b1a-b7df-6f312bfd06a3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2{x}^{4}{csc}^{2}⁡x+8{x}^{3}tan⁡x" :db/id #edb/ref 17592186401811}] :answer-field/correct {:answer/id #uuid "2285f6af-f131-5a62-954e-164127014717" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2{x}^{4}{csc}^{2}⁡x-8{x}^{3}cot⁡x" :db/id #edb/ref 17592186401809} :answer-field/id #uuid "f7aeb284-4f80-510f-8935-07a7e23c626b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186401806}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "ee4e083b-fcc9-5eb5-9a27-ac52f9a97afd" :question/math-academy-id "q-1913" :question/problem "Find $\\frac{\\text{d}y}{\\text{d}x}$ if $y=-2{x}^{4}cot⁡x.$" :question/worked-solution "We calculate the derivative using the product rule, as follows:\n\n$$\n\\begin{aligned}\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}}{\\text{d}x}(-2{x}^{4}cot⁡x) \\\\  & =(-8{x}^{3})(cot⁡x)+(-2{x}^{4})(-{csc}^{2}⁡x) \\\\  & =-8{x}^{3}cot⁡x+2{x}^{4}{csc}^{2}⁡x\\end{aligned}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186287939 :knowledge-point/_questions [{:db/id #edb/ref 17592186105701 :knowledge-point/id #uuid "7c9317eb-d1ce-5f42-b69b-a37e643b865b" :knowledge-point/title "Calculating a Vector Projection Using Angle and Magnitude"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "51f1a168-e459-5855-9f32-c7f995528292" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-6\\sqrt{2}b" :db/id #edb/ref 17592186285543} {:answer/id #uuid "9d0ca20c-6282-53b7-a446-f76828bdd080" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-18\\sqrt{2}b" :db/id #edb/ref 17592186286224} {:answer/id #uuid "b1302f72-3e46-5025-ab0e-97b643675a59" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-9\\sqrt{2}b" :db/id #edb/ref 17592186286407} {:answer/id #uuid "c07b1571-e4fd-5a58-a381-73bd15f01a6d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-12\\sqrt{2}b" :db/id #edb/ref 17592186286548} {:answer/id #uuid "cb5ff959-29d9-5163-867c-ef6c1827374c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3\\sqrt{2}b" :db/id #edb/ref 17592186286643}] :answer-field/correct {:answer/id #uuid "cb5ff959-29d9-5163-867c-ef6c1827374c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3\\sqrt{2}b" :db/id #edb/ref 17592186286643} :answer-field/id #uuid "1c576604-9cab-5f35-9107-e12da3cf2cf2" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186287208}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "9b19c031-650e-5cdc-af13-3ca3ed0d48bd" :question/math-academy-id "q-19220" :question/problem "Suppose that $|\\,a\\,|=36$, $|\\,b\\,|=6$ and that the angle between the vectors is $\\theta ={135}^{∘}.$ Find the vector projection of $a$ onto $b$ in terms of the vector $b.$" :question/worked-solution "First, we find the scalar projection as follows:\n\n$$\n\\begin{aligned}{\\text{comp}}_{b}\\,a & =|\\,a\\,|\\operatorname{cos}⁡\\theta  \\\\  & =36\\operatorname{cos}⁡({135}^{∘}) \\\\  & =36\\cdot (-\\frac{\\sqrt{2}}{2}) \\\\  & =-18\\sqrt{2}\\end{aligned}\n$$\n\nNow, we find the unit vector that is parallel to $b:$\n\n$$\nu=\\frac{b}{|\\,b\\,|}=\\frac{b}{6}=\\frac{1}{6}b\n$$\n\nFinally, we compute the vector projection as follows:\n\n$$\n\\begin{aligned}{\\text{proj}}_{b}\\,a & ={\\text{comp}}_{b}\\,a\\cdot u \\\\  & =(-18\\sqrt{2})\\cdot \\frac{1}{6}b \\\\  & =-3\\sqrt{2}b\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186401812 :knowledge-point/_questions [{:db/id #edb/ref 17592186064370 :knowledge-point/id #uuid "a1ec1379-ce50-53c7-b04d-3380676ebeb9" :knowledge-point/title "Calculating the Velocity of a Particle at a Particular Moment"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e41ae0ea-e83b-581f-a124-c29c127545ab" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "v=9.46" :db/id #edb/ref 17592186401814} {:answer/id #uuid "2ddc81bc-6b74-5b86-9aa6-68b7985e21ee" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "v=4.94" :db/id #edb/ref 17592186401815} {:answer/id #uuid "4c2d52e0-5f90-57ca-a8a9-c0f4aaadbdfb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "v=10.03" :db/id #edb/ref 17592186401816} {:answer/id #uuid "e34561e5-c74f-5726-99b2-cd744a8924ae" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "v=9.24" :db/id #edb/ref 17592186401817} {:answer/id #uuid "eea394a2-6e5a-5394-a910-d19a50a2530e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "v=8.36" :db/id #edb/ref 17592186401818}] :answer-field/correct {:answer/id #uuid "e41ae0ea-e83b-581f-a124-c29c127545ab" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "v=9.46" :db/id #edb/ref 17592186401814} :answer-field/id #uuid "ab640647-5232-553a-be5a-08e8539221b0" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186401813}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "59ea1544-758d-5928-bf3f-4995dd8b61f1" :question/math-academy-id "q-19299" :question/problem "The position $s(t)$ of a particle at time $t$ is given by \n\n$$\ns(t)=4{e}^{-t}+3{t}^{2}-2t+1,\\,t\\ge 0.\n$$\n\nCalculate the velocity at time $t=2.$ Round your answer to $2$ decimal places." :question/worked-solution "First, we calculate the velocity function by differentiating the position function:\n\n$$\n\\begin{aligned}v(t) & =\\frac{\\text{d}s}{\\text{d}t} \\\\  & =\\frac{\\text{d}}{\\text{d}t}(4{e}^{-t}+3{t}^{2}-2t+1) \\\\  & =-4{e}^{-t}+6t-2\\end{aligned}\n$$\n\nTo calculate the velocity at $t=2,$ we substitute $t=2$ into the velocity function above:\n\n$$\n\\begin{aligned}v(2) & =-4{e}^{-2}+6\\cdot 2-2 \\\\  & =-4{e}^{-2}+10 \\\\  & =9.458\\,658… \\\\  & ≈9.46\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186287951 :knowledge-point/_questions [{:db/id #edb/ref 17592186092261 :knowledge-point/id #uuid "2f4bfd24-dafd-57b3-940a-154a6e0acf3d" :knowledge-point/title "Differentiating a General Exponential Function Using the Chain Rule"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0bb72661-686b-55b7-acd2-2a3bd4990839" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "9\\cdot {2}^{9x}" :db/id #edb/ref 17592186284881} {:answer/id #uuid "0fa45466-3a87-5294-bb09-177ec594bc1e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "9x" :db/id #edb/ref 17592186284925} {:answer/id #uuid "7da55036-6972-52f3-847b-a31f95df7852" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{2}^{9x}" :db/id #edb/ref 17592186285944} {:answer/id #uuid "968393cd-2595-5198-a30d-859a805cd56e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "9\\operatorname{ln}⁡2\\cdot {2}^{9x}" :db/id #edb/ref 17592186286156} {:answer/id #uuid "f0d61fb9-24f0-590c-861d-b0dc09f76a1f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{ln}⁡2\\cdot {2}^{9x}" :db/id #edb/ref 17592186286998}] :answer-field/correct {:answer/id #uuid "968393cd-2595-5198-a30d-859a805cd56e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "9\\operatorname{ln}⁡2\\cdot {2}^{9x}" :db/id #edb/ref 17592186286156} :answer-field/id #uuid "05333763-722c-5f4d-b56e-21e02dec7970" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186287152}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "15807573-b299-5e98-85b6-db47d2fbe91c" :question/math-academy-id "q-1952" :question/problem "Given that $y={2}^{9x},$ find $\\frac{\\text{d}y}{\\text{d}x}.$" :question/worked-solution "First, we express $y$ as the composite function\n\n$$\ny={2}^{u},\\,u=9x.\n$$\n\nDifferentiating gives\n\n$$\n\\frac{\\text{d}y}{\\text{d}u}={2}^{u}\\operatorname{ln}⁡2,\\,\\frac{\\text{d}u}{\\text{d}x}=9.\n$$\n\nWe now apply the chain rule, and get\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}y}{\\text{d}u}\\cdot \\frac{\\text{d}u}{\\text{d}x} \\\\  & ={2}^{u}\\operatorname{ln}⁡2\\cdot 9 \\\\  & =9\\operatorname{ln}⁡2\\cdot {2}^{u} \\\\  & =9\\operatorname{ln}⁡2\\cdot {2}^{9x}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186287953 :knowledge-point/_questions [{:db/id #edb/ref 17592186100950 :knowledge-point/id #uuid "a180dc90-c6b9-577e-9eef-ed60ecafe4e5" :knowledge-point/title "Finding the General Solution to an Equation Containing a Transformed Cosine Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "21a58fd9-1eec-5255-a842-d9b344d5a32b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{3}{2}" :db/id #edb/ref 17592186285089} {:answer/id #uuid "244c711b-020d-50ea-a3c7-e3f53022f59e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{3}{16}" :db/id #edb/ref 17592186285105} {:answer/id #uuid "3ce9febb-24a9-5950-8f46-fb621aa09f6e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186285362} {:answer/id #uuid "9ab55399-eaab-5bf2-b31d-0cc923874c94" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{3}{4}" :db/id #edb/ref 17592186286205} {:answer/id #uuid "a252d0dc-972c-57ed-b476-d063056a314b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{3}{8}" :db/id #edb/ref 17592186286275}] :answer-field/correct {:answer/id #uuid "a252d0dc-972c-57ed-b476-d063056a314b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{3}{8}" :db/id #edb/ref 17592186286275} :answer-field/id #uuid "ad78ce79-2c39-5ac5-96ff-eade1681f9f7" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186287508}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "00abbf43-3e03-55ab-b7aa-2f9087193808" :question/math-academy-id "q-19756" :question/problem "Consider the following trigonometric equation: \n\n$$\n\\operatorname{cos}⁡(2x+\\frac{3\\pi }{4})=1\n$$\n\nThe general solution of this equation can be expressed as \n\n$$\nx=\\pi a+\\pi n\n$$\n\nwhere $n$ is any integer. Which of the following could be the value of $a?$" :question/worked-solution "The general solution to our equation is\n\n$$\n\\begin{aligned}2x+\\frac{3\\pi }{4} & =0+2\\pi n.\\end{aligned}\n$$\n\nSolving the equation above for $x,$ we get:\n\n$$\n\\begin{aligned}2x & =-\\frac{3\\pi }{4}+2\\pi n \\\\ x & =-\\frac{3\\pi }{8}+\\pi n\\end{aligned}\n$$\n\nTherefore, $a=-\\frac{3}{8}.$"}] [{:db/id #edb/ref 17592186233619 :knowledge-point/_questions [{:db/id #edb/ref 17592186179660 :knowledge-point/id #uuid "644b7f09-7f66-50f2-8eba-ef6e009429d0" :knowledge-point/title "Simplifying a Variable Expression Containing a Quotient With Many Factorials"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "22766496-0abf-50a1-80d1-5c3aa17a5c49" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(n-8)(n+8)(n+9)" :db/id #edb/ref 17592186285095} {:answer/id #uuid "2decc5e8-9169-5cef-a48f-c52612fb5bb9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(n+8)(n+9)" :db/id #edb/ref 17592186285195} {:answer/id #uuid "68bba672-b656-58bd-ab7d-b6d8e1d686e5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(n+7)(n+8)(n+9)" :db/id #edb/ref 17592186285750} {:answer/id #uuid "96c58f78-9e89-5c29-947e-3e0a3eea9a98" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{(n+8)(n+9)}{n-9}" :db/id #edb/ref 17592186286158} {:answer/id #uuid "bd10a16d-830d-53c9-ba1c-682004537a80" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{n+9}{n-9}" :db/id #edb/ref 17592186286513}] :answer-field/correct {:answer/id #uuid "22766496-0abf-50a1-80d1-5c3aa17a5c49" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(n-8)(n+8)(n+9)" :db/id #edb/ref 17592186285095} :answer-field/id #uuid "12acb7ca-836f-551c-8db4-207dc9c189b1" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186287179}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "f3ef0665-6f2a-5dd9-af17-7da892c3b332" :question/math-academy-id "q-19882" :question/problem "Given that $n\\ge 9$ is an integer, simplify $\\frac{(n-8)!\\,(n+9)!}{(n-9)!\\,(n+7)!}.$" :question/worked-solution "First, we notice that\n\n$$\n\\begin{aligned}(n+9)! & =(n+9)(n+8)(n+7)! \\\\ (n-8)! & =(n-8)(n-9)!\\end{aligned}\n$$\n\nThen, we can cancel the $(n+7)!$ and $(n-9)!$ that occur in both the numerator and the denominator:\n\n$$\n\\begin{aligned}\\frac{(n-8)!\\,(n+9)!}{(n-9)!\\,(n+7)!} & =\\frac{[(n-8)\\cdot (n-9)!]\\cdot [(n+9)\\cdot (n+8)\\cdot (n+7)!]}{(n-9)!\\cdot (n+7)!} \\\\  & =\\frac{(n-8)\\cdot \\cancel{(n-9)!}\\cdot (n+9)\\cdot (n+8)\\cdot \\cancel{(n+7)!}}{\\cancel{(n-9)!}\\cdot \\cancel{(n+7)!}} \\\\  & =(n-8)\\cdot (n+8)\\cdot (n+9) \\\\  & =(n-8)(n+8)(n+9)\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186287964 :knowledge-point/_questions [{:db/id #edb/ref 17592186179660 :knowledge-point/id #uuid "644b7f09-7f66-50f2-8eba-ef6e009429d0" :knowledge-point/title "Simplifying a Variable Expression Containing a Quotient With Many Factorials"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0cdf387f-3a0b-57c6-89ff-676228ded636" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2m}{m+5}" :db/id #edb/ref 17592186284894} {:answer/id #uuid "1b734ea2-a219-577a-8568-20df8a2e2919" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{m+5}" :db/id #edb/ref 17592186285031} {:answer/id #uuid "1e6ad601-4800-552a-b12e-a5b40856f5ab" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2m}{m+4}" :db/id #edb/ref 17592186285058} {:answer/id #uuid "4334150f-17b3-522c-8a54-1ba9d10b279e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2m" :db/id #edb/ref 17592186285408} {:answer/id #uuid "c780a0ee-f288-5cb4-974a-df2c2b28d6ed" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{m}{m+4}" :db/id #edb/ref 17592186286616}] :answer-field/correct {:answer/id #uuid "0cdf387f-3a0b-57c6-89ff-676228ded636" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2m}{m+5}" :db/id #edb/ref 17592186284894} :answer-field/id #uuid "30b22a75-1b58-5fe1-bc2a-8eed1972c5c4" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186287251}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "ae781a4d-b2cf-5568-b0a5-f23d5dc664e6" :question/math-academy-id "q-19887" :question/problem "Given that $m\\ge 1$ is an integer, simplify $\\frac{(2m)!\\,(m+4)!}{(m+5)!\\,(2m-1)!}.$" :question/worked-solution "First, we notice that\n\n$$\n\\begin{aligned}(m+5)! & =(m+5)(m+4)! \\\\ 2m! & =2m(2m-1)!\\end{aligned}\n$$\n\nThen, we can cancel the $(m+4)!$ and $(2m-1)!$ that occur in both the numerator and the denominator:\n\n$$\n\\begin{aligned}\\frac{(2m)!\\,(m+4)!}{(m+5)!\\,(2m-1)!} & =\\frac{(2m)\\,\\cdot (2m-1)!\\cdot (m+4)!}{(m+5)\\cdot (m+4)!\\cdot (2m-1)!} \\\\  & =\\frac{(2m)\\,\\cdot \\cancel{(2m-1)!}\\cdot \\cancel{(m+4)!}}{(m+5)\\cdot \\cancel{(m+4)!}\\cdot \\cancel{(2m-1)!}} \\\\  & =\\frac{2m}{m+5}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186287965 :knowledge-point/_questions [{:db/id #edb/ref 17592186083220 :knowledge-point/id #uuid "e49e2595-62a1-595a-8df9-99541bccbdf5" :knowledge-point/title "Calculating Permutations"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "110abfe8-256f-586f-8c14-cdbacbf98aa0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "48" :db/id #edb/ref 17592186284936} {:answer/id #uuid "6a8cbe92-7d56-57d4-ac77-8dcc36070b12" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "24" :db/id #edb/ref 17592186285763} {:answer/id #uuid "75559a19-2283-512d-bed1-5bd115893a57" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "12" :db/id #edb/ref 17592186285871} {:answer/id #uuid "7c34d0e6-2814-5d2f-be61-88b870668d34" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186285933} {:answer/id #uuid "a1f7b5bb-d5a9-5ca5-9642-1dbe2e08c1b8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186286271}] :answer-field/correct {:answer/id #uuid "a1f7b5bb-d5a9-5ca5-9642-1dbe2e08c1b8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186286271} :answer-field/id #uuid "29d5b268-f0c4-5b8e-8047-2fa1728600f0" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186287239}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "b4641263-8717-5c07-a2d0-51003a352849" :question/math-academy-id "q-19899" :question/problem "Michael goes to a restaurant and orders a sandwich, a salad, and a muffin. In how many different orders can he decide to eat his food?" :question/worked-solution "There are $3$ foods, so there are $3!$ ways of ordering them:\n\n$$\n\\begin{aligned}3! & =3\\times 2\\times 1 \\\\  & =6.\\end{aligned}\n$$\n\nTherefore, there are 6 possible arrangements."}] [{:db/id #edb/ref 17592186287980 :knowledge-point/_questions [{:db/id #edb/ref 17592186092165 :knowledge-point/id #uuid "26666440-d376-5cb6-b922-9850e5c42eb3" :knowledge-point/title "Solving a Trigonometric Equation Involving Cosine Under a Modified Domain"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "471b8112-fe03-5559-8fd9-7d262e3aacb2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{{\\pi }^{2}}{16}" :db/id #edb/ref 17592186285445} {:answer/id #uuid "51beac23-bf68-50c9-952d-653cee2aa6dc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{25{\\pi }^{2}}{36}" :db/id #edb/ref 17592186285540} {:answer/id #uuid "71ac35f1-a93a-56ba-81c5-2d2d400444ea" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{5{\\pi }^{2}}{36}" :db/id #edb/ref 17592186285834} {:answer/id #uuid "82f17c2a-2ee4-5365-bf0f-241c55acae58" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{{\\pi }^{2}}{36}" :db/id #edb/ref 17592186285989} {:answer/id #uuid "aa74e9c4-0cc5-5f42-a6c7-ce6192d80edf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{4{\\pi }^{2}}{9}" :db/id #edb/ref 17592186286341}] :answer-field/correct {:answer/id #uuid "51beac23-bf68-50c9-952d-653cee2aa6dc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{25{\\pi }^{2}}{36}" :db/id #edb/ref 17592186285540} :answer-field/id #uuid "8be7a502-2728-5180-92ba-ee5a5a51b7d0" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186287439}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "fe360508-b564-5f2e-8656-ff74569f459b" :question/math-academy-id "q-20214" :question/problem "Given that ${x}_{1}$ and ${x}_{2}$ are the solutions of the equation $2\\sqrt{3}\\operatorname{cos}⁡x+3=0$ for $-\\pi <x\\le \\pi ,$ what is the value of ${x}_{1}\\cdot {x}_{2}?$" :question/worked-solution "First, we rearrange the equation, isolating $\\operatorname{cos}⁡x:$\n\n$$\n\\begin{aligned}2\\sqrt{3}\\operatorname{cos}⁡x+3 & =0 \\\\ 2\\sqrt{3}\\operatorname{cos}⁡x & =-3 \\\\ \\operatorname{cos}⁡x & =-\\frac{3}{2\\sqrt{3}} \\\\ \\operatorname{cos}⁡x & =-\\frac{\\sqrt{3}}{2}\\end{aligned}\n$$\n\nNow, we find the principal value:\n\n$$\n\\begin{aligned}x=\\operatorname{arccos}⁡(-\\frac{\\sqrt{3}}{2})=\\frac{5\\pi }{6}\\end{aligned}\n$$\n\nSince $\\frac{5\\pi }{6}$ lies inside the required domain, our first solution is ${x}_{1}=\\frac{5\\pi }{6}.$\n\nOur first solution lies in the second quadrant and has a reference angle of ${\\theta }_{R}=\\frac{\\pi }{6}.$ Since $\\operatorname{cos}⁡x<0,$ the second solution must lie in the third quadrant, and it also has a reference angle ${\\theta }_{R}=\\frac{\\pi }{6}.$\n\n![](images/6b/6bc5aed39e6421b8ff2416edb75dc888c8f38ae14f99b3d6e28d8e4c9302908f.png)\n\nA second solution $X$ lies in the $3$rd quadrant, and we can find it using the reference angle, as follows:\n\n$$\n\\begin{aligned}X & =\\pi +{\\theta }_{R} \\\\  & =\\pi +\\frac{\\pi }{6} \\\\  & =\\frac{7\\pi }{6}\\end{aligned}\n$$\n\nHowever, this value is not in the required domain. To get a second solution that's within the required domain, we simply subtract $2\\pi $ from $X:$\n\n$$\n\\begin{aligned}{x}_{2} & =X-2\\pi  \\\\  & =\\frac{7\\pi }{6}-2\\pi  \\\\  & =-\\frac{5\\pi }{6}\\end{aligned}\n$$\n\nSo, the solutions are $x=\\pm \\frac{5\\pi }{6}.$\n\nFinally,\n\n$$\n{x}_{1}{x}_{2}=\\frac{5\\pi }{6}\\cdot (-\\frac{5\\pi }{6})=-\\frac{25{\\pi }^{2}}{36}.\n$$"}] [{:db/id #edb/ref 17592186287987 :knowledge-point/_questions [{:db/id #edb/ref 17592186064179 :knowledge-point/id #uuid "e617f241-254b-5f70-9937-5883b6f28c4f" :knowledge-point/title "Integrating Secant-Tangent and Cosecant-Cotangent"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "16d4843e-1503-5b14-9ef4-6d9bd866b768" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "sec⁡\\theta +C" :db/id #edb/ref 17592186284994} {:answer/id #uuid "5f513476-ecb1-5481-9bb0-8cd729eba6f2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "csc⁡xcot⁡x+C" :db/id #edb/ref 17592186285660} {:answer/id #uuid "c159be5b-9ba9-50ec-90b5-6beba2ba516f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "csc⁡\\theta +C" :db/id #edb/ref 17592186286558} {:answer/id #uuid "dbdb10ca-14c4-5f21-a345-f92c3250e22c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-sec⁡\\theta +C" :db/id #edb/ref 17592186286788} {:answer/id #uuid "f5a909e4-a442-5f93-bb1c-8af5b5eeb86f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-csc⁡\\theta +C" :db/id #edb/ref 17592186287037}] :answer-field/correct {:answer/id #uuid "dbdb10ca-14c4-5f21-a345-f92c3250e22c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-sec⁡\\theta +C" :db/id #edb/ref 17592186286788} :answer-field/id #uuid "f5759735-03db-58c8-afc1-42a56314fd9a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186287647}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "8eefdd68-c49a-5b6b-9578-f46e438f3aac" :question/math-academy-id "q-2038" :question/problem "$\\int (-sec⁡\\theta tan⁡\\theta )\\text{d}\\theta =$" :question/worked-solution "Recall that\n\n$$\n\\int sec⁡\\theta tan⁡\\theta \\,\\text{d}\\theta =sec⁡\\theta +C.\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}\\begin{aligned}\\int (-sec⁡\\theta tan⁡\\theta )\\text{d}\\theta  & =-\\int sec⁡\\theta tan⁡\\theta \\,\\text{d}\\theta  \\\\  & =-(sec⁡\\theta )+C \\\\  & =-sec⁡\\theta +C.\\end{aligned}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186395776 :knowledge-point/_questions [{:db/id #edb/ref 17592186083240 :knowledge-point/id #uuid "8922ab07-5ac7-5f85-bfee-c30de7f4024a" :knowledge-point/title "Finding the Derivative of a Parametric Curve"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "05fd7882-e12b-5d1e-bda2-674211a5aad1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186395778} {:answer/id #uuid "61e0f80f-69b1-578c-857a-82bc0682835a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186395779} {:answer/id #uuid "26a77c96-4bef-5e82-8889-1c4a9ce7d523" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186395780} {:answer/id #uuid "9c9b090b-3cbc-511c-95ab-35fc8c1fc057" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186395781} {:answer/id #uuid "d1c50146-0d7c-501d-bf37-4d8d838c3cef" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186395782}] :answer-field/correct {:answer/id #uuid "9c9b090b-3cbc-511c-95ab-35fc8c1fc057" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186395781} :answer-field/id #uuid "56d7a736-a513-51fb-b585-d99caa2d0531" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186395777}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "45b1f64f-9248-57a2-a310-050eb4c80ee5" :question/math-academy-id "q-20849" :question/problem "![](images/c9/c9371d5e2bb921b4f5e58423bbce492f2b555122ee42bd861040b57d01070353.png)\n\nFor the parametric curve (shown above)\n\n$$\nx=2(t+1),\\,y=4{t}^{2},\\,-1\\le t<1,\n$$\n\n find the derivative $\\frac{dy}{dx}$ at the point $P$ on the curve where $t=0.$" :question/worked-solution "We will use the formula\n\n$$\n\\frac{dy}{dx}=\\frac{{y}^{′}(t)}{{x}^{′}(t)}.\n$$\n\nDifferentiating $x$ and $y,$ we get\n\n$$\n{x}^{′}(t)=2,\\,{y}^{′}(t)=8t.\n$$\n\n \n\nTherefore,\n\n$$\n\\frac{dy}{dx}=\\frac{8t}{2}=4t.\n$$\n\nAt the point where $t=0$ we have\n\n$$\n\\begin{aligned}\\frac{dy}{dx} & =4(0) \\\\  & =0\\,.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186401840 :knowledge-point/_questions [{:db/id #edb/ref 17592186083240 :knowledge-point/id #uuid "8922ab07-5ac7-5f85-bfee-c30de7f4024a" :knowledge-point/title "Finding the Derivative of a Parametric Curve"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1e5ec4eb-fb50-5d50-87c7-e15a073c23f5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "12" :db/id #edb/ref 17592186401842} {:answer/id #uuid "7b15bc55-e6d8-5c21-b55e-568e588591b8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "10" :db/id #edb/ref 17592186401843} {:answer/id #uuid "2c8c26cd-3204-5045-8920-160928c0068e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186401844} {:answer/id #uuid "7828179c-427e-5c33-a7ae-bd0edbe05cfe" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "15" :db/id #edb/ref 17592186401845} {:answer/id #uuid "db0ee922-0122-505b-abc7-21b2699ea220" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "7" :db/id #edb/ref 17592186401846}] :answer-field/correct {:answer/id #uuid "1e5ec4eb-fb50-5d50-87c7-e15a073c23f5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "12" :db/id #edb/ref 17592186401842} :answer-field/id #uuid "0ec6f4c2-cef2-5136-bda0-046075ea56a5" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186401841}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "a11f695c-004e-57f4-b1f5-cd09434f69e2" :question/math-academy-id "q-20851" :question/problem "For the parametric curve \n\n$$\nx=2\\sqrt{t},\\,y=12t+1,\\,0\\le t<\\infty ,\n$$\n\n find the derivative $\\frac{dy}{dx}$ at the point $P$ on the curve where $t=1.$" :question/worked-solution "We will use the formula\n\n$$\n\\frac{dy}{dx}=\\frac{{y}^{′}(t)}{{x}^{′}(t)}.\n$$\n\nDifferentiating $x$ and $y,$ we get\n\n$$\n{x}^{′}(t)=\\frac{1}{\\sqrt{t}},\\,{y}^{′}(t)=12.\n$$\n\n \n\nTherefore,\n\n$$\n\\frac{dy}{dx}=\\frac{12}{\\frac{1}{\\sqrt{t}}}=12\\sqrt{t}.\n$$\n\nAt the point where $t=1$ we have\n\n$$\n\\begin{aligned}\\frac{dy}{dx} & =12\\sqrt{1} \\\\  & =12\\,.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186390402 :knowledge-point/_questions [{:db/id #edb/ref 17592186105894 :knowledge-point/id #uuid "7d1252e9-f2ac-5adf-9cf5-ef48e35fb747" :knowledge-point/title "Determining the Image of an Object Formed by a Singular Transformation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "cd55c037-00e6-5219-914e-9a5a9bd7534e" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/e6/e667849ed8a214e7d17871b0f96f73f83c59eec2677bfbaeaab589e04cc89e61.png" :db/id #edb/ref 17592186390404} {:answer/id #uuid "f174cb91-e1ee-5d6c-90ef-6029cbaebf29" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/52/52266ff97300b29c85ac14f5b60b308d9e8a0e2fe3a01e8e0431b643e6a28922.png" :db/id #edb/ref 17592186390405} {:answer/id #uuid "071cdea1-0dac-5f25-b6f4-63481ba1e33c" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/1a/1a027e19617c0c62fd8f5247c6d1bbac894f9522ec9e90aec5b7ed05b3996b37.png" :db/id #edb/ref 17592186390406} {:answer/id #uuid "dd9aba44-7003-5d32-9bce-752796690c23" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/ca/cac3c2b4fb6191aa9a523b445d8533774f438d24556ea79b8e67a4d6c3867526.png" :db/id #edb/ref 17592186390407} {:answer/id #uuid "38ce622d-f9f2-50a8-99cd-404657278c3a" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/f7/f7033ca262624a9723186563638f5ff006d4174a82349be0812ac3de4c25af5e.png" :db/id #edb/ref 17592186390408}] :answer-field/correct {:answer/id #uuid "f174cb91-e1ee-5d6c-90ef-6029cbaebf29" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/52/52266ff97300b29c85ac14f5b60b308d9e8a0e2fe3a01e8e0431b643e6a28922.png" :db/id #edb/ref 17592186390405} :answer-field/id #uuid "8cfcca37-0c5f-5e1f-94b7-02dbf414d41e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186390403}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "f7e170ff-3ef3-51ef-bb76-d32ad791f4a6" :question/math-academy-id "q-21058" :question/problem "![](images/fe/fee79ec0b214a4ba87400b4b8c9dab2c623878d067821c572b26ae241625c48a.png)\n\nConsider the linear transformation $T$ with matrix representation $T,$ given by\n\n$$\nT=[\\begin{aligned}2 & 1 \\\\ 10 & 5\\end{aligned}].\n$$\n\nWhich of the following is the image of the triangle shown above under the action of $T?$" :question/worked-solution "To find the image of the triangle under the action of $T$, we first create a matrix $X$ containing all of the vertices of the triangle:\n\n$$\nX=[\\begin{aligned}1 & 1 & 2 \\\\ 0 & 1 & 1\\end{aligned}].\n$$\n\nNow, we compute the image of $X$ under the action of $T$ by calculating the matrix product $TX:$\n\n$$\n\\begin{aligned}TX & =[\\begin{aligned}2 & 1 \\\\ 10 & 5\\end{aligned}][\\begin{aligned}1 & 1 & 2 \\\\ 0 & 1 & 1\\end{aligned}] \\\\  & =[\\begin{aligned}2 & 3 & 5 \\\\ 10 & 15 & 25\\end{aligned}].\\end{aligned}\n$$\n\nTherefore, the coordinates of the image's vertices are $(2,10)$, $(3,15)$, and  $(5,25).$  Notice that all three points lie on the same line.\n\n![](images/bf/bf5987fde11416780a6a599e3952db7319e1c0e859e2439b7df70c5659bc6839.png)"}] [{:db/id #edb/ref 17592186290269 :knowledge-point/_questions [{:db/id #edb/ref 17592186105894 :knowledge-point/id #uuid "7d1252e9-f2ac-5adf-9cf5-ef48e35fb747" :knowledge-point/title "Determining the Image of an Object Formed by a Singular Transformation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0b93f461-1c7c-56fa-9e47-cf342c2182e3" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/40/40f352980b38be63b071b160953eff23a98996dce58c5f616e10958a8a70182e.png" :db/id #edb/ref 17592186288119} {:answer/id #uuid "6d878e48-5182-54e0-9a21-7580d9175240" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/ee/ee4a96b2b1106fbd1a5ec222c3f7f2a5e5a9e84c9bfe539aeb29a1918943aef9.png" :db/id #edb/ref 17592186288798} {:answer/id #uuid "84bcd4c8-95e4-5ba2-812e-8d15253507a6" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/dc/dc5ad781e838e597706600633701871006cd59fd3db60344cf34aaddb4200da8.png" :db/id #edb/ref 17592186288924} {:answer/id #uuid "bae133f8-955a-587b-8e5f-630c8d7aa03e" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/92/92beb71e7d09cba01f2eeb82a60ca3b0b3929064e4f16da3af104db8c5eaa8df.png" :db/id #edb/ref 17592186289265} {:answer/id #uuid "be768ba3-bb22-5082-9403-9396a068e5ec" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/b4/b4d2150d92ff14a654fb7079a17d7bd75abe721c0d37d4075d5a92635bafc170.png" :db/id #edb/ref 17592186289285}] :answer-field/correct {:answer/id #uuid "6d878e48-5182-54e0-9a21-7580d9175240" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/ee/ee4a96b2b1106fbd1a5ec222c3f7f2a5e5a9e84c9bfe539aeb29a1918943aef9.png" :db/id #edb/ref 17592186288798} :answer-field/id #uuid "9224408d-95cf-5c4a-a8cc-58f66c41fcd9" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186290058}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "dcfd5567-90cc-5d33-9aaa-36581e272ed2" :question/math-academy-id "q-21063" :question/problem "![](images/65/6501b1a7e9429c786905c11835410111c32ac0337f1ba63bff130d327350316c.png)\n\nConsider the linear transformation $T$ with matrix representation $T,$ given by\n\n$$\nT=[\\begin{aligned}2 & 4 \\\\ 1 & 2\\end{aligned}]\n$$\n\nWhich of the following is the image of the triangle shown above under the action of $T?$" :question/worked-solution "To find the image of the triangle under the action of $T$, we first create a matrix $X$ containing all of the vertices of the triangle:\n\n$$\nX=[\\begin{aligned}1 & 2 & 1 \\\\ 1 & 1 & 2\\end{aligned}].\n$$\n\nNow, we compute the image of $X$ under the action of $T$ by calculating the matrix product $TX:$\n\n$$\n\\begin{aligned}TX & =[\\begin{aligned}2 & 4 \\\\ 1 & 2\\end{aligned}][\\begin{aligned}1 & 2 & 1 \\\\ 1 & 1 & 2\\end{aligned}] \\\\  & =[\\begin{aligned}6 & 8 & 10 \\\\ 3 & 4 & 5\\end{aligned}].\\end{aligned}\n$$\n\nTherefore, the coordinates of the image's vertices are $(6,3)$, $(8,4)$ and $(10,5).$ Notice that all three points lie on the same line.\n\n![](images/a9/a91af151d3dc0e48aef0eef58012f6c9f72aaff02aafae2d55fe0714c29c96e3.png)"}] [{:db/id #edb/ref 17592186290287 :knowledge-point/_questions [{:db/id #edb/ref 17592186059670 :knowledge-point/id #uuid "e6eef35a-3502-5429-bd71-fb5bd0e8efc8" :knowledge-point/title "Identifying Extrema on Transformed Curves"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "01b3ee48-738d-5154-93f4-593da455f6f8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(4,6)" :db/id #edb/ref 17592186288038} {:answer/id #uuid "02202242-35fc-558e-b9c0-5e30f23f7048" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(4,0)" :db/id #edb/ref 17592186288042} {:answer/id #uuid "7017f50c-dcb4-516e-bbbc-55369bab2f30" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(1,0)" :db/id #edb/ref 17592186288810} {:answer/id #uuid "c4904f95-4b3c-5515-9fcf-0a99b245182b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(1,-3)" :db/id #edb/ref 17592186289330} {:answer/id #uuid "cbce72d8-a3b3-5305-909c-46fd579eba75" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(2,6)" :db/id #edb/ref 17592186289382}] :answer-field/correct {:answer/id #uuid "7017f50c-dcb4-516e-bbbc-55369bab2f30" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(1,0)" :db/id #edb/ref 17592186288810} :answer-field/id #uuid "09418823-c229-5178-abcd-3466929f3782" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186289745}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "c0430c7a-d01d-554d-86e5-a8ca9cccf773" :question/math-academy-id "q-211462" :question/problem "![](images/80/8000655c1943c60282d8844a2ae965b6415e21962c44309cd68806f04744b806.png)\n\nThe diagram above shows the global minimum and maximum of the function $y=f(x).$ What is the global maximum of $y=-f(2x)+3?$" :question/worked-solution "Notice that the graph of $y=-f(2x)+3$ can be obtained from the graph of $y=f(x)$ by \n\n- stretching it by a scale factor of $\\frac{1}{2}$ parallel to the $x$-axis,\n\n- flipping it across the $x$-axis, and finally\n\n- translating it by $3$ units up.\n\nSince one of these transformations flips the graph across the $x$-axis, the combined transformation maps the global **minimum** of $y=f(x)$ to the global **maximum** of $y=-f(2x)+3.$ So, we need to find the image of $(2,3),$ the global minimum of $y=f(x),$ under the transformation. \n\nTo plot $y=-f(2x)+3,$ we apply the following steps: \n\n- First, we take the graph $y=f(x)$ that passes through $(2,3).$\n\n- Then, we stretch the graph  along the $x$-axis by a scale factor of $\\frac{1}{2}$ and get the graph of $y=f(2x).$ After this transformation, the point $(2,3)$ will be mapped to the point\n\n$$\n(\\frac{1}{2}\\cdot 2,3)=(1,3).\n$$\n\n- Next, we flip the result across the $x$-axis and get the graph of $y=-f(2x).$ After this transformation, the point $(1,3)$ will be mapped to the point\n\n$$\n(1,-1\\cdot 3)=(1,-3).\n$$\n\n- Finally, we translate the result by $3$ units up and get the graph of $y=-f(2x)+3.$ After this transformation, the point $(1,-3)$ will be mapped to the point\n\n$$\n(1,-3+3)=(1,0).\n$$\n\nTherefore, the global maximum of $y=-f(2x)+3$ is $(1,0).$"}] [{:db/id #edb/ref 17592186290294 :knowledge-point/_questions [{:db/id #edb/ref 17592186105703 :knowledge-point/id #uuid "84c96375-27d5-5ada-a952-34e09b3e92bf" :knowledge-point/title "Perpendicular Vectors"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "05f5cec0-bb91-5c28-a043-4592ab711f53" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186288076} {:answer/id #uuid "5aa80b1b-8d9e-53e5-b4ff-3afd65b4f60b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-10" :db/id #edb/ref 17592186288664} {:answer/id #uuid "69174e17-b083-51ab-a263-552d37887450" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186288772} {:answer/id #uuid "7f12c795-1d8e-5fc7-8db2-9ce3db4be399" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-5" :db/id #edb/ref 17592186288894} {:answer/id #uuid "a9b8268e-e1e9-5fc0-968f-daa50516ca35" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186289158}] :answer-field/correct {:answer/id #uuid "5aa80b1b-8d9e-53e5-b4ff-3afd65b4f60b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-10" :db/id #edb/ref 17592186288664} :answer-field/id #uuid "9dafe033-6f62-51c0-aef0-ed6ade7a0953" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186290079}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "ff2e4ed3-b952-5f49-9d70-f52c7f12daca" :question/math-academy-id "q-212457" :question/problem "Let $a=⟨0,1,-5⟩$ and $b=⟨6,x,-2⟩.$ Given that the projection of $a$ onto $b$ is the zero vector, find the value of $x.$" :question/worked-solution "Since $a$ is a nonzero vector, its projection onto another nonzero vector $b$ equals the zero vector only when the vectors are perpendicular. \n\nSo, we must have\n\n$$\na⊥b\\,⟹\\,a\\cdot b=0.\n$$\n\nComputing the dot product, we obtain\n\n$$\n\\begin{aligned}a\\cdot b & ={a}_{x}\\cdot {b}_{x}+{a}_{y}\\cdot {b}_{y}+{a}_{z}\\cdot {b}_{z} \\\\  & =0\\cdot 6+1\\cdot x+(-5)\\cdot (-2) \\\\  & =x+10.\\end{aligned}\n$$\n\nSetting the dot product equal to $0,$ we get\n\n$$\n\\begin{aligned}a\\cdot b & =0 \\\\ x+10 & =0 \\\\ x & =-10.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186290323 :knowledge-point/_questions [{:db/id #edb/ref 17592186110599 :knowledge-point/id #uuid "29005c66-9f30-5862-926f-8a09320d404c" :knowledge-point/title "Determining Whether Two Lines in Slope-Intercept Form are Perpendicular"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2f2f9488-176e-5ee3-ad8e-2db95b1123f1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=x-2" :db/id #edb/ref 17592186288350} {:answer/id #uuid "3f03d5e0-e5b1-53b3-ab18-0d7e379a24cf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=-x+9" :db/id #edb/ref 17592186288461} {:answer/id #uuid "ccf2b0ef-9634-5c51-86e7-60eaa13bc504" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=2x+1" :db/id #edb/ref 17592186289396} {:answer/id #uuid "cea07821-893d-5fac-a3e9-4d99a591dc1f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=-2x+1" :db/id #edb/ref 17592186289410} {:answer/id #uuid "f789d1aa-f223-5771-a67e-fc052240756a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=x-\\frac{1}{2}" :db/id #edb/ref 17592186289662}] :answer-field/correct {:answer/id #uuid "3f03d5e0-e5b1-53b3-ab18-0d7e379a24cf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=-x+9" :db/id #edb/ref 17592186288461} :answer-field/id #uuid "aed86ac2-1482-5201-9d78-def088012c7d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186290116}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "da3fa1e4-9073-5723-b4d9-3e3d9f56d008" :question/math-academy-id "q-215890" :question/problem "Which of the following lines is perpendicular to $y=x+\\frac{1}{2}?$" :question/worked-solution "For the two lines to be perpendicular, their slopes must multiply to $-1.$\n\nThe line $y=x+\\frac{1}{2}$ is in slope-intercept form, and its slope is $1.$\n\nLooking at the answer choices, the line $y=-x+9$ has a slope of $-1.$\n\nMultiplying the slopes together, we have\n\n$$\n1\\cdot (-1)=-1.\n$$\n\nSince the slopes multiply to $-1,$ we conclude that the line $y=-x+9$ is perpendicular to the given line."}] [{:db/id #edb/ref 17592186290329 :knowledge-point/_questions [{:db/id #edb/ref 17592186096634 :knowledge-point/id #uuid "14370371-529b-5f25-9963-62c0cd9a172e" :knowledge-point/title "Solving a System Containing Fractions in One Equation Using Elimination"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "28be3240-f527-5881-b030-d0e2f6f588f7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "p=9,\\,q=10" :db/id #edb/ref 17592186288304} {:answer/id #uuid "2cd4f05d-ba10-5b34-a545-fb122617cedb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "p=5,\\,q=2" :db/id #edb/ref 17592186288324} {:answer/id #uuid "3c45f0cb-960d-58d2-8635-289e83d41c5b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "p=3,\\,q=9" :db/id #edb/ref 17592186288448} {:answer/id #uuid "4eeddfa0-2016-5856-83e5-03c446213f2b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "p=-3,\\,q=5" :db/id #edb/ref 17592186288578} {:answer/id #uuid "c538b0db-744e-5c84-a6a0-48a8617f619c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "p=3,\\,q=10" :db/id #edb/ref 17592186289338}] :answer-field/correct {:answer/id #uuid "c538b0db-744e-5c84-a6a0-48a8617f619c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "p=3,\\,q=10" :db/id #edb/ref 17592186289338} :answer-field/id #uuid "3459c60d-978a-5a3f-861a-110bccb1e94a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186289840}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "906fc64a-e7c8-5770-89dc-d9c9f6b082d4" :question/math-academy-id "q-216042" :question/problem "$$\n{\\begin{aligned}-3p+\\frac{4}{5}q=-1 \\\\ 9p-4q=-13\\end{aligned}\n$$\n\nFind the solution to the system of equations given above." :question/worked-solution "To get rid of the fractions in the first equation, we must multiply the first equation by the lowest common denominator of the fractions, which is $5.$\n\n$$\n{\\begin{aligned}-3p+\\frac{4}{5}q=-1 & |\\,\\times 5 \\\\ 9p-4q=-13\\end{aligned}\\,⟹\\,{\\begin{aligned}-15p+4q=-5 \\\\ 9p-4q=-13\\end{aligned}\n$$\n\nWe will use the elimination method to solve the system. Notice that the $4q$ term in the first equation can cancel with the $-4q$ term in the second equation.\n\nAdding the two equations eliminates the $q$-variable, and allows us to solve for $p:$\n\n$$\n\\begin{aligned}-15p+\\cancel{4q} & =-5 \\\\ 9p-\\cancel{4q} & =-13 \\\\ -6p & =-18 \\\\ p & =3\\end{aligned}\n$$\n\nFinally, we can substitute $p=3$ into the equation $9p-4q=-13$ to solve for $q:$\n\n$$\n\\begin{aligned}9p-4q & =-13 \\\\ 9\\cdot 3-4q & =-13 \\\\ 27-4q & =-13 \\\\ -4q & =-40 \\\\ q & =10\\end{aligned}\n$$\n\nTherefore, the solution to the system of equations is $p=3,\\,q=10.$"}] [{:db/id #edb/ref 17592186290336 :knowledge-point/_questions [{:db/id #edb/ref 17592186064178 :knowledge-point/id #uuid "0cae5c1b-57bd-51f6-a360-db946d25532f" :knowledge-point/title "Integrating Sine and Cosine"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "346358f5-312e-5c8a-9238-6be633b31e62" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-sin⁡x-cos⁡x+C" :db/id #edb/ref 17592186288379} {:answer/id #uuid "419bbacf-36c2-544f-888a-5bf28372bd28" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-sin⁡x+cos⁡x+C" :db/id #edb/ref 17592186288478} {:answer/id #uuid "70205983-7a23-51c1-a345-bf2ec479a0bf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2sin⁡x+C" :db/id #edb/ref 17592186288812} {:answer/id #uuid "ba4296e8-700e-5668-8c90-e562531a6962" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "sin⁡x+cos⁡x+C" :db/id #edb/ref 17592186289261} {:answer/id #uuid "c6a193d2-0ce7-5a28-86c4-834fae7f7271" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "sin⁡x-cos⁡x+C" :db/id #edb/ref 17592186289350}] :answer-field/correct {:answer/id #uuid "ba4296e8-700e-5668-8c90-e562531a6962" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "sin⁡x+cos⁡x+C" :db/id #edb/ref 17592186289261} :answer-field/id #uuid "0c59fbc8-d124-507b-af30-f117e1976ad1" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186289758}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "d70818e9-1705-53df-abe3-9e6e72f287c6" :question/math-academy-id "q-2161" :question/problem "$\\int (cos⁡x-sin⁡x)\\,\\text{d}x=$" :question/worked-solution "Recall that\n\n$$\n\\begin{aligned}\\int sin⁡x\\,\\text{d}x & =-cos⁡x+C, \\\\ \\int cos⁡x\\,\\text{d}x & =sin⁡x+C.\\end{aligned}\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}\\int (cos⁡x-sin⁡x)\\,\\text{d}x & =\\int cos⁡x\\,\\text{d}x-\\int sin⁡x\\,\\text{d}x \\\\  & =sin⁡x-(-cos⁡x)+C \\\\  & =sin⁡x+cos⁡x+C.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186290343 :knowledge-point/_questions [{:db/id #edb/ref 17592186171915 :knowledge-point/id #uuid "b8874325-af33-506b-b24d-3a3e387bd88c" :knowledge-point/title "Finding Roots of Unity With Certain Properties"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "791706c1-fc72-5123-9e31-3c7ce30854b8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{e}^{9\\pi \\text{i}/14}" :db/id #edb/ref 17592186288864} {:answer/id #uuid "9ce573f9-48e8-5ac3-aa97-939de73f0108" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{e}^{11\\pi \\text{i}/14}" :db/id #edb/ref 17592186289090} {:answer/id #uuid "a2fdc674-96ab-5ac8-a0ab-d0809b2008c1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{e}^{6\\pi \\text{i}/7}" :db/id #edb/ref 17592186289120} {:answer/id #uuid "e0df3657-bbfa-5488-8746-ee68814b11da" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{e}^{3\\pi \\text{i}/7}" :db/id #edb/ref 17592186289534} {:answer/id #uuid "f9884108-f3e3-5cb0-b016-a9030f916564" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{e}^{5\\pi \\text{i}/7}" :db/id #edb/ref 17592186289676}] :answer-field/correct {:answer/id #uuid "a2fdc674-96ab-5ac8-a0ab-d0809b2008c1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{e}^{6\\pi \\text{i}/7}" :db/id #edb/ref 17592186289120} :answer-field/id #uuid "c5eae31a-74ea-5e55-88a7-2b9c77bcd639" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186290157}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "87c48cd8-6b59-5b2c-8f86-b6fedd6aff90" :question/math-academy-id "q-216706" :question/problem "![](images/89/89d0606f11701cb59685e5ea1540b8ed98ce8cfe371951a675f01a1c6cc5a748.png)\n\nFind the $7$th root of unity highlighted in the diagram above." :question/worked-solution "The $n$th roots of unity lie at the vertices of a regular $n$-gon inscribed inside the unit circle in the complex plane. One of the vertices of this regular $n$-gon must lie at the point $(1,0).$\n\nFirst, we express the complex number $1$ in the form $r{e}^{\\text{i}\\theta }.$ Notice that $|1|=1$ and $\\operatorname{arg}⁡(1)=0.$ Hence, \n\n$$\n1={e}^{\\text{i}(0+2k\\pi )}={e}^{2k\\pi \\text{i}},\n$$\n\nwhere $k$ is an integer. So, we have\n\n$$\n\\begin{aligned}{z}^{7}={e}^{2k\\pi \\text{i}}\\,⟹\\,z=({e}^{2k\\pi \\text{i}})^{1/7}={e}^{2k\\pi \\text{i}/7}.\\end{aligned}\n$$\n\nTo find the index $k$ of our root of unity, we enumerate the roots in the diagram counter-clockwise, starting with the root at $(1,0)$ corresponding to $k=0,$ as shown below. \n\n![](images/34/344d760f2cd08e5e1e1eccc2664e7182d01744ee9b0b15f985c6d7b4e0e5515d.png)\n\n \n\nSo, the required root corresponds to $k=3.$ Substituting this into the expression for roots, we obtain the following:\n\n$$\n\\begin{aligned}{z}_{3}={e}^{2(3)\\pi \\text{i}/7}={e}^{6\\pi \\text{i}/7}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186290346 :knowledge-point/_questions [{:db/id #edb/ref 17592186171915 :knowledge-point/id #uuid "b8874325-af33-506b-b24d-3a3e387bd88c" :knowledge-point/title "Finding Roots of Unity With Certain Properties"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "019f383c-4240-5aa1-8167-9eeec6560832" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{e}^{4\\pi \\text{i}/3}" :db/id #edb/ref 17592186288036} {:answer/id #uuid "3089eabc-41b3-575d-9707-096e1189e460" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{e}^{7\\pi \\text{i}/6}" :db/id #edb/ref 17592186288352} {:answer/id #uuid "36b865dc-3f00-5c77-8e65-143b51a1cd23" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{e}^{16\\pi \\text{i}/9}" :db/id #edb/ref 17592186288398} {:answer/id #uuid "3907c5c9-15e2-5165-983c-58c43d4ca77d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{e}^{5\\pi \\text{i}/3}" :db/id #edb/ref 17592186288423} {:answer/id #uuid "a07a07da-8c7f-5d52-a274-e0fe0101c4e9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{e}^{11\\pi \\text{i}/6}" :db/id #edb/ref 17592186289102}] :answer-field/correct {:answer/id #uuid "3907c5c9-15e2-5165-983c-58c43d4ca77d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{e}^{5\\pi \\text{i}/3}" :db/id #edb/ref 17592186288423} :answer-field/id #uuid "7b8d3be4-ff98-5294-8a8c-5e871bca47da" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186290001}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "76a645d8-58db-587a-a38f-24be87eafa21" :question/math-academy-id "q-216710" :question/problem "![](images/b5/b575a8b3c4830aa48586b457b45f76ca8df49ecf8036df720f66aaddc857bdaf.png)\n\nFind the root of unity highlighted in the diagram above." :question/worked-solution "The $n$th roots of unity lie at the vertices of a regular $n$-gon inscribed inside the unit circle in the complex plane. One of the vertices of this regular $n$-gon must lie at the point $(1,0).$\n\nSince there are $6$ points in our diagram, we need to find a $6$th root of unity.\n\nFirst, we express the complex number $1$ in the form $r{e}^{\\text{i}\\theta }.$ Notice that $|1|=1$ and $\\operatorname{arg}⁡(1)=0.$ Hence, \n\n$$\n1={e}^{\\text{i}(0+2k\\pi )}={e}^{2k\\pi \\text{i}},\n$$\n\nwhere $k$ is an integer. So, we have\n\n$$\n\\begin{aligned}{z}^{6}={e}^{2k\\pi \\text{i}}\\,⟹\\,z=({e}^{2k\\pi \\text{i}})^{1/6}={e}^{k\\pi \\text{i}/3}.\\end{aligned}\n$$\n\nTo find the index $k$ of our root of unity, we enumerate the roots in the diagram counter-clockwise, starting with the root at $(1,0)$ corresponding to $k=0,$ as shown below. \n\n![](images/34/34a3bb77a9765cd806a047ad42a7f0719201effdd46659efe7ffd1a94a051910.png)\n\n \n\nSo, the required root corresponds to $k=5.$ Substituting this into the expression for roots, we obtain the following:\n\n$$\n\\begin{aligned}{z}_{5}={e}^{(5)\\pi \\text{i}/3}={e}^{5\\pi \\text{i}/3}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186069141 :knowledge-point/_questions [{:db/id #edb/ref 17592186068722 :knowledge-point/id #uuid "b89c50f3-2181-5b61-96cb-386ef88d2035" :knowledge-point/title "Integrating an Expression Involving a Power Function Multiplied by Its Derivative"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7d5927e7-3d1a-5589-9ab4-b01b479f66f5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2x({x}^{2}+1)^{13}}{13}+C" :db/id #edb/ref 17592186288882} {:answer/id #uuid "a65798db-1640-5ac0-9550-f0316b86d818" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{({x}^{2}+1)^{13}}{13}+C" :db/id #edb/ref 17592186289133} {:answer/id #uuid "a71c627c-e9b2-5a11-b21d-b190f3a77006" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{2x({x}^{2}+1)^{13}}{13}+C" :db/id #edb/ref 17592186289138} {:answer/id #uuid "d436ea16-40f5-50d5-8944-8947c0a63c89" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{2x({x}^{2}+1)^{12}}{12}+C" :db/id #edb/ref 17592186289436} {:answer/id #uuid "eb4463e3-17c4-52b2-809c-06d7c4b4e286" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{({x}^{2}+1)^{12}}{12}+C" :db/id #edb/ref 17592186289589}] :answer-field/correct {:answer/id #uuid "a65798db-1640-5ac0-9550-f0316b86d818" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{({x}^{2}+1)^{13}}{13}+C" :db/id #edb/ref 17592186289133} :answer-field/id #uuid "827ea8a6-3f45-58a9-acce-ef8eb4a48299" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186290018}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "c4b49482-74ae-5d27-81da-2160ac3cb246" :question/math-academy-id "q-2195" :question/problem "$\\int 2x({x}^{2}+1)^{12}\\,\\text{d}x=$" :question/worked-solution "We note that $2x$ is the derivative of the quantity in the parentheses. So we make a substitution\n\n$$\nu={x}^{2}+1.\n$$\n\nIts derivative is given by\n\n$$\n\\begin{aligned}\\frac{\\text{d}u}{\\text{d}x} & =2x\\,⟹\\,\\text{d}u=2x\\,\\text{d}x,\\end{aligned}\n$$\n\nand rewriting our integral, we get\n\n$$\n\\begin{aligned}\\int 2x({x}^{2}+1)^{12}\\,\\text{d}x & =\\int ({x}^{2}+1)^{12}\\,2x\\,\\text{d}x \\\\  & =\\int {u}^{12}\\,\\text{d}u.\\end{aligned}\n$$\n\nWe can now solve the integral using the power rule:\n\n$$\n\\int {u}^{12}\\,\\text{d}u=\\frac{{u}^{13}}{13}+C\n$$\n\nLastly, we substitute $u={x}^{2}+1$ back in the expression. So the final result is\n\n$$\n\\int 2x({x}^{2}+1)^{12}\\,\\text{d}x=\\frac{({x}^{2}+1)^{13}}{13}+C.\n$$"}] [{:db/id #edb/ref 17592186290369 :knowledge-point/_questions [{:db/id #edb/ref 17592186100869 :knowledge-point/id #uuid "b494140f-206a-5317-8079-ff719a253140" :knowledge-point/title "Determining Whether Two Matrices Are Conformable for Multiplication"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8292c378-f477-55da-80ea-56bd4135cf7f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186288910} {:answer/id #uuid "95fa9c35-2493-581e-bec2-06a09917fa48" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186289035} {:answer/id #uuid "afdc0aa9-1534-5121-892d-7fd982536645" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186289195} {:answer/id #uuid "eb3234b4-fa2a-5696-8475-0c7cca9ca765" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186289588} {:answer/id #uuid "f1e33c97-12ab-549d-88a5-9b6b03088a03" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186289630}] :answer-field/correct {:answer/id #uuid "95fa9c35-2493-581e-bec2-06a09917fa48" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186289035} :answer-field/id #uuid "e798780e-db3f-5004-a9f5-57c606c3d4b9" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186290218}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "7f63e1f3-652b-58b6-9207-73ea266277c9" :question/math-academy-id "q-22055" :question/problem "$$\nX=[\\begin{aligned}1 & 2 \\\\ 0 & 7\\end{aligned}],\\,Y=[\\begin{aligned}1 & 0 & -1 \\\\ -1 & 0 & 1\\end{aligned}],\\,Z=[\\begin{aligned}1 & 0 & -1 \\\\ -1 & 0 & 1 \\\\ 1 & 0 & 1\\end{aligned}]\n$$\n\nWhich of the following statements are true regarding the matrices $X,Y,$ and $Z?$\n\n- The product $XY$ is well defined\n- The product $YX$ is well defined\n- The product $YZ$ is well defined" :question/worked-solution "Notice that $X$ is a $2\\times 2$ matrix, $Y$ is a $2\\times 3$ matrix, and $Z$ is a $3\\times 3$ matrix.\n\nThere are $2$ columns in $X$ and $2$ rows in $Y.$ Since the number of columns in $X$ equals the number of rows in $Y,$ the matrices $X$ and $Y$ are conformable for multiplication:\n\n$$\n{X}_{2\\times \\boxed{\\text{2}}}{\\times }_{✓}{Y}_{\\boxed{\\text{2}}\\times 3}=\\text{well defined}\n$$\n\nOn the other hand, there are $3$ columns in $Y$ and $2$ rows in $X.$ Since the number of columns in $Y$ does **not** equal the number of rows in $X,$ the matrices $Y$ and $X$ are **not** conformable for multiplication:\n\n$$\n{Y}_{2\\times 3}{\\times }_{\\ne }{X}_{2\\times 2}=\\text{undefined}\n$$\n\nFinally, there are $3$ columns in $Y$ and $3$ rows in $Z.$ Since the number of columns in $Y$ equals the number of rows in $Z,$ the matrices $Y$ and $Z$ are conformable for multiplication:\n\n$$\n{Y}_{2\\times \\boxed{\\text{3}}}{\\times }_{✓}{Z}_{\\boxed{\\text{3}}\\times 3}=\\text{well defined}\n$$\n\nTherefore, statements I and III are true, while statement II is false."}] [{:db/id #edb/ref 17592186290437 :knowledge-point/_questions [{:db/id #edb/ref 17592186064177 :knowledge-point/id #uuid "980bb2fb-4bb5-5cbb-aea8-87010493c013" :knowledge-point/title "Integrating a Sum of Exponential Functions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "39f1030c-14e2-59e9-a189-ae72636d7cec" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2{e}^{x}+\\frac{{5}^{x}}{ln⁡2}+C" :db/id #edb/ref 17592186288429} {:answer/id #uuid "831fe1aa-d1a9-59de-914e-66c8e45135cf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5{e}^{x}+{2}^{x}ln⁡2+C" :db/id #edb/ref 17592186288914} {:answer/id #uuid "a92a1f84-319a-5ffc-912d-da344601d75d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{e}^{x}}{5}+\\frac{{2}^{x}}{ln⁡2}+C" :db/id #edb/ref 17592186289153} {:answer/id #uuid "bfec5a66-eb21-510f-ac20-724d2da23f30" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5{e}^{x}+\\frac{x}{ln⁡2}+C" :db/id #edb/ref 17592186289301} {:answer/id #uuid "f611671a-7317-5307-aefb-d9046cadfb32" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5{e}^{x}+\\frac{{2}^{x}}{ln⁡2}+C" :db/id #edb/ref 17592186289655}] :answer-field/correct {:answer/id #uuid "f611671a-7317-5307-aefb-d9046cadfb32" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5{e}^{x}+\\frac{{2}^{x}}{ln⁡2}+C" :db/id #edb/ref 17592186289655} :answer-field/id #uuid "6b01bf45-11e5-550e-91d5-6d78dcabad9c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186289964}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "e3b4a92d-a353-507a-becb-bee354a44152" :question/math-academy-id "q-2277" :question/problem "$\\int (5{e}^{x}+{2}^{x})\\,\\text{d}x=$" :question/worked-solution "Here, we combine the sum rule and our exponential rules to get\n\n$$\n\\begin{aligned}\\begin{aligned}\\int (5{e}^{x}+{2}^{x})\\,\\text{d}x & =5\\int {e}^{x}\\,\\text{d}x+\\int {2}^{x}\\,\\text{d}x \\\\  & =5{e}^{x}+\\frac{{2}^{x}}{ln⁡2}+C.\\end{aligned}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186290442 :knowledge-point/_questions [{:db/id #edb/ref 17592186054845 :knowledge-point/id #uuid "9bf25f86-6b27-5eaa-b1a1-1104478b290a" :knowledge-point/title "Finding the Derivative of a Function Given in Implicit Form"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1e268375-538a-538a-80bc-2f086cffdbb9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{6x}{1-\\operatorname{ln}⁡(2)\\,{2}^{y}}" :db/id #edb/ref 17592186288224} {:answer/id #uuid "793b6c32-8350-533d-bf9d-724d40064c5a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{2}^{y}}{6x-\\operatorname{ln}⁡2\\,}" :db/id #edb/ref 17592186288865} {:answer/id #uuid "a3589f85-19fc-5bd4-ac3b-96bf622c2422" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{6x}{\\operatorname{ln}⁡(2)\\,{2}^{y}}" :db/id #edb/ref 17592186289122} {:answer/id #uuid "e0d85bbf-5174-563d-a666-9a94bd4cf6fa" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{6x}{{2}^{y}}" :db/id #edb/ref 17592186289532} {:answer/id #uuid "e27c90f5-ce7c-52d7-8488-fe25083eb2d1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{6x}{1-{2}^{y}}" :db/id #edb/ref 17592186289540}] :answer-field/correct {:answer/id #uuid "1e268375-538a-538a-80bc-2f086cffdbb9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{6x}{1-\\operatorname{ln}⁡(2)\\,{2}^{y}}" :db/id #edb/ref 17592186288224} :answer-field/id #uuid "3f58fa9b-a3f6-53aa-a4c8-4680d5988ce9" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186289871}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "623f14ca-5670-5819-81c3-5ed253df18c6" :question/math-academy-id "q-2289" :question/problem "Given that  $y-{2}^{y}=3{x}^{2},$ calculate $\\frac{\\text{d}y}{\\text{d}x}.$" :question/worked-solution "First, we differentiate both sides of the equation with respect to $x,$ assuming that $y=y(x).$ \n\n$$\n\\begin{aligned}\\begin{aligned}y-{2}^{y} & =3{x}^{2} \\\\ \\frac{\\text{d}}{\\text{d}x}(y-{2}^{y}) & =\\frac{\\text{d}}{\\text{d}x}(3{x}^{2}) \\\\ \\frac{\\text{d}}{\\text{d}x}(y)-\\frac{\\text{d}}{\\text{d}x}({2}^{y}) & =6x \\\\ (1-\\operatorname{ln}⁡(2){2}^{y})(\\frac{\\text{d}y}{\\text{d}x}) & =6x\\end{aligned}\\end{aligned}\n$$\n\nNow we solve the equation for $\\frac{\\text{d}y}{\\text{d}x},$ as follows:\n\n$$\n\\begin{aligned}\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x}(1-\\operatorname{ln}⁡(2)\\,{2}^{y}) & =6x \\\\ \\frac{\\text{d}y}{\\text{d}x} & =\\frac{6x}{1-\\operatorname{ln}⁡(2)\\,{2}^{y}}\\end{aligned}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186290450 :knowledge-point/_questions [{:db/id #edb/ref 17592186129080 :knowledge-point/id #uuid "021e3349-c54d-55a8-9095-902bba933660" :knowledge-point/title "Applying the Pythagorean Theorem to the Unit Circle"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "041bb980-2220-5c0f-b904-f70291dc858b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=-\\frac{\\sqrt{29}}{12}" :db/id #edb/ref 17592186288059} {:answer/id #uuid "1bcd216a-5d96-580d-89a1-1300b816ea9c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=\\frac{\\sqrt{29}}{12}" :db/id #edb/ref 17592186288211} {:answer/id #uuid "6428772c-31cb-5d11-ad40-b384b65de264" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=-\\frac{\\sqrt{23}}{12}" :db/id #edb/ref 17592186288738} {:answer/id #uuid "a6ab4c14-8b8f-5d7f-941d-c5430187106a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=\\frac{\\sqrt{23}}{12}" :db/id #edb/ref 17592186289135} {:answer/id #uuid "b4335ae8-54ab-5f8c-98b6-6b1f10f60c80" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=-\\frac{7\\sqrt{33}}{12}" :db/id #edb/ref 17592186289224}] :answer-field/correct {:answer/id #uuid "6428772c-31cb-5d11-ad40-b384b65de264" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=-\\frac{\\sqrt{23}}{12}" :db/id #edb/ref 17592186288738} :answer-field/id #uuid "94cc4b6d-4396-5dd4-a8e0-bcf717fb1b6e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186290063}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "808fb241-7b41-5e43-96f3-08a62164f95c" :question/math-academy-id "q-23289" :question/problem "![](images/89/8904a5ebafade54a46cee77a2e20cac255c888d257ef1c208b2def32d247f2cd.png)\n\nThe point $P$ is located on the unit circle, as shown above. The $y$-coordinate of $P$ is $\\frac{11}{12}.$ What is the $x$-coordinate of $P?$" :question/worked-solution "Since the point $P$ lies on the unit circle, it must satisfy the Pythagorean theorem: \n\n$$\n{x}^{2}+{y}^{2}=1\n$$\n\nSubstituting $y=\\frac{11}{12}$ into the above and solving for $x$ gives\n\n$$\n\\begin{aligned}{x}^{2}+{y}^{2} & =1 \\\\ {x}^{2}+{(\\frac{11}{12})}^{2} & =1 \\\\ {x}^{2}+(\\frac{121}{144}) & =1 \\\\ {x}^{2} & =1-\\frac{121}{144} \\\\ {x}^{2} & =\\frac{23}{144} \\\\ x & =\\pm \\sqrt{\\frac{23}{144}} \\\\ x & =\\pm \\frac{\\sqrt{23}}{12}.\\end{aligned}\n$$\n\nFinally, we select the negative answer since $x$ is negative in the second quadrant. So our final answer is $x=-\\frac{\\sqrt{23}}{12}.$"}] [{:db/id #edb/ref 17592186088089 :knowledge-point/_questions [{:db/id #edb/ref 17592186087890 :knowledge-point/id #uuid "fe05aa67-e29e-5803-980c-e49ecb5db248" :knowledge-point/title "Calculating the Acceleration of a Particle at a Particular Moment Given Its Position"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0ff8525f-bdb5-59b7-9364-7f3238e455f1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "21\\,{\\text{m/s}}^{2}" :db/id #edb/ref 17592186288149} {:answer/id #uuid "1b1a00c6-778b-593d-99b5-702f58820750" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "14\\,{\\text{m/s}}^{2}" :db/id #edb/ref 17592186288203} {:answer/id #uuid "42931aef-7dc3-55d6-82f9-d903adc9adb0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "12\\,{\\text{m/s}}^{2}" :db/id #edb/ref 17592186288484} {:answer/id #uuid "4c581d2f-fca2-53f4-8e91-541c726d08fc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "18\\,{\\text{m/s}}^{2}" :db/id #edb/ref 17592186288560} {:answer/id #uuid "ff7bc305-8f2b-5684-a01c-e4bf62ba726c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "24\\,{\\text{m/s}}^{2}" :db/id #edb/ref 17592186289723}] :answer-field/correct {:answer/id #uuid "4c581d2f-fca2-53f4-8e91-541c726d08fc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "18\\,{\\text{m/s}}^{2}" :db/id #edb/ref 17592186288560} :answer-field/id #uuid "b56098b1-fb45-5f85-8ed3-7a8cab96d6c6" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186290127}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "e4551db6-cbed-5a0b-aa5c-4809ad316023" :question/math-academy-id "q-2351" :question/problem "The displacement (in meters) of a particle moving in a straight line is given by $s(t)=2{t}^{3}-3{t}^{2}+2t$, where $t$ is measured in seconds.  Find the particle's acceleration at $t=2$ seconds." :question/worked-solution "First, we calculate $v(t)$ by differentiating $s(t):$\n\n$$\n\\begin{aligned}v(t) & =\\frac{\\text{d}s}{\\text{d}t} \\\\  & =\\frac{\\text{d}}{\\text{d}t}(2{t}^{3}-3{t}^{2}+2t) \\\\  & =6{t}^{2}-6t+2\\end{aligned}\n$$\n\nNow, we differentiate $v(t)$ to find $a(t):$\n\n$$\n\\begin{aligned}a(t) & =\\frac{\\text{d}v}{\\text{d}t} \\\\  & =\\frac{\\text{d}}{\\text{d}t}(6{t}^{2}-6t+2) \\\\  & =12t-6\\end{aligned}\n$$\n\nTo calculate the acceleration at time $t=2$, we substitute this into the above:\n\n$$\n\\begin{aligned}a(2) & =12(2)-6 \\\\  & =24-6 \\\\  & =18\\,{\\text{m/s}}^{2}\\end{aligned}\n$$\n\nTherefore, the acceleration when $t=2$ seconds is $18\\,{\\text{m/s}}^{2}.$"}] [{:db/id #edb/ref 17592186290461 :knowledge-point/_questions [{:db/id #edb/ref 17592186059651 :knowledge-point/id #uuid "23637774-8d69-500d-8cb0-5e41a0207542" :knowledge-point/title "Simplifying Rational Expressions Using an Alternate Form of the Pythagorean Identity"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "277373e3-169a-586e-ad29-c1c31afaae90" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{cos}⁡\\theta +\\operatorname{sin}⁡\\theta " :db/id #edb/ref 17592186288292} {:answer/id #uuid "6a095a67-ddbe-5bf7-9a39-f8782eff2ea0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{sin}^{2}⁡\\theta " :db/id #edb/ref 17592186288780} {:answer/id #uuid "94d134d0-8d56-5307-b137-977c53f49ff7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{cot}⁡\\theta " :db/id #edb/ref 17592186289029} {:answer/id #uuid "ae3d194e-cae3-5d1d-9ecd-a175924b168f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{csc}⁡\\theta " :db/id #edb/ref 17592186289186} {:answer/id #uuid "cc7343e7-6e46-504c-b190-873fccc910a7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{sin}⁡\\theta " :db/id #edb/ref 17592186289392}] :answer-field/correct {:answer/id #uuid "cc7343e7-6e46-504c-b190-873fccc910a7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{sin}⁡\\theta " :db/id #edb/ref 17592186289392} :answer-field/id #uuid "78b2f4eb-6782-5d0a-9ec1-3e356d9f2e48" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186289993}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "d60ea30f-16e8-5e44-938b-3986249a44fc" :question/math-academy-id "q-23526" :question/problem "$\\frac{1-2{cos}^{2}⁡\\theta }{\\operatorname{sin}⁡\\theta }+\\frac{{cos}^{2}⁡\\theta }{\\operatorname{sin}⁡\\theta }=$" :question/worked-solution "Since both fractions are over a common denominator, we can add them. This gives\n\n$$\n\\begin{aligned}\\frac{1-2{cos}^{2}⁡\\theta }{\\operatorname{sin}⁡\\theta }+\\frac{{cos}^{2}⁡\\theta }{\\operatorname{sin}⁡\\theta } & =\\frac{1-2{cos}^{2}⁡\\theta +{cos}^{2}⁡\\theta }{\\operatorname{sin}⁡\\theta } \\\\  & =\\frac{1-{cos}^{2}⁡\\theta }{\\operatorname{sin}⁡\\theta }.\\end{aligned}\n$$\n\nThen, we use ${cos}^{2}⁡\\theta =1-{sin}^{2}⁡\\theta $ to simplify the expression in the numerator:\n\n$$\n\\begin{aligned}\\frac{1-{cos}^{2}⁡\\theta }{\\operatorname{sin}⁡\\theta } & =\\frac{{sin}^{2}⁡\\theta }{\\operatorname{sin}⁡\\theta } \\\\  & =\\operatorname{sin}⁡\\theta .\\end{aligned}\n$$\n\nTherefore, we conclude that\n\n$$\n\\frac{1-2{cos}^{2}⁡\\theta }{\\operatorname{sin}⁡\\theta }+\\frac{{cos}^{2}⁡\\theta }{\\operatorname{sin}⁡\\theta }=\\operatorname{sin}⁡\\theta .\n$$"}] [{:db/id #edb/ref 17592186110994 :knowledge-point/_questions [{:db/id #edb/ref 17592186110560 :knowledge-point/id #uuid "35fe6748-f040-5318-84e0-f3f76c9c7250" :knowledge-point/title "Simplifying an Expression Using the Cotangent-Cosecant Identity"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "108b997f-3ef8-51bd-8557-0ff04c25f1bd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{cos}^{2}⁡\\theta " :db/id #edb/ref 17592186288157} {:answer/id #uuid "7041b720-f438-5081-b848-05a44b0aed85" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{cos}⁡\\theta " :db/id #edb/ref 17592186288814} {:answer/id #uuid "78afce16-dd3c-5a3e-ac4b-6998edd1f35d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\operatorname{cos}⁡\\theta " :db/id #edb/ref 17592186288862} {:answer/id #uuid "f3b3fb44-66d6-5d64-93da-9ca291156c95" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\operatorname{cos}⁡\\theta " :db/id #edb/ref 17592186289642} {:answer/id #uuid "fb5e503b-835c-559e-adc2-29bda28d6008" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2\\operatorname{cos}⁡\\theta " :db/id #edb/ref 17592186289689}] :answer-field/correct {:answer/id #uuid "7041b720-f438-5081-b848-05a44b0aed85" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{cos}⁡\\theta " :db/id #edb/ref 17592186288814} :answer-field/id #uuid "5f020196-633d-58ab-b488-e011bb361efe" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186289936}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "e2a7de17-dd0e-54fa-9258-ee9fa753362a" :question/math-academy-id "q-23602" :question/problem "Simplify $\\frac{\\operatorname{csc}⁡\\theta \\cdot \\operatorname{cot}⁡\\theta }{1+{cot}^{2}⁡\\theta }.$" :question/worked-solution "Using the identity $1+{cot}^{2}⁡\\theta ={csc}^{2}⁡\\theta ,$ we rewrite and simplify the expression as follows:\n\n$$\n\\begin{aligned}\\frac{\\operatorname{csc}⁡\\theta \\cdot \\operatorname{cot}⁡\\theta }{1+{cot}^{2}⁡\\theta } & =\\frac{\\operatorname{csc}⁡\\theta \\cdot \\operatorname{cot}⁡\\theta }{{csc}^{2}⁡\\theta } \\\\  & =\\frac{1}{\\operatorname{csc}⁡\\theta }\\cdot \\operatorname{cot}⁡\\theta  \\\\  & =\\operatorname{sin}⁡\\theta \\cdot \\frac{\\operatorname{cos}⁡\\theta }{\\operatorname{sin}⁡\\theta } \\\\  & =\\operatorname{cos}⁡\\theta \\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186290466 :knowledge-point/_questions [{:db/id #edb/ref 17592186087889 :knowledge-point/id #uuid "e0cdcbc5-c10b-5dd1-af9a-410d2d44a4c5" :knowledge-point/title "Calculating the Acceleration of a Particle Given Its Velocity"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "03ce4bdc-93af-5a54-9a75-4348de1eca82" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3\\text{ m/s}" :db/id #edb/ref 17592186288056} {:answer/id #uuid "38003279-169b-5abe-bbd8-5dd8613c632b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1\\text{ m/s}" :db/id #edb/ref 17592186288412} {:answer/id #uuid "b5e5544f-7d20-58e7-8ae2-104f0dc53c75" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1\\text{ m/s}" :db/id #edb/ref 17592186289236} {:answer/id #uuid "c004da3d-3b21-5bf2-8b40-1a7f273f69dd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3\\text{ m/s}" :db/id #edb/ref 17592186289302} {:answer/id #uuid "c111a5f3-32b9-5d72-a5ee-cf9cbe58a3f3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\text{ m/s}" :db/id #edb/ref 17592186289309}] :answer-field/correct {:answer/id #uuid "b5e5544f-7d20-58e7-8ae2-104f0dc53c75" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1\\text{ m/s}" :db/id #edb/ref 17592186289236} :answer-field/id #uuid "a41fbea3-85aa-5b15-9e85-ef6d9ffbc9e8" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186290099}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "df553b92-e7eb-5bae-8500-5506ac0ebe3f" :question/math-academy-id "q-2361" :question/problem "The velocity $v$ (in $\\text{m/s}$) of a particle at time $t$ (in seconds) is given by $v(t)=4{t}^{2}-16t+15.$ Calculate the velocity of the particle when the acceleration $a$ is equal to $0\\,{\\text{m/s}}^{2}.$" :question/worked-solution "We differentiate $v(t)$ to calculate $a(t):$\n\n$$\n\\begin{aligned}a(t) & =\\frac{\\text{d}v}{\\text{d}t} \\\\  & =\\frac{\\text{d}}{\\text{d}t}(4{t}^{2}-16t+15) \\\\  & =8t-16\\end{aligned}\n$$\n\nTo calculate the time when the acceleration is $a=0,$ we substitute this into the above:\n\n$$\n\\begin{aligned}0 & =8t-16 \\\\ 8t & =16 \\\\ t & =2\\end{aligned}\n$$\n\nThen, to calculate the velocity at time $t=2,$ we substitute this into the equation for the velocity:\n\n$$\n\\begin{aligned}v(2) & =4(2)^{2}-16(2)+15 \\\\  & =16-32+15 \\\\  & =-1\\text{ m/s}\\end{aligned}\n$$\n\nTherefore, the velocity when $a=0\\,{\\text{m/s}}^{2}$ is $-1\\,\\text{m/s}.$"}] [{:db/id #edb/ref 17592186290468 :knowledge-point/_questions [{:db/id #edb/ref 17592186110600 :knowledge-point/id #uuid "e732f270-1d6f-5ff8-8792-d9b329ea858d" :knowledge-point/title "Determining Whether Two Lines in Standard Form are Perpendicular"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3b644ab2-4c21-5aeb-9032-26a79415192f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=-\\frac{1}{3}" :db/id #edb/ref 17592186288444} {:answer/id #uuid "540e1587-3f3e-52a8-8424-5abf66ff30e0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=-\\frac{1}{3}x" :db/id #edb/ref 17592186288610} {:answer/id #uuid "70b1df14-3de9-50cb-8b16-2a2eec5b3954" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=3x" :db/id #edb/ref 17592186288816} {:answer/id #uuid "959ae715-31b5-5f44-931c-f40632872d6e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=-3x+1" :db/id #edb/ref 17592186289030} {:answer/id #uuid "c2d44e35-06ab-5ae0-8bfd-256c7f07808a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=\\frac{1}{3}x-3" :db/id #edb/ref 17592186289319}] :answer-field/correct {:answer/id #uuid "70b1df14-3de9-50cb-8b16-2a2eec5b3954" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=3x" :db/id #edb/ref 17592186288816} :answer-field/id #uuid "990087b9-37dc-5d9d-b34d-123762544320" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186290071}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "d4eec6d2-1c29-5a4c-9b34-ea67f65dce06" :question/math-academy-id "q-23621" :question/problem "Which of the following lines is perpendicular to $x+3y=6?$" :question/worked-solution "For the two lines to be perpendicular, their slopes must multiply to $-1.$\n\nTo find the slope of the given line $x+3y=6,$ we convert to slope-intercept form:\n\n$$\n\\begin{aligned}x+3y & =6 \\\\ 3y & =-x+6 \\\\ y & =-\\frac{1}{3}x+2\\end{aligned}\n$$\n\nIn slope-intercept form, the slope is the $x$-coefficient. So, the slope of the given line is $-\\frac{1}{3}.$\n\nLooking at the answer choices, the line $y=3x$ has a slope of $3.$\n\nMultiplying the slopes together, we have\n\n$$\n(-\\frac{1}{3})\\cdot 3=-1.\n$$\n\nSince the slopes multiply to $-1,$ we conclude that the line $y=3x$ is perpendicular to the given line."}] [{:db/id #edb/ref 17592186290470 :knowledge-point/_questions [{:db/id #edb/ref 17592186175924 :knowledge-point/id #uuid "c52fd5dd-780e-5dab-805f-561383873dd4" :knowledge-point/title "Finding the Equation of a Line Perpendicular to a Line in Standard Form"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1b9cfaf6-9a1a-5e8a-ba94-ac0ace22d609" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3x-2y=-5" :db/id #edb/ref 17592186288209} {:answer/id #uuid "4b0ae802-61bf-59f5-8b33-d414ac86732a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x+y=0" :db/id #edb/ref 17592186288552} {:answer/id #uuid "5a9e515d-8988-5114-8e78-b9e0df04aced" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2x+3y=1" :db/id #edb/ref 17592186288663} {:answer/id #uuid "6463122b-ca6b-5780-a23a-d3c73e619707" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2x-3y=-5" :db/id #edb/ref 17592186288741} {:answer/id #uuid "9a46eb07-3565-5f66-8f29-3f6a3b2e30be" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3x+2y=-1" :db/id #edb/ref 17592186289064}] :answer-field/correct {:answer/id #uuid "9a46eb07-3565-5f66-8f29-3f6a3b2e30be" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3x+2y=-1" :db/id #edb/ref 17592186289064} :answer-field/id #uuid "ec350e8b-707f-561e-b0a8-e7f213d56fbc" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186290223}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "96f3c704-d5cd-55de-a550-62294d23b6d6" :question/math-academy-id "q-23631" :question/problem "Find the equation of the line containing the point $(-1,1)$ that is perpendicular to $2x-3y=-5.$" :question/worked-solution "First, we write the equation $2x-3y=-5$ in its slope-intercept form, as follows:\n\n$$\n\\begin{aligned}2x-3y & =-5 \\\\ -3y & =-2x-5 \\\\ y & =\\frac{2}{3}x+\\frac{5}{3}\\end{aligned}\n$$\n\nSince perpendicular lines have slopes that are negative reciprocals of each other, the slope of the new line should be the negative reciprocal of the slope of the given line $y=\\frac{2}{3}x+\\frac{5}{3}.$ The given line has a slope of $\\frac{2}{3},$ so our perpendicular line must have a slope of $-\\frac{3}{2}.$\n\nOur perpendicular line must have the slope $m=-\\frac{3}{2}$ and pass through the point $({x}_{1},{y}_{1})=(-1,1).$ Using point-slope form and simplifying, we obtain the equation of the line:\n\n$$\n\\begin{aligned}y-{y}_{1} & =m(x-{x}_{1}) \\\\ y-1 & =-\\frac{3}{2}(x-(-1)) \\\\ y-1 & =-\\frac{3}{2}(x+1) \\\\ y-1 & =-\\frac{3}{2}x-\\frac{3}{2} \\\\ y & =-\\frac{3}{2}x-\\frac{1}{2} \\\\ 2y & =-3x-1 \\\\ 3x+2y & =-1\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186290473 :knowledge-point/_questions [{:db/id #edb/ref 17592186110561 :knowledge-point/id #uuid "240a0a0b-fb86-5760-bb2b-74275708ff77" :knowledge-point/title "Simplifying an Expression Using the Alternate Forms of the Cotangent-Cosecant Identity"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0eb8834a-50b7-5416-880c-a8fd45d432bc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186288135} {:answer/id #uuid "13ea8bc8-393e-5910-9dfa-5a1ece3971a9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186288168} {:answer/id #uuid "526475f0-7a67-5902-ad09-03aaeaa90b76" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186288604} {:answer/id #uuid "69cdaa41-514c-59d8-8b47-dc49563092c2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186288778} {:answer/id #uuid "d3227cac-a33f-5639-a941-a9ded844e2ec" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186289430}] :answer-field/correct {:answer/id #uuid "13ea8bc8-393e-5910-9dfa-5a1ece3971a9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186288168} :answer-field/id #uuid "6d1ac430-1346-5392-97ab-d61f5c529673" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186289970}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "4adf28a2-e005-5bdd-b207-f7c30d8f8ad8" :question/math-academy-id "q-23642" :question/problem "Simplify ${csc}^{4}⁡\\theta -{cot}^{4}⁡\\theta -2{cot}^{2}⁡\\theta .$" :question/worked-solution "First, let's recall the following identity:\n\n$$\n{cot}^{2}⁡\\theta ={csc}^{2}⁡\\theta -1\n$$\n\nSubstituting the above identity into the given expression, we get\n\n$$\n\\begin{aligned}{csc}^{4}⁡\\theta -{cot}^{4}⁡\\theta -2{cot}^{2}⁡\\theta  & ={csc}^{4}⁡\\theta -{({cot}^{2}⁡\\theta )}^{2}-2{cot}^{2}⁡\\theta  \\\\  & ={csc}^{4}⁡\\theta -({csc}^{2}⁡\\theta -1)^{2}-2({csc}^{2}⁡\\theta -1) \\\\  & ={csc}^{4}⁡\\theta -({csc}^{4}⁡\\theta -2{csc}^{2}⁡\\theta +1)-2{csc}^{2}⁡\\theta +2 \\\\  & ={csc}^{4}⁡\\theta -{csc}^{4}⁡\\theta +2{csc}^{2}⁡\\theta -1-2{csc}^{2}⁡\\theta +2 \\\\  & =\\cancel{{csc}^{4}⁡\\theta }-\\cancel{{csc}^{4}⁡\\theta }+\\cancel{2{csc}^{2}⁡\\theta }-1-\\cancel{2{csc}^{2}⁡\\theta }+2 \\\\  & =1.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186290475 :knowledge-point/_questions [{:db/id #edb/ref 17592186129123 :knowledge-point/id #uuid "933b20c7-323f-5443-9cf4-97e87fa2c6fc" :knowledge-point/title "Finding the Midline of a Transformed Sinusoidal Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3b0d2e17-b1cc-53d6-a590-29ca48abe4d2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=-2" :db/id #edb/ref 17592186288441} {:answer/id #uuid "4a00572c-39f3-51f2-908d-92627f661500" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=-4" :db/id #edb/ref 17592186288544} {:answer/id #uuid "a37b2fb0-553a-530f-99ca-b90f84cdee3f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=-7" :db/id #edb/ref 17592186289123} {:answer/id #uuid "ab1273fc-bf67-57d2-a722-130587889698" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=3" :db/id #edb/ref 17592186289164} {:answer/id #uuid "f95f3f20-7128-592d-a073-380a9759c7df" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=0" :db/id #edb/ref 17592186289672}] :answer-field/correct {:answer/id #uuid "3b0d2e17-b1cc-53d6-a590-29ca48abe4d2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=-2" :db/id #edb/ref 17592186288441} :answer-field/id #uuid "246102b7-25b3-5a75-9c7c-581da5239b11" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186289815}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "250619d1-370b-5c0d-af5b-ed64a801198a" :question/math-academy-id "q-236893" :question/problem "Find the equation of the midline for a transformed sine function with a minimum value of $-7$ and a maximum value of $3.$" :question/worked-solution "A sinusoidal graph's midline (or vertical shift) is the horizontal line that divides it vertically in half. \n\nThe equation of the midline is given by\n\n$$\ny=\\frac{{y}_{\\text{min}}+{y}_{\\text{max}}}{2},\n$$\n\nwhere ${y}_{\\text{min}}$ and ${y}_{\\text{max}}$ are the minimum and maximum values of the function. The midline equals the average of the maximum and minimum values. \n\nIn our case, we have\n\n$$\n\\begin{aligned}\\frac{{y}_{\\text{min}}+{y}_{\\text{max}}}{2} & =\\frac{-7+3}{2} \\\\  & =\\frac{-4}{2} \\\\  & =-2.\\end{aligned}\n$$\n\nTherefore, the midline is $y=-2.$"}] [{:db/id #edb/ref 17592186129562 :knowledge-point/_questions [{:db/id #edb/ref 17592186129123 :knowledge-point/id #uuid "933b20c7-323f-5443-9cf4-97e87fa2c6fc" :knowledge-point/title "Finding the Midline of a Transformed Sinusoidal Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0ffe8c2d-22ae-5a74-9fb5-b44fdb8cce26" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=7" :db/id #edb/ref 17592186288150} {:answer/id #uuid "3f9156c5-37a7-56f3-b8d3-991ed27e42a2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=9" :db/id #edb/ref 17592186288465} {:answer/id #uuid "90eda464-9558-5e5e-b442-f50682de504d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=2" :db/id #edb/ref 17592186289005} {:answer/id #uuid "d650ff67-6889-5b78-bc90-d9ce4271c33c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=-4" :db/id #edb/ref 17592186289456} {:answer/id #uuid "d7360b5c-2ef2-52b6-a3be-6f516c9b4151" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=-5" :db/id #edb/ref 17592186289463}] :answer-field/correct {:answer/id #uuid "90eda464-9558-5e5e-b442-f50682de504d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=2" :db/id #edb/ref 17592186289005} :answer-field/id #uuid "b0fa4e38-53cb-50b5-ba34-1bae28b400d7" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186290121}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "723b13df-bde4-592d-ade7-17cdd1dad568" :question/math-academy-id "q-236896" :question/problem "Find the equation of the midline for a transformed cosine function with a minimum value of $-5$ and a maximum value of $9.$" :question/worked-solution "A sinusoidal graph's midline (or vertical shift) is the horizontal line that divides it vertically in half. \n\nThe equation of the midline is given by\n\n$$\ny=\\frac{{y}_{\\text{min}}+{y}_{\\text{max}}}{2},\n$$\n\nwhere ${y}_{\\text{min}}$ and ${y}_{\\text{max}}$ are the minimum and maximum values of the function. The midline equals the average of the maximum and minimum values. \n\nIn our case, we have\n\n$$\n\\begin{aligned}\\frac{{y}_{\\text{min}}+{y}_{\\text{max}}}{2} & =\\frac{-5+9}{2} \\\\  & =\\frac{4}{2} \\\\  & =2.\\end{aligned}\n$$\n\nTherefore, the midline is $y=2.$"}] [{:db/id #edb/ref 17592186290478 :knowledge-point/_questions [{:db/id #edb/ref 17592186203962 :knowledge-point/id #uuid "37ff20d1-fa3d-50aa-90d1-7bcb848ee460" :knowledge-point/title "Maxima of Transformed Sine or Cosine Functions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0a4385b2-cedb-5f97-84c3-917a017432a1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x={60}^{∘}+{180}^{∘}\\cdot n" :db/id #edb/ref 17592186288112} {:answer/id #uuid "1c9f0461-9e12-5816-9c05-6b4fa234ef57" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x={60}^{∘}+{120}^{∘}\\cdot n" :db/id #edb/ref 17592186288216} {:answer/id #uuid "58d0b77c-504d-574d-966c-005ac0e0d6f2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x={30}^{∘}+{120}^{∘}\\cdot n" :db/id #edb/ref 17592186288652} {:answer/id #uuid "5f9bb498-f6e5-5039-b259-d917d5660a03" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x={90}^{∘}+{120}^{∘}\\cdot n" :db/id #edb/ref 17592186288699} {:answer/id #uuid "f4bd4a4b-0690-5bdb-96fa-3576eebd5a61" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x={90}^{∘}+{360}^{∘}\\cdot n" :db/id #edb/ref 17592186289646}] :answer-field/correct {:answer/id #uuid "58d0b77c-504d-574d-966c-005ac0e0d6f2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x={30}^{∘}+{120}^{∘}\\cdot n" :db/id #edb/ref 17592186288652} :answer-field/id #uuid "057f72f3-32e2-5bf8-9e0a-6bb801c5adf3" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186289739}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "7caa2144-9fd2-5d73-bd9e-432e5c2fb4d1" :question/math-academy-id "q-236971" :question/problem "Consider the function $f(x)=\\frac{2}{3}\\operatorname{sin}⁡(3x).$ Which expression gives all of the values of $x$ at which $f(x)$ attains its maximum value? Assume that $n$ is an integer." :question/worked-solution "First, let's start by defining a new variable $X$ as\n\n$$\nX=3x.\n$$\n\nSo, we need to calculate $X$-values at the maxima of\n\n$$\ny=\\frac{2}{3}\\operatorname{sin}⁡X.\n$$\n\n \n\nThe $X$-values at the maxima are given by the following expression:\n\n$$\nX={90}^{∘}+{360}^{∘}\\cdot n\n$$\n\nwhere $n$ is an integer.\n\nTo find the $x$-values at the maxima of our original function, we rewrite $X$ in terms of the original variable $x$ and solve the resulting equation for $x:$\n\n$$\n\\begin{aligned}X & ={90}^{∘}+{360}^{∘}\\cdot n \\\\ 3x & ={90}^{∘}+{360}^{∘}\\cdot n \\\\ x & ={30}^{∘}+{120}^{∘}\\cdot n\\end{aligned}\n$$\n\nWe conclude that the values of $x$ that maximize $f(x)$ are given by $x={30}^{∘}+{120}^{∘}\\cdot n,$ where $n$ is an integer."}] [{:db/id #edb/ref 17592186290490 :knowledge-point/_questions [{:db/id #edb/ref 17592186105918 :knowledge-point/id #uuid "a51e317c-f6b3-5704-afb4-bdfc79f1176f" :knowledge-point/title "Projecting a Vector Onto a Perpendicular Vector"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2dc40103-4688-55dd-8d82-093d855eb2cf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-8" :db/id #edb/ref 17592186288339} {:answer/id #uuid "4be5c6a7-9473-5f8f-a76d-361e76618b03" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186288557} {:answer/id #uuid "969e8fda-7e9c-55a7-bced-44ceb4371dda" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186289039} {:answer/id #uuid "cbe15376-5215-5280-ae06-1a3991f84d01" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-6" :db/id #edb/ref 17592186289384} {:answer/id #uuid "eb4d7bb2-b033-5091-b1bf-ce3cd9d629f1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186289590}] :answer-field/correct {:answer/id #uuid "2dc40103-4688-55dd-8d82-093d855eb2cf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-8" :db/id #edb/ref 17592186288339} :answer-field/id #uuid "0bd2ffd0-af54-5576-8d75-4029636169bd" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186289757}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "23ed6766-8e64-5c6e-b8a5-b8f25dcf697a" :question/math-academy-id "q-237018" :question/problem "Let $a=5i-4j+3k$ and $b=-7i+xj+k.$ Given that the scalar projection of $a$ onto $b$ is zero, find the value of $x.$" :question/worked-solution "Since $a$ is a nonzero vector, its scalar projection onto another nonzero vector $b$ equals zero only when the vectors are perpendicular. \n\nSo, we must have\n\n$$\na⊥b\\,⟹\\,a\\cdot b=0.\n$$\n\nComputing the dot product, we obtain\n\n$$\n\\begin{aligned}a\\cdot b & ={a}_{x}\\cdot {b}_{x}+{a}_{y}\\cdot {b}_{y}+{a}_{z}\\cdot {b}_{z} \\\\  & =5\\cdot (-7)+(-4)\\cdot x+3\\cdot 1 \\\\  & =-4x-32.\\end{aligned}\n$$\n\nSetting the dot product equal to $0,$ we get\n\n$$\n\\begin{aligned}a\\cdot b & =0 \\\\ -4x-32 & =0 \\\\ 4x & =-32 \\\\ x & =-8.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186290491 :knowledge-point/_questions [{:db/id #edb/ref 17592186105918 :knowledge-point/id #uuid "a51e317c-f6b3-5704-afb4-bdfc79f1176f" :knowledge-point/title "Projecting a Vector Onto a Perpendicular Vector"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "341784da-b585-53fe-93fa-c3cbb0d2b032" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186288377} {:answer/id #uuid "8ca536b9-617f-5625-ad14-acd349960cf7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186288973} {:answer/id #uuid "ac275e68-b65e-502d-8d04-712cba1e1a03" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186289174} {:answer/id #uuid "bba33e30-0659-53ad-a553-8814871bb2ba" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186289270} {:answer/id #uuid "f03674f0-c895-5b67-901a-d1feb586a561" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186289620}] :answer-field/correct {:answer/id #uuid "341784da-b585-53fe-93fa-c3cbb0d2b032" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186288377} :answer-field/id #uuid "fff57b46-70ef-54bd-87fb-a12c9a20446e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186290256}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "8158669b-62f4-54f1-8025-20269eb7a332" :question/math-academy-id "q-237020" :question/problem "Let $p=⟨2,0,3⟩$ and $q=⟨3,0,x⟩.$ Given that the scalar projection of $p$ onto $q$ is zero, find the value of $x.$" :question/worked-solution "Since $p$ is a nonzero vector, its scalar projection onto another nonzero vector $q$ equals zero only when the vectors are perpendicular. \n\nSo, we must have\n\n$$\np⊥q\\,⟹\\,p\\cdot q=0.\n$$\n\nComputing the dot product, we obtain\n\n$$\n\\begin{aligned}p\\cdot q & ={p}_{x}\\cdot {q}_{x}+{p}_{y}\\cdot {q}_{y}+{p}_{z}\\cdot {q}_{z} \\\\  & =2\\cdot 3+0\\cdot 0+3\\cdot x \\\\  & =3x+6.\\end{aligned}\n$$\n\nSetting the dot product equal to $0,$ we get\n\n$$\n\\begin{aligned}p\\cdot q & =0 \\\\ 3x+6 & =0 \\\\ 3x & =-6 \\\\ x & =-2.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186290493 :knowledge-point/_questions [{:db/id #edb/ref 17592186105918 :knowledge-point/id #uuid "a51e317c-f6b3-5704-afb4-bdfc79f1176f" :knowledge-point/title "Projecting a Vector Onto a Perpendicular Vector"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "42c8fa6e-ec22-57a4-ace9-9ab79eb86dfc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186288485} {:answer/id #uuid "b84d2b62-4353-5f5a-a5c9-69ea117204f1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186289251} {:answer/id #uuid "d5049764-b1b5-5357-be51-767024d656d9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186289448} {:answer/id #uuid "dbf67f99-cbea-58b8-a183-8ed451369ef4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186289496} {:answer/id #uuid "dd4a724f-68fe-5924-b70a-bdc7366c3c49" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186289506}] :answer-field/correct {:answer/id #uuid "d5049764-b1b5-5357-be51-767024d656d9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186289448} :answer-field/id #uuid "1dc69ae9-136f-5a66-9a05-68c04a2bca60" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186289806}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "487960be-d7be-5dc4-ae5e-e966e5d0db00" :question/math-academy-id "q-237022" :question/problem "Let $p=⟨3,5,x⟩$ and $q=⟨-3,1,2⟩.$ Given that the scalar projection of $p$ onto $q$ is zero, find the value of $x.$" :question/worked-solution "Since $p$ is a nonzero vector, its scalar projection onto another nonzero vector $q$ equals zero only when the vectors are perpendicular. \n\nSo, we must have\n\n$$\np⊥q\\,⟹\\,p\\cdot q=0.\n$$\n\nComputing the dot product, we obtain\n\n$$\n\\begin{aligned}p\\cdot q & ={p}_{x}\\cdot {q}_{x}+{p}_{y}\\cdot {q}_{y}+{p}_{z}\\cdot {q}_{z} \\\\  & =3\\cdot (-3)+5\\cdot 1+x\\cdot 2 \\\\  & =2x-4.\\end{aligned}\n$$\n\nSetting the dot product equal to $0,$ we get\n\n$$\n\\begin{aligned}p\\cdot q & =0 \\\\ 2x-4 & =0 \\\\ 2x & =4 \\\\ x & =2.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186290507 :knowledge-point/_questions [{:db/id #edb/ref 17592186059651 :knowledge-point/id #uuid "23637774-8d69-500d-8cb0-5e41a0207542" :knowledge-point/title "Simplifying Rational Expressions Using an Alternate Form of the Pythagorean Identity"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "045ea7df-d48b-5101-9c0c-7774dc6805c2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186288062} {:answer/id #uuid "4d31c233-2e4c-57f7-9920-b65073d0d7ef" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186288566} {:answer/id #uuid "64c5cf3d-8049-5124-af6a-dce315f146c5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186288745} {:answer/id #uuid "7951f08c-4d89-5398-9695-a3e5c15037b4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{2}" :db/id #edb/ref 17592186288867} {:answer/id #uuid "d4ccec9a-d724-59c9-bf5f-e71a3038702e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186289445}] :answer-field/correct {:answer/id #uuid "64c5cf3d-8049-5124-af6a-dce315f146c5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186288745} :answer-field/id #uuid "008e8235-fe77-52a6-94f1-aa6a712b1be3" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186289730}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "a183fbf8-0afb-55d8-9c23-9f82dba8cb3e" :question/math-academy-id "q-23799" :question/problem "$\\frac{\\operatorname{tan}⁡\\theta -\\operatorname{tan}⁡\\theta {sin}^{2}⁡\\theta }{2\\operatorname{sin}⁡\\theta \\operatorname{cos}⁡\\theta }=$" :question/worked-solution "First, we factor the numerator:\n\n$$\n\\begin{aligned}\\frac{\\operatorname{tan}⁡\\theta -\\operatorname{tan}⁡\\theta {sin}^{2}⁡\\theta }{2\\operatorname{sin}⁡\\theta \\operatorname{cos}⁡\\theta } & =\\frac{\\operatorname{tan}⁡\\theta (1-{sin}^{2}⁡\\theta )}{2\\operatorname{sin}⁡\\theta \\operatorname{cos}⁡\\theta }\\end{aligned}\n$$\n\nNext, we rewrite the numerator using $1-{sin}^{2}⁡\\theta ={cos}^{2}⁡\\theta $ and simplify:\n\n$$\n\\begin{aligned}\\frac{\\operatorname{tan}⁡\\theta (1-{sin}^{2}⁡\\theta )}{2\\operatorname{sin}⁡\\theta \\operatorname{cos}⁡\\theta } & =\\frac{\\operatorname{tan}⁡\\theta {cos}^{2}⁡\\theta }{2\\operatorname{sin}⁡\\theta \\operatorname{cos}⁡\\theta } \\\\  & =\\frac{\\operatorname{tan}⁡\\theta \\operatorname{cos}⁡\\theta \\cancel{\\operatorname{cos}⁡\\theta }}{2\\operatorname{sin}⁡\\theta \\cancel{\\operatorname{cos}⁡\\theta }} \\\\  & =\\frac{\\operatorname{tan}⁡\\theta \\operatorname{cos}⁡\\theta }{2\\operatorname{sin}⁡\\theta } \\\\  & =\\operatorname{tan}⁡\\theta \\cdot \\frac{\\operatorname{cos}⁡\\theta }{2\\operatorname{sin}⁡\\theta }\\end{aligned}\n$$\n\nThen, we rewrite $\\operatorname{tan}⁡\\theta $ using its definition and simplify further:\n\n$$\n\\begin{aligned}\\operatorname{tan}⁡\\theta \\cdot \\frac{\\operatorname{cos}⁡\\theta }{2\\operatorname{sin}⁡\\theta } & =\\frac{\\operatorname{sin}⁡\\theta }{\\operatorname{cos}⁡\\theta }\\cdot \\frac{\\operatorname{cos}⁡\\theta }{2\\operatorname{sin}⁡\\theta } \\\\  & =\\frac{\\cancel{\\operatorname{sin}⁡\\theta }}{\\operatorname{cos}⁡\\theta }\\cdot \\frac{\\operatorname{cos}⁡\\theta }{2\\cancel{\\operatorname{sin}⁡\\theta }} \\\\  & =\\frac{1}{\\operatorname{cos}⁡\\theta }\\cdot \\frac{\\operatorname{cos}⁡\\theta }{2} \\\\  & =\\frac{1}{\\cancel{\\operatorname{cos}⁡\\theta }}\\cdot \\frac{\\cancel{\\operatorname{cos}⁡\\theta }}{2} \\\\  & =\\frac{1}{2}\\end{aligned}\n$$\n\nTherefore, we conclude that:\n\n$$\n\\frac{\\operatorname{tan}⁡\\theta -\\operatorname{tan}⁡\\theta {sin}^{2}⁡\\theta }{2\\operatorname{sin}⁡\\theta \\operatorname{cos}⁡\\theta }=\\frac{1}{2}\n$$"}] [{:db/id #edb/ref 17592186290511 :knowledge-point/_questions [{:db/id #edb/ref 17592186110561 :knowledge-point/id #uuid "240a0a0b-fb86-5760-bb2b-74275708ff77" :knowledge-point/title "Simplifying an Expression Using the Alternate Forms of the Cotangent-Cosecant Identity"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "074fdb0b-a308-592d-95a7-627490475229" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186288090} {:answer/id #uuid "5783022f-4924-5f6c-9cae-555095fa0e46" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186288640} {:answer/id #uuid "90b88db6-bab3-5a4c-99fa-584338a46a92" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186289002} {:answer/id #uuid "cf687924-3c7d-5b1e-a02e-efa81c08aab6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186289416} {:answer/id #uuid "db309d7c-29f6-5802-ae1d-a51c0aae9f9f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186289494}] :answer-field/correct {:answer/id #uuid "5783022f-4924-5f6c-9cae-555095fa0e46" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186288640} :answer-field/id #uuid "a1dd2961-41df-5267-b65a-47c8ee4b24c7" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186290090}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "0a349287-5d4c-537c-9bb0-00fd8c054f79" :question/math-academy-id "q-23849" :question/problem "Simplify $\\frac{{cot}^{2}⁡x}{{csc}^{2}⁡x}-1+{sin}^{2}⁡x$" :question/worked-solution "First, we operate the first two terms, as follows:\n\n$$\n\\begin{aligned}\\frac{{cot}^{2}⁡x}{{csc}^{2}⁡x}-1+{sin}^{2}⁡x & =\\frac{({cot}^{2}⁡x-{csc}^{2}⁡x)}{{csc}^{2}⁡x}+{sin}^{2}⁡x \\\\  & =\\frac{-({csc}^{2}⁡x-{cot}^{2}⁡x)}{{csc}^{2}⁡x}+{sin}^{2}⁡x\\end{aligned}\n$$\n\nNow, using the identity ${csc}^{2}⁡x-{cot}^{2}⁡x=1,$ we get\n\n$$\n\\begin{aligned}\\frac{-({csc}^{2}⁡x-{cot}^{2}⁡x)}{{csc}^{2}⁡x}+{sin}^{2}⁡x & =\\frac{-1}{{csc}^{2}⁡x}+{sin}^{2}⁡x \\\\  & =-{sin}^{2}⁡x+{sin}^{2}⁡x \\\\  & =0.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186290516 :knowledge-point/_questions [{:db/id #edb/ref 17592186110562 :knowledge-point/id #uuid "d012a04e-f802-5a26-b900-0801427073d8" :knowledge-point/title "Simplifying an Expression by Factoring and Using Various Forms of the Cotangent-Cosecant Identity"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b18c6a05-844b-5206-b3e5-0ce6326b0d24" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{csc}^{4}⁡\\theta " :db/id #edb/ref 17592186289206} {:answer/id #uuid "b436c6f7-d646-5b9f-aa11-5941dcdc990c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{csc}^{3}⁡x" :db/id #edb/ref 17592186289225} {:answer/id #uuid "d8589411-fbdf-5b50-9eba-de99e34580ba" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1+{csc}^{2}⁡\\theta " :db/id #edb/ref 17592186289474} {:answer/id #uuid "d86ac2a5-c6c6-5345-9657-3860d675b972" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{csc}^{2}⁡\\theta " :db/id #edb/ref 17592186289476} {:answer/id #uuid "fec95ded-39dc-5c20-9496-9dcb8bfbcf09" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{csc}⁡\\theta " :db/id #edb/ref 17592186289716}] :answer-field/correct {:answer/id #uuid "b18c6a05-844b-5206-b3e5-0ce6326b0d24" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{csc}^{4}⁡\\theta " :db/id #edb/ref 17592186289206} :answer-field/id #uuid "0b30197c-f6f6-5ce8-b1f2-2d38394819a6" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186289755}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "d2d6dd75-f063-5feb-ad58-0c61bba9a5c9" :question/math-academy-id "q-23897" :question/problem "Simplify $1+{cot}^{2}⁡\\theta +{cot}^{2}⁡\\theta \\,{csc}^{2}⁡\\theta .$" :question/worked-solution "First, we use the identity $1+{cot}^{2}⁡\\theta ={csc}^{2}⁡\\theta ,$ as follows:\n\n$$\n\\begin{aligned}1+{cot}^{2}⁡\\theta +{cot}^{2}⁡\\theta \\,{csc}^{2}⁡\\theta  & =[1+{cot}^{2}⁡\\theta ]+{cot}^{2}⁡\\theta \\,{csc}^{2}⁡\\theta  \\\\  & ={csc}^{2}⁡\\theta +{cot}^{2}⁡\\theta \\,{csc}^{2}⁡\\theta \\end{aligned}\n$$\n\nNow, we factor out ${csc}^{2}⁡\\theta ,$ and we use the identity $1+{cot}^{2}⁡\\theta ={csc}^{2}⁡\\theta $ again. This gives\n\n$$\n\\begin{aligned}{csc}^{2}⁡\\theta +{cot}^{2}⁡\\theta \\,{csc}^{2}⁡\\theta  & ={csc}^{2}⁡\\theta (1+{cot}^{2}⁡\\theta ) \\\\  & ={csc}^{2}⁡\\theta \\,({csc}^{2}⁡\\theta )\\, \\\\  & ={csc}^{4}⁡\\theta .\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186290517 :knowledge-point/_questions [{:db/id #edb/ref 17592186110562 :knowledge-point/id #uuid "d012a04e-f802-5a26-b900-0801427073d8" :knowledge-point/title "Simplifying an Expression by Factoring and Using Various Forms of the Cotangent-Cosecant Identity"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "26c11a98-a429-5f8c-9801-3e71352bfb47" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186288285} {:answer/id #uuid "3897ff35-e87a-5a29-9032-5e07bd0c4985" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186288419} {:answer/id #uuid "5d3ffb47-3276-5091-a415-fa8fec9ce38d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186288683} {:answer/id #uuid "d455067b-0dec-5c44-8118-9b5b1ff428e7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186289440} {:answer/id #uuid "f9aa2d21-a95b-5bbf-8025-7e8589c6fa4c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186289677}] :answer-field/correct {:answer/id #uuid "3897ff35-e87a-5a29-9032-5e07bd0c4985" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186288419} :answer-field/id #uuid "17bab95c-81ea-5471-ab78-f85af95d1be3" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186289787}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "2ce8a935-1da8-5328-91b9-35c9544cd048" :question/math-academy-id "q-23898" :question/problem "Simplify ${tan}^{2}⁡\\theta \\,{csc}^{2}⁡\\theta -\\frac{1}{{cot}^{2}⁡\\theta }.$" :question/worked-solution "First, we write the given expression as:\n\n$$\n\\begin{aligned}{tan}^{2}⁡\\theta \\,{csc}^{2}⁡\\theta -\\frac{1}{{cot}^{2}⁡\\theta } & ={tan}^{2}⁡\\theta \\,{csc}^{2}⁡\\theta -{tan}^{2}⁡\\theta \\end{aligned}\n$$\n\nNow, we factor out ${tan}^{2}⁡\\theta $ and use the identity \n${csc}^{2}⁡\\theta -1={cot}^{2}⁡\\theta .$\nThis gives\n\n$$\n\\begin{aligned}{tan}^{2}⁡\\theta \\,{csc}^{2}⁡\\theta -{tan}^{2}⁡\\theta  & ={tan}^{2}⁡\\theta \\,({csc}^{2}⁡\\theta -1) \\\\  & ={tan}^{2}⁡\\theta \\,{cot}^{2}⁡\\theta  \\\\  & ={tan}^{2}⁡\\theta \\cdot \\frac{1}{{tan}^{2}⁡\\theta } \\\\  & =1.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186290519 :knowledge-point/_questions [{:db/id #edb/ref 17592186096845 :knowledge-point/id #uuid "1c269944-636a-50f2-bfc9-c32a7b2e7ca3" :knowledge-point/title "Calculating a Derivative Using the Chain and Product Rules"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "38e395c8-f565-5740-959d-6bf0c34f8710" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{a}^{3x}({sec}^{2}⁡x+3\\operatorname{ln}⁡a\\operatorname{tan}⁡x)" :db/id #edb/ref 17592186288420} {:answer/id #uuid "47d8a58a-8445-5585-bc47-18b1d4683989" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{a}^{3x}({sec}^{2}⁡x+3\\operatorname{tan}⁡x)" :db/id #edb/ref 17592186288526} {:answer/id #uuid "60da0eec-e09f-556c-977c-0afa9bca8118" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{a}^{3x}{sec}^{2}⁡x+3\\operatorname{tan}⁡x" :db/id #edb/ref 17592186288710} {:answer/id #uuid "9efacfe8-4ef9-586f-935e-d85e18391332" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3{a}^{3x}({sec}^{2}⁡x+\\operatorname{ln}⁡a\\operatorname{tan}⁡x)" :db/id #edb/ref 17592186289098} {:answer/id #uuid "d7f42cff-705d-5052-8de2-d67ef0b14a77" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3{sec}^{2}⁡x+3{a}^{3x}\\operatorname{tan}⁡x" :db/id #edb/ref 17592186289468}] :answer-field/correct {:answer/id #uuid "38e395c8-f565-5740-959d-6bf0c34f8710" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{a}^{3x}({sec}^{2}⁡x+3\\operatorname{ln}⁡a\\operatorname{tan}⁡x)" :db/id #edb/ref 17592186288420} :answer-field/id #uuid "84733a66-1c91-5acb-9908-573c1e35d199" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186290021}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "d4cb91b7-6460-5845-ba44-f35610f01889" :question/math-academy-id "q-2392" :question/problem "Calculate $\\frac{\\text{d}y}{\\text{d}x}$ for $y={a}^{3x}\\operatorname{tan}⁡x.$" :question/worked-solution "This question requires the product rule. Let $u(x)=\\operatorname{tan}⁡x$ and $v(x)={a}^{3x}.$ Then\n\n$$\n{u}^{′}(x)={sec}^{2}⁡x,\\,{v}^{′}(x)=3{a}^{3x}\\operatorname{ln}⁡a.\n$$\n\nNote that we used the chain rule to differentiate $v.$\n\nNow, applying the product rule and simplifying, we have\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & ={u}^{′}(x)\\cdot v(x)+u(x)\\cdot {v}^{′}(x) \\\\  & =({sec}^{2}⁡x)({a}^{3x})+(\\operatorname{tan}⁡x)(3{a}^{3x}\\operatorname{ln}⁡a) \\\\  & ={a}^{3x}({sec}^{2}⁡x+3\\operatorname{ln}⁡a\\operatorname{tan}⁡x).\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186290522 :knowledge-point/_questions [{:db/id #edb/ref 17592186096844 :knowledge-point/id #uuid "261910cd-a1a4-5c90-8caa-238208558458" :knowledge-point/title "Calculating a Derivative Using the Chain and Quotient Rules"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "018421ea-dca9-5daf-ab3a-c27696ce4249" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{x-2\\sqrt{\\operatorname{ln}⁡x}}{4{x}^{2}\\operatorname{ln}⁡x}" :db/id #edb/ref 17592186288034} {:answer/id #uuid "1e02db35-b595-59ea-973e-bd157371128c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1-2\\operatorname{ln}⁡x}{\\sqrt{\\operatorname{ln}⁡x}}" :db/id #edb/ref 17592186288223} {:answer/id #uuid "5e5c0bc2-0072-5944-8dd3-fe8dcbae8938" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1+2\\sqrt{\\operatorname{ln}⁡x}}{2{x}^{2}\\sqrt{\\operatorname{ln}⁡x}}" :db/id #edb/ref 17592186288693} {:answer/id #uuid "ac81cfb0-7259-5f57-9adb-04296e897ae4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1-2\\operatorname{ln}⁡x}{4{x}^{2}\\sqrt{\\operatorname{ln}⁡x}}" :db/id #edb/ref 17592186289177} {:answer/id #uuid "cb7a7d1a-20e3-5bd6-9408-f184d8d4065a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\operatorname{ln}⁡x-2}{\\sqrt{\\operatorname{ln}⁡x}}" :db/id #edb/ref 17592186289380}] :answer-field/correct {:answer/id #uuid "ac81cfb0-7259-5f57-9adb-04296e897ae4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1-2\\operatorname{ln}⁡x}{4{x}^{2}\\sqrt{\\operatorname{ln}⁡x}}" :db/id #edb/ref 17592186289177} :answer-field/id #uuid "f45efbdd-39dd-5ca7-b621-baab9c7920f2" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186290238}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "c3d7d091-4a85-557a-b384-1cb4715f620a" :question/math-academy-id "q-2403" :question/problem "Find ${y}^{′}$ for $y=\\frac{\\sqrt{\\operatorname{ln}⁡x}}{2x}.$" :question/worked-solution "We use the quotient rule with the numerator $u(x)=\\sqrt{\\operatorname{ln}⁡x}$ and the denominator $v(x)=2x.$ \n\nDifferentiating $u(x)$ and $v(x),$ we have\n\n$$\n{u}^{′}(x)=\\frac{1}{2x\\sqrt{\\operatorname{ln}⁡x}},\\,{v}^{′}(x)=2.\n$$\n\nNote that we used the chain rule to differentiate $u.$\n\nNow, applying the quotient rule and simplifying, we have\n\n$$\n\\begin{aligned}\\begin{aligned}{y}^{′}=\\frac{\\text{d}y}{\\text{d}x} & =\\frac{{u}^{′}(x)\\cdot v(x)-u(x)\\cdot {v}^{′}(x)}{[v(x)]^{2}} \\\\  & =\\frac{(\\frac{1}{2x\\sqrt{\\operatorname{ln}⁡x}})(2x)-(\\sqrt{\\operatorname{ln}⁡x})(2)}{(2x)^{2}} \\\\  & =\\frac{\\frac{1}{\\sqrt{\\operatorname{ln}⁡x}}-2\\sqrt{\\operatorname{ln}⁡x}}{4{x}^{2}} \\\\  & =\\frac{1-2\\operatorname{ln}⁡x}{4{x}^{2}\\sqrt{\\operatorname{ln}⁡x}}.\\end{aligned}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186290543 :knowledge-point/_questions [{:db/id #edb/ref 17592186179789 :knowledge-point/id #uuid "2dc9469a-e2ca-55ba-b05a-b0be37384f9e" :knowledge-point/title "Finding Solutions of Exponential Equations Using the Natural Logarithm: Advanced Cases"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0dcd191d-3785-54a0-a639-e0094f61d3df" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\operatorname{ln}⁡(8)" :db/id #edb/ref 17592186288129} {:answer/id #uuid "6905831a-aab1-5aa6-90c9-108a514050cd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2\\operatorname{ln}⁡(3)+\\operatorname{ln}⁡(8)}{\\operatorname{ln}⁡(3)-\\operatorname{ln}⁡(8)}" :db/id #edb/ref 17592186288770} {:answer/id #uuid "78f720c7-027b-52c2-b6ef-5787c36db04a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2(\\operatorname{ln}⁡(3)+3\\operatorname{ln}⁡(8))}" :db/id #edb/ref 17592186288863} {:answer/id #uuid "978813b7-39da-53a5-9479-68b97e87dbf5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\operatorname{ln}⁡(8)}{2(\\operatorname{ln}⁡(3)+3\\operatorname{ln}⁡(8))}" :db/id #edb/ref 17592186289046} {:answer/id #uuid "9bb5517e-f727-547d-b85c-617c8b602edd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3\\operatorname{ln}⁡(3)+\\operatorname{ln}⁡(8)" :db/id #edb/ref 17592186289079}] :answer-field/correct {:answer/id #uuid "978813b7-39da-53a5-9479-68b97e87dbf5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\operatorname{ln}⁡(8)}{2(\\operatorname{ln}⁡(3)+3\\operatorname{ln}⁡(8))}" :db/id #edb/ref 17592186289046} :answer-field/id #uuid "5c40079c-8840-5be3-8c8b-803492714f39" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186289927}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "399f64e6-0f82-5ca3-861d-fbe99de11ba6" :question/math-academy-id "q-242923" :question/problem "Find the solution of ${3}^{2x}={8}^{1-6x}.$" :question/worked-solution "First, we take the natural logarithm $(ln)$ of both sides of the equation:\n\n$$\n\\begin{aligned}{3}^{2x} & ={8}^{1-6x} \\\\ \\operatorname{ln}⁡({3}^{2x}) & =\\operatorname{ln}⁡({8}^{1-6x})\\end{aligned}\n$$\n\nNow, we use the power law of logarithms to simplify both sides of the equation. This gives:\n\n$$\n\\begin{aligned}2x\\operatorname{ln}⁡(3) & =(1-6x)\\operatorname{ln}⁡(8)\\end{aligned}\n$$\n\nFinally, we solve for $x$, as follows:\n\n$$\n\\begin{aligned}2x\\operatorname{ln}⁡(3) & =(1-6x)\\operatorname{ln}⁡(8) \\\\ 2x\\operatorname{ln}⁡(3) & =\\operatorname{ln}⁡(8)-6x\\operatorname{ln}⁡(8) \\\\ 2x\\operatorname{ln}⁡(3)+6x\\operatorname{ln}⁡(8) & =\\operatorname{ln}⁡(8) \\\\ 2x(\\operatorname{ln}⁡(3)+3\\operatorname{ln}⁡(8)) & =\\operatorname{ln}⁡(8) \\\\ x & =\\frac{\\operatorname{ln}⁡(8)}{2(\\operatorname{ln}⁡(3)+3\\operatorname{ln}⁡(8))}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186290546 :knowledge-point/_questions [{:db/id #edb/ref 17592186087670 :knowledge-point/id #uuid "12ff17ae-9319-5498-a5e0-1d49ddbef50a" :knowledge-point/title "Using Alternative Forms of Double-Angle Formula to Simplify Expressions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3c6c484f-0d4c-5059-abdc-0a5388322664" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{cos}⁡(\\frac{\\pi }{10})" :db/id #edb/ref 17592186288449} {:answer/id #uuid "905767c2-2f4f-53cd-a805-da5f17ade7e7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\operatorname{cos}⁡(\\frac{\\pi }{5})" :db/id #edb/ref 17592186288998} {:answer/id #uuid "a2d3b909-fd08-568d-a4fd-3a367cf58a52" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{cos}⁡(\\frac{2\\pi }{5})" :db/id #edb/ref 17592186289118} {:answer/id #uuid "b27cd6d7-da62-5d7b-84c9-e5730cb22b5c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{cos}⁡(\\frac{4\\pi }{5})" :db/id #edb/ref 17592186289211} {:answer/id #uuid "e1c5c2bc-0b3f-5d28-8a4b-51fdecf0f8b6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\operatorname{cos}⁡(\\frac{\\pi }{10})" :db/id #edb/ref 17592186289536}] :answer-field/correct {:answer/id #uuid "a2d3b909-fd08-568d-a4fd-3a367cf58a52" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{cos}⁡(\\frac{2\\pi }{5})" :db/id #edb/ref 17592186289118} :answer-field/id #uuid "f665bcbb-88dc-5ad6-8703-67a0c36bad75" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186290240}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "a509f6a5-78b4-503c-a592-ded49f6e4644" :question/math-academy-id "q-24341" :question/problem "Express $1-2{sin}^{2}⁡(\\frac{\\pi }{5})$ as a single trigonometric ratio." :question/worked-solution "First, let's recall the double-angle formula for cosine:\n\n$$\n1-2{sin}^{2}⁡x=\\operatorname{cos}⁡2x\n$$\n\nSubstituting $x=\\frac{\\pi }{5}$ into the above, we get\n\n$$\n\\begin{aligned}1-2{sin}^{2}⁡(\\frac{\\pi }{5}) & =\\operatorname{cos}⁡(2\\cdot \\frac{\\pi }{5}) \\\\  & =\\operatorname{cos}⁡(\\frac{2\\pi }{5}).\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186069177 :knowledge-point/_questions [{:db/id #edb/ref 17592186068751 :knowledge-point/id #uuid "5dff5b7c-544a-5fda-a175-51ce4723a135" :knowledge-point/title "Solving a \"Greater Than or Equal To\" Inequality Given the Graph of the Corresponding Parabola"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1383fd97-77d3-5ac2-be23-4b9d7dc8885a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x\\ge 3" :db/id #edb/ref 17592186288167} {:answer/id #uuid "362fcbae-cb89-5509-8424-b1ee7253363f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3\\le x\\le 2" :db/id #edb/ref 17592186288395} {:answer/id #uuid "46d5b3e6-49b1-5f02-8bd8-ebc685df8719" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$x\\le -2$ or $x\\ge 3$" :db/id #edb/ref 17592186288519} {:answer/id #uuid "4881613a-3587-5b83-92d1-c4557759480e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2\\le x\\le 3" :db/id #edb/ref 17592186288534} {:answer/id #uuid "570c0835-b65c-52fe-9f64-104b4ace6481" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x\\le -2" :db/id #edb/ref 17592186288635}] :answer-field/correct {:answer/id #uuid "1383fd97-77d3-5ac2-be23-4b9d7dc8885a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x\\ge 3" :db/id #edb/ref 17592186288167} :answer-field/id #uuid "7a561c7b-ae6b-533f-be16-6d5b7c106d68" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186289999}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "ffe39127-4650-5f93-972b-bb5efc38f550" :question/math-academy-id "q-24351" :question/problem "![](images/09/098189dc8e96b01cb045a198eef3f00ba2df6594fc14675cad81246fc2d25964.png)\n\nGiven the graph above, solve the inequality $(x+2)(x-3)\\ge 0.$" :question/worked-solution "Notice that our inequality\n\n$$\n(x+2)(x-3)\\ge 0\n$$\n\nis a \"*greater than or equal to*\" inequality. Therefore, we need to find the values of $x$ for which the parabola \n\n$$\ny=(x+2)(x-3)\n$$\n\nis *above* the $x$-axis or *touches* this axis. We mark these values of $x$ in blue in the diagram below.\n\n![](images/3e/3e80a6e08ccff87314e5081a08332f0de508f6db02446742d1c93416d41a4b3c.png)\n\nSo, the solution to the inequality is $x\\le -2$ or $x\\ge 3.$"}] [{:db/id #edb/ref 17592186290548 :knowledge-point/_questions [{:db/id #edb/ref 17592186078386 :knowledge-point/id #uuid "dff5ec0b-1456-5231-94e1-0fc5923d6672" :knowledge-point/title "Determining a Rate of Change for a Given Function at a Point"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5fe34d4f-b1fc-5ae0-9d55-04367e3e3a49" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$7$ pounds per year" :db/id #edb/ref 17592186288703} {:answer/id #uuid "8837d663-da3e-54d6-ad9e-b7fbd44fd2ac" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$5$ pounds per year" :db/id #edb/ref 17592186288950} {:answer/id #uuid "b1646ebc-8eb5-5ea1-9807-4559284424b2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$10$ pounds per year" :db/id #edb/ref 17592186289205} {:answer/id #uuid "bf59944a-828b-52d4-8152-acc3370d61a1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$4$ pounds per year" :db/id #edb/ref 17592186289294} {:answer/id #uuid "da9443d8-9b09-5781-bcc9-9bb6ff7ade2c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$15$ pounds per year" :db/id #edb/ref 17592186289489}] :answer-field/correct {:answer/id #uuid "b1646ebc-8eb5-5ea1-9807-4559284424b2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$10$ pounds per year" :db/id #edb/ref 17592186289205} :answer-field/id #uuid "4197b5aa-e931-53da-b252-0e4b8f548ea2" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186289879}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "89c5ed41-56cc-572f-ab21-6b6ef12532fd" :question/math-academy-id "q-2439" :question/problem "The weight $w,$ in pounds, of a baby gorilla $t$ years after birth can be modeled by the function $w(t)=4{t}^{3}-{t}^{2}+15.$ What is the instantaneous rate of change of his weight when $t=1$ year?" :question/worked-solution "The instantaneous rate of change of weight when $t=1$ year is equal to ${w}^{′}(1).$\n\nFirst, we take the derivative and get\n\n$$\n\\begin{aligned}{w}^{′}(t) & =\\frac{\\text{d}}{\\text{d}t}(4{t}^{3}-{t}^{2}+15) \\\\  & =12{t}^{2}-2t.\\end{aligned}\n$$\n\nNow, substituting $t=1,$ we get\n\n$$\n\\begin{aligned}{w}^{′}(1) & =12(1)^{2}-2(1) \\\\  & =12-2 \\\\  & =10.\\end{aligned}\n$$\n\nTherefore, the instantaneous rate change of the weight when $t=1$ year is $10$ pounds per year."}] [{:db/id #edb/ref 17592186290550 :knowledge-point/_questions [{:db/id #edb/ref 17592186087669 :knowledge-point/id #uuid "5ec37c5e-8a40-58a7-8af3-4457cd5da43f" :knowledge-point/title "Using the Double-Angle Formula to Simplify Expressions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "43eca4f5-7e71-5c4d-b3d7-7641c44eb318" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{cos}⁡(\\frac{\\pi }{5})" :db/id #edb/ref 17592186288495} {:answer/id #uuid "492ca887-fe22-579a-b5cb-0f29cfad327c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{cos}⁡(\\frac{6\\pi }{5})" :db/id #edb/ref 17592186288539} {:answer/id #uuid "93678e0d-634c-5d71-b943-62299e286df9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{cos}⁡(\\frac{3\\pi }{5})" :db/id #edb/ref 17592186289019} {:answer/id #uuid "c7df7cd8-b50b-55b6-b605-e2f558905842" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{cos}⁡(\\frac{2\\pi }{5})" :db/id #edb/ref 17592186289355} {:answer/id #uuid "c878a2ea-30a4-57ca-8bad-92bcefc1de12" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{cos}⁡(\\frac{4\\pi }{5})" :db/id #edb/ref 17592186289360}] :answer-field/correct {:answer/id #uuid "492ca887-fe22-579a-b5cb-0f29cfad327c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{cos}⁡(\\frac{6\\pi }{5})" :db/id #edb/ref 17592186288539} :answer-field/id #uuid "44b91e88-c247-552d-ac22-5e6fb9335e1a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186289882}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "ccbcdf42-d0d6-5ef1-b1a3-dd2467d078f8" :question/math-academy-id "q-24499" :question/problem "Express ${cos}^{2}⁡(\\frac{3\\pi }{5})-{sin}^{2}⁡(\\frac{3\\pi }{5})$ as a single trigonometric ratio." :question/worked-solution "First, let's recall the double-angle formula for cosine:\n\n$$\n{cos}^{2}⁡x-{sin}^{2}⁡x=\\operatorname{cos}⁡2x\n$$\n\nSubstituting $x=(\\frac{3\\pi }{5})$ into the above, we get\n\n$$\n\\begin{aligned}{cos}^{2}⁡(\\frac{3\\pi }{5})-{sin}^{2}⁡(\\frac{3\\pi }{5}) & =\\operatorname{cos}⁡(2\\cdot \\frac{3\\pi }{5}) \\\\  & =\\operatorname{cos}⁡(\\frac{6\\pi }{5}).\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186088096 :knowledge-point/_questions [{:db/id #edb/ref 17592186087671 :knowledge-point/id #uuid "2902b205-4508-55c6-9a68-f57d3afc9eab" :knowledge-point/title "Finding Exact Values of Trigonometric Expressions Using the Double-Angle Formula"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0043b9dd-acd7-5722-ae3f-3f717ea8f717" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186288026} {:answer/id #uuid "0fcd1b2f-6684-5235-9ad9-1439089c5d1d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{2}" :db/id #edb/ref 17592186288147} {:answer/id #uuid "2e93b461-8b28-554d-a5d3-b0197fe38c18" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{\\sqrt{3}}{2}" :db/id #edb/ref 17592186288346} {:answer/id #uuid "38664848-58db-58e9-955b-e673ca767957" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\sqrt{3}" :db/id #edb/ref 17592186288415} {:answer/id #uuid "679b2481-2702-5446-9e64-41947ec19124" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{3}}{2}" :db/id #edb/ref 17592186288759}] :answer-field/correct {:answer/id #uuid "679b2481-2702-5446-9e64-41947ec19124" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{3}}{2}" :db/id #edb/ref 17592186288759} :answer-field/id #uuid "0e2b6c24-7b3b-5d04-808b-ab04891dc6ac" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186289763}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "baeab088-833a-54f7-96df-e4a2e1a80c83" :question/math-academy-id "q-24514" :question/problem "Find the exact value of ${cos}^{2}⁡(\\frac{\\pi }{12})-{sin}^{2}⁡(\\frac{\\pi }{12}).$" :question/worked-solution "First, let's recall the double-angle formula for cosine:\n\n$$\n{cos}^{2}⁡x-{sin}^{2}⁡x=\\operatorname{cos}⁡2x\n$$\n\nSubstituting $x=\\frac{\\pi }{12}$ into the above, we get\n\n$$\n\\begin{aligned}{cos}^{2}⁡(\\frac{\\pi }{12})-{sin}^{2}⁡(\\frac{\\pi }{12}) & =\\operatorname{cos}⁡(2\\cdot \\frac{\\pi }{12}) \\\\  & =\\operatorname{cos}⁡(\\frac{\\pi }{6}) \\\\  & =\\frac{\\sqrt{3}}{2}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186290558 :knowledge-point/_questions [{:db/id #edb/ref 17592186059673 :knowledge-point/id #uuid "5f9683d9-05b9-5a42-9f81-0170a15dfac1" :knowledge-point/title "Using the Double-Angle Formula to Simplify Ratios"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "062a3218-733e-525a-8b5d-331d7e8996a8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{cos}⁡{30}^{∘}-\\operatorname{sin}⁡{30}^{∘}" :db/id #edb/ref 17592186288081} {:answer/id #uuid "24557d4c-6a4a-5cd5-a7e3-e24950b0390f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{cos}⁡{30}^{∘}+\\operatorname{sin}⁡{60}^{∘}" :db/id #edb/ref 17592186288265} {:answer/id #uuid "2d84974c-0049-5521-a257-45ab79f50d17" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{cos}⁡{60}^{∘}\\operatorname{sin}⁡{60}^{∘}" :db/id #edb/ref 17592186288337} {:answer/id #uuid "d7ea36f8-fdb9-5210-9922-102972d65fd2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{cos}⁡{60}^{∘}\\operatorname{sin}⁡{30}^{∘}" :db/id #edb/ref 17592186289467} {:answer/id #uuid "f0888764-f8f2-5ce9-b665-20d788007d1c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{cos}⁡{30}^{∘}+\\operatorname{sin}⁡{30}^{∘}" :db/id #edb/ref 17592186289621}] :answer-field/correct {:answer/id #uuid "f0888764-f8f2-5ce9-b665-20d788007d1c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{cos}⁡{30}^{∘}+\\operatorname{sin}⁡{30}^{∘}" :db/id #edb/ref 17592186289621} :answer-field/id #uuid "b91ed20d-b388-5b5f-8238-6bf59161d259" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186290136}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "4eaa49cb-94d5-5c4a-8e77-4592aca20df1" :question/math-academy-id "q-24641" :question/problem "$\\frac{\\operatorname{sin}⁡{60}^{∘}\\operatorname{cot}⁡{30}^{∘}-1}{\\operatorname{cos}⁡{30}^{∘}-\\operatorname{sin}⁡{30}^{∘}}=$" :question/worked-solution "First, let's recall the double-angle formula for sine: \n\n$$\n\\operatorname{sin}⁡2x=2\\operatorname{sin}⁡x\\operatorname{cos}⁡x\n$$\n\nSubstituting $x={30}^{∘}$ into the above, we get\n\n$$\n\\begin{aligned}\\operatorname{sin}⁡(2\\cdot {30}^{∘}) & =2\\operatorname{sin}⁡{30}^{∘}\\operatorname{cos}⁡{30}^{∘} \\\\ \\operatorname{sin}⁡({60}^{∘}) & =2\\operatorname{sin}⁡{30}^{∘}\\operatorname{cos}⁡{30}^{∘}.\\end{aligned}\n$$\n\nNow, we can rewrite the given expression using the above, as follows:\n\n$$\n\\begin{aligned}\\frac{\\operatorname{sin}⁡{60}^{∘}\\operatorname{cot}⁡{30}^{∘}-1}{\\operatorname{cos}⁡{30}^{∘}-\\operatorname{sin}⁡{30}^{∘}} & =\\frac{2\\operatorname{sin}⁡{30}^{∘}\\operatorname{cos}⁡{30}^{∘}\\cdot \\frac{\\operatorname{cos}⁡{30}^{∘}}{\\operatorname{sin}⁡{30}^{∘}}-1}{\\operatorname{cos}⁡{30}^{∘}-\\operatorname{sin}⁡{30}^{∘}} \\\\  & =\\frac{2{cos}^{2}⁡{30}^{∘}-1}{\\operatorname{cos}⁡{30}^{∘}-\\operatorname{sin}⁡{30}^{∘}} \\\\  & =\\frac{{cos}^{2}⁡{30}^{∘}-1+{cos}^{2}⁡{30}^{∘}}{\\operatorname{cos}⁡{30}^{∘}-\\operatorname{sin}⁡{30}^{∘}} \\\\  & =\\frac{{cos}^{2}⁡{30}^{∘}-(1-{cos}^{2}⁡{30}^{∘})}{\\operatorname{cos}⁡{30}^{∘}-\\operatorname{sin}⁡{30}^{∘}}\\end{aligned}\n$$\n\nUsing  the Pythagorean identity in the form ${sin}^{2}⁡{30}^{∘}=1-{cos}^{2}⁡{30}^{∘},$ we get\n\n$$\n\\begin{aligned}\\frac{{cos}^{2}⁡{30}^{∘}-(1-{cos}^{2}⁡{30}^{∘})}{\\operatorname{cos}⁡{30}^{∘}-\\operatorname{sin}⁡{30}^{∘}} & =\\frac{{cos}^{2}⁡{30}^{∘}-{sin}^{2}⁡{30}^{∘}}{\\operatorname{cos}⁡{30}^{∘}-\\operatorname{sin}⁡{30}^{∘}} \\\\  & =\\frac{(\\operatorname{cos}⁡{30}^{∘}+\\operatorname{sin}⁡{30}^{∘})(\\operatorname{cos}⁡{30}^{∘}-\\operatorname{sin}⁡{30}^{∘})}{\\operatorname{cos}⁡{30}^{∘}-\\operatorname{sin}⁡{30}^{∘}} \\\\  & =\\frac{(\\operatorname{cos}⁡{30}^{∘}+\\operatorname{sin}⁡{30}^{∘})\\cancel{(\\operatorname{cos}⁡{30}^{∘}-\\operatorname{sin}⁡{30}^{∘})}}{\\cancel{\\operatorname{cos}⁡{30}^{∘}-\\operatorname{sin}⁡{30}^{∘}}} \\\\  & =\\operatorname{cos}⁡{30}^{∘}+\\operatorname{sin}⁡{30}^{∘}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186290559 :knowledge-point/_questions [{:db/id #edb/ref 17592186059672 :knowledge-point/id #uuid "d820aa9f-7c02-53b5-9b09-c25ee59dbdaf" :knowledge-point/title "Using the Double-Angle Formula Multiple Times"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "250cdf52-80dd-5fc2-af4b-70ef347a1cea" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{sin}⁡(\\frac{\\pi }{4})" :db/id #edb/ref 17592186288273} {:answer/id #uuid "3fd9b186-aadf-56c5-aa56-1a4655188af6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{sin}⁡(\\frac{\\pi }{2})" :db/id #edb/ref 17592186288467} {:answer/id #uuid "aa4e972a-a6ae-5ee9-939d-472e588fddcd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\operatorname{sin}⁡(\\frac{\\pi }{2})" :db/id #edb/ref 17592186289160} {:answer/id #uuid "dd44e3ed-170a-5c64-abc8-da906810e3b4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}\\operatorname{sin}⁡(\\frac{\\pi }{4})" :db/id #edb/ref 17592186289505} {:answer/id #uuid "e97836dd-63c8-53a9-9a9c-9ddec55ceab1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}\\operatorname{sin}⁡(\\frac{\\pi }{2})" :db/id #edb/ref 17592186289583}] :answer-field/correct {:answer/id #uuid "3fd9b186-aadf-56c5-aa56-1a4655188af6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{sin}⁡(\\frac{\\pi }{2})" :db/id #edb/ref 17592186288467} :answer-field/id #uuid "dd8d3d20-451b-5d5a-b8e5-ba16d376b2a2" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186290201}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "4270d786-b50e-5319-88f8-bca386712273" :question/math-academy-id "q-24645" :question/problem "$4\\operatorname{sin}⁡(\\frac{\\pi }{8})\\operatorname{cos}⁡(\\frac{\\pi }{8})\\operatorname{cos}⁡(\\frac{\\pi }{4})=$" :question/worked-solution "First, let's recall the double-angle formula for sine: \n\n$$\n2\\operatorname{sin}⁡x\\operatorname{cos}⁡x=\\operatorname{sin}⁡2x\n$$\n\nSubstituting $x=\\frac{\\pi }{8}$ into the above, we get\n\n$$\n2\\operatorname{sin}⁡(\\frac{\\pi }{8})\\operatorname{cos}⁡(\\frac{\\pi }{8})=\\operatorname{sin}⁡(2\\cdot \\frac{\\pi }{8})\n$$\n\nwhich simplifies as\n\n$$\n2\\operatorname{sin}⁡(\\frac{\\pi }{8})\\operatorname{cos}⁡(\\frac{\\pi }{8})=\\operatorname{sin}⁡(\\frac{\\pi }{4}).\n$$\n\nNow, we can rewrite the given expression using the above, as follows:\n\n$$\n\\begin{aligned}4\\operatorname{sin}⁡(\\frac{\\pi }{8})\\operatorname{cos}⁡(\\frac{\\pi }{8})\\operatorname{cos}⁡(\\frac{\\pi }{4}) & =2[2\\operatorname{sin}⁡(\\frac{\\pi }{8})\\operatorname{cos}⁡(\\frac{\\pi }{8})]\\operatorname{cos}⁡(\\frac{\\pi }{4}) \\\\  & =2\\operatorname{sin}⁡(\\frac{\\pi }{4})\\operatorname{cos}⁡(\\frac{\\pi }{4})\\end{aligned}\n$$\n\nNow, using the double-angle formula once more with $x=\\frac{\\pi }{4}$, we can further simplify the above expression: \n\n$$\n\\begin{aligned}4\\operatorname{sin}⁡(\\frac{\\pi }{8})\\operatorname{cos}⁡(\\frac{\\pi }{8})\\operatorname{cos}⁡(\\frac{\\pi }{4}) & =2\\operatorname{sin}⁡(\\frac{\\pi }{4})\\operatorname{cos}⁡(\\frac{\\pi }{4}) \\\\  & =\\operatorname{sin}⁡(2\\cdot \\frac{\\pi }{4}) \\\\  & =\\operatorname{sin}⁡(\\frac{\\pi }{2})\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186290560 :knowledge-point/_questions [{:db/id #edb/ref 17592186059671 :knowledge-point/id #uuid "143766e0-0ef5-5caf-b699-d394d4a707e9" :knowledge-point/title "Using the Double-Angle Formula to Simplify Products"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1c357368-fcee-57c4-bf91-a6420fe440cf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{sin}⁡(\\frac{\\pi }{3})" :db/id #edb/ref 17592186288213} {:answer/id #uuid "27f10174-6b5a-51a5-a3ff-b27f66395464" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4\\operatorname{sin}⁡(\\frac{\\pi }{6})" :db/id #edb/ref 17592186288298} {:answer/id #uuid "853e171a-cb9a-5680-8257-0e827c783b56" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4\\operatorname{sin}⁡(\\frac{\\pi }{3})" :db/id #edb/ref 17592186288930} {:answer/id #uuid "cc2b8d46-c755-5546-ae37-7ed12f4842f9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\operatorname{sin}⁡(\\frac{\\pi }{3})" :db/id #edb/ref 17592186289390} {:answer/id #uuid "e5710b37-6161-53d9-9349-b0d8e0d217e8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}\\operatorname{sin}⁡(\\frac{\\pi }{6})" :db/id #edb/ref 17592186289552}] :answer-field/correct {:answer/id #uuid "cc2b8d46-c755-5546-ae37-7ed12f4842f9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\operatorname{sin}⁡(\\frac{\\pi }{3})" :db/id #edb/ref 17592186289390} :answer-field/id #uuid "f984848b-f15f-5efc-b09a-0122e1e107ed" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186290247}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "feecaade-207a-51bf-96ee-61bce1de2e85" :question/math-academy-id "q-24647" :question/problem "Express $4\\operatorname{sin}⁡(\\frac{\\pi }{6})\\operatorname{cos}⁡(\\frac{\\pi }{6})$ as a single trigonometric ratio." :question/worked-solution "First, let's recall the double-angle formula for sine: \n\n$$\n2\\operatorname{sin}⁡x\\operatorname{cos}⁡x=\\operatorname{sin}⁡2x\n$$\n\nSubstituting $x=\\frac{\\pi }{6}$ into the above, we get\n\n$$\n2\\operatorname{sin}⁡(\\frac{\\pi }{6})\\operatorname{cos}⁡(\\frac{\\pi }{6})=\\operatorname{sin}⁡(2\\cdot \\frac{\\pi }{6})=\\operatorname{sin}⁡(\\frac{\\pi }{3}).\n$$\n\nTherefore,\n\n$$\n4\\operatorname{sin}⁡(\\frac{\\pi }{6})\\operatorname{cos}⁡(\\frac{\\pi }{6})=2\\cdot 2\\operatorname{sin}⁡(\\frac{\\pi }{6})\\operatorname{cos}⁡(\\frac{\\pi }{6})=2\\operatorname{sin}⁡(\\frac{\\pi }{3}).\n$$"}] [{:db/id #edb/ref 17592186290562 :knowledge-point/_questions [{:db/id #edb/ref 17592186059672 :knowledge-point/id #uuid "d820aa9f-7c02-53b5-9b09-c25ee59dbdaf" :knowledge-point/title "Using the Double-Angle Formula Multiple Times"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "21623035-5d3b-54b0-b966-85086e882ee3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186288244} {:answer/id #uuid "327ce358-2120-579c-a825-a49f79276978" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4\\operatorname{csc}⁡(\\frac{\\pi }{5})" :db/id #edb/ref 17592186288362} {:answer/id #uuid "462fdeb4-069c-543e-84f4-6256b0c7292e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4\\operatorname{sin}⁡(\\frac{2\\pi }{5})" :db/id #edb/ref 17592186288512} {:answer/id #uuid "4691cd9d-d70d-5609-bda6-07f12d1b3808" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186288515} {:answer/id #uuid "6381d420-eb79-5f12-aa11-1fa09a350b57" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\operatorname{sin}⁡(\\frac{4\\pi }{5})" :db/id #edb/ref 17592186288728}] :answer-field/correct {:answer/id #uuid "4691cd9d-d70d-5609-bda6-07f12d1b3808" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186288515} :answer-field/id #uuid "b3e9dae2-f4ee-56c2-b632-6441b7a7809a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186290123}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "f30309d1-f3e3-55ac-be8a-acbe0c0f980a" :question/math-academy-id "q-24650" :question/problem "$8\\,\\operatorname{sin}⁡(\\frac{\\pi }{5})\\operatorname{cos}⁡(\\frac{\\pi }{5})\\operatorname{csc}⁡(\\frac{2\\pi }{5})=$" :question/worked-solution "First, let's recall the double-angle formula for sine: \n\n$$\n2\\operatorname{sin}⁡x\\operatorname{cos}⁡x=\\operatorname{sin}⁡2x\n$$\n\nSubstituting $x=\\frac{\\pi }{5}$ into the above, we get\n\n$$\n2\\operatorname{sin}⁡(\\frac{\\pi }{5})\\operatorname{cos}⁡(\\frac{\\pi }{5})=\\operatorname{sin}⁡(2\\cdot \\frac{\\pi }{5})=\\operatorname{sin}⁡(\\frac{2\\pi }{5}).\n$$\n\nNow, we can rewrite the given expression using the above, as follows:\n\n$$\n\\begin{aligned}8\\,\\operatorname{sin}⁡(\\frac{\\pi }{5})\\operatorname{cos}⁡(\\frac{\\pi }{5})\\operatorname{csc}⁡(\\frac{2\\pi }{5}) & =4\\cdot [2\\operatorname{sin}⁡(\\frac{\\pi }{5})\\operatorname{cos}⁡(\\frac{\\pi }{5})]\\operatorname{csc}⁡(\\frac{2\\pi }{5}) \\\\  & =4\\operatorname{sin}⁡(\\frac{2\\pi }{5})\\cdot \\frac{1}{\\operatorname{sin}⁡(\\frac{2\\pi }{5})} \\\\  & =4\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186290579 :knowledge-point/_questions [{:db/id #edb/ref 17592186115400 :knowledge-point/id #uuid "905d1f6a-72aa-5984-8c7d-920497fd58e4" :knowledge-point/title "Differentiating Inverse Reciprocal Trigonometric Functions Using the Product Rule"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "111f643e-21fe-5850-a34c-7e75f866dffd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2x}{|x|\\sqrt{{x}^{2}-1}}" :db/id #edb/ref 17592186288160} {:answer/id #uuid "5476c042-8711-54ab-b3d4-eadca3ea72e5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2arccscx}{|x|\\sqrt{{x}^{2}-1}}" :db/id #edb/ref 17592186288614} {:answer/id #uuid "6427fa83-3424-5638-881a-1b75c59158ff" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2arcsecx}{|x|\\sqrt{{x}^{2}-1}}" :db/id #edb/ref 17592186288737} {:answer/id #uuid "8d34a562-2280-5df3-b021-0fc8376c8ba7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{arccscx-arcsecx}{|x|\\sqrt{{x}^{2}-1}}" :db/id #edb/ref 17592186288975} {:answer/id #uuid "f32241a6-5d82-568c-bcfd-3f92960cb105" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{arccscx+arcsecx}{|x|\\sqrt{{x}^{2}-1}}" :db/id #edb/ref 17592186289638}] :answer-field/correct {:answer/id #uuid "8d34a562-2280-5df3-b021-0fc8376c8ba7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{arccscx-arcsecx}{|x|\\sqrt{{x}^{2}-1}}" :db/id #edb/ref 17592186288975} :answer-field/id #uuid "352c605b-c2ce-576c-94c4-6d4a6fa3df72" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186289846}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "fabb0dc5-fadf-5950-bf52-26606893c541" :question/math-academy-id "q-2484" :question/problem "Find ${f}^{′}(x)$ for $f(x)=arccscx\\cdot arcsecx$" :question/worked-solution "The formulae for the derivatives of $arccsc$ and $arcsec$ are\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}(arccscx) & =-\\frac{1}{|x|\\sqrt{{x}^{2}-1}}, \\\\ \\frac{\\text{d}}{\\text{d}x}(arcsecx) & =\\frac{1}{|x|\\sqrt{{x}^{2}-1}}.\\end{aligned}\n$$\n\nUsing the product rule and the formulae above, we obtain\n\n$$\n\\begin{aligned}{f}^{′}(x) & =arcsecx\\cdot \\frac{\\text{d}}{\\text{d}x}(arccscx)+arccscx\\cdot \\frac{\\text{d}}{\\text{d}x}(arcsecx) \\\\  & =arcsecx\\cdot (-\\frac{1}{|x|\\sqrt{{x}^{2}-1}})+arccscx\\cdot (\\frac{1}{|x|\\sqrt{{x}^{2}-1}}) \\\\  & =-\\frac{arcsecx}{|x|\\sqrt{{x}^{2}-1}}+\\frac{arccscx}{|x|\\sqrt{{x}^{2}-1}} \\\\  & =\\frac{arccscx-arcsecx}{|x|\\sqrt{{x}^{2}-1}}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186060250 :knowledge-point/_questions [{:db/id #edb/ref 17592186059810 :knowledge-point/id #uuid "9e89b620-641a-5dbf-85f6-ca0f7a2fad80" :knowledge-point/title "Evaluating Arcsine or Arccosine"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "02f71a90-9f0c-57a8-8d03-9d9eeaccc52b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\pi }{6}" :db/id #edb/ref 17592186288051} {:answer/id #uuid "443aa495-57ed-5721-9745-6ff07a7e846d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\pi }{3}" :db/id #edb/ref 17592186288496} {:answer/id #uuid "81913624-dd8d-5e6e-a115-a31409962017" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5\\pi }{4}" :db/id #edb/ref 17592186288905} {:answer/id #uuid "8bd93056-9bf4-54d1-81ae-7be48a7ed21a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3\\pi }{4}" :db/id #edb/ref 17592186288965} {:answer/id #uuid "df916113-228a-55af-a94b-2a8acc6b6b99" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\pi }{4}" :db/id #edb/ref 17592186289523}] :answer-field/correct {:answer/id #uuid "8bd93056-9bf4-54d1-81ae-7be48a7ed21a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3\\pi }{4}" :db/id #edb/ref 17592186288965} :answer-field/id #uuid "574749d6-30f1-54d9-a75b-edfe46306402" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186289913}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "d044bebd-f049-585d-81d1-00fe08c3d294" :question/math-academy-id "q-24911" :question/problem "$\\operatorname{arccos}⁡(-\\frac{\\sqrt{2}}{2})=$" :question/worked-solution "The range of $\\theta =\\operatorname{arccos}⁡x$ is given by\n\n$$\n0\\le \\theta \\le \\pi .\n$$\n\nNote that the angle $\\theta $ spans the first and second quadrants.\n\nSince $-\\frac{\\sqrt{2}}{2}$ is negative, our answer is an angle that lies in the second quadrant, where cosine is negative.\n\n![](images/db/dbf36192ac332dc49ed75278838e989a37ac7d888311be1b8b059a7b59667aa6.png)\n\nFrom the values in the second quadrant, we see that\n\n$$\n\\operatorname{cos}⁡(\\frac{3\\pi }{4})=-\\frac{\\sqrt{2}}{2}.\n$$\n\nTherefore,\n\n$$\n\\operatorname{arccos}⁡(-\\frac{\\sqrt{2}}{2})=\\frac{3\\pi }{4}.\n$$"}] [{:db/id #edb/ref 17592186292541 :knowledge-point/_questions [{:db/id #edb/ref 17592186175924 :knowledge-point/id #uuid "c52fd5dd-780e-5dab-805f-561383873dd4" :knowledge-point/title "Finding the Equation of a Line Perpendicular to a Line in Standard Form"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "222e0bdd-c45c-5f9b-ae54-71cdb6646a9d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2x-y=2" :db/id #edb/ref 17592186290780} {:answer/id #uuid "93fc4b47-47c7-5ebf-9229-bb1de3d6fc45" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2x+5y=26" :db/id #edb/ref 17592186291272} {:answer/id #uuid "96366abc-617a-5664-be0a-124e181d78a4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2x+y=10" :db/id #edb/ref 17592186291284} {:answer/id #uuid "d0dd3655-249b-55c7-ad7e-aa78ebaf2966" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x+2y=11" :db/id #edb/ref 17592186291519} {:answer/id #uuid "d8c2f176-99d3-5c0e-91c7-0a77ab6cde83" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x+4y=19" :db/id #edb/ref 17592186291538}] :answer-field/correct {:answer/id #uuid "d0dd3655-249b-55c7-ad7e-aa78ebaf2966" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x+2y=11" :db/id #edb/ref 17592186291519} :answer-field/id #uuid "f929ad97-39dd-50e0-b2f2-34f577615f96" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186292514}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "9bf24f67-6184-5bd5-8b16-92247aa73ac4" :question/math-academy-id "q-252524" :question/problem "Find the equation of the line that passes through the point $(3,4)$ and is perpendicular to the line passing through the points $(2,2)$ and $(5,8).$" :question/worked-solution "Perpendicular lines have slopes, which are negative reciprocals of each other.\n\nFirst, let's find the slope ${m}_{1}$ of the line passing through the points $(2,2)$ and $(5,8):$\n\n$$\n\\begin{aligned}{m}_{1} & =\\frac{{y}_{2}-{y}_{1}}{{x}_{2}-{x}_{1}} \\\\  & =\\frac{8-2}{5-2} \\\\  & =\\frac{6}{3} \\\\  & =2\\end{aligned}\n$$\n\nSince we want a perpendicular line, the slope $m$ of the line we're trying to find must satisfy\n\n$$\nm\\cdot (2)=-1\\,⇒\\,m=-\\frac{1}{2}.\n$$\n\nWe know that the line passes through the point $(3,4).$ Using point-slope form and simplifying, we obtain the equation of the line:\n\n$$\n\\begin{aligned}y-{y}_{1} & =m(x-{x}_{1}) \\\\ y-4 & =-\\frac{1}{2}(x-3) \\\\ 2(y-4) & =-(x-3) \\\\ 2y-8 & =-x+3 \\\\ 2y & =-x+11 \\\\ y & =-\\frac{1}{2}x+\\frac{11}{2}\\end{aligned}\n$$\n\nHowever, we want to write the equation in standard form. So, we will bring the $x$ term to the left-hand side and multiply both sides of the equation by $2:$\n\n$$\n\\begin{aligned}y & =-\\frac{1}{2}x+\\frac{11}{2} \\\\ \\frac{1}{2}x+y & =\\frac{11}{2} \\\\ 2\\cdot (\\frac{1}{2}x+y) & =2\\cdot \\frac{11}{2} \\\\ x+2y & =11\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186292608 :knowledge-point/_questions [{:db/id #edb/ref 17592186129102 :knowledge-point/id #uuid "bd6703d2-36f6-5665-90e3-f75aea5f663b" :knowledge-point/title "Finding a General Expression for the Domain of a Transformed Tangent or Cotangent Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0247856b-a519-56dd-a2b1-a1b70c9b2dd7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x\\ne \\frac{\\pi }{6}+\\frac{n\\pi }{3}" :db/id #edb/ref 17592186290651} {:answer/id #uuid "6880d187-a9df-5074-bc5d-223d72e1916c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x\\ne \\frac{\\pi }{6}+\\frac{n\\pi }{2}" :db/id #edb/ref 17592186291077} {:answer/id #uuid "d2246bcc-e2cc-5d62-bed2-bbaf586f4fa8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x\\ne \\frac{\\pi }{8}+\\frac{n\\pi }{2}" :db/id #edb/ref 17592186291520} {:answer/id #uuid "de5d79b6-0b6d-56b2-b4b8-34d1931786d7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x\\ne \\frac{\\pi }{8}+n\\pi " :db/id #edb/ref 17592186291565} {:answer/id #uuid "e45c748f-05b7-55c6-9a75-1f27a3900067" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x\\ne \\frac{\\pi }{4}+\\frac{n\\pi }{2}" :db/id #edb/ref 17592186291587}] :answer-field/correct {:answer/id #uuid "e45c748f-05b7-55c6-9a75-1f27a3900067" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x\\ne \\frac{\\pi }{4}+\\frac{n\\pi }{2}" :db/id #edb/ref 17592186291587} :answer-field/id #uuid "7482ef83-edf6-558f-8523-f7d7648ec139" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186292094}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "6007df97-7592-55f0-9719-8190411bf59a" :question/math-academy-id "q-26063" :question/problem "What is the domain of the function $f(x)=\\operatorname{tan}⁡(2x)?$  Assume that $n$ is an integer." :question/worked-solution "The domain of $y=\\operatorname{tan}⁡x$ is given by\n\n$$\nx\\ne \\frac{\\pi }{2}+n\\pi ,\n$$\n\nwhere $n$ is an integer.\n\nTo find the domain of $\\operatorname{tan}⁡(2x),$ we replace the $x$ on the left-hand side of the above with $(2x).$ This gives\n\n$$\n2x\\ne \\frac{\\pi }{2}+n\\pi .\n$$\n\nSolving for $x,$ we get\n\n$$\n\\begin{aligned}2x & \\ne \\frac{\\pi }{2}+n\\pi  \\\\ x & \\ne \\frac{\\pi }{2\\cdot 2}+\\frac{n\\pi }{2} \\\\ x & \\ne \\frac{\\pi }{4}+\\frac{n\\pi }{2}.\\end{aligned}\n$$\n\nTherefore, the domain of the function is $x\\ne \\frac{\\pi }{4}+\\frac{n\\pi }{2},$ where $n$ is an integer."}] [{:db/id #edb/ref 17592186292609 :knowledge-point/_questions [{:db/id #edb/ref 17592186096636 :knowledge-point/id #uuid "90455606-1080-552e-a825-0cc7054b4be3" :knowledge-point/title "Solving a System Containing Fractions in One Equation Using Substitution"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "83f90f5e-a59d-5dbb-b7bc-2235614d11e5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=4,\\,y=4" :db/id #edb/ref 17592186291191} {:answer/id #uuid "88278ddc-f2aa-572e-bfa1-75529cee7a88" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=-4,\\,y=6" :db/id #edb/ref 17592186291213} {:answer/id #uuid "8b6b2395-ed33-5ae6-ab41-6b9f005b95ce" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=2,\\,y=2" :db/id #edb/ref 17592186291224} {:answer/id #uuid "a00f19d2-18a2-58fa-85b9-7734b7ab495a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=-3,\\,y=3" :db/id #edb/ref 17592186291328} {:answer/id #uuid "ae7b1a51-3e08-5e97-9ce6-48f66f412876" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=3,\\,y=-15" :db/id #edb/ref 17592186291389}] :answer-field/correct {:answer/id #uuid "a00f19d2-18a2-58fa-85b9-7734b7ab495a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=-3,\\,y=3" :db/id #edb/ref 17592186291328} :answer-field/id #uuid "64524a94-87ea-54e7-b6ab-78b313a3c370" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186292039}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "35a25c61-ba3b-5b21-8d90-ee3bc07b7267" :question/math-academy-id "q-26094" :question/problem "Find the solution to the following system of equations.\n\n$$\n{\\begin{aligned}\\frac{x}{6}+\\frac{5y}{6}-2=0 \\\\ 3x+y+6=0\\end{aligned}\n$$" :question/worked-solution "To get rid of the fractions in the first equation, we must multiply the first equation by the lowest common denominator of the fractions, which is $6.$\n\n$$\n{\\begin{aligned}\\frac{x}{6}+\\frac{5y}{6}-2=0 & |\\,\\times 6 \\\\ 3x+y+6=0\\end{aligned}\\,⟹\\,{\\begin{aligned}x+5y-12=0 \\\\ 3x+y+6=0\\end{aligned}\n$$\n\nWe will use the substitution method to solve the system. Notice that the second equation can easily be solved for $y:$\n\n$$\n\\begin{aligned}3x+y+6 & =0 \\\\ y & =-3x-6\\end{aligned}\n$$\n\nWe substitute $y=-3x-6$ into the first equation and then solve for $x:$\n\n$$\n\\begin{aligned}x+5y-12 & =0 \\\\ x+5(-3x-6)-12 & =0 \\\\ x-15x-30-12 & =0 \\\\ -14x-42 & =0 \\\\ -14x & =42 \\\\ x & =-3\\end{aligned}\n$$\n\nFinally, to find the value of $y,$ we substitute $x=-3$ into the equation $y=-3x-6$ as follows:\n\n$$\n\\begin{aligned}y & =-3x-6 \\\\  & =-3(-3)-6 \\\\  & =9-6 \\\\  & =3\\end{aligned}\n$$\n\nThus, the solution to the system of equations is $x=-3,\\,y=3.$"}] [{:db/id #edb/ref 17592186401908 :knowledge-point/_questions [{:db/id #edb/ref 17592186096785 :knowledge-point/id #uuid "cc62d8df-450f-5f7a-b647-b53c051f8339" :knowledge-point/title "Solving a System Containing Decimals in Both Equations"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c29c57bf-e265-52a1-bca7-e9f5dad2f3f4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$x=\\frac{4}{3},$ $y=-2$" :db/id #edb/ref 17592186401910} {:answer/id #uuid "211a2e7b-9745-58a0-94ae-5560db869797" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$x=1,$ $y=-3$" :db/id #edb/ref 17592186401911} {:answer/id #uuid "862aa3fb-5e83-5622-8209-8caba2d722df" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$x=\\frac{7}{3},$ $y=1$" :db/id #edb/ref 17592186401912} {:answer/id #uuid "30d0a7a2-ddd3-5355-ab33-3b6c7d057ae2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$x=2,$ $y=0$" :db/id #edb/ref 17592186401913} {:answer/id #uuid "0284c37f-87d7-5181-9665-5eb50a2bc860" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$x=\\frac{5}{3},$ $y=-1$" :db/id #edb/ref 17592186401914}] :answer-field/correct {:answer/id #uuid "0284c37f-87d7-5181-9665-5eb50a2bc860" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$x=\\frac{5}{3},$ $y=-1$" :db/id #edb/ref 17592186401914} :answer-field/id #uuid "e422abe5-7836-5aa6-bfb2-34896476a4d7" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186401909}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "3d7c59ff-df86-5863-a05a-c20fb84b2ead" :question/math-academy-id "q-26223" :question/problem "Solve the following system of equations:\n\n$$\n{\\begin{aligned}0.3x-0.1y=0.6 \\\\ 0.6x+0.8y=0.2\\end{aligned}\n$$" :question/worked-solution "To get rid of the decimals, we multiply both equations by $10,$ as follows:\n\n$$\n{\\begin{aligned}0.3x-0.1y=0.6 & |\\,\\times 10 \\\\ 0.6x+0.8y=0.2 & |\\,\\times 10\\end{aligned}\\,⟹\\,{\\begin{aligned}3x-y=6 \\\\ 6x+8y=2\\end{aligned}\n$$\n\nNotice that if we divide the second equation by $(-2),$ we will get a $-3x$ term in the second equation that can cancel with the $3x$ term in the first equation:\n\n$$\n{\\begin{aligned}3x-y=6 &  \\\\ 6x+8y=2 & |\\,÷(-2)\\end{aligned}\\,⟹\\,{\\begin{aligned}3x-y=6 \\\\ -3x-4y=-1\\end{aligned}\n$$\n\nAdding the two equations eliminates the $x$-variable and allows us to solve for $y:$\n\n$$\n\\begin{aligned}\\cancel{3x}-y & =6 \\\\ -\\cancel{3x}-4y & =-1 \\\\ (-y-4y) & =(6-1) \\\\ -5y & =5 \\\\ y & =-1\\end{aligned}\n$$\n\nFinally, we can substitute $y=-1$ into the equation $3x-y=6$ to solve for $x:$\n\n$$\n\\begin{aligned}3x-y & =6 \\\\ 3x-(-1) & =6 \\\\ 3x & =5 \\\\ x & =\\frac{5}{3}\\end{aligned}\n$$\n\nThus, the solution to the system of equations is $x=\\frac{5}{3}$ and $y=-1.$"}] [{:db/id #edb/ref 17592186292646 :knowledge-point/_questions [{:db/id #edb/ref 17592186179787 :knowledge-point/id #uuid "7e37891e-d24f-53cd-ba74-d887fa99aa3b" :knowledge-point/title "Finding Exact Solutions of Exponential Equations"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "47fe5df5-7916-5060-8fbe-5ad8b202e09b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{1+2\\operatorname{log}⁡(7)}" :db/id #edb/ref 17592186290928} {:answer/id #uuid "6566b744-0a39-5a79-adc4-eb963875b944" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{1-\\operatorname{log}⁡(7)}" :db/id #edb/ref 17592186291063} {:answer/id #uuid "84375010-b552-520c-9e30-6bce98e9d946" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1-\\operatorname{log}⁡(7)" :db/id #edb/ref 17592186291193} {:answer/id #uuid "a942eb9e-20af-5ce8-bcb0-edde94e6b8d5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{\\operatorname{log}⁡(7)}" :db/id #edb/ref 17592186291370} {:answer/id #uuid "da13d7a6-842f-5188-995b-f601e0fb9261" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{3}{\\operatorname{log}⁡(7)}" :db/id #edb/ref 17592186291544}] :answer-field/correct {:answer/id #uuid "6566b744-0a39-5a79-adc4-eb963875b944" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{1-\\operatorname{log}⁡(7)}" :db/id #edb/ref 17592186291063} :answer-field/id #uuid "480c9754-f2a3-545e-b087-84a9e0daed41" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186291963}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "3565dc73-156f-57ee-a4a3-9af19402d1e5" :question/math-academy-id "q-26385" :question/problem "Expressed in terms of common logarithms, what value of $x$ satisfies the equation ${10}^{x-3}={7}^{x}?$" :question/worked-solution "First, we take the common logarithm $(log)$ of both sides of the equation:\n\n$$\n\\begin{aligned}{10}^{x-3} & ={7}^{x} \\\\ \\operatorname{log}⁡({10}^{x-3}) & =\\operatorname{log}⁡({7}^{x})\\end{aligned}\n$$\n\nNow, we use the fact that ${log}_{b}⁡({b}^{c})=c$ to simplify the left-hand side. This gives:\n\n$$\n\\begin{aligned}x-3 & =\\operatorname{log}⁡({7}^{x})\\end{aligned}\n$$\n\nNext, we use the power law of logarithms to simplify the right-hand side:\n\n$$\n\\begin{aligned}x-3 & =x\\operatorname{log}⁡(7)\\end{aligned}\n$$\n\nFinally, we solve for $x,$ as follows:\n\n$$\n\\begin{aligned}x-x\\operatorname{log}⁡(7) & =3 \\\\ x(1-\\operatorname{log}⁡(7)) & =3 \\\\ x & =\\frac{3}{1-\\operatorname{log}⁡(7)}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186292672 :knowledge-point/_questions [{:db/id #edb/ref 17592186059668 :knowledge-point/id #uuid "0bd940e7-fccc-5811-b07a-11e4843b1785" :knowledge-point/title "Finding a Point That Lies on a Transformed Curve"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "33c00c15-b13b-5bcc-8be2-21e93f4c417e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(3,-2)" :db/id #edb/ref 17592186290839} {:answer/id #uuid "487a2755-1c9b-50dc-a9ef-825d319c08d1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-3,-2)" :db/id #edb/ref 17592186290930} {:answer/id #uuid "5a5b7f1c-6ca6-519d-9324-afd97504caa0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(3,2)" :db/id #edb/ref 17592186291021} {:answer/id #uuid "bfbeb462-5ad4-5751-9859-039c2c20e85a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-3,-3)" :db/id #edb/ref 17592186291457} {:answer/id #uuid "f4debbbb-a978-5aa2-807b-d09d5e6771d0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(3,-3)" :db/id #edb/ref 17592186291662}] :answer-field/correct {:answer/id #uuid "33c00c15-b13b-5bcc-8be2-21e93f4c417e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(3,-2)" :db/id #edb/ref 17592186290839} :answer-field/id #uuid "337977c2-17f5-5416-91d9-a9bbf15f1e4e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186291907}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "6eb852b1-3670-5b7e-89d9-1b29c405f01a" :question/math-academy-id "q-26594" :question/problem "The point  $(3,1)$ lies on the curve $y=f(x).$ Which of the following points **must** lie on $y=-f(x)-1?$" :question/worked-solution "**Method 1**\n\nTo plot $y=-f(x)-1,$ we apply the following steps: \n\n- First, we take the graph $y=f(x).$\n\n- Then, we reflect the graph across the $x$-axis and get the graph of $y=-f(x).$ After this transformation, the point $(3,1)$ will be mapped to the point\n\n$$\n(3,-(1))=(3,-1).\n$$\n\n- Finally, we shift the result vertically by $1$ unit down and obtain the graph of $y=-f(x)-1.$ After this transformation, the point $(3,-1)$ will be mapped to the point\n\n$$\n(3,-1-1)=(3,-2).\n$$\n\n**Method 2**\n\nSince the point $(3,1)$ lies on the graph of $y=f(x)$, we have that $f(3)=1.$\n\nNow consider the graph of $y=-f(x)-1.$ Substituting $x=3$, we get\n\n$$\n\\begin{aligned}y & =-f(3)-1 \\\\  & =-(1)-1 \\\\  & =-1-1 \\\\  & =-2.\\end{aligned}\n$$\n\nTherefore, the point $(3,-2)$ must lie on $y=-f(x)-1.$"}] [{:db/id #edb/ref 17592186292673 :knowledge-point/_questions [{:db/id #edb/ref 17592186059669 :knowledge-point/id #uuid "38b450bd-b43a-507c-9bbe-0aaf7a64a3ed" :knowledge-point/title "Finding a Point That Lies on a Transformed Curve Given Another Transformed Curve"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2f5bb3ff-2bf2-59a6-a9dc-028e36b29e5f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(3,0)" :db/id #edb/ref 17592186290821} {:answer/id #uuid "6a0dffee-d291-5706-b099-bf26056b0a79" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(3,4)" :db/id #edb/ref 17592186291085} {:answer/id #uuid "745f11b3-4abb-5778-b95c-05bfed92c9ad" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(3,2)" :db/id #edb/ref 17592186291130} {:answer/id #uuid "add1ba6b-56e1-507d-81c4-d7cc7dd66d71" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(3,-2)" :db/id #edb/ref 17592186291387} {:answer/id #uuid "f811fc7c-86fc-528d-a6a8-cba9ceee139f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-3,-2)" :db/id #edb/ref 17592186291677}] :answer-field/correct {:answer/id #uuid "add1ba6b-56e1-507d-81c4-d7cc7dd66d71" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(3,-2)" :db/id #edb/ref 17592186291387} :answer-field/id #uuid "e46bb93d-f096-5e20-be4c-e4f183d28feb" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186292449}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "4ee92c98-a45f-55db-8092-7db7c00e5a4e" :question/math-academy-id "q-26596" :question/problem "The point  $(3,2)$ lies on the curve $y=f(x)-2.$ Which of the following points **must** lie on $y=-f(x)+2?$" :question/worked-solution "**Method 1**\n\nWe first find a point corresponding to $(3,2)$ on $y=f(x).$ Then, we find a corresponding point on $y=-f(x)+2:$\n\n- To plot the graph of $y=f(x),$ we apply the following steps:\n\n- First, take the graph $y=f(x)-2.$\n\n- Then, we shift the graph vertically by $2$ units up and get the graph of $y=f(x).$ After this transformation, the point $(3,2)$ will be mapped to the point\n\n$$\n(3,2+2)=(3,4).\n$$\n\n- Next, to plot the graph of $y=-f(x)+2,$ we apply the following steps:\n\n- First, take the graph $y=f(x).$\n\n- Then, we reflect the result across the $x$-axis and get the graph of $y=-f(x).$ After this transformation, the point $(3,4)$ will be mapped  to the point\n\n$$\n(3,-(4))=(3,-4).\n$$\n\n- Next, we shift the result vertically by $2$ units up and obtain the graph of $y=-f(x)+2.$ After this transformation, the point $(3,-4)$ will be mapped to the point \n\n$$\n(3,-4+2)=(3,-2).\n$$\n\n**Method 2**\n\nSince the point $(3,2)$ lies on the graph of $y=f(x)-2$, we have that \n\n$$\nf(3)-2=2\\,⟹\\,f(3)=4.\n$$\n\nNow consider the graph of $y=-f(x)+2.$ Substituting $x=3$, we get\n\n$$\n\\begin{aligned}y & =-f(3)+2 \\\\  & =-4+2 \\\\  & =-2.\\end{aligned}\n$$\n\nTherefore, the point $(3,-2)$ must lie on $y=-f(x)+2.$"}] [{:db/id #edb/ref 17592186390514 :knowledge-point/_questions [{:db/id #edb/ref 17592186087821 :knowledge-point/id #uuid "dd63cb30-a236-546e-82ac-08bce09c88f7" :knowledge-point/title "Identifying a Vertically Shifted Exponential Growth Curve"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1db17739-2def-5e37-af22-164593bd5829" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/61/61cd6304483770e91658f37cd8ac3dbf57c58f25c9a631ab45a56cd706d381ee.png" :db/id #edb/ref 17592186390516} {:answer/id #uuid "9904a233-df69-591c-90af-01e22fb617bb" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/31/31f0d95293939e141e0ebff2aaad6223a9a82188e892441906ae09c530919b1d.png" :db/id #edb/ref 17592186390517} {:answer/id #uuid "acd865cc-8ca0-5df0-b0c5-c2cd29210f44" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/df/dfb46737087c1196ce079607220107a88857d6ca139d0d5c53b181795fe1344a.png" :db/id #edb/ref 17592186390518} {:answer/id #uuid "ddc2a988-d900-5cd3-a9a0-9a6ecf303b6b" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/ee/eef682605cf7486a9d8fa23cd508705e70443622164eeb2c253ca342bbce92cb.png" :db/id #edb/ref 17592186390519} {:answer/id #uuid "fffb642d-e2f2-5134-92b3-6bde0b2a9298" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/bc/bce2bc405efee4fc0fc0f8cd53a3f230fe407f1232c98237ced4ce64743a8499.png" :db/id #edb/ref 17592186390520}] :answer-field/correct {:answer/id #uuid "fffb642d-e2f2-5134-92b3-6bde0b2a9298" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/bc/bce2bc405efee4fc0fc0f8cd53a3f230fe407f1232c98237ced4ce64743a8499.png" :db/id #edb/ref 17592186390520} :answer-field/id #uuid "fe0ebeea-e82f-58d4-a5b0-0f856e91026c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186390515}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "63caaf01-44b4-5dc6-a569-9e3a3a5c8859" :question/math-academy-id "q-26811" :question/problem "Which of the following is the graph of $y={7}^{x}+4?$" :question/worked-solution "First, we plot the graph of $y={7}^{x}:$\n\n![](images/cd/cd8226319b26b3fef6db6e98efc187b1c474c91bc0252e424151791fda373b95.png)\n\nTo sketch the graph of $y={7}^{x}+4,$ we take the graph of $y={7}^{x}$ and shift it $4$ units up. The $y$-intercept moves from $(0,1)$ to $(0,5),$ and the horizontal asymptote moves from $y=0$ to $y=4.$\n\n![](images/85/85cc1403ab74e2df97669a7c3363d1abddf6d093c358e888a69b655f1ca7450a.png)"}] [{:db/id #edb/ref 17592186390521 :knowledge-point/_questions [{:db/id #edb/ref 17592186087821 :knowledge-point/id #uuid "dd63cb30-a236-546e-82ac-08bce09c88f7" :knowledge-point/title "Identifying a Vertically Shifted Exponential Growth Curve"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e4093346-6cc0-5f63-9423-7b76da2a672f" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/1d/1d80c585063f3cd30a6ec1f877e0f2add2bf109bc54506e4b6c9e44a7b5019d2.png" :db/id #edb/ref 17592186390523} {:answer/id #uuid "fd28d0fd-5ee9-586e-ade7-f559ef7573ec" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/bb/bbdfe3e538e840385c082f16ca2cdfd07a7731c561d05cab6e7a25f487cdf463.png" :db/id #edb/ref 17592186390524} {:answer/id #uuid "be9702e6-d21c-5c09-a96e-1267b5361dc9" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/cd/cd11656e3dae8a4976b1051a135b4bead1e5afc4beb21fa7541571892a037500.png" :db/id #edb/ref 17592186390525} {:answer/id #uuid "35b1a419-9084-5fab-a034-b69305bdd882" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/66/6674add26b7a15f5b09c53a832d649979484f0ffd41b440069dd5230cd9a5187.png" :db/id #edb/ref 17592186390526} {:answer/id #uuid "724df295-2359-5b8b-ab62-27d9d0e10f5e" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/a3/a30938f3d3af2fd70a0ee9498d7d99973d5386f062f22aaa8a028e9e18b3fb57.png" :db/id #edb/ref 17592186390527}] :answer-field/correct {:answer/id #uuid "be9702e6-d21c-5c09-a96e-1267b5361dc9" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/cd/cd11656e3dae8a4976b1051a135b4bead1e5afc4beb21fa7541571892a037500.png" :db/id #edb/ref 17592186390525} :answer-field/id #uuid "9cb7b8b6-ddf5-57db-b6c9-dfd64245bb49" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186390522}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "5100b042-b82c-5834-8756-fafba09daf0e" :question/math-academy-id "q-26815" :question/problem "Which of the following is the graph of $y={6}^{x}-0.75?$" :question/worked-solution "First, we plot the graph of $y={6}^{x}:$\n\n![](images/29/29d270676a48f4cf40625ef3ec50b0323c9c99389b2a7d080881727eda28de56.png)\n\nTo sketch the graph of $y={6}^{x}-0.75,$ we take the graph of $y={6}^{x}$ and shift it $0.75$ units down. The $y$-intercept moves from $(0,1)$ to $(0,0.25),$ and the horizontal asymptote moves from $y=0$ to $y=-0.75.$\n\n![](images/3b/3b141be99e5c01c70d6f6f04f4adf06741f1dc0fcef80c73b52e3dba1ae44a87.png)"}] [{:db/id #edb/ref 17592186292685 :knowledge-point/_questions [{:db/id #edb/ref 17592186059674 :knowledge-point/id #uuid "4c898bbf-004c-5905-a0a0-761adefc8bd8" :knowledge-point/title "Finding Exact Value of a Trigonometric Expression Using the Double-Angle Formula"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "078b25eb-c753-58c4-a8bb-c23711fdad11" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{2}" :db/id #edb/ref 17592186290671} {:answer/id #uuid "7908b470-d7ec-55b9-b4ab-b86372edd49a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186291145} {:answer/id #uuid "820532c3-42ff-5bba-a8ac-2af534fa5f77" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186291181} {:answer/id #uuid "9fdbc26c-f0b1-58b7-b55e-4663ee54eccb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{3}}{2}" :db/id #edb/ref 17592186291327} {:answer/id #uuid "fcc2c5b1-4056-55a7-8817-839d1d89caec" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2+\\sqrt{3}}{2}" :db/id #edb/ref 17592186291707}] :answer-field/correct {:answer/id #uuid "820532c3-42ff-5bba-a8ac-2af534fa5f77" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186291181} :answer-field/id #uuid "d670500b-2a4c-531d-a949-3190b98d3ea6" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186292387}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "83f3d502-62d9-5e1b-a7be-52d9144a4c16" :question/math-academy-id "q-26907" :question/problem "Find the exact value of ${(\\operatorname{sin}⁡({105}^{∘})+\\operatorname{cos}⁡({105}^{∘}))}^{2}.$" :question/worked-solution "First, we expand the parenthesis and use the Pythagorean identity.\n\n$$\n\\begin{aligned}{(\\operatorname{sin}⁡({105}^{∘})+\\operatorname{cos}⁡({105}^{∘}))}^{2} & ={sin}^{2}⁡({105}^{∘})+2\\operatorname{sin}⁡({105}^{∘})\\operatorname{cos}⁡({105}^{∘})+{cos}^{2}⁡({105}^{∘}) \\\\  & =[{sin}^{2}⁡({105}^{∘})+{cos}^{2}⁡({105}^{∘})]+2\\operatorname{sin}⁡({105}^{∘})\\operatorname{cos}⁡({105}^{∘}) \\\\  & =1+2\\operatorname{sin}⁡({105}^{∘})\\operatorname{cos}⁡({105}^{∘})\\end{aligned}\n$$\n\nNow, let's recall the double-angle formula for sine: \n\n$$\n2\\operatorname{sin}⁡x\\operatorname{cos}⁡x=\\operatorname{sin}⁡2x\n$$\n\nSubstituting $x={105}^{∘}$ into the above, we get\n\n$$\n\\begin{aligned}2\\operatorname{sin}⁡({105}^{∘})\\operatorname{cos}⁡({105}^{∘}) & =\\operatorname{sin}⁡(2\\cdot {105}^{∘}) \\\\  & =\\operatorname{sin}⁡({210}^{∘}) \\\\  & =\\operatorname{sin}⁡({180}^{∘}+{30}^{∘}) \\\\  & =-\\operatorname{sin}⁡({30}^{∘}) \\\\  & =-\\frac{1}{2}.\\end{aligned}\n$$\n\nHence, we obtain\n\n$$\n1+2\\operatorname{sin}⁡({105}^{∘})\\operatorname{cos}⁡({105}^{∘})=1-\\frac{1}{2}=\\frac{1}{2}.\n$$\n\nTherefore, we conclude that\n\n$$\n{(\\operatorname{sin}⁡({105}^{∘})+\\operatorname{cos}⁡({105}^{∘}))}^{2}=\\frac{1}{2}.\n$$"}] [{:db/id #edb/ref 17592186292696 :knowledge-point/_questions [{:db/id #edb/ref 17592186176047 :knowledge-point/id #uuid "542df339-5020-5680-a39c-a1ae161083e7" :knowledge-point/title "Describing Properties of the Cosine Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "043c68c8-e391-5780-a3ff-6d80dc52b081" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186290656} {:answer/id #uuid "931ab8d4-be2c-5e4d-92d6-fc6433eec3f1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186291265} {:answer/id #uuid "9767e111-d1e9-5924-9dc2-6f58d60a1d5a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186291290} {:answer/id #uuid "bb01b60e-6bb3-5d81-89d4-9256edcd3ff6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186291443} {:answer/id #uuid "d869766d-8d2f-5348-b322-4dd0c0dc459d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186291536}] :answer-field/correct {:answer/id #uuid "043c68c8-e391-5780-a3ff-6d80dc52b081" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186290656} :answer-field/id #uuid "c15b4588-e9b5-5b8e-af3b-02394e3239c9" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186292328}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "69137884-05b3-53be-9c7c-95b53b1ed329" :question/math-academy-id "q-27009" :question/problem "Which of the following statements are true regarding the function $y=cos⁡x?$ \n\n- The function intersects the $x$-axis at $x=\\frac{\\pi }{2}.$\n- The function has a minimum value at  $x=2\\pi .$\n- The function intersects the $y$-axis at $y=0.$" :question/worked-solution "Let's plot the graph of $y=cos⁡x.$\n\n![](images/9c/9c77bec4ebb04668fbff5176418ed9c09143a8660879fdf523a158c5f109006c.png)\n\nLet's go through each statement.\n\n- Statement I is true. At $x=\\frac{\\pi }{2}$ the function intersects the $x$-axis.\n\n- Statement II is false. The function has a maximum at $x=2\\pi .$\n\n- Statement III is false. The function intersects the $y$-axis at $y=1.$"}] [{:db/id #edb/ref 17592186055187 :knowledge-point/_questions [{:db/id #edb/ref 17592186054754 :knowledge-point/id #uuid "a186b166-928c-5bad-a996-3bdf6af419f5" :knowledge-point/title "Solving a Quadratic Inequality Using the Sign Table Method"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6edce2b1-4a27-55cc-b790-5b7035f56f10" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x\\in (-\\infty ,-5)\\cup (2,\\infty )" :db/id #edb/ref 17592186291108} {:answer/id #uuid "8e6aca7e-2c26-5ac1-ad8f-f26fea188d58" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x\\in (-\\infty ,2)\\cup (5,\\infty )" :db/id #edb/ref 17592186291244} {:answer/id #uuid "a0fcb44c-262e-57ad-8f5a-95eb76595b87" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x\\in (-2,5)" :db/id #edb/ref 17592186291334} {:answer/id #uuid "c0e240d4-f67f-53a1-917a-1652485d6081" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x\\in (-\\infty ,-2)\\cup (5,\\infty )" :db/id #edb/ref 17592186291462} {:answer/id #uuid "da78814f-36ea-5458-8651-4b37fc6c9f9a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x\\in (-5,2)" :db/id #edb/ref 17592186291546}] :answer-field/correct {:answer/id #uuid "c0e240d4-f67f-53a1-917a-1652485d6081" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x\\in (-\\infty ,-2)\\cup (5,\\infty )" :db/id #edb/ref 17592186291462} :answer-field/id #uuid "204f716b-5c4a-54ac-ac8d-6cc04dca8468" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186291854}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "7824abae-ac0a-561f-a7e4-242996de64c9" :question/math-academy-id "q-27068" :question/problem "For which values of $x$ is ${x}^{2}-3x-10>0?$" :question/worked-solution "First, let's factor the left-hand side of the inequality:\n\n$$\n\\begin{aligned}{x}^{2}-3x-10 & >0 \\\\ (x+2)(x-5) & >0\\end{aligned}\n$$\n\nNext, we find the roots of the corresponding equation $(x+2)(x-5)=0.$ The roots are $x=-2$ and $x=5,$ and they split the number line into the $3$ intervals $(-\\infty ,-2),$ $(-2,5),$ and $(5,\\infty ).$\n\nNow, we construct a sign table with the list of the intervals on the top and the list of factors on the left. Filling in the sign table using the usual method, we get the following result:\n\n|  | $(-\\infty ,-2)$ | $(-2,5)$ | $(5,\\infty )$ |\n| --- | --- | --- | --- |\n| $x+2$ | $-$ | $+$ | $+$ |\n| $x-5$ | $-$ | $-$ | $+$ |\n| $(x+2)(x-5)$ | $(-)\\cdot (-)=+$ | $(+)\\cdot (-)=-$ | $(+)\\cdot (+)=+$ |\n\nFinally, to solve the quadratic inequality $(x+2)(x-5)>0,$ we look at the bottom row to find out where the expression $(x+2)(x-5)$ is positive.\n\nWe see that the expression is positive on the intervals $(-\\infty ,-2)\\cup (5,\\infty ).$ \n\nTherefore, we conclude that ${x}^{2}-3x-10>0$ for all $x\\in (-\\infty ,-2)\\cup (5,\\infty ).$"}] [{:db/id #edb/ref 17592186055189 :knowledge-point/_questions [{:db/id #edb/ref 17592186054754 :knowledge-point/id #uuid "a186b166-928c-5bad-a996-3bdf6af419f5" :knowledge-point/title "Solving a Quadratic Inequality Using the Sign Table Method"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "31b90582-7492-541f-a422-a2ab4f6931f0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x\\in [-3,4]" :db/id #edb/ref 17592186290833} {:answer/id #uuid "4d187d1c-3040-5dd4-8232-8928c0010654" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x\\in (-\\infty ,-3]\\cup [4,\\infty )" :db/id #edb/ref 17592186290959} {:answer/id #uuid "62cd106e-503e-5f0f-a812-7e330a9b4ac9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x\\in [3,4]" :db/id #edb/ref 17592186291054} {:answer/id #uuid "b69c52f4-8b11-5492-9898-5b48aeef799f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x\\in [-4,3]" :db/id #edb/ref 17592186291421} {:answer/id #uuid "ce74bdfc-ed7d-5aed-ac88-c87e81a912a7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x\\in (-\\infty ,3]\\cup [4,\\infty )" :db/id #edb/ref 17592186291508}] :answer-field/correct {:answer/id #uuid "31b90582-7492-541f-a422-a2ab4f6931f0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x\\in [-3,4]" :db/id #edb/ref 17592186290833} :answer-field/id #uuid "1252b4f0-0f19-5e91-821d-a4efb9cf7cf5" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186291797}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "3d81bc42-8840-5c1f-ae63-83e13f8b6083" :question/math-academy-id "q-27071" :question/problem "For which values of $x$ is $3{x}^{2}-3x-36\\le 0?$" :question/worked-solution "First, let's factor the left-hand side of the inequality:\n\n$$\n\\begin{aligned}3{x}^{2}-3x-36 & \\le 0 \\\\ 3({x}^{2}-x-12) & \\le 0 \\\\ 3(x+3)(x-4) & \\le 0\\end{aligned}\n$$\n\nNext, we find the roots of the corresponding equation $(x+3)(x-4)=0.$ The roots are $x=-3$ and $x=4,$ and they split the number line into the $3$ subintervals $(-\\infty ,-3),$ $(-3,4),$ and $(4,\\infty ).$\n\nNow, we construct a sign table with the list of the intervals on the top and the list of factors on the left. Filling in the sign table using the usual method, we get the following result:\n\n|  | $(-\\infty ,-3)$ | $(-3,4)$ | $(4,\\infty )$ |\n| --- | --- | --- | --- |\n| $x+3$ | $-$ | $+$ | $+$ |\n| $x-4$ | $-$ | $-$ | $+$ |\n| $(x+3)(x-4)$ | $(-)\\cdot (-)=+$ | $(+)\\cdot (-)=-$ | $(+)\\cdot (+)=+$ |\n\nFinally, to solve the quadratic inequality $3(x+3)(x-4)\\le 0,$ we look at the bottom row to find out where the expression $3(x+3)(x-4)$ is zero or negative.\n\nWe see that the expression is negative on the interval $(-3,4).$ Also, we know that the expression equals $0$ at the points $x=-3$ and $x=4.$\n\nTherefore, we conclude that $(x+3)(x-4)\\le 0$ for all $x\\in [-3,4].$"}] [{:db/id #edb/ref 17592186292705 :knowledge-point/_questions [{:db/id #edb/ref 17592186054755 :knowledge-point/id #uuid "dc018e0e-60bc-59bd-a3f6-8ae2b68f8cfb" :knowledge-point/title "Solving an Inequality by Rearranging Terms and Using the Sign Table Method"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0b599f1e-71ef-5dac-88a7-d7a6b8c88246" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x\\in (-\\infty ,-5]\\cup [2,\\infty )" :db/id #edb/ref 17592186290686} {:answer/id #uuid "5983021d-f7e6-5a87-8334-04f37b819ac3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x\\in (-\\infty ,-5]\\cup [-2,\\infty )" :db/id #edb/ref 17592186291013} {:answer/id #uuid "5ece811e-cbe1-5481-a31c-64331b0fbbd3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x\\in [-2,5]" :db/id #edb/ref 17592186291037} {:answer/id #uuid "b9450f33-d113-5ab4-ada4-d129af5dc260" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x\\in [-5,2]" :db/id #edb/ref 17592186291435} {:answer/id #uuid "f1fc084f-3385-55c7-b348-c2cb4cc3ba37" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x\\in (-\\infty ,2]\\cup [5,\\infty )" :db/id #edb/ref 17592186291650}] :answer-field/correct {:answer/id #uuid "0b599f1e-71ef-5dac-88a7-d7a6b8c88246" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x\\in (-\\infty ,-5]\\cup [2,\\infty )" :db/id #edb/ref 17592186290686} :answer-field/id #uuid "51429ea0-f26a-52cb-9d46-1c28f1950ae2" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186291986}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "28268741-19ff-50b9-9cfe-fa406e7a681a" :question/math-academy-id "q-27073" :question/problem "For which values of $x$ is $5{x}^{2}+25x-53\\ge 10x-3?$" :question/worked-solution "First, we rewrite the given inequality so that the right-hand side equals zero. Then, we factor the left-hand side:\n\n$$\n\\begin{aligned}5{x}^{2}+25x-53 & \\ge 10x-3 \\\\ 5{x}^{2}+15x-50 & \\ge 0 \\\\ 5({x}^{2}+3x-10) & \\ge 0 \\\\ 5(x+5)(x-2) & \\ge 0\\end{aligned}\n$$\n\nNext, we find the roots of the corresponding equation $5(x+5)(x-2)=0.$ The roots are $x=-5$ and $x=2,$ and they split the number line into $3$ subintervals $(-\\infty ,-5),$ $(-5,2),$ and $(2,\\infty ).$\n\nNow, we construct a sign table with the list of the intervals on the top and the list of factors on the left. Filling in the sign table using the usual method, we get the following result:\n\n|  | $(-\\infty ,-5)$ | $(-5,2)$ | $(2,\\infty )$ |\n| --- | --- | --- | --- |\n| $x+5$ | $-$ | $+$ | $+$ |\n| $x-2$ | $-$ | $-$ | $+$ |\n| $5(x+5)(x-2)$ | $+$ | $-$ | $+$ |\n\nFinally, to solve the quadratic inequality $5(x+5)(x-2)\\ge 0,$ we look at the bottom row to find out where the expression $5(x+5)(x-2)$ is zero or positive.\n\nWe see that the expression is positive on the intervals $(-\\infty ,-5)$ and $(2,\\infty ).$ Also, we know that the expression equals $0$ at the points $x=-5$ and $x=2.$\n\nTherefore, we conclude that $5{x}^{2}+25x-53\\ge 10x-3$ for all $x\\in (-\\infty ,-5]\\cup [2,\\infty ).$"}] [{:db/id #edb/ref 17592186390531 :knowledge-point/_questions [{:db/id #edb/ref 17592186068829 :knowledge-point/id #uuid "5bb394c3-cd7c-523d-88df-b1306d9d528f" :knowledge-point/title "Identifying a Vertically Shifted Exponential Decay Curve"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5145dde8-60d2-54b7-ad8d-2892ff5d3963" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/a4/a4161037f51b8c4d95037c3ff28d7e6afecb354d4e0fabc22e5dd819bb65b6cc.png" :db/id #edb/ref 17592186390533} {:answer/id #uuid "6680ac81-034b-5243-a46f-e14b15ca391f" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/a4/a4511ffac1899bdeb512b0b50b50b6a121477f486ef7e2efc83697fd9dddb8d2.png" :db/id #edb/ref 17592186390534} {:answer/id #uuid "2d7b451c-b477-571c-b8f0-b6b471ddf99b" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/95/953bb642696a6b9c