nowledge-point/_questions [{:db/id #edb/ref 17592186078459 :knowledge-point/id #uuid "fb183013-a42d-50a3-a1b8-cd8501781075" :knowledge-point/title "Factoring a Polynomial With Multiple Variables as a Difference of Squares"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "17f420e0-2ce0-5aca-8dee-2fc02f4be838" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "({x}^{2}+{y}^{3})({x}^{2}-{y}^{3})" :db/id #edb/ref 17592186297656} {:answer/id #uuid "2decc769-5d34-52a4-8f61-0d917cf2c0e6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "({x}^{5}+{y}^{2})(x-{y}^{4})" :db/id #edb/ref 17592186297746} {:answer/id #uuid "84d3cf7b-8bb1-5c05-bad0-4556bf860b32" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "({x}^{3}+{y}^{3})({x}^{2}-{y}^{2})" :db/id #edb/ref 17592186298125} {:answer/id #uuid "903c4fc8-2bfb-5749-a8dc-9a4f1681fb2d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "({x}^{3}+{y}^{2})({x}^{3}-{y}^{2})" :db/id #edb/ref 17592186298178} {:answer/id #uuid "bd0ab2a9-e83d-55df-8e55-44c8b207e2a8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "({x}^{2}+{y}^{2})({x}^{2}-{y}^{2})" :db/id #edb/ref 17592186298375}] :answer-field/correct {:answer/id #uuid "17f420e0-2ce0-5aca-8dee-2fc02f4be838" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "({x}^{2}+{y}^{3})({x}^{2}-{y}^{3})" :db/id #edb/ref 17592186297656} :answer-field/id #uuid "710ade4f-6788-57df-bfae-27eab8eaa863" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186299022}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "a03ef93a-a766-5bc2-9cd5-d8ee9f70bca4" :question/math-academy-id "q-31991" :question/problem "Factor ${x}^{4}-{y}^{6}.$" :question/worked-solution "The difference of squares formula is given by\n\n$$\n{a}^{2}-{b}^{2}=(a+b)(a-b)\n$$\n\nNotice that our expression can be written as a difference of squares:\n\n$$\n{x}^{4}-{y}^{6}={({x}^{2})}^{2}-{({y}^{3})}^{2}\n$$\n\nFinally, we factor our expression using the difference of squares formula:\n\n$$\n{({x}^{2})}^{2}-{({y}^{3})}^{2}=({x}^{2}+{y}^{3})({x}^{2}-{y}^{3})\n$$"}] [{:db/id #edb/ref 17592186115739 :knowledge-point/_questions [{:db/id #edb/ref 17592186115401 :knowledge-point/id #uuid "4c1def23-83e0-5dc7-b20b-9693127d3a9e" :knowledge-point/title "Differentiating Inverse Reciprocal Trigonometric Functions Using the Chain Rule"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "006c4d37-009e-5065-aa0e-e789bc12caf9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{4{x}^{3}}{|8-{x}^{4}|\\sqrt{(8-{x}^{4})^{2}-1}}" :db/id #edb/ref 17592186297551} {:answer/id #uuid "a3a34a37-aaa2-5b33-8413-e4f969d084a1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{12{x}^{3}}{|8-{x}^{4}|\\sqrt{(8-{x}^{4})^{2}-1}}" :db/id #edb/ref 17592186298270} {:answer/id #uuid "bb221971-81aa-5b2d-a077-c6b670f32b1b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{8{x}^{3}}{|8-{x}^{4}|\\sqrt{(8-{x}^{4})^{2}-1}}" :db/id #edb/ref 17592186298367} {:answer/id #uuid "c0e98b1b-1585-5bcb-a6c7-f9e80aef1351" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{6{x}^{3}}{|8-{x}^{4}|\\sqrt{(8-{x}^{4})^{2}-1}}" :db/id #edb/ref 17592186298401} {:answer/id #uuid "cd44316a-87ed-548b-af75-38a85154bbc0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{12{x}^{3}}{|8-{x}^{4}|\\sqrt{(8-{x}^{4})^{2}-1}}" :db/id #edb/ref 17592186298447}] :answer-field/correct {:answer/id #uuid "bb221971-81aa-5b2d-a077-c6b670f32b1b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{8{x}^{3}}{|8-{x}^{4}|\\sqrt{(8-{x}^{4})^{2}-1}}" :db/id #edb/ref 17592186298367} :answer-field/id #uuid "b39d87eb-5482-5669-84b6-1f25fa680a00" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186299244}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "c5f8a50f-d033-5259-86d9-bade982764d7" :question/math-academy-id "q-32000" :question/problem "Calculate ${f}^{′}(x)$ for $f(x)=2arccsc(8-{x}^{4}).$" :question/worked-solution "The formula for the derivative of $\\text{arccsc}$ is\n\n$$\n\\frac{\\text{d}}{\\text{d}x}(\\text{arccsc}\\,x)=-\\frac{1}{|x|\\sqrt{{x}^{2}-1}}.\n$$\n\nUsing the chain rule and the formula above, we obtain\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}(2arccsc(8-{x}^{4})) \\\\  & =2\\cdot \\frac{\\text{d}}{\\text{d}x}(arccsc(8-{x}^{4})) \\\\  & =2(-\\frac{1}{|8-{x}^{4}|\\sqrt{(8-{x}^{4})^{2}-1}})\\cdot \\frac{\\text{d}}{\\text{d}x}(8-{x}^{4}) \\\\  & =2(-\\frac{1}{|8-{x}^{4}|\\sqrt{(8-{x}^{4})^{2}-1}})\\cdot (-4{x}^{3}) \\\\  & =\\frac{8{x}^{3}}{|8-{x}^{4}|\\sqrt{(8-{x}^{4})^{2}-1}}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186120195 :knowledge-point/_questions [{:db/id #edb/ref 17592186119940 :knowledge-point/id #uuid "0305491f-5ac7-5ba4-9a80-1a9a79b964f0" :knowledge-point/title "Calculating dy/dx at a Point Using dx/dy"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2104e133-914f-5ccf-9abb-bb338526ec6d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{7}{18}" :db/id #edb/ref 17592186300116} {:answer/id #uuid "2e7b2fae-8ac3-57a0-bffe-05751f19e1e4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{54}{7}" :db/id #edb/ref 17592186300187} {:answer/id #uuid "9e343b3d-6257-5d65-9a7e-1c0b02359997" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{9}{5}" :db/id #edb/ref 17592186300760} {:answer/id #uuid "a782896a-abec-59e4-9290-6a432fe3815a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5}{9}" :db/id #edb/ref 17592186300805} {:answer/id #uuid "bebe977a-dc05-5a44-8579-fd4c6afc897a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{18}{7}" :db/id #edb/ref 17592186300914}] :answer-field/correct {:answer/id #uuid "bebe977a-dc05-5a44-8579-fd4c6afc897a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{18}{7}" :db/id #edb/ref 17592186300914} :answer-field/id #uuid "38691da1-c3cd-5bcd-bc71-b36d06760bd6" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186301409}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "e944b722-89ed-5df5-8b31-cb3570eaaf1f" :question/math-academy-id "q-32595" :question/problem "If $x=2\\sqrt{y}-\\frac{3}{\\sqrt{y}},$ find $\\frac{\\text{d}y}{\\text{d}x}$ at the point $(5,9).$" :question/worked-solution "First, we differentiate $x(y)$ with respect to $y:$\n\n$$\n\\begin{aligned}\\frac{\\text{d}x}{\\text{d}y} & =\\frac{\\text{d}}{\\text{d}y}(2\\sqrt{y}-\\frac{3}{\\sqrt{y}}) \\\\  & =2\\frac{\\text{d}}{\\text{d}y}(\\sqrt{y})-3\\frac{\\text{d}}{\\text{d}y}(\\frac{1}{\\sqrt{y}}) \\\\  & =2\\frac{\\text{d}}{\\text{d}y}({y}^{1/2})-3\\frac{\\text{d}}{\\text{d}y}({y}^{-1/2}) \\\\  & =2\\cdot \\frac{1}{2}{y}^{-1/2}-3\\cdot (-\\frac{1}{2}{y}^{-3/2}) \\\\  & ={y}^{-1/2}+\\frac{3}{2}{y}^{-3/2} \\\\  & =\\frac{1}{\\sqrt{y}}+\\frac{3}{2\\sqrt{{y}^{3}}} \\\\  & =\\frac{1}{\\sqrt{y}}+\\frac{3}{2y\\sqrt{y}} \\\\  & =\\frac{2y+3}{2y\\sqrt{y}}.\\end{aligned}\n$$\n\nNow, taking the reciprocal of $\\frac{\\text{d}x}{\\text{d}y},$ we get\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}={(\\frac{\\text{d}x}{\\text{d}y})}^{-1}=\\frac{2y\\sqrt{y}}{2y+3}.\n$$\n\nFinally, substituting the point $(5,9),$ we find\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x}{|}_{(x,y)=(5,9)} & =\\frac{2(9)\\sqrt{9}}{2(9)+3}=\\frac{18}{7}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186120196 :knowledge-point/_questions [{:db/id #edb/ref 17592186119941 :knowledge-point/id #uuid "4ff302ba-5a3f-599b-b038-7417af1dca71" :knowledge-point/title "Finding the Equation of a Tangent Line Using dx/dy"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "16d73b7d-9403-55ab-b551-e19830698e26" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=\\frac{x}{12}+\\frac{9}{4}" :db/id #edb/ref 17592186300052} {:answer/id #uuid "6a33eeae-06c8-52d2-b05c-f45a9e998a06" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=\\frac{x}{12}+\\frac{7}{2}" :db/id #edb/ref 17592186300498} {:answer/id #uuid "9e0ef0fa-a60f-528b-b723-df752ee1c670" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=\\frac{x}{12}+\\frac{7}{4}" :db/id #edb/ref 17592186300758} {:answer/id #uuid "b2d76d1c-be51-51c6-8cde-9ba71e9a668a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=9x+3" :db/id #edb/ref 17592186300855} {:answer/id #uuid "b6e2c41b-b138-5e44-b020-de7bc94b2004" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=12x-27" :db/id #edb/ref 17592186300874}] :answer-field/correct {:answer/id #uuid "16d73b7d-9403-55ab-b551-e19830698e26" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=\\frac{x}{12}+\\frac{9}{4}" :db/id #edb/ref 17592186300052} :answer-field/id #uuid "2a3602d1-8784-558b-8e8c-d79f5c14e514" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186301360}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "c7ef2446-7ddb-53cb-83cf-b4fed6b4ea6f" :question/math-academy-id "q-32596" :question/problem "Given a curve $x=\\frac{2}{3}{y}^{3}-{y}^{2},$ what is the equation of the tangent to the curve at the point $(9,3)?$" :question/worked-solution "First, we differentiate $x(y)$ with respect to $y:$\n\n$$\n\\begin{aligned}\\frac{\\text{d}x}{\\text{d}y} & =\\frac{\\text{d}}{\\text{d}y}(\\frac{2}{3}{y}^{3}-{y}^{2}) \\\\  & =\\frac{2}{3}\\frac{\\text{d}}{\\text{d}y}({y}^{3})-\\frac{\\text{d}}{\\text{d}y}({y}^{2}) \\\\  & =\\frac{2}{3}\\cdot 3{y}^{2}-2y \\\\  & =2{y}^{2}-2y\\end{aligned}\n$$\n\nNow, taking the reciprocal of $\\frac{\\text{d}x}{\\text{d}y},$ we get\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}={(\\frac{\\text{d}x}{\\text{d}y})}^{-1}=\\frac{1}{2{y}^{2}-2y}.\n$$\n\nThe slope of the tangent to the curve at the point $(9,3)$ is\n\n$$\n\\begin{aligned}m & =\\frac{\\text{d}y}{\\text{d}x}{|}_{(x,y)=(9,3)} \\\\  & =\\frac{1}{2(3)^{2}-2(3)} \\\\  & =\\frac{1}{12}.\\end{aligned}\n$$\n\nUsing the point-slope formula for a tangent line, we get\n\n$$\n\\begin{aligned}y-{y}_{1} & =m(x-{x}_{1}) \\\\ y-3 & =\\frac{1}{12}(x-9) \\\\ y & =\\frac{x}{12}-\\frac{3}{4}+3 \\\\ y & =\\frac{x}{12}+\\frac{9}{4}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186120198 :knowledge-point/_questions [{:db/id #edb/ref 17592186119978 :knowledge-point/id #uuid "8c0b7d95-c699-5762-aa44-449712f035c7" :knowledge-point/title "Calculating the Derivative of the Inverse of a Polynomial Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "319c0fb3-aee5-5e2d-bcbf-a1949dbc941d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2{g}^{-1}(x)+6}" :db/id #edb/ref 17592186300206} {:answer/id #uuid "896ccbe6-a82d-5b23-9d7c-b0f373d22b40" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4{g}^{-1}(x)+6" :db/id #edb/ref 17592186300656} {:answer/id #uuid "da6d18f3-3cee-525c-86e4-e352d45bb12f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{4{g}^{-1}(x)+6}" :db/id #edb/ref 17592186301044} {:answer/id #uuid "f2c1668d-0e47-5c9f-bcd8-84e9ad090306" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{4{g}^{-1}(x)+6}" :db/id #edb/ref 17592186301161} {:answer/id #uuid "ff0f86e0-2705-5cc9-b536-c3f797b75455" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2({g}^{-1}(x))+6{g}^{-1}(x)-2}" :db/id #edb/ref 17592186301223}] :answer-field/correct {:answer/id #uuid "f2c1668d-0e47-5c9f-bcd8-84e9ad090306" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{4{g}^{-1}(x)+6}" :db/id #edb/ref 17592186301161} :answer-field/id #uuid "348b05f8-ac66-5d57-a5c3-05e956512cbf" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186301392}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "62e6ddbb-e71d-53d4-9a83-95cdcae2804b" :question/math-academy-id "q-32629" :question/problem "If $g(x)=2{x}^{2}+6x-2,$ find ${({g}^{-1})}^{′}(x)$ as a function of ${g}^{-1}(x).$" :question/worked-solution "**Step 1:** First, we write the inverse function implicitly. The given function is $y=2{x}^{2}+6x-2,$ and to write the inverse function implicitly, we swap $x$ and $y$ as follows:\n\n$$\nx=2{y}^{2}+6y-2\n$$\n\nNote that in the equation above, we have $y={g}^{-1}(x).$\n\n**Step 2:** Next, we differentiate. The overall goal is to find $\\frac{\\text{d}y}{\\text{d}x},$ but the equation is already solved for $x,$ so we compute $\\frac{\\text{d}x}{\\text{d}y}$ and then take the reciprocal:\n\n$$\n\\begin{aligned}\\frac{\\text{d}x}{\\text{d}y} & =\\frac{\\text{d}}{\\text{d}y}(2{y}^{2}+6y-2) \\\\ \\frac{\\text{d}x}{\\text{d}y} & =4y+6 \\\\ \\frac{\\text{d}y}{\\text{d}x} & =\\frac{1}{4y+6}\\end{aligned}\n$$\n\n**Step 3:**\n\nLastly, we write the result in terms of ${g}^{-1}(x).$ Since $y={g}^{-1}(x),$ we have\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}[{g}^{-1}(x)] & =\\frac{1}{4{g}^{-1}(x)+6} \\\\ {({g}^{-1})}^{′}(x) & =\\frac{1}{4{g}^{-1}(x)+6}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186302290 :knowledge-point/_questions [{:db/id #edb/ref 17592186119979 :knowledge-point/id #uuid "0196af83-9ef6-5bab-9f50-0aacf488f0cc" :knowledge-point/title "Calculating the Derivative of the Inverse of a Composite Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2e68e0e6-041a-534e-ae3f-656e3055c656" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}\\,\\operatorname{csc}⁡(2{g}^{-1}(x)+5)" :db/id #edb/ref 17592186300186} {:answer/id #uuid "3d41be64-6ef0-5cb2-8c49-dfdb88df1918" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}\\,\\operatorname{sec}⁡(2{g}^{-1}(x)+5)" :db/id #edb/ref 17592186300260} {:answer/id #uuid "3ed454bc-d138-582d-9b57-ad9bfb532c15" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\operatorname{csc}⁡(2{g}^{-1}(x)+5)" :db/id #edb/ref 17592186300270} {:answer/id #uuid "77e1d8bb-f34a-54b5-88c5-760321bf0433" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\operatorname{cos}⁡(2{g}^{-1}(x)+5)" :db/id #edb/ref 17592186300552} {:answer/id #uuid "7f545b1d-f3a2-5eae-aa1d-a60253aadbbe" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{sec}⁡(2{g}^{-1}(x))" :db/id #edb/ref 17592186300594}] :answer-field/correct {:answer/id #uuid "3d41be64-6ef0-5cb2-8c49-dfdb88df1918" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}\\,\\operatorname{sec}⁡(2{g}^{-1}(x)+5)" :db/id #edb/ref 17592186300260} :answer-field/id #uuid "f6625e80-6f3e-5f94-979a-72f6d57fbe39" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186302013}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "2318ec9c-3e92-5221-b4ff-d2d8a492f82d" :question/math-academy-id "q-32635" :question/problem "If $g(x)=\\operatorname{sin}⁡(2x+5)-1,$ find ${({g}^{-1})}^{′}(x)$ as a function of ${g}^{-1}(x).$" :question/worked-solution "**Step 1:** First, we write the inverse function implicitly. The given function is $y=\\operatorname{sin}⁡(2x+5)-1,$ and to write the inverse function implicitly, we swap $x$ and $y$ as follows:\n\n$$\nx=\\operatorname{sin}⁡(2y+5)-1\n$$\n\nNote that in the equation above, we have $y={g}^{-1}(x).$\n\n**Step 2:** Next, we differentiate. The overall goal is to find $\\frac{\\text{d}y}{\\text{d}x},$ but the equation is already solved for $x,$ so we compute $\\frac{\\text{d}x}{\\text{d}y}$ and then take the reciprocal:\n\n$$\n\\begin{aligned}\\frac{\\text{d}x}{\\text{d}y} & =\\frac{\\text{d}}{\\text{d}y}(\\operatorname{sin}⁡(2y+5)-1) \\\\ \\frac{\\text{d}x}{\\text{d}y} & =\\operatorname{cos}⁡(2y+5)\\cdot 2 \\\\ \\frac{\\text{d}x}{\\text{d}y} & =2\\operatorname{cos}⁡(2y+5) \\\\ \\frac{\\text{d}y}{\\text{d}x} & =\\frac{1}{2\\operatorname{cos}⁡(2y+5)} \\\\ \\frac{\\text{d}y}{\\text{d}x} & =\\frac{1}{2}\\operatorname{sec}⁡(2y+5)\\end{aligned}\n$$\n\n**Step 3:** Lastly, we write the result in terms of ${g}^{-1}(x).$ Since $y={g}^{-1}(x),$ we have\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}[{g}^{-1}(x)] & =\\frac{1}{2}\\operatorname{sec}⁡(2{g}^{-1}(x)+5) \\\\ {({g}^{-1})}^{′}(x) & =\\frac{1}{2}\\operatorname{sec}⁡(2{g}^{-1}(x)+5).\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186120202 :knowledge-point/_questions [{:db/id #edb/ref 17592186119939 :knowledge-point/id #uuid "00ac6edc-908a-50be-9ef1-4b24ba597d1d" :knowledge-point/title "Calculating dy/dx Using dx/dy"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "233da062-0046-5ff6-be71-aee3cc7e71f8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{y}^{3}}{4+4{y}^{4}}" :db/id #edb/ref 17592186300130} {:answer/id #uuid "95d1ecb0-3160-5adc-97f9-910e8d9c239c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{y}^{3}}{1+{y}^{4}}" :db/id #edb/ref 17592186300719} {:answer/id #uuid "b0a94346-e82d-5c11-b3c7-77080761ef66" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{x}^{3}}{1+{x}^{4}}" :db/id #edb/ref 17592186300843} {:answer/id #uuid "f6dc110a-2fc4-5a9e-a3d2-5fed13a83b5e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{y}{4+4{y}^{4}}" :db/id #edb/ref 17592186301179} {:answer/id #uuid "fae0bb00-a872-5722-aa1c-2b78582a5353" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{y}^{3}}{4+4{y}^{3}}" :db/id #edb/ref 17592186301204}] :answer-field/correct {:answer/id #uuid "233da062-0046-5ff6-be71-aee3cc7e71f8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{y}^{3}}{4+4{y}^{4}}" :db/id #edb/ref 17592186300130} :answer-field/id #uuid "84d7d2bf-ce4d-5963-b71f-6932bfd6b3ea" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186301646}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "cd82fd71-e11f-52b4-879b-d6f659d732bf" :question/math-academy-id "q-32705" :question/problem "If $x=-\\frac{2}{{y}^{2}}+2{y}^{2},$ then $\\frac{\\text{d}y}{\\text{d}x}=$" :question/worked-solution "First, we differentiate $x(y)$ with respect to $y:$\n\n$$\n\\begin{aligned}\\frac{\\text{d}x}{\\text{d}y} & =\\frac{\\text{d}}{\\text{d}y}(-\\frac{2}{{y}^{2}}+2{y}^{2}) \\\\  & =\\frac{\\text{d}}{\\text{d}y}(-2{y}^{-2}+2{y}^{2}) \\\\  & =-2\\frac{\\text{d}}{\\text{d}y}({y}^{-2})+2\\frac{\\text{d}}{\\text{d}y}({y}^{2}) \\\\  & =4{y}^{-3}+4y \\\\  & =\\frac{4}{{y}^{3}}+4y \\\\  & =\\frac{4+4{y}^{4}}{{y}^{3}}\\end{aligned}\n$$\n\nNow, taking the reciprocal of $\\frac{\\text{d}x}{\\text{d}y},$ we get\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}={(\\frac{\\text{d}x}{\\text{d}y})}^{-1}=\\frac{{y}^{3}}{4+4{y}^{4}}.\n$$"}] [{:db/id #edb/ref 17592186304802 :knowledge-point/_questions [{:db/id #edb/ref 17592186119978 :knowledge-point/id #uuid "8c0b7d95-c699-5762-aa44-449712f035c7" :knowledge-point/title "Calculating the Derivative of the Inverse of a Polynomial Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0ad77982-9d97-5298-9445-aa2f29bc75ea" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "({g}^{-1}(x))^{2}+12" :db/id #edb/ref 17592186302529} {:answer/id #uuid "3d2f1231-6fab-51a9-b30c-1f9c29aba694" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{12({g}^{-1}(x))^{2}+2}" :db/id #edb/ref 17592186302837} {:answer/id #uuid "89a7c6b9-61e0-5fa5-b9cf-bcfa192e6661" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2}{12({g}^{-1}(x))^{2}+1}" :db/id #edb/ref 17592186303314} {:answer/id #uuid "97905197-8f84-5b48-bca4-efd82fb4afb0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{({g}^{-1}(x))^{2}+2}" :db/id #edb/ref 17592186303397} {:answer/id #uuid "eba8ac9e-26d2-5904-bec3-e057833f71f4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "12({g}^{-1}(x))^{2}+2" :db/id #edb/ref 17592186303931}] :answer-field/correct {:answer/id #uuid "3d2f1231-6fab-51a9-b30c-1f9c29aba694" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{12({g}^{-1}(x))^{2}+2}" :db/id #edb/ref 17592186302837} :answer-field/id #uuid "67848d2d-ef17-55d4-8334-d4361a471cbe" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186304355}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "54994de7-137e-54bf-80bb-ec8f86707073" :question/math-academy-id "q-3300" :question/problem "Find ${({g}^{-1})}^{′}(x)$  as a function of ${g}^{-1}(x),$ if $g(x)=4{x}^{3}+2x+6.$" :question/worked-solution "**Step 1:** First, we write the inverse function implicitly. The given function is $y=4{x}^{3}+2x+6,$ and to write the inverse function implicitly, we swap $x$ and $y$ as follows:\n\n$$\nx=4{y}^{3}+2y+6\n$$\n\nNote that in the equation above, we have $y={g}^{-1}(x).$\n\n**Step 2:** Next, we differentiate. The overall goal is to find $\\frac{\\text{d}y}{\\text{d}x},$ but the equation is already solved for $x,$ so we compute $\\frac{\\text{d}x}{\\text{d}y}$ and then take the reciprocal:\n\n$$\n\\begin{aligned}\\frac{\\text{d}x}{\\text{d}y} & =\\frac{\\text{d}}{\\text{d}y}(4{y}^{3}+2y+6) \\\\ \\frac{\\text{d}x}{\\text{d}y} & =12{y}^{2}+2 \\\\ \\frac{\\text{d}y}{\\text{d}x} & =\\frac{1}{12{y}^{2}+2}\\end{aligned}\n$$\n\n**Step 3:** Lastly, we write the result in terms of ${g}^{-1}(x).$ Since $y={g}^{-1}(x),$ we have\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}[{g}^{-1}(x)] & =\\frac{1}{12({g}^{-1}(x))^{2}+2} \\\\ {({g}^{-1})}^{′}(x) & =\\frac{1}{12({g}^{-1}(x))^{2}+2}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186060270 :knowledge-point/_questions [{:db/id #edb/ref 17592186059685 :knowledge-point/id #uuid "993c8fe4-dae9-5dc4-9f94-5012f905e0ee" :knowledge-point/title "Finding the Correct Quadrant for Negative Angles that Contain More Than One Full Rotation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "252d775f-77ed-511b-95ad-524d7bb4cd39" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "IV" :db/id #edb/ref 17592186315326} {:answer/id #uuid "6bcab351-5c37-5d1b-99d8-985db29eacd6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II" :db/id #edb/ref 17592186315726} {:answer/id #uuid "969cb243-da0c-5f4c-8e30-aedc2baa4e6e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "Between quadrants III and IV" :db/id #edb/ref 17592186315954} {:answer/id #uuid "ae942c7b-d556-576d-99b4-c2d5e0d5ad8c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I" :db/id #edb/ref 17592186316110} {:answer/id #uuid "e7b0d548-2819-5f8e-b792-8ccfa0fb789c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III" :db/id #edb/ref 17592186316400}] :answer-field/correct {:answer/id #uuid "969cb243-da0c-5f4c-8e30-aedc2baa4e6e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "Between quadrants III and IV" :db/id #edb/ref 17592186315954} :answer-field/id #uuid "e94ae561-6bac-5708-8ab7-f7ca8354b9fd" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186317100}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "8483a20c-9e8e-5588-94ee-dd0e0014806e" :question/math-academy-id "q-34325" :question/problem "The angle $\\theta =-{450}^{∘}$ is represented in the coordinate plane in the usual way. In which quadrant does it lie?" :question/worked-solution "First, we find an angle that's coterminal with $-{450}^{∘}$ by *adding* integer multiples of ${360}^{∘}$ until we get an angle that lies in the range $[{0}^{∘},{360}^{∘}).$\n\n- $-{450}^{∘}+{360}^{∘}=-90$\n\n- $-{450}^{∘}+2\\cdot {360}^{∘}={270}^{∘}\\,✓$\n\nSo the angle ${270}^{∘}$ is coterminal with $-{450}^{∘}.$ Let's draw this coterminal angle in the coordinate plane.\n\n![](images/35/35b9783c9ac87b0a8d177e7bdf340b48513146404b7c768a8532da59b6ec7948.png)\n\nWe see that ${270}^{∘}$ lies between quadrants III and IV. Therefore, $-{450}^{∘}$ also lies between these quadrants."}] [{:db/id #edb/ref 17592186069268 :knowledge-point/_questions [{:db/id #edb/ref 17592186068861 :knowledge-point/id #uuid "a7f04ab7-f6f6-5d01-bfcf-b667e37e4f0b" :knowledge-point/title "Solving a Quadratic Equation When the Solutions Are Irrational"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "824db7a0-468b-5b7c-bdd3-7bd19185dd56" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "p + q = 80, z =-5 ± 5\\sqrt{3}" :db/id #edb/ref 17592186066779} {:answer/id #uuid "f44af2a5-1591-5f5e-93ba-40c0ddd584b9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "p + q = 80, z =-8 ± 3" :db/id #edb/ref 17592186066780} {:answer/id #uuid "30dfca08-4199-59da-8d02-2600e0f2122b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "p + q = 75, z = 5 ± 5\\sqrt{3}" :db/id #edb/ref 17592186066781} {:answer/id #uuid "4a3b9749-a33c-5c57-89ac-26939f855dba" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "p + q = 80, z = 5 ± 5\\sqrt{3}" :db/id #edb/ref 17592186066782} {:answer/id #uuid "6d135e5e-ebb4-5c27-84bf-0be68ee6c029" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "p + q =-70, z = ± \\sqrt{3}" :db/id #edb/ref 17592186066783}] :answer-field/id #uuid "988361f0-82f8-5fa0-bce8-8775fead2e27" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186066778} {:answer-field/choices [{:answer/id #uuid "9eb9e11c-6e9c-5d9f-85b6-41a705579cde" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "p+q=80,\\,z=-5\\pm 5\\sqrt{3}" :db/id #edb/ref 17592186402357} {:answer/id #uuid "23289d14-87e9-57fb-bbda-cdd305eb9ab6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "p+q=-70,\\,z=\\pm \\sqrt{3}" :db/id #edb/ref 17592186402358} {:answer/id #uuid "691a3cdd-d3d5-50e7-a708-646cfa31e0a7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "p+q=80,\\,z=-8\\pm 3" :db/id #edb/ref 17592186402359} {:answer/id #uuid "823c0a9e-ef4b-5a9d-a5eb-0fe274767e74" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "p+q=75,\\,z=5\\pm 5\\sqrt{3}" :db/id #edb/ref 17592186402360} {:answer/id #uuid "ee362d99-5b0e-55c5-83d5-a9a8872163ac" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "p+q=80,\\,z=5\\pm 5\\sqrt{3}" :db/id #edb/ref 17592186402361}] :answer-field/correct {:answer/id #uuid "9eb9e11c-6e9c-5d9f-85b6-41a705579cde" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "p+q=80,\\,z=-5\\pm 5\\sqrt{3}" :db/id #edb/ref 17592186402357} :answer-field/id #uuid "0174c191-2a23-5d0f-b8d7-9880c6f7ee41" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186402356}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "5c0076f5-08a5-5d4c-9789-196650ab8295" :question/math-academy-id "q-3435" :question/problem "The equation ${z}^{2}-50=-10z$ can be written in the form $(z+p{)}^{2}=q.$ Find $p+q,$ and solve the equation." :question/worked-solution "First, we move the constant term to the right-hand side, the $-10z$ term to the left-hand side, and complete the square on the left-hand side.\n\n$$\n\\begin{aligned}{z}^{2}-50 & =-10z \\\\ {z}^{2}+10z & =50 \\\\ {z}^{2}+2\\cdot 5\\cdot z & =50 \\\\ {z}^{2}+2\\cdot 5\\cdot z+{5}^{2}-{5}^{2} & =50 \\\\ (z+5{)}^{2}-{5}^{2} & =50\\end{aligned}\n$$\n\nThen, we isolate the perfect square:\n\n$$\n\\begin{aligned}(z+5{)}^{2}-{5}^{2} & =50 \\\\ (z+5{)}^{2} & =75\\end{aligned}\n$$\n\nSo, $p=5,q=75,$ and $p+q=80.$\n\nNext, we solve the equation using the square-root method:\n\n$$\n\\begin{aligned}(z+5{)}^{2} & =75 \\\\ \\sqrt{(z+5{)}^{2}} & =\\sqrt{75} \\\\ |z+5| & =\\sqrt{75} \\\\ z+5 & =\\pm 5\\sqrt{3} \\\\ z & =-5\\pm 5\\sqrt{3}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186060272 :knowledge-point/_questions [{:db/id #edb/ref 17592186059685 :knowledge-point/id #uuid "993c8fe4-dae9-5dc4-9f94-5012f905e0ee" :knowledge-point/title "Finding the Correct Quadrant for Negative Angles that Contain More Than One Full Rotation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1f1000f1-7874-54ec-a25c-a6fdd4c99c19" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I" :db/id #edb/ref 17592186058255} {:answer/id #uuid "3d05c2d3-5f8b-520c-9698-93cd44016078" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "Between quadrants II and III" :db/id #edb/ref 17592186058256} {:answer/id #uuid "3e675e47-ccc8-5f07-88dd-4486ea14690b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "IV" :db/id #edb/ref 17592186058257} {:answer/id #uuid "4077c45f-7284-5f8a-b112-9435133409d5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III" :db/id #edb/ref 17592186058258} {:answer/id #uuid "73d4409a-0928-587b-a8b0-c3b59584d36a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II" :db/id #edb/ref 17592186058259}] :answer-field/id #uuid "ba6c658f-3e45-5acf-b1fd-cc6fc99efea5" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186058254} {:answer-field/choices [{:answer/id #uuid "f053f6c2-d473-5f4a-9761-a34e3f8fa5eb" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II" :db/id #edb/ref 17592186402370} {:answer/id #uuid "b8c1d7ef-187c-5c23-afd5-1de27fa281b9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III" :db/id #edb/ref 17592186402371} {:answer/id #uuid "e2833382-6b90-5b3c-ae32-77694f3ceaef" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "IV" :db/id #edb/ref 17592186402372} {:answer/id #uuid "79867f36-2c63-53a2-b0d7-906e247536ec" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "Between quadrants II and III" :db/id #edb/ref 17592186402373} {:answer/id #uuid "7b1cfc22-b026-5ac0-aed5-a3a643bfff05" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I" :db/id #edb/ref 17592186402374}] :answer-field/correct {:answer/id #uuid "e2833382-6b90-5b3c-ae32-77694f3ceaef" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "IV" :db/id #edb/ref 17592186402372} :answer-field/id #uuid "88bbe855-4ccb-5da3-a31c-9c9bb8b0b176" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186402369}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "80f5801f-10e6-5373-bb84-2300dad1ed58" :question/math-academy-id "q-34403" :question/problem "The angle $\\theta =-\\frac{9\\pi }{4}$ is represented in the coordinate plane in the usual way. In which quadrant does it lie?" :question/worked-solution "First, we find an angle that's coterminal with $-\\frac{9\\pi }{4}$ by *adding* integer multiples of $2\\pi $ until we get an angle that lies in the range $[0,2\\pi ).$\n\n- $-\\frac{9\\pi }{4}+2\\pi =-\\frac{\\pi }{4}$\n\n- $-\\frac{9\\pi }{4}+2\\cdot (2\\pi )=\\frac{7\\pi }{4}\\,✓$\n\nSo the angle $-\\frac{9\\pi }{4}$ is coterminal with $\\frac{7\\pi }{4}.$ Let's draw this coterminal angle in the coordinate plane.\n\n![](images/89/891959642b0d055d852329c59be7541179dd5ae0c4182c2bec533261ce3a700d.png)\n\nWe see that $\\frac{7\\pi }{6}$ lies in quadrant IV. Therefore, $-\\frac{9\\pi }{4}$ also lies in this quadrant."}] [{:db/id #edb/ref 17592186320740 :knowledge-point/_questions [{:db/id #edb/ref 17592186184212 :knowledge-point/id #uuid "3202d7cc-541b-553b-8ec1-d4ea85dd0590" :knowledge-point/title "Completing the Square on an Expression With a Negative Leading Coefficient"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "53025447-2eb1-5df5-a00f-6e8c8a103513" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2{(z+\\frac{7}{2})}^{2}-\\frac{89}{4}" :db/id #edb/ref 17592186319630} {:answer/id #uuid "66db5717-8d6c-56e3-9e6e-8159327ca744" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2{(z+\\frac{7}{2})}^{2}-\\frac{67}{2}" :db/id #edb/ref 17592186319706} {:answer/id #uuid "6f875b91-463b-5b9e-b642-9334220d3e01" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2{(z-\\frac{7}{2})}^{2}-\\frac{49}{2}" :db/id #edb/ref 17592186319727} {:answer/id #uuid "78093d05-d766-51e5-bfbd-15a4b1ad83e3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2{(z-\\frac{7}{2})}^{2}+\\frac{67}{4}" :db/id #edb/ref 17592186319753} {:answer/id #uuid "b538e599-0c29-5367-95db-1d80a51d71e1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2{(z+\\frac{7}{2})}^{2}+\\frac{81}{2}" :db/id #edb/ref 17592186319948}] :answer-field/correct {:answer/id #uuid "b538e599-0c29-5367-95db-1d80a51d71e1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2{(z+\\frac{7}{2})}^{2}+\\frac{81}{2}" :db/id #edb/ref 17592186319948} :answer-field/id #uuid "9c1dc974-537c-5a19-8b0e-de4ef3bf427a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186320478}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "8b2f4df1-3e4e-5541-bb2f-d2b7890aaf73" :question/math-academy-id "q-35079" :question/problem "Rewrite $-2{z}^{2}-14z+16$ by completing the square." :question/worked-solution "Notice that the leading coefficient is $-2.$ So, we take out a factor of $-2$ from the entire expression:\n\n$$\n-2({z}^{2}+7z-8)\n$$\n\nLet's now complete the square for the expression inside the parentheses:\n\n$$\n{z}^{2}+7z-8\n$$\n\nFirst, we rewrite the coefficient of the linear term as a product with $2$ as a factor:\n\n$$\n{z}^{2}+2\\cdot \\frac{7}{2}\\cdot z-8\n$$\n\nThen, we *add* and *then subtract* ${(\\frac{7}{2})}^{2},$ writing the constant term $8$ last:\n\n$$\n{{z}^{2}+2\\cdot \\frac{7}{2}\\cdot z+{(\\frac{7}{2})}^{2}}_{⏟}-{(\\frac{7}{2})}^{2}-8\n$$\n\nThe first three terms form a perfect square, which we factor as follows:\n\n$$\n{(z+\\frac{7}{2})}^{2}-{(\\frac{7}{2})}^{2}-8\n$$\n\nEvaluating the last two terms, we get\n\n$$\n{(z+\\frac{7}{2})}^{2}-\\frac{81}{4}.\n$$\n\nFinally, we substitute this result back into our original expression::\n\n$$\n\\begin{aligned}-2({z}^{2}+7z-8) & =-2({(z+\\frac{7}{2})}^{2}-\\frac{81}{4}) \\\\  & =-2{(z+\\frac{7}{2})}^{2}+(-2)\\cdot (-\\frac{81}{4}) \\\\  & =-2{(z+\\frac{7}{2})}^{2}+\\frac{81}{2}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186106285 :knowledge-point/_questions [{:db/id #edb/ref 17592186105854 :knowledge-point/id #uuid "a5bea806-2913-57f5-ba32-be7aeda5bd15" :knowledge-point/title "Computing the Limit at Infinity of a Power Function With an Odd Power"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "15ff9d00-cfe3-5000-9f39-f5b084d00080" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186319455} {:answer/id #uuid "9035921e-6fcf-5772-b9a5-7d9a496b6106" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\infty " :db/id #edb/ref 17592186319823} {:answer/id #uuid "d6df4228-d351-594e-9eea-e865f3a883bc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\infty " :db/id #edb/ref 17592186320046} {:answer/id #uuid "dcc970a1-4ea5-589f-8352-ce90a07452c3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{4}" :db/id #edb/ref 17592186320063} {:answer/id #uuid "f9a74ebb-b1db-5cf0-a20e-5165336efc1a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\text{DNE}" :db/id #edb/ref 17592186320137}] :answer-field/correct {:answer/id #uuid "d6df4228-d351-594e-9eea-e865f3a883bc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\infty " :db/id #edb/ref 17592186320046} :answer-field/id #uuid "1cb04ca6-e219-5d5e-ab67-487f7d66d988" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186320233}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "7c7529a5-2ffe-53f0-9bca-cd9b5d97a802" :question/math-academy-id "q-35192" :question/problem "Evaluate ${lim}_{x\\to -\\infty }(-\\frac{{x}^{5}}{4}).$" :question/worked-solution "First, we note that\n\n$$\n\\begin{aligned}{lim}_{x\\to -\\infty }-\\frac{{x}^{5}}{4} & ={lim}_{x\\to -\\infty }(-\\frac{1}{4}\\cdot {x}^{5}) \\\\  & =-\\frac{1}{4}\\cdot {lim}_{x\\to -\\infty }{x}^{5}.\\end{aligned}\n$$\n\nThe graph $y={x}^{5}$ is power function with an odd positive power and therefore has the property that\n\n$$\n{lim}_{x\\to -\\infty }{x}^{5}=-\\infty .\n$$\n\nMultiplication by the negative constant $-\\frac{1}{4}$ changes the sign of the limit. \nSo, we have\n\n$$\n\\begin{aligned}-\\frac{1}{4}\\cdot {lim}_{x\\to -\\infty }{x}^{5} & =-{lim}_{x\\to -\\infty }{x}^{5}=\\infty .\\end{aligned}\n$$\n\nTherefore, we conclude that\n\n$$\n{lim}_{x\\to -\\infty }(-\\frac{{x}^{5}}{4})=\\infty .\n$$"}] [{:db/id #edb/ref 17592186320960 :knowledge-point/_questions [{:db/id #edb/ref 17592186078416 :knowledge-point/id #uuid "40a70c8d-dc8e-52bd-a679-ffd6d1940451" :knowledge-point/title "Finding the Inverse of a Function With a Parameter"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0b9b836c-fae2-50e0-a795-3a27cfdd5785" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{f}^{-1}(x)=\\frac{x+a}{7}" :db/id #edb/ref 17592186319421} {:answer/id #uuid "3492000c-c2fa-51a4-bcee-24c414d9ca52" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{f}^{-1}(x)=7x-a" :db/id #edb/ref 17592186319554} {:answer/id #uuid "8d3d6dcf-2ec9-5287-a8ef-e92f9f472281" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{f}^{-1}(x)=\\frac{x-7}{a}" :db/id #edb/ref 17592186319812} {:answer/id #uuid "ccb04d9c-7b29-5181-b95e-06fc65228ede" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{f}^{-1}(x)=\\frac{x+7}{a}" :db/id #edb/ref 17592186320017} {:answer/id #uuid "d00e46ee-e183-5993-a320-dcbaa9aa4eae" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{f}^{-1}(x)=\\frac{x-a}{7}" :db/id #edb/ref 17592186320030}] :answer-field/correct {:answer/id #uuid "ccb04d9c-7b29-5181-b95e-06fc65228ede" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{f}^{-1}(x)=\\frac{x+7}{a}" :db/id #edb/ref 17592186320017} :answer-field/id #uuid "c5d4e30f-32ac-5460-b456-38e5a87775f1" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186320578}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "abfc488e-a974-5dbc-b40c-2f281295336b" :question/math-academy-id "q-35217" :question/problem "Find the inverse of the function $f(x)=ax-7$, where $a$ is a non-zero constant." :question/worked-solution "To find the inverse of a function, we follow these steps:\n\n**Step 1:** Replace $f(x)$ with $y$:\n\n$$\ny=ax-7\n$$\n\n**Step 2:** Swap $x$ and $y$:\n\n$$\nx=ay-7\n$$\n\n**Step 3:** Solve for $y$:\n\n$$\n\\begin{aligned}x & =ay-7 \\\\ x+7 & =ay \\\\ \\frac{x+7}{a} & =y\\end{aligned}\n$$\n\n**Step 4:** Replace $y$ with ${f}^{-1}(x)$:\n\n$$\n{f}^{-1}(x)=\\frac{x+7}{a}\n$$"}] [{:db/id #edb/ref 17592186320986 :knowledge-point/_questions [{:db/id #edb/ref 17592186105849 :knowledge-point/id #uuid "4974097a-95c9-5835-ba1d-46480efab66b" :knowledge-point/title "Computing the Limit at Infinity of a Power Function With an Even Power"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3ccc7bce-8234-5ee1-bd8b-2bcdd3fcbd07" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\infty " :db/id #edb/ref 17592186319574} {:answer/id #uuid "574ba857-9f96-590d-abdc-bb096d802847" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{3}" :db/id #edb/ref 17592186319648} {:answer/id #uuid "ac7a7fe3-5133-5ba3-baf2-2c6b2e00ce1a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\text{DNE}" :db/id #edb/ref 17592186319916} {:answer/id #uuid "e1c8a647-b5b3-5af4-85b7-661bdc068c81" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\infty " :db/id #edb/ref 17592186320074} {:answer/id #uuid "f8b296d9-adc9-527b-a4b4-ccaabe649e19" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186320133}] :answer-field/correct {:answer/id #uuid "3ccc7bce-8234-5ee1-bd8b-2bcdd3fcbd07" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\infty " :db/id #edb/ref 17592186319574} :answer-field/id #uuid "5e14ff5e-6a4f-5e24-8876-c8a24ddf7181" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186320361}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "1ffa1d84-420d-51e5-b5d5-2102976566da" :question/math-academy-id "q-35243" :question/problem "![](images/67/67b77d2d3798e87593c7dddeea93603fff36d9153f53248cc2dab295f4879321.png)\n\nThe figure above shows the graph of $f(x).$ Find ${lim}_{x\\to -\\infty }\\frac{{x}^{2}}{f(x)}.$" :question/worked-solution "Applying the product rule and the quotient rule, we have\n\n$$\n\\begin{aligned}{lim}_{x\\to -\\infty }\\frac{{x}^{2}}{f(x)} & ={lim}_{x\\to -\\infty }({x}^{2}\\cdot \\frac{1}{f(x)}) \\\\  & ={lim}_{x\\to -\\infty }{x}^{2}\\cdot ({lim}_{x\\to -\\infty }\\frac{1}{f(x)}) \\\\  & ={lim}_{x\\to -\\infty }{x}^{2}\\cdot \\frac{1}{({lim}_{x\\to -\\infty }f(x))}\\end{aligned}\n$$\n\nFrom the graph, we get that ${lim}_{x\\to -\\infty }f(x)=3.$ Therefore, the above becomes:\n\n$$\n\\begin{aligned}{lim}_{x\\to -\\infty }\\frac{{x}^{2}}{f(x)} & ={lim}_{x\\to -\\infty }{x}^{2}\\cdot (\\frac{1}{3}) \\\\  & ={lim}_{x\\to -\\infty }\\frac{1}{3}{x}^{2} \\\\  & =\\frac{1}{3}\\cdot {lim}_{x\\to -\\infty }{x}^{2}\\end{aligned}\n$$\n\nThe graph $y={x}^{2}$ is an upward parabola, so\n\n$$\n{lim}_{x\\to -\\infty }{x}^{2}=\\infty .\n$$\n\nMultiplication by the positive constant $\\frac{1}{3}$ does not change the sign of the limit. So, we have\n\n$$\n\\begin{aligned}{lim}_{x\\to -\\infty }(\\frac{1}{3}{x}^{2})={lim}_{x\\to -\\infty }({x}^{2})=\\infty .\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186078876 :knowledge-point/_questions [{:db/id #edb/ref 17592186078416 :knowledge-point/id #uuid "40a70c8d-dc8e-52bd-a679-ffd6d1940451" :knowledge-point/title "Finding the Inverse of a Function With a Parameter"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "28a8e3f3-e6e5-59bd-9144-f9733223829f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{f}^{-1}(x)=ax-11a" :db/id #edb/ref 17592186319519} {:answer/id #uuid "8ee8eb52-9b9f-56f1-9ecb-13190d21a579" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{f}^{-1}(x)=ax-11" :db/id #edb/ref 17592186319819} {:answer/id #uuid "b056fbea-f31f-565e-a6ee-a22a4a856c27" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{f}^{-1}(x)=ax+11" :db/id #edb/ref 17592186319927} {:answer/id #uuid "b321e6e4-fc1e-54d2-9a1a-305a18b80a61" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{f}^{-1}(x)=ax+11a" :db/id #edb/ref 17592186319939} {:answer/id #uuid "b495768c-d594-5351-a058-aad82b451854" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{f}^{-1}(x)=x+11a" :db/id #edb/ref 17592186319945}] :answer-field/correct {:answer/id #uuid "28a8e3f3-e6e5-59bd-9144-f9733223829f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{f}^{-1}(x)=ax-11a" :db/id #edb/ref 17592186319519} :answer-field/id #uuid "1f5fa981-8f9f-5e72-b3b9-955186ce41e6" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186320236}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "40530ca3-e238-5640-94b0-1433afa01d34" :question/math-academy-id "q-35310" :question/problem "Find the inverse of the function $f(x)=\\frac{x}{a}+11$, where $a$ is a non-zero constant." :question/worked-solution "To find the inverse of a function, we follow these steps:\n\n**Step 1:** Replace $f(x)$ with $y$:\n\n$$\ny=\\frac{x}{a}+11\n$$\n\n**Step 2:** Swap $x$ and $y$:\n\n$$\nx=\\frac{y}{a}+11\n$$\n\n**Step 3:** Solve for $y$:\n\n$$\n\\begin{aligned}x & =\\frac{y}{a}+11 \\\\ x-11 & =\\frac{y}{a} \\\\ a(x-11) & =y \\\\ ax-11a & =y\\end{aligned}\n$$\n\n**Step 4:** Replace $y$ with ${f}^{-1}(x)$:\n\n$$\n{f}^{-1}(x)=ax-11a\n$$"}] [{:db/id #edb/ref 17592186402402 :knowledge-point/_questions [{:db/id #edb/ref 17592186105857 :knowledge-point/id #uuid "fc04f720-28f3-55ab-8e89-582db57672a4" :knowledge-point/title "Computing the Limit at Infinity of a General Polynomial"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "185960eb-bfc4-5b04-9b8e-889e9fa563fe" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\infty " :db/id #edb/ref 17592186402404} {:answer/id #uuid "f7e16aa5-8900-58f3-8772-5eddc1069f2c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\infty " :db/id #edb/ref 17592186402405} {:answer/id #uuid "de3fec5a-67b7-579c-a809-55a0c1f4c2ee" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "7" :db/id #edb/ref 17592186402406} {:answer/id #uuid "10adf48f-3c4e-533f-ba78-f17c436ead07" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\text{DNE}" :db/id #edb/ref 17592186402407} {:answer/id #uuid "8d0475d5-57f8-5642-b3fc-c1fb1233e0f2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186402408}] :answer-field/correct {:answer/id #uuid "f7e16aa5-8900-58f3-8772-5eddc1069f2c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\infty " :db/id #edb/ref 17592186402405} :answer-field/id #uuid "181f4699-3530-5c7f-a1cf-43e09f53ac45" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186402403}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "da57a6bc-d0db-59f4-81d7-c54fef1172ef" :question/math-academy-id "q-35379" :question/problem "Evaluate ${lim}_{x\\to -\\infty }(-{x}^{4}+3).$" :question/worked-solution "We identify the leading term and compute its limit:\n\n$$\n\\begin{aligned}{lim}_{x\\to -\\infty }(-{x}^{4}+3) & ={lim}_{x\\to -\\infty }(-{x}^{4}) \\\\  & =-{lim}_{x\\to -\\infty }({x}^{4}) \\\\  & =-\\,(\\infty ) \\\\  & =-\\infty \\,.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186124911 :knowledge-point/_questions [{:db/id #edb/ref 17592186124663 :knowledge-point/id #uuid "ee15db10-b92c-5f48-8983-e602068c7e08" :knowledge-point/title "Identifying the Horizontal Asymptote of a Rational Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "349d6fca-cfd5-5899-97f9-619f38ffc399" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=0" :db/id #edb/ref 17592186321547} {:answer/id #uuid "ce6ce2ac-2a25-54b2-839c-b1cc6290b561" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=2" :db/id #edb/ref 17592186322759} {:answer/id #uuid "d539cb73-cc46-54a7-951a-365d9f621a83" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=1" :db/id #edb/ref 17592186322807} {:answer/id #uuid "e2c15bef-666c-5440-98b0-35f3376a287f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "No horizontal asymptote" :db/id #edb/ref 17592186322920} {:answer/id #uuid "ebb9dd70-fd1d-55b4-8e19-6849ed66d65b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=\\frac{1}{2}" :db/id #edb/ref 17592186322993}] :answer-field/correct {:answer/id #uuid "349d6fca-cfd5-5899-97f9-619f38ffc399" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=0" :db/id #edb/ref 17592186321547} :answer-field/id #uuid "d568f8c0-9a4c-5bd9-a0d2-159cca6bb4c9" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186323591}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "24c1ddd3-5086-5a99-bc61-14c84e2545e8" :question/math-academy-id "q-35763" :question/problem "Find the horizontal asymptote of the function $f(x)=\\frac{2x+5}{2{x}^{3}+2x+6}.$" :question/worked-solution "The horizontal asymptote is $y={lim}_{x\\to \\infty }f(x).$ To find the horizontal asymptote, we apply the usual procedure of dividing the numerator and denominator by the highest power of $x$ in the denominator, which is ${x}^{3}.$\n\n$$\n\\begin{aligned}{lim}_{x\\to \\infty }f(x) & ={lim}_{x\\to \\infty }\\frac{2x+5}{2{x}^{3}+2x+6} \\\\  & ={lim}_{x\\to \\infty }\\frac{(\\frac{2x}{{x}^{3}}+\\frac{5}{{x}^{3}})}{(\\frac{2{x}^{3}}{{x}^{3}}+\\frac{2x}{{x}^{3}}+\\frac{6}{{x}^{3}})} \\\\  & ={lim}_{x\\to \\infty }\\frac{(\\frac{2}{{x}^{2}}+\\frac{5}{{x}^{3}})}{(2+\\frac{2}{{x}^{2}}+\\frac{6}{{x}^{3}})} \\\\  & =\\frac{0+0}{2+0+0} \\\\  & =0.\\end{aligned}\n$$\n\n \n\nTherefore, the horizontal asymptote of $f(x)$ is $y=0.$"}] [{:db/id #edb/ref 17592186124921 :knowledge-point/_questions [{:db/id #edb/ref 17592186124664 :knowledge-point/id #uuid "bde258b7-1654-5e73-8703-0e42371db8f4" :knowledge-point/title "Identifying When a Rational Function has No Horizontal Asymptote"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "544fe8c0-00d7-5582-9b43-a7537bdb2cd4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "No horizontal asymptote" :db/id #edb/ref 17592186321810} {:answer/id #uuid "8d44af16-7047-5688-8bee-4018f24233a6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=-1" :db/id #edb/ref 17592186322274} {:answer/id #uuid "b0f05e28-da65-5e0b-9cd3-41729a024a5d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=1" :db/id #edb/ref 17592186322534} {:answer/id #uuid "b324732c-ba06-52ac-9465-f950f027ee85" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=0" :db/id #edb/ref 17592186322547} {:answer/id #uuid "d8824ca2-db5e-5819-9375-3a960341c205" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=-3" :db/id #edb/ref 17592186322841}] :answer-field/correct {:answer/id #uuid "544fe8c0-00d7-5582-9b43-a7537bdb2cd4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "No horizontal asymptote" :db/id #edb/ref 17592186321810} :answer-field/id #uuid "1017af27-6db1-5bfd-9bf5-b120516afb73" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186323200}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "d5a61e3c-7091-5d14-ae25-993daf76ef12" :question/math-academy-id "q-35834" :question/problem "Find the horizontal asymptote of $y=f(x)$ where $f(x)=\\frac{12x-3{x}^{4}}{3{x}^{2}+7}.$" :question/worked-solution "The horizontal asymptote is $y={lim}_{x\\to \\infty }f(x).$ To find the horizontal asymptote, we apply the usual procedure of dividing the numerator and denominator by the highest power of $x$ in the denominator, which is ${x}^{2}.$\n\n$$\n\\begin{aligned}{lim}_{x\\to \\infty }f(x) & ={lim}_{x\\to \\infty }\\frac{12x-3{x}^{4}}{3{x}^{2}+7} \\\\  & {lim}_{x\\to \\infty }\\frac{(\\frac{12x}{{x}^{2}}-\\frac{3{x}^{4}}{{x}^{2}})}{(\\frac{3{x}^{2}}{{x}^{2}}+\\frac{7}{{x}^{2}})} \\\\  & ={lim}_{x\\to \\infty }\\frac{(\\frac{12}{x}-3{x}^{2})}{(3+\\frac{7}{{x}^{2}})} \\\\  & ={lim}_{x\\to \\infty }\\frac{0-3{x}^{2}}{3+0} \\\\  & ={lim}_{x\\to \\infty }(-{x}^{2}) \\\\  & =-\\infty .\\end{aligned}\n$$\n\n \n\nThe limit does not come out to a finite number. Therefore, there is no horizontal asymptote."}] [{:db/id #edb/ref 17592186323737 :knowledge-point/_questions [{:db/id #edb/ref 17592186124473 :knowledge-point/id #uuid "ffd143c8-a993-5d0b-85a5-821d6482ae60" :knowledge-point/title "Identifying the Intervals on Which a Function is Invertible Given Its Graph"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7739ff43-c68c-58ca-8bbe-3cf898ab85f6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186322081} {:answer/id #uuid "8d033687-0dda-5d24-a50d-81609e131df6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186322273} {:answer/id #uuid "8f052679-93df-563a-8c3a-49901beaf19d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186322283} {:answer/id #uuid "cc2a112f-a59c-5195-8734-7545ee263058" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186322736} {:answer/id #uuid "eefd406f-e3a9-51c3-9df4-f6d2a447cae1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186323031}] :answer-field/correct {:answer/id #uuid "eefd406f-e3a9-51c3-9df4-f6d2a447cae1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186323031} :answer-field/id #uuid "661e0d23-dac0-58fe-aeb6-82bf0e4b60b3" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186323373}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "544516cf-cdec-5de8-af07-1ff7e5be101e" :question/math-academy-id "q-36004" :question/problem "![](images/15/1597ad53471d0d9b44812c5caa31bcb160cfa150d1df9a9314447fa49e62ccff.png)\n\nOn which of the following intervals is the function $f(x)$ (shown above) invertible?\n\n- $x\\in [-6,0]$\n- $x\\in [-6,4)$\n- $x\\in [4,10)$" :question/worked-solution "A function is invertible on a particular interval if and only if it's a one-to-one function on that interval. To determine the intervals on which the function is invertible, we use the horizontal line test.  \n\n- The given function is invertible on each of the intervals $x\\in [-6,0]$ and $x\\in [4,10).$ Indeed, any horizontal line will intersect the curve at most once, no matter where we draw the line.\n\n![](images/7c/7cb282e3fa66af801ff03816973d5f5f1d0cb41e39d08a8addd27d7aa9c5b9df.png)\n\n      \n\n- The given function is **not** invertible on the interval $[-6,4]$  because some horizontal lines will intersect the curve more than once.\n\n![](images/00/000953609a7b3e13ad09473ead62f96aa895c7f94aa618884e69883595004fd4.png)\n\n \n\n Therefore, the correct answer is \"I  and III only\"."}] [{:db/id #edb/ref 17592186323742 :knowledge-point/_questions [{:db/id #edb/ref 17592186124473 :knowledge-point/id #uuid "ffd143c8-a993-5d0b-85a5-821d6482ae60" :knowledge-point/title "Identifying the Intervals on Which a Function is Invertible Given Its Graph"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "014f6668-666f-5040-a144-715105254126" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186321160} {:answer/id #uuid "26c34079-b0a6-5fc3-9a77-ee93f052ff20" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186321452} {:answer/id #uuid "80353f56-f611-551a-b4e9-abf19a92d1af" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186322153} {:answer/id #uuid "968df320-cd19-54ac-b971-d412835fd3ac" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186322348} {:answer/id #uuid "f59bf802-b4bc-54f8-8889-7338410f2cd0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186323072}] :answer-field/correct {:answer/id #uuid "80353f56-f611-551a-b4e9-abf19a92d1af" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186322153} :answer-field/id #uuid "28b86894-2e1c-5167-ac3e-a4dd5b6514f1" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186323253}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "d31db013-e3f7-5fe2-aefa-8428da418673" :question/math-academy-id "q-36011" :question/problem "![](images/b0/b02c2e94e144935f0ff96846cd51b5a969fa8f884a7ca1d09abb231b7c945232.png)\n\nOn which of the following intervals is the function $f(x)$ (shown above) invertible? \n\n- $x\\in (-4,-2)$\n- $x\\in [-2,3]$\n- $x\\in [-3,3]$" :question/worked-solution "A function is invertible on a particular interval if and only if it's a one-to-one function on that interval. To determine the intervals on which the function is invertible, we use the horizontal line test.  \n\n- The given function is invertible on each of the intervals $x\\in (-4,-2)$ and $x\\in [-2,3].$ Indeed, any horizontal line will intersect the curve at most once, no matter where we draw the line.\n\n![](images/53/53fe88780b2ccb7522d2f1baa711162ec99300c2a2d4da29bba9ca532026cd07.png)\n\n- The given function is **not** invertible on  the interval $x\\in [-3,3]$  because some lines will  intersect the curve at more than one point.\n\n![](images/63/63cee4fc05ab17a8e69d9bfae578fa83c24d73e4677065a54a33a25e0871e718.png)\n\nTherefore, the correct answer is \"I and II only\"."}] [{:db/id #edb/ref 17592186323810 :knowledge-point/_questions [{:db/id #edb/ref 17592186157432 :knowledge-point/id #uuid "29435c7e-2913-51cb-b1ca-bb88c5109d0a" :knowledge-point/title "Solving an Inequality with Exponential Functions on Both Sides"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "03f3bfa4-c874-5502-b110-2b8c72d11d3c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x\\ge \\frac{2\\operatorname{ln}⁡5-\\operatorname{ln}⁡4}{3\\operatorname{ln}⁡5+2\\operatorname{ln}⁡4}" :db/id #edb/ref 17592186321187} {:answer/id #uuid "0676db20-db96-5e83-9dd9-af9bc2d62d2a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x\\ge \\frac{\\operatorname{ln}⁡3-\\operatorname{ln}⁡4}{3\\operatorname{ln}⁡5-2\\operatorname{ln}⁡4}" :db/id #edb/ref 17592186321198} {:answer/id #uuid "89cc5679-849e-548d-a951-2998d3ec013f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x\\le \\frac{\\operatorname{ln}⁡3+2\\operatorname{ln}⁡5-\\operatorname{ln}⁡4}{3\\operatorname{ln}⁡5-2\\operatorname{ln}⁡4}" :db/id #edb/ref 17592186322248} {:answer/id #uuid "c04ceba5-0448-5d21-beab-cccea2bd0eea" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x\\le \\frac{2\\operatorname{ln}⁡5+\\operatorname{ln}⁡4}{3\\operatorname{ln}⁡5-2\\operatorname{ln}⁡4}" :db/id #edb/ref 17592186322641} {:answer/id #uuid "ea682fc8-18e7-53c1-b083-08279d59916f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x\\le \\frac{\\operatorname{ln}⁡3+\\operatorname{ln}⁡5-\\operatorname{ln}⁡4}{\\operatorname{ln}⁡5+2\\operatorname{ln}⁡4}" :db/id #edb/ref 17592186322983}] :answer-field/correct {:answer/id #uuid "89cc5679-849e-548d-a951-2998d3ec013f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x\\le \\frac{\\operatorname{ln}⁡3+2\\operatorname{ln}⁡5-\\operatorname{ln}⁡4}{3\\operatorname{ln}⁡5-2\\operatorname{ln}⁡4}" :db/id #edb/ref 17592186322248} :answer-field/id #uuid "87a0d8da-f7a1-5f82-9cfc-3a0cc85e80a1" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186323436}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "3f36893d-e053-5d18-beeb-2f0d972c9d98" :question/math-academy-id "q-365323" :question/problem "Solve the inequality ${4}^{1-2x}\\le 3\\cdot {5}^{2-3x}.$" :question/worked-solution "Taking the natural logarithm of both sides and applying the laws of logarithms, we get the following:\n\n$$\n\\begin{aligned}{4}^{1-2x} & \\le 3\\cdot {5}^{2-3x} \\\\ \\operatorname{ln}⁡({4}^{1-2x}) & \\le \\operatorname{ln}⁡(3\\cdot {5}^{2-3x}) \\\\ \\operatorname{ln}⁡({4}^{1-2x}) & \\le \\operatorname{ln}⁡(3)+\\operatorname{ln}⁡({5}^{2-3x}) \\\\ (1-2x)\\operatorname{ln}⁡4 & \\le \\operatorname{ln}⁡3+(2-3x)\\operatorname{ln}⁡5 \\\\ \\operatorname{ln}⁡4-2x\\operatorname{ln}⁡4 & \\le \\operatorname{ln}⁡3+2\\operatorname{ln}⁡5-3x\\operatorname{ln}⁡5 \\\\ 3x\\operatorname{ln}⁡5-2x\\operatorname{ln}⁡4 & \\le \\operatorname{ln}⁡3+2\\operatorname{ln}⁡5-\\operatorname{ln}⁡4 \\\\ x(3\\operatorname{ln}⁡5-2\\operatorname{ln}⁡4) & \\le \\operatorname{ln}⁡3+2\\operatorname{ln}⁡5-\\operatorname{ln}⁡4 \\\\ x & \\le \\frac{\\operatorname{ln}⁡3+2\\operatorname{ln}⁡5-\\operatorname{ln}⁡4}{3\\operatorname{ln}⁡5-2\\operatorname{ln}⁡4}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186402495 :knowledge-point/_questions [{:db/id #edb/ref 17592186100979 :knowledge-point/id #uuid "9bc794c7-cd0c-5ebc-aa11-9b82e72905fd" :knowledge-point/title "Computing Limits of Piecewise Functions with a Gap in the Domain"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f6489f85-c078-529a-bb89-256282a9a13d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{lim}_{x\\to \\,{0}^{-}}f(x)=0,\\,{lim}_{x\\to \\,{0}^{+}}f(x)=1" :db/id #edb/ref 17592186402497} {:answer/id #uuid "4ee1227f-4f52-5de5-b34e-e560db110256" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{lim}_{x\\to \\,{0}^{-}}f(x)=\\text{DNE},\\,{lim}_{x\\to \\,{0}^{+}}f(x)=1" :db/id #edb/ref 17592186402498} {:answer/id #uuid "b65d528b-38e9-53d6-b9b7-00b8f1c5ac41" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{lim}_{x\\to \\,{0}^{-}}f(x)=1,\\,{lim}_{x\\to \\,{0}^{+}}f(x)=\\text{DNE}" :db/id #edb/ref 17592186402499} {:answer/id #uuid "e70c9d48-daf4-5c24-8f93-c596a8791141" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{lim}_{x\\to \\,{0}^{-}}f(x)=0,\\,{lim}_{x\\to \\,{0}^{+}}f(x)=\\text{DNE}" :db/id #edb/ref 17592186402500} {:answer/id #uuid "668245ac-4011-59ee-a836-e35d283d1eb2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{lim}_{x\\to \\,{0}^{-}}f(x)=\\text{DNE},\\,{lim}_{x\\to \\,{0}^{+}}f(x)=\\text{DNE}" :db/id #edb/ref 17592186402501}] :answer-field/correct {:answer/id #uuid "b65d528b-38e9-53d6-b9b7-00b8f1c5ac41" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{lim}_{x\\to \\,{0}^{-}}f(x)=1,\\,{lim}_{x\\to \\,{0}^{+}}f(x)=\\text{DNE}" :db/id #edb/ref 17592186402499} :answer-field/id #uuid "9766008d-bd13-5a70-b8fc-147a47588ba7" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186402496}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "65911f9a-fa00-54b8-9673-9586456d002e" :question/math-academy-id "q-36696" :question/problem "Find ${lim}_{x\\to \\,{0}^{+}}f(x)$ and ${lim}_{x\\to \\,{0}^{-}}f(x)$ for the function given by\n\n$$\nf(x)={\\begin{aligned}\\operatorname{sec}⁡x & \\text{ for }\\,-\\frac{\\pi }{2}<x<0 \\\\ \\operatorname{csc}⁡x & \\text{ for }\\,\\frac{\\pi }{2}<x<\\pi \\end{aligned}\n$$" :question/worked-solution "The right-sided limit ${lim}_{x\\to {0}^{+}}f(x)$ does not exist since $f(x)$ is not defined on the interval $x\\in (0,\\frac{\\pi }{2}).$ \n\nConsequently, \n\n$$\n{lim}_{x\\to {0}^{+}}f(x)=\\text{DNE}.\n$$\n\nApproaching $x=0$ from the left, we have $x<0,$ so we use the expression $f(x)=\\operatorname{sec}⁡x.$ We get\n\n$$\n\\begin{aligned}{lim}_{x\\to {0}^{-}}f(x) & ={lim}_{x\\to {0}^{-}}\\operatorname{sec}⁡x \\\\  & =\\operatorname{sec}⁡0 \\\\  & =1.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n{lim}_{x\\to {0}^{+}}f(x)=\\text{DNE},\\,{lim}_{x\\to {0}^{-}}f(x)=1.\n$$"}] [{:db/id #edb/ref 17592186323846 :knowledge-point/_questions [{:db/id #edb/ref 17592186100977 :knowledge-point/id #uuid "0995bfd4-20b1-5f12-9d1d-fcb180a6291e" :knowledge-point/title "Computing the One-Sided Limits of a Piecewise Function when the Limits Coincide"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "19ed57d1-1d91-544a-bdae-7940b7113ad5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{lim}_{x\\to (1/2)}f(x)=\\text{DNE}" :db/id #edb/ref 17592186321348} {:answer/id #uuid "877e8444-5a27-500f-a477-baed7db698bb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{lim}_{x\\to (1/2)}f(x)=2" :db/id #edb/ref 17592186322223} {:answer/id #uuid "964d5dce-dd1f-5775-a66c-aba0c11d0274" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{lim}_{x\\to (1/2)}f(x)=1" :db/id #edb/ref 17592186322343} {:answer/id #uuid "98de86f1-ea9d-579c-b52c-2a809a3accce" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{lim}_{x\\to (1/2)}f(x)=-4" :db/id #edb/ref 17592186322361} {:answer/id #uuid "e14ed661-5e3a-5437-bf1b-eb0a7535207c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{lim}_{x\\to (1/2)}f(x)=4" :db/id #edb/ref 17592186322907}] :answer-field/correct {:answer/id #uuid "e14ed661-5e3a-5437-bf1b-eb0a7535207c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{lim}_{x\\to (1/2)}f(x)=4" :db/id #edb/ref 17592186322907} :answer-field/id #uuid "bf487efd-f750-56a9-8fe4-aff8fa623557" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186323545}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "df0978e3-40c7-5749-aacd-3714af936e64" :question/math-academy-id "q-36720" :question/problem "Find the limit at $x=\\frac{1}{2}$ of the piecewise function $f(x)$ defined by\n\n$$\nf(x)={\\begin{aligned}6x+1\\, & \\text{ for }\\,x\\le \\frac{1}{2} \\\\ -4{log}_{2}⁡x\\, & \\text{ for }\\,x>\\frac{1}{2}.\\end{aligned}\n$$" :question/worked-solution "Approaching from the left, we have $x<\\frac{1}{2},$ so we use the expression $f(x)=6x+1.$ We get\n\n$$\n\\begin{aligned}{lim}_{x\\to {(1/2)}^{-}}f(x) & ={lim}_{x\\to {(1/2)}^{-}}(6x+1) \\\\  & =6\\cdot \\frac{1}{2}+1 \\\\  & =4.\\end{aligned}\n$$\n\nNow,  approaching from the right, we have $x>\\frac{1}{2},$ so we use the expression $f(x)=-4{log}_{2}⁡x.$ We get\n\n$$\n\\begin{aligned}{lim}_{x\\to {(1/2)}^{+}}f(x) & ={lim}_{x\\to {(1/2)}^{+}}-4{log}_{2}⁡x \\\\  & =-4{log}_{2}⁡\\frac{1}{2} \\\\  & =-4{log}_{2}⁡{2}^{-1} \\\\  & =-4(-1){log}_{2}⁡2 \\\\  & =-4(-1) \\\\  & =4.\\end{aligned}\n$$\n\nSince the left- and right-sided limits are equal to $4,$ we conclude that\n\n$$\n{lim}_{x\\to (1/2)}f(x)=4.\n$$"}] [{:db/id #edb/ref 17592186323847 :knowledge-point/_questions [{:db/id #edb/ref 17592186100978 :knowledge-point/id #uuid "bdd4a2e4-b0e6-54e8-972c-3dc194ce4ab3" :knowledge-point/title "Computing the One-Sided Limits of a Piecewise Function when the Limits Do Not Coincide"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0331564f-2588-501b-b00b-4bfc21903eab" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{lim}_{x\\to 3}f(x)=-1" :db/id #edb/ref 17592186321178} {:answer/id #uuid "26f8feb1-5ef3-5db8-83c3-0253bb71a162" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{lim}_{x\\to 3}f(x)=\\text{DNE}" :db/id #edb/ref 17592186321454} {:answer/id #uuid "30a31cb0-e610-5382-bc68-23ae87a10893" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{lim}_{x\\to 3}f(x)=1" :db/id #edb/ref 17592186321520} {:answer/id #uuid "8e9a9190-a31e-5666-90db-d2259e210b30" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{lim}_{x\\to 3}f(x)=2" :db/id #edb/ref 17592186322279} {:answer/id #uuid "e9e36c4d-2ff0-5296-a228-00cad37c904e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{lim}_{x\\to 3}f(x)=3" :db/id #edb/ref 17592186322977}] :answer-field/correct {:answer/id #uuid "26f8feb1-5ef3-5db8-83c3-0253bb71a162" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{lim}_{x\\to 3}f(x)=\\text{DNE}" :db/id #edb/ref 17592186321454} :answer-field/id #uuid "6db0b422-9f7f-5b42-ba98-b50b2a2c0d76" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186323389}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "2777af2b-a5d2-5c98-9043-4dca19a2df59" :question/math-academy-id "q-36724" :question/problem "Find the limit at $x=3$ for the function\n\n$$\nf(x)={\\begin{aligned}\\sqrt[3]{3x-1}\\, & \\text{ for }\\,x<3 \\\\ \\operatorname{cos}⁡(x\\pi )\\, & \\text{ for }\\,x\\ge 3.\\end{aligned}\n$$" :question/worked-solution "Approaching from the left, we have $x<3,$ so we use the expression $f(x)=\\sqrt[3]{3x-1}.$ We get\n\n$$\n\\begin{aligned}{lim}_{x\\to {3}^{-}}f(x) & ={lim}_{x\\to {3}^{-}}\\sqrt[3]{3x-1} \\\\  & =\\sqrt[3]{3\\cdot 3-1} \\\\  & =\\sqrt[3]{8} \\\\  & =2\\,.\\end{aligned}\n$$\n\nApproaching from the right, we have $x>3,$ so we use the expression $f(x)=\\operatorname{cos}⁡(x\\pi ).$ We get\n\n$$\n\\begin{aligned}{lim}_{x\\to {3}^{+}}f(x) & ={lim}_{x\\to {3}^{+}}\\operatorname{cos}⁡(x\\pi ) \\\\  & =\\operatorname{cos}⁡(3\\pi ) \\\\  & =-1\\,.\\end{aligned}\n$$\n\nSince the two limits are different, we can conclude that\n\n$$\n{lim}_{x\\to 3}f(x)=\\text{DNE}\n$$"}] [{:db/id #edb/ref 17592186402516 :knowledge-point/_questions [{:db/id #edb/ref 17592186124472 :knowledge-point/id #uuid "3bd13aa5-83a8-5b23-96cb-ea665039ea30" :knowledge-point/title "Identifying an Invertible Function From Its Graph"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "22d016a6-ae62-56e2-94ca-cf268596c630" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186402518} {:answer/id #uuid "07a9ea11-bf6b-5bd3-bc0f-8446bc1bf4cd" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186402519} {:answer/id #uuid "89edd0ab-89db-5aea-aa06-1774d0033938" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "None" :db/id #edb/ref 17592186402520} {:answer/id #uuid "bf173099-427d-522f-a04c-39870e96d661" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186402521} {:answer/id #uuid "5e473cc0-e97e-5768-bad0-fa0e92282062" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186402522}] :answer-field/correct {:answer/id #uuid "89edd0ab-89db-5aea-aa06-1774d0033938" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "None" :db/id #edb/ref 17592186402520} :answer-field/id #uuid "5ab0fae8-fb4f-560c-b176-a3a930105d51" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186402517}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "8cbc83e7-bc89-5609-b94a-0fe1dfb1bde0" :question/math-academy-id "q-36905" :question/problem "![](images/91/91f073fa77aab423ee33902451e61ad9f033b61b2a875b66ff69708d4361e24f.png)\n\nWhich of the graphs above correspond to an invertible function?" :question/worked-solution "A function is invertible if and only if it's a one-to-one function. To determine which of the functions are one-to-one, we use the horizontal line test.\n\nFrom the above, we see that in each of the four given graphs, some horizontal lines intersect the curve more than once. Therefore, these are not one-to-one functions. As a result, none of them correspond to an invertible function."}] [{:db/id #edb/ref 17592186125021 :knowledge-point/_questions [{:db/id #edb/ref 17592186124473 :knowledge-point/id #uuid "ffd143c8-a993-5d0b-85a5-821d6482ae60" :knowledge-point/title "Identifying the Intervals on Which a Function is Invertible Given Its Graph"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4caea11f-484f-50a4-a520-52df284329ac" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186321753} {:answer/id #uuid "54e75cb9-e5b0-5ea8-9eaf-304e5de715df" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186321816} {:answer/id #uuid "888f7548-fc8c-5732-aae9-9e3aa70555ca" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186322236} {:answer/id #uuid "c304d552-6f05-5067-a107-0c7b855a1c17" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186322661} {:answer/id #uuid "f99f1c2f-bc18-5796-a3e2-28f9f9b5b60a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186323112}] :answer-field/correct {:answer/id #uuid "888f7548-fc8c-5732-aae9-9e3aa70555ca" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186322236} :answer-field/id #uuid "9392c5de-5972-51d1-8356-6d7fe3ba1f53" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186323456}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "e891cfb3-f978-5b44-b8bf-4d4f9f71b503" :question/math-academy-id "q-36941" :question/problem "![](images/3c/3cbdac583a4cdf1b5eb761892934516a0b4edd1487bd402ae0014859c4a0ad53.png)\n\nOn which of the following intervals is the function $f(x)$ (shown above) invertible?\n\n- $x\\in (-2,0]$\n- $x\\in (-2,2]$\n- $x\\in [-4,-2]\\cup [2,4]$" :question/worked-solution "A function is invertible on a particular interval if and only if it's a one-to-one function on that interval. To determine the intervals on which the function is invertible, we use the horizontal line test.\n\n- The given function is invertible on the interval $x\\in (-2,0].$ Indeed, a horizontal line will intersect the curve at most once, no matter where we draw the line.\n\n![](images/d7/d7c6e8d314483ad67e89ce5d4675b7af27fa08c88a4ed9d95eed9ad2a4da51cc.png)\n\n- The given function is **not** invertible on the intervals $x\\in (-2,2]$ and $x\\in [-4,-2]\\cup [2,4]$ because some horizontal lines will intersect the curve more than once.\n\n![](images/ce/cee829f7e3d5f32b0acb54cb5c40406d8391d2a2967c68df0c1f5e1cae87d729.png)\n\nTherefore, the correct answer is \"I only\"."}]}
