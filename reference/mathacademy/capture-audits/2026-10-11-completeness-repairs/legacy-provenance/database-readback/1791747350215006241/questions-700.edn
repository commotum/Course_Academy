7592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186401926} {:answer/id #uuid "87f49733-d7a3-52db-ba58-c47681214494" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186401927}] :answer-field/correct {:answer/id #uuid "fc388d3c-f7de-526c-bae0-44297aa5c1a7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186401925} :answer-field/id #uuid "ae9fdfce-f210-5819-a39f-6d6ef14bee25" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186401922}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "fcb31a9b-9679-5d24-8bf7-7929bd2e8a6c" :question/math-academy-id "q-29163" :question/problem "Which of the following equations has no solutions for $0\\le x<2\\pi ?$\n\nI. $\\operatorname{sec}⁡x=1$\nII. $\\operatorname{sec}⁡x=2$\nIII. $\\operatorname{sec}⁡x=\\frac{1}{2}$" :question/worked-solution "Recall that the range of $\\operatorname{sec}⁡x$ for $0\\le x<2\\pi $ is given by\n\n$$\n\\operatorname{sec}⁡x\\in (-\\infty ,-1]\\cup [1,\\infty ).\n$$\n\nSo, the equation $\\operatorname{sec}⁡x=k$ has no solutions for $k\\in (-1,1).$ \n\nTherefore, of the given equations, only equation III has no solutions."}] [{:db/id #edb/ref 17592186115707 :knowledge-point/_questions [{:db/id #edb/ref 17592186115180 :knowledge-point/id #uuid "28062dbf-815b-5221-ae86-1050e106c5ea" :knowledge-point/title "Solving a Trigonometric Equation Involving Secant Under a Modified Domain"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "88a2376c-dc19-5dd0-a77a-56366a05b81d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-12000" :db/id #edb/ref 17592186113209} {:answer/id #uuid "c5a28036-b367-589e-9512-aab611b56f04" :answer/ty