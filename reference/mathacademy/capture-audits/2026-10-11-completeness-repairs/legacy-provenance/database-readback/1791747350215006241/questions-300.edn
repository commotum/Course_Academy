#{[{:db/id #edb/ref 17592186253628 :knowledge-point/_questions [{:db/id #edb/ref 17592186059673 :knowledge-point/id #uuid "5f9683d9-05b9-5a42-9f81-0170a15dfac1" :knowledge-point/title "Using the Double-Angle Formula to Simplify Ratios"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "024f4b95-a6a5-5f2d-a751-2755ac5cce12" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{csc}⁡(\\frac{\\pi }{8})" :db/id #edb/ref 17592186250575} {:answer/id #uuid "0e20a623-1450-54d0-9595-8a7aa3109a42" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}\\operatorname{sin}⁡(\\frac{\\pi }{8})" :db/id #edb/ref 17592186250675} {:answer/id #uuid "3a0ea007-0dad-5df4-93e4-28082fff80d0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\operatorname{csc}⁡(\\frac{\\pi }{4})" :db/id #edb/ref 17592186251033} {:answer/id #uuid "8f9f6191-c575-5400-985e-09588bd93769" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\operatorname{sin}⁡(\\frac{\\pi }{4})" :db/id #edb/ref 17592186251773} {:answer/id #uuid "adab3445-9088-5485-a515-0fc08abd7e3b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}\\operatorname{csc}⁡(\\frac{\\pi }{8})" :db/id #edb/ref 17592186252067}] :answer-field/correct {:answer/id #uuid "adab3445-9088-5485-a515-0fc08abd7e3b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}\\operatorname{csc}⁡(\\frac{\\pi }{8})" :db/id #edb/ref 17592186252067} :answer-field/id #uuid "8a4e8fb7-0cf4-569d-9a43-083899802b06" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186253044}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "11defe63-9b06-5fba-87b6-5807bf8b34d3" :question/math-academy-id "q-120018" :question/problem "$\\frac{\\operatorname{cos}⁡(\\frac{\\pi }{8})}{\\operatorname{sin}⁡(\\frac{\\pi }{4})}=$" :question/worked-solution "First, let's recall the double-angle formula for sine: \n\n$$\n\\operatorname{sin}⁡2x=2\\operatorname{sin}⁡x\\operatorname{cos}⁡x\n$$\n\nSubstituting $x=\\frac{\\pi }{8}$ into the above, we get\n\n$$\n\\operatorname{sin}⁡(2\\cdot \\frac{\\pi }{8})=2\\operatorname{sin}⁡(\\frac{\\pi }{8})\\operatorname{cos}⁡(\\frac{\\pi }{8})\n$$\n\nwhich simplifies as\n\n$$\n\\operatorname{sin}⁡(\\frac{\\pi }{4})=2\\operatorname{sin}⁡(\\frac{\\pi }{8})\\operatorname{cos}⁡(\\frac{\\pi }{8}).\n$$\n\nTherefore, we can simplify the given expression by rewriting the $\\operatorname{sin}⁡(\\frac{\\pi }{4})$ in the denominator, as follows:\n\n$$\n\\begin{aligned}\\frac{\\operatorname{cos}⁡(\\frac{\\pi }{8})}{\\operatorname{sin}⁡(\\frac{\\pi }{4})} & =\\frac{\\operatorname{cos}⁡(\\frac{\\pi }{8})}{2\\operatorname{sin}⁡(\\frac{\\pi }{8})\\operatorname{cos}⁡(\\frac{\\pi }{8})} \\\\  & =\\frac{\\cancel{\\operatorname{cos}⁡(\\frac{\\pi }{8})}}{2\\operatorname{sin}⁡(\\frac{\\pi }{8})\\cancel{\\operatorname{cos}⁡(\\frac{\\pi }{8})}} \\\\  & =\\frac{1}{2\\operatorname{sin}⁡(\\frac{\\pi }{8})} \\\\  & =\\frac{1}{2}\\operatorname{csc}⁡(\\frac{\\pi }{8}).\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186253632 :knowledge-point/_questions [{:db/id #edb/ref 17592186059673 :knowledge-point/id #uuid "5f9683d9-05b9-5a42-9f81-0170a15dfac1" :knowledge-point/title "Using the Double-Angle Formula to Simplify Ratios"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0a1adf34-b5ab-575a-b655-c479f3717df6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1+\\operatorname{cos}⁡{50}^{∘}" :db/id #edb/ref 17592186250640} {:answer/id #uuid "199a6b8d-c1b5-52ec-8d2b-338601436874" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1-\\operatorname{cos}⁡{50}^{∘}" :db/id #edb/ref 17592186250776} {:answer/id #uuid "38546a08-184f-5411-80ea-0b9a2a403009" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{cos}⁡{50}^{∘}-1" :db/id #edb/ref 17592186251022} {:answer/id #uuid "65f52443-c286-5605-b6f6-ab3d3b725230" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{cos}^{2}⁡{50}^{∘}" :db/id #edb/ref 17592186251392} {:answer/id #uuid "e2a2c78e-06dc-539e-b4e5-76443acce72b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1+{cos}^{2}⁡{50}^{∘}" :db/id #edb/ref 17592186252545}] :answer-field/correct {:answer/id #uuid "0a1adf34-b5ab-575a-b655-c479f3717df6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1+\\operatorname{cos}⁡{50}^{∘}" :db/id #edb/ref 17592186250640} :answer-field/id #uuid "c0d401dc-d0fa-51c1-b8e5-f54d86918a91" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186253138}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "df53af64-a7fb-5920-a9ae-4765f5d7236c" :question/math-academy-id "q-120029" :question/problem "$\\frac{\\operatorname{sin}⁡{100}^{∘}\\operatorname{tan}⁡{50}^{∘}}{2-2\\operatorname{cos}⁡{50}^{∘}}=$" :question/worked-solution "First, let's recall the double-angle formula for sine: \n\n$$\n\\operatorname{sin}⁡2x=2\\operatorname{sin}⁡x\\operatorname{cos}⁡x\n$$\n\nSubstituting $x={50}^{∘}$ into the above, we get\n\n$$\n\\begin{aligned}\\operatorname{sin}⁡(2\\cdot {50}^{∘}) & =2\\operatorname{sin}⁡{50}^{∘}\\operatorname{cos}⁡{50}^{∘} \\\\ \\operatorname{sin}⁡({100}^{∘}) & =2\\operatorname{sin}⁡{50}^{∘}\\operatorname{cos}⁡{50}^{∘}.\\end{aligned}\n$$\n\nNow, we can rewrite the given expression using the above, as follows:\n\n$$\n\\begin{aligned}\\frac{\\operatorname{sin}⁡{100}^{∘}\\operatorname{tan}⁡{50}^{∘}}{2-2\\operatorname{cos}⁡{50}^{∘}} & =\\frac{2\\operatorname{sin}⁡{50}^{∘}\\operatorname{cos}⁡{50}^{∘}\\cdot \\frac{\\operatorname{sin}⁡{50}^{∘}}{\\operatorname{cos}⁡{50}^{∘}}}{2-2\\operatorname{cos}⁡{50}^{∘}} \\\\  & =\\frac{2{sin}^{2}⁡{50}^{∘}}{2(1-\\operatorname{cos}⁡{50}^{∘})} \\\\  & =\\frac{{sin}^{2}⁡{50}^{∘}}{1-\\operatorname{cos}⁡{50}^{∘}}\\end{aligned}\n$$\n\nUsing  the Pythagorean identity ${sin}^{2}⁡{50}^{∘}=1-{cos}^{2}⁡{50}^{∘},$ we get\n\n$$\n\\begin{aligned}\\frac{{sin}^{2}⁡{50}^{∘}}{1-\\operatorname{cos}⁡{50}^{∘}} & =\\frac{1-{cos}^{2}⁡{50}^{∘}}{1-\\operatorname{cos}⁡{50}^{∘}} \\\\  & =\\frac{(1-\\operatorname{cos}⁡{50}^{∘})(1+\\operatorname{cos}⁡{50}^{∘})}{1-\\operatorname{cos}⁡{50}^{∘}} \\\\  & =\\frac{\\cancel{(1-\\operatorname{cos}⁡{50}^{∘})}(1+\\operatorname{cos}⁡{50}^{∘})}{\\cancel{1-\\operatorname{cos}⁡{50}^{∘}}} \\\\  & =1+\\operatorname{cos}⁡{50}^{∘}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186386973 :knowledge-point/_questions [{:db/id #edb/ref 17592186147618 :knowledge-point/id #uuid "1233be4b-7634-5882-9ae5-3200a9da71d8" :knowledge-point/title "Calculating the Surface Area of a Polyhedron Given the Areas of the Faces: Word Problems"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "27a702ee-79d1-55c6-8b8d-dc8a7f0f77db" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "336\\,{\\text{cm}}^{2}" :db/id #edb/ref 17592186386975} {:answer/id #uuid "3e5df382-1586-5105-af93-061d2effa30e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "324\\,{\\text{cm}}^{2}" :db/id #edb/ref 17592186386976} {:answer/id #uuid "b73a068b-a624-57c6-8f23-a62443cd2759" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "354\\,{\\text{cm}}^{2}" :db/id #edb/ref 17592186386977} {:answer/id #uuid "13ab4dd1-997e-50aa-8938-fe73f4c8d489" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "348\\,{\\text{cm}}^{2}" :db/id #edb/ref 17592186386978} {:answer/id #uuid "9f5375b8-a182-53a8-881e-1b45a8a8313f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "316\\,{\\text{cm}}^{2}" :db/id #edb/ref 17592186386979}] :answer-field/correct {:answer/id #uuid "3e5df382-1586-5105-af93-061d2effa30e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "324\\,{\\text{cm}}^{2}" :db/id #edb/ref 17592186386976} :answer-field/id #uuid "0f65bd7f-3d3f-5045-8487-612d7385d46c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186386974}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "2c2645ff-704d-5d0e-a816-127a2f8fd501" :question/math-academy-id "q-120078" :question/problem "![](images/8b/8b618c8e43dbe898a6e1c481f4f887a50bc2e8c658368876be11ec5ea269a50c.png)\n\nA company produces a chocolate bar that comes in an triangular-prism-shaped box. In the figure, the areas of some of the faces are displayed in a net of the prism. What is the total surface area of the box?" :question/worked-solution "The surface area of our prism consists of $2$ triangles (base and top) and $3$ rectangles (central and side faces). \n\nTherefore, we get\n\n$$\n\\begin{aligned}\\text{Surface area} & =2\\times (\\text{Area of the base})+2\\times (\\text{Area of the side faces}) \\\\  & +1\\times (\\text{Area of the central face}) \\\\  & =2\\times 36+2\\times 72+108 \\\\  & =72+144+108 \\\\  & =324\\,{\\text{cm}}^{2}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186395991 :knowledge-point/_questions [{:db/id #edb/ref 17592186087746 :knowledge-point/id #uuid "d8c04b23-e341-57e9-a072-985e4b536e5a" :knowledge-point/title "Identifying Linear Transformations"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "af31ad74-3d71-5216-82f4-241c0fe0d883" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I, II, and III" :db/id #edb/ref 17592186395993} {:answer/id #uuid "55344227-ef64-559d-b72e-d67580b900d1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186395994} {:answer/id #uuid "8c8d3009-744a-5594-85d0-81623acfa040" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186395995} {:answer/id #uuid "1acecbea-2330-5d66-8f7e-c711b7d73ea2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "None" :db/id #edb/ref 17592186395996} {:answer/id #uuid "cabd1c0f-3241-5f02-a31b-66428bbc54cc" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186395997}] :answer-field/correct {:answer/id #uuid "af31ad74-3d71-5216-82f4-241c0fe0d883" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I, II, and III" :db/id #edb/ref 17592186395993} :answer-field/id #uuid "e3af571d-ad32-5475-bbe0-4ca42f82e8b5" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186395992}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "d2b3861b-a381-5b7c-bc56-9232209a631c" :question/math-academy-id "q-12008" :question/problem "Let \n$T:[\\begin{aligned}x \\\\ y\\end{aligned}]⟶[\\begin{aligned}x+y \\\\ 4x+3y\\end{aligned}].$\nWhich of the following statements are true?\n\nI. $T(kv)=kT(v)$ for any real $2\\times 1$ column vector $v$ and real scalar $k$\nII. $T({v}_{1}+{v}_{2})=T({v}_{1})+T({v}_{2})$ for any real $2\\times 1$ column vectors ${v}_{1}$ and ${v}_{2}$\nIII. $T$ is a linear transformation" :question/worked-solution "A linear transformation $T$ satisfies two properties:\n\n$$\n\\begin{aligned} & T[\\begin{aligned}kx \\\\ ky\\end{aligned}]=kT[\\begin{aligned}x \\\\ y\\end{aligned}], \\\\  & T[\\begin{aligned}{x}_{1}+{x}_{2} \\\\ {y}_{1}+{y}_{2}\\end{aligned}]=T[\\begin{aligned}{x}_{1} \\\\ {y}_{1}\\end{aligned}]+T[\\begin{aligned}{x}_{2} \\\\ {y}_{2}\\end{aligned}].\\end{aligned}\n$$\n\n- Checking the first condition, we have\n\n$$\n\\begin{aligned}T[\\begin{aligned}kx \\\\ ky\\end{aligned}] & =[\\begin{aligned}kx+ky \\\\ 4kx+3ky\\end{aligned}] \\\\  & =k[\\begin{aligned}x+y \\\\ 4x+3y\\end{aligned}] \\\\  & =kT[\\begin{aligned}x \\\\ y\\end{aligned}].\\,✓\\end{aligned}\n$$\n\n- Checking the second condition, we have\n\n$$\n\\begin{aligned}T[\\begin{aligned}{x}_{1}+{x}_{2} \\\\ {y}_{1}+{y}_{2}\\end{aligned}] & =[\\begin{aligned}{x}_{1}+{x}_{2}+{y}_{1}+{y}_{2} \\\\ 4({x}_{1}+{x}_{2})+3({y}_{1}+{y}_{2})\\end{aligned}] \\\\  & =[\\begin{aligned}{x}_{1}+{y}_{1} \\\\ 4{x}_{1}+3{y}_{1}\\end{aligned}]+[\\begin{aligned}{x}_{2}+{y}_{2} \\\\ 4{x}_{2}+3{y}_{2}\\end{aligned}] \\\\  & =T[\\begin{aligned}{x}_{1} \\\\ {y}_{1}\\end{aligned}]+T[\\begin{aligned}{x}_{2} \\\\ {y}_{2}\\end{aligned}].\\,✓\\end{aligned}\n$$\n\nTherefore, $\\text{T}$ is a linear transformation.\n\nAs a result, all three statements are true."}] [{:db/id #edb/ref 17592186386987 :knowledge-point/_questions [{:db/id #edb/ref 17592186092220 :knowledge-point/id #uuid "c4034e61-63dc-5f72-8275-e9c81290767d" :knowledge-point/title "Identifying the Graph of a Polar Circle"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a6979975-c4fc-5dd6-a7c2-9f66b3cec100" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/9d/9d77180cde3a0c2ca1ad5187a6b64c6b7d0d282b0e673e24c50132d7e3d91ce3.png" :db/id #edb/ref 17592186386989} {:answer/id #uuid "3aebcf64-2103-5b69-9394-e1bc7f1d2130" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/72/725d3670d3f2e50a9359e1573b3acf3d947b75f2318b8f84687a19d3f31825