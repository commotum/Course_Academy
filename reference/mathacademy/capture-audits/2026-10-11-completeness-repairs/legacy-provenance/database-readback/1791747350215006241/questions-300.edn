lds [{:answer-field/choices [{:answer/id #uuid "553e0164-69a4-571b-83c5-465b3b54c747" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$P$ and $R$ only" :db/id #edb/ref 17592186400207} {:answer/id #uuid "340d28a9-ac24-51ee-a63d-8b51e38606b5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "None" :db/id #edb/ref 17592186400208} {:answer/id #uuid "78a35f41-30f5-5c39-b8bd-a9e3ffc633f6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$Q$ only" :db/id #edb/ref 17592186400209} {:answer/id #uuid "21a84219-2aac-5deb-8cdc-11cd02b9b263" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$P$ only" :db/id #edb/ref 17592186400210} {:answer/id #uuid "f7e6c06f-a2ea-57cc-a6b1-d8e81a150186" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$P$ and $Q$ only" :db/id #edb/ref 17592186400211}] :answer-field/correct {:answer/id #uuid "340d28a9-ac24-51ee-a63d-8b51e38606b5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "None" :db/id #edb/ref 17592186400208} :answer-field/id #uuid "c7e2e824-6270-5a22-9f66-f3228d3b14f7" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186400206}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "8674af78-bd5e-58b6-917b-e86f01702cc2" :question/math-academy-id "q-126222" :question/problem "Which of the following are diagonal matrices?\n\n$$\nP=[\\begin{aligned}1 & 0 & 0 & 0 \\\\ 0 & 1 & 0 & 0\\text{ }\\end{aligned}],\\,Q=[\\begin{aligned}1 & 2 \\\\ 1 & 2 \\\\ 1 & 2 \\\\ 2 & 1\\end{aligned}],\\,R=[\\begin{aligned}1 & 0 & 5 \\\\ 0 & -2 & 0 \\\\ 7 & 0 & -3\\end{aligned}]\n$$" :question/worked-solution "- $P$ is *not* a diagonal matrix since it's not a square matrix.\n\n- $Q$ is *not* a diagonal matrix since it's not a square matrix.\n\n- $R$ is *not* a diagonal matrix. It's a square matrix since it has the same number of rows and columns. But some of the entries that do not lie on the main diagonal are not zeros (for instance, ${r}_{31}=7\\ne 0$).\n\nTherefore, none of the given are diagonal matrices."}] [{:db/id #edb/ref 17592186400212 :knowledge-point/_questions [{:db/id #edb/ref 17592186087696 :knowledge-point/id #uuid "3ca13445-0218-5950-967e-a68bcfec32c7" :knowledge-point/title "Identifying a Square Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7a1baaae-52d0-516b-a600-797b0388a127" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$A$ and $C$ only" :db/id #edb/ref 17592186400214} {:answer/id #uuid "58de69df-cd32-5f8f-af98-12f470c70f21" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$A$ only" :db/id #edb/ref 17592186400215} {:answer/id #uuid "a552f5cd-8b45-5e90-b478-e07b0a27d36d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "None" :db/id #edb/ref 17592186400216} {:answer/id #uuid "89ac50ef-c4ba-518c-8394-d2674f51bbdf" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$A$ and $B$ only" :db/id #edb/ref 17592186400217} {:answer/id #uuid "78dd51ac-64a5-503e-bd20-319def136b11" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$B$ only" :db/id #edb/ref 17592186400218}] :answer-field/correct {:answer/id #uuid "89ac50ef-c4ba-518c-8394-d2674f51bbdf" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$A$ and $B$ only" :db/id #edb/ref 17592186400217} :answer-field/id #uuid "9197f330-4826-5c7c-93a0-be4b4589ea86" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186400213}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "b1fe65ee-e4c1-507a-9313-0ea6b012c1aa" :question/math-academy-id "q-126278" :question/problem "Which of the following are square matrices?\n\n$$\nA=[\\begin{aligned}-1\\end{aligned}],\\,B=[\\begin{aligned}1 & 1 & 1 \\\\ 2 & 4 & 2 \\\\ -2 & 2 & 1\\end{aligned}],\\,C=[\\begin{aligned}2 & 1\\end{aligned}]\n$$" :question/worked-solution "- $A$ is a square matrix since it has the same number of rows and columns. It has $1$ row and $1$ column, so it is a $1\\times 1$ matrix.\n\n- $B$ is a square matrix since it has the same number of rows and columns. It has $3$ rows and $3$ columns, so it is a $3\\times 3$ matrix.\n\n- $C$ is *not* a square matrix since the numbers of rows and columns are not the same. It has $1$ row and $2$ columns, so it's a $1\\times 2$ matrix.\n\nTherefore, only $A$ and $B$ are square matrices."}] [{:db/id #edb/ref 17592186400219 :knowledge-point/_questions [{:db/id #edb/ref 17592186087698 :knowledge-point/id #uuid "7b6ddadb-471a-5195-a0f5-fd44bdc8f780" :knowledge-point/title "Identifying Other Matrices"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "bf4c3781-1b67-53e0-91c6-9593e072014d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$A$ only" :db/id #edb/ref 17592186400221} {:answer/id #uuid "bac3ee2b-f690-591f-b3e6-5fdd75c9a5dc" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "None" :db/id #edb/ref 17592186400222} {:answer/id #uuid "3cc6769f-f67a-553d-839b-096df4607353" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$A$ and $B$ only" :db/id #edb/ref 17592186400223} {:answer/id #uuid "fc536d94-62f6-5d74-84b2-f2009b1d5026" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$C$ only" :db/id #edb/ref 17592186400224} {:answer/id #uuid "8dde38bd-46a0-5152-8b2b-5e3f164418ea" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$B$ only" :db/id #edb/ref 17592186400225}] :answer-field/correct {:answer/id #uuid "8dde38bd-46a0-5152-8b2b-5e3f164418ea" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$B$ only" :db/id #edb/ref 17592186400225} :answer-field/id #uuid "d5d68012-89d6-5afa-af0d-db48f598febd" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186400220}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "c9fca4a1-9999-5571-b7b3-a6f45eb203a9" :question/math-academy-id "q-126287" :question/problem "Which of the following are column vectors?\n\n$$\nA=[\\begin{aligned}-2 & 0\\end{aligned}],\\,B=[\\begin{aligned}2 \\\\ 0 \\\\ 0\\end{aligned}],\\,C=[\\begin{aligned}1 & -3 \\\\ -2 & 1\\end{aligned}]\n$$" :question/worked-solution "- $A$ is *not* a column vector. It has only one row (and $2$ columns), so it's a row vector.\n\n- $B$ is a column vector since it has only one column.\n\n- $C$ is *not* a column vector, since it has more than $1$ column (it has $2$ columns).\n\nTherefore, only $B$ is a column vector."}] [{:db/id #edb/ref 17592186387671 :knowledge-point/_questions [{:db/id #edb/ref 17592186105702 :knowledge-point/id #uuid "c0670172-77cb-5e88-b78d-e5136c06095f" :knowledge-point/title "Calculating a Vector Projection Using Components"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ddd256bf-169a-5728-b266-13306aec364f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨\\sqrt{2},\\frac{\\sqrt{2}}{2},1⟩" :db/id #edb/ref 17592186387673} {:answer/id #uuid "13625fe8-fe4c-5729-bb47-cf2e90a16a13" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨0,0,0⟩" :db/id #edb/ref 17592186387674} {:answer/id #uuid "d9fe7439-2115-5466-abf0-d1ec9a32b9e3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨3\\sqrt{2},\\frac{3\\sqrt{2}}{2},3⟩" :db/id #edb/ref 17592186387675} {:answer/id #uuid "aa8df59e-c038-5fd9-acf2-d5f9b6c4c9f2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨6,3,3\\sqrt{2}⟩" :db/id #edb/ref 17592186387676} {:answer/id #uuid "722ef9d4-feb0-57cb-beaf-db4966197821" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨2,1,\\sqrt{2}⟩" :db/id #edb/ref 17592186387677}] :answer-field/correct {:answer/id #uuid "722ef9d4-feb0-57cb-beaf-db4966197821" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨2,1,\\sqrt{2}⟩" :db/id #edb/ref 17592186387677} :answer-field/id #uuid "c8d371fe-0eaf-54aa-9be2-f431197dc95a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186387672}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "07d400bc-8e75-529a-86cf-3fbedf09676f" :question/math-academy-id "q-126507" :question/problem "Let $a=[\\begin{aligned}6 \\\\ 3 \\\\ 3\\sqrt{2}\\end{aligned}]$ and $b=[\\begin{aligned}3 \\\\ 1 \\\\ 0\\end{aligned}].$ Find the vector projection of $b$ onto $a.$" :question/worked-solution "Using the formula for the vector projection, we obtain \n\n$$\n\\begin{aligned}{\\text{proj}}_{a}\\,b & =\\frac{a\\cdot b}{a\\cdot a}a \\\\  & =\\frac{{a}_{x}{b}_{x}+{a}_{y}{b}_{y}+{a}_{z}{b}_{z}}{{a}_{x}^{2}+{a}_{y}^{2}+{a}_{z}^{2}}a \\\\  & =\\frac{6\\cdot 3+3\\cdot 1+3\\sqrt{2}\\cdot 0}{{6}^{2}+{3}^{2}+(3\\sqrt{2})^{2}}a \\\\  & =\\frac{21}{63}⟨6,3,3\\sqrt{2}⟩ \\\\  & =\\frac{1}{3}⟨6,3,3\\sqrt{2}⟩ \\\\  & =⟨2,1,\\sqrt{2}⟩.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186400226 :knowledge-point/_questions [{:db/id #edb/ref 17592186059766 :knowledge-point/id #uuid "f71a8f16-93d4-5e5a-9b8b-e29efc682430" :knowledge-point/title "Identifying the Reflection of a Cosine Curve Over the Horizontal Axis"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c4e173d4-f5b8-5ccc-9008-d91b45244f8c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=1.5cos⁡(x)" :db/id #edb/ref 17592186400228} {:answer/id #uuid "4c24a715-ead1-58d4-8292-0189666d823a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=cos⁡(x)-1.5" :db/id #edb/ref 17592186400229} {:answer/id #uuid "c1cd17dd-96e3-5b25-bf97-b5e326ff0ab9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=cos⁡(x)+1.5" :db/id #edb/ref 17592186400230} {:answer/id #uuid "774b4b4b-55ca-5041-80c5-d41b0058a5c0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=-cos⁡(x-1.5)" :db/id #edb/ref 17592186400231} {:answer/id #uuid "c37c2d1e-7ba4-57eb-9816-faa0ae5b47ae" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=-1.5cos⁡(x)" :db/id #edb/ref 17592186400232}] :answer-field/correct {:answer/id #uuid "c37c2d1e-7ba4-57eb-9816-faa0ae5b47ae" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=-1.5cos⁡(x)" :db/id #edb/ref 17592186400232} :answer-field/id #uuid "56e9c54d-acd0-56fe-8076-95dec659fb84" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186400227}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "5183ff04-e16d-572d-aca9-41a49c02cc01" :question/math-academy-id "q-12675" :question/problem "![](images/14/146cd919d8b1cdc034dc8aa1d8d0867bee7475b7ed72837c935de3cd11b38d59.png)\n\nWhat is the equation of the graph shown above?" :question/worked-solution "![](images/85/857a4b0109ddc20535b65ffe16191494ab9fdef01b6def354fcd68b862b98679.png)\n\nTo plot the given curve, we follow these steps:\n\n- Start with the graph of $y=cos⁡x.$\n\n- Then, reflect it in the $x$-axis to give $y=-cos⁡x.$\n\n- Finally, stretch it parallel to the $y$-axis by a stretch factor of $1.5$ to give $y=-1.5cos⁡x$\n\nTherefore, the given curve is the graph of $y=-1.5cos⁡x.$"}] [{:db/id #edb/ref 17592186262693 :knowledge-point/_questions [{:db/id #edb/ref 17592186175902 :knowledge-point/id #uuid "205c5518-c67a-5784-8cc7-55b42ce7fb0e" :knowledge-point/title "Determining Whether the Extreme Value Theorem Is Applicable to a Function Given Its Graph"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "28335c41-e264-547d-a39b-c4a9dfc761b5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186260228} {:answer/id #uuid "9257b803-5a7d-5007-b81e-7a3549eb8cde" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186261145} {:answer/id #uuid "b694e300-bb93-5e29-a890-34ffafa897df" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186261480} {:answer/id #uuid "d7939b51-ceeb-5210-a129-13ac3a1ad6b5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186261773} {:answer/id #uuid "e142852e-671e-52a5-9fe8-763b34b574d6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "None" :db/id #edb/ref 17592186261863}] :answer-field/correct {:answer/id #uuid "b694e300-bb93-5e29-a890-34ffafa897df" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186261480} :answer-field/id #uuid "aad849ef-d673-5d42-ae65-37f160fc6b9f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186262430}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "144d9fbc-7660-5ed9-9ae4-01d5a04d6a5a" :question/math-academy-id "q-127040" :question/problem "![](images/3c/3c25115cfb7ccde7ec0cbec249d62b037c7fb94be92905b186101ce1fd45a1d8.png)\n\nConsider the function $y=f(x)$ whose graph is plotted above. On which interval is the extreme value theorem applicable to $f(x)?$\n\n- $[0,2]$\n- $(1,2)$\n- $(-\\infty ,0]$" :question/worked-solution "Remember that the extreme value theorem is only applicable to closed intervals on which the function is continuous.\n\nWith that in mind, let's take a look at each interval.\n\n- The interval $[0,2]$ is closed, and the function is continuous on $[0,2].$ Therefore, the extreme value theorem is applicable.\n\n- The interval $(1,2)$ is not closed, so the extreme value theorem is not applicable.\n\n- The interval $(-\\infty ,0]$ is closed, but it is not a bounded interval in the form $[a,b].$ Therefore, the extreme value theorem is not applicable.\n\nIn conclusion, the correct answer is \"I only\"."}] [{:db/id #edb/ref 17592186262765 :knowledge-point/_questions [{:db/id #edb/ref 17592186083336 :knowledge-point/id #uuid "b5cda348-b3e8-5a89-abd4-bd6f3a7a8370" :knowledge-point/title "Calculating Critical Points of Trigonometric Functions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1eef0e3e-ea4f-50cd-b2e1-e979df67ba0f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{4{\\pi }^{2}}{9}" :db/id #edb/ref 17592186260140} {:answer/id #uuid "2d22227e-5422-5254-972d-0af4f993e223" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5{\\pi }^{2}}{16}" :db/id #edb/ref 17592186260282} {:answer/id #uuid "afbf3a70-63dc-59d9-875a-84d1d998ecb5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{21{\\pi }^{2}}{16}" :db/id #edb/ref 17592186261428} {:answer/id #uuid "d66540ac-e909-53f2-ba6d-a70dda6376dc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{7{\\pi }^{2}}{16}" :db/id #edb/ref 17592186261760} {:answer/id #uuid "f7a29601-8979-5087-b9d6-8281213733bd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{7{\\pi }^{2}}{9}" :db/id #edb/ref 17592186262040}] :answer-field/correct {:answer/id #uuid "2d22227e-5422-5254-972d-0af4f993e223" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5{\\pi }^{2}}{16}" :db/id #edb/ref 17592186260282} :answer-field/id #uuid "6854d4ad-f3c0-5783-800f-09ea5cad0175" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186262299}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "13dc6cf8-4247-5345-8915-7e98d8dd8d84" :question/math-academy-id "q-127391" :question/problem "Consider the function $f(x)=\\operatorname{sin}⁡x+\\operatorname{cos}⁡x.$ If the critical points of $f(x)$ for $x\\in (0,2\\pi )$ are $x={x}_{1}$ and $x={x}_{2},$ what is the value of ${x}_{1}\\cdot {x}_{2}?$" :question/worked-solution "A critical point of $f(x)$ is a point $x=c$ in the domain of $f$ such that either ${f}^{′}(c)=0$ or ${f}^{′}(c)$ does not exist.\n\nDifferentiating $f(x),$ we obtain\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}(\\operatorname{sin}⁡x+\\operatorname{cos}⁡x) \\\\  & =\\operatorname{cos}⁡x-\\operatorname{sin}⁡x.\\end{aligned}\n$$\n\nWe now proceed to find the critical points:\n\n- First, we compute the points where ${f}^{′}(c)=0.$ We set the derivative equal to zero, and solve for $x:$\n\n$$\n\\begin{aligned}\\operatorname{cos}⁡x-\\operatorname{sin}⁡x & =0 \\\\ \\operatorname{sin}⁡x & =\\operatorname{cos}⁡x \\\\ \\frac{\\operatorname{sin}⁡x}{\\operatorname{cos}⁡x} & =\\frac{\\operatorname{cos}⁡x}{\\operatorname{cos}⁡x} \\\\ \\operatorname{tan}⁡x & =1\\end{aligned}\n$$\n\nThe general solution to our equation is\n\n$$\n\\begin{aligned}x & =\\operatorname{arctan}⁡1+n\\pi  \\\\  & =\\frac{\\pi }{4}+n\\pi .\\end{aligned}\n$$\n\nWe set $n=0,\\pm 1,\\pm 2,…,$ until we have generated all solutions in the domain $0<x<2\\pi .$\n\n- setting $n=0$ gives $x=\\frac{\\pi }{4}$\n\n- setting $n=1$ gives $x=\\frac{5\\pi }{4}$\n\nAll other values of $n$ generate solutions outside the domain $0<x<2\\pi .$ So, the solutions to this equation for $x\\in (0,2\\pi )$ are \n\n$$\nx=\\frac{\\pi }{4},\\,x=\\frac{5\\pi }{4}.\n$$\n\nTherefore, $f(x)$ has stationary points at $x=\\frac{\\pi }{4}$ and $x=\\frac{5\\pi }{4}.$\n\n- Second, we note that ${f}^{′}(x)$ exists for all values of $x\\in (0,2\\pi ).$ So $f(x)$ has no non-stationary critical points.\n\nTherefore, we conclude that the critical points of $f(x)$ for $x\\in (0,2\\pi )$ are ${x}_{1}=\\frac{\\pi }{4}$ and ${x}_{2}=\\frac{5\\pi }{4}.$\n\nFinally,\n\n$$\n{x}_{1}\\cdot {x}_{2}=\\frac{\\pi }{4}\\cdot \\frac{5\\pi }{4}=\\frac{5{\\pi }^{2}}{16}.\n$$"}] [{:db/id #edb/ref 17592186262802 :knowledge-point/_questions [{:db/id #edb/ref 17592186059749 :knowledge-point/id #uuid "26e8a6ff-e5ed-59a7-b31d-1981495bf26a" :knowledge-point/title "Calculating the Determinant of a 2x2 Matrix With Non-Integer Entries"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5498ee4c-4372-5204-b6e1-f57f31f7ce72" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3{y}^{2}x-5" :db/id #edb/ref 17592186260592} {:answer/id #uuid "61a3d195-a5ae-5921-ac90-3b4c24a6e5e9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y(2{x}^{2}+5)" :db/id #edb/ref 17592186260716} {:answer/id #uuid "9ad83484-0f5d-5184-b122-b899402359be" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3{x}^{2}y+3" :db/id #edb/ref 17592186261219} {:answer/id #uuid "9f32a52b-bd39-5040-afc5-c0f0787ecc96" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4{x}^{2}{y}^{2}" :db/id #edb/ref 17592186261256} {:answer/id #uuid "a2a8698b-73f4-57ac-a21f-031d3c8b223a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y(2{x}^{2}-3)" :db/id #edb/ref 17592186261294}] :answer-field/correct {:answer/id #uuid "61a3d195-a5ae-5921-ac90-3b4c24a6e5e9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y(2{x}^{2}+5)" :db/id #edb/ref 17592186260716} :answer-field/id #uuid "b1e2c382-0ce2-5adc-b135-69fb578a8e4f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186262444}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "5adfe9df-8aee-5967-99f3-985aed9cc4da" :question/math-academy-id "q-127603" :question/problem "Calculate $det(D)$, if\n    $D=[\\begin{aligned}2x & y \\\\ -5 & xy\\end{aligned}].$" :question/worked-solution "For a $2\\times 2$ matrix, the determinant is given by the formula\n\n$$\n|\\begin{aligned}a & b \\\\ c & d\\end{aligned}|=ad-bc.\n$$\n\nUsing the formula, we have:\n\n$$\n\\begin{aligned}\\text{det}(D) & =|\\begin{aligned}2x & y \\\\ -5 & xy\\end{aligned}| \\\\  & =2x\\cdot xy-y\\cdot (-5) \\\\  & =2{x}^{2}y+5y \\\\  & =y(2{x}^{2}+5)\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186398333 :knowledge-point/_questions [{:db/id #edb/ref 17592186087701 :knowledge-point/id #uuid "bea23649-e835-540a-b238-7b89ed330cd3" :knowledge-point/title "Calculating the Inverse of a 2x2 Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "bce01ee3-e62d-5dbf-8ab7-ab7ffd839257" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{2}[\\begin{aligned}-2 & 8 \\\\ 1 & -3\\end{aligned}]" :db/id #edb/ref 17592186398335} {:answer/id #uuid "cb1c7834-02fe-5c78-b2fe-aa883eb34976" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{2}[\\begin{aligned}8 & 2 \\\\ 3 & 1\\end{aligned}]" :db/id #edb/ref 17592186398336} {:answer/id #uuid "c2e1ebaa-2f3e-5015-b022-3d3df282249e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{14}[\\begin{aligned}8 & 2 \\\\ 3 & 1\\end{aligned}]" :db/id #edb/ref 17592186398337} {:answer/id #uuid "717243f7-02ac-50c5-9655-63bba2b18b42" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}[\\begin{aligned}-1 & 2 \\\\ 3 & 8\\end{aligned}]" :db/id #edb/ref 17592186398338} {:answer/id #uuid "fcfc218d-9756-5117-a5b1-a400cbe24097" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}[\\begin{aligned}8 & -2 \\\\ -3 & 1\\end{aligned}]" :db/id #edb/ref 17592186398339}] :answer-field/correct {:answer/id #uuid "fcfc218d-9756-5117-a5b1-a400cbe24097" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}[\\begin{aligned}8 & -2 \\\\ -3 & 1\\end{aligned}]" :db/id #edb/ref 17592186398339} :answer-field/id #uuid "16d27f97-4329-5b65-b357-06a7d75d56ef" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186398334}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "9fd0e8ab-5ed1-5462-b099-07b3173547c9" :question/math-academy-id "q-127736" :question/problem "Calculate ${Z}^{-1}$ where\n$Z=[\\begin{aligned}1 & 2 \\\\ 3 & 8\\end{aligned}].$" :question/worked-solution "Given a $2\\times 2$ matrix\n\n$$\nZ=[\\begin{aligned}a & b \\\\ c & d\\end{aligned}],\n$$\n\nthe inverse of $Z$ can be found using the following formula:\n\n$$\n\\begin{aligned}{Z}^{-1} & =\\frac{1}{det(Z)}[\\begin{aligned}d & -b \\\\ -c & a\\end{aligned}].\\end{aligned}\n$$\n\nFirst, we compute the determinant:\n\n$$\ndet(Z)=1\\cdot 8-3\\cdot 2=2\n$$\n\nUsing the formula, then, the inverse is given by\n\n$$\n\\begin{aligned}{Z}^{-1} & =\\frac{1}{det(Z)}[\\begin{aligned}d & -b \\\\ -c & a\\end{aligned}] \\\\  & =\\frac{1}{2}[\\begin{aligned}8 & -2 \\\\ -3 & 1\\end{aligned}].\\end{aligned}\n$$\n\nWe can verify the result as follows:\n\n$$\n\\begin{aligned}Z{Z}^{-1} & =[\\begin{aligned}1 & 2 \\\\ 3 & 8\\end{aligned}]\\cdot \\frac{1}{2}[\\begin{aligned}8 & -2 \\\\ -3 & 1\\end{aligned}] \\\\  & =[\\begin{aligned}1 & 0 \\\\ 0 & 1\\end{aligned}] \\\\  & ={I}_{2}\\,✓ \\\\ {Z}^{-1}Z & =\\frac{1}{2}[\\begin{aligned}8 & -2 \\\\ -3 & 1\\end{aligned}][\\begin{aligned}1 & 2 \\\\ 3 & 8\\end{aligned}] \\\\  & =[\\begin{aligned}1 & 0 \\\\ 0 & 1\\end{aligned}] \\\\  & ={I}_{2}\\,✓\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186398340 :knowledge-point/_questions [{:db/id #edb/ref 17592186087701 :knowledge-point/id #uuid "bea23649-e835-540a-b238-7b89ed330cd3" :knowledge-point/title "Calculating the Inverse of a 2x2 Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ad7ce0b9-8bef-5a30-a632-26629274772f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}[\\begin{aligned}-2 & 3 \\\\ 5 & 7\\end{aligned}]" :db/id #edb/ref 17592186398342} {:answer/id #uuid "a1e85deb-4ee7-5dd1-83b9-549af07b1b5c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}7 & -3 \\\\ -5 & 2\\end{aligned}]" :db/id #edb/ref 17592186398343} {:answer/id #uuid "506981c3-b1de-57d9-8bb9-05dbc5caad2c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}[\\begin{aligned}-2 & -3 \\\\ 5 & 7\\end{aligned}]" :db/id #edb/ref 17592186398344} {:answer/id #uuid "c55c053c-99f7-578e-a9b7-2928fc100ac3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}7 & -3 \\\\ 5 & -2\\end{aligned}]" :db/id #edb/ref 17592186398345} {:answer/id #uuid "da2f7c91-660d-5f24-88f0-96190a785249" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}[\\begin{aligned}7 & -3 \\\\ 5 & -2\\end{aligned}]" :db/id #edb/ref 17592186398346}] :answer-field/correct {:answer/id #uuid "c55c053c-99f7-578e-a9b7-2928fc100ac3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}7 & -3 \\\\ 5 & -2\\end{aligned}]" :db/id #edb/ref 17592186398345} :answer-field/id #uuid "194044ba-41ba-5420-975a-652d3ae5b598" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186398341}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "e9cf7ac8-28c7-510c-8205-256a03a04ef2" :question/math-academy-id "q-127737" :question/problem "Calculate ${U}^{-1}$, where \n$U=[\\begin{aligned}-2 & 3 \\\\ -5 & 7\\end{aligned}].$" :question/worked-solution "Given a $2\\times 2$ matrix\n\n$$\nU=[\\begin{aligned}a & b \\\\ c & d\\end{aligned}],\n$$\n\nthe inverse of $U$ can be found using the following formula:\n\n$$\n\\begin{aligned}{U}^{-1} & =\\frac{1}{det(U)}[\\begin{aligned}d & -b \\\\ -c & a\\end{aligned}].\\end{aligned}\n$$\n\nFirst, we compute the determinant:\n\n$$\ndet(U)=-2\\cdot 7-(-5)\\cdot 3=1\n$$\n\nUsing the formula, then, the inverse is given by\n\n$$\n\\begin{aligned}{U}^{-1} & =\\frac{1}{det(U)}[\\begin{aligned}d & -b \\\\ -c & a\\end{aligned}] \\\\  & =\\frac{1}{1}[\\begin{aligned}7 & -3 \\\\ -(-5) & -2\\end{aligned}] \\\\  & =[\\begin{aligned}7 & -3 \\\\ 5 & -2\\end{aligned}].\\end{aligned}\n$$\n\nWe can verify the result as follows:\n\n$$\n\\begin{aligned}U{U}^{-1} & =[\\begin{aligned}-2 & 3 \\\\ -5 & 7\\end{aligned}]\\cdot [\\begin{aligned}7 & -3 \\\\ 5 & -2\\end{aligned}] \\\\  & =[\\begin{aligned}1 & 0 \\\\ 0 & 1\\end{aligned}] \\\\  & ={I}_{2}\\,✓ \\\\ {U}^{-1}U & =[\\begin{aligned}7 & -3 \\\\ 5 & -2\\end{aligned}][\\begin{aligned}-2 & 3 \\\\ -5 & 7\\end{aligned}] \\\\  & =[\\begin{aligned}1 & 0 \\\\ 0 & 1\\end{aligned}] \\\\  & ={I}_{2}\\,✓\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186262823 :knowledge-point/_questions [{:db/id #edb/ref 17592186087702 :knowledge-point/id #uuid "4c6056ee-15f3-5b5c-8a14-173ea1da1381" :knowledge-point/title "Identifying Singular Matrices"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "10748dde-a51d-5d0d-8b07-92b83b7c92de" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$A$ and $B$ only" :db/id #edb/ref 17592186260025} {:answer/id #uuid "5a8cf61a-0004-57ec-84ee-1b8ad63b0b27" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$A$ only" :db/id #edb/ref 17592186260650} {:answer/id #uuid "85c936f8-cd07-542c-9749-57246cdecd81" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$B$ only" :db/id #edb/ref 17592186261037} {:answer/id #uuid "87376d90-7214-54b3-9895-2b5679afcdc1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$A$ and $C$ only" :db/id #edb/ref 17592186261054} {:answer/id #uuid "edfcd0ca-7188-5271-8783-e88e36e7f6d1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$C$ only" :db/id #edb/ref 17592186261968}] :answer-field/correct {:answer/id #uuid "87376d90-7214-54b3-9895-2b5679afcdc1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$A$ and $C$ only" :db/id #edb/ref 17592186261054} :answer-field/id #uuid "cf045499-f180-5fc9-928e-e89fb43e0ba9" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186262486}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "2e8059f3-ef63-587d-911b-0d0c0a784873" :question/math-academy-id "q-127755" :question/problem "Which of the matrices below does **not** have an inverse?\n\n$$\nA=[\\begin{aligned}1 & 0\\end{aligned}],\\,B=[\\begin{aligned}0 & 1 \\\\ -1 & 0\\end{aligned}],\\,C=[\\begin{aligned}1 & 1 \\\\ 2 & 2\\end{aligned}].\n$$" :question/worked-solution "- The matrix $A$ is a $1\\times 2$ matrix. So, it is not invertible.\n\n- For the matrix $B$, we have\n\n$$\ndet(B)=0\\cdot 0-(-1)\\cdot 1=1.\n$$\n\nBecause $det(B)\\ne 0,$ we conclude that $B$ is invertible.\n\n- For the matrix $C$, we have\n\n$$\ndet(C)=1\\cdot 2-2\\cdot 1=0.\n$$\n\nBecause $det(C)=0,$ we conclude that $C$ is not invertible.\n\nTherefore, only $A$ and $C$ do not have an inverse."}] [{:db/id #edb/ref 17592186400324 :knowledge-point/_questions [{:db/id #edb/ref 17592186087702 :knowledge-point/id #uuid "4c6056ee-15f3-5b5c-8a14-173ea1da1381" :knowledge-point/title "Identifying Singular Matrices"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e8d2bc02-c082-5c4b-b8b4-4cc42589135a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$A$ and $C$ only" :db/id #edb/ref 17592186400326} {:answer/id #uuid "4ca1bc72-a590-545b-a3ed-548d70e28416" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$A$ only" :db/id #edb/ref 17592186400327} {:answer/id #uuid "61887468-5253-5e21-a263-8a4203dd1713" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$B$ and $C$ only" :db/id #edb/ref 17592186400328} {:answer/id #uuid "bdb370b3-9b49-53aa-adf8-a245cfd5dfd0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$A$ and $B$ only" :db/id #edb/ref 17592186400329} {:answer/id #uuid "1a4d2564-d98c-55bf-bdf9-5d34fdcf8601" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$B$ only" :db/id #edb/ref 17592186400330}] :answer-field/correct {:answer/id #uuid "4ca1bc72-a590-545b-a3ed-548d70e28416" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$A$ only" :db/id #edb/ref 17592186400327} :answer-field/id #uuid "e2eacdbe-c7ca-5401-a770-a6823a00bee1" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186400325}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "dd3729c7-43c0-5883-808f-5b63c7f7af84" :question/math-academy-id "q-127826" :question/problem "Which of the matrices below does **not** have an inverse?\n\n$$\nA=[\\begin{aligned}3 \\\\ 1 \\\\ 9\\end{aligned}],\\,B=[\\begin{aligned}-3 & 15 \\\\ 1 & 5\\end{aligned}],\\,C=[\\begin{aligned}7 & 4 \\\\ 3 & 2\\end{aligned}].\n$$" :question/worked-solution "- The matrix $A$ is a $3\\times 1$ matrix. So, it is not invertible.\n\n- For the matrix $B$, we have\n\n$$\ndet(B)=-3\\cdot 5-1\\cdot 15=-30.\n$$\n\nBecause $det(B)\\ne 0,$ we conclude that $B$ is invertible.\n\n- For the matrix $C$, we have\n\n$$\ndet(C)=7\\cdot 2-3\\cdot 4=2.\n$$\n\nBecause $det(C)\\ne 0,$ we conclude that $C$ is invertible.\n\nTherefore, only $A$ does not have an inverse."}] [{:db/id #edb/ref 17592186262830 :knowledge-point/_questions [{:db/id #edb/ref 17592186059850 :knowledge-point/id #uuid "0a166115-1a93-5945-bfac-b1d3ddb1cfbd" :knowledge-point/title "Calculating the Cross Product of Two Vectors Whose Angle Is a Special Angle"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "03426403-c917-535c-902b-aef80fe5071d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3n" :db/id #edb/ref 17592186259904} {:answer/id #uuid "03bf234d-79a2-59ba-8aff-b62bf020f13b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5n" :db/id #edb/ref 17592186259909} {:answer/id #uuid "28a204dc-9720-57af-a03b-e46255191b93" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186260233} {:answer/id #uuid "3a4b1eb1-85e4-5558-8234-0e932dda4ad3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "30n" :db/id #edb/ref 17592186260397} {:answer/id #uuid "be6ebb7d-8490-5cd2-8209-4c83e244cd24" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "15n" :db/id #edb/ref 17592186261554}] :answer-field/correct {:answer/id #uuid "be6ebb7d-8490-5cd2-8209-4c83e244cd24" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "15n" :db/id #edb/ref 17592186261554} :answer-field/id #uuid "3d2a4849-42e2-5f28-967e-49cff93d81d6" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186262234}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "bf6a3fd8-9d4e-5cd0-83c5-0d33a2370f19" :question/math-academy-id "q-127841" :question/problem "The vector $u$ has magnitude $5$, the vector $v$ has magnitude $3,$ the angle between $u$ and $v$ is ${90}^{∘}$ and $n$ is the unit vector that points in the direction of $u\\times v.$ Find $u\\times v$ in terms of $n.$" :question/worked-solution "We use the formula for the cross product and obtain\n\n$$\n\\begin{aligned}u\\times v & =|u|\\cdot |v|\\cdot \\operatorname{sin}⁡\\theta \\cdot n \\\\  & =5\\cdot 3\\cdot \\operatorname{sin}⁡{90}^{∘}\\cdot n \\\\  & =15\\cdot 1\\cdot n \\\\  & =15n.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186262832 :knowledge-point/_questions [{:db/id #edb/ref 17592186059851 :knowledge-point/id #uuid "09aeb7f5-31e0-5b2d-9e2a-8eace54a6665" :knowledge-point/title "Calculating the Cross Product of Two Vectors Whose Angle Is a Non-Special Angle"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6a53b042-71de-578e-b706-acc4b23435f5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "30.6n" :db/id #edb/ref 17592186260806} {:answer/id #uuid "7d381b9f-d3c8-533b-bb9e-5699d88a5805" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "29.8n" :db/id #edb/ref 17592186260963} {:answer/id #uuid "a76403ad-e5f9-5710-b5f6-677bace879e2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "21.3n" :db/id #edb/ref 17592186261336} {:answer/id #uuid "acc4cebd-ec93-5988-868c-a6cd2c5c3eba" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "28.9n" :db/id #edb/ref 17592186261387} {:answer/id #uuid "d021fbbe-89ef-5218-bbeb-d997b3f77c8d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "20.1n" :db/id #edb/ref 17592186261712}] :answer-field/correct {:answer/id #uuid "acc4cebd-ec93-5988-868c-a6cd2c5c3eba" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "28.9n" :db/id #edb/ref 17592186261387} :answer-field/id #uuid "3f4e886d-2696-5bcd-9a3a-a1dac9a0b5f1" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186262237}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "c82f8a89-f925-5da0-abbf-d7bdbd694605" :question/math-academy-id "q-127846" :question/problem "The vector $a$ has magnitude $3$, the vector $b$ has magnitude $15,$ the angle between $a$ and $b$ is ${40}^{∘}$ and $n$ is the unit vector that points in the direction of $a\\times b.$ Find $a\\times b$ in terms of $n.$ Round your final answer to one decimal place where appropriate." :question/worked-solution "We use the formula for the cross product and obtain\n\n$$\n\\begin{aligned}a\\times b & =|a|\\cdot |b|\\cdot \\operatorname{sin}⁡\\theta \\cdot n \\\\  & =3\\cdot 15\\cdot \\operatorname{sin}⁡{40}^{∘}\\cdot n \\\\  & =45\\cdot (0.642\\,78…)\\cdot n \\\\  & =(28.925\\,44…)\\cdot n \\\\  & ≈28.9n.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186262833 :knowledge-point/_questions [{:db/id #edb/ref 17592186059851 :knowledge-point/id #uuid "09aeb7f5-31e0-5b2d-9e2a-8eace54a6665" :knowledge-point/title "Calculating the Cross Product of Two Vectors Whose Angle Is a Non-Special Angle"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "37260aa4-569a-56b0-bb4d-51362a133037" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "47.3n" :db/id #edb/ref 17592186260367} {:answer/id #uuid "38babf1b-826f-5f7d-a5cd-3ac67c6c5c4b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "44.4n" :db/id #edb/ref 17592186260379} {:answer/id #uuid "4020c8b3-0933-50e3-8a2f-bd114983e935" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "41.9n" :db/id #edb/ref 17592186260437} {:answer/id #uuid "77a304a4-bd09-5a24-a472-c61bed5b5391" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "43.7n" :db/id #edb/ref 17592186260918} {:answer/id #uuid "a65f2a98-d121-53e8-add6-b9485d0b2eb3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "40.1n" :db/id #edb/ref 17592186261324}] :answer-field/correct {:answer/id #uuid "77a304a4-bd09-5a24-a472-c61bed5b5391" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "43.7n" :db/id #edb/ref 17592186260918} :answer-field/id #uuid "28f46a5e-81da-5c5a-894d-5420cf6156b8" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186262200}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "dec81709-4d57-533e-9540-a3bae9092291" :question/math-academy-id "q-127849" :question/problem "The vector $u$ has magnitude $7$, the vector $v$ has magnitude $7,$ the angle between $u$ and $v$ is ${117}^{∘}$ and $n$ is the unit vector that points in the direction of $u\\times v.$ Find $u\\times v$ in terms of $n.$ Round your final answer to one decimal place where appropriate." :question/worked-solution "We use the formula for the cross product and obtain\n\n$$\n\\begin{aligned}u\\times v & =|u|\\cdot |v|\\cdot \\operatorname{sin}⁡\\theta \\cdot n \\\\  & =7\\cdot 7\\cdot \\operatorname{sin}⁡{117}^{∘}\\cdot n \\\\  & =49\\cdot (0.891\\,00…)\\cdot n \\\\  & =(43.659\\,31…)\\cdot n \\\\  & ≈43.7n.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186262841 :knowledge-point/_questions [{:db/id #edb/ref 17592186087703 :knowledge-point/id #uuid "4e64e0c3-f8f5-5c38-ae75-1aed92e0ac01" :knowledge-point/title "Solving for a Variable in a Singular Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0694821e-0afc-5a6f-9ac3-c60009288f14" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "a=\\pm 12" :db/id #edb/ref 17592186259936} {:answer/id #uuid "82ad1107-f4f2-56fb-a170-26080bfb5a58" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "a=\\pm 9" :db/id #edb/ref 17592186261009} {:answer/id #uuid "93eed24a-7d3e-5252-8646-ba1e56d6756f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "a=1" :db/id #edb/ref 17592186261161} {:answer/id #uuid "acb60d02-9af1-5edb-8a62-0a7f615d8394" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "a=\\pm 4" :db/id #edb/ref 17592186261386} {:answer/id #uuid "f1b9c926-8614-5473-84ac-a0af3c07259f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "a=2" :db/id #edb/ref 17592186261991}] :answer-field/correct {:answer/id #uuid "0694821e-0afc-5a6f-9ac3-c60009288f14" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "a=\\pm 12" :db/id #edb/ref 17592186259936} :answer-field/id #uuid "b5f9163f-3e19-52b4-9fae-e228093cfe55" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186262453}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "54a4b93b-d93e-5ce6-98ac-7b0ed79d28ef" :question/math-academy-id "q-127901" :question/problem "If $A=[\\begin{aligned}48 & a \\\\ a & 3\\end{aligned}]$ is a singular matrix, calculate the value(s) of $a.$" :question/worked-solution "The matrix $A$ is singular if and only if $det(A)=0.$ Calculating the determinant, we get\n\n$$\n\\begin{aligned}det(A) & =48\\cdot 3-a\\cdot a \\\\  & =144-{a}^{2}.\\end{aligned}\n$$\n\nNow, we set the determinant equal to $0$ and solve for $a:$\n\n$$\n\\begin{aligned}144-{a}^{2} & =0 \\\\ {a}^{2} & =144 \\\\ a & =\\pm 12\\end{aligned}\n$$\n\nTherefore, the values of $a$ are $a=\\pm 12.$"}] [{:db/id #edb/ref 17592186262842 :knowledge-point/_questions [{:db/id #edb/ref 17592186087703 :knowledge-point/id #uuid "4e64e0c3-f8f5-5c38-ae75-1aed92e0ac01" :knowledge-point/title "Solving for a Variable in a Singular Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "03e10364-a8ca-5a9b-8ec9-fb274ee07c3b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "t=9" :db/id #edb/ref 17592186259910} {:answer/id #uuid "64215484-b9df-5191-b8c1-9280990fe3aa" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "t=4" :db/id #edb/ref 17592186260740} {:answer/id #uuid "b5950187-60d8-50ca-a7cc-6a821b22c615" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "t=0" :db/id #edb/ref 17592186261470} {:answer/id #uuid "cec39778-4048-5806-ae58-6218823c031b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "k=\\pm 7" :db/id #edb/ref 17592186261705} {:answer/id #uuid "d2a62acf-b03a-52a7-ab5a-7633988a7413" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "k=\\pm 10" :db/id #edb/ref 17592186261728}] :answer-field/correct {:answer/id #uuid "b5950187-60d8-50ca-a7cc-6a821b22c615" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "t=0" :db/id #edb/ref 17592186261470} :answer-field/id #uuid "cfd7d4c7-e60d-5c53-95c8-2c7046132a9a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186262488}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "a4d5dba8-4e64-55e3-a838-e85b88eeb6cd" :question/math-academy-id "q-127903" :question/problem "If $M=[\\begin{aligned}t & 5 \\\\ t & 9\\end{aligned}]$ is a singular matrix, calculate the value(s) of $t.$" :question/worked-solution "The matrix $M$ is singular if and only if $det(M)=0.$ Calculating the determinant, we get\n\n$$\n\\begin{aligned}det(M) & =t\\cdot 9-t\\cdot 5 \\\\  & =9t-5t \\\\  & =4t\\end{aligned}\n$$\n\nNow, we set the determinant equal to $0$ and solve for $t:$\n\n$$\n\\begin{aligned}4t & =0 \\\\ t & =0\\end{aligned}\n$$\n\nTherefore, the value of $t$ is $t=0.$"}] [{:db/id #edb/ref 17592186262882 :knowledge-point/_questions [{:db/id #edb/ref 17592186059847 :knowledge-point/id #uuid "979859e4-b60c-548d-8da6-b180400e1b07" :knowledge-point/title "Calculating the Determinant of a 3x3 Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1682dd1e-6a3e-585a-b8de-5b23b7ea94c4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "20" :db/id #edb/ref 17592186260072} {:answer/id #uuid "1689a068-b51c-5ee0-8061-d29ddb153fe2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-5" :db/id #edb/ref 17592186260073} {:answer/id #uuid "1d2470ac-dd54-5b59-9478-94b73932f435" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "12" :db/id #edb/ref 17592186260124} {:answer/id #uuid "7d4bbf76-c7a5-5145-83ec-650fb6db1e65" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186260964} {:answer/id #uuid "de38351b-baf5-5a90-a6e5-ee73c0a46168" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-32" :db/id #edb/ref 17592186261839}] :answer-field/correct {:answer/id #uuid "de38351b-baf5-5a90-a6e5-ee73c0a46168" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-32" :db/id #edb/ref 17592186261839} :answer-field/id #uuid "b65a4ca0-f974-538c-8c68-2ae22626c269" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186262454}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "94e0f9cc-6b5b-54e5-ac6a-648684ded023" :question/math-academy-id "q-128309" :question/problem "Find the value of $|\\begin{aligned}-2 & 1 & 1 \\\\ 1 & 4 & 0 \\\\ 5 & -3 & 1\\end{aligned}|.$" :question/worked-solution "Using the formula, we take the alternating sum of the entries in the top row of the matrix, multiplied by their respective minors, as follows:\n\n$$\n\\begin{aligned}|\\begin{aligned}-2 & 1 & 1 \\\\ 1 & 4 & 0 \\\\ 5 & -3 & 1\\end{aligned}| & =-2|\\begin{aligned}4 & 0 \\\\ -3 & 1\\end{aligned}|-1|\\begin{aligned}1 & 0 \\\\ 5 & 1\\end{aligned}|+1|\\begin{aligned}1 & 4 \\\\ 5 & -3\\end{aligned}| \\\\  & =-2(4-0)-1(1-0)-1(-3-20) \\\\  & =-2\\cdot 4-1\\cdot 1+1\\cdot (-23) \\\\  & =-8-1-23 \\\\  & =-32\\end{aligned}\n$$"}]}
