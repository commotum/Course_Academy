045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186395589}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "a01e6206-bbdb-5e69-a533-c1319faf7313" :question/math-academy-id "q-99068" :question/problem "Which of the following is the graph of $y=-\\frac{1}{4x}?$" :question/worked-solution "To plot $y=-\\frac{1}{4x},$ we apply the following steps:\n\n- Take the curve $y=-\\frac{1}{x}.$\n\n![](images/9d/9da0db2e6c97e507e82b7ca801e46802fabf91ad31ff53ad3cc9ae580151370a.png)\n\n- Stretch the result by a scale factor of $\\frac{1}{4}$ parallel to the $y$-axis to get the graph of $y=-\\frac{1}{4x}.$\n\n![](images/34/344a3615421b88df05cb666ca90395991f3aa6af75c9095a60c73be89124b7e9.png)"}] [{:db/id #edb/ref 17592186395595 :knowledge-point/_questions [{:db/id #edb/ref 17592186217152 :knowledge-point/id #uuid "5fa86dd3-3bb3-54d5-8940-5dc07ae4c99f" :knowledge-point/title "Exponential Growth Functions With Horizontal and Vertical Shifts"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f7c4d435-ed23-5544-bf93-e1449ee399df" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/03/039b46c639a4e4b6976c9d6d4ce8451a4206555d7d2960d3c822d669460dc8be.png" :db/id #edb/ref 17592186395597} {:answer/id #uuid "7cbc6492-65db-5f5d-a611-c28f8b4d046c" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/b7/b75375bf734633beb27745f68c83db9b713d6be77a25ad778a55f989aa9e02fe.png" :db/id #edb/ref 17592186395598} {:answer/id #uuid "d3d6b14e-40d1-5e9e-bdec-ed3828d1910f" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/af/af07ec5cd9a09beebcdc833212f9b83d636ad79ac77e7a857068f458e778680d.png" :db/id #edb/ref 17592186395599} {:answer/id #uuid "25792ba5-676c-5168-88c6-f98127ebecb8" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/93/9