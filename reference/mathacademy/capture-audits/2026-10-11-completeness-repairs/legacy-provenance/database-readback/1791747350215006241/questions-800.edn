#{[{:db/id #edb/ref 17592186120410 :knowledge-point/_questions [{:db/id #edb/ref 17592186119956 :knowledge-point/id #uuid "231604dc-fe8f-59be-90fe-37af7a1bb648" :knowledge-point/title "Identifying When a Rational Function has no Vertical Asymptotes"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "15f2dcf3-b7da-5207-a75c-12f5aab228de" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=\\frac{3}{2}" :db/id #edb/ref 17592186321324} {:answer/id #uuid "2d333293-812e-550f-be94-d57de33d86b8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=\\frac{3}{4}" :db/id #edb/ref 17592186321498} {:answer/id #uuid "3e848eef-3137-5776-aaca-65af02d8767e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=6" :db/id #edb/ref 17592186321638} {:answer/id #uuid "40ee8b23-a651-5c65-b7f7-c17eaad7aa2c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "No vertical asymptotes" :db/id #edb/ref 17592186321664} {:answer/id #uuid "77dc533c-b6a2-5d5c-aab6-a0419fb093db" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=\\frac{3}{8}" :db/id #edb/ref 17592186322087}] :answer-field/correct {:answer/id #uuid "40ee8b23-a651-5c65-b7f7-c17eaad7aa2c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "No vertical asymptotes" :db/id #edb/ref 17592186321664} :answer-field/id #uuid "7758aae7-f886-5729-92ed-f1adeb80d088" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186323403}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "07860f00-c712-5f63-bfe2-a24e46e0db46" :question/math-academy-id "q-37070" :question/problem "Find the vertical asymptotes of $f(x)=\\frac{4{x}^{2}-3x}{8x-6}.$" :question/worked-solution "Let's simplify the expression by factoring both the numerator and the denominator:\n\n$$\n\\begin{aligned}\\frac{4{x}^{2}-3x}{8x-6} & =\\frac{x(4x-3)}{2(4x-3)}=\\frac{x}{2}.\\end{aligned}\n$$\n\nSince the denominator is never zero, we conclude that this function has no vertical asymptotes. A plot of the function is below. Note that it is not defined at $x=\\frac{3}{4}.$\n\n![](images/3e/3e6ebc8eaec86276442b13fde934234fdaf9c4a457398bb1b792c6910350e44c.png)"}] [{:db/id #edb/ref 17592186392101 :knowledge-point/_questions [{:db/id #edb/ref 17592186100978 :knowledge-point/id #uuid "bdd4a2e4-b0e6-54e8-972c-3dc194ce4ab3" :knowledge-point/title "Computing the One-Sided Limits of a Piecewise Function when the Limits Do Not Coincide"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1f56bdd5-a607-5af2-b88c-b12454f5dbac" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{lim}_{x\\to \\,{0}^{-}}f(x)=2" :db/id #edb/ref 17592186392103} {:answer/id #uuid "f80ff926-3aa7-5c1c-b968-b56b246178c3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{lim}_{x\\to \\,{0}^{-}}f(x)=\\text{DNE}" :db/id #edb/ref 17592186392104} {:answer/id #uuid "544549f0-b759-5c27-aa3c-4223a9df60df" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{lim}_{x\\to \\,{0}^{-}}f(x)=-1" :db/id #edb/ref 17592186392105} {:answer/id #uuid "4fccaa0b-2b3d-58c3-881e-5c696c14c18c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{lim}_{x\\to \\,{0}^{-}}f(x)=1" :db/id #edb/ref 17592186392106} {:answer/id #uuid "8a29317f-e4cb-5886-99c5-3539d5b2e238" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{lim}_{x\\to \\,{0}^{-}}f(x)=0" :db/id #edb/ref 17592186392107}] :answer-field/correct {:answer/id #uuid "8a29317f-e4cb-5886-99c5-3539d5b2e238" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{lim}_{x\\to \\,{0}^{-}}f(x)=0" :db/id #edb/ref 17592186392107} :answer-field/id #uuid "04efa2b5-a248-5966-8fd4-c3f5d9dc1a1b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186392102}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "14d10373-1baf-5303-9f9f-7dbe595ac72a" :question/math-academy-id "q-37488" :question/problem "Find the left-sided limit at $x=0$ for the function\n\n$$\nf(x)={\\begin{aligned}\\operatorname{tan}⁡x & \\text{ for }\\,-\\frac{\\pi }{2}<x\\le 0 \\\\ {log}_{2}⁡x & \\text{ for }\\,x>0.\\end{aligned}\n$$" :question/worked-solution "Approaching from the left, we have $x<0,$ so we use the expression $f(x)=\\operatorname{tan}⁡x.$ We get\n\n$$\n\\begin{aligned}{lim}_{x\\to {0}^{-}}f(x) & ={lim}_{x\\to {0}^{-}}\\operatorname{tan}⁡x \\\\  & =\\operatorname{tan}⁡0 \\\\  & =0.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186323924 :knowledge-point/_questions [{:db/id #edb/ref 17592186124661 :knowledge-point/id #uuid "32cbf366-20bd-5a52-a14f-83add698bf07" :knowledge-point/title "Evaluating a Limit at Infinity: Rational Solutions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "400f0091-175f-5587-84b8-9c92e0445d78" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186321651} {:answer/id #uuid "463439b5-0cfc-525b-89ed-52c822437a9f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{3}" :db/id #edb/ref 17592186321701} {:answer/id #uuid "689d0a5e-3cbe-5251-93c7-9224aa737768" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "Does not exist." :db/id #edb/ref 17592186321963} {:answer/id #uuid "fdbe2c23-cb67-5e33-ae6d-6470a9763727" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\infty " :db/id #edb/ref 17592186323149} {:answer/id #uuid "feda0822-7e47-547f-b9e2-686fb2b48328" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\infty " :db/id #edb/ref 17592186323159}] :answer-field/correct {:answer/id #uuid "463439b5-0cfc-525b-89ed-52c822437a9f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{3}" :db/id #edb/ref 17592186321701} :answer-field/id #uuid "c7b2c792-031f-57b9-a80b-617c4464ff0b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186323563}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "be3f2ca8-5451-5c14-b7e4-a6be8ff17159" :question/math-academy-id "q-3762" :question/problem "${lim}_{x\\to -\\infty }\\,\\,\\frac{-2{x}^{3}+{x}^{2}}{6{x}^{3}-9}=$" :question/worked-solution "First, we divide both the numerator and the denominator by the highest power of $x$ in the denominator, which is ${x}^{3}.$ Then, by noting that the reciprocals shrink to $0$ in the limit, we can then evaluate the resulting expression.\n\n$$\n\\begin{aligned}{lim}_{x\\to -\\infty }\\,\\,\\frac{-2{x}^{3}+{x}^{2}}{6{x}^{3}-9} & ={lim}_{x\\to -\\infty }\\,\\,\\frac{(\\frac{-2{x}^{3}}{{x}^{3}}+\\frac{{x}^{2}}{{x}^{3}})}{(\\frac{6{x}^{3}}{{x}^{3}}-\\frac{9}{{x}^{3}})} \\\\  & ={lim}_{x\\to -\\infty }\\,\\,\\frac{(-2+\\frac{1}{x})}{(6-\\frac{9}{{x}^{3}})} \\\\  & =\\frac{-2+0}{6-0} \\\\  & =-\\frac{1}{3}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186125111 :knowledge-point/_questions [{:db/id #edb/ref 17592186124515 :knowledge-point/id #uuid "dd0537f8-b091-580a-974e-8e928d54939d" :knowledge-point/title "Finding the Image of a Vector Under a Linear Transformation Given its Standard Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1ef73df9-84ec-5f34-a71b-fe726195bfd8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}3 \\\\ 4 \\\\ 3\\end{aligned}]" :db/id #edb/ref 17592186321383} {:answer/id #uuid "3efa9ca2-24ec-5607-8469-50498346ff15" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}16 \\\\ 3 \\\\ 3\\end{aligned}]" :db/id #edb/ref 17592186321642} {:answer/id #uuid "eb9025d4-18ab-5385-94bd-26181314bc40" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}12 \\\\ 6 \\\\ 6\\end{aligned}]" :db/id #edb/ref 17592186322992} {:answer/id #uuid "eedbea08-593d-5c3a-a72c-6b6885d23514" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}3 \\\\ 12 \\\\ 3\\end{aligned}]" :db/id #edb/ref 17592186323029} {:answer/id #uuid "fa65dcba-2e33-5614-8e1f-2c508af52fb5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}3 \\\\ 3 \\\\ 12\\end{aligned}]" :db/id #edb/ref 17592186323123}] :answer-field/correct {:answer/id #uuid "3efa9ca2-24ec-5607-8469-50498346ff15" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}16 \\\\ 3 \\\\ 3\\end{aligned}]" :db/id #edb/ref 17592186321642} :answer-field/id #uuid "ba434382-4384-5494-9593-15482668b874" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186323533}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "12f3bb3a-f83c-5bc7-89c6-1af5031ec24d" :question/math-academy-id "q-37881" :question/problem "Consider the matrix $T$ and the vector $v$ given below. If $T$ is the standard matrix of the linear transformation $T,$ find $T(v).$\n\n$$\nT=[\\begin{aligned}-2 & 4 & -1 \\\\ 5 & 1 & 3 \\\\ -1 & 3 & 4\\end{aligned}],\\,v=[\\begin{aligned}1 \\\\ 4 \\\\ -2\\end{aligned}]\n$$" :question/worked-solution "Using the fact that $\\,T(v)=T\\cdot v,$ we get\n\n$$\n\\begin{aligned}T(v) & =T\\cdot v \\\\  & =[\\begin{aligned}-2 & 4 & -1 \\\\ 5 & 1 & 3 \\\\ -1 & 3 & 4\\end{aligned}]\\cdot [\\begin{aligned}1 \\\\ 4 \\\\ -2\\end{aligned}] \\\\  & =[\\begin{aligned}16 \\\\ 3 \\\\ 3\\end{aligned}].\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186323956 :knowledge-point/_questions [{:db/id #edb/ref 17592186064318 :knowledge-point/id #uuid "70029065-69c3-585d-a6a1-cc9d2485a60a" :knowledge-point/title "Applying the Definition of Continuity to Evaluate a Limit"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "91fbca89-c577-5e53-936f-3be4371d6739" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{3}" :db/id #edb/ref 17592186322305} {:answer/id #uuid "a4d2dab8-cede-584b-9e20-5115b3d14dfb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186322441} {:answer/id #uuid "e53eb49d-9767-5e28-a2f3-ab6cd8a7a0ae" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186322942} {:answer/id #uuid "ed71d143-9343-52d1-af9f-9b40f8a55525" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186323019} {:answer/id #uuid "ed9ee2db-b77f-5cab-9284-b745cebd2507" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186323021}] :answer-field/correct {:answer/id #uuid "a4d2dab8-cede-584b-9e20-5115b3d14dfb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186322441} :answer-field/id #uuid "1bfbccbb-cbf5-52c1-a3ca-3a74ad96eac6" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186323224}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "cb646a61-3e18-55e1-850b-c5318af9cd57" :question/math-academy-id "q-37900" :question/problem "If $f(x)$ is continuous at $x=-1$ and $f(-1)=-3,$ then what is ${lim}_{x\\to {(-1)}^{-}}f(x)?$" :question/worked-solution "We're told that $f(x)$ is continuous at $x=-1.$ According to the definition of continuity, this means that ${lim}_{x\\to (-1)}f(x)$ exists and\n\n$$\n{lim}_{x\\to (-1)}f(x)=f(-1)=-3.\n$$\n\nTherefore, \n\n$$\n{lim}_{x\\to {(-1)}^{-}}f(x)={lim}_{x\\to (-1)}f(x)=-3.\n$$"}] [{:db/id #edb/ref 17592186323957 :knowledge-point/_questions [{:db/id #edb/ref 17592186110755 :knowledge-point/id #uuid "3c73db44-2ec2-5025-9431-acb02e414916" :knowledge-point/title "Computing a Trigonometric Ratio Using the Pythagorean Identity"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1d8126b5-2054-5d88-865f-be6cbe674d45" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{8}" :db/id #edb/ref 17592186321368} {:answer/id #uuid "3466518b-1130-594a-9f91-8439ec16fa46" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{4}" :db/id #edb/ref 17592186321544} {:answer/id #uuid "51eee8c3-23ea-5613-a452-4c2182222cb3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{4}{3}" :db/id #edb/ref 17592186321794} {:answer/id #uuid "5ba4b8d7-052a-5cf2-86db-50636fe22d83" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{6}{5}" :db/id #edb/ref 17592186321871} {:answer/id #uuid "c2131ada-4ea2-5f29-85f1-aa42dc442a53" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{2}" :db/id #edb/ref 17592186322653}] :answer-field/correct {:answer/id #uuid "3466518b-1130-594a-9f91-8439ec16fa46" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{4}" :db/id #edb/ref 17592186321544} :answer-field/id #uuid "617b107f-dc16-5899-aab5-ab0f5850cc8b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186323364}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "9112180a-ac6b-5472-ba8b-819d346ead1b" :question/math-academy-id "q-37915" :question/problem "![](images/6c/6c36dbce847c719accc77fa15f33dfb9a87cfae669691afe30f7693663076d2e.png)\n\nThe diagram above shows the unit circle. Given that the $y$-coordinate of the point $P$ is $\\frac{\\sqrt{10}}{4},$ use the Pythagorean identity to find $2{cos}^{2}⁡\\theta .$" :question/worked-solution "![](images/52/52fe94bb303a001e89f9db221e9730d4ca8c5c284217aa20fb6084ee041dec66.png)\n\nAny point $(x,y)$ on the unit circle is related to the central angle $\\theta $ as follows:\n\n$$\nx=cos⁡\\theta ,\\,y=sin⁡\\theta \n$$\n\nWe're given that $y=\\frac{\\sqrt{10}}{4}$ at the point $P.$ Therefore, we have\n\n$$\nsin⁡\\theta =\\frac{\\sqrt{10}}{4}.\n$$\n\nWe can use the Pythagorean identity to find $2{cos}^{2}⁡\\theta :$\n\n$$\n\\begin{aligned}{sin}^{2}⁡\\theta +{cos}^{2}⁡\\theta  & =1 \\\\ {cos}^{2}⁡\\theta  & =1-{sin}^{2}⁡\\theta  \\\\ 2{cos}^{2}⁡\\theta  & =2-2{sin}^{2}⁡\\theta \\end{aligned}\n$$\n\nSubstituting $sin⁡\\theta =\\frac{\\sqrt{10}}{4}$ gives\n\n$$\n\\begin{aligned}2{cos}^{2}⁡\\theta  & =2-2{(\\frac{\\sqrt{10}}{4})}^{2} \\\\  & =2-2(\\frac{10}{16}) \\\\  & =2-\\frac{20}{16} \\\\  & =\\frac{3}{4}.\\end{aligned}\n$$\n\nSo our final answer is $2{cos}^{2}⁡\\theta =\\frac{3}{4}.$"}] [{:db/id #edb/ref 17592186326672 :knowledge-point/_questions [{:db/id #edb/ref 17592186059847 :knowledge-point/id #uuid "979859e4-b60c-548d-8da6-b180400e1b07" :knowledge-point/title "Calculating the Determinant of a 3x3 Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "11f2d595-4c96-599f-b04a-ef1a4facbf7d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-12" :db/id #edb/ref 17592186324134} {:answer/id #uuid "35476165-d1db-5ee5-b183-b3201978c25b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186324408} {:answer/id #uuid "36554c2e-a686-5080-983a-7fd2be339db8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186324414} {:answer/id #uuid "5dc9de58-8130-508b-ad5a-dc48cfe4914d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "12" :db/id #edb/ref 17592186324751} {:answer/id #uuid "a45499fc-34c3-5b71-b300-396e74e38e5c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-6" :db/id #edb/ref 17592186325368}] :answer-field/correct {:answer/id #uuid "11f2d595-4c96-599f-b04a-ef1a4facbf7d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-12" :db/id #edb/ref 17592186324134} :answer-field/id #uuid "17302b73-c3c5-5ca7-9ed6-b18a09cd2b48" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186326262}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "687c1640-263b-54f0-8cd7-1fc76a39da2b" :question/math-academy-id "q-38180" :question/problem "Find the value of $|\\begin{aligned}0 & -1 & 3 \\\\ 1 & 0 & 2 \\\\ 3 & -2 & 0\\end{aligned}|.$" :question/worked-solution "Using the formula, we take the alternating sum of the entries in the top row of the matrix, multiplied by their respective minors, as follows:\n\n$$\n\\begin{aligned}|\\begin{aligned}0 & -1 & 3 \\\\ 1 & 0 & 2 \\\\ 3 & -2 & 0\\end{aligned}| & =0|\\begin{aligned}0 & 2 \\\\ -2 & 0\\end{aligned}|-(-1)|\\begin{aligned}1 & 2 \\\\ 3 & 0\\end{aligned}|+3|\\begin{aligned}1 & 0 \\\\ 3 & -2\\end{aligned}| \\\\  & =0+1(0-6)+3(-2-0) \\\\  & =1\\cdot (-6)+3\\cdot (-2) \\\\  & =-6-6 \\\\  & =-12\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186129638 :knowledge-point/_questions [{:db/id #edb/ref 17592186129254 :knowledge-point/id #uuid "344f1838-a027-5fd5-82da-17e9b4fcac2b" :knowledge-point/title "Further Translating Problems With Proportional Rates of Change Into Differential Equations"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "874fff2e-ad05-545d-b9da-54afafb38522" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{dD}{dt} = kD, k > 0" :db/id #edb/ref 17592186127310} {:answer/id #uuid "8fbdf968-a3aa-5c7c-bee0-f3e5cdef2d93" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{dD}{dt} =-kt, k > 0" :db/id #edb/ref 17592186127311} {:answer/id #uuid "0f4bda65-3235-5e5f-bca3-363e844b6c69" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{dD}{dt} = kt, k > 0" :db/id #edb/ref 17592186127312} {:answer/id #uuid "1d0e73de-fef3-542f-948e-ab7d50987655" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{dD}{dt} =-\\frac{k}{t^{2}}, k > 0" :db/id #edb/ref 17592186127313} {:answer/id #uuid "77b6d1c9-13bd-55b9-bf57-aaf485a87dc1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{dD}{dt} = kt^{2}, k > 0" :db/id #edb/ref 17592186127314}] :answer-field/id #uuid "7ce1a994-8031-5aae-8482-b5c5180c0212" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186127309} {:answer-field/choices [{:answer/id #uuid "2c5a7d28-429d-5869-a68d-4d92f36195cd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\text{d}D}{\\text{d}t}=kt,\\,\\,k>0" :db/id #edb/ref 17592186402624} {:answer/id #uuid "c87a8f69-4b14-5096-8f83-ef9eed495b9d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\text{d}D}{\\text{d}t}=k{t}^{2},\\,\\,k>0" :db/id #edb/ref 17592186402625} {:answer/id #uuid "ed230839-dcea-57e5-a62d-204f0b996646" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\text{d}D}{\\text{d}t}=-\\frac{k}{{t}^{2}},\\,\\,k>0" :db/id #edb/ref 17592186402626} {:answer/id #uuid "7b35292d-237a-56fe-bfb7-1ff65aaee600" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\text{d}D}{\\text{d}t}=kD,\\,\\,k>0" :db/id #edb/ref 17592186402627} {:answer/id #uuid "78931a87-f659-54d0-8ce9-c7e8a7e38fe2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\text{d}D}{\\text{d}t}=-kt,\\,\\,k>0" :db/id #edb/ref 17592186402628}] :answer-field/correct {:answer/id #uuid "c87a8f69-4b14-5096-8f83-ef9eed495b9d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\text{d}D}{\\text{d}t}=k{t}^{2},\\,\\,k>0" :db/id #edb/ref 17592186402625} :answer-field/id #uuid "a733e896-0f87-5db4-b6c7-ab7a478c7bf4" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186402623}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "f8683314-e1cb-5e62-aca4-60ca1e1c5bf9" :question/math-academy-id "q-38313" :question/problem "A skater is skating straight down a ramp. The displacement $D$ of the skater increases at a rate that's proportional to the square of the time $t,$ in seconds.\nWhat differential equation describes the rate of change of displacement $D$ at time $t,$ where $t$ is the time since he started skating?" :question/worked-solution "Let's highlight the important words in the given statement:\n\n*A skater is skating straight down a ramp. The **displacement** $D$ of the skater **increases** at a **rate** that's **proportional** to the **square of the time** $t,$ in seconds. *\n\nWe note the following:\n\n- The question describes the *rate* at which the *displacement* varies. Therefore, this is a statement about the quantity \n\n$$\n\\frac{\\text{d}D}{\\text{d}t}.\n$$\n\n- We're told that $\\frac{\\text{d}D}{\\text{d}t}$ is *proportional to* the *square of the time.* In other words,\n\n$$\n\\frac{\\text{d}D}{\\text{d}t}∝{t}^{2}.\n$$\n\nRecall that $∝$ means \"is proportional to.\"\n\n- Finally, we want to replace the proportionality symbol with an equality symbol. Let $k$ be a positive constant. Since the displacement *increases* with time, our derivative should be *positive*. Therefore, we can rewrite our proportionality statement as\n\n$$\n\\frac{\\text{d}D}{\\text{d}t}=k{t}^{2}.\n$$"}] [{:db/id #edb/ref 17592186326691 :knowledge-point/_questions [{:db/id #edb/ref 17592186068700 :knowledge-point/id #uuid "81247553-750f-5bf7-a1c4-698ad63b5ae4" :knowledge-point/title "Identifying True Statements Regarding Left- and Right-Continuity"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "374ae646-8b4e-5b0e-bd7e-4acb5d1c0ed8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "None of the statements are true" :db/id #edb/ref 17592186324420} {:answer/id #uuid "7d1612fc-e261-50ce-9313-fe26f50738e4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186325026} {:answer/id #uuid "c86a33ca-8732-5643-a35e-d2538c0e58e8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186325709} {:answer/id #uuid "d3e6cb1a-5418-5746-8b18-030e1c8789a1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186325813} {:answer/id #uuid "f0206e22-2c8b-5150-92b8-e52b0d52a598" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186326089}] :answer-field/correct {:answer/id #uuid "374ae646-8b4e-5b0e-bd7e-4acb5d1c0ed8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "None of the statements are true" :db/id #edb/ref 17592186324420} :answer-field/id #uuid "5b0c2133-1c76-5099-a8ab-82d13698a8d7" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186326375}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "aa66e43c-92cc-5831-9942-3be250ef9ed8" :question/math-academy-id "q-38546" :question/problem "![](images/8f/8fdb835ed2998fae4d8afc3fd5e593bac6c72b1ee45c8b4fe01bdc4348322d1e.png)\n\nWhich of the following statements are true regarding the function $y=f(x)$ plotted above?\n\n- The function is left-continuous at $x=-1$\n- The function is right-continuous at $x=-1$\n- The function is continuous at $x=-1$" :question/worked-solution "Let's look at each statement in turn:\n\n- Statement I is false. The function is not left-continuous at $x=-1,$ since the left-sided limit is not equal to the function value:\n\n$$\n{lim}_{x\\to (-1)^{-}}f(x)=-1\\ne 1=f(-1)\n$$\n\n- Statement II is false. The function is not right-continuous at $x=-1,$ since the right-sided limit is not equal to the function value:\n\n$$\n{lim}_{x\\to (-1)^{+}}f(x)=-1\\ne 1=f(-1)\n$$\n\n- Statement III is false. In order for the function to be continuous at $x=-1,$ it must be both left-continuous and right-continuous. However, we have already determined that the function is neither left-continuous nor right-continuous at this point.\n\nIn conclusion, none of the statements are true."}] [{:db/id #edb/ref 17592186402649 :knowledge-point/_questions [{:db/id #edb/ref 17592186129148 :knowledge-point/id #uuid "34aa8f4e-20f1-5dda-ac53-6eb411543897" :knowledge-point/title "Identifying True Statements Regarding the Graph of a Polynomial"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "09148cf6-e660-5422-9fa7-a9f4738defd3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186402651} {:answer/id #uuid "3340c634-8f83-5193-ae75-2b37a7b6c946" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186402652} {:answer/id #uuid "f4481476-873e-5b4e-a202-210e8449c587" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186402653} {:answer/id #uuid "63b1b59c-8954-5973-ae03-cc16a86d080d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186402654} {:answer/id #uuid "a0f0241d-3539-5ced-b138-fdde689dc4a7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186402655}] :answer-field/correct {:answer/id #uuid "3340c634-8f83-5193-ae75-2b37a7b6c946" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186402652} :answer-field/id #uuid "7f13134e-6c13-54bc-aaf2-8a968a13df74" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186402650}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "e4ced118-ede6-56c5-a59a-002b28515d4b" :question/math-academy-id "q-38580" :question/problem "![](images/ea/ea87f040e4249a04c21dd6c8466ffd194d60753056c29f00d8956e182db61ff3.png)\n\nThe graph of the polynomial $y=F(x)$ is shown above. Which of the following statements are true?\n\nI. The degree of $F(x)$ is odd.\nII. The degree of $F(x)$ is even.\nIII. The coefficient of the leading term is positive." :question/worked-solution "The end behavior of $F(x)$ is\n\n- $F(x)\\to \\infty $ as $x\\to \\infty ,$ and\n\n- $F(x)\\to -\\infty $ as $x\\to -\\infty .$\n\nConsequently, \n\n- the degree of $F(x)$ is odd, and\n\n- the leading coefficient of $F(x)$ is positive.\n\nSo II is false, and I and III are true."}] [{:db/id #edb/ref 17592186326698 :knowledge-point/_questions [{:db/id #edb/ref 17592186129119 :knowledge-point/id #uuid "255dee12-5f44-536b-b679-5a894843395d" :knowledge-point/title "Translating Problems With Proportional Rates of Change Into Differential Equations"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "117b0f2a-a546-5344-bfb8-3e0c41afbbc5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\text{d}V}{\\text{d}t}=-kV,\\,k>0" :db/id #edb/ref 17592186324131} {:answer/id #uuid "395db5bb-f296-567c-91ea-db87d69ea219" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\text{d}V}{\\text{d}t}=kV,\\,k>0" :db/id #edb/ref 17592186324435} {:answer/id #uuid "41eb7615-c4fd-5775-8878-99d3a9cb550f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\text{d}V}{\\text{d}t}=k+V,\\,k>0" :db/id #edb/ref 17592186324504} {:answer/id #uuid "b71b1c89-8e55-546e-8485-90db0a36d0ee" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "t\\frac{\\text{d}V}{\\text{d}t}=-V" :db/id #edb/ref 17592186325544} {:answer/id #uuid "f047554c-a8e1-5e18-881a-83ed20299fda" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\text{d}V}{\\text{d}t}=-tV" :db/id #edb/ref 17592186326092}] :answer-field/correct {:answer/id #uuid "117b0f2a-a546-5344-bfb8-3e0c41afbbc5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\text{d}V}{\\text{d}t}=-kV,\\,k>0" :db/id #edb/ref 17592186324131} :answer-field/id #uuid "cdf79fb1-73e0-5037-8b11-7d7606258ed9" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186326595}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "eafaeb15-26b6-5234-a17e-a3acc08c3e0c" :question/math-academy-id "q-38593" :question/problem "The number of weekly sales of a particular book decreases with time. The number of units sold at any given moment decreases at a rate that's proportional to the number of units sold at that moment. What differential equation describes the rate of change of the number of units sold $V(t)$ at time $t,$ where $t$ is the time since the book first went on sale?" :question/worked-solution "Let's highlight the important words in the given statement:\n\n*The **number of units sold** at any given moment **decreases** at a **rate** that is **proportional** to **the number of units sold** at that moment.* \n\nWe note the following:\n\n- The question describes the *rate* at which the *number of units sold* of a particular book varies. Therefore, this is a statement about the quantity \n\n$$\n\\frac{\\text{d}V}{\\text{d}t}.\n$$\n\n- We're told that $\\frac{\\text{d}V}{\\text{d}t}$ is *proportional to* the *number of units sold.* In other words,\n\n$$\n\\frac{\\text{d}V}{\\text{d}t}∝V.\n$$\n\nRecall that $∝$ means \"is proportional to.\"\n\n- Finally, we want to replace the proportionality symbol with an equality symbol. Let $k$ be a positive constant. Since the number of units sold *decreases* with time, our derivative should be *negative*. Therefore, we can rewrite our proportionality statement as\n\n$$\n\\frac{\\text{d}V}{\\text{d}t}=-kV.\n$$"}] [{:db/id #edb/ref 17592186129679 :knowledge-point/_questions [{:db/id #edb/ref 17592186129148 :knowledge-point/id #uuid "34aa8f4e-20f1-5dda-ac53-6eb411543897" :knowledge-point/title "Identifying True Statements Regarding the Graph of a Polynomial"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "520ce037-6d65-5a87-816c-38b9a9d22f11" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I, II, and III" :db/id #edb/ref 17592186324642} {:answer/id #uuid "b137372b-d54b-51cb-8c70-5c8eaabe8e23" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186325482} {:answer/id #uuid "c7ee0489-97b3-566f-8f0e-c62d506da27a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186325704} {:answer/id #uuid "cb11e15c-7b44-5232-8e56-3e85080ab86c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186325731} {:answer/id #uuid "e61483f3-87ce-5ef0-b035-b6a704d798b2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186325997}] :answer-field/correct {:answer/id #uuid "b137372b-d54b-51cb-8c70-5c8eaabe8e23" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186325482} :answer-field/id #uuid "ceb549ca-f772-54ab-ac92-58fb214b0833" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186326598}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "7f40578d-2e88-5fde-bb73-48381fd621fe" :question/math-academy-id "q-38617" :question/problem "![](images/fb/fb4959f437e11b767be136a2a024260d45ed29805cd57b1832d74d7cc2da11c1.png)\n\nThe graph of a polynomial $y=P(x)$ is shown above. Which of the following statements are true?\n\n- $P(x)\\to \\infty $ as $x\\to -\\infty .$\n- The degree of $P(x)$ is odd.\n- The coefficient of the leading term is negative." :question/worked-solution "The end behavior of $P(x)$ is\n\n- $P(x)\\to -\\infty $ as $x\\to -\\infty ,$ and\n\n- $P(x)\\to -\\infty $ as $x\\to \\infty .$\n\nConsequently, \n\n- the degree of $P(x)$ is even, and\n\n- the leading coefficient of $P(x)$ is negative.\n\nTherefore, statements I and II are false, while statement III is true."}] [{:db/id #edb/ref 17592186129680 :knowledge-point/_questions [{:db/id #edb/ref 17592186129144 :knowledge-point/id #uuid "ef7cf112-ab08-5e7a-855d-91bb69ec7f76" :knowledge-point/title "Identifying the Polynomial Given its Graph"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8fbb6282-911b-5b66-b192-305d440d6e16" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y = 2x^{6} + x^{4} - 5x - 1" :db/id #edb/ref 17592186127562} {:answer/id #uuid "a5a044cc-7963-5872-b7e6-6d9a2f224fbe" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y =-7x^{8} + 6x^{7} - 4x^{3} + 2x^{2} - 2" :db/id #edb/ref 17592186127563} {:answer/id #uuid "ecb2454f-bf3e-5aa4-afce-9896ef787f3e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y =-5x^{5} + 3x^{2} + x + 1" :db/id #edb/ref 17592186127564} {:answer/id #uuid "3e5b9971-58f5-5d6d-9f95-7c155519b2d8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y =-x^{3} + 2x - 1" :db/id #edb/ref 17592186127565} {:answer/id #uuid "4c0c079c-6769-57c1-b736-a89c4eef2463" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y = x^{3} - x^{2} + x - 3" :db/id #edb/ref 17592186127566}] :answer-field/id #uuid "db6524ac-b4e5-521e-a137-1133e610aa7b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186127561} {:answer-field/choices [{:answer/id #uuid "cb2ff6c4-35ee-5c86-88b6-f2b778bb9b49" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=-{x}^{3}+2x-1" :db/id #edb/ref 17592186402657} {:answer/id #uuid "0cf46694-f517-57c1-b656-f30bd243fe5f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=-7{x}^{8}+6{x}^{7}-4{x}^{3}+2{x}^{2}-2" :db/id #edb/ref 17592186402658} {:answer/id #uuid "0cabba40-fb5e-5284-8447-f1cf64e6820e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=2{x}^{6}+{x}^{4}-5x-1" :db/id #edb/ref 17592186402659} {:answer/id #uuid "e52d814a-f821-5e6e-934c-6f5a0f7ba906" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y={x}^{3}-{x}^{2}+x-3" :db/id #edb/ref 17592186402660} {:answer/id #uuid "343e1b78-b8cf-5288-841e-bb541f7dedd1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=-5{x}^{5}+3{x}^{2}+x+1" :db/id #edb/ref 17592186402661}] :answer-field/correct {:answer/id #uuid "cb2ff6c4-35ee-5c86-88b6-f2b778bb9b49" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=-{x}^{3}+2x-1" :db/id #edb/ref 17592186402657} :answer-field/id #uuid "702788a0-aadc-5877-8e1c-f586a9038e3d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186402656}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "0e1b36cf-56ef-56e7-80a1-3a4e3d34ad42" :question/math-academy-id "q-38624" :question/problem "![](images/d8/d873bd2af8e397d6c540267340b6105f413928c4279b939110aa4bb5b00d8948.png)\n\nWhich of the following polynomials could be the function shown in the diagram above?" :question/worked-solution "Let's call $P(x)$ the polynomial shown in the diagram.\n\nThe end behavior of $P(x)$ is\n\n- $P(x)\\to \\infty $ as $x\\to -\\infty ,$ and\n\n- $P(x)\\to -\\infty $ as $x\\to \\infty .$\n\nConsequently, \n\n- the degree of $P(x)$ is odd, and\n\n- the leading coefficient of $P(x)$ is negative.\n\n- the $y$-intercept is negative, which means that $P(0)<0.$\n\nTherefore, of the given options, only $P(x)=-{x}^{3}+2x-1$ satisties all these conditions."}] [{:db/id #edb/ref 17592186326703 :knowledge-point/_questions [{:db/id #edb/ref 17592186129144 :knowledge-point/id #uuid "ef7cf112-ab08-5e7a-855d-91bb69ec7f76" :knowledge-point/title "Identifying the Polynomial Given its Graph"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "11ec8bba-61a9-5e53-9f83-ae6306a35d16" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=-\\frac{\\sqrt{3}}{2}{x}^{6}+\\sqrt{7}{x}^{3}+x-1" :db/id #edb/ref 17592186324133} {:answer/id #uuid "1d3e9e3c-8f63-5b55-a2b5-d6ae2f7cc85b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=-2{x}^{4}+{x}^{2}-x+2" :db/id #edb/ref 17592186324219} {:answer/id #uuid "4a6cc728-1b58-586c-b553-5f4c6de4cade" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=-3{x}^{3}+8x+2" :db/id #edb/ref 17592186324575} {:answer/id #uuid "858b3ba7-0126-52d6-a92c-623111bcf464" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=4{x}^{8}+4{x}^{2}+6x+3" :db/id #edb/ref 17592186325099} {:answer/id #uuid "d96579c4-211b-512e-819d-f2e5755afaf1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=6{x}^{5}+4{x}^{4}-7{x}^{3}+6{x}^{2}-3x+2" :db/id #edb/ref 17592186325862}] :answer-field/correct {:answer/id #uuid "1d3e9e3c-8f63-5b55-a2b5-d6ae2f7cc85b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=-2{x}^{4}+{x}^{2}-x+2" :db/id #edb/ref 17592186324219} :answer-field/id #uuid "7c01c0f4-68e1-5f41-ac69-b50a572974f5" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186326444}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "c04700c1-06e0-50a6-8674-83b9d2f36915" :question/math-academy-id "q-38626" :question/problem "![](images/eb/eb467eed4327c7feaa4cb0aad4495032fe52518891bb6d33227352c953ce4d35.png)\n\nWhich of the following polynomials could be the function shown in the diagram above?" :question/worked-solution "Let's call $P(x)$ the polynomial shown in the diagram.\n\nThe end behavior of $P(x)$ is\n\n- $P(x)\\to -\\infty $ as $x\\to -\\infty ,$ and\n\n- $P(x)\\to -\\infty $ as $x\\to \\infty .$\n\nConsequently, \n\n- the degree of $P(x)$ is even, and\n\n- the leading coefficient of $P(x)$ is negative.\n\n- the $y$-intercept is positive, which means that $P(0)>0.$\n\nTherefore, of the given options, the only one that satisfies all three criteria is $y=-2{x}^{4}+{x}^{2}-x+2.$"}] [{:db/id #edb/ref 17592186326713 :knowledge-point/_questions [{:db/id #edb/ref 17592186129154 :knowledge-point/id #uuid "a66188f6-3228-59e9-9766-0f9bacbe8443" :knowledge-point/title "Identifying True Statements Regarding the Graph of a Given Polynomial"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "42f76b4e-c2e3-5210-b8b9-db6bc53bafc0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186324510} {:answer/id #uuid "868d64bf-05a4-5a8a-bb2f-f215d1a3fb4c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186325114} {:answer/id #uuid "aefcef1a-2486-5ad4-889b-d4796ad4702f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186325458} {:answer/id #uuid "dfae7751-a48a-56fb-8fe9-dabe433a0205" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186325924} {:answer/id #uuid "fd71fe36-ab9d-5173-8340-e63507c5a1eb" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I, II and III" :db/id #edb/ref 17592186326205}] :answer-field/correct {:answer/id #uuid "868d64bf-05a4-5a8a-bb2f-f215d1a3fb4c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186325114} :answer-field/id #uuid "b1d289fa-530e-56e8-81da-88ee4282c3b8" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186326541}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "fbe22a70-053f-5354-8d7b-dc32dacb2db4" :question/math-academy-id "q-38770" :question/problem "![](images/cd/cd19717bd41b787346a96394ce3bc4e38fe690340bb73bd3d11139d41ff977e2.png)\n\nThe graph of a polynomial $p(x)$ is shown above. Which of the following statements are true?\n\n- $x=2$ is a simple root.\n- $x=-1$ is a root of even multiplicity.\n- $p(x)\\to -\\infty $ as $x\\to \\infty .$" :question/worked-solution "Let's analyze each statement in turn.\n\n- Statement I is true. The root $x=2$ is a simple root because the graph crosses the $x$-axis at the point and the curve is not tangent to the $x$-axis at that point.\n\n- Statement II is true. The root $x=-1$  has an even multiplicity because at $x=-1$ the graph just touches the $x$-axis and reverses direction.\n\n- Statement III is false. As $x$ moves right in the positive direction towards $+\\infty ,$ the $y$ value moves up in the positive direction towards $+\\infty .$\n\nTherefore, the correct answer is \"I and II only\"."}] [{:db/id #edb/ref 17592186326722 :knowledge-point/_questions [{:db/id #edb/ref 17592186129094 :knowledge-point/id #uuid "eac988ba-ea97-52c7-90a7-d451ee7f49e5" :knowledge-point/title "Finding the Intervals on Which a Rational Function Is Continuous"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b2ecaae7-3c35-55c3-949a-8bc3ad796eaa" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-\\infty ,0)\\cup (0,\\infty )" :db/id #edb/ref 17592186325506} {:answer/id #uuid "bcc63a98-85e5-5224-9b6a-a9c5d63399a7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-\\infty ,1)\\cup (1,\\infty )" :db/id #edb/ref 17592186325592} {:answer/id #uuid "c44ce678-da9d-5026-bdf2-d1c31648eeec" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(0,7)" :db/id #edb/ref 17592186325659} {:answer/id #uuid "cc959c14-7321-5ed8-8a0d-e560f10b3ab1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-\\infty ,0)\\cup (0,1)\\cup (1,\\infty )" :db/id #edb/ref 17592186325745} {:answer/id #uuid "fb645e78-49d9-5243-b606-2ce3f8529efb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-\\infty ,0)\\cup (0,7)\\cup (7,\\infty )" :db/id #edb/ref 17592186326183}] :answer-field/correct {:answer/id #uuid "b2ecaae7-3c35-55c3-949a-8bc3ad796eaa" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-\\infty ,0)\\cup (0,\\infty )" :db/id #edb/ref 17592186325506} :answer-field/id #uuid "aebe9ce5-b166-55c6-9070-84eeedf233a8" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186326535}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "90ecbfdb-7e05-5892-b0cb-107f95150e27" :question/math-academy-id "q-38831" :question/problem "Determine the largest union of intervals on which the function $f(x)=\\frac{x-{x}^{2}}{7x}$ is continuous." :question/worked-solution "This is a rational function, so it is continuous at all points in its domain. To find its domain, we start by factoring the numerator:\n\n$$\n\\begin{aligned}f(x) & =\\frac{x-{x}^{2}}{7x} \\\\  & =\\frac{x(1-x)}{7x} \\\\  & =\\frac{1-x}{7},\\end{aligned}\n$$\n\n \n\nwhere $x\\ne 0.$\n\nThis function is continuous everywhere except at the excluded point $x=0.$\n\nTherefore, the domain consists of the union of the intervals $(-\\infty ,0),$ and $(0,\\infty ),$ namely\n\n$$\n(-\\infty ,0)\\cup (0,\\infty )\n$$\n\nand the function is also continuous on this union of intervals."}] [{:db/id #edb/ref 17592186326735 :knowledge-point/_questions [{:db/id #edb/ref 17592186129302 :knowledge-point/id #uuid "503a2d0a-ba6c-5529-9f26-b83c769a26a2" :knowledge-point/title "Finding the Domain of a Transformed Reciprocal Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "13b52373-27a9-501e-8947-0c1f244a213e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186324149} {:answer/id #uuid "5bec4237-30c8-54eb-a9f5-13ccaf205551" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x\\in (-\\infty ,2)\\cup (2,\\infty )" :db/id #edb/ref 17592186324732} {:answer/id #uuid "85ed53c0-2287-5169-b4e2-c59609989228" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x\\in (0,\\infty )" :db/id #edb/ref 17592186325105} {:answer/id #uuid "d964678d-9ceb-5d76-929a-65b4dd6a6052" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x\\in (-\\infty ,0)\\cup (2,\\infty )" :db/id #edb/ref 17592186325861} {:answer/id #uuid "df8ff16b-fe1f-5c14-b271-df5bace274b6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x\\in (-\\infty ,0)\\cup (0,\\infty )" :db/id #edb/ref 17592186325923}] :answer-field/correct {:answer/id #uuid "df8ff16b-fe1f-5c14-b271-df5bace274b6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x\\in (-\\infty ,0)\\cup (0,\\infty )" :db/id #edb/ref 17592186325923} :answer-field/id #uuid "d9cd61a3-c73b-5511-815b-f6d529fa4ad2" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186326616}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "45b870b0-b774-5b07-bef2-72f771e77f18" :question/math-academy-id "q-38999" :question/problem "What is the domain of the function $y=\\frac{2}{x}?$" :question/worked-solution "A reciprocal function is defined for all values of $x$ except for those that make the denominator zero. So, to find the domain, we must exclude all values of $x$ that make the denominator zero.\n\nSetting the denominator equal to zero and solving, we get\n\n$$\n\\begin{aligned}x & =0.\\end{aligned}\n$$\n\nTherefore, the domain is $x\\in (-\\infty ,0)\\cup (0,\\infty ).$"}] [{:db/id #edb/ref 17592186083681 :knowledge-point/_questions [{:db/id #edb/ref 17592186083310 :knowledge-point/id #uuid "001262b8-82b7-5421-80ac-8608b20d4be1" :knowledge-point/title "Factoring a Cubic Polynomial Using the Rational Roots Theorem"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "135f42a4-d1ee-5f2c-af3a-0c8aa0176bf9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{3}{5}" :db/id #edb/ref 17592186324143} {:answer/id #uuid "268df909-c8fb-563f-af2f-c08134584f25" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\sqrt{5}" :db/id #edb/ref 17592186324283} {:answer/id #uuid "69e770f2-5fac-5581-b92a-b1b948231e35" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{5}{3}" :db/id #edb/ref 17592186324857} {:answer/id #uuid "8b3c6363-b72d-5a0d-9eec-918fa9888a08" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5}{3}" :db/id #edb/ref 17592186325152} {:answer/id #uuid "fc9d3f67-6d9d-5067-8456-4fe529f4d545" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{5}" :db/id #edb/ref 17592186326194}] :answer-field/correct {:answer/id #uuid "69e770f2-5fac-5581-b92a-b1b948231e35" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{5}{3}" :db/id #edb/ref 17592186324857} :answer-field/id #uuid "4f2953d1-fb0d-5e3e-8ec9-21bd1672c52d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186326351}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "f572c08e-edf8-5f9d-9827-c106bc98ece4" :question/math-academy-id "q-39033" :question/problem "Given that the polynomial $f(x)=3{x}^{3}+5{x}^{2}-15x-25$ has one of its roots in the interval $(-2,-\\frac{1}{2}),$ find the sum of the distinct real roots of $f(x).$" :question/worked-solution "Given a polynomial with integer coefficients, the rational roots theorem states that any rational roots of the polynomial must take the form\n\n$$\n\\pm \\frac{\\text{factor of the constant term}}{\\text{factor of the leading coefficient}}.\n$$\n\nFor the given polynomial $f(x),$ the constant term is $-25$ and the leading coefficient is $3.$ So, any rational roots of $f(x)$ must take the form\n\n$$\n\\pm \\frac{\\text{factor of }-25}{\\text{factor of }3}.\n$$\n\nTherefore, the possible rational roots are as follows:\n\n$$\n\\pm 1,\\,\\pm 5,\\,\\pm 25,\\,\\pm \\frac{1}{3},\\,\\pm \\frac{5}{3},\\,\\pm \\frac{25}{3}\n$$\n\nOf these roots, the only roots in the interval $(-2,-\\frac{1}{2}),$ are $-1$ and $-\\frac{5}{3}.$\n\nNow, let's use synthetic division to test whether $(x+\\frac{5}{3})$ is a factor of $f(x).$ We get the following:\n\n|  | ${x}^{3}$ | ${x}^{2}$ | ${x}^{1}$ | ${x}^{0}$ |\n| --- | --- | --- | --- | --- |\n| $-\\frac{5}{3}$ | $3$ | $5$ | $-15$ | $-25$ |\n|  | $↓$ | $-5$ | $0$ | $25$ |\n|  | $3$ | $0$ | $-15$ | $0$ |\n\nSince the remainder is $0,$ we conclude that $(x+\\frac{5}{3})$ is indeed a factor of $f(x).$ Moreover, we have\n\n$$\nf(x)=(x+\\frac{5}{3})(3{x}^{2}-15).\n$$\n\nSince the highest-degree factor is now a quadratic, we can continue factoring using the usual methods:\n\n$$\n\\begin{aligned}f(x) & =(x+\\frac{5}{3})(3{x}^{2}-15) \\\\  & =3(x+\\frac{5}{3})({x}^{2}-5) \\\\  & =3(x+\\frac{5}{3})(x+\\sqrt{5})(x-\\sqrt{5})\\end{aligned}\n$$\n\nSetting the factors equal to $0,$ we find the roots $x=-\\frac{5}{3},-\\sqrt{5},\\sqrt{5}.$ Summing these roots, we get\n\n$$\n-\\frac{5}{3}-\\sqrt{5}+\\sqrt{5}=-\\frac{5}{3}.\n$$"}] [{:db/id #edb/ref 17592186402675 :knowledge-point/_questions [{:db/id #edb/ref 17592186105857 :knowledge-point/id #uuid "fc04f720-28f3-55ab-8e89-582db57672a4" :knowledge-point/title "Computing the Limit at Infinity of a General Polynomial"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7d1d0905-b59d-5d4a-909c-cea1b665a291" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\infty " :db/id #edb/ref 17592186402677} {:answer/id #uuid "f2fa7f39-114c-5150-972f-6a6f4f47133a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "16" :db/id #edb/ref 17592186402678} {:answer/id #uuid "77d63650-bd84-5a65-ad3f-110fff12b852" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\infty " :db/id #edb/ref 17592186402679} {:answer/id #uuid "a04b8362-fdb8-5b5f-84e2-c7356b9ecb6c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\text{DNE}" :db/id #edb/ref 17592186402680} {:answer/id #uuid "6d67d68d-f930-5fbf-a8ad-1dfef015cd8e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186402681}] :answer-field/correct {:answer/id #uuid "7d1d0905-b59d-5d4a-909c-cea1b665a291" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\infty " :db/id #edb/ref 17592186402677} :answer-field/id #uuid "570ae7f1-bab1-51b3-a682-ac5497a6d1ea" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186402676}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "494506ed-3be9-5fa5-a304-e992bf8e5303" :question/math-academy-id "q-3946" :question/problem "Calculate ${lim}_{x\\to \\infty }(4{x}^{2}-5x+16).$" :question/worked-solution "We identify the leading term and compute its limit:\n\n$$\n\\begin{aligned}{lim}_{x\\to \\infty }(4{x}^{2}-5x+16) & ={lim}_{x\\to \\infty }(4{x}^{2}) \\\\  & =4\\cdot {lim}_{x\\to \\infty }({x}^{2}) \\\\  & =\\infty \\,.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186129755 :knowledge-point/_questions [{:db/id #edb/ref 17592186129096 :knowledge-point/id #uuid "5ad95b4e-e367-5e26-800c-1a87a537ca83" :knowledge-point/title "Finding the Intervals on Which a Trigonometric Function Is Continuous"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "433bf40e-b58f-5f73-acd3-043724f4f0a1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-\\infty ,-1)\\cup (-1,1)\\cup (1,\\infty )" :db/id #edb/ref 17592186324514} {:answer/id #uuid "b5d08469-ad7b-5338-83f8-aa4eda61a77a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-1,1)" :db/id #edb/ref 17592186325534} {:answer/id #uuid "ba4f7279-6b09-5d5a-b7dd-914bf38083f6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-\\infty ,-1)\\cup (-1,1)" :db/id #edb/ref 17592186325571} {:answer/id #uuid "eab55c63-7bc8-5884-94c9-5575e81cf09c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-1,1)\\cup (1,\\infty )" :db/id #edb/ref 17592186326040} {:answer/id #uuid "f0a36cbf-0b55-59cd-a76e-8d0bcaae5e9a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-\\infty ,1)\\cup (1,\\infty )" :db/id #edb/ref 17592186326095}] :answer-field/correct {:answer/id #uuid "433bf40e-b58f-5f73-acd3-043724f4f0a1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-\\infty ,-1)\\cup (-1,1)\\cup (1,\\infty )" :db/id #edb/ref 17592186324514} :answer-field/id #uuid "c279fba3-e32a-5884-932a-62cb2020e6bd" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186326573}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "bdf79360-c3a2-5f70-b20e-0e9fca989978" :question/math-academy-id "q-39765" :question/problem "Find the largest union of intervals on which the function $f(x)=\\operatorname{sin}⁡(\\frac{3}{{x}^{2}-1})$ is continuous." :question/worked-solution "The function is a composition of two functions, a rational function, and a sine function.\n\nThe sine is continuous at all points in its domain, and its domain consists of all real numbers. So, we focus on the rational function.\n\nLikewise, the rational function $\\frac{3}{{x}^{2}-1}$ is continuous at all points in its domain. To find its domain, we start by factoring the denominator:\n\n$$\n\\begin{aligned}f(x) & =\\frac{3}{{x}^{2}-1} \\\\  & =\\frac{3}{(x-1)(x+1)}\\end{aligned}\n$$\n\nThis function is continuous everywhere except at the excluded points $x=-1$ and $x=1.$\n\nTherefore, the domain our original function consists of the union of the intervals $(-\\infty ,-1),$ $(-1,1),$ and $(1,\\infty ),$ namely\n\n$$\n(-\\infty ,-1)\\cup (-1,1)\\cup (1,\\infty )\n$$\n\nand the function is also continuous on these intervals."}] [{:db/id #edb/ref 17592186326782 :knowledge-point/_questions [{:db/id #edb/ref 17592186129096 :knowledge-point/id #uuid "5ad95b4e-e367-5e26-800c-1a87a537ca83" :knowledge-point/title "Finding the Intervals on Which a Trigonometric Function Is Continuous"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "00cc317f-9860-521f-8e35-82b0b96775d5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-\\frac{1}{2},\\infty )" :db/id #edb/ref 17592186323979} {:answer/id #uuid "1336a17d-6837-5de5-bf71-47722d0cc700" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-\\infty ,-\\frac{1}{2}]" :db/id #edb/ref 17592186324141} {:answer/id #uuid "20176902-9b53-52f9-8032-b69446a5fc1f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[-\\frac{1}{2},\\infty )" :db/id #edb/ref 17592186324236} {:answer/id #uuid "a203df96-a113-582e-930a-799f5e42f2cb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\frac{1}{2},\\infty )" :db/id #edb/ref 17592186325346} {:answer/id #uuid "d6617b71-5ede-536c-a0f7-693baf883f9a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(0,\\infty )" :db/id #edb/ref 17592186325835}] :answer-field/correct {:answer/id #uuid "20176902-9b53-52f9-8032-b69446a5fc1f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[-\\frac{1}{2},\\infty )" :db/id #edb/ref 17592186324236} :answer-field/id #uuid "0394152c-8a6f-59be-83ce-2e7929fa5c84" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186326229}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "2ae959f9-6d60-5b89-84b8-0851a7c0c42d" :question/math-academy-id "q-39769" :question/problem "Find the largest interval on which the function $f(x)=\\operatorname{cos}⁡(\\sqrt{2x+1})$ is continuous." :question/worked-solution "The function is a composition of two functions, a radical function, and a cosine function.\n\nThe cosine is continuous at all points in its domain, and its domain consists of all real numbers. So, we focus on the radical function.\n\nLikewise, the radical function $\\sqrt{2x+1}$ is continuous at all points in its domain. To find its domain, we set the expression under the radical to be greater than or equal to zero:\n\n$$\n\\begin{aligned}2x+1\\ge 0\\,⟹\\,2x\\ge -1\\,⟹\\,x\\ge -\\frac{1}{2}\\end{aligned}\n$$\n\nTherefore, the domain of $f(x)$ is $[-\\frac{1}{2},\\infty )$, and the function is continuous on this interval."}] [{:db/id #edb/ref 17592186402688 :knowledge-point/_questions [{:db/id #edb/ref 17592186087842 :knowledge-point/id #uuid "60c99086-75e7-5d91-b425-4e1b6f582bcc" :knowledge-point/title "Calculating the Vertical Asymptotes of a Rational Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ce1c8713-2cf3-5d3e-be72-a3135dfaed78" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=-1,\\,x=1,\\,x=3" :db/id #edb/ref 17592186402690} {:answer/id #uuid "fd5c07fd-aef8-50a6-bb7a-0214e75d1fbe" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=-3,\\,x=1,\\,x=3" :db/id #edb/ref 17592186402691} {:answer/id #uuid "b9d397dd-0706-56c3-a545-4f1e11b5d1fb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=-3,\\,x=-1,\\,x=1" :db/id #edb/ref 17592186402692} {:answer/id #uuid "7d3acbb2-152b-5386-a5b3-d4d5f9778946" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=-1,\\,x=1" :db/id #edb/ref 17592186402693} {:answer/id #uuid "466aa8d5-5559-5bc5-8a5d-ddd22b7bb453" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=-1,\\,x=-\\frac{1}{3},\\,x=1" :db/id #edb/ref 17592186402694}] :answer-field/correct {:answer/id #uuid "b9d397dd-0706-56c3-a545-4f1e11b5d1fb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=-3,\\,x=-1,\\,x=1" :db/id #edb/ref 17592186402692} :answer-field/id #uuid "aba4d313-1d11-58c4-bb5b-3d3a12220a0e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186402689}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "ca4d349e-c1ee-5a19-a1e0-b0c9e7e02dd8" :question/math-academy-id "q-39793" :question/problem "Determine the vertical asymptotes of $f(x)=\\frac{x}{(x+3)(x+1)(x-1)}.$" :question/worked-solution "To find the vertical asymptotes of a rational function, we factor the numerator and denominator and cancel any common factors. Then, we set the denominator equal to zero and solve for $x.$\n\nThere are no common factors in the numerator and denominator, so we set the denominator equal to zero and solve for $x:$\n\n$$\n\\begin{aligned}(x+3)(x+1)(x-1) & =0\\end{aligned}\n$$\n\nThis gives the three solutions $x=-3,$ $x=-1$ and $x=1.$ Therefore, the equations of the vertical asymptotes are  $x=-3,\\,$ $x=-1$ and $x=1.$"}] [{:db/id #edb/ref 17592186402695 :knowledge-point/_questions [{:db/id #edb/ref 17592186087845 :knowledge-point/id #uuid "4b0b57da-f9af-5fab-a337-51ee4cb28f9e" :knowledge-point/title "Calculating Vertical Asymptotes With Common Factors When the Denominator Has Complex Roots"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a602f803-9ee4-55ae-ba4f-d88ab6ec6a90" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=\\pm \\frac{1}{2},\\,x=0" :db/id #edb/ref 17592186402697} {:answer/id #uuid "d1acf715-1373-5a06-b01b-ab3b303c535d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=-1,\\,x=0,\\,x=1" :db/id #edb/ref 17592186402698} {:answer/id #uuid "bfbc63c9-13bb-57db-8074-636542eaac49" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$x=0$ only" :db/id #edb/ref 17592186402699} {:answer/id #uuid "66e7f76d-26a7-52c7-993f-99c8712a83c4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=\\pm 1" :db/id #edb/ref 17592186402700} {:answer/id #uuid "5ad6dfaf-76c0-5356-9336-dc60a8e77b95" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The function has no vertical asymptotes" :db/id #edb/ref 17592186402701}] :answer-field/correct {:answer/id #uuid "5ad6dfaf-76c0-5356-9336-dc60a8e77b95" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The function has no vertical asymptotes" :db/id #edb/ref 17592186402701} :answer-field/id #uuid "e4e77536-5db4-551c-9973-483a9864ffa5" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186402696}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "10e486fb-a153-567a-b122-83eab72817c1" :question/math-academy-id "q-39936" :question/problem "Determine the vertical asymptotes of $f(x)=\\frac{{x}^{2}-1}{{x}^{4}-1}.$" :question/worked-solution "To find the vertical asymptotes of a rational function, we factor the numerator and denominator and cancel any common factors. Then, we set the denominator equal to zero and solve for $x.$\n\nFactoring the numerator and denominator and canceling any common factors, we get\n\n$$\n\\begin{aligned}f(x) & =\\frac{{x}^{2}-1}{{x}^{4}-1} \\\\  & =\\frac{{x}^{2}-1}{({x}^{2}-1)({x}^{2}+1)} \\\\  & =\\frac{(x-1)(x+1)}{(x-1)(x+1)({x}^{2}+1)} \\\\  & =\\frac{\\cancel{(x-1)(x+1)}}{\\cancel{(x-1)(x+1)}({x}^{2}+1)} \\\\  & =\\frac{1}{{x}^{2}+1}\\end{aligned}\n$$\n\nNext, we set the denominator equal to zero:\n\n$$\n{x}^{2}+1=0\n$$\n\nThis equation does not have any real solutions. Therefore, $f(x)$ has no vertical asymptotes."}] [{:db/id #edb/ref 17592186326801 :knowledge-point/_questions [{:db/id #edb/ref 17592186129303 :knowledge-point/id #uuid "bd0aa5fc-79de-525e-a688-a8a2d2fcf858" :knowledge-point/title "Solving for an Unknown Constant in a Transformed Reciprocal Function Given the Domain"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "36817ff5-94b5-5e0c-aa6e-e4adfd7b868f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186324418} {:answer/id #uuid "58722e71-13e2-5d86-b77b-8b1c37339129" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186324706} {:answer/id #uuid "796d99a4-c609-5611-b9b4-030174fd4671" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186324984} {:answer/id #uuid "ceb00e44-4f46-5766-841d-29d6d2a9f5b6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "12" :db/id #edb/ref 17592186325767} {:answer/id #uuid "dd1f23f3-9644-55d1-99f6-e9850f0217bb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186325901}] :answer-field/correct {:answer/id #uuid "ceb00e44-4f46-5766-841d-29d6d2a9f5b6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "12" :db/id #edb/ref 17592186325767} :answer-field/id #uuid "2a286a71-fa21-5505-b96c-f7267c23eddf" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186326290}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "4d984b68-ba41-5abd-a3f2-afc368e8283a" :question/math-academy-id "q-40027" :question/problem "The domain of the function $f(x)=\\frac{4}{3x+b}$ is $(-\\infty ,-4)\\cup (-4,\\infty ).$ Find the value of $b.$" :question/worked-solution "A reciprocal function is defined for all values of $x$ except for those that make the denominator zero. So, to find the domain, we must exclude all values that make the denominator zero.\n\nSetting the denominator equal to zero and solving, we get\n\n$$\n\\begin{aligned}3x+b & =0 \\\\ 3x & =-b \\\\ x & =-\\frac{b}{3}.\\end{aligned}\n$$\n\nSo, the point that must be excluded from the domain is $x=-\\frac{b}{3}.$ \n\nOn the other hand, we can see that $x=-4$ is excluded from the domain. Equating this to $-\\frac{b}{3},$ we get\n\n$$\n\\begin{aligned}-\\frac{b}{3} & =-4 \\\\ \\frac{b}{3} & =4 \\\\ b & =12.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186326806 :knowledge-point/_questions [{:db/id #edb/ref 17592186129096 :knowledge-point/id #uuid "5ad95b4e-e367-5e26-800c-1a87a537ca83" :knowledge-point/title "Finding the Intervals on Which a Trigonometric Function Is Continuous"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3497a718-c1a6-51e6-af1a-953f981abd22" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-\\pi ,\\pi )" :db/id #edb/ref 17592186324397} {:answer/id #uuid "40780318-a745-5f1a-8bba-affb853af852" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[-\\pi ,0)\\cup (0,\\pi ]" :db/id #edb/ref 17592186324489} {:answer/id #uuid "7216b300-5c68-553d-ab9a-ac506700f72e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[-\\pi ,0)" :db/id #edb/ref 17592186324916} {:answer/id #uuid "a0aeec49-d531-50db-bf21-b8578d86c37d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(0,\\pi ]" :db/id #edb/ref 17592186325333} {:answer/id #uuid "d5d962bb-8ba4-5e15-a962-658461433d49" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-\\pi ,0)\\cup (0,\\pi )" :db/id #edb/ref 17592186325832}] :answer-field/correct {:answer/id #uuid "d5d962bb-8ba4-5e15-a962-658461433d49" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-\\pi ,0)\\cup (0,\\pi )" :db/id #edb/ref 17592186325832} :answer-field/id #uuid "7f7faea1-42ca-5601-a0d5-7ae190223c12" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186326451}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "14982c8b-d480-564b-82c7-d131ac68638d" :question/math-academy-id "q-40081" :question/problem "The interval $I$ consists of all real numbers $x$ such that $-\\pi \\le x\\le \\pi .$ What is the largest subset of $I$ on which the function $g(x)=\\operatorname{csc}⁡(x)-\\operatorname{cos}⁡(x)$ is continuous?" :question/worked-solution "Trigonometric functions are continuous at all points in their respective domains.\n\nThe function $\\operatorname{cos}⁡x$ is continuous over the entire interval $[-\\pi ,\\pi ],$ but the function $\\operatorname{csc}⁡x$ is not defined at $x=-\\pi ,0,\\pi .$ \n\nTherefore, the domain of $g(x)$ consists of the union of the intervals $(-\\pi ,0)$ and $(0,\\pi ),$ namely\n\n$$\n(-\\pi ,0)\\cup (0,\\pi )\n$$\n\nand the function is also continuous on this union of intervals."}] [{:db/id #edb/ref 17592186326831 :knowledge-point/_questions [{:db/id #edb/ref 17592186133936 :knowledge-point/id #uuid "c80b75e7-19b2-534b-97f8-aba563ebe058" :knowledge-point/title "Solving a Factored Cubic Polynomial Inequality"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1b2e8b63-81e7-5a1c-a343-d2e83bac41de" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x\\in (0,\\frac{1}{2})\\cup (2,\\infty )" :db/id #edb/ref 17592186324201} {:answer/id #uuid "4c4cf899-ff99-50a7-ab03-977e0a939e21" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x\\in (-\\infty ,-2)\\cup (0,4)" :db/id #edb/ref 17592186324597} {:answer/id #uuid "849305c9-d929-518e-bf23-35902ab0355f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x\\in (-2,\\frac{1}{2})\\cup (3,\\infty )" :db/id #edb/ref 17592186325088} {:answer/id #uuid "be244597-d382-5777-9a00-d13314a385f5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x\\in (-\\infty ,-2)\\cup (\\frac{1}{2},3)" :db/id #edb/ref 17592186325604} {:answer/id #uuid "fa451380-973c-50c6-af68-c706839c4054" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x\\in (-\\infty ,-2)\\cup (\\frac{1}{2},\\infty )" :db/id #edb/ref 17592186326173}] :answer-field/correct {:answer/id #uuid "849305c9-d929-518e-bf23-35902ab0355f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x\\in (-2,\\frac{1}{2})\\cup (3,\\infty )" :db/id #edb/ref 17592186325088} :answer-field/id #uuid "2359e231-cc4e-518b-8b28-8c3c01996302" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186326280}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "f08a6c50-6d74-51fe-a849-876f9c4eebbf" :question/math-academy-id "q-40347" :question/problem "Solve the inequality $(x+2)(2x-1)(x-3)>0.$" :question/worked-solution "First, we define the function $f(x)$ as\n\n$$\nf(x)=(x+2)(2x-1)(x-3).\n$$\n\nSo we're now solving the inequality $f(x)>0.$\n\nThe solutions to the equation $f(x)=0$ are $x=-2,$ $x=\\frac{1}{2}$ and $x=3.$ These roots divide the number line into $4$ subintervals: \n\n$$\n(-\\infty ,-2),\\,(-2,\\frac{1}{2}),\\,(\\frac{1}{2},3),\\,(3,\\infty )\n$$\n\nNow, we construct a sign table with the list of the intervals on the top and the list of factors on the left. Filling in the sign table using the usual method, we get the following result:\n\n|  | $(-\\infty ,-2)$ | $(-2,\\frac{1}{2})$ | $(\\frac{1}{2},3)$ | $(3,\\infty )$ |\n| --- | --- | --- | --- | --- |\n| $x+2$ | $-$ | $+$ | $+$ | $+$ |\n| $2x-1$ | $-$ | $-$ | $+$ | $+$ |\n| $x-3$ | $-$ | $-$ | $-$ | $+$ |\n| $f(x)$ | $-$ | $+$ | $-$ | $+$ |\n\nFinally, to solve the inequality $f(x)>0,$ we look at the bottom row to find out where the expression $f(x)$ is positive.\n\nFrom the table, we see that $f(x)$ is positive on the intervals $(-2,\\frac{1}{2})$ and $(3,\\infty ).$\n\nTherefore, we conclude that $f(x)>0$ for all $x\\in (-2,\\frac{1}{2})\\cup (3,\\infty ).$"}] [{:db/id #edb/ref 17592186092702 :knowledge-point/_questions [{:db/id #edb/ref 17592186092220 :knowledge-point/id #uuid "c4034e61-63dc-5f72-8275-e9c81290767d" :knowledge-point/title "Identifying the Graph of a Polar Circle"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "287b66ce-eea9-5761-8ae3-e433ccc705bd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "r=12" :db/id #edb/ref 17592186324296} {:answer/id #uuid "a6ad43de-68fe-5a9c-aea2-663552beff50" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\theta =6" :db/id #edb/ref 17592186325393} {:answer/id #uuid "b8aea7da-f08f-5e62-9eb6-3d6d90b0ef32" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "r=3" :db/id #edb/ref 17592186325556} {:answer/id #uuid "c1392b6e-aa07-545b-9154-c8ff037361cc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\theta =3" :db/id #edb/ref 17592186325631} {:answer/id #uuid "c4dd1117-4024-55d3-ab48-87b95cec4c00" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "r=6" :db/id #edb/ref 17592186325666}] :answer-field/correct {:answer/id #uuid "c4dd1117-4024-55d3-ab48-87b95cec4c00" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "r=6" :db/id #edb/ref 17592186325666} :answer-field/id #uuid "733270aa-9c3b-5f1e-a50b-48efd158ae2c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186326425}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "ebf40886-fb73-5481-a019-3b75d93ee8ab" :question/math-academy-id "q-40791" :question/problem "![](images/d5/d5c95dca34605acc8f66ca24f11e8d048ed3490ae859c55e7f5eb42806307071.png)\n\nWhat is the polar equation of the curve shown above?" :question/worked-solution "Notice that the given curve is a circle of radius $6$ centered at the origin.\n\nTherefore, its polar equation is $r=6.$"}] [{:db/id #edb/ref 17592186326884 :knowledge-point/_questions [{:db/id #edb/ref 17592186092219 :knowledge-point/id #uuid "ad049d53-af38-5917-b9d0-be965cadabcb" :knowledge-point/title "Finding the Cartesian Coordinates of a Point Given Some Information About Another Point"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1de63e38-80fb-54c4-9a7c-5a96600b508f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(4\\sqrt{3},4\\sqrt{3})" :db/id #edb/ref 17592186324222} {:answer/id #uuid "23d41aa2-c3a0-5270-abba-3a1f3207c3d3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(4\\sqrt{2},4\\sqrt{2})" :db/id #edb/ref 17592186324266} {:answer/id #uuid "2e4dd8b9-9d94-588f-a6d0-7d91017750d9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(2\\sqrt{2},2\\sqrt{2})" :db/id #edb/ref 17592186324340} {:answer/id #uuid "81916b05-53d5-5cfe-b7c6-b0642b2c06ac" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(8\\sqrt{3},8\\sqrt{3})" :db/id #edb/ref 17592186325056} {:answer/id #uuid "82355246-8fcd-5520-a5e5-83b3cb9b05c9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(8\\sqrt{2},8\\sqrt{2})" :db/id #edb/ref 17592186325067}] :answer-field/correct {:answer/id #uuid "23d41aa2-c3a0-5270-abba-3a1f3207c3d3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(4\\sqrt{2},4\\sqrt{2})" :db/id #edb/ref 17592186324266} :answer-field/id #uuid "3036c726-f5d4-51ab-a7e4-77d619c6072b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186326308}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "417c4b2b-c91e-563b-b92c-41495ea7b2b8" :question/math-academy-id "q-40826" :question/problem "The point $A$ has polar coordinates $(\\sqrt{2},\\theta )$ and the point $B$ has polar coordinates $(8,\\theta +\\pi ).$ Find the Cartesian coordinates of $B$ given that the Cartesian coordinates of $A$ are $(-1,-1).$" :question/worked-solution "First, we use the Cartesian coordinates of $A$ to find its reference angle ${\\theta }_{R}:$\n\n$$\n\\begin{aligned}{\\theta }_{R} & =\\operatorname{arctan}⁡(\\frac{-1}{-1}) \\\\  & =\\operatorname{arctan}⁡(1) \\\\  & =\\frac{\\pi }{4}\\end{aligned}\n$$\n\nSince the point $A$ lies in the third quadrant, we have $\\theta =\\pi +{\\theta }_{R}=\\frac{5\\pi }{4}.$ Consequently, the polar coordinates of $B$ are\n\n$$\n(8,\\frac{5\\pi }{4}+\\pi )=(8,\\frac{9\\pi }{4})=(8,\\frac{\\pi }{4}).\n$$\n\nNow, we convert $B$ to Cartesian coordinates. To convert from polar coordinates to Cartesian coordinates, we use\n\n$$\nx=r\\operatorname{cos}⁡\\theta ,\\,y=r\\operatorname{sin}⁡\\theta .\n$$\n\nFirst, we calculate the $x$-coordinate of $B:$\n\n$$\n\\begin{aligned}x & =r\\operatorname{cos}⁡\\theta  \\\\  & =8\\operatorname{cos}⁡(\\frac{\\pi }{4}) \\\\  & =8\\cdot \\frac{\\sqrt{2}}{2} \\\\  & =4\\sqrt{2}\\end{aligned}\n$$\n\nThen, we calculate the $y$-coordinate of $B:$\n\n$$\n\\begin{aligned}y & =r\\operatorname{sin}⁡\\theta  \\\\  & =8\\operatorname{sin}⁡(\\frac{\\pi }{4}) \\\\  & =8\\cdot \\frac{\\sqrt{2}}{2} \\\\  & =4\\sqrt{2}\\end{aligned}\n$$\n\nTherefore, the Cartesian coordinates of $B$ are $(4\\sqrt{2},4\\sqrt{2}).$"}] [{:db/id #edb/ref 17592186392382 :knowledge-point/_questions [{:db/id #edb/ref 17592186133750 :knowledge-point/id #uuid "407616a9-e448-5652-9882-a1edf19600f8" :knowledge-point/title "Identifying a Radial Line Given Its Polar Equation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "558d39e0-0ab6-5d33-b3a0-396e26bb8653" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/aa/aa72b03a85b16e3a9ef9dc3f65f4126cdee0339ac722fcfe8a1f21973796f623.png" :db/id #edb/ref 17592186392384} {:answer/id #uuid "3fd87d8b-270f-573d-9412-5025cd44dba3" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/10/10d1cdb8ecbfe7f7153618b5da57fecefbf8711d395cf3c6f5c879f3169977f9.png" :db/id #edb/ref 17592186392385} {:answer/id #uuid "97873c7d-0308-59b1-889c-345b9fb3b8f7" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/80/802bb767b28c38598663d928d66338086adf08b80bc5887a7795704183ed2212.png" :db/id #edb/ref 17592186392386} {:answer/id #uuid "bee250d6-c6dd-5d05-9b3d-34683cc111c8" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/85/85271401b413b162990a99e905ebecbfb4048953e77bcb5808c0b729c1fc7de3.png" :db/id #edb/ref 17592186392387} {:answer/id #uuid "521ffe4f-8b8b-5b4e-afbd-79c02578ee0b" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/2b/2b88d001cbc59e0c46922b6e369644e50a02eff26c800e9d571147988357918e.png" :db/id #edb/ref 17592186392388}] :answer-field/correct {:answer/id #uuid "97873c7d-0308-59b1-889c-345b9fb3b8f7" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/80/802bb767b28c38598663d928d66338086adf08b80bc5887a7795704183ed2212.png" :db/id #edb/ref 17592186392386} :answer-field/id #uuid "93203f91-1d26-5d83-a83e-32f479d20351" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186392383}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "15ae4fee-42a8-584b-a59a-68427466f591" :question/math-academy-id "q-40828" :question/problem "Which of the following is the graph of the polar curve  $\\theta =\\frac{11\\pi }{10}?$" :question/worked-solution "The polar curve defined by the equation $\\theta =\\frac{11\\pi }{10}$ is the ray that starts at the origin and makes a counterclockwise angle of $\\frac{11\\pi }{10}$ with the positive $x$-axis. \n\nTherefore, the angle it makes with the negative $x$-axis is \n\n$$\n\\frac{11\\pi }{10}-\\pi =\\frac{\\pi }{10}.\n$$\n\n \n\nThe correct answer is shown below.\n\n![](images/80/802bb767b28c38598663d928d66338086adf08b80bc5887a7795704183ed2212.png)"}] [{:db/id #edb/ref 17592186326900 :knowledge-point/_questions [{:db/id #edb/ref 17592186129102 :knowledge-point/id #uuid "bd6703d2-36f6-5665-90e3-f75aea5f663b" :knowledge-point/title "Finding a General Expression for the Domain of a Transformed Tangent or Cotangent Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "56259cef-6878-51cd-b1f5-eeaf49702140" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x\\ne \\frac{\\pi }{9}+n\\pi " :db/id #edb/ref 17592186324688} {:answer/id #uuid "654e271d-49cd-5e3c-9c7d-b37514a25a84" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x\\ne \\frac{\\pi }{9}+\\frac{n\\pi }{3}" :db/id #edb/ref 17592186324810} {:answer/id #uuid "8b458fe6-2549-577d-823d-3fcf10021ffa" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x\\ne \\frac{\\pi }{6}+\\frac{n\\pi }{6}" :db/id #edb/ref 17592186325153} {:answer/id #uuid "d136e134-3728-57dd-b18c-c29e658d49ca" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x\\ne \\frac{\\pi }{9}+\\frac{n\\pi }{2}" :db/id #edb/ref 17592186325789} {:answer/id #uuid "fd810710-4cf3-54c8-88a7-9403d3f91aee" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x\\ne \\frac{\\pi }{3}+\\frac{n\\pi }{9}" :db/id #edb/ref 17592186326206}] :answer-field/correct {:answer/id #uuid "654e271d-49cd-5e3c-9c7d-b37514a25a84" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x\\ne \\frac{\\pi }{9}+\\frac{n\\pi }{3}" :db/id #edb/ref 17592186324810} :answer-field/id #uuid "ff7a4b9e-8f3f-5b3c-98a8-33205f758cf4" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186326668}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "a89fb0a0-3a36-552f-b729-6c5581cebcd4" :question/math-academy-id "q-41106" :question/problem "What is the domain of the function $f(x)=3\\operatorname{tan}⁡(3x+\\frac{\\pi }{6})+1?$ Assume that $n$ is an integer." :question/worked-solution "The domain of $y=\\operatorname{tan}⁡x$ is given by\n\n$$\nx\\ne \\frac{\\pi }{2}+n\\pi ,\n$$\n\nwhere $n$ is an integer.\n\nTo find the domain of $3\\operatorname{tan}⁡(3x+\\frac{\\pi }{6})+1,$ we replace the $x$ on the left-hand side of the above with $(3x+\\frac{\\pi }{6}).$ This gives\n\n$$\n3x+\\frac{\\pi }{6}\\ne \\frac{\\pi }{2}+n\\pi .\n$$\n\nSolving for $x,$ we get\n\n$$\n\\begin{aligned}3x+\\frac{\\pi }{6} & \\ne \\frac{\\pi }{2}+n\\pi  \\\\ 3x & \\ne \\frac{\\pi }{2}+n\\pi -\\frac{\\pi }{6} \\\\ 3x & \\ne \\frac{\\pi }{3}+n\\pi  \\\\ x & \\ne \\frac{\\pi }{3\\cdot 3}+\\frac{n\\pi }{3} \\\\ x & \\ne \\frac{\\pi }{9}+\\frac{n\\pi }{3}.\\end{aligned}\n$$\n\nTherefore, the domain of the function is $x\\ne \\frac{\\pi }{9}+\\frac{n\\pi }{3},$ where $n$ is an integer."}] [{:db/id #edb/ref 17592186115826 :knowledge-point/_questions [{:db/id #edb/ref 17592186115202 :knowledge-point/id #uuid "9bc0be03-9369-508e-9765-8c88871ec20b" :knowledge-point/title "The Range of a Transformed Logarithmic Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "87c6f1e6-0d33-5cdc-af67-5f19a9b4678a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "f(x)\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186325127} {:answer/id #uuid "cb12b821-bce4-53ba-809b-8073091be039" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "f(x)\\in (0,\\infty )" :db/id #edb/ref 17592186325732} {:answer/id #uuid "cf3e7d3c-28cb-551b-814d-24c71777a04d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "f(x)\\in (-\\infty ,\\frac{1}{2})" :db/id #edb/ref 17592186325772} {:answer/id #uuid "dbdb2d32-06a5-584c-b837-e088b83a23f0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "f(x)\\in (\\frac{1}{2},\\infty )" :db/id #edb/ref 17592186325886} {:answer/id #uuid "eb32a561-e406-5ef8-b8f6-32579968df6f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "f(x)\\in (-\\infty ,2)" :db/id #edb/ref 17592186326041}] :answer-field/correct {:answer/id #uuid "87c6f1e6-0d33-5cdc-af67-5f19a9b4678a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "f(x)\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186325127} :answer-field/id #uuid "14aade30-4dcf-54fe-90ad-21a8d183cf5a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186326258}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "d356ad64-d32b-5d91-870e-d983fd54ca81" :question/math-academy-id "q-41240" :question/problem "Determine the range of the function $f(x)=2{log}_{5}⁡(2x-1)+1.$" :question/worked-solution "The range of the function $y={log}_{5}⁡(x)$ is $y\\in (-\\infty ,\\infty ).$ \n\nHorizontal and vertical shifts and stretches do not affect the range of a logarithmic function.\n\nTherefore, the range of the given function is $f(x)\\in (-\\infty ,\\infty ).$"}] [{:db/id #edb/ref 17592186134340 :knowledge-point/_questions [{:db/id #edb/ref 17592186133753 :knowledge-point/id #uuid "fc8d4944-9005-5712-ad88-744dac83603e" :knowledge-point/title "Finding the Point of Intersection of a Circle and a Radial Line"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0dd96ba1-2b4a-52b0-ae56-d48afc1ad438" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-4\\sqrt{3},4\\sqrt{3})" :db/id #edb/ref 17592186324095} {:answer/id #uuid "2ed05277-6e18-5e15-8940-2ac1cc7e711a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-4\\sqrt{3},4\\sqrt{2})" :db/id #edb/ref 17592186324343} {:answer/id #uuid "45a4f7ba-02b2-575e-9878-19dffb79d143" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-4,4\\sqrt{3})" :db/id #edb/ref 17592186324534} {:answer/id #uuid "5ba9dd42-5731-5299-842c-9b4b8a43aecc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-4,4\\sqrt{2})" :db/id #edb/ref 17592186324727} {:answer/id #uuid "eedf37c4-e836-577f-8644-c79747d63f14" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-4\\sqrt{3},4)" :db/id #edb/ref 17592186326080}] :answer-field/correct {:answer/id #uuid "eedf37c4-e836-577f-8644-c79747d63f14" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-4\\sqrt{3},4)" :db/id #edb/ref 17592186326080} :answer-field/id #uuid "c09b660e-acc3-5ec3-9d23-f8cb222700d1" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186326568}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "d7c864f9-8a06-59dd-91e8-789300497ddc" :question/math-academy-id "q-41263" :question/problem "![](images/34/34b473c8e212297d8cb434fe0a2dd9872cfa2fda924ac3a4d528bc1318af8c5f.png)\n\nThe polar curve $r=8$ and the ray $\\theta =\\frac{5\\pi }{6}$ intersect at the point $P,$ as shown above. What are the Cartesian coordinates of $P?$" :question/worked-solution "The polar coordinates of $P$ are $(r,\\theta )=(8,\\frac{5\\pi }{6}).$ We can convert the polar coordinates of $P$ to Cartesian coordinates, as follows:\n\n$$\n\\begin{aligned}x & =r\\operatorname{cos}⁡\\theta  \\\\  & =8\\operatorname{cos}⁡(\\frac{5\\pi }{6}) \\\\  & =8\\cdot (-\\frac{\\sqrt{3}}{2}) \\\\  & =-4\\sqrt{3} \\\\ y & =r\\operatorname{sin}⁡\\theta  \\\\  & =8\\operatorname{sin}⁡(\\frac{5\\pi }{6}) \\\\  & =8\\cdot (\\frac{1}{2}) \\\\  & =4\\end{aligned}\n$$\n\nTherefore, the Cartesian coordinates of $P$ are $(-4\\sqrt{3},4).$"}] [{:db/id #edb/ref 17592186069329 :knowledge-point/_questions [{:db/id #edb/ref 17592186068753 :knowledge-point/id #uuid "8058df30-04de-555c-adfa-61fbf2b0ff31" :knowledge-point/title "Adding Rational Expressions in One Variable With Common Factors in the Denominators"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "15017b89-6a83-59c3-8ca4-1e65d3e32c85" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{45}{1-2y}" :db/id #edb/ref 17592186324161} {:answer/id #uuid "3a903b7b-dcca-5c4f-8920-9a1546e6dcf1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{-14y+45}{5(1-2y)}" :db/id #edb/ref 17592186324443} {:answer/id #uuid "c79526ea-db45-5cfa-a2b6-882255022a24" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{14y}{5(1-2y)}" :db/id #edb/ref 17592186325697} {:answer/id #uuid "dc042986-d3e3-5167-8273-d4f156249300" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{26y-45}{5(1-2y)}" :db/id #edb/ref 17592186325890} {:answer/id #uuid "e379b819-7fe0-521e-bbc1-1371d8e50ada" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2y+9}{1-2y}" :db/id #edb/ref 17592186325971}] :answer-field/correct {:answer/id #uuid "3a903b7b-dcca-5c4f-8920-9a1546e6dcf1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{-14y+45}{5(1-2y)}" :db/id #edb/ref 17592186324443} :answer-field/id #uuid "36e51594-6076-558b-b4c1-486d8c2bf0d5" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186326314}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "e010d20d-afd2-59fa-8a1c-50d451ce4776" :question/math-academy-id "q-41576" :question/problem "Given that $\\frac{6y}{5(1-2y)}=p$ and $\\frac{9-4y}{1-2y}=q,$ what is $p+q?$" :question/worked-solution "We wish to add the following fractions:\n\n$$\np+q=\\frac{6y}{5(1-2y)}+\\frac{9-4y}{1-2y}\n$$\n\nIn order to add the two fractions, we need them to have a common denominator. Here, we can put both fractions over a common denominator of $5(1-2y)$ if we multiply the top and bottom of the second fraction by $5:$\n\n$$\n\\begin{aligned}\\frac{6y}{5(1-2y)}+\\frac{9-4y}{1-2y} & = \\\\ \\frac{6y}{5(1-2y)}+\\frac{5}{5}\\cdot \\frac{9-4y}{1-2y} & = \\\\ \\frac{6y}{5(1-2y)}+\\frac{5(9-4y)}{5(1-2y)} & = \\\\ \\frac{6y+5(9-4y)}{5(1-2y)} & = \\\\ \\frac{6y+45-20y}{5(1-2y)} & = \\\\ \\frac{-14y+45}{5(1-2y)} & \\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186326912 :knowledge-point/_questions [{:db/id #edb/ref 17592186129124 :knowledge-point/id #uuid "5696c2d5-4e35-5ed3-a4a2-6fe9b158e461" :knowledge-point/title "Finding the Range of a Transformed Sinusoidal Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6d1c4191-fab1-56ef-9a9e-5df4f5a37573" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y\\in [4,6]" :db/id #edb/ref 17592186324871} {:answer/id #uuid "705447cb-ac85-5790-aadf-544a4a2ca55d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y\\in [-2,6]" :db/id #edb/ref 17592186324896} {:answer/id #uuid "c37b50d3-93b0-5e4b-a2f6-ad5ca8b620b9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y\\in [3,6]" :db/id #edb/ref 17592186325652} {:answer/id #uuid "d9fbb5f9-1876-576d-956d-164f993762da" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y\\in [2,4]" :db/id #edb/ref 17592186325870} {:answer/id #uuid "e3d1017a-3133-56bf-ad84-e9bd0f77a8d9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y\\in [2,6]" :db/id #edb/ref 17592186325976}] :answer-field/correct {:answer/id #uuid "e3d1017a-3133-56bf-ad84-e9bd0f77a8d9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y\\in [2,6]" :db/id #edb/ref 17592186325976} :answer-field/id #uuid "5600e685-5275-5ef3-a75f-13f121192c83" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186326367}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "8be6063d-ee1d-5aea-9fe3-f1f6572dff56" :question/math-academy-id "q-41840" :question/problem "What is the range of the function $y=-2\\operatorname{sin}⁡(x+{30}^{∘})+4?$" :question/worked-solution "The range of $\\operatorname{sin}⁡x$ is\n\n$$\n-1\\le \\operatorname{sin}⁡x\\le 1.\n$$\n\nHorizontal shifts and stretches have no effect on the range. Therefore,\n\n$$\n-1\\le \\operatorname{sin}⁡(x+{30}^{∘})\\le 1.\n$$\n\nMultiplying the above inequality by $-2$ and then adding $4$, we get\n\n$$\n\\begin{aligned}-1 & \\le \\operatorname{sin}⁡(x+{30}^{∘})\\le 1 \\\\ 2 & \\ge -2\\operatorname{sin}⁡(x+{30}^{∘})\\ge -2 \\\\ 6 & \\ge -2\\operatorname{sin}⁡(x+{30}^{∘})+4\\ge 2 \\\\ 2 & \\le y\\le 6.\\end{aligned}\n$$\n\nTherefore, the range is $y\\in [2,6].$"}] [{:db/id #edb/ref 17592186101407 :knowledge-point/_questions [{:db/id #edb/ref 17592186100876 :knowledge-point/id #uuid "89362140-1a17-56fd-a9ab-4da336112bee" :knowledge-point/title "Multiplying a Matrix by a Column or Row of the Identity Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8a95370d-414b-5eac-8919-246de33eac09" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-2 & 2\\sqrt{5} & -2.5\\end{bmatrix}" :db/id #edb/ref 17592186099604} {:answer/id #uuid "a84bcb4e-521f-5ea1-9075-3e249dbed932" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}3.5 \\\\ -2.5 \\\\ 5\\end{bmatrix}" :db/id #edb/ref 17592186099605} {:answer/id #uuid "e006e13f-10ad-5b98-98da-0e4073b443c0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-3 \\\\ 2\\sqrt{5} \\\\ 4\\end{bmatrix}" :db/id #edb/ref 17592186099606} {:answer/id #uuid "2c32ad2d-131b-5f58-b76f-c00ad96820b0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}2\\sqrt{7} \\\\ -2 \\\\ \\sqrt{3}\\end{bmatrix}" :db/id #edb/ref 17592186099607} {:answer/id #uuid "695edc9d-dd29-5f2a-b8fd-06ab5abd1f2a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}2\\sqrt{7} & -3 & 3.5\\end{bmatrix}" :db/id #edb/ref 17592186099608}] :answer-field/id #uuid "954dd7be-0875-59ee-8cb2-ab4ad7d267c9" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186099603} {:answer-field/choices [{:answer/id #uuid "e77b0e35-b8ea-5618-ab6c-8503315df0e2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}3.5 \\\\ -2.5 \\\\ 5\\end{aligned}]" :db/id #edb/ref 17592186392443} {:answer/id #uuid "b90bbe8b-d8e5-5080-9aa2-4142743a4b96" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}2\\sqrt{7} \\\\ -2 \\\\ \\sqrt{3}\\end{aligned}]" :db/id #edb/ref 17592186392444} {:answer/id #uuid "6b52aa96-4f70-58ea-b2cf-28f779b7b43b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}-2 & 2\\sqrt{5} & -2.5\\end{aligned}]" :db/id #edb/ref 17592186392445} {:answer/id #uuid "d06d67b6-8acb-58a8-957c-d55d012736a4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}-3 \\\\ 2\\sqrt{5} \\\\ 4\\end{aligned}]" :db/id #edb/ref 17592186392446} {:answer/id #uuid "e47cb90f-8189-59b3-96b0-469513eb54fc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}2\\sqrt{7} & -3 & 3.5\\end{aligned}]" :db/id #edb/ref 17592186392447}] :answer-field/correct {:answer/id #uuid "b90bbe8b-d8e5-5080-9aa2-4142743a4b96" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}2\\sqrt{7} \\\\ -2 \\\\ \\sqrt{3}\\end{aligned}]" :db/id #edb/ref 17592186392444} :answer-field/id #uuid "3cb1f592-094a-5b91-bac8-80971fe96ac3" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186392442}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "bde0cdd0-7dbe-5ba4-9b36-e66cfe099501" :question/math-academy-id "q-41949" :question/problem "Find the product $AB$, if\n$A=[\\begin{aligned}2\\sqrt{7} & -3 & 3.5 \\\\ -2 & 2\\sqrt{5} & -2.5 \\\\ \\sqrt{3} & 4 & 5\\end{aligned}]$\nand \n$B=[\\begin{aligned}1 \\\\ 0 \\\\ 0\\end{aligned}].$" :question/worked-solution "Notice that $B$ is the $1$st *column* of the identity matrix ${I}_{3}.$\n\nSince we're multiplying the $3\\times 3$ matrix $A$ by the $1$st *column* of the identity matrix ${I}_{3},$ the result must be the $1$st *column* of $A.$ Therefore,\n\n$$\nAB=[\\begin{aligned}2\\sqrt{7} \\\\ -2 \\\\ \\sqrt{3}\\end{aligned}].\n$$\n\nLet's check the long way:\n\n$$\n\\begin{aligned}AB & =[\\begin{aligned}2\\sqrt{7} & -3 & 3.5 \\\\ -2 & 2\\sqrt{5} & -2.5 \\\\ \\sqrt{3} & 4 & 5\\end{aligned}][\\begin{aligned}1 \\\\ 0 \\\\ 0\\end{aligned}] \\\\  & =[\\begin{aligned}2\\sqrt{7}\\cdot 1+(-3)\\cdot 0+3.5\\cdot 0 \\\\ (-2)\\cdot 1+2\\sqrt{5}\\cdot 0+(-2.5)\\cdot 0 \\\\ \\sqrt{3}\\cdot 1+4\\cdot 0+5\\cdot 0\\end{aligned}] \\\\  & =[\\begin{aligned}2\\sqrt{7} \\\\ -2 \\\\ \\sqrt{3}\\end{aligned}]\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186392448 :knowledge-point/_questions [{:db/id #edb/ref 17592186115227 :knowledge-point/id #uuid "8feeacff-b07d-5f98-a765-4d8571674a7a" :knowledge-point/title "Calculating a Matrix Product Using the Associative Law"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "bc44afbe-5d76-5e09-9981-f46801ba7f6a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}-3 & 5\\end{aligned}]" :db/id #edb/ref 17592186392450} {:answer/id #uuid "52743f64-5575-5f50-ab83-057fdf07b94a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}5 \\\\ 4\\end{aligned}]" :db/id #edb/ref 17592186392451} {:answer/id #uuid "56be43e4-cbda-5ce6-b53d-23acb1dfe969" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}5 & -3 \\\\ 4 & 1\\end{aligned}]" :db/id #edb/ref 17592186392452} {:answer/id #uuid "77068922-3e71-5bec-a56b-febc23200124" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}-3 \\\\ 5\\end{aligned}]" :db/id #edb/ref 17592186392453} {:answer/id #uuid "55501deb-48c2-5461-b4b5-3c1803f7a5f2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}-3 & 5 \\\\ 1 & 4\\end{aligned}]" :db/id #edb/ref 17592186392454}] :answer-field/correct {:answer/id #uuid "bc44afbe-5d76-5e09-9981-f46801ba7f6a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}-3 & 5\\end{aligned}]" :db/id #edb/ref 17592186392450} :answer-field/id #uuid "fb19f32f-0991-5b71-b98c-bdea9bdda5e4" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186392449}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "54c6b58b-7b12-5b44-8e47-3a85c2ee0cea" :question/math-academy-id "q-41981" :question/problem "Calculate $ABC$, where\n\n$$\nA=[\\begin{aligned}-3 & 5\\end{aligned}],\\,B=[\\begin{aligned}1 & 3 \\\\ 1 & 4\\end{aligned}],\\,C=[\\begin{aligned}4 & -3 \\\\ -1 & 1\\end{aligned}].\n$$" :question/worked-solution "First, recall the associative law\n\n$$\nABC=(AB)C=A(BC).\n$$\n\nNotice that $A$ is a $1\\times 2$ matrix, $B$ is a $2\\times 2$ matrix, and $C$ is a $2\\times 2$ matrix. Therefore, \n\n- multiplying $A$ by $B$, we will obtain a $1\\times 2$ matrix, which will require finding $2$ entries, while\n\n- multiplying $B$ by $C$, we will obtain a $2\\times 2$ matrix, which will require finding $4$ entries.\n\nSo, we find the product $AB$ first: \n\n$$\n\\begin{aligned}AB & =[\\begin{aligned}-3 & 5\\end{aligned}]\\cdot [\\begin{aligned}1 & 3 \\\\ 1 & 4\\end{aligned}] \\\\  & =[\\begin{aligned}2 & 11\\end{aligned}]\\end{aligned}\n$$\n\nNow, we multiply $AB$ by $C:$\n\n$$\n\\begin{aligned}ABC & =(AB)C \\\\  & =[\\begin{aligned}2 & 11\\end{aligned}]\\cdot [\\begin{aligned}4 & -3 \\\\ -1 & 1\\end{aligned}] \\\\  & =[\\begin{aligned}-3 & 5\\end{aligned}]\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186129775 :knowledge-point/_questions [{:db/id #edb/ref 17592186129082 :knowledge-point/id #uuid "98d6004a-547a-5b0b-9748-9571cc3ee632" :knowledge-point/title "Computing a Tangent or Cotangent Using the Pythagorean Identity"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c61dc7c0-d3f8-5a52-a767-d5a5950ed61b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\tan θ =-4\\sqrt{3}" :db/id #edb/ref 17592186128132} {:answer/id #uuid "3c3acfbd-450b-529e-9e81-f6898d0afc15" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\tan θ =-\\frac{1}{5}" :db/id #edb/ref 17592186128133} {:answer/id #uuid "425120b8-9a7a-509b-b2b1-16f549aee0d9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\tan θ = \\frac{7}{2}" :db/id #edb/ref 17592186128134} {:answer/id #uuid "51495d9a-03f0-5f49-aeab-3c6ea5811fbe" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\tan θ =-\\frac{\\sqrt{3}}{3}" :db/id #edb/ref 17592186128135} {:answer/id #uuid "681b517b-c0da-555d-9464-011b10f62e6c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\tan θ = \\sqrt{3}" :db/id #edb/ref 17592186128136}] :answer-field/id #uuid "a1f2f1dc-9d19-53e5-af38-cc9ea5f6ad94" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186128131} {:answer-field/choices [{:answer/id #uuid "d2ab46d8-4b20-5cb0-bd03-d4843745957e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "tan⁡\\theta =-4\\sqrt{3}" :db/id #edb/ref 17592186402771} {:answer/id #uuid "1281daa1-21d2-521b-ba7b-2f63be883923" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "tan⁡\\theta =\\frac{7}{2}" :db/id #edb/ref 17592186402772} {:answer/id #uuid "cf49d4c9-aad2-5d7f-bca3-cd2582a8d854" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "tan⁡\\theta =\\sqrt{3}" :db/id #edb/ref 17592186402773} {:answer/id #uuid "1efc176a-2f08-5690-b21d-dbaa2aa9e6f1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "tan⁡\\theta =-\\frac{\\sqrt{3}}{3}" :db/id #edb/ref 17592186402774} {:answer/id #uuid "9257c9b4-8a20-5a75-b76e-4b9c11a339a8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "tan⁡\\theta =-\\frac{1}{5}" :db/id #edb/ref 17592186402775}] :answer-field/correct {:answer/id #uuid "1efc176a-2f08-5690-b21d-dbaa2aa9e6f1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "tan⁡\\theta =-\\frac{\\sqrt{3}}{3}" :db/id #edb/ref 17592186402774} :answer-field/id #uuid "737f5b1b-3e66-5582-9362-63911dfedfe9" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186402770}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "299c91a4-6289-5d24-ace1-495b52634a62" :question/math-academy-id "q-42043" :question/problem "![](images/91/919b9e8f2a9493fd0dda3e0d7bf66de9af054fc4ed9c0fcf7a68329fdbbaffdd.png)\n\nThe diagram above shows the unit circle. Given that $sin⁡\\theta =\\frac{1}{2},$ what is the value of $tan⁡\\theta ?$" :question/worked-solution "![](images/94/948610f67267e6ec1b845d2b4e1bc4030b81a1080bcb9a44d9f974ff78c3f7b0.png)\n\nWe can use the Pythagorean identity to find $cos⁡\\theta :$\n\n$$\n\\begin{aligned}{sin}^{2}⁡\\theta +{cos}^{2}⁡\\theta  & =1 \\\\ {cos}^{2}⁡\\theta  & =1-{sin}^{2}⁡\\theta  \\\\ cos⁡\\theta  & =\\pm \\sqrt{1-{sin}^{2}⁡\\theta }\\end{aligned}\n$$\n\nSubstituting $sin⁡\\theta =\\frac{1}{2}$ gives\n\n$$\n\\begin{aligned}cos⁡\\theta  & =\\pm \\sqrt{1-{(\\frac{1}{2})}^{2}} \\\\  & =\\pm \\sqrt{1-\\frac{1}{4}} \\\\  & =\\pm \\sqrt{\\frac{3}{4}} \\\\  & =\\pm \\frac{\\sqrt{3}}{2}.\\end{aligned}\n$$\n\nWe select the negative answer since $cos⁡\\theta $ is negative in the second quadrant. So, $cos⁡\\theta =-\\frac{\\sqrt{3}}{2}.$\n\nFinally, knowing that $tan⁡\\theta =\\frac{sin⁡\\theta }{cos⁡\\theta },$ we have\n\n$$\ntan⁡\\theta =\\frac{(\\frac{1}{2})}{(-\\frac{\\sqrt{3}}{2})}=-\\frac{1}{\\sqrt{3}}=-\\frac{\\sqrt{3}}{3}.\n$$"}] [{:db/id #edb/ref 17592186111167 :knowledge-point/_questions [{:db/id #edb/ref 17592186110568 :knowledge-point/id #uuid "69d6ed5b-1c29-53a7-a37e-817042a02861" :knowledge-point/title "Graphing the Inverse Sine Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "85251810-38ab-5c23-8000-832183eefbba" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/e9/e97a7603936b6e125189e9868df34291e145aac878ca64c1c03761bf544fbbec.png" :db/id #edb/ref 17592186108728} {:answer/id #uuid "abdfb5b0-c85f-5799-b427-6af8ee1ed617" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/32/326290611c8ca441f0d9bcc0439678f0c29302b2784ee4fe65e69a3008ec8fe3.png" :db/id #edb/ref 17592186108729} {:answer/id #uuid "ccd132f0-d5bb-5367-b1a4-75bd6fb41b8c" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/dd/dd1817cc5f293e7a4031a000ced0fa698112a7785101c2ab17723161c19f526c.png" :db/id #edb/ref 17592186108730} {:answer/id #uuid "2994ee93-1150-5d4d-8ef2-03630d797e86" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/df/df22eea4331c47da3047381ca672fd80ebf75118054316fe88c0e2d96dae0d34.png" :db/id #edb/ref 17592186108731} {:answer/id #uuid "5a6f6699-986f-504c-a2d1-370a53a9504d" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/92/92f86a487d6e397276a6d7277ad3d8a9353bc34bb482e28f2f7eeeed89cbac5c.png" :db/id #edb/ref 17592186108732}] :answer-field/id #uuid "700b0334-81f7-5763-8fe8-2103ae830feb" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186108727} {:answer-field/choices [{:answer/id #uuid "c9dd7ae6-9a89-5175-aa8a-c684a6afe786" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/e9/e97a7603936b6e125189e9868df34291e145aac878ca64c1c03761bf544fbbec.png" :db/id #edb/ref 17592186392476} {:answer/id #uuid "d4ef4dea-31e8-5828-8c0a-fbbd1f3e8b97" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/df/df22eea4331c47da3047381ca672fd80ebf75118054316fe88c0e2d96dae0d34.png" :db/id #edb/ref 17592186392477} {:answer/id #uuid "73055f14-73bd-51bf-92b4-e53d83d00615" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/dd/dd1817cc5f293e7a4031a000ced0fa698112a7785101c2ab17723161c19f526c.png" :db/id #edb/ref 17592186392478} {:answer/id #uuid "2fc93602-1fff-5fbe-a880-75ec2cdbb676" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/92/92f86a487d6e397276a6d7277ad3d8a9353bc34bb482e28f2f7eeeed89cbac5c.png" :db/id #edb/ref 17592186392479} {:answer/id #uuid "cc6b1ec5-18b5-59a6-ac35-d404b0b9f34b" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/32/326290611c8ca441f0d9bcc0439678f0c29302b2784ee4fe65e69a3008ec8fe3.png" :db/id #edb/ref 17592186392480}] :answer-field/correct {:answer/id #uuid "d4ef4dea-31e8-5828-8c0a-fbbd1f3e8b97" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/df/df22eea4331c47da3047381ca672fd80ebf75118054316fe88c0e2d96dae0d34.png" :db/id #edb/ref 17592186392477} :answer-field/id #uuid "9e05f68f-1fcc-5b0b-b66c-d5b388883e5c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186392475}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "6d5543e2-0abb-561e-9632-e9b1d00fcc94" :question/math-academy-id "q-42117" :question/problem "What is the graph of $y=\\operatorname{arcsin}⁡x?$" :question/worked-solution "Let's recall some of the basic properties of $y=\\operatorname{arcsin}⁡x$:\n\n- The domain of the function is $x\\in [-1,1].$\n\n- The range of the function is $y\\in [-\\frac{\\pi }{2},\\frac{\\pi }{2}].$\n\n- Its minimum value occurs at $x=-1.$\n\n- Its maximum value occurs at $x=1.$\n\n- Its zero occurs at $x=0.$\n\n- The function is strictly increasing on its entire domain.\n\nOf the given functions, the only one that has all of these properties is as follows:\n\n![](images/df/df22eea4331c47da3047381ca672fd80ebf75118054316fe88c0e2d96dae0d34.png)"}] [{:db/id #edb/ref 17592186392508 :knowledge-point/_questions [{:db/id #edb/ref 17592186115227 :knowledge-point/id #uuid "8feeacff-b07d-5f98-a765-4d8571674a7a" :knowledge-point/title "Calculating a Matrix Product Using the Associative Law"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f0a43c89-29de-5118-a4d4-3f996c643cb5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}7 & -2 \\\\ 15 & -7 \\\\ 9 & 1\\end{aligned}]" :db/id #edb/ref 17592186392510} {:answer/id #uuid "c445d736-2b33-5a39-a7be-0a95976a8481" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}7 \\\\ 15 \\\\ 0\\end{aligned}]" :db/id #edb/ref 17592186392511} {:answer/id #uuid "cbc16d9e-74fc-598e-a8df-a8298f3cced4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}7 & -2 \\\\ -15 & 7 \\\\ 0 & 0\\end{aligned}]" :db/id #edb/ref 17592186392512} {:answer/id #uuid "b96c80d8-2ac1-5468-adbf-38acb2a30f63" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}-7 \\\\ 12 \\\\ 9\\end{aligned}]" :db/id #edb/ref 17592186392513} {:answer/id #uuid "49f1aa56-0832-5de3-ba9b-9f00b6b7f69f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}7 \\\\ 15 \\\\ 9\\end{aligned}]" :db/id #edb/ref 17592186392514}] :answer-field/correct {:answer/id #uuid "49f1aa56-0832-5de3-ba9b-9f00b6b7f69f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}7 \\\\ 15 \\\\ 9\\end{aligned}]" :db/id #edb/ref 17592186392514} :answer-field/id #uuid "c68e793c-51ab-520a-a8e9-a83467b6243d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186392509}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "72c2951d-d6a9-5cec-b270-d342a8fcfdc1" :question/math-academy-id "q-42259" :question/problem "Calculate $ABC$, where\n\n$$\nA=[\\begin{aligned}1 & 0 \\\\ 2 & 1 \\\\ 1 & 2\\end{aligned}],\\,B=[\\begin{aligned}3 & 1 & 2 \\\\ 0 & 1 & 1\\end{aligned}],\\,C=[\\begin{aligned}2 \\\\ 1 \\\\ 0\\end{aligned}].\n$$" :question/worked-solution "First, recall the associative law\n\n$$\nABC=(AB)C=A(BC).\n$$\n\nNotice that $A$ is a $3\\times 2$ matrix, $B$ is a $2\\times 3$ matrix, and $C$ is a $3\\times 1$ matrix. Therefore, \n\n- multiplying $A$ by $B$, we will obtain a $3\\times 3$ matrix, which will require finding $9$ entries, while\n\n- multiplying $B$ by $C$, we will obtain a $2\\times 1$ matrix, which will require finding $2$ entries.\n\nSo, we find the product $BC$ first:\n\n$$\n\\begin{aligned}BC & =[\\begin{aligned}3 & 1 & 2 \\\\ 0 & 1 & 1\\end{aligned}]\\cdot [\\begin{aligned}2 \\\\ 1 \\\\ 0\\end{aligned}] \\\\  & =[\\begin{aligned}7 \\\\ 1\\end{aligned}]\\end{aligned}\n$$\n\nNow, we multiply $A$ by $BC:$\n\n$$\n\\begin{aligned}ABC & =A(BC) \\\\  & =[\\begin{aligned}1 & 0 \\\\ 2 & 1 \\\\ 1 & 2\\end{aligned}]\\cdot [\\begin{aligned}7 \\\\ 1\\end{aligned}] \\\\  & =[\\begin{aligned}7 \\\\ 15 \\\\ 9\\end{aligned}]\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186329640 :knowledge-point/_questions [{:db/id #edb/ref 17592186115228 :knowledge-point/id #uuid "5a870c4a-daa5-5df2-8968-d8bf9ac0bd75" :knowledge-point/title "Identifying True Statements Regarding Matrix Multiplication"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "19c7b53a-701a-51a2-a16d-4e21a8a4cc1b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186327157} {:answer/id #uuid "52c48599-aa51-58b9-b7f4-01369eca46de" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186327652} {:answer/id #uuid "90f50a2a-111f-54d0-a288-d415a537c42d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186328199} {:answer/id #uuid "c36d0ce7-0114-5581-9387-0b4151c0500e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186328642} {:answer/id #uuid "ec160af8-f144-50c1-b2ac-330cdc7c76a8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186329001}] :answer-field/correct {:answer/id #uuid "c36d0ce7-0114-5581-9387-0b4151c0500e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186328642} :answer-field/id #uuid "1f303ed6-16a7-554a-b9b7-791202045199" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186329235}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "005a0156-3d99-59d1-ab99-adf9b9b4c7b4" :question/math-academy-id "q-42264" :question/problem "Given that $A,B,$ and $C$ are $2\\times 2$ matrices, which of the following statements are always true?\n\n- $AB=BA$\n- $(AB)C=A(BC)$\n- $A(B-C)=(B-C)A$" :question/worked-solution "Let's consider the statements one by one.\n\n- Statement I is false. Matrix multiplication is not commutative, so $AB\\ne BA$ in general.\n\n- Statement II is true. Matrix multiplication is associative, so $(AB)C=A(BC)$ in general.\n\n- Statement III is false. Matrix multiplication is not commutative, so $A(B-C)\\ne (B-C)A$ in general.\n\nTherefore, only statement II is true."}] [{:db/id #edb/ref 17592186329647 :knowledge-point/_questions [{:db/id #edb/ref 17592186100869 :knowledge-point/id #uuid "b494140f-206a-5317-8079-ff719a253140" :knowledge-point/title "Determining Whether Two Matrices Are Conformable for Multiplication"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "56c993a3-b521-5e4e-9b63-95377e12d7bd" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186327688} {:answer/id #uuid "a3940e2a-5e4d-5111-9aa8-655e9e0cdb0e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186328350} {:answer/id #uuid "a6e55bac-7903-58ed-9ab9-ceb90373ea31" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186328384} {:answer/id #uuid "c647be2e-8b5a-5ce5-9a50-22a814f61f15" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186328674} {:answer/id #uuid "d6a063c4-4c0d-5e6a-9d31-a7b0ca0d2115" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186328813}] :answer-field/correct {:answer/id #uuid "a3940e2a-5e4d-5111-9aa8-655e9e0cdb0e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186328350} :answer-field/id #uuid "3df7bbd7-c529-5b77-87d0-548dcad75995" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186329305}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "628bddc5-7db2-5c2d-bca2-c9a2f11c4f87" :question/math-academy-id "q-42381" :question/problem "$$\nO=[\\begin{aligned}1 & 2 \\\\ -4 & 3 \\\\ 0 & 4\\end{aligned}],\\,P=[\\begin{aligned}5 & 0 & 0 \\\\ -4 & 5 & 1\\end{aligned}],\\,R=[\\begin{aligned}2 & 0 & 5\\end{aligned}]\n$$\n\nWhich of the following statements are true regarding the matrices $O,P,$ and $R?$\n\n- The product $OP$ is well defined\n- The product $OR$ is well defined\n- The product $PR$ is well defined" :question/worked-solution "Notice that $O$ is a $3\\times 2$ matrix, $P$ is a $2\\times 3$ matrix, and $R$ is a $1\\times 3$ row vector.\n\nThere are $2$ columns in $O$ and $2$ rows in $P.$ Since the number of columns in $O$ equals the number of rows in $P,$ the matrices $O$ and $P$ are conformable for multiplication:\n\n$$\n{O}_{3\\times \\boxed{\\text{2}}}{\\times }_{✓}{P}_{\\boxed{\\text{2}}\\times 3}=\\text{well defined}\n$$\n\nOn the other hand, there are $2$ columns in $O$ and $1$ rows in $R.$ Since the number of columns in $O$ does **not** equal the number of rows in $R,$ the matrices $O$ and $R$ are **not** conformable for multiplication:\n\n$$\n{O}_{3\\times 2}{\\times }_{\\ne }{R}_{1\\times 3}=\\text{undefined}\n$$\n\nFinally, there are $3$ columns in $P$ and $1$ rows in $R.$ Since the number of columns in $P$ does **not** equal the number of rows in $R,$ the matrices $P$ and $R$ are **not** conformable for multiplication:\n\n$$\n{P}_{2\\times 3}{\\times }_{\\ne }{R}_{1\\times 3}=\\text{undefined}\n$$\n\nTherefore, statement I is true, while statements II and III are false."}] [{:db/id #edb/ref 17592186329650 :knowledge-point/_questions [{:db/id #edb/ref 17592186110574 :knowledge-point/id #uuid "2df217d3-d1d2-54cd-8c93-7925225bfdf3" :knowledge-point/title "Identifying Values in the Range of the Inverse Cosine Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "08020323-c5a9-5b42-9d0e-dd6a5b878b40" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-1,\\frac{\\pi }{2})" :db/id #edb/ref 17592186327000} {:answer/id #uuid "49001fd7-a2ca-5328-aca0-c6263276892c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(0,0)" :db/id #edb/ref 17592186327571} {:answer/id #uuid "6f7b2933-c87c-5869-886d-bd6249488566" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(1,\\pi )" :db/id #edb/ref 17592186327901} {:answer/id #uuid "7202ed4c-a3a4-5db0-bb3b-08b9f0401f66" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-1,\\pi )" :db/id #edb/ref 17592186327921} {:answer/id #uuid "98bd83f6-9a85-596c-88fa-8629f4a8ff28" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(1,\\frac{\\pi }{2})" :db/id #edb/ref 17592186328252}] :answer-field/correct {:answer/id #uuid "7202ed4c-a3a4-5db0-bb3b-08b9f0401f66" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-1,\\pi )" :db/id #edb/ref 17592186327921} :answer-field/id #uuid "9d81aa2a-bd62-55a7-ab1c-fab1facf05b1" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186329446}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "2388e5a3-ccc0-5a99-a06b-72ab673f984d" :question/math-academy-id "q-42433" :question/problem "Which of the following gives the coordinates of the maximum point of the function $y=\\operatorname{arccos}⁡x?$" :question/worked-solution "Let's recall the graph of $y=\\operatorname{arccos}⁡x.$\n\n![](images/d2/d2677563c82c37fd1672a806a18524c97ea5ec17cb4f8ef6d8df23b827ba5e81.png)\n\nFrom the graph, we see that the maximum value is $\\pi $ and it is reached at $x=-1.$ Therefore, the coordinates of the maximum point of the function are $(-1,\\pi ).$"}] [{:db/id #edb/ref 17592186329675 :knowledge-point/_questions [{:db/id #edb/ref 17592186096652 :knowledge-point/id #uuid "45b6a076-8795-5510-aabc-62a925826dd0" :knowledge-point/title "Finding Two Scalar Factors in a Linear Combination"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "08c24834-8cd4-5bea-b65d-b2c5663746e1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$\\lambda =-3$ and $\\mu =-2$" :db/id #edb/ref 17592186327004} {:answer/id #uuid "43f90f38-cbf5-5d7a-920b-1121b5764f3e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$\\lambda =0$ and $\\mu =-2$" :db/id #edb/ref 17592186327528} {:answer/id #uuid "ab7ece4b-a049-56ac-8617-bdfeb30b3311" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$\\lambda =-3$ and $\\mu =-3$" :db/id #edb/ref 17592186328419} {:answer/id #uuid "b21ee6fb-0023-5a59-b1cc-92b08b1e5bb0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$\\lambda =3$ and $\\mu =2$" :db/id #edb/ref 17592186328478} {:answer/id #uuid "baf8f242-62cb-5b3c-a8e9-9e47509ff9d7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$\\lambda =-3$ and $\\mu =0$" :db/id #edb/ref 17592186328564}] :answer-field/correct {:answer/id #uuid "08c24834-8cd4-5bea-b65d-b2c5663746e1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$\\lambda =-3$ and $\\mu =-2$" :db/id #edb/ref 17592186327004} :answer-field/id #uuid "ce77403f-2bf1-5fb6-9d50-de0552a7684f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186329549}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "4f6563bc-e431-538e-8c1d-8eaa7d0e394f" :question/math-academy-id "q-42657" :question/problem "![](images/dc/dc708da9adb4f61161ee1face89403bf1a6ce9762905e8a59b4b3ed9031c817a.png)\n\nConsider the picture above. Given that $r=\\lambda p+\\mu q$, find $\\lambda $ and $\\mu .$" :question/worked-solution "![](images/84/84f8951c4921eca20b00132996dc7b2dfafe047d58574e1822da795e1444c861.png)\n\nIn $△OPR$ shown above, we have \n\n- $OP=3|p|$\n\n- $\\overset{\\to }{OP}$ has the opposite direction to $p$\n\nHence, $\\overset{\\to }{OP}=-3p.$\n\nSimilarly:\n\n- $PR=2|q|$\n\n- $\\overset{\\to }{PR}$ has the opposite direction to $q$\n\nHence, $\\overset{\\to }{PR}=-2q.$\n\nAdditionally, \n\n$$\n\\begin{aligned}r & =\\overset{\\to }{OP}+\\overset{\\to }{PR} \\\\  & =-3p-2q.\\end{aligned}\n$$\n\nConsequently, $r=\\lambda p+\\mu q=-3p-2q.$\n\nSince $p∦q,$ the linear combination can only be written in one way. Equating the coefficients, we get:\n\n- $\\lambda =-3$ and $\\mu =-2$"}] [{:db/id #edb/ref 17592186329678 :knowledge-point/_questions [{:db/id #edb/ref 17592186096653 :knowledge-point/id #uuid "feae36e7-ae88-5f3a-957f-e65a92e399ad" :knowledge-point/title "Expressing a Vector That Satisfies a Ratio in Terms of Known Vectors"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0e3b19d7-9caa-5865-b36b-62dba7ca1b49" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\overset{\\to }{OW}=\\frac{1}{3}u+\\frac{2}{3}v" :db/id #edb/ref 17592186327054} {:answer/id #uuid "12bc31bd-410e-5cec-b3e8-db5ec16e6668" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\overset{\\to }{OW}=\\frac{7}{9}v-\\frac{2}{9}u" :db/id #edb/ref 17592186327095} {:answer/id #uuid "1d8032c3-8159-562d-b85e-ce01f3a9419c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\overset{\\to }{OW}=\\frac{7}{9}u+\\frac{2}{9}v" :db/id #edb/ref 17592186327189} {:answer/id #uuid "ccd9827b-fe26-5576-843d-788fca86322f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\overset{\\to }{OW}=\\frac{2}{3}u+\\frac{1}{3}v" :db/id #edb/ref 17592186328732} {:answer/id #uuid "f6116bad-8f2c-5913-918c-8429cac9d1d4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\overset{\\to }{OW}=-\\frac{1}{3}v+\\frac{2}{3}u" :db/id #edb/ref 17592186329092}] :answer-field/correct {:answer/id #uuid "1d8032c3-8159-562d-b85e-ce01f3a9419c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\overset{\\to }{OW}=\\frac{7}{9}u+\\frac{2}{9}v" :db/id #edb/ref 17592186327189} :answer-field/id #uuid "624e21c0-b503-5eed-93a7-5e549f2e0d0a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186329358}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "cfe5446c-2b26-5e48-974b-de364027f648" :question/math-academy-id "q-42669" :question/problem "![](images/04/040127594f639248736d4492f1853bcb1e6ef18c37db9242ebe466045713628a.png)\n\nConsider the diagram above, where $\\overset{\\to }{OU}=u,$ $\\overset{\\to }{OV}=v$ and $W$ divides $\\overset{―}{UV}$ in the ratio $UW:WV=2:7.$ Find $\\overset{\\to }{OW}.$" :question/worked-solution "From the diagram, we see that\n\n$$\n\\overset{\\to }{OW}=\\overset{\\to }{OU}+\\overset{\\to }{UW}.\n$$\n\nWe're told that $\\overset{\\to }{OU}=u,$ so we just need to work out $\\overset{\\to }{UW}.$\n\nFirst, from $△OUV,$ we have\n\n$$\n\\begin{aligned}\\overset{\\to }{UV} & =\\overset{\\to }{UO}+\\overset{\\to }{OV} \\\\  & =-\\overset{\\to }{OU}+\\overset{\\to }{OV} \\\\  & =-u+v \\\\  & =v-u.\\end{aligned}\n$$\n\nSince $UW:WV=2:7,$ we have\n\n$$\n\\overset{\\to }{UW}=\\frac{2}{9}\\overset{\\to }{UV}=\\frac{2}{9}(v-u).\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\overset{\\to }{OW} & =\\overset{\\to }{OU}+\\overset{\\to }{UW} \\\\  & =u+\\frac{2}{9}(v-u) \\\\  & =\\frac{7}{9}u+\\frac{2}{9}v.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186101412 :knowledge-point/_questions [{:db/id #edb/ref 17592186100844 :knowledge-point/id #uuid "3ea83062-5744-52ef-9b3e-f9805ed092fb" :knowledge-point/title "Finding the General Solution to an Equation Containing a Transformed Reciprocal Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2affdaad-96aa-5484-a442-927e85d5bc81" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "110" :db/id #edb/ref 17592186327314} {:answer/id #uuid "3521707d-b15a-5eb1-a674-60c3a068dbef" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "80" :db/id #edb/ref 17592186327393} {:answer/id #uuid "8ebe1f6b-8a8a-56c5-a9de-f051b92a33f8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "240" :db/id #edb/ref 17592186328176} {:answer/id #uuid "b9883cba-3829-5eae-b3f0-46c20405acfc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "210" :db/id #edb/ref 17592186328552} {:answer/id #uuid "f84442ad-34a5-5352-9847-b2355864c670" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "160" :db/id #edb/ref 17592186329110}] :answer-field/correct {:answer/id #uuid "f84442ad-34a5-5352-9847-b2355864c670" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "160" :db/id #edb/ref 17592186329110} :answer-field/id #uuid "2b837f60-46c5-55db-be33-a2ded8972ca1" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186329262}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "9d1cd618-3e37-5bc5-a865-78591e0eea79" :question/math-academy-id "q-42788" :question/problem "Consider the following trigonometric equation:\n\n$$\n\\operatorname{sec}⁡(\\frac{x}{4}+{20}^{∘})=2.\n$$\n\nThe general solution of this equation is\n\n$$\nx={a}^{∘}+1\\,{440}^{∘}\\cdot n,\\,x=1\\,{120}^{∘}+1\\,{440}^{∘}\\cdot n,\n$$\n\nwhere $n$ is any integer. Which of the following could be the value of $a?$" :question/worked-solution "First, note that the given equation is equivalent to\n\n$$\n\\operatorname{cos}⁡(\\frac{x}{4}+{20}^{∘})=\\frac{1}{2}.\n$$\n\nTherefore, the general solution to our equation is\n\n$$\n\\frac{x}{4}+{20}^{∘}={60}^{∘}+{360}^{∘}\\cdot n,\\,\\frac{x}{4}+{20}^{∘}={300}^{∘}+{360}^{∘}\\cdot n.\n$$\n\nSolving the two equations above for $x,$ we get\n\n$$\n\\begin{aligned}\\frac{x}{4}=-{20}^{∘}+{60}^{∘}+{360}^{∘}\\cdot n, & \\,\\frac{x}{4}=-{20}^{∘}+{300}^{∘}+{360}^{∘}\\cdot n \\\\ \\frac{x}{4}={40}^{∘}+{360}^{∘}\\cdot n, & \\,\\frac{x}{4}={280}^{∘}+{360}^{∘}\\cdot n \\\\ x={160}^{∘}+1\\,{440}^{∘}\\cdot n, & \\,x=1\\,{120}^{∘}+1\\,{440}^{∘}\\cdot n.\\end{aligned}\n$$\n\nSo, we have that $a=160.$"}] [{:db/id #edb/ref 17592186101413 :knowledge-point/_questions [{:db/id #edb/ref 17592186100844 :knowledge-point/id #uuid "3ea83062-5744-52ef-9b3e-f9805ed092fb" :knowledge-point/title "Finding the General Solution to an Equation Containing a Transformed Reciprocal Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "12816130-b7ae-58a5-9f0f-13cc67f21c08" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\pi }{2}" :db/id #edb/ref 17592186327091} {:answer/id #uuid "6184fdd6-eb33-584c-a47e-2dced8a8cf8c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\pi }{4}" :db/id #edb/ref 17592186327786} {:answer/id #uuid "907e306a-a246-574c-a744-8bdd110c28f2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{7\\pi }{12}" :db/id #edb/ref 17592186328195} {:answer/id #uuid "9cc6b643-f6b1-53f2-993d-a1106fb48532" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3\\pi }{4}" :db/id #edb/ref 17592186328288} {:answer/id #uuid "f59c64f1-4d1a-5a50-80ef-df0df82a9e03" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5\\pi }{12}" :db/id #edb/ref 17592186329084}] :answer-field/correct {:answer/id #uuid "907e306a-a246-574c-a744-8bdd110c28f2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{7\\pi }{12}" :db/id #edb/ref 17592186328195} :answer-field/id #uuid "8d377a9e-b5c4-59ea-9955-f41f6b988ee8" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186329420}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "bd51b773-7114-5c60-8ae3-bd4c43f5e27a" :question/math-academy-id "q-42789" :question/problem "Consider the following trigonometric  equation:\n\n$$\n\\operatorname{csc}⁡2x=-2\n$$\n\nThe general solution of this equation can be expressed as \n\n$$\nx=a+\\pi n,\\,x=\\frac{11\\pi }{12}+\\pi n,\n$$\n\nwhere $n$ is any integer. Which of the following could be the value of $a?$" :question/worked-solution "First, note that the given equation is equivalent to\n\n$$\n\\operatorname{sin}⁡2x=-\\frac{1}{2}.\n$$\n\nTherefore, the general solution to our equation is\n\n$$\n2x=\\frac{7\\pi }{6}+2n\\pi ,\\,x=\\frac{11\\pi }{6}+2\\pi n.\n$$\n\nSolving the two equations above for $x,$ we get:\n\n$$\nx=\\frac{7\\pi }{12}+n\\pi ,\\,x=\\frac{11\\pi }{12}+n\\pi \\,\\,\n$$\n\nSo, we have that $a=\\frac{7\\pi }{12}.$"}] [{:db/id #edb/ref 17592186329692 :knowledge-point/_questions [{:db/id #edb/ref 17592186176051 :knowledge-point/id #uuid "0e2a8cf2-64db-5b2f-b0f7-0c727cf492a9" :knowledge-point/title "Describing Properties of the Secant Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3a3b4306-55a9-5f15-98c8-f5d60b6a40ac" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186327443} {:answer/id #uuid "3cf0eaf4-db08-533b-aed6-515990875a68" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "None" :db/id #edb/ref 17592186327466} {:answer/id #uuid "72c7c4d8-6511-5726-b3e9-0656b209f8f4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186327928} {:answer/id #uuid "90fc077c-9a61-5c22-a6a7-607c04c3efe3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186328200} {:answer/id #uuid "95047154-213d-51aa-9ff0-8ef74040020d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186328235}] :answer-field/correct {:answer/id #uuid "90fc077c-9a61-5c22-a6a7-607c04c3efe3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186328200} :answer-field/id #uuid "40a9794c-8ea9-5381-b6f9-0d109bd0dcbf" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186329312}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "3923a242-a394-5f37-9f6d-741dafd435c0" :question/math-academy-id "q-42886" :question/problem "Which of the following statements are true regarding the function $y=sec⁡x?$\n\n- The point $(0,2)$ is in the graph\n- $x=\\frac{3\\pi }{2}$ is a vertical asymptote\n- $y=-2$ belongs to the range of the function." :question/worked-solution "Let's plot the graph of $y=sec⁡x.$\n\n![](images/da/da729794a0331383debd75be0a4ce4a9f2d4da3286f50bd4f284868996077412.png)\n\nLet's go through each statement.\n\n- Statement I is false. The $y$-intercept of $sec⁡x$ is $1.$\n\n- Statement II is true. The function $y=sec⁡x$ has asymptotes at $x=\\frac{\\pi }{2}+n\\pi ,$ thus $x=\\frac{3\\pi }{2}$ is a vertical asymptote.\n\n- Statement III is true. The range of the function is $(-\\infty ,-1]\\cup [1,\\infty ),$ so $y=-2$ belongs to the range."}] [{:db/id #edb/ref 17592186329713 :knowledge-point/_questions [{:db/id #edb/ref 17592186059655 :knowledge-point/id #uuid "ec62fd08-5729-5dc4-97b9-1a422f70109e" :knowledge-point/title "Simplifying an Expression by Expanding Parentheses and Using the Pythagorean Identity"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2f4dfaf9-6adc-58e2-af62-11084821e994" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186327358} {:answer/id #uuid "88ee277f-7d39-51d6-ae8e-804455cc5483" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186328112} {:answer/id #uuid "9908e0fd-b391-508e-8dd9-9f1b7572eaab" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186328256} {:answer/id #uuid "b457a22e-59a5-554f-b4d6-d662134d1479" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186328503} {:answer/id #uuid "d0528873-0750-5fae-828d-e2dd5c23f87e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186328766}] :answer-field/correct {:answer/id #uuid "2f4dfaf9-6adc-58e2-af62-11084821e994" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186327358} :answer-field/id #uuid "a085cb5f-e013-5736-9ee5-2fef11903a5c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186329453}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "770be8a8-209f-5a4a-8f5b-267370ed95fc" :question/math-academy-id "q-43288" :question/problem "$\\operatorname{cos}⁡\\theta \\operatorname{sin}⁡\\theta (\\frac{\\operatorname{cos}⁡\\theta }{\\operatorname{sin}⁡\\theta }+\\frac{\\operatorname{sin}⁡\\theta }{\\operatorname{cos}⁡\\theta })=$" :question/worked-solution "First, we expand the parentheses:\n\n$$\n\\begin{aligned}\\operatorname{cos}⁡\\theta \\operatorname{sin}⁡\\theta (\\frac{\\operatorname{cos}⁡\\theta }{\\operatorname{sin}⁡\\theta }+\\frac{\\operatorname{sin}⁡\\theta }{\\operatorname{cos}⁡\\theta }) & =\\operatorname{cos}⁡\\theta \\operatorname{sin}⁡\\theta \\cdot \\frac{\\operatorname{cos}⁡\\theta }{\\operatorname{sin}⁡\\theta }+\\operatorname{cos}⁡\\theta \\operatorname{sin}⁡\\theta \\cdot \\frac{\\operatorname{sin}⁡\\theta }{\\operatorname{cos}⁡\\theta } \\\\  & =\\frac{\\operatorname{sin}⁡\\theta {cos}^{2}⁡\\theta }{\\operatorname{sin}⁡\\theta }+\\frac{{sin}^{2}⁡\\theta \\operatorname{cos}⁡\\theta }{\\operatorname{cos}⁡\\theta } \\\\  & =\\frac{\\cancel{\\operatorname{sin}⁡\\theta }{cos}^{2}⁡\\theta }{\\cancel{\\operatorname{sin}⁡\\theta }}+\\frac{{sin}^{2}⁡\\theta \\cancel{\\operatorname{cos}⁡\\theta }}{\\cancel{\\operatorname{cos}⁡\\theta }} \\\\  & ={cos}^{2}⁡\\theta +{sin}^{2}⁡\\theta  \\\\  & =1\\end{aligned}\n$$\n\nNotice that, in the last step, we simplified the right-hand side using ${cos}^{2}⁡\\theta +{sin}^{2}⁡\\theta =1.$ \n\nTherefore, we conclude that\n\n$$\n\\operatorname{cos}⁡\\theta \\operatorname{sin}⁡\\theta (\\frac{\\operatorname{cos}⁡\\theta }{\\operatorname{sin}⁡\\theta }+\\frac{\\operatorname{sin}⁡\\theta }{\\operatorname{cos}⁡\\theta })=1.\n$$"}] [{:db/id #edb/ref 17592186329718 :knowledge-point/_questions [{:db/id #edb/ref 17592186059643 :knowledge-point/id #uuid "1bc8c875-3393-5fd6-90cf-87737e16f2f2" :knowledge-point/title "Simplifying a Trigonometric Expression Using a Common Denominator and the Pythagorean Identity"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "16d51a21-90c5-5b54-a6e4-e0b0b8a2ed02" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{sec}⁡t+1" :db/id #edb/ref 17592186327134} {:answer/id #uuid "40320fe3-c500-5dcb-a7c9-96f211e3f18e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{sec}⁡t" :db/id #edb/ref 17592186327498} {:answer/id #uuid "7a98372a-b734-5075-bb5b-a84d747704c2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\operatorname{sec}⁡t-1" :db/id #edb/ref 17592186327984} {:answer/id #uuid "95f2320a-4032-50dc-aeeb-456b3b00cb5f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\operatorname{sec}⁡t+1" :db/id #edb/ref 17592186328238} {:answer/id #uuid "ace65715-85a6-5e2d-ba3b-d82ca77a9505" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\operatorname{sec}⁡t" :db/id #edb/ref 17592186328434}] :answer-field/correct {:answer/id #uuid "40320fe3-c500-5dcb-a7c9-96f211e3f18e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{sec}⁡t" :db/id #edb/ref 17592186327498} :answer-field/id #uuid "34fb1090-54c7-5d88-a697-5bc7387e677b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186329286}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "db749ad3-a154-5aac-9219-0c39bfac704c" :question/math-academy-id "q-43298" :question/problem "$\\operatorname{sin}⁡t(\\frac{\\operatorname{cos}⁡t}{\\operatorname{sin}⁡t}+\\frac{\\operatorname{sin}⁡t}{\\operatorname{cos}⁡t})=$" :question/worked-solution "First, we expand the parentheses:\n\n$$\n\\begin{aligned}\\operatorname{sin}⁡t(\\frac{\\operatorname{cos}⁡t}{\\operatorname{sin}⁡t}+\\frac{\\operatorname{sin}⁡t}{\\operatorname{cos}⁡t}) & =\\operatorname{sin}⁡t\\cdot \\frac{\\operatorname{cos}⁡t}{\\operatorname{sin}⁡t}+\\operatorname{sin}⁡t\\cdot \\frac{\\operatorname{sin}⁡t}{\\operatorname{cos}⁡t} \\\\  & =\\frac{\\operatorname{cos}⁡t\\cdot \\operatorname{sin}⁡t}{\\operatorname{sin}⁡t}+\\frac{{sin}^{2}⁡t}{\\operatorname{cos}⁡t} \\\\  & =\\frac{\\operatorname{cos}⁡t\\cdot \\cancel{\\operatorname{sin}⁡t}}{\\cancel{\\operatorname{sin}⁡t}}+\\frac{{sin}^{2}⁡t}{\\operatorname{cos}⁡t} \\\\  & =\\operatorname{cos}⁡t+\\frac{{sin}^{2}⁡t}{\\operatorname{cos}⁡t}\\end{aligned}\n$$\n\nWe put both terms over a common denominator, and combine the two fractions:\n\n$$\n\\begin{aligned}\\operatorname{cos}⁡\\theta +\\frac{{sin}^{2}⁡t}{\\operatorname{cos}⁡t} & =\\frac{\\operatorname{cos}⁡t}{1}+\\frac{{sin}^{2}⁡t}{\\operatorname{cos}⁡t} \\\\  & =\\frac{\\operatorname{cos}⁡t\\cdot \\operatorname{cos}⁡t}{1\\cdot \\operatorname{cos}⁡t}+\\frac{{sin}^{2}⁡t}{\\operatorname{cos}⁡t} \\\\  & =\\frac{{cos}^{2}⁡t+{sin}^{2}⁡t}{\\operatorname{cos}⁡t}\\end{aligned}\n$$\n\nFinally, we simplify using the Pythagorean identity, as follows:\n\n$$\n\\begin{aligned}\\frac{{cos}^{2}⁡t+{sin}^{2}⁡t}{\\operatorname{cos}⁡t}=\\frac{1}{\\operatorname{cos}⁡t}=\\operatorname{sec}⁡t\\end{aligned}\n$$\n\nTherefore, we conclude that\n\n$$\n\\operatorname{sin}⁡t(\\frac{\\operatorname{cos}⁡t}{\\operatorname{sin}⁡t}+\\frac{\\operatorname{sin}⁡t}{\\operatorname{cos}⁡t})=\\operatorname{sec}⁡t.\n$$"}] [{:db/id #edb/ref 17592186329719 :knowledge-point/_questions [{:db/id #edb/ref 17592186059656 :knowledge-point/id #uuid "e85a2d68-d49f-5bf4-ab62-13ad8c35b0d4" :knowledge-point/title "Simplifying Expression Using an Alternate Form of the Pythagorean Identity"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1d9790e4-77cb-5ff4-ac43-39c78331e808" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{cot}^{2}⁡\\theta " :db/id #edb/ref 17592186327191} {:answer/id #uuid "9939c042-c8aa-5188-bbb4-1c3c3f7a7f48" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{cos}⁡\\theta " :db/id #edb/ref 17592186328257} {:answer/id #uuid "a407281c-48ae-50b3-a5ba-d986468525b5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{cos}⁡\\theta \\operatorname{cot}⁡\\theta " :db/id #edb/ref 17592186328354} {:answer/id #uuid "a8f911ba-6e39-5c15-993b-525d98cd4ba0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1-\\operatorname{cos}⁡\\theta " :db/id #edb/ref 17592186328397} {:answer/id #uuid "e51dd51b-095f-57d7-a137-944306de7d23" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{cos}^{2}⁡\\theta " :db/id #edb/ref 17592186328940}] :answer-field/correct {:answer/id #uuid "a407281c-48ae-50b3-a5ba-d986468525b5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{cos}⁡\\theta \\operatorname{cot}⁡\\theta " :db/id #edb/ref 17592186328354} :answer-field/id #uuid "37d7ae64-5756-5393-953b-b3fac5aef0ce" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186329293}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "3eb8e400-2919-528a-91cb-5d1221ea0b97" :question/math-academy-id "q-43308" :question/problem "Which of the following is equivalent to $(1-\\operatorname{sin}⁡\\theta )(1+\\operatorname{csc}⁡\\theta )?$" :question/worked-solution "First, use the identity $\\operatorname{csc}⁡\\theta =\\frac{1}{\\operatorname{sin}⁡\\theta }:$ \n\n$$\n\\begin{aligned}(1-\\operatorname{sin}⁡\\theta )(1+\\operatorname{csc}⁡\\theta ) & =(1-\\operatorname{sin}⁡\\theta )(1+\\frac{1}{\\operatorname{sin}⁡\\theta }) \\\\  & =(1-\\operatorname{sin}⁡\\theta )(\\frac{\\operatorname{sin}⁡\\theta +1}{\\operatorname{sin}⁡\\theta }) \\\\  & =\\frac{(1-\\operatorname{sin}⁡\\theta )(1+\\operatorname{sin}⁡\\theta )}{\\operatorname{sin}⁡\\theta }\\end{aligned}\n$$\n\nThen, we expand the parentheses in the numerator:\n\n$$\n\\begin{aligned}\\frac{(1-\\operatorname{sin}⁡\\theta )(1+\\operatorname{sin}⁡\\theta )}{\\operatorname{sin}⁡\\theta } & =\\frac{1-{sin}^{2}⁡\\theta }{\\operatorname{sin}⁡\\theta }\\end{aligned}\n$$\n\nNext, we rewrite the numerator using $1-{sin}^{2}⁡\\theta ={cos}^{2}⁡\\theta $ and simplify:\n\n$$\n\\begin{aligned}\\frac{1-{sin}^{2}⁡\\theta }{\\operatorname{sin}⁡\\theta } & =\\frac{{cos}^{2}⁡\\theta }{\\operatorname{sin}⁡\\theta } \\\\  & =\\operatorname{cos}⁡\\theta \\cdot \\frac{\\operatorname{cos}⁡\\theta }{\\operatorname{sin}⁡\\theta } \\\\  & =\\operatorname{cos}⁡\\theta \\operatorname{cot}⁡\\theta .\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186329721 :knowledge-point/_questions [{:db/id #edb/ref 17592186105904 :knowledge-point/id #uuid "cafdb077-0e02-5e7a-bf78-c3a8aacfb6f7" :knowledge-point/title "Calculating an Angle or Side of a Triangle Given the Area of a Triangle"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "55cfe684-dc18-5ab1-b164-6d50fade618a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{45}^{∘}" :db/id #edb/ref 17592186327676} {:answer/id #uuid "8d23ee9d-454e-5907-a98d-d759e11996ed" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{25}^{∘}" :db/id #edb/ref 17592186328151} {:answer/id #uuid "b7359851-720e-5ab4-876a-6265d25f515d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{40}^{∘}" :db/id #edb/ref 17592186328528} {:answer/id #uuid "cf531d87-8a79-5162-b024-e25dc07d7e53" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{30}^{∘}" :db/id #edb/ref 17592186328757} {:answer/id #uuid "e7164a97-e526-5ef2-8ced-7e38b414e248" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{35}^{∘}" :db/id #edb/ref 17592186328954}] :answer-field/correct {:answer/id #uuid "cf531d87-8a79-5162-b024-e25dc07d7e53" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{30}^{∘}" :db/id #edb/ref 17592186328757} :answer-field/id #uuid "fbc9b871-5875-5e5c-8a91-d0aec6bf5882" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186329619}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "55d7cd50-6834-55b6-a52f-4f6d251b49dd" :question/math-academy-id "q-43339" :question/problem "![](images/85/85b13f2236c5f00da34ea71fdbfc967882fa6e66c347f6ef40c0604391a5d68e.png)\n\nThe area of ​​the triangle $△ABC$ is $15{\\text{ cm}}^{2}.$ Find $m∠A.$" :question/worked-solution "The formula for the area of the triangle is \n\n$$\nA=\\frac{1}{2}bc\\operatorname{sin}⁡A,\n$$\n\nwhere $∠A$ is between the sides of lengths $b$ and $c.$ \n\nHere\n\n$$\n\\begin{aligned}c & =AB=5\\,\\text{ cm}, \\\\ b & =AC=12\\,\\text{cm}\\end{aligned}\n$$\n\nTherefore, we can calculate $m∠A$ as follows:\n\n$$\n\\begin{aligned}A & =\\frac{1}{2}\\cdot b\\cdot c\\cdot \\operatorname{sin}⁡A \\\\ 15 & =\\frac{1}{2}\\cdot 12\\cdot 5\\cdot \\operatorname{sin}⁡A \\\\ 15 & =30\\cdot \\operatorname{sin}⁡A \\\\ \\frac{15}{30} & =\\operatorname{sin}⁡A \\\\ \\operatorname{sin}⁡A & =\\frac{1}{2} \\\\ m∠A & ={30}^{∘}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186329723 :knowledge-point/_questions [{:db/id #edb/ref 17592186129122 :knowledge-point/id #uuid "1eeb42af-74ee-53d7-af9f-be171f77968f" :knowledge-point/title "Calculating the Period of a Transformed Sinusoidal Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0f720e8d-bb1b-59ca-9ab6-dc161291bf7c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{60}^{∘}" :db/id #edb/ref 17592186327071} {:answer/id #uuid "5fc7ca04-3dfc-5466-a866-a199437da7e3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{30}^{∘}" :db/id #edb/ref 17592186327775} {:answer/id #uuid "7851f496-18f4-5ce9-b27a-0a6147c6176e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{45}^{∘}" :db/id #edb/ref 17592186327963} {:answer/id #uuid "85974f52-6385-50ae-a81b-e8bc2b19d899" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{15}^{∘}" :db/id #edb/ref 17592186328085} {:answer/id #uuid "dfb14292-bdff-5641-bc24-4dffec7b4e6f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{75}^{∘}" :db/id #edb/ref 17592186328894}] :answer-field/correct {:answer/id #uuid "7851f496-18f4-5ce9-b27a-0a6147c6176e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{45}^{∘}" :db/id #edb/ref 17592186327963} :answer-field/id #uuid "c2a5f161-27b6-5dd4-aa10-c1cb6123c7a0" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186329527}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "72d5418e-aa83-5e26-b56d-9365871c6a6c" :question/math-academy-id "q-43411" :question/problem "What is the period of the function $f(x)=\\operatorname{cos}⁡(8x+{90}^{∘})?$" :question/worked-solution "Given a function in the form $y=A\\operatorname{cos}⁡(Bx+C)+D,$ the period is ${360}^{∘}.$\n\nIn our case, we have that $B=8.$ Therefore, the period is $\\frac{{360}^{∘}}{8}={45}^{∘}.$"}] [{:db/id #edb/ref 17592186111178 :knowledge-point/_questions [{:db/id #edb/ref 17592186110553 :knowledge-point/id #uuid "03491655-9b81-5fc0-bf20-e4f74a9c72ad" :knowledge-point/title "Simplifying an Expression Using the Secant-Tangent Identity: Replacing a Squared Tangent"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3181638b-4d66-589a-b061-04d74bf07e12" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186327372} {:answer/id #uuid "4fd3b151-608d-541d-b9c4-1224e1328c24" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186327630} {:answer/id #uuid "584096c0-c59b-5b5c-802a-e72a377ffdcd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2{sec}^{2}⁡\\theta " :db/id #edb/ref 17592186327708} {:answer/id #uuid "5b36cc0f-2f9f-59d1-bc2e-d088509a383f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\operatorname{sec}⁡\\theta " :db/id #edb/ref 17592186327734} {:answer/id #uuid "9b4c20ff-9024-5eb1-89f9-dc0efac40673" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186328278}] :answer-field/correct {:answer/id #uuid "4fd3b151-608d-541d-b9c4-1224e1328c24" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186327630} :answer-field/id #uuid "bac4f7c2-82a2-5f28-8ff9-2ad956252386" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186329515}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "a581c5d1-c937-510f-8cbd-8478ab152d79" :question/math-academy-id "q-43617" :question/problem "$\\frac{1+{tan}^{2}⁡\\theta }{{sec}^{2}⁡\\theta }=$" :question/worked-solution "First, let's recall the secant-tangent identity:\n\n$$\n1+{tan}^{2}⁡\\theta ={sec}^{2}⁡\\theta \n$$\n\nWe rewrite the given expression using the secant-tangent identity as follows:\n\n$$\n\\begin{aligned}\\frac{1+{tan}^{2}⁡\\theta }{{sec}^{2}⁡\\theta } & =\\frac{{sec}^{2}⁡\\theta }{{sec}^{2}⁡\\theta } \\\\  & =\\frac{\\cancel{{sec}^{2}⁡\\theta }}{\\cancel{{sec}^{2}⁡\\theta }} \\\\  & =1\\end{aligned}\n$$\n\nTherefore, we conclude that\n\n$$\n\\frac{1+{tan}^{2}⁡\\theta }{{sec}^{2}⁡\\theta }=1.\n$$"}] [{:db/id #edb/ref 17592186392554 :knowledge-point/_questions [{:db/id #edb/ref 17592186110585 :knowledge-point/id #uuid "46e1513d-0944-5c09-8a7e-e1d9ae81bae5" :knowledge-point/title "Graphing the Inverse Tangent Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "704dd449-03cc-5cb5-8d71-9633864418fd" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/90/901cc06ce7661348fa18bb172f0a014e0c0d49e6f0a788cfe5926faa6e3061b0.png" :db/id #edb/ref 17592186392556} {:answer/id #uuid "ab422978-41b5-5448-9e5c-293965809dac" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/b2/b2939d0005167bb5771d7a566af50eff3c0d595ff95666d97d0d52597518f814.png" :db/id #edb/ref 17592186392557} {:answer/id #uuid "537f4564-f5f1-5ad4-9cdb-0876e35602eb" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/d7/d7984b9098d02bfc2b1e9a422aef919533abce54fbb94117e709c7613b0870a3.png" :db/id #edb/ref 17592186392558} {:answer/id #uuid "3969e61c-1862-53e5-8d39-b6a5cccbc85b" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/7a/7aadddedfe33accf816c81268b8873d02a324034e6ab26bdbfa9895989e7e63e.png" :db/id #edb/ref 17592186392559} {:answer/id #uuid "99f07ab8-6830-58b2-8709-6db297f0d693" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/e7/e7aff749f5804fb774a334918b62ff9f20fd8e384fcebbc372e811ce51729d4a.png" :db/id #edb/ref 17592186392560}] :answer-field/correct {:answer/id #uuid "537f4564-f5f1-5ad4-9cdb-0876e35602eb" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/d7/d7984b9098d02bfc2b1e9a422aef919533abce54fbb94117e709c7613b0870a3.png" :db/id #edb/ref 17592186392558} :answer-field/id #uuid "51b945ad-4e83-57d3-875d-408d14586c43" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186392555}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "e78d2563-d22e-5b86-b89f-f6aab65d4ec5" :question/math-academy-id "q-43659" :question/problem "What is the graph of $y=\\operatorname{arctan}⁡x?$" :question/worked-solution "Let's recall some of the basic properties of $y=\\operatorname{arctan}⁡x:$\n\n- The domain is all real numbers.\n\n- There is a zero at $x=0.$\n\n- The function is negative over $(-\\infty ,0)$ and positive over $(0,\\infty ).$\n\n- The function is strictly increasing in its entire domain.\n\n- $y\\to -\\frac{\\pi }{2}$ (from above) as $x\\to -\\infty .$\n\n- $y\\to \\frac{\\pi }{2}$ (from below) as $x\\to \\infty .$\n\n- The lines $y=\\pm \\frac{\\pi }{2}$ are horizontal asymptotes of the function.\n\nOf the given functions, the only one that has all of these properties is as follows:\n\n![](images/d7/d7984b9098d02bfc2b1e9a422aef919533abce54fbb94117e709c7613b0870a3.png)"}] [{:db/id #edb/ref 17592186329753 :knowledge-point/_questions [{:db/id #edb/ref 17592186175922 :knowledge-point/id #uuid "ae4289af-e251-514c-981e-5c6d21992ad3" :knowledge-point/title "Finding the Equation of a Perpendicular Line"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7e922a42-6deb-5bc6-a4f2-a8d06f3fea60" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=2x+6" :db/id #edb/ref 17592186328024} {:answer/id #uuid "d59f7611-aece-5245-9299-86b545be9496" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=-\\frac{1}{2}x+6" :db/id #edb/ref 17592186328803} {:answer/id #uuid "dd0e28cc-1799-536e-bd55-0a06dc16bb67" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=\\frac{1}{2}x" :db/id #edb/ref 17592186328867} {:answer/id #uuid "de5640a4-5333-5d9b-b991-e89e51fe95ab" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=-6x-2" :db/id #edb/ref 17592186328881} {:answer/id #uuid "ed73643a-713f-5f7a-aea6-c63401f50949" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=-2x+6" :db/id #edb/ref 17592186329014}] :answer-field/correct {:answer/id #uuid "d59f7611-aece-5245-9299-86b545be9496" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=-\\frac{1}{2}x+6" :db/id #edb/ref 17592186328803} :answer-field/id #uuid "2512d590-4b14-5e67-bd6c-bb6c4cebbb08" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186329251}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "36e2ce70-a218-5096-a57b-5f93338562ee" :question/math-academy-id "q-44337" :question/problem "![](images/c9/c9c426e75153bd893e3dbef39bd8a837991d8c3ec6a48b41aeb27df6c4250660.png)\n\nIn the diagram above, the equation of the line ${l}_{1}$ is $y=2x-1$ and ${l}_{2}$ is perpendicular to ${l}_{1}.$ What is the equation of the line ${l}_{2}?$" :question/worked-solution "Since perpendicular lines have slopes that are negative reciprocals of each other, the slope of ${l}_{2}$ is the negative reciprocal of the slope of ${l}_{1}.$ Since ${l}_{1}$ has a slope of $2,$ the line ${l}_{2}$ must have a slope of $-\\frac{1}{2}.$\n\nOur perpendicular line must have the slope $m=-\\frac{1}{2}$ and a $y$-intercept of $6.$ Therefore, it can be written in slope-intercept form as\n\n$$\ny=-\\frac{1}{2}x+6.\n$$"}] [{:db/id #edb/ref 17592186111184 :knowledge-point/_questions [{:db/id #edb/ref 17592186110600 :knowledge-point/id #uuid "e732f270-1d6f-5ff8-8792-d9b329ea858d" :knowledge-point/title "Determining Whether Two Lines in Standard Form are Perpendicular"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "04aa8a38-9ecc-5e87-9899-fa2c52620615" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=5x-4" :db/id #edb/ref 17592186326982} {:answer/id #uuid "2a0d4423-cdbd-59bc-9519-c02229ca242c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=-x+1" :db/id #edb/ref 17592186327296} {:answer/id #uuid "842c8b78-fb24-5dfb-9556-59ef1eff7a4f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=\\frac{1}{5}x-6" :db/id #edb/ref 17592186328076} {:answer/id #uuid "8f307607-46e6-546c-b68f-66ba5c7a0d68" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=-\\frac{1}{5}x+15" :db/id #edb/ref 17592186328184} {:answer/id #uuid "b9b36271-f849-5b31-8979-398e7e127d62" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=-5x-1" :db/id #edb/ref 17592186328554}] :answer-field/correct {:answer/id #uuid "04aa8a38-9ecc-5e87-9899-fa2c52620615" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=5x-4" :db/id #edb/ref 17592186326982} :answer-field/id #uuid "637a8d42-8d66-59a6-9b11-fb936c324619" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186329359}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "f8ebc497-48a2-5b22-a14f-221db06dd5d2" :question/math-academy-id "q-44404" :question/problem "Which of the following lines is perpendicular to $x+5y=10?$" :question/worked-solution "For the two lines to be perpendicular, their slopes must multiply to $-1.$\n\nTo find the slope of the given line $x+5y=10,$ we convert to slope-intercept form:\n\n$$\n\\begin{aligned}x+5y & =10 \\\\ 5y & =-x+10 \\\\ y & =-\\frac{1}{5}x+2\\end{aligned}\n$$\n\nIn slope-intercept form, the slope is the $x$-coefficient. So, the slope of the given line is $-\\frac{1}{5}.$\n\nLooking at the answer choices, the line $y=5x-4$ has a slope of $5.$\n\nMultiplying the slopes together, we have\n\n$$\n(-\\frac{1}{5})\\cdot 5=-1.\n$$\n\nSince the slopes multiply to $-1,$ we conclude that the line $y=5x-4$ is perpendicular to the given line."}] [{:db/id #edb/ref 17592186329754 :knowledge-point/_questions [{:db/id #edb/ref 17592186110601 :knowledge-point/id #uuid "6f3d7d62-686b-59c4-9ea1-695c6be3180b" :knowledge-point/title "Determining Unknown Parameters Given Two Perpendicular Lines"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7c5cea50-fecb-5d5b-8a89-f4f34d327f19" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186328005} {:answer/id #uuid "7f3ca05e-2e03-5005-8439-1e9b0e51d16a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-6" :db/id #edb/ref 17592186328028} {:answer/id #uuid "d0d0efcf-7b5d-51ae-a082-657d77e63c13" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{6}" :db/id #edb/ref 17592186328768} {:answer/id #uuid "df927e48-fbac-512c-b73b-41214fbca6fb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{2}" :db/id #edb/ref 17592186328892} {:answer/id #uuid "e4e47ca3-6ef9-5cec-9235-9aa609798010" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{3}{2}" :db/id #edb/ref 17592186328939}] :answer-field/correct {:answer/id #uuid "7f3ca05e-2e03-5005-8439-1e9b0e51d16a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-6" :db/id #edb/ref 17592186328028} :answer-field/id #uuid "4e4084a6-ffaf-52c0-9e02-59ab5e2b3839" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186329328}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "fa337919-23eb-5736-a04b-9af0d92af77d" :question/math-academy-id "q-44407" :question/problem "The lines $4x-8y=7$ and $3y-px=9$ are perpendicular. The value of $p=$" :question/worked-solution "For the two lines to be perpendicular, their slopes must multiply to $-1.$\n\nTo find the slope of $4x-8y=7,$ we convert to slope-intercept form:\n\n$$\n\\begin{aligned}4x-8y & =7 \\\\ -8y & =-4x+7 \\\\ 8y & =4x-7 \\\\ y & =\\frac{1}{2}x-\\frac{7}{8}\\end{aligned}\n$$\n\nTo find the slope of $3y-px=9,$ we convert to slope-intercept form:\n\n$$\n\\begin{aligned}3y-px & =9 \\\\ 3y & =px+9 \\\\ y & =\\frac{p}{3}x+3\\end{aligned}\n$$\n\nTherefore:\n\n- The slope of the line $4x-8y=7$ is $\\frac{1}{2}.$\n\n- The slope of the line $3y-px=9$ is $\\frac{p}{3}.$\n\nMultiplying the slopes together, we have\n\n$$\n\\frac{1}{2}\\cdot \\frac{p}{3}=-1\\,⟹\\,p=-6.\n$$"}] [{:db/id #edb/ref 17592186329760 :knowledge-point/_questions [{:db/id #edb/ref 17592186110602 :knowledge-point/id #uuid "a6fee8d5-e1f7-599d-a74c-abc44d973065" :knowledge-point/title "Finding Equations of Perpendicular Horizontal and Vertical Lines"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "15a5593e-d6ed-5927-b3a1-d1daf628097e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=-7" :db/id #edb/ref 17592186327122} {:answer/id #uuid "30c1bcff-f9d0-5c30-91f5-4ef435a4a0c0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=-9" :db/id #edb/ref 17592186327366} {:answer/id #uuid "76680e20-3119-50e8-b90e-149dee6da095" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=-7" :db/id #edb/ref 17592186327947} {:answer/id #uuid "9aeb19e0-e051-568b-87f4-243574507bc2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=5" :db/id #edb/ref 17592186328276} {:answer/id #uuid "b5707a21-7927-57dc-8dfb-375cdb25c534" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=-9" :db/id #edb/ref 17592186328513}] :answer-field/correct {:answer/id #uuid "15a5593e-d6ed-5927-b3a1-d1daf628097e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=-7" :db/id #edb/ref 17592186327122} :answer-field/id #uuid "b1cd0532-96ff-5c54-9e68-ab598a48b1e0" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186329496}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "30c4eaa9-084c-53b2-8078-d461a7041d34" :question/math-academy-id "q-44691" :question/problem "Determine the equation of the line that passes through the point $(-7,-9)$ and is perpendicular to $y=5.$" :question/worked-solution "Since the line $y=5$ is a horizontal line, a perpendicular line would need to be vertical. So, the perpendicular line must take the form $x=k$ for some value of $k.$\n\nThe perpendicular line needs to go through the point $(-7,-9),$ which has an $x$-coordinate of $-7.$ So, the perpendicular line is $x=-7.$"}] [{:db/id #edb/ref 17592186392568 :knowledge-point/_questions [{:db/id #edb/ref 17592186068687 :knowledge-point/id #uuid "b3ff37f0-6e45-5da4-ac87-1b93c8df3e80" :knowledge-point/title "Representing Solutions of Compound Inequalities on Number Lines"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f2430143-e3ef-56c0-9f1f-964a44b1fe36" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/91/91ec8574742229a2c7fd5af8920f9137e2b25e28a6f02a7cf1edcc8a4db4b6d5.png" :db/id #edb/ref 17592186392570} {:answer/id #uuid "42638bec-e49e-5814-a427-d1911ca95c41" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/1a/1a3b83780bbd15328077dc45eef965aaf311e704990ee3cb45078d76c96183a2.png" :db/id #edb/ref 17592186392571} {:answer/id #uuid "304db39b-9fd8-57ff-a43e-494c6882a179" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/c8/c8c019b0d7a2b34e9791394ce1ac50f8db22b1d7fb9296a8c119a80a583d63ef.png" :db/id #edb/ref 17592186392572} {:answer/id #uuid "2102c409-a8fd-5bbe-a29f-a0866257c255" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/d3/d3ff8ace8f19f48631b57968c7aad223613e65f5be6f67a3196bd5fa9158ae51.png" :db/id #edb/ref 17592186392573} {:answer/id #uuid "95f7974a-4774-510c-92d0-7a4e59b60df1" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/5a/5a8e25a0a97ec193574fd8099e2dfdce70ed887e9f527b855b1ca0957ae7885b.png" :db/id #edb/ref 17592186392574}] :answer-field/correct {:answer/id #uuid "f2430143-e3ef-56c0-9f1f-964a44b1fe36" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/91/91ec8574742229a2c7fd5af8920f9137e2b25e28a6f02a7cf1edcc8a4db4b6d5.png" :db/id #edb/ref 17592186392570} :answer-field/id #uuid "fe31165c-2ea1-57a8-ac77-e3f03a131397" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186392569}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "e996239f-cafe-55a4-9e1e-af5edfdca48f" :question/math-academy-id "q-44761" :question/problem "Which of the following number lines gives the solution to $-1<-5x-6<4?$" :question/worked-solution "We isolate $x$ by applying the addition and multiplication principles, as usual:\n\n$$\n\\begin{aligned}-1 & <-5x-6<4 \\\\ -1+6 & <-5x-6+6<4+6 \\\\ 5 & <-5x<10\\end{aligned}\n$$\n\nAt this point, we need to divide by $-5.$ However, because we are dividing by a negative, we also need to flip the signs of the inequalities.\n\n$$\n\\begin{aligned}5 & <-5x<10 \\\\ \\frac{5}{-5} & >\\frac{-5x}{-5}>\\frac{10}{-5} \\\\ -1 & >x>-2\\end{aligned}\n$$\n\nThe solution can be written as $-1>x>-2$, but this is somewhat difficult to read because the larger number is on the left rather than the right. So, we will rewrite the solution by reversing the order of the numbers: \n\n$$\n-2<x<-1\n$$\n\nWe can represent this solution using a number line, as follows.\n\n![](images/91/91ec8574742229a2c7fd5af8920f9137e2b25e28a6f02a7cf1edcc8a4db4b6d5.png)"}] [{:db/id #edb/ref 17592186329766 :knowledge-point/_questions [{:db/id #edb/ref 17592186129094 :knowledge-point/id #uuid "eac988ba-ea97-52c7-90a7-d451ee7f49e5" :knowledge-point/title "Finding the Intervals on Which a Rational Function Is Continuous"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "184cb986-356b-5b99-a26d-3c28037cbf9b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-2,\\infty )" :db/id #edb/ref 17592186327143} {:answer/id #uuid "229a8b7a-fb69-51c8-9752-e403414ceb1f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-\\infty ,2)\\cup [2,\\infty )" :db/id #edb/ref 17592186327233} {:answer/id #uuid "4b9f6c3f-8609-5e1f-ae1c-e5a050990595" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-\\infty ,-2)\\cup (-2,\\infty )" :db/id #edb/ref 17592186327596} {:answer/id #uuid "7ae44e58-9700-5cdf-bf75-0cbc7d570e5a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(2,\\infty )" :db/id #edb/ref 17592186327991} {:answer/id #uuid "efcfb790-d29a-5a46-b95a-2182bff9ba84" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-\\infty ,-2]\\cup (-2,\\infty )" :db/id #edb/ref 17592186329028}] :answer-field/correct {:answer/id #uuid "4b9f6c3f-8609-5e1f-ae1c-e5a050990595" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-\\infty ,-2)\\cup (-2,\\infty )" :db/id #edb/ref 17592186327596} :answer-field/id #uuid "02a29085-f6a5-57a6-b07d-857f7c485ce9" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186329190}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "abf06e7d-1262-50fe-8aac-916db45605bd" :question/math-academy-id "q-4561" :question/problem "Determine the largest union of intervals on which the function $f(x)=\\frac{{x}^{2}}{2x+4}$ is continuous." :question/worked-solution "This is a rational function, so it is continuous at all points in its domain. To find its domain, we start by factoring the denominator:\n\n$$\n\\begin{aligned}f(x) & =\\frac{{x}^{2}}{2x+4} \\\\  & =\\frac{{x}^{2}}{2(x+2)}\\end{aligned}\n$$\n\n \n\nThis function is continuous everywhere except at the excluded point $x=-2.$\n\nTherefore, the domain consists of the union of the intervals $(-\\infty ,-2)$ and $(-2,\\infty ),$ namely\n\n$$\n(-\\infty ,-2)\\cup (-2,\\infty )\n$$\n\nand the function is also continuous on this union of intervals."}] [{:db/id #edb/ref 17592186329768 :knowledge-point/_questions [{:db/id #edb/ref 17592186100994 :knowledge-point/id #uuid "8e9df1ae-8176-555b-987d-94773c27d435" :knowledge-point/title "Finding the Radius of a Circle on the Coordinate Plane Using the Distance Formula"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1f69a451-fc1a-53c3-99ba-8794adb192de" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186327206} {:answer/id #uuid "336a30a2-8421-5c3f-9236-26d06f04d9ba" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3\\sqrt{5}" :db/id #edb/ref 17592186327378} {:answer/id #uuid "339042f1-7a53-52e5-9e12-f3fd477136df" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{5}" :db/id #edb/ref 17592186327381} {:answer/id #uuid "5620faab-8634-5c06-8781-d34feae4212a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\sqrt{5}" :db/id #edb/ref 17592186327679} {:answer/id #uuid "a6b816b2-1418-5f58-be00-510d1833ac0b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186328380}] :answer-field/correct {:answer/id #uuid "339042f1-7a53-52e5-9e12-f3fd477136df" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{5}" :db/id #edb/ref 17592186327381} :answer-field/id #uuid "e7cc9205-adbc-534f-bd1f-78044226c4d1" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186329585}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "1784a5ba-0bb5-56cc-a185-96af988fd7de" :question/math-academy-id "q-45759" :question/problem "The points $A$ and $B$ have coordinates $(0,-3)$ and $(4,-5)$, respectively, and the segment $\\overset{―}{AB}$ is a diameter of a circle. Find the radius of the circle." :question/worked-solution "The diameter can be calculated using the distance formula: \n\n$$\n\\begin{aligned}d & =\\sqrt{{({x}_{1}-{x}_{2})}^{2}+{({y}_{1}-{y}_{2})}^{2}} \\\\  & =\\sqrt{{(4-0)}^{2}+(-5-(-3))^{2}} \\\\  & =\\sqrt{{4}^{2}+{(-2)}^{2}} \\\\  & =\\sqrt{16+4} \\\\  & =2\\sqrt{5}.\\end{aligned}\n$$\n\nThe radius is half the diameter:\n\n$$\nr=\\frac{d}{2}=\\frac{2\\sqrt{5}}{2}=\\sqrt{5}\n$$"}] [{:db/id #edb/ref 17592186329770 :knowledge-point/_questions [{:db/id #edb/ref 17592186129082 :knowledge-point/id #uuid "98d6004a-547a-5b0b-9748-9571cc3ee632" :knowledge-point/title "Computing a Tangent or Cotangent Using the Pythagorean Identity"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0697fb32-13a8-5152-929c-1cbc92697a41" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{4\\sqrt{5}}{12}" :db/id #edb/ref 17592186326990} {:answer/id #uuid "29cbd9c5-1f6a-5f93-bfe0-6e1833448eef" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{25}{12}" :db/id #edb/ref 17592186327292} {:answer/id #uuid "5f59d2b0-87ec-535c-98db-46f721956829" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5\\sqrt{5}}{12}" :db/id #edb/ref 17592186327771} {:answer/id #uuid "875b0e21-3bdb-537e-83a7-6070520501cf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{25}{12}" :db/id #edb/ref 17592186328098} {:answer/id #uuid "8c78c851-07e7-51bc-a294-83ea44fc4afa" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{5\\sqrt{5}}{12}" :db/id #edb/ref 17592186328139}] :answer-field/correct {:answer/id #uuid "29cbd9c5-1f6a-5f93-bfe0-6e1833448eef" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{25}{12}" :db/id #edb/ref 17592186327292} :answer-field/id #uuid "6067e08a-a253-5424-8dcb-5049856ea945" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186329354}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "c5295f76-3e41-52a4-88d5-2769f2995c21" :question/math-academy-id "q-45875" :question/problem "If $\\operatorname{csc}⁡\\theta =\\frac{5}{3}$ and $\\frac{\\pi }{2}<\\theta <\\pi $ then what is the value of $\\operatorname{tan}⁡\\theta +\\operatorname{cot}⁡\\theta ?$" :question/worked-solution "As $\\operatorname{csc}⁡\\theta =\\frac{5}{3}$ then $\\operatorname{sin}⁡\\theta =\\frac{1}{\\operatorname{csc}⁡\\theta }=\\frac{3}{5}.$\n\nLet's sketch our angle $\\theta $ in the coordinate plane.\n\n![](images/aa/aaba5af0542d29ef91d4b0e17907a81e32bccc402c48b32c205e7298630b5bc0.png)\n\nWe're given that $\\operatorname{sin}⁡\\theta =\\frac{3}{5}$ We can use the Pythagorean identity to find $\\operatorname{cos}⁡\\theta :$\n\n$$\n\\begin{aligned}{sin}^{2}⁡\\theta +{cos}^{2}⁡\\theta  & =1 \\\\ {cos}^{2}⁡\\theta  & =1-{sin}^{2}⁡\\theta  \\\\ \\operatorname{cos}⁡\\theta  & =\\pm \\sqrt{1-{sin}^{2}⁡\\theta }\\end{aligned}\n$$\n\nSubstituting $\\operatorname{sin}⁡\\theta =\\frac{3}{5}$ gives\n\n$$\n\\begin{aligned}\\operatorname{cos}⁡\\theta  & =\\pm \\sqrt{1-{(\\frac{3}{5})}^{2}} \\\\  & =\\pm \\sqrt{1-\\frac{9}{25}} \\\\  & =\\pm \\sqrt{\\frac{16}{25}} \\\\  & =\\pm \\frac{4}{5}.\\end{aligned}\n$$\n\nWe select the negative answer since $\\operatorname{cos}⁡\\theta $ is negative in the second quadrant. So, $\\operatorname{cos}⁡\\theta =-\\frac{4}{5}.$\n\nFinally, knowing that $\\operatorname{cot}⁡\\theta =\\frac{\\operatorname{cos}⁡\\theta }{\\operatorname{sin}⁡\\theta },$ and $\\operatorname{tan}⁡\\theta =\\frac{\\operatorname{sin}⁡\\theta }{\\operatorname{cos}⁡\\theta }$ we have:\n\n- $\\operatorname{cot}⁡\\theta =\\frac{(-\\frac{4}{5})}{(\\frac{3}{5})}=-\\frac{4}{3}$\n\n- $\\operatorname{tan}⁡\\theta =\\frac{(\\frac{3}{5})}{(-\\frac{4}{5})}=-\\frac{3}{4}.$\n\nFinally, we have\n\n$\\operatorname{tan}⁡\\theta +\\operatorname{cot}⁡\\theta =-\\frac{4}{3}-\\frac{3}{4}=-\\frac{25}{12}.$"}] [{:db/id #edb/ref 17592186329783 :knowledge-point/_questions [{:db/id #edb/ref 17592186083235 :knowledge-point/id #uuid "2de6dbad-0ca5-5a17-a04b-cdfd72d6dab5" :knowledge-point/title "Factoring an Expression Containing a Sum of Squares"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2a1351ff-6581-5cc5-90e7-dd06f6e8c14b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-4(5+3\\text{i}m)(5-3\\text{i}m)" :db/id #edb/ref 17592186327297} {:answer/id #uuid "80b6fe9e-0506-5dda-971f-dc0d61ec4a3f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-(3+5\\text{i}m)(3-5\\text{i}m)" :db/id #edb/ref 17592186328042} {:answer/id #uuid "8d7c8efa-e9ed-5427-9384-353a1c64efa7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-(5+3\\text{i}m)(5-3\\text{i}m)" :db/id #edb/ref 17592186328157} {:answer/id #uuid "9cc57fa3-bb89-5a7a-bd30-97bbd6466a0e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-5(3+4\\text{i}m)(3-4\\text{i}m)" :db/id #edb/ref 17592186328287} {:answer/id #uuid "d3280bbc-cdd4-5168-adda-2abb101ed90e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-5(4+3\\text{i}m)(4-3\\text{i}m)" :db/id #edb/ref 17592186328788}] :answer-field/correct {:answer/id #uuid "2a1351ff-6581-5cc5-90e7-dd06f6e8c14b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-4(5+3\\text{i}m)(5-3\\text{i}m)" :db/id #edb/ref 17592186327297} :answer-field/id #uuid "5c8abfda-8c32-53b8-bdc8-9bf64abd97ce" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186329350}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "54d3d1e2-2e59-5152-a868-718f646fc4f9" :question/math-academy-id "q-46507" :question/problem "The expression $-100-36{m}^{2}$ is equivalent to" :question/worked-solution "First, let's factor out $-4$ from the expression. We have\n\n$$\n-100-36{m}^{2}=-4(25+9{m}^{2}).\n$$\n\nLet's now focus on factoring the expression $(25+9{m}^{2}).$\n\nTo factor a sum of squares, we first write it as a difference. Then, we rewrite the second term using ${\\text{i}}^{2}=-1.$ Finally, we factor as a difference of squares.\n\n$$\n\\begin{aligned}25+9{m}^{2} & =25-(-9{m}^{2}) \\\\  & =25-(9{\\text{i}}^{2}{m}^{2}) \\\\  & ={5}^{2}-{(3\\text{i}m)}^{2} \\\\  & =(5+3\\text{i}m)(5-3\\text{i}m)\\end{aligned}\n$$\n\nFinally, substituting this back into the expression, we get\n\n$$\n-4(25+9{m}^{2})=-4(5+3\\text{i}m)(5-3\\text{i}m).\n$$"}] [{:db/id #edb/ref 17592186329785 :knowledge-point/_questions [{:db/id #edb/ref 17592186083248 :knowledge-point/id #uuid "b2478305-485c-53a6-9d6c-a72e0764dd4e" :knowledge-point/title "Finding a Quadratic Polynomial Given Two Real Roots and a Leading Coefficient"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2d53f205-3f13-5653-97f7-16a13fccb6b5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{t}^{2}-25" :db/id #edb/ref 17592186327333} {:answer/id #uuid "2e0027e4-9313-5ed2-941a-ed87cac9171d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4{t}^{2}+100" :db/id #edb/ref 17592186327346} {:answer/id #uuid "97aead54-9510-5fc5-aa9f-eeb7b75426e3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4{t}^{2}-25" :db/id #edb/ref 17592186328249} {:answer/id #uuid "bb42db12-58ef-5359-a1c1-28a86be9c910" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4{t}^{2}-100" :db/id #edb/ref 17592186328567} {:answer/id #uuid "cb0f7336-c824-5328-b9af-5399374350f9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{t}^{2}+25" :db/id #edb/ref 17592186328713}] :answer-field/correct {:answer/id #uuid "bb42db12-58ef-5359-a1c1-28a86be9c910" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4{t}^{2}-100" :db/id #edb/ref 17592186328567} :answer-field/id #uuid "9e7458a1-7227-5719-a279-7114bb1314ad" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186329449}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "5c80b75c-c4ac-520f-a68d-126d07fda083" :question/math-academy-id "q-46582" :question/problem "The quadratic polynomial $P(t)$ has roots ${t}_{1}=-5,{t}_{2}=5,$ and the coefficient of the quadratic term is $4.$ Find $P(t).$" :question/worked-solution "Since our quadratic polynomial has roots ${t}_{1}=-5$ and ${t}_{2}=5,$ and the coefficient of the quadratic term is $a=4,$ we can write the polynomial as follows:\n\n$$\n\\begin{aligned}a(t-{t}_{1})(t-{t}_{2}) & =(4)(t-(-5))(t-5) \\\\  & =4(t+5)(t-5)\\end{aligned}\n$$\n\nExpanding the parentheses, we obtain\n\n$$\n\\begin{aligned}4(t+5)(t-5) & =4({t}^{2}-25) \\\\  & =4{t}^{2}-100.\\end{aligned}\n$$\n\nTherefore, $P(t)=4{t}^{2}-100.$"}] [{:db/id #edb/ref 17592186329786 :knowledge-point/_questions [{:db/id #edb/ref 17592186083237 :knowledge-point/id #uuid "4b0262c8-c029-5a72-846b-1b4f4f3306ba" :knowledge-point/title "Finding a Quadratic Polynomial Given a Double Root and a Leading Coefficient"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "01e9cc2a-2e40-5eac-8225-9a3647af4013" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3{y}^{2}-18y-27" :db/id #edb/ref 17592186326953} {:answer/id #uuid "397d37fa-9c19-5957-8545-f3e9c8b2907e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3{y}^{2}-18y+27" :db/id #edb/ref 17592186327435} {:answer/id #uuid "6c86f783-35aa-5013-881b-97dcb72fefca" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3{y}^{2}-9y-27" :db/id #edb/ref 17592186327870} {:answer/id #uuid "bdba8a19-4868-5b73-b78a-b2f2642ee9f6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3{y}^{2}-9y+27" :db/id #edb/ref 17592186328591} {:answer/id #uuid "d9689658-04a0-54b7-9816-4e531d6a63dc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3{y}^{2}-24y+27" :db/id #edb/ref 17592186328834}] :answer-field/correct {:answer/id #uuid "397d37fa-9c19-5957-8545-f3e9c8b2907e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3{y}^{2}-18y+27" :db/id #edb/ref 17592186327435} :answer-field/id #uuid "2d4f3164-f7c0-5641-841e-102bb0a49284" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186329265}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "d6f211f1-c9b6-5172-aa3d-db8224b3a9c4" :question/math-academy-id "q-46588" :question/problem "The quadratic polynomial $P(y)$ has the double root ${y}_{1}={y}_{2}=3,$ and the coefficient of the quadratic term is $a=3.$ Find $P(y).$" :question/worked-solution "Since our quadratic polynomial has the double root ${y}_{1}={y}_{2}=3,$ and the coefficient of the quadratic term is $a=3,$ we can write the polynomial as follows:\n\n$$\n\\begin{aligned}a(y-{y}_{1})^{2} & =3{(y-3)}^{2}\\end{aligned}\n$$\n\nExpanding the parentheses, we obtain\n\n$$\n\\begin{aligned}3{(y-3)}^{2} & =3({y}^{2}-6y+9) \\\\  & =3{y}^{2}-18y+27.\\end{aligned}\n$$\n\nTherefore, $P(y)=3{y}^{2}-18y+27.$"}] [{:db/id #edb/ref 17592186329791 :knowledge-point/_questions [{:db/id #edb/ref 17592186083238 :knowledge-point/id #uuid "70c149d8-3739-564c-97c5-6636860ad0c4" :knowledge-point/title "Finding a Quadratic Polynomial Given Two Imaginary or Complex Roots"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0022c81d-7249-57ea-b85c-faca52fa725e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2{z}^{2}-12z-13" :db/id #edb/ref 17592186326934} {:answer/id #uuid "1c62967a-35b8-51ec-b618-768b175287e4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2{z}^{2}+12z-26" :db/id #edb/ref 17592186327179} {:answer/id #uuid "3f0e210e-e687-5df2-8531-30a91aae299d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2{z}^{2}+6z-13" :db/id #edb/ref 17592186327485} {:answer/id #uuid "80f269b1-70e4-5874-ac0d-1c99549a7558" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2{z}^{2}-6z+9" :db/id #edb/ref 17592186328046} {:answer/id #uuid "8cf7a053-7d48-5047-9768-06a394556fb8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2{z}^{2}+12z-5" :db/id #edb/ref 17592186328150}] :answer-field/correct {:answer/id #uuid "1c62967a-35b8-51ec-b618-768b175287e4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2{z}^{2}+12z-26" :db/id #edb/ref 17592186327179} :answer-field/id #uuid "f5ac5061-3c66-50a0-9298-0fb8d6af5746" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186329607}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "99f2b811-f0ad-5df2-9c8e-3f3014230013" :question/math-academy-id "q-46664" :question/problem "The quadratic polynomial $f(z)$ has real coefficients, has roots ${z}_{1}=3+2\\text{i}$ and ${z}_{2}=3-2\\text{i},$ and the coefficient of the quadratic term is $-2.$ Find $f(z).$" :question/worked-solution "Since our quadratic polynomial has roots ${z}_{1}=3+2\\text{i}$ and ${z}_{2}=3-2\\text{i},$ and the coefficient of the quadratic term is $a=-2,$ we can write the polynomial as follows:\n\n$$\n\\begin{aligned}a(z-{z}_{1})(z-{z}_{2}) & =(-2)(z-(3+2\\text{i}))(z-(3-2\\text{i}))\\end{aligned}\n$$\n\nExpanding the parentheses, we obtain\n\n$$\n\\begin{aligned}(-2)(z-(3+2\\text{i}))(z-(3-2\\text{i})) & =(-2)({z}^{2}-(3+2\\text{i})z-(3-2\\text{i})z+(3+2\\text{i})(3-2\\text{i})) \\\\  & =(-2)({z}^{2}-(3+2\\text{i}+3-2\\text{i})z+({3}^{2}-{2}^{2}{\\text{i}}^{2})) \\\\  & =(-2)({z}^{2}-6z+(9+4)) \\\\  & =-2{z}^{2}+12z-26.\\end{aligned}\n$$\n\nTherefore, $f(z)=-2{z}^{2}+12z-26.$"}] [{:db/id #edb/ref 17592186329792 :knowledge-point/_questions [{:db/id #edb/ref 17592186083238 :knowledge-point/id #uuid "70c149d8-3739-564c-97c5-6636860ad0c4" :knowledge-point/title "Finding a Quadratic Polynomial Given Two Imaginary or Complex Roots"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "43f2712e-bbf9-5d64-b4a4-19fa66e817ec" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2{v}^{2}-12v+50" :db/id #edb/ref 17592186327527} {:answer/id #uuid "7dea58a2-f43b-55a7-9363-8cbf0140d0fd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2{v}^{2}-6v+50" :db/id #edb/ref 17592186328021} {:answer/id #uuid "a6c61ffe-0e5e-5090-911a-89611958a46f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2{v}^{2}+8v-14" :db/id #edb/ref 17592186328382} {:answer/id #uuid "ee5b7e26-c574-59a3-b54b-9724ee8d1044" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2{v}^{2}-16v-14" :db/id #edb/ref 17592186329017} {:answer/id #uuid "ff80448e-3917-589d-a32d-f1e60b6bfd66" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2{v}^{2}+6v+25" :db/id #edb/ref 17592186329178}] :answer-field/correct {:answer/id #uuid "43f2712e-bbf9-5d64-b4a4-19fa66e817ec" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2{v}^{2}-12v+50" :db/id #edb/ref 17592186327527} :answer-field/id #uuid "92a83e02-7c9e-5529-ab3d-121fdc72ecd6" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186329430}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "af81e241-3fd9-5579-878e-052d0c216987" :question/math-academy-id "q-46669" :question/problem "The quadratic polynomial $f(v)$ has real coefficients, has roots ${v}_{1}=3+4\\text{i}$ and ${v}_{2}=3-4\\text{i},$ and the coefficient of the quadratic term is $2.$ Find $f(v).$" :question/worked-solution "Since our quadratic polynomial has roots ${v}_{1}=3+4\\text{i}$ and ${v}_{2}=3-4\\text{i},$ and the coefficient of the quadratic term is $a=2,$ we can write the polynomial as follows:\n\n$$\n\\begin{aligned}a(v-{v}_{1})(v-{v}_{2}) & =2(v-(3+4\\text{i}))(v-(3-4\\text{i}))\\end{aligned}\n$$\n\nExpanding the parentheses, we obtain\n\n$$\n\\begin{aligned}2(v-(3+4\\text{i}))(v-(3-4\\text{i})) & =2({v}^{2}-(3+4\\text{i})v-(3-4\\text{i})v+(3+4\\text{i})(3-4\\text{i})) \\\\  & =2({v}^{2}-(3+4\\text{i}+3-4\\text{i})v+({3}^{2}-{4}^{2}{\\text{i}}^{2})) \\\\  & =2({v}^{2}-6v+(9+16)) \\\\  & =2{v}^{2}-12v+50.\\end{aligned}\n$$\n\nTherefore, $f(v)=2{v}^{2}-12v+50.$"}] [{:db/id #edb/ref 17592186329795 :knowledge-point/_questions [{:db/id #edb/ref 17592186078557 :knowledge-point/id #uuid "045722b6-b558-522b-86e1-322c64e2848f" :knowledge-point/title "Calculating the Limit of a Rational Function with a Radical in the Denominator"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0801cf1c-5fd2-5cc2-8874-bb033ff63b06" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{4}" :db/id #edb/ref 17592186326999} {:answer/id #uuid "21618e1a-d4b1-5642-ac4b-4adec6bcb616" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\infty " :db/id #edb/ref 17592186327222} {:answer/id #uuid "2a3ed060-8f3d-5e5f-a548-ad4adb40f6c7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186327301} {:answer/id #uuid "3f5696e8-74ce-57d4-98a1-81edbd390bcf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186327489} {:answer/id #uuid "9d7d71e6-17cd-53a0-9ad8-987841eae685" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\text{DNE}" :db/id #edb/ref 17592186328296}] :answer-field/correct {:answer/id #uuid "2a3ed060-8f3d-5e5f-a548-ad4adb40f6c7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186327301} :answer-field/id #uuid "914d0201-289f-570f-b5ca-55e4260ae1f3" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186329425}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "005f9ab9-467f-5576-9116-815c97776952" :question/math-academy-id "q-46830" :question/problem "Evaluate ${lim}_{x\\to {4}^{+}}\\frac{x-4}{\\sqrt{3x-3}-3}.$" :question/worked-solution "If we attempt to evaluate the limit by simply evaluating the function at $x=4$, we get an indeterminate form:\n\n$$\n\\begin{aligned}{lim}_{x\\to {4}^{+}}\\frac{x-4}{\\sqrt{3x-3}-3} & =\\frac{4-4}{\\sqrt{3(4)-3}-3}=\\frac{0}{0}\\end{aligned}\n$$\n\nSo, we need to first simplify the limit. Since the radical is in the denominator, we can multiply the numerator and the denominator by the conjugate of the denominator. We get\n\n$$\n\\begin{aligned}{lim}_{x\\to {4}^{+}}\\frac{x-4}{\\sqrt{3x-3}-3} & ={lim}_{x\\to {4}^{+}}\\frac{(x-4)(\\sqrt{3x-3}+3)}{(\\sqrt{3x-3}-3)(\\sqrt{3x-3}+3)} \\\\  & ={lim}_{x\\to {4}^{+}}\\frac{(x-4)(\\sqrt{3x-3}+3)}{{(\\sqrt{3x-3})}^{2}-{3}^{2}} \\\\  & ={lim}_{x\\to {4}^{+}}\\frac{(x-4)(\\sqrt{3x-3}+3)}{3x-3-9} \\\\  & ={lim}_{x\\to {4}^{+}}\\frac{(x-4)(\\sqrt{3x-3}+3)}{3x-12} \\\\  & ={lim}_{x\\to {4}^{+}}\\frac{(x-4)(\\sqrt{3x-3}+3)}{3(x-4)} \\\\  & ={lim}_{x\\to {4}^{+}}\\frac{\\sqrt{3x-3}+3}{3} \\\\  & =\\frac{\\sqrt{3(4)-3}+3}{3} \\\\  & =\\frac{3+3}{3} \\\\  & =2.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186329796 :knowledge-point/_questions [{:db/id #edb/ref 17592186078536 :knowledge-point/id #uuid "a441c8ef-b5b3-5438-97b9-53e4eb7b2d75" :knowledge-point/title "Calculating the Limit of a Rational Function with a Radical in the Numerator"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0f3b50a7-1a31-52bc-91a4-f6b268955f83" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\infty " :db/id #edb/ref 17592186327070} {:answer/id #uuid "10710463-0db1-5838-be7b-4f17aca898c1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{8}" :db/id #edb/ref 17592186327081} {:answer/id #uuid "196dae27-2242-5069-9416-9d2435e009f6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{24}" :db/id #edb/ref 17592186327154} {:answer/id #uuid "519f1ddd-7a1e-5d1a-a24e-d9445baa5f01" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{16}" :db/id #edb/ref 17592186327645} {:answer/id #uuid "fe2ff551-9a15-5bb4-987f-b343fdf4c92b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\text{DNE}" :db/id #edb/ref 17592186329168}] :answer-field/correct {:answer/id #uuid "519f1ddd-7a1e-5d1a-a24e-d9445baa5f01" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{16}" :db/id #edb/ref 17592186327645} :answer-field/id #uuid "3556b158-4519-5e67-be7a-f8d92924db68" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186329288}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "83a2f35e-6a3d-5f89-a27d-35edfe302559" :question/math-academy-id "q-46831" :question/problem "Evaluate ${lim}_{x\\to 2}\\frac{\\sqrt{x+2}-2}{{x}^{2}-4}.$" :question/worked-solution "If we attempt to evaluate the limit, we get an indeterminate form:\n\n$$\n\\begin{aligned}{lim}_{x\\to 2}\\frac{\\sqrt{x+2}-2}{{x}^{2}-4} & =\\frac{\\sqrt{2+2}-2}{{2}^{2}-4}=\\frac{0}{0}\\end{aligned}\n$$\n\nSo, we need to first simplify the limit. Since the radical is in the numerator, we can multiply the numerator and the denominator by the conjugate of the numerator. We get\n\n$$\n\\begin{aligned}{lim}_{x\\to 2}\\frac{\\sqrt{x+2}-2}{{x}^{2}-4} & ={lim}_{x\\to 2}\\frac{\\sqrt{x+2}-2}{(x-2)(x+2)} \\\\  & ={lim}_{x\\to 2}\\frac{(\\sqrt{x+2}-2)(\\sqrt{x+2}+2)}{(x-2)(x+2)(\\sqrt{x+2}+2)} \\\\  & ={lim}_{x\\to 2}\\frac{{(\\sqrt{x+2})}^{2}-{2}^{2}}{(x-2)(x+2)(\\sqrt{x+2}+2)} \\\\  & ={lim}_{x\\to 2}\\frac{x+2-4}{(x-2)(x+2)(\\sqrt{x+2}+2)} \\\\  & ={lim}_{x\\to 2}\\frac{x-2}{(x-2)(x+2)(\\sqrt{x+2}+2)} \\\\  & ={lim}_{x\\to 2}\\frac{1}{(x+2)(\\sqrt{x+2}+2)} \\\\  & =\\frac{1}{(2+2)(\\sqrt{2+2}+2)} \\\\  & =\\frac{1}{16}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186329802 :knowledge-point/_questions [{:db/id #edb/ref 17592186124671 :knowledge-point/id #uuid "e37b91f0-ea0a-58b0-98d0-8f3626578dd6" :knowledge-point/title "Computing the Limit of Cotangent Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3552e823-ed7e-5411-8a4d-a7a161d920bc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\infty " :db/id #edb/ref 17592186327395} {:answer/id #uuid "3f22fb2d-15a6-595d-8e20-54b09e482167" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\text{DNE}" :db/id #edb/ref 17592186327487} {:answer/id #uuid "6874f84d-9c2d-5c6c-8e62-74ddd0d5cfc7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186327835} {:answer/id #uuid "7b8ddd5a-8d1e-5b11-a6bc-864708f334f9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\infty " :db/id #edb/ref 17592186327996} {:answer/id #uuid "bc89a2bc-ead2-5238-9aae-15a92a90fa81" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186328574}] :answer-field/correct {:answer/id #uuid "3f22fb2d-15a6-595d-8e20-54b09e482167" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\text{DNE}" :db/id #edb/ref 17592186327487} :answer-field/id #uuid "10bd8af9-359c-5678-a39c-41fc93bcc176" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186329211}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "5898d1b3-7352-5733-948f-e0e93cd0becf" :question/math-academy-id "q-47039" :question/problem "Calculate ${lim}_{x\\to \\pi }\\operatorname{cot}⁡x.$" :question/worked-solution "First, let's attempt to evaluate the limit by direct substitution:\n\n$$\n\\begin{aligned}{lim}_{x\\to \\pi }\\operatorname{cot}⁡(x) & =\\operatorname{cot}⁡(\\pi ) \\\\  & =\\frac{\\operatorname{cos}⁡\\pi }{\\operatorname{sin}⁡\\pi } \\\\  & =\\frac{-1}{0},\\end{aligned}\n$$\n\nwhich is undefined.\n\nTherefore, to find the limit, let's sketch the graph of $y=\\operatorname{cot}⁡(x).$\n\n![](images/5e/5e9d0e9d944cda9c97555ffdeac5aa245905f800cd99e11f5d172203bad3892d.png)\n\nAs $x$ approaches $\\pi $ from the left, the values of $y=\\operatorname{cot}⁡(x)$ are negative and decrease without bound. Therefore\n\n$$\n{lim}_{x\\to {\\pi }^{-}}\\operatorname{cot}⁡(x)=-\\infty \n$$\n\nHowever, as $x$ approaches $\\pi $ from the right, the values of $y=\\operatorname{cot}⁡(x)$ are positive and grow without bound. Therefore\n\n$$\n{lim}_{x\\to {\\pi }^{+}}\\operatorname{cot}⁡(x)=\\infty \n$$\n\nSince the two limits are not equal, we conclude that\n\n$$\n{lim}_{x\\to \\pi }\\operatorname{cot}⁡(x)=\\text{DNE}.\n$$"}] [{:db/id #edb/ref 17592186329806 :knowledge-point/_questions [{:db/id #edb/ref 17592186115372 :knowledge-point/id #uuid "6835b52b-adaa-5c66-9f6d-d32591864659" :knowledge-point/title "Evaluating Infinite Limits Using the Laws of Exponents and the Algebra of Limits"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "17028eac-4ec5-5412-a437-179e2341db73" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\infty " :db/id #edb/ref 17592186327136} {:answer/id #uuid "699925f0-6e8c-5f1a-b77d-e1c6f323fb8f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186327842} {:answer/id #uuid "aa0370f2-56b3-5cc8-a52d-9b4a98865995" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\text{DNE}" :db/id #edb/ref 17592186328406} {:answer/id #uuid "cdfe3a0e-970e-5bb9-8a35-e018230647f4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186328745} {:answer/id #uuid "f5621511-1f8d-5799-9acc-c62ea19974de" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\infty " :db/id #edb/ref 17592186329079}] :answer-field/correct {:answer/id #uuid "cdfe3a0e-970e-5bb9-8a35-e018230647f4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186328745} :answer-field/id #uuid "1f990210-b8a8-5e34-9486-0ad7ae987df5" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186329237}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "66cb54a9-7be0-554a-a6fe-eb1aaa1b6f8b" :question/math-academy-id "q-47073" :question/problem "${lim}_{x\\to -\\infty }{2}^{3x-8}=$" :question/worked-solution "We can use the laws of exponents and the algebra of limits to rewrite the given limit, as follows:\n\n$$\n\\begin{aligned}{lim}_{x\\to -\\infty }{2}^{3x-8} & ={lim}_{x\\to -\\infty }{2}^{3x}\\cdot {2}^{-8} \\\\  & ={lim}_{x\\to -\\infty }{({2}^{3})}^{x}\\cdot {2}^{-8} \\\\  & ={lim}_{x\\to -\\infty }{8}^{x}\\cdot (\\frac{1}{256}) \\\\  & =(\\frac{1}{256})\\cdot {lim}_{x\\to -\\infty }{8}^{x}\\end{aligned}\n$$\n\nNext, we recall the graph of $y={8}^{x}.$\n\n![](images/85/85319605a7c7b57d4c7ed29b8d409e3169f3331775580b91b70e2be99fef7986.png)\n\nFrom the graph, we see that the function decreases to zero as $x$ decreases. Therefore,\n\n$$\n{lim}_{x\\to -\\infty }{8}^{x}=0.\n$$\n\nSo, we conclude that \n\n$$\n(\\frac{1}{256})\\cdot {lim}_{x\\to -\\infty }{8}^{x}=(\\frac{1}{256})\\cdot 0=0\n$$"}] [{:db/id #edb/ref 17592186392582 :knowledge-point/_questions [{:db/id #edb/ref 17592186092240 :knowledge-point/id #uuid "55a323ba-f2a7-5a49-abd4-a9812518ef8c" :knowledge-point/title "Determining the Equation of a Normal Line to a Curve at a Point"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "10131252-4695-56ed-8c59-747e545f594c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "71" :db/id #edb/ref 17592186392584} {:answer/id #uuid "e6984861-e3cb-5365-9e9e-1ecd4311dcb8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "61" :db/id #edb/ref 17592186392585} {:answer/id #uuid "859687f9-c59b-551f-aaa5-e7e3c04ba6c0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-81" :db/id #edb/ref 17592186392586} {:answer/id #uuid "95424aa7-6153-5c48-9071-e6e5ac4c3b4c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "81" :db/id #edb/ref 17592186392587} {:answer/id #uuid "41016988-d005-506a-b687-2940e1c88cd8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-71" :db/id #edb/ref 17592186392588}] :answer-field/correct {:answer/id #uuid "95424aa7-6153-5c48-9071-e6e5ac4c3b4c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "81" :db/id #edb/ref 17592186392587} :answer-field/id #uuid "c9549a2f-75a6-5fa7-b3e3-19c27b3b484f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186392583}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "414ee72f-747c-573a-9cad-a9cbdad6101a" :question/math-academy-id "q-47410" :question/problem "The equation of the normal line to the curve $y=3{x}^{2}+4x$ at the point $(1,7)$ is given by $x+py=q$ where $p$ and $q$ are constants. Find the value of $p+q.$" :question/worked-solution "Let $f(x)=3{x}^{2}+4x.$ First, we compute the derivative:\n\n$$\n\\begin{aligned}{f}^{′}(x)=\\frac{\\text{d}}{\\text{d}x}(3{x}^{2}+4x)=6x+4\\end{aligned}\n$$\n\nThen, we compute the slope of the tangent at the point $(1,7):$\n\n$$\n\\begin{aligned}m={f}^{′}(1)=6(1)+4=10\\end{aligned}\n$$\n\nTherefore, the slope of the normal line ${m}^{′}$ is\n\n$$\n{m}^{′}=-\\frac{1}{m}=-\\frac{1}{10}.\n$$\n\nFinally, the equation of the normal line is\n\n$$\n\\begin{aligned}y-(7) & =-\\frac{1}{10}(x-1) \\\\ 10y-70 & =-x+1 \\\\ x+10y & =71.\\end{aligned}\n$$\n\nTherefore, $p+q=10+71=81.$"}] [{:db/id #edb/ref 17592186329815 :knowledge-point/_questions [{:db/id #edb/ref 17592186092384 :knowledge-point/id #uuid "4a05f6c0-98ab-5197-922e-8e8dff1d4302" :knowledge-point/title "Calculating the Slope of a Normal Line to a Curve at a Point"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "298a6c80-4207-50f6-8a34-1d93a5f89fed" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{3}" :db/id #edb/ref 17592186327287} {:answer/id #uuid "307e57c3-1572-5e33-a5f9-3472b90bf91f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186327363} {:answer/id #uuid "e1ee7da7-a08a-5f34-86ea-f3f106a5f98c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186328912} {:answer/id #uuid "e33c1589-993a-5e15-9743-78a5a9f95009" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{2}" :db/id #edb/ref 17592186328926} {:answer/id #uuid "fb9c839b-8755-5fd8-b8d8-b4929a06d14c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{3}" :db/id #edb/ref 17592186329142}] :answer-field/correct {:answer/id #uuid "fb9c839b-8755-5fd8-b8d8-b4929a06d14c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{3}" :db/id #edb/ref 17592186329142} :answer-field/id #uuid "197f2e71-4c00-5a81-830b-269b6b29fd90" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186329228}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "704dafc6-9839-55e3-9683-dc5e275270d6" :question/math-academy-id "q-47449" :question/problem "Find the slope of the normal line to the curve $y={x}^{2}+x$ at the point $(1,2).$" :question/worked-solution "Let $f(x)={x}^{2}+x.$ First, we compute the derivative:\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}({x}^{2}+x) \\\\  & =2x+1\\end{aligned}\n$$\n\nThen, we compute the slope of the tangent at the point $(1,2):$\n\n$$\nm={f}^{′}(1)=2(1)+1=3\n$$\n\nTherefore, the slope of the normal line ${m}^{′}$ is\n\n$$\n{m}^{′}=-\\frac{1}{m}=-\\frac{1}{3}.\n$$"}] [{:db/id #edb/ref 17592186329816 :knowledge-point/_questions [{:db/id #edb/ref 17592186176051 :knowledge-point/id #uuid "0e2a8cf2-64db-5b2f-b0f7-0c727cf492a9" :knowledge-point/title "Describing Properties of the Secant Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "029e14a6-a3da-5d56-bd50-24aa3841ff59" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II" :db/id #edb/ref 17592186326964} {:answer/id #uuid "09838c12-324b-5f86-b8eb-b9a50a5b99f2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186327012} {:answer/id #uuid "58d2b82d-ca43-5016-b810-dc807085c710" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186327713} {:answer/id #uuid "d9fe1f38-597e-53c5-aa82-041838d9bba1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III" :db/id #edb/ref 17592186328838} {:answer/id #uuid "ed61f5fa-bf44-559a-b259-d059d2ed706f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186329011}] :answer-field/correct {:answer/id #uuid "ed61f5fa-bf44-559a-b259-d059d2ed706f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186329011} :answer-field/id #uuid "dc0b4dd2-5359-5754-b6be-a086a2742846" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186329570}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "4ce070dc-f77b-529a-a508-4630f3613570" :question/math-academy-id "q-47455" :question/problem "Which of the following statements are true regarding the function $y=sec⁡x?$\n\n- The period of the function is $\\pi .$\n- The function is increasing in the interval $(-\\frac{\\pi }{2},0].$\n- The function has no zeros." :question/worked-solution "Let's plot the graph of $y=sec⁡x.$\n\n![](images/77/779d7a31646a229492a8165c8212a5c83ad7d37d843c1c1b3b36766a74bc5124.png)\n\nLet's go through each statement.\n\n- Statement I is false. The period of the function is $2\\pi .$\n\n- Statement II is false. The function $y=sec⁡x$ is decreasing on $(-\\frac{\\pi }{2},0].$\n\n- Statement III is true. The function has no zeros."}] [{:db/id #edb/ref 17592186115883 :knowledge-point/_questions [{:db/id #edb/ref 17592186115382 :knowledge-point/id #uuid "7dcbd56f-0fc2-59c5-a016-4272be4734c7" :knowledge-point/title "Determining the Points at Which a Function is Not Differentiable"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "814a3015-040d-5d38-8d89-66e613ea9c28" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$x =-2$, $x = 0$, and $x = 2$" :db/id #edb/ref 17592186114236} {:answer/id #uuid "bbc4ca4a-1ffc-505e-9c15-eada8368fb5c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$x = 2$ only" :db/id #edb/ref 17592186114237} {:answer/id #uuid "c9f356c3-5dd2-587a-aa58-7ab4bc07f2f0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$x =-2$ only" :db/id #edb/ref 17592186114238} {:answer/id #uuid "cd84e69a-febf-59d0-8ce5-b1b9373d8954" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$x = 0$ only" :db/id #edb/ref 17592186114239} {:answer/id #uuid "551564d0-36a1-5e6f-a7f1-ebd7c47f4f37" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$x =-2$ and $x = 2$ only" :db/id #edb/ref 17592186114240}] :answer-field/id #uuid "3caeafb3-6b65-5977-a595-ae7d734d711e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186114235} {:answer-field/choices [{:answer/id #uuid "6f7c45a8-6d0f-5a1d-b8dc-4e8e1b4b6ce1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$x=2$ only" :db/id #edb/ref 17592186396662} {:answer/id #uuid "f7475fa2-2dfb-5ab6-af30-4b6beda786d6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$x=-2$ and $x=2$ only" :db/id #edb/ref 17592186396663} {:answer/id #uuid "1541152a-7611-5c14-a588-d1e5cc5e22df" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$x=-2$, $x=0$, and $x=2$" :db/id #edb/ref 17592186396664} {:answer/id #uuid "453cb038-db89-5863-98ef-ba1dcdd04c12" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$x=0$ only" :db/id #edb/ref 17592186396665} {:answer/id #uuid "edc154f2-6797-5d5a-be28-0f6a1f59d668" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$x=-2$ only" :db/id #edb/ref 17592186396666}] :answer-field/correct {:answer/id #uuid "1541152a-7611-5c14-a588-d1e5cc5e22df" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$x=-2$, $x=0$, and $x=2$" :db/id #edb/ref 17592186396664} :answer-field/id #uuid "71e2164a-d23d-528c-85fa-147024e56737" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186396661}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "097f3e11-2ce8-55f7-bbfa-1640ee282b68" :question/math-academy-id "q-47650" :question/problem "![](images/8e/8e7daf95fadbe2262a09e8183f00d63075655f3b97dd363984c192ac3414ad17.png)\n\nConsider the function $y=f(x)$ whose graph is plotted above. At which points is the function $f(x)$ **not** differentiable?" :question/worked-solution "The function is not differentiable wherever it has a discontinuity, corner, cusp, or vertical tangent.\n\n- At $x=-2$ the function has a cusp, so it's not differentiable there.\n\n- At $x=0$ the function has a jump discontinuity, so it's not differentiable there.\n\n- At $x=2$ the function has an infinite discontinuity, so it's not differentiable there.\n\nTherefore, the correct answer is $x=-2$, $x=0$, and $x=2.$"}] [{:db/id #edb/ref 17592186115885 :knowledge-point/_questions [{:db/id #edb/ref 17592186115382 :knowledge-point/id #uuid "7dcbd56f-0fc2-59c5-a016-4272be4734c7" :knowledge-point/title "Determining the Points at Which a Function is Not Differentiable"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "bf6e8497-4669-5084-9732-38c2fbe4d251" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/cf/cf9beb1c95dc2d69b430a47be217b98b81bec65c3370099397ab70672f8cbe54.png" :db/id #edb/ref 17592186114248} {:answer/id #uuid "d8f2438d-6d60-5115-af40-26ada984c0e9" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/1e/1ef7e9ce0d1db1e60721d5f44b094d23091fd42b02b3b93832f4b17523241c87.png" :db/id #edb/ref 17592186114249} {:answer/id #uuid "36d333d5-7a67-54ef-91f8-131a778f0daa" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/bf/bf943c2d6f9281c62f82712485bce8ab06b7312e8156baf0b961e858e0f28ea6.png" :db/id #edb/ref 17592186114250} {:answer/id #uuid "4d064a0e-8c94-5a25-be42-711ce4c45961" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/8e/8e9b1f8848e09eb936116d39dc72b9d15bded2426b2e4de23f88e257cbe9d46f.png" :db/id #edb/ref 17592186114251} {:answer/id #uuid "7ae424b3-cbc6-57db-ad88-a9fc93750070" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/d2/d297db86c650af71f2d116f65470aa46445aceede8f81462e22e1becb284736a.png" :db/id #edb/ref 17592186114252}] :answer-field/id #uuid "0c90a9f6-9f64-5438-bbf5-7a3d896f8873" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186114247} {:answer-field/choices [{:answer/id #uuid "36bac047-eabf-53d8-9e97-1e6ace55c083" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/cf/cf9beb1c95dc2d69b430a47be217b98b81bec65c3370099397ab70672f8cbe54.png" :db/id #edb/ref 17592186392590} {:answer/id #uuid "04671946-230b-5e70-8f2c-ff566e8b3b34" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/d2/d297db86c650af71f2d116f65470aa46445aceede8f81462e22e1becb284736a.png" :db/id #edb/ref 17592186392591} {:answer/id #uuid "b8e33187-d6c4-5fbc-b100-c663848334e6" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/bf/bf943c2d6f9281c62f82712485bce8ab06b7312e8156baf0b961e858e0f28ea6.png" :db/id #edb/ref 17592186392592} {:answer/id #uuid "218adc50-a59c-5ded-a9cc-466c8124d139" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/1e/1ef7e9ce0d1db1e60721d5f44b094d23091fd42b02b3b93832f4b17523241c87.png" :db/id #edb/ref 17592186392593} {:answer/id #uuid "8bee35bf-0fbc-59b3-ad02-d3fba93e60a8" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/8e/8e9b1f8848e09eb936116d39dc72b9d15bded2426b2e4de23f88e257cbe9d46f.png" :db/id #edb/ref 17592186392594}] :answer-field/correct {:answer/id #uuid "04671946-230b-5e70-8f2c-ff566e8b3b34" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/d2/d297db86c650af71f2d116f65470aa46445aceede8f81462e22e1becb284736a.png" :db/id #edb/ref 17592186392591} :answer-field/id #uuid "36fddb3c-5df5-5efe-9d09-31fdd773672d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186392589}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "d2d358ee-4f00-5039-8abe-a47808bd6f20" :question/math-academy-id "q-47669" :question/problem "Which of the following functions is not differentiable over the entire interval $x\\in (-1,1)$ due to the existence of a vertical tangent in the interval?" :question/worked-solution "Notice that the function $y=h(x)$ has a vertical tangent at $x=0$ and is therefore not differentiable at $x=0.$ \nTherefore, the correct answer is $y=h(x).$\n\nThe other graphs do not have a vertical tangent inside the interval $(-1,1).$\n\n- The function $y=f(x)$ has a corner point at $x=0.$\n\n- The function $y=g(x)$ is smooth and continuous over the entire interval $x\\in (-1,1).$\n\n- The functions $y=p(x)$ and $y=q(x)$ are not defined at $x=0.$"}] [{:db/id #edb/ref 17592186329826 :knowledge-point/_questions [{:db/id #edb/ref 17592186115381 :knowledge-point/id #uuid "1b4100f8-8a66-5243-b0b6-c36b9d17dac3" :knowledge-point/title "Determining Which Functions are Differentiable at a Given Point From the Function Expressions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "20ac00fa-c573-50b2-9181-c5c47c436adb" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186327214} {:answer/id #uuid "6664d395-2cd4-57fa-8267-dad7b7f6653c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186327822} {:answer/id #uuid "ad7699cf-1310-5e2c-8483-50775b4a0f7d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186328441} {:answer/id #uuid "c8d74407-8722-5f57-a238-174a8da68bde" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186328700} {:answer/id #uuid "cf91c4ec-315b-5bb2-ba9b-e695b2ead9ad" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186328760}] :answer-field/correct {:answer/id #uuid "6664d395-2cd4-57fa-8267-dad7b7f6653c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186327822} :answer-field/id #uuid "01e41401-65d6-5b8b-a09b-c7db46fa5956" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186329187}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "8298d153-fa1d-58c6-bfcd-efab6041f9f0" :question/math-academy-id "q-47681" :question/problem "Which of the following statements are true regarding the function given below?\n\n$$\nf(x)={\\begin{aligned}{x}^{3}+1, & x\\ne 1 \\\\ 3, & x=1\\end{aligned}\\,\n$$\n\n- It is continuous and differentiable at $x=1$\n- It is **not** differentiable at $x=1$\n- It is differentiable on the interval $(-1,2)$" :question/worked-solution "Let's analyze each statement individually. \n\n- Statement I is false.  At $x=1$, we have \n\n$$\n\\begin{aligned}{lim}_{x\\to {1}^{+}}f(x) & ={lim}_{x\\to {1}^{+}}({x}^{3}+1)={1}^{3}+1=2 \\\\ {lim}_{x\\to {1}^{-}}f(x) & ={lim}_{x\\to {1}^{-}}({x}^{3}+1)={1}^{3}+1=2.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n{lim}_{x\\to {1}^{+}}f(x)={lim}_{x\\to {1}^{-}}f(x)\\ne f(1)=3,\n$$\n\nand so $f(x)$ is not continuous at $x=1$ ($f(x)$ has a removable discontinuity at $x=1$).\n\n- Statement II is true. Since  $f(x)$ is not continuous at $x=1,$ it is also not differentiable there (because differentiability implies continuity).\n\n- Statement III is false. Since $f(x)$ is not differentiable at $x=1,$ it is not differentiable on any interval containing this point. Consequently, it is not differentiable on $(-1,2).$\n\nTherefore, only statement II is true."}] [{:db/id #edb/ref 17592186329835 :knowledge-point/_questions [{:db/id #edb/ref 17592186119954 :knowledge-point/id #uuid "744b0e69-71f9-5ca0-a200-8968a9ec192e" :knowledge-point/title "Determining Vertical Asymptotes of a Rational Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "29a0fc8a-86ac-5ab6-acd1-3ec0072b7256" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=-2" :db/id #edb/ref 17592186327288} {:answer/id #uuid "b4bd35f1-1cf5-5986-8bcd-cae0e1e256a0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=\\sqrt{2}" :db/id #edb/ref 17592186328506} {:answer/id #uuid "e6a685ba-076b-591a-b200-e9ee6e74f0b0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=2" :db/id #edb/ref 17592186328951} {:answer/id #uuid "f1f4c678-2ef4-5109-bc2c-e164d61c301e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=5" :db/id #edb/ref 17592186329047} {:answer/id #uuid "f598a74d-ecb1-5d47-9ac6-e6464cddea05" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "There are no vertical asymptotes." :db/id #edb/ref 17592186329083}] :answer-field/correct {:answer/id #uuid "b4bd35f1-1cf5-5986-8bcd-cae0e1e256a0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=\\sqrt{2}" :db/id #edb/ref 17592186328506} :answer-field/id #uuid "5859fa75-27d1-5a4e-9275-4eb9c181d62a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186329341}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "e2ba45bb-fcdc-536e-a19c-0143c96613a0" :question/math-academy-id "q-47854" :question/problem "Find the vertical asymptotes of $y=f(x)=\\frac{5}{x-\\sqrt{2}}.$" :question/worked-solution "There are no common factors in the numerator and denominator. So, we find the vertical asymptotes by setting the denominator equal to zero:\n\n$$\nx-\\sqrt{2}=0\\,⟹\\,x=\\sqrt{2}.\n$$\n\nConsequently, $x=\\sqrt{2}$ is the only vertical asymptote of $y=f(x),$ as shown below. \n\n![](images/09/09c19a6049d77a2b57c093ca714627a453c99bf52af27ae656ad1f4e779d1866.png)"}] [{:db/id #edb/ref 17592186402909 :knowledge-point/_questions [{:db/id #edb/ref 17592186064162 :knowledge-point/id #uuid "a595bc07-ad64-537d-be42-06144814b97d" :knowledge-point/title "Identifying Extrema of a Function Given Its Graph"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5af784ce-3cef-5945-8932-b03fe43316e6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$A$ and $C$ only" :db/id #edb/ref 17592186402911} {:answer/id #uuid "9673d400-5f29-5ce5-b5e9-8047de8eb008" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$B$ and $D$ only" :db/id #edb/ref 17592186402912} {:answer/id #uuid "eb5c6830-b8b8-54b9-9b05-279cc0d24408" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$B$ and $C$ only" :db/id #edb/ref 17592186402913} {:answer/id #uuid "f088b713-a43a-50e7-9574-07ac077ab3d9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$C$ only" :db/id #edb/ref 17592186402914} {:answer/id #uuid "62bbee0f-e18c-5110-a2d4-144a718f657e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$B$ only" :db/id #edb/ref 17592186402915}] :answer-field/correct {:answer/id #uuid "9673d400-5f29-5ce5-b5e9-8047de8eb008" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$B$ and $D$ only" :db/id #edb/ref 17592186402912} :answer-field/id #uuid "01f254e3-3027-52e3-8cb7-edd707cacbbe" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186402910}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "62b39803-cf8b-5f2a-91f9-b83f48f12d0e" :question/math-academy-id "q-47919" :question/problem "![](images/d9/d9d8fb6d663d8dfd0cce24ae3817c936e2e97ab2df7aefeaa0c734caf0311b94.png)\n\nThe graph of $y=f(x)$ is plotted above. Given that $f(x)$ is defined on the interval $x\\in [-3,10]$, which points represent the global maximum of $f(x)?$" :question/worked-solution "The global extrema of a function are the lowest or highest points of the function's graph over its entire domain.\n\nThe lowest point is the global minimum, whereas the highest point is the global maximum.\n\nAccording to the graph, the highest points are $B$ and $D$, and so these points represents the global maximum of $f(x).$"}] [{:db/id #edb/ref 17592186329841 :knowledge-point/_questions [{:db/id #edb/ref 17592186096621 :knowledge-point/id #uuid "3c547746-49c8-5a4a-85fe-c6b75493a354" :knowledge-point/title "Differentiating a Quotient Containing Other Functions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "24cdb15d-92a4-57bb-b3ae-70ee6398efed" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{e}^{x}sin⁡x-cos⁡x}{{sin}^{2}⁡x}" :db/id #edb/ref 17592186327252} {:answer/id #uuid "28cffc72-f500-56eb-b62d-297789e3d352" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{e}^{x}(cos⁡x+sin⁡x)}{{cos}^{2}⁡x}" :db/id #edb/ref 17592186327280} {:answer/id #uuid "537f4f22-dc76-5ecc-941c-28735a7fbb3e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{e}^{x}sin⁡x-cos⁡x}{{cos}^{2}⁡x}" :db/id #edb/ref 17592186327658} {:answer/id #uuid "6cb04a5b-8198-547f-9f85-6d03684ff103" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{e}^{x}(sin⁡x-cos⁡x)}{cos⁡x}" :db/id #edb/ref 17592186327873} {:answer/id #uuid "6ebf154b-78ed-5323-9bc6-5af4e4ce0e17" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{e}^{x}(sin⁡x-cos⁡x)}{{cos}^{2}⁡x}" :db/id #edb/ref 17592186327893}] :answer-field/correct {:answer/id #uuid "28cffc72-f500-56eb-b62d-297789e3d352" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{e}^{x}(cos⁡x+sin⁡x)}{{cos}^{2}⁡x}" :db/id #edb/ref 17592186327280} :answer-field/id #uuid "1139e71c-df1c-5f00-8bad-e71886ea7ae5" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186329215}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "5ace0fb1-1a71-5cfd-952c-d11857b972c9" :question/math-academy-id "q-47943" :question/problem "If $f(x)=\\frac{{e}^{x}}{cos⁡x},$ find ${f}^{′}(x).$" :question/worked-solution "In this case, the expression for $f(x)$ is a quotient $\\frac{u(x)}{v(x)}$ with $u(x)={e}^{x}$ and $v(x)=cos⁡x.$ \n\nTherefore, we apply the quotient rule as follows:\n\n$$\n\\begin{aligned}\\begin{aligned}{f}^{′}(x) & =\\frac{{u}^{′}(x)\\cdot v(x)-u(x)\\cdot {v}^{′}(x)}{[v(x)]^{2}} \\\\  & =\\frac{({e}^{x})^{′}\\cdot cos⁡x-{e}^{x}\\cdot (cos⁡x)^{′}}{(cos⁡x)^{2}} \\\\  & =\\frac{{e}^{x}cos⁡x+{e}^{x}sin⁡x}{(cos⁡x)^{2}} \\\\  & =\\frac{{e}^{x}(cos⁡x+sin⁡x)}{{cos}^{2}⁡x}\\end{aligned}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186329845 :knowledge-point/_questions [{:db/id #edb/ref 17592186059676 :knowledge-point/id #uuid "711f198b-26b4-5185-812a-102329d49313" :knowledge-point/title "Finding the Derivative of an Expression With the Tangent Trigonometric Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "026a56b8-1115-5684-ac6e-ef1630e64970" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1+\\sqrt{x}{sec}^{2}⁡x}{2\\sqrt{x}}" :db/id #edb/ref 17592186326960} {:answer/id #uuid "0393bd6c-c00c-5794-bb05-1c8299be09b2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1+2{sec}^{2}⁡\\sqrt{x}}{2\\sqrt{x}}" :db/id #edb/ref 17592186326972} {:answer/id #uuid "25ff194a-cfcd-58a0-adba-8bc91fdf1efe" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1+2x{sec}^{2}⁡x}{2\\sqrt{x}}" :db/id #edb/ref 17592186327262} {:answer/id #uuid "44d191be-38a4-500e-8cfb-76a9d83fe2e6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1+2\\sqrt{x}sec⁡x}{2\\sqrt{x}}" :db/id #edb/ref 17592186327534} {:answer/id #uuid "9336f84c-bb60-54b1-ba79-495700d341f9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1+2\\sqrt{x}{sec}^{2}⁡x}{2\\sqrt{x}}" :db/id #edb/ref 17592186328218}] :answer-field/correct {:answer/id #uuid "9336f84c-bb60-54b1-ba79-495700d341f9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1+2\\sqrt{x}{sec}^{2}⁡x}{2\\sqrt{x}}" :db/id #edb/ref 17592186328218} :answer-field/id #uuid "39c98579-7ff9-5677-8870-c03daabb35df" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186329297}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "db3973ed-197d-5377-b8db-60e027e16ad0" :question/math-academy-id "q-47983" :question/problem "Find the derivative of $y=\\sqrt{x}+tan⁡x.$" :question/worked-solution "We know that $\\frac{\\text{d}}{\\text{d}x}(tan⁡x)={sec}^{2}⁡x.$ Applying this formula, we have\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}}{\\text{d}x}(\\sqrt{x}+tan⁡x) \\\\  & =\\frac{1}{2\\sqrt{x}}+{sec}^{2}⁡x \\\\  & =\\frac{1+2\\sqrt{x}{sec}^{2}⁡x}{2\\sqrt{x}}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186329846 :knowledge-point/_questions [{:db/id #edb/ref 17592186059675 :knowledge-point/id #uuid "0de0627b-2568-5c02-8928-d14344df5a2f" :knowledge-point/title "Finding the Derivative of an Expression With Sine or Cosine Trigonometric Functions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "58178d4f-4abd-58b7-80f3-235da8563710" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2sin⁡x-2{x}^{-1}" :db/id #edb/ref 17592186327707} {:answer/id #uuid "6e8ba3a3-8163-54a7-a89c-617f3758ea02" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2sin⁡x-2{x}^{-3}" :db/id #edb/ref 17592186327890} {:answer/id #uuid "abf48582-4f98-5a96-ba7c-6645540d8053" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2sin⁡x-2{x}^{-3}" :db/id #edb/ref 17592186328424} {:answer/id #uuid "b8c3ad30-bf9c-5740-9f1f-85721ef68822" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2sin⁡x+2{x}^{-3}" :db/id #edb/ref 17592186328543} {:answer/id #uuid "fb5d65e6-8cdc-5871-afa6-4d5b3c079a97" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2sin⁡x-2{x}^{-2}" :db/id #edb/ref 17592186329139}] :answer-field/correct {:answer/id #uuid "abf48582-4f98-5a96-ba7c-6645540d8053" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2sin⁡x-2{x}^{-3}" :db/id #edb/ref 17592186328424} :answer-field/id #uuid "fa72fd76-960d-5bcb-9cf5-7f47b8602241" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186329616}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "f32d0b6b-0338-505d-81ba-ba8c8d1669de" :question/math-academy-id "q-47985" :question/problem "Find the derivative of $y=-2cos⁡x+{x}^{-2}.$" :question/worked-solution "We know that $\\frac{\\text{d}}{\\text{d}x}(cos⁡x)=-sin⁡x.$ Applying this formula, we have\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}}{\\text{d}x}(-2cos⁡x+{x}^{-2}) \\\\  & =-2(-sin⁡x)+(-2){x}^{-2-1} \\\\  & =2sin⁡x-2{x}^{-3}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186329847 :knowledge-point/_questions [{:db/id #edb/ref 17592186119978 :knowledge-point/id #uuid "8c0b7d95-c699-5762-aa44-449712f035c7" :knowledge-point/title "Calculating the Derivative of the Inverse of a Polynomial Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "38ba450c-d188-5534-a6ad-9cafd867771b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{2{({g}^{-1}(x))}^{2}}{{({g}^{-1}(x))}^{3}+1}" :db/id #edb/ref 17592186327431} {:answer/id #uuid "5ac51d0f-a480-5257-9373-a102ae71dd07" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{{g}^{-1}(x)}{2{g}^{-1}(x)+2}" :db/id #edb/ref 17592186327728} {:answer/id #uuid "750ebad7-1376-571e-b002-d5de0ee49d71" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{2{g}^{-1}(x)}{{({g}^{-1}(x))}^{2}+2}" :db/id #edb/ref 17592186327940} {:answer/id #uuid "b6596677-9e79-5e4d-84e5-b8e191d29f04" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{{({g}^{-1}(x))}^{2}}{2{({g}^{-1}(x))}^{3}+2}" :db/id #edb/ref 17592186328519} {:answer/id #uuid "f6eb08b3-97ab-5448-916e-1bc51afd4120" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{{g}^{-1}(x)}{{({g}^{-1}(x))}^{3}+2}" :db/id #edb/ref 17592186329100}] :answer-field/correct {:answer/id #uuid "b6596677-9e79-5e4d-84e5-b8e191d29f04" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{{({g}^{-1}(x))}^{2}}{2{({g}^{-1}(x))}^{3}+2}" :db/id #edb/ref 17592186328519} :answer-field/id #uuid "fc99300b-987e-5768-8111-394ddb19ea49" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186329622}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "22ff07e4-057d-5a67-9809-969ec3b995f3" :question/math-academy-id "q-47990" :question/problem "If $g(x)=-{x}^{2}+\\frac{2}{x},$ find ${({g}^{-1})}^{′}(x)$ as a function of ${g}^{-1}(x).$" :question/worked-solution "**Step 1:** First, we write the inverse function implicitly. The given function is $y=-{x}^{2}+\\frac{2}{x},$ and to write the inverse function implicitly, we swap $x$ and $y$ as follows:\n\n$$\nx=-{y}^{2}+\\frac{2}{y}\n$$\n\nNote that in the equation above, we have $y={g}^{-1}(x).$\n\n**Step 2:** Next, we differentiate. The overall goal is to find $\\frac{\\text{d}y}{\\text{d}x},$ but the equation is already solved for $x,$ so we compute $\\frac{\\text{d}x}{\\text{d}y}$ and then take the reciprocal:\n\n$$\n\\begin{aligned}\\frac{\\text{d}x}{\\text{d}y} & =\\frac{\\text{d}}{\\text{d}y}(-{y}^{2}+\\frac{2}{y}) \\\\ \\frac{\\text{d}x}{\\text{d}y} & =-2y-\\frac{2}{{y}^{2}} \\\\ \\frac{\\text{d}x}{\\text{d}y} & =-\\frac{2{y}^{3}+2}{{y}^{2}} \\\\ \\frac{\\text{d}y}{\\text{d}x} & =-\\frac{{y}^{2}}{2{y}^{3}+2}\\end{aligned}\n$$\n\n**Step 3:** Lastly, we write the result in terms of ${g}^{-1}(x).$ Since $y={g}^{-1}(x),$ we have\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}[{g}^{-1}(x)] & =-\\frac{({g}^{-1}(x))^{2}}{2({g}^{-1}(x))^{3}+2} \\\\ {({g}^{-1})}^{′}(x) & =-\\frac{({g}^{-1}(x))^{2}}{2({g}^{-1}(x))^{3}+2}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186329849 :knowledge-point/_questions [{:db/id #edb/ref 17592186096621 :knowledge-point/id #uuid "3c547746-49c8-5a4a-85fe-c6b75493a354" :knowledge-point/title "Differentiating a Quotient Containing Other Functions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5d04b0f4-3b5e-5a83-ab7c-fadd2fae0aa3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{xcos⁡x+2sin⁡x}{{x}^{3}}" :db/id #edb/ref 17592186327753} {:answer/id #uuid "79438a62-c77a-5744-9802-65b0e97ef42c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{cos⁡x-2xsin⁡x}{{x}^{4}}" :db/id #edb/ref 17592186327973} {:answer/id #uuid "85f38040-e7a5-59fd-a359-c862f85f6a27" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{xcos⁡x-2sin⁡x}{{x}^{3}}" :db/id #edb/ref 17592186328088} {:answer/id #uuid "a8c4ce4c-f609-552a-9123-d8fd254ccab0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2xcos⁡x-xsin⁡x}{{x}^{3}}" :db/id #edb/ref 17592186328396} {:answer/id #uuid "c0e8be1f-f487-5a62-b564-e74b12097ed9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{xsin⁡x-2cos⁡x}{{x}^{4}}" :db/id #edb/ref 17592186328619}] :answer-field/correct {:answer/id #uuid "85f38040-e7a5-59fd-a359-c862f85f6a27" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{xcos⁡x-2sin⁡x}{{x}^{3}}" :db/id #edb/ref 17592186328088} :answer-field/id #uuid "9f86cadc-4440-532f-bf1a-6161f5f6bfb9" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186329450}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "b3c4b5b5-b682-57e6-baf5-0601260b1ed0" :question/math-academy-id "q-47998" :question/problem "If $f(x)=\\frac{sin⁡x}{{x}^{2}},$ find ${f}^{′}(x).$" :question/worked-solution "In this case, the expression for $f(x)$ is a quotient $\\frac{u(x)}{v(x)}$ with $u(x)=sin⁡x$ and $v(x)={x}^{2}.$ \n\nTherefore, we apply the quotient rule as follows:\n\n$$\n\\begin{aligned}\\begin{aligned}{f}^{′}(x) & =\\frac{{u}^{′}(x)\\cdot v(x)-u(x)\\cdot {v}^{′}(x)}{[v(x)]^{2}} \\\\  & =\\frac{(sin⁡x)^{′}\\cdot {x}^{2}-sin⁡x\\cdot ({x}^{2})^{′}}{({x}^{2})^{2}} \\\\  & =\\frac{{x}^{2}cos⁡x-2xsin⁡x}{{x}^{4}} \\\\  & =\\frac{x(xcos⁡x-2sin⁡x)}{{x}^{4}} \\\\  & =\\frac{xcos⁡x-2sin⁡x}{{x}^{3}}\\end{aligned}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186329850 :knowledge-point/_questions [{:db/id #edb/ref 17592186092260 :knowledge-point/id #uuid "a83f86ab-a008-5487-b118-f1495a0fe4d6" :knowledge-point/title "Differentiating an Exponential Function with a Linear Exponent"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "016b59fa-7dd1-5430-8a0d-9d17b256b87e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-8{e}^{4x-1}+3" :db/id #edb/ref 17592186326950} {:answer/id #uuid "1a09b33b-87d5-53a9-afee-f8e02962d4c3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}{e}^{4x-1}" :db/id #edb/ref 17592186327160} {:answer/id #uuid "35f572ac-b945-560e-89f5-d45ed6858e1a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8{e}^{4x-1}+3" :db/id #edb/ref 17592186327403} {:answer/id #uuid "bab77687-86e3-5b97-960a-d832566921c3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-8{e}^{4x-2}" :db/id #edb/ref 17592186328563} {:answer/id #uuid "bfa829b5-29ee-5ba4-a1c8-72e5faa0588a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-8{e}^{4x-1}" :db/id #edb/ref 17592186328611}] :answer-field/correct {:answer/id #uuid "bfa829b5-29ee-5ba4-a1c8-72e5faa0588a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-8{e}^{4x-1}" :db/id #edb/ref 17592186328611} :answer-field/id #uuid "a2f4dd66-f6d3-5f50-8ce9-b004c416733f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186329462}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "dd0c521a-06b7-559f-8b78-1152ec8cbcd7" :question/math-academy-id "q-48007" :question/problem "Calculate ${f}^{′}(x)$ if $f(x)=-2{e}^{4x-1}+3.$" :question/worked-solution "First, we express $f(x)$ as the composite function\n\n$$\nf=-2{e}^{u}+3,\\,u=4x-1.\n$$\n\nDifferentiating gives\n\n$$\n\\frac{\\text{d}f}{\\text{d}u}=-2{e}^{u},\\,\\frac{\\text{d}u}{\\text{d}x}=4.\n$$\n\nWe now apply the chain rule, and get\n\n$$\n\\begin{aligned}\\frac{\\text{d}f}{\\text{d}x} & =\\frac{\\text{d}f}{\\text{d}u}\\cdot \\frac{\\text{d}u}{\\text{d}x} \\\\  & =-2{e}^{u}\\cdot 4 \\\\  & =-8{e}^{u} \\\\  & =-8{e}^{4x-1}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186392602 :knowledge-point/_questions [{:db/id #edb/ref 17592186068696 :knowledge-point/id #uuid "31eacf5a-75a5-5b38-8c24-4b1598ecf3a7" :knowledge-point/title "Identifying Points of Discontinuity"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d495799e-2f9d-5146-a399-506d9d32ad84" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/c9/c9ba1e63c665ad63597c822828fdf26ec0fefade083df5ea828f57a49d3aa149.png" :db/id #edb/ref 17592186392604} {:answer/id #uuid "c796e42f-5eb7-5d3a-900e-6d5fb58916e3" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/fc/fc1d428500558ed62fbf5f7e0c13604cbc759629cedb63a8f9c2f7fc0b412480.png" :db/id #edb/ref 17592186392605} {:answer/id #uuid "742220de-47f9-5f30-8679-f64626ac489f" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/d9/d9185fb471c9806d490133c6ea5a54ef69878f89ca0e0be66008ec3626bfe346.png" :db/id #edb/ref 17592186392606} {:answer/id #uuid "11ce7ab1-ca48-5c69-b7f7-b7ff62f3ea3d" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/49/49e7b3c3cd4e6410b95a307f74c90079ec61c2d3540f86a357db88c77039ca44.png" :db/id #edb/ref 17592186392607} {:answer/id #uuid "c37ded1b-1a1e-52ed-a977-31d60b87248f" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/bd/bd662a57e07bf3f0319a00a15dc5c520a172d59672eae24f7999a4535da0b9ee.png" :db/id #edb/ref 17592186392608}] :answer-field/correct {:answer/id #uuid "c796e42f-5eb7-5d3a-900e-6d5fb58916e3" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/fc/fc1d428500558ed62fbf5f7e0c13604cbc759629cedb63a8f9c2f7fc0b412480.png" :db/id #edb/ref 17592186392605} :answer-field/id #uuid "ac8479b0-0f39-5a85-82ad-a7d9ee04b2a6" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186392603}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "c3d5f3e1-0f7f-56ba-9eea-f720be7a7122" :question/math-academy-id "q-48038" :question/problem "Select the function that has a discontinuity at $x=1.$" :question/worked-solution "The correct answer is shown below. Notice that the function contains a break exactly at $x=1$ and it's impossible to draw its graph without taking our pencil off of the paper.\n\n![](images/3c/3c8a198c1ec835590a3d755b964929ef9ac9a30e4268b2fdc80dacdb394899d8.png)\n\nAll the other given graphs can be plotted without taking the pencil off of the paper."}] [{:db/id #edb/ref 17592186329854 :knowledge-point/_questions [{:db/id #edb/ref 17592186068697 :knowledge-point/id #uuid "3f92e521-e7ab-56ba-8eac-0484b140b1a2" :knowledge-point/title "Determining the Behavior of a Function in the Neighborhood of a Point"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0ee867b9-645a-512d-9f99-f3aa8226ad71" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186327063} {:answer/id #uuid "4558acbf-a492-5e1c-acde-0aa26d25d7f5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186327540} {:answer/id #uuid "a58a5f87-8e65-5592-8409-a19f0dfcd0ee" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186328364} {:answer/id #uuid "b013ab09-8aad-54e4-9a17-87cdc1aa5d04" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186328460} {:answer/id #uuid "c6636203-3372-5d9c-9639-986cdeaf7e30" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186328677}] :answer-field/correct {:answer/id #uuid "0ee867b9-645a-512d-9f99-f3aa8226ad71" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186327063} :answer-field/id #uuid "e45de7c6-c5ce-5b9d-a7b8-ea5254d09158" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186329581}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "96069899-bca3-51de-b64c-6e29072ea13e" :question/math-academy-id "q-48062" :question/problem "![](images/d9/d9db7f2a491ae3065dbe8434a71d378c4fed8fec16c82e2fd76dcb209c786809.png)\n\nThe graph of $y=f(x)$ is shown above. Which of the following statements are true? \n\n- $f(x)$ is defined at $x=1$\n- ${lim}_{x\\to \\,1}f(x)$ exists\n- $f(x)$ is continuous at $x=1$" :question/worked-solution "By inspecting the graph, we can conclude the following:\n\n- Statement I is false. From the graph we can see that no value has been assigned to $f(x)$ at $x=1.$\n\n- Statement II is true. Indeed, \n\n$$\n\\begin{aligned}{lim}_{x\\to \\,{1}^{-}}f(x) & =1, \\\\ {lim}_{x\\to \\,{1}^{+}}f(x) & =1.\\end{aligned}\n$$\n\nHence, \n${lim}_{x\\to \\,1}f(x)=1.$\n\n- Statement III is false. The function is not even defined at $x=1.$ The graph contains a break at $x=1.$ It's impossible to draw the graph of $f(x)$ without taking our pencil off of the paper."}] [{:db/id #edb/ref 17592186329855 :knowledge-point/_questions [{:db/id #edb/ref 17592186068697 :knowledge-point/id #uuid "3f92e521-e7ab-56ba-8eac-0484b140b1a2" :knowledge-point/title "Determining the Behavior of a Function in the Neighborhood of a Point"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4f05bd8f-eb2f-57d7-ae18-c11817bd78b7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186327620} {:answer/id #uuid "83335e31-f97c-5df4-863a-ef88150fb6f3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I, II and III" :db/id #edb/ref 17592186328065} {:answer/id #uuid "9a9a91aa-3ed8-5151-bcb5-e59ccd13d6bc" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186328272} {:answer/id #uuid "ce9e8871-1f30-5744-8374-042f56698b0e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186328750} {:answer/id #uuid "d6472410-aa22-5e41-a0c0-09e47c3fb93c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186328811}] :answer-field/correct {:answer/id #uuid "83335e31-f97c-5df4-863a-ef88150fb6f3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I, II and III" :db/id #edb/ref 17592186328065} :answer-field/id #uuid "23e84077-b88d-5119-bcf7-6c45cbfd0278" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186329249}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "1e01edc7-98f4-52fe-bf43-cb1e05ae0d4a" :question/math-academy-id "q-48065" :question/problem "![](images/fa/fa15192923f9fd7370818fcb6b05b24b3bb6901dfbf90dd53539d71fd0f8b0bf.png)\n\nThe graph of $y=f(x)$ is shown above. Which of the following statements are true? \n\n- $f(x)$ is defined at $x=2$\n- ${lim}_{x\\to \\,2}f(x)=f(2)$\n- $f(x)$ is continuous at $x=2$" :question/worked-solution "By inspecting the graph, we can conclude the following:\n\n- Statement I is true. Indeed, $f(x)$ is defined at $x=2$ and $f(2)=1.$\n\n- Statement II is true. Indeed, from the graph we see that\n\n$$\n\\begin{aligned}{lim}_{x\\to \\,{2}^{-}}f(x) & =1, \\\\ {lim}_{x\\to \\,{2}^{+}}f(x) & =1.\\end{aligned}\n$$\n\nHence, ${lim}_{x\\to \\,2}f(x)=1=f(2).$\n\n- Statement III is true. The graph of $f(x)$ can be drawn without taking our pencil off of the paper in the neighborhood of $x=2.$"}] [{:db/id #edb/ref 17592186329858 :knowledge-point/_questions [{:db/id #edb/ref 17592186092382 :knowledge-point/id #uuid "db808f48-6d0c-5b35-9342-b1817df65172" :knowledge-point/title "Calculating the Equation of a Tangent Line to a Curve at a Point"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "02cb37f5-2f1d-5582-9b0a-ba3d5ae84781" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=x-12" :db/id #edb/ref 17592186326967} {:answer/id #uuid "12f35963-b5fb-5ee8-a217-7821558518c7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=4x-3" :db/id #edb/ref 17592186327097} {:answer/id #uuid "29f970a0-530a-5098-9cef-2daea001ef9c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=4x-1" :db/id #edb/ref 17592186327295} {:answer/id #uuid "39dad4a5-4110-5374-97bc-fe41c7c0f5d8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=5x-5" :db/id #edb/ref 17592186327440} {:answer/id #uuid "83d0f077-ab57-54f6-80e1-8b63e8a4c95e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=5x-2" :db/id #edb/ref 17592186328072}] :answer-field/correct {:answer/id #uuid "83d0f077-ab57-54f6-80e1-8b63e8a4c95e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=5x-2" :db/id #edb/ref 17592186328072} :answer-field/id #uuid "324d4519-c59d-5772-95b5-cc69664e41ef" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186329278}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "a5a7a5a2-50a1-5b97-8ac0-810e9082e127" :question/math-academy-id "q-4807" :question/problem "Find the equation of the tangent to the curve $y=2{x}^{2}+x$ at the point $(1,3).$" :question/worked-solution "Let $f(x)=2{x}^{2}+x.$ Computing the derivative ${f}^{′}(x)$ gives\n\n$$\n\\begin{aligned}{f}^{′}(x)=\\frac{\\text{d}}{\\text{d}x}(2{x}^{2}+x)=4x+1.\\end{aligned}\n$$\n\nWe then compute ${f}^{′}(1)$, which gives\n\n$$\n\\begin{aligned}{f}^{′}(1)=4(1)+1=5\\,.\\end{aligned}\n$$\n\nFinally, we use the point-slope form with $m=5$ and the coordinates of our point $(1,3),$ and get\n\n$$\n\\begin{aligned}y-{y}_{1} & =m(x-{x}_{1}) \\\\ y-(3) & =5(x-1) \\\\ y & =5x-5+3 \\\\ y & =5x-2.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186069368 :knowledge-point/_questions [{:db/id #edb/ref 17592186068696 :knowledge-point/id #uuid "31eacf5a-75a5-5b38-8c24-4b1598ecf3a7" :knowledge-point/title "Identifying Points of Discontinuity"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9aa17146-c6c7-5f57-99cb-8b4f88241e1c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$x = 2$ and $x = 0$" :db/id #edb/ref 17592186067379} {:answer/id #uuid "f56223ce-52c2-5805-b123-5b321403e168" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$x = 0$ only" :db/id #edb/ref 17592186067380} {:answer/id #uuid "fe31fb35-056a-5723-b579-c5fcb9207404" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$x = 2$ only" :db/id #edb/ref 17592186067381} {:answer/id #uuid "0f09c3a6-6f34-51bf-9fbc-ff068943f2ad" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$x =-2$ and $x = 0$" :db/id #edb/ref 17592186067382} {:answer/id #uuid "4ff820fc-2a81-54bf-9357-bc56abc716af" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x = ± 2" :db/id #edb/ref 17592186067383}] :answer-field/id #uuid "79a76400-df25-5acb-8a89-5231f72c68bd" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186067378} {:answer-field/choices [{:answer/id #uuid "e9d17f27-11e4-5d07-bef6-23b79d1c374c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=\\pm 2" :db/id #edb/ref 17592186396668} {:answer/id #uuid "51dfca4a-207b-5033-87d0-8f1fd9a9fe6a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$x=2$ only" :db/id #edb/ref 17