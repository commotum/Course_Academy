 "images/3a/3a8f77e96f836eadfdb1a0c73f35bad5e245b66df0f21daec6ac008fb69a4815.png" :db/id #edb/ref 17592186386685} {:answer/id #uuid "f85feca0-357a-5c74-8fde-4d7fdaa2cd0b" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/f5/f558777e9ec384bdd169cddefeac589861cae2568f130816c4bf7a1f4ee1e520.png" :db/id #edb/ref 17592186386686} {:answer/id #uuid "dba9cafa-0a6c-53c7-80a2-61fb5e35090a" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/8f/8f2a42430ac31a559e5f85c961579aa482280bd9b69ed5d948250f5fafce21a5.png" :db/id #edb/ref 17592186386687} {:answer/id #uuid "b0a9dbae-7498-55b8-b00b-07a41ab70457" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/0b/0bb082b243d961b45b63d352f84359d7022492df93e781f93114206e9924b5c2.png" :db/id #edb/ref 17592186386688}] :answer-field/correct {:answer/id #uuid "f85feca0-357a-5c74-8fde-4d7fdaa2cd0b" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/f5/f558777e9ec384bdd169cddefeac589861cae2568f130816c4bf7a1f4ee1e520.png" :db/id #edb/ref 17592186386686} :answer-field/id #uuid "1a9d5ff1-d590-522a-bcb5-31d743a32102" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186386683}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "110d0b81-fd68-5dac-ba01-18cdf7c4cb65" :question/math-academy-id "q-113463" :question/problem "Which of the following is the graph of $y=\\frac{3}{4(x-1)}?$" :question/worked-solution "To plot $y=\\frac{3}{4(x-1)},$ we apply the following steps:\n\n- Take the curve $y=\\frac{1}{x}.$\n\n![](images/e8/e80865b0f32a5473da27b39537034bcdabee0a6c24032f41413e20518642d3f4.png)\n\n- Translate it by $1$ unit to the right to get the graph of $y=\\frac{1}{x-1}.$\n\n![](images/8f/8f2a42430ac31a559e5f85c961579aa482280bd9b69ed5d948250f5fafce21a5.png)\n\n- Then, stretch the result by a scale factor of $\\frac{3}{4}$ parallel to the $y$-axis to get the graph of $y=\\frac{3}{4(x-1)}.$\n\n![](images/f5/f558777e9ec384bdd169cddefeac589861cae2568f130816c4bf7a1f4ee1e520.png)"}] [{:db/id #edb/ref 17592186247353 :knowledge-point/_questions [{:db/id #edb/ref 17592186068780 :knowledge-point/id #uuid "308f3685-0a90-56f3-9653-a83cec4286d2" :knowledge-point/title "Solving for Some Unknowns Given the Graph of a Transformed Reciprocal Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1f0f5357-6a5d-52cb-a0b3-8bb0331ee994" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186244583} {:answer/id #uuid "606311eb-894b-5b77-b109-e32e121ff8d3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1.5" :db/id #edb/ref 17592186245155} {:answer/id #uuid "6d13ff09-b329-5200-85b0-89687a5270ba" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186245277} {:answer/id #uuid "7f280c4b-6081-508f-8997-4749439fa6b4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-4.5" :db/id #edb/ref 17592186245435} {:answer/id #uuid "847e53f3-ba86-5571-b86e-1f4f19fe8930" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-0.5" :db/id #edb/ref 17592186245483}] :answer-field/correct {:answer/id #uuid "606311eb-894b-5b77-b109-e32e121ff8d3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1.5" :db/id #edb/ref 17592186245155} :answer-field/id #uuid "917d77c5-3e45-5592-bf27-58d3f7e98794" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186246797}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "3d881fc0-905f-5d7f-8a88-250eeb9291b8" :question/math-academy-id "q-113482" :question/problem "![](images/4d/4d2dec8a05bc9835693c1df9dbc54618fd39d77667cbbdcd5bb6d92bf25c0d97.png)\n\nThe graph represents the function $y=\\frac{a}{x-b}+k.$ What is the value of $a+b+k?$" :question/worked-solution "First, notice that the horizontal asymptote of the graph is $y=0.5,$ while the vertical asymptote is $x=3.$ This means that $k=0.5$ and $b=3,$ and we can re-write our function as\n\n$$\ny=\\frac{a}{x-3}+0.5.\n$$\n\nAlso, we are given that the point $(1,1.5)$ lies on the graph. Substituting its coordinates into the equation above, we obtain\n\n$$\n\\begin{aligned}y & =\\frac{a}{x-3}+0.5 \\\\ 1.5 & =\\frac{a}{1-3}+0.5 \\\\ 1 & =\\frac{a}{-2} \\\\ a & =-2.\\end{aligned}\n$$\n\nFinally, $a+b+k=-2+3+0.5=1.5.$"}] [{:db/id #edb/ref 17592186398102 :knowledge-point/_questions [{:db/id #edb/ref 17592186064203 :knowledge-point/id #uuid "e2b47545-fdf1-5e6a-b0bb-bbbecb8067cc" :knowledge-point/title "Integrating an Algebraic Function With Positive Integer Exponent"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "326be129-c932-54e7-bd6e-d61f8a6c1750" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{18}{5}(2-5x)^{6}+C" :db/id #edb/ref 17592186398104} {:answer/id #uuid "d8f6915c-a30b-538c-be4c-c5d4feafc456" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{3}{5}(2-5x)^{6}+C" :db/id #edb/ref 17592186398105} {:answer/id #uuid "d929af17-b6b6-5bb1-9948-38e8c5714648" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{5}(2-5x)^{6}+C" :db/id #edb/ref 17592186398106} {:answer/id #uuid "e257789f-7b07-5075-adc9-57e60483dc0d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{18}{5}(2-5x)^{6}+C" :db/id #edb/ref 17592186398107} {:answer/id #uuid "65143245-b12a-5ed5-a1a3-dc55de2b261a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{15}(2-5x)^{6}+C" :db/id #edb/ref 17592186398108}] :answer-field/correct {:answer/id #uuid "d8f6915c-a30b-538c-be4c-c5d4feafc456" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{3}{5}(2-5x)^{6}+C" :db/id #edb/ref 17592186398105} :answer-field/id #uuid "0d582062-813e-5b4d-b116-6b4cb9d5d390" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186398103}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "201b1303-edfe-5a94-b70a-3687fd03d284" :question/math-academy-id "q-113502" :question/problem "$\\int 18(2-5x)^{5}\\,\\text{d}x=$" :question/worked-solution "Let $u=2-5x.$ Then differentiating with respect to $x$ gives\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=-5\\,⟹\\,\\text{d}x=-\\frac{1}{5}\\text{d}u.\n$$\n\nWe now write our integral in terms of $u,$ calculate the integral as normal, and write the final answer in terms of $x$ at the very end:\n\n$$\n\\begin{aligned}\\int 18(2-5x)^{5}\\,\\text{d}x & =\\int 18{u}^{5}\\cdot (-\\frac{1}{5})\\text{d}u \\\\  & =18\\cdot (-\\frac{1}{5})\\int {u}^{5}\\cdot \\,\\text{d}u \\\\  & =-\\frac{18}{5}\\int {u}^{5}\\,\\text{d}u \\\\  & =-\\frac{18}{5}\\cdot \\frac{{u}^{6}}{6}+C \\\\  & =-\\frac{3}{5}{u}^{6}+C \\\\  & =-\\frac{3}{5}(2-5x)^{6}+C\\end{aligned}\n$$\n\nLet's double-check that our result is correct. If we differentiate the result, then it should come out to the original integrand:\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}[-\\frac{3}{5}(2-5x)^{6}+C] & =-\\frac{\\text{d}}{\\text{d}x}[\\frac{3}{5}(2-5x)^{6}]+\\frac{\\text{d}}{\\text{d}x}(C) \\\\  & =-\\frac{18}{5}(2-5x)^{5}\\cdot \\frac{\\text{d}}{\\text{d}x}(2-5x)+0 \\\\  & =-\\frac{18}{5}(2-5x)^{5}\\cdot (-5) \\\\  & =18(2-5x)^{5}\\,✓\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186398109 :knowledge-point/_questions [{:db/id #edb/ref 17592186064204 :knowledge-point/id #uuid "387d85df-b839-5837-89b9-5e4bb4daa073" :knowledge-point/title "Integrating an Algebraic Function With Negative Integer Exponent"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "87bb5e34-8a7e-5077-9056-44171c31d68f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{2(x-2)^{4}}+C" :db/id #edb/ref 17592186398111} {:answer/id #uuid "73df82c1-76f6-50ea-99b9-53a33ba7607d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2(x-2)^{2}}+C" :db/id #edb/ref 17592186398112} {:answer/id #uuid "cfab3df7-4bb6-5eeb-9342-3841991827b8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{2}{(x-2)^{2}}+C" :db/id #edb/ref 17592186398113} {:answer/id #uuid "1e49762e-1e14-5248-8c9e-16a5e673bda1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{(x-2)^{2}}+C" :db/id #edb/ref 17592186398114} {:answer/id #uuid "15a56691-9975-5ae2-aa7b-fda010fe63b8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{2(x-2)^{2}}+C" :db/id #edb/ref 17592186398115}] :answer-field/correct {:answer/id #uuid "15a56691-9975-5ae2-aa7b-fda010fe63b8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{2(x-2)^{2}}+C" :db/id #edb/ref 17592186398115} :answer-field/id #uuid "c13dea0f-f218-5cd2-a503-c7b2250d51fb" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186398110}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "1948aa2d-5fbb-59f5-8ccc-6dd9cfd6ef51" :question/math-academy-id "q-113509" :question/problem "Calculate the integral $\\int \\frac{1}{(x-2)^{3}}\\,\\text{d}x.$" :question/worked-solution "First, we rewrite the integral as\n\n$$\n\\int (x-2)^{-3}\\,\\text{d}x.\n$$\n\nLet $u=x-2.$ Then differentiating with respect to $x$ gives\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=1\\,⟹\\,\\text{d}x=\\text{d}u.\n$$\n\nWe now write our integral in terms of $u,$ calculate the integral as normal, and write the final answer in terms of $x$ at the very end:\n\n$$\n\\begin{aligned}\\int (x-2)^{-3}\\,\\text{d}x & =\\int {u}^{-3}\\cdot \\text{d}u \\\\  & =-\\frac{1}{2}\\cdot {u}^{-2}+C \\\\  & =-\\frac{1}{2{u}^{2}}+C \\\\  & =-\\frac{1}{2(x-2)^{2}}+C\\end{aligned}\n$$\n\nLet's double-check that our result is correct. If we differentiate the result, then it should come out to the original integrand:\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}[-\\frac{1}{2(x-2)^{2}}+C] & =\\frac{\\text{d}}{\\text{d}x}[-\\frac{1}{2(x-2)^{2}}]+\\frac{\\text{d}}{\\text{d}x}(C) \\\\  & =-\\frac{1}{2}\\frac{\\text{d}}{\\text{d}x}[(x-2)^{-2}]+\\frac{\\text{d}}{\\text{d}x}(C) \\\\  & =-\\frac{1}{2}\\cdot (-2)\\cdot (x-2)^{-3}\\cdot \\frac{\\text{d}}{\\text{d}x}(x-2)+0 \\\\  & =1\\cdot \\frac{1}{(x-2)^{3}}\\cdot 1 \\\\  & =\\frac{1}{(x-2)^{3}}\\,✓\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186398116 :knowledge-point/_questions [{:db/id #edb/ref 17592186064204 :knowledge-point/id #uuid "387d85df-b839-5837-89b9-5e4bb4daa073" :knowledge-point/title "Integrating an Algebraic Function With Negative Integer Exponent"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "06f0d601-5b9e-5b34-b1e4-35332ff61132" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{20(9-5x)^{4}}+C" :db/id #edb/ref 17592186398118} {:answer/id #uuid "ae0f063f-eba9-55db-a617-104bbe47e493" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{5(9-5x)^{2}}+C" :db/id #edb/ref 17592186398119} {:answer/id #uuid "199a03cb-71ce-557c-b3af-135bd3564f86" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{10(9-5x)^{2}}+C" :db/id #edb/ref 17592186398120} {:answer/id #uuid "418bd3f4-e4c0-5bc7-b4ac-5541696af9d9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{10(9-5x)^{2}}+C" :db/id #edb/ref 17592186398121} {:answer/id #uuid "51978e0d-c725-5111-8fd8-58bfe89fa4d2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{2(9-5x)^{2}}+C" :db/id #edb/ref 17592186398122}] :answer-field/correct {:answer/id #uuid "418bd3f4-e4c0-5bc7-b4ac-5541696af9d9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{10(9-5x)^{2}}+C" :db/id #edb/ref 17592186398121} :answer-field/id #uuid "3b49b60e-8217-5844-bea9-fe48c12aaf25" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186398117}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "d34fadec-e1db-5f0e-b3fb-64f3326f1376" :question/math-academy-id "q-113517" :question/problem "$\\int \\frac{1}{(9-5x)^{3}}\\,\\text{d}x=$" :question/worked-solution "First, we rewrite the integral as\n\n$$\n\\int (9-5x)^{-3}\\,\\text{d}x.\n$$\n\nLet $u=9-5x.$ Then differentiating with respect to $x$ gives\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=-5\\,⟹\\,\\text{d}x=-\\frac{1}{5}\\text{d}u.\n$$\n\nWe now write our integral in terms of $u,$ calculate the integral as normal, and write the final answer in terms of $x$ at the very end:\n\n$$\n\\begin{aligned}\\int (9-5x)^{-3}\\text{d}x & =\\int {u}^{-3}\\cdot (-\\frac{1}{5})\\,\\text{d}u \\\\  & =-\\frac{1}{5}\\int {u}^{-3}\\,\\text{d}u \\\\  & =-\\frac{1}{5}\\cdot (-\\frac{1}{2}){u}^{-2}+C \\\\  & =\\frac{1}{10{u}^{2}}+C \\\\  & =\\frac{1}{10(9-5x)^{2}}+C\\end{aligned}\n$$\n\nLet's double-check that our result is correct. If we differentiate the result, then it should come out to the original integrand:\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}[\\frac{1}{10(9-5x)^{2}}+C] & =\\frac{\\text{d}}{\\text{d}x}[\\frac{1}{10(9-5x)^{2}}]+\\frac{\\text{d}}{\\text{d}x}(C) \\\\  & =\\frac{1}{10}\\frac{\\text{d}}{\\text{d}x}[(9-5x)^{-2}]+\\frac{\\text{d}}{\\text{d}x}(C) \\\\  & =\\frac{1}{10}\\cdot (-2)(9-5x)^{-3}\\cdot \\frac{\\text{d}}{\\text{d}x}(9-5x)+0 \\\\  & =-\\frac{1}{5}(9-5x)^{-3}\\cdot (-5) \\\\  & =(9-5x)^{-3} \\\\  & =\\frac{1}{{(9-5x)}^{3}}\\,✓\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186399795 :knowledge-point/_questions [{:db/id #edb/ref 17592186087844 :knowledge-point/id #uuid "b18ace11-d31c-5d5a-bd2e-32e1c28af2b9" :knowledge-point/title "Calculating Vertical Asymptotes When the Denominator Has Complex Roots"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5a12e93a-5479-5bc8-a172-5f001b81680d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$x=0$ and $x=2$" :db/id #edb/ref 17592186399797} {:answer/id #uuid "9bd56062-f5eb-5d51-97c9-2401cc2382c4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$x=6$ only" :db/id #edb/ref 17592186399798} {:answer/id #uuid "50434bd2-8dc8-5df0-b8fa-4d7fa1f9bf18" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$x=2$ only" :db/id #edb/ref 17592186399799} {:answer/id #uuid "060d6765-1a4c-5cef-9036-baa44df95b64" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$x=-6$ only" :db/id #edb/ref 17592186399800} {:answer/id #uuid "0532888d-2587-5d82-aa30-da64f92b3ef7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$x=2$ and $x=6$ only" :db/id #edb/ref 17592186399801}] :answer-field/correct {:answer/id #uuid "50434bd2-8dc8-5df0-b8fa-4d7fa1f9bf18" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$x=2$ only" :db/id #edb/ref 17592186399799} :answer-field/id #uuid "9de2cff7-92c8-5c70-9102-18ed3f31a5ce" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186399796}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "046b8096-a4b3-5639-81fd-05cfaf3fcc14" :question/math-academy-id "q-113527" :question/problem "Determine the vertical asymptotes of $f(x)=\\frac{{x}^{2}-9}{{x}^{3}-2{x}^{2}+6x-12}.$" :question/worked-solution "To find the vertical asymptotes of a rational function, we factor the numerator and denominator and cancel any common factors. Then, we set the denominator equal to zero and solve for $x:$\n\nFactoring the numerator and denominator, we get\n\n$$\n\\begin{aligned}f(x) & =\\frac{{x}^{2}-9}{{x}^{3}-2{x}^{2}+6x-12} \\\\  & =\\frac{(x+3)(x-3)}{{x}^{2}(x-2)+6(x-2)} \\\\  & =\\frac{(x+3)(x-3)}{({x}^{2}+6)(x-2)}\\end{aligned}\n$$\n\nThere are no common factors in the numerator and denominator, so we set the denominator equal to zero. This gives\n\n$$\n({x}^{2}+6)(x-2)=0.\n$$\n\nWe now solve the above equation using the zero product property:\n\n- Solving $x-2=0$ gives the solution $x=2.$\n\n- The equation ${x}^{2}+6=0$ has no real solutions.\n\nTherefore, the only vertical asymptote is $x=2.$"}] [{:db/id #edb/ref 17592186247369 :knowledge-point/_questions [{:db/id #edb/ref 17592186064208 :knowledge-point/id #uuid "af32f07f-fa65-5ede-a506-735dc2d3a5ef" :knowledge-point/title "Integrating a Combination of Linear Rational Functions Using the General Formula"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0bdfb622-49b8-594f-a384-42995cb2c4bc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}\\operatorname{ln}⁡(K|(3x+2)(3x-2)|)" :db/id #edb/ref 17592186244424} {:answer/id #uuid "44aada26-4d55-57df-82e1-467968cd4443" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{3}\\operatorname{ln}⁡(K|(3x+2)(3x-2)|)" :db/id #edb/ref 17592186244917} {:answer/id #uuid "5b7c324f-ce33-58d1-aeaf-8e1275376ed8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{ln}⁡(K|(3x+2)(3x-2)|)" :db/id #edb/ref 17592186245116} {:answer/id #uuid "96e82d2d-4206-5a6a-b1a4-4d0423e61b5e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}\\operatorname{ln}⁡(K|\\frac{3x+2}{3x-2}|)" :db/id #edb/ref 17592186245644} {:answer/id #uuid "cd50755b-b627-54de-8de5-5509a4cc9a9a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{3}\\operatorname{ln}⁡(K|\\frac{3x+2}{3x-2}|)" :db/id #edb/ref 17592186246145}] :answer-field/correct {:answer/id #uuid "44aada26-4d55-57df-82e1-467968cd4443" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{3}\\operatorname{ln}⁡(K|(3x+2)(3x-2)|)" :db/id #edb/ref 17592186244917} :answer-field/id #uuid "5b7ee80e-437d-599e-8d92-09c467d8e2c3" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186246709}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "8007e479-04c9-545e-b360-e628f7f99f22" :question/math-academy-id "q-113540" :question/problem "Calculate $\\int (\\frac{1}{3x+2}+\\frac{1}{3x-2})\\,\\text{d}x.$ Assume that $K$ is an arbitrary positive constant." :question/worked-solution "Let's solve this using the general formula:\n\n$$\n\\begin{aligned}\\int (\\frac{1}{3x+2}+\\frac{1}{3x-2})\\,\\text{d}x & =\\int \\frac{1}{3x+2}\\,\\text{d}x+\\int \\frac{1}{3x-2}\\,\\text{d}x \\\\  & =\\frac{1}{3}\\operatorname{ln}⁡|3x+2|+\\frac{1}{3}\\operatorname{ln}⁡|3x-2|+C \\\\  & =\\frac{1}{3}\\operatorname{ln}⁡|(3x+2)(3x-2)|+\\frac{1}{3}\\operatorname{ln}⁡K \\\\  & =\\frac{1}{3}\\operatorname{ln}⁡(K|(3x+2)(3x-2)|)\\end{aligned}\n$$\n\nNotice that we used the laws of logarithms to write the result as a single logarithm."}] [{:db/id #edb/ref 17592186399802 :knowledge-point/_questions [{:db/id #edb/ref 17592186087845 :knowledge-point/id #uuid "4b0b57da-f9af-5fab-a337-51ee4cb28f9e" :knowledge-point/title "Calculating Vertical Asymptotes With Common Factors When the Denominator Has Complex Roots"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ac9bdca2-12f3-5135-add9-f6cee60b6017" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$x=0$ and $x=\\sqrt{3}$" :db/id #edb/ref 17592186399804} {:answer/id #uuid "ea637b56-a1b6-530a-b8ad-0581d7725118" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$x=-\\sqrt{3},x=0$ and $x=\\sqrt{3}$" :db/id #edb/ref 17592186399805} {:answer/id #uuid "6caf38b1-8d42-5322-9446-2276f113b03b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$x=\\sqrt{3}$ only" :db/id #edb/ref 17592186399806} {:answer/id #uuid "88004c88-6f69-578a-840b-c594bbb79e81" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$x=0$ and $x=-3$" :db/id #edb/ref 17592186399807} {:answer/id #uuid "7aeb7239-f064-571a-82f0-341dafcdd4e5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The function has no vertical asymptotes" :db/id #edb/ref 17592186399808}] :answer-field/correct {:answer/id #uuid "7aeb7239-f064-571a-82f0-341dafcdd4e5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The function has no vertical asymptotes" :db/id #edb/ref 17592186399808} :answer-field/id #uuid "ce9f7db0-7e00-5308-89b8-2a0dcddb1466" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186399803}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "e0085fda-c140-5022-a903-4aa2d0060987" :question/math-academy-id "q-113554" :question/problem "Determine the vertical asymptotes of $f(x)=\\frac{2{x}^{2}-6}{{x}^{4}-9}.$" :question/worked-solution "To find the vertical asymptotes of a rational function, we factor the numerator and denominator and cancel any common factors. Then, we set the denominator equal to zero and solve for $x.$\n\nFactoring the numerator and denominator and canceling any common factors, we get\n\n$$\n\\begin{aligned}f(x) & =\\frac{2{x}^{2}-6}{{x}^{4}-9} \\\\  & =\\frac{2({x}^{2}-3)}{({x}^{2}-3)({x}^{2}+3)} \\\\  & =\\frac{2\\cancel{({x}^{2}-3)}}{\\cancel{({x}^{2}-3)}({x}^{2}+3)} \\\\  & =\\frac{2}{{x}^{2}+3}\\end{aligned}\n$$\n\nNext, we set the denominator equal to zero:\n\n$$\n{x}^{2}+3=0\n$$\n\nThis equation does not have any real solutions. Therefore, $f(x)$ has no vertical asymptotes."}] [{:db/id #edb/ref 17592186247386 :knowledge-point/_questions [{:db/id #edb/ref 17592186171958 :knowledge-point/id #uuid "e5c108c0-f32a-5725-af3b-c3e747da09f2" :knowledge-point/title "Calculating Binomial Coefficients Using the Formula"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "636f8cd8-4302-5907-8b4c-9cc71b409de8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "45" :db/id #edb/ref 17592186245184} {:answer/id #uuid "8d6f224a-0caa-520d-ad3e-993bd26b1e43" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "20" :db/id #edb/ref 17592186245550} {:answer/id #uuid "8f9a6dca-cecb-5099-bca3-bbc8aacd9e89" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "10" :db/id #edb/ref 17592186245567} {:answer/id #uuid "c619693a-c3a7-5317-948a-2a458be487ab" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "15" :db/id #edb/ref 17592186246074} {:answer/id #uuid "caf7ba92-da92-5e6d-bf74-d3e00df8ce32" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "30" :db/id #edb/ref 17592186246121}] :answer-field/correct {:answer/id #uuid "c619693a-c3a7-5317-948a-2a458be487ab" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "15" :db/id #edb/ref 17592186246074} :answer-field/id #uuid "fcd4c2ff-b851-5eb6-ae43-13350a5efade" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186246998}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "a5b0a4bf-2ef4-500e-bc73-fda1cf537ad7" :question/math-academy-id "q-113617" :question/problem "Determine the value of $(\\frac{6}{2}).$" :question/worked-solution "The binomial coefficient $(\\frac{n}{r})$ is given by the formula\n\n$$\n(\\frac{n}{r})=\\frac{n!}{(n-r)!\\,r!}.\n$$\n\nIn this case, we have $n=6$ and $r=2.$ Therefore,\n\n$$\n\\begin{aligned}(\\frac{6}{2}) & =\\frac{6!}{(6-2)!\\cdot 2!} \\\\  & =\\frac{6\\cdot 5\\cdot 4!}{4!\\cdot 2!} \\\\  & =\\frac{6\\cdot 5\\cdot \\cancel{4!}}{\\cancel{4!}\\cdot 2} \\\\  & =\\frac{30}{2} \\\\  & =15.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186247387 :knowledge-point/_questions [{:db/id #edb/ref 17592186171958 :knowledge-point/id #uuid "e5c108c0-f32a-5725-af3b-c3e747da09f2" :knowledge-point/title "Calculating Binomial Coefficients Using the Formula"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "314d4276-e509-5164-9961-ca77aeaa8178" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "7" :db/id #edb/ref 17592186244754} {:answer/id #uuid "37d70a43-b1b3-54ec-a8e7-99f1791d767a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "15" :db/id #edb/ref 17592186244809} {:answer/id #uuid "53333cee-f6e2-59f6-aa51-70e6bcf82322" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "21" :db/id #edb/ref 17592186245049} {:answer/id #uuid "6ab8bbe4-9ce7-5266-afd4-ffc9546dd22f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "42" :db/id #edb/ref 17592186245258} {:answer/id #uuid "d49d5638-6eae-54be-bb6d-0d49474605da" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "35" :db/id #edb/ref 17592186246209}] :answer-field/correct {:answer/id #uuid "53333cee-f6e2-59f6-aa51-70e6bcf82322" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "21" :db/id #edb/ref 17592186245049} :answer-field/id #uuid "a552523c-10f5-578e-9b5d-bff02b6bd9d0" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186246839}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "b1f98a7a-f74d-5763-bfa6-f9be1199e7b5" :question/math-academy-id "q-113618" :question/problem "Determine the value of $(\\frac{7}{5}).$" :question/worked-solution "The binomial coefficient $(\\frac{n}{r})$ is given by the formula\n\n$$\n(\\frac{n}{r})=\\frac{n!}{(n-r)!\\,r!}.\n$$\n\nIn this case, we have $n=7$ and $r=5.$ Therefore,\n\n$$\n\\begin{aligned}(\\frac{7}{5}) & =\\frac{7!}{(7-5)!\\cdot 5!} \\\\  & =\\frac{7\\cdot 6\\cdot 5!}{2!\\cdot 5!} \\\\  & =\\frac{7\\cdot 6\\cdot \\cancel{5!}}{2\\cdot \\cancel{5!}} \\\\  & =\\frac{42}{2} \\\\  & =21.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186247389 :knowledge-point/_questions [{:db/id #edb/ref 17592186100892 :knowledge-point/id #uuid "8de0dd63-23c6-5926-9e33-71e517949af2" :knowledge-point/title "Finding the Coefficient of a Particular Term"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "08fce7bc-08d1-5e8b-bb40-8c4d517f4c4d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "420" :db/id #edb/ref 17592186244387} {:answer/id #uuid "1b9986ef-a167-5908-bb05-76132770f5af" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3\\,360" :db/id #edb/ref 17592186244558} {:answer/id #uuid "892b9d62-faf3-52d5-9abf-938f5096c36d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "210" :db/id #edb/ref 17592186245514} {:answer/id #uuid "d4f11da1-787c-53dc-9bda-8b355fb7c87c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5\\,040" :db/id #edb/ref 17592186246215} {:answer/id #uuid "e792fd70-e9d5-51b8-9049-70955fe9ebf9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1\\,680" :db/id #edb/ref 17592186246363}] :answer-field/correct {:answer/id #uuid "1b9986ef-a167-5908-bb05-76132770f5af" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3\\,360" :db/id #edb/ref 17592186244558} :answer-field/id #uuid "a671ebcc-fc71-5f4c-b050-211eca6acd49" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186246846}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "521595db-fa9d-5190-ad38-7460533af950" :question/math-academy-id "q-113621" :question/problem "The coefficient of ${x}^{18}$ in the expansion of ${(2+{x}^{3})}^{10}$ is" :question/worked-solution "The binomial theorem states that for any positive integer $n,$ we have\n \n\n$$\n(a+b)^{n}=(\\frac{n}{0}){a}^{n}{b}^{0}+(\\frac{n}{1}){a}^{n-1}{b}^{1}+(\\frac{n}{2}){a}^{n-2}{b}^{2}+…+(\\frac{n}{n}){a}^{0}{b}^{n}.\n$$\n\nIn the case of ${(2+{x}^{3})}^{10},$ we have $a=2,$ $b={x}^{3},$ and $n=10.$ Therefore,\n\n$$\n\\begin{aligned}{(2+{x}^{3})}^{10}=(\\frac{10}{0}){2}^{10}{({x}^{3})}^{0}+(\\frac{10}{1}){2}^{10-1}{({x}^{3})}^{1}+(\\frac{10}{2}){2}^{10-2}{({x}^{3})}^{2}+⋯+(\\frac{10}{10}){2}^{10-10}{({x}^{3})}^{10}.\\end{aligned}\n$$\n\nFrom here, we see that the ${x}^{18}$ term must be\n\n$$\n(\\frac{10}{6}){2}^{10-6}{({x}^{3})}^{6}.\n$$\n\nSimplifying this term, we get\n\n$$\n\\begin{aligned}(\\frac{10}{6}){2}^{10-6}{({x}^{3})}^{6} & =210\\cdot {2}^{4}\\cdot {x}^{18} \\\\  & =210\\cdot 16\\cdot {x}^{18} \\\\  & =3\\,360{x}^{18}.\\end{aligned}\n$$\n\nTherefore, the coefficient of ${x}^{18}$ is $3\\,360.$"}] [{:db/id #edb/ref 17592186247396 :knowledge-point/_questions [{:db/id #edb/ref 17592186068723 :knowledge-point/id #uuid "8fe2a279-0b92-561e-b17d-b902f43725ac" :knowledge-point/title "Integrating an Expression Involving a Power Function Multiplied by a Constant Multiple of Its Derivative"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5e32ff11-46c7-5e54-94bf-fdf37bd4e777" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{(4+{x}^{6})^{6}}{6}+C" :db/id #edb/ref 17592186245143} {:answer/id #uuid "61c7ef3d-13c8-5479-bf15-23c7156762ab" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{(4+{x}^{6})^{6}}{18}+C" :db/id #edb/ref 17592186245171} {:answer/id #uuid "90a0075f-a39c-584e-ab19-3bcdb240a499" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{(4+{x}^{6})^{6}}{3}+C" :db/id #edb/ref 17592186245575} {:answer/id #uuid "ad996ae5-8424-527c-80d5-4c89b95ad520" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{(4+{x}^{6})^{6}}{2}+C" :db/id #edb/ref 17592186245863} {:answer/id #uuid "c21643d0-8214-58cb-bb01-f4183d7d91a2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2(4+{x}^{6})^{6}+C" :db/id #edb/ref 17592186246045}] :answer-field/correct {:answer/id #uuid "61c7ef3d-13c8-5479-bf15-23c7156762ab" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{(4+{x}^{6})^{6}}{18}+C" :db/id #edb/ref 17592186245171} :answer-field/id #uuid "51b37ac4-75b0-5695-8c29-875df29f0437" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186246690}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "49e41322-d540-5688-b30a-e33aaf2dc9a7" :question/math-academy-id "q-113710" :question/problem "Calculate $\\int 2{x}^{5}(4+{x}^{6})^{5}\\,\\text{d}x.$" :question/worked-solution "In this case, the term $2{x}^{5}$ outside the parentheses isn't quite the derivative of $4+{x}^{6}.$ But the derivative is $6{x}^{5},$ so we're only out by a constant factor.\nSo we make the substitution\n\n$$\nu=4+{x}^{6}.\n$$\n\nIts derivative is given by\n\n$$\n\\begin{aligned}\\frac{\\text{d}u}{\\text{d}x} & =6{x}^{5}\\,⟹\\,\\frac{1}{3}\\text{d}u=2{x}^{5}\\,\\text{d}x,\\end{aligned}\n$$\n\nand we can now write our integral in terms of $u,$ as follows:\n\n$$\n\\begin{aligned}\\int 2{x}^{5}(4+{x}^{6})^{5}\\,\\text{d}x & =\\int (4+{x}^{6})^{5}\\cdot 2{x}^{5}\\,\\text{d}x \\\\  & =\\int {u}^{5}\\cdot \\frac{1}{3}\\text{d}u \\\\  & =\\frac{1}{3}\\int {u}^{5}\\,\\text{d}u\\end{aligned}\n$$\n\nFinally, we can solve the integral in terms of $u$ and then write the final result in terms of $x.$ We get\n\n$$\n\\begin{aligned}\\frac{1}{3}\\int {u}^{5}\\,\\text{d}u & =\\frac{1}{3}\\cdot \\frac{{u}^{6}}{6}+C \\\\  & =\\frac{1}{18}{u}^{6}+C \\\\  & =\\frac{1}{18}(4+{x}^{6})^{6}+C \\\\  & =\\frac{(4+{x}^{6})^{6}}{18}+C.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186247401 :knowledge-point/_questions [{:db/id #edb/ref 17592186068724 :knowledge-point/id #uuid "18ce1807-3a09-5ebd-b3cd-a91db8d2b4a8" :knowledge-point/title "Integrating a Rational Function Using Natural Logarithms"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7d5dafea-bf81-547d-bc49-424b9dda654f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\operatorname{ln}⁡|{x}^{2}+2x|}{2x+2}+C" :db/id #edb/ref 17592186245413} {:answer/id #uuid "99a2a79b-5577-502b-8046-72f844be5fb0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{ln}⁡|2x+2|+C" :db/id #edb/ref 17592186245676} {:answer/id #uuid "d24c27f7-0e1d-5d59-b35b-8372ae555f55" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{ln}⁡|{x}^{2}+2x|+C" :db/id #edb/ref 17592186246185} {:answer/id #uuid "f82296d1-fe61-58f2-9cf3-93e048824594" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{ln}⁡|\\frac{{x}^{2}+2x}{2x+2}|+C" :db/id #edb/ref 17592186246494} {:answer/id #uuid "fb9b4b11-e546-550e-884b-27bb9cfddd54" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{ln}⁡|\\frac{2x+2}{{x}^{2}+2x}|+C" :db/id #edb/ref 17592186246517}] :answer-field/correct {:answer/id #uuid "d24c27f7-0e1d-5d59-b35b-8372ae555f55" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{ln}⁡|{x}^{2}+2x|+C" :db/id #edb/ref 17592186246185} :answer-field/id #uuid "79f96c4c-101d-52fa-a1e7-55a417e265bc" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186246759}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "a444aaf3-15c5-5890-a26f-622f4c6bdbef" :question/math-academy-id "q-113721" :question/problem "Calculate $\\int \\frac{2x+2}{{x}^{2}+2x}\\,\\text{d}x.$" :question/worked-solution "Let $u={x}^{2}+2x.$ Then\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=2x+2\\,⟹\\,\\text{d}u=(2x+2)\\,\\text{d}x,\n$$\n\nand we can solve the resulting integral as follows:\n\n$$\n\\begin{aligned}\\int \\frac{2x+2}{{x}^{2}+2x}\\,\\text{d}x & =\\int \\frac{1}{{x}^{2}+2x}\\cdot (2x+2)\\,\\text{d}x \\\\  & =\\int \\frac{1}{u}\\,\\text{d}u \\\\  & =\\operatorname{ln}⁡|u|+C \\\\  & =\\operatorname{ln}⁡|{x}^{2}+2x|+C\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186247402 :knowledge-point/_questions [{:db/id #edb/ref 17592186068786 :knowledge-point/id #uuid "03e934c8-da65-5615-9717-a50eee3577fd" :knowledge-point/title "Integrating Other Fractional Expressions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "387b1fd3-d0b6-5a4f-9f87-df4622619640" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{7}{5(3-{x}^{5})^{5}}+C" :db/id #edb/ref 17592186244813} {:answer/id #uuid "5a108ad3-8f59-57fb-86b0-8078293f3c34" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{25}{7(3-{x}^{5})^{5}}+C" :db/id #edb/ref 17592186245104} {:answer/id #uuid "64849b83-6c8e-5754-857d-65fbc670429e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{7}{25(3-{x}^{5})^{5}}+C" :db/id #edb/ref 17592186245200} {:answer/id #uuid "92481de8-22aa-54dd-8e3e-03c362cb4b5f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{7}{25(3-{x}^{5})^{5}}+C" :db/id #edb/ref 17592186245589} {:answer/id #uuid "d7b59bc3-4c29-5982-981f-e767a487ae12" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5}{7(3-{x}^{5})^{5}}+C" :db/id #edb/ref 17592186246233}] :answer-field/correct {:answer/id #uuid "92481de8-22aa-54dd-8e3e-03c362cb4b5f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{7}{25(3-{x}^{5})^{5}}+C" :db/id #edb/ref 17592186245589} :answer-field/id #uuid "a5979b9c-8e33-51cf-9331-a30916482816" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186246840}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "14745f6d-a16a-5fbf-98d1-0322f61ed9f2" :question/math-academy-id "q-113726" :question/problem "Calculate $\\int \\frac{7{x}^{4}}{{(3-{x}^{5})}^{6}}\\,\\text{d}x.$" :question/worked-solution "Let $u=3-{x}^{5}.$ Then\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=-5{x}^{4}\\,⟹\\,-\\frac{7}{5}\\text{d}u=7{x}^{4}\\,\\text{d}x,\n$$\n\nand we can solve the resulting integral as follows:\n\n$$\n\\begin{aligned}\\int \\frac{7{x}^{4}}{{(3-{x}^{5})}^{6}}\\,\\text{d}x & =\\int \\frac{1}{{(3-{x}^{5})}^{6}}\\cdot 7{x}^{4}\\,\\text{d}x \\\\  & =\\int \\frac{1}{{u}^{6}}\\cdot (-\\frac{7}{5})\\,\\text{d}u \\\\  & =-\\frac{7}{5}\\int \\frac{1}{{u}^{6}}\\,\\text{d}u \\\\  & =-\\frac{7}{5}(-\\frac{1}{5{u}^{5}})+C \\\\  & =\\frac{7}{25{u}^{5}}+C \\\\  & =\\frac{7}{25(3-{x}^{5})^{5}}+C\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186247405 :knowledge-point/_questions [{:db/id #edb/ref 17592186054610 :knowledge-point/id #uuid "078c9361-898f-5b9f-889e-c92442f882d9" :knowledge-point/title "Using the Constant Factor Rule to Integrate a Constant Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6a047b88-d760-555b-9e93-164a62866d3b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2}{5y}+C" :db/id #edb/ref 17592186245252} {:answer/id #uuid "95a7a62a-096c-53a6-9e63-99bffb683248" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2}{y}+C" :db/id #edb/ref 17592186245622} {:answer/id #uuid "a51fd8e4-b513-5c94-9774-6b4bdb6b2119" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{y}{10}+C" :db/id #edb/ref 17592186245797} {:answer/id #uuid "b43d5d61-14e6-5d21-a689-c9df2d507f9f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5}{2}y+C" :db/id #edb/ref 17592186245921} {:answer/id #uuid "f824863b-216c-5fb2-8443-c7b2f37cefa1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2}{5}y+C" :db/id #edb/ref 17592186246495}] :answer-field/correct {:answer/id #uuid "f824863b-216c-5fb2-8443-c7b2f37cefa1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2}{5}y+C" :db/id #edb/ref 17592186246495} :answer-field/id #uuid "b72ce3d4-25eb-5424-b4ec-a1a9ca20b6ff" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186246880}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "1e9f7c60-e13f-56df-879c-69f076975c52" :question/math-academy-id "q-113743" :question/problem "Calculate $\\int \\frac{2}{5}\\,\\text{d}y.$" :question/worked-solution "We can just take the constant factor out of the integral, and then apply the power rule:\n\n$$\n\\begin{aligned}\\int \\frac{2}{5}\\,\\text{d}y & =\\frac{2}{5}\\int 1\\,\\text{d}y \\\\  & =\\frac{2}{5}\\int {y}^{0}\\,\\text{d}y \\\\  & =\\frac{2}{5}\\cdot \\frac{{y}^{0+1}}{0+1}+C \\\\  & =\\frac{2}{5}\\cdot y+C \\\\  & =\\frac{2}{5}y+C\\end{aligned}\n$$\n\nIn general, we can see that for any constant $k,$ we have $\\int k\\,\\text{d}x=kx+C.$"}] [{:db/id #edb/ref 17592186250117 :knowledge-point/_questions [{:db/id #edb/ref 17592186068759 :knowledge-point/id #uuid "f149f8ef-dd7f-5f65-928e-534e1541f9b2" :knowledge-point/title "Dividing Rational Expressions with a Single Common Factor"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3138c09d-4d43-51c5-bead-0fdb778e1372" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5k}{2h}" :db/id #edb/ref 17592186247870} {:answer/id #uuid "31b53764-ce11-5727-886a-8d35ebdf717e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{kh}{2}" :db/id #edb/ref 17592186247876} {:answer/id #uuid "4536e350-3f2a-5750-abb4-9f26a11d9ba9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2hk}" :db/id #edb/ref 17592186248045} {:answer/id #uuid "a62285a7-f22e-5063-a1e7-ac6ebe678521" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{k}{5h}" :db/id #edb/ref 17592186248905} {:answer/id #uuid "eee7c8c3-97c8-59fa-9ad6-63ca4f761b48" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{k}{2h}" :db/id #edb/ref 17592186249521}] :answer-field/correct {:answer/id #uuid "eee7c8c3-97c8-59fa-9ad6-63ca4f761b48" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{k}{2h}" :db/id #edb/ref 17592186249521} :answer-field/id #uuid "1a8d3447-4499-5d0e-ad45-b2bcd7eff6ae" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186249715}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "d696dd66-1554-57e6-9d74-9c8f4a560ef5" :question/math-academy-id "q-113818" :question/problem "$\\frac{5}{h}÷\\frac{10}{k}=$" :question/worked-solution "To compute\n\n$$\n\\frac{5}{h}÷\\frac{10}{k},\n$$\n\nwe just need to multiply by the reciprocal of the divisor:\n\n$$\n\\begin{aligned}\\frac{5}{h}÷\\frac{10}{k} & = \\\\ \\frac{5}{h}\\cdot \\frac{k}{10} & = \\\\ \\frac{5k}{10h} & = \\\\ \\frac{\\cancel{5}\\cdot k}{\\cancel{5}\\cdot 2h} & = \\\\ \\frac{k}{2h} & \\end{aligned}\n$$\n\nNote that in the final step, we canceled out a common factor of $5$ in the numerator and denominator."}] [{:db/id #edb/ref 17592186250120 :knowledge-point/_questions [{:db/id #edb/ref 17592186068760 :knowledge-point/id #uuid "f7614a05-f221-5fda-b491-6893f44a1a5f" :knowledge-point/title "Dividing Rational Expressions with Multiple Common Factors"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "97c1c6ab-73c5-56f5-9fee-ca0a10e54db6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2(z-2)}{z+1}" :db/id #edb/ref 17592186248776} {:answer/id #uuid "a9625933-0685-5510-8621-3032717dd0ac" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{18(z-2)}{z+1}" :db/id #edb/ref 17592186248929} {:answer/id #uuid "b3efc6b8-c94f-51b9-8dc1-1921a321212b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{18}{z+1}" :db/id #edb/ref 17592186249034} {:answer/id #uuid "badd22b5-a641-5ad8-8db4-43458737b054" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{18(z+1)}{z-2}" :db/id #edb/ref 17592186249093} {:answer/id #uuid "ef35f532-0726-5061-9704-c32df9534b0c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2}{z+1}" :db/id #edb/ref 17592186249524}] :answer-field/correct {:answer/id #uuid "b3efc6b8-c94f-51b9-8dc1-1921a321212b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{18}{z+1}" :db/id #edb/ref 17592186249034} :answer-field/id #uuid "96e98c2b-f5b8-5971-a5f1-a27e14529d08" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186249939}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "fd3f875b-33f7-55de-93e3-693ddb1d2606" :question/math-academy-id "q-113826" :question/problem "Given that $\\frac{3(z-2)}{(z+1)^{2}}=a$ and $\\frac{z-2}{6(z+1)}=b,$ what is $a÷b?$" :question/worked-solution "To compute\n\n$$\na÷b=\\frac{3(z-2)}{(z+1)^{2}}÷\\frac{z-2}{6(z+1)},\n$$\n\nwe just need to multiply by the reciprocal of the divisor:\n\n$$\n\\begin{aligned}\\frac{3(z-2)}{(z+1)^{2}}÷\\frac{z-2}{6(z+1)} & = \\\\ \\frac{3(z-2)}{(z+1)^{2}}\\cdot \\frac{6(z+1)}{z-2} & = \\\\ \\frac{3\\cancel{(z-2)}}{(z+1)^{\\cancel{2}}}\\cdot \\frac{6\\cancel{(z+1)}}{\\cancel{(z-2)}} & = \\\\ \\frac{3}{z+1}\\cdot 6 & = \\\\ \\frac{18}{z+1}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186250126 :knowledge-point/_questions [{:db/id #edb/ref 17592186096630 :knowledge-point/id #uuid "89902023-09e6-50cd-b08a-9d3e82d826c9" :knowledge-point/title "Writing the Area Bounded by a Curve as a Definite Integral"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3245c48f-1a4d-5b3a-9824-8d88eff85902" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "A={\\int }_{0}^{3}({x}^{2}-2x+2)\\,\\text{d}x" :db/id #edb/ref 17592186247883} {:answer/id #uuid "630663c5-73ef-581c-8f85-9dab63b65145" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "A={\\int }_{-1}^{0}(-{x}^{2}+2x-2)\\,\\text{d}x" :db/id #edb/ref 17592186248322} {:answer/id #uuid "78f4a7cf-7d63-5517-b755-104a70761128" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "A={\\int }_{-3}^{0}(-{x}^{2}+2x-2)\\,\\text{d}x" :db/id #edb/ref 17592186248484} {:answer/id #uuid "907fc2ff-2b6f-5b81-8ef6-ee353873c46f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "A={\\int }_{-3}^{0}({x}^{2}-2x+2)\\,\\text{d}x" :db/id #edb/ref 17592186248707} {:answer/id #uuid "e0f6fe33-4274-5a92-8a81-3a822cd289e6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "A={\\int }_{-1}^{3}({x}^{2}-2x+2)\\,\\text{d}x" :db/id #edb/ref 17592186249414}] :answer-field/correct {:answer/id #uuid "3245c48f-1a4d-5b3a-9824-8d88eff85902" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "A={\\int }_{0}^{3}({x}^{2}-2x+2)\\,\\text{d}x" :db/id #edb/ref 17592186247883} :answer-field/id #uuid "31720fdc-70b9-5d97-9b44-5f4fe1d54cab" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186249760}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "63bcbbf8-c502-5d3b-bd0e-da913f8e74d5" :question/math-academy-id "q-113868" :question/problem "![](images/14/149fd953075c1d9909e036d4935ccd4f17ad1734d86bba4a70254468cd2035d5.png)\n\nFor the function $f(x)={x}^{2}-2x+2$ shown above, what is the expression for the area $A$ as a definite integral?" :question/worked-solution "We want to express the area $A$ between the function $f(x)={x}^{2}-2x+2$ and the $x$-axis, between $x=0$ and $x=3.$\n\nThis can be expressed as the definite integral of $f(x)={x}^{2}-2x+2$ between the lower limit $x=0$ and the upper limit $x=3,$ as follows:\n\n$$\nA={\\int }_{0}^{3}({x}^{2}-2x+2)\\,\\text{d}x\n$$"}] [{:db/id #edb/ref 17592186386717 :knowledge-point/_questions [{:db/id #edb/ref 17592186096631 :knowledge-point/id #uuid "cdc82e49-5df6-5096-a8fd-e00017fb1e3a" :knowledge-point/title "Expressing a Definite Integral as the Limit of a Left Riemann Sum"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7d1a6ba2-db64-573f-8e5b-b88ea8981842" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{lim}_{n\\to \\infty }{\\sum }_{i=0}^{n-1}[{e}^{3i/n}\\cdot \\frac{1}{3n}]" :db/id #edb/ref 17592186386719} {:answer/id #uuid "beae40ea-5a16-56be-94c0-5c319be8f0a9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{lim}_{n\\to \\infty }{\\sum }_{i=0}^{n-1}[{e}^{3i/n}\\cdot \\frac{3}{n}]" :db/id #edb/ref 17592186386720} {:answer/id #uuid "d70342b7-9d3b-5244-a755-c5e40ee84a60" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{lim}_{n\\to \\infty }{\\sum }_{i=0}^{n-1}[{e}^{i/n}\\cdot \\frac{1}{n}]" :db/id #edb/ref 17592186386721} {:answer/id #uuid "7758f4a7-e843-5572-bd52-fd33dee0bce2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{lim}_{n\\to \\infty }{\\sum }_{i=0}^{n-1}[{e}^{3i/n}\\cdot \\frac{1}{n}]" :db/id #edb/ref 17592186386722} {:answer/id #uuid "8503faec-27f0-534a-a1ff-592a3f1183d0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{lim}_{n\\to \\infty }{\\sum }_{i=0}^{n-1}[{e}^{i/n}\\cdot \\frac{3}{n}]" :db/id #edb/ref 17592186386723}] :answer-field/correct {:answer/id #uuid "beae40ea-5a16-56be-94c0-5c319be8f0a9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{lim}_{n\\to \\infty }{\\sum }_{i=0}^{n-1}[{e}^{3i/n}\\cdot \\frac{3}{n}]" :db/id #edb/ref 17592186386720} :answer-field/id #uuid "81eaba12-1887-5376-9908-1a56c2da3284" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186386718}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "a0fbe66e-c44a-5c47-b716-80288ecee20d" :question/math-academy-id "q-113880" :question/problem "What is ${\\int }_{0}^{3}{e}^{x}\\,\\text{d}x$ expressed as the limit of a left Riemann sum?" :question/worked-solution "The definite integral can be defined in terms of the limit of a left Riemann sum as\n\n$$\n{\\int }_{a}^{b}f(x)\\,\\text{d}x={lim}_{n\\to \\infty }{\\sum }_{i=0}^{n-1}f({x}_{i})\\cdot Δx,\n$$\n\n    \n\nwhere $Δx=\\frac{b-a}{n}$ and ${x}_{i}=a+iΔx.$\n\nIn the definite integral\n\n$$\n{\\int }_{0}^{3}{e}^{x}\\,\\text{d}x,\n$$\n\nthe function is $f(x)={e}^{x},$ the lower bound is $a=0,$ and the upper bound is $b=3.$ So, we have\n\n$$\nΔx=\\frac{3-0}{n}=\\frac{3}{n},\n$$\n\nand therefore\n\n$$\n\\begin{aligned}{\\int }_{0}^{3}{e}^{x}\\,\\text{d}x & ={lim}_{n\\to \\infty }{\\sum }_{i=0}^{n-1}f({x}_{i})\\cdot Δx \\\\  & ={lim}_{n\\to \\infty }{\\sum }_{i=0}^{n-1}[f(0+i\\cdot \\frac{3}{n})\\,\\cdot \\frac{3}{n}] \\\\  & ={lim}_{n\\to \\infty }{\\sum }_{i=0}^{n-1}[f(\\frac{3i}{n})\\cdot \\frac{3}{n}] \\\\  & ={lim}_{n\\to \\infty }{\\sum }_{i=0}^{n-1}[{e}^{3i/n}\\cdot \\frac{3}{n}].\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186250130 :knowledge-point/_questions [{:db/id #edb/ref 17592186064172 :knowledge-point/id #uuid "8bd8c6d8-0b11-5735-88a1-9b12e6315401" :knowledge-point/title "Integrating an Exponential Function With a General Base"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0558a391-cdbf-584c-a0f0-8f221f341cae" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{5}^{x}ln⁡5+C" :db/id #edb/ref 17592186247467} {:answer/id #uuid "06607b0a-9d24-576c-adf1-bdc2e55f52bb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{5}^{x}+C" :db/id #edb/ref 17592186247482} {:answer/id #uuid "22d652bf-3b5e-5181-8f0c-7123f5c17343" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{ln⁡x}{ln⁡5}+C" :db/id #edb/ref 17592186247734} {:answer/id #uuid "68d69094-f985-5c03-a478-6c0269a3cc32" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{5}^{x}}{ln⁡5}+C" :db/id #edb/ref 17592186248365} {:answer/id #uuid "99a53d55-830f-55db-ac33-a12525e3cd5a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5ln⁡x+C" :db/id #edb/ref 17592186248795}] :answer-field/correct {:answer/id #uuid "68d69094-f985-5c03-a478-6c0269a3cc32" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{5}^{x}}{ln⁡5}+C" :db/id #edb/ref 17592186248365} :answer-field/id #uuid "3eca50b8-7630-5d78-accd-b706994b9510" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186249782}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "333b8bc2-8d50-5f18-bbc4-8fbfe08b346d" :question/math-academy-id "q-113887" :question/problem "Calculate $\\int {5}^{x}\\,\\text{d}x.$" :question/worked-solution "To compute the integral of a general exponential function, we just need to divide by the natural logarithm of the base of the exponential function:\n\n$$\n\\begin{aligned}\\int {5}^{x}\\,\\text{d}x & =\\frac{{5}^{x}}{ln⁡5}+C\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186250134 :knowledge-point/_questions [{:db/id #edb/ref 17592186064178 :knowledge-point/id #uuid "0cae5c1b-57bd-51f6-a360-db946d25532f" :knowledge-point/title "Integrating Sine and Cosine"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "271c490c-5a05-5e0a-9c8e-cee6e93cd8b5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{6}cos⁡\\theta +C" :db/id #edb/ref 17592186247771} {:answer/id #uuid "39e2cf43-8568-5bca-98a7-54e900afc4d6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6cos⁡\\theta +C" :db/id #edb/ref 17592186247936} {:answer/id #uuid "8369302d-e75e-5f17-a44e-47eda2ef57fa" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-6sin⁡\\theta +C" :db/id #edb/ref 17592186248585} {:answer/id #uuid "8f10e1a5-527b-5f97-860b-39eca916d8f7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6sin⁡\\theta +C" :db/id #edb/ref 17592186248696} {:answer/id #uuid "a8b91066-0304-5eec-9198-3b7d46a0b0c8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-6cos⁡\\theta +C" :db/id #edb/ref 17592186248923}] :answer-field/correct {:answer/id #uuid "39e2cf43-8568-5bca-98a7-54e900afc4d6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6cos⁡\\theta +C" :db/id #edb/ref 17592186247936} :answer-field/id #uuid "d679155c-4e3c-59a8-a851-7bdacacd637d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186250043}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "4099e9a0-92e6-5376-9bf3-b36d248db1d1" :question/math-academy-id "q-113907" :question/problem "$\\int (-6sin⁡\\theta )\\,\\text{d}\\theta =$" :question/worked-solution "Recall that\n\n$$\n\\int sin⁡\\theta \\,\\text{d}\\theta =-cos⁡\\theta +C.\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}\\begin{aligned}\\int (-6sin⁡\\theta )\\,\\text{d}\\theta  & =-6\\int sin⁡\\theta \\,\\text{d}\\theta  \\\\  & =-6(-cos⁡\\theta )+C \\\\  & =6cos⁡\\theta +C.\\end{aligned}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186250138 :knowledge-point/_questions [{:db/id #edb/ref 17592186064179 :knowledge-point/id #uuid "e617f241-254b-5f70-9937-5883b6f28c4f" :knowledge-point/title "Integrating Secant-Tangent and Cosecant-Cotangent"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2a6b2d77-6333-57e0-afd5-ae25cfed1172" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3sec⁡xcot⁡x+C" :db/id #edb/ref 17592186247800} {:answer/id #uuid "558aa8a6-6ebf-5d3f-a5a9-3b19d8e488c1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3csc⁡x+C" :db/id #edb/ref 17592186248195} {:answer/id #uuid "73fffa3b-03d4-5a40-b567-70c7ae4ccf96" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3csc⁡x+C" :db/id #edb/ref 17592186248445} {:answer/id #uuid "a4b2a2ae-e079-58a1-a369-536f12c56dbc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3sec⁡x+C" :db/id #edb/ref 17592186248893} {:answer/id #uuid "acbcb4c2-9b18-5aa7-84c2-3dabda9f77dd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3sec⁡x+C" :db/id #edb/ref 17592186248966}] :answer-field/correct {:answer/id #uuid "73fffa3b-03d4-5a40-b567-70c7ae4ccf96" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3csc⁡x+C" :db/id #edb/ref 17592186248445} :answer-field/id #uuid "c3fad684-5e9d-51a7-9e19-ea6cfd103f16" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186250006}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "0ba0c93b-e27b-584f-9b8e-5ad2b653f757" :question/math-academy-id "q-113920" :question/problem "$\\int -3csc⁡x\\,cot⁡x\\,\\text{d}x=$" :question/worked-solution "Recall that\n\n$$\n\\int csc⁡xcot⁡x\\,\\text{d}x=-csc⁡x+C.\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}\\begin{aligned}\\int -3csc⁡x\\,cot⁡x\\,\\text{d}x & =-3\\int csc⁡xcot⁡x\\,\\text{d}x \\\\  & =-3(-csc⁡x)+C \\\\  & =3csc⁡x+C.\\end{aligned}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186386730 :knowledge-point/_questions [{:db/id #edb/ref 17592186096633 :knowledge-point/id #uuid "29b136d3-69bc-51ef-a262-dbee8af377d2" :knowledge-point/title "Expressing a Definite Integral as the Limit of a Right Riemann Sum"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5e817c90-73b6-5e40-a4cb-de6f65f4e504" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{lim}_{n\\to \\infty }{\\sum }_{k=1}^{n}[\\operatorname{arctan}⁡(\\frac{k}{n})\\cdot \\frac{1}{n}]" :db/id #edb/ref 17592186386732} {:answer/id #uuid "eec77c43-6c27-5f35-9de9-91342da5f4f9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{lim}_{n\\to \\infty }{\\sum }_{k=1}^{n}[\\operatorname{arctan}⁡(\\frac{3k}{n})\\cdot \\frac{3}{n}]" :db/id #edb/ref 17592186386733} {:answer/id #uuid "f138b282-2b50-5da5-af3e-9f5891074c43" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{lim}_{n\\to \\infty }{\\sum }_{k=1}^{n}[\\operatorname{arctan}⁡(\\frac{k}{3n})\\cdot \\frac{3}{n}]" :db/id #edb/ref 17592186386734} {:answer/id #uuid "69e645c6-0c73-5a1c-a257-403a41a6eca2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{lim}_{n\\to \\infty }{\\sum }_{k=1}^{n}[\\operatorname{arctan}⁡(\\frac{3k}{n})\\cdot \\frac{1}{n}]" :db/id #edb/ref 17592186386735} {:answer/id #uuid "dce1be34-b20a-5bb8-891d-5f521a6ed79b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{lim}_{n\\to \\infty }{\\sum }_{k=1}^{n}[\\operatorname{arctan}⁡(\\frac{3k}{n})\\cdot \\frac{1}{3n}]" :db/id #edb/ref 17592186386736}] :answer-field/correct {:answer/id #uuid "eec77c43-6c27-5f35-9de9-91342da5f4f9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{lim}_{n\\to \\infty }{\\sum }_{k=1}^{n}[\\operatorname{arctan}⁡(\\frac{3k}{n})\\cdot \\frac{3}{n}]" :db/id #edb/ref 17592186386733} :answer-field/id #uuid "1438f8f6-1b0c-5edd-937f-a796652639f0" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186386731}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "0af12d5f-0f9a-59ff-b6c2-207d86cde81b" :question/math-academy-id "q-113929" :question/problem "What is ${\\int }_{0}^{3}\\operatorname{arctan}⁡x\\,\\text{d}x$ expressed as the limit of a right Riemann sum?" :question/worked-solution "The definite integral can be defined in terms of the limit of a right Riemann sum as\n\n$$\n{\\int }_{a}^{b}f(x)\\,\\text{d}x={lim}_{n\\to \\infty }{\\sum }_{k=1}^{n}f({x}_{k})\\cdot Δx,\n$$\n\nwhere ${x}_{k}=a+kΔx$ and $Δx=\\frac{b-a}{n}.$\n\nIn the definite integral\n\n$$\n{\\int }_{0}^{3}\\operatorname{arctan}⁡x\\,\\text{d}x,\n$$\n\nthe function is $f(x)=\\operatorname{arctan}⁡x,$ the lower bound is $a=0$ and the upper bound is $b=3.$ So, we have\n\n$$\nΔx=\\frac{3-0}{n}=\\frac{3}{n}.\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}{\\int }_{0}^{3}\\operatorname{arctan}⁡x\\,\\text{d}x & ={lim}_{n\\to \\infty }{\\sum }_{k=1}^{n}f({x}_{k})\\cdot Δx \\\\  & ={lim}_{n\\to \\infty }{\\sum }_{k=1}^{n}[f(0+k\\cdot \\frac{3}{n})\\cdot \\frac{3}{n}] \\\\  & ={lim}_{n\\to \\infty }{\\sum }_{k=1}^{n}[f(\\frac{3k}{n})\\cdot \\frac{3}{n}] \\\\  & ={lim}_{n\\to \\infty }{\\sum }_{k=1}^{n}[\\operatorname{arctan}⁡(\\frac{3k}{n})\\cdot \\frac{3}{n}].\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186250142 :knowledge-point/_questions [{:db/id #edb/ref 17592186064180 :knowledge-point/id #uuid "caf358b8-31fb-5587-8663-f414317c42be" :knowledge-point/title "Integrating Secant Squared"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0a394ebb-e724-5257-b2b3-c6ee24c9c0ee" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2sec⁡\\theta +C" :db/id #edb/ref 17592186247513} {:answer/id #uuid "645e7853-d773-51a7-97f0-145e363f5063" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2csc⁡\\theta +C" :db/id #edb/ref 17592186248330} {:answer/id #uuid "a159c48f-05f8-5b71-ac43-7e38b5032b08" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-{csc}^{2}⁡\\theta +C" :db/id #edb/ref 17592186248866} {:answer/id #uuid "cb0b4d51-0534-5643-95e4-f3c845c225d3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{tan}^{2}⁡\\theta +C" :db/id #edb/ref 17592186249233} {:answer/id #uuid "ee2434c9-75b3-5a4f-85a5-13b29917e9e5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2tan⁡\\theta +C" :db/id #edb/ref 17592186249513}] :answer-field/correct {:answer/id #uuid "ee2434c9-75b3-5a4f-85a5-13b29917e9e5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2tan⁡\\theta +C" :db/id #edb/ref 17592186249513} :answer-field/id #uuid "0726a333-67f4-5bae-9092-988faf871214" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186249681}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "1eae0c2a-9fbb-58f9-9e02-1ea035b71ceb" :question/math-academy-id "q-113936" :question/problem "$\\int 2{sec}^{2}⁡\\theta \\,\\text{d}\\theta =$" :question/worked-solution "Recall that \n\n$$\n\\int {sec}^{2}⁡\\theta \\,\\text{d}\\theta =tan⁡\\theta +C\n$$\n\nTherefore, we get\n\n$$\n\\begin{aligned}\\begin{aligned}\\int 2{sec}^{2}⁡\\theta \\,\\text{d}\\theta  & =2\\int {sec}^{2}⁡\\theta \\,\\text{d}\\theta  \\\\  & =2tan⁡\\theta +C.\\end{aligned}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186250147 :knowledge-point/_questions [{:db/id #edb/ref 17592186064197 :knowledge-point/id #uuid "15bd1f67-6361-55f7-ba25-07e54aad8f66" :knowledge-point/title "Evaluating the Definite Integral of a Rational Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "455009c1-cd1b-5980-bebc-005c166aaab0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{47}{243}" :db/id #edb/ref 17592186248047} {:answer/id #uuid "896f555a-8df1-54e2-8351-8c2d255e5f6f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{26}{81}" :db/id #edb/ref 17592186248645} {:answer/id #uuid "af350e46-2ecb-56b8-977a-f33f11df9722" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{26}{27}" :db/id #edb/ref 17592186248994} {:answer/id #uuid "c7fb154d-0bb2-50c5-a991-8b8bf26ab955" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{13}{27}" :db/id #edb/ref 17592186249203} {:answer/id #uuid "e7b780a7-5d64-5db2-a401-0d776743ab54" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{13}{81}" :db/id #edb/ref 17592186249470}] :answer-field/correct {:answer/id #uuid "896f555a-8df1-54e2-8351-8c2d255e5f6f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{26}{81}" :db/id #edb/ref 17592186248645} :answer-field/id #uuid "1c672aeb-3770-5ff7-9ee1-eb36a7e65af5" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186249719}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "e8ba6724-aa4a-53a8-8ea0-e040d768a286" :question/math-academy-id "q-113989" :question/problem "${\\int }_{-3}^{-1}{x}^{-4}\\,\\text{d}x=$" :question/worked-solution "Taking the antiderivative and evaluating the difference at the bounds, we get\n\n$$\n\\begin{aligned}{\\int }_{-3}^{-1}{x}^{-4}\\,\\text{d}x & =\\frac{{x}^{-4+1}}{(-4+1)}{|}_{-3}^{-1} \\\\  & =\\frac{{x}^{-3}}{(-3)}{|}_{-3}^{-1} \\\\  & =-\\frac{1}{3{x}^{3}}{|}_{-3}^{-1} \\\\  & =-(\\frac{1}{3(-1)^{3}}-\\frac{1}{3(-3)^{3}}) \\\\  & =-(-\\frac{1}{3}+\\frac{1}{81}) \\\\  & =-(-\\frac{26}{81}) \\\\  & =\\frac{26}{81}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186250162 :knowledge-point/_questions [{:db/id #edb/ref 17592186064182 :knowledge-point/id #uuid "90033e91-fdb2-5aa0-8cce-76762a38ffd2" :knowledge-point/title "Integrating Using Arcsine"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "68b10feb-2180-5f4b-affc-efda6877e76e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2arccscx+C" :db/id #edb/ref 17592186248364} {:answer/id #uuid "6aec3579-b361-56d6-a432-c946f704be8f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2\\operatorname{arctan}⁡x+C" :db/id #edb/ref 17592186248375} {:answer/id #uuid "da0de2de-876a-5403-b74e-22394befed75" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2arcsecx+C" :db/id #edb/ref 17592186249349} {:answer/id #uuid "ed63bc4d-a191-52f9-8099-1ca3eac1e754" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\operatorname{cot}⁡x+C" :db/id #edb/ref 17592186249506} {:answer/id #uuid "f89181c8-7cac-5b50-aded-bef01ac1683b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2\\operatorname{arcsin}⁡x+C" :db/id #edb/ref 17592186249591}] :answer-field/correct {:answer/id #uuid "f89181c8-7cac-5b50-aded-bef01ac1683b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2\\operatorname{arcsin}⁡x+C" :db/id #edb/ref 17592186249591} :answer-field/id #uuid "1e8c0466-86ee-546f-9d46-8a6ca5c6d092" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186249724}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "620c9fa2-b98d-514c-8603-da573e96fa60" :question/math-academy-id "q-114026" :question/problem "$\\int \\frac{-2}{\\sqrt{1-{x}^{2}}}\\,\\text{d}x=$" :question/worked-solution "Recall that \n\n$$\n\\int \\frac{1}{\\sqrt{1-{x}^{2}}}\\text{d}x=\\operatorname{arcsin}⁡x+C.\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}\\begin{aligned}\\int \\frac{-2}{\\sqrt{1-{x}^{2}}}\\,\\text{d}x & =-2\\int \\frac{1}{\\sqrt{1-{x}^{2}}}\\,\\text{d}x \\\\  & =-2\\operatorname{arcsin}⁡x+C.\\end{aligned}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186250194 :knowledge-point/_questions [{:db/id #edb/ref 17592186064183 :knowledge-point/id #uuid "d7256d2e-7105-5a4e-8d0a-5e00dfc1e311" :knowledge-point/title "Integrating Using Arctangent"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "31bd6778-18b0-5ff5-8b99-5a553e76b73e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{x}^{2}}{2}-2\\operatorname{arcsin}⁡x+C" :db/id #edb/ref 17592186247877} {:answer/id #uuid "4a97465c-2eb1-5200-9609-a38e8e5419dd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{x}^{2}\\operatorname{arccos}⁡x+C" :db/id #edb/ref 17592186248089} {:answer/id #uuid "5170f02c-e217-5a70-9d06-19689007bd09" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{x}^{2}\\operatorname{arctan}⁡x+C" :db/id #edb/ref 17592186248155} {:answer/id #uuid "70c0b236-95a4-5fec-9b61-50baea92bf78" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{x}^{2}}{2}+2\\operatorname{arctan}⁡x+C" :db/id #edb/ref 17592186248412} {:answer/id #uuid "bb0c8113-6440-560f-bdcf-41c0564064c8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{x}^{2}}{2}+2\\operatorname{sec}⁡x+C" :db/id #edb/ref 17592186249095}] :answer-field/correct {:answer/id #uuid "70c0b236-95a4-5fec-9b61-50baea92bf78" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{x}^{2}}{2}+2\\operatorname{arctan}⁡x+C" :db/id #edb/ref 17592186248412} :answer-field/id #uuid "c16c266a-b08e-5ef0-9fc4-f4220c1b8349" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186250002}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "2a79dcdc-c1c8-5a71-9d84-cbbd212d39b8" :question/math-academy-id "q-114156" :question/problem "$\\int (x+\\frac{2}{1+{x}^{2}})\\text{d}x=$" :question/worked-solution "Recall that \n\n$$\n\\int \\frac{1}{1+{x}^{2}}\\text{d}x=\\operatorname{arctan}⁡x+C.\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}\\int (x+\\frac{2}{1+{x}^{2}})\\text{d}x & =\\int x\\,\\text{d}x+\\int \\frac{2}{1+{x}^{2}}\\,\\text{d}x \\\\  & =\\int x\\,\\text{d}x+2\\int \\frac{1}{1+{x}^{2}}\\,\\text{d}x \\\\  & =\\frac{{x}^{2}}{2}+2\\operatorname{arctan}⁡x+C.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186250196 :knowledge-point/_questions [{:db/id #edb/ref 17592186064170 :knowledge-point/id #uuid "67f41769-a0ff-5ecc-8b05-5890a7ac9fe3" :knowledge-point/title "Integrating Using Arcsecant"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "41556b45-6566-5d35-a32f-9aedd70af148" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-arcsec12x+C" :db/id #edb/ref 17592186248004} {:answer/id #uuid "a265277f-a558-5b79-8aaf-a6ba74ffc423" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-12arcsecx+C" :db/id #edb/ref 17592186248874} {:answer/id #uuid "d936202f-1fd4-5b76-893e-473a9d4de4ab" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-12arctanx+C" :db/id #edb/ref 17592186249341} {:answer/id #uuid "ede6325d-4880-5db4-a203-b3e4e58e2c5a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "arctan12x+C" :db/id #edb/ref 17592186249510} {:answer/id #uuid "fe6d4fa2-8f57-5607-990f-63d3e9fd166e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "12arcsinx+C" :db/id #edb/ref 17592186249650}] :answer-field/correct {:answer/id #uuid "a265277f-a558-5b79-8aaf-a6ba74ffc423" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-12arcsecx+C" :db/id #edb/ref 17592186248874} :answer-field/id #uuid "0b16d465-2ab3-5fbc-b5c1-6f20a32dcef9" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186249688}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "337f64c2-ac77-50d2-b155-e1f75e2f921e" :question/math-academy-id "q-114162" :question/problem "$\\int -\\frac{12}{|x|\\sqrt{{x}^{2}-1}}\\,\\text{d}x=$" :question/worked-solution "Recall that\n\n$$\n\\int \\frac{1}{|x|\\sqrt{{x}^{2}-1}}\\,\\text{d}x=\\text{arcsec}\\,x.\n$$\n\nThen we have\n\n$$\n\\begin{aligned}\\begin{aligned}\\int -\\frac{12}{|x|\\sqrt{{x}^{2}-1}}\\,\\text{d}x & =-12\\int \\frac{1}{|x|\\sqrt{{x}^{2}-1}}\\,\\text{d}x \\\\  & =-12arcsecx+C.\\end{aligned}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186250202 :knowledge-point/_questions [{:db/id #edb/ref 17592186064185 :knowledge-point/id #uuid "8e6b5d85-0b53-580f-9520-6c33463231d5" :knowledge-point/title "Integrating Using Inverse Trigonometric Functions and Some Manipulations"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "573f0bf8-8c3a-5fd3-87b0-1f98d36645e3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x-5\\operatorname{arctan}⁡x+C" :db/id #edb/ref 17592186248215} {:answer/id #uuid "7df83fc4-3a1c-5b4e-9334-3a07c3e58e5f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5x-5\\operatorname{arctan}⁡x+C" :db/id #edb/ref 17592186248529} {:answer/id #uuid "857ce7ea-a4b4-5485-b3d8-49d024d15f0b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5x+5\\operatorname{arctan}⁡x+C" :db/id #edb/ref 17592186248613} {:answer/id #uuid "881c84d2-e368-5509-bb5a-80ca75c9ca6c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2x+3\\operatorname{arctan}⁡x+C" :db/id #edb/ref 17592186248639} {:answer/id #uuid "994d053b-d19e-559c-a29d-2a8054864f41" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x+5\\operatorname{arctan}⁡x+C" :db/id #edb/ref 17592186248792}] :answer-field/correct {:answer/id #uuid "7df83fc4-3a1c-5b4e-9334-3a07c3e58e5f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5x-5\\operatorname{arctan}⁡x+C" :db/id #edb/ref 17592186248529} :answer-field/id #uuid "7223fe64-f45f-5bb2-b016-eb100aa48182" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186249866}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "5d5fd5d6-3989-51af-a4dc-33f4a2f20e44" :question/math-academy-id "q-114183" :question/problem "$\\int \\frac{5{x}^{2}}{{x}^{2}+1}\\,\\text{d}x=$" :question/worked-solution "This integral doesn't look like one of the basic ones. However, we can manipulate the numerator a bit  to make it look more like the denominator, which reveals a more familiar expression:\n\n$$\n\\begin{aligned}\\frac{5{x}^{2}}{{x}^{2}+1} & =\\frac{5{x}^{2}+5-5}{{x}^{2}+1} \\\\  & =\\frac{5({x}^{2}+1)-5}{{x}^{2}+1} \\\\  & =\\frac{5({x}^{2}+1)}{{x}^{2}+1}-\\frac{5}{{x}^{2}+1} \\\\  & =\\frac{5\\cancel{({x}^{2}+1)}}{\\cancel{{x}^{2}+1}}-\\frac{5}{{x}^{2}+1} \\\\  & =5-\\frac{5}{{x}^{2}+1}\\end{aligned}\n$$\n\nRemembering that\n\n$$\n\\int \\frac{1}{{x}^{2}+1}\\text{d}x=\\operatorname{arctan}⁡x,\n$$\n\nwe can now calculate the integral and get\n\n$$\n\\begin{aligned}\\begin{aligned}\\int \\frac{5{x}^{2}}{{x}^{2}+1}\\,\\text{d}x & =\\int (5-\\frac{5}{{x}^{2}+1})\\text{d}x \\\\  & =5\\int \\text{d}x-5\\int \\frac{1}{{x}^{2}+1}\\,\\text{d}x \\\\  & =5x-5\\operatorname{arctan}⁡x+C.\\end{aligned}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186250241 :knowledge-point/_questions [{:db/id #edb/ref 17592186073810 :knowledge-point/id #uuid "522b66f4-8a46-5dd0-a9d7-3b081c0ed157" :knowledge-point/title "Finding the Distance Between a Point and a Horizontal or Vertical Line"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1b1feabb-d80c-59ec-8f66-d72d31498c1b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186247669} {:answer/id #uuid "42c0433e-7aaf-5761-81da-33fe01ca9740" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "7" :db/id #edb/ref 17592186248020} {:answer/id #uuid "84f2ec16-f076-58cc-9d96-6046d0c047cf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186248604} {:answer/id #uuid "a2228bab-407a-5173-8ec9-6f138869205f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186248871} {:answer/id #uuid "da8f8caf-52fa-57a4-9034-247fa54a5c3a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186249355}] :answer-field/correct {:answer/id #uuid "1b1feabb-d80c-59ec-8f66-d72d31498c1b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186247669} :answer-field/id #uuid "7bbc3278-eb17-5700-bb41-ce67c5754955" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186249883}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "a7327f68-1eda-5ad2-867d-ca3941f336b9" :question/math-academy-id "q-114323" :question/problem "Find the shortest distance between the point $(4,3)$ and the line $x=2.$" :question/worked-solution "Let's sketch the given situation.\n\n![](images/ea/ea64c0752738b0c917d897060351cdd43ed7bbf687cc20781b7241ee3be0ad3c.png)\n\nSince the line $x=2$ is a vertical line, the shortest distance between this line and the point $(4,3)$ is given by the absolute value of the difference between the $x$-coordinate of the point and $2.$ \n\nSo, the shortest distance is\n\n$$\nd=|4-2|=2.\n$$"}] [{:db/id #edb/ref 17592186250247 :knowledge-point/_questions [{:db/id #edb/ref 17592186073811 :knowledge-point/id #uuid "d7030a12-bd18-5f8b-84eb-28b6f216f972" :knowledge-point/title "Finding the Distance Between a Point and a Line"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0dc625ac-31af-5204-8aa1-d135161d7f0d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186247552} {:answer/id #uuid "0ef14e40-61a3-5e9d-8570-f753f7cc4507" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4\\sqrt{2}" :db/id #edb/ref 17592186247562} {:answer/id #uuid "17d12124-8c76-5d6d-96b2-2686e53d0068" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8\\sqrt{2}" :db/id #edb/ref 17592186247640} {:answer/id #uuid "2e6ebd32-522e-573e-b812-a47b4e052305" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186247836} {:answer/id #uuid "80085e2c-2862-5780-b8b7-faf2920e4807" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\sqrt{2}" :db/id #edb/ref 17592186248548}] :answer-field/correct {:answer/id #uuid "0ef14e40-61a3-5e9d-8570-f753f7cc4507" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4\\sqrt{2}" :db/id #edb/ref 17592186247562} :answer-field/id #uuid "54362198-2ea2-5313-8e36-1d82209afe8b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186249825}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "633d0fd6-e7a8-521b-a27a-54658471a6ed" :question/math-academy-id "q-114343" :question/problem "Find the shortest distance between the point $(-1,5)$ and the line $y=x-2.$" :question/worked-solution "Let's draw a diagram describing our situation. \n\n![](images/02/021b08ba0d14e40939103d6d3e9e2004d49e5d047a5f89677b3fe542aa866f82.png)\n\n \n\nFirst, we find the equation of the line that's perpendicular to $y=x-2$ and passes through the point $(-1,5).$\n\nThe given line has a slope of $1,$ so our perpendicular line must have a slope of $-1.$\n\nUsing point-slope form and simplifying, we obtain the equation of the perpendicular line:\n\n$$\n\\begin{aligned}y-{y}_{1} & =m(x-{x}_{1}) \\\\ y-5 & =-(x+1) \\\\ y & =-x-1+5 \\\\ y & =-x+4\\end{aligned}\n$$\n\nWe now find the point where the two lines intersect. To do this, we solve the following system of equations:\n\n$$\n{\\begin{aligned}y=x-2 \\\\ y=-x+4\\end{aligned}\n$$\n\nWe can solve this system by putting the two equations equal to one another and solving for $x.$ This gives\n\n$$\n\\begin{aligned}x-2 & =-x+4 \\\\ x+x & =4+2 \\\\ 2x & =6 \\\\ x & =3.\\end{aligned}\n$$\n\nSubstituting $x=3$ into either of the two equations gives $y=1.$ So, our solution is $x=3$ and $y=1.$ Therefore, the lines intersect at the point $(3,1).$\n\nFinally, we find the distance $d$ between the points $(-1,5)$ and $(3,1):$\n\n$$\n\\begin{aligned}d & =\\sqrt{({x}_{2}-{x}_{1})^{2}+({y}_{2}-{y}_{1})^{2}} \\\\  & =\\sqrt{(3+1)^{2}+(1-5)^{2}} \\\\  & =\\sqrt{(4)^{2}+(-4)^{2}} \\\\  & =\\sqrt{16+16} \\\\  & =4\\sqrt{2}\\end{aligned}\n$$\n\nTherefore, we conclude that the shortest distance between the point $(-1,5)$ and the line $y=x-2$ is $4\\sqrt{2}.$"}] [{:db/id #edb/ref 17592186250248 :knowledge-point/_questions [{:db/id #edb/ref 17592186073815 :knowledge-point/id #uuid "59d3a391-c163-5a04-944c-5d61a3950e03" :knowledge-point/title "Finding a Point on a Line That Is Closest to a Given Point"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "072e45bc-d35a-54a2-8ab9-5f295ebf110f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(\\frac{3}{13},\\frac{11}{13})" :db/id #edb/ref 17592186247490} {:answer/id #uuid "14581a73-ac53-505c-8447-0394a875fcd8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(\\frac{3}{13},-\\frac{11}{13})" :db/id #edb/ref 17592186247608} {:answer/id #uuid "6cb5a940-7e41-5de0-9f76-33adbc3d81da" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-\\frac{3}{13},\\frac{11}{13})" :db/id #edb/ref 17592186248386} {:answer/id #uuid "bd6d5bb5-c38f-58f9-bdcf-296b1625b1d6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(\\frac{11}{13},\\frac{3}{13})" :db/id #edb/ref 17592186249109} {:answer/id #uuid "de549bfd-d213-57c1-ad88-fadc596d833b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(3,11)" :db/id #edb/ref 17592186249395}] :answer-field/correct {:answer/id #uuid "072e45bc-d35a-54a2-8ab9-5f295ebf110f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(\\frac{3}{13},\\frac{11}{13})" :db/id #edb/ref 17592186247490} :answer-field/id #uuid "a5d3e168-c279-50d0-a119-0930eb63b6db" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186249960}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "dd8e8e07-0b88-58f7-806a-13412093afb7" :question/math-academy-id "q-114345" :question/problem "![](images/ff/ff9810290868f7fd465bc310c969255b92f646d6b59ad71a93a3dcc9c38ef49c.png)\n\nFind the point on the line $3y+2x=3$ that is closest to the point $(3,5).$" :question/worked-solution "First, we rewrite the equation of the given line in slope-intercept form:\n\n$$\n\\begin{aligned}3y+2x & =3 \\\\ 3y & =-2x+3 \\\\ y & =-\\frac{2}{3}x+1\\end{aligned}\n$$\n\nNext, we find the equation of the line that's perpendicular to $y=-\\frac{2}{3}x+1$ and passes through the point $(3,5).$\n\nThe given line has a slope of $-\\frac{2}{3},$ so our perpendicular line must have a slope of $\\frac{3}{2}.$\n\nUsing point-slope form and simplifying, we obtain the equation of the perpendicular line:\n\n$$\n\\begin{aligned}y-{y}_{1} & =m(x-{x}_{1}) \\\\ y-5 & =\\frac{3}{2}(x-3) \\\\ y & =\\frac{3}{2}x-\\frac{9}{2}+5 \\\\ y & =\\frac{3}{2}x+\\frac{1}{2}\\end{aligned}\n$$\n\nWe now find the point where the two lines intersect. To do this, we solve the following system of equations:\n\n$$\n{\\begin{aligned}y=-\\frac{2}{3}x+1 \\\\ y=\\frac{3}{2}x+\\frac{1}{2}\\end{aligned}\n$$\n\nWe can solve this system by putting the two equations equal to one another and solving for $x.$ This gives\n\n$$\n\\begin{aligned}-\\frac{2}{3}x+1 & =\\frac{3}{2}x+\\frac{1}{2} \\\\ -\\frac{2}{3}x-\\frac{3}{2}x & =\\frac{1}{2}-1 \\\\ -\\frac{13}{6}x & =-\\frac{1}{2} \\\\ x & =\\frac{3}{13}.\\end{aligned}\n$$\n\nSubstituting $x=\\frac{3}{13}$ into either of the two equations gives $y=\\frac{11}{13}.$ So, our solution is $x=\\frac{3}{13}$ and $y=\\frac{11}{13}.$ So, the lines intersect at the point $(\\frac{3}{13},\\frac{11}{13}).$\n\nTherefore, we conclude that the point on the line  $3y+2x=3$ that is closest to the point $(3,5)$ is  $(\\frac{3}{13},\\frac{11}{13}).$"}] [{:db/id #edb/ref 17592186054967 :knowledge-point/_questions [{:db/id #edb/ref 17592186054648 :knowledge-point/id #uuid "9a248b79-7e8b-5ad8-b2e8-847ac2030783" :knowledge-point/title "Adding Square Matrices"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a55f584c-0261-59b4-bb28-5df04c5e5bd6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}6 & 6 \\\\ 1 & 3\\end{bmatrix}" :db/id #edb/ref 17592186051333} {:answer/id #uuid "df503ec5-393a-5e2d-b982-c56e35aaa181" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}5 & 2 \\\\ 1 & 3\\end{bmatrix}" :db/id #edb/ref 17592186051334} {:answer/id #uuid "03de6fb6-f81c-5d37-a647-7b5873b78089" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}5 & 5 \\\\ 5 & 5\\end{bmatrix}" :db/id #edb/ref 17592186051335} {:answer/id #uuid "423881fd-5f5f-52b5-95c3-bdb632772bba" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-6 & 6 \\\\ 1 & -3\\end{bmatrix}" :db/id #edb/ref 17592186051336} {:answer/id #uuid "4cb4b1ee-1844-5475-bfe1-7abebf91b3b8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}6 & 6 \\\\ 6 & 6\\end{bmatrix}" :db/id #edb/ref 17592186051337}] :answer-field/id #uuid "8876c980-9b7f-5aa5-b5a7-7c5722252f32" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186051332} {:answer-field/choices [{:answer/id #uuid "a6e60215-8077-5f8c-8c55-359a0a908320" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}5 & 2 \\\\ 1 & 3\\end{aligned}]" :db/id #edb/ref 17592186386738} {:answer/id #uuid "29d738c0-81db-5e6c-91c9-db679852e3b4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}-6 & 6 \\\\ 1 & -3\\end{aligned}]" :db/id #edb/ref 17592186386739} {:answer/id #uuid "20fa7a5b-5a7b-5d2e-91fe-afbafad3502d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}6 & 6 \\\\ 6 & 6\\end{aligned}]" :db/id #edb/ref 17592186386740} {:answer/id #uuid "f1d7ca1e-94f6-54ec-80f6-9ab401480cbc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}6 & 6 \\\\ 1 & 3\\end{aligned}]" :db/id #edb/ref 17592186386741} {:answer/id #uuid "8751a674-6cb2-575b-98a1-e1863e33ff8f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}5 & 5 \\\\ 5 & 5\\end{aligned}]" :db/id #edb/ref 17592186386742}] :answer-field/correct {:answer/id #uuid "f1d7ca1e-94f6-54ec-80f6-9ab401480cbc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}6 & 6 \\\\ 1 & 3\\end{aligned}]" :db/id #edb/ref 17592186386741} :answer-field/id #uuid "1ce63358-0fcc-55be-a22f-c3c4afd97cf2" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186386737}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "06528850-f3e1-5360-9392-bba2a3bf7deb" :question/math-academy-id "q-11440" :question/problem "Calculate $A+B$, where\n\n$$\nA=[\\begin{aligned}2 & 5 \\\\ 3 & 1\\end{aligned}],\\,B=[\\begin{aligned}4 & 1 \\\\ -2 & 2\\end{aligned}].\n$$" :question/worked-solution "We add the corresponding entries:\n\n$$\n\\begin{aligned}A+B & =[\\begin{aligned}2 & 5 \\\\ 3 & 1\\end{aligned}]+[\\begin{aligned}4 & 1 \\\\ -2 & 2\\end{aligned}] \\\\  & =[\\begin{aligned}2+4 & 5+1 \\\\ 3+(-2) & 1+2\\end{aligned}] \\\\  & =[\\begin{aligned}6 & 6 \\\\ 1 & 3\\end{aligned}]\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186250333 :knowledge-point/_questions [{:db/id #edb/ref 17592186157442 :knowledge-point/id #uuid "bf6a3dbb-52b3-5384-b640-0fbf29a6cc98" :knowledge-point/title "Solving an Inequality Involving a Cube Root"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2f66da87-fd41-50fb-b1c2-717ae0591859" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x\\le 13" :db/id #edb/ref 17592186247850} {:answer/id #uuid "2ffb2392-7201-5c3f-88bc-392e23cd505a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x\\le 3" :db/id #edb/ref 17592186247855} {:answer/id #uuid "32b16bed-d3ba-546b-bd37-eb68ce75789b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x\\ge -10" :db/id #edb/ref 17592186247885} {:answer/id #uuid "4204141e-6e99-5199-acf5-81445a1bf4ce" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x\\ge \\frac{1}{5}" :db/id #edb/ref 17592186248012} {:answer/id #uuid "659e5468-e099-55eb-a4ef-9a48327cdd3e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x\\le -\\frac{1}{2}" :db/id #edb/ref 17592186248339}] :answer-field/correct {:answer/id #uuid "2f66da87-fd41-50fb-b1c2-717ae0591859" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x\\le 13" :db/id #edb/ref 17592186247850} :answer-field/id #uuid "b9dadf63-5d8c-56c1-8844-878ea2a7844a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186249993}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "9ed9bfbd-adb2-54e5-bf5d-6caa34443565" :question/math-academy-id "q-115031" :question/problem "Solve the inequality $\\sqrt[3]{2x+1}-1\\le 2.$" :question/worked-solution "Isolating the cubic term, we find\n\n$$\n\\begin{aligned}\\sqrt[3]{2x+1}-1 & \\le 2 \\\\ \\sqrt[3]{2x+1} & \\le 3.\\end{aligned}\n$$\n\nThen, we cube both sides and get\n\n$$\n\\begin{aligned}{(\\sqrt[3]{2x+1})}^{3} & \\le {3}^{3} \\\\ 2x+1 & \\le 27 \\\\ 2x & \\le 26 \\\\ x & \\le 13.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186250341 :knowledge-point/_questions [{:db/id #edb/ref 17592186096816 :knowledge-point/id #uuid "0f247351-8c81-595e-bb30-26630159819c" :knowledge-point/title "Calculating a Missing Coefficient"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "486cff62-01d3-5049-9232-7e6b8711ae02" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-7" :db/id #edb/ref 17592186248073} {:answer/id #uuid "735df79d-ddb4-5640-bc31-d30cdbd2b16c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186248433} {:answer/id #uuid "a517b323-5082-5ab0-976c-3adc8f5377c7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186248898} {:answer/id #uuid "ba0187fb-9d9a-5be9-8904-397388709c9b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186249085} {:answer/id #uuid "beede94a-cbfc-5628-8c7c-ee54767e0e85" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186249121}] :answer-field/correct {:answer/id #uuid "735df79d-ddb4-5640-bc31-d30cdbd2b16c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186248433} :answer-field/id #uuid "1d4f1ea4-5984-59d1-8aad-4caa825a8331" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186249721}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "76685609-49ea-56b3-87fb-774aa7271a5f" :question/math-academy-id "q-115101" :question/problem "Given that \n\n$$\n\\frac{5x-22}{(x-4)^{2}}=\\frac{5}{x-4}+\\frac{B}{(x-4)^{2}},\n$$\n\nwhat is the value of $B?$" :question/worked-solution "Multiplying both sides of the given equality by $(x-4)^{2}$ gives\n\n$$\n\\begin{aligned}5x-22 & =5(x-4)+B.\\end{aligned}\n$$\n\nLetting $x=4$  gives\n\n$$\n\\begin{aligned}5(4)-22 & =5(4-4)+B \\\\ -2 & =0+B \\\\ B & =-2.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186250347 :knowledge-point/_questions [{:db/id #edb/ref 17592186087840 :knowledge-point/id #uuid "de557d1d-5f27-50e3-bcba-22b21f83267f" :knowledge-point/title "Determining the Equation of a Tall Ellipse"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "153668da-d780-523a-8e26-48e058715b79" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{x}^{2}}{36}+\\frac{{y}^{2}}{4}=1" :db/id #edb/ref 17592186247615} {:answer/id #uuid "3d9dc02d-1da3-5526-af85-e13cc50a7c05" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{x}^{2}}{4}+\\frac{{y}^{2}}{12}=1" :db/id #edb/ref 17592186247968} {:answer/id #uuid "750c26fb-43a5-5a41-8361-58c46e0b0804" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{x}^{2}}{4}+\\frac{{y}^{2}}{36}=1" :db/id #edb/ref 17592186248452} {:answer/id #uuid "a1d902f3-35d6-5d0d-ac8b-52610f9c819b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{x}^{2}}{2}+\\frac{{y}^{2}}{6}=1" :db/id #edb/ref 17592186248870} {:answer/id #uuid "a8569992-7633-5a8b-9630-e609ef25ddfa" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{x}^{2}}{6}+\\frac{{y}^{2}}{4}=1" :db/id #edb/ref 17592186248919}] :answer-field/correct {:answer/id #uuid "750c26fb-43a5-5a41-8361-58c46e0b0804" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{x}^{2}}{4}+\\frac{{y}^{2}}{36}=1" :db/id #edb/ref 17592186248452} :answer-field/id #uuid "106279dc-5bad-5b89-83c9-6a40e4f9b6f8" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186249697}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "522f5175-a019-5a90-95ed-58cc045a0980" :question/math-academy-id "q-115124" :question/problem "![](images/76/764f25a4b18f3f28110c0ce3345402bf183d61cac350832663e221b0de9852a5.png)\n\nWhat is the equation of the ellipse given above?" :question/worked-solution "Remember that the equation of an ellipse centered at the origin with a horizontal radius of length $a$ and a vertical radius of length $b$ is given by\n\n$$\n\\frac{{x}^{2}}{{a}^{2}}+\\frac{{y}^{2}}{{b}^{2}}=1.\n$$\n\n \n\nHere, the horizontal radius has length $a=2$ and the vertical radius has length $b=6.$ Therefore, the equation of the ellipse is\n\n$$\n\\begin{aligned}\\frac{{x}^{2}}{{a}^{2}}+\\frac{{y}^{2}}{{b}^{2}} & =1 \\\\ \\frac{{x}^{2}}{{2}^{2}}+\\frac{{y}^{2}}{{6}^{2}} & =1 \\\\ \\frac{{x}^{2}}{4}+\\frac{{y}^{2}}{36} & =1.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186399850 :knowledge-point/_questions [{:db/id #edb/ref 17592186087841 :knowledge-point/id #uuid "4e43e393-8752-58bc-b87c-b72f679cbfd9" :knowledge-point/title "Determining the Lengths of the Major and Minor Axes Given the Equation of an Ellipse"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d4ffa0ff-df0b-5bc5-b896-3f6772a35019" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$28$ and $24$" :db/id #edb/ref 17592186399852} {:answer/id #uuid "e8f1177f-3e11-593f-ad9c-dda3299fba50" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$24.5$ and $18$" :db/id #edb/ref 17592186399853} {:answer/id #uuid "e59ee665-26a4-5d2e-8c55-26143f2480d8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$14$ and $12$" :db/id #edb/ref 17592186399854} {:answer/id #uuid "ee829b75-97f1-545e-8cf4-3704340f4ba1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$49$ and $36$" :db/id #edb/ref 17592186399855} {:answer/id #uuid "f8e390e1-9f85-5321-a954-3f147b97e82b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$7$ and $6$" :db/id #edb/ref 17592186399856}] :answer-field/correct {:answer/id #uuid "e59ee665-26a4-5d2e-8c55-26143f2480d8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$14$ and $12$" :db/id #edb/ref 17592186399854} :answer-field/id #uuid "44102d96-20a4-51fc-add2-7a7a026df6ba" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186399851}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "3113828e-6ca6-530b-804d-2cdc91aade73" :question/math-academy-id "q-115134" :question/problem "What are the lengths of the major and minor axes of an ellipse with equation \n$\\frac{{x}^{2}}{49}+\\frac{{y}^{2}}{36}=1?$" :question/worked-solution "Remember that the equation of an ellipse centered at the origin with a horizontal radius of length $a$ and a vertical radius of length $b$ is given by\n\n$$\n\\frac{{x}^{2}}{{a}^{2}}+\\frac{{y}^{2}}{{b}^{2}}=1.\n$$\n\n \n\nIn the given equation, we have ${a}^{2}=49$ and ${b}^{2}=36.$\n\n- Since ${a}^{2}=49,$ the length of the horizontal radius must be $a=\\sqrt{49}=7.$\n\n- Since ${b}^{2}=36,$ the length of the vertical radius must be $b=\\sqrt{36}=6.$\n\nThus, the semi-major axis has length $a=7,$ and the semi-minor axis has length $b=6.$\n\nTherefore, the major axis has length $2a=2\\cdot 7=14,$ and the minor axis has length $2b=2\\cdot 6=12.$"}] [{:db/id #edb/ref 17592186250352 :knowledge-point/_questions [{:db/id #edb/ref 17592186157429 :knowledge-point/id #uuid "04309d45-2991-5d4b-9dc9-b75422610ab6" :knowledge-point/title "Solving an Inequality When the Base of the Exponential is Greater Than One"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "02bdd76d-fa8d-58df-b8b1-e545dd5c28a4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x<2" :db/id #edb/ref 17592186247444} {:answer/id #uuid "5f8022bf-d528-51f6-a8fe-a1a2f2edfe97" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x<\\operatorname{ln}⁡(1+e)+3" :db/id #edb/ref 17592186248288} {:answer/id #uuid "72f0f4a1-3bd5-58b1-99bb-22f7c3a5d087" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x<2-e" :db/id #edb/ref 17592186248429} {:answer/id #uuid "7b638bf8-7756-522e-9993-bf13fac41704" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x<\\operatorname{ln}⁡(1+e)-1" :db/id #edb/ref 17592186248508} {:answer/id #uuid "e798bb82-b211-5b83-b9ba-7f365819f211" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x<-1" :db/id #edb/ref 17592186249468}] :answer-field/correct {:answer/id #uuid "02bdd76d-fa8d-58df-b8b1-e545dd5c28a4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x<2" :db/id #edb/ref 17592186247444} :answer-field/id #uuid "f6d28fe8-a9db-5ee3-a3b6-13de7bfcbfad" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186250106}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "5c7e7d0e-6a38-575b-b57f-c4b68672e279" :question/math-academy-id "q-115205" :question/problem "Solve the inequality $2{e}^{x-2}+1<3.$" :question/worked-solution "Isolating the exponential term, we find\n\n$$\n\\begin{aligned}2{e}^{x-2}+1 & <3 \\\\ 2{e}^{x-2} & <2 \\\\ {e}^{x-2} & <1.\\end{aligned}\n$$\n\nThen, taking the natural logarithm of both sides and applying the laws of logarithms, we get\n\n$$\n\\begin{aligned}\\operatorname{ln}⁡({e}^{x-2}) & <\\operatorname{ln}⁡1 \\\\ x-2 & <0 \\\\ x & <2.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186250356 :knowledge-point/_questions [{:db/id #edb/ref 17592186096819 :knowledge-point/id #uuid "9e9c4ef2-0491-5b42-8679-4fe7dfbd7b00" :knowledge-point/title "Finding a Partial Fraction Decomposition With Higher Order Factors"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3dbca64e-b64c-56ce-8eb6-ecc6fa7d24a5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186247969} {:answer/id #uuid "7dcc2019-801d-5716-bfaf-80f9a09a03a1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-6" :db/id #edb/ref 17592186248526} {:answer/id #uuid "8a2be079-dea0-55fc-b357-78c9dfb9a15a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186248655} {:answer/id #uuid "8eeafaf3-5a99-5006-982b-a9ce701b9d8a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186248693} {:answer/id #uuid "b8ebd06e-cdc5-52a8-b4dd-4e79454aff1b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-9" :db/id #edb/ref 17592186249077}] :answer-field/correct {:answer/id #uuid "8a2be079-dea0-55fc-b357-78c9dfb9a15a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186248655} :answer-field/id #uuid "9f468e2b-e0a3-5878-a496-8f74d00ba6ee" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186249949}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "1a9eca33-ce1c-5c81-8c1b-83778e94422b" :question/math-academy-id "q-115214" :question/problem "Given that \n\n$$\n\\frac{{x}^{2}-6x+9}{(x-2)^{3}}=\\frac{A}{x-2}+\\frac{B}{(x-2)^{2}}+\\frac{C}{(x-2)^{3}},\n$$\n\nwhere $A$, $B$ and $C$ are real constants, find the value of $A\\cdot B\\cdot C.$" :question/worked-solution "Multiplying both sides of the given equality by $(x-2)^{3}$ gives\n\n$$\n\\begin{aligned}{x}^{2}-6x+9 & =A(x-2)^{2}+B(x-2)+C.\\end{aligned}\n$$\n\nLetting $x=2$  gives\n\n$$\n\\begin{aligned}{2}^{2}-6(2)+9 & =A(2-2)^{2}+B(2-2)+C \\\\ 1 & =A(0)+B(0)+C \\\\ C & =1.\\end{aligned}\n$$\n\nLetting $x=0$ and using our value for $C$ gives\n\n$$\n\\begin{aligned}{0}^{2}-6(0)+9 & =A(0-2)^{2}+B(0-2)+1 \\\\ 9 & =4A-2B+1 \\\\ 0 & =4A-2B-8 \\\\ 0 & =2A-B-4 \\\\ B & =2A-4.\\,\\,(1)\\end{aligned}\n$$\n\nNow, letting $x=1$ and using our value for $C$ gives\n\n$$\n\\begin{aligned}{1}^{2}-6(1)+9 & =A(1-2)^{2}+B(1-2)+1 \\\\ 4 & =A-B+1 \\\\ 0 & =A-B-3 \\\\ B & =A-3.\\,\\,(2)\\end{aligned}\n$$\n\nFrom $(1)$ and $(2)$ we have\n\n$$\n\\begin{aligned}2A-4 & =A-3 \\\\ 2A-A & =-3+4 \\\\ A & =1.\\end{aligned}\n$$\n\nNow we substitute the value of $A$ into $(2)$  to get the value of $B:$\n\n$$\n\\begin{aligned}B & =A-3=-2\\end{aligned}\n$$\n\nFinally,\n\n$$\n\\begin{aligned}A\\cdot B\\cdot C & =1\\cdot (-2)\\cdot 1=-2.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186250363 :knowledge-point/_questions [{:db/id #edb/ref 17592186157431 :knowledge-point/id #uuid "a114450f-bfcd-5db3-9060-fcd067c606fa" :knowledge-point/title "Solving an Inequality When the Exponential is Compared to Zero or a Negative Number"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8bdffb0b-c92f-5db5-9e16-6a3a24c0abd1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "all real numbers" :db/id #edb/ref 17592186248676} {:answer/id #uuid "e6f077c7-5e76-5947-a22b-b6009f1fd675" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x\\ge \\frac{12\\operatorname{ln}⁡0.72+7}{3}" :db/id #edb/ref 17592186249458} {:answer/id #uuid "e7f9e7c7-c57e-5eff-8f9d-5369d8005008" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x\\le 7-12\\operatorname{ln}⁡0.72" :db/id #edb/ref 17592186249473} {:answer/id #uuid "f4b4cb88-3f73-51d9-8cf2-e22028d822b0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x\\le 12" :db/id #edb/ref 17592186249563} {:answer/id #uuid "f9c7af93-9f26-5f0f-a636-8636e12184c5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "no solutions" :db/id #edb/ref 17592186249600}] :answer-field/correct {:answer/id #uuid "f9c7af93-9f26-5f0f-a636-8636e12184c5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "no solutions" :db/id #edb/ref 17592186249600} :answer-field/id #uuid "f1a6f05f-9154-583e-9c93-e25bd8295455" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186250091}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "8c4c4542-894b-5890-9a4c-cece675d50b3" :question/math-academy-id "q-115230" :question/problem "Solve the inequality $\\frac{1}{2}(0.72)^{3x-7}+2\\le -4.$" :question/worked-solution "Isolating the exponential term, we find\n\n$$\n\\begin{aligned}\\frac{1}{2}(0.72)^{3x-7}+2 & \\le -4 \\\\ \\frac{1}{2}(0.72)^{3x-7} & \\le -6 \\\\ (0.72)^{3x-7} & \\le -12.\\end{aligned}\n$$\n\nBecause a power of a positive number is always greater than $0,$ we must have\n\n$$\n(0.72)^{3x-7}>0\n$$\n\nfor all values of $x.$\n\nTherefore, the inequality $(0.72)^{3x-7}\\le -12$ has no solutions."}] [{:db/id #edb/ref 17592186250370 :knowledge-point/_questions [{:db/id #edb/ref 17592186157432 :knowledge-point/id #uuid "29435c7e-2913-51cb-b1ca-bb88c5109d0a" :knowledge-point/title "Solving an Inequality with Exponential Functions on Both Sides"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1e749b95-3859-5caf-bfd8-c834793e8ed4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x<5\\operatorname{ln}⁡2+3" :db/id #edb/ref 17592186247694} {:answer/id #uuid "40bebdef-ae8a-5d9e-ac28-6228e738db2a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x>\\frac{\\operatorname{ln}⁡5-\\operatorname{ln}⁡2}{2\\operatorname{ln}⁡5}" :db/id #edb/ref 17592186247995} {:answer/id #uuid "49f23bbb-2f76-5966-bbae-3c9d22acc9ab" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x<\\frac{\\operatorname{ln}⁡5-2\\operatorname{ln}⁡2}{\\operatorname{ln}⁡5-\\operatorname{ln}⁡2}" :db/id #edb/ref 17592186248082} {:answer/id #uuid "b99ff983-b6ef-5e58-8aa0-af927de0b3fe" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x>2\\operatorname{ln}⁡5-3" :db/id #edb/ref 17592186249083} {:answer/id #uuid "f6b0c71b-a6be-59ae-b32b-dde21ce862fe" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x<2\\operatorname{ln}⁡5-3" :db/id #edb/ref 17592186249578}] :answer-field/correct {:answer/id #uuid "49f23bbb-2f76-5966-bbae-3c9d22acc9ab" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x<\\frac{\\operatorname{ln}⁡5-2\\operatorname{ln}⁡2}{\\operatorname{ln}⁡5-\\operatorname{ln}⁡2}" :db/id #edb/ref 17592186248082} :answer-field/id #uuid "7730106b-6087-572a-9b32-b26564608b47" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186249875}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "1c08f0a1-4fee-59ab-b31f-f6a9816dc7a4" :question/math-academy-id "q-115250" :question/problem "Solve the inequality ${5}^{x-1}<{(\\frac{1}{2})}^{2-x}.$" :question/worked-solution "Taking the natural logarithm of both sides and applying the laws of logarithms, we get the following: \n\n$$\n\\begin{aligned}{5}^{x-1} & <{(\\frac{1}{2})}^{2-x} \\\\ \\operatorname{ln}⁡({5}^{x-1}) & <\\operatorname{ln}⁡[{(\\frac{1}{2})}^{2-x}] \\\\ (x-1)\\operatorname{ln}⁡5 & <(2-x)\\operatorname{ln}⁡(\\frac{1}{2}) \\\\ (x-1)\\operatorname{ln}⁡5 & <(2-x)(\\operatorname{ln}⁡1-\\operatorname{ln}⁡2) \\\\ (x-1)\\operatorname{ln}⁡5 & <(2-x)(0-\\operatorname{ln}⁡2) \\\\ (x-1)\\operatorname{ln}⁡5 & <(x-2)\\operatorname{ln}⁡2 \\\\ x\\operatorname{ln}⁡5-\\operatorname{ln}⁡5 & <x\\operatorname{ln}⁡2-2\\operatorname{ln}⁡2 \\\\ x\\operatorname{ln}⁡5-x\\operatorname{ln}⁡2 & <\\operatorname{ln}⁡5-2\\operatorname{ln}⁡2 \\\\ x(\\operatorname{ln}⁡5-\\operatorname{ln}⁡2) & <\\operatorname{ln}⁡5-2\\operatorname{ln}⁡2 \\\\ x & <\\frac{\\operatorname{ln}⁡5-2\\operatorname{ln}⁡2}{\\operatorname{ln}⁡5-\\operatorname{ln}⁡2}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186250385 :knowledge-point/_questions [{:db/id #edb/ref 17592186068823 :knowledge-point/id #uuid "3eec195c-6549-5de2-b3f0-0417e5f518e7" :knowledge-point/title "Solving a \"Greater Than\" Inequality Given the Graph of the Corresponding Parabola"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "10b832b4-be06-5538-a94b-59818cb45058" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-7<x<0" :db/id #edb/ref 17592186247571} {:answer/id #uuid "14b511b3-c177-5a70-857b-b7eb87042c71" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1<x<7" :db/id #edb/ref 17592186247610} {:answer/id #uuid "9502705b-7b3a-50f1-ba5b-ab33c1d821fd" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$x<-1$ or $x>7$" :db/id #edb/ref 17592186248748} {:answer/id #uuid "aa53455f-6c45-505a-ba7b-d31e4ed8c1fc" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$x<-7$ or $x>1$" :db/id #edb/ref 17592186248940} {:answer/id #uuid "c91c552a-e3ed-5137-931f-0e712dfaf92f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-7<x<1" :db/id #edb/ref 17592186249214}] :answer-field/correct {:answer/id #uuid "c91c552a-e3ed-5137-931f-0e712dfaf92f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-7<x<1" :db/id #edb/ref 17592186249214} :answer-field/id #uuid "f1df4b5a-1a4a-56c9-9f2c-02ac2d39edd0" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186250093}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "8e9f024f-9fc0-58af-9612-031b9867fc38" :question/math-academy-id "q-115287" :question/problem "![](images/bb/bb57d377a05a6e169c32f2442e02c3926391d62bff7cb24cf3201fb0289b59a4.png)\n\nGiven the graph above, solve the inequality $7-6x-{x}^{2}>0.$" :question/worked-solution "Notice that our inequality\n\n$$\n7-6x-{x}^{2}>0,\n$$\n\nis a \"*greater than*\" inequality. Therefore, we need to find the values of $x$ for which the parabola  \n\n$$\ny=7-6x-{x}^{2}\n$$\n\nis *above* the $x$-axis. We mark these values of $x$ in blue in the diagram below.\n\n![](images/8e/8e12975187d46b6dc408e21234309e33654a24503db65ed075e32990de8ed654.png)\n\nSo, the solution to the inequality is $-7<x<1.$"}] [{:db/id #edb/ref 17592186250390 :knowledge-point/_questions [{:db/id #edb/ref 17592186087834 :knowledge-point/id #uuid "a5028940-be34-56b7-8947-6129252f06a7" :knowledge-point/title "Determining the Center and Lengths of the Major and Minor Axes Given the Equation of an Ellipse"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1dc8d6fa-6312-5332-b890-b96f8ba86d34" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-3,2)" :db/id #edb/ref 17592186247690} {:answer/id #uuid "2f504533-dba5-5a4f-8e8e-d571f324bc13" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(3,-2)" :db/id #edb/ref 17592186247849} {:answer/id #uuid "5337ac8c-87dc-5ed1-9732-75915073f600" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(2,-3)" :db/id #edb/ref 17592186248174} {:answer/id #uuid "6a7cb839-e5f3-5581-9fe8-bb0945fd74b3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(3,3)" :db/id #edb/ref 17592186248373} {:answer/id #uuid "7f7020d4-fe3f-50f8-bd90-be3c6e4d9e72" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-2,3)" :db/id #edb/ref 17592186248543}] :answer-field/correct {:answer/id #uuid "7f7020d4-fe3f-50f8-bd90-be3c6e4d9e72" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-2,3)" :db/id #edb/ref 17592186248543} :answer-field/id #uuid "54c42180-98c9-5c11-b93b-3fa148651bca" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186249826}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "1dd86485-ed9c-5475-8932-90607bb9958e" :question/math-academy-id "q-115308" :question/problem "What is the center of the ellipse $\\frac{(x+2)^{2}}{3}+\\frac{(y-3)^{2}}{9}=1?$" :question/worked-solution "Remember that the general equation of an ellipse centered at $(h,k)$ with a horizontal radius of length $a$ and a vertical radius of length $b$ is given by\n\n$$\n\\frac{(x-h)^{2}}{{a}^{2}}+\\frac{(y-k)^{2}}{{b}^{2}}=1.\n$$\n\n \n\nIn the given equation, we have $h=-2$ and $k=3,$ so the center is located at $(-2,3).$"}] [{:db/id #edb/ref 17592186399871 :knowledge-point/_questions [{:db/id #edb/ref 17592186087834 :knowledge-point/id #uuid "a5028940-be34-56b7-8947-6129252f06a7" :knowledge-point/title "Determining the Center and Lengths of the Major and Minor Axes Given the Equation of an Ellipse"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "53855cff-bcca-509b-8df4-37d79e809e7c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$25$ and $6$" :db/id #edb/ref 17592186399873} {:answer/id #uuid "17302a0c-db71-5e47-9f9c-7d55635451b5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$5$ and $2$" :db/id #edb/ref 17592186399874} {:answer/id #uuid "a6aed6ae-4085-506e-b702-8b9d95570e9b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$10$ and $2\\sqrt{6}$" :db/id #edb/ref 17592186399875} {:answer/id #uuid "f17c689d-e9fa-5fd9-b2ff-5ea750ce8ac4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$5$ and $\\sqrt{6}$" :db/id #edb/ref 17592186399876} {:answer/id #uuid "d786fe68-0f02-5397-bafb-ab8b7df3332f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$12.5$ and $3$" :db/id #edb/ref 17592186399877}] :answer-field/correct {:answer/id #uuid "a6aed6ae-4085-506e-b702-8b9d95570e9b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$10$ and $2\\sqrt{6}$" :db/id #edb/ref 17592186399875} :answer-field/id #uuid "632f4b79-0b5d-599f-9a9d-155f44ffca58" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186399872}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "6821b43a-88ac-5b4b-9151-2f35f973a4c0" :question/math-academy-id "q-115313" :question/problem "For the ellipse $\\frac{(x+5)^{2}}{25}+\\frac{(y-2)^{2}}{6}=1$, find the lengths of its major and minor axes." :question/worked-solution "Remember that the general equation of an ellipse centered at $(h,k)$ with a horizontal radius of length $a$ and a vertical radius of length $b$ is given by\n\n$$\n\\frac{(x-h)^{2}}{{a}^{2}}+\\frac{(y-k)^{2}}{{b}^{2}}=1.\n$$\n\n \n\nIn the given equation, we have $h=-5$ and $k=2,$ so the center is located at $(-5,2).$\n\nIn the given equation, we also have ${a}^{2}=25$ and ${b}^{2}=6.$\n\n- Since ${a}^{2}=25,$ the length of the horizontal radius must be $a=\\sqrt{25}=5.$\n\n- Since ${b}^{2}=6,$ the length of the vertical radius must be $b=\\sqrt{6}.$\n\nSo the semi-major axis has length $a=5,$ and the semi-minor axis has length $b=\\sqrt{6}.$\n\nTherefore, the major axis has length $2a=2\\cdot 5=10,$ and the minor axis has length $2b=2\\cdot \\sqrt{6}=2\\sqrt{6}.$"}] [{:db/id #edb/ref 17592186250400 :knowledge-point/_questions [{:db/id #edb/ref 17592186100994 :knowledge-point/id #uuid "8e9df1ae-8176-555b-987d-94773c27d435" :knowledge-point/title "Finding the Radius of a Circle on the Coordinate Plane Using the Distance Formula"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2172b8f7-3593-5571-b2f3-7d7267020abd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5}{2}" :db/id #edb/ref 17592186247720} {:answer/id #uuid "39cf299f-3302-568e-80c6-f68f90479350" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186247934} {:answer/id #uuid "5fb4096d-f189-5fca-82c4-8803e1e12ee4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186248291} {:answer/id #uuid "6c0f207e-3753-5536-ba31-32a146709a0c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{2}" :db/id #edb/ref 17592186248381} {:answer/id #uuid "dca5ff4b-c86a-5b8a-b547-f8671207d2f5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186249377}] :answer-field/correct {:answer/id #uuid "6c0f207e-3753-5536-ba31-32a146709a0c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{2}" :db/id #edb/ref 17592186248381} :answer-field/id #uuid "cffa1467-5032-5c7c-8355-c1c0efa2e0bb" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186250030}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "6fa395af-9563-5dd6-b788-298fc3edabb7" :question/math-academy-id "q-115360" :question/problem "The points $A$ and $B$ have coordinates $(-3,-4)$ and $(0,-4)$, respectively, and the segment $\\overset{―}{AB}$ is a diameter of a circle. Find the radius of the circle." :question/worked-solution "The diameter can be calculated using the distance formula: \n\n$$\n\\begin{aligned}d & =\\sqrt{{({x}_{1}-{x}_{2})}^{2}+{({y}_{1}-{y}_{2})}^{2}} \\\\  & =\\sqrt{(-3-0)^{2}+(-4-(-4))^{2}} \\\\  & =\\sqrt{(-3)^{2}+(0)^{2}} \\\\  & =\\sqrt{9+0} \\\\  & =\\sqrt{9} \\\\  & =3\\end{aligned}\n$$\n\nThe radius is half the diameter:\n\n$$\nr=\\frac{d}{2}=\\frac{3}{2}\n$$"}] [{:db/id #edb/ref 17592186399885 :knowledge-point/_questions [{:db/id #edb/ref 17592186100995 :knowledge-point/id #uuid "52384502-66c5-5089-b38f-d46b94877430" :knowledge-point/title "Determining the Center and Radius of a Circle on the Coordinate Plane"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d8fa6bba-8366-50e3-bd6e-0487665ca2c7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The center is $(0,3)$ and the radius is $2$" :db/id #edb/ref 17592186399887} {:answer/id #uuid "0fba675a-9578-5d7e-86a6-668cee3df4ec" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The center is $(0,4)$ and the radius is $1$" :db/id #edb/ref 17592186399888} {:answer/id #uuid "73d0aee8-773e-58fb-89a9-36098d20a922" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The center is $(0,4)$ and the radius is $2$" :db/id #edb/ref 17592186399889} {:answer/id #uuid "d14d98e0-0f4f-5aa7-b716-c80926e97a57" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The center is $(0,3)$ and the radius is $1$" :db/id #edb/ref 17592186399890} {:answer/id #uuid "4de2cf95-13f1-5b1b-8916-4cd2aebe378f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The center is $(0,3)$ and the radius is $\\sqrt{2}$" :db/id #edb/ref 17592186399891}] :answer-field/correct {:answer/id #uuid "4de2cf95-13f1-5b1b-8916-4cd2aebe378f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The center is $(0,3)$ and the radius is $\\sqrt{2}$" :db/id #edb/ref 17592186399891} :answer-field/id #uuid "6a898ac5-9ac8-57ea-9a3a-e0a38e6b53ae" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186399886}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "a02e3599-0d24-591c-985f-c45e9f652ee9" :question/math-academy-id "q-115364" :question/problem "![](images/3a/3af3101fd7a103e8382755177ca1ebab9bc1cdf48aebd34af8ac7cc92991387c.png)\n\nGiven that the points $(-1,2)$ and $(1,4)$ lie on a diameter of a circle, what are the center and radius of the circle?" :question/worked-solution "The center of the circle is located at the midpoint of the diameter. So, we can calculate the coordinates of the center using the midpoint formula:\n\n$$\n\\begin{aligned}(h,k) & =(\\frac{{x}_{1}+{x}_{2}}{2},\\frac{{y}_{1}+{y}_{2}}{2}) \\\\  & =(\\frac{-1+1}{2},\\frac{2+4}{2}) \\\\  & =(\\frac{0}{2},\\frac{6}{2}) \\\\  & =(0,3)\\end{aligned}\n$$\n\nThe radius can be found by calculating the distance between the center $(0,3)$ and a point on the circle, such as $(-1,2):$\n\n$$\n\\begin{aligned}r & =\\sqrt{{({x}_{1}-{x}_{2})}^{2}+{({y}_{1}-{y}_{2})}^{2}} \\\\  & =\\sqrt{{(-1-0)}^{2}+{(2-3)}^{2}} \\\\  & =\\sqrt{(-1)^{2}+(-1)^{2}} \\\\  & =\\sqrt{1+1} \\\\  & =\\sqrt{2}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186250406 :knowledge-point/_questions [{:db/id #edb/ref 17592186054753 :knowledge-point/id #uuid "7de7d614-76c9-5133-a4df-95f079467cb9" :knowledge-point/title "Solving a Quadratic Inequality With No Constant Term Using the Sign Table Method"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "826552d3-c4e0-538c-9196-4afb18110140" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x\\in (0,13)" :db/id #edb/ref 17592186248579} {:answer/id #uuid "9bf08c39-e90f-5ba4-9229-d2ffff374c6f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x\\in (-\\infty ,-13)\\cup (0,\\infty )" :db/id #edb/ref 17592186248811} {:answer/id #uuid "9fb2522e-32d2-56e6-ac37-54a4312dd677" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x\\in (-\\infty ,0)\\cup (13,\\infty )" :db/id #edb/ref 17592186248847} {:answer/id #uuid "af81a493-1449-5b36-ab97-412b7aebe26d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x\\in (-\\infty ,-13)\\cup (13,\\infty )" :db/id #edb/ref 17592186248998} {:answer/id #uuid "ce1caebc-93ec-52f4-b0af-a5dbfeb7b5b7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x\\in (-13,0)" :db/id #edb/ref 17592186249251}] :answer-field/correct {:answer/id #uuid "ce1caebc-93ec-52f4-b0af-a5dbfeb7b5b7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x\\in (-13,0)" :db/id #edb/ref 17592186249251} :answer-field/id #uuid "faa7acea-63e1-5f4b-ad99-c211d52b1202" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186250113}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "f2bb17ed-6922-578d-aad8-d1768d7a7b6f" :question/math-academy-id "q-115426" :question/problem "For which values of $x$ is ${x}^{2}+13x<0?$" :question/worked-solution "First, let's factor the left-hand side of the inequality:\n\n$$\n\\begin{aligned}{x}^{2}+13x & <0 \\\\ x(x+13) & <0\\end{aligned}\n$$\n\nNext, we find the roots of the corresponding equation $x(x+13)=0.$ The roots are $x=-13$ and $x=0,$ and they split the number line into the $3$ intervals $(-\\infty ,-13),$ $(-13,0),$ and $(0,\\infty ).$\n\nNow, we construct a sign table with the list of the intervals on the top and the list of factors on the left. Filling in the sign table using the usual method, we get the following result:\n\n|  | $(-\\infty ,-13)$ | $(-13,0)$ | $(0,\\infty )$ |\n| --- | --- | --- | --- |\n| $x+13$ | $-$ | $+$ | $+$ |\n| $x$ | $-$ | $-$ | $+$ |\n| $x(x+13)$ | $(-)\\cdot (-)=+$ | $(+)\\cdot (-)=-$ | $(+)\\cdot (+)=+$ |\n\nFinally, to solve the quadratic inequality $x(x+13)<0,$ we look at the bottom row to find out where the expression $x(x+13)$ is negative.\n\nWe see that the expression is negative on the interval $(-13,0).$ \n\nTherefore, we conclude that ${x}^{2}+13x<0$ for all $x\\in (-13,0).$"}]}
