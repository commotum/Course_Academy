#{[{:db/id #edb/ref 17592186399643 :knowledge-point/_questions [{:db/id #edb/ref 17592186138478 :knowledge-point/id #uuid "8f4e3599-287a-56a3-8f1b-9e7033803e0a" :knowledge-point/title "Identifying Acceleration on a Speed-Time Graph"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "46f114a5-8479-5ab2-898f-e1a0d9b64d84" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "From $20\\,\\text{s}$ to $40\\,\\text{s}$" :db/id #edb/ref 17592186399645} {:answer/id #uuid "8bfd7b7f-f09a-57f0-9cdf-fa0624b62f8e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "From $30\\,\\text{s}$ to $60\\,\\text{s}$" :db/id #edb/ref 17592186399646} {:answer/id #uuid "bbf8f966-bf45-522b-9a34-c98c57a6aa01" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "From $0\\,\\text{s}$ to $60\\,\\text{s}$" :db/id #edb/ref 17592186399647} {:answer/id #uuid "2463de37-8db5-51e1-909c-4ac15ec53855" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "From $10\\,\\text{s}$ to $50\\,\\text{s}$" :db/id #edb/ref 17592186399648} {:answer/id #uuid "8f078bce-f94d-54cc-ae41-aea8efc48b13" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "From $0\\,\\text{s}$ to $30\\,\\text{s}$" :db/id #edb/ref 17592186399649}] :answer-field/correct {:answer/id #uuid "8bfd7b7f-f09a-57f0-9cdf-fa0624b62f8e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "From $30\\,\\text{s}$ to $60\\,\\text{s}$" :db/id #edb/ref 17592186399646} :answer-field/id #uuid "6d62422f-d84e-5e31-bc10-667678bf2be5" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186399644}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "c47c1778-9762-5608-84e1-7206031f9c36" :question/math-academy-id "q-108462" :question/problem "![](images/31/31e0e843eb581f01cdc7ebb5273398a3c0f32d2949b9e36cd28423295d7b76e8.png)\n\nThe speed-time graph shown above represents the motion of a $250\\text{cc}$ motorcycle. At what times is the motorcycle accelerating?" :question/worked-solution "The motorcycle is accelerating when its acceleration is positive. In a speed-time graph, the acceleration is given by the slope of the line. So, we need to find the times for which the slope is positive.\n\nWe see from the graph that the slope is positive from $t=30\\,\\text{s}$ to $t=60\\,\\text{s}.$ Therefore, the $250\\text{cc}$ motorcycle is accelerating in this time interval."}] [{:db/id #edb/ref 17592186244141 :knowledge-point/_questions [{:db/id #edb/ref 17592186054845 :knowledge-point/id #uuid "9bf25f86-6b27-5eaa-b1a1-1104478b290a" :knowledge-point/title "Finding the Derivative of a Function Given in Implicit Form"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1e436aa9-1f27-528c-9b27-85ed3f247f85" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{e}^{y}+1}{2-{e}^{y}}" :db/id #edb/ref 17592186241442} {:answer/id #uuid "aa8e1e52-332d-5342-9c48-ba0f24733d9e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2-{e}^{y}}" :db/id #edb/ref 17592186242671} {:answer/id #uuid "bb3b068a-44ff-5d2f-a0c9-b5478e80da18" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{x{e}^{y}-1}{2-{e}^{y}}" :db/id #edb/ref 17592186242822} {:answer/id #uuid "d2124168-f20b-59e2-b795-fe1b9c41f12c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{e}^{y}+2}{1+y{e}^{y}}" :db/id #edb/ref 17592186243031} {:answer/id #uuid "fe8d9684-f50a-5be7-ae59-410c9f9af558" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{y{e}^{y}+1}{2+{e}^{y}}" :db/id #edb/ref 17592186243420}] :answer-field/correct {:answer/id #uuid "aa8e1e52-332d-5342-9c48-ba0f24733d9e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2-{e}^{y}}" :db/id #edb/ref 17592186242671} :answer-field/id #uuid "56334162-ef15-56a1-bf2b-a790116276b1" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186243610}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "7ce22a4d-4733-52a4-87c2-c2e0529b4bfc" :question/math-academy-id "q-108506" :question/problem "Given that  ${e}^{y}=2y-x,$ calculate $\\frac{\\text{d}y}{\\text{d}x}.$" :question/worked-solution "First, we differentiate both sides of the equation with respect to $x,$ assuming that $y=y(x).$\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}({e}^{y}) & =\\frac{\\text{d}}{\\text{d}x}(2y-x) \\\\ {e}^{y}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}(2y)}{\\text{d}x}-\\frac{\\text{d}(x)}{\\text{d}x} \\\\ {e}^{y}\\frac{\\text{d}y}{\\text{d}x} & =2\\frac{\\text{d}y}{\\text{d}x}-1\\end{aligned}\n$$\n\nNow we solve the equation for $\\frac{\\text{d}y}{\\text{d}x},$ as follows:\n\n$$\n\\begin{aligned}{e}^{y}\\frac{\\text{d}y}{\\text{d}x} & =2\\frac{\\text{d}y}{\\text{d}x}-1 \\\\ \\frac{\\text{d}y}{\\text{d}x}(2-{e}^{y}) & =1 \\\\ \\frac{\\text{d}y}{\\text{d}x} & =\\frac{1}{2-{e}^{y}}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186386282 :knowledge-point/_questions [{:db/id #edb/ref 17592186138479 :knowledge-point/id #uuid "88580aff-e043-58ea-a8ca-1ce32026428f" :knowledge-point/title "Constructing the Speed-Time Graph for a Real-Life Scenario"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "085fe59d-4891-5783-a3dc-e512a6c66398" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/17/170dea566e8c74e1c3df3c087c6565c85dd03c0703c4dbec1be594ca653c6aa1.png" :db/id #edb/ref 17592186386284} {:answer/id #uuid "39a73eee-b69a-5a6a-a85b-7c1d22da0949" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/0c/0c89f7f469830ff7c505d22677f6ea612f1fff396c73aba325b4e87f6f61ae42.png" :db/id #edb/ref 17592186386285} {:answer/id #uuid "258ed6c0-b4dd-5cf0-90d1-01a6e4322f93" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/a3/a3fb0b9ebb6ef907a77c3d8ce139802dbd72fab04ea0bfc5db57e9f028c263b9.png" :db/id #edb/ref 17592186386286} {:answer/id #uuid "d191d1ef-4285-5a17-92b3-a9aefa6e1e2c" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/12/1280bba15fdb6ada20f6d6f2ea4cfeeb39e9366939d72a06059062cc2abedc8d.png" :db/id #edb/ref 17592186386287} {:answer/id #uuid "3cdbb3a8-0531-5672-b68a-760d458dd965" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/8d/8dd2eefb2c2397f10d4c07853ef819b8682e448824bf6e26302d4a16bc02183c.png" :db/id #edb/ref 17592186386288}] :answer-field/correct {:answer/id #uuid "258ed6c0-b4dd-5cf0-90d1-01a6e4322f93" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/a3/a3fb0b9ebb6ef907a77c3d8ce139802dbd72fab04ea0bfc5db57e9f028c263b9.png" :db/id #edb/ref 17592186386286} :answer-field/id #uuid "c342a9a6-0c8f-53d9-8bfc-52d1954443be" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186386283}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "0e2fe401-8d6a-539f-989f-5022eb0fe1eb" :question/math-academy-id "q-108567" :question/problem "A particle accelerates from rest with a constant acceleration of $1\\,{\\text{km/h}}^{2}$ for the first $3$ hours of its motion. It then travels at a constant speed for the next $3$ hours before accelerating with a constant acceleration of $0.5\\,{\\text{km/h}}^{2}$ for other $3$ hours. Which graph represents the described motion?" :question/worked-solution "We start the first line from the point $(0,0),$ since the particle starts from rest. Then, because the acceleration is $1\\,{\\text{km/h}}^{2},$ we draw a line with slope $1.$ \n\nHowever, because the particle is only accelerating for the first $3$ hours, we stop the line at $t=3.$ At this time, the particle's speed has increased by $1\\cdot 3=3\\,\\text{km/h}.$ So, the first line segment goes from $(0,0)$ to $(3,3).$\n\n![](images/7a/7a9fd32e5705860064e597fcf9308fee457063e060d3adede260f109ca488201.png)\n\nThe particle then travels at a constant speed for the next $3$ hours. So, the speed remains at $3\\,\\text{km/h}$ for the next $3$ hours, until $t=3+3=6.$\n\n![](images/e4/e4c7e47150bf1c205c243c6fa1d0f0e24b7a69f27a8461791d495eb7487cf4f3.png)\n\nAfter $t=3,$ the particle has an acceleration of $0.5\\,{\\text{km/h}}^{2},$ so the slope of the third line segment is $0.5.$ The third line segment stops after $3$ hours. To figure out the velocity at this moment, we need to find the equation for the third line segment.\n\nSince the third line segment passes through the point $(6,3)$ and has a slope of $0.5,$ we can use point-slope form to write the equation of the line:\n\n$$\n\\begin{aligned}v-{v}_{1} & =m(t-{t}_{1}) \\\\ v-3 & =0.5(t-6) \\\\ v-3 & =0.5t-3 \\\\ v & =0.5t\\end{aligned}\n$$\n\nThe third line segment stops when $t=6+3=9$ hours, and the velocity at this moment is\n\n$$\n\\begin{aligned}v & =0.5t \\\\ v & =0.5(9) \\\\ v & =4.5\\end{aligned}\n$$\n\nSo, the third line segment stops at the point $(9,4.5).$ The final graph is\n\n![](images/a3/a3fb0b9ebb6ef907a77c3d8ce139802dbd72fab04ea0bfc5db57e9f028c263b9.png)"}] [{:db/id #edb/ref 17592186244149 :knowledge-point/_questions [{:db/id #edb/ref 17592186054677 :knowledge-point/id #uuid "619182bf-107d-5217-a306-ec4f7c1109eb" :knowledge-point/title "Finding the Derivative of a Function Given in Implicit Form Using the Product Rule"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "38abdefd-3252-574c-ad83-da30c6b82e9f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{8x-7{x}^{3}{y}^{2}}{7{x}^{2}{y}^{3}-2y}" :db/id #edb/ref 17592186241685} {:answer/id #uuid "bb545dae-a3c6-5bfb-9023-948c37103acf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{8x-{x}^{2}{y}^{3}}{7{x}^{3}{y}^{2}+{y}^{2}}" :db/id #edb/ref 17592186242823} {:answer/id #uuid "c5136acb-020b-505c-a4e7-1cfbfb2cc0de" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{8x-7{x}^{2}{y}^{3}}{7{x}^{3}{y}^{2}+2y}" :db/id #edb/ref 17592186242917} {:answer/id #uuid "cdcd5ecf-e29d-52a6-8e4f-06c8bd373504" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{x-{x}^{3}{y}^{2}}{7{x}^{3}{y}^{2}+2y}" :db/id #edb/ref 17592186242992} {:answer/id #uuid "d32818a8-5eed-5b07-a7ac-495f052b994d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{x-{x}^{2}{y}^{3}}{{x}^{3}{y}^{2}+y}" :db/id #edb/ref 17592186243042}] :answer-field/correct {:answer/id #uuid "c5136acb-020b-505c-a4e7-1cfbfb2cc0de" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{8x-7{x}^{2}{y}^{3}}{7{x}^{3}{y}^{2}+2y}" :db/id #edb/ref 17592186242917} :answer-field/id #uuid "4934faa7-2c01-504f-90c9-b63344c5db8e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186243577}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "82a0f4a1-b7fe-533e-9033-fcc9236329fd" :question/math-academy-id "q-108655" :question/problem "Calculate $\\frac{\\text{d}y}{\\text{d}x}$ for $7{x}^{3}{y}^{3}+3{y}^{2}=12{x}^{2}.$" :question/worked-solution "First, we differentiate both sides of the equation with respect to $x,$ assuming that $y=y(x).$\n\nNote that to differentiate the $7{x}^{3}{y}^{3}$ term, we will need to use the product rule.\n\n$$\n\\begin{aligned}7{x}^{3}{y}^{3}+3{y}^{2} & =12{x}^{2} \\\\ \\frac{\\text{d}}{\\text{d}x}(7{x}^{3}{y}^{3}+3{y}^{2}) & =\\frac{\\text{d}}{\\text{d}x}(12{x}^{2}) \\\\ \\frac{\\text{d}}{\\text{d}x}(7{x}^{3}{y}^{3})+\\frac{\\text{d}}{\\text{d}x}(3{y}^{2}) & =\\frac{\\text{d}}{\\text{d}x}(12{x}^{2}) \\\\ [21{x}^{3}{y}^{2}\\frac{\\text{d}y}{\\text{d}x}+21{x}^{2}{y}^{3}]+6y\\frac{\\text{d}y}{\\text{d}x} & =24x \\\\ 21{x}^{3}{y}^{2}\\frac{\\text{d}y}{\\text{d}x}+21{x}^{2}{y}^{3}+6y\\frac{\\text{d}y}{\\text{d}x} & =24x\\end{aligned}\n$$\n\nNow we solve the equation for $\\frac{\\text{d}y}{\\text{d}x},$ as follows:\n\n$$\n\\begin{aligned}21{x}^{3}{y}^{2}\\frac{\\text{d}y}{\\text{d}x}+6y\\frac{\\text{d}y}{\\text{d}x} & =24x-21{x}^{2}{y}^{3} \\\\ \\frac{\\text{d}y}{\\text{d}x}(21{x}^{3}{y}^{2}+6y) & =24x-21{x}^{2}{y}^{3} \\\\ \\frac{\\text{d}y}{\\text{d}x} & =\\frac{8x-7{x}^{2}{y}^{3}}{7{x}^{3}{y}^{2}+2y}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186244152 :knowledge-point/_questions [{:db/id #edb/ref 17592186054846 :knowledge-point/id #uuid "2311a895-587e-5609-8a9f-9963b8cae372" :knowledge-point/title "Finding the Slope of the Tangent Line to a Curve Given in Implicit Form at a Point"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "45ce074c-f5ee-5790-955f-744688452a51" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\sqrt{3}" :db/id #edb/ref 17592186241807} {:answer/id #uuid "7e670689-9386-512c-80a1-9ffb0405857d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186242290} {:answer/id #uuid "a4fe8801-fc93-5cb1-b234-3374bb79395a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{3}}{4}" :db/id #edb/ref 17592186242633} {:answer/id #uuid "d4b24f33-d38a-5c21-a5c3-2817021cafc9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2}{3}" :db/id #edb/ref 17592186243063} {:answer/id #uuid "de835654-3bb0-5b6e-95d2-3def6a996d9f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{3}}{2}" :db/id #edb/ref 17592186243159}] :answer-field/correct {:answer/id #uuid "45ce074c-f5ee-5790-955f-744688452a51" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\sqrt{3}" :db/id #edb/ref 17592186241807} :answer-field/id #uuid "504aa2d6-12d2-5a6b-8911-82cd37da7948" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186243594}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "ffb47def-243e-5613-87da-6b6ae8fdf163" :question/math-academy-id "q-108674" :question/problem "Find the slope of the tangent at the point $(\\frac{\\pi }{3},\\,2)$ for the curve $y\\operatorname{cos}⁡(x)=1.$" :question/worked-solution "To find the slope at a point, we use implicit differentiation to calculate the derivative of the curve, assuming that $y=y(x).$\n\nNote that to differentiate the $y\\operatorname{cos}⁡(x)$ term, we will need to use the product rule.\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}(y\\operatorname{cos}⁡(x)) & =\\frac{\\text{d}}{\\text{d}x}(1) \\\\ y\\frac{\\text{d}}{\\text{d}x}(\\operatorname{cos}⁡(x))+\\operatorname{cos}⁡x\\frac{\\text{d}}{\\text{d}x}(y) & =0 \\\\ y(-\\operatorname{sin}⁡(x))+\\operatorname{cos}⁡(x)\\frac{\\text{d}y}{\\text{d}x} & =0 \\\\ \\operatorname{cos}⁡(x)\\frac{\\text{d}y}{\\text{d}x} & =y\\operatorname{sin}⁡(x) \\\\ \\frac{\\text{d}y}{\\text{d}x} & =\\frac{y\\operatorname{sin}⁡(x)}{\\operatorname{cos}⁡(x)}\\end{aligned}\n$$\n\nThe slope of the tangent at the point $(\\frac{\\pi }{3},\\,2)$ is then given by\n\n$$\n\\begin{aligned}m & ={(\\frac{\\text{d}y}{\\text{d}x})}_{(\\pi /3,\\,2)} \\\\  & ={(\\frac{y\\operatorname{sin}⁡(x)}{\\operatorname{cos}⁡(x)})}_{(\\pi /3,\\,2)} \\\\  & =\\frac{2\\cdot \\operatorname{sin}⁡(\\frac{\\pi }{3})}{\\operatorname{cos}⁡(\\frac{\\pi }{3})} \\\\  & =\\frac{2\\cdot (\\frac{\\sqrt{3}}{2})}{(\\frac{1}{2})} \\\\  & =2\\sqrt{3}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186244153 :knowledge-point/_questions [{:db/id #edb/ref 17592186054846 :knowledge-point/id #uuid "2311a895-587e-5609-8a9f-9963b8cae372" :knowledge-point/title "Finding the Slope of the Tangent Line to a Curve Given in Implicit Form at a Point"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2e607f78-385d-53f6-ab41-74ac877a5a71" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186241591} {:answer/id #uuid "32897127-ad14-5eef-9a81-301deb3e2a1d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186241624} {:answer/id #uuid "d18a655d-56b1-5123-a490-d7bf85825ed6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{\\sqrt{2}}{2}" :db/id #edb/ref 17592186243025} {:answer/id #uuid "dc7ba673-b558-5e38-9cf1-92dadf966d68" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\sqrt{2}" :db/id #edb/ref 17592186243142} {:answer/id #uuid "fd113b97-7abf-5d30-9cb0-076358176a03" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186243411}] :answer-field/correct {:answer/id #uuid "32897127-ad14-5eef-9a81-301deb3e2a1d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186241624} :answer-field/id #uuid "52dfb695-349e-5936-9fe3-1ad1eeda4511" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186243598}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "85cec444-2f0a-598c-bff4-89c6e3584a08" :question/math-academy-id "q-108679" :question/problem "Find the slope of the tangent at the point $(4,\\,4)$ for the curve $\\sqrt{x}+\\sqrt{y}=4.$" :question/worked-solution "To find the slope at a point, we use implicit differentiation to calculate the derivative of the curve, assuming that $y=y(x).$\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}(\\sqrt{x}+\\sqrt{y}) & =\\frac{\\text{d}}{\\text{d}x}(4) \\\\ \\frac{\\text{d}}{\\text{d}x}({x}^{1/2}+{y}^{1/2}) & =\\frac{\\text{d}}{\\text{d}x}(4) \\\\ \\frac{1}{2}{x}^{-1/2}+\\frac{1}{2}{y}^{-1/2}(\\frac{\\text{d}y}{\\text{d}x}) & =0 \\\\ \\frac{1}{2}{y}^{-1/2}(\\frac{\\text{d}y}{\\text{d}x}) & =-\\frac{1}{2}{x}^{-1/2} \\\\ \\frac{1}{2\\sqrt{y}}(\\frac{\\text{d}y}{\\text{d}x}) & =-\\frac{1}{2\\sqrt{x}} \\\\ \\frac{\\text{d}y}{\\text{d}x} & =-\\frac{\\sqrt{y}}{\\sqrt{x}}\\end{aligned}\n$$\n\nThe slope of the tangent at the point $(4,\\,4)$ is then given by\n\n$$\n\\begin{aligned}m & ={(\\frac{\\text{d}y}{\\text{d}x})}_{(4,\\,4)} \\\\  & =-{\\frac{\\sqrt{y}}{\\sqrt{x}}}_{(4,\\,4)} \\\\  & =-\\frac{\\sqrt{4}}{\\sqrt{4}} \\\\  & =-\\frac{2}{2} \\\\  & =-1.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186092507 :knowledge-point/_questions [{:db/id #edb/ref 17592186092385 :knowledge-point/id #uuid "3ba61258-92a9-511e-891f-9e6adce2edb0" :knowledge-point/title "Determining the Intercepts of a Normal Line"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "17dbb435-0cbf-53b0-b774-95a09e5dd5e2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-1,0)" :db/id #edb/ref 17592186241384} {:answer/id #uuid "52de3f96-3021-5e86-a521-dd5eaf2b4c3a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(1,0)" :db/id #edb/ref 17592186241918} {:answer/id #uuid "7aaf9455-fc42-5674-a140-8638e322d2c9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(5,0)" :db/id #edb/ref 17592186242258} {:answer/id #uuid "8b234896-b4c5-57ed-a626-2274af12bce9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(16,0)" :db/id #edb/ref 17592186242411} {:answer/id #uuid "aecf5e6b-c2d8-5faf-a09d-6ece73a85a07" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(\\frac{16}{5},0)" :db/id #edb/ref 17592186242704}] :answer-field/correct {:answer/id #uuid "8b234896-b4c5-57ed-a626-2274af12bce9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(16,0)" :db/id #edb/ref 17592186242411} :answer-field/id #uuid "562461af-5947-5911-b5fb-04453b8765df" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186243609}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "a8debb9f-1a0f-5757-8884-2cca273ae3ea" :question/math-academy-id "q-10871" :question/problem "Find where the normal line to the curve $f(x)=2{x}^{2}+x$ at the point $(1,3)$ intersects the $x$-axis." :question/worked-solution "Taking the derivative, we have\n\n$$\n\\begin{aligned}{f}^{′}(x)=\\frac{\\text{d}}{\\text{d}x}(2{x}^{2}+x)=4x+1.\\end{aligned}\n$$\n\nSo the slope of the tangent line is\n\n$$\nm={f}^{′}(1)=4(1)+1=5,\n$$\n\nand therefore the slope of the normal line is\n\n$$\n{m}^{′}=-\\frac{1}{m}=-\\frac{1}{5}.\n$$\n\nFinally, the equation of the normal line is\n\n$$\n\\begin{aligned}y-3 & =-\\frac{1}{5}(x-1) \\\\ y & =-\\frac{1}{5}x+\\frac{1}{5}+3 \\\\ y & =-\\frac{1}{5}x+\\frac{16}{5}.\\end{aligned}\n$$\n\nLastly, we find the point of intersection with the $x$-axis by setting $y=0$ and solving the resulting equation. We get\n\n$$\n\\begin{aligned}-\\frac{1}{5}x+\\frac{16}{5} & =0 \\\\ x & =16.\\end{aligned}\n$$\n\nTherefore, the normal line intersects the $x$-axis at $(16,0).$"}] [{:db/id #edb/ref 17592186244174 :knowledge-point/_questions [{:db/id #edb/ref 17592186059677 :knowledge-point/id #uuid "89f65f58-bd3d-5c3f-b9e0-462d74d75b59" :knowledge-point/title "Computing Second Order Derivatives"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0937fb22-de20-5285-adfe-fb134454e739" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "24{x}^{2}-24" :db/id #edb/ref 17592186241260} {:answer/id #uuid "4ade996e-8565-5999-b8b9-37a0812a3215" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{\\sqrt{{x}^{5}}}+10" :db/id #edb/ref 17592186241854} {:answer/id #uuid "890e01dc-717c-5668-ab27-67a47e021472" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{\\sqrt{{x}^{3}}}+10" :db/id #edb/ref 17592186242385} {:answer/id #uuid "c17a783f-f9eb-533a-858b-97da81489721" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{\\sqrt{{x}^{3}}}-10" :db/id #edb/ref 17592186242874} {:answer/id #uuid "e29f5fcc-b099-589c-9900-89b9765edee7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{\\sqrt{{x}^{5}}}+10" :db/id #edb/ref 17592186243194}] :answer-field/correct {:answer/id #uuid "890e01dc-717c-5668-ab27-67a47e021472" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{\\sqrt{{x}^{3}}}+10" :db/id #edb/ref 17592186242385} :answer-field/id #uuid "4cfdea00-47d2-5a4e-be1a-28b9c2503425" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186243586}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "2dffb4d9-bf1b-5b2c-8ebe-2cdd8aa443db" :question/math-academy-id "q-10883" :question/problem "Find ${f}^{″}(x)$ for $f(x)=4\\sqrt{x}+5{x}^{2}+x.$" :question/worked-solution "Computing the first derivative, we have\n\n$$\n\\begin{aligned}{f}^{′}(x) & ={(4\\sqrt{x}+5{x}^{2}+x)}^{′} \\\\  & ={(4{x}^{1/2}+5{x}^{2}+x)}^{′} \\\\  & =\\frac{1}{2}\\cdot 4{x}^{-1/2}+2\\cdot 5x+1 \\\\  & =2{x}^{-1/2}+10x+1\\,.\\end{aligned}\n$$\n\nComputing the second derivative, we have\n\n$$\n\\begin{aligned}{f}^{″}(x) & ={(2{x}^{-1/2}+10x+1)}^{′} \\\\  & =-\\frac{1}{2}\\cdot 2{x}^{-3/2}+10+0 \\\\  & =-{x}^{-3/2}+10 \\\\  & =-\\frac{1}{\\sqrt{{x}^{3}}}+10.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186386329 :knowledge-point/_questions [{:db/id #edb/ref 17592186064369 :knowledge-point/id #uuid "81d5fa54-0b80-52c1-97d7-6f8fb231f692" :knowledge-point/title "Calculating the Velocity of a Particle"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5ba0f630-2f65-5ebb-9ef9-7e215b9a8e6c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "v(t)=\\frac{t+1}{({t}^{2}+1)^{2}}" :db/id #edb/ref 17592186386331} {:answer/id #uuid "f67a34cc-bdd7-5109-9e49-3aa73823a730" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "v(t)=\\frac{t+2}{{t}^{2}+1}" :db/id #edb/ref 17592186386332} {:answer/id #uuid "c13cdfa8-c254-5851-9c01-b69045d39098" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "v(t)=\\frac{2{t}^{2}}{{t}^{2}+1}" :db/id #edb/ref 17592186386333} {:answer/id #uuid "fb33e651-cb52-5f09-b8c1-872e7acf356e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "v(t)=\\frac{2t}{({t}^{2}+1)^{2}}" :db/id #edb/ref 17592186386334} {:answer/id #uuid "c61cc750-e5d1-5559-b9f2-17126e07ceef" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "v(t)=\\frac{2}{{t}^{2}+1}" :db/id #edb/ref 17592186386335}] :answer-field/correct {:answer/id #uuid "fb33e651-cb52-5f09-b8c1-872e7acf356e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "v(t)=\\frac{2t}{({t}^{2}+1)^{2}}" :db/id #edb/ref 17592186386334} :answer-field/id #uuid "3e7b11db-5579-5d23-8dd0-1d60abf80b79" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186386330}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "68190923-09f1-522b-b256-54bea9ce1f9c" :question/math-academy-id "q-109000" :question/problem "The position $x$ of a particle at time $t$ is given by $x(t)=\\frac{{t}^{2}}{{t}^{2}+1}.$ Calculate the velocity at time $t.$" :question/worked-solution "The velocity is the derivative of the position function $x(t)$ with respect to time:\n\n$$\n\\begin{aligned}v(t) & =\\frac{\\text{d}x}{\\text{d}t} \\\\  & =\\frac{\\text{d}}{\\text{d}t}(\\frac{{t}^{2}}{{t}^{2}+1}) \\\\  & =\\frac{2t({t}^{2}+1)-{t}^{2}(2t)}{({t}^{2}+1)^{2}} \\\\  & =\\frac{2{t}^{3}+2t-2{t}^{3}}{({t}^{2}+1)^{2}} \\\\  & =\\frac{2t}{({t}^{2}+1)^{2}}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186386336 :knowledge-point/_questions [{:db/id #edb/ref 17592186064371 :knowledge-point/id #uuid "45b380ed-1974-5876-8c88-a45773741b48" :knowledge-point/title "Calculating the Speed of a Particle at a Particular Moment"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3ad1c91f-8f94-5d43-a015-0df4347e3b34" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3\\,\\text{miles/h}" :db/id #edb/ref 17592186386338} {:answer/id #uuid "310152fb-5481-5acf-b0d8-91619d3b8169" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{3}\\,\\text{miles/h}" :db/id #edb/ref 17592186386339} {:answer/id #uuid "adcedacc-6f21-533a-91b1-d246d25b6c18" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2}{3}\\,\\text{miles/h}" :db/id #edb/ref 17592186386340} {:answer/id #uuid "a069c0c1-7f30-50e9-827f-c04f4b7ee402" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{9}\\,\\text{miles/h}" :db/id #edb/ref 17592186386341} {:answer/id #uuid "ea1abc4d-2e9f-52d6-8953-d8678f00178e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1\\,\\text{miles/h}" :db/id #edb/ref 17592186386342}] :answer-field/correct {:answer/id #uuid "310152fb-5481-5acf-b0d8-91619d3b8169" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{3}\\,\\text{miles/h}" :db/id #edb/ref 17592186386339} :answer-field/id #uuid "2ab55df5-5342-5b9d-ac07-93197546e743" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186386337}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "d585be43-c802-5898-9f5b-2c2fe6d06f55" :question/math-academy-id "q-109012" :question/problem "The position $s(t)$ of a particle (in miles) at time $t$ hours is given by \n\n$$\ns(t)=\\frac{3}{t},\\,t>0.\n$$\n\nCalculate the speed of the particle when $t=3\\,\\text{h}.$" :question/worked-solution "First, we calculate the velocity function by differentiating the position function:\n\n$$\n\\begin{aligned}v(t) & =\\frac{\\text{d}s}{\\text{d}t} \\\\  & =\\frac{\\text{d}}{\\text{d}t}(\\frac{3}{t}) \\\\  & =-\\frac{3}{{t}^{2}}\\end{aligned}\n$$\n\nWhen $t=3,$ the velocity is\n\n$$\nv(3)=-\\frac{3}{{3}^{2}}=-\\frac{1}{3}.\n$$\n\nTherefore, the speed is $|-\\frac{1}{3}|=\\frac{1}{3}\\,\\text{miles/h}.$"}] [{:db/id #edb/ref 17592186059986 :knowledge-point/_questions [{:db/id #edb/ref 17592186059678 :knowledge-point/id #uuid "6afb4058-908a-5983-9c1e-78ee3fbadf44" :knowledge-point/title "Computing Second Order Derivatives Using Leibnitz Notation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "23efc5ef-2690-54f2-bee2-55957c887e24" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "60{x}^{2}+12" :db/id #edb/ref 17592186241494} {:answer/id #uuid "540b13bd-f4ff-5df5-a485-37254ae4135c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "60{x}^{2}+8" :db/id #edb/ref 17592186241934} {:answer/id #uuid "864b257c-04a1-57df-ba29-1fda8aa650a7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "60{x}^{2}+8x" :db/id #edb/ref 17592186242356} {:answer/id #uuid "c9c4addb-f175-5120-8653-b40175f4b448" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "30{x}^{2}+8" :db/id #edb/ref 17592186242960} {:answer/id #uuid "cd2989ae-1b63-5358-ae2f-b0968d4a0f14" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "60{x}^{3}+8" :db/id #edb/ref 17592186242985}] :answer-field/correct {:answer/id #uuid "540b13bd-f4ff-5df5-a485-37254ae4135c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "60{x}^{2}+8" :db/id #edb/ref 17592186241934} :answer-field/id #uuid "17955a33-082e-5b39-af43-2edeaac25d20" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186243479}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "b7a8a2be-ff9a-5f4a-96bd-e383a3bb4443" :question/math-academy-id "q-10903" :question/problem "Calculate $\\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}}$ for $y=5{x}^{4}+4{x}^{2}.$" :question/worked-solution "Computing the first derivative, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}}{\\text{d}x}(5{x}^{4}+4{x}^{2}) \\\\  & =4\\cdot 5{x}^{3}+2\\cdot 4x \\\\  & =20{x}^{3}+8x\\,.\\end{aligned}\n$$\n\nComputing the second derivative, we get\n\n$$\n\\begin{aligned}\\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}} & =\\frac{\\text{d}}{\\text{d}x}(20{x}^{3}+8x) \\\\  & =3\\cdot 20{x}^{2}+8 \\\\  & =60{x}^{2}+8.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186244250 :knowledge-point/_questions [{:db/id #edb/ref 17592186059751 :knowledge-point/id #uuid "2e1b4442-eca7-5283-9d5d-5bcbd1d67975" :knowledge-point/title "Calculating a Minor in a 3x3 Matrix With Integer Entries"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0a9ee733-0369-5383-98cf-d57199634ade" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186241275} {:answer/id #uuid "40bf570b-0c28-5b93-a302-1dc3fb653a1d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "28" :db/id #edb/ref 17592186241758} {:answer/id #uuid "7d689186-2be7-5416-bc98-d1d5fe22acb1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "42" :db/id #edb/ref 17592186242279} {:answer/id #uuid "942ccf7d-5d78-5f28-9073-6d9a3b731eee" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-42" :db/id #edb/ref 17592186242480} {:answer/id #uuid "abbf1cc6-5ea9-587f-9f60-4f1101db2fc6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-18" :db/id #edb/ref 17592186242680}] :answer-field/correct {:answer/id #uuid "7d689186-2be7-5416-bc98-d1d5fe22acb1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "42" :db/id #edb/ref 17592186242279} :answer-field/id #uuid "783ab98e-8260-54c9-b8b7-0c860e9b9a51" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186243670}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "926e7b3c-e48b-52a2-9640-544759dee372" :question/math-academy-id "q-1092" :question/problem "Calculate the minor of the entry ${b}_{22}$ in the matrix\n$B=[\\begin{aligned}3 & 13 & -6 \\\\ 2 & 7 & 0 \\\\ 5 & 0 & 4\\end{aligned}].$" :question/worked-solution "The minor of ${b}_{22}=7$ (second row, second column) is the determinant of the remaining entries when the column and row containing $7$ are removed: \n\n$$\nB=[\\begin{aligned}3 & ∗ & -6 \\\\ ∗ & 7 & ∗ \\\\ 5 & ∗ & 4\\end{aligned}]\n$$\n\n \n\nSo, the minor of ${b}_{22}=7$ is\n\n$$\n\\begin{aligned}\\text{det}[\\begin{aligned}3 & -6 \\\\ 5 & 4\\end{aligned}] & =|\\begin{aligned}3 & -6 \\\\ 5 & 4\\end{aligned}| \\\\  & =3\\cdot 4-(-6)\\cdot 5 \\\\  & =12-(-30) \\\\  & =42.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186247055 :knowledge-point/_questions [{:db/id #edb/ref 17592186096683 :knowledge-point/id #uuid "7e66d7cf-1a4b-51e6-9c78-f70a8c0555df" :knowledge-point/title "Expressing a Rational Function With Three Linear Factors as a Sum of Partial Fractions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "41194700-a88a-5de8-9f24-f3c32143a64f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{7}{(3-x)}-\\frac{5}{(2-x)}+\\frac{1}{(x+1)}" :db/id #edb/ref 17592186244885} {:answer/id #uuid "4e422a04-18f2-59e2-a393-df7b6a8004be" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5}{(3-x)}+\\frac{1}{(2-x)}-\\frac{6}{(x+1)}" :db/id #edb/ref 17592186245007} {:answer/id #uuid "9c91ab1d-3d06-53b3-b5e5-8f8fe8bb4e69" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{(3-x)}+\\frac{10}{(2-x)}-\\frac{2}{(x+1)}" :db/id #edb/ref 17592186245704} {:answer/id #uuid "b74f8f7b-03ab-5c30-a84d-e353f0aaedcb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{7}{(3-x)}+\\frac{2}{(2-x)}-\\frac{5}{(x+1)}" :db/id #edb/ref 17592186245951} {:answer/id #uuid "db943c38-ecc5-5aae-b0af-de25da6bb882" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{(3-x)}-\\frac{4}{(2-x)}+\\frac{9}{(x+1)}" :db/id #edb/ref 17592186246262}] :answer-field/correct {:answer/id #uuid "b74f8f7b-03ab-5c30-a84d-e353f0aaedcb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{7}{(3-x)}+\\frac{2}{(2-x)}-\\frac{5}{(x+1)}" :db/id #edb/ref 17592186245951} :answer-field/id #uuid "98e9c5d2-341d-5db4-a4e2-54315de20ea2" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186246814}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "400ab8c9-505d-514d-9b8b-a37c002e9bd9" :question/math-academy-id "q-10986" :question/problem "Express $\\frac{22x-38}{(3-x)(2-x)(x+1)}$ as a sum of partial fractions." :question/worked-solution "Our task is to find $A,$ $B$ and $C$ such that\n\n$$\n\\begin{aligned}\\frac{22x-38}{(3-x)(2-x)(x+1)} & =\\frac{A}{(3-x)}+\\frac{B}{(2-x)}+\\frac{C}{(x+1)}.\\end{aligned}\n$$\n\nMultiplying both sides by $(3-x)(2-x)(x+1)$ gives\n\n$$\n22x-38=A(2-x)(x+1)+B(3-x)(x+1)+C(3-x)(2-x).\n$$\n\nFor $x=3$, we get \n\n$$\n\\begin{aligned}22(3)-38 & =A(2-3)(3+1) \\\\  & \\,+B(3-3)(3+1) \\\\  & \\,+C(3-3)(2-3) \\\\ 66-38 & =A(-4) \\\\ A & =\\frac{28}{-4} \\\\ A & =-7.\\end{aligned}\n$$\n\nFor $x=2$, we get \n\n$$\n\\begin{aligned}22(2)-38 & =A(2-2)(2+1) \\\\  & \\,+B(3-2)(2+1) \\\\  & \\,+C(3-2)(2-2) \\\\ 44-38 & =B(3) \\\\ B & =\\frac{6}{3} \\\\ B & =2.\\end{aligned}\n$$\n\nFor $x=-1$, we get \n\n$$\n\\begin{aligned}22(-1)-38 & =A(2-(-1))(-1+1) \\\\  & \\,+B(3-(-1))(-1+1) \\\\  & \\,+C(3-(-1))(2-(-1)) \\\\ -22-38 & =C(12) \\\\ C & =\\frac{-60}{12} \\\\ C & =-5.\\end{aligned}\n$$\n\nHence,\n\n$$\n\\frac{22x-38}{(3-x)(2-x)(x+1)}=-\\frac{7}{(3-x)}+\\frac{2}{(2-x)}-\\frac{5}{(x+1)}.\n$$"}] [{:db/id #edb/ref 17592186247056 :knowledge-point/_questions [{:db/id #edb/ref 17592186096683 :knowledge-point/id #uuid "7e66d7cf-1a4b-51e6-9c78-f70a8c0555df" :knowledge-point/title "Expressing a Rational Function With Three Linear Factors as a Sum of Partial Fractions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2fc1086c-ae6d-5627-a9bf-0594bb709ade" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "9" :db/id #edb/ref 17592186244742} {:answer/id #uuid "b2d0c3be-0fd6-5bf4-bf9e-8621adbd759c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186245906} {:answer/id #uuid "bdfb317b-c63e-55f3-a734-4593cadb4bb5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186246006} {:answer/id #uuid "cae876a4-e90f-5e79-9cf3-81a298ccd0f5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-7" :db/id #edb/ref 17592186246119} {:answer/id #uuid "e971006f-f0a6-5a44-9eee-63de0ba56858" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186246383}] :answer-field/correct {:answer/id #uuid "e971006f-f0a6-5a44-9eee-63de0ba56858" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186246383} :answer-field/id #uuid "c2cbe5ea-38be-5f8f-ad09-74a001ac8e73" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186246898}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "eed23ce3-ed2f-59db-8baa-f9c235e009f0" :question/math-academy-id "q-10988" :question/problem "Given that\n\n$$\n\\frac{13{x}^{2}-19x-16}{(3x+2)(x-3)(x+1)}=\\frac{A}{(3x+2)}+\\frac{B}{(x-3)}+\\frac{C}{(x+1)},\n$$\n\nwhere $A,$ $B$ and $C$ are real constants, calculate $A+B+C.$" :question/worked-solution "Our task is to find $A,$ $B$ and $C$ such that\n\n$$\n\\begin{aligned}\\frac{13{x}^{2}-19x-16}{(3x+2)(x-3)(x+1)}=\\frac{A}{(3x+2)}+\\frac{B}{(x-3)}+\\frac{C}{(x+1)}.\\end{aligned}\n$$\n\nMultiplying both sides by $(3x+2)(x-3)(x+1)$ gives\n\n$$\n13{x}^{2}-19x-16=A(x-3)(x+1)+B(3x+2)(x+1)+C(3x+2)(x-3).\n$$\n\nFor $x=-\\frac{2}{3}$, we get \n\n$$\n\\begin{aligned}13{(-\\frac{2}{3})}^{2}-19(-\\frac{2}{3})-16 & =A(-\\frac{2}{3}-3)(-\\frac{2}{3}+1) \\\\  & \\,+B(3(-\\frac{2}{3})+2)(-\\frac{2}{3}+1) \\\\  & \\,+C(3(-\\frac{2}{3})+1)(-\\frac{2}{3}-3) \\\\ \\frac{52}{9}+\\frac{38}{3}-16 & =A(\\frac{(-11)(1)}{9}) \\\\ \\frac{52+114-144}{9} & =A(-\\frac{11}{9}) \\\\ A & =-\\frac{22}{11} \\\\ A & =-2.\\end{aligned}\n$$\n\nFor $x=3$, we obtain\n\n$$\n\\begin{aligned}13(3)^{2}-19(3)-16 & =A(3-3)(3+1) \\\\  & \\,+B(3(3)+2)(3+1) \\\\  & \\,+C(3(3)+2)(3-3) \\\\ 117-57-16 & =B(44) \\\\ B & =\\frac{44}{44} \\\\ B & =1.\\end{aligned}\n$$\n\nFor $x=-1$, we get \n\n$$\n\\begin{aligned}13(-1)^{2}-19(-1)-16 & =A(-1-3)(-1+1) \\\\  & \\,+B(3(-1)+2)(-1+1) \\\\  & \\,+C(3(-1)+2)(-1-3) \\\\ 13+19-16 & =C(4) \\\\ C & =\\frac{16}{4} \\\\ C & =4.\\end{aligned}\n$$\n\nHence,\n\n$$\n\\begin{aligned}A+B+C & =(-2)+1+4=3.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186247067 :knowledge-point/_questions [{:db/id #edb/ref 17592186096818 :knowledge-point/id #uuid "c30dc350-d0c9-5a4d-87a0-4e2ebb1bb221" :knowledge-point/title "Calculating a Three-Term Partial Fraction Decomposition"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "016d575c-9081-57b4-bc08-75eca4d55fd3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{3}{x+7}-\\frac{2}{(x+7)^{2}}+\\frac{2}{x-3}" :db/id #edb/ref 17592186244321} {:answer/id #uuid "1fb63833-17e5-50c3-9e6a-d4d5100a43f2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{6}{x+7}+\\frac{4}{(x+7)^{2}}+\\frac{2}{x-3}" :db/id #edb/ref 17592186244594} {:answer/id #uuid "6149c2b7-cb65-56f0-9ed7-b239ad10c444" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{3}{x+7}+\\frac{4}{(x+7)^{2}}+\\frac{2}{x-3}" :db/id #edb/ref 17592186245162} {:answer/id #uuid "8da28e65-e1f3-5260-b060-5b17b3b2e13d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{6}{x+7}-\\frac{2}{(x+7)^{2}}-\\frac{4}{x-3}" :db/id #edb/ref 17592186245553} {:answer/id #uuid "cfac0ef7-8b50-5c6d-a5bf-75a8af09617f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{3}{x+7}+\\frac{4}{(x+7)^{2}}-\\frac{4}{x-3}" :db/id #edb/ref 17592186246167}] :answer-field/correct {:answer/id #uuid "6149c2b7-cb65-56f0-9ed7-b239ad10c444" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{3}{x+7}+\\frac{4}{(x+7)^{2}}+\\frac{2}{x-3}" :db/id #edb/ref 17592186245162} :answer-field/id #uuid "4f9ef799-ff43-5ebd-af86-0243a466e65c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186246686}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "b9c7f12f-f5f3-522f-8863-2127e54d4ac8" :question/math-academy-id "q-10995" :question/problem "Express $\\frac{-{x}^{2}+20x+149}{(x+7)^{2}(x-3)}$ as a sum of partial     fractions." :question/worked-solution "Our task is to find $A,$ $B$ and $C$ such that\n\n$$\n\\begin{aligned}\\frac{-{x}^{2}+20x+149}{(x+7)^{2}(x-3)} & =\\frac{A}{x+7}+\\frac{B}{(x+7)^{2}}+\\frac{C}{x-3}.\\end{aligned}\n$$\n\nMultiplying both sides by $(x+7)^{2}(x-3)$ gives\n\n$$\n-{x}^{2}+20x+149=A(x+7)(x-3)+B(x-3)+C(x+7)^{2}.\n$$\n\nFor $x=-7$, we get \n\n$$\n\\begin{aligned}-(-7)^{2}+20(-7)+149 & =A(-7+7)(-7-3)+B(-7-3)+C(-7+7)^{2} \\\\ -49-140+149 & =B(-10) \\\\ B & =\\frac{-40}{-10} \\\\ B & =4.\\end{aligned}\n$$\n\nFor $x=3$, we get \n\n$$\n\\begin{aligned}-(3)^{2}+20(3)+149 & =A(3+7)(3-3)+B(3-3)+C(3+7)^{2} \\\\ -9+60+149 & =C{(10)}^{2} \\\\ C & =\\frac{200}{100} \\\\ C & =2.\\end{aligned}\n$$\n\nFor $x=0$, we get\n\n$$\n\\begin{aligned}-({0}^{2})+20(0)+149 & =A(0+7)(0-3)+B(0-3)+C(0+7)^{2} \\\\ 149 & =-21A-3B+49C \\\\ 149 & =-21A-3(4)+49(2) \\\\ 149 & =-21A+86 \\\\ 21A & =-63 \\\\ A & =-3.\\end{aligned}\n$$\n\nHence,\n\n$$\n\\frac{-{x}^{2}+20x+149}{(x+7)^{2}(x-3)}=-\\frac{3}{x+7}+\\frac{4}{(x+7)^{2}}+\\frac{2}{x-3}.\n$$"}] [{:db/id #edb/ref 17592186247074 :knowledge-point/_questions [{:db/id #edb/ref 17592186064271 :knowledge-point/id #uuid "0fa5bdf9-4b27-5565-9ee1-ecb9f9db4791" :knowledge-point/title "Determining the Units of a Derivative"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0a9d1daa-4262-5139-a82a-fa3e67db2278" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "squared hours" :db/id #edb/ref 17592186244405} {:answer/id #uuid "14b30c62-666a-59b5-8d86-70c3aaa84281" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "hours per minute" :db/id #edb/ref 17592186244504} {:answer/id #uuid "266712ff-2378-5f67-aec9-f0527b04aad3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "minutes" :db/id #edb/ref 17592186244654} {:answer/id #uuid "b676b7d4-a1ba-50cd-8d9e-e05b06adc11f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "hours" :db/id #edb/ref 17592186245944} {:answer/id #uuid "f0f28c2d-9b38-50b8-86c4-fef300c2b50e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "minutes per hour" :db/id #edb/ref 17592186246441}] :answer-field/correct {:answer/id #uuid "14b30c62-666a-59b5-8d86-70c3aaa84281" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "hours per minute" :db/id #edb/ref 17592186244504} :answer-field/id #uuid "05a9c882-cc73-506a-8893-344eaeecc41b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186246562}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "986c7828-ebef-5b92-b3ca-04f414e27f95" :question/math-academy-id "q-110042" :question/problem "A battery lasts $L(t)$ hours when it is charged for $t$ minutes. What are the units of $\\frac{\\text{d}L}{\\text{d}t}?$" :question/worked-solution "We have that the battery duration $L(t)$ is measured in hours and the charging time is measured in minutes. \n\n$$\n\\begin{aligned}L(t): & \\text{hours} \\\\ t: & \\text{minutes}\\end{aligned}\n$$\n\nThe derivative $\\frac{\\text{d}L}{\\text{d}t}$ measures a change in $L(t)$ over a change in $t.$ So, it represents a ratio of the units:\n\n$$\n\\begin{aligned}\\frac{\\text{d}L}{\\text{d}t}: & \\frac{\\text{hours}}{\\text{minute}}\\end{aligned}\n$$\n\nIn other words, $\\frac{\\text{d}L}{\\text{d}t}$ is measured in \"hours per minute\"."}] [{:db/id #edb/ref 17592186247081 :knowledge-point/_questions [{:db/id #edb/ref 17592186096684 :knowledge-point/id #uuid "d10c4317-f4b3-5846-8376-c7d382fc0ba3" :knowledge-point/title "Expressing Rational Functions as a Sum of Partial Fractions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "07727d7f-2c55-5c5c-b6bf-023798916eda" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{4x+1}{({x}^{2}+11)}+\\frac{1}{(x-5)}" :db/id #edb/ref 17592186244373} {:answer/id #uuid "304ce17a-85e2-591d-89e0-8e6f154201c9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2x+5}{({x}^{2}+11)}-\\frac{7}{(x-5)}" :db/id #edb/ref 17592186244747} {:answer/id #uuid "72f881ba-150a-5750-bb32-d48934ef96fb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{x+2}{({x}^{2}+11)}-\\frac{3}{(x-5)}" :db/id #edb/ref 17592186245342} {:answer/id #uuid "80f84e2b-243f-5712-a4cd-ff9a8411e827" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5x+3}{({x}^{2}+11)}-\\frac{4}{(x-5)}" :db/id #edb/ref 17592186245453} {:answer/id #uuid "c5c81f0c-ed8f-5c9b-af84-836ee910ecdc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3x+2}{({x}^{2}+11)}+\\frac{2}{(x-5)}" :db/id #edb/ref 17592186246069}] :answer-field/correct {:answer/id #uuid "80f84e2b-243f-5712-a4cd-ff9a8411e827" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5x+3}{({x}^{2}+11)}-\\frac{4}{(x-5)}" :db/id #edb/ref 17592186245453} :answer-field/id #uuid "7426eb8b-dbe6-5c90-bab6-297b47683a95" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186246748}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "d0fd4da8-2774-540b-8642-c6079728ee7a" :question/math-academy-id "q-11007" :question/problem "Express $\\frac{{x}^{2}-22x-59}{({x}^{2}+11)(x-5)}$ as a sum of partial fractions." :question/worked-solution "Our task is to find $A,$ $B,$ and $C$ such that\n\n$$\n\\begin{aligned}\\frac{{x}^{2}-22x-59}{({x}^{2}+11)(x-5)} & =\\frac{Ax+B}{({x}^{2}+11)}+\\frac{C}{(x-5)}.\\end{aligned}\n$$\n\nNote that since ${x}^{2}+11$ is an irreducible quadratic factor, we must use a linear term $Ax+B$ in the numerator.\n\nWe multiply both sides by $({x}^{2}+11)(x-5)$ and get\n\n$$\n{x}^{2}-22x-59=(Ax+B)(x-5)+C({x}^{2}+11).\n$$\n\nPlugging in $x=5$ eliminates $A$ and $B$ and allows us to solve for $C.$ We get \n\n$$\n\\begin{aligned}{5}^{2}-22(5)-59 & =(A(5)+B)(5-5)+C({5}^{2}+11) \\\\ 25-110-59 & =36C \\\\ C & =-\\frac{144}{36} \\\\ C & =-4.\\end{aligned}\n$$\n\nPlugging in $x=0$ eliminates the $A$ term, and using our result for $C$ allows us to solve for $B.$ We get \n\n$$\n\\begin{aligned}(0)^{2}-22(0)-59 & =(A(0)+B)(0-5)+C({0}^{2}+11) \\\\ -59 & =-5B+11C \\\\ -59 & =-5B+11(-4) \\\\ 5B & =-44+59 \\\\ B & =\\frac{15}{5} \\\\ B & =3.\\end{aligned}\n$$\n\nFinally, to solve for $A,$ we choose $x=1$ and use our results for $B$ and $C.$ We get\n\n$$\n\\begin{aligned}(1)^{2}-22(1)-59 & =(A(1)+B)(1-5)+C({1}^{2}+11) \\\\ 1-22-59 & =-4A-4B+12C \\\\ -80 & =-4A-4(3)+12(-4) \\\\ 4A & =-12-48+80 \\\\ A & =\\frac{20}{4} \\\\ A & =5.\\end{aligned}\n$$\n\nSo we have $A=5,$ $B=3,$ and $C=-4.$ Therefore, our final result is\n\n$$\n\\frac{{x}^{2}-22x-59}{({x}^{2}+11)(x-5)}=\\frac{5x+3}{({x}^{2}+11)}-\\frac{4}{(x-5)}.\n$$"}] [{:db/id #edb/ref 17592186096950 :knowledge-point/_questions [{:db/id #edb/ref 17592186096684 :knowledge-point/id #uuid "d10c4317-f4b3-5846-8376-c7d382fc0ba3" :knowledge-point/title "Expressing Rational Functions as a Sum of Partial Fractions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "40f3ff82-6f77-549d-a624-5debcc99a8d7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3x+1}{({x}^{2}+2x+3)}+\\frac{2}{(x-1)}" :db/id #edb/ref 17592186244883} {:answer/id #uuid "6a5c70ee-90d2-5687-b3ef-c971b9f60b46" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{x+3}{({x}^{2}+2x+3)}+\\frac{2}{(x-1)}" :db/id #edb/ref 17592186245256} {:answer/id #uuid "88b2fe13-efa4-5d72-a479-ed5d91e3729f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{x+2}{({x}^{2}+2x+3)}+\\frac{3}{(x-1)}" :db/id #edb/ref 17592186245512} {:answer/id #uuid "c5e65d48-58e0-5c74-85e0-8eaade6131a2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{x+3}{({x}^{2}+2x+3)}-\\frac{2}{(x-1)}" :db/id #edb/ref 17592186246071} {:answer/id #uuid "cb9bc7f1-3946-5b24-a66f-3a730e714c0f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2x+1}{({x}^{2}+2x+3)}-\\frac{3}{(x-1)}" :db/id #edb/ref 17592186246126}] :answer-field/correct {:answer/id #uuid "40f3ff82-6f77-549d-a624-5debcc99a8d7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3x+1}{({x}^{2}+2x+3)}+\\frac{2}{(x-1)}" :db/id #edb/ref 17592186244883} :answer-field/id #uuid "0e133db9-6266-5cab-9b3a-996ed74e5d30" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186246575}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "5ed7374e-1891-5f2a-9591-44dae68b363d" :question/math-academy-id "q-11014" :question/problem "Express $\\frac{5{x}^{2}+2x+5}{({x}^{2}+2x+3)(x-1)}$ as a sum of partial fractions." :question/requires-calculator true :question/worked-solution "Our task is to find $A,$ $B,$ and $C$ such that\n\n$$\n\\begin{aligned}\\frac{5{x}^{2}+2x+5}{({x}^{2}+2x+3)(x-1)} & =\\frac{Ax+B}{({x}^{2}+2x+3)}+\\frac{C}{(x-1)}.\\end{aligned}\n$$\n\nNote that since ${x}^{2}+2x+3$ is an irreducible quadratic factor, we must use a linear term $Ax+B$ in the numerator.\n\nWe multiply both sides by $({x}^{2}+2x+3)(x-1)$ and get\n\n$$\n5{x}^{2}+2x+5=(Ax+B)(x-1)+C({x}^{2}+2x+3).\n$$\n\nPlugging in $x=1$ eliminates the $A$ and $B$ terms and allows us to solve for $C.$ We get \n\n$$\n\\begin{aligned}5(1)^{2}+2(1)+5 & =(A(1)+B)(1-1)+C((1)^{2}+2(1)+3) \\\\ 5+2+5 & =6C \\\\ C & =\\frac{12}{6} \\\\ C & =2.\\end{aligned}\n$$\n\nPlugging in $x=0$ eliminates the $A$ term, and using our result for $C$ allows us to solve for $B.$ We get \n\n$$\n\\begin{aligned}5({0}^{2})+2(0)+5 & =(A(0)+B)(0-1)+C({0}^{2}+2(0)+3) \\\\ 5 & =-B+3C \\\\ 5 & =-B+3(2) \\\\ B & =6-5 \\\\ B & =1.\\end{aligned}\n$$\n\nFinally, to solve for $A,$ we choose $x=2$ and use our results for $B$ and $C.$ We get\n\n$$\n\\begin{aligned}5(2)^{2}+2(2)+5 & =(A(2)+B)(2-1)+C({2}^{2}+2(2)+3) \\\\ 29 & =2A+B+11C \\\\ 29 & =2A+(1)+11(2) \\\\ 2A & =29-23 \\\\ A & =\\frac{6}{2} \\\\ A & =3.\\end{aligned}\n$$\n\nSo we have $A=3,B=1,$ and $C=2.$ Therefore, our final result is\n\n$$\n\\frac{5{x}^{2}+2x+5}{({x}^{2}+2x+3)(x-1)}=\\frac{3x+1}{({x}^{2}+2x+3)}+\\frac{2}{(x-1)}.\n$$"}] [{:db/id #edb/ref 17592186247089 :knowledge-point/_questions [{:db/id #edb/ref 17592186110602 :knowledge-point/id #uuid "a6fee8d5-e1f7-599d-a74c-abc44d973065" :knowledge-point/title "Finding Equations of Perpendicular Horizontal and Vertical Lines"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0cad6201-010a-539b-a233-a3a596a28dc4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=-1" :db/id #edb/ref 17592186244428} {:answer/id #uuid "2c55774a-a3f7-5f2a-9db4-822399b469f0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=-2" :db/id #edb/ref 17592186244707} {:answer/id #uuid "5809a7c4-dbcc-51e9-a678-5bee1fdb700f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=1" :db/id #edb/ref 17592186245092} {:answer/id #uuid "6ff5dd77-50b2-599d-bae1-c332e1f63976" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=4" :db/id #edb/ref 17592186245314} {:answer/id #uuid "ac2f7b12-1531-5623-b56b-f9c9386acf29" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=4" :db/id #edb/ref 17592186245854}] :answer-field/correct {:answer/id #uuid "ac2f7b12-1531-5623-b56b-f9c9386acf29" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=4" :db/id #edb/ref 17592186245854} :answer-field/id #uuid "e4b2b10b-4212-561e-9c28-87b5d79c2cdb" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186246954}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "08d4aa7d-7a62-5d6f-bf6f-63a5dddd841b" :question/math-academy-id "q-110140" :question/problem "Find the equation of the line that is perpendicular to $x=2$ and passes through the point $(1,4).$" :question/worked-solution "Since the line $x=2$ is a vertical line, a perpendicular line would need to be horizontal. So, the perpendicular line must take the form $y=k$ for some value of $k.$\n\nThe perpendicular line needs to go through the point $(1,4),$ which has a $y$-coordinate of $4.$ So, the perpendicular line is $y=4.$"}] [{:db/id #edb/ref 17592186247095 :knowledge-point/_questions [{:db/id #edb/ref 17592186119941 :knowledge-point/id #uuid "4ff302ba-5a3f-599b-b038-7417af1dca71" :knowledge-point/title "Finding the Equation of a Tangent Line Using dx/dy"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "62979e92-45e9-5dc6-8f39-99cc2e9d96b4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=\\frac{x}{8}-\\frac{8}{7}" :db/id #edb/ref 17592186245178} {:answer/id #uuid "805e2500-01e2-50d2-a506-5c198597c2e5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=\\frac{x}{28}+\\frac{1}{7}" :db/id #edb/ref 17592186245444} {:answer/id #uuid "844ac3c9-57f1-5fd5-8d04-85a9a8a1b2b4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=\\frac{x}{18}-\\frac{7}{8}" :db/id #edb/ref 17592186245480} {:answer/id #uuid "d811f8f1-2ef1-5c53-a599-574d0712abf3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=\\frac{x}{28}+\\frac{16}{7}" :db/id #edb/ref 17592186246237} {:answer/id #uuid "f5245542-2c39-5d0f-b0a9-ba2de27c7518" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=\\frac{x}{28}+\\frac{8}{7}" :db/id #edb/ref 17592186246476}] :answer-field/correct {:answer/id #uuid "f5245542-2c39-5d0f-b0a9-ba2de27c7518" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=\\frac{x}{28}+\\frac{8}{7}" :db/id #edb/ref 17592186246476} :answer-field/id #uuid "5234f73d-f7a9-51e5-9340-f6c76b65f21c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186246691}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "00d18bd8-cfc3-5c89-ac8d-72f20b70464f" :question/math-academy-id "q-110192" :question/problem "Given a curve $x=5{y}^{3}-8{y}^{2}+16,$ what is the equation of the tangent to the curve at the point $(24,2)?$" :question/worked-solution "First, we differentiate $x(y)$ with respect to $y:$\n\n$$\n\\begin{aligned}\\frac{\\text{d}x}{\\text{d}y} & =\\frac{\\text{d}}{\\text{d}y}(5{y}^{3}-8{y}^{2}+16) \\\\  & =5\\frac{\\text{d}}{\\text{d}y}({y}^{3})-8\\frac{\\text{d}}{\\text{d}y}({y}^{2})+16\\frac{\\text{d}}{\\text{d}y}(1) \\\\  & =5\\cdot (3{y}^{2})-8\\cdot (2y)+0 \\\\  & =15{y}^{2}-16y.\\end{aligned}\n$$\n\nNow, taking the reciprocal of $\\frac{\\text{d}x}{\\text{d}y},$ we get\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}={(\\frac{\\text{d}x}{\\text{d}y})}^{-1}=\\frac{1}{15{y}^{2}-16y}.\n$$\n\nThe slope of the tangent to the curve at the point $(24,2)$ is\n\n$$\n\\begin{aligned}m & =\\frac{\\text{d}y}{\\text{d}x}{|}_{(x,y)=(24,2)} \\\\  & =\\frac{1}{15\\cdot {2}^{2}-16\\cdot 2} \\\\  & =\\frac{1}{28}.\\end{aligned}\n$$\n\nUsing the point-slope formula for a tangent line, we get\n\n$$\n\\begin{aligned}y-{y}_{1} & =m(x-{x}_{1}) \\\\ y-2 & =\\frac{1}{28}(x-24) \\\\ y & =\\frac{x}{28}-\\frac{6}{7}+2 \\\\ y & =\\frac{x}{28}+\\frac{8}{7}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186247096 :knowledge-point/_questions [{:db/id #edb/ref 17592186064251 :knowledge-point/id #uuid "4270c31c-80f1-5b5d-bca8-e16a47206c2b" :knowledge-point/title "Calculating the Derivative of an Inverse Function From a Graph"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "19748f7d-bb3c-5578-815a-2c40f268fd48" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{2}" :db/id #edb/ref 17592186244541} {:answer/id #uuid "245e0993-1c09-56ea-a369-0117d5ee5974" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{4}" :db/id #edb/ref 17592186244637} {:answer/id #uuid "2f2e6757-a78e-5338-abcf-b4cc049dfd1b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{2}{3}" :db/id #edb/ref 17592186244738} {:answer/id #uuid "6f36eba8-2e78-54af-916b-61cedc572d7c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186245301} {:answer/id #uuid "721e29cf-a6f9-513b-8aa0-cf84cb7826ed" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186245332}] :answer-field/correct {:answer/id #uuid "19748f7d-bb3c-5578-815a-2c40f268fd48" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{2}" :db/id #edb/ref 17592186244541} :answer-field/id #uuid "517e252a-aac0-56a3-81dc-672a79260cc6" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186246688}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "c68b15f6-2538-56cf-b4b4-1738b9f449cf" :question/math-academy-id "q-110198" :question/problem "![](images/ba/ba762e13c4015b43b99f9038ee63a247584345cd535e12b80c1f3b0d9e50e70b.png)\n\nThe figure above shows the graph of a piecewise linear function $y=f(x).$ The point $A$ has coordinates $(1,0)$ and lies on $y=f(x).$ Given that $(0,1)$ lies on $y={f}^{-1}(x),$ what is $({f}^{-1})^{′}(0)?$" :question/worked-solution "Since $(0,1)$ lies on ${f}^{-1},$ we have ${f}^{-1}(0)=1.$ \nThe slope of the tangent to $f(x)$ for $x\\in [0,2]$ is $-2$, hence, ${f}^{′}(1)=-2.$\n\nThe formula for the derivative of the inverse function is \n\n$$\n({f}^{-1})^{′}(x)=\\frac{1}{{f}^{′}({f}^{-1}(x))}.\n$$\n\nEvaluating at $x=0,$ we have\n\n$$\n\\begin{aligned}({f}^{-1})^{′}(0) & =\\frac{1}{{f}^{′}({f}^{-1}(0))} \\\\  & =\\frac{1}{{f}^{′}(1)} \\\\  & =\\frac{1}{-2} \\\\  & =-\\frac{1}{2}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186247135 :knowledge-point/_questions [{:db/id #edb/ref 17592186087691 :knowledge-point/id #uuid "10095048-0db6-5b4e-889f-303f07449367" :knowledge-point/title "Finding Solutions to Exponential Equations when Rearrangement is Required"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "248c560a-5504-5344-ba06-31ff881f4228" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "ln⁡(2)-1" :db/id #edb/ref 17592186244640} {:answer/id #uuid "453ad4e8-fc91-5dc6-a9a5-3321c0d9dc49" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "ln⁡(2)+1" :db/id #edb/ref 17592186244926} {:answer/id #uuid "a51377ae-5388-50fe-83c3-7ef69418daf1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2ln⁡(2)-1" :db/id #edb/ref 17592186245796} {:answer/id #uuid "f8312b64-ab69-53ae-90e8-b700b7b53c1c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2ln⁡(2)+1" :db/id #edb/ref 17592186246497} {:answer/id #uuid "faecbb4c-e0f8-59a8-a3d7-92a5f5e02711" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2ln⁡(2)" :db/id #edb/ref 17592186246516}] :answer-field/correct {:answer/id #uuid "a51377ae-5388-50fe-83c3-7ef69418daf1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2ln⁡(2)-1" :db/id #edb/ref 17592186245796} :answer-field/id #uuid "8a081fae-877e-5e2e-acae-a2b3a4e290d6" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186246787}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "48d44085-8aaf-5ed5-9d45-53625f178071" :question/math-academy-id "q-110536" :question/problem "Given that ${e}^{y+1}-1=3,$ then $y=$" :question/worked-solution "First, we rearrange our equation into a form that is more convenient for logarithms, as follows:\n\n$$\n\\begin{aligned}{e}^{y+1}-1 & =3 \\\\ {e}^{y+1} & =4\\end{aligned}\n$$\n\nThen, we find the natural logarithm $(ln)$ of both sides of the equation and solve for $y:$\n\n$$\n\\begin{aligned}{e}^{y+1} & =4 \\\\ ln⁡({e}^{y+1}) & =ln⁡(4) \\\\ y+1 & =2ln⁡(2) \\\\ y & =2ln⁡(2)-1\\end{aligned}\n$$\n\nTherefore, the solution is $y=2ln⁡(2)-1.$"}] [{:db/id #edb/ref 17592186247137 :knowledge-point/_questions [{:db/id #edb/ref 17592186115219 :knowledge-point/id #uuid "a8eebff2-97ca-599b-a819-04ff34f0c1c4" :knowledge-point/title "Solving Exponential Equations Containing Different Bases by Rewriting Two Exponents"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5590a848-eae9-5089-bdc1-7f789ac62064" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "15" :db/id #edb/ref 17592186245065} {:answer/id #uuid "5f338793-8672-5f89-9124-424dc680305c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "9" :db/id #edb/ref 17592186245150} {:answer/id #uuid "a0029015-9d7a-5b76-8132-425f8e5b1369" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "10" :db/id #edb/ref 17592186245736} {:answer/id #uuid "caf954cd-bb67-553d-8e8c-ae5436312352" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186246122} {:answer/id #uuid "f2f19e3a-8e8b-5a89-b39e-a28325288d1b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186246459}] :answer-field/correct {:answer/id #uuid "5590a848-eae9-5089-bdc1-7f789ac62064" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "15" :db/id #edb/ref 17592186245065} :answer-field/id #uuid "5d24b5a0-aff5-5beb-bda9-0451317c58e5" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186246711}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "6b4f9a18-294f-593c-86d1-c0d405dcd6de" :question/math-academy-id "q-110544" :question/problem "Solve for $y$ where ${81}^{y}={27}^{y+5}.$" :question/worked-solution "To solve this equation, we need both exponential terms to have a common base. To do this, we rewrite the equation using $81={3}^{4}$ and $27={3}^{3},$ as follows:\n\n$$\n{({3}^{4})}^{y}={({3}^{3})}^{y+5}\n$$\n\nThen, we apply the power rule of exponents. This gives:\n\n$$\n\\begin{aligned}{3}^{4y}={3}^{3(y+5)}\\end{aligned}\n$$\n\nNow, since both sides of the equation share the same base $(3),$ we equate the exponents and solve for $y:$\n\n$$\n\\begin{aligned}4y & =3(y+5) \\\\ 4y & =3y+15 \\\\ y & =15\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186247151 :knowledge-point/_questions [{:db/id #edb/ref 17592186064366 :knowledge-point/id #uuid "93a44f44-0998-5857-9b12-de8998e370fd" :knowledge-point/title "Differentiating an Inverse Cosine Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "09ee8a3a-aff1-5329-ab62-d486c9340be5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5-\\frac{4}{\\sqrt{1-{x}^{2}}}" :db/id #edb/ref 17592186244398} {:answer/id #uuid "89609260-8cd9-5ba1-b619-2fc1bd29c3eb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5+\\frac{4}{\\sqrt{1-{x}^{2}}}" :db/id #edb/ref 17592186245517} {:answer/id #uuid "8d8724d8-cb92-559c-84a5-0132b5fbd151" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5-\\frac{4x}{\\sqrt{1-{x}^{2}}}" :db/id #edb/ref 17592186245551} {:answer/id #uuid "962ee919-f8a1-5686-b7b2-8aaf7083525a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5x+\\frac{4}{\\sqrt{1-{x}^{2}}}" :db/id #edb/ref 17592186245636} {:answer/id #uuid "d758ea7b-694a-526b-a30b-4e618f038f63" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4-\\frac{5}{\\sqrt{1-{x}^{2}}}" :db/id #edb/ref 17592186246230}] :answer-field/correct {:answer/id #uuid "09ee8a3a-aff1-5329-ab62-d486c9340be5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5-\\frac{4}{\\sqrt{1-{x}^{2}}}" :db/id #edb/ref 17592186244398} :answer-field/id #uuid "5935a167-843e-514d-9aca-7a9d8403bae1" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186246704}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "e8030974-10cb-5204-836f-a9b8dc5afc64" :question/math-academy-id "q-110625" :question/problem "Calculate ${f}^{′}(x)$  for $f(x)=5x+4\\operatorname{arccos}⁡x.$" :question/worked-solution "The formula for the derivative of arccosine is\n\n$$\n\\frac{\\text{d}}{\\text{d}x}(\\operatorname{arccos}⁡x)=-\\frac{1}{\\sqrt{1-{x}^{2}}}.\n$$\n\nUsing the formula above, we get\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}(5x+4\\operatorname{arccos}⁡x) \\\\  & =5+4\\cdot \\frac{\\text{d}}{\\text{d}x}(\\operatorname{arccos}⁡x) \\\\  & =5+4(-\\frac{1}{\\sqrt{1-{x}^{2}}}) \\\\  & =5-\\frac{4}{\\sqrt{1-{x}^{2}}}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186247152 :knowledge-point/_questions [{:db/id #edb/ref 17592186064366 :knowledge-point/id #uuid "93a44f44-0998-5857-9b12-de8998e370fd" :knowledge-point/title "Differentiating an Inverse Cosine Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "14063917-2f5c-53ac-a1be-a84525cdd48b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8+\\frac{15}{\\sqrt{1-{x}^{2}}}" :db/id #edb/ref 17592186244495} {:answer/id #uuid "3bbb79dc-d168-5e6c-967d-301ffb7b9bec" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8x-\\frac{15}{\\sqrt{1-{x}^{2}}}" :db/id #edb/ref 17592186244839} {:answer/id #uuid "ac0b8241-b7f9-55f9-8dd0-032a83734e86" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "15-\\frac{8}{\\sqrt{1-{x}^{2}}}" :db/id #edb/ref 17592186245852} {:answer/id #uuid "c978eae8-643b-508b-8afb-0d9a95c8c8ab" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8-\\frac{15}{\\sqrt{1-{x}^{2}}}" :db/id #edb/ref 17592186246098} {:answer/id #uuid "caebc49d-d3db-5490-82b2-efb3f04c7f5f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8+\\frac{15x}{\\sqrt{1-{x}^{2}}}" :db/id #edb/ref 17592186246120}] :answer-field/correct {:answer/id #uuid "c978eae8-643b-508b-8afb-0d9a95c8c8ab" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8-\\frac{15}{\\sqrt{1-{x}^{2}}}" :db/id #edb/ref 17592186246098} :answer-field/id #uuid "cf16ad5d-42c4-5764-9634-f695fe575fed" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186246919}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "7680792c-1905-5073-9b89-1803e3b68661" :question/math-academy-id "q-110626" :question/problem "Calculate ${f}^{′}(x)$  for $f(x)=15\\operatorname{arccos}⁡x+8x.$" :question/worked-solution "The formula for the derivative of arccosine is\n\n$$\n\\frac{\\text{d}}{\\text{d}x}(\\operatorname{arccos}⁡x)=-\\frac{1}{\\sqrt{1-{x}^{2}}}.\n$$\n\nUsing the formula above, we get\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}(15\\operatorname{arccos}⁡x+8x) \\\\  & =15\\cdot \\frac{\\text{d}}{\\text{d}x}(\\operatorname{arccos}⁡x)+8 \\\\  & =15(-\\frac{1}{\\sqrt{1-{x}^{2}}})+8 \\\\  & =8-\\frac{15}{\\sqrt{1-{x}^{2}}}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186247161 :knowledge-point/_questions [{:db/id #edb/ref 17592186064367 :knowledge-point/id #uuid "c5582e8b-3870-5a32-b15e-62b8f8306ce6" :knowledge-point/title "Differentiating Inverse Trigonometric Functions Using the Product or Quotient Rule"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "149dcaee-a842-584c-9fc7-09c4da3304aa" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{6{x}^{2}+3{x}^{5}\\operatorname{arctan}⁡({x}^{3})}{({x}^{6}+1)^{2}}" :db/id #edb/ref 17592186244503} {:answer/id #uuid "768d48e2-8c95-5280-ba0c-8ed707947487" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{x}^{2}-6{x}^{6}\\operatorname{arctan}⁡({x}^{3})}{({x}^{6}+1)^{2}}" :db/id #edb/ref 17592186245367} {:answer/id #uuid "80e24ca9-2891-539c-a111-b07fb4ce033f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{x}^{3}-6{x}^{5}\\operatorname{arctan}⁡({x}^{3})}{({x}^{6}+1)^{2}}" :db/id #edb/ref 17592186245451} {:answer/id #uuid "8759d4f9-38b4-5c69-b25c-92f362595b22" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3{x}^{2}-6{x}^{5}\\operatorname{arctan}⁡({x}^{3})}{({x}^{6}+1)^{2}}" :db/id #edb/ref 17592186245505} {:answer/id #uuid "ef4377e7-ae39-50b4-a1fe-882b741bc63b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3{x}^{2}+{x}^{6}\\operatorname{arctan}⁡({x}^{3})}{({x}^{6}+1)^{2}}" :db/id #edb/ref 17592186246431}] :answer-field/correct {:answer/id #uuid "8759d4f9-38b4-5c69-b25c-92f362595b22" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3{x}^{2}-6{x}^{5}\\operatorname{arctan}⁡({x}^{3})}{({x}^{6}+1)^{2}}" :db/id #edb/ref 17592186245505} :answer-field/id #uuid "c6b18822-cc1c-50af-9989-8e193167758f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186246905}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "2888c71d-c895-59c2-afdb-577636636ba4" :question/math-academy-id "q-110762" :question/problem "Calculate $\\frac{\\text{d}y}{\\text{d}x}$ for $y=\\frac{\\operatorname{arctan}⁡({x}^{3})}{{x}^{6}+1}.$" :question/worked-solution "Applying the quotient rule, using the formula for the derivative of $\\operatorname{arctan}⁡x$ and applying the chain rule, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}}{\\text{d}x}(\\frac{\\operatorname{arctan}⁡({x}^{3})}{{x}^{6}+1}) \\\\  & =\\frac{({x}^{6}+1)\\cdot \\frac{\\text{d}}{\\text{d}x}(\\operatorname{arctan}⁡({x}^{3}))-\\operatorname{arctan}⁡({x}^{3})\\cdot \\frac{\\text{d}}{\\text{d}x}({x}^{6}+1)}{({x}^{6}+1)^{2}} \\\\  & =\\frac{({x}^{6}+1)\\cdot \\frac{1}{{x}^{6}+1}\\cdot \\frac{\\text{d}}{\\text{d}x}({x}^{3})-\\operatorname{arctan}⁡({x}^{3})\\cdot 6{x}^{5}}{({x}^{6}+1)^{2}} \\\\  & =\\frac{\\frac{({x}^{6}+1)(3{x}^{2})}{{x}^{6}+1}-6{x}^{5}\\operatorname{arctan}⁡({x}^{3})}{({x}^{6}+1)^{2}} \\\\  & =\\frac{3{x}^{2}-6{x}^{5}\\operatorname{arctan}⁡({x}^{3})}{({x}^{6}+1)^{2}}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186247163 :knowledge-point/_questions [{:db/id #edb/ref 17592186064367 :knowledge-point/id #uuid "c5582e8b-3870-5a32-b15e-62b8f8306ce6" :knowledge-point/title "Differentiating Inverse Trigonometric Functions Using the Product or Quotient Rule"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "22a2e63d-ce23-5f94-b43c-fe498a90aeef" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{{e}^{x}\\sqrt{1-{x}^{2}}}-\\frac{\\operatorname{arccos}⁡x}{{e}^{x}}" :db/id #edb/ref 17592186244617} {:answer/id #uuid "5d4c6d81-2c16-5cd7-b161-403eb27b5d97" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{{e}^{x}\\sqrt{1-{x}^{2}}}-\\frac{\\operatorname{arcsin}⁡x}{{e}^{x}}" :db/id #edb/ref 17592186245137} {:answer/id #uuid "646d492b-7b50-5a66-b9d1-b587fee404cc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{{e}^{x}}{\\sqrt{1-{x}^{2}}}+\\frac{\\operatorname{arccos}⁡x}{{e}^{x}}" :db/id #edb/ref 17592186245197} {:answer/id #uuid "aca6fa25-92b4-55d1-9de0-7256742207ad" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{e}^{x}}{\\sqrt{1-{x}^{2}}}-\\frac{\\operatorname{arcsin}⁡x}{{e}^{x}}" :db/id #edb/ref 17592186245855} {:answer/id #uuid "f3bf57b6-e50e-5557-a8b2-a49cf3d68351" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{\\sqrt{1-{x}^{2}}}+\\frac{\\operatorname{arcsin}⁡x}{{e}^{x}}" :db/id #edb/ref 17592186246464}] :answer-field/correct {:answer/id #uuid "5d4c6d81-2c16-5cd7-b161-403eb27b5d97" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{{e}^{x}\\sqrt{1-{x}^{2}}}-\\frac{\\operatorname{arcsin}⁡x}{{e}^{x}}" :db/id #edb/ref 17592186245137} :answer-field/id #uuid "1df422f0-6fd5-5d06-9f9a-8e3773d8232b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186246598}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "fce053b7-4dd3-554f-bea5-f458f557cfe3" :question/math-academy-id "q-110777" :question/problem "Calculate $\\frac{\\text{d}y}{\\text{d}x}$ for $y=\\frac{\\operatorname{arcsin}⁡x}{{e}^{x}}.$" :question/worked-solution "Applying the quotient rule and using the formula for the derivative of $\\operatorname{arcsin}⁡x,$  we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}(\\frac{\\operatorname{arcsin}⁡x}{{e}^{x}}) & =\\frac{{e}^{x}\\cdot \\frac{\\text{d}}{\\text{d}x}(\\operatorname{arcsin}⁡x)-\\operatorname{arcsin}⁡x\\cdot \\frac{\\text{d}}{\\text{d}x}({e}^{x})}{{({e}^{x})}^{2}} \\\\  & =\\frac{{e}^{x}\\cdot \\frac{1}{\\sqrt{1-{x}^{2}}}-\\operatorname{arcsin}⁡x\\cdot {e}^{x}}{{e}^{2x}} \\\\  & =\\frac{(\\frac{1}{\\sqrt{1-{x}^{2}}}-\\operatorname{arcsin}⁡x)}{{e}^{x}} \\\\  & =\\frac{1}{{e}^{x}\\sqrt{1-{x}^{2}}}-\\frac{\\operatorname{arcsin}⁡x}{{e}^{x}}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186386571 :knowledge-point/_questions [{:db/id #edb/ref 17592186157437 :knowledge-point/id #uuid "3758cf02-ba4b-539a-bc61-8c2030ff6f6f" :knowledge-point/title "Solving an Exponential Equation by Factoring"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "745439dc-de09-51c8-bbdb-eedea4d0f155" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186386573} {:answer/id #uuid "617f1c2d-99ac-5b8a-931f-683ccf1893b4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186386574} {:answer/id #uuid "db8e533b-8461-5017-a4f6-47771a90f0b9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186386575} {:answer/id #uuid "e510aa7f-7425-5853-824c-91e79e70849b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186386576} {:answer/id #uuid "2d786935-adc1-5afa-a4cc-25f126fdd263" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186386577}] :answer-field/correct {:answer/id #uuid "e510aa7f-7425-5853-824c-91e79e70849b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186386576} :answer-field/id #uuid "50a99769-405d-5ab0-ad5f-e1bf8543c410" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186386572}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "11afc858-764d-5d9d-a321-3ddf5528f806" :question/math-academy-id "q-110801" :question/problem "What is the product of solutions of the equation ${x}^{2}\\cdot {7}^{2-x}-{7}^{2-x}=0?$" :question/worked-solution "First, we factor the equation:\n\n$$\n\\begin{aligned}{x}^{2}\\cdot {7}^{2-x}-{7}^{2-x} & =0 \\\\ ({x}^{2}-1)\\cdot {7}^{2-x} & =0\\end{aligned}\n$$\n\n \n\nWe can now apply the zero product property, which states that $ab=0$ if and only if $a=0$ or $b=0.$ This gives us two equations,\n\n$$\n{x}^{2}-1=0\\,\\text{and}\\,{7}^{2-x}=0.\n$$\n\nWe now solve each of these equations separately.\n\n- The equation ${x}^{2}-1=0$ can be factored as\n\n$$\n(x+1)(x-1)=0,\n$$\n\nwhich leads to the solutions $x=-1,1.$\n\n- The equation ${7}^{2-x}=0$ has no solutions because ${7}^{2-x}$ is positive for every real number $x.$\n\nTherefore, the original equation has the solutions $x=-1,1,$ and their product is $-1\\cdot 1=-1.$"}] [{:db/id #edb/ref 17592186386578 :knowledge-point/_questions [{:db/id #edb/ref 17592186157438 :knowledge-point/id #uuid "8aaf12cf-8596-5960-bc68-5ca3eb5fab0f" :knowledge-point/title "Solving an Exponential Equation by Rearranging the Equation and Then Factoring"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "83cca658-4075-5016-8fbe-e5612324db1b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186386580} {:answer/id #uuid "bb580306-8e14-5c41-83ea-3c1ee2e8cdf1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186386581} {:answer/id #uuid "c11a3bed-2998-59a1-97a6-f48556210e01" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186386582} {:answer/id #uuid "e3957c19-6d34-5546-aa5e-4ed5649688c3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186386583} {:answer/id #uuid "7ddd09f0-bf49-52e2-98a4-7a4a058d7c69" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186386584}] :answer-field/correct {:answer/id #uuid "e3957c19-6d34-5546-aa5e-4ed5649688c3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186386583} :answer-field/id #uuid "e20ce4da-f186-5091-a95d-1d090861a47d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186386579}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "1ddd6b32-1ad1-5a92-b6ca-5f243dfcc079" :question/math-academy-id "q-110803" :question/problem "What is the product of solutions of the equation ${x}^{2}{10}^{2-x}={10}^{2-x}?$" :question/worked-solution "First, we factor the equation:\n\n$$\n\\begin{aligned}{x}^{2}{10}^{2-x} & ={10}^{2-x} \\\\ {x}^{2}{10}^{2-x}-{10}^{2-x} & =0 \\\\ ({x}^{2}-1){10}^{2-x} & =0\\end{aligned}\n$$\n\nWe can now apply the zero product property, which states that $ab=0$ if and only if $a=0$ or $b=0.$ This gives us two equations,\n\n$$\n{x}^{2}-1=0\\,\\text{and}\\,{10}^{2-x}=0.\n$$\n\nWe now solve each of these equations separately.\n\n- The equation ${x}^{2}-1=0$ can be factored as\n\n$$\n(x+1)(x-1)=0,\n$$\n\nwhich leads to the solutions $x=-1,1.$\n\n- The equation ${10}^{2-x}=0$ has no solutions because ${10}^{2-x}$ is positive for every real number $x.$\n\nTherefore, the original equation has the solutions $x=-1,1,$ and their product is $(-1)\\cdot 1=-1.$"}] [{:db/id #edb/ref 17592186247169 :knowledge-point/_questions [{:db/id #edb/ref 17592186115399 :knowledge-point/id #uuid "20a5f15e-8a26-57af-a867-8f8ae02a91c1" :knowledge-point/title "Differentiating Inverse Reciprocal Trigonometric Functions Using the Quotient Rule"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1d6a9bcf-5b72-54d9-a128-8bd6ee36de0a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2x+4}{arccscx}+\\frac{{x}^{2}+4x}{\\sqrt{{x}^{2}-1}\\cdot {arccsc}^{2}x}" :db/id #edb/ref 17592186244573} {:answer/id #uuid "3a12daab-bb88-55ce-a334-ad69cb782225" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{x+4}{arccscx}-\\frac{{x}^{2}+4x}{|x|\\sqrt{{x}^{2}-1}\\cdot {arccsc}^{2}x}" :db/id #edb/ref 17592186244829} {:answer/id #uuid "734eb1e5-5d2c-548c-a909-d144450435b1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{4x+2}{arcsecx}+\\frac{{x}^{2}+4x}{|x|\\sqrt{{x}^{2}-1}\\cdot {arccsc}^{2}x}" :db/id #edb/ref 17592186245345} {:answer/id #uuid "d5f3b612-bac7-5a34-a41e-8ffc73c0c464" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2x+4}{arccscx}+\\frac{{x}^{2}+4x}{|x|\\sqrt{{x}^{2}-1}\\cdot {arccsc}^{2}x}" :db/id #edb/ref 17592186246219} {:answer/id #uuid "f484b6c9-af99-5523-b72f-2c18bf53b1b0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{x}^{2}+4}{arccscx}-\\frac{2x+4x}{|x|\\sqrt{{x}^{2}-1}\\cdot {arccsc}^{2}x}" :db/id #edb/ref 17592186246471}] :answer-field/correct {:answer/id #uuid "d5f3b612-bac7-5a34-a41e-8ffc73c0c464" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2x+4}{arccscx}+\\frac{{x}^{2}+4x}{|x|\\sqrt{{x}^{2}-1}\\cdot {arccsc}^{2}x}" :db/id #edb/ref 17592186246219} :answer-field/id #uuid "f6a0c5df-079e-53e1-9ee0-47a76e0ae5a0" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186246987}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "698df1fd-5fd3-5825-8b74-4170ba6ffbf1" :question/math-academy-id "q-110834" :question/problem "Calculate $\\frac{\\text{d}y}{\\text{d}x}$ for $y=\\frac{{x}^{2}+4x}{arccscx}.$" :question/worked-solution "Here, we let $u(x)={x}^{2}+4x$ and $v(x)=arccscx,$ and apply the quotient rule.\n\nWe use the formulae\n\n$$\n{u}^{′}(x)=2x+4\\,\\text{and}\\,{v}^{′}(x)=-\\frac{1}{|x|\\sqrt{{x}^{2}-1}}.\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{{u}^{′}(x)\\cdot v(x)-u(x)\\cdot {v}^{′}(x)}{[v(x)]^{2}} \\\\  & =\\frac{(2x+4)\\cdot arccscx-({x}^{2}+4x)\\cdot (-\\frac{1}{|x|\\sqrt{{x}^{2}-1}})}{{arccsc}^{2}x} \\\\  & =\\frac{2x+4}{arccscx}+\\frac{{x}^{2}+4x}{|x|\\sqrt{{x}^{2}-1}\\cdot {arccsc}^{2}x}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186247230 :knowledge-point/_questions [{:db/id #edb/ref 17592186152116 :knowledge-point/id #uuid "db871222-7398-5fea-8097-bcf669751a40" :knowledge-point/title "Finding the LCM of Two Polynomials that Differ by a Constant Factor"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0e8d13e1-a99f-5ab7-a526-b7cfba5e8813" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "9(z-4)^{2}" :db/id #edb/ref 17592186244444} {:answer/id #uuid "0ea68ebf-9255-53a8-a395-205c70267496" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "14(z-4)^{2}" :db/id #edb/ref 17592186244446} {:answer/id #uuid "7c28feb1-7589-5e8d-9418-28850a614574" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "28(z-4)^{4}" :db/id #edb/ref 17592186245401} {:answer/id #uuid "a73784f2-2fb7-5100-b1a9-c95f9187984f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "28(z-4)^{2}" :db/id #edb/ref 17592186245812} {:answer/id #uuid "f54ce985-d718-578e-8921-d62dfebbfd89" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "14(z-4)^{4}" :db/id #edb/ref 17592186246478}] :answer-field/correct {:answer/id #uuid "0ea68ebf-9255-53a8-a395-205c70267496" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "14(z-4)^{2}" :db/id #edb/ref 17592186244446} :answer-field/id #uuid "b7db519b-b493-5c2a-b1f8-3f09714be182" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186246881}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "1022040b-f64c-5ed6-9959-011542bf6e8b" :question/math-academy-id "q-111582" :question/problem "Find the least common multiple of $2(z-4)^{2}$ and $7(z-4)^{2}.$" :question/worked-solution "To find the least common multiple ($\\text{LCM}$) of two polynomials that are made up of products of binomials, we find the least common multiple of the constants and the least common multiple of the variable part. Then, we multiply all of the results together.\n\nSo first, we find $\\text{LCM}(2,7):$\n\n- Multiples of $2:$ $\\,2,\\,4,…,\\,12,\\,14,16,…$\n\n- Multiples of $7:$ $\\,7,\\,14,\\,21,…$\n\nSo, $\\text{LCM}(2,7)=14.$\n\nSince the variable part is the same in the expressions, we have\n\n$$\n\\text{LCM}((z-4)^{2},\\,(z-4)^{2})=(z-4)^{2}.\n$$\n\nFinally, we multiply all of our results together:\n\n$$\n\\text{LCM}(2(z-4)^{2},\\,7(z-4)^{2})=14\\cdot (z-4)^{2}=14(z-4)^{2}.\n$$"}] [{:db/id #edb/ref 17592186247239 :knowledge-point/_questions [{:db/id #edb/ref 17592186129142 :knowledge-point/id #uuid "5dce1c69-c79d-541a-b479-8fc127352c2a" :knowledge-point/title "Identifying the Graph of a Polynomial"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1936865a-0f4e-52f9-91d5-746d678fde4f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "D" :db/id #edb/ref 17592186244539} {:answer/id #uuid "6a2c32d0-0d87-5f9d-a922-71f4c277c5e8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "C" :db/id #edb/ref 17592186245254} {:answer/id #uuid "9c38f3d9-2abb-52d7-862f-ac3326faabc1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "B" :db/id #edb/ref 17592186245699} {:answer/id #uuid "9db779f5-dbcf-55a9-a973-1dad55349d1b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "None of the given options is correct" :db/id #edb/ref 17592186245719} {:answer/id #uuid "ec748b7b-f501-5ca3-adaf-ebbcea9f3b55" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "A" :db/id #edb/ref 17592186246405}] :answer-field/correct {:answer/id #uuid "ec748b7b-f501-5ca3-adaf-ebbcea9f3b55" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "A" :db/id #edb/ref 17592186246405} :answer-field/id #uuid "636cbec4-06e4-5b40-9927-087ffb75e1a0" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186246721}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "521eada5-fcae-5914-a56b-54aece215449" :question/math-academy-id "q-112076" :question/problem "![](images/83/83b8d9a8d8f1cd9cc79fb10964e0d34c38204cc518a1e5175ac9a826127cd548.png)\n\nWhich of the above could be the graph of $y={x}^{3}-4x?$" :question/worked-solution "Let's call $P(x)$ the given polynomial:\n\n$$\nP(x)={x}^{3}-4x\n$$\n\nThe degree $(n=3)$ is odd and the leading coefficient $({a}_{3}=1)$ is positive. Therefore, the polynomial has the following end behavior:\n\n- $P(x)\\to -\\infty $ as $x\\to -\\infty .$\n\n- $P(x)\\to \\infty $ as $x\\to \\infty .$\n\nOnly the graph $A$ satisfies these conditions."}] [{:db/id #edb/ref 17592186247258 :knowledge-point/_questions [{:db/id #edb/ref 17592186171956 :knowledge-point/id #uuid "be11193b-a241-5812-a1c1-54d233ae9ddd" :knowledge-point/title "Determining the Value of a Binomial Coefficient"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2d834456-fd92-55f5-941e-3eb305dec713" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186244722} {:answer/id #uuid "3cc1b262-e0bb-5f32-9ca5-acaaad5a8816" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "9" :db/id #edb/ref 17592186244848} {:answer/id #uuid "3ef8a6f0-3f3d-54ea-aad2-d48b15ce196e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186244868} {:answer/id #uuid "61851206-c16f-5bde-bcf9-39ad15b3a54e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186245165} {:answer/id #uuid "84f31bc7-e7cd-53ed-9cce-1c536d30a70e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186245487}] :answer-field/correct {:answer/id #uuid "84f31bc7-e7cd-53ed-9cce-1c536d30a70e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186245487} :answer-field/id #uuid "ec673f44-f9b5-558a-81c0-2ead76584e8f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186246970}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "f22cfc7d-e4da-562f-9d3d-9e3613fd5a63" :question/math-academy-id "q-112325" :question/problem "Use Pascal's triangle to determine the value of $(\\frac{3}{3}).$" :question/worked-solution "To find the value of $(\\frac{3}{3}),$ we need to find the number that is located in row $3$ and position $3$ of Pascal's triangle. \n\n**Important**: When counting the rows and positions in Pascal's triangle, we always start counting from zero! Remember:\n\n- The top row of Pascal's triangle is row $0.$\n\n- The first position of each row (the one of the left) is position number $0.$\n\nThe value located in row $3$ and position $3$ is highlighted below.\n\n$$\n\\begin{aligned} &  &  &  &  &  & 1 \\\\  &  &  &  &  & 1 &  & 1 \\\\  &  &  &  & 1 &  & 2 &  & 1 \\\\  &  &  & 1 &  & 3 &  & 3 &  & 1 \\\\  &  & 1 &  & 4 &  & 6 &  & 4 &  & 1 \\\\  & ⋮ &  & ⋮ &  & ⋮ &  & ⋮ &  & ⋮ &  & ⋮\\end{aligned}\n$$\n\nTherefore, $(\\frac{3}{3})=1.$"}] [{:db/id #edb/ref 17592186247263 :knowledge-point/_questions [{:db/id #edb/ref 17592186064154 :knowledge-point/id #uuid "c7df31c9-b27a-5ce2-93c8-178ba96da000" :knowledge-point/title "Determining a Rate of Change"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "04171382-cbfa-5f10-92fb-22e5c7a6e6de" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$20$ percent per hour" :db/id #edb/ref 17592186244346} {:answer/id #uuid "284bf059-1884-5e2d-a5c3-731890221cc7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$2$ percent per hour" :db/id #edb/ref 17592186244669} {:answer/id #uuid "51d5b6bd-e195-5c6e-bf88-1a79c021dc21" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$10$ percent per hour" :db/id #edb/ref 17592186245038} {:answer/id #uuid "6d228c5d-7d6a-5f80-841c-f0172b125cc3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$40$ percent per hour" :db/id #edb/ref 17592186245278} {:answer/id #uuid "7452c71d-92bf-59ad-847f-f7ba52f5ece7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$4$ percent per hour" :db/id #edb/ref 17592186245349}] :answer-field/correct {:answer/id #uuid "04171382-cbfa-5f10-92fb-22e5c7a6e6de" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$20$ percent per hour" :db/id #edb/ref 17592186244346} :answer-field/id #uuid "4de83a2e-a171-5c7c-a155-600eb37ea0f6" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186246677}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "524d3949-c8de-5ba0-b1ba-ea4e8e41e832" :question/math-academy-id "q-112383" :question/problem "After charging the battery of a PC, the percentage of charge decreases at a rate of $c(t)=100\\cdot {5}^{-0.2t}$ percent per hour, where $t$ is the time, in hours, since the battery had completed its charge. What will be the rate of decrease after $5$ hours?" :question/worked-solution "Since we want to determine the rate of decrease in the amount of charge after $5$ hours, we have $t=5.$\n\nThus, the rate of decrease of the amount of charge after $5$ hours will be\n\n$$\n\\begin{aligned}c(5) & =100\\cdot {5}^{-0.2(5)} \\\\  & =100\\cdot {5}^{-1} \\\\  & =\\frac{100}{5} \\\\  & =20.\\end{aligned}\n$$\n\nTherefore, the rate of decrease will be $20$ percent per hour."}] [{:db/id #edb/ref 17592186399739 :knowledge-point/_questions [{:db/id #edb/ref 17592186068860 :knowledge-point/id #uuid "9d78ba1c-5297-5540-afdc-d419d33e0cf7" :knowledge-point/title "Solving a Quadratic Equation When the Solutions Are Rational"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "88f1c5a8-42ee-5523-84ec-f29f28e0ac2c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$pq=-264\\,$ and $\\,{t}_{1}+{t}_{2}=-14$" :db/id #edb/ref 17592186399741} {:answer/id #uuid "eb2399df-9166-5676-8f9c-a51959d4ab11" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$pq=343\\,$ and $\\,{t}_{1}+{t}_{2}=-14$" :db/id #edb/ref 17592186399742} {:answer/id #uuid "dff389cf-80e0-5f10-b6f2-86dcbc11e52c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$pq=-14\\,$ and $\\,{t}_{1}+{t}_{2}=49$" :db/id #edb/ref 17592186399743} {:answer/id #uuid "c14d9b4a-b38e-5fab-ad4f-cb09b4aea808" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$pq=-343\\,$ and $\\,{t}_{1}+{t}_{2}=-14$" :db/id #edb/ref 17592186399744} {:answer/id #uuid "7dec2dec-aebb-5a50-befe-935b17a9002a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$pq=-343\\,$ and $\\,{t}_{1}+{t}_{2}=14$" :db/id #edb/ref 17592186399745}] :answer-field/correct {:answer/id #uuid "7dec2dec-aebb-5a50-befe-935b17a9002a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$pq=-343\\,$ and $\\,{t}_{1}+{t}_{2}=14$" :db/id #edb/ref 17592186399745} :answer-field/id #uuid "9feed68a-3a5e-5bf8-a32b-19c5c668ac59" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186399740}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "fac39442-17f5-5ace-9954-931f61698611" :question/math-academy-id "q-112457" :question/problem "The equation ${t}^{2}-14t+5=5$ can be written in the form $(t+p{)}^{2}=q.$ Find $\\,pq\\,,$ and the sum of the roots ${t}_{1}+{t}_{2}.$" :question/worked-solution "First, we move the constant term to the right-hand side and complete the square on the left-hand side:\n\n$$\n\\begin{aligned}{t}^{2}-14t+5 & =5 \\\\ {t}^{2}-14t & =0 \\\\ {t}^{2}-2\\cdot t\\cdot 7+{7}^{2}-{7}^{2} & =0 \\\\ (t-7{)}^{2}-{7}^{2} & =0 \\\\ (t-7{)}^{2} & =49\\end{aligned}\n$$\n\nHence, $p=-7$ and $q=49.$ Thus, $pq=-343.$\n\nWe now solve the equation using the square root method:\n\n$$\n\\begin{aligned}(t-7{)}^{2} & =49 \\\\ \\sqrt{(t-7{)}^{2}} & =\\sqrt{49} \\\\ |t-7| & =7 \\\\ t-7 & =\\pm 7 \\\\ t & =7\\pm 7\\end{aligned}\n$$\n\nWe simplify the two solutions:\n\n$$\n\\begin{aligned}{t}_{1} & =7-7=0 \\\\ {t}_{2} & =7+7=14\\end{aligned}\n$$\n\nTherefore, the sum is ${t}_{1}+{t}_{2}=14.$"}] [{:db/id #edb/ref 17592186399746 :knowledge-point/_questions [{:db/id #edb/ref 17592186068861 :knowledge-point/id #uuid "a7f04ab7-f6f6-5d01-bfcf-b667e37e4f0b" :knowledge-point/title "Solving a Quadratic Equation When the Solutions Are Irrational"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c39a0e2e-7b56-5be7-b30b-746a3a4150cf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "p+q=12,\\,m=-4\\pm 2\\sqrt{2}" :db/id #edb/ref 17592186399748} {:answer/id #uuid "015db316-4ebb-5b1d-99f9-48da4423ea95" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "p+q=10,\\,m=-2\\pm \\sqrt{2}" :db/id #edb/ref 17592186399749} {:answer/id #uuid "6bce9687-7b54-57ab-bfdf-8d118e548ef3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "p+q=8,\\,m=4\\pm 2\\sqrt{2}" :db/id #edb/ref 17592186399750} {:answer/id #uuid "b47af5b9-db68-5705-87ff-a810d0b94396" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "p+q=10,\\,m=4\\pm 2\\sqrt{3}" :db/id #edb/ref 17592186399751} {:answer/id #uuid "51890425-293e-58e0-898f-8746f49fa609" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "p+q=14,\\,m=-4\\pm 2\\sqrt{3}" :db/id #edb/ref 17592186399752}] :answer-field/correct {:answer/id #uuid "c39a0e2e-7b56-5be7-b30b-746a3a4150cf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "p+q=12,\\,m=-4\\pm 2\\sqrt{2}" :db/id #edb/ref 17592186399748} :answer-field/id #uuid "1d4fba57-c484-5fd0-a729-550a53e648f6" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186399747}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "6d70e8a4-cad6-5c6f-b225-88fe32f8d423" :question/math-academy-id "q-112487" :question/problem "The equation ${m}^{2}+8=-8m$ can be written in the form $(m+p)^{2}=q.$ Find $p+q,$ and solve the equation." :question/worked-solution "First, we move the constant term to the right-hand side, the $-8m$ term to the left-hand side, and complete the square on the left-hand side.\n\n$$\n\\begin{aligned}{m}^{2}+8 & =-8m \\\\ {m}^{2}+8m & =-8 \\\\ {m}^{2}+2\\cdot 4\\cdot m & =-8 \\\\ {m}^{2}+2\\cdot 4\\cdot m+{4}^{2}-{4}^{2} & =-8 \\\\ (m+4)^{2}-{4}^{2} & =-8\\end{aligned}\n$$\n\nThen, we isolate the perfect square:\n\n$$\n\\begin{aligned}(m+4)^{2}-{4}^{2} & =-8 \\\\ (m+4)^{2} & =8\\end{aligned}\n$$\n\nSo, $p=4,q=8,$ and $p+q=12.$\n\nNext, we solve the equation using the square-root method:\n\n$$\n\\begin{aligned}(m+4)^{2} & =8 \\\\ \\sqrt{(m+4)^{2}} & =\\sqrt{8} \\\\ |m+4| & =\\sqrt{8} \\\\ m+4 & =\\pm 2\\sqrt{2} \\\\ m & =-4\\pm 2\\sqrt{2}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186399760 :knowledge-point/_questions [{:db/id #edb/ref 17592186184191 :knowledge-point/id #uuid "257b907c-70c1-5bbd-a6d2-297d51325d1f" :knowledge-point/title "Solving a Quadratic Equation With a Positive Leading Coefficient"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b361b7f6-2975-5ed2-b3d6-cb981bcbc5f6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "p+q=6" :db/id #edb/ref 17592186399762} {:answer/id #uuid "af436aca-c25b-50d1-ae25-749ecc05a446" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "p+q=12" :db/id #edb/ref 17592186399763} {:answer/id #uuid "ef4e5843-97cc-5c3b-b643-9e3130891ce7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "p+q=4" :db/id #edb/ref 17592186399764} {:answer/id #uuid "04e15661-c522-5a93-a20e-dafb0bf87524" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "p+q=10" :db/id #edb/ref 17592186399765} {:answer/id #uuid "ab45afe2-3455-59a3-8889-5adbe62eaacf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "p+q=8" :db/id #edb/ref 17592186399766}] :answer-field/correct {:answer/id #uuid "ab45afe2-3455-59a3-8889-5adbe62eaacf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "p+q=8" :db/id #edb/ref 17592186399766} :answer-field/id #uuid "b5f1bfdb-7442-5063-835b-afe41546d21e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186399761}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "eaa71aa3-e92b-5db0-96a6-7043b42bf47f" :question/math-academy-id "q-112524" :question/problem "The equation $4{x}^{2}+6x-5=0$ can be written in the form $4(x+p)^{2}=q.$ Find $p+q.$" :question/worked-solution "First, we move the constant term to the right-hand side, factor the coefficient of the quadratic term, and complete the square on the left-hand side.\n\n$$\n\\begin{aligned}4{x}^{2}+6x-5 & =0 \\\\ 4{x}^{2}+6x & =5 \\\\ 4({x}^{2}+\\frac{3}{2}x) & =5 \\\\ 4[{x}^{2}+2\\cdot \\frac{3}{4}\\cdot x+{(\\frac{3}{4})}^{2}-{(\\frac{3}{4})}^{2}] & =5 \\\\ 4[{(x+\\frac{3}{4})}^{2}-{(\\frac{3}{4})}^{2}] & =5 \\\\ 4[{(x+\\frac{3}{4})}^{2}-\\frac{9}{16}] & =5\\end{aligned}\n$$\n\nNext, we expand the brackets, and write the equation in the required form:\n\n$$\n\\begin{aligned}4{(x+\\frac{3}{4})}^{2}-4\\cdot \\frac{9}{16} & =5 \\\\ 4{(x+\\frac{3}{4})}^{2}-\\frac{9}{4} & =5 \\\\ 4{(x+\\frac{3}{4})}^{2} & =\\frac{29}{4}\\end{aligned}\n$$\n\nTherefore, $p=\\frac{3}{4}$ and $q=\\frac{29}{4}.$ Finally,\n\n$$\np+q=\\frac{3}{4}+\\frac{29}{4}=\\frac{32}{4}=8.\n$$"}] [{:db/id #edb/ref 17592186247286 :knowledge-point/_questions [{:db/id #edb/ref 17592186096784 :knowledge-point/id #uuid "f7578c48-cc9e-5170-8ffe-5ebee6580677" :knowledge-point/title "Solving a System Containing Decimals in One Equation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a6ebfd06-d7c9-57b4-b164-23f6c520852b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186245809} {:answer/id #uuid "ae0c5246-8ce2-595b-ad3a-db2ecfd1e47e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186245867} {:answer/id #uuid "c4fb152b-7d3f-5c08-a1e9-825a6063554e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186246063} {:answer/id #uuid "d2cb50da-f2c1-5202-9d6c-9c29e5314403" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186246188} {:answer/id #uuid "e8a51a07-fd3f-5ae5-ae01-d02b470db8e9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-5" :db/id #edb/ref 17592186246373}] :answer-field/correct {:answer/id #uuid "c4fb152b-7d3f-5c08-a1e9-825a6063554e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186246063} :answer-field/id #uuid "e99cf02c-5f10-549e-80cb-8624ae42aa3b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186246962}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "67d9ca65-c314-5c48-b66e-c63d3eedec32" :question/math-academy-id "q-112561" :question/problem "Let $(x,y)$ be the solution of the following system. What is the value of $x+y?$\n\n$$\n{\\begin{aligned}x+3y=7 \\\\ 0.5x+0.4y=0.2\\end{aligned}\n$$" :question/worked-solution "To get rid of the decimals, we multiply the second equation by $10,$ as follows:\n\n$$\n{\\begin{aligned}x+3y=7 &  \\\\ 0.5x+0.4y=0.2 & |\\,\\times 10\\end{aligned}\\,⟹\\,{\\begin{aligned}x+3y=7 \\\\ 5x+4y=2\\end{aligned}\n$$\n\nNotice that if we multiply the  first equation by $-5,$ then we will get a $-5x$ term that can cancel with the $5x$ term in the second equation:\n\n$$\n{\\begin{aligned}x+3y=7 & |\\,\\times (-5) \\\\ 5x+4y=2\\end{aligned}\\,⟹\\,{\\begin{aligned}-5x-15y=-35 \\\\ 5x+4y=2\\end{aligned}\n$$\n\nAdding the two equations eliminates the $x$-variable and allows us to solve for $y:$\n\n$$\n\\begin{aligned}\\begin{aligned}-\\cancel{5x}-15y & =-35 \\\\ \\cancel{5x}+4y & =2 \\\\ (-15y+4y) & =(-33) \\\\ -11y & =-33 \\\\ y & =3\\end{aligned}\\end{aligned}\n$$\n\nFinally, we can substitute $y=3$ into the equation $x+3y=7$ to solve for $x:$\n\n$$\n\\begin{aligned}\\begin{aligned}x+3y & =7 \\\\ x+3(3) & =7 \\\\ x+9 & =7 \\\\ x & =-2\\end{aligned}\\end{aligned}\n$$\n\nTherefore, the solution to the system of equations is $x=-2,\\,y=3.$ So,\n\n$$\nx+y=(-2)+(3)=1.\n$$"}] [{:db/id #edb/ref 17592186247293 :knowledge-point/_questions [{:db/id #edb/ref 17592186129145 :knowledge-point/id #uuid "4fc09a0f-34d3-5ca9-9964-6cb00498bfa7" :knowledge-point/title "Identifying the Factored Polynomial Shown in a Graph"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1f558239-f4a4-5855-9197-acc15e505249" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=2x(x+2)(x+3{)}^{3}" :db/id #edb/ref 17592186244588} {:answer/id #uuid "3725f8b4-55f3-5d89-94d0-703eea9f7ae1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y={x}^{3}(x+2{)}^{3}(x+3{)}^{2}" :db/id #edb/ref 17592186244802} {:answer/id #uuid "9272bb35-cb93-5c03-9095-56d3bf0f34e1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=\\frac{1}{4}x(x+2)(x-3)" :db/id #edb/ref 17592186245590} {:answer/id #uuid "b34d6675-f629-5fa4-8fd7-539940bd8f9f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=5{x}^{3}(x+2{)}^{2}(x-3{)}^{3}" :db/id #edb/ref 17592186245912} {:answer/id #uuid "d04fc1cd-f13a-5132-a1fa-779918c80d88" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=\\frac{1}{5}{x}^{3}(x+2)(x-3)" :db/id #edb/ref 17592186246172}] :answer-field/correct {:answer/id #uuid "d04fc1cd-f13a-5132-a1fa-779918c80d88" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=\\frac{1}{5}{x}^{3}(x+2)(x-3)" :db/id #edb/ref 17592186246172} :answer-field/id #uuid "aef2415b-6234-5ebf-b592-60e406e41efb" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186246866}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "ac9b5d16-e129-5bbc-9ccb-344cad0daab4" :question/math-academy-id "q-112596" :question/problem "![](images/84/849535b983a64c97b4cf06afcc7da7598349dc3f14f771cd3ae20db2c0742e8b.png)\n\nWhich of the following could be the equation of the polynomial curve shown above?" :question/worked-solution "First, we notice that the function has precisely three distinct roots, $x=-2,$ $x=0$ and $x=3.$\n\nBased on the graph, we can make the following conclusions about the multiplicities of the roots:\n\n- Since the graph is *not* tangent to the $x$-axis at $x=-2,$ this root is a simple root (the multiplicity equals $1$).\n\n- Since the graph passes through $x=0,$ this root has odd multiplicity, and since the graph is tangent to the $x$-axis at $x=0,$ the multiplicity must be greater than one.\n\n- Since the graph is *not* tangent to the $x$-axis at $x=3,$ this root is a simple root (the multiplicity equals $1$).\n\nTherefore, the only possible equation is $y=\\frac{1}{5}{x}^{3}(x+2)(x-3).$"}] [{:db/id #edb/ref 17592186399767 :knowledge-point/_questions [{:db/id #edb/ref 17592186184192 :knowledge-point/id #uuid "3996c79f-9281-5b9d-9b33-8863f10adc33" :knowledge-point/title "Solving a Quadratic Equation With a Negative Leading Coefficient"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "51235c4b-9ea8-5be6-9202-8faae512d7e6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$p=2,\\,z=-\\frac{3}{2}$ and $z=2$" :db/id #edb/ref 17592186399769} {:answer/id #uuid "18c50e74-54e2-5b08-8781-bdac4e3eb829" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$p=2,\\,z=\\frac{1}{2}$ and $z=-\\frac{5}{2}$" :db/id #edb/ref 17592186399770} {:answer/id #uuid "0ef860dc-5a1c-5a5d-8cba-4a4b862a9b98" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$p=9,\\,z=-\\frac{1}{2}$ and $z=\\frac{3}{2}$" :db/id #edb/ref 17592186399771} {:answer/id #uuid "c6502671-64f9-549c-ad24-6af57af49c10" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$p=9,\\,z=-\\frac{1}{2}$ and $z=\\frac{9}{2}$" :db/id #edb/ref 17592186399772} {:answer/id #uuid "605403ec-6766-5b0b-898a-15f1f1697f89" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$p=2,\\,z=-\\frac{7}{2}$ and $z=-\\frac{1}{2}$" :db/id #edb/ref 17592186399773}] :answer-field/correct {:answer/id #uuid "605403ec-6766-5b0b-898a-15f1f1697f89" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$p=2,\\,z=-\\frac{7}{2}$ and $z=-\\frac{1}{2}$" :db/id #edb/ref 17592186399773} :answer-field/id #uuid "132377e4-a98b-5f45-bb48-4f5451b52524" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186399768}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "b0945056-0521-55d9-80fa-5db83ff53407" :question/math-academy-id "q-112612" :question/problem "The equation $-4{z}^{2}-16z-7=0$ can be written in the form $4(z+p)^{2}=q.$ Find $p,$ and solve the equation." :question/worked-solution "First, we multiply the equation by $-1:$\n\n$$\n\\begin{aligned}(-1)\\cdot (-4{z}^{2}-16z-7) & =(-1)\\cdot 0 \\\\ 4{z}^{2}+16z+7 & =0\\end{aligned}\n$$\n\nNow we move the constant term to the right-hand side and complete the square on the left-hand side:\n\n$$\n\\begin{aligned}4{z}^{2}+16z+7 & =0 \\\\ 4{z}^{2}+16z & =-7 \\\\ 4({z}^{2}+4z) & =-7 \\\\ 4[{z}^{2}+2\\cdot 2\\cdot z+{(2)}^{2}-{(2)}^{2}] & =-7 \\\\ 4[{(z+2)}^{2}-4] & =-7\\end{aligned}\n$$\n\nNext, we expand the brackets, and write the equation in the required form:\n\n$$\n\\begin{aligned}4{(z+2)}^{2}-4\\cdot 4 & =-7 \\\\ 4{(z+2)}^{2}-16 & =-7 \\\\ 4{(z+2)}^{2} & =-7+16 \\\\ 4{(z+2)}^{2} & =9\\end{aligned}\n$$\n\nTherefore, $p=2.$ We now solve the equation using the square root method:\n\n$$\n\\begin{aligned}4{(z+2)}^{2} & =9 \\\\ {(z+2)}^{2} & =\\frac{9}{4} \\\\ \\sqrt{{(z+2)}^{2}} & =\\sqrt{\\frac{9}{4}} \\\\ |z+2| & =\\frac{3}{2} \\\\ z+2 & =\\pm \\frac{3}{2} \\\\ z & =-2\\pm \\frac{3}{2}\\end{aligned}\n$$\n\nWe simplify the two solutions:\n\n$$\n\\begin{aligned}z & =-2-\\frac{3}{2}=-\\frac{7}{2} \\\\ z & =-2+\\frac{3}{2}=-\\frac{1}{2}\\end{aligned}\n$$\n\nSo, the solutions are $z=-\\frac{7}{2}$ and $z=-\\frac{1}{2}.$"}] [{:db/id #edb/ref 17592186398088 :knowledge-point/_questions [{:db/id #edb/ref 17592186054750 :knowledge-point/id #uuid "fc0ce2c2-36b9-526b-93d6-31bf223ef326" :knowledge-point/title "Determining the Multiplicity of a Root of a Cubic Polynomial Using the GCF"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b123c8c7-4f1d-5408-975f-32f6bc27b94c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=-6" :db/id #edb/ref 17592186398090} {:answer/id #uuid "4fbed8c3-42d9-5e77-8dee-f6c715eb878b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=0" :db/id #edb/ref 17592186398091} {:answer/id #uuid "30eda07a-1025-5c98-a57d-c93c05dbf778" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=0,6" :db/id #edb/ref 17592186398092} {:answer/id #uuid "0673668c-baa9-5ad3-9ebd-b6d66539f06e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=7" :db/id #edb/ref 17592186398093} {:answer/id #uuid "8827287c-1b1d-53c9-bec1-38ed29947161" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=-6,0" :db/id #edb/ref 17592186398094}] :answer-field/correct {:answer/id #uuid "4fbed8c3-42d9-5e77-8dee-f6c715eb878b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=0" :db/id #edb/ref 17592186398091} :answer-field/id #uuid "eeb8e003-ac5d-547c-aeff-048096576722" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186398089}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "c78b7fa0-e6a0-5d03-8538-f39afab9a911" :question/math-academy-id "q-112815" :question/problem "Which root(s) of the polynomial $p(x)=7{x}^{3}+42{x}^{2}$ have multiplicity $2?$" :question/worked-solution "First, we need to factor the polynomial. \n\nFor this polynomial, we can factor by noting that the greatest common factor of $7{x}^{3}$ and $42{x}^{2}$ is $7{x}^{2}:$\n\n$$\n\\begin{aligned}p(x) & =7{x}^{3}+42{x}^{2} \\\\  & =7{x}^{2}(x+6)\\end{aligned}\n$$\n\nTo find the roots and their multiplicities, we look at the factors:\n\n- The factor $x$ has an exponent of $2$ in the factored form of $p(x).$ So the root $x=0$ has multiplicity $2.$\n\n- The factor $(x+6)$ has an exponent of $1$ in the factored form of $p(x).$ So the root $x=-6$ has multiplicity $1.$\n\nIn conclusion, only the root $x=0$ has multiplicity $2.$"}] [{:db/id #edb/ref 17592186247313 :knowledge-point/_questions [{:db/id #edb/ref 17592186083306 :knowledge-point/id #uuid "a75b47ec-8d5a-545e-b915-daca92320322" :knowledge-point/title "Identifying Non-Roots of a Polynomial Using the Rational Roots Theorem"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2c017070-88fd-5d41-924a-dd54f0531459" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186244703} {:answer/id #uuid "4ac6a7f4-b7e5-5aab-882f-f2ec82413511" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186244981} {:answer/id #uuid "7d3708f5-187e-5b74-bb7c-fb6773b51adf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186245410} {:answer/id #uuid "b691b5c9-8cce-5aa4-9d4c-8759d0a10381" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{2}" :db/id #edb/ref 17592186245946} {:answer/id #uuid "bb2dabbb-0466-5a5e-8205-efb8aaaa4a25" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186245985}] :answer-field/correct {:answer/id #uuid "4ac6a7f4-b7e5-5aab-882f-f2ec82413511" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186244981} :answer-field/id #uuid "3a0be498-1922-5ad5-b70c-3159737e4b82" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186246646}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "b6b933a9-c0e8-5275-ae25-ac03d96707b1" :question/math-academy-id "q-112875" :question/problem "According to the rational roots theorem, which of the following **cannot** be a root of the polynomial $f(x)=2{x}^{3}-3{x}^{2}+6x-4?$" :question/worked-solution "Given a polynomial with integer coefficients, the rational roots theorem states that any rational roots of the polynomial must take the form\n\n$$\n\\pm \\frac{\\text{factor of the constant term}}{\\text{factor of the leading coefficient}}.\n$$\n\nFor the given polynomial $f(x),$ the constant term is $-4$ and the leading coefficient is $2.$ So, any rational roots of $f(x)$ must take the form\n\n$$\n\\pm \\frac{\\text{factor of }-4}{\\text{factor of }2}.\n$$\n\nOf the given answer choices, only $-3$ does not take the above form. The value $-3$ can be interpreted as a fraction $-\\frac{3}{1},$ and the numerator $(3)$ is not a factor of $-4.$"}] [{:db/id #edb/ref 17592186247314 :knowledge-point/_questions [{:db/id #edb/ref 17592186083306 :knowledge-point/id #uuid "a75b47ec-8d5a-545e-b915-daca92320322" :knowledge-point/title "Identifying Non-Roots of a Polynomial Using the Rational Roots Theorem"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "00cd694f-d390-52d9-a78d-058dcf78eb8a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{2}" :db/id #edb/ref 17592186244313} {:answer/id #uuid "152de8ab-d160-5e90-b2ca-ff89c3d91bfa" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186244509} {:answer/id #uuid "17313f34-dcb5-5781-b39d-796b35a3916f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "7" :db/id #edb/ref 17592186244528} {:answer/id #uuid "a5040499-a863-56b9-8a63-e98888aa5234" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{7}{2}" :db/id #edb/ref 17592186245794} {:answer/id #uuid "eea69027-2f10-55d7-b23d-3db9cf55ae48" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{21}" :db/id #edb/ref 17592186246425}] :answer-field/correct {:answer/id #uuid "eea69027-2f10-55d7-b23d-3db9cf55ae48" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{21}" :db/id #edb/ref 17592186246425} :answer-field/id #uuid "f324f8a5-9844-5e6d-9c1c-d5cb8449a00a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186246983}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "aa7f9c70-0361-57e7-9796-46db5368f8ef" :question/math-academy-id "q-112876" :question/problem "According to the rational roots theorem, which of the following **cannot** be a root of the polynomial $f(x)=14{x}^{4}+3{x}^{2}-x-7?$" :question/worked-solution "Given a polynomial with integer coefficients, the rational roots theorem states that any rational roots of the polynomial must take the form\n\n$$\n\\pm \\frac{\\text{factor of the constant term}}{\\text{factor of the leading coefficient}}.\n$$\n\nFor the given polynomial $f(x),$ the constant term is $-7$ and the leading coefficient is $14.$ So, any rational roots of $f(x)$ must take the form\n\n$$\n\\pm \\frac{\\text{factor of }-7}{\\text{factor of }14}.\n$$\n\nOf the given answer choices, only $\\frac{1}{21}$ does not take the above form. The denominator $(21)$ is not a factor of $14.$"}] [{:db/id #edb/ref 17592186247315 :knowledge-point/_questions [{:db/id #edb/ref 17592186083306 :knowledge-point/id #uuid "a75b47ec-8d5a-545e-b915-daca92320322" :knowledge-point/title "Identifying Non-Roots of a Polynomial Using the Rational Roots Theorem"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1bdc5f64-cc65-540a-b355-123212f724a5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186244560} {:answer/id #uuid "bed83593-683b-546b-bab1-d01fe899f6a4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "9" :db/id #edb/ref 17592186246017} {:answer/id #uuid "c9d3bb43-fec1-56df-afc1-989bac7cecd7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186246101} {:answer/id #uuid "ca89315e-0250-5749-b30e-2df535002d85" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{2}" :db/id #edb/ref 17592186246110} {:answer/id #uuid "ed290edf-cb24-5f1b-b56c-d0812c7e8baf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{6}" :db/id #edb/ref 17592186246410}] :answer-field/correct {:answer/id #uuid "1bdc5f64-cc65-540a-b355-123212f724a5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186244560} :answer-field/id #uuid "c78daab4-3bc4-5ac1-8d58-c8d47a3e136b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186246907}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "20875202-2f78-5deb-8279-48996bbf9d5a" :question/math-academy-id "q-112877" :question/problem "According to the rational roots theorem, which of the following **cannot** be a root of the polynomial $f(x)=-6{x}^{3}+{x}^{2}-9x+9?$" :question/worked-solution "Given a polynomial with integer coefficients, the rational roots theorem states that any rational roots of the polynomial must take the form\n\n$$\n\\pm \\frac{\\text{factor of the constant term}}{\\text{factor of the leading coefficient}}.\n$$\n\nFor the given polynomial $f(x),$ the constant term is $9$ and the leading coefficient is $-6.$ So, any rational roots of $f(x)$ must take the form\n\n$$\n\\pm \\frac{\\text{factor of }9}{\\text{factor of }-6}.\n$$\n\nOf the given answer choices, only $-2$ does not take the above form. The value $-2$ can be interpreted as a fraction $\\frac{2}{-1},$ and the numerator $(2)$ is not a factor of $9.$"}] [{:db/id #edb/ref 17592186247319 :knowledge-point/_questions [{:db/id #edb/ref 17592186083232 :knowledge-point/id #uuid "1b5f9ee9-a489-5048-8346-0116a19e9b4a" :knowledge-point/title "Counting the Number of Possible Rational Roots of a Polynomial"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "606072b8-1571-53f5-8358-b985e1d8ceae" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "32" :db/id #edb/ref 17592186245154} {:answer/id #uuid "9439af27-061f-5a51-9ce4-101131c1c895" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "20" :db/id #edb/ref 17592186245609} {:answer/id #uuid "b3ce193a-e790-539c-a55d-4caa8a112d35" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "16" :db/id #edb/ref 17592186245914} {:answer/id #uuid "d1f2fa8e-fdb5-5e9e-a57e-65611f8056d1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "36" :db/id #edb/ref 17592186246181} {:answer/id #uuid "dc1acaaa-6000-547c-bdb2-862487dabd47" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "12" :db/id #edb/ref 17592186246268}] :answer-field/correct {:answer/id #uuid "9439af27-061f-5a51-9ce4-101131c1c895" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "20" :db/id #edb/ref 17592186245609} :answer-field/id #uuid "68b65d4b-12e9-5cb7-b679-73b65f162679" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186246729}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "86a67078-b75c-5a5d-bcb6-0d3741c7e938" :question/math-academy-id "q-112964" :question/problem "For the polynomial $f(x)=20{x}^{5}-7{x}^{4}+x-4,$ how many *potential* roots are given by the rational roots theorem?" :question/worked-solution "Given a polynomial with integer coefficients, the rational roots theorem states that any rational roots of the polynomial must take the form\n\n$$\n\\pm \\frac{\\text{factor of the constant term}}{\\text{factor of the leading coefficient}}.\n$$\n\nFor the given polynomial:\n\n- The constant term is $-4,$ and its factors are $\\pm 1,$ $\\pm 2$ and $\\pm 4.$\n\n- The leading coefficient is $20,$ and its factors are $\\pm 1,$ $\\pm 2,$ $\\pm 4,$ $\\pm 5,$ $\\pm 10$ and $\\pm 20.$\n\nFirst, we list out all the possibilities for the numerator and denominator:\n\n$$\n\\begin{aligned}\\pm \\frac{1}{1}, & \\pm \\frac{1}{2}, & \\pm \\frac{1}{4}, & \\pm \\frac{1}{5}, & \\pm \\frac{1}{10}, & \\pm \\frac{1}{20}, \\\\ \\pm \\frac{2}{1}, & \\pm \\frac{2}{2}, & \\pm \\frac{2}{4}, & \\pm \\frac{2}{5}, & \\pm \\frac{2}{10}, & \\pm \\frac{2}{20}, \\\\ \\pm \\frac{4}{1}, & \\pm \\frac{4}{2}, & \\pm \\frac{4}{4}, & \\pm \\frac{4}{5}, & \\pm \\frac{4}{10}, & \\pm \\frac{4}{20}.\\end{aligned}\n$$\n\nNext, we reduce the fractions to the lowest terms:\n\n$$\n\\begin{aligned}\\pm 1, & \\pm \\frac{1}{2}, & \\pm \\frac{1}{4}, & \\pm \\frac{1}{5}, & \\pm \\frac{1}{10}, & \\pm \\frac{1}{20}, \\\\ \\pm 2, & \\pm 1, & \\pm \\frac{1}{2}, & \\pm \\frac{2}{5}, & \\pm \\frac{1}{5}, & \\pm \\frac{1}{10}, \\\\ \\pm 4, & \\pm 2, & \\pm 1, & \\pm \\frac{4}{5}, & \\pm \\frac{2}{5}, & \\pm \\frac{1}{5}.\\end{aligned}\n$$\n\nNotice that several potential roots are duplicates (shown above in red). Removing these duplicates, and listing those remaining in order from least to greatest in absolute value, we have\n\n$$\n\\pm \\frac{1}{20},\\,\\pm \\frac{1}{10},\\,\\pm \\frac{1}{5},\\,\\pm \\frac{1}{4},\\,\\pm \\frac{2}{5},\\,\\pm \\frac{1}{2},\\,\\pm \\frac{4}{5},\\,\\pm 1,\\,\\pm 2,\\,\\pm 4.\n$$\n\nThis makes a total of $20$ potential roots. (Remember that each $\\pm $ sign accounts for $2$ roots, and $2\\cdot 10=20.$)"}] [{:db/id #edb/ref 17592186247331 :knowledge-point/_questions [{:db/id #edb/ref 17592186179648 :knowledge-point/id #uuid "63080bb8-7a6a-505d-813a-e6c99d337064" :knowledge-point/title "Adding and Subtracting a Number and a Rational Expression"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0b25ac5b-cbcc-57ea-af98-36cbf2debd6e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{p-5}{p}" :db/id #edb/ref 17592186244417} {:answer/id #uuid "2835dbf8-8dfd-5b11-9840-111aa89d7e47" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2p-5}{p}" :db/id #edb/ref 17592186244668} {:answer/id #uuid "3e3d761c-0e4f-53bc-9bc6-dd4223070293" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2(p+5)}{p}" :db/id #edb/ref 17592186244861} {:answer/id #uuid "72ffb2d8-d1e6-5411-9428-219a615ab1ad" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2p+5}{p}" :db/id #edb/ref 17592186245343} {:answer/id #uuid "b2cd2d36-c9bd-5a3c-ac47-c6f5b8d1b85a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{p+5}{p}" :db/id #edb/ref 17592186245905}] :answer-field/correct {:answer/id #uuid "72ffb2d8-d1e6-5411-9428-219a615ab1ad" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2p+5}{p}" :db/id #edb/ref 17592186245343} :answer-field/id #uuid "3900ea01-ab69-50df-9eb2-9740cea656bb" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186246643}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "db256712-a567-5c31-aac9-855b317092f8" :question/math-academy-id "q-113217" :question/problem "Write $3+\\frac{5-p}{p}$ as a single fraction." :question/worked-solution "Using the fact that $3=\\frac{3}{1},$ we can write the expression as\n\n$$\n\\frac{3}{1}+\\frac{5-p}{p}.\n$$\n\n \n\nIn order to add the two fractions, we need them to have a common denominator. So, we put both fractions over a common denominator of $p$ by multiplying the top and bottom of the first fraction by $p:$\n\n$$\n\\begin{aligned}\\frac{3}{1}+\\frac{5-p}{p} & = \\\\ \\frac{p}{p}\\cdot \\frac{3}{1}+\\frac{5-p}{p} & = \\\\ \\frac{3p}{p}+\\frac{5-p}{p}\\end{aligned}\n$$\n\nFinally, we add the fractions and simplify the result:\n\n$$\n\\begin{aligned}\\frac{3p}{p}+\\frac{5-p}{p} & = \\\\ \\frac{3p+5-p}{p} & = \\\\ \\frac{2p+5}{p}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186247333 :knowledge-point/_questions [{:db/id #edb/ref 17592186179648 :knowledge-point/id #uuid "63080bb8-7a6a-505d-813a-e6c99d337064" :knowledge-point/title "Adding and Subtracting a Number and a Rational Expression"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "165183aa-3273-5868-996d-bf72842cf7e3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3(2h+1)}{h}" :db/id #edb/ref 17592186244519} {:answer/id #uuid "4270531d-a040-562e-b202-75ec50fead69" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3(2h-1)}{h}" :db/id #edb/ref 17592186244895} {:answer/id #uuid "9220ca4b-6d7c-5b14-9adf-33f3030837cd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2h-1}{h}" :db/id #edb/ref 17592186245586} {:answer/id #uuid "d60d60b4-9436-5997-b763-9f4ab2aa9c33" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{h-3}{h}" :db/id #edb/ref 17592186246220} {:answer/id #uuid "fc805e18-0d87-57e6-a207-15782a97edad" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2h+1}{h}" :db/id #edb/ref 17592186246523}] :answer-field/correct {:answer/id #uuid "4270531d-a040-562e-b202-75ec50fead69" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3(2h-1)}{h}" :db/id #edb/ref 17592186244895} :answer-field/id #uuid "c644fa58-4381-548f-9a70-2fdfff8866ea" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186246903}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "896043de-6bd3-58d0-93eb-3b6444623304" :question/math-academy-id "q-113219" :question/problem "Write $5+\\frac{h-3}{h}$ as a single fraction." :question/worked-solution "Using the fact that $5=\\frac{5}{1},$ we can write the expression as\n\n$$\n\\frac{5}{1}+\\frac{h-3}{h}.\n$$\n\n \n\nIn order to add the two fractions, we need them to have a common denominator. So, we put both fractions over a common denominator of $h$ by multiplying the top and bottom of the first fraction by $h:$\n\n$$\n\\begin{aligned}\\frac{5}{1}+\\frac{h-3}{h} & = \\\\ \\frac{h}{h}\\cdot \\frac{5}{1}+\\frac{h-3}{h} & = \\\\ \\frac{5h}{h}+\\frac{h-3}{h}\\end{aligned}\n$$\n\nFinally, we add the fractions and simplify the result:\n\n$$\n\\begin{aligned}\\frac{5h}{h}+\\frac{h-3}{h} & = \\\\ \\frac{5h+h-3}{h} & = \\\\ \\frac{6h-3}{h} & = \\\\ \\frac{3(2h-1)}{h}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186399788 :knowledge-point/_questions [{:db/id #edb/ref 17592186087830 :knowledge-point/id #uuid "a9c8c1d8-2662-5c15-b084-084f9e930141" :knowledge-point/title "Solving a Quadratic Equation With Complex Roots by Completing the Square"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ac5d4b19-8c81-5ba1-996a-70b59878a1fa" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "p+q=-28,\\,x=3\\pm 5\\,\\text{i}" :db/id #edb/ref 17592186399790} {:answer/id #uuid "6512548c-dca0-5e35-9fae-cb9552f71f4b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "p+q=22,\\,x=3\\pm 5\\,\\text{i}" :db/id #edb/ref 17592186399791} {:answer/id #uuid "ea660700-9472-591c-8a60-b82ac1eb0a78" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "p+q=-28,\\,x=5\\pm 3\\,\\text{i}" :db/id #edb/ref 17592186399792} {:answer/id #uuid "aa2d981b-ddf0-5166-b28f-034d57bae937" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "p+q=22,\\,x=5\\pm 3\\,\\text{i}" :db/id #edb/ref 17592186399793} {:answer/id #uuid "282a88ee-2e7c-579c-b7aa-4a73cb82ac9a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "p+q=-28,\\,x=3\\pm 3\\,\\text{i}" :db/id #edb/ref 17592186399794}] :answer-field/correct {:answer/id #uuid "ac5d4b19-8c81-5ba1-996a-70b59878a1fa" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "p+q=-28,\\,x=3\\pm 5\\,\\text{i}" :db/id #edb/ref 17592186399790} :answer-field/id #uuid "abb7896d-c7f4-5b7b-a55d-ac98d8904d0e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186399789}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "ed379096-4def-51e1-8cd6-e568b470e309" :question/math-academy-id "q-113245" :question/problem "The equation ${x}^{2}-6x+34=0$ can be written in the form $(x+p)^{2}=q.$ Find $p+q,$ and solve the equation." :question/worked-solution "We first move the constant to the right-hand side:\n\n$$\n\\begin{aligned}{x}^{2}-6x+34 & =0 \\\\ {x}^{2}-6x & =-34\\end{aligned}\n$$\n\nNext, we complete the square on the left-hand side:\n\n$$\n\\begin{aligned}{x}^{2}-6x & =-34 \\\\ {x}^{2}-2\\cdot 3x+{3}^{2}-{3}^{2} & =-34 \\\\ (x-3)^{2}-9 & =-34 \\\\ (x-3)^{2} & =-25\\end{aligned}\n$$\n\nTherefore, $p=-3,\\,q=-25,$ and $p+q=-28.$\n\nFinally, we solve the equation using the square root method:\n\n$$\n\\begin{aligned}(x-3)^{2} & =-25 \\\\ x-3 & =\\pm \\sqrt{-25} \\\\ x-3 & =\\pm 5\\,\\text{i} \\\\ x & =3\\pm 5\\,\\text{i}\\end{aligned}\n$$\n\nTherefore, the equation has two solutions, $x=3+5\\,\\text{i}$ and $x=3-5\\,\\text{i}.$"}] [{:db/id #edb/ref 17592186247339 :knowledge-point/_questions [{:db/id #edb/ref 17592186068753 :knowledge-point/id #uuid "8058df30-04de-555c-adfa-61fbf2b0ff31" :knowledge-point/title "Adding Rational Expressions in One Variable With Common Factors in the Denominators"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0af04033-a6ba-55b9-a3cf-e88062146da2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3+8v}{3+2v}" :db/id #edb/ref 17592186244413} {:answer/id #uuid "22c65f9d-8809-5b40-a4ac-12894dc5fb71" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3(2-v)}{2(3+2v)}" :db/id #edb/ref 17592186244619} {:answer/id #uuid "590e2778-3be8-5b98-82cb-b429232a3edf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3-8v}{2(3+2v)}" :db/id #edb/ref 17592186245100} {:answer/id #uuid "68f4011e-d001-588c-8473-c4e6ecca6ef6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5-8v}{2(3+2v)}" :db/id #edb/ref 17592186245240} {:answer/id #uuid "74a2e865-4b12-53b0-9d9d-023142d8fc7e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2(3+v)}{3+2v}" :db/id #edb/ref 17592186245352}] :answer-field/correct {:answer/id #uuid "22c65f9d-8809-5b40-a4ac-12894dc5fb71" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3(2-v)}{2(3+2v)}" :db/id #edb/ref 17592186244619} :answer-field/id #uuid "4f65e550-213e-5735-8350-553dfc51c9ee" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186246685}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "77efbc7d-72cb-5364-b916-b8865a568a34" :question/math-academy-id "q-113296" :question/problem "Given that $\\frac{7v}{2(3+2v)}=t$ and $\\frac{3-5v}{3+2v}=r,$ what is $t+r?$" :question/worked-solution "We wish to add the following fractions:\n\n$$\nt+r=\\frac{7v}{2(3+2v)}+\\frac{3-5v}{3+2v}\n$$\n\nIn order to add the two fractions, we need them to have a common denominator. Here, we can put both fractions over a common denominator of $2(3+2v)$ if we multiply the top and bottom of the second fraction by $2:$\n\n$$\n\\begin{aligned}\\frac{7v}{2(3+2v)}+\\frac{3-5v}{3+2v} & = \\\\ \\frac{7v}{2(3+2v)}+\\frac{2}{2}\\cdot \\frac{3-5v}{3+2v} & = \\\\ \\frac{7v}{2(3+2v)}+\\frac{2(3-5v)}{2(3+2v)} & = \\\\ \\frac{7v+2(3-5v)}{2(3+2v)} & = \\\\ \\frac{7v+6-10v}{2(3+2v)} & = \\\\ \\frac{6-3v}{2(3+2v)} & = \\\\ \\frac{3(2-v)}{2(3+2v)}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186247340 :knowledge-point/_questions [{:db/id #edb/ref 17592186068754 :knowledge-point/id #uuid "fb2231aa-8afa-57df-a43c-cb3add25b2cc" :knowledge-point/title "Adding Rational Expressions in Multiple Variables With Common Factors in the Denominators"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "01b8b770-6c21-56e3-b336-b5d95a1f29e8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2g}{2-h}" :db/id #edb/ref 17592186244324} {:answer/id #uuid "025ab6a7-c175-5bda-a5ae-71435f2b411c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5g-3}{2-h}" :db/id #edb/ref 17592186244327} {:answer/id #uuid "31851e6a-ae53-558a-abeb-21c73e270e9a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{g-8}{g(2-h)}" :db/id #edb/ref 17592186244756} {:answer/id #uuid "6ca976fc-984c-5548-a93e-3086a908c594" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5g-3}{g(2-h)}" :db/id #edb/ref 17592186245274} {:answer/id #uuid "baae5de1-50ed-564b-82ed-9a3209161644" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2g}{g(2-h)}" :db/id #edb/ref 17592186245981}] :answer-field/correct {:answer/id #uuid "6ca976fc-984c-5548-a93e-3086a908c594" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5g-3}{g(2-h)}" :db/id #edb/ref 17592186245274} :answer-field/id #uuid "a59a56f0-3a08-5ffd-bb0c-f4cdd17dbade" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186246841}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "d446f78d-7f19-5904-b8b0-ee54e70de00c" :question/math-academy-id "q-113303" :question/problem "Simplify $\\frac{5}{2-h}-\\frac{3}{g(2-h)}.$" :question/worked-solution "In order to subtract the two fractions, we need them to have a common denominator. Here, we can put both fractions over a common denominator of $g(2-h)$ if we multiply the top and bottom of the first fraction by $g:$\n\n$$\n\\begin{aligned}\\frac{5}{2-h}-\\frac{3}{g(2-h)} & = \\\\ \\frac{g}{g}\\cdot \\frac{5}{2-h}-\\frac{3}{g(2-h)} & = \\\\ \\frac{5g}{g(2-h)}-\\frac{3}{g(2-h)} & = \\\\ \\frac{5g-3}{g(2-h)} & \\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186386654 :knowledge-point/_questions [{:db/id #edb/ref 17592186068813 :knowledge-point/id #uuid "ea2f1348-55bf-5313-8d5e-a5a097231e97" :knowledge-point/title "Graphing a Stretched Reciprocal Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "22044db0-b676-5a41-8839-2fb6643aef6c" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/ee/eeb158823a32a215dcf72d67bd27b8ad5df238ee44af535afd5850a15f9d17c0.png" :db/id #edb/ref 17592186386656} {:answer/id #uuid "5cc5cd0e-29d2-5786-8b2b-2a6c87539104" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/fd/fdc3e5ca668f2e66df09049bfa51fbc156160c091164dafa5f217be1bfbb4c27.png" :db/id #edb/ref 17592186386657} {:answer/id #uuid "5ef4fb86-1493-59fa-ba65-4676e4d1f3dc" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/0f/0fe642f3c7873344885b0e030fb449a8bf882120e675f18d72668ccae3ef4b40.png" :db/id #edb/ref 17592186386658} {:answer/id #uuid "f202128d-2196-5