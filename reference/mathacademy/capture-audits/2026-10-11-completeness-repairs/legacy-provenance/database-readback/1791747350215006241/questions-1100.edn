#{[{:db/id #edb/ref 17592186338841 :knowledge-point/_questions [{:db/id #edb/ref 17592186115193 :knowledge-point/id #uuid "7995b377-1de4-5126-aa29-8cc30b4918f8" :knowledge-point/title "Finding the Slope of the Tangent at a Point of a Function Involving Reciprocal Trigonometric Functions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "20324c7d-2431-5dbf-89ba-4a62fbbbbdeb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2-\\frac{3}{\\pi }" :db/id #edb/ref 17592186336333} {:answer/id #uuid "2d601842-f51f-5a34-901c-3c87ed74673e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{\\pi }-2" :db/id #edb/ref 17592186336467} {:answer/id #uuid "c6ecc1e0-b453-5588-a3e8-923b6e7ebcab" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\pi -2" :db/id #edb/ref 17592186337797} {:answer/id #uuid "ec9d4934-d293-54d1-9eb4-aaf1a8bf5781" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{\\pi }" :db/id #edb/ref 17592186338096} {:answer/id #uuid "ef4a666c-1131-5d8c-a6c2-62062090c6e3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{\\pi }+2" :db/id #edb/ref 17592186338125}] :answer-field/correct {:answer/id #uuid "2d601842-f51f-5a34-901c-3c87ed74673e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{\\pi }-2" :db/id #edb/ref 17592186336467} :answer-field/id #uuid "743b193f-17c2-5199-b0eb-adc69b1674c6" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186338476}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "b4b4054a-401d-511c-ba0c-65722b1ecab6" :question/math-academy-id "q-70874" :question/problem "Find the slope of $y=f(x)$ at $x=\\frac{\\pi }{3}$ if $f(x)=ln⁡x+3csc⁡x.$" :question/worked-solution "First, we calculate the derivative using the sum rule:\n\n$$\n\\begin{aligned}\\begin{aligned}{f}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}(ln⁡x+3csc⁡x) \\\\  & =\\frac{1}{x}+3(-csc⁡xcot⁡x) \\\\  & =\\frac{1}{x}-3csc⁡xcot⁡x\\end{aligned}\\end{aligned}\n$$\n\nThen, we substitute $x=\\frac{\\pi }{3}$ in the derivative and get\n\n$$\n\\begin{aligned}\\begin{aligned}{f}^{′}(\\frac{\\pi }{3}) & =\\frac{1}{(\\frac{\\pi }{3})}-3csc⁡(\\frac{\\pi }{3})cot⁡(\\frac{\\pi }{3}) \\\\  & =\\frac{3}{\\pi }-3(\\frac{2}{\\sqrt{3}})(\\frac{1}{\\sqrt{3}}) \\\\  & =\\frac{3}{\\pi }-3(\\frac{2}{3}) \\\\  & =\\frac{3}{\\pi }-2.\\end{aligned}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186338844 :knowledge-point/_questions [{:db/id #edb/ref 17592186087655 :knowledge-point/id #uuid "82d6988b-3220-578f-ba1c-cd86b9e3dbf9" :knowledge-point/title "Finding the Equation of a Circle Given the Center and the Radius"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5fbf4e0c-e58b-5108-bbb0-4fd59e0d8f51" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(x+1)^{2}+(y-2)^{2}=25" :db/id #edb/ref 17592186336899} {:answer/id #uuid "716b6ec9-6172-5328-9d80-1420c737a11d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(x-2)^{2}+(y-1)^{2}=25" :db/id #edb/ref 17592186337047} {:answer/id #uuid "a2353a98-7f3f-5dcb-8a84-2f6b9edb5c4c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(x-1)^{2}+(y-2)^{2}=25" :db/id #edb/ref 17592186337504} {:answer/id #uuid "cd350b86-92f1-5b47-8195-38e00e0239ed" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(x+1)^{2}+(y+2)^{2}=25" :db/id #edb/ref 17592186337831} {:answer/id #uuid "feac2e41-7550-5e75-ab07-0ad3fc367bb5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(x+2)^{2}+(y+1)^{2}=25" :db/id #edb/ref 17592186338266}] :answer-field/correct {:answer/id #uuid "a2353a98-7f3f-5dcb-8a84-2f6b9edb5c4c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(x-1)^{2}+(y-2)^{2}=25" :db/id #edb/ref 17592186337504} :answer-field/id #uuid "b8cce04b-83c9-5250-85c8-d53e40d3c24a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186338613}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "4b58a709-693d-534f-9bbe-586e11704f18" :question/math-academy-id "q-70896" :question/problem "![](images/ba/baa279bad56527ad959b2923f25df848396ffc7060c612469d637d4e614117b5.png)\n\nWhat is the equation of the circle given above?" :question/worked-solution "The general equation of a circle with radius $r$ centered at the point $(a,b)$ is \n\n$$\n(x-a)^{2}+(y-b)^{2}={r}^{2}.\n$$\n\nFrom the picture, we see that our circle is centered at $C(1,2)$ and the radius of the circle is $r=5.$ Therefore, the equation of the circle is\n\n$$\n\\begin{aligned}(x-a)^{2}+(y-b)^{2} & ={r}^{2} \\\\ (x-1)^{2}+(y-2)^{2} & ={5}^{2} \\\\ (x-1)^{2}+(y-2)^{2} & =25.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186403412 :knowledge-point/_questions [{:db/id #edb/ref 17592186096616 :knowledge-point/id #uuid "cef7fc21-23f4-5d6a-a208-9963ef23c784" :knowledge-point/title "Calculating the Slope of the Tangent Line of a Logarithmic Function at a Point"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8c631962-dd2a-53db-b827-84d94e8f7e53" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{9}{\\operatorname{ln}⁡10}-3" :db/id #edb/ref 17592186403414} {:answer/id #uuid "8f33e14e-f91d-5c5f-9b34-7c61ede2d34c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{\\operatorname{ln}⁡10}+27" :db/id #edb/ref 17592186403415} {:answer/id #uuid "33140677-5da7-59ef-8215-135fba67dffb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{3\\operatorname{ln}⁡10}+3" :db/id #edb/ref 17592186403416} {:answer/id #uuid "7fefc24f-ce9e-58b5-aba2-9f2cb372222e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{\\operatorname{ln}⁡10}-9" :db/id #edb/ref 17592186403417} {:answer/id #uuid "cc3a5a72-8cb5-5f5c-812b-2114a27a36be" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{\\operatorname{ln}⁡10}+9" :db/id #edb/ref 17592186403418}] :answer-field/correct {:answer/id #uuid "8f33e14e-f91d-5c5f-9b34-7c61ede2d34c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{\\operatorname{ln}⁡10}+27" :db/id #edb/ref 17592186403415} :answer-field/id #uuid "1fcab4c2-5aab-5cee-8699-609d2431de61" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186403413}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "ddfac57c-89c4-597b-b080-b0ac4a48d4c1" :question/math-academy-id "q-70903" :question/problem "Given that $y=3\\operatorname{log}⁡x+{x}^{3}-4$, find the slope of the tangent at $x=3.$" :question/worked-solution "To find the slope of the tangent at a given point, we have to find $\\frac{\\text{d}y}{\\text{d}x}$ at that point.\n\nTaking the derivative, we have\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}=\\frac{3}{x\\operatorname{ln}⁡10}+3{x}^{2}\\,.\n$$\n\nTherefore, the slope of the tangent at $x=1$ is \n\n$$\n\\begin{aligned}{\\frac{\\text{d}y}{\\text{d}x}|}_{x=3} & ={(\\frac{3}{x\\operatorname{ln}⁡10}+3{x}^{2})|}_{x=3} \\\\  & =\\frac{3}{3\\cdot \\operatorname{ln}⁡10}+3\\cdot {3}^{2} \\\\  & =\\frac{1}{\\operatorname{ln}⁡10}+27\\,.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186393050 :knowledge-point/_questions [{:db/id #edb/ref 17592186087656 :knowledge-point/id #uuid "89462485-2e28-5727-82c7-7afd0cac6d77" :knowledge-point/title "Finding the Center and Radius of a Circle Given Its Equation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "414d2687-cf0f-5475-b4de-9ae0e2a91b57" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The center is $(-1,-6)$ and radius is $4$" :db/id #edb/ref 17592186393052} {:answer/id #uuid "b904b162-87b0-576b-9c8a-3c647aa88565" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The center is $(-1,-6)$ and radius is $16$" :db/id #edb/ref 17592186393053} {:answer/id #uuid "e0376e6b-94e1-5393-8f70-58f85be3025d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The center is $(1,6)$ and radius is $4$" :db/id #edb/ref 17592186393054} {:answer/id #uuid "a1fe974f-7739-5447-8c15-65e11281c360" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The center is $(1,-6)$ and radius is $4$" :db/id #edb/ref 17592186393055} {:answer/id #uuid "1a4bb814-df36-50ef-990c-594eb222e321" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The center is $(1,6)$ and radius is $16$" :db/id #edb/ref 17592186393056}] :answer-field/correct {:answer/id #uuid "414d2687-cf0f-5475-b4de-9ae0e2a91b57" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The center is $(-1,-6)$ and radius is $4$" :db/id #edb/ref 17592186393052} :answer-field/id #uuid "85727bd6-7f77-5807-aa8a-f0686b43c486" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186393051}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "fed78696-d1d3-57b4-8aa2-ab1ef29e5f93" :question/math-academy-id "q-70933" :question/problem "What is the center and radius of the circle with equation $(x+1)^{2}+(y+6)^{2}=16?$" :question/worked-solution "The general equation of a circle with radius $r$ centered at the point $(a,b)$ is \n\n$$\n(x-a)^{2}+(y-b)^{2}={r}^{2}.\n$$\n\nLet's compare the general equation to our equation side-by-side as follows:\n\n$$\n\\begin{aligned}(x-a)^{2}+(y-b)^{2} & ={r}^{2} \\\\ (x+1)^{2}+(y+6)^{2} & =16 \\\\ (x-(-1))^{2}+(y-(-6))^{2} & ={4}^{2}.\\end{aligned}\n$$\n\nWe see that $a=-1,$ $b=-6,$ and $r=4.$ \n\nTherefore, the circle is centered at $(-1,-6)$ and its radius is $4.$"}] [{:db/id #edb/ref 17592186338856 :knowledge-point/_questions [{:db/id #edb/ref 17592186100873 :knowledge-point/id #uuid "71ff07eb-2e16-529e-b17c-1bf7cb9703bd" :knowledge-point/title "Finding an Entry of the Product of Two Matrices"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "108d6bbd-0580-5e01-b5da-7d66c9de2677" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "58" :db/id #edb/ref 17592186336189} {:answer/id #uuid "23395dc3-a44d-5e00-8ded-065282a293f6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186336360} {:answer/id #uuid "473ce54b-c3d5-51fb-9d6b-a1bfee206728" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186336693} {:answer/id #uuid "6503e9be-0e27-5e84-8fd2-9a826704f72c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186336935} {:answer/id #uuid "ffcf5573-0517-5ba5-b572-8c6b996ce926" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186338275}] :answer-field/correct {:answer/id #uuid "23395dc3-a44d-5e00-8ded-065282a293f6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186336360} :answer-field/id #uuid "5d203bbd-ae08-54f5-b289-51a54374a681" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186338438}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "01084ebc-a27f-547f-baec-04fae1ac84bf" :question/math-academy-id "q-70958" :question/problem "Let $R=PQ.$ What is the value of ${r}_{25}$, if\n\n$$\nP=[\\begin{aligned}1 & -2 \\\\ 3 & -4 \\\\ 4 & -6 \\\\ 1 & -8 \\\\ 3 & -9\\end{aligned}],\\,Q=[\\begin{aligned}0 & 1 & 2 & -1 & 10 \\\\ 2 & 0 & 5 & -2 & 7\\end{aligned}]?\n$$" :question/worked-solution "Multiplying the $2$nd row of $P$ by the $5$th column of $Q$, we get\n\n$$\n\\begin{aligned}{r}_{25} & =[\\begin{aligned}1 & -2 \\\\ 3 & -4 \\\\ 4 & -6 \\\\ 1 & -8 \\\\ 3 & -9\\end{aligned}][\\begin{aligned}0 & 1 & 2 & -1 & 10 \\\\ 2 & 0 & 5 & -2 & 7\\end{aligned}] \\\\  & =[\\begin{aligned}3 & -4\\end{aligned}][\\begin{aligned}10 \\\\ 7\\end{aligned}] \\\\  & =3\\cdot 10+(-4)\\cdot 7 \\\\  & =30-28 \\\\  & =2.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186338867 :knowledge-point/_questions [{:db/id #edb/ref 17592186087657 :knowledge-point/id #uuid "47863922-b0d5-5a0b-8a01-ffefe3b3c929" :knowledge-point/title "Finding the Equation of a Circle Given the Endpoints of a Diameter"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "301aa6a7-5ee2-5a20-9033-4674a143461b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(x+3)^{2}+(y+3)^{2}=4" :db/id #edb/ref 17592186336492} {:answer/id #uuid "64b4c7ae-6592-5435-9dcf-3efafb11647a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(x-3)^{2}+(y-3)^{2}=16" :db/id #edb/ref 17592186336934} {:answer/id #uuid "7faacc68-2956-5fc6-9e73-4fc524688331" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(x+3)^{2}-(y+3)^{2}=4" :db/id #edb/ref 17592186337190} {:answer/id #uuid "8864933a-7a46-5b44-8a98-d9f22b098b5a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(x-3)^{2}+(y-3)^{2}=4" :db/id #edb/ref 17592186337262} {:answer/id #uuid "ed738468-0ab1-5dc7-96f4-55c16f6a1c9d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(x+3)^{2}+(y+3)^{2}=16" :db/id #edb/ref 17592186338104}] :answer-field/correct {:answer/id #uuid "64b4c7ae-6592-5435-9dcf-3efafb11647a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(x-3)^{2}+(y-3)^{2}=16" :db/id #edb/ref 17592186336934} :answer-field/id #uuid "a6d043a5-1717-5a07-aecc-41e08ef6bda7" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186338587}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "0ffdebd9-641e-5fc7-a83b-a3474a188cc9" :question/math-academy-id "q-70987" :question/problem "![](images/b6/b6a4e9a8f4a1c6dcaaad453b843896f3fc56ae22a37d481dcb4cfe54cc53361d.png)\n\nThe line segment $\\overset{―}{XY}$ is a diameter of a circle. Given that $X$ and $Y$ have coordinates $(7,3)$ and $(-1,3)$, respectively, what is the equation of the circle?" :question/worked-solution "The general equation of a circle with radius $r$ centered at the point $(a,b)$ is  \n\n$$\n(x-a)^{2}+(y-b)^{2}={r}^{2}.\n$$\n\nUsing the distance formula to compute the distance between the points $X(7,3)$ and $Y(-1,3),$ we find that the length of the diameter is \n\n$$\n\\begin{aligned}XY & =\\sqrt{{(7-(-1))}^{2}+{(3-3)}^{2}} \\\\  & =\\sqrt{{8}^{2}+{0}^{2}} \\\\  & =\\sqrt{64} \\\\  & =8.\\end{aligned}\n$$\n\nSo the radius of the circle is \n\n$$\nr=\\frac{8}{2}=4.\n$$\n\nSince the center of a circle is the midpoint of the diameter, to find the center we use the midpoint formula as follows:\n\n$$\n(\\frac{{x}_{1}+{x}_{2}}{2},\\frac{{y}_{1}+{y}_{2}}{2})=(\\frac{7+(-1)}{2},\\frac{3+3}{2})=(3,3)\n$$\n\nSo our circle has radius $r=4$ and center $(a,b)=(3,3),$ and therefore it is represented by the following equation:\n\n$$\n\\begin{aligned}(x-a)^{2}+(y-b)^{2} & ={r}^{2} \\\\ (x-3)^{2}+(y-3)^{2} & ={4}^{2} \\\\ (x-3)^{2}+(y-3)^{2} & =16\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186338869 :knowledge-point/_questions [{:db/id #edb/ref 17592186176050 :knowledge-point/id #uuid "eed0c7c3-0bb5-56eb-a9ca-9ec4dc7b3efe" :knowledge-point/title "Utilizing the Periodicity Property of the Tangent Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "37934bed-1f9a-50c5-9a8d-e5b0b59e71a5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5-5\\pi " :db/id #edb/ref 17592186336549} {:answer/id #uuid "4b39580e-c808-5289-b894-51d8505df304" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5\\pi " :db/id #edb/ref 17592186336729} {:answer/id #uuid "5de9a8b6-2bf6-5e41-98c3-3ffaa96e81dc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186336881} {:answer/id #uuid "81ac5deb-9cc0-5543-8625-93f7cbf3fed8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186337211} {:answer/id #uuid "b2061940-30fc-5eef-a2d6-609b6aeedec0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186337622}] :answer-field/correct {:answer/id #uuid "b2061940-30fc-5eef-a2d6-609b6aeedec0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186337622} :answer-field/id #uuid "0ab98c3a-7c21-528d-8351-dfb2882c1ded" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186338295}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "35b95266-3a2f-569f-acd3-81fb0b0052f7" :question/math-academy-id "q-70998" :question/problem "If $tan⁡x=3,$ for some $x$, find the value of $tan⁡(x+5\\pi )+2.$" :question/worked-solution "The period of $y=tan⁡x$ is $\\pi .$ Therefore, for integer $n$ we have\n\n$$\ntan⁡x=tan⁡(x+n\\pi ).\n$$\n\nSubstituting $n=5$ into the right-hand-side of the above gives\n\n$$\n\\begin{aligned}tan⁡x=tan⁡(x+5\\cdot \\pi )=tan⁡(x+5\\pi ).\\end{aligned}\n$$\n\nTherefore, if $tan⁡x=3,$ we get that $tan⁡(x+5\\pi )=3.$\n\nFinally, then\n\n$$\ntan⁡(x+5\\pi )+2=(3)+2=5.\n$$"}] [{:db/id #edb/ref 17592186338888 :knowledge-point/_questions [{:db/id #edb/ref 17592186064318 :knowledge-point/id #uuid "70029065-69c3-585d-a6a1-cc9d2485a60a" :knowledge-point/title "Applying the Definition of Continuity to Evaluate a Limit"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "144aa466-fc47-529b-95bd-84f4d3861d51" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "9" :db/id #edb/ref 17592186336223} {:answer/id #uuid "1b9d7eef-900c-52cb-b1c7-b63f1efceae9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186336289} {:answer/id #uuid "93ed488f-6935-56e6-be2e-80f5fbe53a43" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186337383} {:answer/id #uuid "a7b36ae3-d363-5e51-90f6-5648576ae0d5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186337549} {:answer/id #uuid "faa555a1-33e5-5b0d-9db8-9add99459918" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186338231}] :answer-field/correct {:answer/id #uuid "1b9d7eef-900c-52cb-b1c7-b63f1efceae9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186336289} :answer-field/id #uuid "e590fe1f-5e64-5f83-9bfa-dbf4e8777a47" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186338682}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "05c16066-c0df-52d0-bb6d-c89ff088cac5" :question/math-academy-id "q-71070" :question/problem "If $f(x)$ is continuous at $x=0$ and $f(0)=2,$ then what is the value of\n\n$$\n{lim}_{x\\to {0}^{+}}{({(f(x))}^{2}-3)}^{2}\\,?\n$$" :question/worked-solution "We're told that $f(x)$ is continuous at $x=0.$ According to the definition of continuity, this means that ${lim}_{x\\to 0}f(x)$ exists, and\n\n$$\n{lim}_{x\\to {0}^{+}}f(x)=f(0)=2.\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}{lim}_{x\\to {0}^{+}}{({(f(x))}^{2}-3)}^{2} & ={({2}^{2}-3)}^{2}={1}^{2}=1.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186338891 :knowledge-point/_questions [{:db/id #edb/ref 17592186064317 :knowledge-point/id #uuid "fa1ddb40-3494-541c-b23e-b15dd98bf669" :knowledge-point/title "Identifying the Reason for a Discontinuity"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "53623a55-b77d-5351-9fc2-d973dfa306f4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$f(-1)$ does not exist" :db/id #edb/ref 17592186336802} {:answer/id #uuid "79c71031-97e9-5e1d-a6ba-e74f9e41cc73" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{lim}_{x\\to (-1)}f(x)\\ne f(-1)" :db/id #edb/ref 17592186337129} {:answer/id #uuid "976f1ad0-705e-5259-a60b-4f7ca8ac9ef3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "${lim}_{x\\to (-1)^{-}}f(x)$ does not exist" :db/id #edb/ref 17592186337413} {:answer/id #uuid "aaa26b4e-cfda-5c6f-8638-0760a72b3b60" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "${lim}_{x\\to (-1)^{+}}f(x)$ does not exist" :db/id #edb/ref 17592186337570} {:answer/id #uuid "fb13ed6b-6c19-5ee0-9d99-95a01f90eaeb" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "${lim}_{x\\to (-1)}f(x)$ does not exist" :db/id #edb/ref 17592186338236}] :answer-field/correct {:answer/id #uuid "79c71031-97e9-5e1d-a6ba-e74f9e41cc73" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{lim}_{x\\to (-1)}f(x)\\ne f(-1)" :db/id #edb/ref 17592186337129} :answer-field/id #uuid "af56593a-6a9e-589a-b62d-3c3c78f2abea" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186338599}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "c90a0801-6b26-5a6a-b72a-693261024597" :question/math-academy-id "q-71079" :question/problem "For what reason does the function $f(x)$ given below have a discontinuity at $x=-1?$\n\n$$\nf(x)={\\begin{aligned}\\frac{{x}^{2}+1}{2}, & x<-1 \\\\ 2, & x=-1 \\\\ \\frac{2}{{x}^{2}+1}, & x>-1\\end{aligned}\n$$" :question/worked-solution "Let's check the conditions necessary for $f(x)$ to be continuous at $x=-1.$\n\n- $f(-1)=2,$ so $f(-1)$ exists. $✓$\n\n- We calculate the one-sided limits and check if they coincide:\n\n$$\n\\begin{aligned}{lim}_{x\\to (-1)^{-}}f(x) & ={lim}_{x\\to (-1)^{-}}(\\frac{{x}^{2}+1}{2}) \\\\  & =\\frac{(-1)^{2}+1}{2} \\\\  & =\\frac{1+1}{2} \\\\  & =1, \\\\ {lim}_{x\\to (-1)^{+}}f(x) & ={lim}_{x\\to (-1)^{+}}(\\frac{2}{{x}^{2}+1}) \\\\  & =\\frac{2}{(-1)^{2}+1} \\\\  & =\\frac{2}{1+1} \\\\  & =1.\\end{aligned}\n$$\n\nTherefore, the overall limit exists and ${lim}_{x\\to (-1)}f(x)=1$ $✓$\n\n- The limit of the function is not equal to the function value: ${lim}_{x\\to (-1)}f(x)=1,$ while $f(-1)=2.$ $\\,\\,\\times $\n\nTherefore, the function $f(x)$ has a discontinuity at $x=-1$ because ${lim}_{x\\to (-1)}f(x)\\ne f(-1).$"}] [{:db/id #edb/ref 17592186403461 :knowledge-point/_questions [{:db/id #edb/ref 17592186068900 :knowledge-point/id #uuid "66ade855-4b16-514b-b44a-1d6b9d61ef28" :knowledge-point/title "Identifying the Shift Applied to an Exponential Decay Curve"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d8efb215-a4e3-57a5-9c28-aeceec68ab3d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y={(\\frac{1}{3})}^{x}+2" :db/id #edb/ref 17592186403463} {:answer/id #uuid "dc7c1d24-77af-5b22-8748-eb78e3181bee" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y={(\\frac{1}{3})}^{x}-3" :db/id #edb/ref 17592186403464} {:answer/id #uuid "ac8a280a-f3e5-57ca-a313-b4a7d3f28178" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y={(\\frac{1}{3})}^{x}" :db/id #edb/ref 17592186403465} {:answer/id #uuid "2e259bca-b084-538c-98c1-c8f9fb1db908" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y={(\\frac{1}{3})}^{x}+3" :db/id #edb/ref 17592186403466} {:answer/id #uuid "54400882-3ae8-5fef-9856-f37d1e3a6878" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y={(\\frac{1}{3})}^{x}-2" :db/id #edb/ref 17592186403467}] :answer-field/correct {:answer/id #uuid "d8efb215-a4e3-57a5-9c28-aeceec68ab3d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y={(\\frac{1}{3})}^{x}+2" :db/id #edb/ref 17592186403463} :answer-field/id #uuid "153448b6-9533-5575-9ff3-816d932b2ca7" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186403462}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "d28d182e-64fa-5ae5-be71-7e9fd891464e" :question/math-academy-id "q-7124" :question/problem "![](images/1a/1a54cae748796775b76ade4d9060d4eafe6bb84fd45ce725bd516a7db2681ba9.png)\n\nThe graph above shows the curve $y={(\\frac{1}{3})}^{x}+c.$ Determine the value of $c$ and find the equation of the curve." :question/worked-solution "The horizontal asymptote of $y={(\\frac{1}{3})}^{x}$ is $y=0.$ \n\nThe vertical translation $y={(\\frac{1}{3})}^{x}+c$ shifts the asymptote to $y=c.$\n\nIn the graph above, the horizontal asymptote is $y=2.$ Therefore, $c=2.$"}] [{:db/id #edb/ref 17592186338954 :knowledge-point/_questions [{:db/id #edb/ref 17592186087859 :knowledge-point/id #uuid "30bb1401-f704-520c-a23e-5a238e44960e" :knowledge-point/title "Finding the Equation of a Circle Given a Description"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1f9ae437-1d85-50ec-958b-e8760b5b0e64" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{x}^{2}+{y}^{2}=125" :db/id #edb/ref 17592186336328} {:answer/id #uuid "308f53c4-2ae7-55da-984b-1a65d78f95cf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{x}^{2}+{y}^{2}=25" :db/id #edb/ref 17592186336497} {:answer/id #uuid "73254016-15bc-578d-98b1-e2110dfab2dc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{x}^{2}+{y}^{2}=75" :db/id #edb/ref 17592186337068} {:answer/id #uuid "90833b0d-0556-5041-9d09-6af44e6c3d8e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{x}^{2}+{y}^{2}=5" :db/id #edb/ref 17592186337342} {:answer/id #uuid "a58f261c-1656-5a28-9ad6-6ecc994c1001" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{x}^{2}+{y}^{2}=10" :db/id #edb/ref 17592186337535}] :answer-field/correct {:answer/id #uuid "308f53c4-2ae7-55da-984b-1a65d78f95cf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{x}^{2}+{y}^{2}=25" :db/id #edb/ref 17592186336497} :answer-field/id #uuid "064b2f2d-b064-5112-8c60-48e6b84edd0a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186338286}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "e777ee84-35c1-5291-bae1-8ca4f484b4c9" :question/math-academy-id "q-71506" :question/problem "Which equation describes the set of all points $(x,y)$ in the coordinate plane that are $5$ units away from the origin?" :question/worked-solution "The set of all points $(x,y)$ that are a distance $5$ from the origin defines a circle with radius $r=5$ centered at the origin, as shown below.\n\n![](images/39/398adead10233d1af61cd9aa44f14d51eba9c195d30c9d6b16015a3391403908.png)\n\nSo, the required equation is\n\n$$\n\\begin{aligned}{x}^{2}+{y}^{2} & ={r}^{2} \\\\ {x}^{2}+{y}^{2} & ={5}^{2} \\\\ {x}^{2}+{y}^{2} & =25.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186338957 :knowledge-point/_questions [{:db/id #edb/ref 17592186092384 :knowledge-point/id #uuid "4a05f6c0-98ab-5197-922e-8e8dff1d4302" :knowledge-point/title "Calculating the Slope of a Normal Line to a Curve at a Point"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "105a0ee2-ecfe-5f6b-abf3-c2b8990ff5e8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{4}" :db/id #edb/ref 17592186336186} {:answer/id #uuid "8afbf511-93b1-574c-aea0-f719ed534072" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{4}{5}" :db/id #edb/ref 17592186337288} {:answer/id #uuid "9b55a9ee-2b2e-5710-b96a-5529ce814f84" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186337440} {:answer/id #uuid "b83a05a7-995d-5078-bf9a-4b58abb10a90" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186337665} {:answer/id #uuid "e2cfabde-266f-53a5-a5bf-2a8c9659561a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{4}" :db/id #edb/ref 17592186338007}] :answer-field/correct {:answer/id #uuid "105a0ee2-ecfe-5f6b-abf3-c2b8990ff5e8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{4}" :db/id #edb/ref 17592186336186} :answer-field/id #uuid "fb39a159-1af8-51a3-9955-b31d00f03bbf" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186338721}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "0b93f0c3-f4cf-5391-8374-d4b6970c54ae" :question/math-academy-id "q-71524" :question/problem "Find the slope of the normal line to the curve $y={x}^{2}-5$ at the point $(2,-1).$" :question/worked-solution "Let $f(x)={x}^{2}-5.$ First, we compute the derivative:\n\n$$\n\\begin{aligned}{f}^{′}(x)=\\frac{\\text{d}}{\\text{d}x}({x}^{2}-5)=2x\\end{aligned}\n$$\n\nThen, we compute the slope of the tangent at the point $(2,-1):$\n\n$$\n\\begin{aligned}m={f}^{′}(2)=2(2)=4\\end{aligned}\n$$\n\nTherefore, the slope of the normal line ${m}^{′}$ is\n\n$$\n{m}^{′}=-\\frac{1}{m}=-\\frac{1}{4}.\n$$"}] [{:db/id #edb/ref 17592186338970 :knowledge-point/_questions [{:db/id #edb/ref 17592186064181 :knowledge-point/id #uuid "9836abbe-e172-5c2f-8b19-145ef6d5c02d" :knowledge-point/title "Integrating Cosecant Squared"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3b98751b-5a6f-5701-a079-66efabd0c54e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3tan⁡y+C" :db/id #edb/ref 17592186336591} {:answer/id #uuid "6c064b7d-ae95-54c0-99a2-5b48ab4e6e2b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3cot⁡y+C" :db/id #edb/ref 17592186336987} {:answer/id #uuid "898bc83c-2d65-5f25-8fe3-14152653f4f1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3tan⁡y+C" :db/id #edb/ref 17592186337272} {:answer/id #uuid "bab226dc-1012-58ab-b0e7-c57b6031dacd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3cot⁡y+C" :db/id #edb/ref 17592186337686} {:answer/id #uuid "fe8ec3ab-b777-58b0-80b5-c49a97bea68f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3csc⁡ycot⁡y+C" :db/id #edb/ref 17592186338265}] :answer-field/correct {:answer/id #uuid "6c064b7d-ae95-54c0-99a2-5b48ab4e6e2b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3cot⁡y+C" :db/id #edb/ref 17592186336987} :answer-field/id #uuid "0033f394-fd38-57df-b724-8ce5cc5ff702" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186338279}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "2e4929ca-7804-5d00-ada3-f06fc525c774" :question/math-academy-id "q-71663" :question/problem "$\\int -3{csc}^{2}⁡y\\,\\text{d}y=$" :question/worked-solution "Recall that \n\n$$\n\\int {csc}^{2}⁡y\\,\\text{d}y=-cot⁡y+C\n$$\n\nTherefore, we get\n\n$$\n\\begin{aligned}\\begin{aligned}\\int -3{csc}^{2}⁡y\\,\\text{d}y & =-3\\int {csc}^{2}⁡y\\,\\text{d}y \\\\  & =-3(-cot⁡y)+C \\\\  & =3cot⁡y+C.\\end{aligned}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186338971 :knowledge-point/_questions [{:db/id #edb/ref 17592186064181 :knowledge-point/id #uuid "9836abbe-e172-5c2f-8b19-145ef6d5c02d" :knowledge-point/title "Integrating Cosecant Squared"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "29f94094-a13e-59d3-8e01-6476ad259936" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "sec⁡ytan⁡y+C" :db/id #edb/ref 17592186336421} {:answer/id #uuid "4bbf7e18-db54-5ad4-94b3-6740e294fa86" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "tan⁡y+C" :db/id #edb/ref 17592186336736} {:answer/id #uuid "5a246749-d6a8-5b61-ab0c-eb37e92ba4e3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-tan⁡y+C" :db/id #edb/ref 17592186336853} {:answer/id #uuid "7eef5879-dbe7-5b97-97a6-26e4a74a9d5b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "cot⁡y+C" :db/id #edb/ref 17592186337182} {:answer/id #uuid "cbbba5ec-56d3-5218-abf9-36a5e07211a3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-cot⁡y+C" :db/id #edb/ref 17592186337821}] :answer-field/correct {:answer/id #uuid "7eef5879-dbe7-5b97-97a6-26e4a74a9d5b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "cot⁡y+C" :db/id #edb/ref 17592186337182} :answer-field/id #uuid "709f437f-6931-5254-8a8a-e5df59c326ec" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186338469}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "e6d46060-4d10-5e18-98aa-e065865069a6" :question/math-academy-id "q-71664" :question/problem "$\\int -{csc}^{2}⁡y\\,\\text{d}y=$" :question/worked-solution "Recall that \n\n$$\n\\int {csc}^{2}⁡y\\,\\text{d}y=-cot⁡y+C\n$$\n\nTherefore, we get\n\n$$\n\\begin{aligned}\\begin{aligned}\\int -{csc}^{2}⁡y\\,\\text{d}y & =-\\int {csc}^{2}⁡y\\,\\text{d}y \\\\  & =-(-cot⁡y)+C \\\\  & =cot⁡y+C.\\end{aligned}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186064946 :knowledge-point/_questions [{:db/id #edb/ref 17592186064371 :knowledge-point/id #uuid "45b380ed-1974-5876-8c88-a45773741b48" :knowledge-point/title "Calculating the Speed of a Particle at a Particular Moment"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "899c0898-cc24-5360-b626-1256d90ee17e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1.5cm/s" :db/id #edb/ref 17592186063733} {:answer/id #uuid "c6aaecc1-1a6e-5ad3-9010-833d1cbbb472" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2.0cm/s" :db/id #edb/ref 17592186063734} {:answer/id #uuid "d2a83fe4-2550-5f4e-bded-f0e0495d3bad" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2.5cm/s" :db/id #edb/ref 17592186063735} {:answer/id #uuid "1db5a007-393b-5b2a-820b-7b0e9ee282a0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3.0cm/s" :db/id #edb/ref 17592186063736} {:answer/id #uuid "3d517248-0d79-5d46-92c9-c67e3e69e7db" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4.0cm/s" :db/id #edb/ref 17592186063737}] :answer-field/id #uuid "1533643d-1ad3-5fcd-8671-813502553b72" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186063732} {:answer-field/choices [{:answer/id #uuid "309fb741-f2ee-5d42-a410-6d3722af473d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1.5\\,\\text{cm/s}" :db/id #edb/ref 17592186393175} {:answer/id #uuid "0ba94734-6539-5f8b-b9fa-953023f4379c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2.5\\,\\text{cm/s}" :db/id #edb/ref 17592186393176} {:answer/id #uuid "827e042d-b06c-59c7-b91a-f5e840050abb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2.0\\,\\text{cm/s}" :db/id #edb/ref 17592186393177} {:answer/id #uuid "dafb3fc0-f6a1-5617-964a-36080cd6f04c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3.0\\,\\text{cm/s}" :db/id #edb/ref 17592186393178} {:answer/id #uuid "577baa3c-ff60-5e2e-9451-c051fd6e20b6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4.0\\,\\text{cm/s}" :db/id #edb/ref 17592186393179}] :answer-field/correct {:answer/id #uuid "0ba94734-6539-5f8b-b9fa-953023f4379c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2.5\\,\\text{cm/s}" :db/id #edb/ref 17592186393176} :answer-field/id #uuid "89bc4a65-3fa0-525a-8a5b-ebdeb649b1a9" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186393174}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "c20eb755-854c-51a7-aed2-16e438744a82" :question/math-academy-id "q-7175" :question/problem "The position $s(t)$ of a particle (in centimeters) at time $t$ seconds is given by \n\n$$\ns(t)=\\frac{5t-10}{t},\\,t>0.\n$$\n\nCalculate the speed of the particle when $t=2\\,\\text{s}.$" :question/requires-calculator true :question/worked-solution "First, we calculate the velocity function by differentiating the position function:\n\n$$\n\\begin{aligned}v(t) & =\\frac{\\text{d}s}{\\text{d}t} \\\\  & =\\frac{\\text{d}}{\\text{d}t}(\\frac{5t-10}{t}) \\\\  & =\\frac{10}{{t}^{2}}\\end{aligned}\n$$\n\nWhen $t=2,$ the velocity is\n\n$$\nv(2)=\\frac{10}{(2)^{2}}=\\frac{10}{4}=2.5.\n$$\n\nTherefore, the speed is $|2.5|=2.5\\,\\text{cm/s}.$"}] [{:db/id #edb/ref 17592186338983 :knowledge-point/_questions [{:db/id #edb/ref 17592186064182 :knowledge-point/id #uuid "90033e91-fdb2-5aa0-8cce-76762a38ffd2" :knowledge-point/title "Integrating Using Arcsine"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "753fa037-4869-57bb-ac4a-0f8226e93dce" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8{x}^{2}-\\operatorname{arccos}⁡x+C" :db/id #edb/ref 17592186337088} {:answer/id #uuid "7de44454-c056-5b46-a5ff-feadd65645cc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4{x}^{2}-\\operatorname{arcsin}⁡x+C" :db/id #edb/ref 17592186337171} {:answer/id #uuid "af75991e-fe31-5097-bab1-f9f7833dfa8f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4{x}^{2}-\\operatorname{arctan}⁡x+C" :db/id #edb/ref 17592186337609} {:answer/id #uuid "cddee891-ba94-5bd0-9d64-b60f3812c423" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8{x}^{2}-\\operatorname{arcsin}⁡x+C" :db/id #edb/ref 17592186337835} {:answer/id #uuid "f64bcadb-6519-5fea-93f7-63aa02c92d1d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4{x}^{2}-\\operatorname{arccos}⁡x+C" :db/id #edb/ref 17592186338190}] :answer-field/correct {:answer/id #uuid "7de44454-c056-5b46-a5ff-feadd65645cc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4{x}^{2}-\\operatorname{arcsin}⁡x+C" :db/id #edb/ref 17592186337171} :answer-field/id #uuid "f6a689b3-7d92-5c9d-b9a2-6c4b6c753f86" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186338710}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "f5352827-e02f-55d1-bc3e-a103f93321ab" :question/math-academy-id "q-71761" :question/problem "$\\int (8x-\\frac{1}{\\sqrt{1-{x}^{2}}})\\text{d}x=$" :question/worked-solution "Recall that \n\n$$\n\\int \\frac{1}{\\sqrt{1-{x}^{2}}}\\,\\text{d}x=\\operatorname{arcsin}⁡x+C.\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}\\int (8x-\\frac{1}{\\sqrt{1-{x}^{2}}})\\text{d}x & =\\int 8x\\,\\text{d}x-\\int \\frac{1}{\\sqrt{1-{x}^{2}}}\\,\\text{d}x \\\\  & =8\\int x\\,\\text{d}x-\\int \\frac{1}{\\sqrt{1-{x}^{2}}}\\,\\text{d}x \\\\  & =4{x}^{2}-\\operatorname{arcsin}⁡x+C.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186393180 :knowledge-point/_questions [{:db/id #edb/ref 17592186087889 :knowledge-point/id #uuid "e0cdcbc5-c10b-5dd1-af9a-410d2d44a4c5" :knowledge-point/title "Calculating the Acceleration of a Particle Given Its Velocity"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "89cf84e6-fa60-5c64-b93b-865747b163cd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "a(t)=1+\\frac{1}{{t}^{2}}" :db/id #edb/ref 17592186393182} {:answer/id #uuid "ce91f5ac-68b0-5d12-b408-5805719d5633" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "a(t)=1-\\frac{1}{{t}^{2}}" :db/id #edb/ref 17592186393183} {:answer/id #uuid "9153eb0d-2401-550a-8773-be6e4eb8e8c8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "a(t)=\\frac{1}{{t}^{2}}" :db/id #edb/ref 17592186393184} {:answer/id #uuid "adae588b-ff36-562f-b371-73f948870d37" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "a(t)=t+\\frac{1}{t}" :db/id #edb/ref 17592186393185} {:answer/id #uuid "d5256482-56c1-5d4e-a0c1-dc867d2591d7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "a(t)=t-\\frac{1}{t}" :db/id #edb/ref 17592186393186}] :answer-field/correct {:answer/id #uuid "89cf84e6-fa60-5c64-b93b-865747b163cd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "a(t)=1+\\frac{1}{{t}^{2}}" :db/id #edb/ref 17592186393182} :answer-field/id #uuid "0524bc50-6e64-5c83-9e81-cb4394c0bfc4" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186393181}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "2e5248e4-d160-51d4-9bba-1d38c3c5aabb" :question/math-academy-id "q-7186" :question/problem "The velocity $v$ of a particle at time $t$ is given by $v(t)=\\frac{{t}^{2}-1}{t}.$ Calculate the acceleration of the particle at time $t.$" :question/worked-solution "We differentiate $v(t)$ to calculate $a(t):$\n\n$$\n\\begin{aligned}a(t) & =\\frac{\\text{d}v}{\\text{d}t} \\\\  & =\\frac{\\text{d}}{\\text{d}t}(\\frac{{t}^{2}-1}{t}) \\\\  & =\\frac{\\text{d}}{\\text{d}t}(t-\\frac{1}{t}) \\\\  & =\\frac{\\text{d}}{\\text{d}t}(t-{t}^{-1}) \\\\  & =1-(-{t}^{-2}) \\\\  & =1+\\frac{1}{{t}^{2}}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186339007 :knowledge-point/_questions [{:db/id #edb/ref 17592186087700 :knowledge-point/id #uuid "a75c67e5-3469-5730-9181-54df4ec6d5b2" :knowledge-point/title "Determining the Inverse of a Larger Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "43339e1d-1bfa-55d0-b3c2-c8e4ad7e48be" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186336667} {:answer/id #uuid "7483dbfb-2a05-5002-b015-71ac4bbb50b4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186337079} {:answer/id #uuid "9bc56d9f-7969-5603-8164-402febf66e59" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186337442} {:answer/id #uuid "b2a235c2-3d22-5e37-8f24-ef0a23a374c2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186337626} {:answer/id #uuid "cf0d9494-e399-55f1-8b32-0a285f986f3f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186337843}] :answer-field/correct {:answer/id #uuid "b2a235c2-3d22-5e37-8f24-ef0a23a374c2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186337626} :answer-field/id #uuid "0b488541-8354-522a-b07d-347ec327f286" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186338298}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "8aec4565-777c-5fd0-95ff-9f5ced653b55" :question/math-academy-id "q-71879" :question/problem "Consider the matrices\n\n$$\nA=[\\begin{aligned}0 & -1 & -1 \\\\ 0 & 1 & 0 \\\\ 1 & 1 & 1\\end{aligned}],\\,B=[\\begin{aligned}1 & 0 & 1 \\\\ 0 & 2 & 0 \\\\ -1 & -1 & 0\\end{aligned}],\\,C=[\\begin{aligned}0 & -\\frac{1}{2} & -1 \\\\ 0 & \\frac{1}{2} & 0 \\\\ 1 & \\frac{1}{2} & 1\\end{aligned}].\n$$\n\nWhich of the following statements are true?\n\n- $AB=BA={I}_{3}$\n- $BC=CB={I}_{3}$\n- $A={B}^{-1}$" :question/worked-solution "- First, we check whether $AB=BA={I}_{3}.$ Computing $AB$, we get\n\n$$\n\\begin{aligned}AB & =[\\begin{aligned}0 & -1 & -1 \\\\ 0 & 1 & 0 \\\\ 1 & 1 & 1\\end{aligned}][\\begin{aligned}1 & 0 & 1 \\\\ 0 & 2 & 0 \\\\ -1 & -1 & 0\\end{aligned}] \\\\  & =[\\begin{aligned}∗ & -1 & ∗ \\\\ ∗ & ∗ & ∗ \\\\ ∗ & ∗ & ∗\\end{aligned}] \\\\  & \\ne {I}_{3}.\\,\\times \\end{aligned}\n$$\n\nSo, statement I is false. As a result, $A\\ne {B}^{-1}$ and statement III is false too.\n\n- Now, we check whether $BC=CB={I}_{3}.$ Computing $BC$, we get\n\n$$\n\\begin{aligned}BC & =[\\begin{aligned}1 & 0 & 1 \\\\ 0 & 2 & 0 \\\\ -1 & -1 & 0\\end{aligned}][\\begin{aligned}0 & -\\frac{1}{2} & -1 \\\\ 0 & \\frac{1}{2} & 0 \\\\ 1 & \\frac{1}{2} & 1\\end{aligned}] \\\\  & =[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 1\\end{aligned}] \\\\  & ={I}_{3}.\\,✓\\end{aligned}\n$$\n\nLikewise, computing $CB$, we get\n\n$$\n\\begin{aligned}CB & =[\\begin{aligned}0 & -\\frac{1}{2} & -1 \\\\ 0 & \\frac{1}{2} & 0 \\\\ 1 & \\frac{1}{2} & 1\\end{aligned}][\\begin{aligned}1 & 0 & 1 \\\\ 0 & 2 & 0 \\\\ -1 & -1 & 0\\end{aligned}] \\\\  & =[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 1\\end{aligned}] \\\\  & ={I}_{3}.\\,✓\\end{aligned}\n$$\n\nSo, statement II is true.\n\nTherefore, the correct answer is \"II only\"."}] [{:db/id #edb/ref 17592186339009 :knowledge-point/_questions [{:db/id #edb/ref 17592186064171 :knowledge-point/id #uuid "3f9548e6-28ef-5a97-ab04-dfb1b6e23c16" :knowledge-point/title "Integrating the Exponential Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "23784fc4-3a90-53e4-89bb-df7f53cf6d59" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}{e}^{x}+C" :db/id #edb/ref 17592186336365} {:answer/id #uuid "2c3c2a30-99f8-537b-8508-e5713aa27c9e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}{e}^{2x}+C" :db/id #edb/ref 17592186336450} {:answer/id #uuid "67383a40-44c5-5a00-bfa0-07f13c0dcbe6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{e}^{x}+C" :db/id #edb/ref 17592186336953} {:answer/id #uuid "b945ae93-7849-5d6e-b645-1e8c14a1d6cf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}{e}^{1/2x}+C" :db/id #edb/ref 17592186337675} {:answer/id #uuid "fbb744da-ccfd-5f44-8169-07909ef53f32" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2{e}^{x}+C" :db/id #edb/ref 17592186338242}] :answer-field/correct {:answer/id #uuid "23784fc4-3a90-53e4-89bb-df7f53cf6d59" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}{e}^{x}+C" :db/id #edb/ref 17592186336365} :answer-field/id #uuid "f9fc2e0f-aa1f-50b5-8ba0-74df5403bd7c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186338718}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "7119fae9-f265-530e-8dcf-9a8fd6ab825e" :question/math-academy-id "q-71900" :question/problem "$\\int \\frac{1}{2}{e}^{x}\\,\\text{d}x=$" :question/worked-solution "Factoring out the constant $\\frac{1}{2}$ and calculating the resulting integral, we get\n\n$$\n\\begin{aligned}\\int \\frac{1}{2}{e}^{x}\\,\\text{d}x & =\\frac{1}{2}\\int {e}^{x}\\,\\text{d}x \\\\  & =\\frac{1}{2}{e}^{x}+C.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186339023 :knowledge-point/_questions [{:db/id #edb/ref 17592186096843 :knowledge-point/id #uuid "0a312840-0d35-50bb-94b3-b04778f4efc3" :knowledge-point/title "Differentiating a Function Using the Chain Rule and Prime Notation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2d2f6517-e258-513a-b912-2250e7c54e17" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-15(2+5x{)}^{2}" :db/id #edb/ref 17592186336461} {:answer/id #uuid "3b2c8729-231c-5b49-a873-246a32aa4645" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-15(2-5x{)}^{3}" :db/id #edb/ref 17592186336588} {:answer/id #uuid "77d335ef-89db-5392-8e96-2e5663d37f72" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "15(2+5x{)}^{2}" :db/id #edb/ref 17592186337111} {:answer/id #uuid "84c34e15-f7f7-51bd-91ad-be1849bcac42" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "15(2-5x{)}^{2}" :db/id #edb/ref 17592186337229} {:answer/id #uuid "ba6755f1-59bc-5601-b289-66317d2b0d63" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-15(2-5x{)}^{2}" :db/id #edb/ref 17592186337682}] :answer-field/correct {:answer/id #uuid "ba6755f1-59bc-5601-b289-66317d2b0d63" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-15(2-5x{)}^{2}" :db/id #edb/ref 17592186337682} :answer-field/id #uuid "20dca297-5492-547a-957c-959f9e7520f3" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186338339}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "ccad926b-6344-5bec-99bc-507d50cda1e3" :question/math-academy-id "q-71956" :question/problem "Given that $f(x)={(2-5x)}^{3},$ find ${f}^{′}(x).$" :question/worked-solution "Let $g(x)=2-5x$ and $f(g(x))=g(x{)}^{3}.$ \n\nDifferentiating, we have\n\n$$\n\\begin{aligned}{f}^{′}(g(x)) & =({g}^{3}{)}^{′}=3{g}^{2}, \\\\ {g}^{′}(x) & =(2-5x{)}^{′}=-5.\\end{aligned}\n$$\n\nThen, using the chain rule, \n\n$$\n\\begin{aligned}{f}^{′}(x) & ={f}^{′}(g(x))\\cdot {g}^{′}(x) \\\\  & =3{g}^{2}\\cdot (-5) \\\\  & =-15(2-5x{)}^{2}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186339030 :knowledge-point/_questions [{:db/id #edb/ref 17592186087703 :knowledge-point/id #uuid "4e64e0c3-f8f5-5c38-ae75-1aed92e0ac01" :knowledge-point/title "Solving for a Variable in a Singular Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3f062ffd-0731-5c9d-b5df-1e280483ad62" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "t=-\\frac{3}{4}" :db/id #edb/ref 17592186336623} {:answer/id #uuid "87e8b87b-9219-5612-bc47-0727af4eb0b5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "t=0" :db/id #edb/ref 17592186337259} {:answer/id #uuid "9d1a9b12-eb65-52f2-be17-471977096571" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "t=5" :db/id #edb/ref 17592186337454} {:answer/id #uuid "db1521d6-6365-5c27-8635-662375c34db6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "t=-5" :db/id #edb/ref 17592186337942} {:answer/id #uuid "e0112779-824d-50fa-a23d-b42b80a0e397" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "t=\\frac{3}{4}" :db/id #edb/ref 17592186337989}] :answer-field/correct {:answer/id #uuid "87e8b87b-9219-5612-bc47-0727af4eb0b5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "t=0" :db/id #edb/ref 17592186337259} :answer-field/id #uuid "82b667e3-83f0-533b-abd1-94355475f197" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186338510}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "35c7dc25-96f0-5d9f-9d6a-dfbf5fcfb320" :question/math-academy-id "q-71969" :question/problem "If $M=[\\begin{aligned}t & 4 \\\\ t & 10\\end{aligned}]$ is a singular matrix, calculate the value of $t.$" :question/worked-solution "The matrix $M$ is singular if and only if $det(M)=0.$ Calculating the determinant, we get\n\n$$\n\\begin{aligned}det(M) & =t\\cdot 10-t\\cdot 4 \\\\  & =10t-4t \\\\  & =6t\\end{aligned}\n$$\n\nNow, we set the determinant equal to $0$ and solve for $t:$\n\n$$\n\\begin{aligned}6t & =0 \\\\ t & =0\\end{aligned}\n$$\n\nTherefore, the value of $t$ is $t=0.$"}] [{:db/id #edb/ref 17592186339038 :knowledge-point/_questions [{:db/id #edb/ref 17592186087846 :knowledge-point/id #uuid "37a4168b-1425-5f3a-a577-4b5884906a52" :knowledge-point/title "Calculating the Sum of a Complex Number and Its Conjugate"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "131e439a-9165-56c6-8fdd-b21c8dea91e1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8+14\\text{i}" :db/id #edb/ref 17592186336212} {:answer/id #uuid "1b6aa3b5-1f23-581f-bd0e-52f0682b50a0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186336285} {:answer/id #uuid "1e6f5eb4-3b18-507b-9c32-4ce046ab8046" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "13" :db/id #edb/ref 17592186336313} {:answer/id #uuid "d95dea67-8da9-5f2b-8c58-9a5fb247332b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "14\\text{i}" :db/id #edb/ref 17592186337923} {:answer/id #uuid "f90cfae7-9eea-5dc8-8b18-628804095bea" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186338215}] :answer-field/correct {:answer/id #uuid "1b6aa3b5-1f23-581f-bd0e-52f0682b50a0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186336285} :answer-field/id #uuid "bd3178b7-71a4-5c4f-9b23-601af5c49da4" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186338617}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "568e1d1c-4c3e-536f-acb0-c6800da06527" :question/math-academy-id "q-71986" :question/problem "If $z=4+7\\text{i}$, calculate $z+\\overset{―}{z}.$" :question/worked-solution "**Method 1**\n\nWhen we add a complex number and its conjugate, the result is always twice the real part of the complex number.\n\nFor the given complex number $z=4+7\\text{i},$ the real part is $Re(z)=4,$ so we have\n\n$$\n\\begin{aligned}z+\\overset{―}{z} & =2\\text{Re}(z) \\\\  & =2(4) \\\\  & =8.\\end{aligned}\n$$\n\n**Method 2**\n\nAlternatively, we can actually carry out the process of adding the complex number and its conjugate.\n\nTo obtain the conjugate of the complex number $z=4+7\\text{i},$ we flip the sign of the imaginary part and get $\\overset{―}{z}=4-7\\text{i}.$\n\nAdding, we get\n\n$$\n\\begin{aligned}z+\\overset{―}{z} & =(4+7\\text{i})+(4-7\\text{i}) \\\\  & =(4+4)+\\text{i}(7-7) \\\\  & =8+\\text{i}0 \\\\  & =8.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186064947 :knowledge-point/_questions [{:db/id #edb/ref 17592186064272 :knowledge-point/id #uuid "fa38f112-466c-50e9-ac08-be72b6f53782" :knowledge-point/title "Relating a Derivative to a Rate of Change"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "148eb00f-3a9c-5cde-b11e-4aa6e5df5baf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "N(t)=r(t)" :db/id #edb/ref 17592186336227} {:answer/id #uuid "3ce9ccdf-1421-5fcb-b41e-795e91107452" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "N(t)={r}^{′}(t)" :db/id #edb/ref 17592186336606} {:answer/id #uuid "3d4ac506-d0f2-599b-b8f3-e6dce6983161" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{N}^{′}(t)=r(t)" :db/id #edb/ref 17592186336611} {:answer/id #uuid "80a522d2-bd93-5515-9735-bcaf1eb17692" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "N(t)=-{r}^{′}(t)" :db/id #edb/ref 17592186337197} {:answer/id #uuid "e3743113-4ad5-561d-af41-cbb9230afbba" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{N}^{′}(t)=-r(t)" :db/id #edb/ref 17592186338017}] :answer-field/correct {:answer/id #uuid "3d4ac506-d0f2-599b-b8f3-e6dce6983161" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{N}^{′}(t)=r(t)" :db/id #edb/ref 17592186336611} :answer-field/id #uuid "874c5434-9157-538e-be59-176244d35d61" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186338525}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "97f8f938-0d50-59f5-922b-f7bea8bb44f7" :question/math-academy-id "q-72004" :question/problem "Jason, a biologist, is measuring the growth of bacteria in a Petri dish by recording the following two numbers for different values of $t,$ where $t$ is the time, in hours, since he started his observations:\n\n- $N(t)$ - the number of bacteria in the dish.\n\n- $r(t)$ - the rate at which the number of bacteria in the dish is increasing.\n\nWhat is the relationship between $N(t)$ and $r(t)?$" :question/worked-solution "The function $N(t)$ gives the number of bacteria inside the dish after $t$ hours. Then,\n\n$$\n{N}^{′}(t)=\\frac{\\text{d}N(t)}{\\text{d}t}=\\frac{\\text{Change in }N}{\\text{Change in }t}.\n$$\n\nThus, ${N}^{′}(t)$ gives the rate at which the number of bacteria is increasing at time $t$, which is the same as $r(t).$ Therefore, the relationship between $N(t)$ and $r(t)$ is ${N}^{′}(t)=r(t).$"}] [{:db/id #edb/ref 17592186339052 :knowledge-point/_questions [{:db/id #edb/ref 17592186105715 :knowledge-point/id #uuid "cf98ee24-7774-5674-8a1e-63f4f6d225c0" :knowledge-point/title "Integrating a Reciprocal Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1f88c79e-e25c-5fcd-a473-3f9adb3d4e9e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{\\sqrt{7}}{7}ln⁡|x|+C" :db/id #edb/ref 17592186336327} {:answer/id #uuid "58b493c2-73d3-5db1-af15-0200a2937632" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{\\sqrt{7}}{ln⁡|x|}+C" :db/id #edb/ref 17592186336844} {:answer/id #uuid "daf20704-2d65-5753-af90-f6e026c52e12" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{7}ln⁡|x|+C" :db/id #edb/ref 17592186337940} {:answer/id #uuid "ec4261ce-b5b3-5551-9fbd-56937e1eea24" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{7}{\\sqrt{7}}ln⁡|x|+C" :db/id #edb/ref 17592186338091} {:answer/id #uuid "f7a97ce9-ff10-5758-b496-1ffe87d0bb3c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-ln⁡|\\sqrt{7}x|+C" :db/id #edb/ref 17592186338202}] :answer-field/correct {:answer/id #uuid "1f88c79e-e25c-5fcd-a473-3f9adb3d4e9e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{\\sqrt{7}}{7}ln⁡|x|+C" :db/id #edb/ref 17592186336327} :answer-field/id #uuid "f930863c-55bb-55cc-bd9d-51b8ae4abea3" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186338715}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "d9daecf1-e255-5c0c-a433-fdc798f551aa" :question/math-academy-id "q-72059" :question/problem "Calculate $\\int -\\frac{1}{\\sqrt{7}x}\\,\\text{d}x.$" :question/worked-solution "First, we apply the constant factor rule and take the coefficient $-\\frac{1}{\\sqrt{7}}=-\\frac{1}{\\sqrt{7}}\\frac{\\sqrt{7}}{\\sqrt{7}}=-\\frac{\\sqrt{7}}{7}$ out of the integral. Then we compute the integral of $\\frac{1}{x},$ and get\n\n$$\n\\begin{aligned}\\int -\\frac{1}{\\sqrt{7}x}\\,\\text{d}x & =-\\frac{1}{\\sqrt{7}}\\int \\frac{1}{x}\\,\\,\\text{d}x \\\\  & =-\\frac{\\sqrt{7}}{7}ln⁡|x|+C.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186339059 :knowledge-point/_questions [{:db/id #edb/ref 17592186064152 :knowledge-point/id #uuid "159b4d58-b34d-52cd-aad2-2c058f772ad2" :knowledge-point/title "Interpreting the Derivative of a Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "08f73173-53b3-594c-9f00-73f6211f3aba" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The rate at which the perimeter changes as each side changes" :db/id #edb/ref 17592186336106} {:answer/id #uuid "2f86ab33-c24f-513c-9f78-18726fd0321b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The rate at which the area changes as each side changes" :db/id #edb/ref 17592186336488} {:answer/id #uuid "8526b1a3-6e9c-580f-9c0b-82c5736c43b1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The rate at which each side changes as the perimeter changes" :db/id #edb/ref 17592186337231} {:answer/id #uuid "95ba1001-8463-59e2-bed5-38495c9afaab" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The rate at which the perimeter changes as the area changes" :db/id #edb/ref 17592186337400} {:answer/id #uuid "eddb83ed-12b2-59b9-8dd1-0e4ed245941a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The rate at which each side changes as the area changes" :db/id #edb/ref 17592186338109}] :answer-field/correct {:answer/id #uuid "08f73173-53b3-594c-9f00-73f6211f3aba" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The rate at which the perimeter changes as each side changes" :db/id #edb/ref 17592186336106} :answer-field/id #uuid "aa385052-bba0-5f25-abff-7baf2aaa746f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186338590}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "c47d8541-4bf8-5eff-901b-cba03fe2cd37" :question/math-academy-id "q-72104" :question/problem "Consider a regular pentagon such that the length $s$ of each side varies. What is the best interpretation of ${P}^{′}(s)$ if $P$ is the perimeter of the pentagon?" :question/worked-solution "The function $P(s)$ gives the perimeter of a pentagon with side $s.$ So,\n\n$$\n{P}^{′}(s)=\\frac{\\text{d}P}{\\text{d}s}=\\frac{\\text{Change in }P}{\\text{Change in }s}.\n$$\n\nTherefore, ${P}^{′}(s)$ is the rate at which the perimeter changes as each side changes."}] [{:db/id #edb/ref 17592186339060 :knowledge-point/_questions [{:db/id #edb/ref 17592186064272 :knowledge-point/id #uuid "fa38f112-466c-50e9-ac08-be72b6f53782" :knowledge-point/title "Relating a Derivative to a Rate of Change"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1bd3314e-09b5-5ed6-b34d-9c8eb2cd078f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{A}^{′}(t)=r(t)" :db/id #edb/ref 17592186336291} {:answer/id #uuid "5f89b95a-dc2f-5355-a891-5f7ad0897f2f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "A(t)=-{r}^{′}(t)" :db/id #edb/ref 17592186336898} {:answer/id #uuid "d84adbce-e1e5-541f-ae42-248e49f85aef" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{A}^{′}(t)=-r(t)" :db/id #edb/ref 17592186337909} {:answer/id #uuid "eb90804a-9cb1-5c0e-93ff-93893405ab87" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "A(t)={r}^{′}(t)" :db/id #edb/ref 17592186338088} {:answer/id #uuid "f843d514-c114-567f-8b4e-d0d7f91897e0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "A(t)=r(t)" :db/id #edb/ref 17592186338207}] :answer-field/correct {:answer/id #uuid "1bd3314e-09b5-5ed6-b34d-9c8eb2cd078f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{A}^{′}(t)=r(t)" :db/id #edb/ref 17592186336291} :answer-field/id #uuid "27c52aef-834f-5c1c-9709-b11a313c17d7" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186338353}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "4da77317-b047-59f4-8384-7a00ca57d0df" :question/math-academy-id "q-72105" :question/problem "Douglas, a pilot, is flying a plane. The plane's control systems record two measurements for different values of $t,$ where $t$ is the time, in minutes, since take off. The two measurements are:\n\n- $A(t)$ - the altitude (height) of the plane\n\n- $r(t)$ the rate at which the altitude is increasing\n\nWhat is the relationship between $A(t)$ and $r(t)?$" :question/worked-solution "The function $A(t)$ gives the altitude of the plane after $t$ hours. Then,\n\n$$\n{A}^{′}(t)=\\frac{\\text{d}A(t)}{\\text{d}t}=\\frac{\\text{Change in }A}{\\text{Change in }t}.\n$$\n\nThus, ${A}^{′}(t)$ gives the rate at which the altitude is increasing at time $t$, which is the same as $r(t).$ Therefore, the relationship between $A(t)$ and $r(t)$ is ${A}^{′}(t)=r(t).$"}] [{:db/id #edb/ref 17592186339066 :knowledge-point/_questions [{:db/id #edb/ref 17592186064284 :knowledge-point/id #uuid "a483e892-90f2-51f4-80cd-2b1200cd0c37" :knowledge-point/title "Differentiating a Composition of Trigonometric Functions Using the Chain Rule"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "35d0b5a0-960c-537b-b36b-f81b09719172" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3\\operatorname{sec}⁡x\\operatorname{tan}⁡(-\\operatorname{sin}⁡x)" :db/id #edb/ref 17592186336532} {:answer/id #uuid "8659cf38-7f28-521b-9eb6-a1f4bb5d55a9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3\\operatorname{sin}⁡x\\operatorname{sec}⁡(-\\operatorname{sin}⁡x)\\operatorname{tan}⁡(-\\operatorname{sin}⁡x)" :db/id #edb/ref 17592186337248} {:answer/id #uuid "cf2b4496-4d43-50c5-b8f4-50cbe3748941" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3\\operatorname{cos}⁡x\\operatorname{sec}⁡(\\operatorname{cos}⁡x)\\operatorname{tan}⁡(\\operatorname{cos}⁡x)" :db/id #edb/ref 17592186337845} {:answer/id #uuid "e5a21dd0-44ef-54d6-bc1c-1c98a20cbcd7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3\\operatorname{sin}⁡x\\operatorname{sec}⁡x\\operatorname{tan}⁡(\\operatorname{cos}⁡x)" :db/id #edb/ref 17592186338037} {:answer/id #uuid "f7b439b8-4fb4-5bd2-b82d-c5283f54f75b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3\\operatorname{sin}⁡x\\operatorname{sec}⁡(\\operatorname{cos}⁡x)\\operatorname{tan}⁡(\\operatorname{cos}⁡x)" :db/id #edb/ref 17592186338204}] :answer-field/correct {:answer/id #uuid "f7b439b8-4fb4-5bd2-b82d-c5283f54f75b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3\\operatorname{sin}⁡x\\operatorname{sec}⁡(\\operatorname{cos}⁡x)\\operatorname{tan}⁡(\\operatorname{cos}⁡x)" :db/id #edb/ref 17592186338204} :answer-field/id #uuid "76164faf-c99c-514d-8f55-17d4f55b16c4" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186338480}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "bdadc1fd-0dca-59ce-bd49-88a477cdb0a0" :question/math-academy-id "q-72173" :question/problem "Find the derivative of $y=3\\operatorname{sec}⁡(\\operatorname{cos}⁡x).$" :question/worked-solution "First, we express $y$ as the composite function\n\n$$\ny=3\\operatorname{sec}⁡u,\\,u=\\operatorname{cos}⁡x.\n$$\n\nDifferentiating gives\n\n$$\n\\frac{\\text{d}y}{\\text{d}u}=3\\operatorname{sec}⁡u\\operatorname{tan}⁡u,\\,\\frac{\\text{d}u}{\\text{d}x}=-\\operatorname{sin}⁡x.\n$$\n\nWe now apply the chain rule, and get\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}y}{\\text{d}u}\\cdot \\frac{\\text{d}u}{\\text{d}x} \\\\  & =3\\operatorname{sec}⁡u\\operatorname{tan}⁡u\\cdot (-\\operatorname{sin}⁡x) \\\\  & =-3\\operatorname{sin}⁡x\\operatorname{sec}⁡(\\operatorname{cos}⁡x)\\operatorname{tan}⁡(\\operatorname{cos}⁡x).\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186339074 :knowledge-point/_questions [{:db/id #edb/ref 17592186054677 :knowledge-point/id #uuid "619182bf-107d-5217-a306-ec4f7c1109eb" :knowledge-point/title "Finding the Derivative of a Function Given in Implicit Form Using the Product Rule"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0a0fc10a-2cbd-5633-bb2f-ea7aaaa841c2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{6{x}^{2}+\\operatorname{sin}⁡(y)}{x\\operatorname{sin}⁡(y)+3{y}^{2}}" :db/id #edb/ref 17592186336123} {:answer/id #uuid "16292cbd-8350-5bd3-96d9-795ef552cf0a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{6{x}^{2}-\\operatorname{sin}⁡(y)}{x\\operatorname{cos}⁡(y)+3{y}^{2}}" :db/id #edb/ref 17592186336240} {:answer/id #uuid "1e57b365-540c-5e8a-8331-f6790e70b06d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{6{x}^{2}-\\operatorname{sin}⁡(y)}{x\\operatorname{cos}⁡(y)+2{y}^{3}}" :db/id #edb/ref 17592186336311} {:answer/id #uuid "23a544b4-0d38-57bb-983c-e904eb2a25c2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{6{x}^{2}+\\operatorname{sin}⁡(y)}{x\\operatorname{cos}⁡(y)+{y}^{2}}" :db/id #edb/ref 17592186336367} {:answer/id #uuid "ee47ac7c-c346-5761-8902-7e42ed6ca55e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{6{x}^{2}+\\operatorname{sin}⁡(y)}{x\\operatorname{cos}⁡(y)+3{y}^{2}}" :db/id #edb/ref 17592186338116}] :answer-field/correct {:answer/id #uuid "16292cbd-8350-5bd3-96d9-795ef552cf0a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{6{x}^{2}-\\operatorname{sin}⁡(y)}{x\\operatorname{cos}⁡(y)+3{y}^{2}}" :db/id #edb/ref 17592186336240} :answer-field/id #uuid "f6bf4581-0ffc-537f-82d9-87405f04b109" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186338711}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "454b7cf5-7862-57c7-a910-8dbc0dac1fcc" :question/math-academy-id "q-72213" :question/problem "Calculate $\\frac{\\text{d}y}{\\text{d}x}$ for $x\\operatorname{sin}⁡(y)+{y}^{3}=2{x}^{3}.$" :question/worked-solution "First, we differentiate both sides of the equation with respect to $x,$ assuming that $y=y(x).$\n\nNote that to differentiate the $x\\operatorname{sin}⁡y$ term, we will need to use the product rule.\n\n$$\n\\begin{aligned}x\\operatorname{sin}⁡(y)+{y}^{3}=2{x}^{3} \\\\ \\frac{\\text{d}}{\\text{d}x}(x\\operatorname{sin}⁡(y)+{y}^{3}) & =\\frac{\\text{d}}{\\text{d}x}(2{x}^{3}) \\\\ \\frac{\\text{d}}{\\text{d}x}(x\\operatorname{sin}⁡(y))+\\frac{\\text{d}}{\\text{d}x}({y}^{3}) & =\\frac{\\text{d}}{\\text{d}x}(2{x}^{3}) \\\\ [x(\\operatorname{cos}⁡(y)\\cdot \\frac{\\text{d}y}{\\text{d}x})+\\operatorname{sin}⁡(y)]+3{y}^{2}\\frac{\\text{d}y}{\\text{d}x} & =6{x}^{2} \\\\ x\\operatorname{cos}⁡(y)\\frac{\\text{d}y}{\\text{d}x}+\\operatorname{sin}⁡(y)+3{y}^{2}\\frac{\\text{d}y}{\\text{d}x} & =6{x}^{2}\\end{aligned}\n$$\n\nNow we solve the equation for $\\frac{\\text{d}y}{\\text{d}x},$ as follows:\n\n$$\n\\begin{aligned}x\\operatorname{cos}⁡(y)\\frac{\\text{d}y}{\\text{d}x}+3{y}^{2}\\frac{\\text{d}y}{\\text{d}x} & =6{x}^{2}-\\operatorname{sin}⁡(y) \\\\ \\frac{\\text{d}y}{\\text{d}x}(x\\operatorname{cos}⁡(y)+3{y}^{2}) & =6{x}^{2}-\\operatorname{sin}⁡(y) \\\\ \\frac{\\text{d}y}{\\text{d}x} & =\\frac{6{x}^{2}-\\operatorname{sin}⁡(y)}{x\\operatorname{cos}⁡(y)+3{y}^{2}}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186339078 :knowledge-point/_questions [{:db/id #edb/ref 17592186087833 :knowledge-point/id #uuid "57e19ee3-db9a-58d7-8ca3-4e8801aee656" :knowledge-point/title "Determining the Equation of a Tall Ellipse"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0d360012-b71b-5e3d-a5ed-050551fedc08" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{(x+2)^{2}}{6}+\\frac{(y+2)^{2}}{8}=1" :db/id #edb/ref 17592186336156} {:answer/id #uuid "363d6738-eccc-55d0-b37d-dc6eeb5492c9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{(x-2)^{2}}{9}+\\frac{(y+2)^{2}}{16}=1" :db/id #edb/ref 17592186336536} {:answer/id #uuid "799fad89-4775-5c00-9f34-a99bb77a3ae6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{(x-2)^{2}}{8}+\\frac{(y-2)^{2}}{6}=1" :db/id #edb/ref 17592186337125} {:answer/id #uuid "975b13c5-78a1-50ac-8fca-df15265468b8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{(x+2)^{2}}{9}+\\frac{(y+2)^{2}}{16}=1" :db/id #edb/ref 17592186337411} {:answer/id #uuid "a0e5af31-ccd8-5042-a136-b3b71e9698e8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{(x-2)^{2}}{9}+\\frac{(y-2)^{2}}{16}=1" :db/id #edb/ref 17592186337486}] :answer-field/correct {:answer/id #uuid "975b13c5-78a1-50ac-8fca-df15265468b8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{(x+2)^{2}}{9}+\\frac{(y+2)^{2}}{16}=1" :db/id #edb/ref 17592186337411} :answer-field/id #uuid "e195d8c3-ee86-56e6-9272-e56918978464" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186338674}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "82c10773-d500-51bb-9b6a-76b40d3c3844" :question/math-academy-id "q-72252" :question/problem "![](images/28/28079ead5ebb4649900653172d11c25f3ff489c6b34772094a1ba947c18ef3e1.png)\n\nWhat is the equation of the ellipse given above?" :question/worked-solution "Remember that the general equation of an ellipse centered at $(h,k)$ with a horizontal radius of length $a$ and a vertical radius of length $b$ is given by\n\n$$\n\\frac{(x-h)^{2}}{{a}^{2}}+\\frac{(y-k)^{2}}{{b}^{2}}=1.\n$$\n\n \n\nHere, the ellipse is centered at $(-2,-2),$ the horizontal radius has length $a=3,$ and the vertical radius has length $b=4.$ Therefore, the equation of the ellipse is\n\n$$\n\\begin{aligned}\\frac{(x-h)^{2}}{{a}^{2}}+\\frac{(y-k)^{2}}{{b}^{2}} & =1 \\\\ \\frac{(x-(-2))^{2}}{{3}^{2}}+\\frac{(y-(-2))^{2}}{{4}^{2}} & =1 \\\\ \\frac{(x+2)^{2}}{9}+\\frac{(y+2)^{2}}{16} & =1.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186339079 :knowledge-point/_questions [{:db/id #edb/ref 17592186054677 :knowledge-point/id #uuid "619182bf-107d-5217-a306-ec4f7c1109eb" :knowledge-point/title "Finding the Derivative of a Function Given in Implicit Form Using the Product Rule"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4b322d9c-37ab-52f7-9c7e-158b2aad5a2b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{6{x}^{2}-2xy}{{x}^{2}+4}" :db/id #edb/ref 17592186336727} {:answer/id #uuid "4fa8641b-f12e-5282-8639-b287c9ca081d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{6x-xy}{{x}^{2}+4}" :db/id #edb/ref 17592186336764} {:answer/id #uuid "778b8f44-4e6f-5e84-b5d0-3856a65b2fcc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{6-2xy}{{x}^{2}+4}" :db/id #edb/ref 17592186337107} {:answer/id #uuid "8e0a7e37-7922-5237-be4e-0d4daf2edd15" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{6x-2y}{{x}^{2}+4}" :db/id #edb/ref 17592186337313} {:answer/id #uuid "d8ffdd28-a653-5368-a470-1763333eed55" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{6x+2xy}{{x}^{2}-4}" :db/id #edb/ref 17592186337920}] :answer-field/correct {:answer/id #uuid "4b322d9c-37ab-52f7-9c7e-158b2aad5a2b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{6{x}^{2}-2xy}{{x}^{2}+4}" :db/id #edb/ref 17592186336727} :answer-field/id #uuid "f8ea9a9d-1024-53db-ae2f-47b539ab86b2" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186338714}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "3b84d5b9-93df-56c4-be18-4346c8b72764" :question/math-academy-id "q-72260" :question/problem "Calculate $\\frac{\\text{d}y}{\\text{d}x}$ for ${x}^{2}y+4y=2{x}^{3}.$" :question/worked-solution "First, we differentiate both sides of the equation with respect to $x,$ assuming that $y=y(x).$\n\nNote that to differentiate the ${x}^{2}y$ term, we will need to use the product rule.\n\n$$\n\\begin{aligned}{x}^{2}y+4y & =2{x}^{3} \\\\ \\frac{\\text{d}}{\\text{d}x}({x}^{2}y+4y) & =\\frac{\\text{d}}{\\text{d}x}(2{x}^{3}) \\\\ \\frac{\\text{d}}{\\text{d}x}({x}^{2}y)+\\frac{\\text{d}}{\\text{d}x}(4y) & =\\frac{\\text{d}}{\\text{d}x}(2{x}^{3}) \\\\ [{x}^{2}\\frac{\\text{d}y}{\\text{d}x}+y\\cdot 2x]+4\\frac{\\text{d}y}{\\text{d}x} & =6{x}^{2} \\\\ {x}^{2}\\frac{\\text{d}y}{\\text{d}x}+2xy+4\\frac{\\text{d}y}{\\text{d}x} & =6{x}^{2}\\end{aligned}\n$$\n\nNow we solve the equation for $\\frac{\\text{d}y}{\\text{d}x},$ as follows:\n\n$$\n\\begin{aligned}{x}^{2}\\frac{\\text{d}y}{\\text{d}x}+4\\frac{\\text{d}y}{\\text{d}x} & =6{x}^{2}-2xy \\\\ \\frac{\\text{d}y}{\\text{d}x}({x}^{2}+4) & =6{x}^{2}-2xy \\\\ \\frac{\\text{d}y}{\\text{d}x} & =\\frac{6{x}^{2}-2xy}{{x}^{2}+4}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186403550 :knowledge-point/_questions [{:db/id #edb/ref 17592186087822 :knowledge-point/id #uuid "79daf9dd-814d-562b-b3bc-b066bd2dfb90" :knowledge-point/title "Identifying the Shift Applied to an Exponential Growth Curve"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "93a712bc-5c5d-5646-9703-82e77d69b46e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=-3({3}^{x})" :db/id #edb/ref 17592186403552} {:answer/id #uuid "c63beba4-7686-58ae-845d-111254d3e6ae" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y={3}^{x}-1" :db/id #edb/ref 17592186403553} {:answer/id #uuid "5996d30b-a352-5547-9b35-f09224ff8616" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y={3}^{x}-3" :db/id #edb/ref 17592186403554} {:answer/id #uuid "e2d5db3c-106b-5a20-8512-215f226e23f6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y={3}^{x}-2" :db/id #edb/ref 17592186403555} {:answer/id #uuid "3d9e24e9-f8f1-50d2-a309-392b65ff2168" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=-2({3}^{x})" :db/id #edb/ref 17592186403556}] :answer-field/correct {:answer/id #uuid "e2d5db3c-106b-5a20-8512-215f226e23f6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y={3}^{x}-2" :db/id #edb/ref 17592186403555} :answer-field/id #uuid "7f6e4f21-8993-51e5-a1c9-737356240b0e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186403551}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "bbca085f-0b60-5f9a-bdc1-1da6491170fe" :question/math-academy-id "q-7230" :question/problem "![](images/87/8764149ca0000522277d48bf48f4ef14ba06f7e4793ba1a58ef639ff7af3a3b9.png)\n\nThe graph above shows the curve $y={3}^{x}+c.$ Determine the value of $c$ and find the equation of the curve." :question/worked-solution "The horizontal asymptote of $y={3}^{x}$ is $y=0.$ The vertical translation $y={3}^{x}+c$ shifts the asymptote to $y=c.$\n\nIn the graph above, the horizontal asymptote is $y=-2.$ Therefore, $c=-2.$"}] [{:db/id #edb/ref 17592186403557 :knowledge-point/_questions [{:db/id #edb/ref 17592186087822 :knowledge-point/id #uuid "79daf9dd-814d-562b-b3bc-b066bd2dfb90" :knowledge-point/title "Identifying the Shift Applied to an Exponential Growth Curve"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "760d4f2f-67c3-578b-90ce-e44b5cc0e475" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y={2}^{x}-2" :db/id #edb/ref 17592186403559} {:answer/id #uuid "a42ff124-ce1b-58ec-a4c4-728cb4b536df" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=-3({2}^{x})" :db/id #edb/ref 17592186403560} {:answer/id #uuid "9bb95f56-7efa-56a4-ab5b-5f4220d4b140" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y={2}^{x}-3" :db/id #edb/ref 17592186403561} {:answer/id #uuid "840799e0-019f-5e56-960e-e4dce9f6a43e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y={3}^{x}-4" :db/id #edb/ref 17592186403562} {:answer/id #uuid "97c4002b-68c4-5b92-bb46-3a3c52c7bbac" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=3({2}^{x})" :db/id #edb/ref 17592186403563}] :answer-field/correct {:answer/id #uuid "9bb95f56-7efa-56a4-ab5b-5f4220d4b140" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y={2}^{x}-3" :db/id #edb/ref 17592186403561} :answer-field/id #uuid "117f36b7-d2dd-58cf-81f2-744857f29ebf" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186403558}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "bb2d08ab-7e1f-579d-8314-e037ebc00133" :question/math-academy-id "q-7232" :question/problem "![](images/2a/2ad72b3df34f32d6a76f79f6801887bd6fe1d762fefd74071517a754b1890ac2.png)\n\nThe graph above shows the curve $y={2}^{x}+c.$ Determine the value of $c$ and find the equation of the curve." :question/worked-solution "The horizontal asymptote of $y={2}^{x}$ is $y=0.$ The vertical translation $y={2}^{x}+c$ shifts the asymptote to $y=c.$\n\nIn the graph above, the horizontal asymptote is $y=-3.$ Therefore, $c=-3.$"}] [{:db/id #edb/ref 17592186339090 :knowledge-point/_questions [{:db/id #edb/ref 17592186068690 :knowledge-point/id #uuid "9f29435f-b112-5999-b0ca-9003d9e622e1" :knowledge-point/title "Calculating an Indeterminate Limit of the Form Infinity Divided by Infinity Using L'Hopital's Rule"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2905b3c7-5120-5928-8659-ab7cf49215cf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\infty " :db/id #edb/ref 17592186336415} {:answer/id #uuid "9c9f02de-6945-5986-9bd6-77c4fda53a38" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186337447} {:answer/id #uuid "c4c17bce-f321-5a5a-b8a2-e2f57aa0f0a6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186337781} {:answer/id #uuid "d1424795-2c4b-569b-984c-33e713fb9a2d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186337866} {:answer/id #uuid "f3baaf2a-856c-5b97-ba7e-56d8806079c7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186338162}] :answer-field/correct {:answer/id #uuid "f3baaf2a-856c-5b97-ba7e-56d8806079c7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186338162} :answer-field/id #uuid "1d342821-bbce-5fd1-b3bb-822b8446cf81" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186338330}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "83ace1c9-0a10-59aa-bb99-7a86a6dbfa17" :question/math-academy-id "q-72333" :question/problem "Evaluate ${lim}_{x\\to {0}^{+}}\\frac{\\operatorname{ln}⁡x}{{e}^{1/x}}.$" :question/worked-solution "Here the limits of the numerator and denominator are ${lim}_{x\\to {0}^{+}}\\operatorname{ln}⁡x=-\\infty $ and ${lim}_{x\\to {0}^{+}}{e}^{1/x}=\\infty ,$ respectively, so we have the case $\\frac{-\\infty }{\\infty }.$\n\nApplying L'Hopital's rule, we obtain\n\n$$\n\\begin{aligned}{lim}_{x\\to {0}^{+}}\\frac{\\operatorname{ln}⁡x}{{e}^{1/x}} & ={lim}_{x\\to {0}^{+}}\\frac{[\\operatorname{ln}⁡x]^{′}}{[{e}^{1/x}]^{′}} \\\\  & ={lim}_{x\\to {0}^{+}}\\frac{(\\frac{1}{x})}{{e}^{1/x}(-\\frac{1}{{x}^{2}})} \\\\  & =-{lim}_{x\\to {0}^{+}}\\frac{{x}^{-1}}{{e}^{1/x}\\cdot {x}^{-2}} \\\\  & =-{lim}_{x\\to {0}^{+}}\\frac{x}{{e}^{1/x}} \\\\  & =0.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186339092 :knowledge-point/_questions [{:db/id #edb/ref 17592186068690 :knowledge-point/id #uuid "9f29435f-b112-5999-b0ca-9003d9e622e1" :knowledge-point/title "Calculating an Indeterminate Limit of the Form Infinity Divided by Infinity Using L'Hopital's Rule"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2dd6dd70-5f78-54b6-ac97-950f2f384aef" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186336473} {:answer/id #uuid "4e08260e-b4f6-5c7a-ad2d-8294f523a3ac" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186336757} {:answer/id #uuid "5b538add-4209-5721-8b56-652729cc391f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186336862} {:answer/id #uuid "7d7564a4-f738-5faf-a2c3-bdd625a0ef99" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{4}" :db/id #edb/ref 17592186337163} {:answer/id #uuid "bb83b45c-700e-5a49-955e-7ea35708e865" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\infty " :db/id #edb/ref 17592186337697}] :answer-field/correct {:answer/id #uuid "4e08260e-b4f6-5c7a-ad2d-8294f523a3ac" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186336757} :answer-field/id #uuid "64250102-7382-5959-9fea-4e5f4501809d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186338454}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "d0dae206-0030-50d7-a470-3e9d541986a9" :question/math-academy-id "q-72336" :question/problem "Evaluate ${lim}_{x\\to 0}\\frac{(\\frac{1}{{x}^{2}})}{(\\frac{1}{{x}^{4}}-1)}.$" :question/worked-solution "Here the limits of the numerator and denominator are ${lim}_{x\\to 0}\\frac{1}{{x}^{2}}=\\infty $ and ${lim}_{x\\to 0}(\\frac{1}{{x}^{4}}-1)=\\infty ,$ respectively, so we have the case $\\frac{\\infty }{\\infty }.$\n\nApplying L'Hopital's rule, we obtain\n\n$$\n\\begin{aligned}{lim}_{x\\to 0}\\frac{(\\frac{1}{{x}^{2}})}{(\\frac{1}{{x}^{4}}-1)} & ={lim}_{x\\to 0}\\frac{{[\\frac{1}{{x}^{2}}]}^{′}}{{[\\frac{1}{{x}^{4}}-1]}^{′}} \\\\  & ={lim}_{x\\to 0}\\frac{(-\\frac{2}{{x}^{3}})}{(-\\frac{4}{{x}^{5}})} \\\\  & ={lim}_{x\\to 0}\\frac{2{x}^{-3}}{4{x}^{-5}} \\\\  & ={lim}_{x\\to 0}\\frac{{x}^{2}}{2} \\\\  & =0.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186069507 :knowledge-point/_questions [{:db/id #edb/ref 17592186068690 :knowledge-point/id #uuid "9f29435f-b112-5999-b0ca-9003d9e622e1" :knowledge-point/title "Calculating an Indeterminate Limit of the Form Infinity Divided by Infinity Using L'Hopital's Rule"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2c029288-0577-53f2-b622-20d182eb4958" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\infty " :db/id #edb/ref 17592186336446} {:answer/id #uuid "537b5f65-839c-5501-a32d-7c7e7a49a12b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186336806} {:answer/id #uuid "77455b1e-3f23-5bec-b73a-1b6c9dc86ab2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186337106} {:answer/id #uuid "9e26fb10-c993-50f5-8b93-429253440f15" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\infty " :db/id #edb/ref 17592186337463} {:answer/id #uuid "e2592f07-77fc-5726-895f-b9958ca63d12" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186338000}] :answer-field/correct {:answer/id #uuid "e2592f07-77fc-5726-895f-b9958ca63d12" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186338000} :answer-field/id #uuid "d7f9d37f-e6cb-53f6-b39d-a73c1eb6742f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186338656}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "8a9948ce-563f-5b0f-bd31-1937130137d2" :question/math-academy-id "q-72339" :question/problem "Evaluate ${lim}_{x\\to {0}^{+}}\\frac{\\operatorname{ln}⁡(\\operatorname{sin}⁡x)}{\\operatorname{csc}⁡x}.$" :question/worked-solution "Here the limits of the numerator and denominator are ${lim}_{x\\to {0}^{+}}\\operatorname{ln}⁡(\\operatorname{sin}⁡x)=-\\infty $ and ${lim}_{x\\to {0}^{+}}\\operatorname{csc}⁡x=\\infty ,$ respectively, so we have the case $\\frac{-\\infty }{\\infty }.$\n\nApplying L'Hopital's rule, we obtain\n\n$$\n\\begin{aligned}{lim}_{x\\to {0}^{+}}\\frac{\\operatorname{ln}⁡(\\operatorname{sin}⁡x)}{\\operatorname{csc}⁡x} & ={lim}_{x\\to {0}^{+}}\\frac{{[\\operatorname{ln}⁡(\\operatorname{sin}⁡x)]}^{′}}{[\\operatorname{csc}⁡x]^{′}} \\\\  & ={lim}_{x\\to {0}^{+}}\\frac{\\operatorname{cot}⁡x}{-\\operatorname{csc}⁡x\\operatorname{cot}⁡x} \\\\  & =-{lim}_{x\\to {0}^{+}}\\frac{\\cancel{\\operatorname{cot}⁡x}}{\\operatorname{csc}⁡x\\cancel{\\operatorname{cot}⁡x}} \\\\  & =-{lim}_{x\\to {0}^{+}}\\frac{1}{\\operatorname{csc}⁡x} \\\\  & =-{lim}_{x\\to {0}^{+}}\\operatorname{sin}⁡x \\\\  & =0.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186339100 :knowledge-point/_questions [{:db/id #edb/ref 17592186068722 :knowledge-point/id #uuid "b89c50f3-2181-5b61-96cb-386ef88d2035" :knowledge-point/title "Integrating an Expression Involving a Power Function Multiplied by Its Derivative"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "181818f9-ee5d-570b-8805-3453bec6da26" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\sqrt{(1+{x}^{5})^{3}}+C" :db/id #edb/ref 17592186336257} {:answer/id #uuid "324b72d3-41e0-5026-af58-5b34dc0551ad" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\sqrt{1+{x}^{5}}+C" :db/id #edb/ref 17592186336509} {:answer/id #uuid "601c5f25-3385-59f3-b9ec-6f4783410687" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{1+{x}^{5}}}{2}+C" :db/id #edb/ref 17592186336901} {:answer/id #uuid "d13e9d9a-a682-5a93-b274-9657dd12c702" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2x\\sqrt{1+{x}^{5}}+C" :db/id #edb/ref 17592186337864} {:answer/id #uuid "e2d6ab9a-d942-55d2-8674-766bbfa15318" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{(1+{x}^{5})^{3}}}{2}+C" :db/id #edb/ref 17592186338008}] :answer-field/correct {:answer/id #uuid "324b72d3-41e0-5026-af58-5b34dc0551ad" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\sqrt{1+{x}^{5}}+C" :db/id #edb/ref 17592186336509} :answer-field/id #uuid "1287170e-aae1-5d7e-9ef3-ec229bb6713f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186338307}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "94a2c36c-7f20-5b89-950f-742f856d9127" :question/math-academy-id "q-72382" :question/problem "Calculate $\\int \\frac{5{x}^{4}}{\\sqrt{1+{x}^{5}}}\\,\\text{d}x.$" :question/worked-solution "We note that $5{x}^{4}$ is the derivative of the quantity in the radical. So we make a substitution\n\n$$\nu=1+{x}^{5}.\n$$\n\nIts derivative is given by\n\n$$\n\\begin{aligned}\\frac{\\text{d}u}{\\text{d}x} & =5{x}^{4}\\,⟹\\,\\text{d}u=5{x}^{4}\\,\\text{d}x,\\end{aligned}\n$$\n\nand rewriting our integral, we get\n\n$$\n\\begin{aligned}\\int \\frac{5{x}^{4}}{\\sqrt{1+{x}^{5}}}\\,\\text{d}x & =\\int \\frac{1}{\\sqrt{1+{x}^{5}}}\\,5{x}^{4}\\,\\text{d}x \\\\  & =\\int \\frac{1}{\\sqrt{u}}\\,\\text{d}u \\\\  & =\\int \\frac{1}{{u}^{1/2}}\\,\\text{d}u \\\\  & =\\int {u}^{-1/2}\\,\\text{d}u.\\end{aligned}\n$$\n\nWe can now solve the integral using the power rule:\n\n$$\n\\begin{aligned}\\int {u}^{-1/2}\\,\\text{d}u & =\\frac{{u}^{1/2}}{(\\frac{1}{2})}+C \\\\  & =2{u}^{1/2}+C \\\\  & =2\\sqrt{u}+C\\end{aligned}\n$$\n\nLastly, we substitute $u=1+{x}^{5}$ back in the expression. So the final result is\n\n$$\n\\begin{aligned}\\int \\frac{5{x}^{4}}{\\sqrt{1+{x}^{5}}}\\,\\text{d}x & =2\\sqrt{1+{x}^{5}}+C.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186339103 :knowledge-point/_questions [{:db/id #edb/ref 17592186087824 :knowledge-point/id #uuid "0b70a3b7-90a7-5a83-b71f-304f7f25c4ef" :knowledge-point/title "Identifying the Shift and Stretch Applied to an Exponential Growth Curve"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "121b16a2-0458-5600-9a6f-f4f6e552fd5d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=3({2}^{x})-2" :db/id #edb/ref 17592186336202} {:answer/id #uuid "4c671da3-c302-5f3c-9ea5-2dc6dac2cc6c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=3({2}^{x})+2" :db/id #edb/ref 17592186336742} {:answer/id #uuid "6fed05ea-acde-5be8-b414-01135dc6f042" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=3({2}^{x})-1" :db/id #edb/ref 17592186337023} {:answer/id #uuid "826ab4ce-caa8-5db7-9188-f1b3cd74a9bb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y={2}^{x}-1" :db/id #edb/ref 17592186337218} {:answer/id #uuid "9cf95245-48b9-524a-917b-0ba71da5cdb8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=2({2}^{x})-1" :db/id #edb/ref 17592186337452}] :answer-field/correct {:answer/id #uuid "6fed05ea-acde-5be8-b414-01135dc6f042" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=3({2}^{x})-1" :db/id #edb/ref 17592186337023} :answer-field/id #uuid "0eab9c10-198f-58c5-918e-000cc777273e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186338303}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "9f0333a8-0cc0-5b0c-9999-f5175286f364" :question/math-academy-id "q-7239" :question/problem "![](images/1c/1ca11413bbce2ff307e494fb5a79028535b76cff24619e6921620f88c3e274ec.png)\n\nThe graph above shows $y=k({2}^{x})+c.$  Determine the values of $k$ and $c$ and find the equation of the curve." :question/worked-solution "The horizontal asymptote of the curve $y=k({2}^{x})+c$ is $y=c.$ In the graph above, the horizontal asymptote is $y=-1,$ so $c=-1.$\n\nTherefore, our function takes the form\n\n$$\ny=k({2}^{x})-1.\n$$\n\nWe can solve for $k$ by finding a point on the graph and substituting for $x$ and $y.$ The labeled point on the graph is $(0,2),$ so we substitute $x=0$ and $y=2$ into the function and solve for $k:$\n\n$$\n\\begin{aligned}y & =k({2}^{x})-1 \\\\ 2 & =k({2}^{0})-1 \\\\ 2 & =k(1)-1 \\\\ 2 & =k-1 \\\\ 3 & =k\\end{aligned}\n$$\n\nTherefore, the curve is $y=3({2}^{x})-1.$"}] [{:db/id #edb/ref 17592186339109 :knowledge-point/_questions [{:db/id #edb/ref 17592186087824 :knowledge-point/id #uuid "0b70a3b7-90a7-5a83-b71f-304f7f25c4ef" :knowledge-point/title "Identifying the Shift and Stretch Applied to an Exponential Growth Curve"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "49005b9e-8885-518c-a503-38932dbc77f8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=1.5({2}^{x})+4" :db/id #edb/ref 17592186336710} {:answer/id #uuid "a7777608-b4d4-5368-84cb-c7a407165b82" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=1.5({2}^{x})+3" :db/id #edb/ref 17592186337546} {:answer/id #uuid "ba7873cf-81b9-5aaf-8051-9f548d554ab8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=0.5({2}^{x})+4" :db/id #edb/ref 17592186337684} {:answer/id #uuid "c3ad9d29-36d5-5b4e-bad4-d6181862fae0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=1.5({2}^{x})+5" :db/id #edb/ref 17592186337768} {:answer/id #uuid "e97102d4-c948-5475-a8f4-3282b09cc04f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=0.5({2}^{x})+5" :db/id #edb/ref 17592186338069}] :answer-field/correct {:answer/id #uuid "49005b9e-8885-518c-a503-38932dbc77f8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=1.5({2}^{x})+4" :db/id #edb/ref 17592186336710} :answer-field/id #uuid "08a06ece-0b13-5c0a-9459-301060485f8d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186338290}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "5a92c523-6f37-5b9d-8ed7-2c5b4d7360ee" :question/math-academy-id "q-7241" :question/problem "![](images/3a/3a78c4fc61bbf60e1cdfdba6303ecc1a9d5e09caa21d0879556106893a931a09.png)\n\nThe graph above shows $y=k({2}^{x})+c.$  Determine the values of $k$ and $c$ and find the equation of the curve." :question/worked-solution "The horizontal asymptote of the curve $y=k({2}^{x})+c$ is $y=c.$ In the graph above, the horizontal asymptote is $y=4,$ so $c=4.$\n\nTherefore, our function takes the form\n\n$$\ny=k({2}^{x})+4.\n$$\n\nWe can solve for $k$ by finding a point on the graph and substituting for $x$ and $y.$ The labeled point on the graph is $(0,5.5),$ so we substitute $x=0$ and $y=5.5$ into the function and solve for $k:$\n\n$$\n\\begin{aligned}y & =k({2}^{x})+4 \\\\ 5.5 & =k({2}^{0})+4 \\\\ 5.5 & =k(1)+4 \\\\ 5.5 & =k+4 \\\\ 1.5 & =k\\end{aligned}\n$$\n\nTherefore, the curve is $y=1.5({2}^{x})+4.$"}] [{:db/id #edb/ref 17592186398961 :knowledge-point/_questions [{:db/id #edb/ref 17592186064203 :knowledge-point/id #uuid "e2b47545-fdf1-5e6a-b0bb-bbbecb8067cc" :knowledge-point/title "Integrating an Algebraic Function With Positive Integer Exponent"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6058cb14-4722-5ae2-982a-1d1d72759305" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-(7-2x)^{8}+C" :db/id #edb/ref 17592186398963} {:answer/id #uuid "615ab3c3-1cc9-56db-a561-9ade7641ace4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{2}(7-2x)^{8}+C" :db/id #edb/ref 17592186398964} {:answer/id #uuid "2b200597-1f86-5ecd-b8bc-18b09c132aad" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(7-2x)^{8}+C" :db/id #edb/ref 17592186398965} {:answer/id #uuid "13a3fa38-b420-5956-8a4b-2194f2d8ef30" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{8}(7-2x)^{8}+C" :db/id #edb/ref 17592186398966} {:answer/id #uuid "5674f007-df38-5b04-ac90-1342c70182a8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}(7-2x)^{8}+C" :db/id #edb/ref 17592186398967}] :answer-field/correct {:answer/id #uuid "6058cb14-4722-5ae2-982a-1d1d72759305" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-(7-2x)^{8}+C" :db/id #edb/ref 17592186398963} :answer-field/id #uuid "6ee57767-a470-5ed2-888e-e7479cb9accb" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186398962}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "8c75bb9c-44e2-5f73-9a68-3c296ae237a7" :question/math-academy-id "q-72424" :question/problem "$\\int 16(7-2x)^{7}\\,\\text{d}x=$" :question/worked-solution "Let $u=7-2x.$ Then differentiating with respect to $x$ gives\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=-2\\,⟹\\,\\text{d}x=-\\frac{1}{2}\\text{d}u.\n$$\n\nWe now write our integral in terms of $u,$ calculate the integral as normal, and write the final answer in terms of $x$ at the very end:\n\n$$\n\\begin{aligned}\\int 16(7-2x)^{7}\\,\\text{d}x & =\\int 16{u}^{7}\\cdot (-\\frac{1}{2})\\,\\text{d}u \\\\  & =16\\int {u}^{7}\\cdot (-\\frac{1}{2})\\,\\text{d}u \\\\  & =16\\cdot (-\\frac{1}{2})\\int {u}^{7}\\,\\text{d}u \\\\  & =-8\\cdot \\frac{{u}^{8}}{8}+C \\\\  & =-{u}^{8}+C \\\\  & =-(7-2x)^{8}+C\\end{aligned}\n$$\n\nLet's double-check that our result is correct. If we differentiate the result, then it should come out to the original integrand:\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}[-(7-2x)^{8}+C] & =-\\frac{\\text{d}}{\\text{d}x}[(7-2x)^{8}]+\\frac{\\text{d}}{\\text{d}x}(C) \\\\  & =-8(7-2x)^{7}\\cdot \\frac{\\text{d}}{\\text{d}x}(7-2x)+0 \\\\  & =-8(7-2x)^{7}\\cdot (-2) \\\\  & =16(7-2x)^{7}\\,✓\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186339116 :knowledge-point/_questions [{:db/id #edb/ref 17592186064207 :knowledge-point/id #uuid "bdbfa506-08a1-5e43-b958-2ae373df775d" :knowledge-point/title "Integrating a Linear Rational Function and Simplifying the Arbitrary Constant"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0ea8c3ea-0518-506a-9945-ef3bf2bf7936" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\operatorname{ln}⁡(K|7-x|)" :db/id #edb/ref 17592186336171} {:answer/id #uuid "6ae31738-7e11-5b61-bda5-73b51a186dc1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{7}\\operatorname{ln}⁡(K|7-x|)" :db/id #edb/ref 17592186336978} {:answer/id #uuid "9dd74f15-1558-5167-ae1a-0738b496e927" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}\\operatorname{ln}⁡(K|7-x|)" :db/id #edb/ref 17592186337459} {:answer/id #uuid "afeaa9dd-27fb-515f-9b9a-a9fc160293f8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{ln}⁡(K|7-x|)" :db/id #edb/ref 17592186337612} {:answer/id #uuid "c8d07741-d286-59ef-b0bc-34120b2124b6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{7}\\operatorname{ln}⁡(K|7-x|)" :db/id #edb/ref 17592186337807}] :answer-field/correct {:answer/id #uuid "0ea8c3ea-0518-506a-9945-ef3bf2bf7936" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\operatorname{ln}⁡(K|7-x|)" :db/id #edb/ref 17592186336171} :answer-field/id #uuid "14072edb-e48a-597d-a3df-afce4caaaa51" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186338311}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "b16baf99-001c-5b72-bc61-2ffc6c75b449" :question/math-academy-id "q-72445" :question/problem "Calculate $\\int \\frac{1}{7-x}\\,\\text{d}x.$ Assume that $K$ is an arbitrary positive constant." :question/worked-solution "First, let $u=7-x.$ Then differentiating with respect to $x$ gives\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=-1\\,⟹\\,\\text{d}x=-\\text{d}u.\n$$\n\nWe can now rewrite the integral in terms of $u,$ solve it, and write the final answer in terms of $x$ as follows:\n\n$$\n\\begin{aligned}\\int \\frac{1}{7-x}\\,\\text{d}x & =\\int \\frac{1}{u}\\cdot (-1)\\,\\text{d}u \\\\  & =-\\int \\frac{1}{u}\\,\\text{d}u \\\\  & =-\\operatorname{ln}⁡|u|+C \\\\  & =-\\operatorname{ln}⁡|7-x|+C\\end{aligned}\n$$\n\nWe can further simplify the above by writing $C=-\\operatorname{ln}⁡K$ for another arbitrary constant $K,$ and then we can combine the two terms using the laws of logarithms, as follows:\n\n$$\n\\begin{aligned}-\\operatorname{ln}⁡|7-x|+C & =-\\operatorname{ln}⁡|7-x|-\\operatorname{ln}⁡K \\\\  & =-(\\operatorname{ln}⁡|7-x|+\\operatorname{ln}⁡K) \\\\  & =-\\operatorname{ln}⁡(K|7-x|)\\end{aligned}\n$$\n\nSo, we finally conclude that\n\n$$\n\\int \\frac{1}{7-x}\\,\\text{d}x=-\\operatorname{ln}⁡(K|7-x|).\n$$"}] [{:db/id #edb/ref 17592186339117 :knowledge-point/_questions [{:db/id #edb/ref 17592186064207 :knowledge-point/id #uuid "bdbfa506-08a1-5e43-b958-2ae373df775d" :knowledge-point/title "Integrating a Linear Rational Function and Simplifying the Arbitrary Constant"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "07b76063-8fda-596f-8106-cbb57f2ef69a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}\\operatorname{ln}⁡(K|5-2x|)" :db/id #edb/ref 17592186336093} {:answer/id #uuid "86f6a2e9-4d29-5e23-9617-09660280aaa3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\operatorname{ln}⁡(K|5-2x|)" :db/id #edb/ref 17592186337252} {:answer/id #uuid "b4ead48b-c59a-570e-a7de-39bcbc22b8fe" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{ln}⁡(K|5-2x|)" :db/id #edb/ref 17592186337638} {:answer/id #uuid "bec88b66-0b15-559a-8f7c-3341c51c2ee0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{2}\\operatorname{ln}⁡(K|5-2x|)" :db/id #edb/ref 17592186337729} {:answer/id #uuid "f6322442-f9d7-5f7c-ac2d-896d214f1436" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2\\operatorname{ln}⁡(K|5-2x|)" :db/id #edb/ref 17592186338188}] :answer-field/correct {:answer/id #uuid "bec88b66-0b15-559a-8f7c-3341c51c2ee0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{2}\\operatorname{ln}⁡(K|5-2x|)" :db/id #edb/ref 17592186337729} :answer-field/id #uuid "209f233a-25a9-55a5-ab33-40122ec3bf02" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186338337}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "2d475585-492e-5142-bfa4-12e97136e061" :question/math-academy-id "q-72446" :question/problem "Calculate $\\int \\frac{1}{5-2x}\\,\\text{d}x.$ Assume that $K$ is an arbitrary positive constant." :question/worked-solution "First, let $u=5-2x.$ Then differentiating with respect to $x$ gives\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=-2\\,⟹\\,\\text{d}x=-\\frac{1}{2}\\text{d}u.\n$$\n\nWe can now rewrite the integral in terms of $u,$ solve it, and write the final answer in terms of $x$ as follows:\n\n$$\n\\begin{aligned}\\int \\frac{1}{5-2x}\\,\\text{d}x & =\\int \\frac{1}{u}\\cdot (-\\frac{1}{2})\\,\\text{d}u \\\\  & =-\\frac{1}{2}\\int \\frac{1}{u}\\,\\text{d}u \\\\  & =-\\frac{1}{2}\\operatorname{ln}⁡|u|+C \\\\  & =-\\frac{1}{2}\\operatorname{ln}⁡|5-2x|+C\\end{aligned}\n$$\n\nWe can further simplify the above by writing $C=-\\frac{1}{2}\\operatorname{ln}⁡K$ for another arbitrary constant $K,$ and then we can combine the two terms using the laws of logarithms, as follows:\n\n$$\n\\begin{aligned}-\\frac{1}{2}\\operatorname{ln}⁡|5-2x|+C & =-\\frac{1}{2}\\operatorname{ln}⁡|5-2x|-\\frac{1}{2}\\operatorname{ln}⁡K \\\\  & =-\\frac{1}{2}(\\operatorname{ln}⁡|5-2x|+\\operatorname{ln}⁡K) \\\\  & =-\\frac{1}{2}\\operatorname{ln}⁡(K|5-2x|)\\end{aligned}\n$$\n\nSo, we finally conclude that\n\n$$\n\\int \\frac{1}{5-2x}\\text{d}x=-\\frac{1}{2}\\operatorname{ln}⁡(K|5-2x|).\n$$"}] [{:db/id #edb/ref 17592186339119 :knowledge-point/_questions [{:db/id #edb/ref 17592186064208 :knowledge-point/id #uuid "af32f07f-fa65-5ede-a506-735dc2d3a5ef" :knowledge-point/title "Integrating a Combination of Linear Rational Functions Using the General Formula"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1f5cd12b-daf8-57b4-a508-5b25997dfab6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}\\operatorname{ln}⁡(K|(2x+1)(2x-1)|)" :db/id #edb/ref 17592186336323} {:answer/id #uuid "4b0ccfc1-4a8e-5fe1-b80c-9d8713467d76" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{ln}⁡(K|\\frac{2x+1}{2x-1}|)" :db/id #edb/ref 17592186336723} {:answer/id #uuid "4e0854d1-efd5-57d5-ad92-34e8d95cd84e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\operatorname{ln}⁡(K|(2x+1)(2x-1)|)" :db/id #edb/ref 17592186336758} {:answer/id #uuid "89828476-cdcf-5b30-b125-067c9a0a1d66" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\operatorname{ln}⁡(K|\\frac{2x+1}{2x-1}|)" :db/id #edb/ref 17592186337271} {:answer/id #uuid "8e9493db-04ea-5567-b436-e98702a20a0a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}\\operatorname{ln}⁡(K|\\frac{2x+1}{2x-1}|)" :db/id #edb/ref 17592186337316}] :answer-field/correct {:answer/id #uuid "1f5cd12b-daf8-57b4-a508-5b25997dfab6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}\\operatorname{ln}⁡(K|(2x+1)(2x-1)|)" :db/id #edb/ref 17592186336323} :answer-field/id #uuid "dd143701-6720-5620-9d38-200cfec896ea" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186338665}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "b89e488e-b744-5dec-bdcd-c1a1eb5f6a8b" :question/math-academy-id "q-72449" :question/problem "Calculate $\\int (\\frac{1}{2x+1}+\\frac{1}{2x-1})\\,\\text{d}x.$ Assume that $K$ is an arbitrary positive constant." :question/worked-solution "Let's solve this using the general formula:\n\n$$\n\\begin{aligned}\\int (\\frac{1}{2x+1}+\\frac{1}{2x-1})\\,\\text{d}x & =\\int \\frac{1}{2x+1}\\,\\text{d}x+\\int \\frac{1}{2x-1}\\,\\text{d}x \\\\  & =\\frac{1}{2}\\operatorname{ln}⁡|2x+1|+\\frac{1}{2}\\operatorname{ln}⁡|2x-1|+C \\\\  & =\\frac{1}{2}\\operatorname{ln}⁡|(2x+1)(2x-1)|+\\frac{1}{2}\\text{ }\\operatorname{ln}⁡K \\\\  & =\\frac{1}{2}\\operatorname{ln}⁡(K|(2x+1)(2x-1)|)\\end{aligned}\n$$\n\nNotice that we used the laws of logarithms to write the result as a single logarithm."}] [{:db/id #edb/ref 17592186339123 :knowledge-point/_questions [{:db/id #edb/ref 17592186068723 :knowledge-point/id #uuid "8fe2a279-0b92-561e-b17d-b902f43725ac" :knowledge-point/title "Integrating an Expression Involving a Power Function Multiplied by a Constant Multiple of Its Derivative"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0e59935f-f93b-599b-9816-d15f61104595" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\sqrt{({x}^{2}-5)^{3}}+C" :db/id #edb/ref 17592186336167} {:answer/id #uuid "1ccce204-ca7a-5eee-bc02-3fcc7e16e632" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3\\sqrt{({x}^{2}-5)^{3}}+C" :db/id #edb/ref 17592186336299} {:answer/id #uuid "4b5b5f53-8881-5e03-8cde-ddfcc41895a3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{({x}^{2}-5)^{3}}+C" :db/id #edb/ref 17592186336732} {:answer/id #uuid "75e7362c-a6a5-5145-bf5d-1527db0f317d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{3}\\sqrt{({x}^{2}-5)^{3}}+C" :db/id #edb/ref 17592186337095} {:answer/id #uuid "7bc5cfb0-4b70-528a-a0e4-e88e561188b5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}\\sqrt{({x}^{2}-5)^{3}}+C" :db/id #edb/ref 17592186337152}] :answer-field/correct {:answer/id #uuid "75e7362c-a6a5-5145-bf5d-1527db0f317d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{3}\\sqrt{({x}^{2}-5)^{3}}+C" :db/id #edb/ref 17592186337095} :answer-field/id #uuid "80b5679a-f4f7-56bb-9b5b-253ee5665aec" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186338504}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "de70203f-dd05-5f0d-9800-283717012618" :question/math-academy-id "q-72467" :question/problem "Calculate $\\int x\\sqrt{{x}^{2}-5}\\,\\text{d}x.$" :question/worked-solution "In this case, the $x$ that's outside the square root isn't quite the derivative of $({x}^{2}-5).$ But the derivative is $2x,$ so we're only out by a constant factor.\n\nSo we make the substitution\n\n$$\nu={x}^{2}-5.\n$$\n\nIts derivative is given by\n\n$$\n\\begin{aligned}\\frac{\\text{d}u}{\\text{d}x} & =2x\\,⟹\\,\\frac{1}{2}\\text{d}u=x\\,\\text{d}x,\\end{aligned}\n$$\n\nand we can now write our integral in terms of $u,$ as follows:\n\n$$\n\\begin{aligned}\\int x\\sqrt{{x}^{2}-5}\\,\\text{d}x & =\\int \\sqrt{{x}^{2}-5}\\cdot x\\,\\text{d}x \\\\  & =\\int \\sqrt{u}\\cdot \\frac{1}{2}\\text{d}u \\\\  & =\\frac{1}{2}\\int {u}^{1/2}\\,\\text{d}u\\end{aligned}\n$$\n\nFinally, we can solve the integral in terms of $u$ and then write the final result in terms of $x.$ We get\n\n$$\n\\begin{aligned}\\frac{1}{2}\\int {u}^{1/2}\\,\\text{d}u & =\\frac{1}{2}\\cdot \\frac{{u}^{3/2}}{(\\frac{3}{2})}+C \\\\  & =\\frac{1}{2}\\cdot \\frac{2}{3}\\cdot {u}^{3/2}+C \\\\  & =\\frac{1}{3}{u}^{3/2}+C \\\\  & =\\frac{1}{3}\\sqrt{{u}^{3}}+C \\\\  & =\\frac{1}{3}\\sqrt{({x}^{2}-5)^{3}}+C.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186111390 :knowledge-point/_questions [{:db/id #edb/ref 17592186110669 :knowledge-point/id #uuid "34645eb8-3624-5ff3-817d-28f8d0cee4ba" :knowledge-point/title "Identifying the Scaling Constant From a Graph"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1dc7ed7d-8822-50d6-adbe-ad3f4f94cc16" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186336309} {:answer/id #uuid "2855b2b9-6a8b-51fc-bc86-192bc1d62f6f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{3}" :db/id #edb/ref 17592186336410} {:answer/id #uuid "62f307be-5f4b-5771-b9ee-77edd782e456" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186336922} {:answer/id #uuid "75294229-d638-5281-9b75-127f796a0330" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186337087} {:answer/id #uuid "a40c3d37-1f3e-56af-9259-897cf2fc43fe" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{3}" :db/id #edb/ref 17592186337522}] :answer-field/correct {:answer/id #uuid "1dc7ed7d-8822-50d6-adbe-ad3f4f94cc16" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186336309} :answer-field/id #uuid "dfe47395-e6a4-5174-8bac-b9841d8af59f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186338671}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "7ca56a13-e2a8-587b-a791-0b4526ed9f52" :question/math-academy-id "q-7249" :question/problem "![](images/db/db4c6694a3bc172aea8a47f1a828eac8235286b7ce6b7e327574790a6c31c270.png)\n\nThe graph above shows $y=k{(\\frac{1}{3})}^{x}.$ What is the value of $k?$" :question/worked-solution "To plot the graph of $y=k{(\\frac{1}{3})}^{x}$ we take the graph of $y={(\\frac{1}{3})}^{x}$ and stretch it vertically by a scale factor of  $k.$ Under the action of this transformation, the $y$-intercept is mapped from $(0,1)$ to $(0,k).$\n\nComparing the point $(0,3)$ on the graph to $(0,k),$ we see that we must have $k=3.$"}] [{:db/id #edb/ref 17592186339129 :knowledge-point/_questions [{:db/id #edb/ref 17592186110599 :knowledge-point/id #uuid "29005c66-9f30-5862-926f-8a09320d404c" :knowledge-point/title "Determining Whether Two Lines in Slope-Intercept Form are Perpendicular"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ad7f19f7-5593-5372-821e-d1252d3b8446" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=x" :db/id #edb/ref 17592186337587} {:answer/id #uuid "c0e66778-1d33-59c9-9c63-84193616625d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=-2x-3" :db/id #edb/ref 17592186337745} {:answer/id #uuid "cf4a56a8-6d0c-5363-9d42-b65beb462d50" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=-\\frac{x}{2}x+5" :db/id #edb/ref 17592186337846} {:answer/id #uuid "cf58d7b6-9e04-5b2a-b15f-7c5224686dfe" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=-\\frac{x}{2}x-1" :db/id #edb/ref 17592186337847} {:answer/id #uuid "f9e1b841-fe74-5a6f-9da0-dd60389da801" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=2x+19" :db/id #edb/ref 17592186338222}] :answer-field/correct {:answer/id #uuid "f9e1b841-fe74-5a6f-9da0-dd60389da801" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=2x+19" :db/id #edb/ref 17592186338222} :answer-field/id #uuid "833a989b-8bb1-589d-92ce-6ba9062090a9" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186338511}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "cdd0bbdf-150a-52db-a038-e888ce1f0809" :question/math-academy-id "q-72524" :question/problem "Which of the following lines is perpendicular to $y=-\\frac{x}{2}+7?$" :question/worked-solution "For the two lines to be perpendicular, their slopes must multiply to $-1.$\n\nThe line $y=-\\frac{x}{2}+7$ is in slope-intercept form, and its slope is $-\\frac{1}{2}.$\n\nLooking at the answer choices, the line $y=2x+19$ has a slope of $2.$\n\nMultiplying the slopes together, we have\n\n$$\n-\\frac{1}{2}\\cdot 2=-1.\n$$\n\nSince the slopes multiply to $-1,$ we conclude that the line $y=2x+19$ is perpendicular to the given line."}] [{:db/id #edb/ref 17592186403592 :knowledge-point/_questions [{:db/id #edb/ref 17592186068900 :knowledge-point/id #uuid "66ade855-4b16-514b-b44a-1d6b9d61ef28" :knowledge-point/title "Identifying the Shift Applied to an Exponential Decay Curve"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "128902a2-01ba-574b-8cb8-9e24d91588d6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y={(\\frac{1}{2})}^{x}+3" :db/id #edb/ref 17592186403594} {:answer/id #uuid "d421b62c-91bc-51bd-9a1e-dcb674541fa2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y={(\\frac{1}{2})}^{x}" :db/id #edb/ref 17592186403595} {:answer/id #uuid "89b95e28-4bdc-577f-9fef-39eb015deed9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y={(\\frac{1}{2})}^{x}-1" :db/id #edb/ref 17592186403596} {:answer/id #uuid "1f9a6792-46dd-54a0-852a-c3ce900255d8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y={(\\frac{1}{2})}^{x}+1" :db/id #edb/ref 17592186403597} {:answer/id #uuid "cdf02042-68e8-57bc-821d-c4e709f6e6d5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y={(\\frac{1}{2})}^{x}+2" :db/id #edb/ref 17592186403598}] :answer-field/correct {:answer/id #uuid "1f9a6792-46dd-54a0-852a-c3ce900255d8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y={(\\frac{1}{2})}^{x}+1" :db/id #edb/ref 17592186403597} :answer-field/id #uuid "86226cb6-da89-5070-bdaf-be3482566831" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186403593}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "c80543b3-4997-5175-82f2-660b5af23e52" :question/math-academy-id "q-7253" :question/problem "![](images/50/50be1f4a894e86b5f06fba18655caca163c3d4c7a3423d2ecf159aa49975eb8c.png)\n\nThe graph above shows the curve $y={(\\frac{1}{2})}^{x}+c.$ Determine the value of $c$ and find the equation of the curve." :question/worked-solution "The horizontal asymptote of $y={(\\frac{1}{2})}^{x}$ is $y=0.$\n\nThe vertical translation $y={(\\frac{1}{2})}^{x}+c$ shifts the asymptote to $y=c.$\n\nIn the graph above, the horizontal asymptote is $y=1.$ Therefore, $c=1.$"}] [{:db/id #edb/ref 17592186341834 :knowledge-point/_questions [{:db/id #edb/ref 17592186175923 :knowledge-point/id #uuid "44b9b212-27c4-5d6d-a221-cd85c25fc956" :knowledge-point/title "Finding the Equation of a Line Perpendicular to a Line Through Two Points"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "460f3e7e-a692-5e84-84d3-bb04895e42c1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=2x+9" :db/id #edb/ref 17592186339750} {:answer/id #uuid "7de51bcc-dba4-5f66-9ed1-e89e2285349b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=x+3" :db/id #edb/ref 17592186340264} {:answer/id #uuid "a496b65e-0fa0-5379-bb60-a181cb54a9be" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=\\frac{1}{2}x+6" :db/id #edb/ref 17592186340623} {:answer/id #uuid "dc1a70a6-b427-555b-b378-aaf49435f770" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=x+7" :db/id #edb/ref 17592186341084} {:answer/id #uuid "f252e1db-2d4f-5cfe-b195-696e6f606c03" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=\\frac{1}{2}x-3" :db/id #edb/ref 17592186341262}] :answer-field/correct {:answer/id #uuid "a496b65e-0fa0-5379-bb60-a181cb54a9be" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=\\frac{1}{2}x+6" :db/id #edb/ref 17592186340623} :answer-field/id #uuid "f4e67ea3-0bdd-589c-834c-8bb372afcf1d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186341816}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "99fe5e6a-20b3-53d0-a013-c1c2c0d3ad0c" :question/math-academy-id "q-72568" :question/problem "Find the equation of the line that passes through the point $(-2,5)$ and is perpendicular to the line passing through the points $(6,1)$ and $(4,5).$" :question/worked-solution "Perpendicular lines have slopes which are negative reciprocals of each other.\n\nFirst, let's find the slope ${m}_{1}$ of the line passing through the points $(6,1)$ and $(4,5):$\n\n$$\n\\begin{aligned}{m}_{1} & =\\frac{{y}_{2}-{y}_{1}}{{x}_{2}-{x}_{1}} \\\\  & =\\frac{5-1}{4-6} \\\\  & =\\frac{4}{-2} \\\\  & =-2\\end{aligned}\n$$\n\nSince we want a perpendicular line, the slope $m$ of the line we're trying to find must satisfy\n\n$$\nm\\cdot (-2)=-1\\,⇒\\,m=\\frac{1}{2}.\n$$\n\nWe know that the line passes through the point $(-2,5).$ Using point-slope form and simplifying, we obtain the equation of the line:\n\n$$\n\\begin{aligned}y-{y}_{1} & =m(x-{x}_{1}) \\\\ y-5 & =\\frac{1}{2}(x-(-2)) \\\\ y-5 & =\\frac{1}{2}(x+2) \\\\ y-5 & =\\frac{1}{2}x+1 \\\\ y & =\\frac{1}{2}x+6\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186341836 :knowledge-point/_questions [{:db/id #edb/ref 17592186175924 :knowledge-point/id #uuid "c52fd5dd-780e-5dab-805f-561383873dd4" :knowledge-point/title "Finding the Equation of a Line Perpendicular to a Line in Standard Form"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3e1988b7-4bc8-5bda-86c5-639e0552dedd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2x-3y=7" :db/id #edb/ref 17592186339683} {:answer/id #uuid "51dac7ff-2d97-5661-b543-ad769758a707" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x+y=6" :db/id #edb/ref 17592186339880} {:answer/id #uuid "6d11b816-6f21-575c-a776-01785873cb84" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2x-3y=5" :db/id #edb/ref 17592186340089} {:answer/id #uuid "803a7a88-7553-50e1-862d-0b786cfc737c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2x+3y=13" :db/id #edb/ref 17592186340279} {:answer/id #uuid "af6755f9-b09b-562d-a589-5067ac2ec549" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2x+3y=7" :db/id #edb/ref 17592186340728}] :answer-field/correct {:answer/id #uuid "803a7a88-7553-50e1-862d-0b786cfc737c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2x+3y=13" :db/id #edb/ref 17592186340279} :answer-field/id #uuid "58e7ea68-a247-56ce-a08d-252af6a5df70" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186341536}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "ad191a02-5856-5306-8980-ab9514c55d3b" :question/math-academy-id "q-72571" :question/problem "Find the equation of the line that passes through the point $(5,1)$ and is perpendicular to the line passing through the points $(1,5)$ and $(-3,-1).$" :question/worked-solution "Perpendicular lines have slopes which are negative reciprocals of each other.\n\nFirst, let's find the slope ${m}_{1}$ of the line passing through the points $(1,5)$ and $(-3,-1):$\n\n$$\n\\begin{aligned}{m}_{1} & =\\frac{{y}_{2}-{y}_{1}}{{x}_{2}-{x}_{1}} \\\\  & =\\frac{-1-5}{-3-1} \\\\  & =\\frac{-6}{-4} \\\\  & =\\frac{3}{2}\\end{aligned}\n$$\n\nSince we want a perpendicular line, the slope $m$ of the line we're trying to find must satisfy\n\n$$\nm\\cdot (\\frac{3}{2})=-1\\,⇒\\,m=-\\frac{2}{3}.\n$$\n\nWe know that the line passes through the point $(5,1).$ Using point-slope form and simplifying, we obtain the equation of the line:\n\n$$\n\\begin{aligned}y-{y}_{1} & =m(x-{x}_{1}) \\\\ y-1 & =-\\frac{2}{3}(x-5) \\\\ y-1 & =-\\frac{2}{3}x+\\frac{10}{3} \\\\ y & =-\\frac{2}{3}x+\\frac{13}{3}\\end{aligned}\n$$\n\nHowever, we want to write the equation in standard form. So, we will bring the $x$ term to the left-hand side and multiply both sides of the equation by $3:$\n\n$$\n\\begin{aligned}y & =-\\frac{2}{3}x+\\frac{13}{3} \\\\ \\frac{2}{3}x+y & =\\frac{13}{3} \\\\ 3\\cdot (\\frac{2}{3}x+y) & =3\\cdot \\frac{13}{3} \\\\ 2x+3y & =13\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186341840 :knowledge-point/_questions [{:db/id #edb/ref 17592186068724 :knowledge-point/id #uuid "18ce1807-3a09-5ebd-b3cd-a91db8d2b4a8" :knowledge-point/title "Integrating a Rational Function Using Natural Logarithms"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "424f1750-2255-5cd3-97f1-bff8ae1f779e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2\\operatorname{ln}⁡|2-5{x}^{5}|+C" :db/id #edb/ref 17592186339710} {:answer/id #uuid "64a24bd8-02d1-5da1-875a-ff8313d79449" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2}{5(2-5{x}^{5})^{2}}+C" :db/id #edb/ref 17592186340018} {:answer/id #uuid "cd66158f-066f-573b-a023-86fcc42573cc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{5}{2(2-5{x}^{5})^{2}}+C" :db/id #edb/ref 17592186340950} {:answer/id #uuid "d40a6f74-0d5f-5192-b1f2-24adfd672a83" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5}{2}\\operatorname{ln}⁡|2-5{x}^{5}|+C" :db/id #edb/ref 17592186341003} {:answer/id #uuid "f1c87e78-2256-558f-a463-3af7ee7e05a4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{2}{5}\\operatorname{ln}⁡|2-5{x}^{5}|+C" :db/id #edb/ref 17592186341259}] :answer-field/correct {:answer/id #uuid "f1c87e78-2256-558f-a463-3af7ee7e05a4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{2}{5}\\operatorname{ln}⁡|2-5{x}^{5}|+C" :db/id #edb/ref 17592186341259} :answer-field/id #uuid "c4f33047-2f0b-50bf-84ac-e403b1fabf2c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186341723}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "958efc2b-d91b-53e5-b712-1690bc1b7068" :question/math-academy-id "q-72605" :question/problem "$\\int \\frac{10{x}^{4}}{2-5{x}^{5}}\\,\\text{d}x=$" :question/worked-solution "Let $u=2-5{x}^{5}.$ Then\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=-25{x}^{4}\\,⟹\\,(-\\frac{1}{25})\\text{d}u={x}^{4}\\,\\text{d}x,\n$$\n\nand we can solve the resulting integral as follows:\n\n$$\n\\begin{aligned}\\int \\frac{10{x}^{4}}{2-5{x}^{5}}\\,\\text{d}x & =10\\int \\frac{1}{2-5{x}^{5}}\\cdot {x}^{4}\\,\\text{d}x \\\\  & =10\\int \\frac{1}{u}\\cdot (-\\frac{1}{25})\\text{d}u \\\\  & =-\\frac{10}{25}\\int \\frac{1}{u}\\,\\text{d}u \\\\  & =-\\frac{2}{5}\\int \\frac{1}{u}\\,\\text{d}u \\\\  & =-\\frac{2}{5}\\operatorname{ln}⁡|u|+C \\\\  & =-\\frac{2}{5}\\operatorname{ln}⁡|2-5{x}^{5}|+C\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186341843 :knowledge-point/_questions [{:db/id #edb/ref 17592186087768 :knowledge-point/id #uuid "3520d323-c6a4-5bce-bac1-1f4c02bd0068" :knowledge-point/title "Finding the Equation of a Circle Given the Center and a Point on the Circle"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "44ceba2e-461c-5d6f-94d0-fffabcaa7f4e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(x-3)^{2}+(y-3)^{2}=\\sqrt{41}" :db/id #edb/ref 17592186339737} {:answer/id #uuid "67364410-21ff-5ab6-b499-984469e0f0b3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(x-3)^{2}+(y+3)^{2}=41" :db/id #edb/ref 17592186340042} {:answer/id #uuid "7e6b7a0c-3051-526a-9636-efd77cb0b591" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(x+3)^{2}+(y+3)^{2}=41" :db/id #edb/ref 17592186340268} {:answer/id #uuid "c00a31e7-30ad-5958-a723-a2568cb7ceb8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(x-3)^{2}+(y+3)^{2}=\\sqrt{41}" :db/id #edb/ref 17592186340844} {:answer/id #uuid "ccdecbe3-6add-5929-86dd-7b81307f2bae" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(x+3)^{2}+(y+3)^{2}=\\sqrt{41}" :db/id #edb/ref 17592186340941}] :answer-field/correct {:answer/id #uuid "67364410-21ff-5ab6-b499-984469e0f0b3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(x-3)^{2}+(y+3)^{2}=41" :db/id #edb/ref 17592186340042} :answer-field/id #uuid "59370454-96d7-5c69-8869-e408beefd110" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186341537}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "b538b794-53e2-55d6-941e-f772138f1dd6" :question/math-academy-id "q-72621" :question/problem "![](images/6e/6e68ede9db2528ea607fc6fd63f0ec4ca1c1378982239913ef49153e1cf5b609.png)\n\nThe circle above is centered at $C(3,-3)$ and the point $X(-1,2)$ lies on the circumference. Find the equation of the circle." :question/worked-solution "The general equation of a circle with radius $r$ centered at the point $(a,b)$ is\n\n$$\n(x-a)^{2}+(y-b)^{2}={r}^{2}.\n$$\n\nThe length of the radius is \n\n$$\n\\begin{aligned}CX & =\\sqrt{{(-1-3)}^{2}+{(2-(-3))}^{2}} \\\\  & =\\sqrt{(-4)^{2}+{5}^{2}} \\\\  & =\\sqrt{41}.\\end{aligned}\n$$\n\nSo, our circle is generated by the following equation:\n\n$$\n\\begin{aligned}(x-a)^{2}+(y-b)^{2} & ={r}^{2} \\\\ (x-3)^{2}+(y-(-3))^{2} & =(\\sqrt{41})^{2} \\\\ (x-3)^{2}+(y+3)^{2} & =41\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186341845 :knowledge-point/_questions [{:db/id #edb/ref 17592186059641 :knowledge-point/id #uuid "3332b534-bd04-5e86-995e-1e6d691d8e1b" :knowledge-point/title "Simplifying an Expression by Factoring and Using the Pythagorean Identity"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "733d9013-5828-5e8a-a6ca-98d0ee84db3d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2\\operatorname{sin}⁡x+\\operatorname{cos}⁡x" :db/id #edb/ref 17592186340151} {:answer/id #uuid "9e08cb06-fa94-559a-b45f-0247593ae993" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{sin}⁡x-\\operatorname{cos}⁡x" :db/id #edb/ref 17592186340553} {:answer/id #uuid "ce427bad-7fbf-553d-94e7-4eac1f2a458e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{sin}⁡x+3\\operatorname{cos}⁡x" :db/id #edb/ref 17592186340960} {:answer/id #uuid "d512d53f-d1ef-5fcf-a459-a5ecee4d6396" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{sin}⁡x+2\\operatorname{cos}⁡x" :db/id #edb/ref 17592186341012} {:answer/id #uuid "ddb559b7-bf25-5a4d-8461-b1784d7b4dd7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\operatorname{sin}⁡x+\\operatorname{cos}⁡x" :db/id #edb/ref 17592186341097}] :answer-field/correct {:answer/id #uuid "d512d53f-d1ef-5fcf-a459-a5ecee4d6396" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{sin}⁡x+2\\operatorname{cos}⁡x" :db/id #edb/ref 17592186341012} :answer-field/id #uuid "7c77d87a-34f1-5f64-8f04-06a22766d6be" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186341597}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "5b1e203a-fce6-56f0-bd3a-5a969f3f611d" :question/math-academy-id "q-72711" :question/problem "Simplify the trigonometric expression $\\operatorname{sin}⁡x+2{cos}^{3}⁡x+2{sin}^{2}⁡x\\operatorname{cos}⁡x.$" :question/worked-solution "First, we factor the expression:\n\n$$\n\\operatorname{sin}⁡x+2{cos}^{3}⁡x+2{sin}^{2}⁡x\\operatorname{cos}⁡x=\\operatorname{sin}⁡x+2\\operatorname{cos}⁡x({cos}^{2}⁡x+{sin}^{2}⁡x)\n$$\n\nThen, we use ${cos}^{2}⁡x+{sin}^{2}⁡x=1$ to simplify the expression in the parentheses:\n\n$$\n\\begin{aligned}\\operatorname{sin}⁡x+2\\operatorname{cos}⁡x({cos}^{2}⁡x+{sin}^{2}⁡x) & =\\operatorname{sin}⁡x+2\\operatorname{cos}⁡x\\cdot 1 \\\\  & =\\operatorname{sin}⁡x+2\\operatorname{cos}⁡x\\end{aligned}\n$$\n\nHence, we conclude that\n\n$$\n\\operatorname{sin}⁡x+2{cos}^{3}⁡x+2{sin}^{2}⁡x\\operatorname{cos}⁡x=\\operatorname{sin}⁡x+2\\operatorname{cos}⁡x.\n$$"}] [{:db/id #edb/ref 17592186341846 :knowledge-point/_questions [{:db/id #edb/ref 17592186059642 :knowledge-point/id #uuid "868125f0-22e0-57fc-9620-f3242419a689" :knowledge-point/title "Simplifying a Rational Expression Using the Pythagorean Identity"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "18d5cf9e-61a5-56dc-ab85-48cc3361b6cc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\operatorname{tan}⁡x+\\operatorname{sec}⁡x" :db/id #edb/ref 17592186339348} {:answer/id #uuid "2a4a8bfb-24ab-5d4f-85c0-b03c7be1078c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\operatorname{tan}⁡x" :db/id #edb/ref 17592186339502} {:answer/id #uuid "5af65e91-2dda-5a02-a6b9-84e591e12cdb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{tan}⁡x+1" :db/id #edb/ref 17592186339956} {:answer/id #uuid "94adee08-1ae4-5711-87c2-0b92afcedb4b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{tan}⁡x+\\operatorname{sec}⁡x" :db/id #edb/ref 17592186340463} {:answer/id #uuid "a2128603-79a4-5ac2-aad8-d0e79ce06174" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\operatorname{tan}⁡x-\\operatorname{sec}⁡x" :db/id #edb/ref 17592186340599}] :answer-field/correct {:answer/id #uuid "94adee08-1ae4-5711-87c2-0b92afcedb4b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{tan}⁡x+\\operatorname{sec}⁡x" :db/id #edb/ref 17592186340463} :answer-field/id #uuid "7ffbbed8-ad51-5238-b319-cf240d8126f8" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186341605}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "508dcfe6-ec7a-5fa0-ab23-63e62cd88ad5" :question/math-academy-id "q-72712" :question/problem "Simplify the trigonometric expression $\\frac{{sin}^{3}⁡x+\\operatorname{sin}⁡x{cos}^{2}⁡x+1}{\\operatorname{cos}⁡x}.$" :question/worked-solution "First, we factor $\\operatorname{sin}⁡x$ from the first two terms:\n\n$$\n\\frac{{sin}^{3}⁡x+\\operatorname{sin}⁡x{cos}^{2}⁡x+1}{\\operatorname{cos}⁡x}=\\frac{\\operatorname{sin}⁡x({sin}^{2}⁡x+{cos}^{2}⁡x)+1}{\\operatorname{cos}⁡x}\n$$\n\nNext, we use the Pythagorean identity to rewrite the expression in the parentheses, and then we simplify the resulting expression as much as possible:\n\n$$\n\\begin{aligned}\\frac{\\operatorname{sin}⁡x({sin}^{2}⁡x+{cos}^{2}⁡x)+1}{\\operatorname{cos}⁡x} & =\\frac{\\operatorname{sin}⁡x+1}{\\operatorname{cos}⁡x} \\\\  & =\\frac{\\operatorname{sin}⁡x}{\\operatorname{cos}⁡x}+\\frac{1}{\\operatorname{cos}⁡x} \\\\  & =\\operatorname{tan}⁡x+\\operatorname{sec}⁡x\\end{aligned}\n$$\n\nHence, we conclude that:\n\n$$\n\\frac{{sin}^{3}⁡x+\\operatorname{sin}⁡x{cos}^{2}⁡x+1}{\\operatorname{cos}⁡x}=\\operatorname{tan}⁡x+\\operatorname{sec}⁡x\n$$"}] [{:db/id #edb/ref 17592186341858 :knowledge-point/_questions [{:db/id #edb/ref 17592186105906 :knowledge-point/id #uuid "5dd3dcff-06d2-5d61-9863-0f5b541d8d4b" :knowledge-point/title "Finding the Area of a Triangle Given the Area of a Quadrilateral"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0f07a6b5-32ea-529d-9160-238820145dc6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "34{\\text{ cm}}^{2}" :db/id #edb/ref 17592186339267} {:answer/id #uuid "174b9032-2956-564a-826e-c2c81592003e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "23{\\text{ cm}}^{2}" :db/id #edb/ref 17592186339336} {:answer/id #uuid "508acfdf-0761-5691-be12-cc8ecd53beb4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "19{\\text{ cm}}^{2}" :db/id #edb/ref 17592186339862} {:answer/id #uuid "84059e1d-50ea-57c1-a02c-e73cba67744f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "13{\\text{ cm}}^{2}" :db/id #edb/ref 17592186340317} {:answer/id #uuid "f79db4a6-d5f5-5ae3-9697-f4ab3f3df76c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "25{\\text{ cm}}^{2}" :db/id #edb/ref 17592186341318}] :answer-field/correct {:answer/id #uuid "508acfdf-0761-5691-be12-cc8ecd53beb4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "19{\\text{ cm}}^{2}" :db/id #edb/ref 17592186339862} :answer-field/id #uuid "ea1b3e9c-7be4-50dc-84b7-55a05c94254f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186341796}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "d86eb6a4-4303-50bf-b47a-fa898e3f8037" :question/math-academy-id "q-72764" :question/problem "![](images/f5/f53996727138b9442ac041cf492618db8287b54ba652c4f9e375cdde27dc1862.png)\n\nThe area of $ABCD$ is $34{\\text{ cm}}^{2}.$   What is the area of $△BCD$ rounded to the nearest integer?" :question/worked-solution "Let's start by finding the area of $△ABD.$ We get \n\n$$\n\\begin{aligned}{A}_{△ABD} & =\\frac{1}{2}\\cdot AB\\cdot AD\\cdot \\operatorname{sin}⁡A \\\\  & =\\frac{1}{2}\\cdot 9\\cdot 15\\cdot \\operatorname{sin}⁡{52}^{∘} \\\\  & =67.5\\cdot \\operatorname{sin}⁡{52}^{∘} \\\\  & =53.190… \\\\  & ≈53{\\text{ cm}}^{2}\\end{aligned}\n$$\n\nrounded to the nearest integer.\n\nThe difference of the areas of $△ABD$ and the quadrilateral $ABCD$ gives the area of $△BCD.$ Therefore, \n\n$$\n\\begin{aligned}{A}_{△BCD} & ={A}_{△ABD}-{A}_{ABCD} \\\\  & =53-34 \\\\  & =19{\\text{ cm}}^{2}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186341859 :knowledge-point/_questions [{:db/id #edb/ref 17592186105905 :knowledge-point/id #uuid "3173d361-b91d-5699-97d8-6595ef59d0a3" :knowledge-point/title "Calculating the Area of a Quadrilateral"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4d011d15-855e-593b-a305-503c6f4d7b4a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "65" :db/id #edb/ref 17592186339829} {:answer/id #uuid "5049855a-0cf1-52ff-a6d7-82ad580a1998" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "135" :db/id #edb/ref 17592186339858} {:answer/id #uuid "65970e9b-6b55-55f9-87cb-642a2bfcf59a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "132" :db/id #edb/ref 17592186340026} {:answer/id #uuid "810e57dc-6211-51e2-9530-7c30c274a5a4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "98" :db/id #edb/ref 17592186340286} {:answer/id #uuid "941f7586-f901-520c-ba5a-d3f77fa4895c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "112" :db/id #edb/ref 17592186340460}] :answer-field/correct {:answer/id #uuid "5049855a-0cf1-52ff-a6d7-82ad580a1998" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "135" :db/id #edb/ref 17592186339858} :answer-field/id #uuid "59a7e60a-6a2a-50ed-b8ee-1ebc1c309e07" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186341540}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "c1e965d5-3d0b-5c28-9671-3eb1e1598d0f" :question/math-academy-id "q-72768" :question/problem "![](images/36/36af7324fd2112d94feddc5a1a02a91d97bbc0866cb93a6ca711dd73f566305a.png)\n\nFind, to the nearest integer, the area of the parallelogram $ABCD.$" :question/worked-solution "The diagonal $\\overset{―}{AC}$ divides the parallelogram into two congruent triangles. Therefore, the area of the parallelogram is twice the area of $△ACB$ (see the illustration below).\n\n![](images/7c/7cfcb5cdf77b4afbf25afd64e37bb33f0ab2c211e09659181bfc16db0ccd2db7.png)\n\n Computing the area of $△ACB,$ we find\n \n\n$$\n\\begin{aligned}{A}_{ACD} & =\\frac{1}{2}(18)(8)\\operatorname{sin}⁡{70}^{∘} \\\\  & =72\\cdot \\operatorname{sin}⁡{70}^{∘} \\\\  & ≈67.658,\\end{aligned}\n$$\n\nrounded to three decimal places. Consequently,\n\n$$\n\\begin{aligned}{A}_{ABCD} & =2{A}_{ACB} \\\\  & =2\\cdot 67.658 \\\\  & =135.316.\\end{aligned}\n$$\n\nSo, to the nearest integer, the area of the parallelogram is $135.$"}] [{:db/id #edb/ref 17592186341864 :knowledge-point/_questions [{:db/id #edb/ref 17592186092167 :knowledge-point/id #uuid "d8c7ab50-5a8b-5bcd-8483-cec8bf6bd3ce" :knowledge-point/title "Solving a Trigonometric Equation Involving Tangent with Non-Special Angles"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0ad93dd9-f865-5592-811e-14f384c64bbf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8.2" :db/id #edb/ref 17592186339219} {:answer/id #uuid "31074855-d3da-586d-8c04-526c3ec62d18" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "7.8" :db/id #edb/ref 17592186339558} {:answer/id #uuid "3342aa60-3377-5de6-abd0-ce1b0d538d0f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8.4" :db/id #edb/ref 17592186339583} {:answer/id #uuid "86a98dfc-6975-5761-a79b-d41b66fce8b9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.8" :db/id #edb/ref 17592186340339} {:answer/id #uuid "a3814b4e-90bf-5084-b757-74d52e377f50" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8.0" :db/id #edb/ref 17592186340610}] :answer-field/correct {:answer/id #uuid "0ad93dd9-f865-5592-811e-14f384c64bbf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8.2" :db/id #edb/ref 17592186339219} :answer-field/id #uuid "c29068c9-aa1b-5e85-b568-8a54965ad3b8" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186341718}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "5bb6f7b5-fd38-5f44-84f6-733c5b1973e6" :question/math-academy-id "q-72824" :question/problem "Given that ${x}_{1}$ and ${x}_{2}$ are the solutions to the equation $\\operatorname{tan}⁡x=-8$ for $0\\le x<2\\pi ,$ what is the value of ${x}_{1}\\cdot {x}_{2},$ rounded to one decimal place?" :question/worked-solution "First, we find the principal value:\n\n$$\nx=\\operatorname{arctan}⁡(-8)=-1.446\\,4…≈-1.446\\,4.\n$$\n\nSince $-1.446\\,4$ lies outside the given domain, it is not a solution.\n\nTo generate more solutions, we add integer multiples of $\\pi .$ Hence,\n\n$$\n\\begin{aligned}{x}_{1} & =\\pi -1.446\\,4≈1.695\\,2, \\\\ {x}_{2} & =2\\pi -1.446\\,4≈4.836\\,8.\\end{aligned}\n$$\n\nFinally, \n\n$$\n{x}_{1}\\cdot {x}_{2}≈1.695\\,2\\cdot 4.836\\,8≈8.2\n$$\n\nrounded to one decimal place."}] [{:db/id #edb/ref 17592186341870 :knowledge-point/_questions [{:db/id #edb/ref 17592186092171 :knowledge-point/id #uuid "5f607558-5a7f-52df-b344-57f2f84791e9" :knowledge-point/title "Solving a Trigonometric Equation Involving Cosine with Non-Special Angles"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "416a58ae-ce76-5e02-96f0-d7597149753a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5.5" :db/id #edb/ref 17592186339708} {:answer/id #uuid "6db8cad2-a957-58f3-ad26-db45b399e754" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4.8" :db/id #edb/ref 17592186340098} {:answer/id #uuid "a1cd8970-9cb3-5318-9504-b8c8a617dc91" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6.1" :db/id #edb/ref 17592186340596} {:answer/id #uuid "b6c00063-961c-57de-9996-aa7c34c1b08f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4.9" :db/id #edb/ref 17592186340780} {:answer/id #uuid "ff350533-a65b-5d8c-9636-be091780422d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5.1" :db/id #edb/ref 17592186341376}] :answer-field/correct {:answer/id #uuid "ff350533-a65b-5d8c-9636-be091780422d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5.1" :db/id #edb/ref 17592186341376} :answer-field/id #uuid "90108bbe-e3f9-552f-9a17-4a20b275ed27" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186341634}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "40af3b43-8968-5b55-af69-0a7608e19327" :question/math-academy-id "q-72838" :question/problem "Given that ${x}_{1}$ and ${x}_{2}$ are the solutions to the equation $\\operatorname{cos}⁡x=\\frac{4}{7}$ for $0\\le x<2\\pi ,$ what is the value of ${x}_{1}\\cdot {x}_{2},$ rounded to one decimal place?" :question/worked-solution "First, we find the principal value:\n\n$$\n\\begin{aligned}x=\\operatorname{arccos}⁡(\\frac{4}{7})=0.962\\,550…≈0.962\\,6\\end{aligned}\n$$\n\nSince $0.962\\,6$ lies inside the specified domain, our first solution is ${x}_{1}=0.962\\,6.$\n\nOur first solution lies in the first quadrant and has a reference angle of ${\\theta }_{R}=0.962\\,6.$ Since $\\operatorname{cos}⁡x>0,$ the second solution must lie in the fourth quadrant, and it also has a reference angle ${\\theta }_{R}=0.962\\,6.$\n\n![](images/b2/b2cd7e76526632d8507ba484246a560829882e7f10d9814f01593f7a48d9a2ac.png)\n\nSince the second solution ${x}_{2}$ lies in the $4$th quadrant, we can find it using the reference angle as follows:\n\n$$\n\\begin{aligned}{x}_{2} & =2\\pi -{\\theta }_{R} \\\\  & =2\\pi -0.962\\,6 \\\\  & =5.320\\,6\\end{aligned}\n$$\n\nFinally,\n\n$$\n{x}_{1}{x}_{2}≈0.962\\,6\\cdot 5.320\\,6≈5.1\n$$\n\nrounded to one decimal place."}] [{:db/id #edb/ref 17592186341876 :knowledge-point/_questions [{:db/id #edb/ref 17592186092164 :knowledge-point/id #uuid "e9f482ac-9771-52a3-9517-8494c3de6379" :knowledge-point/title "Solving a Trigonometric Equation Involving Cosine with Quadrantal Angles"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "48a7f416-9ccc-595c-937e-87b4c13463c5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x={30}^{∘},\\,{210}^{∘}" :db/id #edb/ref 17592186339775} {:answer/id #uuid "6d4e1aa1-9741-5265-a620-2ea9b913f9f4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x={0}^{∘}" :db/id #edb/ref 17592186340094} {:answer/id #uuid "aebf971f-72a5-59d6-b10a-ed17ef40c94d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x={180}^{∘}" :db/id #edb/ref 17592186340722} {:answer/id #uuid "d9cf140c-f381-5614-bcb7-c52362b8a27c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x={60}^{∘},\\,{240}^{∘}" :db/id #edb/ref 17592186341061} {:answer/id #uuid "e6edd2e5-fda5-5b71-a1c5-87184ab67800" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x={90}^{∘}" :db/id #edb/ref 17592186341170}] :answer-field/correct {:answer/id #uuid "aebf971f-72a5-59d6-b10a-ed17ef40c94d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x={180}^{∘}" :db/id #edb/ref 17592186340722} :answer-field/id #uuid "ce966d3f-597e-52d1-908c-5971b6d20f49" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186341742}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "3dee65bc-3bdf-57d3-9d7b-8a1802789c99" :question/math-academy-id "q-72845" :question/problem "Find the solution(s) to the equation $\\frac{\\operatorname{cos}⁡x+3}{2}=1$ for ${0}^{∘}\\le x<{360}^{∘}.$" :question/worked-solution "First, we rearrange the equation, isolating $\\operatorname{cos}⁡x:$\n\n$$\n\\begin{aligned}\\frac{\\operatorname{cos}⁡x+3}{2} & =1 \\\\ \\operatorname{cos}⁡x+3 & =2 \\\\ \\operatorname{cos}⁡x & =-1\\end{aligned}\n$$\n\nNotice that the solutions to $\\operatorname{cos}⁡x=1$ correspond to the values of $x$ at which $\\operatorname{cos}⁡x$ attains its minimum value.\n\nNow, we find the principal value:\n\n$$\n\\begin{aligned}x=\\operatorname{arccos}⁡(-1)={180}^{∘}\\end{aligned}\n$$\n\nSince ${180}^{∘}$ lies inside the required domain, our first solution is ${x}_{1}={180}^{∘}.$\n\nThis solution is a quadrantal angle. To find the remaining solutions, we use our knowledge of the cosine function. We know that the cosine function has its minimum values at\n\n$$\nx={180}^{∘}+{360}^{∘}\\cdot n.\n$$\n\nSince the domain ${0}^{∘}\\le x<{360}^{∘}$ is one period, and we have already found one minimum value in this period, we conclude that $x={180}^{∘}$ is the only solution."}] [{:db/id #edb/ref 17592186341886 :knowledge-point/_questions [{:db/id #edb/ref 17592186087724 :knowledge-point/id #uuid "6381faa4-5dfd-58fa-ace7-411fd2a97e98" :knowledge-point/title "Calculating the x-Intercepts of an Ellipse By Completing the Square"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5bedf0ef-d091-529c-9452-055d4df48089" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(2\\pm \\sqrt{3},0)" :db/id #edb/ref 17592186339962} {:answer/id #uuid "7b290d59-ce77-5ad9-b904-8c21b160ec07" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-3\\pm \\sqrt{2},0)" :db/id #edb/ref 17592186340231} {:answer/id #uuid "907bfe3d-4729-5dfa-8728-e4a9413ce8e3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-2\\pm \\sqrt{3},0)" :db/id #edb/ref 17592186340423} {:answer/id #uuid "d409ed3f-53f8-5d27-b84d-7ce80fe544a8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(5,0)" :db/id #edb/ref 17592186341002} {:answer/id #uuid "ea330265-17ea-5ce6-9db7-de0ab2bee739" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "There is no $x$-intercept" :db/id #edb/ref 17592186341195}] :answer-field/correct {:answer/id #uuid "5bedf0ef-d091-529c-9452-055d4df48089" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(2\\pm \\sqrt{3},0)" :db/id #edb/ref 17592186339962} :answer-field/id #uuid "98d12b9f-78ac-5e61-9bc9-9638586d0302" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186341648}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "0e89bb93-f1e6-5d54-9eb6-f01d87f935ca" :question/math-academy-id "q-72914" :question/problem "Calculate the points where the ellipse ${x}^{2}+{y}^{2}-4x-2y+1=0$ intercepts the $x$-axis." :question/worked-solution "To calculate the $x$-intercepts, we need to substitute $y=0$ into the equation of the ellipse and solve the resulting equation for $x.$ We do this and solve the resulting equation by completing the square:\n\n$$\n\\begin{aligned}{x}^{2}+{y}^{2}-4x-2y+1 & =0 \\\\ {x}^{2}+{0}^{2}-4x-2(0)+1 & =0 \\\\ {x}^{2}-4x+1 & =0 \\\\ (x-2)^{2}-4+1 & =0 \\\\ (x-2)^{2} & =3 \\\\ x-2 & =\\pm \\sqrt{3} \\\\ x & =2\\pm \\sqrt{3}\\end{aligned}\n$$\n\nTherefore, the ellipse intercepts the $x$-axis at $(2-\\sqrt{3},0)$ and $(2+\\sqrt{3},0).$"}] [{:db/id #edb/ref 17592186341896 :knowledge-point/_questions [{:db/id #edb/ref 17592186096804 :knowledge-point/id #uuid "0a16e7b6-2a09-5aeb-9a8b-ea8fb1d59807" :knowledge-point/title "Calculating the Derivative of a Function From Its Graph"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "062499b4-be47-5b28-982d-86c642bba935" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186339180} {:answer/id #uuid "0c2e9142-707f-5bcc-a580-ee524bee6fdb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{4}{3}" :db/id #edb/ref 17592186339234} {:answer/id #uuid "359a8a35-2225-5f23-8b9d-aae7b68bb0a4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{2}" :db/id #edb/ref 17592186339604} {:answer/id #uuid "96928fb6-9fc9-5f9b-b89c-531b735c25b5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{2}{3}" :db/id #edb/ref 17592186340487} {:answer/id #uuid "c6587bc5-7cad-5be9-a21b-564e512cd0a5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{3}" :db/id #edb/ref 17592186340885}] :answer-field/correct {:answer/id #uuid "96928fb6-9fc9-5f9b-b89c-531b735c25b5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{2}{3}" :db/id #edb/ref 17592186340487} :answer-field/id #uuid "4f07086c-8b55-5351-9a76-5d3e1c547bcf" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186341518}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "241c4369-248c-546e-84df-6e2b47d7a0e2" :question/math-academy-id "q-72998" :question/problem "![](images/6d/6d5146afb9508532145180a4f632c0b5c4495487b0a9a89cfd4f71e134b95f50.png)\n\nThe graph of the function $y=f(x)$ is given above. Find ${f}^{′}(-1.5).$" :question/worked-solution "To compute ${f}^{′}(-1.5),$ we need to find the slope of the tangent to $f(x)$ at $x=-1.5.$\n\nLet's consider the graph of $y=f(x)$ on $[-2,1].$ Notice that $x=-1.5$ lies in this interval.\n\n![](images/22/2216d3014a8c74102d5e298c300092a575798de0b66d89914716898bc16ac655.png)\n\nThe slope of $y=f(x)$ on $x\\in (-2,1)$ is constant and equals\n\n$$\n\\begin{aligned}\\frac{Δf}{Δx} & =\\frac{0-2}{1-(-2)}=-\\frac{2}{3}.\\end{aligned}\n$$\n\nTherefore, ${f}^{′}(-1.5)=-\\frac{2}{3}.$"}] [{:db/id #edb/ref 17592186234328 :knowledge-point/_questions [{:db/id #edb/ref 17592186179659 :knowledge-point/id #uuid "44e3a595-a9ae-5d8c-9aa5-c8e3403fcb28" :knowledge-point/title "Simplifying a Variable Expression Containing a Quotient of Factorials"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2ae24c67-169d-568f-9906-74f5b3cc2e0b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "n(n+1)" :db/id #edb/ref 17592186339505} {:answer/id #uuid "35c068a3-dbe1-516f-a719-8c52f792f017" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{n}^{2}(n+1)" :db/id #edb/ref 17592186339606} {:answer/id #uuid "4cc01694-bcd6-5105-860b-e7ae3171d223" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "n(n-2)" :db/id #edb/ref 17592186339824} {:answer/id #uuid "9d31eea3-a5b0-5f91-81ac-06d7e2e82a81" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(n-1)(n+1)" :db/id #edb/ref 17592186340545} {:answer/id #uuid "cb8da782-b040-553f-a209-d1c9c3875b8e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "n(n-1)" :db/id #edb/ref 17592186340932}] :answer-field/correct {:answer/id #uuid "2ae24c67-169d-568f-9906-74f5b3cc2e0b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "n(n+1)" :db/id #edb/ref 17592186339505} :answer-field/id #uuid "20784676-1346-5beb-bf37-2d8560fbcb5c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186341437}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "81d120ad-3169-5d64-9a97-a76dfeab46ec" :question/math-academy-id "q-73023" :question/problem "Given that $n\\ge 1$ is an integer, simplify $\\frac{(n+1)!}{(n-1)!}.$" :question/worked-solution "First, notice the following:\n\n$$\n(n+1)!=(n+1)\\cdot n\\cdot (n-1)!\n$$\n\nThen, we cancel the $(n-1)!$ that occurs in both the numerator and the denominator:\n\n$$\n\\begin{aligned}\\frac{(n+1)!}{(n-1)!} & =\\frac{(n+1)\\cdot n\\cdot (n-1)!}{(n-1)!} \\\\  & =\\frac{(n+1)\\cdot n\\cdot \\cancel{(n-1)!}}{\\cancel{(n-1)!}} \\\\  & =n(n+1)\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186234331 :knowledge-point/_questions [{:db/id #edb/ref 17592186179659 :knowledge-point/id #uuid "44e3a595-a9ae-5d8c-9aa5-c8e3403fcb28" :knowledge-point/title "Simplifying a Variable Expression Containing a Quotient of Factorials"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "29487ed3-a525-52dd-9167-d626037dc815" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{n+2}" :db/id #edb/ref 17592186339491} {:answer/id #uuid "7f774ed2-5f28-52ae-865d-32a61cabb3ca" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{n+1}" :db/id #edb/ref 17592186340273} {:answer/id #uuid "9c213996-40cb-543e-9a55-403ef758636c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "n+2" :db/id #edb/ref 17592186340533} {:answer/id #uuid "9d2f4e0c-cc16-5245-84c3-7f919dd4a20d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{{n}^{2}+n}" :db/id #edb/ref 17592186340543} {:answer/id #uuid "dca1f91a-c517-5f9d-abf6-091011b8edcd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "n+1" :db/id #edb/ref 17592186341087}] :answer-field/correct {:answer/id #uuid "29487ed3-a525-52dd-9167-d626037dc815" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{n+2}" :db/id #edb/ref 17592186339491} :answer-field/id #uuid "247d41fd-6e73-5f0c-95b3-a198cf2975b2" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186341444}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "72330c15-2550-5193-88bf-8afccb0b16d4" :question/math-academy-id "q-73028" :question/problem "Given that $n\\ge -1$ is an integer, simplify $\\frac{(n+1)!}{(n+2)!}.$" :question/worked-solution "First, notice the following:\n\n$$\n(n+2)!=(n+2)\\cdot (n+1)!\n$$\n\nThen, we cancel the $(n+1)!$ that occurs in both the numerator and the denominator:\n\n$$\n\\begin{aligned}\\frac{(n+1)!}{(n+2)!} & =\\frac{(n+1)!}{(n+2)\\cdot (n+1)!} \\\\  & =\\frac{\\cancel{(n+1)!}}{(n+2)\\cdot \\cancel{(n+1)!}} \\\\  & =\\frac{1}{n+2}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186341899 :knowledge-point/_questions [{:db/id #edb/ref 17592186119957 :knowledge-point/id #uuid "68ba4c5d-8b91-57bc-b98b-0e9f8d8f1f67" :knowledge-point/title "Determining the Vertical Asymptotes for the Sum of Two Rational Functions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "52a883e7-4d2a-532d-9bbd-dce6962edcc3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=-1" :db/id #edb/ref 17592186339890} {:answer/id #uuid "5a4e1d9b-7c6a-5c7d-b288-86ddd171b3c1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$x=1$, $x=-1$" :db/id #edb/ref 17592186339949} {:answer/id #uuid "89cc96ba-2754-55f6-8b86-473c4e42f001" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$x=\\frac{1}{2}$, $x=1$" :db/id #edb/ref 17592186340358} {:answer/id #uuid "8f1ac77d-4b8a-5f0e-932d-f01c276b93ed" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=2" :db/id #edb/ref 17592186340415} {:answer/id #uuid "a9c87c4a-a6d6-5db3-8002-3e4994f240d6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=0" :db/id #edb/ref 17592186340674}] :answer-field/correct {:answer/id #uuid "52a883e7-4d2a-532d-9bbd-dce6962edcc3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=-1" :db/id #edb/ref 17592186339890} :answer-field/id #uuid "929e3387-fa4c-54fe-ab80-91ba52610238" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186341637}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "d13dc12b-246a-57c9-9dc3-693e68fcfaf7" :question/math-academy-id "q-73031" :question/problem "Find the vertical asymptotes of $f(x)=\\frac{1}{x-1}+\\frac{1}{x+1}.$" :question/worked-solution "First, let's put the two terms over a common denominator:\n\n$$\n\\begin{aligned}\\frac{1}{x-1}+\\frac{1}{x+1} & =\\frac{x+1+(x-1)}{(x-1)(x+1)}=\\frac{2x}{(x-1)(x+1)}\\end{aligned}\n$$\n\nThere are no common factors in the numerator and denominator, so we proceed to set the denominator equal to zero and get\n\n$$\n(x-1)(x+1)=0\\,⟹\\,x=1\\,,\\,x=-1.\n$$\n\nTherefore, the vertical asymptotes are at $x=1$ and $x=-1.$"}] [{:db/id #edb/ref 17592186234332 :knowledge-point/_questions [{:db/id #edb/ref 17592186179660 :knowledge-point/id #uuid "644b7f09-7f66-50f2-8eba-ef6e009429d0" :knowledge-point/title "Simplifying a Variable Expression Containing a Quotient With Many Factorials"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "04802008-4ed6-5b73-83f5-d29dc06587f8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "k+1" :db/id #edb/ref 17592186339160} {:answer/id #uuid "1ba86355-0ac6-5962-ae05-e44d9250bd1a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{k}^{2}+k" :db/id #edb/ref 17592186339366} {:answer/id #uuid "af54b886-24b1-56d3-9d8e-4c71dd5f011f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{k+2}" :db/id #edb/ref 17592186340727} {:answer/id #uuid "f4bcde05-f467-51e7-b960-da690faabda6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{k}{k+2}" :db/id #edb/ref 17592186341287} {:answer/id #uuid "f7792b0b-5d92-53fc-957c-3f59a201b930" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{{k}^{2}+2k}" :db/id #edb/ref 17592186341316}] :answer-field/correct {:answer/id #uuid "af54b886-24b1-56d3-9d8e-4c71dd5f011f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{k+2}" :db/id #edb/ref 17592186340727} :answer-field/id #uuid "e83b7853-94c1-56fb-bb60-7f7706a1acaa" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186341792}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "4c27af90-5244-552c-a6c5-2d976ec6599f" :question/math-academy-id "q-73037" :question/problem "Given that $k\\ge -1$ is an integer, $\\frac{(k+2)((k+1)!)^{2}}{((k+2)!)^{2}}=$" :question/worked-solution "First, we notice that\n\n$$\n(k+2)!=(k+2)(k+1)!\n$$\n\nThen, we can cancel the $k!$ that occurs in both the numerator and the denominator:\n\n$$\n\\begin{aligned}\\frac{(k+2)((k+1)!)^{2}}{((k+2)!)^{2}} & =\\frac{(k+2)\\cdot (k+1)!\\cdot (k+1)!}{(k+2)!\\cdot (k+2)!} \\\\  & =\\frac{(k+2)\\cdot (k+1)!\\cdot (k+1)!}{(k+2)\\cdot (k+1)!\\cdot (k+2)\\cdot (k+1)!} \\\\  & =\\frac{\\cancel{(k+2)}\\cdot \\cancel{(k+1)!}\\cdot \\cancel{(k+1)!}}{(k+2)\\cdot \\cancel{(k+1)!}\\cdot \\cancel{(k+2)}\\cdot \\cancel{(k+1)!}} \\\\  & =\\frac{1}{k+2}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186341901 :knowledge-point/_questions [{:db/id #edb/ref 17592186059671 :knowledge-point/id #uuid "143766e0-0ef5-5caf-b699-d394d4a707e9" :knowledge-point/title "Using the Double-Angle Formula to Simplify Products"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1d39e1d2-809f-5155-a07c-2be82fe6f5c9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{tan}⁡(\\frac{3\\pi }{7})" :db/id #edb/ref 17592186339382} {:answer/id #uuid "40729786-50b6-5ff5-b256-a96bf88930f0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{cos}⁡(\\frac{6\\pi }{7})" :db/id #edb/ref 17592186339704} {:answer/id #uuid "ab3fcfc4-5970-535a-9851-ae25c946b062" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{sin}⁡(\\frac{3\\pi }{14})" :db/id #edb/ref 17592186340688} {:answer/id #uuid "dc526537-6440-5beb-89ba-a669341bd361" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{sin}⁡(\\frac{6\\pi }{7})" :db/id #edb/ref 17592186341086} {:answer/id #uuid "f54d10f1-3bdb-508e-83f2-6340ec8fe28b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\operatorname{sin}⁡(\\frac{3\\pi }{7})" :db/id #edb/ref 17592186341292}] :answer-field/correct {:answer/id #uuid "dc526537-6440-5beb-89ba-a669341bd361" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{sin}⁡(\\frac{6\\pi }{7})" :db/id #edb/ref 17592186341086} :answer-field/id #uuid "6bdfe7ee-6a1b-5a6c-8716-9c970e741c65" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186341565}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "188c3216-6730-58aa-bfa7-8985bab845cd" :question/math-academy-id "q-7305" :question/problem "Express $2\\operatorname{sin}⁡(\\frac{3\\pi }{7})\\operatorname{cos}⁡(\\frac{3\\pi }{7})$ as a single trigonometric ratio." :question/worked-solution "First, let's recall the double-angle formula for sine: \n\n$$\n2\\operatorname{sin}⁡x\\operatorname{cos}⁡x=\\operatorname{sin}⁡2x\n$$\n\nSubstituting $x=\\frac{3\\pi }{7}$ into the above, we get\n\n$$\n\\begin{aligned}2\\operatorname{sin}⁡(\\frac{3\\pi }{7})\\operatorname{cos}⁡(\\frac{3\\pi }{7}) & =\\operatorname{sin}⁡(2\\cdot \\frac{3\\pi }{7})=\\operatorname{sin}⁡(\\frac{6\\pi }{7}).\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186341908 :knowledge-point/_questions [{:db/id #edb/ref 17592186068700 :knowledge-point/id #uuid "81247553-750f-5bf7-a1c4-698ad63b5ae4" :knowledge-point/title "Identifying True Statements Regarding Left- and Right-Continuity"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "33ab5c9a-741e-507f-8a99-07a9f7aa451c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186339588} {:answer/id #uuid "3bf55990-23dc-5693-8dde-0dd252a432b1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I, II and III" :db/id #edb/ref 17592186339663} {:answer/id #uuid "48fe273f-13eb-5f78-8272-5b9b3a2db061" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "None" :db/id #edb/ref 17592186339782} {:answer/id #uuid "4a2895ac-425c-5001-bb2a-284e8601acaf" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186339796} {:answer/id #uuid "ea2ab1df-0cb6-5919-a2be-e9cca71bcc58" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186341194}] :answer-field/correct {:answer/id #uuid "4a2895ac-425c-5001-bb2a-284e8601acaf" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186339796} :answer-field/id #uuid "bf84d3cb-0dfa-513a-bcdd-3183ad8dee6c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186341710}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "79464211-37d1-5cac-b164-284bb9d9308a" :question/math-academy-id "q-73105" :question/problem "![](images/ad/ad3fb8a0cce2a6dac706d7876aca0a2339fe49c05cb7aa6ae54de86735ceafab.png)\n\nWhich of the following statements are true regarding the function $y=f(x)$ plotted above?\n\n- The function is left-continuous at $x=3$\n- The function is right-continuous at $x=3$\n- The function is continuous at $x=3$" :question/worked-solution "Let's look at each statement in turn:\n\n- Statement I is false. The function is not left-continuous at $x=3,$ since the left-sided limit is not equal to the function value:\n\n$$\n{lim}_{x\\to {3}^{-}}f(x)=3\\ne 1=f(3)\n$$\n\n- Statement II is true. The function is right-continuous at $x=3,$ since the right-sided limit is equal to the function value:\n\n$$\n{lim}_{x\\to {3}^{+}}f(x)=1=f(3)\n$$\n\n- Statement III is false. In order for the function to be continuous at $x=3,$ it must be both left-continuous and right-continuous. However, we have already determined that the function is not left-continuous at this point.\n\nIn conclusion, only statement II is true."}] [{:db/id #edb/ref 17592186393250 :knowledge-point/_questions [{:db/id #edb/ref 17592186096631 :knowledge-point/id #uuid "cdc82e49-5df6-5096-a8fd-e00017fb1e3a" :knowledge-point/title "Expressing a Definite Integral as the Limit of a Left Riemann Sum"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ce3626c4-68fc-5111-92bb-c6a72ef04b3f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{lim}_{n\\to \\infty }{\\sum }_{i=0}^{n-1}[ln⁡(e+\\frac{4ie}{n})\\cdot \\frac{4e}{n}]" :db/id #edb/ref 17592186393252} {:answer/id #uuid "51976397-23e1-57d8-a039-644bf6317f62" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{lim}_{n\\to \\infty }{\\sum }_{i=0}^{n-1}[{e}^{(-2i/n)}\\cdot \\frac{1}{n}]" :db/id #edb/ref 17592186393253} {:answer/id #uuid "9d2df163-f8cb-55a5-aa92-94fe12f6f8d2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{lim}_{n\\to \\infty }{\\sum }_{i=0}^{n-1}[ln⁡(e+\\frac{2ie}{n})\\cdot \\frac{2e}{n}]" :db/id #edb/ref 17592186393254} {:answer/id #uuid "680c2096-a3a6-56c7-af41-ad8e3a2a9b3e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{lim}_{n\\to \\infty }{\\sum }_{i=0}^{n-1}[{e}^{(2i/n)}\\cdot \\frac{2}{n}]" :db/id #edb/ref 17592186393255} {:answer/id #uuid "7e48b7d1-54ea-5e38-b291-212dbf407565" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{lim}_{n\\to \\infty }{\\sum }_{i=0}^{n-1}[ln⁡(e+\\frac{ie}{n})\\cdot \\frac{e}{n}]" :db/id #edb/ref 17592186393256}] :answer-field/correct {:answer/id #uuid "9d2df163-f8cb-55a5-aa92-94fe12f6f8d2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{lim}_{n\\to \\infty }{\\sum }_{i=0}^{n-1}[ln⁡(e+\\frac{2ie}{n})\\cdot \\frac{2e}{n}]" :db/id #edb/ref 17592186393254} :answer-field/id #uuid "ae6ae5ee-b93f-55d8-b530-ad34a29b014a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186393251}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "d2f3eda7-3ae2-5c51-adcd-171934d8313e" :question/math-academy-id "q-73156" :question/problem "What is ${\\int }_{e}^{3e}ln⁡x\\,\\text{d}x$ expressed as the limit of a left Riemann sum?" :question/worked-solution "The definite integral can be defined in terms of the limit of a left Riemann sum as\n\n$$\n{\\int }_{a}^{b}f(x)\\text{d}x={lim}_{n\\to \\infty }{\\sum }_{i=0}^{n-1}f({x}_{i})\\cdot Δx,\n$$\n\n    \n\nwhere $Δx=\\frac{b-a}{n}$ and ${x}_{i}=a+iΔx.$\n\nIn the definite integral\n\n$$\n{\\int }_{e}^{3e}ln⁡x\\,\\text{d}x,\n$$\n\nthe function is $f(x)=ln⁡x,$ the lower bound is $a=e,$ and the upper bound is $b=3e.$ So, we have\n\n$$\nΔx=\\frac{3e-e}{n}=\\frac{2e}{n},\n$$\n\nand therefore\n\n$$\n\\begin{aligned}{\\int }_{e}^{3e}ln⁡x\\,\\text{d}x & ={lim}_{n\\to \\infty }{\\sum }_{i=0}^{n-1}f({x}_{i})\\cdot Δx \\\\  & ={lim}_{n\\to \\infty }{\\sum }_{i=0}^{n-1}[f(e+i\\cdot \\frac{2e}{n})\\cdot \\frac{2e}{n}] \\\\  & ={lim}_{n\\to \\infty }{\\sum }_{i=0}^{n-1}[f(e+\\frac{2ie}{n})\\cdot \\frac{2e}{n}] \\\\  & ={lim}_{n\\to \\infty }{\\sum }_{i=0}^{n-1}[ln⁡(e+\\frac{2ie}{n})\\cdot \\frac{2e}{n}].\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186393264 :knowledge-point/_questions [{:db/id #edb/ref 17592186096633 :knowledge-point/id #uuid "29b136d3-69bc-51ef-a262-dbee8af377d2" :knowledge-point/title "Expressing a Definite Integral as the Limit of a Right Riemann Sum"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "516433a3-ddcf-5286-911f-d1661221641b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{lim}_{n\\to \\infty }{\\sum }_{k=1}^{n}[-2{(\\frac{5k}{n})}^{-2}\\cdot \\frac{5}{n}]" :db/id #edb/ref 17592186393266} {:answer/id #uuid "91a60e1f-ff52-5d12-8845-6de6b6f23736" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{lim}_{n\\to \\infty }{\\sum }_{k=1}^{n}[-2{(-2+\\frac{5k}{n})}^{3}\\cdot \\frac{5}{n}]" :db/id #edb/ref 17592186393267} {:answer/id #uuid "6006a006-5f33-5ef4-b609-573993a53f00" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{lim}_{n\\to \\infty }{\\sum }_{k=1}^{n}[-2{(2+\\frac{k}{n})}^{3}\\cdot \\frac{1}{n}]" :db/id #edb/ref 17592186393268} {:answer/id #uuid "8ff05667-12f6-5f44-9206-bc6cf51be751" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{lim}_{n\\to \\infty }{\\sum }_{k=1}^{n}[-{(-1+\\frac{5k}{n})}^{3}\\cdot \\frac{5}{n}]" :db/id #edb/ref 17592186393269} {:answer/id #uuid "af9dfa31-4950-5539-b718-f5c060dd0d43" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{lim}_{n\\to \\infty }{\\sum }_{k=1}^{n}[-2(5+\\frac{2k}{n})\\cdot \\frac{2}{n}]" :db/id #edb/ref 17592186393270}] :answer-field/correct {:answer/id #uuid "91a60e1f-ff52-5d12-8845-6de6b6f23736" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{lim}_{n\\to \\infty }{\\sum }_{k=1}^{n}[-2{(-2+\\frac{5k}{n})}^{3}\\cdot \\frac{5}{n}]" :db/id #edb/ref 17592186393267} :answer-field/id #uuid "97365ecd-a18f-5653-861f-4053aa6db95b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186393265}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "f5568099-5914-5fb0-903c-d4010e585001" :question/math-academy-id "q-73180" :question/problem "What is ${\\int }_{-2}^{3}-2{x}^{3}\\text{d}x$ expressed as the limit of a right Riemann sum?" :question/worked-solution "The definite integral can be defined in terms of the limit of a right Riemann sum as\n\n$$\n{\\int }_{a}^{b}f(x)\\,\\text{d}x={lim}_{n\\to \\infty }{\\sum }_{k=1}^{n}f({x}_{k})\\cdot Δx,\n$$\n\nwhere ${x}_{k}=a+kΔx$ and $Δx=\\frac{b-a}{n}.$\n\nIn the definite integral\n\n$$\n{\\int }_{-2}^{3}-2{x}^{3}\\text{d}x,\n$$\n\nthe function is $f(x)=-2{x}^{3},$ the lower bound is $a=-2$ and the upper bound is $b=3.$ So, we have\n\n$$\nΔx=\\frac{3-(-2)}{n}=\\frac{5}{n}.\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}{\\int }_{-2}^{3}-2{x}^{3}\\text{d}x & ={lim}_{n\\to \\infty }{\\sum }_{k=1}^{n}f({x}_{k})\\cdot Δx \\\\  & ={lim}_{n\\to \\infty }{\\sum }_{k=1}^{n}[f(-2+k\\cdot \\frac{5}{n})\\cdot \\frac{5}{n}] \\\\  & ={lim}_{n\\to \\infty }{\\sum }_{k=1}^{n}[f(-2+\\frac{5k}{n})\\cdot \\frac{5}{n}] \\\\  & ={lim}_{n\\to \\infty }{\\sum }_{k=1}^{n}[-2{(-2+\\frac{5k}{n})}^{3}\\cdot \\frac{5}{n}].\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186393278 :knowledge-point/_questions [{:db/id #edb/ref 17592186096817 :knowledge-point/id #uuid "e0d98b82-24d2-5b2c-b596-0300778bd187" :knowledge-point/title "Calculating a Two-Term Partial Fraction Decomposition"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "df5097ab-aeed-5dd2-a4ac-84a7912ba470" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$A=1$ and $B=4$" :db/id #edb/ref 17592186393280} {:answer/id #uuid "e7c9cc94-3908-54a8-9499-857e6df7b5d2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$A=4$ and $B=2$" :db/id #edb/ref 17592186393281} {:answer/id #uuid "a5117579-9f3d-5b5b-bd73-6a66279018b8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$A=2$ and $B=1$" :db/id #edb/ref 17592186393282} {:answer/id #uuid "d57fb7dd-ef0f-5819-8fc5-009e2372e7ae" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$A=2$ and $B=-1$" :db/id #edb/ref 17592186393283} {:answer/id #uuid "fdc0b9fc-a2e6-5d8a-9c55-1ce7d90a1edf" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$A=-2$ and $B=-1$" :db/id #edb/ref 17592186393284}] :answer-field/correct {:answer/id #uuid "d57fb7dd-ef0f-5819-8fc5-009e2372e7ae" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$A=2$ and $B=-1$" :db/id #edb/ref 17592186393283} :answer-field/id #uuid "9e286ea8-8e5b-5a6b-a9dc-7462355f83f9" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186393279}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "8e5d3142-b826-521f-9a5c-2fb700156ee4" :question/math-academy-id "q-73189" :question/problem "Given that \n\n$$\n\\frac{2x+1}{(x+1)^{2}}=\\frac{A}{x+1}+\\frac{B}{(x+1)^{2}},\n$$\n\nfind the real constants $A$ and $B.$" :question/worked-solution "Multiplying both sides of the given equality by $(x+1)^{2}$ gives\n\n$$\n\\begin{aligned}2x+1 & =A(x+1)+B.\\end{aligned}\n$$\n\nLetting $x=-1$  gives\n\n$$\n\\begin{aligned}2(-1)+1 & =A(-1+1)+B \\\\ -1 & =B.\\end{aligned}\n$$\n\nLetting $x=0$ and using our value for $B$ gives\n\n$$\n\\begin{aligned}2(0)+1 & =A(0+1)-1 \\\\ 2 & =A\\end{aligned}\n$$\n\nTherefore, $A=2$ and $B=-1.$"}] [{:db/id #edb/ref 17592186341922 :knowledge-point/_questions [{:db/id #edb/ref 17592186096816 :knowledge-point/id #uuid "0f247351-8c81-595e-bb30-26630159819c" :knowledge-point/title "Calculating a Missing Coefficient"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0a9382f0-7a0d-5fdf-b6b4-fcd28ebbe39a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186339217} {:answer/id #uuid "3a3d14e6-bba3-5ffb-918b-631b55a400f9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186339650} {:answer/id #uuid "3a9bdf12-ba46-5ab6-bd2b-5d7ddb245855" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186339653} {:answer/id #uuid "5755ea0e-2f23-5d0e-bce6-ca54b7a0aa7b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186339927} {:answer/id #uuid "ae7fad86-5186-5452-a484-01b2b17a50d5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186340721}] :answer-field/correct {:answer/id #uuid "3a9bdf12-ba46-5ab6-bd2b-5d7ddb245855" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186339653} :answer-field/id #uuid "268d95a7-d6ca-5d10-b5ce-e2cd1c539891" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186341448}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "3df5e280-10bc-5c40-be58-baa686dafca8" :question/math-academy-id "q-73195" :question/problem "Given that \n\n$$\n\\frac{5x-2}{(x+3)^{2}}=\\frac{A}{x+3}-\\frac{17}{(x+3)^{2}},\n$$\n\nwhat is the value of $A?$" :question/worked-solution "Multiplying both sides of the given equality by $(x+3)^{2}$ gives\n\n$$\n\\begin{aligned}5x-2 & =A(x+3)-17.\\end{aligned}\n$$\n\nLetting $x=0$  gives\n\n$$\n\\begin{aligned}5(0)-2 & =A(0+3)-17 \\\\ -2 & =3A-17 \\\\ 15 & =3A \\\\ A & =5.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186341928 :knowledge-point/_questions [{:db/id #edb/ref 17592186115380 :knowledge-point/id #uuid "794398c0-ffbf-5971-a411-f236607f56b8" :knowledge-point/title "Determining Whether a Function is Differentiable at a Point Given a Graph"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3115a701-908d-5194-89b5-3934f2aee943" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186339559} {:answer/id #uuid "3ef63771-16e0-5c66-87bb-9773a47f39ce" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186339696} {:answer/id #uuid "4084d34d-cdd6-5521-90d7-5d09fec010be" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186339705} {:answer/id #uuid "5f7cee9c-67f1-509a-a047-56e0f6f1ef9b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186339975} {:answer/id #uuid "9f5901ab-7568-583f-a1e8-bd3745447399" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186340567}] :answer-field/correct {:answer/id #uuid "9f5901ab-7568-583f-a1e8-bd3745447399" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186340567} :answer-field/id #uuid "941f6918-d68b-5b25-9b9f-c8698c202566" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186341640}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "fa88d46b-d2ce-5164-bbed-10d691e29ef6" :question/math-academy-id "q-73250" :question/problem "![](images/a8/a8a70a2f28585b63d2a083b42eb6ad54bfb581b5f13c699a3bc3c8d836afaee8.png)\n\nGiven the plot of the function $y=f(x)$ above, which of the following statements are true?\n\n- The function is continuous at $x=1$\n- The function is continuous at $x=0$\n- The function is differentiable at $x=0$" :question/worked-solution "- Statement I is false. From the graph we can see that $f(x)$ has a removable discontinuity at $x=1.$\n\n- Statement II is true. The graph can be drawn in a neighborhood of $x=0$ without taking the pencil off the paper.\n\n- Statement III is false. The function $f(x)$ has a corner point at $x=0$ and so it is not differentiable there.\n\nTherefore, only statement II is true."}] [{:db/id #edb/ref 17592186341929 :knowledge-point/_questions [{:db/id #edb/ref 17592186115380 :knowledge-point/id #uuid "794398c0-ffbf-5971-a411-f236607f56b8" :knowledge-point/title "Determining Whether a Function is Differentiable at a Point Given a Graph"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "43206143-d3e7-5558-906d-23db6302ae10" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186339717} {:answer/id #uuid "5aac758e-2f12-517d-8ce4-fe8a5696f212" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186339951} {:answer/id #uuid "9c49a7a3-a3b7-5ac2-9f14-8aeb96443d71" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186340536} {:answer/id #uuid "be0a87e6-ce52-5475-84fa-d3314aa5b89d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186340822} {:answer/id #uuid "dd1f61f7-02e8-5317-a136-be60633289a9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186341093}] :answer-field/correct {:answer/id #uuid "dd1f61f7-02e8-5317-a136-be60633289a9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186341093} :answer-field/id #uuid "315e5c79-1bab-5a2f-a733-2981ea179e3a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186341466}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "fb7ec702-6570-50d7-8199-a59c190c3e40" :question/math-academy-id "q-73252" :question/problem "![](images/1f/1f2d8b9faac6c300b41902cea5065bf8bafb02c137232ee79779a4dc3ff67f33.png)\n\nGiven the plot of the function $y=f(x)$ above, which of the following statements are true?\n\n- The function is continuous at $x=-1$\n- The function is differentiable at $x=1$\n- The function is continuous at $x=2$" :question/worked-solution "- Statement I is true. The graph can be drawn in a neighborhood of $x=-1$ without taking the pencil off the paper.\n\n- Statement II is false. From the graph we can see that $f(x)$ has a removable discontinuity at $x=1.$ So, it can't be differentiable there.\n\n- Statement III is true. The graph can be drawn in a neighborhood of $x=2$ without taking the pencil off the paper.\n\nTherefore, only statements I and III  are true."}] [{:db/id #edb/ref 17592186341958 :knowledge-point/_questions [{:db/id #edb/ref 17592186096819 :knowledge-point/id #uuid "9e9c4ef2-0491-5b42-8679-4fe7dfbd7b00" :knowledge-point/title "Finding a Partial Fraction Decomposition With Higher Order Factors"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "047cccdf-27f1-5cfb-b786-1c8d86f2746c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-32" :db/id #edb/ref 17592186339159} {:answer/id #uuid "49e879e3-cea2-5684-be86-6af3707f8d5a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-36" :db/id #edb/ref 17592186339792} {:answer/id #uuid "8aaa2710-0d0f-52e4-8149-15fbc048e9dd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "54" :db/id #edb/ref 17592186340367} {:answer/id #uuid "91914e32-168a-51fa-af34-cb11e5d0549f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-48" :db/id #edb/ref 17592186340434} {:answer/id #uuid "d67f00c6-3a76-5e96-adcd-17772f5a5452" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "42" :db/id #edb/ref 17592186341029}] :answer-field/correct {:answer/id #uuid "91914e32-168a-51fa-af34-cb11e5d0549f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-48" :db/id #edb/ref 17592186340434} :answer-field/id #uuid "02bffc3a-26ca-54b9-a2e5-c7f8ef639d65" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186341388}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "6fc41a67-28eb-5a31-90bd-82ff488b2606" :question/math-academy-id "q-73384" :question/problem "Given that \n\n$$\n\\frac{10-{x}^{2}}{(x-4)^{3}}=\\frac{A}{x-4}+\\frac{B}{(x-4)^{2}}+\\frac{C}{(x-4)^{3}},\n$$\n\nwhere $A$, $B$ and $C$ are real constants, find the value of $A\\cdot B\\cdot C.$" :question/worked-solution "Multiplying both sides of the given equality by $(x-4)^{3}$ gives\n\n$$\n\\begin{aligned}10-{x}^{2} & =A(x-4)^{2}+B(x-4)+C.\\end{aligned}\n$$\n\nLetting $x=4$ gives\n\n$$\n\\begin{aligned}10-{4}^{2} & =A(4-4)^{2}+B(4-4)+C \\\\ -6 & =A(0)+B(0)+C \\\\ C & =-6.\\end{aligned}\n$$\n\nLetting $x=0$ and using our value for $C$ gives\n\n$$\n\\begin{aligned}10-{0}^{2} & =A(0-4)^{2}+B(0-4)-6 \\\\ 10 & =16A-4B-6 \\\\ 0 & =16A-4B-16 \\\\ 0 & =4A-B-4 \\\\ B & =4A-4.\\,\\,(1)\\end{aligned}\n$$\n\nNow, letting $x=3$ and using our value for $C$ gives\n\n$$\n\\begin{aligned}10-{3}^{2} & =A(3-4)^{2}+B(3-4)-6 \\\\ 1 & =A-B-6 \\\\ 0 & =A-B-7 \\\\ B & =A-7.\\,\\,(2)\\end{aligned}\n$$\n\nFrom $(1)$ and $(2)$ we have\n\n$$\n\\begin{aligned}4A-4 & =A-7 \\\\ 3A & =-3 \\\\ A & =-1.\\end{aligned}\n$$\n\nNow we substitute the value of $A$ into $(2)$  to get the value of $B:$\n\n$$\n\\begin{aligned}B & =-1-7=-8\\end{aligned}\n$$\n\nFinally,\n\n$$\n\\begin{aligned}A\\cdot B\\cdot C & =-1\\cdot (-8)\\cdot (-6)=-48.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186341959 :knowledge-point/_questions [{:db/id #edb/ref 17592186096819 :knowledge-point/id #uuid "9e9c4ef2-0491-5b42-8679-4fe7dfbd7b00" :knowledge-point/title "Finding a Partial Fraction Decomposition With Higher Order Factors"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "00da50d5-06aa-555b-b932-f57f9775becc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186339137} {:answer/id #uuid "0ae0a319-26cd-5696-9948-2ba6df2a5b9b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-10" :db/id #edb/ref 17592186339220} {:answer/id #uuid "0ce2e706-9384-5074-b584-a4c836afe53d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-8" :db/id #edb/ref 17592186339246} {:answer/id #uuid "93c23325-5f41-55c9-a02d-50086fd7d539" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "9" :db/id #edb/ref 17592186340455} {:answer/id #uuid "d35d1d09-7ada-52f3-9bc7-c5c90d509c46" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "12" :db/id #edb/ref 17592186340999}] :answer-field/correct {:answer/id #uuid "00da50d5-06aa-555b-b932-f57f9775becc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186339137} :answer-field/id #uuid "6cf8987e-44ea-5077-b03b-d3da1349f0f2" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186341568}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "9b9b8ee3-9a8d-586a-9eb4-4aa3f12cfa23" :question/math-academy-id "q-73385" :question/problem "Given that \n\n$$\n\\frac{4x-1}{(x-3)^{3}}=\\frac{A}{x-3}+\\frac{B}{(x-3)^{2}}+\\frac{C}{(x-3)^{3}},\n$$\n\nwhere $A$, $B$ and $C$ are real constants, find the value of $A\\cdot B\\cdot C.$" :question/worked-solution "Multiplying both sides of the given equality by $(x-3)^{3}$ gives\n\n$$\n\\begin{aligned}4x-1 & =A(x-3)^{2}+B(x-3)+C.\\end{aligned}\n$$\n\nLetting $x=3$  gives\n\n$$\n\\begin{aligned}4(3)-1 & =A(3-3)^{2}+B(3-3)+C \\\\ 11 & =A(0)+B(0)+C \\\\ C & =11.\\end{aligned}\n$$\n\nLetting $x=0$ and using our value for $C$ gives\n\n$$\n\\begin{aligned}4(0)-1 & =A(0-3)^{2}+B(0-3)+11 \\\\ -1 & =9A-3B+11 \\\\ 0 & =9A-3B+12 \\\\ 0 & =3A-B+4 \\\\ B & =3A+4.\\,\\,(1)\\end{aligned}\n$$\n\nNow, letting $x=2$ and using our value for $C$ gives\n\n$$\n\\begin{aligned}4(2)-1 & =A(2-3)^{2}+B(2-3)+11 \\\\ 7 & =A-B+11 \\\\ 0 & =A-B+4 \\\\ B & =4+A.\\,\\,(2)\\end{aligned}\n$$\n\nFrom $(1)$ and $(2)$ we have\n\n$$\n\\begin{aligned}3A+4 & =4+A \\\\ 2A & =0 \\\\ A & =0.\\end{aligned}\n$$\n\nNow we substitute the value of $A$ into $(2)$  to get the value of $B:$\n\n$$\n\\begin{aligned}B & =4+0=4\\end{aligned}\n$$\n\nFinally,\n\n$$\n\\begin{aligned}A\\cdot B\\cdot C & =0\\cdot 4\\cdot 11=0.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186403633 :knowledge-point/_questions [{:db/id #edb/ref 17592186064273 :knowledge-point/id #uuid "6b5ea4a7-acc4-5825-b6c5-b6c87e6a1674" :knowledge-point/title "Identifying Critical and Stationary Points of a Function Given Its Graph"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "17bd2520-0c4f-54a1-9032-4feba8ac4cd7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$x=6$ only" :db/id #edb/ref 17592186403635} {:answer/id #uuid "bf955400-4c85-5799-a0bb-34bb8034740d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$x=2$ only" :db/id #edb/ref 17592186403636} {:answer/id #uuid "fab62fe8-12aa-52f0-b98d-2406eb0e0b56" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "None" :db/id #edb/ref 17592186403637} {:answer/id #uuid "b01d168e-efd5-5ced-839e-03be5807a102" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$x=2$ and $x=6$ only" :db/id #edb/ref 17592186403638} {:answer/id #uuid "9102896f-bd20-58cb-a6f3-3d67a1deeab9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "All points in the closed interval $[2,6]$" :db/id #edb/ref 17592186403639}] :answer-field/correct {:answer/id #uuid "9102896f-bd20-58cb-a6f3-3d67a1deeab9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "All points in the closed interval $[2,6]$" :db/id #edb/ref 17592186403639} :answer-field/id #uuid "f7a88cb6-2519-5806-b90d-f5beabf35ae2" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186403634}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "6fc62285-d6ad-563b-a202-c3fe4f3d9e71" :question/math-academy-id "q-73409" :question/problem "![](images/7c/7c5bc75101a3bf4b4074bf60c1ab68962f2ed0de559f889365c3807be2fa833c.png)\n\nConsider the function $y=f(x)$ whose graph is shown above. What are the $x$-coordinates of all the critical points?" :question/worked-solution "The critical points of $f(x)$ are the values of $x$ where ${f}^{′}(x)=0$ or ${f}^{′}(x)$ doesn't exist. Graphically, those are the values where the tangent to the graph is horizontal or where the tangent does not exist, respectively.\n\nIn the given graph, we can see that\n\n- at any point between $x=2$ and $x=6$ the tangent to the graph is horizontal, so we have ${f}^{′}(x)=0,$ while\n\n- at $x=2$ and at $x=6$ there are sharp corners, hence ${f}^{′}(2)$ and ${f}^{′}(6)$ don't exist.\n\n![](images/6e/6e4299d762e26ff3de85ae0fd766d28368de937098dfcf232ce9a234fee826e1.png)\n\n  \n\nTherefore, all numbers in the closed interval $[2,6]$ are critical points for $f(x).$"}] [{:db/id #edb/ref 17592186403640 :knowledge-point/_questions [{:db/id #edb/ref 17592186064273 :knowledge-point/id #uuid "6b5ea4a7-acc4-5825-b6c5-b6c87e6a1674" :knowledge-point/title "Identifying Critical and Stationary Points of a Function Given Its Graph"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "cb4d5bbd-8b8e-5b87-b552-49eb950fa340" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$x=3$ only" :db/id #edb/ref 17592186403642} {:answer/id #uuid "25a9ad5d-e3da-5b19-ae3c-1a4da3e2def8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$x=3$, $x=4$, and $x=6$" :db/id #edb/ref 17592186403643} {:answer/id #uuid "4424aa1e-fbe6-5341-b6bf-db50547251d1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "All points in the open interval $(3,4)$" :db/id #edb/ref 17592186403644} {:answer/id #uuid "d8f5049a-410b-5e0f-aa9d-73bdc98cfb29" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$x=4$ only" :db/id #edb/ref 17592186403645} {:answer/id #uuid "ae9b2849-1a87-535e-a5be-0fdab3635438" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$x=3$ and $x=4$ only" :db/id #edb/ref 17592186403646}] :answer-field/correct {:answer/id #uuid "4424aa1e-fbe6-5341-b6bf-db50547251d1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "All points in the open interval $(3,4)$" :db/id #edb/ref 17592186403644} :answer-field/id #uuid "8aaf3855-a51d-5ca4-8c0a-99b3bc89ed52" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186403641}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "a831b1fe-cda9-5ab9-bf01-7acc19edee37" :question/math-academy-id "q-73410" :question/problem "![](images/ea/eab84ed04b86678fb4a8d23c010e9a22beead062595b49818ac95e996c3173e6.png)\n\nConsider the function $y=f(x)$ whose graph is shown above. What are the $x$-coordinates of all the stationary points?" :question/worked-solution "The stationary points of $f(x)$ are the values of $x$ where ${f}^{′}(x)=0.$ Graphically, those are the values where the tangent to the graph is horizontal.\n\nIn the given graph, we can see that at any point between $x=3$ and $x=4$ the tangent to the graph is horizontal, so we have ${f}^{′}(x)=0$ at those points.\n\n![](images/ab/ab200bebf80bbd1abe6e0c43ec124fe359da25f38d4346d25d8741decc88aa26.png)\n\n  \n\nTherefore, the $x$-coordinates of the stationary points of $f(x)$, are all values in the open interval $(3,4).$ \n\n**Note:** At $x=3$ and $x=4$, there are sharp corners, so ${f}^{′}(x)$ doesn't exist at those points. This gives us two more critical points. But they are not stationary points."}] [{:db/id #edb/ref 17592186341971 :knowledge-point/_questions [{:db/id #edb/ref 17592186115398 :knowledge-point/id #uuid "b34b7ab4-a17b-5667-bd2b-5ed53e43afb6" :knowledge-point/title "Differentiating Inverse Reciprocal Trigonometric Functions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "574af7f2-928a-5a00-b135-4916a6dec950" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2\\sqrt{x}}-\\frac{1}{|x|\\sqrt{{x}^{2}-1}}" :db/id #edb/ref 17592186339926} {:answer/id #uuid "987816d8-ddea-5472-bfa6-60df165674be" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{\\sqrt{x}}-\\frac{1}{2|x|\\sqrt{{x}^{2}-1}}" :db/id #edb/ref 17592186340500} {:answer/id #uuid "a07504e1-78da-53c1-a071-bf6d07bb482a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{\\sqrt{x}}+\\frac{2}{x\\sqrt{{x}^{2}-1}}" :db/id #edb/ref 17592186340581} {:answer/id #uuid "c71ac88f-b329-53fd-a776-c30ee71c20b3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2\\sqrt{x}}+\\frac{1}{2x\\sqrt{{x}^{2}-1}}" :db/id #edb/ref 17592186340893} {:answer/id #uuid "c94af7b5-9c00-52e6-891e-6dbf2ca55530" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2\\sqrt{x}}+\\frac{2}{|x|\\sqrt{{x}^{2}-1}}" :db/id #edb/ref 17592186340913}] :answer-field/correct {:answer/id #uuid "c94af7b5-9c00-52e6-891e-6dbf2ca55530" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2\\sqrt{x}}+\\frac{2}{|x|\\sqrt{{x}^{2}-1}}" :db/id #edb/ref 17592186340913} :answer-field/id #uuid "47d65433-3d6d-5565-a566-451d9ef6b0e8" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186341504}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "077baa93-9f9f-5780-986d-77a93ca959f7" :question/math-academy-id "q-73437" :question/problem "Calculate ${f}^{′}(x)$ if $f(x)=\\sqrt{x}-2arccscx.$" :question/worked-solution "The formula for the derivative of $arccsc$ is\n\n$$\n\\frac{\\text{d}}{\\text{d}x}(arccscx)=-\\frac{1}{|x|\\sqrt{{x}^{2}-1}}.\n$$\n\nUsing the formula above, we obtain\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}(\\sqrt{x}-2arccscx) \\\\  & =\\frac{1}{2\\sqrt{x}}-2\\cdot \\frac{\\text{d}}{\\text{d}x}(arccscx) \\\\  & =\\frac{1}{2\\sqrt{x}}-2(-\\frac{1}{|x|\\sqrt{{x}^{2}-1}}) \\\\  & =\\frac{1}{2\\sqrt{x}}+\\frac{2}{|x|\\sqrt{{x}^{2}-1}}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186341974 :knowledge-point/_questions [{:db/id #edb/ref 17592186115399 :knowledge-point/id #uuid "20a5f15e-8a26-57af-a867-8f8ae02a91c1" :knowledge-point/title "Differentiating Inverse Reciprocal Trigonometric Functions Using the Quotient Rule"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3ed6b8a7-489f-5243-a1ab-0833d4b3659d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{{e}^{3x}|x|\\sqrt{{x}^{2}-1}}-\\frac{{e}^{3x}arccscx}{{e}^{3x}-1}" :db/id #edb/ref 17592186339694} {:answer/id #uuid "72547bb8-80f4-5189-a664-31a103998d0e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{3}{({e}^{3x}-1)|x|\\sqrt{{x}^{2}-1}}+\\frac{{e}^{3x}arccscx}{({e}^{3x}-1)^{2}}" :db/id #edb/ref 17592186340143} {:answer/id #uuid "778014a0-4d28-5cbd-bcfb-226c4ad315c6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{{e}^{3x}-1}{|x|\\sqrt{{x}^{2}-1}}+\\frac{3arccscx}{{e}^{3x}({e}^{3x}-1)}" :db/id #edb/ref 17592186340192} {:answer/id #uuid "de92d6cb-e70b-5bc3-b99c-b1ff038239da" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{({e}^{3x}-1)|x|\\sqrt{{x}^{2}-1}}-\\frac{3{e}^{3x}arccscx}{({e}^{3x}-1)^{2}}" :db/id #edb/ref 17592186341104} {:answer/id #uuid "fb52f006-44ca-5a45-b8f9-20bd82b1abbb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{{e}^{3x}|x|\\sqrt{{x}^{2}-1}}+\\frac{{e}^{3x}arccscx}{{e}^{3x}-1}" :db/id #edb/ref 17592186341348}] :answer-field/correct {:answer/id #uuid "de92d6cb-e70b-5bc3-b99c-b1ff038239da" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{({e}^{3x}-1)|x|\\sqrt{{x}^{2}-1}}-\\frac{3{e}^{3x}arccscx}{({e}^{3x}-1)^{2}}" :db/id #edb/ref 17592186341104} :answer-field/id #uuid "d070584c-5ac5-5571-b148-95c94bd096be" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186341746}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "f1d541e8-a8d8-5346-9cfd-53646530c168" :question/math-academy-id "q-73448" :question/problem "Calculate $\\frac{\\text{d}y}{\\text{d}x}$ for $y=\\frac{arccscx}{{e}^{3x}-1}.$" :question/worked-solution "Here, we let $u(x)=arccscx$ and $v(x)={e}^{3x}-1$, and apply the quotient rule.\n\nWe use the formulae\n\n$$\n{u}^{′}(x)=-\\frac{1}{|x|\\sqrt{{x}^{2}-1}}\\,\\text{and}\\,{v}^{′}(x)=3{e}^{3x}.\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{{u}^{′}(x)\\cdot v(x)-u(x)\\cdot {v}^{′}(x)}{[v(x)]^{2}} \\\\  & =\\frac{-\\frac{1}{|x|\\sqrt{{x}^{2}-1}}\\cdot ({e}^{3x}-1)-arccscx\\cdot 3{e}^{3x}}{({e}^{3x}-1)^{2}} \\\\  & =-\\frac{1}{({e}^{3x}-1)|x|\\sqrt{{x}^{2}-1}}-\\frac{3{e}^{3x}arccscx}{({e}^{3x}-1)^{2}}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186341975 :knowledge-point/_questions [{:db/id #edb/ref 17592186175902 :knowledge-point/id #uuid "205c5518-c67a-5784-8cc7-55b42ce7fb0e" :knowledge-point/title "Determining Whether the Extreme Value Theorem Is Applicable to a Function Given Its Graph"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1f9c9d7d-cafe-5ca3-aeda-6ab3a8844c04" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186339402} {:answer/id #uuid "466f898a-a17d-5ef2-9df7-de21d4467270" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186339753} {:answer/id #uuid "53dd7fea-deec-5659-abd2-913b366a2e31" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186339904} {:answer/id #uuid "71573f37-88c6-5316-841b-9e7cbf18b8f2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186340135} {:answer/id #uuid "9acfcc52-3763-5eb4-9f6b-ab6d62822c30" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186340525}] :answer-field/correct {:answer/id #uuid "53dd7fea-deec-5659-abd2-913b366a2e31" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186339904} :answer-field/id #uuid "8811fa51-bfe6-5509-90af-f31705a35d36" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186341617}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "cbdd6305-e297-593d-89f4-fb7ada8ade14" :question/math-academy-id "q-73455" :question/problem "![](images/de/de39663db59e42565c7d69d8a44a4cb95f14af0f4946b77cfc42eac02f7d2786.png)\n\nConsider the function $y=f(x)$ whose graph is plotted above. On which of the following intervals is the extreme value theorem applicable to $f(x)?$\n\n- $[-\\pi ,\\pi ]$\n- $[-\\pi ,0)$\n- $[1,\\pi ]$" :question/worked-solution "Remember that the extreme value theorem is only applicable to closed intervals on which the function is continuous.\n\nWith that in mind, let's take a look at each interval.\n\n- The interval  $[-\\pi ,\\pi ]$ is closed,but the function has a removable discontinuity at $x=0.$ Therefore, the extreme value theorem is not applicable.\n\n- The interval $[-\\pi ,0)$ is not closed, so, the extreme value theorem is not applicable.\n\n- The interval $[1,\\pi ]$ is closed, and the function is continuous on $[1,\\pi ].$ Therefore, the extreme value theorem is applicable.\n\nIn conclusion, the correct answer is \"III only\"."}] [{:db/id #edb/ref 17592186341984 :knowledge-point/_questions [{:db/id #edb/ref 17592186175903 :knowledge-point/id #uuid "3bbc6a2d-2078-50d5-9584-c705c19212da" :knowledge-point/title "Identifying Intervals on Which a Given Function Satisfies the Extreme Value Theorem"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0c85ec74-7261-5a84-b268-2cb5156ec3e8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186339237} {:answer/id #uuid "324afc9c-5fc7-5f92-8306-6b5f8eebe2c3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186339570} {:answer/id #uuid "696a6442-ff9a-551c-9da2-c842f797cf3a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186340065} {:answer/id #uuid "85e6b77c-a45a-52cf-b8c9-1652a4b8a948" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186340328} {:answer/id #uuid "facb3de9-0178-54cd-b07c-1c80bbb75fb7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186341346}] :answer-field/correct {:answer/id #uuid "324afc9c-5fc7-5f92-8306-6b5f8eebe2c3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186339570} :answer-field/id #uuid "217a3a4a-e905-59b0-918b-c92be80eb6b7" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186341440}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "122f233b-5382-5fef-8fbd-2b8682266e28" :question/math-academy-id "q-73481" :question/problem "On which of the following intervals can the extreme value theorem be applied to the function $y=\\frac{\\sqrt[4]{x}}{{x}^{2}+1}?$   \n\n- $[-1,5]$\n- $[0,2]$\n- $[2,5]$" :question/worked-solution "Remember that the extreme value theorem is only applicable to closed intervals on which the function is continuous. \n\nWith that in mind, let's take a look at each interval.\n\n- The interval $[-1,5]$ is closed, but the function is not continuous on it because $\\sqrt[4]{x}$ is not defined anywhere in the subinterval $[-1,0).$  Therefore, the extreme value theorem is not applicable.\n\n- The intervals $[0,2]$ and $[2,5]$ are closed, and the function is continuous on each of these intervals Therefore, the extreme value theorem is applicable on each $[0,2]$  and $[2,5].$\n\nIn conclusion, the correct answer is \"II and III only\"."}] [{:db/id #edb/ref 17592186341986 :knowledge-point/_questions [{:db/id #edb/ref 17592186175903 :knowledge-point/id #uuid "3bbc6a2d-2078-50d5-9584-c705c19212da" :knowledge-point/title "Identifying Intervals on Which a Given Function Satisfies the Extreme Value Theorem"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0a68717c-3c5f-58a5-9174-e8f45f3e1ef1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186339216} {:answer/id #uuid "336f07da-9df2-582d-80ca-e44d8eb292b0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186339585} {:answer/id #uuid "43af0409-9e51-5d17-a8fb-98b37bd00bec" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186339722} {:answer/id #uuid "72581646-406e-5e01-9bba-7ad77de94142" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186340144} {:answer/id #uuid "8e33f721-3fb7-5e44-8644-c40ab2c07185" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186340406}] :answer-field/correct {:answer/id #uuid "336f07da-9df2-582d-80ca-e44d8eb292b0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186339585} :answer-field/id #uuid "9a35e850-44d5-5740-b0b8-70909d0b180d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186341650}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "5aba1141-c0a4-54c1-bd64-30eb78786676" :question/math-academy-id "q-73484" :question/problem "On which of the following intervals can the extreme value theorem be applied to the function $y=\\sqrt{\\operatorname{cos}⁡x}?$    \n\n- $[\\frac{\\pi }{2},\\pi ]$\n- $[\\frac{\\pi }{4},\\frac{\\pi }{2})$\n- $[0,\\frac{\\pi }{2}]$" :question/worked-solution "Remember that the extreme value theorem is only applicable to closed intervals on which the function is continuous. \n\nWith that in mind, let's take a look at each interval.\n\n- The interval $[\\frac{\\pi }{2},\\pi ]$  is closed, but the function is not defined on a part of the interval because $\\operatorname{cos}⁡(x)<0$ for all $x\\in (\\frac{\\pi }{2},\\pi ].$ Therefore, the extreme value theorem is not applicable.\n\n- The interval $[\\frac{\\pi }{4},\\frac{\\pi }{2})$    is not closed, so the extreme value theorem is not applicable.\n\n- The interval $[0,\\frac{\\pi }{2}]$ is  closed, and the function is continuous on $[0,\\frac{\\pi }{2}].$ Therefore, the extreme value theorem is applicable.\n\nIn conclusion, the correct answer is \"III only\"."}] [{:db/id #edb/ref 17592186393292 :knowledge-point/_questions [{:db/id #edb/ref 17592186059754 :knowledge-point/id #uuid "50c01507-99a7-5328-8d74-c9e9bda51330" :knowledge-point/title "Calculating the Inverse of a 3x3 Matrix Using the Matrix of Cofactors"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8f6f82c2-90c5-5b86-9116-e45789f5346b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{12}[\\begin{aligned}0 & -1 & 3 \\\\ 0 & 4 & 18 \\\\ -12 & 0 & -6\\end{aligned}]" :db/id #edb/ref 17592186393294} {:answer/id #uuid "48104ce2-f01f-520d-9994-ff0f604fb955" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "12[\\begin{aligned}0 & 0 & 12 \\\\ 1 & -4 & -18 \\\\ -3 & 0 & 6\\end{aligned}]" :db/id #edb/ref 17592186393295} {:answer/id #uuid "e267455a-8414-553e-ad9e-957e9a3d2a98" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{12}[\\begin{aligned}0 & -1 & 3 \\\\ 0 & 4 & 0 \\\\ -12 & 0 & -6\\end{aligned}]" :db/id #edb/ref 17592186393296} {:answer/id #uuid "792ada25-1920-5890-a2c7-80e2010138b0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}0 & 0 & -1 \\\\ -1 & 4 & 18 \\\\ 3 & 0 & -6\\end{aligned}]" :db/id #edb/ref 17592186393297} {:answer/id #uuid "1506d6fc-6064-5295-a81e-822db7a19957" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{12}[\\begin{aligned}0 & 0 & -12 \\\\ -1 & 4 & 18 \\\\ 3 & 0 & -6\\end{aligned}]" :db/id #edb/ref 17592186393298}] :answer-field/correct {:answer/id #uuid "1506d6fc-6064-5295-a81e-822db7a19957" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{12}[\\begin{aligned}0 & 0 & -12 \\\\ -1 & 4 & 18 \\\\ 3 & 0 & -6\\end{aligned}]" :db/id #edb/ref 17592186393298} :answer-field/id #uuid "14ebbec9-43d1-5641-a2c2-12f7a04b7202" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186393293}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "2d1042ad-eb6e-59f8-9dab-abab5265f662" :question/math-academy-id "q-73485" :question/problem "Find the inverse of the matrix $A=[\\begin{aligned}-2 & 0 & 4 \\\\ 4 & 3 & 1 \\\\ -1 & 0 & 0\\end{aligned}]$\ngiven that $det(A)=12.$" :question/worked-solution "Let's follow the standard five-step procedure.\n\n**Step 1:** We are given the determinant of $A:$\n\n$$\n\\begin{aligned}det(A)=12\\end{aligned}\n$$\n\n**Step 2:** Form the matrix of the minors of $A.$\nTo make this matrix, we replace each entry of $A$ by its minor.\n\n$$\n\\begin{aligned}M & =[\\begin{aligned}|\\begin{aligned}3 & 1 \\\\ 0 & 0\\end{aligned}| & |\\begin{aligned}4 & 1 \\\\ -1 & 0\\end{aligned}| & |\\begin{aligned}4 & 3 \\\\ -1 & 0\\end{aligned}| \\\\ |\\begin{aligned}0 & 4 \\\\ 0 & 0\\end{aligned}| & |\\begin{aligned}-2 & 4 \\\\ -1 & 0\\end{aligned}| & |\\begin{aligned}-2 & 0 \\\\ -1 & 0\\end{aligned}| \\\\ |\\begin{aligned}0 & 4 \\\\ 3 & 1\\end{aligned}| & |\\begin{aligned}-2 & 4 \\\\ 4 & 1\\end{aligned}| & |\\begin{aligned}-2 & 0 \\\\ 4 & 3\\end{aligned}|\\end{aligned}] \\\\  & =[\\begin{aligned}0 & 1 & 3 \\\\ 0 & 4 & 0 \\\\ -12 & -18 & -6\\end{aligned}].\\end{aligned}\n$$\n\n**Step 3:** Create the matrix of cofactors by changing the sign of some of the entries of $M$ according to the rule of alternating signs.\n\n$$\nC=[\\begin{aligned}0 & -1 & 3 \\\\ 0 & 4 & 0 \\\\ -12 & 18 & -6\\end{aligned}].\n$$\n\n**Step 4:** Write down the transpose of the matrix of cofactors.\n\n$$\n{C}^{T}=[\\begin{aligned}0 & 0 & -12 \\\\ -1 & 4 & 18 \\\\ 3 & 0 & -6\\end{aligned}].\n$$\n\n**Step 5:** Use the formula for the inverse of a $3\\times 3$ matrix.\n\n$$\n\\begin{aligned}{A}^{-1} & =\\frac{1}{det(A)}{C}^{T} \\\\  & =\\frac{1}{12}[\\begin{aligned}0 & 0 & -12 \\\\ -1 & 4 & 18 \\\\ 3 & 0 & -6\\end{aligned}].\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186341990 :knowledge-point/_questions [{:db/id #edb/ref 17592186175901 :knowledge-point/id #uuid "eede91c4-9099-55df-a803-f87895d9f51b" :knowledge-point/title "Applying the Extreme Value Theorem to Piecewise Functions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "27cfa7a4-d6c1-5351-99b2-6635044d85f2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186339474} {:answer/id #uuid "65459a76-323b-5a88-8a2f-2e108e43ea11" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186340024} {:answer/id #uuid "88971863-2310-5e3f-ac5d-6e4e1adfb7df" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186340348} {:answer/id #uuid "91912873-03a1-524d-9ad0-7c617923af84" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186340433} {:answer/id #uuid "be62f3bd-2eeb-5b57-889c-ca65dbe099b6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186340825}] :answer-field/correct {:answer/id #uuid "91912873-03a1-524d-9ad0-7c617923af84" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186340433} :answer-field/id #uuid "bcb8b636-417c-59ba-b9cc-599917ded547" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186341706}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "7b9b884e-eb8a-59c7-aa31-49f0025fb47f" :question/math-academy-id "q-73495" :question/problem "Suppose that $f(x)$ is defined as\n\n$$\nf(x)={\\begin{aligned}{2}^{-x}, & x\\ge 0 \\\\ -1, & x<0.\\end{aligned}\n$$\n\nOn which of the following intervals can the extreme value theorem be applied to the function?\n\n- $[-1,1]$\n- $[\\frac{1}{2},1]$\n- $[-1,0)$" :question/worked-solution "Remember that the extreme value theorem is only applicable to closed intervals on which the function is continuous.\n\nSo, let's check whether the function is continuous on each of the intervals.\n\n- First, consider $[-1,1].$ In this case, we have\n\n$$\n\\begin{aligned}{lim}_{x\\to {0}^{+}}f(x) & ={lim}_{x\\to 0}({2}^{-x})={2}^{0}=1, \\\\ {lim}_{x\\to {0}^{-}}f(x) & ={lim}_{x\\to 0}(-1)=-1.\\end{aligned}\n$$\n\nSo, the limits from the left and from the right of $x=0$ are not the same. Hence, $f(x)$ has a discontinuity at $x=0.$ Therefore, $f(x)$ is not continuous on the interval $[-1,1],$ and the extreme value theorem is not applicable on this interval.\n\n- Now, consider the interval $[\\frac{1}{2},1].$ In this interval, $f(x)={2}^{-x}$ and so $f(x)$ is continuous on $[\\frac{1}{2},1].$  Therefore, the extreme value theorem is applicable on this interval.\n\n- Finally, the interval $[-1,0)$, is not closed, so the extreme value theorem is not applicable in this case.\n\nIn conclusion, the correct answer is \"II only\"."}] [{:db/id #edb/ref 17592186341995 :knowledge-point/_questions [{:db/id #edb/ref 17592186064368 :knowledge-point/id #uuid "552973a7-4ab5-5918-83f4-15ee0e3ee052" :knowledge-point/title "Differentiating an Inverse Sine Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3627b1da-fd8d-505f-a997-ae807566590b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{9}{\\sqrt{1+{x}^{2}}}" :db/id #edb/ref 17592186339612} {:answer/id #uuid "74b11f6e-134b-5711-a698-784d2b72cfb2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{9\\sqrt{1+{x}^{2}}}" :db/id #edb/ref 17592186340171} {:answer/id #uuid "8273beb7-017b-5ab4-8c6d-2816c8c83351" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{9}{\\sqrt{1-{x}^{2}}}" :db/id #edb/ref 17592186340303} {:answer/id #uuid "c5d32868-fd11-5abe-9361-4ab3f8f960c6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{9}{\\sqrt{1+{x}^{2}}}" :db/id #edb/ref 17592186340881} {:answer/id #uuid "f9927d95-93dd-5fa7-87cf-bd5c9eb69f0e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{9}{\\sqrt{1-{x}^{2}}}" :db/id #edb/ref 17592186341335}] :answer-field/correct {:answer/id #uuid "8273beb7-017b-5ab4-8c6d-2816c8c83351" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{9}{\\sqrt{1-{x}^{2}}}" :db/id #edb/ref 17592186340303} :answer-field/id #uuid "6255bf89-615b-5c1e-8243-e6d10ccab212" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186341552}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "a6055ee2-868a-5c78-ace7-dbe46416f75e" :question/math-academy-id "q-73507" :question/problem "Calculate $\\frac{\\text{d}y}{\\text{d}x}$ for $y=5+9\\operatorname{arcsin}⁡x.$" :question/worked-solution "The formula for the derivative of arcsine is\n\n$$\n\\frac{\\text{d}}{\\text{d}x}(\\operatorname{arcsin}⁡x)=\\frac{1}{\\sqrt{1-{x}^{2}}}.\n$$\n\nUsing the formula above, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}}{\\text{d}x}(5+9\\operatorname{arcsin}⁡x) \\\\  & =0+9\\cdot \\frac{\\text{d}}{\\text{d}x}(\\operatorname{arcsin}⁡x) \\\\  & =0+9\\cdot \\frac{1}{\\sqrt{1-{x}^{2}}} \\\\  & =\\frac{9}{\\sqrt{1-{x}^{2}}}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186341996 :knowledge-point/_questions [{:db/id #edb/ref 17592186064368 :knowledge-point/id #uuid "552973a7-4ab5-5918-83f4-15ee0e3ee052" :knowledge-point/title "Differentiating an Inverse Sine Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2611dcff-8b91-597f-8c5f-f0d7faaed58a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{8{e}^{x}}{\\sqrt{1-{e}^{2x}}}" :db/id #edb/ref 17592186339457} {:answer/id #uuid "7449185b-c303-5b5d-96c0-ee59bef20ffe" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{8{e}^{x}}{\\sqrt{1+{e}^{x}}}" :db/id #edb/ref 17592186340163} {:answer/id #uuid "cd4e2280-4678-5815-8dcd-085f512cb2a0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{8{e}^{2x}}{\\sqrt{1-{e}^{x}}}" :db/id #edb/ref 17592186340949} {:answer/id #uuid "d65f70a2-0557-5c9f-9a19-d989035f25e3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{e}^{x}}{8\\sqrt{1+{e}^{2x}}}" :db/id #edb/ref 17592186341028} {:answer/id #uuid "eeb2dc92-4c99-527c-a276-2f5596bbd1e3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{e}^{x}}{8\\sqrt{1-{e}^{2x}}}" :db/id #edb/ref 17592186341233}] :answer-field/correct {:answer/id #uuid "2611dcff-8b91-597f-8c5f-f0d7faaed58a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{8{e}^{x}}{\\sqrt{1-{e}^{2x}}}" :db/id #edb/ref 17592186339457} :answer-field/id #uuid "29724483-71c4-5205-a1f7-0c0cb6846690" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186341451}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "7e41abc4-5351-5b76-8500-74e3de1b2a5a" :question/math-academy-id "q-73508" :question/problem "Calculate ${f}^{′}(x)$ for $f(x)=8\\operatorname{arcsin}⁡({e}^{x}).$" :question/worked-solution "The formula for the derivative of arcsine is\n\n$$\n\\frac{\\text{d}}{\\text{d}x}(\\operatorname{arcsin}⁡x)=\\frac{1}{\\sqrt{1-{x}^{2}}}.\n$$\n\nUsing the chain rule and the formula above, we get\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}[8\\operatorname{arcsin}⁡({e}^{x})] \\\\  & =8\\cdot \\frac{1}{\\sqrt{1-{({e}^{x})}^{2}}}\\cdot \\frac{\\text{d}}{\\text{d}x}({e}^{x}) \\\\  & =\\frac{8}{\\sqrt{1-{e}^{2x}}}\\cdot {e}^{x} \\\\  & =\\frac{8{e}^{x}}{\\sqrt{1-{e}^{2x}}}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186342006 :knowledge-point/_questions [{:db/id #edb/ref 17592186059755 :knowledge-point/id #uuid "d79fb5d1-22a6-511d-90ca-7d66c540d172" :knowledge-point/title "Calculating the Cofactor Method To Solve for an Unknown Quantity"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "444cd60d-98f8-57c7-9875-93fe9bccf0fb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186339729} {:answer/id #uuid "534e79d6-1a48-52d9-8361-6b5e12a9cdf3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186339897} {:answer/id #uuid "53b60466-c23f-5e4c-9676-8a33e27c13b4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186339902} {:answer/id #uuid "87d00cf2-3923-56f4-a41d-5b87aa3fb375" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186340345} {:answer/id #uuid "da2aff30-bbeb-5d42-9525-3fe5517ebd88" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186341064}] :answer-field/correct {:answer/id #uuid "da2aff30-bbeb-5d42-9525-3fe5517ebd88" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186341064} :answer-field/id #uuid "45ff8668-6658-5885-8426-f8efdc154b15" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186341502}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "4a069e33-ab79-5e52-8347-ee8dc3251c92" :question/math-academy-id "q-73535" :question/problem "The entry ${a}_{33}^{′}$ in the inverse of the matrix\n$A=[\\begin{aligned}1 & 1 & k \\\\ -1 & 2 & 3 \\\\ 0 & -3 & -1\\end{aligned}]$\nequals $\\frac{1}{4}$ and $det(A)=6+3k.$ Find the value of $k.$" :question/worked-solution "First, note that we are given the determinant of $A:$\n\n$$\ndet(A)=6+3k\n$$\n\nSince we want the entry ${a}_{33}^{′}$ in ${A}^{-1},$ we need to know the value of ${c}_{33}$ in the matrix of cofactors. For this, we use the formula to get\n\n$$\n\\begin{aligned}{c}_{33} & =(-1)^{3+3}|\\begin{aligned}1 & 1 \\\\ -1 & 2\\end{aligned}| \\\\  & =|\\begin{aligned}1 & 1 \\\\ -1 & 2\\end{aligned}| \\\\  & =2-(-1) \\\\  & =3\\end{aligned}\n$$\n\nThen, since ${A}^{-1}=\\frac{1}{det(A)}{C}^{T},$ we have\n\n$$\n\\begin{aligned}{a}_{33}^{′} & =\\frac{1}{\\text{det}(A)}{c}_{33} \\\\  & =\\frac{1}{6+3k}\\cdot 3 \\\\  & =\\frac{1}{2+k}.\\end{aligned}\n$$\n\nFinally, since we are told that ${a}_{33}^{′}=\\frac{1}{4}$, we have\n\n$$\n\\begin{aligned}\\frac{1}{4} & =\\frac{1}{2+k} \\\\ 2+k & =4 \\\\ k & =2.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186403703 :knowledge-point/_questions [{:db/id #edb/ref 17592186096706 :knowledge-point/id #uuid "8c990d69-54da-5541-948f-0d5eff96feb5" :knowledge-point/title "Calculating the X-Intercepts of a Parabola Given Its Graph"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "544b7ae8-40b2-5ec8-83d6-d19730e6b5a3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$0$  and $\\sqrt{5}$" :db/id #edb/ref 17592186403705} {:answer/id #uuid "2316f0bc-0936-5acf-bd1b-fe6117ca3155" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$0$ and $5$" :db/id #edb/ref 17592186403706} {:answer/id #uuid "1bacfa54-8104-51a9-b2bd-c3c2a3c703ad" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$0$ and $3$" :db/id #edb/ref 17592186403707} {:answer/id #uuid "019cfb67-fa2a-5255-b2d3-9c68213d29fc" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$0$ and $4$" :db/id #edb/ref 17592186403708} {:answer/id #uuid "8cdd38f7-11c0-5b67-b2ce-d02618e9c7a7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$0$ and $2\\sqrt{5}$" :db/id #edb/ref 17592186403709}] :answer-field/correct {:answer/id #uuid "019cfb67-fa2a-5255-b2d3-9c68213d29fc" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$0$ and $4$" :db/id #edb/ref 17592186403708} :answer-field/id #uuid "199aaf87-46d2-5438-b5f3-ee557ec29887" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186403704}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "166cdda3-01a4-5828-9800-429450a46515" :question/math-academy-id "q-73832" :question/problem "![](images/e7/e79a3a7c2fce5a3e3ec7d838ebe1327dcc5452168f499fad05eea85a08e8f8b0.png)\n\nWhat are the $x$-intercepts of the parabola shown above?" :question/worked-solution "First, we need to find the equation of the parabola. From the diagram, we see that the parabola has a vertex at $(2,-1)$ and passes through the point $(-2,3).$\n\nThe general standard equation of an up- or down-opening parabola with vertex $(h,k)$ is given by\n\n$$\n(x-h)^{2}=4p(y-k).\n$$\n\nSubstituting $(h,k)=(2,-1)$ into the above gives\n\n$$\n\\begin{aligned}(x-2)^{2} & =4p(y+1).\\end{aligned}\n$$\n\nNow, we need to find $p.$ Since the parabola passes through the point $(-2,3),$ we substitute $x=-2$ and $y=3$ into the equation and get\n\n$$\n\\begin{aligned}(-2-2)^{2} & =4p(3+1) \\\\ 16 & =4p(4) \\\\ p & =1.\\end{aligned}\n$$\n\nTherefore, the equation of the parabola is\n\n$$\n\\begin{aligned}(x-2)^{2} & =4(y+1).\\end{aligned}\n$$\n\nWhen the parabola intersects the $x$-axis, we must have $y=0.$ So, we substitute $y=0$ into the equation of the parabola and solve for $x:$\n\n$$\n\\begin{aligned}(x-2)^{2} & =4(0+1) \\\\ (x-2)^{2} & =4 \\\\ x-2 & =\\pm \\sqrt{4} \\\\ x & =\\pm 2+2\\end{aligned}\n$$\n\nTherefore, the $x$-intercepts are $0$ and $4.$"}] [{:db/id #edb/ref 17592186342088 :knowledge-point/_questions [{:db/id #edb/ref 17592186096706 :knowledge-point/id #uuid "8c990d69-54da-5541-948f-0d5eff96feb5" :knowledge-point/title "Calculating the X-Intercepts of a Parabola Given Its Graph"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4bf2ba5c-546c-58c0-9a99-60987d4bed71" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186339811} {:answer/id #uuid "5e2ace67-6ffd-55da-af93-b17594f892fa" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2\\sqrt{2}" :db/id #edb/ref 17592186339969} {:answer/id #uuid "621d6ad7-359a-53e7-9a2e-ed49e4bb4a07" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186340003} {:answer/id #uuid "bcda2307-f2c0-535e-89b9-b856f445e31d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186340815} {:answer/id #uuid "db10a33c-6f62-5ce7-97af-099d53380323" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\sqrt{2}" :db/id #edb/ref 17592186341074}] :answer-field/correct {:answer/id #uuid "4bf2ba5c-546c-58c0-9a99-60987d4bed71" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186339811} :answer-field/id #uuid "e0082161-5d47-567a-9ee7-c818ab310a04" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186341779}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "fe98c5cc-1b07-5c7a-9070-12e0a5555ab3" :question/math-academy-id "q-73833" :question/problem "![](images/9a/9a7f256ae77447f4b426612a3e136ccb60ebd172a6eb472c9fa9948e324b3085.png)\n\nWhat is the $x$-intercept of the parabola shown above?" :question/worked-solution "First, we need to find the equation of the parabola. From the diagram, we see that the parabola has a vertex at $(-8,-3)$ and passes through the point $(-2,-6).$\n\nThe general standard equation of a left- or right-opening parabola with vertex $(h,k)$ is given by\n\n$$\n(y-k)^{2}=4p(x-h).\n$$\n\nSubstituting $(h,k)=(-8,-3)$ into the above gives\n\n$$\n(y+3)^{2}=4p(x+8).\n$$\n\nNow, we need to find $p.$ Since the parabola passes through the point $(-2,-6),$ we substitute $x=-2$ and $y=-6$ into the equation and get\n\n$$\n\\begin{aligned}(-6+3)^{2} & =4p(-2+8) \\\\ 9 & =4p(6) \\\\ p & =\\frac{3}{8}.\\end{aligned}\n$$\n\nTherefore, the equation of the parabola is\n\n$$\n\\begin{aligned}(y+3)^{2} & =\\frac{3}{2}(x+8).\\end{aligned}\n$$\n\nWhen the parabola intersects the $x$-axis, we must have $y=0.$ So, we substitute $y=0$ into the equation of the parabola and solve for $x:$\n\n$$\n\\begin{aligned}(0+3)^{2} & =\\frac{3}{2}(x+8) \\\\ 9 & =\\frac{3}{2}(x+8) \\\\ \\frac{18}{3} & =x+8 \\\\ x & =6-8 \\\\ x & =-2\\end{aligned}\n$$\n\nTherefore, the $x$-intercept is $-2.$"}] [{:db/id #edb/ref 17592186342092 :knowledge-point/_questions [{:db/id #edb/ref 17592186096707 :knowledge-point/id #uuid "ddc6c4b1-b4c4-52f8-9f25-feda3130e358" :knowledge-point/title "Calculating the Intercepts of a Parabola Given Its Equation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "18731f91-5a2b-5b17-a387-eb4cc9a4d188" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$(0,\\sqrt{3})$ and $(0,-\\sqrt{3})$" :db/id #edb/ref 17592186339346} {:answer/id #uuid "20d59ae8-b207-56f8-a181-059ef32b89f1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "There are no intersection points" :db/id #edb/ref 17592186339410} {:answer/id #uuid "b3e77b72-b0aa-5aa2-80c3-74d69e6d1bde" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$(0,\\sqrt{6})$ and $(0,-\\sqrt{6})$" :db/id #edb/ref 17592186340763} {:answer/id #uuid "e98d2c48-e98a-5bd8-bf7e-745db4c2794a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$(0,\\sqrt{6})$ and $(0,-2\\sqrt{3})$" :db/id #edb/ref 17592186341189} {:answer/id #uuid "f0c3edd0-3761-5700-a2bb-55bbe3d60703" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$(0,2\\sqrt{3})$ and $(0,-2\\sqrt{3})$" :db/id #edb/ref 17592186341250}] :answer-field/correct {:answer/id #uuid "20d59ae8-b207-56f8-a181-059ef32b89f1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "There are no intersection points" :db/id #edb/ref 17592186339410} :answer-field/id #uuid "c1b9401a-2720-53ab-b421-d5879f6deca9" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186341716}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "6253cbd5-f5b5-5898-ac4f-5142a7aaca73" :question/math-academy-id "q-73847" :question/problem "Find the points of intersection of the parabola ${y}^{2}=3(x-2)$ with the $y$-axis." :question/worked-solution "When the parabola intersects the $y$-axis, we must have $x=0.$ So, we set $x=0$ and solve the resulting equation for $y:$\n\n$$\n\\begin{aligned}{y}^{2} & =3(0-2) \\\\ {y}^{2} & =-6.\\end{aligned}\n$$\n\nTherefore, as the equation ${y}^{2}=-6$ has no solutions, we conclude that there are no intersection points."}] [{:db/id #edb/ref 17592186342181 :knowledge-point/_questions [{:db/id #edb/ref 17592186073810 :knowledge-point/id #uuid "522b66f4-8a46-5dd0-a9d7-3b081c0ed157" :knowledge-point/title "Finding the Distance Between a Point and a Horizontal or Vertical Line"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "59078a96-a4c1-5355-9bdf-3b0f39c93291" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186339938} {:answer/id #uuid "836328cc-8806-5c45-bf00-1c3923682d40" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186340310} {:answer/id #uuid "9909d2b8-e7fa-56b5-9269-e5951dc53bcf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186340509} {:answer/id #uuid "a86ba75a-1b29-5797-9053-bf2a3ad7aa27" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "7" :db/id #edb/ref 17592186340658} {:answer/id #uuid "b0de169a-6a53-5b29-85e4-09cc91632445" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186340736}] :answer-field/correct {:answer/id #uuid "59078a96-a4c1-5355-9bdf-3b0f39c93291" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186339938} :answer-field/id #uuid "cab68815-1850-5693-b986-be3ac48add05" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186341736}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "79f2f5ac-44c5-5b82-9c80-2524e0bd699c" :question/math-academy-id "q-74202" :question/problem "Find the shortest distance between the point $(-1,-4)$ and the line $x=4.$" :question/worked-solution "Let's sketch the given situation.\n\n![](images/d4/d46a6ed76af5c226e327ba197fe019df0d9085e095ca4781898aba54268a1706.png)\n\nSince the line $x=4$ is a vertical line, the shortest distance between this line and the point $(-1,-4)$ is given by the absolute value of the difference between $x$-coordinate of the point and $4.$ \n\nSo, the shortest distance is\n\n$$\nd=|-1-4|=5.\n$$"}] [{:db/id #edb/ref 17592186342208 :knowledge-point/_questions [{:db/id #edb/ref 17592186073811 :knowledge-point/id #uuid "d7030a12-bd18-5f8b-84eb-28b6f216f972" :knowledge-point/title "Finding the Distance Between a Point and a Line"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4b6fecf3-af6d-570c-a4e0-5bd2f8943b6b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "9\\sqrt{2}" :db/id #edb/ref 17592186339805} {:answer/id #uuid "86531e02-9d87-59a8-99d4-328fa2c86fbb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3\\sqrt{2}" :db/id #edb/ref 17592186340333} {:answer/id #uuid "d5e737ba-76b9-5760-80fc-271f650d20e2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186341023} {:answer/id #uuid "e47935d1-86c8-5a85-a24b-c428d0150116" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "9" :db/id #edb/ref 17592186341149} {:answer/id #uuid "e58979f5-86fa-57ab-b8b7-766696bc055b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3\\sqrt{3}" :db/id #edb/ref 17592186341156}] :answer-field/correct {:answer/id #uuid "86531e02-9d87-59a8-99d4-328fa2c86fbb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3\\sqrt{2}" :db/id #edb/ref 17592186340333} :answer-field/id #uuid "6f8851fb-c592-5f14-9bf4-a48b2c458a74" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186341574}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "f0e530ca-0510-53a9-a606-7cbe24765900" :question/math-academy-id "q-74417" :question/problem "Find the shortest distance between the point $(-1,-3)$ and the line $y=-x+2.$" :question/worked-solution "Let's draw a diagram describing our situation.\n\n![](images/eb/eb1176b4a5e2565fceb03e9af652a6ae875f5ee678c103405045fcebc36342e1.png)\n\nFirst, we find the equation of the line that's perpendicular to $y=-x+2$ and passes through the point $(-1,-3).$\n\n The given line has a slope of $-1,$ so our perpendicular line must have a slope of $1.$\n\nUsing point-slope form and simplifying, we obtain the equation of the perpendicular line:\n\n$$\n\\begin{aligned}y-{y}_{1} & =m(x-{x}_{1}) \\\\ y+3 & =1(x+1) \\\\ y+3 & =x+1 \\\\ y & =x-2\\end{aligned}\n$$\n\nWe now find the point where the two lines intersect. To do this, we solve the following system of equations:\n\n$$\n{\\begin{aligned}y=-x+2 \\\\ y=x-2\\end{aligned}\n$$\n\nWe can solve this system by putting the two equations equal to one another and solving for $x.$ This gives\n\n$$\n\\begin{aligned}-x+2 & =x-2 \\\\ -x-x & =-2-2 \\\\ -2x & =-4 \\\\ x & =2.\\end{aligned}\n$$\n\nSubstituting $x=2$ into either of the two equations gives $y=0.$ So, our solution is $x=2$ and $y=0.$ Therefore, the lines intersect at the point $(2,0).$\n\nFinally, we find the distance $d$ between the points $(-1,-3)$ and $(2,0):$\n\n$$\n\\begin{aligned}d & =\\sqrt{({x}_{2}-{x}_{1})^{2}+({y}_{2}-{y}_{1})^{2}} \\\\  & =\\sqrt{(2-(-1))^{2}+(0-(-3))^{2}} \\\\  & =\\sqrt{9+9} \\\\  & =\\sqrt{18} \\\\  & =3\\sqrt{2}\\end{aligned}\n$$\n\nTherefore, we conclude that the shortest distance between the point $(-1,-3)$ and the line $y=-x+2$ is $3\\sqrt{2}.$"}] [{:db/id #edb/ref 17592186342212 :knowledge-point/_questions [{:db/id #edb/ref 17592186073815 :knowledge-point/id #uuid "59d3a391-c163-5a04-944c-5d61a3950e03" :knowledge-point/title "Finding a Point on a Line That Is Closest to a Given Point"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "47f7ce0c-16e5-531a-94b9-547622df3f25" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-2,-2)" :db/id #edb/ref 17592186339767} {:answer/id #uuid "569cbb0a-f99c-5355-8f53-bdc678082993" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-4,0)" :db/id #edb/ref 17592186339923} {:answer/id #uuid "8688ee8a-8219-5c84-a042-632559c1a6df" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-1,-3)" :db/id #edb/ref 17592186340337} {:answer/id #uuid "95f977c5-80d6-5f10-bfe2-b1560cf968b7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-3,-1)" :db/id #edb/ref 17592186340481} {:answer/id #uuid "ae765e2d-062d-5b17-8c52-1eef7d4ff32e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-5,1)" :db/id #edb/ref 17592186340720}] :answer-field/correct {:answer/id #uuid "95f977c5-80d6-5f10-bfe2-b1560cf968b7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-3,-1)" :db/id #edb/ref 17592186340481} :answer-field/id #uuid "73585de0-1b70-548d-9d76-12f3a61d673b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186341582}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "7220b7e3-9cce-5102-874c-014511b9e7f6" :question/math-academy-id "q-74439" :question/problem "![](images/1d/1d687bcdc23c283e0945b039781450d2a020f0fd89c0d2976bb252914b296978.png)\n\nFind the point on the line $y+x=-4$ that is closest to the point $(0,2).$" :question/worked-solution "First, we rewrite the equation of the given line in slope-intercept form:\n\n$$\n\\begin{aligned}y+x & =-4 \\\\ y & =-x-4\\end{aligned}\n$$\n\nNext, we find the equation of the line that's perpendicular to $y=-x-4$ and passes through the point $(0,2).$\n\n The given line has a slope of $-1,$ so our perpendicular line must have a slope of $1.$\n\nUsing point-slope form and simplifying, we obtain the equation of the perpendicular line:\n\n$$\n\\begin{aligned}y-{y}_{1} & =m(x-{x}_{1}) \\\\ y-2 & =1(x-0) \\\\ y-2 & =x \\\\ y & =x+2\\end{aligned}\n$$\n\nWe now find the point where the two lines intersect. To do this, we solve the following system of equations:\n\n$$\n{\\begin{aligned}y=x+2 \\\\ y=-x-4\\end{aligned}\n$$\n\nWe can solve this system by putting the two equations equal to one another and solving for $x.$ This gives\n\n$$\n\\begin{aligned}x+2 & =-x-4 \\\\ x+x & =-4-2 \\\\ 2x & =-6 \\\\ x & =-3.\\end{aligned}\n$$\n\nSubstituting $x=-3$ into either of the two equations gives $y=-1.$ So, our solution is $x=-3$ and $y=-1.$ So, the lines intersect at the point $(-3,-1).$\n\nTherefore, we conclude that the point on the line $y+x=-4$ that is closest to the point $(0,2)$ is  $(-3,-1).$"}] [{:db/id #edb/ref 17592186342232 :knowledge-point/_questions [{:db/id #edb/ref 17592186110563 :knowledge-point/id #uuid "85555bce-debf-5165-ba6a-3c232deeeb0a" :knowledge-point/title "Simplifying an Expression by Factoring the Alternate Forms of the Cotangent-Cosecant Identity"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "08fc0950-3524-5922-9e02-e66930a798ff" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\operatorname{cos}⁡\\theta " :db/id #edb/ref 17592186339205} {:answer/id #uuid "5f81dad8-a385-59a5-b987-3ab48355c5a6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{cos}⁡\\theta " :db/id #edb/ref 17592186339977} {:answer/id #uuid "8b2f8558-8bfb-5abe-bc23-5cc7abd21e51" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1-\\operatorname{cos}⁡\\theta " :db/id #edb/ref 17592186340375} {:answer/id #uuid "9335b044-36ce-5d6a-828e-f5cc8aecb3cf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{sec}⁡\\theta -1" :db/id #edb/ref 17592186340452} {:answer/id #uuid "b707521b-3543-5a12-95ba-e74ca1d6440e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\operatorname{cos}⁡\\theta " :db/id #edb/ref 17592186340783}] :answer-field/correct {:answer/id #uuid "5f81dad8-a385-59a5-b987-3ab48355c5a6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{cos}⁡\\theta " :db/id #edb/ref 17592186339977} :answer-field/id #uuid "3c57ed74-0b4f-5f8c-a845-62b4458056df" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186341487}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "01963f02-f6ee-5182-9456-3f8a5d740ddc" :question/math-academy-id "q-74574" :question/problem "Simplify $\\frac{\\operatorname{cos}⁡\\theta {cot}^{2}⁡\\theta }{\\operatorname{csc}⁡\\theta -1}-\\operatorname{cot}⁡\\theta .$" :question/worked-solution "First, let's recall the following identity: \n\n$$\n{cot}^{2}⁡\\theta ={csc}^{2}⁡\\theta -1\n$$\n\nSubstituting the above identity into the given expression, and then factoring it as a difference of squares, we get\n\n$$\n\\begin{aligned}\\frac{\\operatorname{cos}⁡\\theta {cot}^{2}⁡\\theta }{\\operatorname{csc}⁡\\theta -1}-\\operatorname{cot}⁡\\theta  & =\\frac{\\operatorname{cos}⁡\\theta ({csc}^{2}⁡\\theta -1)}{\\operatorname{csc}⁡\\theta -1}-\\operatorname{cot}⁡\\theta  \\\\  & =\\frac{\\operatorname{cos}⁡\\theta (\\operatorname{csc}⁡\\theta +1)(\\operatorname{csc}⁡\\theta -1)}{\\operatorname{csc}⁡\\theta -1}-\\operatorname{cot}⁡\\theta  \\\\  & =\\frac{\\operatorname{cos}⁡\\theta (\\operatorname{csc}⁡\\theta +1)\\cancel{(\\operatorname{csc}⁡\\theta -1)}}{\\cancel{\\operatorname{csc}⁡\\theta -1}}-\\operatorname{cot}⁡\\theta  \\\\  & =\\operatorname{cos}⁡\\theta (\\operatorname{csc}⁡\\theta +1)-\\operatorname{cot}⁡\\theta  \\\\  & =\\operatorname{cos}⁡\\theta \\operatorname{csc}⁡\\theta +\\operatorname{cos}⁡\\theta -\\operatorname{cot}⁡\\theta  \\\\  & =\\operatorname{cot}⁡\\theta +\\operatorname{cos}⁡\\theta -\\operatorname{cot}⁡\\theta  \\\\  & =\\operatorname{cos}⁡\\theta .\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186342233 :knowledge-point/_questions [{:db/id #edb/ref 17592186110563 :knowledge-point/id #uuid "85555bce-debf-5165-ba6a-3c232deeeb0a" :knowledge-point/title "Simplifying an Expression by Factoring the Alternate Forms of the Cotangent-Cosecant Identity"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "264dc817-12f6-57bb-98c7-13484b763445" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{csc}⁡\\theta +1" :db/id #edb/ref 17592186339460} {:answer/id #uuid "5237867d-730f-5989-9d77-b64a864aae4c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\operatorname{csc}⁡\\theta +1" :db/id #edb/ref 17592186339884} {:answer/id #uuid "a070bbce-1d86-53d3-854d-47717ba43e68" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1+2\\operatorname{csc}⁡\\theta " :db/id #edb/ref 17592186340580} {:answer/id #uuid "b535ca1d-ad11-5b54-be0c-efb5196653c8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1-\\operatorname{csc}⁡\\theta " :db/id #edb/ref 17592186340771} {:answer/id #uuid "d00ae2d9-df1a-5189-bde1-3e4432444aa7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{csc}⁡\\theta -1" :db/id #edb/ref 17592186340980}] :answer-field/correct {:answer/id #uuid "264dc817-12f6-57bb-98c7-13484b763445" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{csc}⁡\\theta +1" :db/id #edb/ref 17592186339460} :answer-field/id #uuid "a5d4cc48-92f4-5197-9d4d-51927a8d2422" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186341670}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "ea168c27-f5a7-59a8-ab75-3dcd4e8a5c95" :question/math-academy-id "q-74575" :question/problem "Simplify $\\frac{{cot}^{2}⁡\\theta }{\\operatorname{csc}⁡\\theta -1}.$" :question/worked-solution "First, let's recall the following identity: \n\n$$\n{cot}^{2}⁡\\theta ={csc}^{2}⁡\\theta -1\n$$\n\nSubstituting the above identity into the given expression, and then factoring it as a difference of squares, we get\n\n$$\n\\begin{aligned}\\frac{{cot}^{2}⁡\\theta }{\\operatorname{csc}⁡\\theta -1} & =\\frac{{csc}^{2}⁡\\theta -1}{\\operatorname{csc}⁡\\theta -1} \\\\  & =\\frac{(\\operatorname{csc}⁡\\theta +1)(\\operatorname{csc}⁡\\theta -1)}{\\operatorname{csc}⁡\\theta -1} \\\\  & =\\frac{(\\operatorname{csc}⁡\\theta +1)\\cancel{(\\operatorname{csc}⁡\\theta -1)}}{\\cancel{\\operatorname{csc}⁡\\theta -1}} \\\\  & =\\operatorname{csc}⁡\\theta +1.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186344954 :knowledge-point/_questions [{:db/id #edb/ref 17592186087858 :knowledge-point/id #uuid "31d92381-0c28-53fc-b918-99c16544c201" :knowledge-point/title "Finding the Equation of a Circle Given a Graph"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5a4b5fa4-5e85-51e5-9b82-2d9649982cd2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(x+3)^{2}+(y+3)^{2}=1" :db/id #edb/ref 17592186342994} {:answer/id #uuid "b211db82-e6c0-5369-afda-a7d6f0604094" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{x}^{2}+{y}^{2}=\\sqrt{3}" :db/id #edb/ref 17592186343801} {:answer/id #uuid "c09f0e7e-ade8-567e-9bdb-c40ef89b86f9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{x}^{2}+{y}^{2}=9" :db/id #edb/ref 17592186343929} {:answer/id #uuid "c2604448-70cd-5a27-872f-a0bae07bc1ab" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{x}^{2}+{y}^{2}=3" :db/id #edb/ref 17592186343947} {:answer/id #uuid "c5724e21-1987-5dc1-86a5-a1cfebf33b16" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(x-3)^{2}+(y-3)^{2}=1" :db/id #edb/ref 17592186343972}] :answer-field/correct {:answer/id #uuid "c09f0e7e-ade8-567e-9bdb-c40ef89b86f9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{x}^{2}+{y}^{2}=9" :db/id #edb/ref 17592186343929} :answer-field/id #uuid "78c5d8f1-2e5c-5cee-821c-064fe215366f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186344713}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "c7d8403d-1335-583d-b92f-e71dbc01f5b3" :question/math-academy-id "q-7463" :question/problem "![](images/b5/b5a933346a903b6712b3df53fa2f241b070ef80146078b96b8f4360ae6650233.png)\n\nWhat is the equation of the circle given above?" :question/worked-solution "The general equation of a circle with radius $r$ centered at the origin is \n\n$$\n{x}^{2}+{y}^{2}={r}^{2}.\n$$\n\nFrom the picture, we see that our circle is centered at $(0,0)$ and has radius $r=3.$ So, the equation is\n\n$$\n\\begin{aligned}{x}^{2}+{y}^{2} & ={r}^{2} \\\\ {x}^{2}+{y}^{2} & ={3}^{2} \\\\ {x}^{2}+{y}^{2} & =9.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186344962 :knowledge-point/_questions [{:db/id #edb/ref 17592186059809 :knowledge-point/id #uuid "678ba6cb-b259-5a25-858c-9db161a34ca9" :knowledge-point/title "Dividing a Real Number by a Complex Number"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2f03ab48-2456-5848-b330-165fc1457620" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{18}{13}-\\frac{27}{13}\\text{i}" :db/id #edb/ref 17592186342633} {:answer/id #uuid "308ea711-b018-58dc-97ca-c9410d45e894" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{27}{13}+\\frac{18}{13}\\text{i}" :db/id #edb/ref 17592186342642} {:answer/id #uuid "40c99ea8-5f63-5b3f-8d23-6bbb3883c1c6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{27}{13}-\\frac{18}{13}\\text{i}" :db/id #edb/ref 17592186342772} {:answer/id #uuid "5285e1d7-9b84-5240-a612-f16959ab2ae5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{27}{13}+\\frac{18}{13}\\text{i}" :db/id #edb/ref 17592186342923} {:answer/id #uuid "efeacb6c-de66-5a0b-8e29-6f0916164222" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{27}{13}-\\frac{18}{13}\\text{i}" :db/id #edb/ref 17592186344346}] :answer-field/correct {:answer/id #uuid "efeacb6c-de66-5a0b-8e29-6f0916164222" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{27}{13}-\\frac{18}{13}\\text{i}" :db/id #edb/ref 17592186344346} :answer-field/id #uuid "f9045964-73ba-507e-9088-a8e8656fd086" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186344930}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "35212040-01f3-5be8-a8f4-ec8be3d798dd" :question/math-academy-id "q-74648" :question/problem "$\\frac{9}{-3+2\\text{i}}=$" :question/worked-solution "The denominator is $-3+2\\text{i}$ and its conjugate is $-3-2\\text{i}.$ We multiply both the numerator and the denominator by $-3-2\\text{i},$ so that the denominator turns into a real number:\n\n$$\n\\begin{aligned}\\begin{aligned}\\frac{9}{-3+2\\text{i}} & =\\frac{9}{-3+2\\text{i}}\\cdot \\frac{-3-2\\text{i}}{-3-2\\text{i}} \\\\  & =\\frac{-27-18\\text{i}}{9+6\\text{i}-6\\text{i}-4{\\text{i}}^{2}} \\\\  & =\\frac{-27-18\\text{i}}{9-4(-1)} \\\\  & =\\frac{-27-18\\text{i}}{9+4} \\\\  & =\\frac{-27-18\\text{i}}{13}\\end{aligned}\\end{aligned}\n$$\n\nNow that the denominator is a real number, we can write the complex number in the form $a+b\\text{i}:$\n\n$$\n\\begin{aligned}\\begin{aligned}\\frac{-27-18\\text{i}}{13}=-\\frac{27}{13}-\\frac{18}{13}\\text{i}\\end{aligned}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186344964 :knowledge-point/_questions [{:db/id #edb/ref 17592186059807 :knowledge-point/id #uuid "730fc9a7-a1b8-55a4-b8d3-666f87b82958" :knowledge-point/title "Dividing a Complex Number by an Imaginary Number"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "00e128ac-795f-5079-a65d-c12d434f9b97" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{3}-\\frac{5}{3}\\text{i}" :db/id #edb/ref 17592186342250} {:answer/id #uuid "0acce053-9af4-5f4a-b04a-78ce591eb4a7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5}{3}+\\frac{2}{3}\\text{i}" :db/id #edb/ref 17592186342329} {:answer/id #uuid "28e94e09-28cc-5b42-aa9b-233264e8e1eb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{3}-\\frac{5}{3}\\text{i}" :db/id #edb/ref 17592186342581} {:answer/id #uuid "afda4c35-56d0-5ffe-a1d1-c2b8302ae823" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{2}{3}-\\frac{5}{3}\\text{i}" :db/id #edb/ref 17592186343783} {:answer/id #uuid "b6a9961a-3eb1-54d3-a58d-4663532eebf5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{2}{3}-\\frac{4}{3}\\text{i}" :db/id #edb/ref 17592186343839}] :answer-field/correct {:answer/id #uuid "afda4c35-56d0-5ffe-a1d1-c2b8302ae823" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{2}{3}-\\frac{5}{3}\\text{i}" :db/id #edb/ref 17592186343783} :answer-field/id #uuid "5889b038-c9b2-51d9-9996-ad96224eaa5f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186344642}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "205e8dc8-a862-5058-a749-305018b1708a" :question/math-academy-id "q-74653" :question/problem "If ${z}_{1}=5-2\\text{i}$ and ${z}_{2}=3\\text{i}$, then ${z}_{1}$ divided by ${z}_{2}$ equals" :question/worked-solution "First, we set up the fraction:\n\n$$\n\\frac{5-2\\text{i}}{3\\text{i}}\n$$\n\nThe denominator is the imaginary number $3\\text{i}.$ Note that this can be written as $0+3\\text{i},$ so the conjugate is $0-3\\text{i},$ or simply $-3\\text{i}.$\n\nSo, we multiply both the numerator and the denominator by $-3\\text{i},$ so that the denominator turns into a real number:\n\n$$\n\\begin{aligned}\\begin{aligned}\\frac{{z}_{1}}{{z}_{2}} & =\\frac{5-2\\text{i}}{3\\text{i}} \\\\  & =\\frac{5-2\\text{i}}{3\\text{i}}\\cdot \\frac{-3\\text{i}}{-3\\text{i}} \\\\  & =\\frac{-15\\text{i}+6{\\text{i}}^{2}}{-9{\\text{i}}^{2}} \\\\  & =\\frac{-15\\text{i}+6(-1)}{-9(-1)} \\\\  & =\\frac{-6-15\\text{i}}{9}\\end{aligned}\\end{aligned}\n$$\n\nNow that the denominator is a real number, we can write the complex number in the form $a+b\\text{i}:$\n\n$$\n\\begin{aligned}\\begin{aligned}\\frac{-6-15\\text{i}}{9}=-\\frac{6}{9}-\\frac{15}{9}\\text{i}=-\\frac{2}{3}-\\frac{5}{3}\\text{i}\\end{aligned}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186344977 :knowledge-point/_questions [{:db/id #edb/ref 17592186087671 :knowledge-point/id #uuid "2902b205-4508-55c6-9a68-f57d3afc9eab" :knowledge-point/title "Finding Exact Values of Trigonometric Expressions Using the Double-Angle Formula"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "02d46c16-ac4e-57b4-ae20-20086616c19f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186342277} {:answer/id #uuid "24e78c28-e4f9-5764-a34b-418c159f48ec" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186342548} {:answer/id #uuid "461de0e9-b9bb-5f6f-af7c-df1d3be102dd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186342814} {:answer/id #uuid "80b774e9-0533-56ca-9013-aade87186d21" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{2}}{2}" :db/id #edb/ref 17592186343348} {:answer/id #uuid "9d2368da-9551-54cc-b612-4a5cc5d70024" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{3}}{2}" :db/id #edb/ref 17592186343622}] :answer-field/correct {:answer/id #uuid "80b774e9-0533-56ca-9013-aade87186d21" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{2}}{2}" :db/id #edb/ref 17592186343348} :answer-field/id #uuid "a4a9942c-2ff0-547a-87bb-c11cc79e965c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186344783}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "b81c92b6-aaf0-5164-b094-1fd4bab4c1a6" :question/math-academy-id "q-7473" :question/problem "Find the exact value of $1-2{sin}^{2}⁡({22.5}^{∘}).$" :question/worked-solution "First, let's recall the double-angle formula for cosine:\n\n$$\n1-2{sin}^{2}⁡x=\\operatorname{cos}⁡2x\n$$\n\nSubstituting $x={22.5}^{∘}$ into the above, we get\n\n$$\n\\begin{aligned}1-2{sin}^{2}⁡({22.5}^{∘}) & =\\operatorname{cos}⁡(2\\cdot {22.5}^{∘}) \\\\  & =\\operatorname{cos}⁡{45}^{∘} \\\\  & =\\frac{\\sqrt{2}}{2}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186393431 :knowledge-point/_questions [{:db/id #edb/ref 17592186087747 :knowledge-point/id #uuid "ad1c29f7-c0e7-5bed-944f-a2e33579c7b8" :knowledge-point/title "Determining the Image of a Vector Under a Map Using the Scalar Multiplication Property"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3c348231-faac-5f15-ba88-4a5fcff9895b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}3 \\\\ -4\\end{aligned}]" :db/id #edb/ref 17592186393433} {:answer/id #uuid "1cbe61fb-3b9a-5b63-aefd-518ef08c77c2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}4 \\\\ -3\\end{aligned}]" :db/id #edb/ref 17592186393434} {:answer/id #uuid "741f5285-7e52-5afa-8fd8-e7ffe7bb3ffa" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}3 \\\\ 1\\end{aligned}]" :db/id #edb/ref 17592186393435} {:answer/id #uuid "3e486dbe-f3f0-57e0-8019-075933a8c6cf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}-4 \\\\ 3\\end{aligned}]" :db/id #edb/ref 17592186393436} {:answer/id #uuid "9e1aa637-1399-5be1-8754-cfd06e8753a3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}-3 \\\\ 4\\end{aligned}]" :db/id #edb/ref 17592186393437}] :answer-field/correct {:answer/id #uuid "9e1aa637-1399-5be1-8754-cfd06e8753a3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}-3 \\\\ 4\\end{aligned}]" :db/id #edb/ref 17592186393437} :answer-field/id #uuid "3d0c3af7-ad97-5864-bf2c-f087f946215b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186393432}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "96c9c6b4-4b9d-5bd8-af24-21ff4fd8965e" :question/math-academy-id "q-74762" :question/problem "If $\\,T\\,$ is a linear transformation and $\\,T([\\begin{aligned}4 \\\\ 12\\end{aligned}])=[\\begin{aligned}-12 \\\\ 16\\end{aligned}]$, then find $\\,T([\\begin{aligned}1 \\\\ 3\\end{aligned}]).$" :question/worked-solution "Since $T$ is a linear transformation, it must satisfy $T(kv)=kT(v).$ Noting that $[\\begin{aligned}4 \\\\ 12\\end{aligned}]=4[\\begin{aligned}1 \\\\ 3\\end{aligned}],$ we have\n\n$$\n\\begin{aligned}T([\\begin{aligned}4 \\\\ 12\\end{aligned}]) & =T(4[\\begin{aligned}1 \\\\ 3\\end{aligned}])=4T([\\begin{aligned}1 \\\\ 3\\end{aligned}]).\\end{aligned}\n$$\n\nNow, since we're told that \n\n$$\nT([\\begin{aligned}4 \\\\ 12\\end{aligned}])=[\\begin{aligned}-12 \\\\ 16\\end{aligned}],\n$$\n\nwe must have\n\n$$\n\\begin{aligned}4T([\\begin{aligned}1 \\\\ 3\\end{aligned}]) & =[\\begin{aligned}-12 \\\\ 16\\end{aligned}] \\\\ T([\\begin{aligned}1 \\\\ 3\\end{aligned}]) & =\\frac{1}{4}[\\begin{aligned}-12 \\\\ 16\\end{aligned}] \\\\ T([\\begin{aligned}1 \\\\ 3\\end{aligned}]) & =[\\begin{aligned}-3 \\\\ 4\\end{aligned}].\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186344981 :knowledge-point/_questions [{:db/id #edb/ref 17592186087748 :knowledge-point/id #uuid "381f7ffe-ae4b-5e45-9fa9-e2a6bd8348b3" :knowledge-point/title "Determining the Image of a Vector Under a Map Using Vector Addition and Scalar Multiplication"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1e37951b-03d5-5d76-8207-ab35ada60274" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}2 \\\\ 4\\end{aligned}]" :db/id #edb/ref 17592186342489} {:answer/id #uuid "6884287b-be82-539e-a37e-d742e488e1f4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}6 \\\\ 12\\end{aligned}]" :db/id #edb/ref 17592186343130} {:answer/id #uuid "6fd306d4-ea1c-535c-800d-cf76b50ffc31" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}3 \\\\ 2\\end{aligned}]" :db/id #edb/ref 17592186343199} {:answer/id #uuid "bd29d454-d450-573b-992f-b35c8afcb1e6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}-4 \\\\ 3\\end{aligned}]" :db/id #edb/ref 17592186343901} {:answer/id #uuid "e53aba8b-8d6b-5204-b078-e2ccc56fd5f9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}-4 \\\\ 6\\end{aligned}]" :db/id #edb/ref 17592186344254}] :answer-field/correct {:answer/id #uuid "1e37951b-03d5-5d76-8207-ab35ada60274" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}2 \\\\ 4\\end{aligned}]" :db/id #edb/ref 17592186342489} :answer-field/id #uuid "761eb299-8f17-5fa6-8798-80c42abd8f3d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186344706}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "c7ac2355-a1ae-54c5-9e5b-62d94023dff1" :question/math-academy-id "q-74775" :question/problem "Consider a linear transformation $\\,T\\,.$ If $\\,T(3{v}_{1}+7{v}_{2})=[\\begin{aligned}13 \\\\ 5\\end{aligned}]\\,$ and $\\,T({v}_{2})=[\\begin{aligned}1 \\\\ -1\\end{aligned}]$, then find $\\,T({v}_{1}).$" :question/worked-solution "Since $T$ is a linear transformation, we have that\n\n$$\n\\begin{aligned}T(kv+hw)=T(kv)+T(hw)=kT(v)+hT(w)\\end{aligned}\n$$\n\nfor any vectors $v$ and $w.$ Therefore,\n\n$$\n\\begin{aligned}T(3{v}_{1}+7{v}_{2}) & =3T({v}_{1})+7T({v}_{2}) \\\\ [\\begin{aligned}13 \\\\ 5\\end{aligned}] & =3T({v}_{1})+7[\\begin{aligned}1 \\\\ -1\\end{aligned}] \\\\ 3T({v}_{1}) & =[\\begin{aligned}13 \\\\ 5\\end{aligned}]-7[\\begin{aligned}1 \\\\ -1\\end{aligned}] \\\\ 3T({v}_{1}) & =[\\begin{aligned}13 \\\\ 5\\end{aligned}]-[\\begin{aligned}7 \\\\ -7\\end{aligned}] \\\\ 3T({v}_{1}) & =[\\begin{aligned}6 \\\\ 12\\end{aligned}] \\\\ T({v}_{1}) & =\\frac{1}{3}[\\begin{aligned}6 \\\\ 12\\end{aligned}] \\\\ T({v}_{1}) & =[\\begin{aligned}2 \\\\ 4\\end{aligned}].\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186398989 :knowledge-point/_questions [{:db/id #edb/ref 17592186087749 :knowledge-point/id #uuid "9fbd335c-28cc-5f02-b773-f685e8b15417" :knowledge-point/title "Determining the Image of a Vector Sum Under a Map Using Vector Addition and Scalar Multiplication"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a9149cf2-edbf-544d-9c0f-90c2f55edc73" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}63 \\\\ 51 \\\\ -42\\end{aligned}]" :db/id #edb/ref 17592186398991} {:answer/id #uuid "1f624e49-b4d8-5481-a766-3d48a04ffb70" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}-42 \\\\ -34 \\\\ 28\\end{aligned}]" :db/id #edb/ref 17592186398992} {:answer/id #uuid "f08777ee-7bc2-552d-b942-d0cc1bce2816" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}-21 \\\\ -17 \\\\ 14\\end{aligned}]" :db/id #edb/ref 17592186398993} {:answer/id #uuid "05991325-fa66-564d-8673-e9450a190897" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}-63 \\\\ -51 \\\\ 42\\end{aligned}]" :db/id #edb/ref 17592186398994} {:answer/id #uuid "91bbea6d-c7c9-55fe-bfcc-d43e664cab17" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}42 \\\\ 34 \\\\ -28\\end{aligned}]" :db/id #edb/ref 17592186398995}] :answer-field/correct {:answer/id #uuid "91bbea6d-c7c9-55fe-bfcc-d43e664cab17" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}42 \\\\ 34 \\\\ -28\\end{aligned}]" :db/id #edb/ref 17592186398995} :answer-field/id #uuid "8bb35426-6c4d-5808-82e6-12f94e6cdf85" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186398990}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "7e4e42a9-e81d-5610-8794-d5c4cdbe24ee" :question/math-academy-id "q-74781" :question/problem "Consider a linear transformation $\\,T\\,.$ If $\\,{v}_{1}+{v}_{2}=0\\,$ and $\\,T({v}_{2})=[\\begin{aligned}21 \\\\ 17 \\\\ -14\\end{aligned}]\\,$, find $\\,T(37{v}_{1}+39{v}_{2}).$" :question/worked-solution "First, we have that \n\n$$\n\\begin{aligned}37{v}_{1}+39{v}_{2} & =37{v}_{1}+37{v}_{2}+2{v}_{2} \\\\  & =37({v}_{1}+{v}_{2})+2{v}_{2} \\\\  & =37(0)+2{v}_{2} \\\\  & =2{v}_{2}.\\end{aligned}\n$$\n\nTherefore, we have\n\n$$\nT(37{v}_{1}+39{v}_{2})=T(2{v}_{2}).\n$$\n\n \n\nNow, since $T$ is a linear transformation, we have that $T(kv)=kT(v).$ So \n\n$$\n\\begin{aligned}T(2{v}_{2}) & =2T({v}_{2}) \\\\  & =2[\\begin{aligned}21 \\\\ 17 \\\\ -14\\end{aligned}] \\\\  & =[\\begin{aligned}42 \\\\ 34 \\\\ -28\\end{aligned}].\\end{aligned}\n$$\n\nIn conclusion, $T(37{v}_{1}+39{v}_{2})=[\\begin{aligned}42 \\\\ 34 \\\\ -28\\end{aligned}].$"}]}
