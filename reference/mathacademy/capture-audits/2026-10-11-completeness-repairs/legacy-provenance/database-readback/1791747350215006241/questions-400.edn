:answer/value "\\begin{bmatrix}6 & 7 \\\\ 4 & 5\\end{bmatrix}" :db/id #edb/ref 17592186098123} {:answer/id #uuid "39e8426c-e203-5fdf-a93f-111238c8159f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}0 & 0 \\\\ 0 & 0\\end{bmatrix}" :db/id #edb/ref 17592186098124} {:answer/id #uuid "71f20d62-7872-5e37-97e9-a23e08aef59f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}5 & 7 \\\\ 7 & 5\\end{bmatrix}" :db/id #edb/ref 17592186098125} {:answer/id #uuid "75cc67b5-2545-59dc-9edf-f9e64c9bb09e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}5 & 1 \\\\ 6 & 8\\end{bmatrix}" :db/id #edb/ref 17592186098126}] :answer-field/id #uuid "11b67b69-785c-5ae0-bd01-ea693dbbfc6c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186098121} {:answer-field/choices [{:answer/id #uuid "8f88e9a5-8759-5e71-b262-00b079bef50f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}0 & 0 \\\\ 0 & 0\\end{aligned}]" :db/id #edb/ref 17592186388343} {:answer/id #uuid "f2609425-f61f-5689-a1b2-ad1766ba4f2d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}5 & 1 \\\\ 6 & 8\\end{aligned}]" :db/id #edb/ref 17592186388344} {:answer/id #uuid "065fbb44-49f9-5677-ae45-0db8eae4e9ff" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}5 & 7 \\\\ 7 & 5\\end{aligned}]" :db/id #edb/ref 17592186388345} {:answer/id #uuid "6d7d6d9c-e6a7-5790-92dd-e8b2bca71761" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}6 & 7 \\\\ 4 & 5\\end{aligned}]" :db/id #edb/ref 17592186388346} {:answer/id #uuid "b7fb0aa4-9a2d-5c94-a1be-3f68d1da0be1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}3 & 2 \\\\ 2 & 3\\end{aligned}]" :db/id #edb/ref 17592186388347}] :answer-field/correct {:answer/id #uuid "6d7d6d9c-e6a7-5790-92dd-e8b2bca71761" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}6 & 7 \\\\ 4 & 5\\end{aligned}]" :db/id #edb/ref 17592186388346} :answer-field/id #uuid "aefbe9b4-2591-5f99-bd99-dce5ef9f6719" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186388342}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "60ff0898-484c-5468-ab70-2a2b8951960b" :question/math-academy-id "q-13536" :question/problem "Find $(A+B)-C-(B-C)$, if\n\n$$\nA=[\\begin{aligned}6 & 7 \\\\ 4 & 5\\end{aligned}],\\,B=[\\begin{aligned}3 & 2 \\\\ 2 & 3\\end{aligned}],\\,C=[\\begin{aligned}5 & 1 \\\\ 6 & 8\\end{aligned}].\n$$" :question/worked-solution "First, we simplify the expression by distributing the subtraction over the matrices in the parentheses:\n\n$$\n\\begin{aligned}(A+B)-C-(B-C) & =A+B-C-B+C \\\\  & =A+\\cancel{B}-\\cancel{C}-\\cancel{B}+\\cancel{C} \\\\  & =A\\end{aligned}\n$$\n\nWe are left with a single matrix. So, the result is \n\n$$\n\\begin{aligned}A & =[\\begin{aligned}6 & 7 \\\\ 4 & 5\\end{aligned}]\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186388403 :knowledge-point/_questions [{:db/id #edb/ref 17592186100868 :knowledge-point/id #uuid "8451e22a-247e-51dd-8fb1-9ce9b212dc65" :knowledge-point/title "Multiplying a Matrix With Variable Entries by a Column Vector"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6dac886f-ec90-5d08-838c-5a59cf7394ee" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}-7b \\\\ -7c\\end{aligned}]" :db/id #edb/ref 17592186388405} {:answer/id #uuid "5a12801a-3fc5-59fe-a868-0dd7454f9d59" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}7c \\\\ 7c\\end{aligned}]" :db/id #edb/ref 17592186388406} {:answer/id #uuid "9c65430b-d3c0-5549-805e-9c2f4dc62591" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}7b \\\\ 7c\\end{aligned}]" :db/id #edb/ref 17592186388407} {:answer/id #uuid "2ca00378-b5c5-5906-96a7-630208843a2d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}7b \\\\ 7b\\end{aligned}]" :db/id #edb/ref 17592186388408} {:answer/id #uuid "b66bb36e-56a0-54a6-bcba-44591ba41152" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}7c \\\\ 7b\\end{aligned}]" :db/id #edb/ref 17592186388409}] :answer-field/correct {:answer/id #uuid "9c65430b-d3c0-5549-805e-9c2f4dc62591" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}7b \\\\ 7c\\end{aligned}]" :db/id #edb/ref 17592186388407} :answer-field/id #uuid "00031ac6-c3f2-5a96-85f9-1258053acaf3" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186388404}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "89271958-955e-55b3-a956-b8c8b5250728" :question/math-academy-id "q-13556" :question/problem "Find $By$  if \n$B=[\\begin{aligned}b & b \\\\ c & c\\end{aligned}]$\nand\n$y=[\\begin{aligned}3 \\\\ 4\\end{aligned}].$" :question/worked-solution "We multiply each row in the matrix by the column vector using the dot product: \n\n$$\n\\begin{aligned}By & =[\\begin{aligned}b & b \\\\ c & c\\end{aligned}][\\begin{aligned}3 \\\\ 4\\end{aligned}] \\\\  & =[\\begin{aligned}b\\cdot 3+b\\cdot 4 \\\\ c\\cdot 3+c\\cdot 4\\end{aligned}] \\\\  & =[\\begin{aligned}3b+4b \\\\ 3c+4c\\end{aligned}] \\\\  & =[\\begin{aligned}7b \\\\ 7c\\end{aligned}]\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186101136 :knowledge-point/_questions [{:db/id #edb/ref 17592186100866 :knowledge-point/id #uuid "ff414112-3be2-5b9c-9ded-5025ea05c2b4" :knowledge-point/title "Multiplying a 2x2 Matrix by a Column Vector"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "91719962-a9c9-5473-af93-ea01ef1b4602" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-4 \\\\ 4\\end{bmatrix}" :db/id #edb/ref 17592186098152} {:answer/id #uuid "efdc264d-beb8-5142-9bc0-cfe6ee14fd5d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}4 \\\\ 4\\end{bmatrix}" :db/id #edb/ref 17592186098153} {:answer/id #uuid "300c52bd-1c58-5163-a5c0-19ae05be86e3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}4 \\\\ -4\\end{bmatrix}" :db/id #edb/ref 17592186098154} {:answer/id #uuid "3a610c49-d9ef-5021-9d2e-f11037ff20cd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}4 \\\\ 2\\end{bmatrix}" :db/id #edb/ref 17592186098155} {:answer/id #uuid "7eb70040-131f-5161-adab-840651894fb9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-4 \\\\ -4\\end{bmatrix}" :db/id #edb/ref 17592186098156}] :answer-field/id #uuid "da02eab7-5575-5dba-bf83-14a67bd5b414" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186098151} {:answer-field/choices [{:answer/id #uuid "5ce47e15-8a71-5a0e-877b-8161ee17ff71" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}-4 \\\\ 4\\end{aligned}]" :db/id #edb/ref 17592186388418} {:answer/id #uuid "84d4840e-ffea-5fc0-bd15-47e2b8b3ee8c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}4 \\\\ 2\\end{aligned}]" :db/id #edb/ref 17592186388419} {:answer/id #uuid "a052459a-e452-5bfb-9115-9b9d15dcfb91" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}4 \\\\ 4\\end{aligned}]" :db/id #edb/ref 17592186388420} {:answer/id #uuid "b4829af7-c55a-5072-9da4-2384966bfee9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}-4 \\\\ -4\\end{aligned}]" :db/id #edb/ref 17592186388421} {:answer/id #uuid "f605914a-ff93-5823-885b-2509f3adee21" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}4 \\\\ -4\\end{aligned}]" :db/id #edb/ref 17592186388422}] :answer-field/correct {:answer/id #uuid "f605914a-ff93-5823-885b-2509f3adee21" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}4 \\\\ -4\\end{aligned}]" :db/id #edb/ref 17592186388422} :answer-field/id #uuid "ef949d1a-3425-5215-bdb0-047bedfe1e0b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186388417}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "c6f60840-c1ce-5025-8b9b-ed8f00fe0d5e" :question/math-academy-id "q-13564" :question/problem "Find $Ax$ if \n$A=[\\begin{aligned}-6 & 4 \\\\ 8 & -5\\end{aligned}]$\nand\n$x=[\\begin{aligned}2 \\\\ 4\\end{aligned}].$" :question/worked-solution "We multiply each row in the matrix by the column vector using the dot product. Multiplying the first row, we get\n\n$$\n\\begin{aligned}[\\begin{aligned}-6 & 4 \\\\ 8 & -5\\end{aligned}][\\begin{aligned}2 \\\\ 4\\end{aligned}] & =[\\begin{aligned}(-6)\\cdot 2+4\\cdot 4 \\\\ ∗\\end{aligned}]=[\\begin{aligned}4 \\\\ ∗\\end{aligned}].\\end{aligned}\n$$\n\nMultiplying the second row, we get\n\n$$\n\\begin{aligned}[\\begin{aligned}-6 & 4 \\\\ 8 & -5\\end{aligned}][\\begin{aligned}2 \\\\ 4\\end{aligned}] & =[\\begin{aligned}4 \\\\ 8\\cdot 2+(-5)\\cdot 4\\end{aligned}]=[\\begin{aligned}4 \\\\ -4\\end{aligned}].\\end{aligned}\n$$\n\nTherefore, \n$Ax=[\\begin{aligned}4 \\\\ -4\\end{aligned}].$"}] [{:db/id #edb/ref 17592186269094 :knowledge-point/_questions [{:db/id #edb/ref 17592186100891 :knowledge-point/id #uuid "fd3b5e36-46db-5d34-92e2-eefb7e0e95c8" :knowledge-point/title "Finding the First Few Terms of a Binomial Expansion"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "85685afe-fb39-55da-b177-70712435f681" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "81+108x+54{x}^{2}+⋯" :db/id #edb/ref 17592186267320} {:answer/id #uuid "8bd67713-aa7c-5aa1-9560-21f69317d1f5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "27+108x+54{x}^{2}+⋯" :db/id #edb/ref 17592186267397} {:answer/id #uuid "c0658cf8-fae6-5960-bc9b-561c5ac765bd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "81+27x+9{x}^{2}+⋯" :db/id #edb/ref 17592186267865} {:answer/id #uuid "f09f36b2-37bc-5feb-b758-a54412e15ed1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "81+27x+54{x}^{2}+⋯" :db/id #edb/ref 17592186268283} {:answer/id #uuid "fbd8910a-e2b8-5637-8c7c-0e8b1d61bfcd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "81+108x+9{x}^{2}+⋯" :db/id #edb/ref 17592186268370}] :answer-field/correct {:answer/id #uuid "85685afe-fb39-55da-b177-70712435f681" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "81+108x+54{x}^{2}+⋯" :db/id #edb/ref 17592186267320} :answer-field/id #uuid "ee659c3f-f706-53fd-95d3-de18d2403960" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186268823}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "7cf853ca-6a16-5936-9604-4bf59d63715b" :question/math-academy-id "q-136002" :question/problem "$(3+x)^{4}=$" :question/worked-solution "The binomial theorem states that for any positive integer $n,$ we have\n\n \n\n$$\n(a+b)^{n}=(\\frac{n}{0}){a}^{n}{b}^{0}+(\\frac{n}{1}){a}^{n-1}{b}^{1}+(\\frac{n}{2}){a}^{n-2}{b}^{2}+⋯+(\\frac{n}{n}){a}^{0}{b}^{n}.\n$$\n\nIn the case of $(3+x)^{4},$ we have  $a=3,$ $b=x,$ $n=4.$ \n\nTherefore, the first three terms of $(3+x)^{4}$ are as follows:\n\n$$\n\\begin{aligned}{(3+x)}^{4} & =(\\frac{4}{0}){(3)}^{4}{(x)}^{0}+(\\frac{4}{1}){(3)}^{4-1}{(x)}^{1}+(\\frac{4}{2}){(3)}^{4-2}{(x)}^{2}+⋯ \\\\  & =1{(3)}^{4}+4{(3)}^{3}{(x)}^{1}+6{(3)}^{2}{(x)}^{2}+⋯ \\\\  & =81+108x+54{x}^{2}+⋯.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186269098 :knowledge-point/_questions [{:db/id #edb/ref 17592186100954 :knowledge-point/id #uuid "29896622-4bcb-5ad2-91d0-47c5911a619e" :knowledge-point/title "Finding the First Few Terms of an Expansion With Negative Coefficients"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "92de9a4d-adde-5d21-9a44-c4fe7eae58e0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "16{x}^{5}+80{x}^{4}y+80{x}^{3}{y}^{2}+⋯" :db/id #edb/ref 17592186267456} {:answer/id #uuid "93132ebd-dc50-541e-8f68-35c204bb7b00" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "32{x}^{5}-16{x}^{4}y-8{x}^{3}{y}^{2}+⋯" :db/id #edb/ref 17592186267459} {:answer/id #uuid "a4d1deaf-c76c-50f6-8fd5-3bd05a380230" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "32{x}^{5}-80{x}^{4}y+80{x}^{3}{y}^{2}+⋯" :db/id #edb/ref 17592186267630} {:answer/id #uuid "b9020fcd-56d4-5b84-92bd-7645344e3309" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "32{x}^{5}-16{x}^{4}y+80{x}^{3}{y}^{2}+⋯" :db/id #edb/ref 17592186267804} {:answer/id #uuid "d372e15b-09b2-5957-9a22-edcf439d053d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "32{x}^{5}-80{x}^{4}y+10{x}^{3}{y}^{2}+⋯" :db/id #edb/ref 17592186268031}] :answer-field/correct {:answer/id #uuid "a4d1deaf-c76c-50f6-8fd5-3bd05a380230" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "32{x}^{5}-80{x}^{4}y+80{x}^{3}{y}^{2}+⋯" :db/id #edb/ref 17592186267630} :answer-field/id #uuid "f5c4ce6d-6e8f-50f5-a6b2-8730784d8e35" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186268838}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "b1f57d7b-a958-55ab-a552-4e907ee5b53e" :question/math-academy-id "q-136012" :question/problem "${(2x-y)}^{5}=$" :question/worked-solution "The binomial theorem states that for any positive integer $n,$ we have\n\n \n\n$$\n(a+b)^{n}=(\\frac{n}{0}){a}^{n}{b}^{0}+(\\frac{n}{1}){a}^{n-1}{b}^{1}+(\\frac{n}{2}){a}^{n-2}{b}^{2}+⋯+(\\frac{n}{n}){a}^{0}{b}^{n}.\n$$\n\nIn the case of ${(2x-y)}^{5},$ we have  $a=2x,$ $b=-y,$ $n=5.$ \n\nTherefore, the first three terms of ${(2x-y)}^{5}$ are as follows:\n\n$$\n\\begin{aligned}(2x-y)^{5} & =(\\frac{5}{0})(2x)^{5}(-y)^{0}+(\\frac{5}{1})(2x)^{5-1}(-y)^{1}+(\\frac{5}{2})(2x)^{5-2}(-y)^{2}+⋯ \\\\  & =1(2x)^{5}+5(2x)^{4}(-y)+10(2x)^{3}(-y)^{2}+⋯ \\\\  & =32{x}^{5}-80{x}^{4}y+80{x}^{3}{y}^{2}+⋯.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186269100 :knowledge-point/_questions [{:db/id #edb/ref 17592186100954 :knowledge-point/id #uuid "29896622-4bcb-5ad2-91d0-47c5911a619e" :knowledge-point/title "Finding the First Few Terms of an Expansion With Negative Coefficients"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0a64923f-e9ca-5125-ac6a-140a5b5076d7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{x}^{8}-8{x}^{7}y+28{x}^{6}{y}^{2}+⋯" :db/id #edb/ref 17592186266237} {:answer/id #uuid "302e6a79-c731-5c9b-9923-3a042c55b509" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{x}^{8}-7{x}^{7}y+28{x}^{6}{y}^{2}+⋯" :db/id #edb/ref 17592186266568} {:answer/id #uuid "51dda2cc-97ce-59b3-a5e5-77a0f7d25aed" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{x}^{8}-8{x}^{7}y+14{x}^{6}{y}^{2}+⋯" :db/id #edb/ref 17592186266876} {:answer/id #uuid "aaa5d87f-dec7-5bbc-94cc-0e64238040dd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{x}^{8}-8{x}^{7}y-14{x}^{6}{y}^{2}+⋯" :db/id #edb/ref 17592186267688} {:answer/id #uuid "ecbf3c63-3c89-50eb-807f-78f0383905c6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{x}^{8}+8{x}^{7}y+28{x}^{6}{y}^{2}+⋯" :db/id #edb/ref 17592186268248}] :answer-field/correct {:answer/id #uuid "0a64923f-e9ca-5125-ac6a-140a5b5076d7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{x}^{8}-8{x}^{7}y+28{x}^{6}{y}^{2}+⋯" :db/id #edb/ref 17592186266237} :answer-field/id #uuid "56428909-ad51-5b91-8c44-a2c7c5603c1e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186268562}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "4bfb4f9e-e9db-5bd6-a1f7-0c71987ddffc" :question/math-academy-id "q-136015" :question/problem "${(x-y)}^{8}=$" :question/worked-solution "The binomial theorem states that for any positive integer $n,$ we have\n\n \n\n$$\n(a+b)^{n}=(\\frac{n}{0}){a}^{n}{b}^{0}+(\\frac{n}{1}){a}^{n-1}{b}^{1}+(\\frac{n}{2}){a}^{n-2}{b}^{2}+⋯+(\\frac{n}{n}){a}^{0}{b}^{n}.\n$$\n\nIn the case of ${(x-y)}^{8},$ we have  $a=x,$ $b=-y,$ $n=8.$ \n\nTherefore, the first three terms of ${(x-y)}^{8}$ are as follows:\n\n$$\n\\begin{aligned}{(x-y)}^{8} & =(\\frac{8}{0}){(x)}^{8}{(-y)}^{0}+(\\frac{8}{1}){(x)}^{8-1}{(-y)}^{1}+(\\frac{8}{2}){(x)}^{8-2}{(-y)}^{2}+⋯ \\\\  & =1{(x)}^{8}+8{(x)}^{7}{(-y)}^{1}+28{(x)}^{6}{(-y)}^{2}+⋯ \\\\  & ={x}^{8}-8{x}^{7}y+28{x}^{6}{y}^{2}+⋯.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186269103 :knowledge-point/_questions [{:db/id #edb/ref 17592186083306 :knowledge-point/id #uuid "a75b47ec-8d5a-545e-b915-daca92320322" :knowledge-point/title "Identifying Non-Roots of a Polynomial Using the Rational Roots Theorem"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1482f361-3b1e-543f-870b-a26dcf92d2ca" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186266319} {:answer/id #uuid "2870d2f6-a4e4-5d62-a218-0e3e5a8a8827" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186266504} {:answer/id #uuid "447ea00c-4d69-5351-8ae6-7fb524a5e59a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "10" :db/id #edb/ref 17592186266757} {:answer/id #uuid "ab240971-126a-51ed-95e8-caf2152e97e6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{3}" :db/id #edb/ref 17592186267690} {:answer/id #uuid "fda09780-5082-5dc7-9e43-74a04e529440" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186268378}] :answer-field/correct {:answer/id #uuid "fda09780-5082-5dc7-9e43-74a04e529440" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186268378} :answer-field/id #uuid "466acc84-20e7-58f4-bf70-73eea0fa85ba" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186268526}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "54404730-020a-547b-8cd2-8751476ed4d0" :question/math-academy-id "q-13613" :question/problem "According to the rational roots theorem, which of the following **cannot** be a root of the polynomial $f(x)=3{x}^{3}+10{x}^{2}-23x+10?$" :question/worked-solution "Given a polynomial with integer coefficients, the rational roots theorem states that any rational roots of the polynomial must take the form\n\n$$\n\\pm \\frac{\\text{factor of the constant term}}{\\text{factor of the leading coefficient}}.\n$$\n\nFor the given polynomial $f(x),$ the constant term is $10$ and the leading coefficient is $3.$ So, any rational roots of $f(x)$ must take the form\n\n$$\n\\pm \\frac{\\text{factor of }10}{\\text{factor of }3}.\n$$\n\nOf the given answer choices, only $3$ does not take the above form. The value $3$ can be interpreted as a fraction $\\frac{3}{1},$ and the numerator $(3)$ is not a factor of $10.$"}] [{:db/id #edb/ref 17592186129479 :knowledge-point/_questions [{:db/id #edb/ref 17592186129250 :knowledge-point/id #uuid "c5146ef7-bd48-5d0d-903d-882d739b92c7" :knowledge-point/title "Calculating the Acceleration of a Particle"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3d7f5d51-7683-5a82-9525-98eb244d2f83" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4i\\,{\\text{m/s}}^{2}" :db/id #edb/ref 17592186266689} {:answer/id #uuid "587535b4-bbbc-5fbf-8d54-9f57ff050e73" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(2i+4j)\\,{\\text{m/s}}^{2}" :db/id #edb/ref 17592186266933} {:answer/id #uuid "7eee6282-f69e-54c9-9891-a06d8430264f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(i+2j)\\,{\\text{m/s}}^{2}" :db/id #edb/ref 17592186267262} {:answer/id #uuid "85ff45d3-1ddf-5689-a028-b082d923294e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0\\,{\\text{m/s}}^{2}" :db/id #edb/ref 17592186267326} {:answer/id #uuid "d3d12796-1206-5263-a7e3-9ae46a92f8ad" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(i-2j)\\,{\\text{m/s}}^{2}" :db/id #edb/ref 17592186268032}] :answer-field/correct {:answer/id #uuid "7eee6282-f69e-54c9-9891-a06d8430264f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(i+2j)\\,{\\text{m/s}}^{2}" :db/id #edb/ref 17592186267262} :answer-field/id #uuid "70e965d0-274c-50d0-a3ff-930639d3fa69" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186268615}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "1d30498e-757c-511b-b142-9c3f837aad12" :question/math-academy-id "q-136289" :question/problem "A particle moves with constant acceleration. When $t=0\\,\\text{s},$ the velocity of the particle is $(-2i-8j)\\,\\text{m/s},$ and when $t=4\\,\\text{s},$ the velocity of the particle is $2i\\,\\text{m/s}.$ Calculate the acceleration of the particle." :question/worked-solution "Recall that when a particle moves with constant acceleration, the velocity vector at time $t$ can be found using\n\n$$\nv=u+at,\n$$\n\nwhere $u$ is the initial velocity, and $a$ is the acceleration of the particle.\n\nSubstituting \n\n$$\nu=-2i-8j,\\,v=2i,\\,t=4,\n$$\n\ninto the equation above, we can solve for $a,$ as follows:\n\n$$\n\\begin{aligned}v & =u+at \\\\ 2i & =(-2i-8j)+a(4) \\\\ 4i+8j & =4a \\\\ a & =\\frac{1}{4}(4i+8j) \\\\  & =(i+2j)\\,{\\text{m/s}}^{2}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186129481 :knowledge-point/_questions [{:db/id #edb/ref 17592186129252 :knowledge-point/id #uuid "93d45138-b681-55c0-8910-1400bdf717c5" :knowledge-point/title "Finding the Time when a Particle Reaches a Particular Velocity"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d039f4a6-471f-5a6d-8c7b-7b6f20da9885" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "t = 1s" :db/id #edb/ref 17592186126387} {:answer/id #uuid "d6fbc6ac-7bd1-59a8-ba1b-7358d4ca8319" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "No solution" :db/id #edb/ref 17592186126388} {:answer/id #uuid "ed75ad4e-24ff-5a53-9276-d9d4a0a10469" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "t = 3s" :db/id #edb/ref 17592186126389} {:answer/id #uuid "408ad7c7-e164-5b6a-884f-a6633e2eeb97" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "t = 2s" :db/id #edb/ref 17592186126390} {:answer/id #uuid "6cfe880c-c6a0-563e-aa89-65dcabd2f744" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "t = 6s" :db/id #edb/ref 17592186126391}] :answer-field/id #uuid "95824ee1-eaa5-5a70-8ab3-8de0d1f815bf" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186126386} {:answer-field/choices [{:answer/id #uuid "71811c86-dfc1-5f5a-a4b3-51b613597427" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "t=3\\,\\text{s}" :db/id #edb/ref 17592186400738} {:answer/id #uuid "14045dd5-56a2-56b3-8a1b-32ff353cc995" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "t=1\\,\\text{s}" :db/id #edb/ref 17592186400739} {:answer/id #uuid "9dfea80d-d958-5442-ae1c-80f233864941" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "No solution" :db/id #edb/ref 17592186400740} {:answer/id #uuid "61d086d5-f1b1-5ae6-a501-43af3ee40f2b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "t=6\\,\\text{s}" :db/id #edb/ref 17592186400741} {:answer/id #uuid "30c355e9-d6a5-5ca6-8952-9e4063f7db10" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "t=2\\,\\text{s}" :db/id #edb/ref 17592186400742}] :answer-field/correct {:answer/id #uuid "71811c86-dfc1-5f5a-a4b3-51b613597427" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "t=3\\,\\text{s}" :db/id #edb/ref 17592186400738} :answer-field/id #uuid "2bdb9de5-d1fb-5bbe-8ab8-96d3464f5245" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186400737}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "7c82e497-5ec7-5624-8331-c5c43f9eb1a8" :question/math-academy-id "q-136291" :question/problem "A particle moves with a constant acceleration of $(3i+2j)\\,{\\text{m/s}}^{2}.$ The velocity of the particle is $(-7i-6j)\\,\\text{m/s}$ when $t=0\\,\\text{s}.$ Find the time when the velocity of the particle equals $2i\\,\\text{m/s}.$" :question/worked-solution "Recall that when a particle moves with constant acceleration, the velocity vector at time $t$ can be found using\n\n$$\nv=u+at,\n$$\n\nwhere $u$ is the initial velocity, and $a$ is the acceleration of the particle.\n\nSubstituting \n\n$$\na=3i+2j,\\,u=-7i-6j,\\,v=2i\n$$\n\ninto the equation above, we can solve for $t,$ as follows:\n\n$$\n\\begin{aligned}v & =u+at \\\\ 2i & =(-7i-6j)+(3i+2j)t \\\\ 9i+6j & =(3i+2j)t \\\\ 9i+6j & =3ti+2tj\\end{aligned}\n$$\n\nEquating the $i$ and $j$ components in the last equation, we obtain\n\n$$\n{\\begin{aligned}9=3t \\\\ 6=2t\\end{aligned}\\,⟹\\,t=3\\,\\text{s}.\n$$"}] [{:db/id #edb/ref 17592186398396 :knowledge-point/_questions [{:db/id #edb/ref 17592186129249 :knowledge-point/id #uuid "0118bf72-c730-59f1-b722-85ed779f96c7" :knowledge-point/title "Calculating the Speed of a Particle Given Its Velocity"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d1defb76-8459-59c2-b2f3-882cb40db2b2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4.73\\,\\text{m/s}" :db/id #edb/ref 17592186398398} {:answer/id #uuid "7a65e5ff-4a0a-57d3-b7ca-a7d4f13983ee" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4.65\\,\\text{m/s}" :db/id #edb/ref 17592186398399} {:answer/id #uuid "b99284b1-cb82-5a09-9287-93038bc13098" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6.31\\,\\text{m/s}" :db/id #edb/ref 17592186398400} {:answer/id #uuid "8d65d6c2-39d1-54ee-8ec9-fbbb46896c9b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5.39\\,\\text{m/s}" :db/id #edb/ref 17592186398401} {:answer/id #uuid "881312cb-f0f1-5c91-a009-dd847f6069d3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5.67\\,\\text{m/s}" :db/id #edb/ref 17592186398402}] :answer-field/correct {:answer/id #uuid "8d65d6c2-39d1-54ee-8ec9-fbbb46896c9b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5.39\\,\\text{m/s}" :db/id #edb/ref 17592186398401} :answer-field/id #uuid "3da23e5a-3f1a-58d5-8634-9889dc453786" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186398397}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "9d9adc28-1eef-586b-9169-6940ecdacba5" :question/math-academy-id "q-136311" :question/problem "A particle moves with a constant velocity of $u=(2i-5j)\\,\\text{m/s}.$ Find the speed of the particle, rounding your answer to two decimal places." :question/worked-solution "The speed of a particle equals the magnitude of its velocity.\n\nTherefore, the speed of the particle is\n\n$$\n\\begin{aligned}|u| & =|2i-5j| \\\\  & =\\sqrt{{2}^{2}+(-5)^{2}} \\\\  & =\\sqrt{4+25} \\\\  & =\\sqrt{29} \\\\  & ≈5.39\\,\\text{m/s}\\end{aligned}\n$$\n\nrounded to two decimal places."}] [{:db/id #edb/ref 17592186398403 :knowledge-point/_questions [{:db/id #edb/ref 17592186129249 :knowledge-point/id #uuid "0118bf72-c730-59f1-b722-85ed779f96c7" :knowledge-point/title "Calculating the Speed of a Particle Given Its Velocity"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1e2cbc40-aff5-51fc-94bf-9cdd5efe425d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2.24\\,\\text{km/h}" :db/id #edb/ref 17592186398405} {:answer/id #uuid "5b06ec27-4c21-5388-b505-c3433887b18b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3.87\\,\\text{km/h}" :db/id #edb/ref 17592186398406} {:answer/id #uuid "a6786566-636d-5a9e-99c4-6379cbca69d5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3.18\\,\\text{km/h}" :db/id #edb/ref 17592186398407} {:answer/id #uuid "9a080ec3-eeda-503e-b3b6-a01029c4818a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4.68\\,\\text{km/h}" :db/id #edb/ref 17592186398408} {:answer/id #uuid "d90f3ba8-6541-5bde-87ef-cde3025c3006" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4.12\\,\\text{km/h}" :db/id #edb/ref 17592186398409}] :answer-field/correct {:answer/id #uuid "d90f3ba8-6541-5bde-87ef-cde3025c3006" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4.12\\,\\text{km/h}" :db/id #edb/ref 17592186398409} :answer-field/id #uuid "7bfbd15d-6ca5-5972-85ed-d1d5920988e9" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186398404}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "ede10ea1-892c-5590-9caf-f40ffde6984b" :question/math-academy-id "q-136312" :question/problem "A particle moves with a constant velocity of $u=(i+4j)\\,\\text{km/h}.$ Find the speed of the particle, rounding your answer to two decimal places." :question/worked-solution "The speed of a particle equals the magnitude of its velocity.\n\nTherefore, the speed of the particle is\n\n$$\n\\begin{aligned}|u| & =|i+4j| \\\\  & =\\sqrt{{1}^{2}+{4}^{2}} \\\\  & =\\sqrt{1+16} \\\\  & =\\sqrt{17} \\\\  & ≈4.12\\,\\text{km/h}\\end{aligned}\n$$\n\nrounded to two decimal places."}] [{:db/id #edb/ref 17592186388444 :knowledge-point/_questions [{:db/id #edb/ref 17592186129251 :knowledge-point/id #uuid "7439a96f-07b1-5673-a103-af2c63c25d18" :knowledge-point/title "Calculating the Final Velocity of a Particle"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2b37ee1f-dc1b-5f76-a557-bc8f46566879" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(11i+10j)\\,\\text{km/h}" :db/id #edb/ref 17592186388446} {:answer/id #uuid "044eade9-f6a1-5126-80a9-a709b87c30c5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-6i+24j)\\,\\text{km/h}" :db/id #edb/ref 17592186388447} {:answer/id #uuid "263564a9-1fce-52d4-a819-63af9a57766d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(13i+10j)\\,\\text{km/h}" :db/id #edb/ref 17592186388448} {:answer/id #uuid "973e2d24-b37b-5c7e-b887-ee5e71bb10a5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(i+5j)\\,\\text{km/h}" :db/id #edb/ref 17592186388449} {:answer/id #uuid "3dac51de-8735-51e0-84c2-ae1fef014883" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(11i+6j)\\,\\text{km/h}" :db/id #edb/ref 17592186388450}] :answer-field/correct {:answer/id #uuid "2b37ee1f-dc1b-5f76-a557-bc8f46566879" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(11i+10j)\\,\\text{km/h}" :db/id #edb/ref 17592186388446} :answer-field/id #uuid "1437a6cb-f3bb-5357-a2e0-21c7c316e019" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186388445}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "475b8376-b64f-5b88-84dc-3087e08b2993" :question/math-academy-id "q-136341" :question/problem "The velocity of a particle is $(-i+4j)\\,\\text{km/h}$ when $t=0\\,\\text{h}.$ If the particle moves with a constant acceleration of $(2i+j)\\,{\\text{km/h}}^{2},$ find the velocity of the particle when $t=6\\,\\text{h}.$" :question/worked-solution "Recall that when a particle moves with constant acceleration, the velocity vector at time $t$ can be found using\n\n$$\nv=u+at,\n$$\n\nwhere $u$ is the initial velocity, and $a$ is the acceleration of the particle.\n\nHere, we have\n\n$$\nu=-i+4j,\\,a=2i+j.\n$$\n\nTherefore, after $t=6\\,\\text{h},$ the velocity of the particle will be\n\n$$\n\\begin{aligned}v & =u+at \\\\  & =(-i+4j)+(2i+j)(6) \\\\  & =(-i+4j)+(12i+6j) \\\\  & =(11i+10j)\\,\\text{km/h}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186396025 :knowledge-point/_questions [{:db/id #edb/ref 17592186100913 :knowledge-point/id #uuid "3d7d67c6-d54f-5ee1-af59-fd63d6687cfd" :knowledge-point/title "Multiplying a Column-Vector By a Row-Vector"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c534267d-c67a-576d-a7c7-8f05a39d217f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$$\n[\\begin{aligned}0 & 0 \\\\ -2 & -4 \\\\ -3 & -6\\end{aligned}]\n$$" :db/id #edb/ref 17592186396027} {:answer/id #uuid "17ab5397-bb38-59f6-9330-b062d867cf08" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$$\n[\\begin{aligned}1 & 2 \\\\ -2 & -4 \\\\ -3 & -6\\end{aligned}]\n$$" :db/id #edb/ref 17592186396028} {:answer/id #uuid "bbc3f4eb-2bd2-548e-adb8-c1548530611b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$$\n[\\begin{aligned}1 & 0 \\\\ -2 & -4 \\\\ -3 & -6\\end{aligned}]\n$$" :db/id #edb/ref 17592186396029} {:answer/id #uuid "cd31fdfe-ca0b-590b-9300-ed3e228812d5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "Undefined" :db/id #edb/ref 17592186396030} {:answer/id #uuid "abaf4c24-a433-5f0e-9fa5-6f62768c563e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$$\n[\\begin{aligned}0 & 0 \\\\ -2 & -4 \\\\ 3 & -6\\end{aligned}]\n$$" :db/id #edb/ref 17592186396031}] :answer-field/correct {:answer/id #uuid "c534267d-c67a-576d-a7c7-8f05a39d217f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$$\n[\\begin{aligned}0 & 0 \\\\ -2 & -4 \\\\ -3 & -6\\end{aligned}]\n$$" :db/id #edb/ref 17592186396027} :answer-field/id #uuid "cb12cf5d-8771-503b-99b4-cf0f73c56ea7" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186396026}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "0dc1caab-e8b2-5f4c-af54-cbacb852a075" :question/math-academy-id "q-13635" :question/problem "Find $AB$, if \n$A=[\\begin{aligned}0 \\\\ -2 \\\\ -3\\end{aligned}]$\nand \n$B=[\\begin{aligned}1 & 2\\end{aligned}].$" :question/worked-solution "Here, $A$ is $3\\times 1$ matrix and $B$ is a $1\\times 2$ matrix. \n\nThere is $1$ column in matrix $A$ and $1$ row in matrix $B$, so the product is well defined:\n\n$$\n{A}_{3\\times \\boxed{\\text{1}}}{\\cdot }_{✓}{B}_{\\boxed{\\text{1}}\\times 2}={AB}_{3\\times 2}\n$$\n\nComputing the product, we have:\n\n$$\n\\begin{aligned}AB & =[\\begin{aligned}0 \\\\ -2 \\\\ -3\\end{aligned}][\\begin{aligned}1 & 2\\end{aligned}] \\\\  & =[\\begin{aligned}0\\cdot 1 & 0\\cdot 2 \\\\ (-2)\\cdot 1 & (-2)\\cdot 2 \\\\ (-3)\\cdot 1 & (-3)\\cdot 2\\end{aligned}] \\\\  & =[\\begin{aligned}0 & 0 \\\\ -2 & -4 \\\\ -3 & -6\\end{aligned}]\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186176347 :knowledge-point/_questions [{:db/id #edb/ref 17592186176058 :knowledge-point/id #uuid "66a1733a-d7bb-5c86-a154-9e54422053a7" :knowledge-point/title "Utilizing the Oddness Property of the Tangent Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "19df7d47-b87b-5e46-8360-7533c525ec2c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186266358} {:answer/id #uuid "3c2908b8-2ead-5a77-be9f-804bc07bb7fe" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186266672} {:answer/id #uuid "6ccc1b1b-9a04-5bb8-a591-9f5cc4c7efc6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{2}" :db/id #edb/ref 17592186267102} {:answer/id #uuid "8b14d04b-7661-55d9-a6d2-74ec1e93a05a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186267392} {:answer/id #uuid "a5bfc5ef-972c-5d0d-9011-6abdfdf11b45" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186267642}] :answer-field/correct {:answer/id #uuid "19df7d47-b87b-5e46-8360-7533c525ec2c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186266358} :answer-field/id #uuid "a6737d96-a059-592e-9cfb-df4b5f79acd2" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186268703}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "ccd7ae50-1c4e-5bcc-8b8b-d405f5154f0b" :question/math-academy-id "q-136548" :question/problem "If $tan⁡a=-2,$ then $tan⁡(-a)=$" :question/worked-solution "First, let's recall the graph of $y=tan⁡x.$\n\n![](images/df/df1aba3f5ff980de82a74dde8170ad708e379caf2188873bcddc83177e87c7a6.png)\n\nOur graph has rotational symmetry of order $2$ about the origin. If we rotate the graph ${180}^{∘}$ around the origin, we get the same picture. This means that $tan⁡x$ is an *odd* function, and we have\n\n$$\ntan⁡(-x)=-tan⁡x.\n$$\n\nTherefore, \n\n$$\n\\begin{aligned}tan⁡(-a) & =-tan⁡a \\\\  & =-(-2) \\\\  & =2.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186269128 :knowledge-point/_questions [{:db/id #edb/ref 17592186176059 :knowledge-point/id #uuid "d4b378b0-30e5-59a8-b9f7-882b5e226a2e" :knowledge-point/title "Utilizing the Evenness Property of the Secant Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "04ba9a98-d418-5054-94e5-129c6b76bfac" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-12" :db/id #edb/ref 17592186266186} {:answer/id #uuid "19edb75b-03b9-59e8-bc8e-e9f768d59cb2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186266360} {:answer/id #uuid "5e2ed2c4-f432-5dc5-84ad-45be5e6c0e95" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "12" :db/id #edb/ref 17592186266975} {:answer/id #uuid "5e32262d-72d6-5e5a-894e-153eb250705f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{12}" :db/id #edb/ref 17592186266977} {:answer/id #uuid "f0b9b848-8717-52db-b148-c872c7061d08" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{12}" :db/id #edb/ref 17592186268284}] :answer-field/correct {:answer/id #uuid "04ba9a98-d418-5054-94e5-129c6b76bfac" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-12" :db/id #edb/ref 17592186266186} :answer-field/id #uuid "aa7bd887-2e1e-5f25-8630-dbf79ed567a6" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident