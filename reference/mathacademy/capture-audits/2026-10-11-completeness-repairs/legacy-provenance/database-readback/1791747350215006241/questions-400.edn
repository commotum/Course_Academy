#{[{:db/id #edb/ref 17592186400352 :knowledge-point/_questions [{:db/id #edb/ref 17592186059848 :knowledge-point/id #uuid "32df8909-a239-5167-b8ea-412f7cdaea93" :knowledge-point/title "Identifying Singular Matrices"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4ffbd8f5-0ee6-5cad-88b8-2877cefd01dc" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186400354} {:answer/id #uuid "6c4b7403-5eeb-50d7-a4bd-09fe3acc71a2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186400355} {:answer/id #uuid "21613f83-4258-54f4-a9b2-387b0255c0f6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186400356} {:answer/id #uuid "1db912cd-3357-5080-a6af-3948ea9b0a17" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186400357} {:answer/id #uuid "ee547a84-a761-5ce9-84b8-e2abf25059e2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186400358}] :answer-field/correct {:answer/id #uuid "4ffbd8f5-0ee6-5cad-88b8-2877cefd01dc" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186400354} :answer-field/id #uuid "2c8cea4c-0392-5f09-b624-e7c6aa7142b0" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186400353}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "04472571-0a00-5fac-9502-9b8f8afd8c8a" :question/math-academy-id "q-128480" :question/problem "Which of the following statements are true regarding the matrix $D$ given below?\n\nI. $D$ is a singular matrix\nII. $det(D)=1$\nIII. $det(D)=0$\n\n$$\nD=[\\begin{aligned}2 & -3 & 1 \\\\ -1 & 2 & 3 \\\\ -3 & 5 & 2\\end{aligned}]\n$$" :question/worked-solution "Remember that a square matrix is singular if its determinant is equal to $0.$\n\nUsing the formula, we take the alternating sum of the entries in the top row of the matrix, multiplied by their respective minors, as follows:\n\n$$\n\\begin{aligned}det(D) & =|\\begin{aligned}2 & -3 & 1 \\\\ -1 & 2 & 3 \\\\ -3 & 5 & 2\\end{aligned}| \\\\  & =2|\\begin{aligned}2 & 3 \\\\ 5 & 2\\end{aligned}|+3|\\begin{aligned}-1 & 3 \\\\ -3 & 2\\end{aligned}|+1|\\begin{aligned}-1 & 2 \\\\ -3 & 5\\end{aligned}| \\\\  & =2(4-15)+3(-2+9)+1(-5+6) \\\\  & =2\\cdot (-11)+3\\cdot 7+1\\cdot 1 \\\\  & =-22+21+1 \\\\  & =0\\end{aligned}\n$$\n\n \n\nSince $det(D)=0$, the matrix is singular. \n\nTherefore, only statements I and III are true."}] [{:db/id #edb/ref 17592186400359 :knowledge-point/_questions [{:db/id #edb/ref 17592186059848 :knowledge-point/id #uuid "32df8909-a239-5167-b8ea-412f7cdaea93" :knowledge-point/title "Identifying Singular Matrices"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f0d86b56-15a8-5ce5-87a3-79892a8fcb59" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186400361} {:answer/id #uuid "72d6cc07-52e5-5150-a7c0-2f37168a2e72" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186400362} {:answer/id #uuid "c359f024-e80b-583a-9ec0-eb3841869630" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186400363} {:answer/id #uuid "ad585491-6925-5efe-a231-7cc8caa22373" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186400364} {:answer/id #uuid "ffccfcfd-c978-5441-bcf2-9a8dfaace8a6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186400365}] :answer-field/correct {:answer/id #uuid "ffccfcfd-c978-5441-bcf2-9a8dfaace8a6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186400365} :answer-field/id #uuid "f4cb87f6-39a9-56d2-9818-a6028ef6c858" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186400360}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "5bcc7af8-2cd5-53ed-a962-12d9bd009077" :question/math-academy-id "q-128491" :question/problem "Which of the following statements are true regarding the matrix $S$ given below?\n\nI. $S$ is a singular matrix\nII. $S$ is **not** a singular matrix\nIII. $det(S)=5+2\\sqrt{7}$\n\n$$\nS=[\\begin{aligned}2\\sqrt{7} & 0 & \\frac{1}{2} \\\\ -\\sqrt{7} & 2 & 0 \\\\ 5 & 0 & \\sqrt{7}\\end{aligned}]\n$$" :question/worked-solution "Remember that a square matrix is singular if its determinant is equal to $0.$\n\nUsing the formula, we take the alternating sum of the entries in the top row of the matrix, multiplied by their respective minors, as follows:\n\n$$\n\\begin{aligned}det(S) & =|\\begin{aligned}2\\sqrt{7} & 0 & \\frac{1}{2} \\\\ -\\sqrt{7} & 2 & 0 \\\\ 5 & 0 & \\sqrt{7}\\end{aligned}| \\\\  & =2\\sqrt{7}|\\begin{aligned}2 & 0 \\\\ 0 & \\sqrt{7}\\end{aligned}|-0|\\begin{aligned}-\\sqrt{7} & 0 \\\\ 5 & \\sqrt{7}\\end{aligned}|+\\frac{1}{2}|\\begin{aligned}-\\sqrt{7} & 2 \\\\ 5 & 0\\end{aligned}| \\\\  & =2\\sqrt{7}(2\\sqrt{7}-0)-0+\\frac{1}{2}(0-10) \\\\  & =2\\sqrt{7}\\cdot 2\\sqrt{7}+\\frac{1}{2}\\cdot (-10) \\\\  & =28-5 \\\\  & =23\\end{aligned}\n$$\n\nSince $det(S)=23\\ne 0$, the matrix is **not ** singular. \n\nTherefore, only statement II is true."}] [{:db/id #edb/ref 17592186388048 :knowledge-point/_questions [{:db/id #edb/ref 17592186059747 :knowledge-point/id #uuid "9c7a77cf-163a-542a-b4a3-4274344b9cf8" :knowledge-point/title "Multiplying 3x3 Square Matrices"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b3e9d798-fb90-59d5-a203-1417449a2049" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}-14 & 0 & -2 \\\\ 14 & -4 & -4 \\\\ 0 & -8 & 10\\end{aligned}]" :db/id #edb/ref 17592186388050} {:answer/id #uuid "f4ba9d1d-813c-5106-b50d-217b417a01b4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}14 & 0 & 0 \\\\ 14 & -4 & -4 \\\\ 0 & -8 & -10\\end{aligned}]" :db/id #edb/ref 17592186388051} {:answer/id #uuid "6ee9a11d-be69-54bb-9606-cb4e7fe20b6d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}14 & 0 & 2 \\\\ 14 & 4 & -4 \\\\ 0 & -8 & 1\\end{aligned}]" :db/id #edb/ref 17592186388052} {:answer/id #uuid "384a031d-89dd-52c1-8825-0b46e7ea136c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}-14 & 0 & -2 \\\\ 14 & -4 & -4 \\\\ -8 & 0 & -10\\end{aligned}]" :db/id #edb/ref 17592186388053} {:answer/id #uuid "447fd152-f5cb-5dc7-9444-3dbb71a852c7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}-14 & 4 & -2 \\\\ 14 & -4 & -4 \\\\ 0 & 0 & 10\\end{aligned}]" :db/id #edb/ref 17592186388054}] :answer-field/correct {:answer/id #uuid "b3e9d798-fb90-59d5-a203-1417449a2049" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}-14 & 0 & -2 \\\\ 14 & -4 & -4 \\\\ 0 & -8 & 10\\end{aligned}]" :db/id #edb/ref 17592186388050} :answer-field/id #uuid "51db0af0-01ec-5d77-8788-b30f88e6807d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186388049}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "cdfd9e99-dfb0-5111-9847-07557a210428" :question/math-academy-id "q-129367" :question/problem "$[\\begin{aligned}1 & 2 & 1 \\\\ 1 & -3 & 0 \\\\ 0 & -3 & 5\\end{aligned}][\\begin{aligned}-1 & -1 & -4 \\\\ -5 & 1 & 0 \\\\ -3 & -1 & 2\\end{aligned}]=$" :question/worked-solution "Multiplying each row in the first matrix by each column in the second, we get\n\n$$\n\\begin{aligned}[\\begin{aligned}1 & 2 & 1 \\\\ 1 & -3 & 0 \\\\ 0 & -3 & 5\\end{aligned}][\\begin{aligned}-1 & -1 & -4 \\\\ -5 & 1 & 0 \\\\ -3 & -1 & 2\\end{aligned}] & =[\\begin{aligned}-1-10-3 & -1+2-1 & -4+0+2 \\\\ -1+15+0 & -1-3+0 & -4+0+0 \\\\ 0+15-15 & 0-3-5 & 0+0+10\\end{aligned}] \\\\  & =[\\begin{aligned}-14 & 0 & -2 \\\\ 14 & -4 & -4 \\\\ 0 & -8 & 10\\end{aligned}].\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186398354 :knowledge-point/_questions [{:db/id #edb/ref 17592186100870 :knowledge-point/id #uuid "f38167e2-3c1d-5c00-9691-ba8e6ac6fdce" :knowledge-point/title "Determining the Dimension of the Product of Two Matrices Given the Dimensions of the Factors"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "fb5de5b4-4d8b-5c4b-949e-2701f12f4f91" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5\\times 1" :db/id #edb/ref 17592186398356} {:answer/id #uuid "639400d8-2573-593d-874f-f06ceff3176b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1\\times 5" :db/id #edb/ref 17592186398357} {:answer/id #uuid "15c0f9d4-3d25-5fe4-b265-b619e9a4fe6f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5\\times 5" :db/id #edb/ref 17592186398358} {:answer/id #uuid "4e12b0f0-56b4-5aeb-bedc-2549e8257ee3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The product is undefined" :db/id #edb/ref 17592186398359} {:answer/id #uuid "004a8839-e101-5295-a1c9-8f3e01aa9901" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "7\\times 5" :db/id #edb/ref 17592186398360}] :answer-field/correct {:answer/id #uuid "fb5de5b4-4d8b-5c4b-949e-2701f12f4f91" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5\\times 1" :db/id #edb/ref 17592186398356} :answer-field/id #uuid "152cf7f5-88d1-5058-9ac3-4041188e5fcc" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186398355}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "238922a6-1ae9-598b-83f3-1fd25fd1bf01" :question/math-academy-id "q-129480" :question/problem "What are the dimensions of $CD$, if $C$ is a $5\\times 7$ matrix and $D$ is a $7\\times 1$ matrix?" :question/worked-solution "There are $7$ columns in $C$ and $7$ rows in $D.$ Since the number of columns in $C$ equals the number of rows in $D,$ the matrices $C$ and $D$ are conformable for multiplication, and $CD$ is a $5\\times 1$ matrix: \n\n$$\n{C}_{5\\times \\boxed{\\text{7}}}{\\times }_{✓}{D}_{\\boxed{\\text{7}}\\times 1}={CD}_{5\\times 1}\n$$"}] [{:db/id #edb/ref 17592186265789 :knowledge-point/_questions [{:db/id #edb/ref 17592186068861 :knowledge-point/id #uuid "a7f04ab7-f6f6-5d01-bfcf-b667e37e4f0b" :knowledge-point/title "Solving a Quadratic Equation When the Solutions Are Irrational"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3d5085e7-9df9-5583-a9eb-4aca834756b7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "p+q=55" :db/id #edb/ref 17592186263545} {:answer/id #uuid "49bc3a1b-22cf-5a66-a6c0-83bfe3292149" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "p+q=-45" :db/id #edb/ref 17592186263634} {:answer/id #uuid "884cd699-7583-5968-ae5f-5297ccb1d1f9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "p+q=-50" :db/id #edb/ref 17592186264178} {:answer/id #uuid "8ad3250f-b580-5861-a4c8-475bce8d9d0c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "p+q=45" :db/id #edb/ref 17592186264188} {:answer/id #uuid "9c4347fb-3578-5e6a-b949-5f25952eb680" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "p+q=50" :db/id #edb/ref 17592186264338}] :answer-field/correct {:answer/id #uuid "3d5085e7-9df9-5583-a9eb-4aca834756b7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "p+q=55" :db/id #edb/ref 17592186263545} :answer-field/id #uuid "a7460a0f-9af3-55d8-9183-7f36516a5325" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186265545}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "b2094d9e-dc94-52c2-adb6-43e9a1505bb1" :question/math-academy-id "q-12995" :question/problem "The equation ${z}^{2}-25=-10z$ can be written in the form $(z+p{)}^{2}=q.$ Find $p+q.$" :question/worked-solution "First, we move the constant term to the right-hand side, the $-10z$ term to the left-hand side, and complete the square on the left-hand side.\n\n$$\n\\begin{aligned}{z}^{2}-25 & =-10z \\\\ {z}^{2}+10z & =25 \\\\ {z}^{2}+2\\cdot 5\\cdot z & =25 \\\\ {z}^{2}+2\\cdot 5\\cdot z+{5}^{2}-{5}^{2} & =25 \\\\ (z+5{)}^{2}-{5}^{2} & =25\\end{aligned}\n$$\n\nThen, we isolate the perfect square:\n\n$$\n\\begin{aligned}(z+5{)}^{2}-{5}^{2} & =25 \\\\ (z+5{)}^{2} & =50\\end{aligned}\n$$\n\nSo, $p=5,q=50,$ and $p+q=55.$"}] [{:db/id #edb/ref 17592186396018 :knowledge-point/_questions [{:db/id #edb/ref 17592186068860 :knowledge-point/id #uuid "9d78ba1c-5297-5540-afdc-d419d33e0cf7" :knowledge-point/title "Solving a Quadratic Equation When the Solutions Are Rational"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "596d615e-5286-5202-8b68-e459a1ad6de4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$p+q=64,\\,a=-12$ and $a=4$" :db/id #edb/ref 17592186396020} {:answer/id #uuid "ab85b611-a835-5c9b-b93a-92affdbe8c81" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$p+q=68,\\,a=12$ and $a=-4$" :db/id #edb/ref 17592186396021} {:answer/id #uuid "cb49ee04-f343-57a4-b655-73c807196dc3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$p+q=60,\\,a=12$ and $a=-8$" :db/id #edb/ref 17592186396022} {:answer/id #uuid "60eb227e-be77-5810-a6ee-f5a5a9b9ed9a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$p+q=68,\\,a=-12$ and $a=4$" :db/id #edb/ref 17592186396023} {:answer/id #uuid "1c7592ca-f49a-5a60-b8d5-154388f0691b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$p+q=64,\\,a=-12$ and $a=-4$" :db/id #edb/ref 17592186396024}] :answer-field/correct {:answer/id #uuid "60eb227e-be77-5810-a6ee-f5a5a9b9ed9a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$p+q=68,\\,a=-12$ and $a=4$" :db/id #edb/ref 17592186396023} :answer-field/id #uuid "950ac440-c42e-5efd-8288-46527f1353b2" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186396019}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "4870cb8f-66f0-5759-83b5-334830749092" :question/math-academy-id "q-12997" :question/problem "The equation ${a}^{2}+8a=48$ can be written in the form $(a+p{)}^{2}=q.$ Find $p+q,$ and solve the equation." :question/worked-solution "First, we complete the square on the left-hand side:\n\n$$\n\\begin{aligned}{a}^{2}+8a & =48 \\\\ {a}^{2}+2\\cdot 4\\cdot a & =48 \\\\ {a}^{2}+2\\cdot 4\\cdot a+{4}^{2}-{4}^{2} & =48 \\\\ ({a}^{2}+2\\cdot 4\\cdot a+{4}^{2})-16 & =48 \\\\ {(a+4)}^{2}-16 & =48\\end{aligned}\n$$\n\nThen, we isolate the perfect square:\n\n$$\n\\begin{aligned}(a+4{)}^{2}-16 & =48 \\\\ (a+4{)}^{2} & =64\\end{aligned}\n$$\n\nSo, $p=4,q=64,$ and $p+q=68.$\n\nNext, we solve the equation using the square-root method:\n\n$$\n\\begin{aligned}(a+4{)}^{2} & =64 \\\\ \\sqrt{(a+4{)}^{2}} & =\\sqrt{64} \\\\ a+4 & =\\pm 8 \\\\ a & =-4\\pm 8\\end{aligned}\n$$\n\nTherefore, the solutions are $a=-12$ and $a=4.$"}] [{:db/id #edb/ref 17592186265909 :knowledge-point/_questions [{:db/id #edb/ref 17592186115228 :knowledge-point/id #uuid "5a870c4a-daa5-5df2-8968-d8bf9ac0bd75" :knowledge-point/title "Identifying True Statements Regarding Matrix Multiplication"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0fbfd4c4-068a-5868-bc97-1329c0713938" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186263143} {:answer/id #uuid "6643c090-5848-523b-8705-add98d1a39e8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186263883} {:answer/id #uuid "b6fe2291-2804-5ef7-b520-dbedc179c766" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186264586} {:answer/id #uuid "ed8fb8cb-7920-5aae-88ae-630ed4a34532" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186265075} {:answer/id #uuid "ee0bccfd-146e-59bb-9ce6-0631931c2bc2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186265079}] :answer-field/correct {:answer/id #uuid "0fbfd4c4-068a-5868-bc97-1329c0713938" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186263143} :answer-field/id #uuid "b22fab6b-24d8-51e9-b884-f29b98fe1103" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186265560}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "da216097-76ab-5a2e-b3ad-662534506edb" :question/math-academy-id "q-130455" :question/problem "Given that $A,B,$ and $C$ are $6\\times 6$ matrices which of the following statements are always true? \n\n- $A(BC)=(AB)C$\n- $A(B-C)=AB-CA$\n- $CA=AC$" :question/worked-solution "Let's consider the statements one by one.\n\n- Statement I is true. Matrix multiplication is associative and  $A(BC)=(AB)C$ is always true.\n\n- Statement II is false. Matrix multiplication is distributive, so $A(B-C)=AB-AC,$ but $AC\\ne CA$ because matrix multiplication is not commutative in general.\n\n- Statement III  is false. Matrix multiplication is not commutative, so $CA\\ne AC$ in general.\n\nTherefore, only statement  I is true."}] [{:db/id #edb/ref 17592186265923 :knowledge-point/_questions [{:db/id #edb/ref 17592186115232 :knowledge-point/id #uuid "f4f746a1-ea9e-5136-90d6-d4dee1306c17" :knowledge-point/title "Representing a 2x2 System of Equations Using a Matrix Product by Reorganizing"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "11874c88-0d8d-5fdc-98e7-8f98e6a3f365" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}3 & 4 \\\\ 0 & -1\\end{aligned}][\\begin{aligned}x \\\\ y\\end{aligned}]=[\\begin{aligned}0 \\\\ -3\\end{aligned}]" :db/id #edb/ref 17592186263162} {:answer/id #uuid "87092bc6-cce8-59e3-97f8-85ea23e9e36d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}2 & -4 \\\\ 0 & -1\\end{aligned}][\\begin{aligned}x \\\\ y\\end{aligned}]=[\\begin{aligned}-1 \\\\ 4\\end{aligned}]" :db/id #edb/ref 17592186264169} {:answer/id #uuid "a375bbba-4d73-59f8-98fd-ff55611b114c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}3 & 4 \\\\ 0 & 1\\end{aligned}][\\begin{aligned}x \\\\ y\\end{aligned}]=[\\begin{aligned}0 \\\\ 4\\end{aligned}]" :db/id #edb/ref 17592186264389} {:answer/id #uuid "c344dea9-14a2-5e14-b911-cdb495284357" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}3 & -4 \\\\ 0 & 1\\end{aligned}][\\begin{aligned}x \\\\ y\\end{aligned}]=[\\begin{aligned}1 \\\\ -4\\end{aligned}]" :db/id #edb/ref 17592186264702} {:answer/id #uuid "d761b6a0-7cd7-5ded-a020-ef128be56117" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}4 & -3 \\\\ 0 & 1\\end{aligned}][\\begin{aligned}x \\\\ y\\end{aligned}]=[\\begin{aligned}1 \\\\ 4\\end{aligned}]" :db/id #edb/ref 17592186264877}] :answer-field/correct {:answer/id #uuid "c344dea9-14a2-5e14-b911-cdb495284357" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}3 & -4 \\\\ 0 & 1\\end{aligned}][\\begin{aligned}x \\\\ y\\end{aligned}]=[\\begin{aligned}1 \\\\ -4\\end{aligned}]" :db/id #edb/ref 17592186264702} :answer-field/id #uuid "e12d11e5-1bfe-5244-a9f3-13036e9bc00f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186265641}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "d99d7426-520b-5e1d-945d-430bc4355051" :question/math-academy-id "q-130510" :question/problem "Represent the following system of equations using matrices:\n\n$$\n\\begin{aligned}{\\begin{aligned}3x-1=4y \\\\ y=-4\\end{aligned}\\end{aligned}\n$$" :question/worked-solution "First, we organize the system so that it’s in the correct order and  both $x$ and $y$ appear in each equation:\n\n$$\n\\begin{aligned}{\\begin{aligned}3x-4y=1 \\\\ 0x+y=-4\\end{aligned}\\end{aligned}\n$$\n\nNow, we can write the system in the form $Ax=b,$ where\n\n$$\nA=[\\begin{aligned}3 & -4 \\\\ 0 & 1\\end{aligned}]\n$$\n\nis the coefficient matrix,\n\n$$\nb=[\\begin{aligned}1 \\\\ -4\\end{aligned}]\n$$\n\nis the column vector of constants, and\n\n$$\nx=[\\begin{aligned}x \\\\ y\\end{aligned}]\n$$\n\nis the column vector of variables.\n\nSo, the equation $Ax=b$ becomes\n\n$$\n[\\begin{aligned}3 & -4 \\\\ 0 & 1\\end{aligned}][\\begin{aligned}x \\\\ y\\end{aligned}]=[\\begin{aligned}1 \\\\ -4\\end{aligned}].\n$$"}] [{:db/id #edb/ref 17592186266042 :knowledge-point/_questions [{:db/id #edb/ref 17592186175901 :knowledge-point/id #uuid "eede91c4-9099-55df-a803-f87895d9f51b" :knowledge-point/title "Applying the Extreme Value Theorem to Piecewise Functions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "44ecce21-550b-523f-b8b9-aeef7fbf3bae" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186263605} {:answer/id #uuid "72477dd1-b33d-54df-b872-6f36021971cb" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186263990} {:answer/id #uuid "8a5449cc-5239-52bf-9b1a-7218973f90ed" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I, II, and III" :db/id #edb/ref 17592186264184} {:answer/id #uuid "a810da3d-3505-5c14-82f7-8bf490141215" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186264436} {:answer/id #uuid "ed55bf29-39a9-50eb-89ad-464d2079ee83" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186265073}] :answer-field/correct {:answer/id #uuid "a810da3d-3505-5c14-82f7-8bf490141215" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186264436} :answer-field/id #uuid "7ca2a258-074d-5301-bd96-9a6250fb613b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186265462}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "d91387a3-da34-5d28-af8d-36338cffabf0" :question/math-academy-id "q-131066" :question/problem "Suppose that $f(x)$ is defined as\n\n$$\nf(x)={\\begin{aligned}2, & x<0 \\\\ \\operatorname{tan}⁡x, & x\\ge 0.\\end{aligned}\n$$\n\nOn which of the following intervals can the extreme value theorem be applied to the function?\n\n- $[-\\frac{\\pi }{3},\\frac{\\pi }{3}]$\n- $[\\frac{\\pi }{6},\\frac{\\pi }{3}]$\n- $[\\frac{\\pi }{3},\\frac{2\\pi }{3}]$" :question/worked-solution "Remember that the extreme value theorem is only applicable to closed intervals on which the function is continuous.\n\nSo, let's check whether the function is continuous on each of the intervals.\n\n- Consider $[-\\frac{\\pi }{3},\\frac{\\pi }{3}].$ We have\n\n$$\n\\begin{aligned}{lim}_{x\\to {0}^{-}}f(x) & ={lim}_{x\\to 0}2=2, \\\\ {lim}_{x\\to {0}^{+}}f(x) & ={lim}_{x\\to 0}\\operatorname{tan}⁡x=0.\\end{aligned}\n$$\n\nSo, the limits from the left and from the right of $x=0$ are not the same. Hence, $f(x)$ has a discontinuity at $x=0.$ Therefore, $f(x)$ is not continuous on the interval $[-\\frac{\\pi }{3},\\frac{\\pi }{3}],$ and the extreme value theorem is not applicable on this interval.\n\n- Consider $[\\frac{\\pi }{6},\\frac{\\pi }{3}].$ In this interval, $f(x)=\\operatorname{tan}⁡x,$ so the function $f(x)$ is continuous on the interval $[\\frac{\\pi }{6},\\frac{\\pi }{3}],$ and the extreme value theorem is applicable on this interval.\n\n- Consider $[\\frac{\\pi }{3},\\frac{2\\pi }{3}].$ In this interval, $f(x)=\\operatorname{tan}⁡x,$ so the function is not defined at $x=\\frac{\\pi }{2}.$ Therefore, $f(x)$ is not continuous on the interval $[\\frac{\\pi }{3},\\frac{2\\pi }{3}],$ and the extreme value theorem is not applicable on this interval.\n\nIn conclusion, the correct answer is \"II only\"."}] [{:db/id #edb/ref 17592186400576 :knowledge-point/_questions [{:db/id #edb/ref 17592186083295 :knowledge-point/id #uuid "f4bd2a8e-357a-5f22-bd50-608e68432a8d" :knowledge-point/title "Finding Critical Points of Polynomials"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "efb825ec-4af1-502e-84e4-c2363e24558e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$x=-6$ and $x=3$" :db/id #edb/ref 17592186400578} {:answer/id #uuid "a0005f3d-2f6a-5da0-ad19-56ff2d7b1c97" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$x=-3$ and $x=4$" :db/id #edb/ref 17592186400579} {:answer/id #uuid "40bc473f-1c61-5b45-af07-0768b0375c55" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$x=-3$ and $x=6$" :db/id #edb/ref 17592186400580} {:answer/id #uuid "2ada282e-9a0b-53a0-acf3-911a8863351b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$x=-4$ and $x=3$" :db/id #edb/ref 17592186400581} {:answer/id #uuid "5eb7851c-f9c7-53a1-b68c-803e4833549a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$x=-4$ and $x=6$" :db/id #edb/ref 17592186400582}] :answer-field/correct {:answer/id #uuid "a0005f3d-2f6a-5da0-ad19-56ff2d7b1c97" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$x=-3$ and $x=4$" :db/id #edb/ref 17592186400579} :answer-field/id #uuid "40b63710-ca14-5f20-99f5-64eef01983af" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186400577}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "19a51c3a-961d-51e8-839d-dcbc2e643a8d" :question/math-academy-id "q-131188" :question/problem "Find the critical points of the function $f(x)=2{x}^{3}-3{x}^{2}-72x.$" :question/worked-solution "A critical point of $f(x)$ is a point $x=c$ in the domain of $f$ such that either ${f}^{′}(c)=0$ or ${f}^{′}(c)$ does not exist.\n\nDifferentiating $f(x),$ we obtain\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}(2{x}^{3}-3{x}^{2}-72x) \\\\  & =6{x}^{2}-6x-72.\\end{aligned}\n$$\n\nWe now proceed to find the critical points:\n\n- First, we compute the points where ${f}^{′}(c)=0.$ We set the derivative equal to zero, and solve for $x:$\n\n$$\n\\begin{aligned}6{x}^{2}-6x-72 & =0 \\\\ {x}^{2}-x-12 & =0 \\\\ (x-4)(x+3) & =0 \\\\ x & =-3,\\,4\\end{aligned}\n$$\n\nTherefore, $f(x)$ has stationary points at $x=-3$ and $x=4.$\n\n- Second, we note that ${f}^{′}(x)$ exists for all values of $x$ in the domain of $f(x).$ So $f(x)$ has no non-stationary critical points.\n\nTherefore, we conclude that the critical points of $f(x)$ are $x=-3$ and $x=4.$"}] [{:db/id #edb/ref 17592186400583 :knowledge-point/_questions [{:db/id #edb/ref 17592186083296 :knowledge-point/id #uuid "48e49ade-8bfe-56e7-8b52-950fa84e4bb0" :knowledge-point/title "Finding Critical Points of Exponential Functions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d89fcce3-b832-5e4c-bf7c-02c1c17153f9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$x=-1$ and $x=3$" :db/id #edb/ref 17592186400585} {:answer/id #uuid "fd55f488-68a4-5b1e-9bbb-f31e747d2214" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$x=0$ and $x=\\pm 1$" :db/id #edb/ref 17592186400586} {:answer/id #uuid "1facde6d-5525-541b-93d6-30090cb94ea3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$x=1$ and $x=3$" :db/id #edb/ref 17592186400587} {:answer/id #uuid "fa042a55-7109-5f70-97f2-337042cc265e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$x=0$ and $x=1$" :db/id #edb/ref 17592186400588} {:answer/id #uuid "be65614c-b0a6-53df-8fb4-0615b69a4d78" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$x=0$ and $x=3$" :db/id #edb/ref 17592186400589}] :answer-field/correct {:answer/id #uuid "fd55f488-68a4-5b1e-9bbb-f31e747d2214" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$x=0$ and $x=\\pm 1$" :db/id #edb/ref 17592186400586} :answer-field/id #uuid "80b83c99-19f6-547f-98fa-adc91ffefc5f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186400584}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "42598c74-a5de-588f-a397-c6d324d9491a" :question/math-academy-id "q-131273" :question/problem "Find the critical points of the function  $f(x)=({x}^{2}-\\frac{5}{4}){e}^{4{x}^{2}}.$" :question/worked-solution "A critical point of $f(x)$ is a point $x=c$ in the domain of $f$ such that either ${f}^{′}(c)=0$ or ${f}^{′}(c)$ does not exist.\n\nDifferentiating $f(x),$ we obtain\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}(({x}^{2}-\\frac{5}{4}){e}^{4{x}^{2}}) \\\\  & ={({x}^{2}-\\frac{5}{4})}^{′}{e}^{4{x}^{2}}+({x}^{2}-\\frac{5}{4}){({e}^{4{x}^{2}})}^{′} \\\\  & =2x{e}^{4{x}^{2}}+(8x)({x}^{2}-\\frac{5}{4}){e}^{4{x}^{2}} \\\\  & =[2x+8{x}^{3}-10x]{e}^{4{x}^{2}} \\\\  & =(8{x}^{3}-8x){e}^{4{x}^{2}}.\\end{aligned}\n$$\n\nWe now proceed to find the critical points:\n\n- First, we compute the points where ${f}^{′}(c)=0.$ We set the derivative equal to zero, and solve for $x:$\n\n$$\n\\begin{aligned}(8{x}^{3}-8x){e}^{4{x}^{2}} & =0\\end{aligned}\n$$\n\nSince ${e}^{4{x}^{2}}\\ne 0$ for all $x,$ we can divide this equation by ${e}^{4{x}^{2}}$ and solve the resulting equation.\n\n$$\n\\begin{aligned}8{x}^{3}-8x & =0 \\\\ 8x({x}^{2}-1) & =0 \\\\ 8x(x+1)(x-1) & =0 \\\\ x & =0,\\,-1,\\,1\\end{aligned}\n$$\n\nTherefore, $f(x)$ has stationary points at $x=-1,$ $x=0$ and $x=1.$\n\n- Second, we note that ${f}^{′}(x)$ exists for all values of $x$ in the domain of $f(x).$ So $f(x)$ has no non-stationary critical points.\n\nTherefore, we conclude that the critical points of $f(x)$ are $x=-1,$ $x=0$ and $x=1.$"}] [{:db/id #edb/ref 17592186268865 :knowledge-point/_questions [{:db/id #edb/ref 17592186083329 :knowledge-point/id #uuid "772ea6ab-9884-51ef-82df-a9d5cd523719" :knowledge-point/title "Finding Critical Points of Rational Functions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "73045e44-339d-5232-8626-58f98fff8223" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=2\\pm \\sqrt{5}" :db/id #edb/ref 17592186267153} {:answer/id #uuid "8ac7dc0e-586e-5673-b490-0806b2480298" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=2\\pm \\sqrt{10}" :db/id #edb/ref 17592186267383} {:answer/id #uuid "935e5baa-3edd-5980-80ab-f815c3d63410" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=-2\\pm \\sqrt{6}" :db/id #edb/ref 17592186267463} {:answer/id #uuid "951c1233-198a-5c2b-80ce-b4df12a181d0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=2\\pm \\sqrt{2}" :db/id #edb/ref 17592186267476} {:answer/id #uuid "a2277225-dbf9-56f1-be02-62c031e01d0a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=-2\\pm \\sqrt{10}" :db/id #edb/ref 17592186267602}] :answer-field/correct {:answer/id #uuid "8ac7dc0e-586e-5673-b490-0806b2480298" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=2\\pm \\sqrt{10}" :db/id #edb/ref 17592186267383} :answer-field/id #uuid "e0768589-116e-5fbb-a67c-91fcef104624" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186268804}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "5d0ffa3b-787e-578b-bbef-1ac3a2b89d8c" :question/math-academy-id "q-132464" :question/problem "What are the critical points of the function $f(x)=\\frac{x-2}{{x}^{2}+6}?$" :question/worked-solution "A critical point of $f(x)$ is a point $x=c$ in the domain of $f$ such that either ${f}^{′}(c)=0$ or ${f}^{′}(c)$ does not exist.\n\nDifferentiating $f(x),$ we obtain\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}(\\frac{x-2}{{x}^{2}+6}) \\\\  & =\\frac{(x-2)^{′}\\cdot ({x}^{2}+6)-(x-2)\\cdot ({x}^{2}+6)^{′}}{({x}^{2}+6)^{2}} \\\\  & =\\frac{({x}^{2}+6)-(x-2)\\cdot 2x}{({x}^{2}+6)^{2}} \\\\  & =\\frac{{x}^{2}+6-2{x}^{2}+4x}{({x}^{2}+6)^{2}} \\\\  & =\\frac{-{x}^{2}+4x+6}{({x}^{2}+6)^{2}} \\\\  & =-\\frac{{x}^{2}-4x-6}{({x}^{2}+6)^{2}}.\\end{aligned}\n$$\n\nWe now proceed to find the critical points:\n\n- First, we compute the points where ${f}^{′}(c)=0.$ We set the derivative equal to zero, and solve for $x$ by completing the square:\n\n$$\n\\begin{aligned}-\\frac{{x}^{2}-4x-6}{({x}^{2}+6)^{2}} & =0 \\\\ {x}^{2}-4x-6 & =0 \\\\ {x}^{2}-2\\cdot 2x+{2}^{2}-{2}^{2}-6 & =0 \\\\ (x-2)^{2}-4-6 & =0 \\\\ (x-2)^{2}-10 & =0 \\\\ (x-2)^{2} & =10 \\\\ x-2 & =\\pm \\sqrt{10} \\\\ x & =2\\pm \\sqrt{10}.\\end{aligned}\n$$\n\nTherefore, $f(x)$ has stationary points at $x=2\\pm \\sqrt{10}.$\n\n- Second, we note that ${f}^{′}(x)$ exists for all values of $x$ in the domain of $f(x).$ So $f(x)$ has no non-stationary critical points.\n\nTherefore, we conclude that the critical points of $f(x)$ are $x=2\\pm \\sqrt{10}.$"}] [{:db/id #edb/ref 17592186268877 :knowledge-point/_questions [{:db/id #edb/ref 17592186083336 :knowledge-point/id #uuid "b5cda348-b3e8-5a89-abd4-bd6f3a7a8370" :knowledge-point/title "Calculating Critical Points of Trigonometric Functions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "46902860-84f9-54b6-b3b8-3b5caed4b8fe" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{5{\\pi }^{2}}{36}" :db/id #edb/ref 17592186266773} {:answer/id #uuid "5555228b-1968-5f92-be4c-7312e7225c4a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{7{\\pi }^{2}}{36}" :db/id #edb/ref 17592186266907} {:answer/id #uuid "78d5f9fb-dfe5-506f-a077-a044cfe9fd8d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{5{\\pi }^{2}}{9}" :db/id #edb/ref 17592186267208} {:answer/id #uuid "9e2d4040-236a-598e-b8f4-30405bf6c917" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{{\\pi }^{2}}{36}" :db/id #edb/ref 17592186267568} {:answer/id #uuid "d62d33a9-c93d-5006-a190-3069e98c1625" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{2{\\pi }^{2}}{9}" :db/id #edb/ref 17592186268051}] :answer-field/correct {:answer/id #uuid "46902860-84f9-54b6-b3b8-3b5caed4b8fe" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{5{\\pi }^{2}}{36}" :db/id #edb/ref 17592186266773} :answer-field/id #uuid "1b382e58-2afe-5639-b4fc-689808dfe239" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186268449}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "f888c82d-82ba-57ac-963b-02774f1c6aab" :question/math-academy-id "q-132567" :question/problem "Consider the function $f(x)=3\\operatorname{cos}⁡x-\\sqrt{3}\\operatorname{sin}⁡x.$ If the critical points of $f(x)$ for $x\\in (-\\pi ,\\pi )$ are $x={x}_{1}$ and $x={x}_{2},$ what is the value of ${x}_{1}\\cdot {x}_{2}?$" :question/worked-solution "A critical point of $f(x)$ is a point $x=c$ in the domain of $f$ such that either ${f}^{′}(c)=0$ or ${f}^{′}(c)$ does not exist.\n\nDifferentiating $f(x),$ we obtain\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}(3\\operatorname{cos}⁡x-\\sqrt{3}\\operatorname{sin}⁡x) \\\\  & =-3\\operatorname{sin}⁡x-\\sqrt{3}\\operatorname{cos}⁡x.\\end{aligned}\n$$\n\nWe now proceed to find the critical points:\n\n- First, we compute the points where ${f}^{′}(c)=0.$ We set the derivative equal to zero, and solve for $x:$\n\n$$\n\\begin{aligned}-3\\operatorname{sin}⁡x-\\sqrt{3}\\operatorname{cos}⁡x & =0 \\\\ -3\\operatorname{sin}⁡x & =\\sqrt{3}\\operatorname{cos}⁡x \\\\ -3\\cdot \\frac{\\operatorname{sin}⁡x}{\\operatorname{cos}⁡x} & =\\sqrt{3}\\cdot \\frac{\\operatorname{cos}⁡x}{\\operatorname{cos}⁡x} \\\\ \\operatorname{tan}⁡x & =-\\frac{\\sqrt{3}}{3}\\end{aligned}\n$$\n\nThe general solution to our equation is\n\n$$\n\\begin{aligned}x & =\\operatorname{arctan}⁡(-\\frac{\\sqrt{3}}{3})+n\\pi  \\\\  & =-\\frac{\\pi }{6}+n\\pi .\\end{aligned}\n$$\n\nWe set $n=0,\\pm 1,\\pm 2,…,$ until we have generated all solutions in the domain $-\\pi <x<\\pi .$\n\n- setting $n=0$ gives $x=-\\frac{\\pi }{6}$\n\n- setting $n=1$ gives $x=\\frac{5\\pi }{6}$\n\nAll other values of $n$ generate solutions outside the domain $-\\pi <x<\\pi .$ So, the solutions to this equation for $x\\in (-\\pi ,\\pi )$ are \n\n$$\nx=-\\frac{\\pi }{6},\\,x=\\frac{5\\pi }{6}.\n$$\n\nTherefore, $f(x)$ has stationary points at $x=-\\frac{\\pi }{6}$ and $x=\\frac{5\\pi }{6}.$\n\n- Second, we note that ${f}^{′}(x)$ exists for all values of $x\\in (-\\pi ,\\pi ).$ So $f(x)$ has no non-stationary critical points.\n\nTherefore, we conclude that the critical points of $f(x)$ for $x\\in (-\\pi ,\\pi )$ are ${x}_{1}=-\\frac{\\pi }{6}$ and ${x}_{2}=\\frac{5\\pi }{6}.$\n\nFinally,\n\n$$\n{x}_{1}\\cdot {x}_{2}=-\\frac{\\pi }{6}\\cdot \\frac{5\\pi }{6}=-\\frac{5{\\pi }^{2}}{36}.\n$$"}] [{:db/id #edb/ref 17592186152417 :knowledge-point/_questions [{:db/id #edb/ref 17592186152238 :knowledge-point/id #uuid "890526df-fd1a-5340-8732-efc0c1a1b0ae" :knowledge-point/title "Estimating the Equation of a Trendline"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "406ddd97-a2f3-5770-b220-a12ff910fb55" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.7" :db/id #edb/ref 17592186266727} {:answer/id #uuid "78fccb29-a94d-5fd1-8387-f1f5806cc249" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-0.7" :db/id #edb/ref 17592186267210} {:answer/id #uuid "808bfacd-b828-51bc-aac7-15a52841d9f6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1.5" :db/id #edb/ref 17592186267276} {:answer/id #uuid "8305f82a-d153-5349-9a40-5df62a8c2dd4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186267297} {:answer/id #uuid "d926c8aa-6d92-5c1f-a305-6a624a663b13" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2.5" :db/id #edb/ref 17592186268066}] :answer-field/correct {:answer/id #uuid "808bfacd-b828-51bc-aac7-15a52841d9f6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1.5" :db/id #edb/ref 17592186267276} :answer-field/id #uuid "1c5c0a7e-bde9-5222-ac42-addf6181e056" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186268450}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "bf5281e3-0502-59b7-8231-a65966150dfe" :question/math-academy-id "q-133768" :question/problem "![](images/cb/cbe12f1271134a82701640386fcf89e39da4efbca3658569aff52cc743272660.png)\n\nEstimate the slope of the trend line for the scatter plot above. Round your answer to the nearest $0.5.$" :question/worked-solution "First, let's draw an approximate trend line for our scatter plot:\n\n![](images/05/0575edf80f4a6f26c8f1002404ac04331d4c5d1f81b644021bc6284a6212338a.png)\n\nIt seems that the trend line passes through $({x}_{1},{y}_{1})≈(2,2)$ and $({x}_{2},{y}_{2})≈(6,8).$\n\nTherefore, we estimate the slope $m$ of the line as follows:\n\n$$\n\\begin{aligned}m & ≈\\frac{{y}_{2}-{y}_{1}}{{x}_{2}-{x}_{1}} \\\\  & =\\frac{8-2}{6-2} \\\\  & =\\frac{6}{4} \\\\  & =1.5\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186180064 :knowledge-point/_questions [{:db/id #edb/ref 17592186179653 :knowledge-point/id #uuid "892f45fd-1e75-5500-90c3-0218fab5f1e1" :knowledge-point/title "Using Trend Lines to Make Predictions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "02d1fd6e-6806-5107-a9b9-f1166aad9873" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2012" :db/id #edb/ref 17592186266168} {:answer/id #uuid "49bae636-6d63-5ff3-91b0-bda02c7cd5cf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2008" :db/id #edb/ref 17592186266797} {:answer/id #uuid "49efc2d2-24de-56ad-9d1a-ea04160e642f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2006" :db/id #edb/ref 17592186266800} {:answer/id #uuid "72680e93-fc03-5818-886b-1fb7836935fa" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2010" :db/id #edb/ref 17592186267147} {:answer/id #uuid "817d7a73-060a-5abb-89b0-40c2335aae2e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2004" :db/id #edb/ref 17592186267283}] :answer-field/correct {:answer/id #uuid "72680e93-fc03-5818-886b-1fb7836935fa" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2010" :db/id #edb/ref 17592186267147} :answer-field/id #uuid "4f0345eb-4f3c-542f-aca7-5c58e9ccc429" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186268544}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "04c26611-8a14-59f2-b00c-17923a404b5a" :question/math-academy-id "q-133772" :question/problem "![](images/97/9749ca6ec771a94dc60c64a48c2b3924641db17ced56b131bc530e1eb51eb1a0.png)\n\nThe scatter plot above shows the population of a town recorded at certain times between the years $2000$ and $2020.$\nUse the trend line to estimate in which year the town's population was $56\\,000.$" :question/worked-solution "To make our estimation, we proceed as follows:\n\n- We start at $y=56$ on the vertical axis.\n\n![](images/a9/a9d57651c5c342c3d619a20cfae2bc632df47f8924d49f400ed764870b7ae900.png)\n\n- Then, we move right until we intersect the trend line.\n\n![](images/c8/c816d47fc84f31c3a436818777d9473b68e9d8468051c40fe9b7b94005cc89ee.png)\n\n- Finally, we move down until we intersect the horizontal axis.\n\n![](images/e6/e6cbfe34a6e3bd002171d2474542a12c66b7d88ce5989b0fbb4b3542f76a2155.png)\n\nTherefore, the population was $56\\,000$ in approximately the year $2000+10=2010.$"}] [{:db/id #edb/ref 17592186180065 :knowledge-point/_questions [{:db/id #edb/ref 17592186179654 :knowledge-point/id #uuid "28adc95e-e6e5-580c-9eed-55a3d12d5232" :knowledge-point/title "Using Trend Line Equations to Make a Prediction"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4f440f8d-212e-598d-8f9f-659b6451b176" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "10" :db/id #edb/ref 17592186266851} {:answer/id #uuid "52760bde-f5a5-5528-95ef-7bbe23fe19c7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "14" :db/id #edb/ref 17592186266881} {:answer/id #uuid "584b3843-6687-57b7-ac8c-269a9c085fc3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "13" :db/id #edb/ref 17592186266932} {:answer/id #uuid "78ec6a8d-4d13-5508-b86f-b1f23b549353" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186267209} {:answer/id #uuid "9d86b59d-0202-5aff-b73f-257b8701b1a0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "12" :db/id #edb/ref 17592186267561}] :answer-field/correct {:answer/id #uuid "52760bde-f5a5-5528-95ef-7bbe23fe19c7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "14" :db/id #edb/ref 17592186266881} :answer-field/id #uuid "0ecb75f6-2653-5a85-866a-87ded5f8c3cc" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186268434}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "f9a2fa13-4227-5518-b473-4e39aa559784" :question/math-academy-id "q-133774" :question/problem "![](images/47/47b77320474a559f69e6ef08b8f6638aac920b05014820ab1b4b82690059c997.png)\n\nThe scatter plot above gives the correspondence between the variables $x$ and $y$ for some data points.\nThe equation of the trend line is $y=-0.5x+9.$ Assuming this trend continues, estimate the value of $x$ when $y=2.$" :question/requires-calculator true :question/worked-solution "We can estimate the required value by substituting $y=2$ into the equation of the trend line and solving for $x:$\n\n$$\n\\begin{aligned}y & =-0.5x+9 \\\\ 2 & =-0.5x+9 \\\\ 2+0.5x & =9 \\\\ 0.5x & =7 \\\\ x & =14\\end{aligned}\n$$\n\nTherefore, according to this model, when $y=2$ we have $x≈14.$\n\nNote: The point where $y=2$ is not shown on our trend line. Therefore, our result *may* be unreliable."}] [{:db/id #edb/ref 17592186400695 :knowledge-point/_questions [{:db/id #edb/ref 17592186179654 :knowledge-point/id #uuid "28adc95e-e6e5-580c-9eed-55a3d12d5232" :knowledge-point/title "Using Trend Line Equations to Make a Prediction"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e4c4d81f-1807-5985-bc75-f78a53aceac8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$10$ decades" :db/id #edb/ref 17592186400697} {:answer/id #uuid "2b8e005e-3461-54dc-ade3-c36922d765ff" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$7$ decades" :db/id #edb/ref 17592186400698} {:answer/id #uuid "f3927082-1031-515d-8b67-7ab60167c394" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$11$ decades" :db/id #edb/ref 17592186400699} {:answer/id #uuid "72fb5990-5df5-5b7d-af99-8c775eef439e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$8$ decades" :db/id #edb/ref 17592186400700} {:answer/id #uuid "baae8426-6809-58f7-b30c-71ec0d63e5b6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$9$ decades" :db/id #edb/ref 17592186400701}] :answer-field/correct {:answer/id #uuid "baae8426-6809-58f7-b30c-71ec0d63e5b6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$9$ decades" :db/id #edb/ref 17592186400701} :answer-field/id #uuid "276c6bfa-9bed-5b15-b91d-56f8ec1aea0e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186400696}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "87bad21a-36f4-5e06-9484-4b7826190ce1" :question/math-academy-id "q-133929" :question/problem "![](images/ce/ce3aec85d418c8f51988f819c04403f3f3ea2e0c0e35165ed729fc1e78d0f12f.png)\n\nThe scatter plot shows the value of an artwork $y,$ in thousands of dollars, and the number of decades $x$ since it was first created. The equation of the trend line is $y=3x+5.$ \n\nAssuming this trend continues, estimate the time it takes for the artwork to be worth $$32\\,000.$" :question/worked-solution "To predict the time that must pass before the artwork is worth $$32\\,000,$ we need to substitute $y=32$ into the equation of the trend line and solve for $x:$\n\n$$\n\\begin{aligned}y & =3x+5 \\\\ 32 & =3x+5 \\\\ 3x & =27 \\\\ x & =9\\end{aligned}\n$$\n\n \n\nTherefore, according to this model, it takes approximately $9$ decades for the artwork to have a value of $$32\\,000.$ \n\nNote: The point where $y=32$ is not shown on our trend line. Therefore, our result *may* be unreliable."}] [{:db/id #edb/ref 17592186268936 :knowledge-point/_questions [{:db/id #edb/ref 17592186179655 :knowledge-point/id #uuid "877509f5-a5de-55d2-ab5d-6c37fc5b0650" :knowledge-point/title "Making a Prediction by Estimating a Trend Line"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "35b193b3-2679-5e57-8519-13a75ee39c10" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "9.5" :db/id #edb/ref 17592186266607} {:answer/id #uuid "63960119-96c8-5a11-ac8b-ce536b8c33fa" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186267020} {:answer/id #uuid "6d5351fc-ea93-5077-808a-2e970121ae5c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8.5" :db/id #edb/ref 17592186267106} {:answer/id #uuid "741f39ef-7c89-590a-98d9-9e6e5d60231a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "10" :db/id #edb/ref 17592186267164} {:answer/id #uuid "e30490b9-cb52-56b4-adaf-fdd3ed2b6536" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "9" :db/id #edb/ref 17592186268150}] :answer-field/correct {:answer/id #uuid "e30490b9-cb52-56b4-adaf-fdd3ed2b6536" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "9" :db/id #edb/ref 17592186268150} :answer-field/id #uuid "454866ab-76dc-5d3a-ae98-8d88fb102885" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186268522}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "b4e2e69a-6742-55aa-baed-902f71aaf13b" :question/math-academy-id "q-133943" :question/problem "![](images/7b/7ba7aa1cf49bb5a2dc430d9a21baaa8491aa61d8898f2aad142406c5c569b51b.png)\n\nThe scatter plot above gives the correspondence between the variables $x$ and $y$ for some data points. Estimate the value of $x$ when $y=7.$ \n\n*Hint: Assume the trend is linear, and that the trend line passes through the points $(1,1)$ and $(5,4).$*" :question/worked-solution "First, using the hint, let's draw an approximate trend line for our scatter plot.\n\n![](images/59/59efe1b79b0d032179a5210ee694b0d59ad082853ca9fb80a9d79d9f6444f2bf.png)\n\nOur trend line passes through $({x}_{1},{y}_{1})=(1,1)$ and $({x}_{2},{y}_{2})=(5,4).$\n\nWe will write the equation of the line in the slope-intercept form \n\n$$\ny=mx+b.\n$$\n\nFirst, we calculate the slope $m$ of the line as follows:\n\n$$\n\\begin{aligned}m & =\\frac{{y}_{2}-{y}_{1}}{{x}_{2}-{x}_{1}} \\\\  & =\\frac{4-1}{5-1} \\\\  & =\\frac{3}{4} \\\\  & =0.75\\end{aligned}\n$$\n\nSubstituting $m=0.75$ into the slope-intercept form above, we get\n\n$$\ny=0.75x+b.\n$$\n\nWe now need to calculate the $y$-intercept $b.$ We can do this by substituting the coordinates of a point on the line. Any point will do, so let's substitute $(1,1):$\n\n$$\n\\begin{aligned}y & =0.75x+b \\\\ 1 & =0.75(1)+b \\\\ 1 & =0.75+b \\\\ b & =0.25\\end{aligned}\n$$\n\nTherefore, the equation of the line is \n\n$$\ny=0.75x+0.25.\n$$\n\nFinally, we substitute $y=7$ into the equation above and solve for $x:$\n\n$$\n\\begin{aligned}y & =0.75x+0.25 \\\\ 7 & =0.75x+0.25 \\\\ 6.75 & =0.75x \\\\ x & =9\\end{aligned}\n$$\n\nTherefore, according to this model, when $y=7$ we have $x≈9.$\n\nNote: The point where $y=7$ is not shown on our trend line. Therefore, our result *may* be unreliable."}] [{:db/id #edb/ref 17592186268942 :knowledge-point/_questions [{:db/id #edb/ref 17592186179655 :knowledge-point/id #uuid "877509f5-a5de-55d2-ab5d-6c37fc5b0650" :knowledge-point/title "Making a Prediction by Estimating a Trend Line"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "17f29363-b569-5d10-bfb6-d2079ad002cc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "18" :db/id #edb/ref 17592186266341} {:answer/id #uuid "21adce06-163c-56df-805d-189e82316cfd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "20" :db/id #edb/ref 17592186266444} {:answer/id #uuid "5eb9a5f6-a02a-50a1-82fc-c1b17fea560a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "17" :db/id #edb/ref 17592186266978} {:answer/id #uuid "8471999f-0fd0-539e-80f6-36a51c97305c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "21" :db/id #edb/ref 17592186267308} {:answer/id #uuid "84f2a1f9-f092-5363-87eb-b298f12956d6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "19" :db/id #edb/ref 17592186267314}] :answer-field/correct {:answer/id #uuid "17f29363-b569-5d10-bfb6-d2079ad002cc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "18" :db/id #edb/ref 17592186266341} :answer-field/id #uuid "6bb94996-186d-52e6-9592-b3343bd68e4c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186268601}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "9cd1cd6f-81d1-5aa8-a97e-ba1b2bd9d144" :question/math-academy-id "q-133965" :question/problem "![](images/e3/e3319694b1112e92602219492d51116d514a88e885431ac1ef0c8f8becb0dc18.png)\n\nA tea shop wants to determine the relationship between the outside temperature and the number of customers they serve. The scatter plot above shows the information they collected over several days. Assuming this trend continues, estimate the number of customers the tea shop expects to serve if the outside temperature is ${36}^{∘}\\,\\text{C}.$\n\n*Hint: Assume the trend is linear and that the trend line passes through the points $(15,60)$ and $(30,30).$*" :question/worked-solution "First, using the hint, let's draw an approximate trend line for our scatter plot.\n\n![](images/7a/7adb5dd9bfcfcea8842eebfcacc704237f010f87c8ffd695afab890801237abd.png)\n\nThe trend line passes through $({x}_{1},{y}_{1})=(15,60)$ and $({x}_{2},{y}_{2})=(30,30).$\n\nWe will write the equation of the line in the slope-intercept form \n\n$$\ny=mx+b.\n$$\n\nFirst, we find the slope $m$ of the line as follows:\n\n$$\n\\begin{aligned}m & =\\frac{{y}_{2}-{y}_{1}}{{x}_{2}-{x}_{1}} \\\\  & =\\frac{30-60}{30-15} \\\\  & =\\frac{(-30)}{15} \\\\  & =-2\\end{aligned}\n$$\n\nSubstituting $m=-2$ into the slope-intercept form above, we get\n\n$$\ny=-2x+b.\n$$\n\nWe now need to calculate the $y$-intercept $b.$ We can do this by substituting the coordinates of a point on the line. Any point will do, so let's substitute $(15,60):$\n\n$$\n\\begin{aligned}y & =-2x+b \\\\ 60 & =-2(15)+b \\\\ 60 & =-30+b \\\\ b & =90\\end{aligned}\n$$\n\nTherefore, the equation of the line is \n\n$$\ny=-2x+90.\n$$\n\nFinally, we substitute $x=36$ into the equation above, which gives\n\n$$\n\\begin{aligned}y & =-2x+90 \\\\  & =-2(36)+90 \\\\  & =-72+90 \\\\  & =18.\\end{aligned}\n$$\n\nTherefore, according to this model, the tea shop expects to serve $18$ customers.\n\nNote: The point where $x=36$ is not shown on our trend line. Therefore, our result *may* be unreliable."}] [{:db/id #edb/ref 17592186268943 :knowledge-point/_questions [{:db/id #edb/ref 17592186179653 :knowledge-point/id #uuid "892f45fd-1e75-5500-90c3-0218fab5f1e1" :knowledge-point/title "Using Trend Lines to Make Predictions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3219263b-abe6-5728-9661-5138a2700247" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$5$ hours" :db/id #edb/ref 17592186266585} {:answer/id #uuid "381bfb6f-c43f-59ee-a686-ab558a709a60" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$5.5$ hours" :db/id #edb/ref 17592186266631} {:answer/id #uuid "5bc2d41a-ea63-5ca1-9147-b914f0535d73" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$4.5$ hours" :db/id #edb/ref 17592186266957} {:answer/id #uuid "6b0c2701-9911-51b4-900b-6cab03bd2c54" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$6$ hours" :db/id #edb/ref 17592186267091} {:answer/id #uuid "eec77403-0e51-5d0c-9b05-535493cd6148" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$4$ hours" :db/id #edb/ref 17592186268269}] :answer-field/correct {:answer/id #uuid "3219263b-abe6-5728-9661-5138a2700247" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$5$ hours" :db/id #edb/ref 17592186266585} :answer-field/id #uuid "8409954c-10b2-59ea-b026-9a4d57399061" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186268643}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "d6bab4ea-9515-5432-8897-bfe0c69aa515" :question/math-academy-id "q-133967" :question/problem "![](images/1d/1d4df2d201ccbaf2305534d61c8a0ed5f7957b1629d8cd2fbd5fff933283c0dc.png)\n\nThe scatter plot above shows the number of matches won by some chess players in a championship and the hours they spend training per day.\nUse the trend line to estimate how much time players need to train each day to win $30$ championship games." :question/worked-solution "To make our estimation, we proceed as follows:\n\n- We start at $y=30$ on the vertical axis.\n\n![](images/26/26ba10258a8794a97dfc5e61c8160b342ed6890f7a9af40c1e21ac814c779188.png)\n\n- Then, we move right until we intersect the trend line.\n\n![](images/e5/e50d79adb9803f6509314cf3512fcd388ccc78b287d6653b9e318ce54ce45022.png)\n\n- Finally, we move down until we intersect the horizontal axis.\n\n![](images/a9/a9bd5a7973ecb2e88c328d0943d4bfebe9862b2cea1abbd0b3fa3665fa177167.png)\n\nTherefore, a chess player that wins $30$ games spends around $5$ hours training per day."}] [{:db/id #edb/ref 17592186388307 :knowledge-point/_questions [{:db/id #edb/ref 17592186152233 :knowledge-point/id #uuid "79f1049a-8af9-50ee-9dac-9dbd9c19bdc6" :knowledge-point/title "Correctly Identifying a Scatter Plot"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d71911a4-1607-57a3-939c-1ce77fc6b325" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/d5/d5d7978459fa262b16b4216fa5363a8f14f431e6524163d6e1bbc0f0bdaad7dc.png" :db/id #edb/ref 17592186388309} {:answer/id #uuid "f6dd706d-50c4-58f6-b939-f20e9d0556b5" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/5b/5bdbaadf2d3ea794c145365f5ee61ee4c1551dc72b62c8a681933b9aac74d214.png" :db/id #edb/ref 17592186388310} {:answer/id #uuid "30229580-8e50-507d-83e4-267c38aa9543" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/75/75196d39e72e9ce6ba5b0b32ca486d191bbe209a8a646b030c83b2979fdc3054.png" :db/id #edb/ref 17592186388311} {:answer/id #uuid "6aa0cce7-f139-50cd-9987-c94e8df7b25d" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/58/58c61701533884a6497bb0e3f692adf4a4d72c648577451fae650dbd164e5001.png" :db/id #edb/ref 17592186388312} {:answer/id #uuid "237d4951-e701-5b11-a8f1-c101458de5ec" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/37/37667e67c6148e8e46c216b1351ada6b16b0e9d3a22de69564415679535fc92e.png" :db/id #edb/ref 17592186388313}] :answer-field/correct {:answer/id #uuid "f6dd706d-50c4-58f6-b939-f20e9d0556b5" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/5b/5bdbaadf2d3ea794c145365f5ee61ee4c1551dc72b62c8a681933b9aac74d214.png" :db/id #edb/ref 17592186388310} :answer-field/id #uuid "02ccddff-56cd-51ab-852a-3e4a3e3b4576" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186388308}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "935951a4-ee2a-54bc-9e42-14a72505ef8e" :question/math-academy-id "q-133968" :question/problem "A teacher wants to determine whether a student's performance in mathematics influences their performance in physics. The following table shows the grades of $5$ students in a mathematics and physics class. \n\n| **Math Grade** | **$8$** | **$6$** | **$8$** | **$4$** | **$5$** |\n| --- | --- | --- | --- | --- | --- |\n| **Physics Grade** | $9$ | $5$ | $8$ | $4$ | $3$ |\n\nWhich of the following scatter plots represents this data?" :question/worked-solution "We create a scatter diagram in the coordinate plane as follows:\n\n- First, we draw the independent variable (math grade) along the horizontal axis.\n\n- Then, we draw the dependent variable (physics grade) along the vertical axis.\n\n- Finally, we plot the points that correspond to the pairs from the data.\n\nThis gives us the following scatter plot.\n\n![](images/5b/5bdbaadf2d3ea794c145365f5ee61ee4c1551dc72b62c8a681933b9aac74d214.png)"}] [{:db/id #edb/ref 17592186388314 :knowledge-point/_questions [{:db/id #edb/ref 17592186152233 :knowledge-point/id #uuid "79f1049a-8af9-50ee-9dac-9dbd9c19bdc6" :knowledge-point/title "Correctly Identifying a Scatter Plot"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1d96ca6e-aa39-56b6-a603-08fb5fae2a80" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/72/726a22a7d72af2ba9a7b9c9568cc1723557ee8c0af4dd38a3dd9bacca4f72769.png" :db/id #edb/ref 17592186388316} {:answer/id #uuid "9816374b-f222-57ec-9346-41bf02f900e3" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/ef/ef920634ab0391c8b13566e8575ee66839bcaf38dd6e4d87bfa336035ab10166.png" :db/id #edb/ref 17592186388317} {:answer/id #uuid "66b02031-af4a-5dc1-ac7f-ed1163e286f3" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/b7/b741264e080009d9e634e7ffce5e9041b6cd65b34e4d840700397a7378255ea8.png" :db/id #edb/ref 17592186388318} {:answer/id #uuid "448502eb-fb15-5ab2-9d96-04aeaf2da0b1" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/8e/8ea63450225d8b50e6f00e012afcd3afe8215eb573ed3a31ce9aa57c30ec8132.png" :db/id #edb/ref 17592186388319} {:answer/id #uuid "8388f37e-7b04-57a4-a21b-751817dec11b" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/81/81364754556cfeed2c4a2b74d2c745c054491e7f0a9e1d2512fffe6dc4569e5d.png" :db/id #edb/ref 17592186388320}] :answer-field/correct {:answer/id #uuid "66b02031-af4a-5dc1-ac7f-ed1163e286f3" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/b7/b741264e080009d9e634e7ffce5e9041b6cd65b34e4d840700397a7378255ea8.png" :db/id #edb/ref 17592186388318} :answer-field/id #uuid "da2b298a-e144-5d4b-ab37-e427ce14674c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186388315}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "711b7d57-8e73-5262-a6cb-c7a387e51978" :question/math-academy-id "q-133969" :question/problem "Lucy, who plays basketball, notices that the number of points she scores in a game increases as a function of the number of hours she practices her jump shot each week. She records the following data.\n\n| **Number of Hours Training** | **$4$** | **$6$** | **$7$** | **$8$** | **$10$** |\n| --- | --- | --- | --- | --- | --- |\n| **Points Scored per Game** | $8$ | $12$ | $16$ | $20$ | $28$ |\n\nWhich of the following scatter plots represents this data?" :question/worked-solution "We create a scatter diagram in the coordinate plane as follows:\n\n- First, we draw the independent variable (number of hours training) along the horizontal axis.\n\n- Then, we draw the dependent variable (points scored per game) along the vertical axis.\n\n- Finally, we plot the points that correspond to the pairs from the data.\n\nThis gives us the following scatter plot.\n\n![](images/b7/b741264e080009d9e634e7ffce5e9041b6cd65b34e4d840700397a7378255ea8.png)"}] [{:db/id #edb/ref 17592186176329 :knowledge-point/_questions [{:db/id #edb/ref 17592186176031 :knowledge-point/id #uuid "534de76f-d4bc-55b5-858e-2b594f63b7bc" :knowledge-point/title "Calculating Distance Given Speed and Time"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "00100cbe-fb7e-5a60-bebf-70ac5833c23b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$145$ miles" :db/id #edb/ref 17592186266151} {:answer/id #uuid "39cf88bf-156e-548d-929c-87b676eb8d65" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$165$ miles" :db/id #edb/ref 17592186266654} {:answer/id #uuid "63e7bb25-145e-5483-bd59-9ec85466a225" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$185$ miles" :db/id #edb/ref 17592186267023} {:answer/id #uuid "6fa4073d-79a4-50e5-bcf9-c804d6b75650" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$21.3$ miles" :db/id #edb/ref 17592186267124} {:answer/id #uuid "cde549c5-0f81-5026-93bf-a2769df847df" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$18.3$ miles" :db/id #edb/ref 17592186267983}] :answer-field/correct {:answer/id #uuid "39cf88bf-156e-548d-929c-87b676eb8d65" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$165$ miles" :db/id #edb/ref 17592186266654} :answer-field/id #uuid "bef8f0e7-5010-5fd0-8979-0100c812c7ee" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186268746}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "6a0c4502-fd0b-5e9b-b54c-913ee6f1d90c" :question/math-academy-id "q-133998" :question/problem "A car traveled for $3$ hours at a constant speed of $55$ miles per hour. Find the distance covered by the car." :question/worked-solution "The speed is $55$ miles per hour. To find the distance covered in $3$ hours, we multiply the speed by $3.$ This gives\n\n$$\n\\begin{aligned}\\text{distance} & =\\text{speed}\\cdot \\text{time} \\\\  & =55\\times 3 \\\\  & =165.\\end{aligned}\n$$\n\nTherefore, the car covered $165$ miles in $3$ hours."}] [{:db/id #edb/ref 17592186268946 :knowledge-point/_questions [{:db/id #edb/ref 17592186152236 :knowledge-point/id #uuid "327d9a77-b2dd-57b1-b959-570684714bf9" :knowledge-point/title "Identifying the Trendline of a Given Scatter Plot"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0badc2a7-9d18-544e-95c9-c64da7e9c069" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "s" :db/id #edb/ref 17592186266252} {:answer/id #uuid "35da4120-6c49-56a1-b4f1-055106750242" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "q" :db/id #edb/ref 17592186266608} {:answer/id #uuid "3d3a362f-50bb-5456-a748-deeddca0fb05" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "There is no linear trend in the data" :db/id #edb/ref 17592186266685} {:answer/id #uuid "7bd