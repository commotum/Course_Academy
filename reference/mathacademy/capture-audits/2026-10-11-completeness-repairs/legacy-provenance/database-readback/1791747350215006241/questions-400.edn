 :answer.type/math} :answer/value "s" :db/id #edb/ref 17592186266356} {:answer/id #uuid "206a46ed-1970-5316-95be-58e720077042" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "q" :db/id #edb/ref 17592186266429} {:answer/id #uuid "9f00bb6e-9294-56b5-992c-5b2f338a0360" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "p" :db/id #edb/ref 17592186267579} {:answer/id #uuid "aa4ceff1-9762-5e9a-86c1-ecb6e7702031" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "r" :db/id #edb/ref 17592186267682} {:answer/id #uuid "ada9a303-0bc7-52d4-9bc2-ee3bd198d19d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "There is no linear trend in the data" :db/id #edb/ref 17592186267713}] :answer-field/correct {:answer/id #uuid "ada9a303-0bc7-52d4-9bc2-ee3bd198d19d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "There is no linear trend in the data" :db/id #edb/ref 17592186267713} :answer-field/id #uuid "2f754f6c-4370-57d3-9e5d-4f14615413c2" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186268490}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "595cbfc4-8fff-5045-9e69-dae0c1acb047" :question/math-academy-id "q-134009" :question/problem "![](images/f6/f64050151e65151975954cdf169379c5ea6ee80b0348a6cb03706ab64c7c7105.png)\n\nWhich of the following is the trend line of the scatter plot?" :question/worked-solution "The plot shows that the data points are scattered along a curve, not a straight line.\n\n![](images/00/00fe583ae8b83bfef31c1914489be7794aa4b7b2850cd01243a46b8d86d1dddb.png)\n\nTherefore, there is no linear trend in the data."}] [{:db/id #edb/ref 17592186268953 :knowledge-point/_questions [{:db/id #edb/ref 17592186152237 :knowledge-point/id #uuid "63426ad7-4275-5ac3-854d-e91ec00dcbe3" :knowledge-point/title "Determining the Equation of a Trendline"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0cd690fa-a856-5e7a-9318-0c4566b49546" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=-\\frac{6}{7}x+8" :db/id #edb/ref 17592186266261} {:answer/id #uuid "222179f7-b6d3-5bda-ba3b-3ad5ca6b0879" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=-\\frac{2}{3}x+9" :db/id #edb/ref 17592186266448} {:answer/id #uuid "676d808b-15b5-5614-89b0-8e029be3a390" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=-\\frac{6}{7}x+9" :db/id #edb/ref 17592186267061} {:answer/id #uuid "a05574d9-4140-5362-b547-5792491d39de" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=-\\frac{5}{7}x+9" :db/id #edb/ref 17592186267591} {:answer/id #uuid "a5de5494-8c30-5f08-bbb3-f4fedda8e8dd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=-\\frac{5}{7}x+8" :db/id #edb/ref 17592186267644}] :answer-field/correct {:answer/id #uuid "676d808b-15b5-5614-89b0-8e029be3a390" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=-\\frac{6}{7}x+9" :db/id #edb/ref 17592186267061} :answer-field/id #uuid "90a152be-2b26-5653-9dda-9d79bf62f9af" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186268659}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "cb94748a-2270-55c2-8da9-a11e4005f88b" :question/math-academy-id "q-134019" :question/problem "![](images/31/31394106551498e7fd3a5cf57773f11ae31c7bc80c9a12272e95033bdcfd462e.png)\n\nDetermine the equation of the trend line shown above." :question/worked-solution "Notice that the trend line passes through the points $({x}_{1},{y}_{1})=(0,9)$ and $({x}_{2},{y}_{2})=(7,3).$\n\nWe will write the equation of the line in the slope-intercept form \n\n$$\ny=mx+b.\n$$\n\nFirst, we compute the slope $m$ of the line, as follows:\n\n$$\n\\begin{aligned}m & =\\frac{{y}_{2}-{y}_{1}}{{x}_{2}-{x}_{1}} \\\\  & =\\frac{3-9}{7-0} \\\\  & =\\frac{-6}{7} \\\\  & =-\\frac{6}{7}\\end{aligned}\n$$\n\nSubstituting $m=-\\frac{6}{7}$ into the slope-intercept form above, we get\n\n$$\ny=-\\frac{6}{7}x+b.\n$$\n\nWe now need to find the $y$-intercept $b.$ We can find this by substituting the coordinates of a point on the line. Any point will do, so let's substitute $(0,9):$\n\n$$\n\\begin{aligned}y & =-\\frac{6}{7}x+b \\\\ 9 & =-\\frac{6}{7}(0)+b \\\\ 9 & =0+b \\\\ b & =9\\end{aligned}\n$$\n\nTherefore, the equation of the line is \n\n$$\ny=-\\frac{6}{7}x+9.\n$$"}] [{:db/id #edb/ref 17592186268954 :knowledge-point/_questions [{:db/id #edb/ref 17592186152237 :knowledge-point/id #uuid "63426ad7-4275-5ac3-854d-e91ec00dcbe3" :knowledge-point/title "Determining the Equation of a Trendline"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3800c633-4663-5a7c-977b-4d0c6dda0f87" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=\\frac{7}{5}x-\\frac{3}{5}" :db/id #edb/ref 17592186266629} {:answer/id #uuid "53efa526-eb5e-5256-af09-1eec2833abff" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=\\frac{7}{5}x-\\frac{2}{5}" :db/id #edb/ref 17592186266895} {:answer/id #uuid "aba8afc3-be94-5f08-8b22-73af4c6b41c5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=\\frac{6}{5}x-\\frac{2}{5}" :db/id #edb/ref 17592186267693} {:answer/id #uuid "ef8916a0-dcf5-50b0-b591-84f24b525679" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=\\frac{8}{5}x-\\frac{3}{5}" :db/id #edb/ref 17592186268274} {:answer/id #uuid "f31ff6ea-86e9-5bba-a3ed-309adf564a34" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=\\frac{6}{5}x-\\frac{3}{5}" :db/id #edb/ref 17592186268306}] :answer-field/correct {:answer/id #uuid "aba8afc3-be94-5f08-8b22-73af4c6b41c5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=\\frac{6}{5}x-\\frac{2}{5}" :db/id #edb/ref 17592186267693} :answer-field/id #uuid "d9d24660-a466-52cd-ab29-3ad82a1272ba" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186268793}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "1c42b7eb-86b2-59d5-8ce6-728291f9e718" :question/math-academy-id "q-134023" :question/problem "![](images/1c/1c9f30692222eaaed4cda6b608dcc1ccb01eefd6b5fa7730b5b8bb29c9f528b1.png)\n\nDetermine the equation of the trend line shown above." :question/worked-solution "Notice that the trend line passes through the points $({x}_{1},{y}_{1})=(2,2)$ and $({x}_{2},{y}_{2})=(7,8).$\n\nWe will write the equation of the line in the slope-intercept form \n\n$$\ny=mx+b.\n$$\n\nFirst, we compute the slope $m$ of the line, as follows:\n\n$$\n\\begin{aligned}m & =\\frac{{y}_{2}-{y}_{1}}{{x}_{2}-{x}_{1}} \\\\  & =\\frac{8-2}{7-2} \\\\  & =\\frac{6}{5}\\end{aligned}\n$$\n\nSubstituting $m=\\frac{6}{5}$ into the slope-intercept form above, we get\n\n$$\ny=\\frac{6}{5}x+b.\n$$\n\nWe now need to find the $y$-intercept $b.$ We can find this by substituting the coordinates of a point on the line. Any point will do, so let's substitute $(2,2):$\n\n$$\n\\begin{aligned}y & =\\frac{6}{5}x+b \\\\ 2 & =\\frac{6}{5}(2)+b \\\\ 2 & =\\frac{12}{5}+b \\\\ 10 & =12+5b \\\\ -2 & =5b \\\\ b & =-\\frac{2}{5}\\end{aligned}\n$$\n\nTherefore, the equation of the line is \n\n$$\ny=\\frac{6}{5}x-\\frac{2}{5}.\n$$"}] [{:db/id #edb/ref 17592186268957 :knowledge-point/_questions [{:db/id #edb/ref 17592186152238 :knowledge-point/id #uuid "890526df-fd1a-5340-8732-efc0c1a1b0ae" :knowledge-point/title "Estimating the Equation of a Trendline"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "85e950e4-4f31-56d6-b780-7f613d916580" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=-0.5x+7" :db/id #edb/ref 17592186267323} {:answer/id #uuid "95835b8d-412b-5f8f-ad13-bd0cceeefc76" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=-1.5x+6" :db/id #edb/ref 17592186267479} {:answer/id #uuid "e9f40f28-45a1-51e8-91ce-8332e573ca21" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=-x+5" :db/id #edb/ref 17592186268230} {:answer/id #uuid "fa3381b5-606e-57ef-aa88-1eeb423ceab7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=-0.5x+5" :db/id #edb/ref 17592186268360} {:answer/id #uuid "fa94c930-a716-5697-abac-a07e0bafa0ee" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=-x+7" :db/id #edb/ref 17592186268362}] :answer-field/correct {:answer/id #uuid "fa94c930-a716-5697-abac-a07e0bafa0ee" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=-x+7" :db/id #edb/ref 17592186268362} :answer-field/id #uuid "202555d8-a079-561f-a3ef-02ab11a55efb" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186268456}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "cd67326e-eade-5de0-b602-784a91831a0b" :question/math-academy-id "q-134031" :question/problem "![](images/11/111833881cf8e939d896f23a5ab7ca436f9265e7b8fd66c099eb118eab8fd6b0.png)\n\nEstimate the equation of the trend line for the scatter plot above. Round both the slope and the $y$-intercept to the nearest $0.5.$" :question/worked-solution "First, let's draw an approximate trend line for our scatter plot:\n\n![](images/fd/fdad2c939372e14617ba4e393037d7f5852cd8114467aa914ccb8963c0eacfeb.png)\n\nIt seems that the trend line passes through $({x}_{1},{y}_{1})≈(2,5)$ and $({x}_{2},{y}_{2})≈(6,1).$\n\nWe will write the equation of the line in the slope-intercept form \n\n$$\ny=mx+b.\n$$\n\nFirst, we estimate the slope $m$ of the line as follows:\n\n$$\n\\begin{aligned}m & ≈\\frac{{y}_{2}-{y}_{1}}{{x}_{2}-{x}_{1}} \\\\  & =\\frac{1-5}{6-2} \\\\  & =\\frac{-4}{4} \\\\  & =-1\\end{aligned}\n$$\n\nSubstituting $m=-1$ into the slope-intercept form above, we get\n\n$$\ny=-x+b.\n$$\n\nWe now need to estimate the $y$-intercept $b.$ We can do this by substituting the coordinates of a point on the line. Any point will do, so let's substitute $(2,5):$\n\n$$\n\\begin{aligned}y & =-x+b \\\\ 5 & =-2+b \\\\ 7 & =b \\\\ b & =7\\end{aligned}\n$$\n\nTherefore, the equation of the line is \n\n$$\ny=-x+7.\n$$"}] [{:db/id #edb/ref 17592186268961 :knowledge-point/_questions [{:db/id #edb/ref 17592186152235 :knowledge-point/id #uuid "7f99f2aa-f977-5d6e-ae62-a826a897ba9b" :knowledge-point/title "Reading a Scatter Plot"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "93b0f7b8-b781-54c4-a185-a692da720e33" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "90%" :db/id #edb/ref 17592186267467} {:answer/id #uuid "93c6b873-1244-55dd-a5d0-7e953959f130" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "85%" :db/id #edb/ref 17592186267468} {:answer/id #uuid "ba35ff19-d85c-5142-84b2-93a8f390294b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "70%" :db/id #edb/ref 17592186267815} {:answer/id #uuid "ce9bdb9f-cdf1-552b-86b5-3b68d3b691fe" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "75%" :db/id #edb/ref 17592186267992} {:answer/id #uuid "da1adb01-9156-561a-b4db-38e2dc065dd9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "80%" :db/id #edb/ref 17592186268075}] :answer-field/correct {:answer/id #uuid "93c6b873-1244-55dd-a5d0-7e953959f130" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "85%" :db/id #edb/ref 17592186267468} :answer-field/id #uuid "0c7565e4-dc8a-5b42-b83a-83fc7e504012" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186268431}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "43fcfab7-3240-5e37-8741-3769fb9bd3d5" :question/math-academy-id "q-134043" :question/problem "![](images/80/80d08441967f6c1a4026fe9ca0d2bdfdde8fac57a2ae0a7b8d6b34889f3469bd.png)\n\nThe scatter plot above shows the relationship between hours of study per week and the overall percentage obtained by students in a math class. What was the overall percentage obtained by the student who studied, on average,  $7$ hours each week?" :question/worked-solution "![](images/39/39e7370f9cf517a7a139fecf71561041a9b1470150e0fa333d3fff679f77882d.png)\n\n    \n\nTo determine the overall percentage obtained by the student who studied $7$ hours each week, we locate $7$ on the horizontal axis and move in the vertical direction until we find some points, as shown above.\n\nThe highlighted point has coordinates $(7,85).$ Therefore, the student who studied $7$ hours each week obtained an overall percentage of $85%.$"}] [{:db/id #edb/ref 17592186398382 :knowledge-point/_questions [{:db/id #edb/ref 17592186152235 :knowledge-point/id #uuid "7f99f2aa-f977-5d6e-ae62-a826a897ba9b" :knowledge-point/title "Reading a Scatter Plot"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3b931d3b-ada2-5b04-a7ba-3e5388b9aa35" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186398384} {:answer/id #uuid "ce0bbf2c-bd3b-5933-b107-38c36abe9e06" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186398385} {:answer/id #uuid "1275d8d1-87ea-51ac-80ba-d13b5b0d06d3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186398386} {:answer/id #uuid "c0d3ff95-8a16-5335-b1eb-84d2fbc5830f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186398387} {:answer/id #uuid "cf078eaa-4e8e-529e-aeaf-cf7c18b72b3c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186398388}] :answer-field/correct {:answer/id #uuid "1275d8d1-87ea-51ac-80ba-d13b5b0d06d3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186398386} :answer-field/id #uuid "c816f258-3ddf-536d-ab66-8610e4b22204" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186398383}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "6b5dde64-1d37-5f32-890c-5a590a1188e6" :question/math-academy-id "q-134085" :question/problem "![](images/55/551ed1182231e19a08653c86ffb7b117c2dc9497b6927f6287ffcd10651b5f56.png)\n\nThe scatter plot above shows the relationship between the number of absences in a month and the size of a class. How many absences were there in a class whose size is $20$ students?" :question/worked-solution "![](images/80/8088e41a66b4aba259d95f3099f71d5777caf876e9278e6b7f11c865ab12f7e0.png)\n\nTo determine the number of absences there were in a class whose size is $20$ students, we locate $20$ on the horizontal axis and move in the vertical direction until we find some points, as shown above.\n\nThe highlighted point has coordinates $(20,6).$ Therefore, there was a total of $6$ absences in the month for the class with $20$ students."}] [{:db/id #edb/ref 17592186268969 :knowledge-point/_questions [{:db/id #edb/ref 17592186175936 :knowledge-point/id #uuid "a2ac0065-9315-547a-a9cf-c6a5abea1aed" :knowledge-point/title "Computing Covariance"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "311e284a-a84b-5e7f-b5a1-e35c8f0d5168" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186266576} {:answer/id #uuid "64ccf930-ce1a-5735-bf79-470826f036dc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186267036} {:answer/id #uuid "76132fbf-5e71-5e70-90ec-a505fc2186fe" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186267185} {:answer/id #uuid "853262fc-b92a-5438-baec-a53e6c209102" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186267317} {:answer/id #uuid "a31cd77b-6b2c-52dc-a626-7500d351a1a2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186267611}] :answer-field/correct {:answer/id #uuid "311e284a-a84b-5e7f-b5a1-e35c8f0d5168" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186266576} :answer-field/id #uuid "aca651ef-8c84-5b8a-8875-73fe007986c0" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186268716}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "1d0e8ef1-dbd3-5d5d-b9cb-f3092550c8dd" :question/math-academy-id "q-134155" :question/problem "Consider the following data sets:\n\n$$\nx={4,\\,6,\\,8,\\,2},\\,y={2,\\,4,\\,10,\\,8}\n$$\n\nYou're given that $\\overset{―}{x}=5$ and $\\overset{―}{y}=6.$ Calculate $\\text{Cov}(x,y).$" :question/worked-solution "The (population) covariance of the data sets $x={{x}_{1},{x}_{2},…,{x}_{n}}$ and $y={{y}_{1},{y}_{2},…,{y}_{n}}$ is given by \n\n$$\n\\text{Cov}(x,y)=\\frac{1}{n}{\\sum }_{i=1}^{n}({x}_{i}-\\overset{―}{x})({y}_{i}-\\overset{―}{y}),\n$$\n\nwhere $\\overset{―}{x}=\\frac{1}{n}{\\sum }_{i=1}^{n}{x}_{i}$ and $\\overset{―}{y}=\\frac{1}{n}{\\sum }_{i=1}^{n}{y}_{i}$ are the means of the data sets.\n\nTherefore, the covariance of our data sets is\n\n$$\n\\begin{aligned}\\text{Cov}(x,y) & =\\frac{1}{n}{\\sum }_{i=1}^{n}({x}_{i}-\\overset{―}{x})({y}_{i}-\\overset{―}{y}) \\\\  & =\\frac{1}{4}[(4-5)(2-6)+(6-5)(4-6)+(8-5)(10-6)+(2-5)(8-6)] \\\\  & =\\frac{1}{4}[(-1)(-4)+(1)(-2)+(3)(4)+(-3)(2)] \\\\  & =\\frac{1}{4}[4-2+12-6] \\\\  & =\\frac{1}{4}\\cdot 8 \\\\  & =2.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186268973 :knowledge-point/_questions [{:db/id #edb/ref 17592186175936 :knowledge-point/id #uuid "a2ac0065-9315-547a-a9cf-c6a5abea1aed" :knowledge-point/title "Computing Covariance"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6c96926a-f4ac-5a4a-bb28-483eebe3a042" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186267101} {:answer/id #uuid "92bb008b-73e2-5f57-aaf9-b1c9670bb361" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186267454} {:answer/id #uuid "98e29162-e94e-5e48-a63c-803330198e5a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186267522} {:answer/id #uuid "de2ab8f0-3c69-58b4-9838-f8a533c7f98f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "7" :db/id #edb/ref 17592186268105} {:answer/id #uuid "f2efc021-dda9-5c9f-ba17-5d373e53d90c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186268303}] :answer-field/correct {:answer/id #uuid "de2ab8f0-3c69-58b4-9838-f8a533c7f98f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "7" :db/id #edb/ref 17592186268105} :answer-field/id #uuid "69377ba2-c0ef-5769-b77b-40c99fa0f34c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186268596}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "4cf798d3-99fb-51d5-934b-1e9180edf066" :question/math-academy-id "q-134159" :question/problem "Consider the following data sets:\n\n$$\nx={-1,\\,6,\\,2,\\,5},\\,y={-2,\\,5,\\,7,\\,6}\n$$\n\nYou're given that $\\overset{―}{x}=3$ and $\\overset{―}{y}=4.$ Calculate $\\text{Cov}(x,y).$" :question/worked-solution "The (population) covariance of the data sets $x={{x}_{1},{x}_{2},…,{x}_{n}}$ and $y={{y}_{1},{y}_{2},…,{y}_{n}}$ is given by \n\n$$\n\\text{Cov}(x,y)=\\frac{1}{n}{\\sum }_{i=1}^{n}({x}_{i}-\\overset{―}{x})({y}_{i}-\\overset{―}{y}),\n$$\n\nwhere $\\overset{―}{x}=\\frac{1}{n}{\\sum }_{i=1}^{n}{x}_{i}$ and $\\overset{―}{y}=\\frac{1}{n}{\\sum }_{i=1}^{n}{y}_{i}$ are the means of the data sets.\n\nTherefore, the covariance of our data sets is\n\n$$\n\\begin{aligned}\\text{Cov}(x,y) & =\\frac{1}{n}{\\sum }_{i=1}^{n}({x}_{i}-\\overset{―}{x})({y}_{i}-\\overset{―}{y}) \\\\  & =\\frac{1}{4}[(-1-3)(-2-4)+(6-3)(5-4)+(2-3)(7-4)+(5-3)(6-4)] \\\\  & =\\frac{1}{4}[(-4)(-6)+(3)(1)+(-1)(3)+(2)(2)] \\\\  & =\\frac{1}{4}[24+3-3+4] \\\\  & =\\frac{1}{4}\\cdot 28 \\\\  & =7.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186268975 :knowledge-point/_questions [{:db/id #edb/ref 17592186176030 :knowledge-point/id #uuid "88babe91-d8bf-53ba-8d72-35ad35f9253e" :knowledge-point/title "Calculating the Speed of an Object"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "048cab5e-bbd5-5811-a4d0-8ca8f85ee145" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$4$ feet per second" :db/id #edb/ref 17592186266183} {:answer/id #uuid "1cf5c97b-a06e-5922-ae8a-d7e195b65387" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$14$ feet per second" :db/id #edb/ref 17592186266390} {:answer/id #uuid "b717b37d-f4d7-5f70-ac90-3365030a3801" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$280$ feet per second" :db/id #edb/ref 17592186267783} {:answer/id #uuid "de613ffe-4f41-5a9b-bffe-1b7387734d36" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$40$ feet per second" :db/id #edb/ref 17592186268107} {:answer/id #uuid "f9712262-c406-555b-85c5-19c0f9652329" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$70$ feet per second" :db/id #edb/ref 17592186268355}] :answer-field/correct {:answer/id #uuid "048cab5e-bbd5-5811-a4d0-8ca8f85ee145" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$4$ feet per second" :db/id #edb/ref 17592186266183} :answer-field/id #uuid "aa305f49-8c63-5967-8dbe-bb8cee6aab2a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186268711}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "363ac4b8-fa48-5948-b74e-bd2bdaf627fa" :question/math-academy-id "q-134164" :question/problem "A canoe traveled $280$ feet in $70$ seconds at a constant rate.  What is the speed of the canoe?" :question/worked-solution "Speed is a special unit rate applied to moving objects. It is defined as *the distance traveled per unit of time*:\n\n$$\n\\text{speed}=\\frac{\\text{distance}}{\\text{time}}\n$$\n\nTo find the speed (in feet per second), we divide the number of feet, $280,$ by the number of seconds, $70.$ This gives,\n\n$$\n\\frac{280}{70}=280÷70=4.\n$$\n\nTherefore, the speed of the canoe is $4$ feet per second."}] [{:db/id #edb/ref 17592186268979 :knowledge-point/_questions [{:db/id #edb/ref 17592186175936 :knowledge-point/id #uuid "a2ac0065-9315-547a-a9cf-c6a5abea1aed" :knowledge-point/title "Computing Covariance"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "441b2c8e-dbaf-594e-9f26-8da9b148397f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-5" :db/id #edb/ref 17592186266751} {:answer/id #uuid "e5ea4787-26d6-5c8e-aa9d-ebc03249189b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186268180} {:answer/id #uuid "e5fd8492-13b4-5fa1-a203-4c2b1a8f2b15" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186268182} {:answer/id #uuid "fb8685e4-075d-5c33-9c2e-d13e809a6745" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-8" :db/id #edb/ref 17592186268368} {:answer/id #uuid "fccdee25-35d1-5ea4-b1da-a4668ce1fbe4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186268374}] :answer-field/correct {:answer/id #uuid "441b2c8e-dbaf-594e-9f26-8da9b148397f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-5" :db/id #edb/ref 17592186266751} :answer-field/id #uuid "923f23dc-8259-592b-ae04-9981fc36c9d3" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186268661}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "8776d2b8-cc6d-5825-8f19-b2c66c611b9a" :question/math-academy-id "q-134170" :question/problem "Calculate $\\text{Cov}(x,y)$ for the following data sets:\n\n$$\nx={4,\\,-2,\\,5,\\,1},\\,y={-7,\\,5,\\,4,\\,-2}\n$$" :question/worked-solution "The (population) covariance of the data sets $x={{x}_{1},{x}_{2},…,{x}_{n}}$ and $y={{y}_{1},{y}_{2},…,{y}_{n}}$ is given by \n\n$$\n\\text{Cov}(x,y)=\\frac{1}{n}{\\sum }_{i=1}^{n}({x}_{i}-\\overset{―}{x})({y}_{i}-\\overset{―}{y}),\n$$\n\nwhere $\\overset{―}{x}=\\frac{1}{n}{\\sum }_{i=1}^{n}{x}_{i}$ and $\\overset{―}{y}=\\frac{1}{n}{\\sum }_{i=1}^{n}{y}_{i}$ are the means of the data sets.\n\nFirst, we need to compute the means:\n\n$$\n\\begin{aligned}\\overset{―}{x} & =\\frac{1}{n}{\\sum }_{i=1}^{n}{x}_{i} \\\\  & =\\frac{1}{4}\\cdot (4+(-2)+5+1) \\\\  & =\\frac{1}{4}\\cdot 8 \\\\  & =2 \\\\ \\overset{―}{y} & =\\frac{1}{n}{\\sum }_{i=1}^{n}{y}_{i} \\\\  & =\\frac{1}{4}\\cdot ((-7)+5+4+(-2)) \\\\  & =\\frac{1}{4}\\cdot 0 \\\\  & =0\\end{aligned}\n$$\n\nTherefore, the covariance of our data sets is\n\n$$\n\\begin{aligned}\\text{Cov}(x,y) & =\\frac{1}{n}{\\sum }_{i=1}^{n}({x}_{i}-\\overset{―}{x})({y}_{i}-\\overset{―}{y}) \\\\  & =\\frac{1}{4}[(4-2)(-7-0)+(-2-2)(5-0)+(5-2)(4-0)+(1-2)(-2-0)] \\\\  & =\\frac{1}{4}[(2)(-7)+(-4)(5)+(3)(4)+(-1)(-2)] \\\\  & =\\frac{1}{4}[-14-20+12+2] \\\\  & =\\frac{1}{4}\\cdot (-20) \\\\  & =-5.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186268980 :knowledge-point/_questions [{:db/id #edb/ref 17592186176030 :knowledge-point/id #uuid "88babe91-d8bf-53ba-8d72-35ad35f9253e" :knowledge-point/title "Calculating the Speed of an Object"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "388381c6-d3f3-5ce8-9343-272755a4a1de" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$145$ feet per minute" :db/id #edb/ref 17592186266636} {:answer/id #uuid "8f5968e7-47fd-59f2-84a5-9faaa2be9ff9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$150.5$ feet per minute" :db/id #edb/ref 17592186267423} {:answer/id #uuid "9918aa8c-9fab-5e35-b660-6a295161995a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$132.5$ feet per minute" :db/id #edb/ref 17592186267525} {:answer/id #uuid "a388233f-9461-523b-bf1c-23eb098cf553" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$301$ feet per minute" :db/id #edb/ref 17592186267615} {:answer/id #uuid "b60499d9-26b2-5a0d-b9b8-bf12fdf4495e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$75$ feet per minute" :db/id #edb/ref 17592186267770}] :answer-field/correct {:answer/id #uuid "8f5968e7-47fd-59f2-84a5-9faaa2be9ff9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$150.5$ feet per minute" :db/id #edb/ref 17592186267423} :answer-field/id #uuid "ed694b78-5bc8-5345-8197-6311533e4009" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186268820}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "9150e0d7-03db-545b-ba25-add48de4f78e" :question/math-academy-id "q-134172" :question/problem "An elevator covers $602$ feet in $4$ minutes, moving at a constant rate. What is the speed of the elevator?" :question/worked-solution "Speed is a special unit rate applied to moving objects. It is defined as *the distance traveled per unit of time*:\n\n$$\n\\text{speed}=\\frac{\\text{distance}}{\\text{time}}\n$$\n\nTo find the speed in feet per minute, we divide the number of feet, $602,$ by the number of minutes, $4.$ This gives,\n\n$$\n\\begin{aligned}\\frac{602}{4} & =\\frac{602÷2}{4÷2} \\\\  & =\\frac{301}{2} \\\\  & =301÷2 \\\\  & =150.5.\\end{aligned}\n$$\n\nTherefore, the speed of the elevator is $150.5$ feet per minute."}] [{:db/id #edb/ref 17592186268990 :knowledge-point/_questions [{:db/id #edb/ref 17592186176032 :knowledge-point/id #uuid "6570253a-b05a-5721-9108-5fddab2b5388" :knowledge-point/title "Calculating Time Given Distance and Speed"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3cab5046-233a-5880-a03b-503b0856d91c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$6.5$ minutes" :db/id #edb/ref 17592186266680} {:answer/id #uuid "e325a324-10a4-5f82-b231-fa3bd706ffd1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$7.5$ minutes" :db/id #edb/ref 17592186268151} {:answer/id #uuid "e83770ff-718f-52f9-990d-ade35dfa8b0f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$6$ minutes" :db/id #edb/ref 17592186268205} {:answer/id #uuid "e91f6d7c-f724-5d0a-abea-83d4d6399631" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$5$ minutes" :db/id #edb/ref 17592186268215} {:answer/id #uuid "ef6e5bd5-073f-5a36-96f8-f3263a6b14de" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$7$ minutes" :db/id #edb/ref 17592186268273}] :answer-field/correct {:answer/id #uuid "e83770ff-718f-52f9-990d-ade35dfa8b0f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$6$ minutes" :db/id #edb/ref 17592186268205} :answer-field/id #uuid "51bb6fb1-a3cf-54cb-9a80-1e8569ed6784" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186268553}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "27bf74aa-5d79-5da2-ae74-80f3b8309260" :question/math-academy-id "q-134220" :question/problem "A jet ski traveled $3\\,960$ meters at a constant speed of $660$ meters per minute. For how long was the jet ski in motion?" :question/worked-solution "The speed is $660$ meters per minute. To find the time it took the jet ski to cover $3\\,960$ meters, we divide the distance by $660.$ This gives\n\n$$\n\\begin{aligned}\\text{time} & =\\frac{\\text{distance}}{\\text{speed}} \\\\  & =\\frac{3\\,960}{660} \\\\  & =\\frac{3\\,960÷60}{660÷60} \\\\  & =\\frac{66}{11} \\\\  & =66÷11 \\\\  & =6.\\end{aligned}\n$$\n\nTherefore, the jet ski was in motion for $6$ minutes."}] [{:db/id #edb/ref 17592186268991 :knowledge-point/_questions [{:db/id #edb/ref 17592186175937 :knowledge-point/id #uuid "cee807c1-dd86-5b0e-a595-5c5754c47e4c" :knowledge-point/title "Computing Covariance in Context"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0f92a789-d109-50a4-95bb-321fbf167553" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186266275} {:answer/id #uuid "3a4fc0c3-7987-5650-a6c4-15357f0a2e40" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186266658} {:answer/id #uuid "81b8fc0f-c491-5c9d-b014-a4dd49ed0618" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186267287} {:answer/id #uuid "8feb198f-42a2-5fd7-a65e-3cb6ba4e1c4b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3.5" :db/id #edb/ref 17592186267425} {:answer/id #uuid "9f77bdcd-8fd8-5c39-a664-6aabddb6169f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2.5" :db/id #edb/ref 17592186267585}] :answer-field/correct {:answer/id #uuid "0f92a789-d109-50a4-95bb-321fbf167553" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186266275} :answer-field/id #uuid "0a27bb6c-7a78-5c39-ae3a-526cec46f622" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186268424}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "fd4f8095-844e-57fc-88d9-718d41a408a6" :question/math-academy-id "q-134221" :question/problem "| **Age, in years ($x$)** | $7$ | $9$ | $11$ | $13$ |\n| --- | --- | --- | --- | --- |\n| **Shoe Size (USA) ($y$)** | $7$ | $8$ | $9$ | $8$ |\n\nMr. Damon recorded the age and shoe size of four tennis players at his academy. The table above shows the information he collected. Compute the covariance of the data sets given that the means are $\\overset{―}{x}=10$ and $\\overset{―}{y}=8.$" :question/worked-solution "The (population) covariance of the data sets $x={{x}_{1},{x}_{2},…,{x}_{n}}$ and $y={{y}_{1},{y}_{2},…,{y}_{n}}$ is given by \n\n$$\n\\text{Cov}(x,y)=\\frac{1}{n}{\\sum }_{i=1}^{n}({x}_{i}-\\overset{―}{x})({y}_{i}-\\overset{―}{y}),\n$$\n\nwhere $\\overset{―}{x}=\\frac{1}{n}{\\sum }_{i=1}^{n}{x}_{i}$ and $\\overset{―}{y}=\\frac{1}{n}{\\sum }_{i=1}^{n}{y}_{i}$ are the means of the data sets.\n\nTherefore, the covariance of our data sets is\n\n$$\n\\begin{aligned}\\text{Cov}(x,y) & =\\frac{1}{n}{\\sum }_{i=1}^{n}({x}_{i}-\\overset{―}{x})({y}_{i}-\\overset{―}{y}) \\\\  & =\\frac{1}{4}[(7-10)(7-8)+(9-10)(8-8)+(11-10)(9-8)+(13-10)(8-8)] \\\\  & =\\frac{1}{4}[(-3)(-1)+(-1)(0)+(1)(1)+(3)(0)] \\\\  & =\\frac{1}{4}[3+0+1+0] \\\\  & =\\frac{1}{4}\\cdot 4 \\\\  & =1.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186268994 :knowledge-point/_questions [{:db/id #edb/ref 17592186176032 :knowledge-point/id #uuid "6570253a-b05a-5721-9108-5fddab2b5388" :knowledge-point/title "Calculating Time Given Distance and Speed"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "02f258e3-8882-5aeb-8740-3e42cb6e7994" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$40$ seconds" :db/id #edb/ref 17592186266171} {:answer/id #uuid "5d95a249-fc05-50ac-9d04-c408a09025da" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$44$ seconds" :db/id #edb/ref 17592186266970} {:answer/id #uuid "60a9d8c4-203b-5e3f-8e27-11c1d3cd6d57" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$50$ seconds" :db/id #edb/ref 17592186266996} {:answer/id #uuid "640b8046-055f-5a66-8042-59ab2cf08bbd" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$52$ seconds" :db/id #edb/ref 17592186267026} {:answer/id #uuid "ab5026ed-6705-5518-8ad4-b09d2651f5d7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$38$ seconds" :db/id #edb/ref 17592186267691}] :answer-field/correct {:answer/id #uuid "5d95a249-fc05-50ac-9d04-c408a09025da" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$44$ seconds" :db/id #edb/ref 17592186266970} :answer-field/id #uuid "9d55d2b0-ddd8-553b-a7e3-cf16362be09c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186268682}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "92c13e99-67cb-5a62-9173-697230856fc4" :question/math-academy-id "q-134241" :question/problem "It takes $35$ seconds for a dolphin to swim $315$ meters at a constant pace. How long does it take for the dolphin to swim $396$ meters?" :question/worked-solution "Speed is a special unit rate applied to moving objects. It is defined as *the distance traveled per unit of time*:\n\n$$\n\\text{speed}=\\frac{\\text{distance}}{\\text{time}}\n$$\n\nTo find the speed, in meters per second, we divide the number of meters, which is $315,$ by the number of seconds, $35.$ This gives,\n\n$$\n\\begin{aligned}\\frac{315}{35} & =\\frac{315÷5}{35÷5} \\\\  & =\\frac{63}{7} \\\\  & =63÷7 \\\\  & =9.\\end{aligned}\n$$\n\nSo, the speed of the dolphin is $9$ meters per second. \n\nTo find the time it takes the dolphin to cover $396$ meters, we divide the distance by $9.$ This gives\n\n$$\n\\begin{aligned}\\text{time} & =\\frac{\\text{distance}}{\\text{speed}} \\\\  & =\\frac{396}{9} \\\\  & =396÷9 \\\\  & =44.\\end{aligned}\n$$\n\nTherefore, it takes the dolphin $44$ seconds to travel $396$ meters."}] [{:db/id #edb/ref 17592186268995 :knowledge-point/_questions [{:db/id #edb/ref 17592186176031 :knowledge-point/id #uuid "534de76f-d4bc-55b5-858e-2b594f63b7bc" :knowledge-point/title "Calculating Distance Given Speed and Time"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "40131a28-43ac-50cf-8d52-39f12b620ee7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$90$ centimeters" :db/id #edb/ref 17592186266722} {:answer/id #uuid "886f2ab6-77f8-5a47-b00c-148f635dc0f8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$81$ centimeters" :db/id #edb/ref 17592186267351} {:answer/id #uuid "a3488564-1ffd-543a-9e83-a3e4de6a4a55" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$72$ centimeters" :db/id #edb/ref 17592186267612} {:answer/id #uuid "a5f5d571-924e-5ad6-9047-abd7a0db08a4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$64$ centimeters" :db/id #edb/ref 17592186267647} {:answer/id #uuid "eeb2d178-478e-56b8-97e6-0ffe587c1d6b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$15$ centimeters" :db/id #edb/ref 17592186268268}] :answer-field/correct {:answer/id #uuid "886f2ab6-77f8-5a47-b00c-148f635dc0f8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$81$ centimeters" :db/id #edb/ref 17592186267351} :answer-field/id #uuid "6f1172ab-eeb3-5cad-a411-b983f6dd952a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186268610}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "12110187-5a54-55e6-a927-228b7377faf9" :question/math-academy-id "q-134243" :question/problem "It takes $30$ minutes for a slug to crawl $135$ centimeters when moving at a constant pace. Find the distance this slug covers in $18$ minutes." :question/worked-solution "Speed is a special unit rate applied to moving objects. It is defined as *the distance traveled per unit of time*:\n\n$$\n\\text{speed}=\\frac{\\text{distance}}{\\text{time}}\n$$\n\nTo find the speed in centimeters per minute, we divide the number of centimeters, $135,$ by the number of minutes, $30.$ This gives,\n\n$$\n\\begin{aligned}\\frac{135}{30} & =135÷30 \\\\  & =\\frac{135÷15}{30÷15} \\\\  & =\\frac{9}{2} \\\\  & =9÷2 \\\\  & =4.5.\\end{aligned}\n$$\n\nSo, the speed of the slug is $4.5$ centimeters per minute. \n\nTo find the distance covered in $18$ minutes, we multiply the speed by $18.$ This gives\n\n$$\n\\begin{aligned}\\text{distance} & =\\text{speed}\\times \\text{time} \\\\  & =4.5\\times 18 \\\\  & =81.\\end{aligned}\n$$\n\nTherefore, the slug covers $81$ centimeters in $18$ minutes."}] [{:db/id #edb/ref 17592186395748 :knowledge-point/_questions [{:db/id #edb/ref 17592186100988 :knowledge-point/id #uuid "8d783281-8364-5597-a804-a4ea0d76bec8" :knowledge-point/title "Finding an Entry of a Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c13c60e5-0749-5b32-b12e-a8ade2bfafa4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "No such entry" :db/id #edb/ref 17592186395750} {:answer/id #uuid "934f3147-a632-5a7a-90a4-6abb01c749b5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186395751} {:answer/id #uuid "75f10e54-f429-5034-a07c-5f3a477a96f5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186395752} {:answer/id #uuid "fc409e78-b2db-5c05-a2e5-b9108d710f88" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186395753} {:answer/id #uuid "42e84e66-ce19-5239-8a81-e70ab0d7a064" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186395754}] :answer-field/correct {:answer/id #uuid "42e84e66-ce19-5239-8a81-e70ab0d7a064" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186395754} :answer-field/id #uuid "009a80b9-eba7-5f26-9519-cf720d746fee" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186395749}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "d09f8217-b119-5565-bb4f-2ae4305acd87" :question/math-academy-id "q-13497" :question/problem "Find the entry ${c}_{24}$ of the matrix $C$, where \n\n$$\nC=[\\begin{aligned}0 & 1 & 2 & 4 \\\\ -1 & 2 & -3 & 5 \\\\ 2 & 1 & -3 & 4\\end{aligned}].\n$$" :question/worked-solution "The entry ${c}_{24}$ should lie at the intersection of the $2$nd row and $4$th column. Therefore, ${c}_{24}=5.$\n\n$$\nC=[\\begin{aligned}0 & 1 & 2 & 4 \\\\ -1 & 2 & -3 & 5 \\\\ 2 & 1 & -3 & 4\\end{aligned}]\n$$"}] [{:db/id #edb/ref 17592186400702 :knowledge-point/_questions [{:db/id #edb/ref 17592186100990 :knowledge-point/id #uuid "1cc70bda-40cf-5860-9a47-25f290c71041" :knowledge-point/title "Describing an Entry of a Matrix in Index Notation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "53bc7c4a-ec03-5241-b616-ab551e2b27cc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{a}_{21}" :db/id #edb/ref 17592186400704} {:answer/id #uuid "3b70af93-f0df-596a-b13f-d4cefebb16dd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{a}_{13}" :db/id #edb/ref 17592186400705} {:answer/id #uuid "710c1a23-9554-5a6a-91ac-2f16e51847e1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{a}_{43}" :db/id #edb/ref 17592186400706} {:a