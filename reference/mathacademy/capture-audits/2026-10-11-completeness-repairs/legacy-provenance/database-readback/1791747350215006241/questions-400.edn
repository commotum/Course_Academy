7592186388507} {:answer/id #uuid "1524532d-303c-57e8-baaa-e00f625a908a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}0 & 0 \\\\ 0 & 0\\end{aligned}]" :db/id #edb/ref 17592186388508} {:answer/id #uuid "f505e5ac-8344-5745-ab05-6ca6bf802e47" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The product is undefined" :db/id #edb/ref 17592186388509} {:answer/id #uuid "5e6230bd-503c-59b4-8461-692f556f4ea7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}2 & 0 \\\\ 0 & 2\\end{aligned}]" :db/id #edb/ref 17592186388510}] :answer-field/correct {:answer/id #uuid "e5497e19-b13b-5352-a486-89ae75f2fe36" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}2 & 3 \\\\ 1 & 2\\end{aligned}]" :db/id #edb/ref 17592186388507} :answer-field/id #uuid "4bf67a40-3ab5-50a6-9561-e2ee6d875a8b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186388505}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "612ed9a2-f644-5c99-b797-cab8e5ee69a6" :question/math-academy-id "q-13762" :question/problem "Calculate the product ${I}_{2}B$ given that ${I}_{2}$ is the $2\\times 2$ identity matrix and\n$B=[\\begin{aligned}2 & 3 \\\\ 1 & 2\\end{aligned}].$" :question/worked-solution "Any matrix, when multiplied by an identity matrix, remains unchanged (assuming that the multiplication is well defined).\n\nThe matrix ${I}_{2}$ is a $2\\times 2$ matrix and $B$ is a $2\\times 2$ matrix too. \n\nTherefore, the multiplication is well defined and \n\n$$\n{I}_{2}\\cdot B=B=[\\begin{aligned}2 & 3 \\\\ 1 & 2\\end{aligned}].\n$$"}] [{:db/id #edb/ref 17592186269219 :knowledge-point/_questions [{:db/id #edb/ref 17592186100878 :knowledge-point/id #uuid "288e49b0-f706-54de-86b7-a17248fe2408" :knowledge-point/title "Calculating the Area of the Parallelogram Spanned by Two Non-Parallel Vectors"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "186ee2ac-da11-5516-b903-e3b5e9480103" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186266346} {:answer/id #uuid "303f5039-136f-57c4-95b6-e45427ec1075" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "10" :db/id #edb/ref 17592186266570} {:answer/id #uuid "3d1f355e-f850-51c9-9c2a-fb7bc5bbb357" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "12" :db/id #edb/ref 17592186266684} {:answer/id #uuid "92a8e1d3-8eda-5c2f-9bb2-70ec28082ba2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "11" :db/id #edb/ref 17592186267452} {:answer/id #uuid "a686bd68-cab0-5c69-85ea-bad821967fe1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186267650}] :answer-field/correct {:answer/id #uuid "303f5039-136f-57c4-95b6-e45427ec1075" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "10" :db/id #edb/ref 17592186266570} :answer-field/id #uuid "ad50c151-5c0e-566c-ac0d-79838b4014d4" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186268718}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "cad6730b-4b4a-5d91-acf2-b03ce7ce4d8e" :question/math-academy-id "q-13944" :question/problem "![](images/7a/7a70285258e584708a7296a2a008536dec9c97750b48e5fe0eb2f8cb7761bed1.png)\n\nCalculate the area of the parallelogram in the figure." :question/worked-solution "From the diagram, we get the vectors\n\n$$\n\\text{u}=⟨3,2⟩,\\,\\text{v}=⟨2,-2⟩.\n$$\n\nFirst, we construct a matrix where the columns are made up of the components of the corresponding vectors:\n\n$$\nM=[\\begin{aligned}3 & 2 \\\\ 2 & -2\\end{aligned}]\n$$\n\nThen, we find the determinant:\n\n$$\n\\begin{aligned}det(M) & =|\\begin{aligned}3 & 2 \\\\ 2 & -2\\end{aligned}| \\\\  & =3\\cdot (-2)-2\\cdot 2 \\\\  & =-10\\end{aligned}\n$$\n\nThe absolute value of $det(M)$ gives the area $A$ of the parallelogram:\n\n$$\nA=|-10\\,|=10\n$$"}] [{:db/id #edb/ref 17592186269232 :knowledge-point/_questions [{:db/id #edb/ref 17592186100878 :knowledge-point/id #uuid "288e49b0-f706-54de-86b7-a17248fe2408" :knowledge-point/title "Calculating the Area of the Parallelogram Spanned by Two Non-Parallel Vectors"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2d768a08-43a7-50f3-bc2c-9d0aec2d145d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "38" :db/id #edb/ref 17592186266547} {:answer/id #uuid "49c440bd-ae95-5742-ba82-03be224e0b41" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "23" :db/id #edb/ref 17592186266798} {:answer/id #uuid "650a0407-08e2-55ea-afa8-98afe8bbc506" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "12" :db/id #edb/ref 17592186267039} {:answer/id #uuid "7b1ac682-0ef5-54bf-9790-851d28380cff" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186267230} {:answer/id #uuid "dba30746-1bcd-5e32-976d-2a26e890257c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "52" :db/id #edb/ref 17592186268088}] :answer-field/correct {:answer/id #uuid "49c440bd-ae95-5742-ba82-03be224e0b41" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "23" :db/id #edb/ref 17592186266798} :answer-field/id #uuid "d0ea674a-8479-5833-a353-9cc54ecf9166" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186268781}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "19e02ca3-a6f7-5909-838c-8df1ebb7ea40" :question/math-academy-id "q-13951" :question/problem "Calculate the area of the parallelogram spanned by $\\text{u}=[\\begin{aligned}1 \\\\ -4\\end{aligned}]$ and $\\text{v}=[\\begin{aligned}5 \\\\ 3\\end{aligned}].$" :question/worked-solution "First, we construct a matrix where the columns are made up of the components of the corresponding vectors:\n\n$$\nM=[\\begin{aligned}1 & 5 \\\\ -4 & 3\\end{aligned}]\n$$\n\nThen, we find the determinant:\n\n$$\n\\begin{aligned}det(M) & =|\\begin{aligned}1 & 5 \\\\ -4 & 3\\end{aligned}| \\\\  & =1\\cdot 3-5\\cdot (-4) \\\\  & =23\\end{aligned}\n$$\n\nThe absolute value of $det(M)$ gives the area $A$ of the parallelogram:\n\n$$\nA=|\\,23\\,|=23\n$$"}] [{:db/id #edb/ref 17592186271964 :knowledge-point/_questions [{:db/id #edb/ref 17592186087819 :knowledge-point/id #uuid "10ca3efc-7d23-5bc1-ab41-f785bed69986" :knowledge-point/title "Matrices for Route Planning"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "257b433d-960b-5602-9139-f0a08f725b10" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186269602} {:answer/id #uuid "2912ecc2-b82b-545b-a134-0f849b9f6f10" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186269638} {:answer/id #uuid "a28f67e7-b07f-5e99-99f1-6ef0ca27df71" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186270719} {:answer/id #uuid "ab496260-2eb5-5f24-b36a-b5c83e218fef" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186270799} {:answer/id #uuid "cee52816-3d9a-5a2d-bf35-0841387ab28c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186271084}] :answer-field/correct {:answer/id #uuid "2912ecc2-b82b-545b-a134-0f849b9f6f10" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186269638} :answer-field/id #uuid "2a50b6d4-0ed8-59a9-bfe9-13d431937f58" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186271588}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "cf86f867-a1a5-56dc-89e8-e2255e71399b" :question/math-academy-id "q-139689" :question/problem "![](images/6c/6c52f315d079b82fb729c4ab47f210ec4bf2683d0dfe1adfe79c94db9fbc5f63.png)\n\nThe diagram above shows train routes between three stations, where nodes represent the stations and arrows represent the directed routes between them. The (incomplete) route matrix below represents information about the number of routes between each of the three stations. Find the value of $a+b+c.$\n\n|  |  | To: |  |  |\n| --- | --- | --- | --- | --- |\n|  |  | **A** | **B** | **C** |\n| From: | **A** | $1$ | $a$ | $0$ |\n| **B** | $0$ | $b$ | $2$ |  |\n| **C** | $c$ | $1$ | $0$ |  |" :question/worked-solution "Let's examine our diagram.\n\n- There is $1$ arrow starting at Station A and ending at Station B. So, there is only one route from $A$ to $B,$ and so $a=1.$\n\n- There is $1$ arrow starting at Station B and ending at Station B. So, there is only one route from $B$ to $B,$ and so $b=1.$\n\n- There are no arrows starting at Station C and ending at Station A. So, there are no routes from $C$ to $A,$ and so $c=0.$\n\nAs a result, our route matrix is the following:\n\n|  |  | To: |  |  |\n| --- | --- | --- | --- | --- |\n|  |  | **A** | **B** | **C** |\n| From: | **A** | $1$ | $1$ | $0$ |\n| **B** | $0$ | $1$ | $2$ |  |\n| **C** | $0$ | $1$ | $0$ |  |\n\nTherefore, \n\n$$\na+b+c=1+1+0=2.\n$$"}] [{:db/id #edb/ref 17592186060044 :knowledge-point/_questions [{:db/id #edb/ref 17592186059851 :knowledge-point/id #uuid "09aeb7f5-31e0-5b2d-9e2a-8eace54a6665" :knowledge-point/title "Calculating the Cross Product of Two Vectors Whose Angle Is a Non-Special Angle"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "60742969-581c-5973-8fa9-78e77a0bf094" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "36n" :db/id #edb/ref 17592186270120} {:answer/id #uuid "622b545e-1af8-5ad8-944d-8f87481ebdc4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "27n" :db/id #edb/ref 17592186270133} {:answer/id #uuid "7cbbc011-0ab5-5321-8b62-8396249479da" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "29n" :db/id #edb/ref 17592186270362} {:answer/id #uuid "84e582c4-e0ad-504a-9f91-14756ec4390b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "43n" :db/id #edb/ref 17592186270417} {:answer/id #uuid "b177a505-8449-5d54-8746-4506cea92190" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "34n" :db/id #edb/ref 17592186270854}] :answer-field/correct {:answer/id #uuid "7cbbc011-0ab5-5321-8b62-8396249479da" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "29n" :db/id #edb/ref 17592186270362} :answer-field/id #uuid "ba0ffccc-6715-58cf-bae1-c7df2b05cefa" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186271847}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "6fb7d87a-bb90-5349-a9b4-58de72e66222" :question/math-academy-id "q-1400" :question/problem "The vector $a$ has magnitude $9,$ the vector $b$ has magnitude $5,$ the angle between $a$ and $b$ is ${140}^{∘}$ and $n$ is the unit vector that points in the direction of $a\\times b.$ Find $a\\times b$ in terms of $n.$ Round your final answer to the nearest integer where appropriate." :question/requires-calculator true :question/worked-solution "We use the formula for the cross product and obtain\n\n$$\n\\begin{aligned}a\\times b & =|a|\\cdot |b|\\cdot \\operatorname{sin}⁡\\theta \\cdot n \\\\  & =9\\cdot 5\\cdot \\operatorname{sin}⁡{140}^{∘}\\cdot n \\\\  & =45\\cdot (0.642…)\\cdot n \\\\  & =(28.925…)\\cdot n \\\\  & ≈29n.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186272044 :knowledge-point/_questions [{:db/id #edb/ref 17592186068874 :knowledge-point/id #uuid "bf9b812d-0dbf-5a67-9d45-3cc5e373b2b1" :knowledge-point/title "Completing the Square When the Perfect Square is Isolated: Negative Linear Term"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1de2e53b-3e5a-515c-aeb7-08b2b37df9ba" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(x-5{)}^{2}+1" :db/id #edb/ref 17592186269517} {:answer/id #uuid "2044f8ba-a526-5264-9c8b-279475bc6079" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(x+5{)}^{2}+1" :db/id #edb/ref 17592186269538} {:answer/id #uuid "4ef60e4f-a72a-5357-acf3-4233e5a280e9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(x-25{)}^{2}+1" :db/id #edb/ref 17592186269981} {:answer/id #uuid "d1396c9b-3b30-5a34-9af3-bb9767985973" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(x-10{)}^{2}+1" :db/id #edb/ref 17592186271110} {:answer/id #uuid "e97a70aa-76d8-5b9c-aa63-ecd9752ccf4f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(x+10{)}^{2}+1" :db/id #edb/ref 17592186271312}] :answer-field/correct {:answer/id #uuid "1de2e53b-3e5a-515c-aeb7-08b2b37df9ba" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(x-5{)}^{2}+1" :db/id #edb/ref 17592186269517} :answer-field/id #uuid "501bcbfe-9b64-5b29-8ec4-43efe59a3a60" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186271656}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "0a5ade6b-92c1-5055-8b0b-c80cbaff9d2f" :question/math-academy-id "q-140281" :question/problem "Rewrite the expression $({x}^{2}-10x+25)+1$ as the sum of a perfect square and a constant." :question/worked-solution "First, we recall the following formula:\n\n$$\n{x}^{2}-2ax+{a}^{2}=(x-a{)}^{2}\n$$\n\nNotice that we have a perfect square in the parentheses that we can factor as follows:\n\n$$\n\\begin{aligned}{x}^{2}-10x+25 & = \\\\ {x}^{2}-10x+{5}^{2} & = \\\\ {x}^{2}-2\\cdot 5x+{5}^{2} & = \\\\ (x-5{)}^{2} & \\end{aligned}\n$$\n\nTherefore, we obtain\n\n$$\n\\begin{aligned}({x}^{2}-10x+25)+1 & = \\\\ (x-5{)}^{2}+1 & .\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186272045 :knowledge-point/_questions [{:db/id #edb/ref 17592186068874 :knowledge-point/id #uuid "bf9b812d-0dbf-5a67-9d45-3cc5e373b2b1" :knowledge-point/title "Completing the Square When the Perfect Square is Isolated: Negative Linear Term"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "098366e9-6bbf-557f-8b0b-c28f1f5c5d06" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(x+12{)}^{2}-4" :db/id #edb/ref 17592186269356} {:answer/id #uuid "229c01ab-0ea9-5605-90a1-1d5a7751e77a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(x-11{)}^{2}-4" :db/id #edb/ref 17592186269568} {:answer/id #uuid "9d389434-bcbe-5f2b-ab97-000df772d7d9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(x-12{)}^{2}-4" :db/id #edb/ref 17592186270659} {:answer/id #uuid "aa8a2c46-7cb2-59b0-9203-35410fcdd6dd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(x-22{)}^{2}-4" :db/id #edb/ref 17592186270793} {:answer/id #uuid "b0f56343-9654-51c6-8939-85100071b4dd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(x+11{)}^{2}-4" :db/id #edb/ref 17592186270849}] :answer-field/correct {:answer/id #uuid "229c01ab-0ea9-5605-90a1-1d5a7751e77a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(x-11{)}^{2}-4" :db/id #edb/ref 17592186269568} :answer-field/id #uuid "90eb344c-2847-58a2-8769-e020f945532e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186271768}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "ff51e775-e2b4-585e-a683-f90782853abe" :question/math-academy-id "q-140283" :question/problem "Rewrite the expression $({x}^{2}-22x+121)-4$ as the difference between a perfect square and a constant." :question/worked-solution "First, we recall the following formula:\n\n$$\n{x}^{2}-2ax+{a}^{2}=(x-a{)}^{2}\n$$\n\nNotice that we have a perfect square in the parentheses that we can factor as follows:\n\n$$\n\\begin{aligned}{x}^{2}-22x+121 & = \\\\ {x}^{2}-22x+{11}^{2} & = \\\\ {x}^{2}-2\\cdot 11x+{11}^{2} & = \\\\ (x-11{)}^{2} & \\end{aligned}\n$$\n\nTherefore, we obtain\n\n$$\n\\begin{aligned}({x}^{2}-22x+121)-4 & = \\\\ (x-11{)}^{2}-4 & .\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186272058 :knowledge-point/_questions [{:db/id #edb/ref 17592186184322 :knowledge-point/id #uuid "2a85fece-e40f-543c-b3c3-ae43a5175808" :knowledge-point/title "Completing the Square When the Leading Coefficient is Negative One: Odd Linear Terms"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "071c98e7-f045-5699-97e6-8ca98ff4c425" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{89}{4}-{(x+14)}^{2}" :db/id #edb/ref 17592186269336} {:answer/id #uuid "0b6551d7-ff9d-5fcb-9ba8-47eb76d9737a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{9}{4}-{(x+\\frac{7}{2})}^{2}" :db/id #edb/ref 17592186269367} {:answer/id #uuid "92214c5a-0fb3-5f9c-b2fd-8c3a954013bf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "59-{(x+14)}^{2}" :db/id #edb/ref 17592186270546} {:answer/id #uuid "b1f6b651-8575-5bc8-a027-fe8e7ce11c40" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{7}{2}-{(x+\\frac{7}{2})}^{2}" :db/id #edb/ref 17592186270861} {:answer/id #uuid "d730e81c-c1fd-5d3a-9ed2-255c3dad533b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{49}{4}-{(x+\\frac{7}{2})}^{2}" :db/id #edb/ref 17592186271160}] :answer-field/correct {:answer/id #uuid "0b6551d7-ff9d-5fcb-9ba8-47eb76d9737a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{9}{4}-{(x+\\frac{7}{2})}^{2}" :db/id #edb/ref 17592186269367} :answer-field/id #uuid "9e101ba8-4e79-5217-9a66-13f1e2c2b19e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186271788}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "5f049fbc-7296-56e3-bb5f-3d51d2204d7a" :question/math-academy-id "q-140330" :question/problem "Rewrite $-({x}^{2}+7x+10)$ by completing the square." :question/worked-solution "We begin by completing the square for the expression inside the parentheses:\n\n$$\n{x}^{2}+7x+10\n$$\n\nFirst, we rewrite the coefficient of the linear term as a product with $2$ as a factor:\n\n$$\n{x}^{2}+2\\cdot \\frac{7}{2}x+10\n$$\n\nThen, we *add* and *then subtract* ${(\\frac{7}{2})}^{2},$ writing the constant term $10$ last:\n\n$$\n{{x}^{2}+2\\cdot \\frac{7}{2}x+{(\\frac{7}{2})}^{2}}_{⏟}-{(\\frac{7}{2})}^{2}+10\n$$\n\nThe first three terms form a perfect square, which we factor as follows:\n\n$$\n{(x+\\frac{7}{2})}^{2}-{(\\frac{7}{2})}^{2}+10\n$$\n\nEvaluating the last two terms, we get\n\n$$\n{(x+\\frac{7}{2})}^{2}-\\frac{9}{4}.\n$$\n\nFinally, we substitute this result back into our original expression:\n\n$$\n\\begin{aligned}-({x}^{2}+7x+10) & =-({(x+\\frac{7}{2})}^{2}-\\frac{9}{4}) \\\\  & =-{(x+\\frac{7}{2})}^{2}+\\frac{9}{4} \\\\  & =\\frac{9}{4}-{(x+\\frac{7}{2})}^{2}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186272060 :knowledge-point/_questions [{:db/id #edb/ref 17592186184322 :knowledge-point/id #uuid "2a85fece-e40f-543c-b3c3-ae43a5175808" :knowledge-point/title "Completing the Square When the Leading Coefficient is Negative One: Odd Linear Terms"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2e0b9d03-98ee-5f65-8899-eb0ca3293f69" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{4}-{(y+\\frac{9}{2})}^{2}" :db/id #edb/ref 17592186269682} {:answer/id #uuid "51675449-e3ed-5d32-a5a1-dc181d745b38" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{161}{4}-{(y-\\frac{9}{2})}^{2}" :db/id #edb/ref 17592186269997} {:answer/id #uuid "64001e55-d244-54a8-918a-a1c0059b44a6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{4}-{(y+\\frac{9}{2})}^{2}" :db/id #edb/ref 17592186270154} {:answer/id #uuid "88d86ace-1240-59e6-93cf-c53adca2f146" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "61-{(y+18)}^{2}" :db/id #edb/ref 17592186270450} {:answer/id #uuid "e002a466-5bda-58b6-b497-ea8df55b4790" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{9}{4}-{(y+\\frac{9}{2})}^{2}" :db/id #edb/ref 17592186271234}] :answer-field/correct {:answer/id #uuid "2e0b9d03-98ee-5f65-8899-eb0ca3293f69" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{4}-{(y+\\frac{9}{2})}^{2}" :db/id #edb/ref 17592186269682} :answer-field/id #uuid "19597342-b978-5e00-8333-b2a8755a3138" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186271554}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "6187e130-749f-5a82-add1-d28e2491c294" :question/math-academy-id "q-140333" :question/problem "Rewrite $-({y}^{2}+9y+20)$ by completing the square." :question/worked-solution "We begin by completing the square for the expression inside the parentheses:\n\n$$\n{y}^{2}+9y+20\n$$\n\nFirst, we rewrite the coefficient of the linear term as a product with $2$ as a factor:\n\n$$\n{y}^{2}+2\\cdot \\frac{9}{2}y+20\n$$\n\nThen, we *add* and *then subtract* ${(\\frac{9}{2})}^{2},$ writing the constant term $20$ last:\n\n$$\n{{y}^{2}+2\\cdot \\frac{9}{2}y+{(\\frac{9}{2})}^{2}}_{⏟}-{(\\frac{9}{2})}^{2}+20\n$$\n\nThe first three terms form a perfect square, which we factor as follows:\n\n$$\n{(y+\\frac{9}{2})}^{2}-{(\\frac{9}{2})}^{2}+20\n$$\n\nEvaluating the last two terms, we get\n\n$$\n{(y+\\frac{9}{2})}^{2}-\\frac{1}{4}.\n$$\n\nFinally, we substitute this result back into our original expression:\n\n$$\n\\begin{aligned}-({y}^{2}+9y+20) & =-({(y+\\frac{9}{2})}^{2}-\\frac{1}{4}) \\\\  & =-{(y+\\frac{9}{2})}^{2}+\\frac{1}{4} \\\\  & =\\frac{1}{4}-{(y+\\frac{9}{2})}^{2}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186184484 :knowledge-point/_questions [{:db/id #edb/ref 17592186184212 :knowledge-point/id #uuid "3202d7cc-541b-553b-8ec1-d4ea85dd0590" :knowledge-point/title "Completing the Square on an Expression With a Negative Leading Coefficient"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2441e55c-3656-5b9c-9444-a562a3ff3b87" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-9{(z-\\frac{1}{3})}^{2}+10" :db/id #edb/ref 17592186269586} {:answer/id #uuid "4f3faa2d-7189-540c-8002-572e91da81bc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-9{(z+\\frac{1}{3})}^{2}+5" :db/id #edb/ref 17592186269984} {:answer/id #uuid "82317f98-eb55-5a2a-84b7-c0fc441aa39a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-9{(z-\\frac{1}{3})}^{2}-8" :db/id #edb/ref 17592186270394} {:answer/id #uuid "ca440db9-063c-5ec8-89e2-7e47d8b1e800" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-9{(z+\\frac{1}{3})}^{2}+10" :db/id #edb/ref 17592186271044} {:answer/id #uuid "f37d3db7-779c-579c-a14f-a3675bd5b658" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-9{(z+\\frac{1}{3})}^{2}+8" :db/id #edb/ref 17592186271404}] :answer-field/correct {:answer/id #uuid "ca440db9-063c-5ec8-89e2-7e47d8b1e800" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-9{(z+\\frac{1}{3})}^{2}+10" :db/id #edb/ref 17592186271044} :answer-field/id #uuid "02be3ebb-ff12-5196-b096-96eac16ef254" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186271509}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "2495fc0b-8e76-56e1-bf72-c223c52c4fc2" :question/math-academy-id "q-140378" :question/problem "Rewrite $-9{z}^{2}-6z+9$ by completing the square." :question/worked-solution "Notice that the leading coefficient is $-9.$ So, we take out a factor of $-9$ from the entire expression:\n\n$$\n-9({z}^{2}+\\frac{2}{3}z-1)\n$$\n\nLet's now complete the square for the expression inside the parentheses:\n\n$$\n{z}^{2}+\\frac{2}{3}z-1\n$$\n\nFirst, we rewrite the coefficient of the linear term as a product with $2$ as a factor:\n\n$$\n{z}^{2}+2\\cdot \\frac{1}{3}\\cdot z-1\n$$\n\nThen, we *add* and *then subtract* ${(\\frac{1}{3})}^{2},$ writing the constant term $1$ last:\n\n$$\n{{z}^{2}+2\\cdot \\frac{1}{3}\\cdot z+{(\\frac{1}{3})}^{2}}_{⏟}-{(\\frac{1}{3})}^{2}-1\n$$\n\nThe first three terms form a perfect square, which we factor as follows:\n\n$$\n{(z+\\frac{1}{3})}^{2}-{(\\frac{1}{3})}^{2}-1\n$$\n\nEvaluating the last two terms, we get\n\n$$\n{(z+\\frac{1}{3})}^{2}-\\frac{10}{9}.\n$$\n\nFinally, we substitute this result back into our original expression::\n\n$$\n\\begin{aligned}-9({z}^{2}+\\frac{2}{3}z-1) & =-9({(z+\\frac{1}{3})}^{2}-\\frac{10}{9}) \\\\  & =-9{(z+\\frac{1}{3})}^{2}+(-9)\\cdot (-\\frac{10}{9}) \\\\  & =-9{(z+\\frac{1}{3})}^{2}+10\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186272081 :knowledge-point/_questions [{:db/id #edb/ref 17592186184322 :knowledge-point/id #uuid "2a85fece-e40f-543c-b3c3-ae43a5175808" :knowledge-point/title "Completing the Square When the Leading Coefficient is Negative One: Odd Linear Terms"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4d854445-4b9d-5457-8fdd-3e9aafaf84c7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{45}{4}-{(y-10)}^{2}" :db/id #edb/ref 17592186269970} {:answer/id #uuid "6c18b098-7360-5163-a283-eff16352c701" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{25}{4}-{(y-\\frac{5}{2})}^{2}" :db/id #edb/ref 17592186270231} {:answer/id #uuid "89f2f572-b7c1-5dea-a169-978a09aab668" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{5}{2}+{(y-\\frac{5}{2})}^{2}" :db/id #edb/ref 17592186270461} {:answer/id #uuid "aa2bcef6-9c81-5bea-950e-d8b1ddb76848" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "20-{(y-10)}^{2}" :db/id #edb/ref 17592186270787} {:answer/id #uuid "ed555ea6-dfea-51d4-876e-75d752688105" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5}{4}-{(y-\\frac{5}{2})}^{2}" :db/id #edb/ref 17592186271354}] :answer-field/correct {:answer/id #uuid "ed555ea6-dfea-51d4-876e-75d752688105" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5}{4}-{(y-\\frac{5}{2})}^{2}" :db/id #edb/ref 17592186271354} :answer-field/id #uuid "880bee47-a8c3-50a6-937c-697f411c6825" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186271749}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "afc8b4da-a3f1-5590-a7d5-e7a094b395bd" :question/math-academy-id "q-140410" :question/problem "Rewrite $-{y}^{2}+5y-5$ by completing the square." :question/worked-solution "Notice that the leading coefficient is $-1.$ So, we take out a factor of $-1$ from the entire expression:\n\n$$\n-({y}^{2}-5y+5)\n$$\n\nLet's now complete the square for the expression inside the parentheses:\n\n$$\n{y}^{2}-5y+5\n$$\n\nFirst, we rewrite the coefficient of the linear term as a product with $2$ as a factor:\n\n$$\n{y}^{2}-2\\cdot \\frac{5}{2}y+5\n$$\n\nThen, we *add* and *then subtract* ${(\\frac{5}{2})}^{2},$ writing the constant term $5$ last:\n\n$$\n{{y}^{2}-2\\cdot \\frac{5}{2}y+{(\\frac{5}{2})}^{2}}_{⏟}-{(\\frac{5}{2})}^{2}+5\n$$\n\nThe first three terms form a perfect square, which we factor as follows:\n\n$$\n{(y-\\frac{5}{2})}^{2}-{(\\frac{5}{2})}^{2}+5\n$$\n\nEvaluating the last two terms, we get\n\n$$\n{(y-\\frac{5}{2})}^{2}-\\frac{5}{4}.\n$$\n\nFinally, we substitute this result back into our original expression:\n\n$$\n\\begin{aligned}-{y}^{2}+5y-5 & =-({(y-\\frac{5}{2})}^{2}-\\frac{5}{4}) \\\\  & =\\frac{5}{4}-{(y-\\frac{5}{2})}^{2}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186272085 :knowledge-point/_questions [{:db/id #edb/ref 17592186096611 :knowledge-point/id #uuid "8b7d0153-6e0a-5e19-83f1-960811dc5205" :knowledge-point/title "Differentiating the Product of a Constant and the Exponential Function, Plus a Polynomial"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0884ad38-9d14-5f8e-b665-d8b35b5af237" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "e+4" :db/id #edb/ref 17592186269346} {:answer/id #uuid "0db0ac08-c4ce-5d3f-845f-d38358413506" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "e+8" :db/id #edb/ref 17592186269388} {:answer/id #uuid "2934301c-7684-5c1f-b910-d7819431eba3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2e" :db/id #edb/ref 17592186269640} {:answer/id #uuid "7789397b-7630-5bd8-9c80-42e72f128cee" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2e+8" :db/id #edb/ref 17592186270328} {:answer/id #uuid "81639cc6-e903-5cd2-bc14-50bfc72b4d70" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2e+4" :db/id #edb/ref 17592186270388}] :answer-field/correct {:answer/id #uuid "7789397b-7630-5bd8-9c80-42e72f128cee" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2e+8" :db/id #edb/ref 17592186270328} :answer-field/id #uuid "c7c2979c-8072-5209-9ca0-20ccbaf77003" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186271876}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "d2ffa4af-5dbe-569b-8d78-f233584a8913" :question/math-academy-id "q-140431" :question/problem "Given that $f(x)=2{e}^{x}+4{x}^{2}-3$, find the slope of the tangent at $x=1.$" :question/worked-solution "First, using the addition and the power rules, we get\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}(2{e}^{x}+4{x}^{2}-3) \\\\  & =\\frac{\\text{d}}{\\text{d}x}(2{e}^{x})+\\frac{\\text{d}}{\\text{d}x}(4{x}^{2})+\\frac{\\text{d}}{\\text{d}x}(-3) \\\\  & =2\\frac{\\text{d}}{\\text{d}x}({e}^{x})+4\\frac{\\text{d}}{\\text{d}x}({x}^{2})+0 \\\\  & =2{e}^{x}+8x.\\end{aligned}\n$$\n\nTherefore, the slope of the tangent at $x=1$ is\n\n$$\n\\begin{aligned}{\\frac{\\text{d}f}{\\text{d}x}|}_{x=1} & ={(2{e}^{x}+8x)\\,|}_{x=1} \\\\  & =2\\cdot {e}^{1}+8\\cdot 1 \\\\  & =2e+8.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186373785 :knowledge-point/_questions [{:db/id #edb/ref 17592186100951 :knowledge-point/id #uuid "82a9b23c-4c79-56cd-9761-79d0ee22646d" :knowledge-point/title "Identifying Solutions to Initial Value Problems"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "60b15d99-5f73-5d71-a0a0-49f9be9df65d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{2}{3}" :db/id #edb/ref 17592186373787} {:answer/id #uuid "3cefcde2-3aa5-51a2-8f0c-24c6172e631c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186373788} {:answer/id #uuid "243ba24f-c088-5741-b1dc-797cc0c88bb6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186373789} {:answer/id #uuid "3ab4b002-dd36-598f-8102-522b7e368735" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{2}" :db/id #edb/ref 17592186373790} {:answer/id #uuid "4a73df82-8e85-5bb1-90fc-89e5be58e836" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186373791}] :answer-field/correct {:answer/id #uuid "3cefcde2-3aa5-51a2-8f0c-24c6172e631c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186373788} :answer-field/id #uuid "e02b7c91-76ce-53ed-b342-163951d05f8f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186373786}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "8abc10be-3eb5-5e2c-9a94-244a431b287a" :question/math-academy-id "q-141112" :question/problem "Consider the following initial value problem\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}=-\\frac{y}{x},\\,y(-2)=-1.\n$$\n\nYou're given that $y=\\frac{A}{x}$ is the solution to this initial value problem. What is the value of the constant $A?$" :question/worked-solution "We're given that $y=\\frac{A}{x}$ is the solution to the initial value problem. Therefore, it must satisfy the differential equation *and* the initial condition $y(-2)=-1.$\n\nSubstituting the initial condition $y(-2)=-1$ into our solution and solving for $A,$ we get\n\n$$\n\\begin{aligned}y & =\\frac{A}{x} \\\\ -1 & =\\frac{A}{(-2)} \\\\ A & =2.\\end{aligned}\n$$\n\nTherefore, the solution to the initial value problem is\n\n$$\ny=\\frac{2}{x}.\n$$"}] [{:db/id #edb/ref 17592186398452 :knowledge-point/_questions [{:db/id #edb/ref 17592186100951 :knowledge-point/id #uuid "82a9b23c-4c79-56cd-9761-79d0ee22646d" :knowledge-point/title "Identifying Solutions to Initial Value Problems"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "89027aec-d449-5dca-8830-9b39f9c5fbba" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "e+1" :db/id #edb/ref 17592186398454} {:answer/id #uuid "d1591666-636c-5480-9f22-08f9eeec3613" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2e-1" :db/id #edb/ref 17592186398455} {:answer/id #uuid "b092bcb2-de91-5a2a-9a1c-b1cf1cdf0b26" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186398456} {:answer/id #uuid "4f0a5d44-77c5-5b01-9db7-d212e6e5f858" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "e-1" :db/id #edb/ref 17592186398457} {:answer/id #uuid "408ad86d-b3e2-50fe-ba49-d6d10e8b89e9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186398458}] :answer-field/correct {:answer/id #uuid "4f0a5d44-77c5-5b01-9db7-d212e6e5f858" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "e-1" :db/id #edb/ref 17592186398457} :answer-field/id #uuid "5f0f43ae-19bf-5c26-8ca2-6e01020ad358" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186398453}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "e96414b2-2fe9-598e-bc15-f2c64a7b0633" :question/math-academy-id "q-141115" :question/problem "Consider the following initial value problem\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}={e}^{-y},\\,y(1)=1.\n$$\n\nYou're given that $y=\\operatorname{ln}⁡(A+x)$ is the solution to this initial value problem. What is the value of the constant $A?$" :question/worked-solution "We're given that $y=\\operatorname{ln}⁡(A+x)$ is the solution to the initial value problem. Therefore, it must satisfy the differential equation *and* the initial condition $y(1)=1.$\n\nSubstituting the initial condition $y(1)=1$ into our solution and solving for $A,$ we get\n\n$$\n\\begin{aligned}y & =\\operatorname{ln}⁡(A+x) \\\\ 1 & =\\operatorname{ln}⁡(A+1) \\\\ {e}^{1} & ={e}^{\\operatorname{ln}⁡(A+1)} \\\\ e & =A+1 \\\\ A & =e-1.\\end{aligned}\n$$\n\nTherefore, the solution to the initial value problem is\n\n$$\ny=\\operatorname{ln}⁡(e-1+x).\n$$"}] [{:db/id #edb/ref 17592186400909 :knowledge-point/_questions [{:db/id #edb/ref 17592186129253 :knowledge-point/id #uuid "4d48e2a0-1a76-5eec-a98c-4a7eb16f70cb" :knowledge-point/title "Identifying Multiplicity of a Root Given a Graph"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3559bdb9-c007-500b-83db-63f2d91cd407" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$x=-3$ is a multiple root of odd multiplicity" :db/id #edb/ref 17592186400911} {:answer/id #uuid "f1984a87-93e4-523e-80b4-a37c28b7dc5b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$x=-3$ is a multiple root of even multiplicity" :db/id #edb/ref 17592186400912} {:answer/id #uuid "3f15fef9-83c3-50e8-980b-72c67ab596d8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$x=-3$ is a simple root of even multiplicity" :db/id #edb/ref 17592186400913} {:answer/id #uuid "f52c0001-2df6-56e0-ae3c-2dca7d79a58b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$x=-3$ is not a root of $p(x)$" :db/id #edb/ref 17592186400914} {:answer/id #uuid "d7950f6f-fd87-5dac-ba8c-650fe8a19888" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$x=-3$ is a simple root" :db/id #edb/ref 17592186400915}] :answer-field/correct {:answer/id #uuid "d7950f6f-fd87-5dac-ba8c-650fe8a19888" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$x=-3$ is a simple root" :db/id #edb/ref 17592186400915} :answer-field/id #uuid "5806f142-c711-5da8-b1d4-68c8001a3f1f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186400910}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "6ab70a1a-e04b-524f-9866-e86f88144126" :question/math-academy-id "q-141140" :question/problem "![](images/b3/b362831ba2248e03537551c412ae7537646dcd09f0d00a598905f0d52a258da9.png)\n\nA part of the graph of a polynomial $p(x)$ is given above. Which of the following statements is true?" :question/worked-solution "| Multiplicity | Sketch | Sketch |\n| --- | --- | --- |\n| $1$ \n\n (Simple Root) | ![](images/5a/5a0221f93c65a1eeb4503604a558a6da81c4c7af81c2c52cc35ecf3d189fe99f.png) | ![](images/d5/d556b4edf39181eebb7ec87c344d6f657a6875ecd2745405eaf5351ccaff6f96.png) |\n| $>1$ \n\n (Multiple Root) \n\n Even | ![](images/9d/9d14c2588da2ee9c9f5bbc32a70791146bed609ea0d6d5912aeaa2edab02e2d7.png) | ![](images/28/28ad9248a9a509e3a44937d0438fb2366f550a22360d01b9b6a29bcac41357e8.png) |\n| $>1$ \n\n (Multiple Root) \n\n Odd | ![](images/3a/3ae81378cb3c918dd5b7730519eb5a91e949f88eef9f03f4910f4ab8fb3cd5a9.png) | ![](images/95/9506a7ce4031f1f6244c0110c3235f66ea5652bb53548a032732869cf21f5997.png) |\n\nIt's possible to determine information regarding the multiplicities of the roots of a polynomial from its graph.\n\n- If the graph intersects the $x$-axis but is *not* tangent to the $x$-axis at $x=a,$ we have a *simple* root $x=a.$\n\n- If the graph is *tangent* to the $x$-axis at $x=a,$ we have a *multiple* root $x=a.$ Furthermore:\n\n- If the graph touches the $x$-axis and reverses direction at $x=a,$ the multiplicity of a root $x=a$ is *even*.\n\n- If the graph crosses the $x$-axis at $x=a,$ the multiplicity of a root $x=a$ is *odd*.\n\nIn our case, the graph is *not* tangent to the $x$-axis at $x=-3.$ Therefore, $x=-3$ is a *simple* root."}] [{:db/id #edb/ref 17592186272221 :knowledge-point/_questions [{:db/id #edb/ref 17592186129253 :knowledge-point/id #uuid "4d48e2a0-1a76-5eec-a98c-4a7eb16f70cb" :knowledge-point/title "Identifying Multiplicity of a Root Given a Graph"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7a762869-8c41-5b99-945a-904933273d75" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$x=6$ is a simple root" :db/id #edb/ref 17592186270354} {:answer/id #uuid "8e0792d1-d0d7-58d4-acd0-2928fe61d064" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$x=6$ is a multiple root of odd multiplicity" :db/id #edb/ref 17592186270498} {:answer/id #uuid "a19bd95b-bbd6-55a2-9a46-010b458abb4e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$x=6$ is not a root of $p(x)$" :db/id #edb/ref 17592186270704} {:answer/id #uuid "c3b75751-2d73-5678-8386-167ce0d8f782" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$x=6$ is a simple root of even multiplicity" :db/id #edb/ref 17592186270997} {:answer/id #uuid "f84b8666-1809-58bd-bfe6-8ab9488eb61f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$x=6$ is a multiple root of even multiplicity" :db/id #edb/ref 17592186271447}] :answer-field/correct {:answer/id #uuid "f84b8666-1809-58bd-bfe6-8ab9488eb61f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$x=6$ is a multiple root of even multiplicity" :db/id #edb/ref 17592186271447} :answer-field/id #uuid "eb90200a-e2bb-5eaf-ba24-af1df789d82c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186271925}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "86545112-71e2-5627-8c9c-5a320524ae07" :question/math-academy-id "q-141144" :question/problem "![](images/40/4092c0852a573a0add69c6fb7b55f393d0767a5b6a2282a10194ea27cb1be9c4.png)\n\nA part of the graph of a polynomial $p(x)$ is shown above. Which of the following statements is true?" :question/worked-solution "| Multiplicity | Sketch | Sketch |\n| --- | --- | --- |\n| $1$ \n\n (Simple Root) | ![](images/5a/5a0221f93c65a1eeb4503604a558a6da81c4c7af81c2c52cc35ecf3d189fe99f.png) | ![](images/d5/d556b4edf39181eebb7ec87c344d6f657a6875ecd2745405eaf5351ccaff6f96.png) |\n| $>1$ \n\n (Multiple Root) \n\n Even | ![](images/9d/9d14c2588da2ee9c9f5bbc32a70791146bed609ea0d6d5912aeaa2edab02e2d7.png) | ![](images/28/28ad9248a9a509e3a44937d0438fb2366f550a22360d01b9b6a29bcac41357e8.png) |\n| $>1$ \n\n (Multiple Root) \n\n Odd | ![](images/3a/3ae81378cb3c918dd5b7730519eb5a91e949f88eef9f03f4910f4ab8fb3cd5a9.png) | ![](images/95/9506a7ce4031f1f6244c0110c3235f66ea5652bb53548a032732869cf21f5997.png) |\n\nIt's possible to determine information regarding the multiplicities of the roots of a polynomial from its graph.\n\n- If the graph intersects the $x$-axis but is *not* tangent to the $x$-axis at $x=a,$ we have a *simple* root $x=a.$\n\n- If the graph is *tangent* to the $x$-axis at $x=a,$ we have a *multiple* root $x=a.$ Furthermore:\n\n- If the graph touches the $x$-axis and reverses direction at $x=a,$ the multiplicity of a root $x=a$ is *even*.\n\n- If the graph crosses the $x$-axis at $x=a,$ the multiplicity of a root $x=a$ is *odd*.\n\nIn our case, the graph is *tangent* to the $x$-axis at $x=6.$ So, $x=6$ is a *multiple* root. \n\nFurthermore, the graph touches the $x$-axis and reverses direction at $x=6.$ So, $x=6$ has *even* multiplicity.\n\nTherefore, $x=6$ is a multiple root of even multiplicity."}] [{:db/id #edb/ref 17592186400916 :knowledge-point/_questions [{:db/id #edb/ref 17592186068825 :knowledge-point/id #uuid "fc419917-fe34-5bf9-8bf0-1b022fce11ff" :knowledge-point/title "Solving a \"Less Than\" Inequality Given the Graph of the Corresponding Parabola"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c694a7cb-1273-5aef-bab1-b00405cb06a8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-5<x<1" :db/id #edb/ref 17592186400918} {:answer/id #uuid "19263d22-de7b-5ef3-9798-b98080320005" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$x<-5$ or    $x>-1$" :db/id #edb/ref 17592186400919} {:answer/id #uuid "ee071af0-120e-5c4a-b72d-0c54e26d3687" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x>5" :db/id #edb/ref 17592186400920} {:answer/id #uuid "395b066b-730c-5a11-889e-cc63987fd8a1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$x<-1$ or    $x>5$" :db/id #edb/ref 17592186400921} {:answer/id #uuid "3271e9c8-ddaf-5be7-852f-5b3fd22e072b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1<x<5" :db/id #edb/ref 17592186400922}] :answer-field/correct {:answer/id #uuid "19263d22-de7b-5ef3-9798-b98080320005" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$x<-5$ or    $x>-1$" :db/id #edb/ref 17592186400919} :answer-field/id #uuid "7f3297c0-8b61-583d-8e5e-b17352fc3208" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186400917}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "66cebf22-0b82-5cf0-a87d-5c8eaa25290f" :question/math-academy-id "q-141187" :question/problem "![](images/46/46edcf2265f41b8fac7931802875e1b9849006834b3509a186ffc7acb510959f.png)\n\nGiven the graph above, solve the inequality $(-x-5)(x+1)<0.$" :question/worked-solution "Notice that our inequality\n\n$$\n(-x-5)(x+1)<0,\n$$\n\nis a \"*less than*\" inequality. Therefore, we need to find the values of $x$ for which the parabola  \n\n$$\ny=(-x-5)(x+1)\n$$\n\n  \n\nis *below* the $x$-axis. We mark these values of $x$ in blue in the diagram below.\n\n![](images/e8/e830af773829b1712c6a87955e74411b6ad9921ae1aea58029ca968ab354c0f1.png)\n\n \n\nSo, the solution to the inequality is $x<-5$ or    $x>-1.$"}] [{:db/id #edb/ref 17592186272254 :knowledge-point/_questions [{:db/id #edb/ref 17592186059662 :knowledge-point/id #uuid "69e91ce7-259a-5a11-bb79-7e6ad7ea86d4" :knowledge-point/title "Simplifying Expressions in Degrees Using the Sum and Difference Formulas"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "12266a51-a7c9-5483-94da-be9664d1b481" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{\\sqrt{2}(\\operatorname{sin}⁡x+\\operatorname{cos}⁡x)}{2}" :db/id #edb/ref 17592186269429} {:answer/id #uuid "18eff7de-8c89-5305-88dc-9781c493dbed" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{3}\\operatorname{sin}⁡x-\\operatorname{cos}⁡x}{2}" :db/id #edb/ref 17592186269477} {:answer/id #uuid "9784d4b6-191f-5d3c-bfd0-0ff7a24f4c76" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{\\operatorname{sin}⁡x+\\sqrt{3}\\operatorname{cos}⁡x}{2}" :db/id #edb/ref 17592186270602} {:answer/id #uuid "b5aefcfb-4daa-5443-aaa4-83730b1b02a2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\operatorname{sin}⁡x-\\sqrt{3}\\operatorname{cos}⁡x}{2}" :db/id #edb/ref 17592186270882} {:answer/id #uuid "f3d99ef5-ddef-5389-82d4-95a6ce517307" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{2}(\\operatorname{sin}⁡x+\\operatorname{cos}⁡x)}{2}" :db/id #edb/ref 17592186271407}] :answer-field/correct {:answer/id #uuid "9784d4b6-191f-5d3c-bfd0-0ff7a24f4c76" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{\\operatorname{sin}⁡x+\\sqrt{3}\\operatorname{cos}⁡x}{2}" :db/id #edb/ref 17592186270602} :answer-field/id #uuid "a0f40e9a-9d94-55f1-89bf-5ae1a4030b7c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186271801}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "b6e1f817-7c7e-51c8-bd09-e888759f9be3" :question/math-academy-id "q-141275" :question/problem "$\\operatorname{sin}⁡(x-{120}^{∘})=$" :question/worked-solution "Recall the difference formula for sine:\n\n$$\n\\operatorname{sin}⁡(u-v)=\\operatorname{sin}⁡u\\operatorname{cos}⁡v-\\operatorname{cos}⁡u\\operatorname{sin}⁡v\n$$\n\nApplying the difference formula for sine with $u=x$ and $v={120}^{∘},$ we get\n\n$$\n\\begin{aligned}\\operatorname{sin}⁡(x-{120}^{∘}) & =\\operatorname{sin}⁡x\\operatorname{cos}⁡{120}^{∘}-\\operatorname{cos}⁡x\\operatorname{sin}⁡{120}^{∘} \\\\  & =\\operatorname{sin}⁡x\\cdot (-\\frac{1}{2})-\\operatorname{cos}⁡x\\cdot (\\frac{\\sqrt{3}}{2}) \\\\  & =-\\frac{\\operatorname{sin}⁡x}{2}-\\frac{\\sqrt{3}\\operatorname{cos}⁡x}{2} \\\\  & =-\\frac{\\operatorname{sin}⁡x+\\sqrt{3}\\operatorname{cos}⁡x}{2}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186272256 :knowledge-point/_questions [{:db/id #edb/ref 17592186059662 :knowledge-point/id #uuid "69e91ce7-259a-5a11-bb79-7e6ad7ea86d4" :knowledge-point/title "Simplifying Expressions in Degrees Using the Sum and Difference Formulas"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "012c6c54-c102-5db4-8d24-caf1dec68123" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\operatorname{cos}⁡x" :db/id #edb/ref 17592186269269} {:answer/id #uuid "55dd97d3-3e02-5362-84db-9281bfaf98c8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{cos}⁡x" :db/id #edb/ref 17592186270029} {:answer/id #uuid "60c3ef61-d3ea-5891-85a9-bc3230333d6c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{3}\\operatorname{cos}⁡x-\\operatorname{sin}⁡x}{2}" :db/id #edb/ref 17592186270123} {:answer/id #uuid "7837e062-26e0-54eb-9c88-937b73a56868" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{\\sqrt{2}(\\operatorname{sin}⁡x+\\operatorname{cos}⁡x)}{2}" :db/id #edb/ref 17592186270334} {:answer/id #uuid "9974f52a-a24a-58ca-913f-99e237c9a5bc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\operatorname{sin}⁡x" :db/id #edb/ref 17592186270618}] :answer-field/correct {:answer/id #uuid "9974f52a-a24a-58ca-913f-99e237c9a5bc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\operatorname{sin}⁡x" :db/id #edb/ref 17592186270618} :answer-field/id #uuid "bea83195-85b8-5a62-ae80-a9df9097b16d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186271856}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "dd3a924d-681c-501c-bf69-7fbcdc5b6418" :question/math-academy-id "q-141278" :question/problem "$\\operatorname{sin}⁡(x-{180}^{∘})=$" :question/worked-solution "Recall the difference formula for sine:\n\n$$\n\\operatorname{sin}⁡(u-v)=\\operatorname{sin}⁡u\\operatorname{cos}⁡v-\\operatorname{cos}⁡u\\operatorname{sin}⁡v\n$$\n\nApplying the difference formula for sine with $u=x$ and $v={180}^{∘},$ we get\n\n$$\n\\begin{aligned}\\operatorname{sin}⁡(x-{180}^{∘}) & =\\operatorname{sin}⁡x\\operatorname{cos}⁡{180}^{∘}-\\operatorname{cos}⁡x\\operatorname{sin}⁡{180}^{∘} \\\\  & =\\operatorname{sin}⁡x\\cdot (-1)-\\operatorname{cos}⁡x\\cdot (0) \\\\  & =-\\operatorname{sin}⁡x.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186272257 :knowledge-point/_questions [{:db/id #edb/ref 17592186059820 :knowledge-point/id #uuid "4b12a7b7-1df3-5203-934e-8820604de3de" :knowledge-point/title "Simplifying Expressions in Radians Using the Sum and Difference Formulas"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0da8bceb-5536-5271-8827-e5da61eb6060" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\operatorname{sin}⁡x" :db/id #edb/ref 17592186269387} {:answer/id #uuid "3ef50584-86f1-5b31-a1a6-a37093aa3120" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\operatorname{cos}⁡x" :db/id #edb/ref 17592186269846} {:answer/id #uuid "42fbd17c-de86-5394-814e-0ac710c28aed" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{2}(\\operatorname{sin}⁡x-\\operatorname{cos}⁡x)}{2}" :db/id #edb/ref 17592186269872} {:answer/id #uuid "ced45233-a48f-5d9c-bc03-580cf170e7ca" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{\\sqrt{3}\\operatorname{sin}⁡x+\\operatorname{cos}⁡x}{2}" :db/id #edb/ref 17592186271083} {:answer/id #uuid "d6ebddae-329f-55c0-89d1-c5bb4c99e094" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{cos}⁡x" :db/id #edb/ref 17592186271157}] :answer-field/correct {:answer/id #uuid "3ef50584-86f1-5b31-a1a6-a37093aa3120" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\operatorname{cos}⁡x" :db/id #edb/ref 17592186269846} :answer-field/id #uuid "e714385a-3268-5f76-bbf9-458125ace391" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186271919}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "78f7a073-b897-5930-bd54-7d5e600e42be" :question/math-academy-id "q-141284" :question/problem "$\\operatorname{sin}⁡(x-\\frac{\\pi }{2})=$" :question/worked-solution "Recall the difference formula for sine:\n\n$$\n\\operatorname{sin}⁡(u-v)=\\operatorname{sin}⁡u\\operatorname{cos}⁡v-\\operatorname{cos}⁡u\\operatorname{sin}⁡v\n$$\n\nApplying the difference formula for sine with $u=x$ and $v=\\frac{\\pi }{2},$ we get\n\n$$\n\\begin{aligned}\\operatorname{sin}⁡(x-\\frac{\\pi }{2}) & =\\operatorname{sin}⁡x\\operatorname{cos}⁡(\\frac{\\pi }{2})-\\operatorname{cos}⁡x\\operatorname{sin}⁡(\\frac{\\pi }{2}) \\\\  & =\\operatorname{sin}⁡x\\cdot (0)-\\operatorname{cos}⁡x\\cdot (1) \\\\  & =-\\operatorname{cos}⁡x.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186272270 :knowledge-point/_questions [{:db/id #edb/ref 17592186059821 :knowledge-point/id #uuid "c6a58962-cb06-519a-8c64-0dfa3b9c14d7" :knowledge-point/title "Simplifying Expressions in Degrees Using the Sum and Difference Formulas"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "25783b4f-f3f1-5cc2-84df-24e666b31d94" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{2}(\\operatorname{cos}⁡x+\\operatorname{sin}⁡x)}{2}" :db/id #edb/ref 17592186269600} {:answer/id #uuid "6ffdb6d7-6d98-5836-9d05-4da7a12f0aac" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{3}\\operatorname{cos}⁡x+\\operatorname{sin}⁡x}{2}" :db/id #edb/ref 17592186270259} {:answer/id #uuid "84074aaa-f06b-558f-bcf0-aa133aa7738a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{3}\\operatorname{cos}⁡x-\\operatorname{sin}⁡x}{2}" :db/id #edb/ref 17592186270409} {:answer/id #uuid "c08bd8f7-a322-5e2b-8ce7-5315830bd7b1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{2}(\\operatorname{cos}⁡x-\\operatorname{sin}⁡x)}{2}" :db/id #edb/ref 17592186270974} {:answer/id #uuid "fc967a21-6b7e-51a5-8070-4d6aaad3f36a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\operatorname{cos}⁡x-\\sqrt{3}\\operatorname{sin}⁡x}{2}" :db/id #edb/ref 17592186271480}] :answer-field/correct {:answer/id #uuid "84074aaa-f06b-558f-bcf0-aa133aa7738a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{3}\\operatorname{cos}⁡x-\\operatorname{sin}⁡x}{2}" :db/id #edb/ref 17592186270409} :answer-field/id #uuid "4424e579-c28d-53af-bbb7-f1ff4f62f6c8" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186271634}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "b5eb1983-1627-51b5-a21b-a1c11d629a2e" :question/math-academy-id "q-141364" :question/problem "$\\operatorname{cos}⁡(x+{30}^{∘})=$" :question/worked-solution "First, we recall the sum formula for cosine:\n\n$$\n\\operatorname{cos}⁡(u+v)=\\operatorname{cos}⁡u\\operatorname{cos}⁡v-\\operatorname{sin}⁡u\\operatorname{sin}⁡v\n$$\n\nApplying the sum formula for cosine with $u=x$ and $v={30}^{∘}$, we get\n\n$$\n\\begin{aligned}\\operatorname{cos}⁡(x+{30}^{∘}) & =\\operatorname{cos}⁡x\\operatorname{cos}⁡{30}^{∘}-\\operatorname{sin}⁡x\\operatorname{sin}⁡{30}^{∘} \\\\  & =\\operatorname{cos}⁡x\\cdot \\frac{\\sqrt{3}}{2}-\\operatorname{sin}⁡x\\cdot \\frac{1}{2} \\\\  & =\\frac{\\sqrt{3}\\operatorname{cos}⁡x}{2}-\\frac{\\operatorname{sin}⁡x}{2} \\\\  & =\\frac{\\sqrt{3}\\operatorname{cos}⁡x-\\operatorname{sin}⁡x}{2}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186272273 :knowledge-point/_questions [{:db/id #edb/ref 17592186059821 :knowledge-point/id #uuid "c6a58962-cb06-519a-8c64-0dfa3b9c14d7" :knowledge-point/title "Simplifying Expressions in Degrees Using the Sum and Difference Formulas"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1aff4cbe-6fe4-5b7e-818d-a180abe9eb18" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{\\sqrt{2}(\\operatorname{sin}⁡x+\\operatorname{cos}⁡x)}{2}" :db/id #edb/ref 17592186269488} {:answer/id #uuid "1ebb1f5f-41ff-5401-ad84-cc41307a79d0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{3}\\operatorname{sin}⁡x+\\operatorname{cos}⁡x}{2}" :db/id #edb/ref 17592186269527} {:answer/id #uuid "38362095-3b1c-5bfd-9cc4-30473fe3b5bf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{2}(\\operatorname{sin}⁡x-\\operatorname{cos}⁡x)}{2}" :db/id #edb/ref 17592186269776} {:answer/id #uuid "4003a8ec-c9e7-5741-ba8f-90325c814912" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\operatorname{sin}⁡x-\\sqrt{3}\\operatorname{cos}⁡x}{2}" :db/id #edb/ref 17592186269851} {:answer/id #uuid "ea19c52e-9497-565a-b200-4435179ca96d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{\\sqrt{3}\\operatorname{cos}⁡x+\\operatorname{sin}⁡x}{2}" :db/id #edb/ref 17592186271320}] :answer-field/correct {:answer/id #uuid "4003a8ec-c9e7-5741-ba8f-90325c814912" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\operatorname{sin}⁡x-\\sqrt{3}\\operatorname{cos}⁡x}{2}" :db/id #edb/ref 17592186269851} :answer-field/id #uuid "fcc5eb38-7a7e-586b-9f31-c5ca7c948e10" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186271946}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "c98a2195-4ec8-5e2a-a4f5-76fb1079c255" :question/math-academy-id "q-141374" :question/problem "$\\operatorname{cos}⁡(x-{150}^{∘})=$" :question/worked-solution "First, we recall the difference formula for cosine:\n\n$$\n\\operatorname{cos}⁡(u-v)=\\operatorname{cos}⁡u\\operatorname{cos}⁡v+\\operatorname{sin}⁡u\\operatorname{sin}⁡v\n$$\n\nApplying the difference formula for cosine with $u=x$ and $v={150}^{∘},$ we get\n\n$$\n\\begin{aligned}\\operatorname{cos}⁡(x-{150}^{∘}) & =\\operatorname{cos}⁡x\\operatorname{cos}⁡{150}^{∘}+\\operatorname{sin}⁡x\\operatorname{sin}⁡{150}^{∘} \\\\  & =\\operatorname{cos}⁡x\\cdot (-\\frac{\\sqrt{3}}{2})+\\operatorname{sin}⁡x\\cdot \\frac{1}{2} \\\\  & =-\\frac{\\sqrt{3}\\operatorname{cos}⁡x}{2}+\\frac{\\operatorname{sin}⁡x}{2} \\\\  & =\\frac{\\operatorname{sin}⁡x-\\sqrt{3}\\operatorname{cos}⁡x}{2}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186272275 :knowledge-point/_questions [{:db/id #edb/ref 17592186059665 :knowledge-point/id #uuid "831f9aa0-099e-5e0c-8a9d-c4828b629f64" :knowledge-point/title "Simplifying Expressions in Radians Using the Sum and Difference Formulas"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0b931fa1-ee52-5db3-bac9-497efc06f498" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{\\sqrt{2}(\\operatorname{cos}⁡x+\\operatorname{sin}⁡x)}{2}" :db/id #edb/ref 17592186269370} {:answer/id #uuid "2342b124-c9e0-58c0-a580-8d4f8695808a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{2}(\\operatorname{sin}⁡x-\\operatorname{cos}⁡x)}{2}" :db/id #edb/ref 17592186269577} {:answer/id #uuid "69b15b7b-0cac-5374-93f1-818c8990768a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{3}\\operatorname{cos}⁡x+\\operatorname{sin}⁡x}{2}" :db/id #edb/ref 17592186270207} {:answer/id #uuid "a358caaa-5c57-5746-b54c-5548bfb79b9b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\operatorname{cos}⁡x-\\sqrt{3}\\operatorname{sin}⁡x}{2}" :db/id #edb/ref 17592186270725} {:answer/id #uuid "dff6ea96-0ee2-5bc4-80b8-7b9f1617a512" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\operatorname{sin}⁡x-\\sqrt{3}\\operatorname{cos}⁡x}{2}" :db/id #edb/ref 17592186271232}] :answer-field/correct {:answer/id #uuid "0b931fa1-ee52-5db3-bac9-497efc06f498" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{\\sqrt{2}(\\operatorname{cos}⁡x+\\operatorname{sin}⁡x)}{2}" :db/id #edb/ref 17592186269370} :answer-field/id #uuid "3f2bd73b-78d1-5e9e-92ad-582b63f4ea0e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186271623}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "308956a9-f5f0-59d1-8748-67ba18adb1f8" :question/math-academy-id "q-141381" :question/problem "$\\operatorname{cos}⁡(x+\\frac{3\\pi }{4})=$" :question/worked-solution "First, we recall the sum formula for cosine:\n\n$$\n\\operatorname{cos}⁡(u+v)=\\operatorname{cos}⁡u\\operatorname{cos}⁡v-\\operatorname{sin}⁡u\\operatorname{sin}⁡v\n$$\n\nApplying the sum formula for cosine with $u=x$ and $v=\\frac{3\\pi }{4},$ we get\n\n$$\n\\begin{aligned}\\operatorname{cos}⁡(x+\\frac{3\\pi }{4}) & =\\operatorname{cos}⁡x\\operatorname{cos}⁡(\\frac{3\\pi }{4})-\\operatorname{sin}⁡x\\operatorname{sin}⁡(\\frac{3\\pi }{4}) \\\\  & =\\operatorname{cos}⁡x\\cdot (-\\frac{\\sqrt{2}}{2})-\\operatorname{sin}⁡x\\cdot \\frac{\\sqrt{2}}{2} \\\\  & =-\\frac{\\sqrt{2}\\operatorname{cos}⁡x}{2}-\\frac{\\sqrt{2}\\operatorname{sin}⁡x}{2} \\\\  & =-\\frac{\\sqrt{2}(\\operatorname{cos}⁡x+\\operatorname{sin}⁡x)}{2}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186272277 :knowledge-point/_questions [{:db/id #edb/ref 17592186059665 :knowledge-point/id #uuid "831f9aa0-099e-5e0c-8a9d-c4828b629f64" :knowledge-point/title "Simplifying Expressions in Radians Using the Sum and Difference Formulas"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2a22d57d-9107-5ef5-9e1a-664d1e481595" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\operatorname{cos}⁡x+\\sqrt{3}\\operatorname{sin}⁡x}{2}" :db/id #edb/ref 17592186269651} {:answer/id #uuid "2e7bf421-a5a6-51a7-bbde-dcaec6ed4724" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{3}\\operatorname{cos}⁡x-\\operatorname{sin}⁡x}{2}" :db/id #edb/ref 17592186269688} {:answer/id #uuid "8a0c5476-651b-5c29-aaf7-9c8b4495a59a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{2}(\\operatorname{cos}⁡x+\\operatorname{sin}⁡x)}{2}" :db/id #edb/ref 17592186270462} {:answer/id #uuid "8a8eb468-d843-5e6f-a576-53b1846a95f7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\operatorname{cos}⁡x-\\sqrt{3}\\operatorname{sin}⁡x}{2}" :db/id #edb/ref 17592186270466} {:answer/id #uuid "ca8ff2c0-77a5-54e0-af66-4eb8ca206ccd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{2}(\\operatorname{cos}⁡x-\\operatorname{sin}⁡x)}{2}" :db/id #edb/ref 17592186271048}] :answer-field/correct {:answer/id #uuid "2a22d57d-9107-5ef5-9e1a-664d1e481595" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\operatorname{cos}⁡x+\\sqrt{3}\\operatorname{sin}⁡x}{2}" :db/id #edb/ref 17592186269651} :answer-field/id #uuid "64d9c7cb-8c90-5531-a052-3b459d3163b8" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186271688}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "bedf2d85-2b35-59e9-bfbf-70576d25817c" :question/math-academy-id "q-141386" :question/problem "$\\operatorname{cos}⁡(x-\\frac{\\pi }{3})=$" :question/worked-solution "First, we recall  the difference formula for cosine:\n\n$$\n\\operatorname{cos}⁡(u-v)=\\operatorname{cos}⁡u\\operatorname{cos}⁡v+\\operatorname{sin}⁡u\\operatorname{sin}⁡v\n$$\n\nApplying the difference formula for cosine with $u=x$ and $v=\\frac{\\pi }{3},$ we get\n\n$$\n\\begin{aligned}\\operatorname{cos}⁡(x-\\frac{\\pi }{3}) & =\\operatorname{cos}⁡x\\operatorname{cos}⁡(\\frac{\\pi }{3})+\\operatorname{sin}⁡x\\operatorname{sin}⁡(\\frac{\\pi }{3}) \\\\  & =\\operatorname{cos}⁡x\\cdot \\frac{1}{2}+\\operatorname{sin}⁡x\\cdot \\frac{\\sqrt{3}}{2} \\\\  & =\\frac{\\operatorname{cos}⁡x}{2}+\\frac{\\sqrt{3}\\operatorname{sin}⁡x}{2} \\\\  & =\\frac{\\operatorname{cos}⁡x+\\sqrt{3}\\operatorname{sin}⁡x}{2}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186083535 :knowledge-point/_questions [{:db/id #edb/ref 17592186083232 :knowledge-point/id #uuid "1b5f9ee9-a489-5048-8346-0116a19e9b4a" :knowledge-point/title "Counting the Number of Possible Rational Roots of a Polynomial"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "311f9529-efb3-578e-8744-809e1101f04a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "10" :db/id #edb/ref 17592186269712} {:answer/id #uuid "6d3730b5-4247-558a-bff6-c3d95ce3ec3e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186270236} {:answer/id #uuid "83f3968d-ef3f-53f0-ba78-c6e9d8fb524c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "16" :db/id #edb/ref 17592186270408} {:answer/id #uuid "86ca815b-5e6f-55e6-91c6-bd46a039a85f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186270438} {:answer/id #uuid "b1319d66-f133-598f-a450-27c576b92f22" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "20" :db/id #edb/ref 17592186270851}] :answer-field/correct {:answer/id #uuid "b1319d66-f133-598f-a450-27c576b92f22" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "20" :db/id #edb/ref 17592186270851} :answer-field/id #uuid "9ca9f1ac-2135-555e-8f76-360ce0db72a9" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186271787}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "aeb1ad5f-0910-5dea-b64a-e03889cc2cc5" :question/math-academy-id "q-14145" :question/problem "For the polynomial $f(x)=10{x}^{6}-52{x}^{2}+50x-8,$ how many *potential* roots are given by the rational roots theorem?" :question/worked-solution "Given a polynomial with integer coefficients, the rational roots theorem states that any rational roots of the polynomial must take the form\n\n$$\n\\pm \\frac{\\text{factor of the constant term}}{\\text{factor of the leading coefficient}}.\n$$\n\nFor the given polynomial:\n\n- The constant term is $-8,$ and its factors are $\\pm 1,$ $\\pm 2,$ $\\pm 4,$ and $\\pm 8.$\n\n- The leading coefficient is $10,$ and its factors are $\\pm 1,$ $\\pm 2,$ $\\pm 5,$ and $\\pm 10.$\n\nFirst, we list out all the possibilities for the numerator and denominator:\n\n$$\n\\begin{aligned}\\pm \\frac{1}{1}, & \\pm \\frac{1}{2}, & \\pm \\frac{1}{5}, & \\pm \\frac{1}{10}, \\\\ \\pm \\frac{2}{1}, & \\pm \\frac{2}{2}, & \\pm \\frac{2}{5}, & \\pm \\frac{2}{10}, \\\\ \\pm \\frac{4}{1}, & \\pm \\frac{4}{2}, & \\pm \\frac{4}{5}, & \\pm \\frac{4}{10}, \\\\ \\pm \\frac{8}{1}, & \\pm \\frac{8}{2}, & \\pm \\frac{8}{5}, & \\pm \\frac{8}{10}.\\end{aligned}\n$$\n\nNext, we reduce the fractions to lowest terms:\n\n$$\n\\begin{aligned}\\pm 1, & \\pm \\frac{1}{2}, & \\pm \\frac{1}{5}, & \\pm \\frac{1}{10}, \\\\ \\pm 2, & \\pm 1, & \\pm \\frac{2}{5}, & \\pm \\frac{1}{5}, \\\\ \\pm 4, & \\pm 2, & \\pm \\frac{4}{5}, & \\pm \\frac{2}{5}, \\\\ \\pm 8, & \\pm 4, & \\pm \\frac{8}{5}, & \\pm \\frac{4}{5}.\\end{aligned}\n$$\n\nNotice that several potential roots are duplicates (shown above in red). Removing these duplicates, and listing those remaining in order from least to greatest in absolute value, we have\n\n$$\n\\pm \\frac{1}{10},\\,\\pm \\frac{1}{5},\\,\\pm \\frac{2}{5},\\,\\pm \\frac{1}{2},\\,\\pm \\frac{4}{5},\\,\\pm 1,\\,\\pm \\frac{8}{5},\\,\\pm 2,\\,\\pm 4,\\,\\pm 8.\n$$\n\nThis makes a total of $20$ potential roots. (Remember that each $\\pm $ sign accounts for $2$ roots, and $2\\cdot 10=20.$)"}] [{:db/id #edb/ref 17592186272292 :knowledge-point/_questions [{:db/id #edb/ref 17592186068873 :knowledge-point/id #uuid "f10e4a34-a512-5ff4-abbc-66e6830d63d0" :knowledge-point/title "Completing the Square When the Perfect Square is Isolated"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "110ee8cd-e830-5bb3-bab0-f16cb26fe2b7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(y+4{)}^{2}-3" :db/id #edb/ref 17592186269421} {:answer/id #uuid "13e31713-81cb-5dec-8652-93d586dd34fb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(y-3{)}^{2}-3" :db/id #edb/ref 17592186269445} {:answer/id #uuid "29d7d2be-f02c-521d-b752-bf360c856fdf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(y+3{)}^{2}-3" :db/id #edb/ref 17592186269648} {:answer/id #uuid "5eb20cc7-de16-5bcf-8e1b-43826770ca5f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(y-6{)}^{2}-3" :db/id #edb/ref 17592186270109} {:answer/id #uuid "f84d763b-739b-535d-8995-04b2349046b0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(y+6{)}^{2}-3" :db/id #edb/ref 17592186271448}] :answer-field/correct {:answer/id #uuid "f84d763b-739b-535d-8995-04b2349046b0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(y+6{)}^{2}-3" :db/id #edb/ref 17592186271448} :answer-field/id #uuid "ee48d03a-569e-51f8-be78-887782d15f39" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186271927}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "48f5b61f-2f3f-5cda-a551-c1e861cdd220" :question/math-academy-id "q-141513" :question/problem "Rewrite the expression $({y}^{2}+12y+{6}^{2})-3$ as the difference between a perfect square and a constant." :question/worked-solution "First, we recall the following formula:\n\n$$\n{y}^{2}+2ay+{a}^{2}=(y+a{)}^{2}\n$$\n\nNotice that we have a perfect square in the parentheses that we can factor as follows:\n\n$$\n\\begin{aligned}{y}^{2}+12y+{6}^{2} & = \\\\ {y}^{2}+2\\cdot 6y+{6}^{2} & = \\\\ (y+6{)}^{2} & \\end{aligned}\n$$\n\nTherefore, we obtain\n\n$$\n\\begin{aligned}({y}^{2}+12y+{6}^{2})-3 & = \\\\ (y+6{)}^{2}-3 & .\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186272294 :knowledge-point/_questions [{:db/id #edb/ref 17592186184169 :knowledge-point/id #uuid "ec6076ff-1538-5bc0-973d-33d908b0b4d2" :knowledge-point/title "Completing the Square on a Quadratic Expression"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "31012e79-2696-578b-952b-a385f9bb0eb6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{(y+\\frac{11}{2})}^{2}-\\frac{21}{4}" :db/id #edb/ref 17592186269711} {:answer/id #uuid "80e62b24-0b58-586c-ab5e-10a92a99e5ed" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{(y+\\frac{11}{2})}^{2}-5" :db/id #edb/ref 17592186270386} {:answer/id #uuid "8e8982a4-a551-5a56-96cc-144410267cb0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{(y+\\frac{11}{2})}^{2}-\\frac{25}{4}" :db/id #edb/ref 17592186270506} {:answer/id #uuid "94a242c2-81bc-53a1-99fc-de5cfa4e26aa" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{(y+\\frac{11}{4})}^{2}-\\frac{21}{2}" :db/id #edb/ref 17592186270571} {:answer/id #uuid "eaa96b06-cbed-595d-86c7-fdb048fe292f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{(y+\\frac{11}{4})}^{2}-5" :db/id #edb/ref 17592186271324}] :answer-field/correct {:answer/id #uuid "31012e79-2696-578b-952b-a385f9bb0eb6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{(y+\\frac{11}{2})}^{2}-\\frac{21}{4}" :db/id #edb/ref 17592186269711} :answer-field/id #uuid "40dc7a0f-2584-5d4a-b845-07be3a13c2db" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186271628}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "b17fd33d-fef8-5118-8c44-b94f68ba1d49" :question/math-academy-id "q-141527" :question/problem "Complete the square on the quadratic expression ${y}^{2}+11y+25.$" :question/worked-solution "First, we rewrite the coefficient of the linear term as a product with $2$ as a factor:\n\n$$\n{y}^{2}+2\\cdot \\frac{11}{2}y+25\n$$\n\nNow, here's the trick. We *add* and *then subtract* ${(\\frac{11}{2})}^{2},$ writing the constant term $25$ last:\n\n$$\n{{y}^{2}+2\\cdot \\frac{11}{2}y+{(\\frac{11}{2})}^{2}}_{⏟}-{(\\frac{11}{2})}^{2}+25\n$$\n\nThe first three terms form a perfect square, which we factor as follows:\n\n$$\n{(y+\\frac{11}{2})}^{2}-{(\\frac{11}{2})}^{2}+25\n$$\n\nFinally, evaluating the last two terms, we get\n\n$$\n{(y+\\frac{11}{2})}^{2}-\\frac{21}{4}.\n$$"}] [{:db/id #edb/ref 17592186272295 :knowledge-point/_questions [{:db/id #edb/ref 17592186184169 :knowledge-point/id #uuid "ec6076ff-1538-5bc0-973d-33d908b0b4d2" :knowledge-point/title "Completing the Square on a Quadratic Expression"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "20d0ce94-71f7-556b-a0d7-7b5e20af96e7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{(y+\\frac{7}{2})}^{2}-\\frac{49}{4}" :db/id #edb/ref 17592186269547} {:answer/id #uuid "5c56dfc4-4aef-5331-872d-da2b2274bae2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{(y+\\frac{7}{2})}^{2}-\\frac{7}{4}" :db/id #edb/ref 17592186270094} {:answer/id #uuid "bbd458c1-82ff-5e70-925e-2f5ec028580c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{(y+\\frac{7}{2})}^{2}-7" :db/id #edb/ref 17592186270924} {:answer/id #uuid "ca96e8bc-27e6-5cce-ac58-a15424f3db5f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{(y+\\frac{7}{4})}^{2}-7" :db/id #edb/ref 17592186271049} {:answer/id #uuid "e14d5b9e-029a-5589-8dcb-8d46977be99b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{(y+\\frac{7}{4})}^{2}-\\frac{7}{2}" :db/id #edb/ref 17592186271248}] :answer-field/correct {:answer/id #uuid "20d0ce94-71f7-556b-a0d7-7b5e20af96e7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{(y+\\frac{7}{2})}^{2}-\\frac{49}{4}" :db/id #edb/ref 17592186269547} :answer-field/id #uuid "4b5ddc0f-2757-59e8-9e14-a04b8fd5611f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186271648}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "f6ca9c1a-eab9-55fb-98fa-ee3277281e1b" :question/math-academy-id "q-141536" :question/problem "Complete the square on the quadratic expression ${y}^{2}+7y.$" :question/worked-solution "First, we rewrite the coefficient of the linear term as a product with $2$ as a factor:\n\n$$\n{y}^{2}+2\\cdot \\frac{7}{2}y\n$$\n\nNow, here's the trick. We *add* and *then subtract* ${(\\frac{7}{2})}^{2}:$\n\n$$\n{{y}^{2}+2\\cdot \\frac{7}{2}y+{(\\frac{7}{2})}^{2}}_{⏟}-{(\\frac{7}{2})}^{2}\n$$\n\nThe first three terms form a perfect square, which we factor as follows:\n\n$$\n{(y+\\frac{7}{2})}^{2}-{(\\frac{7}{2})}^{2}\n$$\n\nFinally, evaluating the last term, we get\n\n$$\n{(y+\\frac{7}{2})}^{2}-\\frac{49}{4}.\n$$"}] [{:db/id #edb/ref 17592186272296 :knowledge-point/_questions [{:db/id #edb/ref 17592186068875 :knowledge-point/id #uuid "366b36a5-c909-5ea5-a05d-a6052fcd41d7" :knowledge-point/title "Completing the Square on a Quadratic Expression"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "129c0ce9-31d0-501f-9253-202530581425" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(x+5{)}^{2}+10" :db/id #edb/ref 17592186269432} {:answer/id #uuid "1e413b35-35e1-5ce6-a283-f4ff4b83d4f3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(x+10{)}^{2}-5" :db/id #edb/ref 17592186269522} {:answer/id #uuid "395d3e65-bf9a-53cf-a730-73e30942c7aa" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(x+5{)}^{2}-9" :db/id #edb/ref 17592186269789} {:answer/id #uuid "899c0f97-acdd-567e-ab3c-221326e9fa7a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(x+5{)}^{2}+12" :db/id #edb/ref 17592186270456} {:answer/id #uuid "d9c19f26-9f49-5230-b707-0daae3af6b9f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(x+5{)}^{2}-7" :db/id #edb/ref 17592186271177}] :answer-field/correct {:answer/id #uuid "395d3e65-bf9a-53cf-a730-73e30942c7aa" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(x+5{)}^{2}-9" :db/id #edb/ref 17592186269789} :answer-field/id #uuid "12b561ff-d7d5-56bf-bd70-881cdbd1aea3" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186271540}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "c7d3420b-3f28-5142-8868-756f1394ea88" :question/math-academy-id "q-141537" :question/problem "Complete the square on the quadratic expression ${x}^{2}+10x+16.$" :question/worked-solution "First, we rewrite the coefficient of the linear term as a product with $2$ as a factor:\n\n$$\n{x}^{2}+2\\cdot 5x+16\n$$\n\nNow, here's the trick. We *add* and *then subtract* ${5}^{2},$ writing the constant term $16$ last:\n\n$$\n{{x}^{2}+2\\cdot 5x+{5}^{2}}_{⏟}-\\,{5}^{2}+16\n$$\n\nThe first three terms form a perfect square, which we factor as follows:\n\n$$\n(x+5{)}^{2}-{5}^{2}+16\n$$\n\nFinally, evaluating the last two terms, we get\n\n$$\n(x+5{)}^{2}-9.\n$$"}] [{:db/id #edb/ref 17592186400930 :knowledge-point/_questions [{:db/id #edb/ref 17592186068875 :knowledge-point/id #uuid "366b36a5-c909-5ea5-a05d-a6052fcd41d7" :knowledge-point/title "Completing the Square on a Quadratic Expression"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c4bc4897-6558-52b5-bb24-657fa38a810c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "p=6,\\,q=8" :db/id #edb/ref 17592186400932} {:answer/id #uuid "62f6fb47-ecea-56a8-9070-83fc55e7254f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "p=3,\\,q=-5" :db/id #edb/ref 17592186400933} {:answer/id #uuid "3d43940b-e27a-5dff-9dca-bf6857baf92f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "p=3,\\,q=5" :db/id #edb/ref 17592186400934} {:answer/id #uuid "bdeaea36-9352-52ca-8483-6b276a77d472" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "p=6,\\,q=7" :db/id #edb/ref 17592186400935} {:answer/id #uuid "bfc66d56-1a8c-5626-b30a-e9774929570d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "p=3,\\,q=-4" :db/id #edb/ref 17592186400936}] :answer-field/correct {:answer/id #uuid "3d43940b-e27a-5dff-9dca-bf6857baf92f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "p=3,\\,q=5" :db/id #edb/ref 17592186400934} :answer-field/id #uuid "95bbc964-13ea-55a0-9065-a7c49f46fb65" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186400931}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "bd1c73ef-6818-5b51-baee-cca065c2f0da" :question/math-academy-id "q-141539" :question/problem "If the expression ${x}^{2}+6x+14$ is written as $(x+p{)}^{2}+q,$ then what are the values of $p$ and $q?$" :question/worked-solution "First, we rewrite the coefficient of the linear term as a product with $2$ as a factor:\n\n$$\n{x}^{2}+2\\cdot 3x+14\n$$\n\nNow, here's the trick. We *add* and *then subtract* ${3}^{2},$ writing the constant term $14$ last:\n\n$$\n{{x}^{2}+2\\cdot 3x+{3}^{2}}_{⏟}-\\,{3}^{2}+14\n$$\n\nThe first three terms form a perfect square, which we factor as follows:\n\n$$\n(x+3{)}^{2}-{3}^{2}+14\n$$\n\nFinally, evaluating the last two terms, we get\n\n$$\n(x+3{)}^{2}+5.\n$$\n\nTherefore, $p=3$ and $q=5.$"}] [{:db/id #edb/ref 17592186272300 :knowledge-point/_questions [{:db/id #edb/ref 17592186184170 :knowledge-point/id #uuid "1481d4a2-64b4-590a-9dbb-c39d3364bb59" :knowledge-point/title "Expressions Containing a Negative Linear Term"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2209d435-198d-515f-b8b4-60c9562f6bdd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{(x+\\frac{11}{2})}^{2}-\\frac{9}{2}" :db/id #edb/ref 17592186269560} {:answer/id #uuid "273798d5-f257-5699-8aa9-4f4c2f307f49" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{(x+\\frac{11}{2})}^{2}-\\frac{7}{2}" :db/id #edb/ref 17592186269613} {:answer/id #uuid "3692e43f-c9b5-5ffd-8fc6-a562924ff89c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{(x-\\frac{11}{2})}^{2}-\\frac{15}{4}" :db/id #edb/ref 17592186269764} {:answer/id #uuid "7a671224-3dde-5038-92af-e145da2474b4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{(x-\\frac{11}{2})}^{2}-\\frac{11}{4}" :db/id #edb/ref 17592186270352} {:answer/id #uuid "8e191cef-1fcc-5bb8-9ab2-aa4afff1bdaa" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{(x-\\frac{11}{2})}^{2}-\\frac{21}{4}" :db/id #edb/ref 17592186270499}] :answer-field/correct {:answer/id #uuid "8e191cef-1fcc-5bb8-9ab2-aa4afff1bdaa" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{(x-\\frac{11}{2})}^{2}-\\frac{21}{4}" :db/id #edb/ref 17592186270499} :answer-field/id #uuid "1f9eedf2-2e58-52db-8e06-a9079bb28565" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186271567}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "b33c0ce6-8797-5117-a675-fc9bb0069eae" :question/math-academy-id "q-141552" :question/problem "Complete the square on the quadratic expression ${x}^{2}-11x+25.$" :question/worked-solution "First, we rewrite the coefficient of the linear term as a product with $2$ as a factor:\n\n$$\n{x}^{2}-2\\cdot \\frac{11}{2}x+25\n$$\n\nNow, here's the trick. We *add* and *then subtract* ${(\\frac{11}{2})}^{2},$ writing the constant term $25$ last:\n\n$$\n{{x}^{2}-2\\cdot \\frac{11}{2}x+{(\\frac{11}{2})}^{2}}_{⏟}-{(\\frac{11}{2})}^{2}+25\n$$\n\nThe first three terms form a perfect square, which we factor as follows:\n\n$$\n{(x-\\frac{11}{2})}^{2}-{(\\frac{11}{2})}^{2}+25\n$$\n\nFinally, evaluating the last two terms, we get\n\n$$\n{(x-\\frac{11}{2})}^{2}-\\frac{21}{4}.\n$$"}] [{:db/id #edb/ref 17592186272304 :knowledge-point/_questions [{:db/id #edb/ref 17592186068876 :knowledge-point/id #uuid "08c6d8d6-3d86-5074-bf99-0cb744c9412a" :knowledge-point/title "Completing the Square on a Quadratic Expression with a Negative Linear Term"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4b8b2afd-fb57-5e61-8b75-209b9cfb00a6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(y-4{)}^{2}+1" :db/id #edb/ref 17592186269948} {:answer/id #uuid "56189019-79f9-5478-aff6-fce083001fda" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(y-2{)}^{2}-4" :db/id #edb/ref 17592186270032} {:answer/id #uuid "5b5b5397-8f7e-5320-893a-7dfa34d502d5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(y-2{)}^{2}+3" :db/id #edb/ref 17592186270081} {:answer/id #uuid "b8a21ffd-56c6-5136-bf66-bc5dc8d6441d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(y-2{)}^{2}+6" :db/id #edb/ref 17592186270901} {:answer/id #uuid "e1c6894a-0f18-540f-812c-d0d96b4ec938" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(y-4{)}^{2}+5" :db/id #edb/ref 17592186271252}] :answer-field/correct {:answer/id #uuid "b8a21ffd-56c6-5136-bf66-bc5dc8d6441d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(y-2{)}^{2}+6" :db/id #edb/ref 17592186270901} :answer-field/id #uuid "072e8659-a896-55fe-8d54-28d07c46a912" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186271518}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "7c43e9bd-a43d-5cc8-ba55-c5e66008e58c" :question/math-academy-id "q-141612" :question/problem "Complete the square on the quadratic expression ${y}^{2}-4y+10.$" :question/worked-solution "First, we rewrite the coefficient of the linear term as a product with $2$ as a factor:\n\n$$\n{y}^{2}-2\\cdot 2y+10\n$$\n\nNow, here's the trick. We *add* and *then subtract* ${2}^{2},$ writing the constant term $10$ last:\n\n$$\n{{y}^{2}-2\\cdot 2y+{2}^{2}}_{⏟}-\\,{2}^{2}+10\n$$\n\nThe first three terms form a perfect square, which we factor as follows:\n\n$$\n(y-2{)}^{2}-{2}^{2}+10\n$$\n\nFinally, evaluating the last two terms, we get\n\n$$\n(y-2{)}^{2}+6.\n$$"}] [{:db/id #edb/ref 17592186400937 :knowledge-point/_questions [{:db/id #edb/ref 17592186068876 :knowledge-point/id #uuid "08c6d8d6-3d86-5074-bf99-0cb744c9412a" :knowledge-point/title "Completing the Square on a Quadratic Expression with a Negative Linear Term"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7d53fe67-7a37-5135-9bda-59dc26da7eba" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "p=-5,\\text{ }q=10" :db/id #edb/ref 17592186400939} {:answer/id #uuid "9b5c7488-0854-5209-9e72-78867a6a1be6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "p=5,\\text{ }q=5" :db/id #edb/ref 17592186400940} {:answer/id #uuid "a2ec775e-a603-50a4-a821-b02cc8bdf4a2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "p=-10,\\text{ }q=5" :db/id #edb/ref 17592186400941} {:answer/id #uuid "91f01cc1-7dda-5a0a-a09b-a1edcdb5224f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "p=-5,\\text{ }q=5" :db/id #edb/ref 17592186400942} {:answer/id #uuid "c0e81c67-49e3-5deb-9f3d-4bfdd5f4f433" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "p=5,\\text{ }q=-5" :db/id #edb/ref 17592186400943}] :answer-field/correct {:answer/id #uuid "91f01cc1-7dda-5a0a-a09b-a1edcdb5224f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "p=-5,\\text{ }q=5" :db/id #edb/ref 17592186400942} :answer-field/id #uuid "c559c184-d951-52c2-ae9b-1fd6b5cd4853" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186400938}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "a81398bc-73ed-504a-b8b3-ef512650d7f6" :question/math-academy-id "q-141622" :question/problem "If the expression ${y}^{2}-10y+30$ is written as $(y+p{)}^{2}+q,$ then what are the values of $p$ and $q?$" :question/worked-solution "First, we rewrite the coefficient of the linear term as a product with $2$ as a factor:\n\n$$\n{y}^{2}-2\\cdot 5y+30\n$$\n\nNow, here's the trick. We *add* and *then subtract* ${5}^{2},$ writing the constant term $30$ last:\n\n$$\n{{y}^{2}-2\\cdot 5y+{5}^{2}}_{⏟}-\\,{5}^{2}+30\n$$\n\nThe first three terms form a perfect square, which we factor as follows:\n\n$$\n(y-5{)}^{2}-{5}^{2}+30\n$$\n\nFinally, evaluating the last two terms, we get\n\n$$\n(y-5{)}^{2}+5.\n$$\n\nTherefore, $p=-5$ and $q=5.$"}] [{:db/id #edb/ref 17592186388841 :knowledge-point/_questions [{:db/id #edb/ref 17592186184232 :knowledge-point/id #uuid "c872e855-895e-5369-8a79-cbdf21133548" :knowledge-point/title "Solving a Quadratic Equation Given a Corresponding Perfect Square"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5c9dab48-f4ec-50d5-997f-66003dcb0d90" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=-\\frac{1}{2},\\,\\frac{3}{2}" :db/id #edb/ref 17592186388843} {:answer/id #uuid "78463560-21e0-5b25-866c-e90cd7340bbc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=-3\\pm \\frac{1}{\\sqrt{2}}" :db/id #edb/ref 17592186388844} {:answer/id #uuid "b9db4f34-08d3-52b7-b130-1953818d1cdb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=-\\frac{11}{2},\\,\\frac{3}{2}" :db/id #edb/ref 17592186388845} {:answer/id #uuid "ef8898ba-df5f-5bff-a12b-8e45e358e308" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=-\\frac{11}{2},\\,-\\frac{1}{2}" :db/id #edb/ref 17592186388846} {:answer/id #uuid "cdcc5cac-e58c-525f-92e0-44013ae6b5ae" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=-3\\pm \\frac{5}{\\sqrt{2}}" :db/id #edb/ref 17592186388847}] :answer-field/correct {:answer/id #uuid "ef8898ba-df5f-5bff-a12b-8e45e358e308" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=-\\frac{11}{2},\\,-\\frac{1}{2}" :db/id #edb/ref 17592186388846} :answer-field/id #uuid "32deee12-64c9-53b5-a191-c9595d854af8" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186388842}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "6cd3a3fd-0ec4-5982-bdba-cd236ee44004" :question/math-academy-id "q-141811" :question/problem "Solve the equation $4{x}^{2}+24x=-11.$ \n\n*Hint: Use the fact that ${x}^{2}+6x+9$ is a perfect square.*" :question/worked-solution "Using the hint, we have\n\n$$\n{x}^{2}+6x+9=(x+3)^{2}.\n$$\n\nFirst, we complete the square on the left-hand side:\n\n$$\n\\begin{aligned}4{x}^{2}+24x & =-11 \\\\ 4({x}^{2}+6x) & =-11 \\\\ 4({x}^{2}+2\\cdot 3x) & =-11 \\\\ 4({x}^{2}+2\\cdot 3x+{3}^{2}-{3}^{2}) & =-11 \\\\ 4[(x+3)^{2}-{3}^{2}] & =-11 \\\\ 4[(x+3)^{2}-9] & =-11 \\\\ 4(x+3)^{2}-36 & =-11\\end{aligned}\n$$\n\nIsolating the perfect square by adding $36$ to both sides and then dividing by $4,$ we get\n\n$$\n\\begin{aligned}4(x+3)^{2}-36 & =-11 \\\\ 4(x+3)^{2}-36+36 & =-11+36 \\\\ 4(x+3)^{2} & =25 \\\\ (x+3)^{2} & =\\frac{25}{4}.\\end{aligned}\n$$\n\nWe now solve the equation using the square root method:\n\n$$\n\\begin{aligned}(x+3)^{2} & =\\frac{25}{4} \\\\ \\sqrt{(x+3)^{2}} & =\\sqrt{\\frac{25}{4}} \\\\ |x+3| & =\\frac{5}{2} \\\\ x+3 & =\\pm \\frac{5}{2} \\\\ x & =-3\\pm \\frac{5}{2} \\\\ x & =-\\frac{11}{2},\\,-\\frac{1}{2}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186272309 :knowledge-point/_questions [{:db/id #edb/ref 17592186068827 :knowledge-point/id #uuid "c3e24f9c-d383-5b77-a22a-8e142a072f0a" :knowledge-point/title "Solving a Quadratic Equation Given a Corresponding Perfect Square"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "33162c16-a26a-585b-b93a-caff202d8543" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "80" :db/id #edb/ref 17592186269736} {:answer/id #uuid "472c723c-83ab-5626-ad0b-8949bf5249de" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "90" :db/id #edb/ref 17592186269915} {:answer/id #uuid "929563b1-603a-55ce-b34f-10a3c1c67754" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "104" :db/id #edb/ref 17592186270550} {:answer/id #uuid "dbafdf59-1e66-5dce-9f48-65bc473487a2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "100" :db/id #edb/ref 17592186271191} {:answer/id #uuid "f1de299d-a3c5-5ebc-80da-bb0051f2d8ec" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "109" :db/id #edb/ref 17592186271392}] :answer-field/correct {:answer/id #uuid "929563b1-603a-55ce-b34f-10a3c1c67754" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "104" :db/id #edb/ref 17592186270550} :answer-field/id #uuid "16c6ad9b-646e-5a06-a5b2-bcae2f52ebb1" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186271547}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "f0de10d9-8ebd-58e0-b040-9c2f5e59c9c7" :question/math-academy-id "q-141812" :question/problem "Let ${x}_{1}$ and ${x}_{2}$ be the solutions of the equation ${x}^{2}-8x=20.$ Find the value ${x}_{1}^{2}+{x}_{2}^{2}.$ \n\n*Hint: Use the fact that ${x}^{2}-8x+16$ is a perfect square.*" :question/worked-solution "Using the hint, we have\n\n$$\n{x}^{2}-8x+16=(x-4{)}^{2}.\n$$\n\nFirst, we complete the square on the left-hand side:\n\n$$\n\\begin{aligned}{x}^{2}-8x & =20 \\\\ {x}^{2}-2\\cdot 4\\cdot x & =20 \\\\ {x}^{2}-2\\cdot 4\\cdot x+{4}^{2}-{4}^{2} & =20 \\\\ (x-4{)}^{2}-16 & =20\\end{aligned}\n$$\n\nNext, we isolate the perfect square by adding $16$ to both sides:\n\n$$\n\\begin{aligned}(x-4{)}^{2}-16+16 & =20+16 \\\\ (x-4{)}^{2} & =36\\end{aligned}\n$$\n\nWe now solve the equation using the square root method:\n\n$$\n\\begin{aligned}(x-4{)}^{2} & =36 \\\\ \\sqrt{(x-4{)}^{2}} & =\\sqrt{36} \\\\ |x-4| & =6 \\\\ x-4 & =\\pm 6 \\\\ x & =4\\pm 6\\end{aligned}\n$$\n\nFinally, we simplify the two solutions:\n\n$$\n\\begin{aligned}{x}_{1} & =4-6=-2 \\\\ {x}_{2} & =4+6=10\\end{aligned}\n$$\n\nTherefore, \n\n$$\n{x}_{1}^{2}+{x}_{2}^{2}=(-2{)}^{2}+{10}^{2}=104.\n$$"}] [{:db/id #edb/ref 17592186272310 :knowledge-point/_questions [{:db/id #edb/ref 17592186184232 :knowledge-point/id #uuid "c872e855-895e-5369-8a79-cbdf21133548" :knowledge-point/title "Solving a Quadratic Equation Given a Corresponding Perfect Square"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "241b1404-c2aa-575d-8065-ec106981f5a3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=-4\\pm \\frac{\\sqrt{2}}{5}" :db/id #edb/ref 17592186269585} {:answer/id #uuid "7919a728-b543-536d-8054-0a184713c2b0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=2\\pm \\frac{\\sqrt{5}}{2}" :db/id #edb/ref 17592186270341} {:answer/id #uuid "c82102a0-f740-5514-9212-0b3cd8c1d0c6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=4\\pm \\frac{2}{\\sqrt{5}}" :db/id #edb/ref 17592186271031} {:answer/id #uuid "e3105ac8-37d5-5739-abc9-4ef7c2fc18d5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=4\\pm \\frac{5}{\\sqrt{2}}" :db/id #edb/ref 17592186271267} {:answer/id #uuid "f25bf37e-9c95-5124-b37f-32e6744d69d1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=2\\pm \\frac{2}{\\sqrt{5}}" :db/id #edb/ref 17592186271399}] :answer-field/correct {:answer/id #uuid "c82102a0-f740-5514-9212-0b3cd8c1d0c6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=4\\pm \\frac{2}{\\sqrt{5}}" :db/id #edb/ref 17592186271031} :answer-field/id #uuid "fbe18474-5ded-5269-8f07-0ba5488b85e6" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186271944}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "7c3581b3-19ec-58f3-879c-94addceac5e6" :question/math-academy-id "q-141817" :question/problem "Solve the equation $5{y}^{2}-40y=-76.$ \n\n*Hint: Use the fact that ${y}^{2}-8y+16$ is a perfect square.*" :question/worked-solution "Using the hint, we have\n\n$$\n{y}^{2}-8y+16=(y-4)^{2}.\n$$\n\nFirst, we complete the square on the left-hand side:\n\n$$\n\\begin{aligned}5{y}^{2}-40y & =-76 \\\\ 5({y}^{2}-8y) & =-76 \\\\ 5({y}^{2}-2\\cdot 4y) & =-76 \\\\ 5({y}^{2}-2\\cdot 4y+{4}^{2}-{4}^{2}) & =-76 \\\\ 5[(y-4)^{2}-{4}^{2}] & =-76 \\\\ 5[(y-4)^{2}-16] & =-76 \\\\ 5(y-4)^{2}-80 & =-76\\end{aligned}\n$$\n\nIsolating the perfect square by adding $80$ to both sides and then dividing by $5,$ we get\n\n$$\n\\begin{aligned}5(y-4)^{2}-80 & =-76 \\\\ 5(y-4)^{2}-80+80 & =-76+80 \\\\ 5(y-4)^{2} & =4 \\\\ (y-4)^{2} & =\\frac{4}{5}.\\end{aligned}\n$$\n\nWe now solve the equation using the square root method:\n\n$$\n\\begin{aligned}(y-4)^{2} & =\\frac{4}{5} \\\\ \\sqrt{(y-4)^{2}} & =\\sqrt{\\frac{4}{5}} \\\\ |y-4| & =\\frac{2}{\\sqrt{5}} \\\\ y-4 & =\\pm \\frac{2}{\\sqrt{5}} \\\\ y & =4\\pm \\frac{2}{\\sqrt{5}}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186272314 :knowledge-point/_questions [{:db/id #edb/ref 17592186096707 :knowledge-point/id #uuid "ddc6c4b1-b4c4-52f8-9f25-feda3130e358" :knowledge-point/title "Calculating the Intercepts of a Parabola Given Its Equation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "05c261f4-b523-5e38-b911-79bebe41075e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(21,0)" :db/id #edb/ref 17592186269321} {:answer/id #uuid "b0e7353a-2dd4-5608-ac70-fe6d8e0291e6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(0,21)" :db/id #edb/ref 17592186270848} {:answer/id #uuid "bbe132bb-0af0-51c8-afe2-8c3302082c29" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-21,0)" :db/id #edb/ref 17592186270925} {:answer/id #uuid "bc901ce9-1a00-525b-a2cd-700e1bd17ebd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-12,0)" :db/id #edb/ref 17592186270928} {:answer/id #uuid "c301dd7e-cbc1-5a8b-80c7-f2bfe83da7ba" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(12,0)" :db/id #edb/ref 17592186270994}] :answer-field/correct {:answer/id #uuid "05c261f4-b523-5e38-b911-79bebe41075e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(21,0)" :db/id #edb/ref 17592186269321} :answer-field/id #uuid "7e2b396b-77e2-5134-94df-60067b3ce9c0" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186271732}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "08773f73-4575-52a7-9948-7d0d1e95d791" :question/math-academy-id "q-14185" :question/problem "Find the point of intersection of the parabola ${y}^{2}-x+10y+21=0$ with the $x$-axis." :question/worked-solution "When the parabola intersects the $x$-axis, we must have $y=0.$ So, we set $y=0$ and solve the resulting equation for $x:$\n\n$$\n\\begin{aligned}{y}^{2}-x+10y+21 & =0 \\\\ (0)^{2}-x+10(0)+21 & =0 \\\\ -x+21 & =0 \\\\ x & =21\\end{aligned}\n$$\n\nTherefore, the parabola intersects the $x$-axis at $(21,0).$"}] [{:db/id #edb/ref 17592186398466 :knowledge-point/_questions [{:db/id #edb/ref 17592186184148 :knowledge-point/id #uuid "dac9c72b-c23f-56fa-b939-6e3b56d3a13b" :knowledge-point/title "Identifying the Horizontal Stretch and Vertical Shift of a Transformed Cotangent Curve"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "accd213e-a18c-57f9-a2cf-0e3297615ffe" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186398468} {:answer/id #uuid "bd8269e6-822d-57d9-a7d5-81b77feea90f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186398469} {:answer/id #uuid "b6d90684-6641-5156-b37c-32b02b1bdd9f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186398470} {:answer/id #uuid "21d7fa3c-5da8-50fa-8d80-231c8289856a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186398471} {:answer/id #uuid "70cad25b-cabf-5869-8148-7ca6a521ce0d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186398472}] :answer-field/correct {:answer/id #uuid "bd8269e6-822d-57d9-a7d5-81b77feea90f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186398469} :answer-field/id #uuid "412e6109-4d77-5424-95b6-1257add5ac9c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186398467}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "b85652aa-105e-56e5-bee4-742b27b9d838" :question/math-academy-id "q-141999" :question/problem "![](images/8b/8b237f9e857b1ed87de447aa79c14d359429e71d8afe7ab8eab201eba7ffb6af.png)\n\nThe graph above shows the function $y=\\operatorname{cot}⁡(Bx)+D,$ where $B$ and $D$ are constants. What is  $B+2D?$" :question/worked-solution "The period $T$ of the function is $\\frac{\\pi }{2}.$\n\nThe formula for the period $T$ of the function $y=A\\operatorname{cot}⁡(Bx+C)+D$ is given by \n\n$$\nT=\\frac{\\pi }{B}.\n$$\n\nApplying the formula of the period, we get\n\n$$\n\\frac{\\pi }{2}=\\frac{\\pi }{B}\\,⟹\\,B=\\frac{\\pi }{(\\frac{\\pi }{2})}=2.\n$$\n\nThe parameter $D$ represents the vertical shift of the cotangent function. We see that the function has been translated by $1$ unit up. Therefore, $D=1.$\n\nTherefore, $B+2D=2+2\\cdot (1)=2+2=4.$  \n\nFinally, the equation of the curve is\n\n$$\ny=\\operatorname{cot}⁡(2x)+1.\n$$"}] [{:db/id #edb/ref 17592186272321 :knowledge-point/_questions [{:db/id #edb/ref 17592186068827 :knowledge-point/id #uuid "c3e24f9c-d383-5b77-a22a-8e142a072f0a" :knowledge-point/title "Solving a Quadratic Equation Given a Corresponding Perfect Square"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "08658d01-89d0-5f4d-8f01-ca95f49a8f8e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "68" :db/id #edb/ref 17592186269345} {:answer/id #uuid "91635a34-3072-5810-bbe9-632fc13648c7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "58" :db/id #edb/ref 17592186270534} {:answer/id #uuid "b63daf1b-11dc-55f7-bcdf-962180261257" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "52" :db/id #edb/ref 17592186270887} {:answer/id #uuid "c16cb9a6-c3c8-5125-ae28-f529c2244338" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "40" :db/id #edb/ref 17592186270983} {:answer/id #uuid "f5121dc9-a221-5173-bccc-27c79eacbf3a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "50" :db/id #edb/ref 17592186271416}] :answer-field/correct {:answer/id #uuid "91635a34-3072-5810-bbe9-632fc13648c7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "58" :db/id #edb/ref 17592186270534} :answer-field/id #uuid "3f3ef694-6ed8-54b6-8d68-ea9692dda819" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186271625}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "36afe386-dcce-5814-bb16-64bd8f39ae6b" :question/math-academy-id "q-142015" :question/problem "Let ${x}_{1}$ and ${x}_{2}$ be the solutions of the equation ${x}^{2}-10x=-21.$ Find the value ${x}_{1}^{2}+{x}_{2}^{2}.$ \n\n*Hint: Use the fact that ${x}^{2}-10x+25$ is a perfect square.*" :question/worked-solution "Using the hint, we have\n\n$$\n{x}^{2}-10x+25=(x-5{)}^{2}.\n$$\n\nFirst, we complete the square on the left-hand side:\n\n$$\n\\begin{aligned}{x}^{2}-10x & =-21 \\\\ {x}^{2}-2\\cdot 5\\cdot x & =-21 \\\\ {x}^{2}-2\\cdot 5\\cdot x+{5}^{2}-{5}^{2} & =-21 \\\\ (x-5{)}^{2}-25 & =-21\\end{aligned}\n$$\n\nNext, we isolate the perfect square by adding $25$ to both sides: \n\n$$\n\\begin{aligned}(x-5{)}^{2}-25+25 & =-21+25 \\\\ (x-5{)}^{2} & =4\\end{aligned}\n$$\n\nWe now solve the equation using the square root method:\n\n$$\n\\begin{aligned}(x-5{)}^{2} & =4 \\\\ \\sqrt{(x-5{)}^{2}} & =\\sqrt{4} \\\\ |x-5| & =2 \\\\ x-5 & =\\pm 2 \\\\ x & =5\\pm 2\\end{aligned}\n$$\n\nFinally, we simplify the two solutions:\n\n$$\n\\begin{aligned}{x}_{1} & =5-2=3 \\\\ {x}_{2} & =5+2=7\\end{aligned}\n$$\n\nTherefore, \n\n$$\n{x}_{1}^{2}+{x}_{2}^{2}={3}^{2}+{7}^{2}=58.\n$$"}] [{:db/id #edb/ref 17592186272323 :knowledge-point/_questions [{:db/id #edb/ref 17592186059820 :knowledge-point/id #uuid "4b12a7b7-1df3-5203-934e-8820604de3de" :knowledge-point/title "Simplifying Expressions in Radians Using the Sum and Difference Formulas"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "06722ca7-474e-5595-bf36-153b1775fd3c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{2}(\\operatorname{sin}⁡x+\\operatorname{cos}⁡x)}{2}" :db/id #edb/ref 17592186269327} {:answer/id #uuid "1f9a8511-de08-55eb-a39b-8c1d7fb3526d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{cos}⁡x" :db/id #edb/ref 17592186269532} {:answer/id #uuid "35238dad-241f-56ad-8d8f-e9b4f0502e53" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\operatorname{sin}⁡x-\\sqrt{3}\\operatorname{cos}⁡x}{2}" :db/id #edb/ref 17592186269755} {:answer/id #uuid "e79b8881-98bb-524f-b8e6-1f50afbbbdee" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{3}\\operatorname{sin}⁡x+\\operatorname{cos}⁡x}{2}" :db/id #edb/ref 17592186271294} {:answer/id #uuid "eb7b137e-47ec-5070-a46e-9c1151db82e8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{-\\sqrt{3}\\operatorname{sin}⁡x-\\operatorname{cos}⁡x}{2}" :db/id #edb/ref 17592186271335}] :answer-field/correct {:answer/id #uuid "eb7b137e-47ec-5070-a46e-9c1151db82e8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{-\\sqrt{3}\\operatorname{sin}⁡x-\\operatorname{cos}⁡x}{2}" :db/id #edb/ref 17592186271335} :answer-field/id #uuid "c897889a-b632-5109-a8b5-b76c95145861" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186271878}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "81ad9fc7-9d0e-5199-bbb4-6a03531ef9d2" :question/math-academy-id "q-142026" :question/problem "$\\operatorname{sin}⁡(x+\\frac{7\\pi }{6})=$" :question/worked-solution "Recall the sum formula for sine:\n\n$$\n\\operatorname{sin}⁡(u+v)=\\operatorname{sin}⁡u\\operatorname{cos}⁡v+\\operatorname{cos}⁡u\\operatorname{sin}⁡v\n$$\n\nApplying the sum formula for sine with $u=x$ and $v=\\frac{7\\pi }{6},$ we get \n\n$$\n\\begin{aligned}\\operatorname{sin}⁡(x+\\frac{7\\pi }{6}) & =\\operatorname{sin}⁡x\\operatorname{cos}⁡(\\frac{7\\pi }{6})+\\operatorname{cos}⁡x\\operatorname{sin}⁡(\\frac{7\\pi }{6}) \\\\  & =\\operatorname{sin}⁡x\\cdot (\\frac{-\\sqrt{3}}{2})+\\operatorname{cos}⁡x\\cdot (\\frac{-1}{2}) \\\\  & =\\frac{-\\sqrt{3}\\operatorname{sin}⁡x-\\operatorname{cos}⁡x}{2}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186272331 :knowledge-point/_questions [{:db/id #edb/ref 17592186059821 :knowledge-point/id #uuid "c6a58962-cb06-519a-8c64-0dfa3b9c14d7" :knowledge-point/title "Simplifying Expressions in Degrees Using the Sum and Difference Formulas"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "090d142f-f7f9-5a7b-b72e-52a078df1eaf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{2}(\\sqrt{3}\\operatorname{sin}⁡x+\\operatorname{cos}⁡x)" :db/id #edb/ref 17592186269350} {:answer/id #uuid "1d201ccd-85fb-549a-9e9c-531394fc50aa" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}(\\sqrt{3}\\operatorname{cos}⁡x+\\operatorname{sin}⁡x)" :db/id #edb/ref 17592186269507} {:answer/id #uuid "76ee6731-902a-5dee-b46b-c4380fed56c0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{2}(\\sqrt{3}\\operatorname{cos}⁡x+\\operatorname{sin}⁡x)" :db/id #edb/ref 17592186270319} {:answer/id #uuid "b75c049c-a748-56a4-b205-01a20869b559" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}(\\sqrt{3}\\operatorname{sin}⁡x+\\operatorname{cos}⁡x)" :db/id #edb/ref 17592186270893} {:answer/id #uuid "c3f5c1f2-a0ab-5100-8db9-3071ee8511c6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}(\\sqrt{3}\\operatorname{sin}⁡x-\\operatorname{cos}⁡x)" :db/id #edb/ref 17592186271000}] :answer-field/correct {:answer/id #uuid "76ee6731-902a-5dee-b46b-c4380fed56c0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{2}(\\sqrt{3}\\operatorname{cos}⁡x+\\operatorname{sin}⁡x)" :db/id #edb/ref 17592186270319} :answer-field/id #uuid "a8980b78-b788-5d75-b585-9a0b63595d13" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186271815}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "a1de0aea-4bea-5c0c-94bb-b2903c951763" :question/math-academy-id "q-142142" :question/problem "$\\operatorname{cos}⁡(x-{210}^{∘})=$" :question/worked-solution "First, we recall the difference formula for cosine:\n\n$$\n\\operatorname{cos}⁡(u-v)=\\operatorname{cos}⁡u\\operatorname{cos}⁡v+\\operatorname{sin}⁡u\\operatorname{sin}⁡v\n$$\n\nApplying the difference formula for cosine with $u=x$ and $v={210}^{∘},$ we get\n\n$$\n\\begin{aligned}\\operatorname{cos}⁡(x-{210}^{∘}) & =\\operatorname{cos}⁡x\\operatorname{cos}⁡{210}^{∘}+\\operatorname{sin}⁡x\\operatorname{sin}⁡{210}^{∘} \\\\  & =\\operatorname{cos}⁡x\\cdot (-\\frac{\\sqrt{3}}{2})+\\operatorname{sin}⁡x\\cdot (-\\frac{1}{2}) \\\\  & =-\\frac{1}{2}(\\sqrt{3}\\operatorname{cos}⁡x+\\operatorname{sin}⁡x).\\end{aligned}\n$$"}]}
