#{[{:db/id #edb/ref 17592186393264 :knowledge-point/_questions [{:db/id #edb/ref 17592186096633 :knowledge-point/id #uuid "29b136d3-69bc-51ef-a262-dbee8af377d2" :knowledge-point/title "Expressing a Definite Integral as the Limit of a Right Riemann Sum"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "516433a3-ddcf-5286-911f-d1661221641b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{lim}_{n\\to \\infty }{\\sum }_{k=1}^{n}[-2{(\\frac{5k}{n})}^{-2}\\cdot \\frac{5}{n}]" :db/id #edb/ref 17592186393266} {:answer/id #uuid "91a60e1f-ff52-5d12-8845-6de6b6f23736" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{lim}_{n\\to \\infty }{\\sum }_{k=1}^{n}[-2{(-2+\\frac{5k}{n})}^{3}\\cdot \\frac{5}{n}]" :db/id #edb/ref 17592186393267} {:answer/id #uuid "6006a006-5f33-5ef4-b609-573993a53f00" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{lim}_{n\\to \\infty }{\\sum }_{k=1}^{n}[-2{(2+\\frac{k}{n})}^{3}\\cdot \\frac{1}{n}]" :db/id #edb/ref 17592186393268} {:answer/id #uuid "8ff05667-12f6-5f44-9206-bc6cf51be751" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{lim}_{n\\to \\infty }{\\sum }_{k=1}^{n}[-{(-1+\\frac{5k}{n})}^{3}\\cdot \\frac{5}{n}]" :db/id #edb/ref 17592186393269} {:answer/id #uuid "af9dfa31-4950-5539-b718-f5c060dd0d43" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{lim}_{n\\to \\infty }{\\sum }_{k=1}^{n}[-2(5+\\frac{2k}{n})\\cdot \\frac{2}{n}]" :db/id #edb/ref 17592186393270}] :answer-field/correct {:answer/id #uuid "91a60e1f-ff52-5d12-8845-6de6b6f23736" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{lim}_{n\\to \\infty }{\\sum }_{k=1}^{n}[-2{(-2+\\frac{5k}{n})}^{3}\\cdot \\frac{5}{n}]" :db/id #edb/ref 17592186393267} :answer-field/id #uuid "97365ecd-a18f-5653-861f-4053aa6db95b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186393265}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "f5568099-5914-5fb0-903c-d4010e585001" :question/math-academy-id "q-73180" :question/problem "What is ${\\int }_{-2}^{3}-2{x}^{3}\\text{d}x$ expressed as the limit of a right Riemann sum?" :question/worked-solution "The definite integral can be defined in terms of the limit of a right Riemann sum as\n\n$$\n{\\int }_{a}^{b}f(x)\\,\\text{d}x={lim}_{n\\to \\infty }{\\sum }_{k=1}^{n}f({x}_{k})\\cdot Δx,\n$$\n\nwhere ${x}_{k}=a+kΔx$ and $Δx=\\frac{b-a}{n}.$\n\nIn the definite integral\n\n$$\n{\\int }_{-2}^{3}-2{x}^{3}\\text{d}x,\n$$\n\nthe function is $f(x)=-2{x}^{3},$ the lower bound is $a=-2$ and the upper bound is $b=3.$ So, we have\n\n$$\nΔx=\\frac{3-(-2)}{n}=\\frac{5}{n}.\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}{\\int }_{-2}^{3}-2{x}^{3}\\text{d}x & ={lim}_{n\\to \\infty }{\\sum }_{k=1}^{n}f({x}_{k})\\cdot Δx \\\\  & ={lim}_{n\\to \\infty }{\\sum }_{k=1}^{n}[f(-2+k\\cdot \\frac{5}{n})\\cdot \\frac{5}{n}] \\\\  & ={lim}_{n\\to \\infty }{\\sum }_{k=1}^{n}[f(-2+\\frac{5k}{n})\\cdot \\frac{5}{n}] \\\\  & ={lim}_{n\\to \\infty }{\\sum }_{k=1}^{n}[-2{(-2+\\frac{5k}{n})}^{3}\\cdot \\frac{5}{n}].\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186342181 :knowledge-point/_questions [{:db/id #edb/ref 17592186073810 :knowledge-point/id #uuid "522b66f4-8a46-5dd0-a9d7-3b081c0ed157" :knowledge-point/title "Finding the Distance Between a Point and a Horizontal or Vertical Line"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "59078a96-a4c1-5355-9bdf-3b0f39c93291" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186339938} {:answer/id #uuid "836328cc-8806-5c45-bf00-1c3923682d40" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186340310} {:answer/id #uuid "9909d2b8-e7fa-56b5-9269-e5951dc53bcf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186340509} {:answer/id #uuid "a86ba75a-1b29-5797-9053-bf2a3ad7aa27" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "7" :db/id #edb/ref 17592186340658} {:answer/id #uuid "b0de169a-6a53-5b29-85e4-09cc91632445" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186340736}] :answer-field/correct {:answer/id #uuid "59078a96-a4c1-5355-9bdf-3b0f39c93291" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186339938} :answer-field/id #uuid "cab68815-1850-5693-b986-be3ac48add05" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186341736}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "79f2f5ac-44c5-5b82-9c80-2524e0bd699c" :question/math-academy-id "q-74202" :question/problem "Find the shortest distance between the point $(-1,-4)$ and the line $x=4.$" :question/worked-solution "Let's sketch the given situation.\n\n![](images/d4/d46a6ed76af5c226e327ba197fe019df0d9085e095ca4781898aba54268a1706.png)\n\nSince the line $x=4$ is a vertical line, the shortest distance between this line and the point $(-1,-4)$ is given by the absolute value of the difference between $x$-coordinate of the point and $4.$ \n\nSo, the shortest distance is\n\n$$\nd=|-1-4|=5.\n$$"}] [{:db/id #edb/ref 17592186342208 :knowledge-point/_questions [{:db/id #edb/ref 17592186073811 :knowledge-point/id #uuid "d7030a12-bd18-5f8b-84eb-28b6f216f972" :knowledge-point/title "Finding the Distance Between a Point and a Line"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4b6fecf3-af6d-570c-a4e0-5bd2f8943b6b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "9\\sqrt{2}" :db/id #edb/ref 17592186339805} {:answer/id #uuid "86531e02-9d87-59a8-99d4-328fa2c86fbb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3\\sqrt{2}" :db/id #edb/ref 17592186340333} {:answer/id #uuid "d5e737ba-76b9-5760-80fc-271f650d20e2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186341023} {:answer/id #uuid "e47935d1-86c8-5a85-a24b-c428d0150116" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "9" :db/id #edb/ref 17592186341149} {:answer/id #uuid "e58979f5-86fa-57ab-b8b7-766696bc055b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3\\sqrt{3}" :db/id #edb/ref 17592186341156}] :answer-field/correct {:answer/id #uuid "86531e02-9d87-59a8-99d4-328fa2c86fbb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3\\sqrt{2}" :db/id #edb/ref 17592186340333} :answer-field/id #uuid "6f8851fb-c592-5f14-9bf4-a48b2c458a74" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186341574}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "f0e530ca-0510-53a9-a606-7cbe24765900" :question/math-academy-id "q-74417" :question/problem "Find the shortest distance between the point $(-1,-3)$ and the line $y=-x+2.$" :question/worked-solution "Let's draw a diagram describing our situation.\n\n![](images/eb/eb1176b4a5e2565fceb03e9af652a6ae875f5ee678c103405045fcebc36342e1.png)\n\nFirst, we find the equation of the line that's perpendicular to $y=-x+2$ and passes through the point $(-1,-3).$\n\n The given line has a slope of $-1,$ so our perpendicular line must have a slope of $1.$\n\nUsing point-slope form and simplifying, we obtain the equation of the perpendicular line:\n\n$$\n\\begin{aligned}y-{y}_{1} & =m(x-{x}_{1}) \\\\ y+3 & =1(x+1) \\\\ y+3 & =x+1 \\\\ y & =x-2\\end{aligned}\n$$\n\nWe now find the point where the two lines intersect. To do this, we solve the following system of equations:\n\n$$\n{\\begin{aligned}y=-x+2 \\\\ y=x-2\\end{aligned}\n$$\n\nWe can solve this system by putting the two equations equal to one another and solving for $x.$ This gives\n\n$$\n\\begin{aligned}-x+2 & =x-2 \\\\ -x-x & =-2-2 \\\\ -2x & =-4 \\\\ x & =2.\\end{aligned}\n$$\n\nSubstituting $x=2$ into either of the two equations gives $y=0.$ So, our solution is $x=2$ and $y=0.$ Therefore, the lines intersect at the point $(2,0).$\n\nFinally, we find the distance $d$ between the points $(-1,-3)$ and $(2,0):$\n\n$$\n\\begin{aligned}d & =\\sqrt{({x}_{2}-{x}_{1})^{2}+({y}_{2}-{y}_{1})^{2}} \\\\  & =\\sqrt{(2-(-1))^{2}+(0-(-3))^{2}} \\\\  & =\\sqrt{9+9} \\\\  & =\\sqrt{18} \\\\  & =3\\sqrt{2}\\end{aligned}\n$$\n\nTherefore, we conclude that the shortest distance between the point $(-1,-3)$ and the line $y=-x+2$ is $3\\sqrt{2}.$"}] [{:db/id #edb/ref 17592186342212 :knowledge-point/_questions [{:db/id #edb/ref 17592186073815 :knowledge-point/id #uuid "59d3a391-c163-5a04-944c-5d61a3950e03" :knowledge-point/title "Finding a Point on a Line That Is Closest to a Given Point"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "47f7ce0c-16e5-531a-94b9-547622df3f25" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-2,-2)" :db/id #edb/ref 17592186339767} {:answer/id #uuid "569cbb0a-f99c-5355-8f53-bdc678082993" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-4,0)" :db/id #edb/ref 17592186339923} {:answer/id #uuid "8688ee8a-8219-5c84-a042-632559c1a6df" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-1,-3)" :db/id #edb/ref 17592186340337} {:answer/id #uuid "95f977c5-80d6-5f10-bfe2-b1560cf968b7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-3,-1)" :db/id #edb/ref 17592186340481} {:answer/id #uuid "ae765e2d-062d-5b17-8c52-1eef7d4ff32e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-5,1)" :db/id #edb/ref 17592186340720}] :answer-field/correct {:answer/id #uuid "95f977c5-80d6-5f10-bfe2-b1560cf968b7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-3,-1)" :db/id #edb/ref 17592186340481} :answer-field/id #uuid "73585de0-1b70-548d-9d76-12f3a61d673b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186341582}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "7220b7e3-9cce-5102-874c-014511b9e7f6" :question/math-academy-id "q-74439" :question/problem "![](images/1d/1d687bcdc23c283e0945b039781450d2a020f0fd89c0d2976bb252914b296978.png)\n\nFind the point on the line $y+x=-4$ that is closest to the point $(0,2).$" :question/worked-solution "First, we rewrite the equation of the given line in slope-intercept form:\n\n$$\n\\begin{aligned}y+x & =-4 \\\\ y & =-x-4\\end{aligned}\n$$\n\nNext, we find the equation of the line that's perpendicular to $y=-x-4$ and passes through the point $(0,2).$\n\n The given line has a slope of $-1,$ so our perpendicular line must have a slope of $1.$\n\nUsing point-slope form and simplifying, we obtain the equation of the perpendicular line:\n\n$$\n\\begin{aligned}y-{y}_{1} & =m(x-{x}_{1}) \\\\ y-2 & =1(x-0) \\\\ y-2 & =x \\\\ y & =x+2\\end{aligned}\n$$\n\nWe now find the point where the two lines intersect. To do this, we solve the following system of equations:\n\n$$\n{\\begin{aligned}y=x+2 \\\\ y=-x-4\\end{aligned}\n$$\n\nWe can solve this system by putting the two equations equal to one another and solving for $x.$ This gives\n\n$$\n\\begin{aligned}x+2 & =-x-4 \\\\ x+x & =-4-2 \\\\ 2x & =-6 \\\\ x & =-3.\\end{aligned}\n$$\n\nSubstituting $x=-3$ into either of the two equations gives $y=-1.$ So, our solution is $x=-3$ and $y=-1.$ So, the lines intersect at the point $(-3,-1).$\n\nTherefore, we conclude that the point on the line $y+x=-4$ that is closest to the point $(0,2)$ is  $(-3,-1).$"}] [{:db/id #edb/ref 17592186345221 :knowledge-point/_questions [{:db/id #edb/ref 17592186152117 :knowledge-point/id #uuid "92a06a13-9e6b-53b1-9fad-ec6cba8b9545" :knowledge-point/title "Finding the LCM of Two Single-Variable Polynomials"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5d89e619-199e-55ac-8eca-9d77fffa7706" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "30(y+1)^{6}" :db/id #edb/ref 17592186343023} {:answer/id #uuid "a00fafbc-22ed-52d6-8f01-31dffa057768" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "30(y+1)^{10}" :db/id #edb/ref 17592186343651} {:answer/id #uuid "da747809-5242-5b07-9971-7285cceb6b5c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "150(y+1)^{10}" :db/id #edb/ref 17592186344157} {:answer/id #uuid "eb3e407c-9b56-57b2-833f-24e819c942f6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "30(y+1)^{12}" :db/id #edb/ref 17592186344298} {:answer/id #uuid "eb9d1027-57d3-5a23-9b93-f847e9338320" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "150(y+1)^{6}" :db/id #edb/ref 17592186344302}] :answer-field/correct {:answer/id #uuid "5d89e619-199e-55ac-8eca-9d77fffa7706" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "30(y+1)^{6}" :db/id #edb/ref 17592186343023} :answer-field/id #uuid "81b1b5e2-12f3-59b8-8a06-c39c41de6a36" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186344722}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "6fe6c820-9683-5a7a-b33c-5f323f0359af" :question/math-academy-id "q-76457" :question/problem "Find the least common multiple of $10(y+1)^{6}$ and $15(y+1)^{4}.$" :question/worked-solution "To find the least common multiple ($\\text{LCM}$) of two polynomials that are made up of products of binomials, we find the least common multiple of the constants and the least common multiple of the variable part. Then, we multiply all of the results together.\n\nSo first, we find $\\text{LCM}(10,15):$\n\n- Multiples of $10:$ $\\,10,\\,20,\\,30,\\,40,…$\n\n- Multiples of $15:$ $\\,15,\\,30,\\,45,…$\n\nSo, $\\text{LCM}(10,15)=30.$\n\nTo find the $\\text{LCM}$ of $(y+1)^{6}$ and $(y+1)^{4},$ we raise $(y+1)$ to the largest power that appears in the expressions, which is $6.$ Therefore,\n\n$$\n\\text{LCM}((y+1)^{6},\\,(y+1)^{4})=(y+1)^{6}.\n$$\n\nFinally, we multiply all of our results together:\n\n$$\n\\text{LCM}(10(y+1)^{6},\\,15(y+1)^{4})=30\\cdot (y+1)^{6}=30(y+1)^{6}.\n$$"}] [{:db/id #edb/ref 17592186345222 :knowledge-point/_questions [{:db/id #edb/ref 17592186152119 :knowledge-point/id #uuid "57496436-8bd0-567e-8c37-ed584849ce1a" :knowledge-point/title "Finding the LCM of Three Polynomials"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0605e45f-3e5a-5d33-a682-7100aa2a8ca5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "120{x}^{4}(y+2)" :db/id #edb/ref 17592186342294} {:answer/id #uuid "11f59668-bc57-5e29-9418-45b2197c07c7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "120{x}^{7}(y+2)^{3}" :db/id #edb/ref 17592186342398} {:answer/id #uuid "b54ac959-62ea-5199-9f5f-2f2c86259b21" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "60{x}^{17}(y+2)^{6}" :db/id #edb/ref 17592186343825} {:answer/id #uuid "ca0e194f-07bb-5959-8ccc-8a01a267e3db" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "60{x}^{4}(y+2)" :db/id #edb/ref 17592186344013} {:answer/id #uuid "d99fcded-2ea6-5c5d-aeda-dffd3b0f7c7a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "60{x}^{7}(y+2)^{3}" :db/id #edb/ref 17592186344149}] :answer-field/correct {:answer/id #uuid "d99fcded-2ea6-5c5d-aeda-dffd3b0f7c7a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "60{x}^{7}(y+2)^{3}" :db/id #edb/ref 17592186344149} :answer-field/id #uuid "27415d0b-998e-58eb-abc2-faf32c0e2a98" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186344563}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "288f9264-3705-5ed8-96fa-98d1f57e896b" :question/math-academy-id "q-76475" :question/problem "Find the least common multiple of the polynomials $20{x}^{7}(y+2),$ $\\,10{x}^{6}(y+2)^{3},$ and $12{x}^{4}(y+2)^{2}.$" :question/worked-solution "To find the least common multiple ($\\text{LCM}$) of three polynomials that are made up of products of binomials, we find the least common multiple of the constants and the least common multiple of each variable part. Then, we multiply all of the results together.\n\nSo first, we find $\\text{LCM}(20,10,12):$\n\n- Multiples of $20:$ $\\,20,\\,40,\\,60,\\,80,\\,100,\\,…$\n\n- Multiples of $10:$ $\\,10,\\,20,\\,30,\\,40,\\,50,\\,60,\\,70,\\,…$\n\n- Multiples of $12:$ $\\,12,\\,24,\\,36,\\,48,\\,60,\\,72,…$\n\nSo, $\\text{LCM}(20,10,12)=60.$\n\nTo find the $\\text{LCM}$ of ${x}^{7}(y+2),{x}^{6}(y+2)^{3},$ and ${x}^{4}(y+2)^{2},$ we find the largest powers for $x$ and $(y+2)$ that appear in all these expressions:\n\n- For ${x}^{7},\\,{x}^{6},$ and ${x}^{4},$ the largest power is $7.$\n\n- For $(y+2),(y+2)^{3},$ and $(y+2)^{2},$ the largest power is $3.$\n\nNow, we raise $x$ and $(y+2)$ to the corresponding largest powers. Therefore,\n\n$$\n\\text{LCM}({x}^{7}(y+2),\\,{x}^{6}(y+2)^{3},\\,{x}^{4}(y+2)^{2})={x}^{7}\\cdot (y+2)^{3}.\n$$\n\nFinally, we multiply all of our results together:\n\n$$\n\\begin{aligned}\\text{LCM}(20{x}^{7}(y+2),\\,10{x}^{6}(y+2)^{3},\\,12{x}^{4}(y+2)^{2}) & = \\\\ 60\\cdot {x}^{7}\\cdot (y+2)^{3} & = \\\\ 60{x}^{7}(y+2)^{3} & .\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186235582 :knowledge-point/_questions [{:db/id #edb/ref 17592186235285 :knowledge-point/id #uuid "58a49d00-cc58-5228-af38-9369cf31d8c8" :knowledge-point/title "Finding a Scalar Factor When Direction Reverses"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1ab5b44a-6f14-5d8c-b994-0ff723092bf6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186234586} {:answer/id #uuid "2b5b4c72-e340-52b5-be53-6903f63361a5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4.5" :db/id #edb/ref 17592186234611} {:answer/id #uuid "cbe36434-9519-583f-9b69-c587e4937715" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{3}" :db/id #edb/ref 17592186234866} {:answer/id #uuid "ce1ea7c1-61ca-56ba-a7d9-91573e3d6a5b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{3}" :db/id #edb/ref 17592186234869} {:answer/id #uuid "f46ca5b6-1fd3-597e-9657-e4197a5f9d69" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186234933}] :answer-field/correct {:answer/id #uuid "1ab5b44a-6f14-5d8c-b994-0ff723092bf6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186234586} :answer-field/id #uuid "1aa48e98-a238-5102-8717-85e261cb4e21" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186234997}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "adcdd06d-1586-51df-9df4-c005428c239d" :question/math-academy-id "q-77451" :question/problem "![](images/28/28faea3a553c505a8a5ab9bc7dd6e784dd23a47c336c70d31218fbe249d57cff.png)\n\nConsider the picture above. Given that $c=\\lambda a+3b,$ find $\\lambda .$" :question/worked-solution "To find $\\lambda ,$ we want to match the expression\n\n$$\nc=\\lambda a+3b.\n$$\n\nWe are given that one of the components is $3b.$ So, we first draw the vector $3b$ from the origin. Then we complete the path to the point $C.$\n\n![](images/52/52421034c2919620a0a9aae844db0eba2d396e5d6f1152d69bee40ff56c4d8ad.png)\n\nLet $P$ be the endpoint of the vector $3b.$ Then\n\n$$\nc=\\overset{\\to }{OP}+\\overset{\\to }{PC}.\n$$\n\nIn $△OPC,$ we have:\n\n- $PC=3|a|$\n\n- $\\overset{\\to }{PC}$ and $a$ have opposite directions\n\nHence, $\\overset{\\to }{PC}=-3a.$\n\nAdditionally,\n\n$$\n\\begin{aligned}c & =\\overset{\\to }{OP}+\\overset{\\to }{PC} \\\\  & =3b-3a.\\end{aligned}\n$$\n\nConsequently, $c=\\lambda a+3b=-3a+3b.$\n\nSince $a∦b,$ the linear combination can only be written in one way. Equating the coefficients of $a,$ we get:\n\n$$\n\\lambda =-3\n$$"}] [{:db/id #edb/ref 17592186348066 :knowledge-point/_questions [{:db/id #edb/ref 17592186068695 :knowledge-point/id #uuid "6cd6c125-ecaf-5847-a802-ec1b3594a15c" :knowledge-point/title "Determining Whether a Function Is Continuous at a Given Point"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "01aeaace-3dee-5861-928d-6a23090d00f2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186345366} {:answer/id #uuid "01c007c5-b958-5f05-bcdb-d16eb849a4b8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186345367} {:answer/id #uuid "02100b32-fbcc-582d-903e-bf23af1e8c8e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186345368} {:answer/id #uuid "c5a6767c-d2f1-526e-934e-fbbf34e09777" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186347068} {:answer/id #uuid "f40cbba4-ff28-567c-bde7-f1a1ff700f2d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186347512}] :answer-field/correct {:answer/id #uuid "f40cbba4-ff28-567c-bde7-f1a1ff700f2d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186347512} :answer-field/id #uuid "01de2c48-cbc5-5a34-8784-842c895031e0" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186347609}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "5c2c6cc4-6d0f-5ca4-bd69-989208f699b4" :question/math-academy-id "q-78132" :question/problem "![](images/89/890e7eaf519a65ca19d4a90b604e7d7a8ab7054635296c4b08f000546f23b545.png)\n\nThe curve $y=f(x)$ is shown above. At which of the following points is $f(x)$ continuous?\n\n- $x=-2$\n- $x=1$\n- $x=3$" :question/worked-solution "Let's consider each point separately.\n\n- The function $f(x)$ is continuous at $-2.$ The graph can be drawn in the neighborhood of $x=-2$ without taking our pencil off of the paper.\n\n- The function $f(x)$ is not continuous at $x=1.$ Since there is a jump at $x=1,$ it is impossible to draw the function in the neighborhood of $x=1$ without taking our pencil off of the paper.\n\n- Therefore, the function $f(x)$ is continuous $x=3.$ The graph can be drawn in the neighborhood of  $x=3$ without taking our pencil off of the paper.\n\nHence, the correct answer is  \"I and III only\".\n\n![](images/7c/7c96c401ddae0049859fd5608cb08c6ce9ae8a2e6c3db69d7d4b379b3824094e.png)"}] [{:db/id #edb/ref 17592186348327 :knowledge-point/_questions [{:db/id #edb/ref 17592186129142 :knowledge-point/id #uuid "5dce1c69-c79d-541a-b479-8fc127352c2a" :knowledge-point/title "Identifying the Graph of a Polynomial"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "218cb034-3e85-59b7-a903-56bfc598b9b0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "None of the given options is correct" :db/id #edb/ref 17592186345650} {:answer/id #uuid "5f26a8c0-2af0-5bee-a1cd-0bf2f5569905" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "A" :db/id #edb/ref 17592186346172} {:answer/id #uuid "6db0d065-e8ef-5454-9cf2-b8d92a429fa0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "B" :db/id #edb/ref 17592186346309} {:answer/id #uuid "afcb4450-4ae6-54b7-b7e5-2a45c0d057a7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "C" :db/id #edb/ref 17592186346883} {:answer/id #uuid "c8fffe14-90a9-51ed-b231-0b2a4af2d1c5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "D" :db/id #edb/ref 17592186347102}] :answer-field/correct {:answer/id #uuid "c8fffe14-90a9-51ed-b231-0b2a4af2d1c5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "D" :db/id #edb/ref 17592186347102} :answer-field/id #uuid "5a7510d2-2b7e-5e14-bd9b-6604c31ce57e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186347762}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "de44d5ab-abd2-5362-b1b7-cef838348808" :question/math-academy-id "q-80107" :question/problem "![](images/f1/f1f31073c260d8111cca3d5de1ec6db3e0f7f76a13c9a41a71b5512acd17f704.png)\n\nWhich of the diagrams above can be the graph of the polynomial $y=-{x}^{5}+4{x}^{2}-3?$" :question/worked-solution "Let's call $P(x)$ the given polynomial:\n\n$$\nP(x)=-{x}^{5}+4{x}^{2}-3\n$$\n\nThe degree $(n=5)$ is odd and the leading coefficient $({a}_{5}=-1)$ is negative. Therefore, the polynomial has the following end behavior:\n\n- $P(x)\\to \\infty $ as $x\\to -\\infty .$\n\n- $P(x)\\to -\\infty $ as $x\\to \\infty .$\n\nOnly the graph $D$ satisfies these conditions."}] [{:db/id #edb/ref 17592186348357 :knowledge-point/_questions [{:db/id #edb/ref 17592186129154 :knowledge-point/id #uuid "a66188f6-3228-59e9-9766-0f9bacbe8443" :knowledge-point/title "Identifying True Statements Regarding the Graph of a Given Polynomial"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2b75e759-23b9-5a00-8a2f-7c0ca516d97a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186345736} {:answer/id #uuid "910cdafc-67fc-587c-87f0-bdba48190064" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186346616} {:answer/id #uuid "b75eed07-3b22-5842-aac1-37ec3c1762bd" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186346950} {:answer/id #uuid "c106e615-06ca-5d4a-9046-a19b20c78b0a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186347019} {:answer/id #uuid "d48896a5-f655-5550-962f-afc68a851fd0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186347213}] :answer-field/correct {:answer/id #uuid "910cdafc-67fc-587c-87f0-bdba48190064" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186346616} :answer-field/id #uuid "b0b44f15-bb40-5519-8a0c-c8353afc8e01" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186347910}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "9e0f13e6-ba4b-56eb-b269-f07bb6ae2732" :question/math-academy-id "q-80303" :question/problem "![](images/0a/0a7b19b50822235a2dcbfcdf74984735a1e26b2b775180b24bdc2bcbf24c588b.png)\n\nThe graph of a polynomial $p(x)$ is shown above. Which of the following statements are true?\n\n- $x=-2$ is a root of even multiplicity.\n- $x=1$ is **not** a simple root.\n- $x=1$ is a root of even multiplicity." :question/worked-solution "Let's analyze each statement in turn.\n\n- Statement I is false. The root $x=-2$ has an odd multiplicity because at $x=-2$ the graph passes through the $x$-axis at this point.\n\n- Statement II is true. The root $x=1$ is not a simple root because the graph crosses the $x$-axis at that point, and the curve is tangent to the $x$-axis at that point.\n\n- Statement III is false. The root $x=1$ has an odd multiplicity because at $x=1$ the graph passes through the $x$-axis at this point.\n\nTherefore, the correct answer is \"II only\"."}] [{:db/id #edb/ref 17592186348369 :knowledge-point/_questions [{:db/id #edb/ref 17592186129145 :knowledge-point/id #uuid "4fc09a0f-34d3-5ca9-9964-6cb00498bfa7" :knowledge-point/title "Identifying the Factored Polynomial Shown in a Graph"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "433015c8-b02a-5d3b-9bc4-7270edca0b40" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y={x}^{3}(x+1)(x-2)" :db/id #edb/ref 17592186345929} {:answer/id #uuid "444cadbf-3703-59f5-bad4-46404cc1a695" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y={x}^{2}(x+1){(x-2)}^{2}" :db/id #edb/ref 17592186345940} {:answer/id #uuid "654ada61-08a2-5d34-998b-5c8db9d07e87" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y={x}^{3}(x+1){(x-2)}^{3}" :db/id #edb/ref 17592186346234} {:answer/id #uuid "6dbb7820-ea22-5b52-910b-269aa2f0dbbf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y={x}^{5}{(x+1)}^{2}(x-2)" :db/id #edb/ref 17592186346310} {:answer/id #uuid "f282e323-500b-5dcf-a254-2d713e281555" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=x{(x+1)}^{2}(x-2)" :db/id #edb/ref 17592186347497}] :answer-field/correct {:answer/id #uuid "654ada61-08a2-5d34-998b-5c8db9d07e87" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y={x}^{3}(x+1){(x-2)}^{3}" :db/id #edb/ref 17592186346234} :answer-field/id #uuid "9d5873ca-3084-51bf-9b1d-3de807002492" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186347880}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "ad55c8cb-7248-5482-9f28-0afc365f8908" :question/math-academy-id "q-80348" :question/problem "![](images/8b/8b086759a25af7e464c0c8be78d36cd4d8458c5c25e7c84cb6ecb28b2d59e9df.png)\n\nWhich of the following could be the equation of the polynomial curve shown above?" :question/worked-solution "First, we notice that the function has precisely three distinct roots, $x=-1$, $x=0$ and $x=2.$\n\nBased on the graph, we can make the following conclusions about the multiplicities of the roots:\n\n- Since the graph is *not* tangent to the $x$-axis at $x=-1,$ this root is a simple root (the multiplicity equals $1$).\n\n- Since the graph passes through $x=0,$ this root has odd multiplicity, and since the graph is tangent to the $x$-axis at $x=0,$ the multiplicity must be greater than one.\n\n- Since the graph passes through $x=2,$ this root has odd multiplicity, and since the graph is tangent to the $x$-axis at $x=2,$ the multiplicity must be greater than one.\n\nFrom the given options, the only possible equation is $y={x}^{3}(x+1){(x-2)}^{3}.$"}] [{:db/id #edb/ref 17592186351284 :knowledge-point/_questions [{:db/id #edb/ref 17592186129302 :knowledge-point/id #uuid "503a2d0a-ba6c-5529-9f26-b83c769a26a2" :knowledge-point/title "Finding the Domain of a Transformed Reciprocal Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "07cf5972-f40e-5217-8db4-af4d714d0f29" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x\\in (-\\infty ,5)\\cup (5,\\infty )" :db/id #edb/ref 17592186348511} {:answer/id #uuid "4ff5e665-aaa0-5a32-9ee9-f1bfeace33e3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x\\in (-\\infty ,-3)\\cup (-3,\\infty )" :db/id #edb/ref 17592186349171} {:answer/id #uuid "86623a7d-5813-5d35-94af-16d6fb07a0e9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x\\in (-\\infty ,\\frac{1}{5})\\cup (\\frac{1}{5},\\infty )" :db/id #edb/ref 17592186349673} {:answer/id #uuid "c3ecf398-d445-5f07-9e39-0e0872bbfc4b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186350178} {:answer/id #uuid "e061e2c5-0620-5228-ad52-cedd9b116361" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x\\in (-\\infty ,-\\frac{1}{3})\\cup (-\\frac{1}{3},\\infty )" :db/id #edb/ref 17592186350417}] :answer-field/correct {:answer/id #uuid "86623a7d-5813-5d35-94af-16d6fb07a0e9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x\\in (-\\infty ,\\frac{1}{5})\\cup (\\frac{1}{5},\\infty )" :db/id #edb/ref 17592186349673} :answer-field/id #uuid "0a944731-6928-5c95-9932-5dd54d8c5f7b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186350725}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "f524ac1c-6637-5a2f-a68c-7f9c181d3393" :question/math-academy-id "q-81297" :question/problem "What is the domain of the function $f(x)=\\frac{3x+1}{5x-1}?$" :question/worked-solution "A reciprocal function is defined for all values of $x$ except for those that make the denominator zero. So, to find the domain, we must exclude all values of $x$ that make the denominator zero.\n\nSetting the denominator equal to zero and solving, we get\n\n$$\n\\begin{aligned}5x-1 & =0 \\\\ 5x & =1 \\\\ x & =\\frac{1}{5}.\\end{aligned}\n$$\n\nTherefore, the domain is $x\\in (-\\infty ,\\frac{1}{5})\\cup (\\frac{1}{5},\\infty ).$"}] [{:db/id #edb/ref 17592186351285 :knowledge-point/_questions [{:db/id #edb/ref 17592186129303 :knowledge-point/id #uuid "bd0aa5fc-79de-525e-a688-a8a2d2fcf858" :knowledge-point/title "Solving for an Unknown Constant in a Transformed Reciprocal Function Given the Domain"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0f8d2777-c68c-5bac-b02b-e76ea7832227" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{4}{5}" :db/id #edb/ref 17592186348585} {:answer/id #uuid "4440720a-4b25-56ac-acfb-e35454aaf42f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5}{4}" :db/id #edb/ref 17592186349068} {:answer/id #uuid "aa03c041-3060-57a7-9832-43fc7a4091d2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186349958} {:answer/id #uuid "b607c09a-ead1-5f9f-8366-b91cefea5b3e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{5}" :db/id #edb/ref 17592186350056} {:answer/id #uuid "fe48bdf6-69b4-58e6-ab4b-56b33ca29990" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "10" :db/id #edb/ref 17592186350684}] :answer-field/correct {:answer/id #uuid "aa03c041-3060-57a7-9832-43fc7a4091d2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186349958} :answer-field/id #uuid "96ab50f6-ff51-5cc2-a2e4-1ac35c1df983" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186350965}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "69d362d8-5140-5de9-97ea-ddf053c6a1b5" :question/math-academy-id "q-81306" :question/problem "The domain of the function $f(x)=\\frac{3x-7}{kx-4}$ is $(-\\infty ,\\frac{4}{5})\\cup (\\frac{4}{5},\\infty ).$ What is the value of $k?$" :question/worked-solution "A reciprocal function is defined for all values of $x$ except for those that make the denominator zero. So, to find the domain, we must exclude all values that make the denominator zero.\n\nSetting the denominator equal to zero and solving, we get\n\n$$\n\\begin{aligned}kx-4 & =0 \\\\ kx & =4 \\\\ x & =\\frac{4}{k}.\\end{aligned}\n$$\n\nSo, the point that must be excluded from the domain is $x=\\frac{4}{k}.$ \n\nOn the other hand, we can see that $x=\\frac{4}{5}$ is excluded from the domain. Equating this to $\\frac{4}{k},$ we get\n\n$$\n\\begin{aligned}\\frac{4}{k} & =\\frac{4}{5} \\\\ \\frac{1}{k} & =\\frac{1}{5} \\\\ k & =5.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186129876 :knowledge-point/_questions [{:db/id #edb/ref 17592186129304 :knowledge-point/id #uuid "66d82fa3-d576-5c42-9dca-4e1b76473424" :knowledge-point/title "Finding the Range of a Transformed Reciprocal Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0e75273e-f9fe-5904-9b97-df326138bc4a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "f(x)\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186348572} {:answer/id #uuid "56bde1c1-ec8e-5414-abd3-cf3a35ed829d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "f(x)\\in (-\\infty ,-1)\\cup (1,\\infty )" :db/id #edb/ref 17592186349240} {:answer/id #uuid "70ec2a49-c0cb-50b3-96d0-78c9ed276005" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "f(x)\\in (-\\infty ,1)\\cup (1,\\infty )" :db/id #edb/ref 17592186349486} {:answer/id #uuid "710ec1a0-ca77-5baf-9aea-64447273a88e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "f(x)\\in (-\\infty ,-6)\\cup (1,\\infty )" :db/id #edb/ref 17592186349487} {:answer/id #uuid "76603cce-9fe2-582e-98c8-b6b5dfe79841" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "f(x)\\in (-\\infty ,6)\\cup (6,\\infty )" :db/id #edb/ref 17592186349534}] :answer-field/correct {:answer/id #uuid "70ec2a49-c0cb-50b3-96d0-78c9ed276005" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "f(x)\\in (-\\infty ,1)\\cup (1,\\infty )" :db/id #edb/ref 17592186349486} :answer-field/id #uuid "2d01f1a9-302b-5e9b-a9b7-f275dfb86ddd" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186350788}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "d6996c90-1b1f-5226-b63d-1aa92068c6b3" :question/math-academy-id "q-81416" :question/problem "What is the range of $f(x)=\\frac{1}{x-6}+1?$" :question/worked-solution "A transformed reciprocal function of the form\n\n$$\nf(x)=\\frac{a}{bx+c}+d\n$$\n\nhas the horizontal asymptote $y=d,$ and therefore, its range is\n\n$$\nf(x)\\in (-\\infty ,d)\\cup (d,\\infty ).\n$$\n\nIn our case, $d=1.$ Therefore, the horizontal asymptote is $y=1,$ and the range of the function is\n\n$$\nf(x)\\in (-\\infty ,1)\\cup (1,\\infty ).\n$$\n\nThe graph $y=f(x)$ is shown below.\n\n![](images/f6/f6b1316dd9c7f2a40c23de08dde63cbc6402593c6209d99384279a7c1ae29da6.png)"}] [{:db/id #edb/ref 17592186351437 :knowledge-point/_questions [{:db/id #edb/ref 17592186087758 :knowledge-point/id #uuid "833ac63c-235b-5059-ab7c-56eb1e44d79e" :knowledge-point/title "Finding the Argument of a Complex Number in the Second Quadrant"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1bdc6138-01e7-5dca-90c2-ee5ef772f650" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1.95" :db/id #edb/ref 17592186348685} {:answer/id #uuid "3a5f7895-83a7-5868-921c-57c50450ef1a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1.82" :db/id #edb/ref 17592186348975} {:answer/id #uuid "69962bbe-75b8-5ae4-99aa-4f7910f71965" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1.11" :db/id #edb/ref 17592186349425} {:answer/id #uuid "7df6bfdf-a463-5e56-a7b0-8cc61b55f17f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2.07" :db/id #edb/ref 17592186349601} {:answer/id #uuid "b60fe42a-6aaa-59ac-b35e-8ac4d19e26ea" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1.66" :db/id #edb/ref 17592186350058}] :answer-field/correct {:answer/id #uuid "1bdc6138-01e7-5dca-90c2-ee5ef772f650" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1.95" :db/id #edb/ref 17592186348685} :answer-field/id #uuid "4c0ed589-e9f7-57d6-8078-aa521972d708" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186350836}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "61e93f3c-1103-58d6-a5e4-4e5649a9f688" :question/math-academy-id "q-8258" :question/problem "Find, in radians to two decimal places, the argument of $z=-2+5\\text{i}.$ \n\n**Hint**: The argument of a complex number is in the range $[0,2\\pi ).$" :question/requires-calculator true :question/worked-solution "Let's plot $z$ in the complex plane.\n\n![](images/fc/fc6a2568ba77ce043ae0d48840ed4707b3e629b8a52c4b5f182c1e23a249fa44.png)\n\nThe complex number $z$ lies in the second quadrant of the complex plane. Therefore $\\frac{\\pi }{2}<arg⁡(z)<\\pi .$ If $\\alpha $ is the angle that $z$ makes with the negative real axis, then\n\n$$\n\\begin{aligned}tan⁡\\alpha  & =\\frac{5}{2} \\\\ \\alpha  & =arctan⁡(\\frac{5}{2}) \\\\  & ≈1.190\\text{ }29\\end{aligned}\n$$\n\nrounded to $5$ decimal places.\n\nTherefore,\n\n$$\n\\theta =arg⁡(z)≈\\pi -1.190\\text{ }29≈1.95\n$$\n\nto two decimal places."}] [{:db/id #edb/ref 17592186088434 :knowledge-point/_questions [{:db/id #edb/ref 17592186087759 :knowledge-point/id #uuid "54588722-bb80-54ca-b100-03aca39e0c17" :knowledge-point/title "Finding the Argument of a Complex Number in the Fourth Quadrant"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6f1b0500-415f-5429-89d9-fbbb92a98ae2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5.31" :db/id #edb/ref 17592186352546} {:answer/id #uuid "cd29b07a-70bf-5347-a5b0-93e51c59301b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5.74" :db/id #edb/ref 17592186353348} {:answer/id #uuid "e36a586c-680f-580d-a120-8ca0ede7f5be" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5.22" :db/id #edb/ref 17592186353548} {:answer/id #uuid "ef8e504f-d2c6-5f83-8ce5-d298b778f10a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5.23" :db/id #edb/ref 17592186353653} {:answer/id #uuid "fde2ebba-1cad-5211-b6e3-3a258bce156d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5.66" :db/id #edb/ref 17592186353793}] :answer-field/correct {:answer/id #uuid "fde2ebba-1cad-5211-b6e3-3a258bce156d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5.66" :db/id #edb/ref 17592186353793} :answer-field/id #uuid "4ee08007-7eba-5dcc-a203-e575bd3f6bdf" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186353951}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "1eede2a0-b32f-5395-87d1-df0fef1f0013" :question/math-academy-id "q-8454" :question/problem "Find, in radians to two decimal places, the argument of $z=7-5\\text{i}.$ \n\n**Hint**: The argument of a complex number is in the range $[0,2\\pi ).$" :question/requires-calculator true :question/worked-solution "Let's plot $z$ in the complex plane.\n\n![](images/d0/d096d76118bc06b2d5c79d5017c0178d96fc84bff6f97d563b7b872d26e75d20.png)\n\nThe complex number $z$ lies in the fourth quadrant of the complex plane. Therefore $\\frac{3\\pi }{2}<arg⁡(z)<2\\pi .$ \n\nIf $\\alpha $ is the angle that $z$ makes with the positive real axis, then\n\n$$\n\\alpha =arctan⁡(\\frac{5}{7})≈0.620\\,25.\n$$\n\nTherefore,\n\n$$\n\\theta =arg⁡(z)=2\\pi -0.620\\,25≈5.66\n$$\n\nto two decimal places."}] [{:db/id #edb/ref 17592186354368 :knowledge-point/_questions [{:db/id #edb/ref 17592186083225 :knowledge-point/id #uuid "120f626e-dd00-537a-8948-d8f81850d696" :knowledge-point/title "Calculating the Number of Combinations of Objects Chosen From a Group Fewer Than Ten"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "260ee64b-60f9-577f-b9cd-899af296d9b5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "84" :db/id #edb/ref 17592186351917} {:answer/id #uuid "73b8b006-61f8-5c7a-906f-a83360295df8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "9" :db/id #edb/ref 17592186352580} {:answer/id #uuid "b91e1eea-f224-503d-85e7-b2faa41fc99d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "27" :db/id #edb/ref 17592186353149} {:answer/id #uuid "ca9be550-efdd-5dc5-80d3-353296eb9f18" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "243" :db/id #edb/ref 17592186353327} {:answer/id #uuid "ef9b644a-cfec-5d4f-922b-5a3e24daabe5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "81" :db/id #edb/ref 17592186353654}] :answer-field/correct {:answer/id #uuid "260ee64b-60f9-577f-b9cd-899af296d9b5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "84" :db/id #edb/ref 17592186351917} :answer-field/id #uuid "fcee7007-39c0-575f-87b4-92eaeeb2b54a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186354257}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "a9b3fff3-7ca8-5a05-bacf-2186c0ce6253" :question/math-academy-id "q-84956" :question/problem "A pizzeria has nine different toppings from which to choose. How many different pizzas can be made using only three toppings?" :question/worked-solution "The number of combinations of $n$ objects taken $r$ at a time is given by the formula\n\n$$\n{}_{n}{C}_{r}=\\frac{n!}{(n-r)!\\,r!}.\n$$\n\nThere are $9$ toppings, so $n=9.$ We want to select $3$ of those toppings for each of the pizzas, so we have $r=3.$\n\nTherefore, the number of different pizzas is\n\n$$\n\\begin{aligned}{}_{9}{C}_{3} & =\\frac{9!}{(9-3)!\\,3!} \\\\  & =\\frac{9!}{6!3!} \\\\  & =\\frac{9\\cdot 8\\cdot 7\\cdot \\cancel{6!}}{\\cancel{6!}3!} \\\\  & =\\frac{9\\cdot 8\\cdot 7}{3\\cdot 2\\cdot 1} \\\\  & =\\frac{504}{6} \\\\  & =84.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186354369 :knowledge-point/_questions [{:db/id #edb/ref 17592186083225 :knowledge-point/id #uuid "120f626e-dd00-537a-8948-d8f81850d696" :knowledge-point/title "Calculating the Number of Combinations of Objects Chosen From a Group Fewer Than Ten"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1755d2b2-8ef2-5841-967a-37231874078e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "154" :db/id #edb/ref 17592186351776} {:answer/id #uuid "22aa46f6-d9f6-52a0-921d-e699a6fdabc9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "82" :db/id #edb/ref 17592186351880} {:answer/id #uuid "aefddd11-ffea-5b50-af77-6441d3546955" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "102" :db/id #edb/ref 17592186353052} {:answer/id #uuid "d8ef2388-0f72-5871-b0be-8276cb5fe915" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "45" :db/id #edb/ref 17592186353453} {:answer/id #uuid "debdfcd2-ba10-5c33-a152-32714bf2926b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "126" :db/id #edb/ref 17592186353500}] :answer-field/correct {:answer/id #uuid "debdfcd2-ba10-5c33-a152-32714bf2926b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "126" :db/id #edb/ref 17592186353500} :answer-field/id #uuid "bb52f3bb-59b4-5a00-86e6-1550bcc92127" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186354137}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "44e1ceb1-ad30-5708-98e7-b7ac9be19ae7" :question/math-academy-id "q-84959" :question/problem "Sara has a box of $9$ colored pencils. In how many ways can Sara pick a set of $4$ different pencils from the box?" :question/worked-solution "The number of combinations of $n$ objects taken $r$ at a time is given by the formula\n\n$$\n{}_{n}{C}_{r}=\\frac{n!}{(n-r)!\\,r!}.\n$$\n\nThere are $9$ pencils in the box, so $n=9.$ We want to select $4$ of those pencils, so we have $r=4.$\n\nTherefore, the number of different potential sets of four pencils is\n\n$$\n\\begin{aligned}{}_{9}{C}_{4} & =\\frac{9!}{(9-4)!\\,4!} \\\\  & =\\frac{9!}{5!4!} \\\\  & =\\frac{9\\cdot 8\\cdot 7\\cdot 6\\cdot \\cancel{5!}}{\\cancel{5!}4!} \\\\  & =\\frac{9\\cdot 8\\cdot 7\\cdot 6}{4\\cdot 3\\cdot 2\\cdot 1} \\\\  & =\\frac{3\\,024}{24} \\\\  & =126.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186394620 :knowledge-point/_questions [{:db/id #edb/ref 17592186083221 :knowledge-point/id #uuid "060e80f0-44bd-5378-9253-999548115dd9" :knowledge-point/title "Calculating the Number of Permutations of Objects Chosen From a Group Fewer Than Ten"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "aaed84db-333e-5211-84c5-2d24c1d90316" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\,016" :db/id #edb/ref 17592186394622} {:answer/id #uuid "e1c1b16c-2ec4-5950-92f8-59f867978e1e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3\\,024" :db/id #edb/ref 17592186394623} {:answer/id #uuid "542940cc-ac17-5702-9c22-d185b7bb47c3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "120" :db/id #edb/ref 17592186394624} {:answer/id #uuid "2e70f827-6004-57e0-825e-f0e45fc164d6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1\\,344" :db/id #edb/ref 17592186394625} {:answer/id #uuid "3d0a0e84-7492-5601-b7a4-02b8e70ea90d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "15\\,120" :db/id #edb/ref 17592186394626}] :answer-field/correct {:answer/id #uuid "e1c1b16c-2ec4-5950-92f8-59f867978e1e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3\\,024" :db/id #edb/ref 17592186394623} :answer-field/id #uuid "72d9fa78-c6ea-5ff0-a6cb-0b7ec2cbcfc0" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186394621}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "4ef67e9d-56e9-502f-9f38-dd41f4d01e7c" :question/math-academy-id "q-84983" :question/problem "A bag contains $9$ different colored marbles. Jamie takes $4$ marbles from the bag, one at a time, and puts them in the order they were taken from the bag to create a sequence of colors. How many different sequences of colors are possible?" :question/worked-solution "The number of permutations of $n$ objects taken $r$ at a time is given by the formula\n\n$$\n{}_{n}{P}_{r}=\\frac{n!}{(n-r)!}.\n$$\n\nThere are $9$ colored marbles, so $n=9.$ We want to select $4$ of those marbles to make a sequence of colors, so we have $r=4.$ \n\nTherefore, the number of different ways to choose the marbles is \n\n$$\n\\begin{aligned}{}_{9}{P}_{4} & =\\frac{9!}{(9-4)!} \\\\  & =\\frac{9!}{5!} \\\\  & =\\frac{9\\cdot 8\\cdot 7\\cdot 6\\cdot \\cancel{5!}}{\\cancel{5!}} \\\\  & =9\\cdot 8\\cdot 7\\cdot 6 \\\\  & =3\\,024.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186394627 :knowledge-point/_questions [{:db/id #edb/ref 17592186083312 :knowledge-point/id #uuid "b6b720d4-59b0-5d86-b856-ff69abfe4152" :knowledge-point/title "Evaluating Combinations Given Using Alternate Notation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "43fa39e5-ce50-500d-851f-de9eb3b12eda" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "19\\,380" :db/id #edb/ref 17592186394629} {:answer/id #uuid "b8e55eef-a2a6-5dcc-8dbd-442ffb6f3b06" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6\\,480" :db/id #edb/ref 17592186394630} {:answer/id #uuid "24b6f013-8ec7-5811-963d-26ce3311756c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\,860" :db/id #edb/ref 17592186394631} {:answer/id #uuid "cde0fe8a-36a8-5e30-8de3-aa6250e1a52c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "9\\,280" :db/id #edb/ref 17592186394632} {:answer/id #uuid "f9dca18c-0cda-53f2-ae56-98a74295c88b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4\\,845" :db/id #edb/ref 17592186394633}] :answer-field/correct {:answer/id #uuid "f9dca18c-0cda-53f2-ae56-98a74295c88b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4\\,845" :db/id #edb/ref 17592186394633} :answer-field/id #uuid "ee128c64-8462-52f2-aa05-6a02c9deb300" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186394628}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "ccb665c6-b272-5591-95cb-e38be54fe76e" :question/math-academy-id "q-85044" :question/problem "Evaluate $(\\begin{aligned}20 \\\\ 16\\end{aligned}).$" :question/worked-solution "First, note that $(\\frac{20}{16})$ means the same thing as ${}_{20}{C}_{16}.$\n\n In general, the number of combinations of $n$ objects taken $r$ at a time is given by the formula\n\n$$\n{}_{n}{C}_{r}=\\frac{n!}{(n-r)!\\,r!}.\n$$\n\nSubstituting $n=20$ and $r=16,$ we get\n\n$$\n\\begin{aligned}{}_{20}{C}_{16} & =\\frac{20!}{(20-16)!16!} \\\\  & =\\frac{20!}{4!16!} \\\\  & =\\frac{20\\cdot 19\\cdot 18\\cdot 17\\cdot \\cancel{16!}}{4!\\cancel{16!}} \\\\  & =\\frac{20\\cdot 19\\cdot 18\\cdot 17}{4\\cdot 3\\cdot 2\\cdot 1} \\\\  & =\\frac{116\\,280}{24} \\\\  & =4\\,845.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186394634 :knowledge-point/_questions [{:db/id #edb/ref 17592186083311 :knowledge-point/id #uuid "e9c145aa-bcbf-54bd-ba88-93f10aeb00f0" :knowledge-point/title "Calculating a Permutation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "bcef49e9-f6e2-5903-88c5-5668ea726fad" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\,652" :db/id #edb/ref 17592186394636} {:answer/id #uuid "00becd7c-07c7-51a1-8d01-c22ee90258d8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1\\,326" :db/id #edb/ref 17592186394637} {:answer/id #uuid "5dbc2ffb-e921-5ab1-a79b-de22cae70506" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\,248" :db/id #edb/ref 17592186394638} {:answer/id #uuid "f4f8eb3e-2322-5192-b908-a3996052fac4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5\\,304" :db/id #edb/ref 17592186394639} {:answer/id #uuid "043e4ba5-d6b6-52c1-acd4-3439e275df92" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1\\,225" :db/id #edb/ref 17592186394640}] :answer-field/correct {:answer/id #uuid "bcef49e9-f6e2-5903-88c5-5668ea726fad" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\,652" :db/id #edb/ref 17592186394636} :answer-field/id #uuid "66c1eba9-fa9c-5dcd-af76-d9dc0545ee45" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186394635}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "b6727864-63ba-5449-a9b7-0dc7ad66d6bd" :question/math-academy-id "q-85046" :question/problem "${}_{52}{P}_{2}=$" :question/worked-solution "The formula for ${}_{n}{P}_{r}$ is given by\n\n$$\n{}_{n}{P}_{r}=\\frac{n!}{(n-r)!}\\,.\n$$\n\nSubstituting $n=52$ and $r=2$ into the above, we get\n\n$$\n\\begin{aligned}{}_{52}{P}_{2} & =\\frac{52!}{(52-2)!} \\\\  & =\\frac{52!}{50!} \\\\  & =\\frac{52\\cdot 51\\cdot \\cancel{50!}}{\\cancel{50!}} \\\\  & =52\\cdot 51 \\\\  & =2\\,652.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186394641 :knowledge-point/_questions [{:db/id #edb/ref 17592186083223 :knowledge-point/id #uuid "e7c35604-c9f9-5077-bddc-fe9446ac45e6" :knowledge-point/title "Calculating a Permutation Given Using Alternate Notation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9972d5bf-226c-5e87-988b-2fa3e0b4fbd7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "7" :db/id #edb/ref 17592186394643} {:answer/id #uuid "82c57328-7703-57d6-912b-2ecb7333260d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5\\,040" :db/id #edb/ref 17592186394644} {:answer/id #uuid "57d5dc3c-cc5e-57df-b81a-64cfa2b4c5cc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186394645} {:answer/id #uuid "7dc1825b-3805-54c0-b2fd-b20b91c26d42" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "720" :db/id #edb/ref 17592186394646} {:answer/id #uuid "4c2571b5-b785-5912-b9bf-d0e4a3fa1a43" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "49" :db/id #edb/ref 17592186394647}] :answer-field/correct {:answer/id #uuid "82c57328-7703-57d6-912b-2ecb7333260d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5\\,040" :db/id #edb/ref 17592186394644} :answer-field/id #uuid "ff3b3c1d-8754-5e1f-a814-29025fd4b1b3" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186394642}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "b1198cf2-96b8-5b7c-bdc4-b79e3231eb29" :question/math-academy-id "q-85049" :question/problem "$P(7,7)=$" :question/worked-solution "The formula for ${}_{n}{P}_{r}$ is given by\n\n$$\n{}_{n}{P}_{r}=\\frac{n!}{(n-r)!}\\,.\n$$\n\n$P(7,7)$ means the same thing as ${}_{7}{P}_{7}.$ Using the usual formula for ${}_{n}{P}_{r},$ we get\n\n$$\n\\begin{aligned}P(7,7) & =\\frac{7!}{(7-7)!} \\\\  & =\\frac{7!}{0!} \\\\  & =\\frac{7\\cdot 6\\cdot 5\\cdot 4\\cdot 3\\cdot 2\\cdot 1}{1} \\\\  & =5\\,040.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186404315 :knowledge-point/_questions [{:db/id #edb/ref 17592186129082 :knowledge-point/id #uuid "98d6004a-547a-5b0b-9748-9571cc3ee632" :knowledge-point/title "Computing a Tangent or Cotangent Using the Pythagorean Identity"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "06cba355-0ee9-5493-b5b4-b01907ba7853" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "cot⁡\\theta =\\frac{2\\sqrt{3}}{9}" :db/id #edb/ref 17592186404317} {:answer/id #uuid "88bc01f1-e620-5d5f-b135-3c829509a914" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "cot⁡\\theta =-\\frac{\\sqrt{5}}{7}" :db/id #edb/ref 17592186404318} {:answer/id #uuid "c44c5852-2bff-553c-b41d-6c60dda93e43" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "cot⁡\\theta =-\\frac{\\sqrt{5}}{3}" :db/id #edb/ref 17592186404319} {:answer/id #uuid "e6647b56-89a1-5a81-85bf-14ccfa47147b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "cot⁡\\theta =-\\frac{2\\sqrt{5}}{15}" :db/id #edb/ref 17592186404320} {:answer/id #uuid "814df066-a51f-5318-8a89-ed554769eecb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "cot⁡\\theta =\\frac{2}{5}" :db/id #edb/ref 17592186404321}] :answer-field/correct {:answer/id #uuid "e6647b56-89a1-5a81-85bf-14ccfa47147b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "cot⁡\\theta =-\\frac{2\\sqrt{5}}{15}" :db/id #edb/ref 17592186404320} :answer-field/id #uuid "9151fede-a06c-511f-acdd-16c15e3d7d4c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186404316}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "37e87bc7-80c8-5654-8c99-e96b9d9f6c6d" :question/math-academy-id "q-85640" :question/problem "![](images/97/97c98411b3455c78c9e061cf54fa76eabfccc369e9e364a5366eb58bd5d2935d.png)\n\nThe diagram above shows the unit circle. Given that $cos⁡\\theta =\\frac{2}{7},$ what is the value of $cot⁡\\theta ?$" :question/worked-solution "![](images/8c/8c7889d63cf5894236bc5f5e24feb64ecf5a47acb2c07c807a4e65458a991232.png)\n\nWe can use the Pythagorean identity to find $sin⁡\\theta :$\n\n$$\n\\begin{aligned}{sin}^{2}⁡\\theta +{cos}^{2}⁡\\theta  & =1 \\\\ {sin}^{2}⁡\\theta  & =1-{cos}^{2}⁡\\theta  \\\\ sin⁡\\theta  & =\\pm \\sqrt{1-{cos}^{2}⁡\\theta }\\end{aligned}\n$$\n\nSubstituting $cos⁡\\theta =\\frac{2}{7}$ gives\n\n$$\n\\begin{aligned}sin⁡\\theta  & =\\pm \\sqrt{1-{(\\frac{2}{7})}^{2}} \\\\  & =\\pm \\sqrt{1-\\frac{4}{49}} \\\\  & =\\pm \\sqrt{\\frac{45}{49}} \\\\  & =\\pm \\frac{3\\sqrt{5}}{7}.\\end{aligned}\n$$\n\nWe select the negative answer since $sin⁡\\theta $ is negative in the fourth quadrant. So, $sin⁡\\theta =-\\frac{3\\sqrt{5}}{7}.$\n\nFinally, knowing that $cot⁡\\theta =\\frac{cos⁡\\theta }{sin⁡\\theta },$ we have\n\n$$\ncot⁡\\theta =\\frac{(\\frac{2}{7})}{(-\\frac{3\\sqrt{5}}{7})}=-\\frac{2}{3\\sqrt{5}}=-\\frac{2\\sqrt{5}}{15}.\n$$"}] [{:db/id #edb/ref 17592186404322 :knowledge-point/_questions [{:db/id #edb/ref 17592186129083 :knowledge-point/id #uuid "55a09362-632a-56c4-b246-903e18fc77ee" :knowledge-point/title "Computing a Reciprocal Trigonometric Ratio Using the Pythagorean Identity"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6bce3c75-6a0d-53d7-9a0d-6b6d8acd31bd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "sec⁡\\theta =-\\frac{7\\sqrt{6}}{12}" :db/id #edb/ref 17592186404324} {:answer/id #uuid "2613efdb-cd4c-5ddd-8173-e348bdcb96f5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "sec⁡\\theta =-\\frac{7\\sqrt{5}}{3}" :db/id #edb/ref 17592186404325} {:answer/id #uuid "1f7b0ef2-5302-5b29-89fc-f8f26371b54c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "sec⁡\\theta =-\\frac{7\\sqrt{3}}{12}" :db/id #edb/ref 17592186404326} {:answer/id #uuid "39dd9d4a-1c32-59d2-b731-ba230d302e82" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "sec⁡\\theta =\\frac{3\\sqrt{2}}{2}" :db/id #edb/ref 17592186404327} {:answer/id #uuid "b99f4a1b-d16f-5aa6-a399-a33703bd010f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "sec⁡\\theta =\\frac{\\sqrt{6}}{12}" :db/id #edb/ref 17592186404328}] :answer-field/correct {:answer/id #uuid "6bce3c75-6a0d-53d7-9a0d-6b6d8acd31bd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "sec⁡\\theta =-\\frac{7\\sqrt{6}}{12}" :db/id #edb/ref 17592186404324} :answer-field/id #uuid "e48430d0-09a9-535a-843b-f4fdfbee498f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186404323}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "0902cd66-9d18-50eb-a894-3b1edfc4b17b" :question/math-academy-id "q-85643" :question/problem "![](images/3b/3be6fa94deb7fc38d870e5a31cc81c3cfd6b9ab84c21340e7e88f7246b1058bc.png)\n\nThe diagram above shows the unit circle. Given that the $y$-coordinate of the point $P$ is $\\frac{5}{7},$ what is the value of $sec⁡\\theta ?$" :question/worked-solution "![](images/17/17e6320115f2cf8b5ffad6abc099169774536af20d2559b453aaa97c1286d96d.png)\n\nWe're given that $y=\\frac{5}{7}$ at the point $P.$ Therefore, $sin⁡\\theta =\\frac{5}{7}.$\n\nWe can use the Pythagorean identity to find $cos⁡\\theta :$\n\n$$\n\\begin{aligned}{sin}^{2}⁡\\theta +{cos}^{2}⁡\\theta  & =1 \\\\ {cos}^{2}⁡\\theta  & =1-{sin}^{2}⁡\\theta  \\\\ cos⁡\\theta  & =\\pm \\sqrt{1-{sin}^{2}⁡\\theta }\\end{aligned}\n$$\n\nSubstituting $sin⁡\\theta =\\frac{5}{7}$ gives\n\n$$\n\\begin{aligned}cos⁡\\theta  & =\\pm \\sqrt{1-{(\\frac{5}{7})}^{2}} \\\\  & =\\pm \\sqrt{1-\\frac{25}{49}} \\\\  & =\\pm \\sqrt{\\frac{24}{49}} \\\\  & =\\pm \\frac{\\sqrt{24}}{7} \\\\  & =\\pm \\frac{2\\sqrt{6}}{7}.\\end{aligned}\n$$\n\nWe select the negative answer since $cos⁡\\theta $ is negative in the second quadrant. So, $cos⁡\\theta =-\\frac{2\\sqrt{6}}{7}.$\n\nFinally, knowing that $sec⁡\\theta =\\frac{1}{cos⁡\\theta },$ we have\n\n$$\nsec⁡\\theta =\\frac{1}{(-\\frac{2\\sqrt{6}}{7})}=-\\frac{7}{2\\sqrt{6}}=-\\frac{7\\sqrt{6}}{12}.\n$$"}] [{:db/id #edb/ref 17592186354465 :knowledge-point/_questions [{:db/id #edb/ref 17592186059844 :knowledge-point/id #uuid "f0052499-42ab-5818-a844-20eb099c3f7b" :knowledge-point/title "Finding the Sine or Cosine of a Special Angle Given in Radians"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "044b0751-3888-55cc-a3f5-80549082bb96" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{2}}{4}" :db/id #edb/ref 17592186351606} {:answer/id #uuid "7b30bf64-0acc-5282-b803-06945c32a50f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{2}}{2}" :db/id #edb/ref 17592186352639} {:answer/id #uuid "92bdbad7-2d48-5c77-876c-fcc57313f9ce" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{3}}{2}" :db/id #edb/ref 17592186352838} {:answer/id #uuid "9f0f11de-1be9-5064-990b-af0dfef7ce48" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{2}}{3}" :db/id #edb/ref 17592186352930} {:answer/id #uuid "dec91441-cb91-59c4-a043-47f7c0f1aa32" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3\\sqrt{2}}{2}" :db/id #edb/ref 17592186353501}] :answer-field/correct {:answer/id #uuid "7b30bf64-0acc-5282-b803-06945c32a50f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{2}}{2}" :db/id #edb/ref 17592186352639} :answer-field/id #uuid "0c5e282a-f0f5-5ba8-8e6f-9a5d8748314c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186353837}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "fb464a1e-3e09-57c1-9d5b-ec060c590e24" :question/math-academy-id "q-86327" :question/problem "$cos⁡(\\frac{\\pi }{4})=$" :question/worked-solution "Let's remind ourselves of the special trigonometric ratios, as given by the unit circle.\n\n![](images/db/dbf36192ac332dc49ed75278838e989a37ac7d888311be1b8b059a7b59667aa6.png)\n\nFrom the unit circle, we see that the angle $\\frac{\\pi }{4}$ corresponds to the point $(\\frac{\\sqrt{2}}{2},\\frac{\\sqrt{2}}{2}).$\n\nSince the cosine of the angle corresponds to the $x$-coordinate, we have $cos⁡(\\frac{\\pi }{4})=\\frac{\\sqrt{2}}{2}.$"}] [{:db/id #edb/ref 17592186354468 :knowledge-point/_questions [{:db/id #edb/ref 17592186068861 :knowledge-point/id #uuid "a7f04ab7-f6f6-5d01-bfcf-b667e37e4f0b" :knowledge-point/title "Solving a Quadratic Equation When the Solutions Are Irrational"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "029fa0e3-dd36-5f3b-83ad-2cba2e31a6df" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "p+q=20" :db/id #edb/ref 17592186351588} {:answer/id #uuid "0347f6ba-8275-55a4-aac2-653e481c8564" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "p+q=26" :db/id #edb/ref 17592186351595} {:answer/id #uuid "371907b8-8d3b-547a-9416-21dcd94a96bf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "p+q=36" :db/id #edb/ref 17592186352079} {:answer/id #uuid "64af757f-a5f5-5de8-9518-714b14936255" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "p+q=-16" :db/id #edb/ref 17592186352457} {:answer/id #uuid "67a3e342-6a19-5ca4-9745-f0c27bfd5f69" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "p+q=6" :db/id #edb/ref 17592186352490}] :answer-field/correct {:answer/id #uuid "0347f6ba-8275-55a4-aac2-653e481c8564" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "p+q=26" :db/id #edb/ref 17592186351595} :answer-field/id #uuid "6b5c2324-629b-5b3c-99c4-45b9f2afb50e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186354016}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "6913ef2e-5530-525b-8ba5-681a643ef5b4" :question/math-academy-id "q-86404" :question/problem "The equation ${y}^{2}+16=-12y$ can be written in the form $(y+p)^{2}=q.$ Find $p+q.$" :question/worked-solution "First, we move the constant term to the right-hand side, the $-12y$ term to the left-hand side, and complete the square on the left-hand side.\n\n$$\n\\begin{aligned}{y}^{2}+16 & =-12y \\\\ {y}^{2}+12y & =-16 \\\\ {y}^{2}+2\\cdot 6\\cdot y & =-16 \\\\ {y}^{2}+2\\cdot 6\\cdot y+{6}^{2}-{6}^{2} & =-16 \\\\ (y+6)^{2}-{6}^{2} & =-16\\end{aligned}\n$$\n\nThen, we isolate the perfect square:\n\n$$\n\\begin{aligned}(y+6)^{2}-{6}^{2} & =-16 \\\\ (y+6)^{2} & =20\\end{aligned}\n$$\n\nSo, $p=6,q=20,$ and $p+q=26.$"}] [{:db/id #edb/ref 17592186115969 :knowledge-point/_questions [{:db/id #edb/ref 17592186115303 :knowledge-point/id #uuid "a227c7a8-977d-54b0-9409-d364da03656f" :knowledge-point/title "Computing the Mean of a Data Set From the Sum"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "30c20a01-270f-5737-ae9a-84d63a1f7fbf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6.1" :db/id #edb/ref 17592186352015} {:answer/id #uuid "4d3569a6-6912-57e6-a85c-9238f40ddbba" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6.2" :db/id #edb/ref 17592186352272} {:answer/id #uuid "afdfff25-ae14-5a9e-93f1-0dc0a031e75e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5.8" :db/id #edb/ref 17592186353070} {:answer/id #uuid "d5e84888-7272-5abb-8f63-afaab6047bda" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5.9" :db/id #edb/ref 17592186353419} {:answer/id #uuid "fd0af2fb-0e67-5b16-95b0-3d374048e7ce" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6.0" :db/id #edb/ref 17592186353783}] :answer-field/correct {:answer/id #uuid "30c20a01-270f-5737-ae9a-84d63a1f7fbf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6.1" :db/id #edb/ref 17592186352015} :answer-field/id #uuid "af5b7a45-08a6-51e0-b39b-62df1bc74ed8" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186354126}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "1b510547-4334-5503-aa02-8d3585bbd83f" :question/math-academy-id "q-86566" :question/problem "Given a data set with $15$ data points and ${\\sum }_{i=1}^{15}{x}_{i}=91,$ compute $\\overset{―}{x}.$ Round your answer to one decimal place." :question/requires-calculator true :question/worked-solution "If we have a data set that consists of the points ${x}_{1},{x}_{2},…,{x}_{n},$ then the mean is denoted by $\\overset{―}{x}$ and is given by the following formula:\n\n$$\n\\overset{―}{x}=\\frac{1}{n}{\\sum }_{i=1}^{n}{x}_{i}\n$$\n\nSubstituting $n=15$ and ${\\sum }_{i=1}^{15}{x}_{i}=91,$ we get\n\n$$\n\\begin{aligned}\\overset{―}{x} & =\\frac{1}{15}\\cdot 91≈6.1,\\end{aligned}\n$$\n\nwhere we have rounded our answer to one decimal place."}] [{:db/id #edb/ref 17592186354531 :knowledge-point/_questions [{:db/id #edb/ref 17592186083220 :knowledge-point/id #uuid "e49e2595-62a1-595a-8df9-99541bccbdf5" :knowledge-point/title "Calculating Permutations"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "087937ab-4446-5368-9bce-1fce43b01fae" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "480" :db/id #edb/ref 17592186351643} {:answer/id #uuid "62d604ea-fe2e-5a98-826f-4071e1838830" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "910" :db/id #edb/ref 17592186352445} {:answer/id #uuid "99c0e736-b604-56b8-b963-6ab73e357502" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "720" :db/id #edb/ref 17592186352885} {:answer/id #uuid "bbd10b1b-d951-577b-8d78-314446269a90" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "540" :db/id #edb/ref 17592186353161} {:answer/id #uuid "faf4206d-50cc-5507-9c11-16e00ad05a75" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "360" :db/id #edb/ref 17592186353765}] :answer-field/correct {:answer/id #uuid "99c0e736-b604-56b8-b963-6ab73e357502" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "720" :db/id #edb/ref 17592186352885} :answer-field/id #uuid "65e3c440-dfb0-5d0a-a444-7331a8e9d7d0" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186354005}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "1af97a6c-2901-5306-ad12-401b993aaea1" :question/math-academy-id "q-86869" :question/problem "A railway train has $6$ passenger wagons. How many ways can $6$ conductors be distributed among the wagons if one conductor is assigned to each wagon?" :question/worked-solution "There are $6$  conductors to arrange, so there are $6!$ ways of arranging them:\n\n$$\n\\begin{aligned}6! & =6\\times 5\\times \\times 3\\times 2\\times 1 \\\\  & =720.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186354538 :knowledge-point/_questions [{:db/id #edb/ref 17592186115303 :knowledge-point/id #uuid "a227c7a8-977d-54b0-9409-d364da03656f" :knowledge-point/title "Computing the Mean of a Data Set From the Sum"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "19d54d1f-efb8-552f-ab3b-abbbe3b0f8a7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "23.6" :db/id #edb/ref 17592186351794} {:answer/id #uuid "2e2993ee-9bdd-5531-bd61-349cf661922e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "26.4" :db/id #edb/ref 17592186351991} {:answer/id #uuid "56cb2b30-74c2-59e2-8165-0d814424a123" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "25.7" :db/id #edb/ref 17592186352333} {:answer/id #uuid "873b25b6-3d91-5f71-aa9e-c71a735899af" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "26.9" :db/id #edb/ref 17592186352751} {:answer/id #uuid "a7e9a2e7-cbd5-5bb1-942a-2f9b29401f9d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "24.3" :db/id #edb/ref 17592186352993}] :answer-field/correct {:answer/id #uuid "56cb2b30-74c2-59e2-8165-0d814424a123" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "25.7" :db/id #edb/ref 17592186352333} :answer-field/id #uuid "521666e1-0f9d-5046-b997-80486f7e0f9e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186353959}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "81127073-3815-575d-a148-cb1ef2bb975d" :question/math-academy-id "q-86932" :question/problem "Given a data set with $23$ data points and ${\\sum }_{i=1}^{23}{x}_{i}=590,$ compute $\\overset{―}{x}.$ Round your answer to one decimal place." :question/worked-solution "If we have a data set that consists of the points ${x}_{1},{x}_{2},…,{x}_{n},$ then the mean is denoted by $\\overset{―}{x}$ and is given by the following formula:\n\n$$\n\\overset{―}{x}=\\frac{1}{n}{\\sum }_{i=1}^{n}{x}_{i}\n$$\n\nSubstituting $n=23$ and ${\\sum }_{i=1}^{23}{x}_{i}=590,$ we get\n\n$$\n\\begin{aligned}\\overset{―}{x} & =\\frac{1}{23}\\cdot 590≈25.7,\\end{aligned}\n$$\n\nwhere we have rounded our answer to one decimal place."}] [{:db/id #edb/ref 17592186354570 :knowledge-point/_questions [{:db/id #edb/ref 17592186115361 :knowledge-point/id #uuid "b6b41a05-7b11-52b8-a407-af505dffaf10" :knowledge-point/title "Computing the Variance of a Data Set Using the Definition"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0b345208-118e-5652-b22b-098c78c034f4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{27}{3}" :db/id #edb/ref 17592186351665} {:answer/id #uuid "43267825-1da1-549f-b40f-13640900b0c6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "11" :db/id #edb/ref 17592186352185} {:answer/id #uuid "756d7bb4-ec1d-5b8d-9ec1-bdd7581a5796" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "15" :db/id #edb/ref 17592186352597} {:answer/id #uuid "a95b216b-5707-5c1c-9ebf-22afc3b7925d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{37}{3}" :db/id #edb/ref 17592186353003} {:answer/id #uuid "c3e627b0-c925-5cfa-9749-80dbb8d824eb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{49}{3}" :db/id #edb/ref 17592186353260}] :answer-field/correct {:answer/id #uuid "a95b216b-5707-5c1c-9ebf-22afc3b7925d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{37}{3}" :db/id #edb/ref 17592186353003} :answer-field/id #uuid "725eaeaf-88ac-5d74-9ca0-28e3a580f020" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186354029}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "a33c9758-e856-52e3-9ca0-8b4d2b8f793f" :question/math-academy-id "q-87464" :question/problem "What is the variance of the following data set?\n\n$$\n-3,\\,1,\\,-5,\\,-5,\\,2,\\,-8\n$$" :question/worked-solution "If we have a data set that consists of the points ${x}_{1},{x}_{2},…,{x}_{n},$ then the variance of the data set is given by \n\n$$\n{\\sigma }^{2}=\\frac{1}{n}{\\sum }_{i=1}^{n}({x}_{i}-\\overset{―}{x})^{2},\n$$\n\nwhere $\\overset{―}{x}=\\frac{1}{n}{\\sum }_{i=1}^{n}{x}_{i}$ is the mean of the data set.\n\nFirst, we need to compute the mean. There are $n=6$ points in our data set, so the mean is\n\n$$\n\\begin{aligned}\\overset{―}{x} & =\\frac{1}{n}{\\sum }_{i=1}^{n}{x}_{i} \\\\  & =\\frac{1}{6}\\cdot (-3+1-5-5+2-8) \\\\  & =\\frac{1}{6}\\cdot (-18) \\\\  & =-3.\\end{aligned}\n$$\n\nTherefore, the variance is\n\n$$\n\\begin{aligned}{\\sigma }^{2} & =\\frac{1}{n}{\\sum }_{i=1}^{n}({x}_{i}-\\overset{―}{x})^{2} \\\\  & =\\frac{1}{6}[(-3-(-3))^{2}+(1-(-3))^{2}+(-5-(-3))^{2}+(-5-(-3))^{2}+(2-(-3))^{2}+(-8-(-3))^{2}] \\\\  & =\\frac{1}{6}[0+16+4+4+25+25] \\\\  & =\\frac{74}{6} \\\\  & =\\frac{37}{3}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186354579 :knowledge-point/_questions [{:db/id #edb/ref 17592186115363 :knowledge-point/id #uuid "d0040fc1-2134-5eaa-a3e8-6c7a457f75f5" :knowledge-point/title "Computing the Variance of a Data Set Using the Formula"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1d194127-5565-5ea6-9149-fb729c34c731" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186351826} {:answer/id #uuid "249d55e5-0b47-5cef-9a5d-7c2c9ce22b60" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186351903} {:answer/id #uuid "60dc0e33-8bff-54f1-9044-88c8aa366515" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "7" :db/id #edb/ref 17592186352429} {:answer/id #uuid "618c0075-6c89-5ce7-8205-c22c83cbce81" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186352439} {:answer/id #uuid "b0c1e82b-4a36-567b-b964-7eae626ffb2d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "9" :db/id #edb/ref 17592186353080}] :answer-field/correct {:answer/id #uuid "1d194127-5565-5ea6-9149-fb729c34c731" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186351826} :answer-field/id #uuid "e885e1fb-3ce2-57f1-87d2-e78acd0124d5" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186354211}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "6e1e3be6-fb14-565f-8535-3adfd3c2eec9" :question/math-academy-id "q-87606" :question/problem "What is the variance of the following data set?\n\n$$\n1,\\,5,\\,1,\\,2,\\,3,\\,6,\\,1,\\,2,\\,6\n$$" :question/worked-solution "If we have a data set that consists of the points ${x}_{1},{x}_{2},…,{x}_{n},$ then the variance can be computed as\n\n$$\n{\\sigma }^{2}=\\overset{―}{{x}^{2}}-(\\overset{―}{x})^{2},\n$$\n\nwhere $\\overset{―}{x}$ is the mean of the data set and $\\overset{―}{{x}^{2}}$ is the mean of the squares of the points in the data set.\n\nFirst, let's compute $\\overset{―}{x}.$ There are $n=9$ points in our data set, so the mean is\n\n$$\n\\begin{aligned}\\overset{―}{x} & =\\frac{1}{n}{\\sum }_{i=1}^{n}{x}_{i} \\\\  & =\\frac{1}{9}\\cdot (1+5+1+2+3+6+1+2+6) \\\\  & =\\frac{1}{9}\\cdot 27 \\\\  & =3.\\end{aligned}\n$$\n\nNow, let's compute $\\overset{―}{{x}^{2}}.$ Computing the mean of the squares of the points in the data set, we get\n\n$$\n\\begin{aligned}\\overset{―}{{x}^{2}} & =\\frac{1}{n}{\\sum }_{i=1}^{n}{x}_{i}^{2} \\\\  & =\\frac{1}{9}\\cdot ({1}^{2}+{5}^{2}+{1}^{2}+{2}^{2}+{3}^{2}+{6}^{2}+{1}^{2}+{2}^{2}+{6}^{2}) \\\\  & =\\frac{1}{9}\\cdot (1+25+1+4+9+36+1+4+36) \\\\  & =\\frac{1}{9}\\cdot 117 \\\\  & =13.\\end{aligned}\n$$\n\nSo, the variance is\n\n$$\n\\begin{aligned}{\\sigma }^{2} & =\\overset{―}{{x}^{2}}-(\\overset{―}{x})^{2} \\\\  & =13-{(3)}^{2} \\\\  & =13-9 \\\\  & =4.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186354582 :knowledge-point/_questions [{:db/id #edb/ref 17592186115364 :knowledge-point/id #uuid "5a72dae6-2bbf-5e59-b71d-8ee57f589753" :knowledge-point/title "Computing the Standard Deviation of a Data Set"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "427e4e36-8e8f-518b-8674-8478d60112ca" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{\\frac{34}{7}}" :db/id #edb/ref 17592186352177} {:answer/id #uuid "b0adc768-befd-5424-a027-a014f92b2b70" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{\\frac{31}{7}}" :db/id #edb/ref 17592186353078} {:answer/id #uuid "d7ae299a-102c-532a-a8e9-1db85591ce85" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{\\frac{97}{7}}" :db/id #edb/ref 17592186353439} {:answer/id #uuid "f38cadee-21b7-58cf-9f69-13b52ed1e1a6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{\\frac{55}{7}}" :db/id #edb/ref 17592186353697} {:answer/id #uuid "f4963773-d74e-538c-9779-c3ce7fcedcde" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{\\frac{87}{7}}" :db/id #edb/ref 17592186353705}] :answer-field/correct {:answer/id #uuid "427e4e36-8e8f-518b-8674-8478d60112ca" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{\\frac{34}{7}}" :db/id #edb/ref 17592186352177} :answer-field/id #uuid "a48d3bea-1363-5f06-866b-d0c35b8f69dc" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186354103}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "c5f5a511-45ef-5fe1-b914-88ccd3d31b71" :question/math-academy-id "q-87612" :question/problem "What is the standard deviation of the following data set?\n\n$$\n7,\\,3,\\,3,\\,5,\\,1,\\,0,\\,2\n$$" :question/worked-solution "The standard deviation of a data set ${x}_{1},{x}_{2},…,{x}_{n}$ is the square root of the variance:\n\n$$\n\\sigma =\\sqrt{{\\sigma }^{2}}=\\sqrt{\\frac{1}{n}{\\sum }_{i=1}^{n}({x}_{i}-\\overset{―}{x})^{2}}=\\sqrt{\\,\\,\\,\\overset{―}{{x}^{2}}-{(\\overset{―}{x})}^{2}}\n$$\n\nFirst, let's compute $\\overset{―}{x}.$ There are $n=7$ points in our data set, so the mean is\n\n$$\n\\begin{aligned}\\overset{―}{x} & =\\frac{1}{n}{\\sum }_{i=1}^{n}{x}_{i} \\\\  & =\\frac{1}{7}\\cdot (7+3+3+5+1+0+2) \\\\  & =\\frac{1}{7}\\cdot 21 \\\\  & =3.\\end{aligned}\n$$\n\nNow, let's compute $\\overset{―}{{x}^{2}}.$ Computing the mean of the squares of the points in the data set, we get\n\n$$\n\\begin{aligned}\\overset{―}{{x}^{2}} & =\\frac{1}{n}{\\sum }_{i=1}^{n}{x}_{i}^{2} \\\\  & =\\frac{1}{7}\\cdot ({7}^{2}+{3}^{2}+{3}^{2}+{5}^{2}+{1}^{2}+{0}^{2}+{2}^{2}) \\\\  & =\\frac{1}{7}\\cdot (49+9+9+25+1+0+4) \\\\  & =\\frac{97}{7}.\\end{aligned}\n$$\n\nSo, the variance is\n\n$$\n\\begin{aligned}{\\sigma }^{2} & =\\overset{―}{{x}^{2}}-(\\overset{―}{x})^{2} \\\\  & =\\frac{97}{7}-{(3)}^{2} \\\\  & =\\frac{97}{7}-9 \\\\  & =\\frac{97-63}{7} \\\\  & =\\frac{34}{7}.\\end{aligned}\n$$\n\nFinally, the standard deviation is\n\n$$\n\\sigma =\\sqrt{{\\sigma }^{2}}=\\sqrt{\\frac{34}{7}}.\n$$"}] [{:db/id #edb/ref 17592186354583 :knowledge-point/_questions [{:db/id #edb/ref 17592186115364 :knowledge-point/id #uuid "5a72dae6-2bbf-5e59-b71d-8ee57f589753" :knowledge-point/title "Computing the Standard Deviation of a Data Set"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1715cab9-06ff-5775-8221-04bf4db52149" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{\\frac{44}{5}}" :db/id #edb/ref 17592186351771} {:answer/id #uuid "2286aa66-4634-5f2a-86f3-a4cdcce1fc98" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{\\frac{124}{5}}" :db/id #edb/ref 17592186351878} {:answer/id #uuid "44f1270a-9110-58f6-8fa9-8ef77b30ed2b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{\\frac{48}{5}}" :db/id #edb/ref 17592186352202} {:answer/id #uuid "56928ff8-cc5a-56f5-92ac-4b2a6100b8b9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{\\frac{41}{5}}" :db/id #edb/ref 17592186352330} {:answer/id #uuid "ddb6a08a-013d-586d-a88a-e2d2b3e0595d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{\\frac{37}{5}}" :db/id #edb/ref 17592186353494}] :answer-field/correct {:answer/id #uuid "1715cab9-06ff-5775-8221-04bf4db52149" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{\\frac{44}{5}}" :db/id #edb/ref 17592186351771} :answer-field/id #uuid "c7a93a33-8e48-5ada-8662-5f5d2efbde64" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186354160}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "ab0de973-6daf-5f45-9069-960a74229aa4" :question/math-academy-id "q-87613" :question/problem "What is the standard deviation of the following data set?\n\n$$\n1,\\,1,\\,5,\\,4,\\,9\n$$" :question/worked-solution "The standard deviation of a data set ${x}_{1},{x}_{2},…,{x}_{n}$ is the square root of the variance:\n\n$$\n\\sigma =\\sqrt{{\\sigma }^{2}}=\\sqrt{\\frac{1}{n}{\\sum }_{i=1}^{n}({x}_{i}-\\overset{―}{x})^{2}}=\\sqrt{\\,\\,\\,\\overset{―}{{x}^{2}}-{(\\overset{―}{x})}^{2}}\n$$\n\nFirst, let's compute $\\overset{―}{x}.$ There are $n=5$ points in our data set, so the mean is\n\n$$\n\\begin{aligned}\\overset{―}{x} & =\\frac{1}{n}{\\sum }_{i=1}^{n}{x}_{i} \\\\  & =\\frac{1}{5}\\cdot (1+1+5+4+9) \\\\  & =\\frac{1}{5}\\cdot 20 \\\\  & =4.\\end{aligned}\n$$\n\nNow, let's compute $\\overset{―}{{x}^{2}}.$ Computing the mean of the squares of the points in the data set, we get\n\n$$\n\\begin{aligned}\\overset{―}{{x}^{2}} & =\\frac{1}{n}{\\sum }_{i=1}^{n}{x}_{i}^{2} \\\\  & =\\frac{1}{5}\\cdot ({1}^{2}+{1}^{2}+{5}^{2}+{4}^{2}+{9}^{2}) \\\\  & =\\frac{1}{5}\\cdot (1+1+25+16+81) \\\\  & =\\frac{124}{5}.\\end{aligned}\n$$\n\nSo, the variance is\n\n$$\n\\begin{aligned}{\\sigma }^{2} & =\\overset{―}{{x}^{2}}-(\\overset{―}{x})^{2} \\\\  & =\\frac{124}{5}-{(4)}^{2} \\\\  & =\\frac{124}{5}-16 \\\\  & =\\frac{124-80}{5} \\\\  & =\\frac{44}{5}.\\end{aligned}\n$$\n\nFinally, the standard deviation is\n\n$$\n\\sigma =\\sqrt{{\\sigma }^{2}}=\\sqrt{\\frac{44}{5}}.\n$$"}] [{:db/id #edb/ref 17592186394779 :knowledge-point/_questions [{:db/id #edb/ref 17592186157437 :knowledge-point/id #uuid "3758cf02-ba4b-539a-bc61-8c2030ff6f6f" :knowledge-point/title "Solving an Exponential Equation by Factoring"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ef56dae1-235e-58a4-9d49-dac58019c11c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-5" :db/id #edb/ref 17592186394781} {:answer/id #uuid "5d542604-cc75-5fe8-a314-152f5e0d0baf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "10" :db/id #edb/ref 17592186394782} {:answer/id #uuid "98750137-8ecd-58a9-830f-28a32bdedfa5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-10" :db/id #edb/ref 17592186394783} {:answer/id #uuid "d7e12eec-8e62-581b-b20f-14c8b66d8602" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "15" :db/id #edb/ref 17592186394784} {:answer/id #uuid "57fa678f-41a4-5b0a-9cfb-0034cbdf2533" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186394785}] :answer-field/correct {:answer/id #uuid "57fa678f-41a4-5b0a-9cfb-0034cbdf2533" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186394785} :answer-field/id #uuid "e16451bc-a0a9-548c-ba07-f9abe1416b11" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186394780}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "d3d7afbe-c052-55bc-910e-6663c48abfcd" :question/math-academy-id "q-88459" :question/problem "What is the product of solutions of the equation $2{x}^{2}\\cdot {2}^{x-1}+12x\\cdot {2}^{x-1}+10\\cdot {2}^{x-1}=0?$" :question/worked-solution "First, we factor the equation:\n\n$$\n\\begin{aligned}2{x}^{2}\\cdot {2}^{x-1}+12x\\cdot {2}^{x-1}+10\\cdot {2}^{x-1} & =0 \\\\ (2{x}^{2}+12x+10){2}^{x-1} & =0\\end{aligned}\n$$\n\nWe can now apply the zero product property, which states that $ab=0$ if and only if $a=0$ or $b=0.$ This gives us two equations,\n\n$$\n2{x}^{2}+12x+10=0\\,\\text{and}\\,{2}^{x-1}=0.\n$$\n\nWe now solve each of these equations separately.\n\n- The equation $2{x}^{2}+12x+10=0$ can be factored as\n\n$$\n2(x+1)(x+5)=0,\n$$\n\nwhich leads to the solutions $x=-5,-1.$\n\n- The equation ${2}^{x-1}=0$ has no solutions because ${2}^{x-1}$ is positive for every real number $x.$\n\nTherefore, the original equation has the solutions $x=-5,-1,$ and their product is $(-5)\\cdot (-1)=5.$"}] [{:db/id #edb/ref 17592186172609 :knowledge-point/_questions [{:db/id #edb/ref 17592186172023 :knowledge-point/id #uuid "3e6159dd-c12e-5882-be17-815b4cc9ae52" :knowledge-point/title "Finding the Roots of a Transformed Radical Function With an Odd Index"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "720ce82d-536f-52e4-a924-9dc9994eace0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=-\\frac{12}{5}" :db/id #edb/ref 17592186355669} {:answer/id #uuid "9c357947-0335-531e-b792-b57594efd6eb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=2" :db/id #edb/ref 17592186356049} {:answer/id #uuid "a14eace9-3890-5be9-b73b-56227bff4efd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=3" :db/id #edb/ref 17592186356096} {:answer/id #uuid "a60dca9c-200d-526d-95e8-ae5ecfbe0621" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=\\frac{12}{5}" :db/id #edb/ref 17592186356135} {:answer/id #uuid "d317e9da-0cf9-523f-af7e-fdda914c3077" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The function has no roots" :db/id #edb/ref 17592186356506}] :answer-field/correct {:answer/id #uuid "a14eace9-3890-5be9-b73b-56227bff4efd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=3" :db/id #edb/ref 17592186356096} :answer-field/id #uuid "7a0524cb-a296-51c4-96c8-ba5fc5980ac8" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186357132}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "1da47db3-4817-571a-b409-df8d62fa2bb2" :question/math-academy-id "q-92875" :question/problem "Find the root of $f(x)=\\sqrt[3]{5x+12}-3.$" :question/worked-solution "To find the root of $f(x),$  we must solve $f(x)=0:$\n\n$$\n\\sqrt[3]{5x+12}-3=0\n$$\n\nWe solve this equation by making $x$ the subject, as follows:\n\n$$\n\\begin{aligned}\\sqrt[3]{5x+12}-3 & =0 \\\\ \\sqrt[3]{5x+12} & =3 \\\\ (\\sqrt[3]{5x+12})^{3} & ={3}^{3} \\\\ 5x+12 & =27 \\\\ 5x & =15 \\\\ x & =3\\end{aligned}\n$$\n\nTherefore, the root of $f(x)$ is $x=3.$"}] [{:db/id #edb/ref 17592186395363 :knowledge-point/_questions [{:db/id #edb/ref 17592186068814 :knowledge-point/id #uuid "52e11164-1929-594d-9f9e-460f6469421d" :knowledge-point/title "Graphing a Stretched Negative Reciprocal Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "cc019953-ecf5-53ce-9d3b-5be9dc928b8b" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/76/76d779da22082439eb40586ddbeb325368b1f49f15fef3158ebaa0eee90f4d84.png" :db/id #edb/ref 17592186395365} {:answer/id #uuid "d9a9fcde-d13a-59ef-9cbd-e86e49dc3376" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/64/647f80eeaea16048c9ba2677624ff6f3393183f6ea0df1529defa5fd55881f52.png" :db/id #edb/ref 17592186395366} {:answer/id #uuid "384d2a96-99ce-5ac9-943e-ea352fc9b0c8" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/a3/a32495fcca947d01cf8d3218fc5cfc0cce083a34e6fb6b629d92ba9e47039a6e.png" :db/id #edb/ref 17592186395367} {:answer/id #uuid "76b6a6b4-55f1-58d8-83a3-1765de08f84e" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/66/6681008fc3e783b64e6bce7e7e0e9c72beb8761fc8cebb35926d528aac076bd9.png" :db/id #edb/ref 17592186395368} {:answer/id #uuid "5a98192b-2704-5d37-b470-494583da6584" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/d5/d5d93e12275