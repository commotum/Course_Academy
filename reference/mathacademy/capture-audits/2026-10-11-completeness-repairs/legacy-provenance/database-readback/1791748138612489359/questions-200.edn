6045498 :db/ident :answer.type/math} :answer/value "n=-2" :db/id #edb/ref 17592186251736} {:answer/id #uuid "9180c1c8-1f7c-540a-8d44-d585577c0e83" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "n=4" :db/id #edb/ref 17592186251795} {:answer/id #uuid "c3f59c7d-fd33-58d7-ae00-8babf85da183" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "n=\\pm 2" :db/id #edb/ref 17592186252288}] :answer-field/correct {:answer/id #uuid "78c0bab0-9b03-5269-8dab-8e7ea4106e4e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "n=\\pm 4" :db/id #edb/ref 17592186251554} :answer-field/id #uuid "e38d674a-89c9-50fe-9a20-d74c11c871f3" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186253196}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "0c7b9ea7-cded-56a3-a2f3-1334f92c0300" :question/math-academy-id "q-11726" :question/problem "If $P=[\\begin{aligned}n & -8 \\\\ -2 & n\\end{aligned}]$ is a singular matrix, calculate the value(s) of $n.$" :question/worked-solution "The matrix $P$ is singular if and only if $det(P)=0.$ Calculating the determinant, we get\n\n$$\n\\begin{aligned}det(P) & =n\\cdot n-(-2)\\cdot (-8) \\\\  & ={n}^{2}-16.\\end{aligned}\n$$\n\nNow, we set the determinant equal to $0$ and solve for $n:$\n\n$$\n\\begin{aligned}{n}^{2}-16 & =0 \\\\ {n}^{2} & =16 \\\\ n & =\\pm 4\\end{aligned}\n$$\n\nTherefore, the values of $n$ are $n=\\pm 4.$"}] [{:db/id #edb/ref 17592186386862 :knowledge-point/_questions [{:db/id #edb/ref 17592186110585 :knowledge-point/id #uuid "46e1513d-0944-5c09-8a7e-e1d9ae81bae5" :knowledge-point/title "Graphing the Inverse Tangent Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "096a914e-ca68-5949-a34e-4616044de5bb" :answer/type {:db/id #edb/ref 17592186045497 