#{[{:db/id #edb/ref 17592186373785 :knowledge-point/_questions [{:db/id #edb/ref 17592186100951 :knowledge-point/id #uuid "82a9b23c-4c79-56cd-9761-79d0ee22646d" :knowledge-point/title "Identifying Solutions to Initial Value Problems"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "60b15d99-5f73-5d71-a0a0-49f9be9df65d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{2}{3}" :db/id #edb/ref 17592186373787} {:answer/id #uuid "3cefcde2-3aa5-51a2-8f0c-24c6172e631c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186373788} {:answer/id #uuid "243ba24f-c088-5741-b1dc-797cc0c88bb6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186373789} {:answer/id #uuid "3ab4b002-dd36-598f-8102-522b7e368735" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{2}" :db/id #edb/ref 17592186373790} {:answer/id #uuid "4a73df82-8e85-5bb1-90fc-89e5be58e836" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186373791}] :answer-field/correct {:answer/id #uuid "3cefcde2-3aa5-51a2-8f0c-24c6172e631c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186373788} :answer-field/id #uuid "e02b7c91-76ce-53ed-b342-163951d05f8f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186373786}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "8abc10be-3eb5-5e2c-9a94-244a431b287a" :question/math-academy-id "q-141112" :question/problem "Consider the following initial value problem\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}=-\\frac{y}{x},\\,y(-2)=-1.\n$$\n\nYou're given that $y=\\frac{A}{x}$ is the solution to this initial value problem. What is the value of the constant $A?$" :question/worked-solution "We're given that $y=\\frac{A}{x}$ is the solution to the initial value problem. Therefore, it must satisfy the differential equation *and* the initial condition $y(-2)=-1.$\n\nSubstituting the initial condition $y(-2)=-1$ into our solution and solving for $A,$ we get\n\n$$\n\\begin{aligned}y & =\\frac{A}{x} \\\\ -1 & =\\frac{A}{(-2)} \\\\ A & =2.\\end{aligned}\n$$\n\nTherefore, the solution to the initial value problem is\n\n$$\ny=\\frac{2}{x}.\n$$"}] [{:db/id #edb/ref 17592186398452 :knowledge-point/_questions [{:db/id #edb/ref 17592186100951 :knowledge-point/id #uuid "82a9b23c-4c79-56cd-9761-79d0ee22646d" :knowledge-point/title "Identifying Solutions to Initial Value Problems"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "89027aec-d449-5dca-8830-9b39f9c5fbba" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "e+1" :db/id #edb/ref 17592186398454} {:answer/id #uuid "d1591666-636c-5480-9f22-08f9eeec3613" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2e-1" :db/id #edb/ref 17592186398455} {:answer/id #uuid "b092bcb2-de91-5a2a-9a1c-b1cf1cdf0b26" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186398456} {:answer/id #uuid "4f0a5d44-77c5-5b01-9db7-d212e6e5f858" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "e-1" :db/id #edb/ref 17592186398457} {:answer/id #uuid "408ad86d-b3e2-50fe-ba49-d6d10e8b89e9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186398458}] :answer-field/correct {:answer/id #uuid "4f0a5d44-77c5-5b01-9db7-d212e6e5f858" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "e-1" :db/id #edb/ref 17592186398457} :answer-field/id #uuid "5f0f43ae-19bf-5c26-8ca2-6e01020ad358" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186398453}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "e96414b2-2fe9-598e-bc15-f2c64a7b0633" :question/math-academy-id "q-141115" :question/problem "Consider the following initial value problem\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}={e}^{-y},\\,y(1)=1.\n$$\n\nYou're given that $y=\\operatorname{ln}⁡(A+x)$ is the solution to this initial value problem. What is the value of the constant $A?$" :question/worked-solution "We're given that $y=\\operatorname{ln}⁡(A+x)$ is the solution to the initial value problem. Therefore, it must satisfy the differential equation *and* the initial condition $y(1)=1.$\n\nSubstituting the initial condition $y(1)=1$ into our solution and solving for $A,$ we get\n\n$$\n\\begin{aligned}y & =\\operatorname{ln}⁡(A+x) \\\\ 1 & =\\operatorname{ln}⁡(A+1) \\\\ {e}^{1} & ={e}^{\\operatorname{ln}⁡(A+1)} \\\\ e & =A+1 \\\\ A & =e-1.\\end{aligned}\n$$\n\nTherefore, the solution to the initial value problem is\n\n$$\ny=\\operatorname{ln}⁡(e-1+x).\n$$"}] [{:db/id #edb/ref 17592186400909 :knowledge-point/_questions [{:db/id #edb/ref 17592186129253 :knowledge-point/id #uuid "4d48e2a0-1a76-5eec-a98c-4a7eb16f70cb" :knowledge-point/title "Identifying Multiplicity of a Root Given a Graph"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3559bdb9-c007-500b-83db-63f2d91cd407" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$x=-3$ is a multiple root of odd multiplicity" :db/id #edb/ref 17592186400911} {:answer/id #uuid "f1984a87-93e4-523e-80b4-a37c28b7dc5b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$x=-3$ is a multiple root of even multiplicity" :db/id #edb/ref 17592186400912} {:answer/id #uuid "3f15fef9-83c3-50e8-980b-72c67ab596d8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$x=-3$ is a simple root of even multiplicity" :db/id #edb/ref 17592186400913} {:answer/id #uuid "f52c0001-2df6-56e0-ae3c-2dca7d79a58b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$x=-3$ is not a root of $p(x)$" :db/id #edb/ref 17592186400914} {:answer/id #uuid "d7950f6f-fd87-5dac-ba8c-650fe8a19888" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$x=-3$ is a simple root" :db/id #edb/ref 17592186400915}] :answer-field/correct {:answer/id #uuid "d7950f6f-fd87-5dac-ba8c-650fe8a19888" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$x=-3$ is a simple root" :db/id #edb/ref 17592186400915} :answer-field/id #uuid "5806f142-c711-5da8-b1d4-68c8001a3f1f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186400910}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "6ab70a1a-e04b-524f-9866-e86f88144126" :question/math-academy-id "q-141140" :question/problem "![](images/b3/b362831ba2248e03537551c412ae7537646dcd09f0d00a598905f0d52a258da9.png)\n\nA part of the graph of a polynomial $p(x)$ is given above. Which of the following statements is true?" :question/worked-solution "| Multiplicity | Sketch | Sketch |\n| --- | --- | --- |\n| $1$ \n\n (Simple Root) | ![](images/5a/5a0221f93c65a1eeb4503604a558a6da81c4c7af81c2c52cc35ecf3d189fe99f.png) | ![](images/d5/d556b4edf39181eebb7ec87c344d6f657a6875ecd2745405eaf5351ccaff6f96.png) |\n| $>1$ \n\n (Multiple Root) \n\n Even | ![](images/9d/9d14c2588da2ee9c9f5bbc32a70791146bed609ea0d6d5912aeaa2edab02e2d7.png) | ![](images/28/28ad9248a9a509e3a44937d0438fb2366f550a22360d01b9b6a29bcac41357e8.png) |\n| $>1$ \n\n (Multiple Root) \n\n Odd | ![](images/3a/3ae81378cb3c918dd5b7730519eb5a91e949f88eef9f03f4910f4ab8fb3cd5a9.png) | ![](images/95/9506a7ce4031f1f6244c0110c3235f66ea5652bb53548a032732869cf21f5997.png) |\n\nIt's possible to determine information regarding the multiplicities of the roots of a polynomial from its graph.\n\n- If the graph intersects the $x$-axis but is *not* tangent to the $x$-axis at $x=a,$ we have a *simple* root $x=a.$\n\n- If the graph is *tangent* to the $x$-axis at $x=a,$ we have a *multiple* root $x=a.$ Furthermore:\n\n- If the graph touches the $x$-axis and reverses direction at $x=a,$ the multiplicity of a root $x=a$ is *even*.\n\n- If the graph crosses the $x$-axis at $x=a,$ the multiplicity of a root $x=a$ is *odd*.\n\nIn our case, the graph is *not* tangent to the $x$-axis at $x=-3.$ Therefore, $x=-3$ is a *simple* root."}] [{:db/id #edb/ref 17592186272221 :knowledge-point/_questions [{:db/id #edb/ref 17592186129253 :knowledge-point/id #uuid "4d48e2a0-1a76-5eec-a98c-4a7eb16f70cb" :knowledge-point/title "Identifying Multiplicity of a Root Given a Graph"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7a762869-8c41-5b99-945a-904933273d75" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$x=6$ is a simple root" :db/id #edb/ref 17592186270354} {:answer/id #uuid "8e0792d1-d0d7-58d4-acd0-2928fe61d064" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$x=6$ is a multiple root of odd multiplicity" :db/id #edb/ref 17592186270498} {:answer/id #uuid "a19bd95b-bbd6-55a2-9a46-010b458abb4e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$x=6$ is not a root of $p(x)$" :db/id #edb/ref 17592186270704} {:answer/id #uuid "c3b75751-2d73-5678-8386-167ce0d8f782" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$x=6$ is a simple root of even multiplicity" :db/id #edb/ref 17592186270997} {:answer/id #uuid "f84b8666-1809-58bd-bfe6-8ab9488eb61f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$x=6$ is a multiple root of even multiplicity" :db/id #edb/ref 17592186271447}] :answer-field/correct {:answer/id #uuid "f84b8666-1809-58bd-bfe6-8ab9488eb61f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$x=6$ is a multiple root of even multiplicity" :db/id #edb/ref 17592186271447} :answer-field/id #uuid "eb90200a-e2bb-5eaf-ba24-af1df789d82c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186271925}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "86545112-71e2-5627-8c9c-5a320524ae07" :question/math-academy-id "q-141144" :question/problem "![](images/40/4092c0852a573a0add69c6fb7b55f393d0767a5b6a2282a10194ea27cb1be9c4.png)\n\nA part of the graph of a polynomial $p(x)$ is shown above. Which of the following statements is true?" :question/worked-solution "| Multiplicity | Sketch | Sketch |\n| --- | --- | --- |\n| $1$ \n\n (Simple Root) | ![](images/5a/5a0221f93c65a1eeb4503604a558a6da81c4c7af81c2c52cc35ecf3d189fe99f.png) | ![](images/d5/d556b4edf39181eebb7ec87c344d6f657a6875ecd2745405eaf5351ccaff6f96.png) |\n| $>1$ \n\n (Multiple Root) \n\n Even | ![](images/9d/9d14c2588da2ee9c9f5bbc32a70791146bed609ea0d6d5912aeaa2edab02e2d7.png) | ![](images/28/28ad9248a9a509e3a44937d0438fb2366f550a22360d01b9b6a29bcac41357e8.png) |\n| $>1$ \n\n (Multiple Root) \n\n Odd | ![](images/3a/3ae81378cb3c918dd5b7730519eb5a91e949f88eef9f03f4910f4ab8fb3cd5a9.png) | ![](images/95/9506a7ce4031f1f6244c0110c3235f66ea5652bb53548a032732869cf21f5997.png) |\n\nIt's possible to determine information regarding the multiplicities of the roots of a polynomial from its graph.\n\n- If the graph intersects the $x$-axis but is *not* tangent to the $x$-axis at $x=a,$ we have a *simple* root $x=a.$\n\n- If the graph is *tangent* to the $x$-axis at $x=a,$ we have a *multiple* root $x=a.$ Furthermore:\n\n- If the graph touches the $x$-axis and reverses direction at $x=a,$ the multiplicity of a root $x=a$ is *even*.\n\n- If the graph crosses the $x$-axis at $x=a,$ the multiplicity of a root $x=a$ is *odd*.\n\nIn our case, the graph is *tangent* to the $x$-axis at $x=6.$ So, $x=6$ is a *multiple* root. \n\nFurthermore, the graph touches the $x$-axis and reverses direction at $x=6.$ So, $x=6$ has *even* multiplicity.\n\nTherefore, $x=6$ is a multiple root of even multiplicity."}] [{:db/id #edb/ref 17592186400916 :knowledge-point/_questions [{:db/id #edb/ref 17592186068825 :knowledge-point/id #uuid "fc419917-fe34-5bf9-8bf0-1b022fce11ff" :knowledge-point/title "Solving a \"Less Than\" Inequality Given the Graph of the Corresponding Parabola"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c694a7cb-1273-5aef-bab1-b00405cb06a8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-5<x<1" :db/id #edb/ref 17592186400918} {:answer/id #uuid "19263d22-de7b-5ef3-9798-b98080320005" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$x<-5$ or    $x>-1$" :db/id #edb/ref 17592186400919} {:answer/id #uuid "ee071af0-120e-5c4a-b72d-0c54e26d3687" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x>5" :db/id #edb/ref 17592186400920} {:answer/id #uuid "395b066b-730c-5a11-889e-cc63987fd8a1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$x<-1$ or    $x>5$" :db/id #edb/ref 17592186400921} {:answer/id #uuid "3271e9c8-ddaf-5be7-852f-5b3fd22e072b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1<x<5" :db/id #edb/ref 17592186400922}] :answer-field/correct {:answer/id #uuid "19263d22-de7b-5ef3-9798-b98080320005" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$x<-5$ or    $x>-1$" :db/id #edb/ref 17592186400919} :answer-field/id #uuid "7f3297c0-8b61-583d-8e5e-b17352fc3208" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186400917}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "66cebf22-0b82-5cf0-a87d-5c8eaa25290f" :question/math-academy-id "q-141187" :question/problem "![](images/46/46edcf2265f41b8fac7931802875e1b9849006834b3509a186ffc7acb510959f.png)\n\nGiven the graph above, solve the inequality $(-x-5)(x+1)<0.$" :question/worked-solution "Notice that our inequality\n\n$$\n(-x-5)(x+1)<0,\n$$\n\nis a \"*less than*\" inequality. Therefore, we need to find the values of $x$ for which the parabola  \n\n$$\ny=(-x-5)(x+1)\n$$\n\n  \n\nis *below* the $x$-axis. We mark these values of $x$ in blue in the diagram below.\n\n![](images/e8/e830af773829b1712c6a87955e74411b6ad9921ae1aea58029ca968ab354c0f1.png)\n\n \n\nSo, the solution to the inequality is $x<-5$ or    $x>-1.$"}] [{:db/id #edb/ref 17592186272254 :knowledge-point/_questions [{:db/id #edb/ref 17592186059662 :knowledge-point/id #uuid "69e91ce7-259a-5a11-bb79-7e6ad7ea86d4" :knowledge-point/title "Simplifying Expressions in Degrees Using the Sum and Difference Formulas"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "12266a51-a7c9-5483-94da-be9664d1b481" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{\\sqrt{2}(\\operatorname{sin}⁡x+\\operatorname{cos}⁡x)}{2}" :db/id #edb/ref 17592186269429} {:answer/id #uuid "18eff7de-8c89-5305-88dc-9781c493dbed" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{3}\\operatorname{sin}⁡x-\\operatorname{cos}⁡x}{2}" :db/id #edb/ref 17592186269477} {:answer/id #uuid "9784d4b6-191f-5d3c-bfd0-0ff7a24f4c76" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{\\operatorname{sin}⁡x+\\sqrt{3}\\operatorname{cos}⁡x}{2}" :db/id #edb/ref 17592186270602} {:answer/id #uuid "b5aefcfb-4daa-5443-aaa4-83730b1b02a2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\operatorname{sin}⁡x-\\sqrt{3}\\operatorname{cos}⁡x}{2}" :db/id #edb/ref 17592186270882} {:answer/id #uuid "f3d99ef5-ddef-5389-82d4-95a6ce517307" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{2}(\\operatorname{sin}⁡x+\\operatorname{cos}⁡x)}{2}" :db/id #edb/ref 17592186271407}] :answer-field/correct {:answer/id #uuid "9784d4b6-191f-5d3c-bfd0-0ff7a24f4c76" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{\\operatorname{sin}⁡x+\\sqrt{3}\\operatorname{cos}⁡x}{2}" :db/id #edb/ref 17592186270602} :answer-field/id #uuid "a0f40e9a-9d94-55f1-89bf-5ae1a4030b7c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186271801}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "b6e1f817-7c7e-51c8-bd09-e888759f9be3" :question/math-academy-id "q-141275" :question/problem "$\\operatorname{sin}⁡(x-{120}^{∘})=$" :question/worked-solution "Recall the difference formula for sine:\n\n$$\n\\operatorname{sin}⁡(u-v)=\\operatorname{sin}⁡u\\operatorname{cos}⁡v-\\operatorname{cos}⁡u\\operatorname{sin}⁡v\n$$\n\nApplying the difference formula for sine with $u=x$ and $v={120}^{∘},$ we get\n\n$$\n\\begin{aligned}\\operatorname{sin}⁡(x-{120}^{∘}) & =\\operatorname{sin}⁡x\\operatorname{cos}⁡{120}^{∘}-\\operatorname{cos}⁡x\\operatorname{sin}⁡{120}^{∘} \\\\  & =\\operatorname{sin}⁡x\\cdot (-\\frac{1}{2})-\\operatorname{cos}⁡x\\cdot (\\frac{\\sqrt{3}}{2}) \\\\  & =-\\frac{\\operatorname{sin}⁡x}{2}-\\frac{\\sqrt{3}\\operatorname{cos}⁡x}{2} \\\\  & =-\\frac{\\operatorname{sin}⁡x+\\sqrt{3}\\operatorname{cos}⁡x}{2}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186272256 :knowledge-point/_questions [{:db/id #edb/ref 17592186059662 :knowledge-point/id #uuid "69e91ce7-259a-5a11-bb79-7e6ad7ea86d4" :knowledge-point/title "Simplifying Expressions in Degrees Using the Sum and Difference Formulas"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "012c6c54-c102-5db4-8d24-caf1dec68123" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\operatorname{cos}⁡x" :db/id #edb/ref 17592186269269} {:answer/id #uuid "55dd97d3-3e02-5362-84db-9281bfaf98c8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{cos}⁡x" :db/id #edb/ref 17592186270029} {:answer/id #uuid "60c3ef61-d3ea-5891-85a9-bc3230333d6c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{3}\\operatorname{cos}⁡x-\\operatorname{sin}⁡x}{2}" :db/id #edb/ref 17592186270123} {:answer/id #uuid "7837e062-26e0-54eb-9c88-937b73a56868" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{\\sqrt{2}(\\operatorname{sin}⁡x+\\operatorname{cos}⁡x)}{2}" :db/id #edb/ref 17592186270334} {:answer/id #uuid "9974f52a-a24a-58ca-913f-99e237c9a5bc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\operatorname{sin}⁡x" :db/id #edb/ref 17592186270618}] :answer-field/correct {:answer/id #uuid "9974f52a-a24a-58ca-913f-99e237c9a5bc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\operatorname{sin}⁡x" :db/id #edb/ref 17592186270618} :answer-field/id #uuid "bea83195-85b8-5a62-ae80-a9df9097b16d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186271856}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "dd3a924d-681c-501c-bf69-7fbcdc5b