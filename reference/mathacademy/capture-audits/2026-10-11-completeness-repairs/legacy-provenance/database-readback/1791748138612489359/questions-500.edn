 Cosine"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "29053ade-ca82-5bab-aa52-fc1416a92dca" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=\\frac{\\pi }{2}+n\\frac{\\pi }{2}" :db/id #edb/ref 17592186278956} {:answer/id #uuid "327f7f81-fa2d-554c-9d59-a0238b6b5c56" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=\\frac{3\\pi }{2}+2n\\pi " :db/id #edb/ref 17592186279034} {:answer/id #uuid "381d375a-d282-5558-af67-c3f309ae7ea8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=\\frac{\\pi }{2}+n\\pi " :db/id #edb/ref 17592186279080} {:answer/id #uuid "64e63cbb-8403-5bbf-a00e-fae8cd3dad71" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=n\\frac{\\pi }{2}" :db/id #edb/ref 17592186279509} {:answer/id #uuid "e0ad06ee-b6ca-5ac4-b103-4ef2e8096fc7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=\\frac{\\pi }{2}+2n\\pi " :db/id #edb/ref 17592186280579}] :answer-field/correct {:answer/id #uuid "e0ad06ee-b6ca-5ac4-b103-4ef2e8096fc7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=\\frac{\\pi }{2}+2n\\pi " :db/id #edb/ref 17592186280579} :answer-field/id #uuid "f7af4244-b19c-5140-981a-ed78c0638c37" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186281275}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "d9834690-2d79-5a22-9e52-3ff6dc17940f" :question/math-academy-id "q-16227" :question/problem "What is the general solution to the equation $\\operatorname{sin}⁡x=1?$ Assume that $n$ is an integer." :question/worked-solution "First, we find the principal value:\n\n$$\n{x}_{1}=\\operatorname{arcsin}⁡(1)=\\frac{\\pi }{2}\n$$\n\nThe sine function has a period of $2\\pi .$ Hence, the general solution for the given equation is\n\n$$\nx=\\frac{\\pi }{2}+2n\\pi .\n$$"}] [{:db/id #edb/ref 17592186389291 :knowledge-point/_questions [{:db/id #edb/ref 17592186171914 :knowledge-point/id #uuid "0c2c755c-59e0-5048-b20c-507f13fce441" :knowledge-point/title "Geometric Interpretation of the Roots of Unity"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "36267af7-3b1c-53e8-8254-4652eb19b61b" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/51/51ac4ad5bbc626c58ddbb6efd8c06bb665ef0849591dd846dd959756ea6e41b6.png" :db/id #edb/ref 17592186389293} {:answer/id #uuid "ae188fc3-ca39-5ffc-ab80-585fcf2025f0" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/73/73ac4fabf63cec9e0639bd2213bf2c4df4030ae0c143e0747ebde469418459d6.png" :db/id #edb/ref 17592186389294} {:answer/id #uuid "c2b96a31-29a9-5690-9d1f-f4a0e63422a3" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/71/717710d10e5f9919aa44a9e499509e19790e630027693f3dd72d8b2fd7caee2f.png" :db/id #edb/ref 17592186389295} {:answer/id #uuid "a562f990-eae4-516e-aae9-54b81af106e2" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/40/40af68e4d6e32b333a539fe33dc51ab52a77de3b8db12f930986e468cb033378.png" :db/id #edb/ref 17592186389296} {:answer/id #uuid "b2fc1dee-e469-53cf-9212-2e5f92188e36" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/ea/ea44776f2632c23a4f52f50282d69492d2948722590ca5dbcaff619ae5079f7e.png" :db/id #edb/ref 17592186389297}] :answer-field/correct {:answer/id #uuid "36267af7-3b1c-53e8-8254-4652eb19b61b" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/51/51ac4ad5bbc626c58ddbb6efd8c06bb665ef0849591dd846dd959756ea6e41b6.png" :db/id #edb/ref 17592186389293} :answer-field/id #uuid "cb58a3f9-1543-53b6-8d35-b52ef0687fb6" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186389292}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "07999dfb-3631-5698-9dcf-dad1b47402f1" :question/math-academy-id "q-162310" :question/problem "Which of the following diagrams shows all the $8$th roots of unity?" :question/worked-solution "Geometrically, the $8$th roots of unity have the following properties:\n\n- all of them lie on the unit circle centered in the origin,\n\n- one of the roots is $1,$ corresponding to the point $(1,0)$ on the complex plane,\n\n- the roots form a regular octagon (regular $8$-sided polygon).\n\nTherefore, the correct answer is the following:\n\n![](images/51/51ac4ad5bbc626c58ddbb6efd8c06bb665ef0849591dd846dd959756ea6e41b6.png)"}] [{:db/id #edb/ref 17592186281475 :knowledge-point/_questions [{:db/id #edb/ref 17592186100822 :knowledge-point/id #uuid "ff04ceeb-c9f6-5562-b494-204eb62d7f5b" :knowledge-point/title "Finding the Coordinates of the Points of Intersection of a Trigonometric Curve and a Horizontal Line"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "08f2c6ea-935c-52be-abaa-4c332cc0fd57" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=-\\frac{\\pi }{3}+n\\pi " :db/id #edb/ref 17592186278677} {:answer/id #uuid "17605140-bedc-5fff-9676-0d338f2dc7c8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=-\\frac{\\pi }{4}+n\\pi " :db/id #edb/ref 17592186278801} {:answer/id #uuid "1c12e4f2-ff20-5fbd-9fc0-8ab5b451aaad" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=\\frac{\\pi }{2}+n\\pi " :db/id #edb/ref 17592186278849} {:answer/id #uuid "31de253a-4fc8-52c3-9e70-43605efad23c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=\\frac{\\pi }{4}+n\\pi " :db/id #edb/ref 17592186279029} {:answer/id #uuid "9311b1e5-983f-56a8-b6d1-330651531b3b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=-\\frac{\\pi }{4}+2n\\pi " :db/id #edb/ref 17592186279899}] :answer-field/correct {:answer/id #uuid "17605140-bedc-5fff-9676-0d338f2dc7c8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=-\\frac{\\pi }{4}+n\\pi " :db/id #edb/ref 17592186278801} :answer-field/id #uuid "175088b2-d5c3-52c9-bc4e-8315e0bcb28d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186280873}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "62746e40-0193-5ca9-870e-c828dbc32d5d" :question/math-academy-id "q-16245" :question/problem "![](images/35/350458d29c8d214f44b175e28a6f43accd7ce064187cf755324cbe99d53eb7ad.png)\n\nThe graph shows a portion of the curve $y=\\operatorname{tan}⁡x$ and $y=-1.$ Which of the following generates the $x$-values of all of their points of intersection? Assume that $n$ is an integer." :question/worked-solution "At the intersection points, the $y$-values are the same for both graphs. This gives the equation $\\operatorname{tan}⁡x=-1.$ \n\nFirst, we find the principal value:\n\n$$\n{x}_{1}=\\operatorname{arctan}⁡(-1)=-\\frac{\\pi }{4}\n$$\n\nThe tangent function has a period of $\\pi .$  Hence, the general solution for the given equation is\n\n$$\nx=-\\frac{\\pi }{4}+n\\pi .\n$$"}] [{:db/id #edb/ref 17592186083564 :knowledge-point/_questions [{:db/id #edb/ref 17592186083299 :knowledge-point/id #uuid "223e29c9-1bb5-51ee-9ec8-4d5c15363951" :knowledge-point/title "Finding the Center of a Horizontal Hyperbola Given an Equation in Expanded Form"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "038e7ca3-9f2e-50ec-983a-de6bd000e63c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(7,-6)" :db/id #edb/ref 17592186281719} {:answer/id #uuid "26bdbef2-c47a-5d6c-aca0-ba40f2fbbbb4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-6,-7)" :db/id #edb/ref 17592186282026} {:answer/id #uuid "d72cdc8c-90d4-561e-9a5a-18d0d4a96d6d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(5,6)" :db/id #edb/ref 17592186283563} {:answer/id #uuid "fe197ae0-a4c9-55f4-812e-62cf4e98d829" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-6,7)" :db/id #edb/ref 17592186283919} {:answer/id #uuid "ffb7a6ad-44d9-55a0-9220-b166c5327e84" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(6,-5)" :db/id #edb/ref 17592186283932}] :answer-field/correct {:answer/id #uuid "fe197ae0-a4c9-55f4-812e-62cf4e98d829" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-6,7)" :db/id #edb/ref 17592186283919} :answer-field/id #uuid "4859b225-780b-5365-b784-c694b9fa73c9" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186284052}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "025d6071-d0ec-5817-8d91-2087900261c6" :question/math-academy-id "q-16381" :question/problem "What is the center of the hyperbola \n$6{x}^{2}-5{y}^{2}+72x+70y=59?$" :question/worked-solution "The equation of a horizontal hyperbola centered at $(h,k)$ is given by\n\n$$\n\\frac{(x-h)^{2}}{{a}^{2}}-\\frac{(y-k)^{2}}{{b}^{2}}=1.\n$$\n\nTo rewrite the equation of the hyperbola in standard form, we need to group $x$ and $y$ terms and complete the squares as follows:\n\n$$\n\\begin{aligned}6{x}^{2}-5{y}^{2}+72x+70y & =59 \\\\ 6{x}^{2}+72x-5{y}^{2}+70y & =59 \\\\ 6[{x}^{2}+12x]-5[{y}^{2}-14y] & =59 \\\\ 6((x+6)^{2}-36)-5[(y-7)^{2}-49] & =59 \\\\ 6(x+6)^{2}-216-5(y-7)^{2}+245 & =59 \\\\ 6(x+6)^{2}-5(y-7)^{2} & =59+216-245 \\\\ 6(x+6)^{2}-5(y-7)^{2} & =30 \\\\ \\frac{(x+6)^{2}}{5}-\\frac{(y-7)^{2}}{6} & =1.\\end{aligned}\n$$\n\nHence, the center is $(-6,7).$"}] [{:db/id #edb/ref 17592186284444 :knowledge-point/_questions [{:db/id #edb/ref 17592186087731 :knowledge-point/id #uuid "0adde8fd-26c3-52f5-9864-5e96641a8b63" :knowledge-point/title "Finding the Complex Conjugate of a Complex Number With Negative Imaginary Part"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "263bdc6d-4fda-5948-a654-f5102a6ece85" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\overset{―}{z}=5+12\\text{i}" :db/id #edb/ref 17592186282022} {:answer/id #uuid "b299723b-ff19-5b3d-b12a-1547439addaf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\overset{―}{z}=\\frac{1}{5-12\\text{i}}" :db/id #edb/ref 17592186283239} {:answer/id #uuid "dd9cb080-c86f-5905-9b32-c8840ca494dc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\overset{―}{z}=-5+12\\text{i}" :db/id #edb/ref 17592186283625} {:answer/id #uuid "e96c448b-3d35-59a6-9940-d54682027729" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\overset{―}{z}=5-12\\text{i}" :db/id #edb/ref 17592186283726} {:answer/id #uuid "ec2ac6e6-d883-532d-b564-f3a895defbf7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\overset{―}{z}=-5-12\\text{i}" :db/id #edb/ref 17592186283751}] :answer-field/correct {:answer/id #uuid "263bdc6d-4fda-5948-a654-f5102a6ece85" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\overset{―}{z}=5+12\\text{i}" :db/id #edb/ref 17592186282022} :answer-field/id #uuid "812cc3a4-e03d-542a-b988-6dbc14db679b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186284152}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "f33a661d-acf6-551f-b7e5-6ad7d3cf9b2f" :question/math-academy-id "q-16414" :question/problem "What is the complex conjugate of $z=5-12\\text{i}?$" :question/worked-solution "To find the complex conjugate, we flip the sign of the imaginary part.\n\nIn the given number $z=5-12\\text{i},$ the imaginary part is $-12\\text{i}.$ Flipping the sign, we get $12\\text{i}.$\n\nTherefore, the complex conjugate is given by $\\overset{―}{z}=5+12\\text{i}.$"}]}
