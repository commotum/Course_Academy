-13\\end{aligned}],\\,N=[\\begin{aligned}-15 & -6 & -13 \\\\ -1 & -8 & 14\\end{aligned}].\n$$" :question/worked-solution "We add the corresponding entries:\n\n$$\n\\begin{aligned}M+N & =[\\begin{aligned}3 & -6 & 14 \\\\ 2 & 9 & -13\\end{aligned}]+[\\begin{aligned}-15 & -6 & -13 \\\\ -1 & -8 & 14\\end{aligned}] \\\\  & =[\\begin{aligned}3+(-15) & -6+(-6) & 14+(-13) \\\\ 2+(-1) & 9+(-8) & -13+14\\end{aligned}] \\\\  & =[\\begin{aligned}-12 & -12 & 1 \\\\ 1 & 1 & 1\\end{aligned}]\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186241150 :knowledge-point/_questions [{:db/id #edb/ref 17592186087742 :knowledge-point/id #uuid "7703063b-658d-50a5-8ac3-747b7f029bb3" :knowledge-point/title "Finding the Parametric Equations of a Circle Centered at the Origin"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8423035f-a5a5-5c6b-84df-93fa66043e10" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=\\operatorname{cos}⁡\\theta ,\\,y=\\operatorname{sin}⁡\\theta " :db/id #edb/ref 17592186239203} {:answer/id #uuid "b001d813-7987-5c68-9466-9de6ccb68bd6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=\\sqrt{\\frac{1}{2}}\\operatorname{cos}⁡\\theta ,\\,y=\\sqrt{\\frac{1}{2}}\\operatorname{sin}⁡\\theta " :db/id #edb/ref 17592186239584} {:answer/id #uuid "c0c2d72f-f92d-59fc-8d72-ef4098955ac2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=2\\operatorname{cos}⁡\\theta ,\\,y=2\\operatorname{sin}⁡\\theta " :db/id #edb/ref 17592186239736} {:answer/id #uuid "c597485d-f992-5ec7-957e-38171d3cdea7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=\\frac{1}{4}\\operatorname{cos}⁡\\theta ,\\,y=\\frac{1}{4}\\operatorname{sin}⁡\\theta " :db/id #edb/ref 17592186239793} {:answer/id #uuid "d652b090-492a-59ad-9d6c-3c66c3e3286e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=\\frac{1}{2}\\operatorname{cos}⁡\\theta ,\\,y=\\frac{1}{2}\\operatorname{sin}⁡\\theta " :db/id #edb/ref 17592186239928}] :answer-field/correct {:answer/id #uuid "d652b090-492a-59ad-9d6c-3c66c3e3286e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=\\frac{1}{2}\\operatorname{cos}⁡\\theta ,\\,y=\\frac{1}{2}\\operatorname{sin}⁡\\theta " :db/id #edb/ref 17592186239928} :answer-field/id #uuid "f65cb3a9-d2ec-5669-ac2a-dd0da3b31a0d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186240764}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "c548914b-7c42-51b7-ab54-c723baf0506a" :question/math-academy-id "q-106032" :question/problem "Which of the following parametric equations, defined for $\\theta \\in [0,2\\pi ),$ generate a circle of radius $\\frac{1}{2}$ centered at the origin?" :question/worked-solution "The parametric equations of a circle  of radius $r$  centered at  the origin are\n\n$$\nx=r\\operatorname{cos}⁡\\theta ,\\,y=r\\operatorname{sin}⁡\\theta ,\\,\\theta \\in [0,2\\pi ).\n$$\n\nIn our case, the radius $r=\\frac{1}{2}.$ Therefore, the parametric equations of the circle are \n\n$$\nx=\\frac{1}{2}\\operatorname{cos}⁡\\theta ,\\,y=\\frac{1}{2}\\operatorname{sin}⁡\\theta ,\\,\\theta \\in [0,2\\pi ).\n$$"}] [{:db/id #edb/ref 17592186397836 :knowledge-point/_questions [{:db/id #edb/ref 17592186087784 :knowledge-point/id #uuid "1d81c7ff-8459-5559-bfae-c2a9c3bc739e" :knowledge-point/title "Parametrizing Part of a Circle"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "232441c2-f7f1-5f16-bc4b-60b09c0b1593" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\frac{\\pi }{2},\\frac{3\\pi }{2}]" :db/id #edb/ref 17592186397838} {:answer/id #uuid "82fba5c9-0131-541c-8948-a25c0d8eae2f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[0,\\frac{\\pi }{2}]" :db/id #edb/ref 17592186397839} {:answer/id #uuid "ef45acfd-4144-56f2-98cf-f241f28d614f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\frac{\\pi }{2},\\pi ]" :db/id #edb/ref 17592186397840} {:answer/id #uuid "0f87d6d3-3c3b-5273-849d-9b1476a53757" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[0,\\pi ]" :db/id #edb/ref 17592186397841} {:answer/id #uuid "c5222c9f-23b7-5ec8-b93f-57e76ab64107" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\frac{\\pi }{2},2\\pi )" :db/id #edb/ref 17592186397842}] :answer-field/correct {:answer/id #uuid "ef45acfd-4144-56f2-98cf-f241f28d614f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\frac{\\pi }{2},\\pi ]" :db/id #edb/ref 17592186397840} :answer-field/id #uuid "dad99554-fa4d-57b5-9d6d-0148f288e880" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186397837}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "da600baa-a9d3-5724-9a5b-8920df8b8600" :question/math-academy-id "q-106293" :question/problem "![](images/d6/d698646baac96e15db7f447c0e1af6dbc0cb03cae50084fbfbb6cab15eabf565.png)\n\nThe quarter-circle above is defined by the parametric equations \n\n$$\nx=2\\operatorname{cos}⁡\\theta ,\\,y=2\\operatorname{sin}⁡\\theta .\n$$\n\nWhat is the domain of the parameter $\\theta ?$" :question/worked-solution "The parametric equations of a circle  of radius $r$  centered at  the origin are\n\n$$\nx=r\\operatorname{cos}⁡\\theta ,\\,y=r\\operatorname{sin}⁡\\theta ,\\,\\theta \\in [0,2\\pi ).\n$$\n\nIn our case, the radius $r=2.$ So, the parametric equations of the *full* circle are \n\n$$\nx=2\\operatorname{cos}⁡\\theta ,\\,y=2\\operatorname{sin}⁡\\theta ,\\,\\theta \\in [0,2\\pi ).\n$$\n\nTo restrict the parameterization to a quarter-circle, we associate the parameter $\\theta $ with the central angle formed by a point $(x,y)$ on the circle and the $x$-axis. \n\n![](images/b7/b76043921a3f9399049d6c3b4f557c7263da4d38a070c66a2dd444dbe2806c8e.png)\n\nWe can see that if we restrict $\\theta $ to $[\\frac{\\pi }{2},\\pi ]$, we get the required quarter-circle.\n\nTherefore, the parametric equations of the quarter-circle are \n\n$$\nx=2\\operatorname{cos}⁡\\theta ,\\,y=2\\operatorname{sin}⁡\\theta ,\\,\\theta \\in [\\frac{\\pi }{2},\\pi ].\n$$"}] [{:db/id #edb/ref 17592186241174 :knowledge-point/_questions [{:db/id #edb/ref 17592186087800 :knowledge-point/id #uuid "7511fb86-dea4-5206-9ccd-69628a59473e" :knowledge-point/title "Parametrizing a Vertical Parabola Whose Vertex Is at the Origin"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "75998071-befb-5489-be0c-bbf3e1494aea" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=t,\\,\\,y=\\frac{1}{2}{t}^{2}" :db/id #edb/ref 17592186239070} {:answer/id #uuid "88eea04a-d8a1-51c3-97d8-6e529bd9b97e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=-\\frac{1}{2}t,\\,\\,y=-{t}^{2}" :db/id #edb/ref 17592186239247} {:answer/id #uuid "a4ecb594-d2f1-55cd-8617-ef560cc14075" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=\\frac{1}{2}t,\\,\\,y={t}^{2}" :db/id #edb/ref 17592186239488} {:answer/id #uuid "c123727a-d48d-5583-8a9c-797904a46c03" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=-t,\\,\\,y=-\\frac{1}{2}{t}^{2}" :db/id #edb/ref 17592186239743} {:answer/id #uuid "c7df434f-7524-5eb1-9b00-8cdfa267e631" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=-2t,\\,\\,y=-{t}^{2}" :db/id #edb/ref 17592186239814}] :answer-field/correct {:answer/id #uuid "c123727a-d48d-5583-8a9c-797904a46c03" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=-t,\\,\\,y=-\\frac{1}{2}{t}^{2}" :db/id #edb/ref 17592186239743} :answer-field/id #uuid "336c67f8-b80c-57f5-b2fd-845c6ff24aed" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186240425}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "f65595d4-58fb-5ba2-ab22-c9fc4bc25274" :question/math-academy-id "q-106412" :question/problem "![](images/c4/c42f5aac98d31b7a66a60eebae34b5e83cb62f3ba4801595a81dd9bb57706384.png)\n\nWhich of the following sets of parametric equations, defined for $t\\in (-\\infty ,\\infty ),$ generate the parabola shown above?" :question/worked-solution "The diagram shows that the parabola is vertical, has its vertex at $(0,0),$ and passes through the point $(4,-8).$\n\nThe parametric equations of a vertical parabola that has its vertex at $(0,0)$ are\n\n$$\nx=2pt,\\,y=p{t}^{2},\n$$\n\nwhere $p$ is constant.\n\nSince the parabola passes through $(4,-8),$ we can substitute $x=4$ and $y=-8$ into the standard parametric equations to obtain a system of equations. This gives\n\n$$\n{\\begin{aligned}4=2pt \\\\ -8=p{t}^{2}.\\end{aligned}\n$$\n\nSolving the first equation for $t,$ we have\n\n$$\n\\begin{aligned}4 & =2pt \\\\ 2 & =pt \\\\ t & =\\frac{2}{p}.\\end{aligned}\n$$\n\nSubstituting this into the second equation and solving for $p,$ we get\n\n$$\n\\begin{aligned}-8 & =p{(\\frac{2}{p})}^{2} \\\\ -8 & =p\\cdot \\frac{4}{{p}^{2}} \\\\ -8 & =\\frac{4}{p} \\\\ p & =-\\frac{1}{2}.\\end{aligned}\n$$\n\nTherefore, the parametric equations of the parabola are\n\n$$\nx=2(-\\frac{1}{2})t,\\,y=(-\\frac{1}{2}){t}^{2},\n$$\n\nwhich simplify to\n\n$$\nx=-t,\\,y=-\\frac{1}{2}{t}^{2}.\n$$"}] [{:db/id #edb/ref 17592186241177 :knowledge-point/_questions [{:db/id #edb/ref 17592186087802 :knowledge-point/id #uuid "4ccc7f71-d2e0-5f35-80a5-042a53eda2da" :knowledge-point/title "Finding the Cartesian Equation of a Parabola Given Its Parametric Equations"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4c3fbccc-901c-57b0-9988-6f723ef84ab7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{x}^{2}=y" :db/id #edb/ref 17592186238713} {:answer/id #uuid "6dc5609b-2aa7-577e-8ca8-e3c677d4774b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{x}^{2}=\\frac{1}{4}y" :db/id #edb/ref 17592186238998} {:answer/id #uuid "72ab017e-5892-5f23-a41e-d964cd88398e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{x}^{2}=\\frac{1}{2}y" :db/id #edb/ref 17592186239037} {:answer/id #uuid "a5fef148-16ca-57f6-9973-15c2d7ca67f4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{x}^{2}=-\\frac{1}{4}y" :db/id #edb/ref 17592186239494} {:answer/id #uuid "a9d73e3e-0200-5470-be2b-26f481b4839e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{x}^{2}=-y" :db/id #edb/ref 17592186239542}] :answer-field/correct {:answer/id #uuid "a9d73e3e-0200-5470-be2b-26f481b4839e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{x}^{2}=-y" :db/id #edb/ref 17592186239542} :answer-field/id #uuid "41723f97-6bef-5b88-aa67-216ec7059ea0" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186240443}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "ff3b94a0-936d-5385-88ce-05fc23ae4390" :question/math-academy-id "q-106438" :question/problem "Find the Cartesian equation of the parabola defined by the parametric equations\n\n$$\nx=-\\frac{1}{2}t,\\,y=-\\frac{1}{4}{t}^{2},\\,t\\in (-\\infty ,\\infty ).\n$$" :question/worked-solution "First, let's make $t$ the subject of the parametric equations. This gives\n\n$$\n\\begin{aligned}t & =-2x,\\,{t}^{2}=-4y.\\end{aligned}\n$$\n\nSquaring both sides of the first equation, we have\n\n$$\n\\begin{aligned}{t}^{2} & =4{x}^{2}.\\end{aligned}\n$$\n\nWe can now eliminate the parameter $t$ by substituting the above into the equation ${t}^{2}=-4y$ and rearranging to find the Cartesian equation of the parabola, as follows:\n\n$$\n\\begin{aligned}4{x}^{2} & =-4y \\\\ {x}^{2} & =-y\\end{aligned}\n$$\n\nTherefore, the Cartesian equation of the parabola is ${x}^{2}=-y.$"}] [{:db/id #edb/ref 17592186243931 :knowledge-point/_questions [{:db/id #edb/ref 17592186124663 :knowledge-point/id #uuid "ee15db10-b92c-5f48-8983-e602068c7e08" :knowledge-point/title "Identifying the Horizontal Asymptote of a Rational Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "347b1d00-e093-5df8-b0bb-241d2df72d9f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=-3" :db/id #edb/ref 17592186241640} {:answer/id #uuid "3b40e80b-3473-51b2-9674-9060ca0ed6dd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=-1" :db/id #edb/ref 17592186241707} {:answer/id #uuid "9644ad6e-c2da-5691-b74a-464d8cb96445" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=2" :db/id #edb/ref 17592186242499} {:answer/id #uuid "9ae96f64-5462-56ef-a273-ca1737d10932" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=1" :db/id #edb/ref 17592186242536} {:answer/id #uuid "bde0195a-caf8-5f42-9afb-97d1fd2ca750" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "No horizontal asymptote" :db/id #edb/ref 17592186242848}] :answer-field/correct {:answer/id #uuid "3b40e80b-3473-51b2-9674-9060ca0ed6dd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=-1" :db/id #edb/ref 17592186241707} :answer-field/id #uuid "5a567200-b104-587e-98b2-cc2ac2aaba52" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186243618}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "1d3780ea-9bd6-553b-af0e-868098039a4e" :question/math-academy-id "q-106705" :question/problem "What is the horizontal asymptote of $y=f(x)$ for $x>0$ with $f(x)=\\frac{|{x}^{3}-5|}{2-{x}^{3}}?$" :question/worked-solution "For large positive values of $x,$ we have $|{x}^{3}-5|=({x}^{3}-5).$ Consequently, for $x\\to \\infty ,$ we get\n\n$$\n{lim}_{x\\to \\infty }\\frac{|{x}^{3}-5|}{2-{x}^{3}}={lim}_{x\\to \\infty }\\frac{{x}^{3}-5}{2-{x}^{3}}.\n$$\n\nThe horizontal asymptote for $x>0$ is $y={lim}_{x\\to \\infty }f(x).$ To find the horizontal asymptote, we apply the usual procedure of dividing the numerator and denominator by the highest power of $x$ in the denominator, which is ${x}^{3}.$\n\n$$\n\\begin{aligned}{lim}_{x\\to \\infty }f(x) & ={lim}_{x\\to \\infty }\\frac{{x}^{3}-5}{2-{x}^{3}} \\\\  & ={lim}_{x\\to \\infty }\\frac{(\\frac{{x}^{3}}{{x}^{3}}-\\frac{5}{{x}^{3}})}{(\\frac{2}{{x}^{3}}-\\frac{{x}^{3}}{{x}^{3}})} \\\\  & ={lim}_{x\\to \\infty }\\frac{(1-\\frac{5}{{x}^{3}})}{(\\frac{2}{{x}^{3}}-1)} \\\\  & =\\frac{1-0}{0-1} \\\\  & =-1.\\end{aligned}\n$$\n\n \n\nTherefore, the horizontal asymptote is $y=-1.$"}] [{:db/id #edb/ref 17592186243936 :knowledge-point/_questions [{:db/id #edb/ref 17592186078623 :knowledge-point/id #uuid "579373bc-38b3-584c-a118-84be7dfc9074" :knowledge-point/title "Comparing the Relative Magnitude of a Trigonometric Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "239937b2-42e0-5623-a141-a945bd09f480" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186241489} {:answer/id #uuid "340018e8-8775-5de6-91c9-f5928068173a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186241638} {:answer/id #uuid "3ef0a508-dd2f-5d42-9768-b657f0958f14" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{2}" :db/id #edb/ref 17592186241742} {:answer/id #uuid "870a28d7-ad0a-50e1-8684-658cfec2ef79" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\text{DNE}" :db/id #edb/ref 17592186242362} {:answer/id #uuid "a464e34e-99b1-555a-9fe8-3179122c1fd1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\infty " :db/id #edb/ref 17592186242623}] :answer-field/correct {:answer/id #uuid "340018e8-8775-5de6-91c9-f5928068173a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186241638} :answer-field/id #uuid "2e447a1f-e474-5ad1-a31c-09184eb24383" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186243524}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "9ec04ce8-c2fc-55aa-9357-bfe8bb93a396" :question/math-academy-id "q-106727" :question/problem "Evaluate ${lim}_{x\\to \\infty }\\frac{3\\operatorname{sin}⁡x}{2-{x}^{2}}.$" :question/worked-solution "First, we rewrite the limit as\n\n$$\n{lim}_{x\\to \\infty }\\frac{3\\operatorname{sin}⁡x}{2-{x}^{2}}={lim}_{x\\to \\infty }\\frac{-3\\operatorname{sin}⁡x}{{x}^{2}-2}.\n$$\n\nThe numerator here is a bounded, oscillating function with\n\n$$\n|-3\\operatorname{sin}⁡x|\\le 3.\n$$\n\nHowever, the denominator ${x}^{2}-2$ grows without bound as $x\\to \\infty .$ So the denominator is growing much faster than the numerator, and we conclude that\n\n$$\n{lim}_{x\\to \\infty }\\frac{3\\operatorname{sin}⁡x}{2-{x}^{2}}={lim}_{x\\to \\infty }\\frac{-3\\operatorname{sin}⁡x}{{x}^{2}-2}=0.\n$$\n\nWe can see this from the graph of $y=\\frac{3\\operatorname{sin}⁡x}{2-{x}^{2}},$ shown below:\n\n![](images/9f/9fade66030e2e416f92138d787999d3ca3a7dd4788ad39cf29dd07ff944038da.png)"}] [{:db/id #edb/ref 17592186243940 :knowledge-point/_questions [{:db/id #edb/ref 17592186129304 :knowledge-point/id #uuid "66d82fa3-d576-5c42-9dca-4e1b76473424" :knowledge-point/title "Finding the Range of a Transformed Reciprocal Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1ecfb844-f4f1-556c-987d-832292fbec49" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "f(x)\\in (-\\infty ,\\frac{5}{2})\\cup (\\frac{5}{2},\\infty )" :db/id #edb/ref 17592186241450} {:answer/id #uuid "1f0a31a2-5a13-565a-a464-3f0914bf9ba9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "f(x)\\in (-\\infty ,0)\\cup (0,\\infty )" :db/id #edb/ref 17592186241453} {:answer/id #uuid "69f5576d-090f-5074-8d93-27f0b35b2326" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "f(x)\\in (-\\infty ,-1)\\cup (-1,\\infty )" :db/id #edb/ref 17592186242133} {:answer/id #uuid "81e21516-bcf4-522f-bcb2-115a49c0c898" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "f(x)\\in (-\\infty ,2)\\cup (2,\\infty )" :db/id #edb/ref 17592186242319} {:answer/id #uuid "93bfca5f-5c07-5241-bbc3-62792fedc0a8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "f(x)\\in (-\\infty ,-2)\\cup (-2,\\infty )" :db/id #edb/ref 17592186242476}] :answer-field/correct {:answer/id #uuid "93bfca5f-5c07-5241-bbc3-62792fedc0a8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "f(x)\\in (-\\infty ,-2)\\cup (-2,\\infty )" :db/id #edb/ref 17592186242476} :answer-field/id #uuid "477827b9-3e44-560c-8518-8d469641fc9e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186243573}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "dee89207-4330-5745-b12b-28c3a1d92f86" :question/math-academy-id "q-106736" :question/problem "What is the range of $f(x)=-\\frac{3}{5-2x}-2?$" :question/worked-solution "A transformed reciprocal function of the form\n\n$$\nf(x)=\\frac{a}{bx+c}+d\n$$\n\nhas the horizontal asymptote $y=d,$ and therefore, its range is\n\n$$\nf(x)\\in (-\\infty ,d)\\cup (d,\\infty ).\n$$\n\nIn our case, $d=-2.$ Therefore, the horizontal asymptote is $y=-2,$ and the range of the function is\n\n$$\nf(x)\\in (-\\infty ,-2)\\cup (-2,\\infty ).\n$$\n\nThe graph $y=f(x)$ is shown below.\n\n![](images/51/51bdabd83a57cce915c284a27699aa200712b259257c371d9e1f19a4b60fa790.png)"}] [{:db/id #edb/ref 17592186243960 :knowledge-point/_questions [{:db/id #edb/ref 17592186078623 :knowledge-point/id #uuid "579373bc-38b3-584c-a118-84be7dfc9074" :knowledge-point/title "Comparing the Relative Magnitude of a Trigonometric Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "07f972ff-a620-557f-9034-6ea42bab0740" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186241245} {:answer/id #uuid "33635954-a851-5e18-b110-259edf76f9a8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\infty " :db/id #edb/ref 17592186241633} {:answer/id #uuid "5fd4879c-90a2-5599-8da2-ef4dbc732343" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186242040} {:answer/id #uuid "999ede88-960a-5796-96f2-7b361f514088" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186242521} {:answer/id #uuid "de4f8b10-fb5e-539e-8885-d99a21bcc073" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{2}" :db/id #edb/ref 17592186243156}] :answer-field/correct {:answer/id #uuid "999ede88-960a-5796-96f2-7b361f514088" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186242521} :answer-field/id #uuid "db660612-31be-51bd-a109-d184b3b2649e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186243819}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "cfa56d21-de83-52ed-897a-8430dcba3cd1" :question/math-academy-id "q-106830" :question/problem "Evaluate ${lim}_{x\\to \\infty }\\frac{5\\operatorname{cos}⁡x}{3-2x}.$" :question/worked-solution "First, we rewrite the limit as\n\n$$\n{lim}_{x\\to \\infty }\\frac{5\\operatorname{cos}⁡x}{3-2x}={lim}_{x\\to \\infty }\\frac{-5\\operatorname{cos}⁡x}{2x-3}.\n$$\n\nThe numerator here is a bounded, oscillating function with\n\n$$\n|-5\\operatorname{cos}⁡x|\\le 5.\n$$\n\nHowever, the denominator $2x-3$ grows without bound as $x\\to \\infty .$ So the denominator is growing much faster than the numerator, and we conclude that\n\n$$\n{lim}_{x\\to \\infty }\\frac{5\\operatorname{cos}⁡x}{3-2x}={lim}_{x\\to \\infty }\\frac{-5\\operatorname{cos}⁡x}{2x-3}=0.\n$$\n\nWe can see this from the graph of $y=\\frac{5\\operatorname{cos}⁡x}{3-2x},$ shown below:\n\n![](images/ab/ab3f7928be50c25689a99751cd180e585d749bf0a5c253c8662f9b820bbf4bb7.png)"}] [{:db/id #edb/ref 17592186244015 :knowledge-point/_questions [{:db/id #edb/ref 17592186119956 :knowledge-point/id #uuid "231604dc-fe8f-59be-90fe-37af7a1bb648" :knowledge-point/title "Identifying When a Rational Function has no Vertical Asymptotes"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2b96b5ae-6ce9-5fbd-b829-c0f4f0d789ea" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=-4" :db/id #edb/ref 17592186241568} {:answer/id #uuid "62fb6837-045c-5c5f-817c-39764aa13a87" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=0,2" :db/id #edb/ref 17592186242070} {:answer/id #uuid "8730e05f-e09f-5912-b238-023b41d1d32f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "No vertical asymptotes" :db/id #edb/ref 17592186242364} {:answer/id #uuid "d94c6f55-f877-5f3f-8d3e-f700d1ec6a57" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=0" :db/id #edb/ref 17592186243114} {:answer/id #uuid "f6287792-bc7c-58bb-8ec6-d36156cc7771" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=-4,0" :db/id #edb/ref 17592186243359}] :answer-field/correct {:answer/id #uuid "8730e05f-e09f-5912-b238-023b41d1d32f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "No vertical asymptotes" :db/id #edb/ref 17592186242364} :answer-field/id #uuid "dbe03a30-9948-5f9d-ada7-d263c82687bb" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186243821}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "f19b56f7-fcd0-5225-aa53-5eaa01302c57" :question/math-academy-id "q-107068" :question/problem "Find the vertical asymptotes of $f(x)=\\frac{(x+4)({x}^{3}+3{x}^{2}-5x)}{{x}^{2}+4x}.$" :question/worked-solution "Let's simplify the expression by factoring both the numerator and the denominator:\n\n$$\n\\begin{aligned}\\frac{(x+4)({x}^{3}+3{x}^{2}-5x)}{{x}^{2}+4x} & =\\frac{x(x+4)({x}^{2}+3x-5)}{x(x+4)} \\\\  & =\\frac{\\cancel{x(x+4)}({x}^{2}+3x-5)}{\\cancel{x(x+4)}} \\\\  & ={x}^{2}+3x-5\\end{aligned}\n$$\n\nSince the denominator is never zero, we conclude that this function has no vertical asymptotes. A plot of the function is below. Note that it is not defined at $x=-4$ and $x=0.$\n\n![](images/a1/a10cef51ad5955f6065fbf4deaccbab1cda1f576db96310236ea976bb8d8eb8b.png)"}] [{:db/id #edb/ref 17592186244017 :knowledge-point/_questions [{:db/id #edb/ref 17592186119957 :knowledge-point/id #uuid "68ba4c5d-8b91-57bc-b98b-0e9f8d8f1f67" :knowledge-point/title "Determining the Vertical Asymptotes for the Sum of Two Rational Functions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0220b710-5b90-53ff-8425-62500cb4eb79" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "No vertical asymptotes" :db/id #edb/ref 17592186241202} {:answer/id #uuid "2a077280-c20c-5c77-86ac-bb178f9de397" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$x=\\sqrt{3}$ and $x=\\frac{1}{2}$" :db/id #edb/ref 17592186241550} {:answer/id #uuid "846c7b7d-f2dd-5c75-bcf0-fceeb8394c0a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=\\frac{1}{2}" :db/id #edb/ref 17592186242338} {:answer/id #uuid "d2d03c5d-27d3-5e41-8fd3-b73e336e3d85" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=\\sqrt{2}" :db/id #edb/ref 17592186243037} {:answer/id #uuid "f5b5b232-6478-5750-9c4b-26a86b00d899" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$x=-\\sqrt{2}$ and $x=\\sqrt{2}$" :db/id #edb/ref 17592186243352}] :answer-field/correct {:answer/id #uuid "0220b710-5b90-53ff-8425-62500cb4eb79" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "No vertical asymptotes" :db/id #edb/ref 17592186241202} :answer-field/id #uuid "7a49c91f-801c-5ea3-bc82-c6c034f4bde1" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186243675}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "c0ab6a53-bb8a-5513-8636-6d49828c6cf2" :question/math-academy-id "q-107074" :question/problem "Find the vertical asymptotes of $f(x)=\\frac{1}{{x}^{2}+3}-\\frac{1}{2{x}^{2}+1}.$" :question/worked-solution "First, let's put the two terms over a common denominator:\n\n$$\n\\begin{aligned}\\frac{1}{{x}^{2}+3}-\\frac{1}{2{x}^{2}+1} & =\\frac{(2{x}^{2}+1)-({x}^{2}+3)}{({x}^{2}+3)(2{x}^{2}+1)}=\\frac{{x}^{2}-2}{({x}^{2}+3)(2{x}^{2}+1)}\\end{aligned}\n$$\n\nThere are no common factors in the numerator and denominator, so we proceed to set the denominator equal to zero and get\n\n$$\n({x}^{2}+3)(2{x}^{2}+1)=0.\n$$\n\nThis equation has no real solutions, therefore $f(x)$ has no vertical asymptotes."}] [{:db/id #edb/ref 17592186244041 :knowledge-point/_questions [{:db/id #edb/ref 17592186096843 :knowledge-point/id #uuid "0a312840-0d35-50bb-94b3-b04778f4efc3" :knowledge-point/title "Differentiating a Function Using the Chain Rule and Prime Notation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3b70de32-5fa9-5056-93ca-35a9463faadb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5(3x+4{)}^{4}" :db/id #edb/ref 17592186241712} {:answer/id #uuid "3ec14f92-c87e-5787-a89f-47a342d4236d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3(3x+4{)}^{5}" :db/id #edb/ref 17592186241739} {:answer/id #uuid "5d608479-e85c-5eaa-9d74-3ea2e83804de" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "20(3x+4{)}^{4}" :db/id #edb/ref 17592186242022} {:answer/id #uuid "8a1ebdf8-e7b7-53d7-92ca-ae1bc7bccfdd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "9(3x+4{)}^{4}" :db/id #edb/ref 17592186242395} {:answer/id #uuid "9a91c92b-ab22-552d-a427-31624937e728" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "15(3x+4{)}^{4}" :db/id #edb/ref 17592186242530}] :answer-field/correct {:answer/id #uuid "9a91c92b-ab22-552d-a427-31624937e728" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "15(3x+4{)}^{4}" :db/id #edb/ref 17592186242530} :answer-field/id #uuid "2cdfb9ab-5d97-59c1-90d9-2ac765b9ee1d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186243521}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "5ffe447f-f2a2-5d58-986c-0fb23858e18e" :question/math-academy-id "q-107293" :question/problem "Given that $f(x)={(3x+4)}^{5},$ find ${f}^{′}(x).$" :question/worked-solution "Let $g(x)=3x+4$ and $f(g(x))=g(x{)}^{5}.$ \n\nDifferentiating, we have\n\n$$\n\\begin{aligned}{f}^{′}(g(x)) & =({g}^{5}{)}^{′}=5{g}^{4}, \\\\ {g}^{′}(x) & =(3x+4{)}^{′}=3.\\end{aligned}\n$$\n\nThen, using the chain rule, \n\n$$\n\\begin{aligned}{f}^{′}(x) & ={f}^{′}(g(x))\\cdot {g}^{′}(x) \\\\  & =5{g}^{4}\\cdot 3 \\\\  & =15(3x+4{)}^{4}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186244056 :knowledge-point/_questions [{:db/id #edb/ref 17592186092263 :knowledge-point/id #uuid "107eaf98-be8c-5fb1-ac4c-948b1e00df0a" :knowledge-point/title "Differentiating an Exponential Function with a Nonlinear Exponent"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "100855dc-01a1-54eb-889b-5c5849671fed" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2{x}^{2}{e}^{{x}^{2}-2x}" :db/id #edb/ref 17592186241318} {:answer/id #uuid "412016b5-7fcf-5318-88ca-74a5337fd439" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2{e}^{{x}^{2}-2x}" :db/id #edb/ref 17592186241764} {:answer/id #uuid "b3c2451f-e77c-598c-a29b-975bfafc93b7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(2x+2){e}^{{x}^{2}-2x}" :db/id #edb/ref 17592186242750} {:answer/id #uuid "e6242e2c-3c54-5534-b3c3-9e6ba73a9681" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(2x-2){e}^{{x}^{2}-2x}" :db/id #edb/ref 17592186243224} {:answer/id #uuid "e95fa722-682a-5996-bbc5-42651cbf8584" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2x{e}^{{x}^{2}-2x}" :db/id #edb/ref 17592186243242}] :answer-field/correct {:answer/id #uuid "e6242e2c-3c54-5534-b3c3-9e6ba73a9681" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(2x-2){e}^{{x}^{2}-2x}" :db/id #edb/ref 17592186243224} :answer-field/id #uuid "666980b0-ea06-5cc6-8aba-d89d9e6e8dd9" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186243640}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "30a7e2e3-900c-5659-9ff0-e1c7283ea786" :question/math-academy-id "q-107445" :question/problem "Given that $y={e}^{{x}^{2}-2x},$ find $\\frac{\\text{d}y}{\\text{d}x}.$" :question/worked-solution "First, we express $y$ as the composite function\n\n$$\ny={e}^{u},\\,u={x}^{2}-2x.\n$$\n\nDifferentiating gives\n\n$$\n\\frac{\\text{d}y}{\\text{d}u}={e}^{u},\\,\\frac{\\text{d}u}{\\text{d}x}=2x-2.\n$$\n\nWe now apply the chain rule, and get\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}y}{\\text{d}u}\\cdot \\frac{\\text{d}u}{\\text{d}x} \\\\  & ={e}^{u}\\cdot (2x-2) \\\\  & =(2x-2){e}^{u} \\\\  & =(2x-2){e}^{{x}^{2}-2x}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186244058 :knowledge-point/_questions [{:db/id #edb/ref 17592186092263 :knowledge-point/id #uuid "107eaf98-be8c-5fb1-ac4c-948b1e00df0a" :knowledge-point/title "Differentiating an Exponential Function with a Nonlinear Exponent"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4f51954f-ef10-5b61-8e64-a3c5da15b5b8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-8" :db/id #edb/ref 17592186241888} {:answer/id #uuid "561e1348-b169-5b7b-9445-b0635e9a11e7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "12" :db/id #edb/ref 17592186241956} {:answer/id #uuid "662b5321-520e-54cd-9509-03f4e29b7113" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186242102} {:answer/id #uuid "d763b1fc-ea11-5f90-95d1-e07b6b76e1cb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186243092} {:answer/id #uuid "ea081c7f-fadb-5983-817c-316ec3dc87d5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186243251}] :answer-field/correct {:answer/id #uuid "ea081c7f-fadb-5983-817c-316ec3dc87d5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186243251} :answer-field/id #uuid "4a8beb4d-3f02-544b-a522-4d1a06ffa730" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186243581}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "f0b47caa-0fc0-55c4-b8be-d17c35ea6d3b" :question/math-academy-id "q-107452" :question/problem "Find the slope of the tangent to the curve $y={e}^{{x}^{3}-4x}$ at the point where $x=2.$" :question/worked-solution "First, we express $y$ as the composite function\n\n$$\ny={e}^{u},\\,u={x}^{3}-4x.\n$$\n\nDifferentiating gives\n\n$$\n\\frac{\\text{d}y}{\\text{d}u}={e}^{u},\\,\\frac{\\text{d}u}{\\text{d}x}=3{x}^{2}-4.\n$$\n\nWe now apply the chain rule and get\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}y}{\\text{d}u}\\cdot \\frac{\\text{d}u}{\\text{d}x} \\\\  & ={e}^{u}\\cdot (3{x}^{2}-4) \\\\  & =(3{x}^{2}-4){e}^{{x}^{3}-4x}.\\end{aligned}\n$$\n\nFinally, to find the slope of the tangent to the curve at $x=2$, we have to evaluate $\\frac{\\text{d}y}{\\text{d}x}$ at that point as follows:\n\n$$\n\\begin{aligned}{\\frac{\\text{d}y}{\\text{d}x}|}_{x=2} & ={(3{x}^{2}-4){e}^{{x}^{3}-4x}\\,|}_{x=2} \\\\  & =(3(2)^{2}-4){e}^{{2}^{3}-4(2)} \\\\  & =8\\cdot {e}^{0} \\\\  & =8\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186244060 :knowledge-point/_questions [{:db/id #edb/ref 17592186092261 :knowledge-point/id #uuid "2f4bfd24-dafd-57b3-940a-154a6e0acf3d" :knowledge-point/title "Differentiating a General Exponential Function Using the Chain Rule"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "530546dd-8877-5ee4-a9a9-4e6037256c79" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\cdot {6}^{1-4x}ln⁡6" :db/id #edb/ref 17592186241920} {:answer/id #uuid "600e2c77-5502-5a78-b78c-316c9d3b0309" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4\\cdot {6}^{1-4x}ln⁡6" :db/id #edb/ref 17592186242042} {:answer/id #uuid "a399353b-dcb8-5ce5-8226-adfa95834745" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "24\\cdot {6}^{1-4x}ln⁡6" :db/id #edb/ref 17592186242614} {:answer/id #uuid "a3a4777f-04c7-56f8-9d79-a2692ed255c7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-4\\cdot {6}^{1-4x}ln⁡6" :db/id #edb/ref 17592186242615} {:answer/id #uuid "f5f46ff0-e8a9-5bfe-82dc-8df71e3e5cb5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-24\\cdot {6}^{1-4x}ln⁡6" :db/id #edb/ref 17592186243356}] :answer-field/correct {:answer/id #uuid "a3a4777f-04c7-56f8-9d79-a2692ed255c7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-4\\cdot {6}^{1-4x}ln⁡6" :db/id #edb/ref 17592186242615} :answer-field/id #uuid "cfbbf656-26a0-5730-8af0-76fb3508854c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186243802}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "a0d30f56-0d1c-5b77-92c9-4ebf415c4add" :question/math-academy-id "q-107461" :question/problem "If $f(x)={6}^{1-4x},$ find ${f}^{′}(x).$" :question/worked-solution "First, we express $f(x)$ as the composite function\n\n$$\nf={6}^{u},\\,u=1-4x.\n$$\n\nDifferentiating gives\n\n$$\n\\frac{\\text{d}f}{\\text{d}u}={6}^{u}ln⁡6,\\,\\frac{\\text{d}u}{\\text{d}x}=-4.\n$$\n\nWe now apply the chain rule, and get\n\n$$\n\\begin{aligned}\\frac{\\text{d}f}{\\text{d}x} & =\\frac{\\text{d}f}{\\text{d}u}\\cdot \\frac{\\text{d}u}{\\text{d}x} \\\\  & ={6}^{u}ln⁡6\\cdot (-4) \\\\  & =-4\\cdot {6}^{u}ln⁡6 \\\\  & =-4\\cdot {6}^{1-4x}ln⁡6.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186244061 :knowledge-point/_questions [{:db/id #edb/ref 17592186087720 :knowledge-point/id #uuid "4d1ea5c4-2700-5c03-a22e-de5439f47c36" :knowledge-point/title "Expressing a Quotient of Complex Numbers in Polar Form"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "32fe7f10-2655-59bb-82ce-08ad3fdc8a05" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "z=2\\sqrt{2}(\\operatorname{cos}⁡(\\frac{3\\pi }{4})+\\text{i}\\operatorname{sin}⁡(\\frac{3\\pi }{4}))" :db/id #edb/ref 17592186241630} {:answer/id #uuid "88a190b9-7d2b-5bcd-9378-d2b0286a8cba" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "z=\\sqrt{2}(\\operatorname{cos}⁡(\\frac{\\pi }{4})+\\text{i}\\operatorname{sin}⁡(\\frac{\\pi }{4}))" :db/id #edb/ref 17592186242381} {:answer/id #uuid "99be3e20-4ed2-5652-9e1c-b2df33c244c1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "z=\\sqrt{2}(\\operatorname{cos}⁡(\\frac{3\\pi }{4})+\\text{i}\\operatorname{sin}⁡(\\frac{3\\pi }{4}))" :db/id #edb/ref 17592186242522} {:answer/id #uuid "ab0a0151-cb92-5657-b7d0-81ffeb455502" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "z=4(\\operatorname{cos}⁡(\\frac{\\pi }{4})+\\text{i}\\operatorname{sin}⁡(\\frac{\\pi }{4}))" :db/id #edb/ref 17592186242677} {:answer/id #uuid "f1256db1-73b6-5040-8e72-39c158686864" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "z=2\\sqrt{2}(\\operatorname{cos}⁡(\\frac{\\pi }{4})+\\text{i}\\operatorname{sin}⁡(\\frac{\\pi }{4}))" :db/id #edb/ref 17592186243320}] :answer-field/correct {:answer/id #uuid "f1256db1-73b6-5040-8e72-39c158686864" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "z=2\\sqrt{2}(\\operatorname{cos}⁡(\\frac{\\pi }{4})+\\text{i}\\operatorname{sin}⁡(\\frac{\\pi }{4}))" :db/id #edb/ref 17592186243320} :answer-field/id #uuid "9d26e50a-4924-502d-a4d6-d0b50c2e526a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186243730}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "a3fb5688-f4d7-5d45-9532-04de911faa48" :question/math-academy-id "q-107478" :question/problem "Express $z=\\frac{4}{1-\\text{i}}$ in the form $r(\\operatorname{cos}⁡\\theta +\\text{i}\\operatorname{sin}⁡\\theta ).$" :question/worked-solution "First, we express the given complex number in the form $z=x+y\\text{i}.$ To do this, we remove $\\text{i}$ from the denominator by multiplying the numerator and denominator of $z$ by the complex conjugate of the denominator, which is $1+\\text{i}:$\n\n$$\n\\begin{aligned}z & =\\frac{4}{1-\\text{i}} \\\\  & =\\frac{4(1+\\text{i})}{(1-\\text{i})(1+\\text{i})} \\\\  & =\\frac{4(1+\\text{i})}{{1}^{2}-{\\text{i}}^{2}} \\\\  & =\\frac{4(1+\\text{i})}{1+1} \\\\  & =2(1+\\text{i}) \\\\  & =2+2\\text{i}\\end{aligned}\n$$\n\n \n\nIn polar form, $r$ represents the magnitude $|z|.$ For a complex number $z=x+y\\text{i},$ the magnitude of $z$ is given by\n\n$$\n|z|=\\sqrt{{x}^{2}+{y}^{2}}.\n$$\n\nSo, for $z=2+2\\text{i},$ the magnitude is \n\n$$\n\\begin{aligned}r=|z| & =\\sqrt{{x}^{2}+{y}^{2}} \\\\  & =\\sqrt{{2}^{2}+{2}^{2}} \\\\  & =2\\sqrt{2}.\\end{aligned}\n$$\n\n    \n\nIn polar form, $\\theta $  represents the argument $\\operatorname{arg}⁡(z).$ Since $x=2$ and $y=2$ are both positive, $z$ lies in the first quadrant. So, we can find $\\theta $ as follows:\n\n$$\n\\begin{aligned}\\theta =\\operatorname{arg}⁡(z) & =\\operatorname{arctan}⁡(\\frac{y}{x}) \\\\  & =\\operatorname{arctan}⁡(\\frac{2}{2}) \\\\  & =\\operatorname{arctan}⁡1 \\\\  & =\\frac{\\pi }{4}\\end{aligned}\n$$\n\nFinally, we write the complex number $z$ in polar form:\n\n$$\nz=2\\sqrt{2}(\\operatorname{cos}⁡(\\frac{\\pi }{4})+\\text{i}\\operatorname{sin}⁡(\\frac{\\pi }{4}))\n$$"}] [{:db/id #edb/ref 17592186244062 :knowledge-point/_questions [{:db/id #edb/ref 17592186171913 :knowledge-point/id #uuid "7da9cbe0-e57b-5289-be33-c21af3f68ee7" :knowledge-point/title "Finding Primary Roots of Unity"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "18bf6ee4-13cb-5e29-aa00-72802f147b3c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{e}^{\\pi \\text{i}/22}" :db/id #edb/ref 17592186241396} {:answer/id #uuid "2b7c8ad0-2732-50f1-9354-cd1cb2cf58a5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{e}^{3\\pi \\text{i}/22}" :db/id #edb/ref 17592186241565} {:answer/id #uuid "4f5e3872-0c2d-5000-9375-cf6192a10587" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{e}^{2\\pi \\text{i}/11}" :db/id #edb/ref 17592186241890} {:answer/id #uuid "a46896c1-0d7c-56eb-b85f-c14eec446f8d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{e}^{3\\pi \\text{i}/11}" :db/id #edb/ref 17592186242624} {:answer/id #uuid "a6980e6c-5cbd-5b95-bcfb-2ebbd81d5080" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{e}^{\\pi \\text{i}/11}" :db/id #edb/ref 17592186242648}] :answer-field/correct {:answer/id #uuid "a6980e6c-5cbd-5b95-bcfb-2ebbd81d5080" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{e}^{\\pi \\text{i}/11}" :db/id #edb/ref 17592186242648} :answer-field/id #uuid "91424deb-1037-5137-b17e-259f9cd3cf8a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186243710}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "8ea7f0d9-052f-5889-bddf-db77ecf1910d" :question/math-academy-id "q-107494" :question/problem "Find the principal $22$th root of unity." :question/worked-solution "Let $z$ be a $22$th root of unity. This means that \n\n$$\n{z}^{22}=1.\n$$\n\nFirst, we express the complex number $1$ in the form $r{e}^{\\text{i}\\theta }.$ Notice that $|1|=1$ and $\\operatorname{arg}⁡(1)=0.$ Hence, \n\n$$\n1={e}^{\\text{i}(0+2k\\pi )}={e}^{2k\\pi \\text{i}},\n$$\n\nwhere $k$ is an integer. So, we have\n\n$$\n\\begin{aligned}{z}^{22}={e}^{2k\\pi \\text{i}}\\,⟹\\,z=({e}^{2k\\pi \\text{i}})^{1/22}={e}^{k\\pi \\text{i}/11}.\\end{aligned}\n$$\n\nThe principal root corresponds to $k=1,$ and is therefore equal to ${e}^{\\pi \\text{i}/11}.$"}] [{:db/id #edb/ref 17592186244065 :knowledge-point/_questions [{:db/id #edb/ref 17592186087720 :knowledge-point/id #uuid "4d1ea5c4-2700-5c03-a22e-de5439f47c36" :knowledge-point/title "Expressing a Quotient of Complex Numbers in Polar Form"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "04f9de1f-4f25-5b06-9fe7-00d80cb7f25e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "z=2(\\operatorname{cos}⁡(\\frac{\\pi }{6})+\\text{i}\\operatorname{sin}⁡(\\frac{\\pi }{6}))" :db/id #edb/ref 17592186241220} {:answer/id #uuid "55a97a63-06b0-52a4-8dc3-397e3cdd5675" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "z=\\operatorname{cos}⁡(\\frac{\\pi }{6})+\\text{i}\\operatorname{sin}⁡(\\frac{\\pi }{6})" :db/id #edb/ref 17592186241950} {:answer/id #uuid "8664ea7d-0c52-5b8c-8536-00cd1890171a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "z=\\operatorname{cos}⁡(\\frac{\\pi }{3})+\\text{i}\\operatorname{sin}⁡(\\frac{\\pi }{3})" :db/id #edb/ref 17592186242357} {:answer/id #uuid "a18e07c2-0be9-58ca-a916-ebd1e6f4c4a3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "z=2(\\operatorname{cos}⁡(\\frac{\\pi }{3})+\\text{i}\\operatorname{sin}⁡(\\frac{\\pi }{3}))" :db/id #edb/ref 17592186242594} {:answer/id #uuid "c1da9973-1d45-5b2a-9d0e-4d2db6f0629a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "z=\\sqrt{2}(\\operatorname{cos}⁡(\\frac{\\pi }{6})+\\text{i}\\operatorname{sin}⁡(\\frac{\\pi }{6}))" :db/id #edb/ref 17592186242880}] :answer-field/correct {:answer/id #uuid "55a97a63-06b0-52a4-8dc3-397e3cdd5675" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "z=\\operatorname{cos}⁡(\\frac{\\pi }{6})+\\text{i}\\operatorname{sin}⁡(\\frac{\\pi }{6})" :db/id #edb/ref 17592186241950} :answer-field/id #uuid "d14dc245-a2a8-5495-902f-1ed1045d160d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186243806}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "2e9181ee-25b9-5957-9828-d0262363192c" :question/math-academy-id "q-107509" :question/problem "Express $z=\\frac{1+\\sqrt{3}\\,\\text{i}}{\\sqrt{3}+\\text{i}}$ in the form $r(\\operatorname{cos}⁡\\theta +\\text{i}\\operatorname{sin}⁡\\theta ).$" :question/worked-solution "First, we express the given complex number in the form $z=x+y\\text{i}.$ To do this, we remove $\\text{i}$ from the denominator by multiplying the numerator and denominator of $z$ by the complex conjugate of the denominator, which is $\\sqrt{3}-\\text{i}:$ \n\n$$\n\\begin{aligned}z & =\\frac{1+\\sqrt{3}\\,\\text{i}}{\\sqrt{3}+\\text{i}} \\\\  & =\\frac{(1+\\sqrt{3}\\,\\text{i})(\\sqrt{3}-\\text{i})}{(\\sqrt{3}+\\text{i})(\\sqrt{3}-\\text{i})} \\\\  & =\\frac{2\\sqrt{3}+2\\text{i}}{(\\sqrt{3})^{2}-{\\text{i}}^{2}} \\\\  & =\\frac{2(\\sqrt{3}+\\text{i})}{3+1} \\\\  & =\\frac{\\sqrt{3}+\\text{i}}{2} \\\\  & =\\frac{\\sqrt{3}}{2}+\\frac{\\text{i}}{2}\\end{aligned}\n$$\n\nIn polar form, $r$ represents the magnitude $|z|.$ For a complex number $z=x+y\\text{i},$ the magnitude of $z$ is given by\n\n$$\n|z|=\\sqrt{{x}^{2}+{y}^{2}}.\n$$\n\nSo, for $z=\\frac{\\sqrt{3}}{2}+\\frac{\\text{i}}{2},$ the magnitude is\n\n$$\n\\begin{aligned}r=|z| & =\\sqrt{{x}^{2}+{y}^{2}} \\\\  & =\\sqrt{{(\\frac{\\sqrt{3}}{2})}^{2}+{(\\frac{1}{2})}^{2}} \\\\  & =\\sqrt{\\frac{3}{4}+\\frac{1}{4}} \\\\  & =1.\\end{aligned}\n$$\n\n    \n\nIn polar form, $\\theta $  represents the argument $\\operatorname{arg}⁡(z).$ Since $x=\\frac{\\sqrt{3}}{2}$ and $y=\\frac{1}{2}$ are both positive, $z$ lies in the first quadrant. So, we can find $\\theta $ as follows: \n\n$$\n\\begin{aligned}\\theta =\\operatorname{arg}⁡(z) & =\\operatorname{arctan}⁡(\\frac{y}{x}) \\\\  & =\\operatorname{arctan}⁡(\\frac{(\\frac{1}{2})}{(\\frac{\\sqrt{3}}{2})}) \\\\  & =\\operatorname{arctan}⁡(\\frac{1}{\\sqrt{3}}) \\\\  & =\\frac{\\pi }{6}\\end{aligned}\n$$\n\nFinally, we write the complex number $z$ in polar form:\n\n$$\nz=\\operatorname{cos}⁡(\\frac{\\pi }{6})+\\text{i}\\operatorname{sin}⁡(\\frac{\\pi }{6})\n$$"}] [{:db/id #edb/ref 17592186092504 :knowledge-point/_questions [{:db/id #edb/ref 17592186092383 :knowledge-point/id #uuid "84c8ba29-95c9-5494-be0b-9b67bee6e45c" :knowledge-point/title "Determining where a Tangent Line Intersects an Axis"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3d43d514-056c-5460-a3af-d849e852963f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(\\frac{26}{15},0)" :db/id #edb/ref 17592186241726} {:answer/id #uuid "62bc42d2-5179-562d-98c4-3bdc3ecbb73c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(\\frac{15}{26},0)" :db/id #edb/ref 17592186242064} {:answer/id #uuid "6989371f-d3e2-5899-88b0-040b8420dc5e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(\\frac{6}{5},0)" :db/id #edb/ref 17592186242127} {:answer/id #uuid "bb13d610-b21e-5707-86ce-445aaa0a4fb4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-52,0)" :db/id #edb/ref 17592186242821} {:answer/id #uuid "d8ae9e16-54c5-576c-9c1a-d34f12e925fe" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(\\frac{13}{14},0)" :db/id #edb/ref 17592186243107}] :answer-field/correct {:answer/id #uuid "3d43d514-056c-5460-a3af-d849e852963f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(\\frac{26}{15},0)" :db/id #edb/ref 17592186241726} :answer-field/id #uuid "dd47966b-6ae5-5788-91db-22f167d38ce2" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186243823}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "9bc53eba-4d4e-5f8c-8a22-7a4a98405447" :question/math-academy-id "q-10752" :question/problem "Find where the tangent to the curve $y=5{x}^{2}-7$ at the point $(3,38)$ intersects the $x$-axis." :question/worked-solution "Let $f(x)=5{x}^{2}-7.$ Let's first calculate the derivative:\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}(5{x}^{2}-7)=10x\\end{aligned}\n$$\n\nSo, the slope of the tangent at our point is\n\n$$\n\\begin{aligned}m={f}^{′}(3)=10(3)=30.\\end{aligned}\n$$\n\nTherefore, the equation of the tangent is\n\n$$\n\\begin{aligned}y-{y}_{1} & =m(x-{x}_{1}) \\\\ y-(38) & =30(x-3) \\\\ y & =30x-90+38 \\\\ y & =30x-52.\\end{aligned}\n$$\n\nTo find where the tangent line intercepts the $x$-axis, we set $y=0$ and solve:\n\n$$\n\\begin{aligned}0 & =30x-52 \\\\ x & =\\frac{26}{15}\\end{aligned}\n$$\n\nTherefore, the point of intersection is $(\\frac{26}{15},0).$"}] [{:db/id #edb/ref 17592186244067 :knowledge-point/_questions [{:db/id #edb/ref 17592186083239 :knowledge-point/id #uuid "1ee21c78-209f-564b-a005-86f58699a3be" :knowledge-point/title "Factoring a Quadratic Polynomial With Complex Roots"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1aa1f7b8-69bb-5f92-911a-dfb947dda4d4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "u-(1-2\\text{i})" :db/id #edb/ref 17592186241408} {:answer/id #uuid "37dd6105-495e-5bc8-8f54-17c0607d9d86" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "u-(3+2\\text{i})" :db/id #edb/ref 17592186241677} {:answer/id #uuid "47519c28-b9c9-50e2-b491-06a371b5156c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "u-(1+4\\text{i})" :db/id #edb/ref 17592186241824} {:answer/id #uuid "8eb02fe6-113c-5c7d-8f1f-8c0f62782555" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "u-(-1-2\\text{i})" :db/id #edb/ref 17592186242434} {:answer/id #uuid "ca92570a-2cd1-5069-94df-4f6b752e31c8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "u-(2+\\text{i})" :db/id #edb/ref 17592186242965}] :answer-field/correct {:answer/id #uuid "1aa1f7b8-69bb-5f92-911a-dfb947dda4d4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "u-(1-2\\text{i})" :db/id #edb/ref 17592186241408} :answer-field/id #uuid "dcf6565b-a7a3-593b-b552-d4db9de85e31" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186243822}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "3d969355-1e15-5d5c-8178-ddac8fee50cd" :question/math-academy-id "q-107523" :question/problem "Which of the following is a factor of ${u}^{2}-2u+5?$" :question/worked-solution "First, we let $f(u)={u}^{2}-2u+5.$\n\nNext, we solve $f(u)=0$ by completing the square, as follows:\n\n$$\n\\begin{aligned}f(u) & =0 \\\\ {u}^{2}-2u+5 & =0 \\\\ ({u}^{2}-2\\cdot u+{1}^{2})-{1}^{2}+5 & =0 \\\\ (u-1)^{2}+4 & =0 \\\\ (u-1)^{2} & =-4 \\\\ (u-1)^{2} & =4{\\text{i}}^{2} \\\\ (u-1)^{2} & =(2\\text{i})^{2} \\\\ u-1 & =\\pm 2\\text{i} \\\\ u & =1\\pm 2\\text{i}\\end{aligned}\n$$\n\nSince our quadratic equation has roots ${u}_{1}=1+2\\text{i}$ and ${u}_{2}=1-2\\text{i},$ and the coefficient of the quadratic term is $a=1,$ the expression ${u}^{2}-2u+5$ can be written as\n\n$$\n\\begin{aligned}{u}^{2}-2u+5 & =a(u-{u}_{1})(u-{u}_{2}) \\\\  & =(u-(1+2\\text{i}))(u-(1-2\\text{i})).\\end{aligned}\n$$\n\nTherefore, among the given options, only $u-(1-2\\text{i})$ is a factor of ${u}^{2}-2u+5.$"}] [{:db/id #edb/ref 17592186244073 :knowledge-point/_questions [{:db/id #edb/ref 17592186087813 :knowledge-point/id #uuid "517f2054-008e-54eb-89dd-5f0a09e1f881" :knowledge-point/title "Finding a Cubic Polynomial Given Three Real Roots and a Leading Coefficient"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "017685bd-cc42-5e91-b6f9-7139f1ca45a7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2{x}^{3}-4{x}^{2}-30x" :db/id #edb/ref 17592186241199} {:answer/id #uuid "164a4c8b-7300-5e8d-87cb-bd18cd95b083" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2{x}^{3}+8{x}^{2}+60x" :db/id #edb/ref 17592186241371} {:answer/id #uuid "378cc4ba-e822-53c1-a956-f59db104e64c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2{x}^{3}-4x-15" :db/id #edb/ref 17592186241670} {:answer/id #uuid "72f9c508-c6db-58c5-bb2e-6d95c1e546b2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2{x}^{3}-2{x}^{2}-30" :db/id #edb/ref 17592186242200} {:answer/id #uuid "e38adfb7-ad96-53f8-82d2-3ba154311b00" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2{x}^{3}+4{x}^{2}+15x" :db/id #edb/ref 17592186243208}] :answer-field/correct {:answer/id #uuid "017685bd-cc42-5e91-b6f9-7139f1ca45a7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2{x}^{3}-4{x}^{2}-30x" :db/id #edb/ref 17592186241199} :answer-field/id #uuid "e510555a-7bca-5d00-b10d-361fdddaa9f4" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186243834}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "cb676cef-b96e-5e0e-9b97-6d918ab0faa9" :question/math-academy-id "q-107540" :question/problem "The cubic polynomial $P(x)$ has roots ${x}_{1}=-3,$ ${x}_{2}=0,$ and ${x}_{3}=5,$ and the coefficient of the cubic term is $2.$ Find $P(x).$" :question/worked-solution "Since our cubic equation has roots ${x}_{1}=-3,$ ${x}_{2}=0,$ and ${x}_{3}=5,$ and the coefficient of the cubic term is $a=2,$ we can write the polynomial as follows:\n\n$$\n\\begin{aligned}a(x-{x}_{1})(x-{x}_{2})(x-{x}_{3}) & =2(x-(-3))(x-0)(x-5) \\\\  & =2x(x+3)(x-5)\\end{aligned}\n$$\n\nExpanding the parentheses, we obtain\n\n$$\n\\begin{aligned}2x(x+3)(x-5) & =2x({x}^{2}-2x-15) \\\\  & =2({x}^{3}-2{x}^{2}-15x) \\\\  & =2{x}^{3}-4{x}^{2}-30x.\\end{aligned}\n$$\n\nTherefore, $P(x)=2{x}^{3}-4{x}^{2}-30x.$"}] [{:db/id #edb/ref 17592186244085 :knowledge-point/_questions [{:db/id #edb/ref 17592186087719 :knowledge-point/id #uuid "31e4455a-9f8f-5c12-8c96-bb6735691591" :knowledge-point/title "Converting From Polar Form to Cartesian Form"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "161529f2-330e-5067-a4a2-2c598f4e23cc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\text{i}" :db/id #edb/ref 17592186241370} {:answer/id #uuid "1b901e84-2519-5cca-b073-7b6c62e3635b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1-\\text{i}" :db/id #edb/ref 17592186241417} {:answer/id #uuid "2cb57ed9-def7-56b0-a186-f45699c1da79" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186241578} {:answer/id #uuid "5806f7a9-da41-59ff-8ae9-a8eb44809d76" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2\\text{i}" :db/id #edb/ref 17592186241977} {:answer/id #uuid "6925961a-23a0-592b-85f0-a2355690ee78" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2+\\text{i}" :db/id #edb/ref 17592186242125}] :answer-field/correct {:answer/id #uuid "2cb57ed9-def7-56b0-a186-f45699c1da79" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186241578} :answer-field/id #uuid "60d90934-60c0-50e8-a41d-f6ab25c17a62" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186243626}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "25fdd1e0-dadc-5981-8079-26e2d85c4830" :question/math-academy-id "q-107567" :question/problem "Express $z=2(\\operatorname{cos}⁡(\\pi )+\\text{i}\\operatorname{sin}⁡(\\pi ))$ in the form $z=x+\\text{i}y.$" :question/worked-solution "To express the number in Cartesian form, we expand the parentheses and substitute the values of the cosine and sine.\n\nSince $\\operatorname{cos}⁡(\\pi )=-1$ and $\\operatorname{sin}⁡(\\pi )=0,$ we have\n\n$$\n\\begin{aligned}z & =2(\\operatorname{cos}⁡(\\pi )+\\text{i}\\operatorname{sin}⁡(\\pi )) \\\\  & =2(-1+\\text{i}\\cdot 0) \\\\  & =-2.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186244087 :knowledge-point/_questions [{:db/id #edb/ref 17592186096608 :knowledge-point/id #uuid "65b4e8e7-e558-50e7-a1ec-37a6eff77e87" :knowledge-point/title "Finding the Amplitude-Phase Form for Sine"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0fdcb2bf-8345-5e1b-882c-bf6e4b7d33af" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\sqrt{5}\\operatorname{sin}⁡(x-{45}^{∘})" :db/id #edb/ref 17592186241316} {:answer/id #uuid "18b631c1-613b-593f-b662-0a358baf67b1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{10}\\operatorname{sin}⁡(x-{60}^{∘})" :db/id #edb/ref 17592186241395} {:answer/id #uuid "25bb4c0b-c018-5544-b1e8-e12b2244067e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{10}\\operatorname{sin}⁡(x-{45}^{∘})" :db/id #edb/ref 17592186241504} {:answer/id #uuid "c9bc19ce-1933-5942-9c00-cd53cf354ffd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{10}\\operatorname{sin}⁡(x-{30}^{∘})" :db/id #edb/ref 17592186242958} {:answer/id #uuid "ee2dba2c-bb4d-57ec-8b76-7eedaf1d151b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\sqrt{5}\\operatorname{sin}⁡(x-{30}^{∘})" :db/id #edb/ref 17592186243291}] :answer-field/correct {:answer/id #uuid "25bb4c0b-c018-5544-b1e8-e12b2244067e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{10}\\operatorname{sin}⁡(x-{45}^{∘})" :db/id #edb/ref 17592186241504} :answer-field/id #uuid "88598f20-c925-534c-af55-d6bf9e3c545c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186243696}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "e33547cc-9eda-5fa2-ada1-bbe7653d7d33" :question/math-academy-id "q-107570" :question/problem "$\\sqrt{5}\\operatorname{sin}⁡x-\\sqrt{5}\\operatorname{cos}⁡x=$" :question/worked-solution "The difference formula for sine gives\n\n$$\n\\begin{aligned}R\\operatorname{sin}⁡(x-ϕ) & =R(\\operatorname{sin}⁡x\\operatorname{cos}⁡ϕ-\\operatorname{cos}⁡x\\operatorname{sin}⁡ϕ) \\\\  & =R\\operatorname{cos}⁡ϕ\\operatorname{sin}⁡x-R\\operatorname{sin}⁡ϕ\\operatorname{cos}⁡x.\\end{aligned}\n$$\n\nTherefore, by writing the given expression in the amplitude-phase form\n\n$$\n\\sqrt{5}\\operatorname{sin}⁡x-\\sqrt{5}\\operatorname{cos}⁡x=R\\operatorname{sin}⁡(x-ϕ),\n$$\n\nwe get the following identity:\n\n$$\n\\sqrt{5}\\operatorname{sin}⁡x-\\sqrt{5}\\operatorname{cos}⁡x=(R\\operatorname{cos}⁡ϕ)\\operatorname{sin}⁡x-(R\\operatorname{sin}⁡ϕ)\\operatorname{cos}⁡x\n$$\n\nEquating the coefficients of $\\operatorname{sin}⁡x$ and $\\operatorname{cos}⁡x,$ we get the following system of equations:\n\n$$\n{\\begin{aligned}R\\operatorname{cos}⁡ϕ=\\sqrt{5} \\\\ R\\operatorname{sin}⁡ϕ=\\sqrt{5}\\end{aligned}\n$$\n\nDividing the second equation by the first, we get\n\n$$\n\\begin{aligned}\\frac{R\\operatorname{sin}⁡ϕ}{R\\operatorname{cos}⁡ϕ} & =\\frac{\\sqrt{5}}{\\sqrt{5}} \\\\ \\operatorname{tan}⁡ϕ & =1 \\\\ ϕ & =\\operatorname{arctan}⁡1 \\\\  & ={45}^{∘}.\\end{aligned}\n$$\n\nNow, we find the amplitude $R.$ Squaring the first and the second equations of the system and adding the results together, we get\n\n$$\n\\begin{aligned}{(R\\operatorname{cos}⁡ϕ)}^{2}+{(R\\operatorname{sin}⁡ϕ)}^{2} & =(\\sqrt{5})^{2}+(\\sqrt{5})^{2} \\\\ {R}^{2}({cos}^{2}⁡ϕ+{sin}^{2}⁡ϕ) & =5+5 \\\\ {R}^{2} & =10 \\\\ R & =\\sqrt{10}.\\end{aligned}\n$$\n\nNote that we only consider the positive root since $R>0.$\n\nFinally, we can write the initial expression in amplitude-phase form as follows:\n\n$$\n\\sqrt{5}\\operatorname{sin}⁡x-\\sqrt{5}\\operatorname{cos}⁡x=\\sqrt{10}\\operatorname{sin}⁡(x-{45}^{∘})\n$$"}] [{:db/id #edb/ref 17592186244089 :knowledge-point/_questions [{:db/id #edb/ref 17592186096608 :knowledge-point/id #uuid "65b4e8e7-e558-50e7-a1ec-37a6eff77e87" :knowledge-point/title "Finding the Amplitude-Phase Form for Sine"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3cdc0764-c704-5f4c-8900-21357c4cc0a5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3\\operatorname{sin}⁡(x+0.730)" :db/id #edb/ref 17592186241721} {:answer/id #uuid "4b4c9039-c2fb-5ec2-94bc-d45cd5379b7c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\sqrt{5}\\operatorname{sin}⁡(x+0.841)" :db/id #edb/ref 17592186241858} {:answer/id #uuid "786d7e6b-a9ac-5d0e-ae28-08ad63146c2c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{7}\\operatorname{sin}⁡(x+0.741)" :db/id #edb/ref 17592186242240} {:answer/id #uuid "870281f1-0101-507d-854d-e412a542cbbc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3\\operatorname{sin}⁡(x+0.841)" :db/id #edb/ref 17592186242361} {:answer/id #uuid "bbc5f724-7da5-5411-9f8c-9ba0486c21de" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\sqrt{5}\\operatorname{sin}⁡(x+0.730)" :db/id #edb/ref 17592186242824}] :answer-field/correct {:answer/id #uuid "3cdc0764-c704-5f4c-8900-21357c4cc0a5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3\\operatorname{sin}⁡(x+0.730)" :db/id #edb/ref 17592186241721} :answer-field/id #uuid "9923f324-3fc1-5d64-bb7b-b26016552565" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186243724}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "e19c29ed-ca08-5b08-881a-c2cea1937130" :question/math-academy-id "q-107574" :question/problem "$\\sqrt{5}\\operatorname{sin}⁡x+2\\operatorname{cos}⁡x≈$" :question/worked-solution "The sum formula for sine gives\n\n$$\n\\begin{aligned}R\\operatorname{sin}⁡(x+ϕ) & =R(\\operatorname{sin}⁡x\\operatorname{cos}⁡ϕ+\\operatorname{cos}⁡x\\operatorname{sin}⁡ϕ) \\\\  & =R\\operatorname{cos}⁡ϕ\\operatorname{sin}⁡x+R\\operatorname{sin}⁡ϕ\\operatorname{cos}⁡x.\\end{aligned}\n$$\n\nTherefore, by writing the given expression in the amplitude-phase form\n\n$$\n\\sqrt{5}\\operatorname{sin}⁡x+2\\operatorname{cos}⁡x=R\\operatorname{sin}⁡(x+ϕ),\n$$\n\nwe get the following identity:\n\n$$\n\\sqrt{5}\\operatorname{sin}⁡x+2\\operatorname{cos}⁡x=(R\\operatorname{cos}⁡ϕ)\\operatorname{sin}⁡x+(R\\operatorname{sin}⁡ϕ)\\operatorname{cos}⁡x\n$$\n\nEquating the coefficients of $\\operatorname{sin}⁡x$ and $\\operatorname{cos}⁡x,$ we get the following system of equations:\n\n$$\n{\\begin{aligned}R\\operatorname{cos}⁡ϕ=\\sqrt{5} \\\\ R\\operatorname{sin}⁡ϕ=2\\end{aligned}\n$$\n\nDividing the second equation by the first, we get\n\n$$\n\\begin{aligned}\\frac{R\\operatorname{sin}⁡ϕ}{R\\operatorname{cos}⁡ϕ} & =\\frac{2}{\\sqrt{5}} \\\\ \\operatorname{tan}⁡ϕ & =\\frac{2\\sqrt{5}}{5} \\\\ ϕ & =\\operatorname{arctan}⁡(\\frac{2\\sqrt{5}}{5}) \\\\ ϕ & ≈0.730\\,\\text{rad}\\end{aligned}\n$$\n\nrounded to three decimal places.\n\nNow, we find the amplitude $R.$ Squaring the first and the second equations of the system and adding the results together, we get: \n\n$$\n\\begin{aligned}{R}^{2}{cos}^{2}⁡ϕ+{R}^{2}{sin}^{2}⁡ϕ & =(\\sqrt{5})^{2}+{2}^{2} \\\\ {R}^{2}({cos}^{2}⁡ϕ+{sin}^{2}⁡ϕ) & =5+4 \\\\ {R}^{2} & =9 \\\\ R & =3\\end{aligned}\n$$\n\nNote that we only consider the positive root since $R>0.$\n\nFinally, we can write the initial expression in amplitude-phase form as follows:\n\n$$\n\\sqrt{5}\\operatorname{sin}⁡x+2\\operatorname{cos}⁡x≈3\\operatorname{sin}⁡(x+0.730)\n$$"}] [{:db/id #edb/ref 17592186244092 :knowledge-point/_questions [{:db/id #edb/ref 17592186096609 :knowledge-point/id #uuid "f12d8028-2520-5706-ba49-d67935036af6" :knowledge-point/title "Finding the Amplitude-Phase Form for Cosine"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "13ef2485-088a-59e5-a9d3-d6d81ac05af0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\pi }{6}" :db/id #edb/ref 17592186241351} {:answer/id #uuid "4579478f-975c-5a82-9cbc-e216916864ba" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\pi }{4}" :db/id #edb/ref 17592186241804} {:answer/id #uuid "a47542a8-9b3c-5c1f-a990-6c080eb2c3cb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\pi }{8}" :db/id #edb/ref 17592186242627} {:answer/id #uuid "b9c37fb5-15bc-5c9c-ac02-81147abd5673" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\pi }{12}" :db/id #edb/ref 17592186242810} {:answer/id #uuid "ee8cf53f-c6cd-5298-a246-3f874d8397d3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\pi }{3}" :db/id #edb/ref 17592186243295}] :answer-field/correct {:answer/id #uuid "13ef2485-088a-59e5-a9d3-d6d81ac05af0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\pi }{6}" :db/id #edb/ref 17592186241351} :answer-field/id #uuid "76907d51-a76b-59d2-814f-949dc43b9da2" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186243669}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "b5b0b758-0715-5d36-8c00-3c3db2730695" :question/math-academy-id "q-107579" :question/problem "Given that the expression $2\\sqrt{6}\\operatorname{cos}⁡x+2\\sqrt{2}\\operatorname{sin}⁡x$ can be written as $R\\operatorname{cos}⁡(x-ϕ)$ with $0<ϕ<\\frac{\\pi }{2}$ and $R>0$, what is the value of $ϕ?$" :question/worked-solution "The difference formula for cosine gives \n\n$$\n\\begin{aligned}R\\operatorname{cos}⁡(x-ϕ) & =R(\\operatorname{cos}⁡x\\operatorname{cos}⁡ϕ+\\operatorname{sin}⁡x\\operatorname{sin}⁡ϕ) \\\\  & =R\\operatorname{cos}⁡ϕ\\operatorname{cos}⁡x+R\\operatorname{sin}⁡ϕ\\operatorname{sin}⁡x.\\end{aligned}\n$$\n\nTherefore, by writing the given expression in the amplitude-phase form\n\n$$\n2\\sqrt{6}\\operatorname{cos}⁡x+2\\sqrt{2}\\operatorname{sin}⁡x=R\\operatorname{cos}⁡(x-ϕ),\n$$\n\nwe get the following identity:\n\n$$\n2\\sqrt{6}\\operatorname{cos}⁡x+2\\sqrt{2}\\operatorname{sin}⁡x=(R\\operatorname{cos}⁡ϕ)\\operatorname{cos}⁡x+(R\\operatorname{sin}⁡ϕ)\\operatorname{sin}⁡x\n$$\n\nEquating the coefficients of $\\operatorname{sin}⁡x$ and $\\operatorname{cos}⁡x,$ we get the following system of equations:\n\n$$\n{\\begin{aligned}R\\operatorname{cos}⁡ϕ=2\\sqrt{6} \\\\ R\\operatorname{sin}⁡ϕ=2\\sqrt{2}\\end{aligned}\n$$\n\nDividing the second equation by the first, we get\n\n$$\n\\begin{aligned}\\frac{R\\operatorname{sin}⁡ϕ}{R\\operatorname{cos}⁡ϕ} & =\\frac{2\\sqrt{2}}{2\\sqrt{6}} \\\\ \\operatorname{tan}⁡ϕ & =\\frac{1}{\\sqrt{3}} \\\\ ϕ & =\\operatorname{arctan}⁡(\\frac{1}{\\sqrt{3}}) \\\\ ϕ & =\\frac{\\pi }{6}.\\end{aligned}\n$$"}]}
