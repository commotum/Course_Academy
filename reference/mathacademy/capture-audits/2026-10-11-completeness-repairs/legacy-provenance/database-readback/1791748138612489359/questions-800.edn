04b0b9f34b" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/32/326290611c8ca441f0d9bcc0439678f0c29302b2784ee4fe65e69a3008ec8fe3.png" :db/id #edb/ref 17592186392480}] :answer-field/correct {:answer/id #uuid "d4ef4dea-31e8-5828-8c0a-fbbd1f3e8b97" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/df/df22eea4331c47da3047381ca672fd80ebf75118054316fe88c0e2d96dae0d34.png" :db/id #edb/ref 17592186392477} :answer-field/id #uuid "9e05f68f-1fcc-5b0b-b66c-d5b388883e5c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186392475}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "6d5543e2-0abb-561e-9632-e9b1d00fcc94" :question/math-academy-id "q-42117" :question/problem "What is the graph of $y=\\operatorname{arcsin}⁡x?$" :question/worked-solution "Let's recall some of the basic properties of $y=\\operatorname{arcsin}⁡x$:\n\n- The domain of the function is $x\\in [-1,1].$\n\n- The range of the function is $y\\in [-\\frac{\\pi }{2},\\frac{\\pi }{2}].$\n\n- Its minimum value occurs at $x=-1.$\n\n- Its maximum value occurs at $x=1.$\n\n- Its zero occurs at $x=0.$\n\n- The function is strictly increasing on its entire domain.\n\nOf the given functions, the only one that has all of these properties is as follows:\n\n![](images/df/df22eea4331c47da3047381ca672fd80ebf75118054316fe88c0e2d96dae0d34.png)"}] [{:db/id #edb/ref 17592186392508 :knowledge-point/_questions [{:db/id #edb/ref 17592186115227 :knowledge-point/id #uuid "8feeacff-b07d-5f98-a765-4d8571674a7a" :knowledge-point/title "Calculating a Matrix Product Using the Associative Law"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f0a43c89-29de-5118-a4d4-3f996c643cb5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}7 & -2 \\\\ 15 & -7 \\\\ 9 & 1\\end{aligned}]" :db/id #edb/ref 17592186392510} {:answer/id #uuid "c445d736-2b33-5a39-a7be-0a95976a8481" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}7 \\\\ 15 \\\\ 0\\end{aligned}]" :db/id #edb/ref 17592186392511} {:answer/id #uuid "cbc16d9e-74fc-598e-a8df-a8298f3cced4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}7 & -2 \\\\ -15 & 7 \\\\ 0 & 0\\end{aligned}]" :db/id #edb/ref 17592186392512} {:answer/id #uuid "b96c80d8-2ac1-5468-adbf-38acb2a30f63" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}-7 \\\\ 12 \\\\ 9\\end{aligned}]" :db/id #edb/ref 17592186392513} {:answer/id #uuid "49f1aa56-0832-5de3-ba9b-9f00b6b7f69f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}7 \\\\ 15 \\\\ 9\\end{aligned}]" :db/id #edb/ref 17592186392514}] :answer-field/correct {:answer/id #uuid "49f1aa56-0832-5de3-ba9b-9f00b6b7f69f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}7 \\\\ 15 \\\\ 9\\end{aligned}]" :db/id #edb/ref 17592186392514} :answer-field/id #uuid "c68e793c-51ab-520a-a8e9-a83467b6243d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186392509}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "72c2951d-d6a9-5cec-b270-d342a8fcfdc1" :question/math-academy-id "q-42259" :question/problem "Calculate $ABC$, where\n\n$$\nA=[\\begin{aligned}1 & 0 \\\\ 2 & 1 \\\\ 1 & 2\\end{aligned}],\\,B=[\\begin{aligned}3 & 1 & 2 \\\\ 0 & 1 & 1\\end{aligned}],\\,C=[\\begin{aligned}2 \\\\ 1 \\\\ 0\\end{aligned}].\n$$" :question/worked-solution "First, recall the associative law\n\n$$\nABC=(AB)C=A(BC).\n$$\n\nNotice that $A$ is a $3\\times 2$ matrix, $B$ is a $2\\times 3$ matrix, and $C$ is a $3\\times 1$ matrix. Therefore, \n\n- multiplying $A$ by $B$, we will obtain a $3\\times 3$ matrix, which will require finding $9$ entries, while\n\n- multiplying $B$ by $C$, we will obtain a $2\\times 1$ matrix, which will require finding $2$ entries.\n\nSo, we find the product $BC$ first:\n\n$$\n\\begin{aligned}BC & =[\\begin{aligned}3 & 1 & 2 \\\\ 0 & 1 & 1\\end{aligned}]\\cdot [\\begin{aligned}2 \\\\ 1 \\\\ 0\\end{aligned}] \\\\  & =[\\begin{aligned}7 \\\\ 1\\end{aligned}]\\end{aligned}\n$$\n\nNow, we multiply $A$ by $BC:$\n\n$$\n\\begin{aligned}ABC & =A(BC) \\\\  & =[\\begin{aligned}1 & 0 \\\\ 2 & 1 \\\\ 1 & 2\\end{aligned}]\\cdot [\\begin{aligned}7 \\\\ 1\\end{aligned}] \\\\  & =[\\begin{aligned}7 \\\\ 15 \\\\ 9\\end{aligned}]\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186329647 :knowledge-point/_questions [{:db/id #edb/ref 17592186100869 :knowledge-point/id #uuid "b494140f-206a-5317-8079-ff719a253140" :knowledge-point/title "Determining Whether Two Matrices Are Conformable for Multiplication"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "56c993a3-b521-5e4e-9b63-95377e12d7bd" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186327688} {:answer/id #uuid "a3940e2a-5e4d-5111-9aa8-655e9e0cdb0e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186328350} {:answer/id #uuid "a6e55bac-7903-58ed-9ab9-ceb90373ea31" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186328384} {:answer/id #uuid "c647be2e-8b5a-5ce5-9a50-22a814f61f15" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186328674} {:answer/id #uuid "d6a063c4-4c0d-5e6a-9d31-a7b0ca0d2115" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186328813}] :answer-field/correct {:answer/id #uuid "a3940e2a-5e4d-5111-9aa8-655e9e0cdb0e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186328350} :answer-field/id #uuid "3df7bbd7-c529-5b77-87d0-548dcad75995" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186329305}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "628bddc5-7db2-5c2d-bca2-c9a2f11c4f87" :question/math-academy-id "q-42381" :question/problem "$$\nO=[\\begin{aligned}1 & 2 \\\\ -4 & 3 \\\\ 0 & 4\\end{aligned}],\\,P=[\\begin{aligned}5 & 0 & 0 \\\\ -4 & 5 & 1\\end{aligned}],\\,R=[\\begin{aligned}2 & 0 & 5\\end{aligned}]\n$$\n\nWhich of the following statements are true regarding the matrices $O,P,$ and $R?$\n\n- The product $OP$ is well defined\n- The product $OR$ is well defined\n- The product $PR$ is well defined" :question/worked-solution "Notice that $O$ is a $3\\times 2$ matrix, $P$ is a $2\\times 3$ matrix, and $R$ is a $1\\times 3$ row vector.\n\nThere are $2$ columns in $O$ and $2$ rows in $P.$ Since the number of columns in $O$ equals the number of rows in $P,$ the matrices $O$ and $P$ are conformable for multiplication:\n\n$$\n{O}_{3\\times \\boxed{\\text{2}}}{\\times }_{✓}{P}_{\\boxed{\\text{2}}\\times 3}=\\text{well defined}\n$$\n\nOn the other hand, there are $2$ columns in $O$ and $1$ rows in $R.$ Since the number of columns in $O$ does **not** equal the number of rows in $R,$ the matrices $O$ and $R$ are **not** conformable for multiplication:\n\n$$\n{O}_{3\\times 2}{\\times }_{\\ne }{R}_{1\\times 3}=\\text{undefined}\n$$\n\nFinally, there are $3$ columns in $P$ and $1$ rows in $R.$ Since the number of columns in $P$ does **not** equal the number of rows in $R,$ the matrices $P$ and $R$ are **not** conformable for multiplication:\n\n$$\n{P}_{2\\times 3}{\\times }_{\\ne }{R}_{1\\times 3}=\\text{undefined}\n$$\n\nTherefore, statement I is true, while statements II and III are false."}] [{:db/id #edb/ref 17592186329650 :knowledge-point/_questions [{:db/id #edb/ref 17592186110574 :knowledge-point/id #uuid "2df217d3-d1d2-54cd-8c93-7925225bfdf3" :knowledge-point/title "Identifying Values in the Range of the Inverse Cosine Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "08020323-c5a9-5b42-9d0e-dd6a5b878b40" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-1,\\frac{\\pi }{2})" :db/id #edb/ref 17592186327000} {:answer/id #uuid "49001fd7-a2ca-5328-aca0-c6263276892c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(0,0)" :db/id #edb/ref 17592186327571} {:answer/id #uuid "6f7b2933-c87c-5869-886d-bd6249488566" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(1,\\pi )" :db/id #edb/ref 17592186327901} {:answer/id #uuid "7202ed4c-a3a4-5db0-bb3b-08b9f0401f66" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-1,\\pi )" :db/id #edb/ref 17592186327921} {:answer/id #uuid "98bd83f6-9a85-596c-88fa-8629f4a8ff28" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(1,\\frac{\\pi }{2})" :db/id #edb/ref 17592186328252}] :answer-field/correct {:answer/id #uuid "7202ed4c-a3a4-5db0-bb3b-08b9f0401f66" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-1,\\pi )" :db/id #edb/ref 17592186327921} :answer-field/id #uuid "9d81aa2a-bd62-55a7-ab1c-fab1facf05b1" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186329446}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "2388e5a3-ccc0-5a99-a06b-72ab673f984d" :question/math-academy-id "q-42433" :question/problem "Which of the following gives the coordinates of the maximum point of the function $y=\\operatorname{arccos}⁡x?$" :question/worked-solution "Let's recall the graph of $y=\\operatorname{arccos}⁡x.$\n\n![](images/d2/d2677563c82c37fd1672a806a18524c97ea5ec17cb4f8ef6d8df23b827ba5e81.png)\n\nFrom the graph, we see that the maximum value is $\\pi $ and it is reached at $x=-1.$ Therefore, the coordinates of the maximum point of the function are $(-1,\\pi ).$"}] [{:db/id #edb/ref 17592186092709 :knowledge-point/_questions [{:db/id #edb/ref 17592186092186 :knowledge-point/id #uuid "4ad1721d-26a4-5459-bc81-297ff0e4d678" :knowledge-point/title "Solving a 3x3 System of Equations By Calculating the Inverse of the Coefficient Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2f1c5547-1ac6-53d1-b475-3c1f3a7a7421" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-5" :db/id #edb/ref 17592186327355} {:answer/id #uuid "cc9bc47f-e4a1-5a48-ad95-9fdc8c30c725" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-6" :db/id #edb/ref 17592186328727} {:answer/id #uuid "e561604b-c400-5b31-b7b4-38788bbd36a1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "13" :db/id #edb/ref 17592186328943} {:answer/id #uuid "ee8db0ff-6f78-5797-8626-bb072f3b6837" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "10" :db/id #edb/ref 17592186329018} {:answer/id #uuid "ef36cb4d-9cd4-585e-b2e1-dfd00cf7e9a7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186329023}] :answer-field/correct {:answer/id #uuid "2f1c5547-1ac6-53d1-b475-3c1f3a7a7421" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-5" :db/id #edb/ref 17592186327355} :answer-field/id #uuid "b8241441-5d37-5b80-8d02-80f7b14d12b8" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186329508}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "be9d95c2-a710-5571-987b-8cd6ddd0d0ab" :question/math-academy-id "q-42449" :question/problem "Solve the following system of linear equations by finding the inverse of the coefficient matrix:\n\n$$\n{\\begin{aligned}2x-3+z=0 \\\\ 5y-1+3x=2z+1 \\\\ 3z+2x-1=2y\\end{aligned}\n$$\n\nFind  $x+y+z.$" :question/worked-solution "First, let's rewrite the system in the correct order:\n\n$$\n{\\begin{aligned}2x+z=3 \\\\ 3x+5y-2z=2 \\\\ 2x-2y+3z=1\\end{aligned}\n$$\n\nNext, we  write the system in the form $Ax=b$, where $A$ is a $3\\times 3$ matrix and $x$ and $b$ are $3\\times 1$ column vectors. We can do this as follows:\n\n$$\n[\\begin{aligned}2 & 0 & 1 \\\\ 3 & 5 & -2 \\\\ 2 & -2 & 3\\end{aligned}][\\begin{aligned}x \\\\ y \\\\ z\\end{aligned}]=[\\begin{aligned}3 \\\\ 2 \\\\ 1\\end{aligned}].\n$$\n\nNow, the solution to $Ax=b$ is given by $x={A}^{-1}b.$ So, we compute ${A}^{-1}$ as follows:\n\n*Step 1:*\n\n$$\n\\begin{aligned}det(A) & =|\\begin{aligned}2 & 0 & 1 \\\\ 3 & 5 & -2 \\\\ 2 & -2 & 3\\end{aligned}| \\\\  & =2|\\begin{aligned}5 & -2 \\\\ -2 & 3\\end{aligned}|-0+|\\begin{aligned}3 & 5 \\\\ 2 & -2\\end{aligned}| \\\\  & =2(15-4)+(-6-10) \\\\  & =22-16 \\\\  & =6.\\end{aligned}\n$$\n\n \n\n*Step 2:*\n\n$$\n\\begin{aligned}M & =[\\begin{aligned}|\\begin{aligned}5 & -2 \\\\ -2 & 3\\end{aligned}| & |\\begin{aligned}3 & -2 \\\\ 2 & 3\\end{aligned}| & |\\begin{aligned}3 & 5 \\\\ 2 & -2\\end{aligned}| \\\\ |\\begin{aligned}0 & 1 \\\\ -2 & 3\\end{aligned}| & |\\begin{aligned}2 & 1 \\\\ 2 & 3\\end{aligned}| & |\\begin{aligned}2 & 0 \\\\ 2 & -2\\end{aligned}| \\\\ |\\begin{aligned}0 & 1 \\\\ 5 & -2\\end{aligned}| & |\\begin{aligned}2 & 1 \\\\ 3 & -2\\end{aligned}| & |\\begin{aligned}2 & 0 \\\\ 3 & 5\\end{aligned}|\\end{aligned}] \\\\  & =[\\begin{aligned}11 & 13 & -16 \\\\ 2 & 4 & -4 \\\\ -5 & -7 & 10\\end{aligned}].\\end{aligned}\n$$\n\n*Step 3:*\n\n$$\nC=[\\begin{aligned}11 & -13 & -16 \\\\ -2 & 4 & 4 \\\\ -5 & 7 & 10\\end{aligned}].\n$$\n\n*Step 4:*\n\n$$\n{C}^{T}=[\\begin{aligned}11 & -2 & -5 \\\\ -13 & 4 & 7 \\\\ -16 & 4 & 10\\end{aligned}].\n$$\n\n*Step 5:*\n\n$$\n{A}^{-1}=\\frac{1}{det(A)}{C}^{T}=\\frac{1}{6}[\\begin{aligned}11 & -2 & -5 \\\\ -13 & 4 & 7 \\\\ -16 & 4 & 10\\end{aligned}].\n$$\n\nFinally, the solution to the given system is\n\n$$\n\\begin{aligned}x & ={A}^{-1}b \\\\  & =\\frac{1}{6}[\\begin{aligned}11 & -2 & -5 \\\\ -13 & 4 & 7 \\\\ -16 & 4 & 10\\end{aligned}][\\begin{aligned}3 \\\\ 2 \\\\ 1\\end{aligned}] \\\\  & =\\frac{1}{6}[\\begin{aligned}24 \\\\ -24 \\\\ -30\\end{aligned}] \\\\  & =[\\begin{aligned}4 \\\\ -4 \\\\ -5\\end{aligned}].\\end{aligned}\n$$\n\n \n\nTherefore, $x+y+z=4-4-5=-5.$"}] [{:db/id #edb/ref 17592186329675 :knowledge-point/_questions [{:db/id #edb/ref 17592186096652 :knowledge-point/id #uuid "45b6a076-8795-5510-aabc-62a925826dd0" :knowledge-point/title "Finding Two Scalar Factors in a Linear Combination"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "08c24834-8cd4-5bea-b65d-b2c5663746e1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$\\lambda =-3$ and $\\mu =-2$" :db/id #edb/ref 17592186327004} {:answer/id #uuid "43f90f38-cbf5-5d7a-920b-1121b5764f3e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$\\lambda =0$ and $\\mu =-2$" :db/id #edb/ref 17592186327528} {:answer/id #uuid "ab7ece4b-a049-56ac-8617-bdfeb30b3311" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$\\lambda =-3$ and $\\mu =-3$" :db/id #edb/ref 17592186328419} {:answer/id #uuid "b21ee6fb-0023-5a59-b1cc-92b08b1e5bb0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$\\lambda =3$ and $\\mu =2$" :db/id #edb/ref 17592186328478} {:answer/id #uuid "baf8f242-62cb-5b3c-a8e9-9e47509ff9d7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$\\lambda =-3$ and $\\mu =0$" :db/id #edb/ref 17592186328564}] :answer-field/correct {:answer/id #uuid "08c24834-8cd4-5bea-b65d-b2c5663746e1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$\\lambda =-3$ and $\\mu =-2$" :db/id #edb/ref 17592186327004} :answer-field/id #uuid "ce77403f-2bf1-5fb6-9d50-de0552a7684f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186329549}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "4f6563bc-e431-538e-8c1d-8eaa7d0e394f" :question/math-academy-id "q-42657" :question/problem "![](images/dc/dc708da9adb4f61161ee1face89403bf1a6ce9762905e8a59b4b3ed9031c817a.png)\n\nConsider the picture above. Given that $r=\\lambda p+\\mu q$, find $\\lambda $ and $\\mu .$" :question/worked-solution "![](images/84/84f8951c4921eca20b00132996dc7b2dfafe047d58574e1822da795e1444c861.png)\n\nIn $△OPR$ shown above, we have \n\n- $OP=3|p|$\n\n- $\\overset{\\to }{OP}$ has the opposite direction to $p$\n\nHence, $\\overset{\\to }{OP}=-3p.$\n\nSimilarly:\n\n- $PR=2|q|$\n\n- $\\overset{\\to }{PR}$ has the opposite direction to $q$\n\nHence, $\\overset{\\to }{PR}=-2q.$\n\nAdditionally, \n\n$$\n\\begin{aligned}r & =\\overset{\\to }{OP}+\\overset{\\to }{PR} \\\\  & =-3p-2q.\\end{aligned}\n$$\n\nConsequently, $r=\\lambda p+\\mu q=-3p-2q.$\n\nSince $p∦q,$ the linear combination can only be written in one way. Equating the coefficients, we get:\n\n- $\\lambda =-3$ and $\\mu =-2$"}] [{:db/id #edb/ref 17592186329678 :knowledge-point/_questions [{:db/id #edb/ref 17592186096653 :knowledge-point/id #uuid "feae36e7-ae88-5f3a-957f-e65a92e399ad" :knowledge-point/title "Expressing a Vector That Satisfies a Ratio in Terms of Known Vectors"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0e3b19d7-9caa-5865-b36b-62dba7ca1b49" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\overset{\\to }{OW}=\\frac{1}{3}u+\\frac{2}{3}v" :db/id #edb/ref 17592186327054} {:answer/id #uuid "12bc31bd-410e-5cec-b3e8-db5ec16e6668" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\overset{\\to }{OW}=\\frac{7}{9}v-\\frac{2}{9}u" :db/id #edb/ref 17592186327095} {:answer/id #uuid "1d8032c3-8159-562d-b85e-ce01f3a9419c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\overset{\\to }{OW}=\\frac{7}{9}u+\\frac{2}{9}v" :db/id #edb/ref 17592186327189} {:answer/id #uuid "ccd9827b-fe26-5576-843d-788fca86322f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\overset{\\to }{OW}=\\frac{2}{3}u+\\frac{1}{3}v" :db/id #edb/ref 17592186328732} {:answer/id #uuid "f6116bad-8f2c-5913-918c-8429cac9d1d4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\overset{\\to }{OW}=-\\frac{1}{3}v+\\frac{2}{3}u" :db/id #edb/ref 17592186329092}] :answer-field/correct {:answer/id #uuid "1d8032c3-8159-562d-b85e-ce01f3a9419c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\overset{\\to }{OW}=\\frac{7}{9}u+\\frac{2}{9}v" :db/id #edb/ref 17592186327189} :answer-field/id #uuid "624e21c0-b503-5eed-93a7-5e549f2e0d0a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186329358}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "cfe5446c-2b26-5e48-974b-de364027f648" :question/math-academy-id "q-42669" :question/problem "![](images/04/040127594f639248736d4492f1853bcb1e6ef18c37db9242ebe466045713628a.png)\n\nConsider the diagram above, where $\\overset{\\to }{OU}=u,$ $\\overset{\\to }{OV}=v$ and $W$ divides $\\overset{―}{UV}$ in the ratio $UW:WV=2:7.$ Find $\\overset{\\to }{OW}.$" :question/worked-solution "From the diagram, we see that\n\n$$\n\\overset{\\to }{OW}=\\overset{\\to }{OU}+\\overset{\\to }{UW}.\n$$\n\nWe're told that $\\overset{\\to }{OU}=u,$ so we just need to work out $\\overset{\\to }{UW}.$\n\nFirst, from $△OUV,$ we have\n\n$$\n\\begin{aligned}\\overset{\\to }{UV} & =\\overset{\\to }{UO}+\\overset{\\to }{OV} \\\\  & =-\\overset{\\to }{OU}+\\overset{\\to }{OV} \\\\  & =-u+v \\\\  & =v-u.\\end{aligned}\n$$\n\nSince $UW:WV=2:7,$ we have\n\n$$\n\\overset{\\to }{UW}=\\frac{2}{9}\\overset{\\to }{UV}=\\frac{2}{9}(v-u).\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\overset{\\to }{OW} & =\\overset{\\to }{OU}+\\overset{\\to }{UW} \\\\  & =u+\\frac{2}{9}(v-u) \\\\  & =\\frac{7}{9}u+\\frac{2}{9}v.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186101412 :knowledge-point/_questions [{:db/id #edb/ref 17592186100844 :knowledge-point/id #uuid "3ea83062-5744-52ef-9b3e-f9805ed092fb" :knowledge-point/title "Finding the General Solution to an Equation Containing a Transformed Reciprocal Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2affdaad-96aa-5484-a442-927e85d5bc81" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "110" :db/id #edb/ref 17592186327314} {:answer/id #uuid "3521707d-b15a-5eb1-a674-60c3a068dbef" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "80" :db/id #edb/ref 17592186327393} {:answer/id #uuid "8ebe1f6b-8a8a-56c5-a9de-f051b92a33f8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "240" :db/id #edb/ref 17592186328176} {:answer/id #uuid "b9883cba-3829-5eae-b3f0-46c20405acfc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "210" :db/id #edb/ref 17592186328552} {:answer/id #uuid "f84442ad-34a5-5352-9847-b2355864c670" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "160" :db/id #edb/ref 17592186329110}] :answer-field/correct {:answer/id #uuid "f84442ad-34a5-5352-9847-b2355864c670" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "160" :db/id #edb/ref 17592186329110} :answer-field/id #uuid "2b837f60-46c5-55db-be33-a2ded8972ca1" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186329262}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "9d1cd618-3e37-5bc5-a865-78591e0eea79" :question/math-academy-id "q-42788" :question/problem "Consider the following trigonometric equation:\n\n$$\n\\operatorname{sec}⁡(\\frac{x}{4}+{20}^{∘})=2.\n$$\n\nThe general solution of this equation is\n\n$$\nx={a}^{∘}+1\\,{440}^{∘}\\cdot n,\\,x=1\\,{120}^{∘}+1\\,{440}^{∘}\\cdot n,\n$$\n\nwhere $n$ is any integer. Which of the following could be the value of $a?$" :question/worked-solution "First, note that the given equation is equivalent to\n\n$$\n\\operatorname{cos}⁡(\\frac{x}{4}+{20}^{∘})=\\frac{1}{2}.\n$$\n\nTherefore, the general solution to our equation is\n\n$$\n\\frac{x}{4}+{20}^{∘}={60}^{∘}+{360}^{∘}\\cdot n,\\,\\frac{x}{4}+{20}^{∘}={300}^{∘}+{360}^{∘}\\cdot n.\n$$\n\nSolving the two equations above for $x,$ we get\n\n$$\n\\begin{aligned}\\frac{x}{4}=-{20}^{∘}+{60}^{∘}+{360}^{∘}\\cdot n, & \\,\\frac{x}{4}=-{20}^{∘}+{300}^{∘}+{360}^{∘}\\cdot n \\\\ \\frac{x}{4}={40}^{∘}+{360}^{∘}\\cdot n, & \\,\\frac{x}{4}={280}^{∘}+{360}^{∘}\\cdot n \\\\ x={160}^{∘}+1\\,{440}^{∘}\\cdot n, & \\,x=1\\,{120}^{∘}+1\\,{440}^{∘}\\cdot n.\\end{aligned}\n$$\n\nSo, we have that $a=160.$"}] [{:db/id #edb/ref 17592186101413 :knowledge-point/_questions [{:db/id #edb/ref 17592186100844 :knowledge-point/id #uuid "3ea83062-5744-52ef-9b3e-f9805ed092fb" :knowledge-point/title "Finding the General Solution to an Equation Containing a Transformed Reciprocal Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "12816130-b7ae-58a5-9f0f-13cc67f21c08" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\pi }{2}" :db/id #edb/ref 17592186327091} {:answer/id #uuid "6184fdd6-eb33-584c-a47e-2dced8a8cf8c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\pi }{4}" :db/id #edb/ref 17592186327786} {:answer/id #uuid "907e306a-a246-574c-a744-8bdd110c28f2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{7\\pi }{12}" :db/id #edb/ref 17592186328195} {:answer/id #uuid "9cc6b643-f6b1-53f2-993d-a1106fb48532" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3\\pi }{4}" :db/id #edb/ref 17592186328288} {:answer/id #uuid "f59c64f1-4d1a-5a50-80ef-df0df82a9e03" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5\\pi }{12}" :db/id #edb/ref 17592186329084}] :answer-field/correct {:answer/id #uuid "907e306a-a246-574c-a744-8bdd110c28f2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{7\\pi }{12}" :db/id #edb/ref 17592186328195} :answer-field/id #uuid "8d377a9e-b5c4-59ea-9955-f41f6b988ee8" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186329420}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "bd51b773-7114-5c60-8ae3-bd4c43f5e27a" :question/math-academy-id "q-42789" :question/problem "Consider the following trigonometric  equation:\n\n$$\n\\operatorname{csc}⁡2x=-2\n$$\n\nThe general solution of this equation can be expressed as \n\n$$\nx=a+\\pi n,\\,x=\\frac{11\\pi }{12}+\\pi n,\n$$\n\nwhere $n$ is any integer. Which of the following could be the value of $a?$" :question/worked-solution "First, note that the given equation is equivalent to\n\n$$\n\\operatorname{sin}⁡2x=-\\frac{1}{2}.\n$$\n\nTherefore, the general solution to our equation is\n\n$$\n2x=\\frac{7\\pi }{6}+2n\\pi ,\\,x=\\frac{11\\pi }{6}+2\\pi n.\n$$\n\nSolving the two equations above for $x,$ we get:\n\n$$\nx=\\frac{7\\pi }{12}+n\\pi ,\\,x=\\frac{11\\pi }{12}+n\\pi \\,\\,\n$$\n\nSo, we have that $a=\\frac{7\\pi }{12}.$"}] [{:db/id #edb/ref 17592186329692 :knowledge-point/_questions [{:db/id #edb/ref 17592186176051 :knowledge-point/id #uuid "0e2a8cf2-64db-5b2f-b0f7-0c727cf492a9" :knowledge-point/title "Describing Properties of the Secant Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3a3b4306-55a9-5f15-98c8-f5d60b6a40ac" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186327443} {:answer/id #uuid "3cf0eaf4-db08-533b-aed6-515990875a68" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "None" :db/id #edb/ref 17592186327466} {:answer/id #uuid "72c7c4d8-6511-5726-b3e9-0656b209f8f4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186327928} {:answer/id #uuid "90fc077c-9a61-5c22-a6a7-607c04c3efe3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186328200} {:answer/id #uuid "95047154-213d-51aa-9ff0-8ef74040020d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186328235}] :answer-field/correct {:answer/id #uuid "90fc077c-9a61-5c22-a6a7-607c04c3efe3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186328200} :answer-field/id #uuid "40a9794c-8ea9-5381-b6f9-0d109bd0dcbf" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186329312}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "3923a242-a394-5f37-9f6d-741dafd435c0" :question/math-academy-id "q-42886" :question/problem "Which of the following statements are true regarding the function $y=sec⁡x?$\n\n- The point $(0,2)$ is in the graph\n- $x=\\frac{3\\pi }{2}$ is a vertical asymptote\n- $y=-2$ belongs to the range of the function." :question/worked-solution "Let's plot the graph of $y=sec⁡x.$\n\n![](images/da/da729794a0331383debd75be0a4ce4a9f2d4da3286f50bd4f284868996077412.png)\n\nLet's go through each statement.\n\n- Statement I is false. The $y$-intercept of $sec⁡x$ is $1.$\n\n- Statement II is true. The function $y=sec⁡x$ has asymptotes at $x=\\frac{\\pi }{2}+n\\pi ,$ thus $x=\\frac{3\\pi }{2}$ is a vertical asymptote.\n\n- Statement III is true. The range of the function is $(-\\infty ,-1]\\cup [1,\\infty ),$ so $y=-2$ belongs to the range."}] [{:db/id #edb/ref 17592186329713 :knowledge-point/_questions [{:db/id #edb/ref 17592186059655 :knowledge-point/id #uuid "ec62fd08-5729-5dc4-97b9-1a422f70109e" :knowledge-point/title "Simplifying an Expression by Expanding Parentheses and Using the Pythagorean Identity"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2f4dfaf9-6adc-58e2-af62-11084821e994" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186327358} {:answer/id #uuid "88ee277f-7d39-51d6-ae8e-804455cc5483" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186328112} {:answer/id #uuid "9908e0fd-b391-508e-8dd9-9f1b7572eaab" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186328256} {:answer/id #uuid "b457a22e-59a5-554f-b4d6-d662134d1479" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186328503} {:answer/id #uuid "d0528873-0750-5fae-828d-e2dd5c23f87e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186328766}] :answer-field/correct {:answer/id #uuid "2f4dfaf9-6adc-58e2-af62-11084821e994" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186327358} :answer-field/id #uuid "a085cb5f-e013-5736-9ee5-2fef11903a5c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186329453}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "770be8a8-209f-5a4a-8f5b-267370ed95fc" :question/math-academy-id "q-43288" :question/problem "$\\operatorname{cos}⁡\\theta \\operatorname{sin}⁡\\theta (\\frac{\\operatorname{cos}⁡\\theta }{\\operatorname{sin}⁡\\theta }+\\frac{\\operatorname{sin}⁡\\theta }{\\operatorname{cos}⁡\\theta })=$" :question/worked-solution "First, we expand the parentheses:\n\n$$\n\\begin{aligned}\\operatorname{cos}⁡\\theta \\operatorname{sin}⁡\\theta (\\frac{\\operatorname{cos}⁡\\theta }{\\operatorname{sin}⁡\\theta }+\\frac{\\operatorname{sin}⁡\\theta }{\\operatorname{cos}⁡\\theta }) & =\\operatorname{cos}⁡\\theta \\operatorname{sin}⁡\\theta \\cdot \\frac{\\operatorname{cos}⁡\\theta }{\\operatorname{sin}⁡\\theta }+\\operatorname{cos}⁡\\theta \\operatorname{sin}⁡\\theta \\cdot \\frac{\\operatorname{sin}⁡\\theta }{\\operatorname{cos}⁡\\theta } \\\\  & =\\frac{\\operatorname{sin}⁡\\theta {cos}^{2}⁡\\theta }{\\operatorname{sin}⁡\\theta }+\\frac{{sin}^{2}⁡\\theta \\operatorname{cos}⁡\\theta }{\\operatorname{cos}⁡\\theta } \\\\  & =\\frac{\\cancel{\\operatorname{sin}⁡\\theta }{cos}^{2}⁡\\theta }{\\cancel{\\operatorname{sin}⁡\\theta }}+\\frac{{sin}^{2}⁡\\theta \\cancel{\\operatorname{cos}⁡\\theta }}{\\cancel{\\operatorname{cos}⁡\\theta }} \\\\  & ={cos}^{2}⁡\\theta +{sin}^{2}⁡\\theta  \\\\  & =1\\end{aligned}\n$$\n\nNotice that, in the last step, we simplified the right-hand side using ${cos}^{2}⁡\\theta +{sin}^{2}⁡\\theta =1.$ \n\nTherefore, we conclude that\n\n$$\n\\operatorname{cos}⁡\\theta \\operatorname{sin}⁡\\theta (\\frac{\\operatorname{cos}⁡\\theta }{\\operatorname{sin}⁡\\theta }+\\frac{\\operatorname{sin}⁡\\theta }{\\operatorname{cos}⁡\\theta })=1.\n$$"}]}
