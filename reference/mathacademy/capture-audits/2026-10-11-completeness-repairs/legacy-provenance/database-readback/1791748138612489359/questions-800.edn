/2c/2c6df3a259e786bdba7842f6c03dd4957d2104959240d64208f68e0cc350b7fd.png" :db/id #edb/ref 17592186390682} :answer-field/id #uuid "2e3ae387-5eb5-5976-a10c-afeed3b761fc" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186390681}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "e138a2bb-43a8-5dac-9ca3-18e579e2b5cd" :question/math-academy-id "q-317895" :question/problem "Which of the following is the graph of the function $y=-{(\\frac{2}{3})}^{x-1}?$" :question/worked-solution "To plot the given function, we follow these steps:\n\n- We take the curve $y={(\\frac{2}{3})}^{x}.$\n\n![](images/fb/fbbddeb527a9ea78b274fd7c4afe9809546a61ba833a67a385cb18aac9e14942.png)\n\n \n\n- Horizontally shift it by $1$ unit to the right to give $y={(\\frac{2}{3})}^{x-1}.$ The $y$-intercept moves from $(0,1)$ to $(1,1)$ but the horizontal asymptote stays at $y=0.$\n\n![](images/61/617dbba0d17c30ce03da929550d17062fd644ed7992a07b55caa02e5815e7232.png)\n\n- Then, reflect it on the $x$-axis to give $y=-{(\\frac{2}{3})}^{x-1}.$ The point $(1,1)$ moves to $(1,-1)$ and the horizontal asymptote stays at $y=0.$\n\n![](images/7e/7e4d38e401c4ce01330d6082dadd43e50974a55b666023d8b8d51bbcbc7f7258.png)"}] [{:db/id #edb/ref 17592186390687 :knowledge-point/_questions [{:db/id #edb/ref 17592186217153 :knowledge-point/id #uuid "b4b5807f-a10a-518a-84fa-907bf699884c" :knowledge-point/title "Exponential Functions With Vertical Reflections and Horizontal Shifts"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "cc9b1f7f-77e0-5da3-a182-cc99609a2934" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/f5/f5643bb8e251468bea69940e4c0335739096d371e36ab569d898b8675da5f3a0.png" :db/id #edb/ref 17592186390689} {:answer/id #uuid "bb991bf3-446e-5307-9c14-0e8ab3fa5b02" :answer/type {:db/id #edb/ref 17592186