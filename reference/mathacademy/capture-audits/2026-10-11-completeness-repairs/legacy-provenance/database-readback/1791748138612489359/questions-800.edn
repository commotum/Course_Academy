e457f65868b58c9246d17744317ad6f76a96c8bd3b024f4fe2d37523a6490fa.png" :db/id #edb/ref 17592186390609} {:answer/id #uuid "b422f31c-7ac6-593f-9a66-3623920a036a" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/73/73590d55299fc519582252723f34bfa143818da7f03a16f7aeb8d208217ee3d4.png" :db/id #edb/ref 17592186390610} {:answer/id #uuid "e921280b-88b6-51bc-a473-f6af4ac53ca8" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/c8/c8652694c97439511e4098e2b8f3d9d1e9727d9953d32348164c3ff7f741f22c.png" :db/id #edb/ref 17592186390611}] :answer-field/correct {:answer/id #uuid "e921280b-88b6-51bc-a473-f6af4ac53ca8" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/c8/c8652694c97439511e4098e2b8f3d9d1e9727d9953d32348164c3ff7f741f22c.png" :db/id #edb/ref 17592186390611} :answer-field/id #uuid "3f6f078f-4b80-5f34-98d4-3100f6b4d2cf" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186390606}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "3af553bc-4342-536e-bf61-1a65d8389d56" :question/math-academy-id "q-31424" :question/problem "Which of the following is the graph of $y=4{(\\frac{1}{2})}^{x}-2?$" :question/worked-solution "First, we plot the graph of $y={(\\frac{1}{2})}^{x}:$\n\n![](images/41/4100e1298857ca36288dc390501fc69dfa68fd13303101d21691d3b056f3365e.png)\n\nNext, we plot the graph of $y=4{(\\frac{1}{2})}^{x}.$ To do this, we scale the graph above by a factor of $4.$ The $y$-intercept moves from $(0,1)$ to $(0,4)$ but the horizontal asymptote stays at $y=0.$\n\n![](images/37/37bb36e82a659fc52e02f2fe2aa3bdfdc11737af467db62b4694c9b63ee4ae6e.png)\n\nFinally, we plot the graph of $y=4{(\\frac{1}{2})}^{x}-2.$ To do this, we shift the above graph $2$ units down. The $y$-intercept moves from $(0,4)$ to $(0,2)$ and the horizontal asymptote moves from $y=0$ to $y=-2.$\n\n![](images/c8/c8652694c97439511e4098e2b8f3d9d1e9727d9953d32348164c3ff7f741f22c.png)"}] [{:db/id #edb/ref 17592186297401 :knowledge-point/_questions [{:db/id #edb/ref 17592186068831 :knowledge-point/id #uuid "cc402a1d-e538-5510-8a6f-79dd1626ff1f" :knowledge-point/title "Identifying the Shift and Stretch Applied to an Exponential Decay Curve"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3a1c47f7-5b8c-5177-997f-9c9709da23dd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186295599} {:answer/id #uuid "4e3cb064-2eaf-5f92-9194-de89c9125599" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186295717} {:answer/id #uuid "7b75ed7d-abd8-526c-8c58-6405c2b625a9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-5" :db/id #edb/ref 17592186295942} {:answer/id #uuid "d96c6138-85f4-575a-bbd3-c78b6c063670" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186296413} {:answer/id #uuid "f51945cd-cb43-5802-a043-9d995443a3f1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186296565}] :answer-field/correct {:answer/id #uuid "3a1c47f7-5b8c-5177-997f-9c9709da23dd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186295599} :answer-field/id #uuid "c9d0e6b0-fcd1-5675-b95f-02f242a5a3ca" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186297051}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "7b52cd54-7f7c-57a1-892c-73badca0d5f6" :question/math-academy-id "q-31435" :question/problem "![](images/01/016286e82482af83783f0eef6361591861b564643d4d9f010f2b82999fcaad27.png)\n\nThe graph above shows $y=k{(\\frac{1}{3})}^{x}+c.$ Find the value of $k-c.$" :question/worked-solution "The horizontal asymptote of the curve $y=k{(\\frac{1}{3})}^{x}+c$ is $y=c.$ In the graph above, the horizontal asymptote is $y=-4.$ Hence, $c=-4.$\n\nWe can solve for $k$ by finding a point on the graph and substituting for $x$ and $y.$ The labeled point on the graph is $(0,-2),$ so we substitute $x=0$ and $y=-2$ into the function and solve for $k:$\n\n$$\n\\begin{aligned}k{(\\frac{1}{3})}^{x}+c & =y \\\\ k{(\\frac{1}{3})}^{x}-4 & =y \\\\ k{(\\frac{1}{3})}^{0}-4 & =-2 \\\\ k-4 & =-2 \\\\ k & =2\\end{aligned}\n$$\n\nTherefore,\n\n$$\nk-c=2-(-4)=6.\n$$\n\nThe equation of the curve is $y=2{(\\frac{1}{3})}^{x}-4.$"}] [{:db/id #edb/ref 17592186297417 :knowledge-point/_questions [{:db/id #edb/ref 17592186068691 :knowledge-point/id #uuid "aeebf57f-21dc-558a-bec5-4e97a5b26de4" :knowledge-point/title "Calculating a Limit at Positive or Negative Infinity Using L'Hopital's Rule"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "169ba8d5-e22c-50d2-9733-e76f465346c4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186295401} {:answer/id #uuid "358520ce-be66-5f40-8a5d-895602d02530" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186295568} {:answer/id #uuid "38549704-6a61-553b-a029-2c376582ae9f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186295584} {:answer/id #uuid "6986393b-a4fa-50a9-8106-363feaca3624" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\infty " :db/id #edb/ref 17592186295859} {:answer/id #uuid "7f9c92c9-e91d-5425-a408-be18f6225423" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186295956}] :answer-field/correct {:answer/id #uuid "169ba8d5-e22c-50d2-9733-e76f465346c4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186295401} :answer-field/id #uuid "7f3a5154-fd03-5ed7-b3ff-94e6906bb61f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186296893}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "6c446587-25a8-5d97-80ba-a22c604d7eae" :question/math-academy-id "q-31517" :question/problem "${lim}_{x\\to \\infty }\\frac{x\\operatorname{ln}⁡x}{{e}^{x}}=$" :question/worked-solution "In this case, we have an indeterminate form of type $\\frac{\\infty }{\\infty },$ so applying  L'Hopital's rule yields\n\n$$\n\\begin{aligned}{lim}_{x\\to \\infty }\\frac{x\\operatorname{ln}⁡x}{{e}^{x}} & ={lim}_{x\\to \\infty }\\frac{[x\\operatorname{ln}⁡x]^{′}}{[{e}^{x}]^{′}} \\\\  & ={lim}_{x\\to \\infty }\\frac{\\operatorname{ln}⁡x+1}{{e}^{x}}.\\end{aligned}\n$$\n\nThis time, the resulting limit still gives the indeterminate form $\\frac{\\infty }{\\infty }.$ To find the limit, we apply L'Hopital's rule once again. We get\n\n$$\n\\begin{aligned}{lim}_{x\\to \\infty }\\frac{x\\operatorname{ln}⁡x}{{e}^{x}} & ={lim}_{x\\to \\infty }\\frac{\\operatorname{ln}⁡x+1}{{e}^{x}} \\\\  & ={lim}_{x\\to \\infty }\\frac{[\\operatorname{ln}⁡x+1]^{′}}{[{e}^{x}]^{′}} \\\\  & ={lim}_{x\\to \\infty }\\frac{(\\frac{1}{x})}{{e}^{x}} \\\\  & ={lim}_{x\\to \\infty }\\frac{1}{x{e}^{x}} \\\\  & =0.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186297433 :knowledge-point/_questions [{:db/id #edb/ref 17592186068689 :knowledge-point/id #uuid "8a41d750-ffd9-5226-9bd7-b763575870c1" :knowledge-point/title "Calculating a Limit Using L'Hopital's Rule Twice"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "46f99c12-e2f9-5bbc-804a-fa6dbea402f5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186295671} {:answer/id #uuid "a7fd8836-9ef9-50e6-ab47-8bc75a539eff" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186296149} {:answer/id #uuid "dbac7023-de8d-5f5e-b480-a33d75ec67c5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186296428} {:answer/id #uuid "dd1b19fb-47bf-5919-90be-4861012ba575" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\infty " :db/id #edb/ref 17592186296440} {:answer/id #uuid "efd30ef0-92ff-547d-a344-ece6965c1205" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186296544}] :answer-field/correct {:answer/id #uuid "a7fd8836-9ef9-50e6-ab47-8bc75a539eff" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186296149} :answer-field/id #uuid "90913f38-64a8-546f-a20c-a3107409ac5e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186296931}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "dc410ce1-0fb1-54b6-a7ff-4bcc2c871ce4" :question/math-academy-id "q-31585" :question/problem "${lim}_{x\\to 0}\\frac{{e}^{x}-x-1}{\\operatorname{cos}⁡x-1}=$" :question/worked-solution "If we plug in $x=0$ we get the indeterminate form $\\frac{0}{0},$ so  we apply L'Hopital's rule to find the limit:\n\n$$\n\\begin{aligned}{lim}_{x\\to 0}\\frac{{e}^{x}-x-1}{\\operatorname{cos}⁡x-1} & ={lim}_{x\\to 0}\\frac{[{e}^{x}-x-1]^{′}}{[\\operatorname{cos}⁡x-1]^{′}} \\\\  & ={lim}_{x\\to 0}\\frac{{e}^{x}-1}{-\\operatorname{sin}⁡x} \\\\  & =-{lim}_{x\\to 0}\\frac{{e}^{x}-1}{\\operatorname{sin}⁡x}\\end{aligned}\n$$\n\nThis time, the resulting limit still gives the indeterminate form $\\frac{0}{0}.$ To find the limit, we apply L'Hopital's rule once again. We get\n\n$$\n\\begin{aligned}{lim}_{x\\to 0}\\frac{{e}^{x}-x-1}{\\operatorname{cos}⁡x-1} & =-{lim}_{x\\to 0}\\frac{{e}^{x}-1}{\\operatorname{sin}⁡x} \\\\  & =-{lim}_{x\\to 0}\\frac{[{e}^{x}-1]^{′}}{[\\operatorname{sin}⁡x]^{′}} \\\\  & =-{lim}_{x\\to 0}\\frac{{e}^{x}}{\\operatorname{cos}⁡x} \\\\  & =-\\frac{{e}^{0}}{\\operatorname{cos}⁡0} \\\\  & =-\\frac{1}{1} \\\\  & =-1.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186297438 :knowledge-point/_questions [{:db/id #edb/ref 17592186068688 :knowledge-point/id #uuid "33f9c59a-257d-52f2-ab08-6986d283c94a" :knowledge-point/title "Calculating a Limit Using L'Hopital's Rule"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "43669ea8-4439-5c52-932e-09963c9aed69" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\infty " :db/id #edb/ref 17592186295646} {:answer/id #uuid "68ac4fcc-e9cd-56f7-9ba5-512586a67a7d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186295855} {:answer/id #uuid "90f6ca85-5f26-52db-bbfc-d1f9279260bd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186296045} {:answer/id #uuid "b0e455bc-7676-59e0-8421-fc92303b6dec" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186296199} {:answer/id #uuid "f0c847f9-8cd7-5aad-ae9b-9ef397a14e1c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186296549}] :answer-field/correct {:answer/id #uuid "f0c847f9-8cd7-5aad-ae9b-9ef397a14e1c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186296549} :answer-field/id #uuid "fe39cd51-4508-5a79-ba59-d1e9f1443e16" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186297155}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "e847ac9b-6147-5e36-9747-365456716188" :question/math-academy-id "q-31600" :question/problem "${lim}_{x\\to -1}\\frac{x\\operatorname{ln}⁡(x+2)}{{x}^{2}+3x+2}=$" :question/worked-solution "Note that plugging in $x=-1$ gives the indeterminate form $\\frac{0}{0}.$ However, we can use L'Hopital's rule to find this limit:\n\n$$\n\\begin{aligned}{lim}_{x\\to -1}\\frac{x\\operatorname{ln}⁡(x+2)}{{x}^{2}+3x+2} & ={lim}_{x\\to -1}\\frac{[x\\operatorname{ln}⁡(x+2)]^{′}}{[{x}^{2}+3x+2]^{′}} \\\\  & ={lim}_{x\\to -1}\\frac{(\\operatorname{ln}⁡(x+2)+\\frac{x}{x+2})}{2x+3} \\\\  & =\\frac{(\\operatorname{ln}⁡(-1+2)+\\frac{-1}{-1+2})}{2(-1)+3} \\\\  & =\\frac{\\operatorname{ln}⁡(1)-1}{1} \\\\  & =-1\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186390645 :knowledge-point/_questions [{:db/id #edb/ref 17592186115368 :knowledge-point/id #uuid "0f61a7c3-82e6-5f90-8a95-4a79078fd542" :knowledge-point/title "Vertical Reflections of Exponential Growth Functions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a771d975-2aaa-513d-bcb8-8905d9edc2ca" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/55/5559cd21367ed24058d7f0a3f1f646feb6cbdc269cbd4128788b17cbd331a01e.png" :db/id #edb/ref 17592186390647} {:answer/id #uuid "41d7c55e-75b0-54d8-907f-70f90a5594aa" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/b0/b05cb7e1d42380d1a1ac76139b39bbed49f429dbc43fddbae79b47e61d5659fd.png" :db/id #edb/ref 17592186390648} {:answer/id #uuid "1dd1f9e6-af1e-5909-94b9-5f25d90a06ae" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/30/30b885e19455654b28e87aba56427a82bfb9abe98d28dc5b542214a7fd55315f.png