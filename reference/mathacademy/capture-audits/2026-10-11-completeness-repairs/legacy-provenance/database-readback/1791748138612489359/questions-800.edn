#{[{:db/id #edb/ref 17592186401961 :knowledge-point/_questions [{:db/id #edb/ref 17592186068860 :knowledge-point/id #uuid "9d78ba1c-5297-5540-afdc-d419d33e0cf7" :knowledge-point/title "Solving a Quadratic Equation When the Solutions Are Rational"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f24ab63d-b4d8-50ae-8389-5045b51319bb" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$pq=0\\,$ and $\\,{x}_{1}+{x}_{2}=2$" :db/id #edb/ref 17592186401963} {:answer/id #uuid "6c1507f7-b1b3-56e3-a38c-1b563d660137" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$pq=-1\\,$ and $\\,{x}_{1}+{x}_{2}=1$" :db/id #edb/ref 17592186401964} {:answer/id #uuid "b2d7f47d-c746-5735-9e9f-835593e46fab" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$pq=-1\\,$ and $\\,{x}_{1}+{x}_{2}=2$" :db/id #edb/ref 17592186401965} {:answer/id #uuid "aa922213-ad7d-513f-ad50-36362f5e8cc5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$pq=1\\,$ and $\\,{x}_{1}+{x}_{2}=2$" :db/id #edb/ref 17592186401966} {:answer/id #uuid "b9d50863-24e6-52af-928c-18cf82d1862f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$pq=-1\\,$ and $\\,{x}_{1}+{x}_{2}=-1$" :db/id #edb/ref 17592186401967}] :answer-field/correct {:answer/id #uuid "b2d7f47d-c746-5735-9e9f-835593e46fab" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$pq=-1\\,$ and $\\,{x}_{1}+{x}_{2}=2$" :db/id #edb/ref 17592186401965} :answer-field/id #uuid "5f724395-4532-5650-9bbb-1b5a58b225fd" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186401962}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "85741874-6828-5db4-a1ab-e8bb9b524df8" :question/math-academy-id "q-30055" :question/problem "The equation ${x}^{2}-2x+1=1$ can be written in the form $(x+p)^{2}=q.$ Find $\\,pq\\,,$ and the sum of the roots ${x}_{1}+{x}_{2}.$" :question/worked-solution "First, we move the constant term to the right-hand side and complete the square on the left-hand side:\n\n$$\n\\begin{aligned}{x}^{2}-2x+1 & =1 \\\\ {x}^{2}-2x & =0 \\\\ {x}^{2}-2\\cdot x\\cdot 1+{1}^{2}-{1}^{2} & =0 \\\\ (x-1)^{2}-{1}^{2} & =0 \\\\ (x-1)^{2} & =1\\end{aligned}\n$$\n\nHence, $p=-1$ and $q=1.$ Thus, $pq=-1.$\n\nWe now solve the equation using the square root method:\n\n$$\n\\begin{aligned}(x-1)^{2} & =1 \\\\ \\sqrt{(x-1)^{2}} & =\\sqrt{1} \\\\ |x-1| & =1 \\\\ x-1 & =\\pm 1 \\\\ x & =1\\pm 1\\end{aligned}\n$$\n\nWe simplify the two solutions:\n\n$$\n\\begin{aligned}{x}_{1} & =1-1=0 \\\\ {x}_{2} & =1+1=2\\end{aligned}\n$$\n\nTherefore, the sum is ${x}_{1}+{x}_{2}=2.$"}] [{:db/id #edb/ref 17592186297279 :knowledge-point/_questions [{:db/id #edb/ref 17592186087823 :knowledge-point/id #uuid "40eeb5a8-3ffe-54d2-b263-f2b1c41fed93" :knowledge-point/title "Identifying a Vertically Shifted and Stretched Exponential Growth Curve"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0265ab4b-e69c-58cd-bb39-877b73f3298f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(0,11.5)" :db/id #edb/ref 17592186295275} {:answer/id #uuid "6ab493a4-b37f-5582-a8b9-4570920c001f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(10.5,0)" :db/id #edb/ref 17592186295861} {:answer/id #uuid "a1678182-8bd9-5b40-83a4-560b3c92dfe8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(0,10.5)" :db/id #edb/ref 17592186296126} {:answer/id #uuid "ecdd579a-68d8-530f-aec2-948295be5064" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(0,5.5)" :db/id #edb/ref 17592186296522} {:answer/id #uuid "f541b6c1-d1ab-5c71-9e34-c29b7b48861a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(5.5,0)" :db/id #edb/ref 17592186296566}] :answer-field/correct {:answer/id #uuid "a1678182-8bd9-5b40-83a4-560b3c92dfe8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(0,10.5)" :db/id #edb/ref 17592186296126} :answer-field/id #uuid "b0972749-6df3-5836-b156-61b2f017bcaf" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186297005}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "91d38446-45fe-5f55-b13c-726fa96fa8c7" :question/math-academy-id "q-30269" :question/problem "For the curve $y=2.5({1.5}^{x})+8$, find the point of intersection with the $y-$axis." :question/worked-solution "**Method 1**\n\n- For the curve $y={1.5}^{x},$ the point of intersection with the $y$-axis is $(0,1).$\n\n- For the scaled function $y=2.5({1.5}^{x}),$ the $y$-coordinate becomes\n\n$$\ny=2.5\\cdot 1=2.5.\n$$\n\n- Finally, after a vertical shift of $8$ units up, we get a point with the $y$-coordinate\n\n$$\ny=2.5+8=10.5.\n$$\n\n**Method 2** \n\nTo find the $y$-intercept, we substitute $x=0$ into the equation of the curve:\n\n$$\n\\begin{aligned}y & =2.5({1.5}^{0})+8 \\\\  & =2.5\\cdot 1+8 \\\\  & =2.5+8 \\\\  & =10.5\\end{aligned}\n$$\n\nTherefore, $y=2.5({1.5}^{x})+8$ intercepts the $y$-axis at $(0,10.5).$"}] [{:db/id #edb/ref 17592186297286 :knowledge-point/_questions [{:db/id #edb/ref 17592186064207 :knowledge-point/id #uuid "bdbfa506-08a1-5e43-b958-2ae373df775d" :knowledge-point/title "Integrating a Linear Rational Function and Simplifying the Arbitrary Constant"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0dbf09c3-18df-50a3-84f7-e6f47d2ef7a6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{4}{3}\\operatorname{ln}⁡(K|3x+4|)" :db/id #edb/ref 17592186295347} {:answer/id #uuid "6e3b22d0-1d8f-5569-b6bf-7b7599fb5580" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3\\operatorname{ln}⁡(K|3x+4|)" :db/id #edb/ref 17592186295876} {:answer/id #uuid "962c31da-ae4b-5022-8358-2aec9b89c95b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{4}\\operatorname{ln}⁡(K|3x+4|)" :db/id #edb/ref 17592186296067} {:answer/id #uuid "b8e4ad65-9186-54e0-8792-0e53759b7716" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{3}\\operatorname{ln}⁡(K|3x+4|)" :db/id #edb/ref 17592186296235} {:answer/id #uuid "fa999cda-1369-5935-898a-85571f00711c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{4}\\operatorname{ln}⁡(K|3x+4|)" :db/id #edb/ref 17592186296595}] :answer-field/correct {:answer/id #uuid "b8e4ad65-9186-54e0-8792-0e53759b7716" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{3}\\operatorname{ln}⁡(K|3x+4|)" :db/id #edb/ref 17592186296235} :answer-field/id #uuid "6dfec598-1f66-5fc7-8005-3949a52a7718" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186296863}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "60fb4a8e-0b44-516d-9ebb-a8d91494c67e" :question/math-academy-id "q-30368" :question/problem "Calculate $\\int \\frac{1}{3x+4}\\,\\text{d}x.$ Assume that $K$ is an arbitrary positive constant." :question/worked-solution "First, let $u=3x+4.$ Then differentiating with respect to $x$ gives\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=3\\,⟹\\,\\text{d}x=\\frac{1}{3}\\text{d}u.\n$$\n\nWe can now rewrite the integral in terms of $u,$ solve it, and write the final answer in terms of $x$ as follows:\n\n$$\n\\begin{aligned}\\int \\frac{1}{3x+4}\\,\\text{d}x & =\\int \\frac{1}{u}\\cdot \\frac{1}{3}\\,\\text{d}u \\\\  & =\\frac{1}{3}\\int \\frac{1}{u}\\,\\text{d}u \\\\  & =\\frac{1}{3}\\operatorname{ln}⁡|u|+C \\\\  & =\\frac{1}{3}\\operatorname{ln}⁡|3x+4|+C\\end{aligned}\n$$\n\nWe can further simplify the above by writing $C=\\frac{1}{3}\\operatorname{ln}⁡K$ for another arbitrary constant $K,$ and then we can combine the two terms using the laws of logarithms, as follows:\n\n$$\n\\begin{aligned}\\frac{1}{3}\\operatorname{ln}⁡|3x+4|+C & =\\frac{1}{3}\\operatorname{ln}⁡|3x+4|+\\frac{1}{3}\\operatorname{ln}⁡K \\\\  & =\\frac{1}{3}\\operatorname{ln}⁡(K|3x+4|)\\end{aligned}\n$$\n\nSo, we finally conclude that\n\n$$\n\\int \\frac{1}{3x+4}\\,\\text{d}x=\\frac{1}{3}\\operatorname{ln}⁡(K|3x+4|).\n$$"}] [{:db/id #edb/ref 17592186297305 :knowledge-point/_questions [{:db/id #edb/ref 17592186087823 :knowledge-point/id #uuid "40eeb5a8-3ffe-54d2-b263-f2b1c41fed93" :knowledge-point/title "Identifying a Vertically Shifted and Stretched Exponential Growth Curve"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5e5493f0-49e5-5ac0-a64b-444f26facf5e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(0,-10)" :db/id #edb/ref 17592186295811} {:answer/id #uuid "cedf3ffd-b468-57c5-a1fb-5644942d8367" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(0,7)" :db/id #edb/ref 17592186296352} {:answer/id #uuid "d228956c-dabb-5adf-b1f0-eea00077c044" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(0,-7)" :db/id #edb/ref 17592186296375} {:answer/id #uuid "e5e90daa-a470-5b92-aeb7-f90fc7f25a72" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(0,-6)" :db/id #edb/ref 17592186296492} {:answer/id #uuid "ec3169b4-14de-5f3c-837e-5d327959c0c6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(0,10)" :db/id #edb/ref 17592186296521}] :answer-field/correct {:answer/id #uuid "d228956c-dabb-5adf-b1f0-eea00077c044" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(0,-7)" :db/id #edb/ref 17592186296375} :answer-field/id #uuid "9ef5eb88-b39d-569b-bc4c-949ed152d723" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186296969}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "5fda2bca-a959-55aa-9acd-07aede112347" :question/math-academy-id "q-30873" :question/problem "For the curve $y=1.5({10}^{x})-8.5$, find the point of intersection with the $y-$axis." :question/worked-solution "**Method 1**\n\n- For the curve $y={10}^{x},$ the point of intersection with the $y$-axis is $(0,1).$\n\n- For the scaled function $y=1.5({10}^{x}),$ the $y$-coordinate becomes\n\n$$\ny=1.5\\cdot 1=1.5.\n$$\n\n- Finally, after a vertical shift of $8.5$ units down, we get a point with the $y$-coordinate\n\n$$\ny=1.5-8.5=-7.\n$$\n\n**Method 2** \n\nTo find the $y$-intercept, we substitute $x=0$ into the equation of the curve:\n\n$$\n\\begin{aligned}y & =1.5({10}^{0})-8.5 \\\\  & =1.5\\cdot 1-8.5 \\\\  & =1.5-8.5 \\\\  & =-7\\end{aligned}\n$$\n\nTherefore, $y=1.5({10}^{x})-8.5$ intercepts the $y$-axis at $(0,-7).$"}] [{:db/id #edb/ref 17592186069230 :knowledge-point/_questions [{:db/id #edb/ref 17592186068823 :knowledge-point/id #uuid "3eec195c-6549-5de2-b3f0-0417e5f518e7" :knowledge-point/title "Solving a \"Greater Than\" Inequality Given the Graph of the Corresponding Parabola"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3924a0d6-844d-5dc6-83c6-7db4a2fb4e17" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$x<2$ or $x>4$" :db/id #edb/ref 17592186295594} {:answer/id #uuid "440955b3-6ad7-5734-9cd2-e9f88aa0e954" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2<x<4" :db/id #edb/ref 17592186295651} {:answer/id #uuid "77034500-21c2-52e9-9478-7a3d41623c6f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$x<-4$ or $x>-2$" :db/id #edb/ref 17592186295916} {:answer/id #uuid "7798a310-53c1-5f5f-8d13-7e74a6c7123a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-4<x<-2" :db/id #edb/ref 17592186295919} {:answer/id #uuid "ef80a80c-3c32-544a-b833-12476f1cf9e6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x>2" :db/id #edb/ref 17592186296540}] :answer-field/correct {:answer/id #uuid "440955b3-6ad7-5734-9cd2-e9f88aa0e954" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2<x<4" :db/id #edb/ref 17592186295651} :answer-field/id #uuid "41198266-3a32-5b6f-aeaf-82b61bfcb718" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186296757}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "8b9f08f5-9d21-5599-bebd-c942241b0925" :question/math-academy-id "q-31015" :question/problem "![](images/11/1126d885ff5000b4afdadffef7b47dec3b2932322dfa7b75d16bc00993218a0e.png)\n\nGiven the graph above, solve the inequality $-(x-2)(x-4)>0.$" :question/worked-solution "Notice that our inequality\n\n$$\n-(x-2)(x-4)>0,\n$$\n\nis a \"*greater than*\" inequality. Therefore, we need to find the values of $x$ for which the parabola \n\n$$\ny=-(x-2)(x-4)\n$$\n\nis *above* the $x$-axis. We mark these values of $x$ in blue in the diagram below.\n\n![](images/dc/dc39c970e292e38519e609367c9f4a3d810aaca99e7040bb6227ff45401b2efc.png)\n\nSo, the solution to the inequality is $2<x<4.$"}] [{:db/id #edb/ref 17592186390592 :knowledge-point/_questions [{:db/id #edb/ref 17592186068829 :knowledge-point/id #uuid "5bb394c3-cd7c-523d-88df-b1306d9d528f" :knowledge-point/title "Identifying a Vertically Shifted Exponential Decay Curve"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c95a3fca-97ff-5e46-ad67-42c5b5b68ef4" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/bc/bc4c0c21c45fc3ed02d88150facf89718896a3e2992105f5a8a5d89b0355f9e0.png" :db/id #edb/ref 17592186390594} {:answer/id #uuid "73326b1a-1067-5996-991e-bb9d853a4e78" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/e6/e6edb90966ce90a141e3fa4ee1a9eb3cf9c7131e3121e45f56b16bc4395076d5.png" :db/id #edb/ref 17592186390595} {:answer/id #uuid "e7a74885-a855-53a6-a12b-5c1f9db59688" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/06/062274f402396a61c76fae3a47c54de80ad31deac970c746f3f8f4627ce535f1.png" :db/id #edb/ref 17592186390596} {:answer/id #uuid "dbeafe1a-8a14-5f3a-8d70-6e398d0ebc6b" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/b3/b3f96cf981a9c127dd0e3c0fa3b73f548db8c640bbc4f0e048b4576356b69532.png" :db/id #edb/ref 17592186390597} {:answer/id #uuid "44eec2a2-c1e5-5830-a6f1-3345cbd3b0c0" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/b4/b48f88ac53107fddece776c81d91fc5684c7d6f06ea3b862fb99cd973eae2dc3.png" :db/id #edb/ref 17592186390598}] :answer-field/correct {:answer/id #uuid "73326b1a-1067-5996-991e-bb9d853a4e78" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/e6/e6edb90966ce90a141e3fa4ee1a9eb3cf9c7131e3121e45f56b16bc4395076d5.png" :db/id #edb/ref 17592186390595} :answer-field/id #uuid "a5e7cf18-216c-59ac-8255-427849d7152c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186390593}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "f6a50d86-9c2e-59fc-b26e-b4043bba0c39" :question/math-academy-id "q-31146" :question/problem "Which of the following is the graph of  $y={(\\frac{1}{12})}^{x}-4?$" :question/worked-solution "First we plot the graph of $y={(\\frac{1}{12})}^{x}:$\n\n![](images/e2/e2f13711ca62a8a4a698e23bdfe78caca6df44d88ded27b88c517219dffbb866.png)\n\nNext, we shift this graph $4$ units down. \nThe horizontal asymptote under such a transformation becomes $y=-4,$ the $y$-intercept becomes $(0,-3).$\nThe resulting graph of $y={(\\frac{1}{12})}^{x}-4$ is shown below.\n\n![](images/dc/dc7f93220ac18ac5671b7b41de141940ca5296139b836d56755fdccf6164ed26.png)"}] [{:db/id #edb/ref 17592186064731 :knowledge-point/_questions [{:db/id #edb/ref 17592186064171 :knowledge-point/id #uuid "3f9548e6-28ef-5a97-ab04-dfb1b6e23c16" :knowledge-point/title "Integrating the Exponential Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0cfff078-9fb4-5b67-bb26-7811957a40b7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2{e}^{ln⁡x}+C" :db/id #edb/ref 17592186295341} {:answer/id #uuid "36c4e4d8-ea74-510a-8195-fcca114fa7c0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{{e}^{x}}{2}+C" :db/id #edb/ref 17592186295573} {:answer/id #uuid "4d71c1ee-dea6-5890-90dd-6cf50a8cd3a5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{e}^{-2x}+C" :db/id #edb/ref 17592186295711} {:answer/id #uuid "bc3c34e1-3b8b-568c-889c-57fe85dd59ea" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2{e}^{x}+C" :db/id #edb/ref 17592186296256} {:answer/id #uuid "cd13943f-d3e1-5920-9b15-4d7240e4db43" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{2}{{e}^{x}}+C" :db/id #edb/ref 17592186296342}] :answer-field/correct {:answer/id #uuid "bc3c34e1-3b8b-568c-889c-57fe85dd59ea" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2{e}^{x}+C" :db/id #edb/ref 17592186296256} :answer-field/id #uuid "b94705d1-73b6-521f-a07d-12831457766a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186297018}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "f474ed40-025d-552e-9e67-da66415ffc42" :question/math-academy-id "q-31245" :question/problem "$\\int -2{e}^{x}\\,\\text{d}x=$" :question/worked-solution "Factoring out the constant $-2$ and calculating the resulting integral, we get\n\n$$\n\\begin{aligned}\\int -2{e}^{x}\\,\\text{d}x & =-2\\int {e}^{x}\\,\\text{d}x \\\\  & =-2{e}^{x}+C.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186297342 :knowledge-point/_questions [{:db/id #edb/ref 17592186064177 :knowledge-point/id #uuid "980bb2fb-4bb5-5cbb-aea8-87010493c013" :knowledge-point/title "Integrating a Sum of Exponential Functions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1ddda862-700e-5259-8a9b-324825fe885d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{e}^{x}+\\frac{{3}^{x}}{ln⁡2}+\\frac{{x}^{2}}{3}+C" :db/id #edb/ref 17592186295436} {:answer/id #uuid "3b3aafd2-10f8-5647-aeef-217f0b123766" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2{e}^{x}-\\frac{{3}^{x}}{ln⁡3}+\\frac{{x}^{3}}{3}+C" :db/id #edb/ref 17592186295606} {:answer/id #uuid "4aaae1a6-c031-5bc5-a104-23401003f961" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{3}^{x}}{ln⁡3}+{x}^{2}+{e}^{x}+C" :db/id #edb/ref 17592186295691} {:answer/id #uuid "531024e5-c103-583c-92eb-e4200ac7a6df" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2{e}^{3x}-\\frac{{3}^{2x}}{ln⁡x}+\\frac{{x}^{2}}{2}+C" :db/id #edb/ref 17592186295744} {:answer/id #uuid "56637843-7c20-5243-80d5-7c1405ee9de3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{2}^{x}}{ln⁡2}+\\frac{{x}^{2}}{2}-3{e}^{x}+C" :db/id #edb/ref 17592186295769}] :answer-field/correct {:answer/id #uuid "3b3aafd2-10f8-5647-aeef-217f0b123766" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2{e}^{x}-\\frac{{3}^{x}}{ln⁡3}+\\frac{{x}^{3}}{3}+C" :db/id #edb/ref 17592186295606} :answer-field/id #uuid "32505d16-6c49-5e59-9ed0-fdcb1b385a52" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186296726}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "42f6b48b-f5fd-5245-b823-ea76a025e943" :question/math-academy-id "q-31252" :question/problem "$\\int (2{e}^{x}-{3}^{x}+{x}^{2})\\,\\text{d}x=$" :question/worked-solution "Here, we combine the sum rule and our exponential rules to get\n\n$$\n\\begin{aligned}\\int (2{e}^{x}-{3}^{x}+{x}^{2})\\,\\text{d}x & =2\\int {e}^{x}\\,\\text{d}x-\\int {3}^{x}\\,\\text{d}x+\\int {x}^{2}\\,\\text{d}x \\\\  & =2{e}^{x}-\\frac{{3}^{x}}{ln⁡3}+\\frac{{x}^{3}}{3}+C.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186115727 :knowledge-point/_questions [{:db/id #edb/ref 17592186115190 :knowledge-point/id #uuid "bbb56f0a-ead0-5794-9e33-7fe0e1f87dc6" :knowledge-point/title "Differentiating Expressions Involving the Cosecant Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "136ad750-eb9e-5055-a26a-c8cda8dba5ea" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x+6csc⁡xcot⁡x" :db/id #edb/ref 17592186295374} {:answer/id #uuid "1cce689b-d66b-5419-b42f-1c935770579a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2{x}^{2}-6csc⁡xcot⁡x" :db/id #edb/ref 17592186295433} {:answer/id #uuid "4c7cbd2b-769e-5c2a-8198-1408890da6d8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2+6csc⁡xcot⁡x" :db/id #edb/ref 17592186295702} {:answer/id #uuid "be094b01-e8a4-5075-a548-43ad86b83a02" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2+6csc⁡xcot⁡x" :db/id #edb/ref 17592186296269} {:answer/id #uuid "e0c1681e-054f-5ee6-ac7d-f24a14f0c567" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2x+6csc⁡xcot⁡x" :db/id #edb/ref 17592186296463}] :answer-field/correct {:answer/id #uuid "e0c1681e-054f-5ee6-ac7d-f24a14f0c567" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2x+6csc⁡xcot⁡x" :db/id #edb/ref 17592186296463} :answer-field/id #uuid "ed22d9b2-1f65-5896-a2a0-0c98a0de1f14" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186297120}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "683c5003-d2ff-5388-892e-f05923834b32" :question/math-academy-id "q-31283" :question/problem "Find ${f}^{′}(x)$ if $f(x)={x}^{2}-6csc⁡x.$" :question/worked-solution "We take the derivative of each term and then add them, as follows:\n\n$$\n\\begin{aligned}\\begin{aligned}{f}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}({x}^{2}-6csc⁡x) \\\\  & =2x-6(-csc⁡xcot⁡x) \\\\  & =2x+6csc⁡xcot⁡x\\end{aligned}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186297368 :knowledge-point/_questions [{:db/id #edb/ref 17592186064282 :knowledge-point/id #uuid "8ef81a0d-5a3a-5d7c-83e9-7d9ed0e8c5c6" :knowledge-point/title "Differentiating a Reciprocal Trigonometric Function Using the Chain Rule"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "074a9ec9-6bfa-51c3-b293-a2e6c7634c3c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186295302} {:answer/id #uuid "3b8e6cf9-9f11-5e02-a08b-b0ce3fd9f2b5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186295608} {:answer/id #uuid "64d5cac3-e49f-55a4-a517-b40d5927cff8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\pi }{2}" :db/id #edb/ref 17592186295841} {:answer/id #uuid "748fff53-6b97-5ddb-a2b7-7573ce8fffb9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186295904} {:answer/id #uuid "c09b0310-1b57-58cd-bbcf-bbf81a785509" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186296283}] :answer-field/correct {:answer/id #uuid "3b8e6cf9-9f11-5e02-a08b-b0ce3fd9f2b5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186295608} :answer-field/id #uuid "67494433-5316-509e-bbfc-ae0d8a99e4af" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186296848}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "8d5db746-ab9b-5b5a-bc25-31e21fc4632d" :question/math-academy-id "q-31338" :question/problem "Find the slope of $f(x)=\\operatorname{cot}⁡(2\\pi -3x)$ at $x=\\frac{\\pi }{2}.$" :question/worked-solution "The slope of $y=f(x)$ at $x=\\frac{\\pi }{2}$ is given by ${f}^{′}(\\frac{\\pi }{2}).$\n\nWe will calculate ${f}^{′}(x)$ using the chain rule. First, we express $f(x)$ as the composite function\n\n$$\nf=\\operatorname{cot}⁡u,\\,u=2\\pi -3x.\n$$\n\nDifferentiating gives\n\n$$\n\\frac{\\text{d}f}{\\text{d}u}=-{csc}^{2}⁡u\\,\\text{and}\\,\\frac{\\text{d}u}{\\text{d}x}=-3.\n$$\n\nWe now apply the chain rule, and get\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{\\text{d}f}{\\text{d}x}=\\frac{\\text{d}f}{\\text{d}u}\\cdot \\frac{\\text{d}u}{\\text{d}x} \\\\  & =-{csc}^{2}⁡u\\cdot (-3) \\\\  & =3{csc}^{2}⁡(2\\pi -3x).\\end{aligned}\n$$\n\nEvaluating at $x=\\frac{\\pi }{2},$ we find\n\n$$\n\\begin{aligned}\\begin{aligned}{f}^{′}(\\frac{\\pi }{2}) & =3{csc}^{2}⁡(2\\pi -\\frac{3\\pi }{2}) \\\\  & =3{csc}^{2}⁡(\\frac{\\pi }{2}) \\\\  & =3\\cdot {1}^{2} \\\\  & =3.\\end{aligned}\\end{aligned}\n$$\n\nTherefore, the slope of $y=f(x)$ at $x=\\frac{\\pi }{2}$ is $3.$"}] [{:db/id #edb/ref 17592186297371 :knowledge-point/_questions [{:db/id #edb/ref 17592186096742 :knowledge-point/id #uuid "f3ee0d5d-0821-5f6b-b613-6b814e65df50" :knowledge-point/title "Calculating a Derivative Using Multiple Instances of the Chain Rule"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "143d951a-1e7a-598c-ab01-6ac4eebb972d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "20{cot}^{3}⁡1{csc}^{2}⁡1" :db/id #edb/ref 17592186295381} {:answer/id #uuid "80ac022d-2fa2-5312-b6bb-20edccc427c6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5{cot}^{3}⁡1{sec}^{2}⁡1" :db/id #edb/ref 17592186295959} {:answer/id #uuid "cfd53f52-57a0-58c2-84e5-51e7836dcaa8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-4{cot}^{2}⁡1{csc}^{2}⁡1" :db/id #edb/ref 17592186296358} {:answer/id #uuid "df819a99-e827-5e8d-8038-4bdc1f81e2b8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "20\\operatorname{cot}⁡1{sec}^{2}⁡1" :db/id #edb/ref 17592186296451} {:answer/id #uuid "f7c37201-fff5-5a86-9be9-3c9d741d2eaa" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-4{cot}^{3}⁡1{csc}^{2}⁡1" :db/id #edb/ref 17592186296584}] :answer-field/correct {:answer/id #uuid "143d951a-1e7a-598c-ab01-6ac4eebb972d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "20{cot}^{3}⁡1{csc}^{2}⁡1" :db/id #edb/ref 17592186295381} :answer-field/id #uuid "c18783dd-cacf-52c8-94df-17f7aaad8258" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186297033}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "60550674-e8b4-5f20-9b57-5b71c82e6894" :question/math-academy-id "q-31361" :question/problem "Find ${f}^{′}(0)$ when $f(x)={cot}^{4}⁡(5x-1).$" :question/worked-solution "First, we express $f$ as the composite function\n\n$$\nf={u}^{4},\\,u=\\operatorname{cot}⁡v,\\,v=5x-1.\n$$\n\nDifferentiating gives\n\n$$\n\\frac{\\text{d}f}{\\text{d}u}=4{u}^{3},\\,\\frac{\\text{d}u}{\\text{d}v}=-{csc}^{2}⁡v,\\,\\frac{\\text{d}v}{\\text{d}x}=5.\n$$\n\nApplying now the chain rule twice, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}f}{\\text{d}x} & =\\frac{\\text{d}f}{\\text{d}u}\\cdot \\frac{\\text{d}u}{\\text{d}x} \\\\  & =\\frac{\\text{d}f}{\\text{d}u}\\cdot \\frac{\\text{d}u}{\\text{d}v}\\cdot \\frac{\\text{d}v}{\\text{d}x} \\\\  & =4{u}^{3}\\cdot (-{csc}^{2}⁡v)\\cdot 5 \\\\  & =4(\\operatorname{cot}⁡(5x-1))^{3}\\cdot (-{csc}^{2}⁡(5x-1))\\cdot 5 \\\\  & =-20{cot}^{3}⁡(5x-1){csc}^{2}⁡(5x-1)\\end{aligned}\n$$\n\nNow we compute ${f}^{′}(0):$\n\n$$\n\\begin{aligned}{f}^{′}(0) & =-20{cot}^{3}⁡(5(0)-1){csc}^{2}⁡(5(0)-1) \\\\  & =-20{cot}^{3}⁡(-1){csc}^{2}⁡(-1) \\\\  & =-20(-{cot}^{3}⁡1){csc}^{2}⁡1 \\\\  & =20{cot}^{3}⁡1{csc}^{2}⁡1\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186069235 :knowledge-point/_questions [{:db/id #edb/ref 17592186068830 :knowledge-point/id #uuid "617f0fe6-7998-5d77-b11f-55a0eca11440" :knowledge-point/title "Identifying a Vertically Shifted and Stretched Exponential Decay Curve"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "84ebbe2d-74ec-5380-9a07-702d026d313d" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/73/73590d55299fc519582252723f34bfa143818da7f03a16f7ae