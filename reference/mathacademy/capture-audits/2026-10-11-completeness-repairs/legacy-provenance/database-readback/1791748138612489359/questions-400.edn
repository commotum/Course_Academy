oint/title "Calculating the Cross Product of Two Vectors Whose Angle Is a Non-Special Angle"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "37260aa4-569a-56b0-bb4d-51362a133037" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "47.3n" :db/id #edb/ref 17592186260367} {:answer/id #uuid "38babf1b-826f-5f7d-a5cd-3ac67c6c5c4b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "44.4n" :db/id #edb/ref 17592186260379} {:answer/id #uuid "4020c8b3-0933-50e3-8a2f-bd114983e935" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "41.9n" :db/id #edb/ref 17592186260437} {:answer/id #uuid "77a304a4-bd09-5a24-a472-c61bed5b5391" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "43.7n" :db/id #edb/ref 17592186260918} {:answer/id #uuid "a65f2a98-d121-53e8-add6-b9485d0b2eb3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "40.1n" :db/id #edb/ref 17592186261324}] :answer-field/correct {:answer/id #uuid "77a304a4-bd09-5a24-a472-c61bed5b5391" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "43.7n" :db/id #edb/ref 17592186260918} :answer-field/id #uuid "28f46a5e-81da-5c5a-894d-5420cf6156b8" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186262200}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "dec81709-4d57-533e-9540-a3bae9092291" :question/math-academy-id "q-127849" :question/problem "The vector $u$ has magnitude $7$, the vector $v$ has magnitude $7,$ the angle between $u$ and $v$ is ${117}^{∘}$ and $n$ is the unit vector that points in the direction of $u\\times v.$ Find $u\\times v$ in terms of $n.$ Round your final answer to one decimal place where appropriate." :question/worked-solution "We use the formula for the cross product and obtain\n\n$$\n\\begin{aligned}u\\times v & =|u|\\cdot |v|\\cdot \\operatorname{sin}⁡\\theta \\cdot n \\\\  & =7\\cdot 7\\cdot \\operatorname{sin}⁡{117}^{∘}\\cdot n \\\\  & =49\\cdot (0.891\\,00…)\\cdot n \\\\  & =(43.659\\,31…)\\cdot n \\\\  & ≈43.7n.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186262841 :knowledge-point/_questions [{:db/id #edb/ref 17592186087703 :knowledge-point/id #uuid "4e64e0c3-f8f5-5c38-ae75-1aed92e0ac01" :knowledge-point/title "Solving for a Variable in a Singular Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0694821e-0afc-5a6f-9ac3-c60009288f14" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "a=\\pm 12" :db/id #edb/ref 17592186259936} {:answer/id #uuid "82ad1107-f4f2-56fb-a170-26080bfb5a58" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "a=\\pm 9" :db/id #edb/ref 17592186261009} {:answer/id #uuid "93eed24a-7d3e-5252-8646-ba1e56d6756f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "a=1" :db/id #edb/ref 17592186261161} {:answer/id #uuid "acb60d02-9af1-5edb-8a62-0a7f615d8394" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "a=\\pm 4" :db/id #edb/ref 17592186261386} {:answer/id #uuid "f1b9c926-8614-5473-84ac-a0af3c07259f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "a=2" :db/id #edb/ref 17592186261991}] :answer-field/correct {:answer/id #uuid "0694821e-0afc-5a6f-9ac3-c60009288f14" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "a=\\pm 12" :db/id #edb/ref 17592186259936} :answer-field/id #uuid "b5f9163f-3e19-52b4-9fae-e228093cfe55" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186262453}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "54a4b93b-d93e-5ce6-98ac-7b0ed79d28ef" :question/math-academy-id "q-127901" :question/problem "If $A=[\\begin{aligned}48 & a \\\\ a & 3\\end{aligned}]$ is a singular matrix, calculate the value(s) of $a.$" :question/worked-solution "The matrix $A$ is singular if and only if $det(A)=0.$ Calculating the determinant, we get\n\n$$\n\\begin{aligned}det(A) & =48\\cdot 3-a\\cdot a \\\\  & =144-{a}^{2}.\\end{aligned}\n$$\n\nNow, we set the determinant equal to $0$ and solve for $a:$\n\n$$\n\\begin{aligned}144-{a}^{2} & =0 \\\\ {a}^{2} & =144 \\\\ a & =\\pm 12\\end{aligned}\n$$\n\nTherefore, the values of $a$ are $a=\\pm 12.$"}] [{:db/id #edb/ref 17592186262842 :knowledge-point/_questions [{:db/id #edb/ref 17592186087703 :knowledge-point/id #uuid "4e64e0c3-f8f5-5c38-ae75-1aed92e0ac01" :knowledge-point/title "Solving for a Variable in a Singular Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "03e10364-a8ca-5a9b-8ec9-fb274ee07c3b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "t=9" :db/id #edb/ref 17592186259910} {:answer/id #uuid "64215484-b9df-5191-b8c1-9280990fe3aa" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "t=4" :db/id #edb/ref 17592186260740} {:answer/id #uuid "b5950187-60d8-50ca-a7cc-6a821b22c615" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "t=0" :db/id #edb/ref 17592186261470} {:answer/id #uuid "cec39778-4048-5806-ae58-6218823c031b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "k=\\pm 7" :db/id #edb/ref 17592186261705} {:answer/id #uuid "d2a62acf-b03a-52a7-ab5a-7633988a7413" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "k=\\pm 10" :db/id #edb/ref 17592186261728}] :answer-field/correct {:answer/id #uuid "b5950187-60d8-50ca-a7cc-6a821b22c615" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "t=0" :db/id #edb/ref 17592186261470} :answer-field/id #uuid "cfd7d4c7-e60d-5c53-95c8-2c7046132a9a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186262488}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "a4d5dba8-4e64-55e3-a838-e85b88eeb6cd" :question/math-academy-id "q-127903" :question/problem "If $M=[\\begin{aligned}t & 5 \\\\ t & 9\\end{aligned}]$ is a singular matrix, calculate the value(s) of $t.$" :question/worked-solution "The matrix $M$ is singular if and only if $det(M)=0.$ Calculating the determinant, we get\n\n$$\n\\begin{aligned}det(M) & =t\\cdot 9-t\\cdot 5 \\\\  & =9t-5t \\\\  & =4t\\end{aligned}\n$$\n\nNow, we set the determinant equal to $0$ and solve for $t:$\n\n$$\n\\begin{aligned}4t & =0 \\\\ t & =0\\end{aligned}\n$$\n\nTherefore, the value of $t$ is $t=0.$"}] [{:db/id #edb/ref 17592186262882 :knowledge-point/_questions [{:db/id #edb/ref 17592186059847 :knowledge-point/id #uuid "979859e4-b60c-548d-8da6-b180400e1b07" :knowledge-point/title "Calculating the Determinant of a 3x3 Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1682dd1e-6a3e-585a-b8de-5b23b7ea94c4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "20" :db/id #edb/ref 17592186260072} {:answer/id #uuid "1689a068-b51c-5ee0-8061-d29ddb153fe2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-5" :db/id #edb/ref 17592186260073} {:answer/id #uuid "1d2470ac-dd54-5b59-9478-94b73932f435" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "12" :db/id #edb/ref 17592186260124} {:answer/id #uuid "7d4bbf76-c7a5-5145-83ec-650fb6db1e65" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186260964} {:answer/id #uuid "de38351b-baf5-5a90-a6e5-ee73c0a46168" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-32" :db/id #edb/ref 17592186261839}] :answer-field/correct {:answer/id #uuid "de38351b-baf5-5a90-a6e5-ee73c0a46168" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-32" :db/id #edb/ref 17592186261839} :answer-field/id #uuid "b65a4ca0-f974-538c-8c68-2ae22626c269" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186262454}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "94e0f9cc-6b5b-54e5-ac6a-648684ded023" :question/math-academy-id "q-128309" :question/problem "Find the value of $|\\begin{aligned}-2 & 1 & 1 \\\\ 1 & 4 & 0 \\\\ 5 & -3 & 1\\end{aligned}|.$" :question/worked-solution "Using the formula, we take the alternating sum of the entries in the top row of the matrix, multiplied by their respective minors, as follows:\n\n$$\n\\begin{aligned}|\\begin{aligned}-2 & 1 & 1 \\\\ 1 & 4 & 0 \\\\ 5 & -3 & 1\\end{aligned}| & =-2|\\begin{aligned}4 & 0 \\\\ -3 & 1\\end{aligned}|-1|\\begin{aligned}1 & 0 \\\\ 5 & 1\\end{aligned}|+1|\\begin{aligned}1 & 4 \\\\ 5 & -3\\end{aligned}| \\\\  & =-2(4-0)-1(1-0)-1(-3-20) \\\\  & =-2\\cdot 4-1\\cdot 1+1\\cdot (-23) \\\\  & =-8-1-23 \\\\  & =-32\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186400352 :knowledge-point/_questions [{:db/id #edb/ref 17592186059848 :knowledge-point/id #uuid "32df8909-a239-5167-b8ea-412f7cdaea93" :knowledge-point/title "Identifying Singular Matrices"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4ffbd8f5-0ee6-5cad-88b8-2877cefd01dc" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186400354} {:answer/id #uuid "6c4b7403-5eeb-50d7-a4bd-09fe3acc71a2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186400355} {:answer/id #uuid "21613f83-4258-54f4-a9b2-387b0255c0f6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186400356} {:answer/id #uuid "1db912cd-3357-5080-a6af-3948ea9b0a17" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186400357} {:answer/id #uuid "ee547a84-a761-5ce9-84b8-e2abf25059e2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186400358}] :answer-field/correct {:answer/id #uuid "4ffbd8f5-0ee6-5cad-88b8-2877cefd01dc" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186400354} :answer-field/id #uuid "2c8cea4c-0392-5f09-b624-e7c6aa7142b0" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186400353}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "04472571-0a00-5fac-9502-9b8f8afd8c8a" :question/math-academy-id "q-128480" :question/problem "Which of the following statements are true regarding the matrix $D$ given below?\n\nI. $D$ is a singular matrix\nII. $det(D)=1$\nIII. $det(D)=0$\n\n$$\nD=[\\begin{aligned}2 & -3 & 1 \\\\ -1 & 2 & 3 \\\\ -3 & 5 & 2\\end{aligned}]\n$$" :question/worked-solution "Remember that a square matrix is singular if its determinant is equal to $0.$\n\nUsing the formula, we take the alternating sum of the entries in the top row of the matrix, multiplied by their respective minors, as follows:\n\n$$\n\\begin{aligned}det(D) & =|\\begin{aligned}2 & -3 & 1 \\\\ -1 & 2 & 3 \\\\ -3 & 5 & 2\\end{aligned}| \\\\  & =2|\\begin{aligned}2 & 3 \\\\ 5 & 2\\end{aligned}|+3|\\begin{aligned}-1 & 3 \\\\ -3 & 2\\end{aligned}|+1|\\begin{aligned}-1 & 2 \\\\ -3 & 5\\end{aligned}| \\\\  & =2(4-15)+3(-2+9)+1(-5+6) \\\\  & =2\\cdot (-11)+3\\cdot 7+1\\cdot 1 \\\\  & =-22+21+1 \\\\  & =0\\end{aligned}\n$$\n\n \n\nSince $det(D)=0$, the matrix is singular. \n\nTherefore, only statements I and III are true."}] [{:db/id #edb/ref 17592186400359 :knowledge-point/_questions [{:db/id #edb/ref 17592186059848 :knowledge-point/id #uuid "32df8909-a239-5167-b8ea-412f7cdaea93" :knowledge-point/title "Identifying Singular Matrices"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f0d86b56-15a8-5ce5-87a3-79892a8fcb59" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186400361} {:answer/id #uuid "72d6cc07-52e5-5150-a7c0-2f37168a2e72" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186400362} {:answer/id #uuid "c359f024-e80b-583a-9ec0-eb3841869630" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186400363} {:answer/id #uuid "ad585491-6925-5efe-a231-7cc8caa22373" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186400364} {:answer/id #uuid "ffccfcfd-c978-5441-bcf2-9a8dfaace8a6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186400365}] :answer-field/correct {:answer/id #uuid "ffccfcfd-c978-5441-bcf2-9a8dfaace8a6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186400365} :answer-field/id #uuid "f4cb87f6-39a9-56d2-9818-a6028ef6c858" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186400360}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "5bcc7af8-2cd5-53ed-a962-12d9bd009077" :question/math-academy-id "q-128491" :question/problem "Which of the following statements are true regarding the matrix $S$ given below?\n\nI. $S$ is a singular matrix\nII. $S$ is **not** a singular matrix\nIII. $det(S)=5+2\\sqrt{7}$\n\n$$\nS=[\\begin{aligned}2\\sqrt{7} & 0 & \\frac{1}{2} \\\\ -\\sqrt{7} & 2 & 0 \\\\ 5 & 0 & \\sqrt{7}\\end{aligned}]\n$$" :question/worked-solution "Remember that a square matrix is singular if its determinant is equal to $0.$\n\nUsing the formula, we take the alternating sum of the entries in the top row of the matrix, multiplied by their respective minors, as follows:\n\n$$\n\\begin{aligned}det(S) & =|\\begin{aligned}2\\sqrt{7} & 0 & \\frac{1}{2} \\\\ -\\sqrt{7} & 2 & 0 \\\\ 5 & 0 & \\sqrt{7}\\end{aligned}| \\\\  & =2\\sqrt{7}|\\begin{aligned}2 & 0 \\\\ 0 & \\sqrt{7}\\end{aligned}|-0|\\begin{aligned}-\\sqrt{7} & 0 \\\\ 5 & \\sqrt{7}\\end{aligned}|+\\frac{1}{2}|\\begin{aligned}-\\sqrt{7} & 2 \\\\ 5 & 0\\end{aligned}| \\\\  & =2\\sqrt{7}(2\\sqrt{7}-0)-0+\\frac{1}{2}(0-10) \\\\  & =2\\sqrt{7}\\cdot 2\\sqrt{7}+\\frac{1}{2}\\cdot (-10) \\\\  & =28-5 \\\\  & =23\\end{aligned}\n$$\n\nSince $det(S)=23\\ne 0$, the matrix is **not ** singular. \n\nTherefore, only statement II is true."}] [{:db/id #edb/ref 17592186388048 :knowledge-point/_questions [{:db/id #edb/ref 17592186059747 :knowledge-point/id #uuid "9c7a77cf-163a-542a-b4a3-4274344b9cf8" :knowledge-point/title "Multiplying 3x3 Square Matrices"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b3e9d798-fb90-59d5-a203-1417449a2049" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}-14 & 0 & -2 \\\\ 14 & -4 & -4 \\\\ 0 & -8 & 10\\end{aligned}]" :db/id #edb/ref 17592186388050} {:answer/id #uuid "f4ba9d1d-813c-5106-b50d-217b417a01b4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}14 & 0 & 0 \\\\ 14 & -4 & -4 \\\\ 0 & -8 & -10\\end{aligned}]" :db/id #edb/ref 17592186388051} {:answer/id #uuid "6ee9a11d-be69-54bb-9606-cb4e7fe20b6d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}14 & 0 & 2 \\\\ 14 & 4 & -4 \\\\ 0 & -8 & 1\\end{aligned}]" :db/id #edb/ref 17592186388052} {:answer/id #uuid "384a031d-89dd-52c1-8825-0b46e7ea136c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}-14 & 0 & -2 \\\\ 14 & -4 & -4 \\\\ -8 & 0 & -10\\end{aligned}]" :db/id #edb/ref 17592186388053} {:answer/id #uuid "447fd152-f5cb-5dc7-9444-3dbb71a852c7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}-14 & 4 & -2 \\\\ 14 & -4 & -4 \\\\ 0 & 0 & 10\\end{aligned}]" :db/id #edb/ref 17592186388054}] :answer-field/correct {:answer/id #uuid "b3e9d798-fb90-59d5-a203-1417449a2049" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}-14 & 0 & -2 \\\\ 14 & -4 & -4 \\\\ 0 & -8 & 10\\end{aligned}]" :db/id #edb/ref 17592186388050} :answer-field/id #uuid "51db0af0-01ec-5d77-8788-b30f88e6807d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186388049}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "cdfd9e99-dfb0-5111-9847-07557a210428" :question/math-academy-id "q-129367" :question/problem "$[\\begin{aligned}1 & 2 & 1 \\\\ 1 & -3 & 0 \\\\ 0 & -3 & 5\\end{aligned}][\\begin{aligned}-1 & -1 & -4 \\\\ -5 & 1 & 0 \\\\ -3 & -1 & 2\\end{aligned}]=$" :question/worked-solution "Multiplying each row in the first matrix by each column in the second, we get\n\n$$\n\\begin{aligned}[\\begin{aligned}1 & 2 & 1 \\\\ 1 & -3 & 0 \\\\ 0 & -3 & 5\\end{aligned}][\\begin{aligned}-1 & -1 & -4 \\\\ -5 & 1 & 0 \\\\ -3 & -1 & 2\\end{aligned}] & =[\\begin{aligned}-1-10-3 & -1+2-1 & -4+0+2 \\\\ -1+15+0 & -1-3+0 & -4+0+0 \\\\ 0+15-15 & 0-3-5 & 0+0+10\\end{aligned}] \\\\  & =[\\begin{aligned}-14 & 0 & -2 \\\\ 14 & -4 & -4 \\\\ 0 & -8 & 10\\end{aligned}].\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186398354 :knowledge-point/_questions [{:db/id #edb/ref 17592186100870 :knowledge-point/id #uuid "f38167e2-3c1d-5c00-9691-ba8e6ac6fdce" :knowledge-point/title "Determining the Dimension of the Product of Two Matrices Given the Dimensions of the Factors"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "fb5de5b4-4d8b-5c4b-949e-2701f12f4f91" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5\\times 1" :db/id #edb/ref 17592186398356} {:answer/id #uuid "639400d8-2573-593d-874f-f06ceff3176b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1\\times 5" :db/id #edb/ref 17592186398357} {:answer/id #uuid "15c0f9d4-3d25-5fe4-b265-b619e9a4fe6f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5\\times 5" :db/id #edb/ref 17592186398358} {:answer/id #uuid "4e12b0f0-56b4-5aeb-bedc-2549e8257ee3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The product is undefined" :db/id #edb/ref 17592186398359} {:answer/id #uuid "004a8839-e101-5295-a1c9-8f3e01aa9901" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "7\\times 5" :db/id #edb/ref 17592186398360}] :answer-field/correct {:answer/id #uuid "fb5de5b4-4d8b-5c4b-949e-2701f12f4f91" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5\\times 1" :db/id #edb/ref 17592186398356} :answer-field/id #uuid "152cf7f5-88d1-5058-9ac3-4041188e5fcc" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186398355}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "238922a6-1ae9-598b-83f3-1fd25fd1bf01" :question/math-academy-id "q-129480" :question/problem "What are the dimensions of $CD$, if $C$ is a $5\\times 7$ matrix and $D$ is a $7\\times 1$ matrix?" :question/worked-solution "There are $7$ columns in $C$ and $7$ rows in $D.$ Since the number of columns in $C$ equals the number of rows in $D,$ the matrices $C$ and $D$ are conformable for multiplication, and $CD$ is a $5\\times 1$ matrix: \n\n$$\n{C}_{5\\times \\boxed{\\text{7}}}{\\times }_{✓}{D}_{\\boxed{\\text{7}}\\times 1}={CD}_{5\\times 1}\n$$"}] [{:db/id #edb/ref 17592186184461 :knowledge-point/_questions [{:db/id #edb/ref 17592186184324 :knowledge-point/id #uuid "02f49ab2-8f14-568c-a602-abd2ed979ff7" :knowledge-point/title "Expanding a Binomial"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3df6f792-30b0-581a-b6bd-2f67836a57c8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1+42t+756{t}^{2}+⋯" :db/id #edb/ref 17592186263550} {:answer/id #uuid "5b6dbb1a-fc99-50a1-81d9-f8afd24b14b5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1+42t+360{t}^{2}+⋯" :db/id #edb/ref 17592186263788} {:answer/id #uuid "6145d129-7718-582d-874d-b76700586a94" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1+42t+728{t}^{2}+⋯" :db/id #edb/ref 17592186263838} {:answer/id #uuid "c9b16518-74f1-5914-b0a7-fe695c5b77f7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1+42t+724{t}^{2}+⋯" :db/id #edb/ref 17592186264764} {:answer/id #uuid "e5a49991-07e3-5b69-8f2d-1f23fc3cbb77" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1+42t+740{t}^{2}+⋯" :db/id #edb/ref 17592186265000}] :answer-field/correct {:answer/id #uuid "3df6f792-30b0-581a-b6bd-2f67836a57c8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1+42t+756{t}^{2}+⋯" :db/id #edb/ref 17592186263550} :answer-field/id #uuid "6083d815-bcab-547d-a160-6071c72c4d4b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186265413}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "2606b2ca-5cc4-52f8-ab33-6c5070667169" :question/math-academy-id "q-12960" :question/problem "${(1+6t)}^{7}=$" :question/requires-calculator true :question/worked-solution "The first three terms of the binomial expansion for $(1+x)^{n}$ are given by\n\n$$\n(1+x)^{n}=1+nx+\\frac{n(n-1)}{2!}{x}^{2}+⋯.\n$$\n\nBy substituting $x=6t$ and $n=7$ into the above formula, we obtain\n\n$$\n\\begin{aligned}{(1+6t)}^{7} & =1+7\\cdot 6t+\\frac{7(7-1)}{2!}\\cdot {(6t)}^{2}+⋯ \\\\  & =1+42t+\\frac{7\\cdot 6}{2}\\cdot 36{t}^{2}+⋯ \\\\  & =1+42t+21\\cdot 36{t}^{2}+⋯ \\\\  & =1+42t+756{t}^{2}+⋯.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186265761 :knowledge-point/_questions [{:db/id #edb/ref 17592186184324 :knowledge-point/id #uuid "02f49ab2-8f14-568c-a602-abd2ed979ff7" :knowledge-point/title "Expanding a Binomial"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2f66a633-1141-5e43-be36-28cfe57eafe8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1+9a+9{a}^{2}+⋯" :db/id #edb/ref 17592186263399} {:answer/id #uuid "34601df5-74e8-5789-9ce8-ecc7cf794ca6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1+9a+12{a}^{2}+⋯" :db/id #edb/ref 17592186263458} {:answer/id #uuid "764284ef-fc78-5f1b-a65c-ba6023841a38" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1+9a+24{a}^{2}+⋯" :db/id #edb/ref 17592186264029} {:answer/id #uuid "772654be-7bd7-5eda-b47d-9dc81a8b4e76" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1+9a+18{a}^{2}+⋯" :db/id #edb/ref 17592186264035} {:answer/id #uuid "82e00053-1273-5adf-b67e-2f8ba5daab29" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1+9a+36{a}^{2}+⋯" :db/id #edb/ref 17592186264126}] :answer-field/correct {:answer/id #uuid "82e00053-1273-5adf-b67e-2f8ba5daab29" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1+9a+36{a}^{2}+⋯" :db/id #edb/ref 17592186264126} :answer-field/id #uuid "5ce8f6ed-bbc2-51d2-bb82-a2ac80579dd8" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186265409}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "c1496f5e-966f-5bae-a9fd-d8a85554ae51" :question/math-academy-id "q-12965" :question/problem "$(1+a)^{9}=$" :question/worked-solution "The first three terms of the binomial expansion for $(1+x)^{n}$ are given by\n\n$$\n(1+x)^{n}=1+nx+\\frac{n(n-1)}{2!}{x}^{2}+⋯.\n$$\n\nBy substituting $x=a$ and $n=9$ into the above formula, we obtain\n\n$$\n\\begin{aligned}{(1+a)}^{9} & =1+9\\cdot a+\\frac{9(9-1)}{2!}\\cdot {a}^{2}+⋯ \\\\  & =1+9a+\\frac{9\\cdot 8}{2}\\cdot {a}^{2}+⋯ \\\\  & =1+9a+36{a}^{2}+⋯.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186265789 :knowledge-point/_questions [{:db/id #edb/ref 17592186068861 :knowledge-point/id #uuid "a7f04ab7-f6f6-5d01-bfcf-b667e37e4f0b" :knowledge-point/title "Solving a Quadratic Equation When the Solutions Are Irrational"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3d5085e7-9df9-5583-a9eb-4aca834756b7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "p+q=55" :db/id #edb/ref 17592186263545} {:answer/id #uuid "49bc3a1b-22cf-5a66-a6c0-83bfe3292149" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "p+q=-45" :db/id #edb/ref 17592186263634} {:answer/id #uuid "884cd699-7583-5968-ae5f-5297ccb1d1f9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "p+q=-50" :db/id #edb/ref 17592186264178} {:answer/id #uuid "8ad3250f-b580-5861-a4c8-475bce8d9d0c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "p+q=45" :db/id #edb/ref 17592186264188} {:answer/id #uuid "9c4347fb-3578-5e6a-b949-5f25952eb680" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "p+q=50" :db/id #edb/ref 17592186264338}] :answer-field/correct {:answer/id #uuid "3d5085e7-9df9-5583-a9eb-4aca834756b7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "p+q=55" :db/id #edb/ref 17592186263545} :answer-field/id #uuid "a7460a0f-9af3-55d8-9183-7f36516a5325" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186265545}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "b2094d9e-dc94-52c2-adb6-43e9a1505bb1" :question/math-academy-id "q-12995" :question/problem "The equation ${z}^{2}-25=-10z$ can be written in the form $(z+p{)}^{2}=q.$ Find $p+q.$" :question/worked-solution "First, we move the constant term to the right-hand side, the $-10z$ term to the left-hand side, and complete the square on the left-hand side.\n\n$$\n\\begin{aligned}{z}^{2}-25 & =-10z \\\\ {z}^{2}+10z & =25 \\\\ {z}^{2}+2\\cdot 5\\cdot z & =25 \\\\ {z}^{2}+2\\cdot 5\\cdot z+{5}^{2}-{5}^{2} & =25 \\\\ (z+5{)}^{2}-{5}^{2} & =25\\end{aligned}\n$$\n\nThen, we isolate the perfect square:\n\n$$\n\\begin{aligned}(z+5{)}^{2}-{5}^{2} & =25 \\\\ (z+5{)}^{2} & =50\\end{aligned}\n$$\n\nSo, $p=5,q=50,$ and $p+q=55.$"}] [{:db/id #edb/ref 17592186396018 :knowledge-point/_questions [{:db/id #edb/ref 17592186068860 :knowledge-point/id #uuid "9d78ba1c-5297-5540-afdc-d419d33e0cf7" :knowledge-point/title "Solving a Quadratic Equation When the Solutions Are Rational"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "596d615e-5286-5202-8b68-e459a1ad6de4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$p+q=64,\\,a=-12$ and $a=4$" :db/id #edb/ref 17592186396020} {:answer/id #uuid "ab85b611-a835-5c9b-b93a-92affdbe8c81" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$p+q=68,\\,a=12$ and $a=-4$" :db/id #edb/ref 17592186396021} {:answer/id #uuid "cb49ee04-f343-57a4-b655-73c807196dc3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$p+q=60,\\,a=12$ and $a=-8$" :db/id #edb/ref 17592186396022} {:answer/id #uuid "60eb227e-be77-5810-a6ee-f5a5a9b9ed9a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$p+q=68,\\,a=-12$ and $a=4$" :db/id #edb/ref 17592186396023} {:answer/id #uuid "1c7592ca-f49a-5a60-b8d5-154388f0691b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$p+q=64,\\,a=-12$ and $a=-4$" :db/id #edb/ref 17592186396024}] :answer-field/correct {:answer/id #uuid "60eb227e-be77-5810-a6ee-f5a5a9b9ed9a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$p+q=68,\\,a=-12$ and $a=4$" :db/id #edb/ref 17592186396023} :answer-field/id #uuid "950ac440-c42e-5efd-8288-46527f1353b2" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186396019}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "4870cb8f-66f0-5759-83b5-334830749092" :question/math-academy-id "q-12997" :question/problem "The equation ${a}^{2}+8a=48$ can be written in the form $(a+p{)}^{2}=q.$ Find $p+q,$ and solve the equation." :question/worked-solution "First, we complete the square on the left-hand side:\n\n$$\n\\begin{aligned}{a}^{2}+8a & =48 \\\\ {a}^{2}+2\\cdot 4\\cdot a & =48 \\\\ {a}^{2}+2\\cdot 4\\cdot a+{4}^{2}-{4}^{2} & =48 \\\\ ({a}^{2}+2\\cdot 4\\cdot a+{4}^{2})-16 & =48 \\\\ {(a+4)}^{2}-16 & =48\\end{aligned}\n$$\n\nThen, we isolate the perfect square:\n\n$$\n\\begin{aligned}(a+4{)}^{2}-16 & =48 \\\\ (a+4{)}^{2} & =64\\end{aligned}\n$$\n\nSo, $p=4,q=64,$ and $p+q=68.$\n\nNext, we solve the equation using the square-root method:\n\n$$\n\\begin{aligned}(a+4{)}^{2} & =64 \\\\ \\sqrt{(a+4{)}^{2}} & =\\sqrt{64} \\\\ a+4 & =\\pm 8 \\\\ a & =-4\\pm 8\\end{aligned}\n$$\n\nTherefore, the solutions are $a=-12$ and $a=4.$"}] [{:db/id #edb/ref 17592186265923 :knowledge-point/_questions [{:db/id #edb/ref 17592186115232 :knowledge-point/id #uuid "f4f746a1-ea9e-5136-90d6-d4dee1306c17" :knowledge-point/title "Representing a 2x2 System of Equations Using a Matrix Product by Reorganizing"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "11874c88-0d8d-5fdc-98e7-8f98e6a3f365" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}3 & 4 \\\\ 0 & -1\\end{aligned}][\\begin{aligned}x \\\\ y\\end{aligned}]=[\\begin{aligned}0 \\\\ -3\\end{aligned}]" :db/id #edb/ref 17592186263162} {:answer/id #uuid "87092bc6-cce8-59e3-97f8-85ea23e9e36d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}2 & -4 \\\\ 0 & -1\\end{aligned}][\\begin{aligned}x \\\\ y\\end{aligned}]=[\\begin{aligned}-1 \\\\ 4\\end{aligned}]" :db/id #edb/ref 17592186264169} {:answer/id #uuid "a375bbba-4d73-59f8-98fd-ff55611b114c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}3 & 4 \\\\ 0 & 1\\end{aligned}][\\begin{aligned}x \\\\ y\\end{aligned}]=[\\begin{aligned}0 \\\\ 4\\end{aligned}]" :db/id #edb/ref 17592186264389} {:answer/id #uuid "c344dea9-14a2-5e14-b911-cdb495284357" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}3 & -4 \\\\ 0 & 1\\end{aligned}][\\begin{aligned}x \\\\ y\\end{aligned}]=[\\begin{aligned}1 \\\\ -4\\end{aligned}]" :db/id #edb/ref 17592186264702} {:answer/id #uuid "d761b6a0-7cd7-5ded-a020-ef128be56117" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}4 & -3 \\\\ 0 & 1\\end{aligned}][\\begin{aligned}x \\\\ y\\end{aligned}]=[\\begin{aligned}1 \\\\ 4\\end{aligned}]" :db/id #edb/ref 17592186264877}] :answer-field/correct {:answer/id #uuid "c344dea9-14a2-5e14-b911-cdb495284357" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}3 & -4 \\\\ 0 & 1\\end{aligned}][\\begin{aligned}x \\\\ y\\end{aligned}]=[\\begin{aligned}1 \\\\ -4\\end{aligned}]" :db/id #edb/ref 17592186264702} :answer-field/id #uuid "e12d11e5-1bfe-5244-a9f3-13036e9bc00f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186265641}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "d99d7426-520b-5e1d-945d-430bc4355051" :question/math-academy-id "q-130510" :question/problem "Represent the following system of equations using matrices:\n\n$$\n\\begin{aligned}{\\begin{aligned}3x-1=4y \\\\ y=-4\\end{aligned}\\end{aligned}\n$$" :question/worked-solution "First, we organize the system so that it’s in the correct order and  both $x$ and $y$ appear in each equation:\n\n$$\n\\begin{aligned}{\\begin{aligned}3x-4y=1 \\\\ 0x+y=-4\\end{aligned}\\end{aligned}\n$$\n\nNow, we can write the system in the form $Ax=b,$ where\n\n$$\nA=[\\begin{aligned}3 & -4 \\\\ 0 & 1\\end{aligned}]\n$$\n\nis the coefficient matrix,\n\n$$\nb=[\\begin{aligned}1 \\\\ -4\\end{aligned}]\n$$\n\nis the column vector of constants, and\n\n$$\nx=[\\begin{aligned}x \\\\ y\\end{aligned}]\n$$\n\nis the column vector of variables.\n\nSo, the equation $Ax=b$ becomes\n\n$$\n[\\begin{aligned}3 & -4 \\\\ 0 & 1\\end{aligned}][\\begin{aligned}x \\\\ y\\end{aligned}]=[\\begin{aligned}1 \\\\ -4\\end{aligned}].\n$$"}] [{:db/id #edb/ref 17592186265926 :knowledge-point/_questions [{:db/id #edb/ref 17592186115233 :knowledge-point/id #uuid "fe2300a1-f31e-5a24-889a-6f45e1e8647b" :knowledge-point/title "Expressing a Matrix Product as a 2x2 System of Equations"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6e7865c0-26cb-5458-8cb7-a258df943633" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{aligned}{\\begin{aligned}10x+5y=-15 \\\\ 12x+3y=6\\end{aligned}\\end{aligned}" :db/id #edb/ref 17592186263958} {:answer/id #uuid "ba3b0d15-f891-50bd-9ed3-b118a7f0ef62" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{aligned}{\\begin{aligned}10x+25y=-15 \\\\ 12x+6y=3\\end{aligned}\\end{aligned}" :db/id #edb/ref 17592186264614} {:answer/id #uuid "c8b6d4c2-d03d-5337-bcfd-e476361be191" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{aligned}{\\begin{aligned}10x+25y=-15 \\\\ 12x+3y=6\\end{aligned}\\end{aligned}" :db/id #edb/ref 17592186264759} {:answer/id #uuid "e22492d5-d991-5958-b2dd-09b8c2ed281f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{aligned}{\\begin{aligned}2x+5y=15 \\\\ 4x+y=-6\\end{aligned}\\end{aligned}" :db/id #edb/ref 17592186264962} {:answer/id #uuid "e409a37e-e390-5a36-aca6-5945e4270bfa" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{aligned}{\\begin{aligned}2x+5y=3 \\\\ 4x+y=-2\\end{aligned}\\end{aligned}" :db/id #edb/ref 17592186264981}] :answer-field/correct {:answer/id #uuid "e409a37e-e390-5a36-aca6-5945e4270bfa" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{aligned}{\\begin{aligned}2x+5y=3 \\\\ 4x+y=-2\\end{aligned}\\end{aligned}" :db/id #edb/ref 17592186264981} :answer-field/id #uuid "0929e729-c74a-53df-b186-d608a6e127ca" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186265262}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "2e54120f-ad5a-5b0e-97ad-23133523c995" :question/math-academy-id "q-130523" :question/problem "What is the system of equations represented by\n\n$$\n[\\begin{aligned}10 & 25 \\\\ 12 & 3\\end{aligned}][\\begin{aligned}x \\\\ y\\end{aligned}]=[\\begin{aligned}15 \\\\ -6\\end{aligned}]?\n$$" :question/worked-solution "The  $2\\times 2$ matrix represents the coefficients of $x$ and $y,$ while the $2\\times 1$ column vector on the right-hand side represents the constants of the equations. So, we get the following system of equations:\n\n$$\n\\begin{aligned}{\\begin{aligned}10x+25y=15 \\\\ 12x+3y=-6\\end{aligned}\\end{aligned}\n$$\n\nSimplifying both equations in the system, we get\n\n$$\n\\begin{aligned}{\\begin{aligned}2x+5y=3 \\\\ 4x+y=-2.\\end{aligned}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186400485 :knowledge-point/_questions [{:db/id #edb/ref 17592186115233 :knowledge-point/id #uuid "fe2300a1-f31e-5a24-889a-6f45e1e8647b" :knowledge-point/title "Expressing a Matrix Product as a 2x2 System of Equations"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3cfc179d-5b69-5b59-a4e1-203c8dd4bb22" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{aligned}{\\begin{aligned}5y=9 \\\\ x=-1\\end{aligned}\\end{aligned}" :db/id #edb/ref 17592186400487} {:answer/id #uuid "9fb23989-8b95-58e0-be53-600d7e758325" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{aligned}{\\begin{aligned}5y=9 \\\\ x=1\\end{aligned}\\end{aligned}" :db/id #edb/ref 17592186400488} {:answer/id #uuid "46e0ac2a-9f8f-5e38-9016-5ba65e5cde4e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{aligned}{\\begin{aligned}5y=-9 \\\\ x=-1\\end{aligned}\\end{aligned}" :db/id #edb/ref 17592186400489} {:answer/id #uuid "8886eb42-23ce-5d40-8b2f-72b0dcb62859" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{aligned}{\\begin{aligned}x+5y=9 \\\\ x=-1\\end{aligned}\\end{aligned}" :db/id #edb/ref 17592186400490} {:answer/id #uuid "8e8b1051-a221-5a72-b1f6-4fd5bf2c673e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{aligned}{\\begin{aligned}x+5y=9 \\\\ y=-1\\end{aligned}\\end{aligned}" :db/id #edb/ref 17592186400491}] :answer-field/correct {:answer/id #uuid "3cfc179d-5b69-5b59-a4e1-203c8dd4bb22" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{aligned}{\\begin{aligned}5y=9 \\\\ x=-1\\end{aligned}\\end{aligned}" :db/id #edb/ref 17592186400487} :answer-field/id #uuid "0c4d849c-e24c-5150-9286-220ece393a3b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186400486}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "a1162f6f-3b06-5edc-926f-fe3ac4ca244f" :question/math-academy-id "q-130528" :question/problem "What is the system of equations represented by\n\n$$\n[\\begin{aligned}0 & 5 \\\\ 1 & 0\\end{aligned}][\\begin{aligned}x \\\\ y\\end{aligned}]=[\\begin{aligned}9 \\\\ -1\\end{aligned}]?\n$$" :question/worked-solution "The  $2\\times 2$ matrix represents the coefficients of $x$ and $y,$ while the $2\\times 1$ column vector on the right-hand side represents the constants of the equations. So, we get the following system of equations:\n\n$$\n\\begin{aligned}{\\begin{aligned}0x+5y=9 \\\\ x+0y=-1\\end{aligned}\\end{aligned}\n$$\n\nSimplifying both equations in the system, we get\n\n$$\n\\begin{aligned}{\\begin{aligned}5y=9 \\\\ x=-1.\\end{aligned}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186266042 :knowledge-point/_questions [{:db/id #edb/ref 17592186175901 :knowledge-point/id #uuid "eede91c4-9099-55df-a803-f87895d9f51b" :knowledge-point/title "Applying the Extreme Value Theorem to Piecewise Functions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "44ecce21-550b-523f-b8b9-aeef7fbf3bae" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186263605} {:answer/id #uuid "72477dd1-b33d-54df-b872-6f36021971cb" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186263990} {:answer/id #uuid "8a5449cc-5239-52bf-9b1a-7218973f90ed" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I, II, and III" :db/id #edb/ref 17592186264184} {:answer/id #uuid "a810da3d-3505-5c14-82f7-8bf490141215" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186264436} {:answer/id #uuid "ed55bf29-39a9-50eb-89ad-464d2079ee83" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186265073}] :answer-field/correct {:answer/id #uuid "a810da3d-3505-5c14-82f7-8bf490141215" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186264436} :answer-field/id #uuid "7ca2a258-074d-5301-bd96-9a6250fb613b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186265462}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "d91387a3-da34-5d28-af8d-36338cffabf0" :question/math-academy-id "q-131066" :question/problem "Suppose that $f(x)$ is defined as\n\n$$\nf(x)={\\begin{aligned}2, & x<0 \\\\ \\operatorname{tan}⁡x, & x\\ge 0.\\end{aligned}\n$$\n\nOn which of the following intervals can the extreme value theorem be applied to the function?\n\n- $[-\\frac{\\pi }{3},\\frac{\\pi }{3}]$\n- $[\\frac{\\pi }{6},\\frac{\\pi }{3}]$\n- $[\\frac{\\pi }{3},\\frac{2\\pi }{3}]$" :question/worked-solution "Remember that the extreme value theorem is only applicable to closed intervals on which the function is continuous.\n\nSo, let's check whether the function is continuous on each of the intervals.\n\n- Consider $[-\\frac{\\pi }{3},\\frac{\\pi }{3}].$ We have\n\n$$\n\\begin{aligned}{lim}_{x\\to {0}^{-}}f(x) & ={lim}_{x\\to 0}2=2, \\\\ {lim}_{x\\to {0}^{+}}f(x) & ={lim}_{x\\to 0}\\operatorname{tan}⁡x=0.\\end{aligned}\n$$\n\nSo, the limits from the left and from the right of $x=0$ are not the same. Hence, $f(x)$ has a discontinuity at $x=0.$ Therefore, $f(x)$ is not continuous on the interval $[-\\frac{\\pi }{3},\\frac{\\pi }{3}],$ and the extreme value theorem is not applicable on this interval.\n\n- Consider $[\\frac{\\pi }{6},\\frac{\\pi }{3}].$ In this interval, $f(x)=\\operatorname{tan}⁡x,$ so the function $f(x)$ is continuous on the interval $[\\frac{\\pi }{6},\\frac{\\pi }{3}],$ and the extreme value theorem is applicable on this interval.\n\n- Consider $[\\frac{\\pi }{3},\\frac{2\\pi }{3}].$ In this interval, $f(x)=\\operatorname{tan}⁡x,$ so the function is not defined at $x=\\frac{\\pi }{2}.$ Therefore, $f(x)$ is not continuous on the interval $[\\frac{\\pi }{3},\\frac{2\\pi }{3}],$ and the extreme value theorem is not applicable on this interval.\n\nIn conclusion, the correct answer is \"II only\"."}] [{:db/id #edb/ref 17592186400576 :knowledge-point/_questions [{:db/id #edb/ref 17592186083295 :knowledge-point/id #uuid "f4bd2a8e-357a-5f22-bd50-608e68432a8d" :knowledge-point/title "Finding Critical Points of Polynomials"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "efb825ec-4af1-502e-84e4-c2363e24558e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$x=-6$ and $x=3$" :db/id #edb/ref 17592186400578} {:answer/id #uuid "a0005f3d-2f6a-5da0-ad19-56ff2d7b1c97" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$x=-3$ and $x=4$" :db/id #edb/ref 17592186400579} {:answer/id #uuid "40bc473f-1c61-5b45-af07-0768b0375c55" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$x=-3$ and $x=6$" :db/id #edb/ref 17592186400580} {:answer/id #uuid "2ada282e-9a0b-53a0-acf3-911a8863351b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$x=-4$ and $x=3$" :db/id #edb/ref 17592186400581} {:answer/id #uuid "5eb7851c-f9c7-53a1-b68c-803e4833549a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$x=-4$ and $x=6$" :db/id #edb/ref 17592186400582}] :answer-field/correct {:answer/id #uuid "a0005f3d-2f6a-5da0-ad19-56ff2d7b1c97" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$x=-3$ and $x=4$" :db/id #edb/ref 17592186400579} :answer-field/id #uuid "40b63710-ca14-5f20-99f5-64eef01983af" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186400577}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "19a51c3a-961d-51e8-839d-dcbc2e643a8d" :question/math-academy-id "q-131188" :question/problem "Find the critical points of the function $f(x)=2{x}^{3}-3{x}^{2}-72x.$" :question/worked-solution "A critical point of $f(x)$ is a point $x=c$ in the domain of $f$ such that either ${f}^{′}(c)=0$ or ${f}^{′}(c)$ does not exist.\n\nDifferentiating $f(x),$ we obtain\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}(2{x}^{3}-3{x}^{2}-72x) \\\\  & =6{x}^{2}-6x-72.\\end{aligned}\n$$\n\nWe now proceed to find the critical points:\n\n- First, we compute the points where ${f}^{′}(c)=0.$ We set the derivative equal to zero, and solve for $x:$\n\n$$\n\\begin{aligned}6{x}^{2}-6x-72 & =0 \\\\ {x}^{2}-x-12 & =0 \\\\ (x-4)(x+3) & =0 \\\\ x & =-3,\\,4\\end{aligned}\n$$\n\nTherefore, $f(x)$ has stationary points at $x=-3$ and $x=4.$\n\n- Second, we note that ${f}^{′}(x)$ exists for all values of $x$ in the domain of $f(x).$ So $f(x)$ has no non-stationary critical points.\n\nTherefore, we conclude that the critical points of $f(x)$ are $x=-3$ and $x=4.$"}] [{:db/id #edb/ref 17592186400583 :knowledge-point/_questions [{:db/id #edb/ref 17592186083296 :knowledge-point/id #uuid "48e49ade-8bfe-56e7-8b52-950fa84e4bb0" :knowledge-point/title "Finding Critical Points of Exponential Functions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d89fcce3-b832-5e4c-bf7c-02c1c17153f9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$x=-1$ and $x=3$" :db/id #edb/ref 17592186400585} {:answer/id #uuid "fd55f488-68a4-5b1e-9bbb-f31e747d2214" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$x=0$ and $x=\\pm 1$" :db/id #edb/ref 17592186400586} {:answer/id #uuid "1facde6d-5525-541b-93d6-30090cb94ea3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$x=1$ and $x=3$" :db/id #edb/ref 17592186400587} {:answer/id #uuid "fa042a55-7109-5f70-97f2-337042cc265e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$x=0$ and $x=1$" :db/id #edb/ref 17592186400588} {:answer/id #uuid "be65614c-b0a6-53df-8fb4-0615b69a4d78" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$x=0$ and $x=3$" :db/id #edb/ref 17592186400589}] :answer-field/correct {:answer/id #uuid "fd55f488-68a4-5b1e-9bbb-f31e747d2214" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$x=0$ and $x=\\pm 1$" :db/id #edb/ref 17592186400586} :answer-field/id #uuid "80b83c99-19f6-547f-98fa-adc91ffefc5f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186400584}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "42598c74-a5de-588f-a397-c6d324d9491a" :question/math-academy-id "q-131273" :question/problem "Find the critical points of the function  $f(x)=({x}^{2}-\\frac{5}{4}){e}^{4{x}^{2}}.$" :question/worked-solution "A critical point of $f(x)$ is a point $x=c$ in the domain of $f$ such that either ${f}^{′}(c)=0$ or ${f}^{′}(c)$ does not exist.\n\nDifferentiating $f(x),$ we obtain\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}(({x}^{2}-\\frac{5}{4}){e}^{4{x}^{2}}) \\\\  & ={({x}^{2}-\\frac{5}{4})}^{′}{e}^{4{x}^{2}}+({x}^{2}-\\frac{5}{4}){({e}^{4{x}^{2}})}^{′} \\\\  & =2x{e}^{4{x}^{2}}+(8x)({x}^{2}-\\frac{5}{4}){e}^{4{x}^{2}} \\\\  & =[2x+8{x}^{3}-10x]{e}^{4{x}^{2}} \\\\  & =(8{x}^{3}-8x){e}^{4{x}^{2}}.\\end{aligned}\n$$\n\nWe now proceed to find the critical points:\n\n- First, we compute the points where ${f}^{′}(c)=0.$ We set the derivative equal to zero, and solve for $x:$\n\n$$\n\\begin{aligned}(8{x}^{3}-8x){e}^{4{x}^{2}} & =0\\end{aligned}\n$$\n\nSince ${e}^{4{x}^{2}}\\ne 0$ for all $x,$ we can divide this equation by ${e}^{4{x}^{2}}$ and solve the resulting equation.\n\n$$\n\\begin{aligned}8{x}^{3}-8x & =0 \\\\ 8x({x}^{2}-1) & =0 \\\\ 8x(x+1)(x-1) & =0 \\\\ x & =0,\\,-1,\\,1\\end{aligned}\n$$\n\nTherefore, $f(x)$ has stationary points at $x=-1,$ $x=0$ and $x=1.$\n\n- Second, we note that ${f}^{′}(x)$ exists for all values of $x$ in the domain of $f(x).$ So $f(x)$ has no non-stationary critical points.\n\nTherefore, we conclude that the critical points of $f(x)$ are $x=-1,$ $x=0$ and $x=1.$"}] [{:db/id #edb/ref 17592186266121 :knowledge-point/_questions [{:db/id #edb/ref 17592186100877 :knowledge-point/id #uuid "4d63e99a-9db4-565e-97c5-ffc3090b0074" :knowledge-point/title "Calculating a Definite Integral of a Rational Function Using Substitution"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "031259ca-bfb9-5b7f-b6a8-7ce7b040a7bf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{ln}⁡(2)-3\\operatorname{ln}⁡(5)" :db/id #edb/ref 17592186263028} {:answer/id #uuid "4b0fb49c-cf37-5bbb-ac4b-cd15a80ea2e3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{3}\\operatorname{ln}⁡(2)-\\frac{1}{3}\\operatorname{ln}⁡(5)" :db/id #edb/ref 17592186263646} {:answer/id #uuid "502e4a3c-5767-5bad-afb9-566bff4bbf5e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{3}\\operatorname{ln}⁡(2)-\\frac{1}{3}\\operatorname{ln}⁡(5)" :db/id #edb/ref 17592186263695} {:answer/id #uuid "c86b65c3-42d2-51bf-ab55-3ddc8c7be580" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{ln}⁡(2)-\\frac{1}{3}\\operatorname{ln}⁡(5)" :db/id #edb/ref 17592186264756} {:answer/id #uuid "ef28c228-7495-5093-98b4-f9461d7bffc4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\operatorname{ln}⁡(2)-\\frac{1}{3}\\operatorname{ln}⁡(5)" :db/id #edb/ref 17592186265098}] :answer-field/correct {:answer/id #uuid "c86b65c3-42d2-51bf-ab55-3ddc8c7be580" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{ln}⁡(2)-\\frac{1}{3}\\operatorname{ln}⁡(5)" :db/id #edb/ref 17592186264756} :answer-field/id #uuid "ebf4a5a8-46b3-57bc-9d21-211323b280d7" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186265667}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "d1aaf83f-8e31-580d-be7a-f74704e40ada" :question/math-academy-id "q-13189" :question/problem "Evaluate the definite integral ${\\int }_{1}^{2}\\frac{1}{3x+2}\\,\\text{d}x.$" :question/worked-solution "We start by changing the variable:\n\n$$\n\\begin{aligned}u & =3x+2 \\\\ \\frac{\\text{d}u}{\\text{d}x} & =3 \\\\ \\text{d}u & =3\\,\\text{d}x \\\\ \\frac{1}{3}\\text{d}u & =\\text{d}x\\end{aligned}\n$$\n\nNext, we create a table for the limits of integration using the rule $u=3x+2.$\n\n$$\n\\begin{aligned}x & 1 & 2 \\\\ u & 5 & 8\\end{aligned}\n$$\n\nSo, the integral in terms of the new variable is\n\n$$\n{\\int }_{1}^{2}\\frac{1}{(3x+2)}\\,\\text{d}x={\\int }_{5}^{8}\\frac{1}{u}\\cdot \\frac{1}{3}\\text{d}u.\n$$\n\nFinally, we can solve it and get\n\n$$\n\\begin{aligned}{\\int }_{5}^{8}\\frac{1}{u}\\cdot \\frac{1}{3}\\text{d}u & =\\frac{1}{3}{\\int }_{5}^{8}\\frac{1}{u}\\,\\text{d}u \\\\  & =\\frac{1}{3}\\operatorname{ln}⁡(u){|}_{5}^{8} \\\\  & =\\frac{1}{3}(\\operatorname{ln}⁡(8)-\\operatorname{ln}⁡(5)) \\\\  & =\\frac{1}{3}(\\operatorname{ln}⁡({2}^{3})-\\operatorname{ln}⁡(5)) \\\\  & =\\frac{1}{3}(3\\operatorname{ln}⁡(2)-\\operatorname{ln}⁡(5)) \\\\  & =\\operatorname{ln}⁡(2)-\\frac{1}{3}\\operatorname{ln}⁡(5).\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186268865 :knowledge-point/_questions [{:db/id #edb/ref 17592186083329 :knowledge-point/id #uuid "772ea6ab-9884-51ef-82df-a9d5cd523719" :knowledge-point/title "Finding Critical Points of Rational Functions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "73045e44-339d-5232-8626-58f98fff8223" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=2\\pm \\sqrt{5}" :db/id #edb/ref 17592186267153} {:answer/id #uuid "8ac7dc0e-586e-5673-b490-0806b2480298" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=2\\pm \\sqrt{10}" :db/id #edb/ref 17592186267383} {:answer/id #uuid "935e5baa-3edd-5980-80ab-f815c3d63410" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=-2\\pm \\sqrt{6}" :db/id #edb/ref 17592186267463} {:answer/id #uuid "951c1233-198a-5c2b-80ce-b4df12a181d0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=2\\pm \\sqrt{2}" :db/id #edb/ref 17592186267476} {:answer/id #uuid "a2277225-dbf9-56f1-be02-62c031e01d0a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=-2\\pm \\sqrt{10}" :db/id #edb/ref 17592186267602}] :answer-field/correct {:answer/id #uuid "8ac7dc0e-586e-5673-b490-0806b2480298" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=2\\pm \\sqrt{10}" :db/id #edb/ref 17592186267383} :answer-field/id #uuid "e0768589-116e-5fbb-a67c-91fcef104624" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186268804}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "5d0ffa3b-787e-578b-bbef-1ac3a2b89d8c" :question/math-academy-id "q-132464" :question/problem "What are the critical points of the function $f(x)=\\frac{x-2}{{x}^{2}+6}?$" :question/worked-solution "A critical point of $f(x)$ is a point $x=c$ in the domain of $f$ such that either ${f}^{′}(c)=0$ or ${f}^{′}(c)$ does not exist.\n\nDifferentiating $f(x),$ we obtain\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}(\\frac{x-2}{{x}^{2}+6}) \\\\  & =\\frac{(x-2)^{′}\\cdot ({x}^{2}+6)-(x-2)\\cdot ({x}^{2}+6)^{′}}{({x}^{2}+6)^{2}} \\\\  & =\\frac{({x}^{2}+6)-(x-2)\\cdot 2x}{({x}^{2}+6)^{2}} \\\\  & =\\frac{{x}^{2}+6-2{x}^{2}+4x}{({x}^{2}+6)^{2}} \\\\  & =\\frac{-{x}^{2}+4x+6}{({x}^{2}+6)^{2}} \\\\  & =-\\frac{{x}^{2}-4x-6}{({x}^{2}+6)^{2}}.\\end{aligned}\n$$\n\nWe now proceed to find the critical points:\n\n- First, we compute the points where ${f}^{′}(c)=0.$ We set the derivative equal to zero, and solve for $x$ by completing the square:\n\n$$\n\\begin{aligned}-\\frac{{x}^{2}-4x-6}{({x}^{2}+6)^{2}} & =0 \\\\ {x}^{2}-4x-6 & =0 \\\\ {x}^{2}-2\\cdot 2x+{2}^{2}-{2}^{2}-6 & =0 \\\\ (x-2)^{2}-4-6 & =0 \\\\ (x-2)^{2}-10 & =0 \\\\ (x-2)^{2} & =10 \\\\ x-2 & =\\pm \\sqrt{10} \\\\ x & =2\\pm \\sqrt{10}.\\end{aligned}\n$$\n\nTherefore, $f(x)$ has stationary points at $x=2\\pm \\sqrt{10}.$\n\n- Second, we note that ${f}^{′}(x)$ exists for all values of $x$ in the domain of $f(x).$ So $f(x)$ has no non-stationary critical points.\n\nTherefore, we conclude that the critical points of $f(x)$ are $x=2\\pm \\sqrt{10}.$"}] [{:db/id #edb/ref 17592186268877 :knowledge-point/_questions [{:db/id #edb/ref 17592186083336 :knowledge-point/id #uuid "b5cda348-b3e8-5a89-abd4-bd6f3a7a8370" :knowledge-point/title "Calculating Critical Points of Trigonometric Functions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "46902860-84f9-54b6-b3b8-3b5caed4b8fe" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{5{\\pi }^{2}}{36}" :db/id #edb/ref 17592186266773} {:answer/id #uuid "5555228b-1968-5f92-be4c-7312e7225c4a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{7{\\pi }^{2}}{36}" :db/id #edb/ref 17592186266907} {:answer/id #uuid "78d5f9fb-dfe5-506f-a077-a044cfe9fd8d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{5{\\pi }^{2}}{9}" :db/id #edb/ref 17592186267208} {:answer/id #uuid "9e2d4040-236a-598e-b8f4-30405bf6c917" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{{\\pi }^{2}}{36}" :db/id #edb/ref 17592186267568} {:answer/id #uuid "d62d33a9-c93d-5006-a190-3069e98c1625" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{2{\\pi }^{2}}{9}" :db/id #edb/ref 17592186268051}] :answer-field/correct {:answer/id #uuid "46902860-84f9-54b6-b3b8-3b5caed4b8fe" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{5{\\pi }^{2}}{36}" :db/id #edb/ref 17592186266773} :answer-field/id #uuid "1b382e58-2afe-5639-b4fc-689808dfe239" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186268449}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "f888c82d-82ba-57ac-963b-02774f1c6aab" :question/math-academy-id "q-132567" :question/problem "Consider the function $f(x)=3\\operatorname{cos}⁡x-\\sqrt{3}\\operatorname{sin}⁡x.$ If the critical points of $f(x)$ for $x\\in (-\\pi ,\\pi )$ are $x={x}_{1}$ and $x={x}_{2},$ what is the value of ${x}_{1}\\cdot {x}_{2}?$" :question/worked-solution "A critical point of $f(x)$ is a point $x=c$ in the domain of $f$ such that either ${f}^{′}(c)=0$ or ${f}^{′}(c)$ does not exist.\n\nDifferentiating $f(x),$ we obtain\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}(3\\operatorname{cos}⁡x-\\sqrt{3}\\operatorname{sin}⁡x) \\\\  & =-3\\operatorname{sin}⁡x-\\sqrt{3}\\operatorname{cos}⁡x.\\end{aligned}\n$$\n\nWe now proceed to find the critical points:\n\n- First, we compute the points where ${f}^{′}(c)=0.$ We set the derivative equal to zero, and solve for $x:$\n\n$$\n\\begin{aligned}-3\\operatorname{sin}⁡x-\\sqrt{3}\\operatorname{cos}⁡x & =0 \\\\ -3\\operatorname{sin}⁡x & =\\sqrt{3}\\operatorname{cos}⁡x \\\\ -3\\cdot \\frac{\\operatorname{sin}⁡x}{\\operatorname{cos}⁡x} & =\\sqrt{3}\\cdot \\frac{\\operatorname{cos}⁡x}{\\operatorname{cos}⁡x} \\\\ \\operatorname{tan}⁡x & =-\\frac{\\sqrt{3}}{3}\\end{aligned}\n$$\n\nThe general solution to our equation is\n\n$$\n\\begin{aligned}x & =\\operatorname{arctan}⁡(-\\frac{\\sqrt{3}}{3})+n\\pi  \\\\  & =-\\frac{\\pi }{6}+n\\pi .\\end{aligned}\n$$\n\nWe set $n=0,\\pm 1,\\pm 2,…,$ until we have generated all solutions in the domain $-\\pi <x<\\pi .$\n\n- setting $n=0$ gives $x=-\\frac{\\pi }{6}$\n\n- setting $n=1$ gives $x=\\frac{5\\pi }{6}$\n\nAll other values of $n$ generate solutions outside the domain $-\\pi <x<\\pi .$ So, the solutions to this equation for $x\\in (-\\pi ,\\pi )$ are \n\n$$\nx=-\\frac{\\pi }{6},\\,x=\\frac{5\\pi }{6}.\n$$\n\nTherefore, $f(x)$ has stationary points at $x=-\\frac{\\pi }{6}$ and $x=\\frac{5\\pi }{6}.$\n\n- Second, we note that ${f}^{′}(x)$ exists for all values of $x\\in (-\\pi ,\\pi ).$ So $f(x)$ has no non-stationary critical points.\n\nTherefore, we conclude that the critical points of $f(x)$ for $x\\in (-\\pi ,\\pi )$ are ${x}_{1}=-\\frac{\\pi }{6}$ and ${x}_{2}=\\frac{5\\pi }{6}.$\n\nFinally,\n\n$$\n{x}_{1}\\cdot {x}_{2}=-\\frac{\\pi }{6}\\cdot \\frac{5\\pi }{6}=-\\frac{5{\\pi }^{2}}{36}.\n$$"}] [{:db/id #edb/ref 17592186152417 :knowledge-point/_questions [{:db/id #edb/ref 17592186152238 :knowledge-point/id #uuid "890526df-fd1a-5340-8732-efc0c1a1b0ae" :knowledge-point/title "Estimating the Equation of a Trendline"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "406ddd97-a2f3-5770-b220-a12ff910fb55" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.7" :db/id #edb/ref 17592186266727} {:answer/id #uuid "78fccb29-a94d-5fd1-8387-f1f5806cc249" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-0.7" :db/id #edb/ref 17592186267210} {:answer/id #uuid "808bfacd-b828-51bc-aac7-15a52841d9f6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1.5" :db/id #edb/ref 17592186267276} {:answer/id #uuid "8305f82a-d153-5349-9a40-5df62a8c2dd4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186267297} {:answer/id #uuid "d926c8aa-6d92-5c1f-a305-6a624a663b13" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2.5" :db/id #edb/ref 17592186268066}] :answer-field/correct {:answer/id #uuid "808bfacd-b828-51bc-aac7-15a52841d9f6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1.5" :db/id #edb/ref 17592186267276} :answer-field/id #uuid "1c5c0a7e-bde9-5222-ac42-addf6181e056" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186268450}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "bf5281e3-0502-59b7-8231-a65966150dfe" :question/math-academy-id "q-133768" :question/problem "![](images/cb/cbe12f1271134a82701640386fcf89e39da4efbca3658569aff52cc743272660.png)\n\nEstimate the slope of the trend line for the scatter plot above. Round your answer to the nearest $0.5.$" :question/worked-solution "First, let's draw an approximate trend line for our scatter plot:\n\n![](images/05/0575edf80f4a6f26c8f1002404ac04331d4c5d1f81b644021bc6284a6212338a.png)\n\nIt seems that the trend line passes through $({x}_{1},{y}_{1})≈(2,2)$ and $({x}_{2},{y}_{2})≈(6,8).$\n\nTherefore, we estimate the slope $m$ of the line as follows:\n\n$$\n\\begin{aligned}m & ≈\\frac{{y}_{2}-{y}_{1}}{{x}_{2}-{x}_{1}} \\\\  & =\\frac{8-2}{6-2} \\\\  & =\\frac{6}{4} \\\\  & =1.5\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186180064 :knowledge-point/_questions [{:db/id #edb/ref 17592186179653 :knowledge-point/id #uuid "892f45fd-1e75-5500-90c3-0218fab5f1e1" :knowledge-point/title "Using Trend Lines to Make Predictions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "02d1fd6e-6806-5107-a9b9-f1166aad9873" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2012" :db/id #edb/ref 17592186266168} {:answer/id #uuid "49bae636-6d63-5ff3-91b0-bda02c7cd5cf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2008" :db/id #edb/ref 17592186266797} {:answer/id #uuid "49efc2d2-24de-56ad-9d1a-ea04160e642f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2006" :db/id #edb/ref 17592186266800} {:answer/id #uuid "72680e93-fc03-5818-886b-1fb7836935fa" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2010" :db/id #edb/ref 17592186267147} {:answer/id #uuid "817d7a73-060a-5abb-89b0-40c2335aae2e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2004" :db/id #edb/ref 17592186267283}] :answer-field/correct {:answer/id #uuid "72680e93-fc03-5818-886b-1fb7836935fa" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2010" :db/id #edb/ref 17592186267147} :answer-field/id #uuid "4f0345eb-4f3c-542f-aca7-5c58e9ccc429" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186268544}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "04c26611-8a14-59f2-b00c-17923a404b5a" :question/math-academy-id "q-133772" :question/problem "![](images/97/9749ca6ec771a94dc60c64a48c2b3924641db17ced56b131bc530e1eb51eb1a0.png)\n\nThe scatter plot above shows the population of a town recorded at certain times between the years $2000$ and $2020.$\nUse the trend line to estimate in which year the town's population was $56\\,000.$" :question/worked-solution "To make our estimation, we proceed as follows:\n\n- We start at $y=56$ on the vertical axis.\n\n![](images/a9/a9d57651c5c342c3d619a20cfae2bc632df47f8924d49f400ed764870b7ae900.png)\n\n- Then, we move right until we intersect the trend line.\n\n![](images/c8/c816d47fc84f31c3a436818777d9473b68e9d8468051c40fe9b7b94005cc89ee.png)\n\n- Finally, we move down until we intersect the horizontal axis.\n\n![](images/e6/e6cbfe34a6e3bd002171d2474542a12c66b7d88ce5989b0fbb4b3542f76a2155.png)\n\nTherefore, the population was $56\\,000$ in approximately the year $2000+10=2010.$"}] [{:db/id #edb/ref 17592186180065 :knowledge-point/_questions [{:db/id #edb/ref 17592186179654 :knowledge-point/id #uuid "28adc95e-e6e5-580c-9eed-55a3d12d5232" :knowledge-point/title "Using Trend Line Equations to Make a Prediction"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4f440f8d-212e-598d-8f9f-659b6451b176" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "10" :db/id #edb/ref 17592186266851} {:answer/id #uuid "52760bde-f5a5-5528-95ef-7bbe23fe19c7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "14" :db/id #edb/ref 17592186266881} {:answer/id #uuid "584b3843-6687-57b7-ac8c-269a9c085fc3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "13" :db/id #edb/ref 17592186266932} {:answer/id #uuid "78ec6a8d-4d13-5508-b86f-b1f23b549353" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186267209} {:answer/id #uuid "9d86b59d-0202-5aff-b73f-257b8701b1a0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "12" :db/id #edb/ref 17592186267561}] :answer-field/correct {:answer/id #uuid "52760bde-f5a5-5528-95ef-7bbe23fe19c7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "14" :db/id #edb/ref 17592186266881} :answer-field/id #uuid "0ecb75f6-2653-5a85-866a-87ded5f8c3cc" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186268434}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "f9a2fa13-4227-5518-b473-4e39aa559784" :question/math-academy-id "q-133774" :question/problem "![](images/47/47b77320474a559f69e6ef08b8f6638aac920b05014820ab1b4b82690059c997.png)\n\nThe scatter plot above gives the correspondence between the variables $x$ and $y$ for some data points.\nThe equation of the trend line is $y=-0.5x+9.$ Assuming this trend continues, estimate the value of $x$ when $y=2.$" :question/requires-calculator true :question/worked-solution "We can estimate the required value by substituting $y=2$ into the equation of the trend line and solving for $x:$\n\n$$\n\\begin{aligned}y & =-0.5x+9 \\\\ 2 & =-0.5x+9 \\\\ 2+0.5x & =9 \\\\ 0.5x & =7 \\\\ x & =14\\end{aligned}\n$$\n\nTherefore, according to this model, when $y=2$ we have $x≈14.$\n\nNote: The point where $y=2$ is not shown on our trend line. Therefore, our result *may* be unreliable."}] [{:db/id #edb/ref 17592186400695 :knowledge-point/_questions [{:db/id #edb/ref 17592186179654 :knowledge-point/id #uuid "28adc95e-e6e5-580c-9eed-55a3d12d5232" :knowledge-point/title "Using Trend Line Equations to Make a Prediction"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e4c4d81f-1807-5985-bc75-f78a53aceac8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$10$ decades" :db/id #edb/ref 17592186400697} {:answer/id #uuid "2b8e005e-3461-54dc-ade3-c36922d765ff" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$7$ decades" :db/id #edb/ref 17592186400698} {:answer/id #uuid "f3927082-1031-515d-8b67-7ab60167c394" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$11$ decades" :db/id #edb/ref 17592186400699} {:answer/id #uuid "72fb5990-5df5-5b7d-af99-8c775eef439e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$8$ decades" :db/id #edb/ref 17592186400700} {:answer/id #uuid "baae8426-6809-58f7-b30c-71ec0d63e5b6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$9$ decades" :db/id #edb/ref 17592186400701}] :answer-field/correct {:answer/id #uuid "baae8426-6809-58f7-b30c-71ec0d63e5b6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$9$ decades" :db/id #edb/ref 17592186400701} :answer-field/id #uuid "276c6bfa-9bed-5b15-b91d-56f8ec1aea0e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186400696}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "87bad21a-36f4-5e06-9484-4b7826190ce1" :question/math-academy-id "q-133929" :question/problem "![](images/ce/ce3aec85d418c8f51988f819c04403f3f3ea2e0c0e35165ed729fc1e78d0f12f.png)\n\nThe scatter plot shows the value of an artwork $y,$ in thousands of dollars, and the number of decades $x$ since it was first created. The equation of the trend line is $y=3x+5.$ \n\nAssuming this trend continues, estimate the time it takes for the artwork to be worth $$32\\,000.$" :question/worked-solution "To predict the time that must pass before the artwork is worth $$32\\,000,$ we need to substitute $y=32$ into the equation of the trend line and solve for $x:$\n\n$$\n\\begin{aligned}y & =3x+5 \\\\ 32 & =3x+5 \\\\ 3x & =27 \\\\ x & =9\\end{aligned}\n$$\n\n \n\nTherefore, according to this model, it takes approximately $9$ decades for the artwork to have a value of $$32\\,000.$ \n\nNote: The point where $y=32$ is not shown on our trend line. Therefore, our result *may* be unreliable."}] [{:db/id #edb/ref 17592186268936 :knowledge-point/_questions [{:db/id #edb/ref 17592186179655 :knowledge-point/id #uuid "877509f5-a5de-55d2-ab5d-6c37fc5b0650" :knowledge-point/title "Making a Prediction by Estimating a Trend Line"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "35b193b3-2679-5e57-8519-13a75ee39c10" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "9.5" :db/id #edb/ref 17592186266607} {:answer/id #uuid "63960119-96c8-5a11-ac8b-ce536b8c33fa" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186267020} {:answer/id #uuid "6d5351fc-ea93-5077-808a-2e970121ae5c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8.5" :db/id #edb/ref 17592186267106} {:answer/id #uuid "741f39ef-7c89-590a-98d9-9e6e5d60231a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "10" :db/id #edb/ref 17592186267164} {:answer/id #uuid "e30490b9-cb52-56b4-adaf-fdd3ed2b6536" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "9" :db/id #edb/ref 17592186268150}] :answer-field/correct {:answer/id #uuid "e30490b9-cb52-56b4-adaf-fdd3ed2b6536" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "9" :db/id #edb/ref 17592186268150} :answer-field/id #uuid "454866ab-76dc-5d3a-ae98-8d88fb102885" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186268522}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "b4e2e69a-6742-55aa-baed-902f71aaf13b" :question/math-academy-id "q-133943" :question/problem "![](images/7b/7ba7aa1cf49bb5a2dc430d9a21baaa8491aa61d8898f2aad142406c5c569b51b.png)\n\nThe scatter plot above gives the correspondence between the variables $x$ and $y$ for some data points. Estimate the value of $x$ when $y=7.$ \n\n*Hint: Assume the trend is linear, and that the trend line passes through the points $(1,1)$ and $(5,4).$*" :question/worked-solution "First, using the hint, let's draw an approximate trend line for our scatter plot.\n\n![](images/59/59efe1b79b0d032179a5210ee694b0d59ad082853ca9fb80a9d79d9f6444f2bf.png)\n\nOur trend line passes through $({x}_{1},{y}_{1})=(1,1)$ and $({x}_{2},{y}_{2})=(5,4).$\n\nWe will write the equation of the line in the slope-intercept form \n\n$$\ny=mx+b.\n$$\n\nFirst, we calculate the slope $m$ of the line as follows:\n\n$$\n\\begin{aligned}m & =\\frac{{y}_{2}-{y}_{1}}{{x}_{2}-{x}_{1}} \\\\  & =\\frac{4-1}{5-1} \\\\  & =\\frac{3}{4} \\\\  & =0.75\\end{aligned}\n$$\n\nSubstituting $m=0.75$ into the slope-intercept form above, we get\n\n$$\ny=0.75x+b.\n$$\n\nWe now need to calculate the $y$-intercept $b.$ We can do this by substituting the coordinates of a point on the line. Any point will do, so let's substitute $(1,1):$\n\n$$\n\\begin{aligned}y & =0.75x+b \\\\ 1 & =0.75(1)+b \\\\ 1 & =0.75+b \\\\ b & =0.25\\end{aligned}\n$$\n\nTherefore, the equation of the line is \n\n$$\ny=0.75x+0.25.\n$$\n\nFinally, we substitute $y=7$ into the equation above and solve for $x:$\n\n$$\n\\begin{aligned}y & =0.75x+0.25 \\\\ 7 & =0.75x+0.25 \\\\ 6.75 & =0.75x \\\\ x & =9\\end{aligned}\n$$\n\nTherefore, according to this model, when $y=7$ we have $x≈9.$\n\nNote: The point where $y=7$ is not shown on our trend line. Therefore, our result *may* be unreliable."}] [{:db/id #edb/ref 17592186268942 :knowledge-point/_questions [{:db/id #edb/ref 17592186179655 :knowledge-point/id #uuid "877509f5-a5de-55d2-ab5d-6c37fc5b0650" :knowledge-point/title "Making a Prediction by Estimating a Trend Line"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "17f29363-b569-5d10-bfb6-d2079ad002cc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "18" :db/id #edb/ref 17592186266341} {:answer/id #uuid "21adce06-163c-56df-805d-189e82316cfd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "20" :db/id #edb/ref 17592186266444} {:answer/id #uuid "5eb9a5f6-a02a-50a1-82fc-c1b17fea560a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "17" :db/id #edb/ref 17592186266978} {:answer/id #uuid "8471999f-0fd0-539e-80f6-36a51c97305c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "21" :db/id #edb/ref 17592186267308} {:answer/id #uuid "84f2a1f9-f092-5363-87eb-b298f12956d6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "19" :db/id #edb/ref 17592186267314}] :answer-field/correct {:answer/id #uuid "17f29363-b569-5d10-bfb6-d2079ad002cc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "18" :db/id #edb/ref 17592186266341} :answer-field/id #uuid "6bb94996-186d-52e6-9592-b3343bd68e4c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186268601}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "9cd1cd6f-81d1-5aa8-a97e-ba1b2bd9d144" :question/math-academy-id "q-133965" :question/problem "![](images/e3/e3319694b1112e92602219492d51116d514a88e885431ac1ef0c8f8becb0dc18.png)\n\nA tea shop wants to determine the relationship between the outside temperature and the number of customers they serve. The scatter plot above shows the information they collected over several days. Assuming this trend continues, estimate the number of customers the tea shop expects to serve if the outside temperature is ${36}^{∘}\\,\\text{C}.$\n\n*Hint: Assume the trend is linear and that the trend line passes through the points $(15,60)$ and $(30,30).$*" :question/worked-solution "First, using the hint, let's draw an approximate trend line for our scatter plot.\n\n![](images/7a/7adb5dd9bfcfcea8842eebfcacc704237f010f87c8ffd695afab890801237abd.png)\n\nThe trend line passes through $({x}_{1},{y}_{1})=(15,60)$ and $({x}_{2},{y}_{2})=(30,30).$\n\nWe will write the equation of the line in the slope-intercept form \n\n$$\ny=mx+b.\n$$\n\nFirst, we find the slope $m$ of the line as follows:\n\n$$\n\\begin{aligned}m & =\\frac{{y}_{2}-{y}_{1}}{{x}_{2}-{x}_{1}} \\\\  & =\\frac{30-60}{30-15} \\\\  & =\\frac{(-30)}{15} \\\\  & =-2\\end{aligned}\n$$\n\nSubstituting $m=-2$ into the slope-intercept form above, we get\n\n$$\ny=-2x+b.\n$$\n\nWe now need to calculate the $y$-intercept $b.$ We can do this by substituting the coordinates of a point on the line. Any point will do, so let's substitute $(15,60):$\n\n$$\n\\begin{aligned}y & =-2x+b \\\\ 60 & =-2(15)+b \\\\ 60 & =-30+b \\\\ b & =90\\end{aligned}\n$$\n\nTherefore, the equation of the line is \n\n$$\ny=-2x+90.\n$$\n\nFinally, we substitute $x=36$ into the equation above, which gives\n\n$$\n\\begin{aligned}y & =-2x+90 \\\\  & =-2(36)+90 \\\\  & =-72+90 \\\\  & =18.\\end{aligned}\n$$\n\nTherefore, according to this model, the tea shop expects to serve $18$ customers.\n\nNote: The point where $x=36$ is not shown on our trend line. Therefore, our result *may* be unreliable."}] [{:db/id #edb/ref 17592186268943 :knowledge-point/_questions [{:db/id #edb/ref 17592186179653 :knowledge-point/id #uuid "892f45fd-1e75-5500-90c3-0218fab5f1e1" :knowledge-point/title "Using Trend Lines to Make Predictions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3219263b-abe6-5728-9661-5138a2700247" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$5$ hours" :db/id #edb/ref 17592186266585} {:answer/id #uuid "381bfb6f-c43f-59ee-a686-ab558a709a60" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$5.5$ hours" :db/id #edb/ref 17592186266631} {:answer/id #uuid "5bc2d41a-ea63-5ca1-9147-b914f0535d73" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$4.5$ hours" :db/id #edb/ref 17592186266957} {:answer/id #uuid "6b0c2701-9911-51b4-900b-6cab03bd2c54" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$6$ hours" :db/id #edb/ref 17592186267091} {:answer/id #uuid "eec77403-0e51-5d0c-9b05-535493cd6148" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$4$ hours" :db/id #edb/ref 17592186268269}] :answer-field/correct {:answer/id #uuid "3219263b-abe6-5728-9661-5138a2700247" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$5$ hours" :db/id #edb/ref 17592186266585} :answer-field/id #uuid "8409954c-10b2-59ea-b026-9a4d57399061" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186268643}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "d6bab4ea-9515-5432-8897-bfe0c69aa515" :question/math-academy-id "q-133967" :question/problem "![](images/1d/1d4df2d201ccbaf2305534d61c8a0ed5f7957b1629d8cd2fbd5fff933283c0dc.png)\n\nThe scatter plot above shows the number of matches won by some chess players in a championship and the hours they spend training per day.\nUse the trend line to estimate how much time players need to train each day to win $30$ championship games." :question/worked-solution "To make our estimation, we proceed as follows:\n\n- We start at $y=30$ on the vertical axis.\n\n![](images/26/26ba10258a8794a97dfc5e61c8160b342ed6890f7a9af40c1e21ac814c779188.png)\n\n- Then, we move right until we intersect the trend line.\n\n![](images/e5/e50d79adb9803f6509314cf3512fcd388ccc78b287d6653b9e318ce54ce45022.png)\n\n- Finally, we move down until we intersect the horizontal axis.\n\n![](images/a9/a9bd5a7973ecb2e88c328d0943d4bfebe9862b2cea1abbd0b3fa3665fa177167.png)\n\nTherefore, a chess player that wins $30$ games spends around $5$ hours training per day."}] [{:db/id #edb/ref 17592186388307 :knowledge-point/_questions [{:db/id #edb/ref 17592186152233 :knowledge-point/id #uuid "79f1049a-8af9-50ee-9dac-9dbd9c19bdc6" :knowledge-point/title "Correctly Identifying a Scatter Plot"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d71911a4-1607-57a3-939c-1ce77fc6b325" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/d5/d5d7978459fa262b16b4216fa5363a8f14f431e6524163d6e1bbc0f0bdaad7dc.png" :db/id #edb/ref 17592186388309} {:answer/id #uuid "f6dd706d-50c4-58f6-b939-f20e9d0556b5" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/5b/5bdbaadf2d3ea794c145365f5ee61ee4c1551dc72b62c8a681933b9aac74d214.png" :db/id #edb/ref 17592186388310} {:answer/id #uuid "30229580-8e50-507d-83e4-267c38aa9543" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/75/75196d39e72e9ce6ba5b0b32ca486d191bbe209a8a646b030c83b2979fdc3054.png" :db/id #edb/ref 17592186388311} {:answer/id #uuid "6aa0cce7-f139-50cd-9987-c94e8df7b25d" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/58/58c61701533884a6497bb0e3f692adf4a4d72c648577451fae650dbd164e5001.png" :db/id #edb/ref 17592186388312} {:answer/id #uuid "237d4951-e701-5b11-a8f1-c101458de5ec" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/37/37667e67c6148e8e46c216b1351ada6b16b0e9d3a22de69564415679535fc92e.png" :db/id #edb/ref 17592186388313}] :answer-field/correct {:answer/id #uuid "f6dd706d-50c4-58f6-b939-f20e9d0556b5" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/5b/5bdbaadf2d3ea794c145365f5ee61ee4c1551dc72b62c8a681933b9aac74d214.png" :db/id #edb/ref 17592186388310} :answer-field/id #uuid "02ccddff-56cd-51ab-852a-3e4a3e3b4576" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186388308}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "935951a4-ee2a-54bc-9e42-14a72505ef8e" :question/math-academy-id "q-133968" :question/problem "A teacher wants to determine whether a student's performance in mathematics influences their performance in physics. The following table shows the grades of $5$ students in a mathematics and physics class. \n\n| **Math Grade** | **$8$** | **$6$** | **$8$** | **$4$** | **$5$** |\n| --- | --- | --- | --- | --- | --- |\n| **Physics Grade** | $9$ | $5$ | $8$ | $4$ | $3$ |\n\nWhich of the following scatter plots represents this data?" :question/worked-solution "We create a scatter diagram in the coordinate plane as follows:\n\n- First, we draw the independent variable (math grade) along the horizontal axis.\n\n- Then, we draw the dependent variable (physics grade) along the vertical axis.\n\n- Finally, we plot the points that correspond to the pairs from the data.\n\nThis gives us the following scatter plot.\n\n![](images/5b/5bdbaadf2d3ea794c145365f5ee61ee4c1551dc72b62c8a681933b9aac74d214.png)"}] [{:db/id #edb/ref 17592186388314 :knowledge-point/_questions [{:db/id #edb/ref 17592186152233 :knowledge-point/id #uuid "79f1049a-8af9-50ee-9dac-9dbd9c19bdc6" :knowledge-point/title "Correctly Identifying a Scatter Plot"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1d96ca6e-aa39-56b6-a603-08fb5fae2a80" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/72/726a22a7d72af2ba9a7b9c9568cc1723557ee8c0af4dd38a3dd9bacca4f72769.png" :db/id #edb/ref 17592186388316} {:answer/id #uuid "9816374b-f222-57ec-9346-41bf02f900e3" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/ef/ef920634ab0391c8b13566e8575ee66839bcaf38dd6e4d87bfa336035ab10166.png" :db/id #edb/ref 17592186388317} {:answer/id #uuid "66b02031-af4a-5dc1-ac7f-ed1163e286f3" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/b7/b741264e080009d9e634e7ffce5e9041b6cd65b34e4d840700397a7378255ea8.png" :db/id #edb/ref 17592186388318} {:answer/id #uuid "448502eb-fb15-5ab2-9d96-04aeaf2da0b1" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/8e/8ea63450225d8b50e6f00e012afcd3afe8215eb573ed3a31ce9aa57c30ec8132.png" :db/id #edb/ref 17592186388319} {:answer/id #uuid "8388f37e-7b04-57a4-a21b-751817dec11b" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/81/81364754556cfeed2c4a2b74d2c745c054491e7f0a9e1d2512fffe6dc4569e5d.png" :db/id #edb/ref 17592186388320}] :answer-field/correct {:answer/id #uuid "66b02031-af4a-5dc1-ac7f-ed1163e286f3" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/b7/b741264e080009d9e634e7ffce5e9041b6cd65b34e4d840700397a7378255ea8.png" :db/id #edb/ref 17592186388318} :answer-field/id #uuid "da2b298a-e144-5d4b-ab37-e427ce14674c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186388315}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "711b7d57-8e73-5262-a6cb-c7a387e51978" :question/math-academy-id "q-133969" :question/problem "Lucy, who plays basketball, notices that the number of points she scores in a game increases as a function of the number of hours she practices her jump shot each week. She records the following data.\n\n| **Number of Hours Training** | **$4$** | **$6$** | **$7$** | **$8$** | **$10$** |\n| --- | --- | --- | --- | --- | --- |\n| **Points Scored per Game** | $8$ | $12$ | $16$ | $20$ | $28$ |\n\nWhich of the following scatter plots represents this data?" :question/worked-solution "We create a scatter diagram in the coordinate plane as follows:\n\n- First, we draw the independent variable (number of hours training) along the horizontal axis.\n\n- Then, we draw the dependent variable (points scored per game) along the vertical axis.\n\n- Finally, we plot the points that correspond to the pairs from the data.\n\nThis gives us the following scatter plot.\n\n![](images/b7/b741264e080009d9e634e7ffce5e9041b6cd65b34e4d840700397a7378255ea8.png)"}] [{:db/id #edb/ref 17592186176329 :knowledge-point/_questions [{:db/id #edb/ref 17592186176031 :knowledge-point/id #uuid "534de76f-d4bc-55b5-858e-2b594f63b7bc" :knowledge-point/title "Calculating Distance Given Speed and Time"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "00100cbe-fb7e-5a60-bebf-70ac5833c23b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$145$ miles" :db/id #edb/ref 17592186266151} {:answer/id #uuid "39cf88bf-156e-548d-929c-87b676eb8d65" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$165$ miles" :db/id #edb/ref 17592186266654} {:answer/id #uuid "63e7bb25-145e-5483-bd59-9ec85466a225" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$185$ miles" :db/id #edb/ref 17592186267023} {:answer/id #uuid "6fa4073d-79a4-50e5-bcf9-c804d6b75650" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$21.3$ miles" :db/id #edb/ref 17592186267124} {:answer/id #uuid "cde549c5-0f81-5026-93bf-a2769df847df" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$18.3$ miles" :db/id #edb/ref 17592186267983}] :answer-field/correct {:answer/id #uuid "39cf88bf-156e-548d-929c-87b676eb8d65" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$165$ miles" :db/id #edb/ref 17592186266654} :answer-field/id #uuid "bef8f0e7-5010-5fd0-8979-0100c812c7ee" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186268746}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "6a0c4502-fd0b-5e9b-b54c-913ee6f1d90c" :question/math-academy-id "q-133998" :question/problem "A car traveled for $3$ hours at a constant speed of $55$ miles per hour. Find the distance covered by the car." :question/worked-solution "The speed is $55$ miles per hour. To find the distance covered in $3$ hours, we multiply the speed by $3.$ This gives\n\n$$\n\\begin{aligned}\\text{distance} & =\\text{speed}\\cdot \\text{time} \\\\  & =55\\times 3 \\\\  & =165.\\end{aligned}\n$$\n\nTherefore, the car covered $165$ miles in $3$ hours."}] [{:db/id #edb/ref 17592186268946 :knowledge-point/_questions [{:db/id #edb/ref 17592186152236 :knowledge-point/id #uuid "327d9a77-b2dd-57b1-b959-570684714bf9" :knowledge-point/title "Identifying the Trendline of a Given Scatter Plot"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0badc2a7-9d18-544e-95c9-c64da7e9c069" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "s" :db/id #edb/ref 17592186266252} {:answer/id #uuid "35da4120-6c49-56a1-b4f1-055106750242" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "q" :db/id #edb/ref 17592186266608} {:answer/id #uuid "3d3a362f-50bb-5456-a748-deeddca0fb05" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "There is no linear trend in the data" :db/id #edb/ref 17592186266685} {:answer/id #uuid "7bd12cf4-3138-5ad4-8eb1-bbe87cb1c95c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "r" :db/id #edb/ref 17592186267241} {:answer/id #uuid "7f6dbac1-f9c2-5628-942c-c4da294b9bcc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "p" :db/id #edb/ref 17592186267266}] :answer-field/correct {:answer/id #uuid "3d3a362f-50bb-5456-a748-deeddca0fb05" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "There is no linear trend in the data" :db/id #edb/ref 17592186266685} :answer-field/id #uuid "7c701653-8f0b-5c04-9905-d5b7c399e9be" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186268632}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "155124c2-60a1-5157-a592-034e3900447f" :question/math-academy-id "q-134008" :question/problem "![](images/29/294e45be62260374df597915428bf83ac676ce709d727a7d194755cb73d78b72.png)\n\nThe scatter plot above shows the correspondence between the distance of a house from the nearest public transport facility and its price, in thousands of dollars, among a sample of newly built homes. Which of the following is the trend line of the scatter plot?" :question/worked-solution "The plot shows that the data points are scattered along a curve, not a straight line.\n\n![](images/e4/e4654e24215c05554c4985cccc2dcce5f6579de537a6218f4b859f13ff276a29.png)\n\nTherefore, there is no linear trend in the data."}] [{:db/id #edb/ref 17592186268947 :knowledge-point/_questions [{:db/id #edb/ref 17592186152236 :knowledge-point/id #uuid "327d9a77-b2dd-57b1-b959-570684714bf9" :knowledge-point/title "Identifying the Trendline of a Given Scatter Plot"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "19df2904-6b7c-58b7-88b2-f605d8ef8506" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "s" :db/id #edb/ref 17592186266356} {:answer/id #uuid "206a46ed-1970-5316-95be-58e720077042" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "q" :db/id #edb/ref 17592186266429} {:answer/id #uuid "9f00bb6e-9294-56b5-992c-5b2f338a0360" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "p" :db/id #edb/ref 17592186267579} {:answer/id #uuid "aa4ceff1-9762-5e9a-86c1-ecb6e7702031" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "r" :db/id #edb/ref 17592186267682} {:answer/id #uuid "ada9a303-0bc7-52d4-9bc2-ee3bd198d19d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "There is no linear trend in the data" :db/id #edb/ref 17592186267713}] :answer-field/correct {:answer/id #uuid "ada9a303-0bc7-52d4-9bc2-ee3bd198d19d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "There is no linear trend in the data" :db/id #edb/ref 17592186267713} :answer-field/id #uuid "2f754f6c-4370-57d3-9e5d-4f14615413c2" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186268490}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "595cbfc4-8fff-5045-9e69-dae0c1acb047" :question/math-academy-id "q-134009" :question/problem "![](images/f6/f64050151e65151975954cdf169379c5ea6ee80b0348a6cb03706ab64c7c7105.png)\n\nWhich of the following is the trend line of the scatter plot?" :question/worked-solution "The plot shows that the data points are scattered along a curve, not a straight line.\n\n![](images/00/00fe583ae8b83bfef31c1914489be7794aa4b7b2850cd01243a46b8d86d1dddb.png)\n\nTherefore, there is no linear trend in the data."}] [{:db/id #edb/ref 17592186268953 :knowledge-point/_questions [{:db/id #edb/ref 17592186152237 :knowledge-point/id #uuid "63426ad7-4275-5ac3-854d-e91ec00dcbe3" :knowledge-point/title "Determining the Equation of a Trendline"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0cd690fa-a856-5e7a-9318-0c4566b49546" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=-\\frac{6}{7}x+8" :db/id #edb/ref 17592186266261} {:answer/id #uuid "222179f7-b6d3-5bda-ba3b-3ad5ca6b0879" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=-\\frac{2}{3}x+9" :db/id #edb/ref 17592186266448} {:answer/id #uuid "676d808b-15b5-5614-89b0-8e029be3a390" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=-\\frac{6}{7}x+9" :db/id #edb/ref 17592186267061} {:answer/id #uuid "a05574d9-4140-5362-b547-5792491d39de" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=-\\frac{5}{7}x+9" :db/id #edb/ref 17592186267591} {:answer/id #uuid "a5de5494-8c30-5f08-bbb3-f4fedda8e8dd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=-\\frac{5}{7}x+8" :db/id #edb/ref 17592186267644}] :answer-field/correct {:answer/id #uuid "676d808b-15b5-5614-89b0-8e029be3a390" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=-\\frac{6}{7}x+9" :db/id #edb/ref 17592186267061} :answer-field/id #uuid "90a152be-2b26-5653-9dda-9d79bf62f9af" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186268659}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "cb94748a-2270-55c2-8da9-a11e4005f88b" :question/math-academy-id "q-134019" :question/problem "![](images/31/31394106551498e7fd3a5cf57773f11ae31c7bc80c9a12272e95033bdcfd462e.png)\n\nDetermine the equation of the trend line shown above." :question/worked-solution "Notice that the trend line passes through the points $({x}_{1},{y}_{1})=(0,9)$ and $({x}_{2},{y}_{2})=(7,3).$\n\nWe will write the equation of the line in the slope-intercept form \n\n$$\ny=mx+b.\n$$\n\nFirst, we compute the slope $m$ of the line, as follows:\n\n$$\n\\begin{aligned}m & =\\frac{{y}_{2}-{y}_{1}}{{x}_{2}-{x}_{1}} \\\\  & =\\frac{3-9}{7-0} \\\\  & =\\frac{-6}{7} \\\\  & =-\\frac{6}{7}\\end{aligned}\n$$\n\nSubstituting $m=-\\frac{6}{7}$ into the slope-intercept form above, we get\n\n$$\ny=-\\frac{6}{7}x+b.\n$$\n\nWe now need to find the $y$-intercept $b.$ We can find this by substituting the coordinates of a point on the line. Any point will do, so let's substitute $(0,9):$\n\n$$\n\\begin{aligned}y & =-\\frac{6}{7}x+b \\\\ 9 & =-\\frac{6}{7}(0)+b \\\\ 9 & =0+b \\\\ b & =9\\end{aligned}\n$$\n\nTherefore, the equation of the line is \n\n$$\ny=-\\frac{6}{7}x+9.\n$$"}] [{:db/id #edb/ref 17592186268954 :knowledge-point/_questions [{:db/id #edb/ref 17592186152237 :knowledge-point/id #uuid "63426ad7-4275-5ac3-854d-e91ec00dcbe3" :knowledge-point/title "Determining the Equation of a Trendline"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3800c633-4663-5a7c-977b-4d0c6dda0f87" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=\\frac{7}{5}x-\\frac{3}{5}" :db/id #edb/ref 17592186266629} {:answer/id #uuid "53efa526-eb5e-5256-af09-1eec2833abff" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=\\frac{7}{5}x-\\frac{2}{5}" :db/id #edb/ref 17592186266895} {:answer/id #uuid "aba8afc3-be94-5f08-8b22-73af4c6b41c5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=\\frac{6}{5}x-\\frac{2}{5}" :db/id #edb/ref 17592186267693} {:answer/id #uuid "ef8916a0-dcf5-50b0-b591-84f24b525679" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=\\frac{8}{5}x-\\frac{3}{5}" :db/id #edb/ref 17592186268274} {:answer/id #uuid "f31ff6ea-86e9-5bba-a3ed-309adf564a34" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=\\frac{6}{5}x-\\frac{3}{5}" :db/id #edb/ref 17592186268306}] :answer-field/correct {:answer/id #uuid "aba8afc3-be94-5f08-8b22-73af4c6b41c5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=\\frac{6}{5}x-\\frac{2}{5}" :db/id #edb/ref 17592186267693} :answer-field/id #uuid "d9d24660-a466-52cd-ab29-3ad82a1272ba" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186268793}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "1c42b7eb-86b2-59d5-8ce6-728291f9e718" :question/math-academy-id "q-134023" :question/problem "![](images/1c/1c9f30692222eaaed4cda6b608dcc1ccb01eefd6b5fa7730b5b8bb29c9f528b1.png)\n\nDetermine the equation of the trend line shown above." :question/worked-solution "Notice that the trend line passes through the points $({x}_{1},{y}_{1})=(2,2)$ and $({x}_{2},{y}_{2})=(7,8).$\n\nWe will write the equation of the line in the slope-intercept form \n\n$$\ny=mx+b.\n$$\n\nFirst, we compute the slope $m$ of the line, as follows:\n\n$$\n\\begin{aligned}m & =\\frac{{y}_{2}-{y}_{1}}{{x}_{2}-{x}_{1}} \\\\  & =\\frac{8-2}{7-2} \\\\  & =\\frac{6}{5}\\end{aligned}\n$$\n\nSubstituting $m=\\frac{6}{5}$ into the slope-intercept form above, we get\n\n$$\ny=\\frac{6}{5}x+b.\n$$\n\nWe now need to find the $y$-intercept $b.$ We can find this by substituting the coordinates of a point on the line. Any point will do, so let's substitute $(2,2):$\n\n$$\n\\begin{aligned}y & =\\frac{6}{5}x+b \\\\ 2 & =\\frac{6}{5}(2)+b \\\\ 2 & =\\frac{12}{5}+b \\\\ 10 & =12+5b \\\\ -2 & =5b \\\\ b & =-\\frac{2}{5}\\end{aligned}\n$$\n\nTherefore, the equation of the line is \n\n$$\ny=\\frac{6}{5}x-\\frac{2}{5}.\n$$"}] [{:db/id #edb/ref 17592186268957 :knowledge-point/_questions [{:db/id #edb/ref 17592186152238 :knowledge-point/id #uuid "890526df-fd1a-5340-8732-efc0c1a1b0ae" :knowledge-point/title "Estimating the Equation of a Trendline"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "85e950e4-4f31-56d6-b780-7f613d916580" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=-0.5x+7" :db/id #edb/ref 17592186267323} {:answer/id #uuid "95835b8d-412b-5f8f-ad13-bd0cceeefc76" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=-1.5x+6" :db/id #edb/ref 17592186267479} {:answer/id #uuid "e9f40f28-45a1-51e8-91ce-8332e573ca21" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=-x+5" :db/id #edb/ref 17592186268230} {:answer/id #uuid "fa3381b5-606e-57ef-aa88-1eeb423ceab7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=-0.5x+5" :db/id #edb/ref 17592186268360} {:answer/id #uuid "fa94c930-a716-5697-abac-a07e0bafa0ee" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=-x+7" :db/id #edb/ref 17592186268362}] :answer-field/correct {:answer/id #uuid "fa94c930-a716-5697-abac-a07e0bafa0ee" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=-x+7" :db/id #edb/ref 17592186268362} :answer-field/id #uuid "202555d8-a079-561f-a3ef-02ab11a55efb" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186268456}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "cd67326e-eade-5de0-b602-784a91831a0b" :question/math-academy-id "q-134031" :question/problem "![](images/11/111833881cf8e939d896f23a5ab7ca436f9265e7b8fd66c099eb118eab8fd6b0.png)\n\nEstimate the equation of the trend line for the scatter plot above. Round both the slope and the $y$-intercept to the nearest $0.5.$" :question/worked-solution "First, let's draw an approximate trend line for our scatter plot:\n\n![](images/fd/fdad2c939372e14617ba4e393037d7f5852cd8114467aa914ccb8963c0eacfeb.png)\n\nIt seems that the trend line passes through $({x}_{1},{y}_{1})≈(2,5)$ and $({x}_{2},{y}_{2})≈(6,1).$\n\nWe will write the equation of the line in the slope-intercept form \n\n$$\ny=mx+b.\n$$\n\nFirst, we estimate the slope $m$ of the line as follows:\n\n$$\n\\begin{aligned}m & ≈\\frac{{y}_{2}-{y}_{1}}{{x}_{2}-{x}_{1}} \\\\  & =\\frac{1-5}{6-2} \\\\  & =\\frac{-4}{4} \\\\  & =-1\\end{aligned}\n$$\n\nSubstituting $m=-1$ into the slope-intercept form above, we get\n\n$$\ny=-x+b.\n$$\n\nWe now need to estimate the $y$-intercept $b.$ We can do this by substituting the coordinates of a point on the line. Any point will do, so let's substitute $(2,5):$\n\n$$\n\\begin{aligned}y & =-x+b \\\\ 5 & =-2+b \\\\ 7 & =b \\\\ b & =7\\end{aligned}\n$$\n\nTherefore, the equation of the line is \n\n$$\ny=-x+7.\n$$"}] [{:db/id #edb/ref 17592186268961 :knowledge-point/_questions [{:db/id #edb/ref 17592186152235 :knowledge-point/id #uuid "7f99f2aa-f977-5d6e-ae62-a826a897ba9b" :knowledge-point/title "Reading a Scatter Plot"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "93b0f7b8-b781-54c4-a185-a692da720e33" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "90%" :db/id #edb/ref 17592186267467} {:answer/id #uuid "93c6b873-1244-55dd-a5d0-7e953959f130" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "85%" :db/id #edb/ref 17592186267468} {:answer/id #uuid "ba35ff19-d85c-5142-84b2-93a8f390294b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "70%" :db/id #edb/ref 17592186267815} {:answer/id #uuid "ce9bdb9f-cdf1-552b-86b5-3b68d3b691fe" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "75%" :db/id #edb/ref 17592186267992} {:answer/id #uuid "da1adb01-9156-561a-b4db-38e2dc065dd9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "80%" :db/id #edb/ref 17592186268075}] :answer-field/correct {:answer/id #uuid "93c6b873-1244-55dd-a5d0-7e953959f130" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "85%" :db/id #edb/ref 17592186267468} :answer-field/id #uuid "0c7565e4-dc8a-5b42-b83a-83fc7e504012" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186268431}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "43fcfab7-3240-5e37-8741-3769fb9bd3d5" :question/math-academy-id "q-134043" :question/problem "![](images/80/80d08441967f6c1a4026fe9ca0d2bdfdde8fac57a2ae0a7b8d6b34889f3469bd.png)\n\nThe scatter plot above shows the relationship between hours of study per week and the overall percentage obtained by students in a math class. What was the overall percentage obtained by the student who studied, on average,  $7$ hours each week?" :question/worked-solution "![](images/39/39e7370f9cf517a7a139fecf71561041a9b1470150e0fa333d3fff679f77882d.png)\n\n    \n\nTo determine the overall percentage obtained by the student who studied $7$ hours each week, we locate $7$ on the horizontal axis and move in the vertical direction until we find some points, as shown above.\n\nThe highlighted point has coordinates $(7,85).$ Therefore, the student who studied $7$ hours each week obtained an overall percentage of $85%.$"}] [{:db/id #edb/ref 17592186398382 :knowledge-point/_questions [{:db/id #edb/ref 17592186152235 :knowledge-point/id #uuid "7f99f2aa-f977-5d6e-ae62-a826a897ba9b" :knowledge-point/title "Reading a Scatter Plot"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3b931d3b-ada2-5b04-a7ba-3e5388b9aa35" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186398384} {:answer/id #uuid "ce0bbf2c-bd3b-5933-b107-38c36abe9e06" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186398385} {:answer/id #uuid "1275d8d1-87ea-51ac-80ba-d13b5b0d06d3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186398386} {:answer/id #uuid "c0d3ff95-8a16-5335-b1eb-84d2fbc5830f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186398387} {:answer/id #uuid "cf078eaa-4e8e-529e-aeaf-cf7c18b72b3c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186398388}] :answer-field/correct {:answer/id #uuid "1275d8d1-87ea-51ac-80ba-d13b5b0d06d3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186398386} :answer-field/id #uuid "c816f258-3ddf-536d-ab66-8610e4b22204" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186398383}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "6b5dde64-1d37-5f32-890c-5a590a1188e6" :question/math-academy-id "q-134085" :question/problem "![](images/55/551ed1182231e19a08653c86ffb7b117c2dc9497b6927f6287ffcd10651b5f56.png)\n\nThe scatter plot above shows the relationship between the number of absences in a month and the size of a class. How many absences were there in a class whose size is $20$ students?" :question/worked-solution "![](images/80/8088e41a66b4aba259d95f3099f71d5777caf876e9278e6b7f11c865ab12f7e0.png)\n\nTo determine the number of absences there were in a class whose size is $20$ students, we locate $20$ on the horizontal axis and move in the vertical direction until we find some points, as shown above.\n\nThe highlighted point has coordinates $(20,6).$ Therefore, there was a total of $6$ absences in the month for the class with $20$ students."}] [{:db/id #edb/ref 17592186268969 :knowledge-point/_questions [{:db/id #edb/ref 17592186175936 :knowledge-point/id #uuid "a2ac0065-9315-547a-a9cf-c6a5abea1aed" :knowledge-point/title "Computing Covariance"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "311e284a-a84b-5e7f-b5a1-e35c8f0d5168" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186266576} {:answer/id #uuid "64ccf930-ce1a-5735-bf79-470826f036dc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186267036} {:answer/id #uuid "76132fbf-5e71-5e70-90ec-a505fc2186fe" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186267185} {:answer/id #uuid "853262fc-b92a-5438-baec-a53e6c209102" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186267317} {:answer/id #uuid "a31cd77b-6b2c-52dc-a626-7500d351a1a2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186267611}] :answer-field/correct {:answer/id #uuid "311e284a-a84b-5e7f-b5a1-e35c8f0d5168" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186266576} :answer-field/id #uuid "aca651ef-8c84-5b8a-8875-73fe007986c0" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186268716}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "1d0e8ef1-dbd3-5d5d-b9cb-f3092550c8dd" :question/math-academy-id "q-134155" :question/problem "Consider the following data sets:\n\n$$\nx={4,\\,6,\\,8,\\,2},\\,y={2,\\,4,\\,10,\\,8}\n$$\n\nYou're given that $\\overset{―}{x}=5$ and $\\overset{―}{y}=6.$ Calculate $\\text{Cov}(x,y).$" :question/worked-solution "The (population) covariance of the data sets $x={{x}_{1},{x}_{2},…,{x}_{n}}$ and $y={{y}_{1},{y}_{2},…,{y}_{n}}$ is given by \n\n$$\n\\text{Cov}(x,y)=\\frac{1}{n}{\\sum }_{i=1}^{n}({x}_{i}-\\overset{―}{x})({y}_{i}-\\overset{―}{y}),\n$$\n\nwhere $\\overset{―}{x}=\\frac{1}{n}{\\sum }_{i=1}^{n}{x}_{i}$ and $\\overset{―}{y}=\\frac{1}{n}{\\sum }_{i=1}^{n}{y}_{i}$ are the means of the data sets.\n\nTherefore, the covariance of our data sets is\n\n$$\n\\begin{aligned}\\text{Cov}(x,y) & =\\frac{1}{n}{\\sum }_{i=1}^{n}({x}_{i}-\\overset{―}{x})({y}_{i}-\\overset{―}{y}) \\\\  & =\\frac{1}{4}[(4-5)(2-6)+(6-5)(4-6)+(8-5)(10-6)+(2-5)(8-6)] \\\\  & =\\frac{1}{4}[(-1)(-4)+(1)(-2)+(3)(4)+(-3)(2)] \\\\  & =\\frac{1}{4}[4-2+12-6] \\\\  & =\\frac{1}{4}\\cdot 8 \\\\  & =2.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186268973 :knowledge-point/_questions [{:db/id #edb/ref 17592186175936 :knowledge-point/id #uuid "a2ac0065-9315-547a-a9cf-c6a5abea1aed" :knowledge-point/title "Computing Covariance"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6c96926a-f4ac-5a4a-bb28-483eebe3a042" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186267101} {:answer/id #uuid "92bb008b-73e2-5f57-aaf9-b1c9670bb361" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186267454} {:answer/id #uuid "98e29162-e94e-5e48-a63c-803330198e5a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186267522} {:answer/id #uuid "de2ab8f0-3c69-58b4-9838-f8a533c7f98f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "7" :db/id #edb/ref 17592186268105} {:answer/id #uuid "f2efc021-dda9-5c9f-ba17-5d373e53d90c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186268303}] :answer-field/correct {:answer/id #uuid "de2ab8f0-3c69-58b4-9838-f8a533c7f98f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "7" :db/id #edb/ref 17592186268105} :answer-field/id #uuid "69377ba2-c0ef-5769-b77b-40c99fa0f34c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186268596}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "4cf798d3-99fb-51d5-934b-1e9180edf066" :question/math-academy-id "q-134159" :question/problem "Consider the following data sets:\n\n$$\nx={-1,\\,6,\\,2,\\,5},\\,y={-2,\\,5,\\,7,\\,6}\n$$\n\nYou're given that $\\overset{―}{x}=3$ and $\\overset{―}{y}=4.$ Calculate $\\text{Cov}(x,y).$" :question/worked-solution "The (population) covariance of the data sets $x={{x}_{1},{x}_{2},…,{x}_{n}}$ and $y={{y}_{1},{y}_{2},…,{y}_{n}}$ is given by \n\n$$\n\\text{Cov}(x,y)=\\frac{1}{n}{\\sum }_{i=1}^{n}({x}_{i}-\\overset{―}{x})({y}_{i}-\\overset{―}{y}),\n$$\n\nwhere $\\overset{―}{x}=\\frac{1}{n}{\\sum }_{i=1}^{n}{x}_{i}$ and $\\overset{―}{y}=\\frac{1}{n}{\\sum }_{i=1}^{n}{y}_{i}$ are the means of the data sets.\n\nTherefore, the covariance of our data sets is\n\n$$\n\\begin{aligned}\\text{Cov}(x,y) & =\\frac{1}{n}{\\sum }_{i=1}^{n}({x}_{i}-\\overset{―}{x})({y}_{i}-\\overset{―}{y}) \\\\  & =\\frac{1}{4}[(-1-3)(-2-4)+(6-3)(5-4)+(2-3)(7-4)+(5-3)(6-4)] \\\\  & =\\frac{1}{4}[(-4)(-6)+(3)(1)+(-1)(3)+(2)(2)] \\\\  & =\\frac{1}{4}[24+3-3+4] \\\\  & =\\frac{1}{4}\\cdot 28 \\\\  & =7.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186268975 :knowledge-point/_questions [{:db/id #edb/ref 17592186176030 :knowledge-point/id #uuid "88babe91-d8bf-53ba-8d72-35ad35f9253e" :knowledge-point/title "Calculating the Speed of an Object"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "048cab5e-bbd5-5811-a4d0-8ca8f85ee145" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$4$ feet per second" :db/id #edb/ref 17592186266183} {:answer/id #uuid "1cf5c97b-a06e-5922-ae8a-d7e195b65387" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$14$ feet per second" :db/id #edb/ref 17592186266390} {:answer/id #uuid "b717b37d-f4d7-5f70-ac90-3365030a3801" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$280$ feet per second" :db/id #edb/ref 17592186267783} {:answer/id #uuid "de613ffe-4f41-5a9b-bffe-1b7387734d36" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$40$ feet per second" :db/id #edb/ref 17592186268107} {:answer/id #uuid "f9712262-c406-555b-85c5-19c0f9652329" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$70$ feet per second" :db/id #edb/ref 17592186268355}] :answer-field/correct {:answer/id #uuid "048cab5e-bbd5-5811-a4d0-8ca8f85ee145" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$4$ feet per second" :db/id #edb/ref 17592186266183} :answer-field/id #uuid "aa305f49-8c63-5967-8dbe-bb8cee6aab2a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186268711}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "363ac4b8-fa48-5948-b74e-bd2bdaf627fa" :question/math-academy-id "q-134164" :question/problem "A canoe traveled $280$ feet in $70$ seconds at a constant rate.  What is the speed of the canoe?" :question/worked-solution "Speed is a special unit rate applied to moving objects. It is defined as *the distance traveled per unit of time*:\n\n$$\n\\text{speed}=\\frac{\\text{distance}}{\\text{time}}\n$$\n\nTo find the speed (in feet per second), we divide the number of feet, $280,$ by the number of seconds, $70.$ This gives,\n\n$$\n\\frac{280}{70}=280÷70=4.\n$$\n\nTherefore, the speed of the canoe is $4$ feet per second."}] [{:db/id #edb/ref 17592186268979 :knowledge-point/_questions [{:db/id #edb/ref 17592186175936 :knowledge-point/id #uuid "a2ac0065-9315-547a-a9cf-c6a5abea1aed" :knowledge-point/title "Computing Covariance"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "441b2c8e-dbaf-594e-9f26-8da9b148397f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-5" :db/id #edb/ref 17592186266751} {:answer/id #uuid "e5ea4787-26d6-5c8e-aa9d-ebc03249189b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186268180} {:answer/id #uuid "e5fd8492-13b4-5fa1-a203-4c2b1a8f2b15" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186268182} {:answer/id #uuid "fb8685e4-075d-5c33-9c2e-d13e809a6745" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-8" :db/id #edb/ref 17592186268368} {:answer/id #uuid "fccdee25-35d1-5ea4-b1da-a4668ce1fbe4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186268374}] :answer-field/correct {:answer/id #uuid "441b2c8e-dbaf-594e-9f26-8da9b148397f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-5" :db/id #edb/ref 17592186266751} :answer-field/id #uuid "923f23dc-8259-592b-ae04-9981fc36c9d3" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186268661}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "8776d2b8-cc6d-5825-8f19-b2c66c611b9a" :question/math-academy-id "q-134170" :question/problem "Calculate $\\text{Cov}(x,y)$ for the following data sets:\n\n$$\nx={4,\\,-2,\\,5,\\,1},\\,y={-7,\\,5,\\,4,\\,-2}\n$$" :question/worked-solution "The (population) covariance of the data sets $x={{x}_{1},{x}_{2},…,{x}_{n}}$ and $y={{y}_{1},{y}_{2},…,{y}_{n}}$ is given by \n\n$$\n\\text{Cov}(x,y)=\\frac{1}{n}{\\sum }_{i=1}^{n}({x}_{i}-\\overset{―}{x})({y}_{i}-\\overset{―}{y}),\n$$\n\nwhere $\\overset{―}{x}=\\frac{1}{n}{\\sum }_{i=1}^{n}{x}_{i}$ and $\\overset{―}{y}=\\frac{1}{n}{\\sum }_{i=1}^{n}{y}_{i}$ are the means of the data sets.\n\nFirst, we need to compute the means:\n\n$$\n\\begin{aligned}\\overset{―}{x} & =\\frac{1}{n}{\\sum }_{i=1}^{n}{x}_{i} \\\\  & =\\frac{1}{4}\\cdot (4+(-2)+5+1) \\\\  & =\\frac{1}{4}\\cdot 8 \\\\  & =2 \\\\ \\overset{―}{y} & =\\frac{1}{n}{\\sum }_{i=1}^{n}{y}_{i} \\\\  & =\\frac{1}{4}\\cdot ((-7)+5+4+(-2)) \\\\  & =\\frac{1}{4}\\cdot 0 \\\\  & =0\\end{aligned}\n$$\n\nTherefore, the covariance of our data sets is\n\n$$\n\\begin{aligned}\\text{Cov}(x,y) & =\\frac{1}{n}{\\sum }_{i=1}^{n}({x}_{i}-\\overset{―}{x})({y}_{i}-\\overset{―}{y}) \\\\  & =\\frac{1}{4}[(4-2)(-7-0)+(-2-2)(5-0)+(5-2)(4-0)+(1-2)(-2-0)] \\\\  & =\\frac{1}{4}[(2)(-7)+(-4)(5)+(3)(4)+(-1)(-2)] \\\\  & =\\frac{1}{4}[-14-20+12+2] \\\\  & =\\frac{1}{4}\\cdot (-20) \\\\  & =-5.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186268980 :knowledge-point/_questions [{:db/id #edb/ref 17592186176030 :knowledge-point/id #uuid "88babe91-d8bf-53ba-8d72-35ad35f9253e" :knowledge-point/title "Calculating the Speed of an Object"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "388381c6-d3f3-5ce8-9343-272755a4a1de" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$145$ feet per minute" :db/id #edb/ref 17592186266636} {:answer/id #uuid "8f5968e7-47fd-59f2-84a5-9faaa2be9ff9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$150.5$ feet per minute" :db/id #edb/ref 17592186267423} {:answer/id #uuid "9918aa8c-9fab-5e35-b660-6a295161995a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$132.5$ feet per minute" :db/id #edb/ref 17592186267525} {:answer/id #uuid "a388233f-9461-523b-bf1c-23eb098cf553" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$301$ feet per minute" :db/id #edb/ref 17592186267615} {:answer/id #uuid "b60499d9-26b2-5a0d-b9b8-bf12fdf4495e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$75$ feet per minute" :db/id #edb/ref 17592186267770}] :answer-field/correct {:answer/id #uuid "8f5968e7-47fd-59f2-84a5-9faaa2be9ff9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$150.5$ feet per minute" :db/id #edb/ref 17592186267423} :answer-field/id #uuid "ed694b78-5bc8-5345-8197-6311533e4009" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186268820}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "9150e0d7-03db-545b-ba25-add48de4f78e" :question/math-academy-id "q-134172" :question/problem "An elevator covers $602$ feet in $4$ minutes, moving at a constant rate. What is the speed of the elevator?" :question/worked-solution "Speed is a special unit rate applied to moving objects. It is defined as *the distance traveled per unit of time*:\n\n$$\n\\text{speed}=\\frac{\\text{distance}}{\\text{time}}\n$$\n\nTo find the speed in feet per minute, we divide the number of feet, $602,$ by the number of minutes, $4.$ This gives,\n\n$$\n\\begin{aligned}\\frac{602}{4} & =\\frac{602÷2}{4÷2} \\\\  & =\\frac{301}{2} \\\\  & =301÷2 \\\\  & =150.5.\\end{aligned}\n$$\n\nTherefore, the speed of the elevator is $150.5$ feet per minute."}] [{:db/id #edb/ref 17592186268990 :knowledge-point/_questions [{:db/id #edb/ref 17592186176032 :knowledge-point/id #uuid "6570253a-b05a-5721-9108-5fddab2b5388" :knowledge-point/title "Calculating Time Given Distance and Speed"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3cab5046-233a-5880-a03b-503b0856d91c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$6.5$ minutes" :db/id #edb/ref 17592186266680} {:answer/id #uuid "e325a324-10a4-5f82-b231-fa3bd706ffd1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$7.5$ minutes" :db/id #edb/ref 17592186268151} {:answer/id #uuid "e83770ff-718f-52f9-990d-ade35dfa8b0f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$6$ minutes" :db/id #edb/ref 17592186268205} {:answer/id #uuid "e91f6d7c-f724-5d0a-abea-83d4d6399631" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$5$ minutes" :db/id #edb/ref 17592186268215} {:answer/id #uuid "ef6e5bd5-073f-5a36-96f8-f3263a6b14de" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$7$ minutes" :db/id #edb/ref 17592186268273}] :answer-field/correct {:answer/id #uuid "e83770ff-718f-52f9-990d-ade35dfa8b0f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$6$ minutes" :db/id #edb/ref 17592186268205} :answer-field/id #uuid "51bb6fb1-a3cf-54cb-9a80-1e8569ed6784" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186268553}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "27bf74aa-5d79-5da2-ae74-80f3b8309260" :question/math-academy-id "q-134220" :question/problem "A jet ski traveled $3\\,960$ meters at a constant speed of $660$ meters per minute. For how long was the jet ski in motion?" :question/worked-solution "The speed is $660$ meters per minute. To find the time it took the jet ski to cover $3\\,960$ meters, we divide the distance by $660.$ This gives\n\n$$\n\\begin{aligned}\\text{time} & =\\frac{\\text{distance}}{\\text{speed}} \\\\  & =\\frac{3\\,960}{660} \\\\  & =\\frac{3\\,960÷60}{660÷60} \\\\  & =\\frac{66}{11} \\\\  & =66÷11 \\\\  & =6.\\end{aligned}\n$$\n\nTherefore, the jet ski was in motion for $6$ minutes."}] [{:db/id #edb/ref 17592186268991 :knowledge-point/_questions [{:db/id #edb/ref 17592186175937 :knowledge-point/id #uuid "cee807c1-dd86-5b0e-a595-5c5754c47e4c" :knowledge-point/title "Computing Covariance in Context"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0f92a789-d109-50a4-95bb-321fbf167553" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186266275} {:answer/id #uuid "3a4fc0c3-7987-5650-a6c4-15357f0a2e40" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186266658} {:answer/id #uuid "81b8fc0f-c491-5c9d-b014-a4dd49ed0618" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186267287} {:answer/id #uuid "8feb198f-42a2-5fd7-a65e-3cb6ba4e1c4b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3.5" :db/id #edb/ref 17592186267425} {:answer/id #uuid "9f77bdcd-8fd8-5c39-a664-6aabddb6169f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2.5" :db/id #edb/ref 17592186267585}] :answer-field/correct {:answer/id #uuid "0f92a789-d109-50a4-95bb-321fbf167553" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186266275} :answer-field/id #uuid "0a27bb6c-7a78-5c39-ae3a-526cec46f622" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186268424}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "fd4f8095-844e-57fc-88d9-718d41a408a6" :question/math-academy-id "q-134221" :question/problem "| **Age, in years ($x$)** | $7$ | $9$ | $11$ | $13$ |\n| --- | --- | --- | --- | --- |\n| **Shoe Size (USA) ($y$)** | $7$ | $8$ | $9$ | $8$ |\n\nMr. Damon recorded the age and shoe size of four tennis players at his academy. The table above shows the information he collected. Compute the covariance of the data sets given that the means are $\\overset{―}{x}=10$ and $\\overset{―}{y}=8.$" :question/worked-solution "The (population) covariance of the data sets $x={{x}_{1},{x}_{2},…,{x}_{n}}$ and $y={{y}_{1},{y}_{2},…,{y}_{n}}$ is given by \n\n$$\n\\text{Cov}(x,y)=\\frac{1}{n}{\\sum }_{i=1}^{n}({x}_{i}-\\overset{―}{x})({y}_{i}-\\overset{―}{y}),\n$$\n\nwhere $\\overset{―}{x}=\\frac{1}{n}{\\sum }_{i=1}^{n}{x}_{i}$ and $\\overset{―}{y}=\\frac{1}{n}{\\sum }_{i=1}^{n}{y}_{i}$ are the means of the data sets.\n\nTherefore, the covariance of our data sets is\n\n$$\n\\begin{aligned}\\text{Cov}(x,y) & =\\frac{1}{n}{\\sum }_{i=1}^{n}({x}_{i}-\\overset{―}{x})({y}_{i}-\\overset{―}{y}) \\\\  & =\\frac{1}{4}[(7-10)(7-8)+(9-10)(8-8)+(11-10)(9-8)+(13-10)(8-8)] \\\\  & =\\frac{1}{4}[(-3)(-1)+(-1)(0)+(1)(1)+(3)(0)] \\\\  & =\\frac{1}{4}[3+0+1+0] \\\\  & =\\frac{1}{4}\\cdot 4 \\\\  & =1.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186268994 :knowledge-point/_questions [{:db/id #edb/ref 17592186176032 :knowledge-point/id #uuid "6570253a-b05a-5721-9108-5fddab2b5388" :knowledge-point/title "Calculating Time Given Distance and Speed"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "02f258e3-8882-5aeb-8740-3e42cb6e7994" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$40$ seconds" :db/id #edb/ref 17592186266171} {:answer/id #uuid "5d95a249-fc05-50ac-9d04-c408a09025da" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$44$ seconds" :db/id #edb/ref 17592186266970} {:answer/id #uuid "60a9d8c4-203b-5e3f-8e27-11c1d3cd6d57" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$50$ seconds" :db/id #edb/ref 17592186266996} {:answer/id #uuid "640b8046-055f-5a66-8042-59ab2cf08bbd" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$52$ seconds" :db/id #edb/ref 17592186267026} {:answer/id #uuid "ab5026ed-6705-5518-8ad4-b09d2651f5d7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$38$ seconds" :db/id #edb/ref 17592186267691}] :answer-field/correct {:answer/id #uuid "5d95a249-fc05-50ac-9d04-c408a09025da" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$44$ seconds" :db/id #edb/ref 17592186266970} :answer-field/id #uuid "9d55d2b0-ddd8-553b-a7e3-cf16362be09c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186268682}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "92c13e99-67cb-5a62-9173-697230856fc4" :question/math-academy-id "q-134241" :question/problem "It takes $35$ seconds for a dolphin to swim $315$ meters at a constant pace. How long does it take for the dolphin to swim $396$ meters?" :question/worked-solution "Speed is a special unit rate applied to moving objects. It is defined as *the distance traveled per unit of time*:\n\n$$\n\\text{speed}=\\frac{\\text{distance}}{\\text{time}}\n$$\n\nTo find the speed, in meters per second, we divide the number of meters, which is $315,$ by the number of seconds, $35.$ This gives,\n\n$$\n\\begin{aligned}\\frac{315}{35} & =\\frac{315÷5}{35÷5} \\\\  & =\\frac{63}{7} \\\\  & =63÷7 \\\\  & =9.\\end{aligned}\n$$\n\nSo, the speed of the dolphin is $9$ meters per second. \n\nTo find the time it takes the dolphin to cover $396$ meters, we divide the distance by $9.$ This gives\n\n$$\n\\begin{aligned}\\text{time} & =\\frac{\\text{distance}}{\\text{speed}} \\\\  & =\\frac{396}{9} \\\\  & =396÷9 \\\\  & =44.\\end{aligned}\n$$\n\nTherefore, it takes the dolphin $44$ seconds to travel $396$ meters."}] [{:db/id #edb/ref 17592186268995 :knowledge-point/_questions [{:db/id #edb/ref 17592186176031 :knowledge-point/id #uuid "534de76f-d4bc-55b5-858e-2b594f63b7bc" :knowledge-point/title "Calculating Distance Given Speed and Time"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "40131a28-43ac-50cf-8d52-39f12b620ee7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$90$ centimeters" :db/id #edb/ref 17592186266722} {:answer/id #uuid "886f2ab6-77f8-5a47-b00c-148f635dc0f8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$81$ centimeters" :db/id #edb/ref 17592186267351} {:answer/id #uuid "a3488564-1ffd-543a-9e83-a3e4de6a4a55" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$72$ centimeters" :db/id #edb/ref 17592186267612} {:answer/id #uuid "a5f5d571-924e-5ad6-9047-abd7a0db08a4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$64$ centimeters" :db/id #edb/ref 17592186267647} {:answer/id #uuid "eeb2d178-478e-56b8-97e6-0ffe587c1d6b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$15$ centimeters" :db/id #edb/ref 17592186268268}] :answer-field/correct {:answer/id #uuid "886f2ab6-77f8-5a47-b00c-148f635dc0f8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$81$ centimeters" :db/id #edb/ref 17592186267351} :answer-field/id #uuid "6f1172ab-eeb3-5cad-a411-b983f6dd952a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186268610}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "12110187-5a54-55e6-a927-228b7377faf9" :question/math-academy-id "q-134243" :question/problem "It takes $30$ minutes for a slug to crawl $135$ centimeters when moving at a constant pace. Find the distance this slug covers in $18$ minutes." :question/worked-solution "Speed is a special unit rate applied to moving objects. It is defined as *the distance traveled per unit of time*:\n\n$$\n\\text{speed}=\\frac{\\text{distance}}{\\text{time}}\n$$\n\nTo find the speed in centimeters per minute, we divide the number of centimeters, $135,$ by the number of minutes, $30.$ This gives,\n\n$$\n\\begin{aligned}\\frac{135}{30} & =135÷30 \\\\  & =\\frac{135÷15}{30÷15} \\\\  & =\\frac{9}{2} \\\\  & =9÷2 \\\\  & =4.5.\\end{aligned}\n$$\n\nSo, the speed of the slug is $4.5$ centimeters per minute. \n\nTo find the distance covered in $18$ minutes, we multiply the speed by $18.$ This gives\n\n$$\n\\begin{aligned}\\text{distance} & =\\text{speed}\\times \\text{time} \\\\  & =4.5\\times 18 \\\\  & =81.\\end{aligned}\n$$\n\nTherefore, the slug covers $81$ centimeters in $18$ minutes."}] [{:db/id #edb/ref 17592186395748 :knowledge-point/_questions [{:db/id #edb/ref 17592186100988 :knowledge-point/id #uuid "8d783281-8364-5597-a804-a4ea0d76bec8" :knowledge-point/title "Finding an Entry of a Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c13c60e5-0749-5b32-b12e-a8ade2bfafa4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "No such entry" :db/id #edb/ref 17592186395750} {:answer/id #uuid "934f3147-a632-5a7a-90a4-6abb01c749b5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186395751} {:answer/id #uuid "75f10e54-f429-5034-a07c-5f3a477a96f5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186395752} {:answer/id #uuid "fc409e78-b2db-5c05-a2e5-b9108d710f88" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186395753} {:answer/id #uuid "42e84e66-ce19-5239-8a81-e70ab0d7a064" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186395754}] :answer-field/correct {:answer/id #uuid "42e84e66-ce19-5239-8a81-e70ab0d7a064" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186395754} :answer-field/id #uuid "009a80b9-eba7-5f26-9519-cf720d746fee" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186395749}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "d09f8217-b119-5565-bb4f-2ae4305acd87" :question/math-academy-id "q-13497" :question/problem "Find the entry ${c}_{24}$ of the matrix $C$, where \n\n$$\nC=[\\begin{aligned}0 & 1 & 2 & 4 \\\\ -1 & 2 & -3 & 5 \\\\ 2 & 1 & -3 & 4\\end{aligned}].\n$$" :question/worked-solution "The entry ${c}_{24}$ should lie at the intersection of the $2$nd row and $4$th column. Therefore, ${c}_{24}=5.$\n\n$$\nC