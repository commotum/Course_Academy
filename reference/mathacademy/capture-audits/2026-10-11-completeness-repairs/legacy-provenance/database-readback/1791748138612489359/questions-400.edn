ind the entry ${r}_{43}$ of the matrix $R$, where \n\n$$\nR=[\\begin{aligned}-5 & 2 & \\sqrt{3} & 4 \\\\ -3 & 0 & -4 & 5 \\\\ 5 & -2 & 8 & -1 \\\\ 0 & -1 & 1 & \\sqrt{2}\\end{aligned}].\n$$" :question/worked-solution "The entry ${r}_{43}$ lies at the intersection of the $4$th row and $3$rd column. Therefore, ${r}_{43}=1.$\n\n$$\nE=[\\begin{aligned}-5 & 2 & \\sqrt{3} & 4 \\\\ -3 & 0 & -4 & 5 \\\\ 5 & -2 & 8 & -1 \\\\ 0 & -1 & 1 & \\sqrt{2}\\end{aligned}]\n$$"}] [{:db/id #edb/ref 17592186400198 :knowledge-point/_questions [{:db/id #edb/ref 17592186100990 :knowledge-point/id #uuid "1cc70bda-40cf-5860-9a47-25f290c71041" :knowledge-point/title "Describing an Entry of a Matrix in Index Notation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "83bdeed3-df37-5030-9210-4fd26c862b5d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{y}_{31}" :db/id #edb/ref 17592186400200} {:answer/id #uuid "5071b299-4f24-5216-a03b-d3bb38f10c37" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{y}_{41}" :db/id #edb/ref 17592186400201} {:answer/id #uuid "6c05e69c-1e2c-58a5-8d1d-ec8b55b911ab" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{y}_{32}" :db/id #edb/ref 17592186400202} {:answer/id #uuid "7d163472-1ec4-5e60-97dc-1403c415123e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{y}_{42}" :db/id #edb/ref 17592186400203} {:answer/id #uuid "214dd131-7e3a-56a7-b7fd-be2f662d3fd3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{y}_{43}" :db/id #edb/ref 17592186400204}] :answer-field/correct {:answer/id #uuid "7d163472-1ec4-5e60-97dc-1403c415123e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{y}_{42}" :db/id #edb/ref 17592186400203} :answer-field/id #uuid "93e2aeb3-64f5-5d7d-b868-6bf0abe7eba8" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186400199}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "a14b13fa-47dd-5e1a-8086-20e6009f70ea" :question/math-academy-id "q-125611" :question/problem "Consider the highlighted entry of the matrix $Y$ given below. Describe it in terms of ${y}_{ij}.$\n\n$$\nY=[\\begin{aligned}2 & 1 \\\\ -4 & 5 \\\\ 0 & 0 \\\\ 1 & 7\\end{aligned}]\n$$" :question/worked-solution "The entry lies at the intersection of the $4$th row and $2$nd column. Hence, we have ${y}_{42}=7.$"}] [{:db/id #edb/ref 17592186387657 :knowledge-point/_questions [{:db/id #edb/ref 17592186059743 :knowledge-point/id #uuid "57187716-c00b-5428-a83a-18836d6b3d04" :knowledge-point/title "Finding the Transpose of a Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "37cadc71-d5de-59be-99af-f5b43457f009" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & \\sqrt{2} \\\\ -5 & 1\\end{aligned}]" :db/id #edb/ref 17592186387659} {:answer/id #uuid "51690e4f-138f-511d-a00d-dcfe4984ffad" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}-5 & 1 \\\\ 1 & \\sqrt{2}\\end{aligned}]" :db/id #edb/ref 17592186387660} {:answer/id #uuid "071345c4-3644-597d-98c0-a2d90d50ae2d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}-\\sqrt{2} & -1 \\\\ -1 & -5\\end{aligned}]" :db/id #edb/ref 17592186387661} {:answer/id #uuid "399353f4-6787-5eda-b67b-e4847c52f917" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "Undefined" :db/id #edb/ref 17592186387662} {:answer/id #uuid "72761529-11bc-5dcc-b8b3-4e7df0b63798" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}\\sqrt{2} & 1 \\\\ 1 & -5\\end{alig