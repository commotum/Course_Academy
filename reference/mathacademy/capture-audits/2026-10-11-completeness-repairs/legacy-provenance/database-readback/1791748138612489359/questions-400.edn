0b079bef50f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}0 & 0 \\\\ 0 & 0\\end{aligned}]" :db/id #edb/ref 17592186388343} {:answer/id #uuid "f2609425-f61f-5689-a1b2-ad1766ba4f2d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}5 & 1 \\\\ 6 & 8\\end{aligned}]" :db/id #edb/ref 17592186388344} {:answer/id #uuid "065fbb44-49f9-5677-ae45-0db8eae4e9ff" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}5 & 7 \\\\ 7 & 5\\end{aligned}]" :db/id #edb/ref 17592186388345} {:answer/id #uuid "6d7d6d9c-e6a7-5790-92dd-e8b2bca71761" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}6 & 7 \\\\ 4 & 5\\end{aligned}]" :db/id #edb/ref 17592186388346} {:answer/id #uuid "b7fb0aa4-9a2d-5c94-a1be-3f68d1da0be1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}3 & 2 \\\\ 2 & 3\\end{aligned}]" :db/id #edb/ref 17592186388347}] :answer-field/correct {:answer/id #uuid "6d7d6d9c-e6a7-5790-92dd-e8b2bca71761" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}6 & 7 \\\\ 4 & 5\\end{aligned}]" :db/id #edb/ref 17592186388346} :answer-field/id #uuid "aefbe9b4-2591-5f99-bd99-dce5ef9f6719" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186388342}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "60ff0898-484c-5468-ab70-2a2b8951960b" :question/math-academy-id "q-13536" :question/problem "Find $(A+B)-C-(B-C)$, if\n\n$$\nA=[\\begin{aligned}6 & 7 \\\\ 4 & 5\\end{aligned}],\\,B=[\\begin{aligned}3 & 2 \\\\ 2 & 3\\end{aligned}],\\,C=[\\begin{aligned}5 & 1 \\\\ 6 & 8\\end{aligned}].\n$$" :question/worked-solution "First, we simplify the expression by distributing the subtraction over the matrices in the parentheses:\n\n$$\n\\begin{aligned}(A+B)-C-(B-C) & =A+B-C-B+C \\\\  & =A+\\cancel{B}-\\cancel{C}-\\cancel{B}+\\cancel{C} \\\\  & =A\\end{aligned}\n$$\n\nWe are left with a single matrix. So, the result is \n\n$$\n\\begin{aligned}A & =[\\begin{aligned}6 & 7 \\\\ 4 & 5\\end{aligned}]\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186388403 :knowledge-point/_questions [{:db/id #edb/ref 17592186100868 :knowledge-point/id #uuid "8451e22a-247e-51dd-8fb1-9ce9b212dc65" :knowledge-point/title "Multiplying a Matrix With Variable Entries by a Column Vector"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6dac886f-ec90-5d08-838c-5a59cf7394ee" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}-7b \\\\ -7c\\end{aligned}]" :db/id #edb/ref 17592186388405} {:answer/id #uuid "5a12801a-3fc5-59fe-a868-0dd7454f9d59" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}7c \\\\ 7c\\end{aligned}]" :db/id #edb/ref 17592186388406} {:answer/id #uuid "9c65430b-d3c0-5549-805e-9c2f4dc62591" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}7b \\\\ 7c\\end{aligned}]" :db/id #edb/ref 17592186388407} {:answer/id #uuid "2ca00378-b5c5-5906-96a7-630208843a2d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}7b \\\\ 7b\\end{aligned}]" :db/id #edb/ref 17592186388408} {:answer/id #uuid "b66bb36e-56a0-54a6-bcba-44591ba41152" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}7c \\\\ 7b\\end{aligned}]" :db/id #edb/ref 17592186388409}] :answer-field/correct {:answer/id #uuid "9c65430b-d3c0-5549-805e-9c2f4dc62591" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}7b \\\\ 7c\\end{aligned}]" :db/id #edb/ref 17592186388407} :answer-field/id #uuid "00031ac6-c3f2-5a96-85f9-1258053acaf3" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186388404}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "89271958-955e-55b3-a956-b8c8b5250728" :question/math-academy-id "q-13556" :question/problem "Find $By$  if \n$B=[\\begin{aligned}b & b \\\\ c & c\\end{aligned}]$\nand\n$y=[\\begin{aligned}3 \\\\ 4\\end{aligned}].$" :question/worked-solution "We multiply each row in the matrix by the column vector using the dot product: \n\n$$\n\\begin{aligned}By & =[\\begin{aligned}b & b \\\\ c & c\\end{aligned}][\\begin{aligned}3 \\\\ 4\\end{aligned}] \\\\  & =[\\begin{aligned}b\\cdot 3+b\\cdot 4 \\\\ c\\cdot 3+c\\cdot 4\\end{aligned}] \\\\  & =[\\begin{aligned}3b+4b \\\\ 3c+4c\\end{aligned}] \\\\  & =[\\begin{aligned}7b \\\\ 7c\\end{aligned}]\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186101136 :knowledge-point/_questions [{:db/id #edb/ref 17592186100866 :knowledge-point/id #uuid "ff414112-3be2-5b9c-9ded-5025ea05c2b4" :knowledge-point/title "Multiplying a 2x2 Matrix by a Column Vector"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "91719962-a9c9-5473-af93-ea01ef1b4602" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-4 \\\\ 4\\end{bmatrix}" :db/id #edb/ref 17592186098152} {:answer/id #uuid "efdc264d-beb8-5142-9bc0-cfe6ee14fd5d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}4 \\\\ 4\\end{bmatrix}" :db/id #edb/ref 17592186098153} {:answer/id #uuid "300c52bd-1c58-5163-a5c0-19ae05be86e3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}4 \\\\ -4\\end{bmatrix}" :db/id #edb/ref 17592186098154} {:answer/id #uuid "3a610c49-d9ef-5021-9d2e