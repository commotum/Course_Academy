id "ef949d1a-3425-5215-bdb0-047bedfe1e0b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186388417}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "c6f60840-c1ce-5025-8b9b-ed8f00fe0d5e" :question/math-academy-id "q-13564" :question/problem "Find $Ax$ if \n$A=[\\begin{aligned}-6 & 4 \\\\ 8 & -5\\end{aligned}]$\nand\n$x=[\\begin{aligned}2 \\\\ 4\\end{aligned}].$" :question/worked-solution "We multiply each row in the matrix by the column vector using the dot product. Multiplying the first row, we get\n\n$$\n\\begin{aligned}[\\begin{aligned}-6 & 4 \\\\ 8 & -5\\end{aligned}][\\begin{aligned}2 \\\\ 4\\end{aligned}] & =[\\begin{aligned}(-6)\\cdot 2+4\\cdot 4 \\\\ ∗\\end{aligned}]=[\\begin{aligned}4 \\\\ ∗\\end{aligned}].\\end{aligned}\n$$\n\nMultiplying the second row, we get\n\n$$\n\\begin{aligned}[\\begin{aligned}-6 & 4 \\\\ 8 & -5\\end{aligned}][\\begin{aligned}2 \\\\ 4\\end{aligned}] & =[\\begin{aligned}4 \\\\ 8\\cdot 2+(-5)\\cdot 4\\end{aligned}]=[\\begin{aligned}4 \\\\ -4\\end{aligned}].\\end{aligned}\n$$\n\nTherefore, \n$Ax=[\\begin{aligned}4 \\\\ -4\\end{aligned}].$"}] [{:db/id #edb/ref 17592186269091 :knowledge-point/_questions [{:db/id #edb/ref 17592186184325 :knowledge-point/id #uuid "9f3ba60a-8c09-563f-ae02-8183bb55e359" :knowledge-point/title "Expanding a Binomial With Negative Coefficients"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0806406c-4a21-56ec-9a7b-330100d5f875" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1-\\frac{14k}{3}+\\frac{29{k}^{2}}{3}+⋯" :db/id #edb/ref 17592186266215} {:answer/id #uuid "2dcae794-1e06-5fd9-8d66-06082a38384f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1-\\frac{14k}{3}+9{k}^{2}+⋯" :db/id #edb/ref 17592186266549} {:answer/id #uuid "8e55eb77-3bf2-5874-b05d-8ab2dc5703ad" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1-\\frac{14k}{3}+30{k}^{2}+⋯" :db/id #edb/ref 17592186267411} {:answer/id #uuid "9b259559-d03d-524f-8b06-c704737b069c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1-\\frac{14k}{3}+\\frac{28{k}^{2}}{3}+⋯" :db/id #edb/ref 17592186267544} {:answer/id #uuid "c2546cf8-923a-5e94-8518-b15ebe81c057" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1-\\frac{14k}{3}+\\frac{25{k}^{2}}{3}+⋯" :db/id #edb/ref 17592186267876}] :answer-field/correct {:answer/id #uuid "9b259559-d03d-524f-8b06-c704737b069c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1-\\frac{14k}{3}+\\frac{28{k}^{2}}{3}+⋯" :db/id #edb/ref 17592186267544} :answer-field/id #uuid "9a9e356d-28ac-5e01-9dcb-b6af995d2e23" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186268679}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "1e2921e3-3663-532f-adb3-94884fb8e499" :question/math-academy-id "q-135995" :question/problem "${(1-\\frac{2k}{3})}^{7}=$" :question/worked-solution "The first three terms of the binomial expansion for $(1+x)^{n}$ are given by\n\n$$\n{(1+x)}^{n}=1+nx+\\frac{n(n-1)}{2!}{x}^{2}+⋯.\n$$\n\nBy substituting $x=-\\frac{2k}{3}$ and $n=7$ into the above formula, we obtain\n\n$$\n\\begin{aligned}{(1-\\frac{2k}{3})}^{7} & =1+7\\cdot (-\\frac{2k}{3})+\\frac{7(7-1)}{2!}\\cdot {(-\\frac{2k}{3})}^{2}+⋯ \\\\  & =1-\\frac{14k}{3}+\\frac{7\\cdot 6}{2}\\cdot \\frac{4{k}^{2}}{9}+⋯ \\\\  & =1-\\frac{14k}{3}+21\\cdot \\frac{4{k}^{2}}{9}+⋯ \\\\  & =1-\\frac{14k}{3}+\\frac{28{k}^{2}}{3}+⋯.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186269094 :knowledge-point/_questions [{:db/id #edb/ref 17592186100891 :knowledge-point/id #uuid "fd3b5e36-46db-5d34-92e2-eefb7e0e95c8" :knowledge-point/title "Finding the First Few Terms of a Binomial Expansion"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "85685afe-fb39-55da-b177-70712435f681" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "81+108x+54{x}^{2}+⋯" :db/id #edb/ref 17592186267320} {:answer/id #uuid "8bd67713-aa7c-5aa1-9560-21f69317d1f5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "27+108x+54{x}^{2}+⋯" :db/id #edb/ref 17592186267397} {:answer/id #uuid "c0658cf8-fae6-5960-bc9b-561c5ac765bd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "81+27x+9{x}^{2}+⋯" :db/id #edb/ref 17592186267865} {:answer/id #uuid "f09f36b2-37bc-5feb-b758-a54412e15ed1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "81+27x+54{x}^{2}+⋯" :db/id #edb/ref 17592186268283} {:answer/id #uuid "fbd8910a-e2b8-5637-8c7c-0e8b1d61bfcd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "81+108x+9{x}^{2}+⋯" :db/id #edb/ref 17592186268370}] :answer-field/correct {:answer/id #uuid "85685afe-fb39-55da-b177-70712435f681" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "81+108x+54{x}^{2}+⋯" :db/id #edb/ref 17592186267320} :answer-field/id #uuid "ee659c3f-f706-53fd-95d3-de18d2403960" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186268823}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "7cf853ca-6a16-5936-9604-4bf59d63715b" :question/math-academy-id "q-136002" :question/problem "$(3+x)^{4}=$" :question/worked-solution "The binomial theorem states that for any positive integer $n,$ we have\n\n \n\n$$\n(a+b)^{n}=(\\frac{n}{0}){a}^{n}{b}^{0}+(\\frac{n}{1}){a}^{n-1}{b}^{1}+(\\frac{n}{2}){a}^{n-2}{b}^{2}+⋯+(\\frac{n}{n}){a}^{0}{b}^{n}.\n$$\n\nIn the case of $(3+x)^{4},$ we have  $a=3,$ $b=x,$ $n=4.$ \n\nTherefore, the first three terms of $(3+x)^{4}$ are as follows:\n\n$$\n\\begin{aligned}{(3+x)}^{4} & =(\\frac{4}{0}){(3)}^{4}{(x)}^{0}+(\\frac{4}{1}){(3)}^{4-1}{(x)}^{1}+(\\frac{4}{2}){(3)}^{4-2}{(x)}^{2}+⋯ \\\\  & =1{(3)}^{4}+4{(3)}^{3}{(x)}^{1}+6{(3)}^{2}{(x)}^{2}+⋯ \\\\  & =81+108x+54{x}^{2}+⋯.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186269098 :knowledge-point/_questions [{:db/id #edb/ref 17592186100954 :knowledge-point/id #uuid "29896622-4bcb-5ad2-91d0-47c5911a619e" :knowledge-point/title "Finding the First Few Terms of an Expansion With Negative Coefficients"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "92de9a4d-adde-5d21-9a44-c4fe7eae58e0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "16{x}^{5}+80{x}^{4}y+80{x}^{3}{y}^{2}+⋯" :db/id #edb/ref 17592186267456} {:answer/id #uuid "93132ebd-dc50-541e-8f68-35c204bb7b00" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "32{x}^{5}-16{x}^{4}y-8{x}^{3}{y}^{2}+⋯" :db/id #edb/ref 17592186267459} {:answer/id #uuid "a4d1deaf-c76c-50f6-8fd5-3bd05a380230" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "32{x}^{5}-80{x}^{4}y+80{x}^{3}{y}^{2}+⋯" :db/id #edb/ref 17592186267630} {:answer/id #uuid "b9020fcd-56d4-5b84-92bd-7645344e3309" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "32{x}^{5}-16{x}^{4}y+80{x}^{3}{y}^{2}+⋯" :db/id #edb/ref 17592186267804} {:answer/id #uuid "d372e15b-09b2-5957-9a22-edcf439d053d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "32{x}^{5}-80{x}^{4}y+10{x}^{3}{y}^{2}+⋯" :db/id #edb/ref 17592186268031}] :answer-field/correct {:answer/id #uuid "a4d1deaf-c76c-50f6-8fd5-3bd05a380230" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "32{x}^{5}-80{x}^{4}y+80{x}^{3}{y}^{2}+⋯" :db/id #edb/ref 17592186267630} :answer-field/id #uuid "f5c4ce6d-6e8f-50f5-a6b2-8730784d8e35" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186268838}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "b1f57d7b-a958-55ab-a552-4e907ee5b53e" :question/math-academy-id "q-136012" :question/problem "${(2x-y)}^{5}=$" :question/worked-solution "The binomial theorem states that for any positive integer $n,$ we have\n\n \n\n$$\n(a+b)^{n}=(\\frac{n}{0}){a}^{n}{b}^{0}+(\\frac{n}{1}){a}^{n-1}{b}^{1}+(\\frac{n}{2}){a}^{n-2}{b}^{2}+⋯+(\\frac{n}{n}){a}^{0}{b}^{n}.\n$$\n\nIn the case of ${(2x-y)}^{5},$ we have  $a=2x,$ $b=-y,$ $n=5.$ \n\nTherefore, the first three terms of ${(2x-y)}^{5}$ are as follows:\n\n$$\n\\begin{aligned}(2x-y)^{5} & =(\\frac{5}{0})(2x)^{5}(-y)^{0}+(\\frac{5}{1})(2x)^{5-1}(-y)^{1}+(\\frac{5}{2})(2x)^{5-2}(-y)^{2}+⋯ \\\\  & =1(2x)^{5}+5(2x)^{4}(-y)+10(2x)^{3}(-y)^{2}+⋯ \\\\  & =32{x}^{5}-80{x}^{4}y+80{x}^{3}{y}^{2}+⋯.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186269099 :knowledge-point/_questions [{:db/id #edb/ref 17592186184326 :knowledge-point/id #uuid "df318a39-103a-53a6-99f8-2ccf3601f3ca" :knowledge-point/title "Calculating a Coefficient of a Binomial Expansion"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "27242a80-102a-54fb-b4e8-9dd4359d2ba3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{91}{2}" :db/id #edb/ref 17592186266493} {:answer/id #uuid "6fbd0a72-843f-5ddf-a0b1-d6148f79222a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{91}{4}" :db/id #edb/ref 17592186267126} {:answer/id #uuid "88b53cc5-3255-567c-bee9-658e8260d0e1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{91}{4}" :db/id #edb/ref 17592186267360} {:answer/id #uuid "97e05e7f-f7f7-591a-a987-e5c3463b5aa5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "7" :db/id #edb/ref 17592186267505} {:answer/id #uuid "fc3cbbff-aef8-5241-a45b-50106f1c074f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{91}{2}" :db/id #edb/ref 17592186268371}] :answer-field/correct {:answer/id #uuid "fc3cbbff-aef8-5241-a45b-50106f1c074f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{91}{2}" :db/id #edb/ref 17592186268371} :answer-field/id #uuid "ca8e6803-5f87-59fb-82a5-58502f9d93e5" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186268770}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "dd5426c2-f89c-51fb-b15d-1c1556603be5" :question/math-academy-id "q-136014" :question/problem "The coefficient of ${a}^{3}$ in the expansion of ${(1-\\frac{a}{2})}^{14}$ is" :question/worked-solution "The binomial expansion for $(1+x)^{n}$ is given by\n\n$$\n(1+x)^{n}=1+nx+\\frac{n(n-1)}{2!}{x}^{2}+⋯.\n$$\n\nIn particular, the ${x}^{3}$ term is given by\n\n$$\n\\frac{n(n-1)(n-2)}{3!}{x}^{3}.\n$$\n\nReplacing $x$ with $-\\frac{a}{2}$ and $n$ with $14$ in the above expression, we get\n\n$$\n\\begin{aligned}\\frac{14(14-1)(14-2)}{3!}\\cdot {(-\\frac{a}{2})}^{3} & =\\frac{14\\cdot 13\\cdot 12}{6}\\cdot (-\\frac{1}{{2}^{3}})\\cdot {a}^{3} \\\\  & =364\\cdot (-\\frac{1}{8}){a}^{3} \\\\  & =-\\frac{91}{2}{a}^{3}.\\end{aligned}\n$$\n\nTherefore, the coefficient of ${a}^{3}$ is $-\\frac{91}{2}.$"}] [{:db/id #edb/ref 17592186269100 :knowledge-point/_questions [{:db/id #edb/ref 17592186100954 :knowledge-point/id #uuid "29896622-4bcb-5ad2-91d0-47c5911a619e" :knowledge-point/title "Finding the First Few Terms of an Expansion With Negative Coefficients"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0a64923f-e9ca-5125-ac6a-140a5b5076d7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{x}^{8}-8{x}^{7}y+28{x}^{6}{y}^{2}+⋯" :db/id #edb/ref 17592186266237} {:answer/id #uuid "302e6a79-c731-5c9b-9923-3a042c55b509" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{x}^{8}-7{x}^{7}y+28{x}^{6}{y}^{2}+⋯" :db/id #edb/ref 17592186266568} {:answer/id #uuid "51dda2cc-97ce-59b3-a5e5-77a0f7d25aed" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{x}^{8}-8{x}^{7}y+14{x}^{6}{y}^{2}+⋯" :db/id #edb/ref 17592186266876} {:answer/id #uuid "aaa5d87f-dec7-5bbc-94cc-0e64238040dd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{x}^{8}-8{x}^{7}y-14{x}^{6}{y}^{2}+⋯" :db/id #edb/ref 17592186267688} {:answer/id #uuid "ecbf3c63-3c89-50eb-807f-78f0383905c6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{x}^{8}+8{x}^{7}y+28{x}^{6}{y}^{2}+⋯" :db/id #edb/ref 17592186268248}] :answer-field/correct {:answer/id #uuid "0a64923f-e9ca-5125-ac6a-140a5b5076d7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{x}^{8}-8{x}^{7}y+28{x}^{6}{y}^{2}+⋯" :db/id #edb/ref 17592186266237} :answer-field/id #uuid "56428909-ad51-5b91-8c44-a2c7c5603c1e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186268562}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "4bfb4f9e-e9db-5bd6-a1f7-0c71987ddffc" :question/math-academy-id "q-136015" :question/problem "${(x-y)}^{8}=$" :question/worked-solution "The binomial theorem states that for any positive integer $n,$ we have\n\n \n\n$$\n(a+b)^{n}=(\\frac{n}{0}){a}^{n}{b}^{0}+(\\frac{n}{1}){a}^{n-1}{b}^{1}+(\\frac{n}{2}){a}^{n-2}{b}^{2}+⋯+(\\frac{n}{n}){a}^{0}{b}^{n}.\n$$\n\nIn the case of ${(x-y)}^{8},$ we have  $a=x,$ $b=-y,$ $n=8.$ \n\nTherefore, the first three terms of ${(x-y)}^{8}$ are as follows:\n\n$$\n\\begin{aligned}{(x-y)}^{8} & =(\\frac{8}{0}){(x)}^{8}{(-y)}^{0}+(\\frac{8}{1}){(x)}^{8-1}{(-y)}^{1}+(\\frac{8}{2}){(x)}^{8-2}{(-y)}^{2}+⋯ \\\\  & =1{(x)}^{8}+8{(x)}^{7}{(-y)}^{1}+28{(x)}^{6}{(-y)}^{2}+⋯ \\\\  & ={x}^{8}-8{x}^{7}y+28{x}^{6}{y}^{2}+⋯.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186269103 :knowledge-point/_questions [{:db/id #edb/ref 17592186083306 :knowledge-point/id #uuid "a75b47ec-8d5a-545e-b915-daca92320322" :knowledge-point/title "Identifying Non-Roots of a Polynomial Using the Rational Roots Theorem"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1482f361-3b1e-543f-870b-a26dcf92d2ca" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186266319} {:answer/id #uuid "2870d2f6-a4e4-5d62-a218-0e3e5a8a8827" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186266504} {:answer/id #uuid "447ea00c-4d69-5351-8ae6-7fb524a5e59a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "10" :db/id #edb/ref 17592186266757} {:answer/id #uuid "ab240971-126a-51ed-95e8-caf2152e97e6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{3}" :db/id #edb/ref 17592186267690} {:answer/id #uuid "fda09780-5082-5dc7-9e43-74a04e529440" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186268378}] :answer-field/correct {:answer/id #uuid "fda09780-5082-5dc7-9e43-74a04e529440" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186268378} :answer-field/id #uuid "466acc84-20e7-58f4-bf70-73eea0fa85ba" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186268526}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "54404730-020a-547b-8cd2-8751476ed4d0" :question/math-academy-id "q-13613" :question/problem "According to the rational roots theorem, which of the following **cannot** be a root of the polynomial $f(x)=3{x}^{3}+10{x}^{2}-23x+10?$" :question/worked-solution "Given a polynomial with integer coefficients, the rational roots theorem states that any rational roots of the polynomial must take the form\n\n$$\n\\pm \\frac{\\text{factor of the constant term}}{\\text{factor of the leading coefficient}}.\n$$\n\nFor the given polynomial $f(x),$ the constant term is $10$ and the leading coefficient is $3.$ So, any rational roots of $f(x)$ must take the form\n\n$$\n\\pm \\frac{\\text{factor of }10}{\\text{factor of }3}.\n$$\n\nOf the given answer choices, only $3$ does not take the above form. The value $3$ can be interpreted as a fraction $\\frac{3}{1},$ and the numerator $(3)$ is not a factor of $10.$"}] [{:db/id #edb/ref 17592186129479 :knowledge-point/_questions [{:db/id #edb/ref 17592186129250 :knowledge-point/id #uuid "c5146ef7-bd48-5d0d-903d-882d739b92c7" :knowledge-point/title "Calculating the Acceleration of a Particle"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3d7f5d51-7683-5a82-9525-98eb244d2f83" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4i\\,{\\text{m/s}}^{2}" :db/id #edb/ref 17592186266689} {:answer/id #uuid "587535b4-bbbc-5fbf-8d54-9f57ff050e73" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(2i+4j)\\,{\\text{m/s}}^{2}" :db/id #edb/ref 17592186266933} {:answer/id #uuid "7eee6282-f69e-54c9-9891-a06d8430264f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(i+2j)\\,{\\text{m/s}}^{2}" :db/id #edb/ref 17592186267262} {:answer/id #uuid "85ff45d3-1ddf-5689-a028-b082d923294e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0\\,{\\text{m/s}}^{2}" :db/id #edb/ref 17592186267326} {:answer/id #uuid "d3d12796-1206-5263-a7e3-9ae46a92f8ad" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(i-2j)\\,{\\text{m/s}}^{2}" :db/id #edb/ref 17592186268032}] :answer-field/correct {:answer/id #uuid "7eee6282-f69e-54c9-9891-a06d8430264f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(i+2j)\\,{\\text{m/s}}^{2}" :db/id #edb/ref 17592186267262} :answer-field/id #uuid "70e965d0-274c-50d0-a3ff-930639d3fa69" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186268615}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "1d30498e-757c-511b-b142-9c3f837aad12" :question/math-academy-id "q-136289" :question/problem "A particle moves with constant acceleration. When $t=0\\,\\text{s},$ the velocity of the particle is $(-2i-8j)\\,\\text{m/s},$ and when $t=4\\,\\text{s},$ the velocity of the particle is $2i\\,\\text{m/s}.$ Calculate the acceleration of the particle." :question/worked-solution "Recall that when a particle moves with constant acceleration, the velocity vector at time $t$ can be found using\n\n$$\nv=u+at,\n$$\n\nwhere $u$ is the initial velocity, and $a$ is the acceleration of the particle.\n\nSubstituting \n\n$$\nu=-2i-8j,\\,v=2i,\\,t=4,\n$$\n\ninto the equation above, we can solve for $a,$ as follows:\n\n$$\n\\begin{aligned}v & =u+at \\\\ 2i & =(-2i-8j)+a(4) \\\\ 4i+8j & =4a \\\\ a & =\\frac{1}{4}(4i+8j) \\\\  & =(i+2j)\\,{\\text{m/s}}^{2}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186129481 :knowledge-point/_questions [{:db/id #edb/ref 17592186129252 :knowledge-point/id #uuid "93d45138-b681-55c0-8910-1400bdf717c5" :knowledge-point/title "Finding the Time when a Particle Reaches a Particular Velocity"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d039f4a6-471f-5a6d-8c7b-7b6f20da9885" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "t = 1s" :db/id #edb/ref 17592186126387} {:answer/id #uuid "d6fbc6ac-7bd1-59a8-ba1b-7358d4ca8319" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "No solution" :db/id #edb/ref 17592186126388} {:answer/id #uuid "ed75ad4e-24ff-5a53-9276-d9d4a0a10469" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "t = 3s" :db/id #edb/ref 17592186126389} {:answer/id #uuid "408ad7c7-e164-5b6a-884f-a6633e2eeb97" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "t = 2s" :db/id #edb/ref 17592186126390} {:answer/id #uuid "6cfe880c-c6a0-563e-aa89-65dcabd2f744" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "t = 6s" :db/id #edb/ref 17592186126391}] :answer-field/id #uuid "95824ee1-eaa5-5a70-8ab3-8de0d1f815bf" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186126386} {:answer-field/choices [{:answer/id #uuid "71811c86-dfc1-5f5a-a4b3-51b613597427" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "t=3\\,\\text{s}" :db/id #edb/ref 17592186400738} {:answer/id #uuid "14045dd5-56a2-56b3-8a1b-32ff353cc995" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "t=1\\,\\text{s}" :db/id #edb/ref 17592186400739} {:answer/id #uuid "9dfea80d-d958-5442-ae1c-80f233864941" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "No solution" :db/id #edb/ref 17592186400740} {:answer/id #uuid "61d086d5-f1b1-5ae6-a501-43af3ee40f2b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "t=6\\,\\text{s}" :db/id #edb/ref 17592186400741} {:answer/id #uuid "30c355e9-d6a5-5ca6-8952-9e4063f7db10" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "t=2\\,\\text{s}" :db/id #edb/ref 17592186400742}] :answer-field/correct {:answer/id #uuid "71811c86-dfc1-5f5a-a4b3-51b613597427" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "t=3\\,\\text{s}" :db/id #edb/ref 17592186400738} :answer-field/id #uuid "2bdb9de5-d1fb-5bbe-8ab8-96d3464f5245" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186400737}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "7c82e497-5ec7-5624-8331-c5c43f9eb1a8" :question/math-academy-id "q-136291" :question/problem "A particle moves with a constant acceleration of $(3i+2j)\\,{\\text{m/s}}^{2}.$ The velocity of the particle is $(-7i-6j)\\,\\text{m/s}$ when $t=0\\,\\text{s}.$ Find the time when the velocity of the particle equals $2i\\,\\text{m/s}.$" :question/worked-solution "Recall that when a particle moves with constant acceleration, the velocity vector at time $t$ can be found using\n\n$$\nv=u+at,\n$$\n\nwhere $u$ is the initial velocity, and $a$ is the acceleration of the particle.\n\nSubstituting \n\n$$\na=3i+2j,\\,u=-7i-6j,\\,v=2i\n$$\n\ninto the equation above, we can solve for $t,$ as follows:\n\n$$\n\\begin{aligned}v & =u+at \\\\ 2i & =(-7i-6j)+(3i+2j)t \\\\ 9i+6j & =(3i+2j)t \\\\ 9i+6j & =3ti+2tj\\end{aligned}\n$$\n\nEquating the $i$ and $j$ components in the last equation, we obtain\n\n$$\n{\\begin{aligned}9=3t \\\\ 6=2t\\end{aligned}\\,⟹\\,t=3\\,\\text{s}.\n$$"}] [{:db/id #edb/ref 17592186398396 :knowledge-point/_questions [{:db/id #edb/ref 17592186129249 :knowledge-point/id #uuid "0118bf72-c730-59f1-b722-85ed779f96c7" :knowledge-point/title "Calculating the Speed of a Particle Given Its Velocity"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d1defb76-8459-59c2-b2f3-882cb40db2b2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4.73\\,\\text{m/s}" :db/id #edb/ref 17592186398398} {:answer/id #uuid "7a65e5ff-4a0a-57d3-b7ca-a7d4f13983ee" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4.65\\,\\text{m/s}" :db/id #edb/ref 17592186398399} {:answer/id #uuid "b99284b1-cb82-5a09-9287-93038bc13098" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6.31\\,\\text{m/s}" :db/id #edb/ref 17592186398400} {:answer/id #uuid "8d65d6c2-39d1-54ee-8ec9-fbbb46896c9b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5.39\\,\\text{m/s}" :db/id #edb/ref 17592186398401} {:answer/id #uuid "881312cb-f0f1-5c91-a009-dd847f6069d3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5.67\\,\\text{m/s}" :db/id #edb/ref 17592186398402}] :answer-field/correct {:answer/id #uuid "8d65d6c2-39d1-54ee-8ec9-fbbb46896c9b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5.39\\,\\text{m/s}" :db/id #edb/ref 17592186398401} :answer-field/id #uuid "3da23e5a-3f1a-58d5-8634-9889dc453786" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186398397}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "9d9adc28-1eef-586b-9169-6940ecdacba5" :question/math-academy-id "q-136311" :question/problem "A particle moves with a constant velocity of $u=(2i-5j)\\,\\text{m/s}.$ Find the speed of the particle, rounding your answer to two decimal places." :question/worked-solution "The speed of a particle equals the magnitude of its velocity.\n\nTherefore, the speed of the particle is\n\n$$\n\\begin{aligned}|u| & =|2i-5j| \\\\  & =\\sqrt{{2}^{2}+(-5)^{2}} \\\\  & =\\sqrt{4+25} \\\\  & =\\sqrt{29} \\\\  & ≈5.39\\,\\text{m/s}\\end{aligned}\n$$\n\nrounded to two decimal places."}] [{:db/id #edb/ref 17592186398403 :knowledge-point/_questions [{:db/id #edb/ref 17592186129249 :knowledge-point/id #uuid "0118bf72-c730-59f1-b722-85ed779f96c7" :knowledge-point/title "Calculating the Speed of a Particle Given Its Velocity"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1e2cbc40-aff5-51fc-94bf-9cdd5efe425d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2.24\\,\\text{km/h}" :db/id #edb/ref 17592186398405} {:answer/id #uuid "5b06ec27-4c21-5388-b505-c3433887b18b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3.87\\,\\text{km/h}" :db/id #edb/ref 17592186398406} {:answer/id #uuid "a6786566-636d-5a9e-99c4-6379cbca69d5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3.18\\,\\text{km/h}" :db/id #edb/ref 17592186398407} {:answer/id #uuid "9a080ec3-eeda-503e-b3b6-a01029c4818a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4.68\\,\\text{km/h}" :db/id #edb/ref 17592186398408} {:answer/id #uuid "d90f3ba8-6541-5bde-87ef-cde3025c3006" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4.12\\,\\text{km/h}" :db/id #edb/ref 17592186398409}] :answer-field/correct {:answer/id #uuid "d90f3ba8-6541-5bde-87ef-cde3025c3006" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4.12\\,\\text{km/h}" :db/id #edb/ref 17592186398409} :answer-field/id #uuid "7bfbd15d-6ca5-5972-85ed-d1d5920988e9" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186398404}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "ede10ea1-892c-5590-9caf-f40ffde6984b" :question/math-academy-id "q-136312" :question/problem "A particle moves with a constant velocity of $u=(i+4j)\\,\\text{km/h}.$ Find the speed of the particle, rounding your answer to two decimal places." :question/worked-solution "The speed of a particle equals the magnitude of its velocity.\n\nTherefore, the speed of the particle is\n\n$$\n\\begin{aligned}|u| & =|i+4j| \\\\  & =\\sqrt{{1}^{2}+{4}^{2}} \\\\  & =\\sqrt{1+16} \\\\  & =\\sqrt{17} \\\\  & ≈4.12\\,\\text{km/h}\\end{aligned}\n$$\n\nrounded to two decimal places."}] [{:db/id #edb/ref 17592186388444 :knowledge-point/_questions [{:db/id #edb/ref 17592186129251 :knowledge-point/id #uuid "7439a96f-07b1-5673-a103-af2c63c25d18" :knowledge-point/title "Calculating the Final Velocity of a Particle"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2b37ee1f-dc1b-5f76-a557-bc8f46566879" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(11i+10j)\\,\\text{km/h}" :db/id #edb/ref 17592186388446} {:answer/id #uuid "044eade9-f6a1-5126-80a9-a709b87c30c5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-6i+24j)\\,\\text{km/h}" :db/id #edb/ref 17592186388447} {:answer/id #uuid "263564a9-1fce-52d4-a819-63af9a57766d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(13i+10j)\\,\\text{km/h}" :db/id #edb/ref 17592186388448} {:answer/id #uuid "973e2d24-b37b-5c7e-b887-ee5e71bb10a5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(i+5j)\\,\\text{km/h}" :db/id #edb/ref 17592186388449} {:answer/id #uuid "3dac51de-8735-51e0-84c2-ae1fef014883" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(11i+6j)\\,\\text{km/h}" :db/id #edb/ref 17592186388450}] :answer-field/correct {:answer/id #uuid "2b37ee1f-dc1b-5f76-a557-bc8f46566879" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(11i+10j)\\,\\text{km/h}" :db/id #edb/ref 17592186388446} :answer-field/id #uuid "1437a6cb-f3bb-5357-a2e0-21c7c316e019" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186388445}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "475b8376-b64f-5b88-84dc-3087e08b2993" :question/math-academy-id "q-136341" :question/problem "The velocity of a particle is $(-i+4j)\\,\\text{km/h}$ when $t=0\\,\\text{h}.$ If the particle moves with a constant acceleration of $(2i+j)\\,{\\text{km/h}}^{2},$ find the velocity of the particle when $t=6\\,\\text{h}.$" :question/worked-solution "Recall that when a particle moves with constant acceleration, the velocity vector at time $t$ can be found using\n\n$$\nv=u+at,\n$$\n\nwhere $u$ is the initial velocity, and $a$ is the acceleration of the particle.\n\nHere, we have\n\n$$\nu=-i+4j,\\,a=2i+j.\n$$\n\nTherefore, after $t=6\\,\\text{h},$ the velocity of the particle will be\n\n$$\n\\begin{aligned}v & =u+at \\\\  & =(-i+4j)+(2i+j)(6) \\\\  & =(-i+4j)+(12i+6j) \\\\  & =(11i+10j)\\,\\text{km/h}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186396025 :knowledge-point/_questions [{:db/id #edb/ref 17592186100913 :knowledge-point/id #uuid "3d7d67c6-d54f-5ee1-af59-fd63d6687cfd" :knowledge-point/title "Multiplying a Column-Vector By a Row-Vector"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c534267d-c67a-576d-a7c7-8f05a39d217f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$$\n[\\begin{aligned}0 & 0 \\\\ -2 & -4 \\\\ -3 & -6\\end{aligned}]\n$$" :db/id #edb/ref 17592186396027} {:answer/id #uuid "17ab5397-bb38-59f6-9330-b062d867cf08" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$$\n[\\begin{aligned}1 & 2 \\\\ -2 & -4 \\\\ -3 & -6\\end{aligned}]\n$$" :db/id #edb/ref 17592186396028} {:answer/id #uuid "bbc3f4eb-2bd2-548e-adb8-c1548530611b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$$\n[\\begin{aligned}1 & 0 \\\\ -2 & -4 \\\\ -3 & -6\\end{aligned}]\n$$" :db/id #edb/ref 17592186396029} {:answer/id #uuid "cd31fdfe-ca0b-590b-9300-ed3e228812d5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "Undefined" :db/id #edb/ref 17592186396030} {:answer/id #uuid "abaf4c24-a433-5f0e-9fa5-6f62768c563e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$$\n[\\begin{aligned}0 & 0 \\\\ -2 & -4 \\\\ 3 & -6\\end{aligned}]\n$$" :db/id #edb/ref 17592186396031}] :answer-field/correct {:answer/id #uuid "c534267d-c67a-576d-a7c7-8f05a39d217f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$$\n[\\begin{aligned}0 & 0 \\\\ -2 & -4 \\\\ -3 & -6\\end{aligned}]\n$$" :db/id #edb/ref 17592186396027} :answer-field/id #uuid "cb12cf5d-8771-503b-99b4-cf0f73c56ea7" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186396026}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "0dc1caab-e8b2-5f4c-af54-cbacb852a075" :question/math-academy-id "q-13635" :question/problem "Find $AB$, if \n$A=[\\begin{aligned}0 \\\\ -2 \\\\ -3\\end{aligned}]$\nand \n$B=[\\begin{aligned}1 & 2\\end{aligned}].$" :question/worked-solution "Here, $A$ is $3\\times 1$ matrix and $B$ is a $1\\times 2$ matrix. \n\nThere is $1$ column in matrix $A$ and $1$ row in matrix $B$, so the product is well defined:\n\n$$\n{A}_{3\\times \\boxed{\\text{1}}}{\\cdot }_{✓}{B}_{\\boxed{\\text{1}}\\times 2}={AB}_{3\\times 2}\n$$\n\nComputing the product, we have:\n\n$$\n\\begin{aligned}AB & =[\\begin{aligned}0 \\\\ -2 \\\\ -3\\end{aligned}][\\begin{aligned}1 & 2\\end{aligned}] \\\\  & =[\\begin{aligned}0\\cdot 1 & 0\\cdot 2 \\\\ (-2)\\cdot 1 & (-2)\\cdot 2 \\\\ (-3)\\cdot 1 & (-3)\\cdot 2\\end{aligned}] \\\\  & =[\\begin{aligned}0 & 0 \\\\ -2 & -4 \\\\ -3 & -6\\end{aligned}]\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186176347 :knowledge-point/_questions [{:db/id #edb/ref 17592186176058 :knowledge-point/id #uuid "66a1733a-d7bb-5c86-a154-9e54422053a7" :knowledge-point/title "Utilizing the Oddness Property of the Tangent Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "19df7d47-b87b-5e46-8360-7533c525ec2c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186266358} {:answer/id #uuid "3c2908b8-2ead-5a77-be9f-804bc07bb7fe" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186266672} {:answer/id #uuid "6ccc1b1b-9a04-5bb8-a591-9f5cc4c7efc6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{2}" :db/id #edb/ref 17592186267102} {:answer/id #uuid "8b14d04b-7661-55d9-a6d2-74ec1e93a05a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186267392} {:answer/id #uuid "a5bfc5ef-972c-5d0d-9011-6abdfdf11b45" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186267642}] :answer-field/correct {:answer/id #uuid "19df7d47-b87b-5e46-8360-7533c525ec2c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186266358} :answer-field/id #uuid "a6737d96-a059-592e-9cfb-df4b5f79acd2" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186268703}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "ccd7ae50-1c4e-5bcc-8b8b-d405f5154f0b" :question/math-academy-id "q-136548" :question/problem "If $tan⁡a=-2,$ then $tan⁡(-a)=$" :question/worked-solution "First, let's recall the graph of $y=tan⁡x.$\n\n![](images/df/df1aba3f5ff980de82a74dde8170ad708e379caf2188873bcddc83177e87c7a6.png)\n\nOur graph has rotational symmetry of order $2$ about the origin. If we rotate the graph ${180}^{∘}$ around the origin, we get the same picture. This means that $tan⁡x$ is an *odd* function, and we have\n\n$$\ntan⁡(-x)=-tan⁡x.\n$$\n\nTherefore, \n\n$$\n\\begin{aligned}tan⁡(-a) & =-tan⁡a \\\\  & =-(-2) \\\\  & =2.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186269128 :knowledge-point/_questions [{:db/id #edb/ref 17592186176059 :knowledge-point/id #uuid "d4b378b0-30e5-59a8-b9f7-882b5e226a2e" :knowledge-point/title "Utilizing the Evenness Property of the Secant Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "04ba9a98-d418-5054-94e5-129c6b76bfac" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-12" :db/id #edb/ref 17592186266186} {:answer/id #uuid "19edb75b-03b9-59e8-bc8e-e9f768d59cb2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186266360} {:answer/id #uuid "5e2ed2c4-f432-5dc5-84ad-45be5e6c0e95" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "12" :db/id #edb/ref 17592186266975} {:answer/id #uuid "5e32262d-72d6-5e5a-894e-153eb250705f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{12}" :db/id #edb/ref 17592186266977} {:answer/id #uuid "f0b9b848-8717-52db-b148-c872c7061d08" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{12}" :db/id #edb/ref 17592186268284}] :answer-field/correct {:answer/id #uuid "04ba9a98-d418-5054-94e5-129c6b76bfac" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-12" :db/id #edb/ref 17592186266186} :answer-field/id #uuid "aa7bd887-2e1e-5f25-8630-dbf79ed567a6" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186268713}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "b8cc1f5d-680d-525d-9686-5ade22a43012" :question/math-academy-id "q-136627" :question/problem "If $sec⁡a=-12,$ then $sec⁡(-a)=$" :question/worked-solution "First, let's recall the graph of $y=sec⁡x.$\n\n![](images/fb/fbf6ef1ca91f998ab4dc2dda1890ffc8a713f2eeff19e5569351b2466256d63a.png)\n\nNotice that our graph is symmetric about the $y$-axis. If we reflect the graph about the $y$-axis, we get the same picture. This means that $sec⁡x$ is an *even* function, and we have\n\n$$\nsec⁡(-x)=sec⁡x.\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}sec⁡(-a) & =sec⁡a \\\\  & =-12.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186269129 :knowledge-point/_questions [{:db/id #edb/ref 17592186176057 :knowledge-point/id #uuid "94645507-186a-54a7-a96b-ccfb0fb1f769" :knowledge-point/title "Utilizing the Evenness Property of the Cosine Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2a49b518-1242-5538-88d2-11c15ad409a6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{7}{10}" :db/id #edb/ref 17592186266511} {:answer/id #uuid "47bd735c-d78a-5fa1-af23-606d585fec22" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{7}{10}" :db/id #edb/ref 17592186266785} {:answer/id #uuid "d7848761-d53a-5319-b2fc-3092efadcb6f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{10}" :db/id #edb/ref 17592186268060} {:answer/id #uuid "f7519539-e4d9-5d01-ab39-32fa53d98166" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{3}{10}" :db/id #edb/ref 17592186268336} {:answer/id #uuid "fb6c5ae7-fa41-560e-9dd3-471731162c02" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{91}}{10}" :db/id #edb/ref 17592186268367}] :answer-field/correct {:answer/id #uuid "f7519539-e4d9-5d01-ab39-32fa53d98166" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{3}{10}" :db/id #edb/ref 17592186268336} :answer-field/id #uuid "8efb648d-3ab0-5adb-a826-86d01fca5115" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186268658}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "4dcab682-c7ea-5000-bb2e-9cbc57f39eb0" :question/math-academy-id "q-136629" :question/problem "If $cos⁡x=-\\frac{3}{10},$ then $cos⁡(-x)=$" :question/worked-solution "First, let's recall the graph of $y=cos⁡x.$\n\n![](images/23/2373daf4b5fd26f098bf90e998e2685db6a8b793e94ac9d80b08ea423cb535c0.png)\n\nNotice that our graph is symmetric about the $y$-axis. If we reflect the graph over the $y$-axis, we get the same picture. This means that $cos⁡x$ is an *even* function, and we have\n\n$$\ncos⁡(-x)=cos⁡x.\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}cos⁡(-x) & =cos⁡x \\\\  & =-\\frac{3}{10}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186269131 :knowledge-point/_questions [{:db/id #edb/ref 17592186176059 :knowledge-point/id #uuid "d4b378b0-30e5-59a8-b9f7-882b5e226a2e" :knowledge-point/title "Utilizing the Evenness Property of the Secant Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "038a1bc6-e647-59b6-aaa7-d35e90993bc6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{8}" :db/id #edb/ref 17592186266176} {:answer/id #uuid "1d7c73d5-90cc-5170-965c-525cdbc8308d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{8}" :db/id #edb/ref 17592186266399} {:answer/id #uuid "3a3b8949-b671-5cf2-bbef-476092a89eb1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186266656} {:answer/id #uuid "bdb40afd-ce8b-5929-b1b9-111a96d60fa4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186267848} {:answer/id #uuid "f750f91c-c511-5f89-913b-c6b563802807" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-8" :db/id #edb/ref 17592186268335}] :answer-field/correct {:answer/id #uuid "f750f91c-c511-5f89-913b-c6b563802807" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-8" :db/id #edb/ref 17592186268335} :answer-field/id #uuid "e028f60d-3a78-5cef-a248-395baca88d6e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186268803}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "a2a3460c-5045-59bc-aae3-13b2bea30fac" :question/math-academy-id "q-136631" :question/problem "If $sec⁡a=-8,$ then $sec⁡(-a)=$" :question/worked-solution "First, let's recall the graph of $y=sec⁡x.$\n\n![](images/fb/fbf6ef1ca91f998ab4dc2dda1890ffc8a713f2eeff19e5569351b2466256d63a.png)\n\nNotice that our graph is symmetric about the $y$-axis. If we reflect the graph about the $y$-axis, we get the same picture. This means that $sec⁡x$ is an *even* function, and we have\n\n$$\nsec⁡(-x)=sec⁡x.\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}sec⁡(-a) & =sec⁡a \\\\  & =-8.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186269132 :knowledge-point/_questions [{:db/id #edb/ref 17592186176058 :knowledge-point/id #uuid "66a1733a-d7bb-5c86-a154-9e54422053a7" :knowledge-point/title "Utilizing the Oddness Property of the Tangent Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "378e1e66-9bf4-50e3-a7c1-262bf4e92781" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{4}{5}" :db/id #edb/ref 17592186266624} {:answer/id #uuid "3ef10c28-e626-5937-ba80-feb997f872b4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5}{4}" :db/id #edb/ref 17592186266707} {:answer/id #uuid "4b3e15ed-e7b6-5ea7-b9ed-17bf737d8274" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{4}{5}" :db/id #edb/ref 17592186266811} {:answer/id #uuid "c3857dc6-9f35-5def-8ee2-c64c55acc069" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{5}{4}" :db/id #edb/ref 17592186267889} {:answer/id #uuid "d30ef100-9315-5778-b153-4a1a0a22e9d8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{5}" :db/id #edb/ref 17592186268026}] :answer-field/correct {:answer/id #uuid "4b3e15ed-e7b6-5ea7-b9ed-17bf737d8274" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{4}{5}" :db/id #edb/ref 17592186266811} :answer-field/id #uuid "d4a81cb7-756d-567d-b8be-538028bb5ed2" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186268787}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "b5606ff1-4177-5d4b-892b-30b0ba862cf3" :question/math-academy-id "q-136639" :question/problem "If $tan⁡a=\\frac{4}{5},$ then $tan⁡(-a)=$" :question/worked-solution "First, let's recall the graph of $y=tan⁡x.$\n\n![](images/df/df1aba3f5ff980de82a74dde8170ad708e379caf2188873bcddc83177e87c7a6.png)\n\nOur graph has rotational symmetry of order $2$ about the origin. If we rotate the graph ${180}^{∘}$ around the origin, we get the same picture. This means that $tan⁡x$ is an *odd* function, and we have\n\n$$\ntan⁡(-x)=-tan⁡x.\n$$\n\nTherefore, \n\n$$\n\\begin{aligned}tan⁡(-a) & =-tan⁡a \\\\  & =-\\frac{4}{5}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186101141 :knowledge-point/_questions [{:db/id #edb/ref 17592186100875 :knowledge-point/id #uuid "1f2f5234-df9c-5269-8702-30b4dde9a2ca" :knowledge-point/title "Multiplying a Matrix by the Identity Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8561cf7d-5905-51f0-afa8-dfa160c2a666" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The product is undefined" :db/id #edb/ref 17592186098182} {:answer/id #uuid "9d75e31c-6d5f-5ff7-bfb7-9af46b05c952" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}2 & 0 \\\\ 0 & 2\\end{bmatrix}" :db/id #edb/ref 17592186098183} {:answer/id #uuid "b04ab11c-1e23-5a8a-ace9-0a5b7e812fa6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-2 & -3 \\\\ -1 & -2\\end{bmatrix}" :db/id #edb/ref 17592186098184} {:answer/id #uuid "d9147d52-f2e7-5bda-9f5b-fe0aae8f7137" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}0 & 0 \\\\ 0 & 0\\end{bmatrix}" :db/id #edb/ref 17592186098185} {:answer/id #uuid "730c731f-1318-55a0-8381-b58852458731" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}2 & 3 \\\\ 1 & 2\\end{bmatrix}" :db/id #edb/ref 17592186098186}] :answer-field/id #uuid "eb3b92a3-f788-5f9e-bc32-c27df022209b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186098181} {:answer-field/choices [{:answer/id #uuid "a3819a4e-2124-51a9-966d-a232f795727b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}-2 & -3 \\\\ -1 & -2\\end{aligned}]" :db/id #edb/ref 17592186388506} {:answer/id #uuid "e5497e19-b13b-5352-a486-89ae75f2fe36" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}2 & 3 \\\\ 1 & 2\\end{aligned}]" :db/id #edb/ref 17592186388507} {:answer/id #uuid "1524532d-303c-57e8-baaa-e00f625a908a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}0 & 0 \\\\ 0 & 0\\end{aligned}]" :db/id #edb/ref 17592186388508} {:answer/id #uuid "f505e5ac-8344-5745-ab05-6ca6bf802e47" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The product is undefined" :db/id #edb/ref 17592186388509} {:answer/id #uuid "5e6230bd-503c-59b4-8461-692f556f4ea7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}2 & 0 \\\\ 0 & 2\\end{aligned}]" :db/id #edb/ref 17592186388510}] :answer-field/correct {:answer/id #uuid "e5497e19-b13b-5352-a486-89ae75f2fe36" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}2 & 3 \\\\ 1 & 2\\end{aligned}]" :db/id #edb/ref 17592186388507} :answer-field/id #uuid "4bf67a40-3ab5-50a6-9561-e2ee6d875a8b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186388505}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "612ed9a2-f644-5c99-b797-cab8e5ee69a6" :question/math-academy-id "q-13762" :question/problem "Calculate the product ${I}_{2}B$ given that ${I}_{2}$ is the $2\\times 2$ identity matrix and\n$B=[\\begin{aligned}2 & 3 \\\\ 1 & 2\\end{aligned}].$" :question/worked-solution "Any matrix, when multiplied by an identity matrix, remains unchanged (assuming that the multiplication is well defined).\n\nThe matrix ${I}_{2}$ is a $2\\times 2$ matrix and $B$ is a $2\\times 2$ matrix too. \n\nTherefore, the multiplication is well defined and \n\n$$\n{I}_{2}\\cdot B=B=[\\begin{aligned}2 & 3 \\\\ 1 & 2\\end{aligned}].\n$$"}] [{:db/id #edb/ref 17592186269219 :knowledge-point/_questions [{:db/id #edb/ref 17592186100878 :knowledge-point/id #uuid "288e49b0-f706-54de-86b7-a17248fe2408" :knowledge-point/title "Calculating the Area of the Parallelogram Spanned by Two Non-Parallel Vectors"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "186ee2ac-da11-5516-b903-e3b5e9480103" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186266346} {:answer/id #uuid "303f5039-136f-57c4-95b6-e45427ec1075" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "10" :db/id #edb/ref 17592186266570} {:answer/id #uuid "3d1f355e-f850-51c9-9c2a-fb7bc5bbb357" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "12" :db/id #edb/ref 17592186266684} {:answer/id #uuid "92a8e1d3-8eda-5c2f-9bb2-70ec28082ba2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "11" :db/id #edb/ref 17592186267452} {:answer/id #uuid "a686bd68-cab0-5c69-85ea-bad821967fe1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186267650}] :answer-field/correct {:answer/id #uuid "303f5039-136f-57c4-95b6-e45427ec1075" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "10" :db/id #edb/ref 17592186266570} :answer-field/id #uuid "ad50c151-5c0e-566c-ac0d-79838b4014d4" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186268718}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "cad6730b-4b4a-5d91-acf2-b03ce7ce4d8e" :question/math-academy-id "q-13944" :question/problem "![](images/7a/7a70285258e584708a7296a2a008536dec9c97750b48e5fe0eb2f8cb7761bed1.png)\n\nCalculate the area of the parallelogram in the figure." :question/worked-solution "From the diagram, we get the vectors\n\n$$\n\\text{u}=⟨3,2⟩,\\,\\text{v}=⟨2,-2⟩.\n$$\n\nFirst, we construct a matrix where the columns are made up of the components of the corresponding vectors:\n\n$$\nM=[\\begin{aligned}3 & 2 \\\\ 2 & -2\\end{aligned}]\n$$\n\nThen, we find the determinant:\n\n$$\n\\begin{aligned}det(M) & =|\\begin{aligned}3 & 2 \\\\ 2 & -2\\end{aligned}| \\\\  & =3\\cdot (-2)-2\\cdot 2 \\\\  & =-10\\end{aligned}\n$$\n\nThe absolute value of $det(M)$ gives the area $A$ of the parallelogram:\n\n$$\nA=|-10\\,|=10\n$$"}] [{:db/id #edb/ref 17592186269232 :knowledge-point/_questions [{:db/id #edb/ref 17592186100878 :knowledge-point/id #uuid "288e49b0-f706-54de-86b7-a17248fe2408" :knowledge-point/title "Calculating the Area of the Parallelogram Spanned by Two Non-Parallel Vectors"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2d768a08-43a7-50f3-bc2c-9d0aec2d145d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "38" :db/id #edb/ref 17592186266547} {:answer/id #uuid "49c440bd-ae95-5742-ba82-03be224e0b41" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "23" :db/id #edb/ref 17592186266798} {:answer/id #uuid "650a0407-08e2-55ea-afa8-98afe8bbc506" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "12" :db/id #edb/ref 17592186267039} {:answer/id #uuid "7b1ac682-0ef5-54bf-9790-851d28380cff" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186267230} {:answer/id #uuid "dba30746-1bcd-5e32-976d-2a26e890257c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "52" :db/id #edb/ref 17592186268088}] :answer-field/correct {:answer/id #uuid "49c440bd-ae95-5742-ba82-03be224e0b41" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "23" :db/id #edb/ref 17592186266798} :answer-field/id #uuid "d0ea674a-8479-5833-a353-9cc54ecf9166" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186268781}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "19e02ca3-a6f7-5909-838c-8df1ebb7ea40" :question/math-academy-id "q-13951" :question/problem "Calculate the area of the parallelogram spanned by $\\text{u}=[\\begin{aligned}1 \\\\ -4\\end{aligned}]$ and $\\text{v}=[\\begin{aligned}5 \\\\ 3\\end{aligned}].$" :question/worked-solution "First, we construct a matrix where the columns are made up of the components of the corresponding vectors:\n\n$$\nM=[\\begin{aligned}1 & 5 \\\\ -4 & 3\\end{aligned}]\n$$\n\nThen, we find the determinant:\n\n$$\n\\begin{aligned}det(M) & =|\\begin{aligned}1 & 5 \\\\ -4 & 3\\end{aligned}| \\\\  & =1\\cdot 3-5\\cdot (-4) \\\\  & =23\\end{aligned}\n$$\n\nThe absolute value of $det(M)$ gives the area $A$ of the parallelogram:\n\n$$\nA=|\\,23\\,|=23\n$$"}] [{:db/id #edb/ref 17592186271964 :knowledge-point/_questions [{:db/id #edb/ref 17592186087819 :knowledge-point/id #uuid "10ca3efc-7d23-5bc1-ab41-f785bed69986" :knowledge-point/title "Matrices for Route Planning"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "257b433d-960b-5602-9139-f0a08f725b10" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186269602} {:answer/id #uuid "2912ecc2-b82b-545b-a134-0f849b9f6f10" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186269638} {:answer/id #uuid "a28f67e7-b07f-5e99-99f1-6ef0ca27df71" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186270719} {:answer/id #uuid "ab496260-2eb5-5f24-b36a-b5c83e218fef" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186270799} {:answer/id #uuid "cee52816-3d9a-5a2d-bf35-0841387ab28c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186271084}] :answer-field/correct {:answer/id #uuid "2912ecc2-b82b-545b-a134-0f849b9f6f10" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186269638} :answer-field/id #uuid "2a50b6d4-0ed8-59a9-bfe9-13d431937f58" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186271588}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "cf86f867-a1a5-56dc-89e8-e2255e71399b" :question/math-academy-id "q-139689" :question/problem "![](images/6c/6c52f315d079b82fb729c4ab47f210ec4bf2683d0dfe1adfe79c94db9fbc5f63.png)\n\nThe diagram above shows train routes between three stations, where nodes represent the stations and arrows represent the directed routes between them. The (incomplete) route matrix below represents information about the number of routes between each of the three stations. Find the value of $a+b+c.$\n\n|  |  | To: |  |  |\n| --- | --- | --- | --- | --- |\n|  |  | **A** | **B** | **C** |\n| From: | **A** | $1$ | $a$ | $0$ |\n| **B** | $0$ | $b$ | $2$ |  |\n| **C** | $c$ | $1$ | $0$ |  |" :question/worked-solution "Let's examine our diagram.\n\n- There is $1$ arrow starting at Station A and ending at Station B. So, there is only one route from $A$ to $B,$ and so $a=1.$\n\n- There is $1$ arrow starting at Station B and ending at Station B. So, there is only one route from $B$ to $B,$ and so $b=1.$\n\n- There are no arrows starting at Station C and ending at Station A. So, there are no routes from $C$ to $A,$ and so $c=0.$\n\nAs a result, our route matrix is the following:\n\n|  |  | To: |  |  |\n| --- | --- | --- | --- | --- |\n|  |  | **A** | **B** | **C** |\n| From: | **A** | $1$ | $1$ | $0$ |\n| **B** | $0$ | $1$ | $2$ |  |\n| **C** | $0$ | $1$ | $0$ |  |\n\nTherefore, \n\n$$\na+b+c=1+1+0=2.\n$$"}] [{:db/id #edb/ref 17592186060044 :knowledge-point/_questions [{:db/id #edb/ref 17592186059851 :knowledge-point/id #uuid "09aeb7f5-31e0-5b2d-9e2a-8eace54a6665" :knowledge-point/title "Calculating the Cross Product of Two Vectors Whose Angle Is a Non-Special Angle"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "60742969-581c-5973-8fa9-78e77a0bf094" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "36n" :db/id #edb/ref 17592186270120} {:answer/id #uuid "622b545e-1af8-5ad8-944d-8f87481ebdc4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "27n" :db/id #edb/ref 17592186270133} {:answer/id #uuid "7cbbc011-0ab5-5321-8b62-8396249479da" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "29n" :db/id #edb/ref 17592186270362} {:answer/id #uuid "84e582c4-e0ad-504a-9f91-14756ec4390b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "43n" :db/id #edb/ref 17592186270417} {:answer/id #uuid "b177a505-8449-5d54-8746-4506cea92190" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "34n" :db/id #edb/ref 17592186270854}] :answer-field/correct {:answer/id #uuid "7cbbc011-0ab5-5321-8b62-8396249479da" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "29n" :db/id #edb/ref 17592186270362} :answer-field/id #uuid "ba0ffccc-6715-58cf-bae1-c7df2b05cefa" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186271847}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "6fb7d87a-bb90-5349-a9b4-58de72e66222" :question/math-academy-id "q-1400" :question/problem "The vector $a$ has magnitude $9,$ the vector $b$ has magnitude $5,$ the angle between $a$ and $b$ is ${140}^{∘}$ and $n$ is the unit vector that points in the direction of $a\\times b.$ Find $a\\times b$ in terms of $n.$ Round your final answer to the nearest integer where appropriate." :question/requires-calculator true :question/worked-solution "We use the formula for the cross product and obtain\n\n$$\n\\begin{aligned}a\\times b & =|a|\\cdot |b|\\cdot \\operatorname{sin}⁡\\theta \\cdot n \\\\  & =9\\cdot 5\\cdot \\operatorname{sin}⁡{140}^{∘}\\cdot n \\\\  & =45\\cdot (0.642…)\\cdot n \\\\  & =(28.925…)\\cdot n \\\\  & ≈29n.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186272044 :knowledge-point/_questions [{:db/id #edb/ref 17592186068874 :knowledge-point/id #uuid "bf9b812d-0dbf-5a67-9d45-3cc5e373b2b1" :knowledge-point/title "Completing the Square When the Perfect Square is Isolated: Negative Linear Term"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1de2e53b-3e5a-515c-aeb7-08b2b37df9ba" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(x-5{)}^{2}+1" :db/id #edb/ref 17592186269517} {:answer/id #uuid "2044f8ba-a526-5264-9c8b-279475bc6079" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(x+5{)}^{2}+1" :db/id #edb/ref 17592186269538} {:answer/id #uuid "4ef60e4f-a72a-5357-acf3-4233e5a280e9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(x-25{)}^{2}+1" :db/id #edb/ref 17592186269981} {:answer/id #uuid "d1396c9b-3b30-5a34-9af3-bb9767985973" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(x-10{)}^{2}+1" :db/id #edb/ref 17592186271110} {:answer/id #uuid "e97a70aa-76d8-5b9c-aa63-ecd9752ccf4f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(x+10{)}^{2}+1" :db/id #edb/ref 17592186271312}] :answer-field/correct {:answer/id #uuid "1de2e53b-3e5a-515c-aeb7-08b2b37df9ba" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(x-5{)}^{2}+1" :db/id #edb/ref 17592186269517} :answer-field/id #uuid "501bcbfe-9b64-5b29-8ec4-43efe59a3a60" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186271656}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "0a5ade6b-92c1-5055-8b0b-c80cbaff9d2f" :question/math-academy-id "q-140281" :question/problem "Rewrite the expression $({x}^{2}-10x+25)+1$ as the sum of a perfect square and a constant." :question/worked-solution "First, we recall the following formula:\n\n$$\n{x}^{2}-2ax+{a}^{2}=(x-a{)}^{2}\n$$\n\nNotice that we have a perfect square in the parentheses that we can factor as follows:\n\n$$\n\\begin{aligned}{x}^{2}-10x+25 & = \\\\ {x}^{2}-10x+{5}^{2} & = \\\\ {x}^{2}-2\\cdot 5x+{5}^{2} & = \\\\ (x-5{)}^{2} & \\end{aligned}\n$$\n\nTherefore, we obtain\n\n$$\n\\begin{aligned}({x}^{2}-10x+25)+1 & = \\\\ (x-5{)}^{2}+1 & .\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186272045 :knowledge-point/_questions [{:db/id #edb/ref 17592186068874 :knowledge-point/id #uuid "bf9b812d-0dbf-5a67-9d45-3cc5e373b2b1" :knowledge-point/title "Completing the Square When the Perfect Square is Isolated: Negative Linear Term"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "098366e9-6bbf-557f-8b0b-c28f1f5c5d06" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(x+12{)}^{2}-4" :db/id #edb/ref 17592186269356} {:answer/id #uuid "229c01ab-0ea9-5605-90a1-1d5a7751e77a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(x-11{)}^{2}-4" :db/id #edb/ref 17592186269568} {:answer/id #uuid "9d389434-bcbe-5f2b-ab97-000df772d7d9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(x-12{)}^{2}-4" :db/id #edb/ref 17592186270659} {:answer/id #uuid "aa8a2c46-7cb2-59b0-9203-35410fcdd6dd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(x-22{)}^{2}-4" :db/id #edb/ref 17592186270793} {:answer/id #uuid "b0f56343-9654-51c6-8939-85100071b4dd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(x+11{)}^{2}-4" :db/id #edb/ref 17592186270849}] :answer-field/correct {:answer/id #uuid "229c01ab-0ea9-5605-90a1-1d5a7751e77a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(x-11{)}^{2}-4" :db/id #edb/ref 17592186269568} :answer-field/id #uuid "90eb344c-2847-58a2-8769-e020f945532e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186271768}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "ff51e775-e2b4-585e-a683-f90782853abe" :question/math-academy-id "q-140283" :question/problem "Rewrite the expression $({x}^{2}-22x+121)-4$ as the difference between a perfect square and a constant." :question/worked-solution "First, we recall the following formula:\n\n$$\n{x}^{2}-2ax+{a}^{2}=(x-a{)}^{2}\n$$\n\nNotice that we have a perfect square in the parentheses that we can factor as follows:\n\n$$\n\\begin{aligned}{x}^{2}-22x+121 & = \\\\ {x}^{2}-22x+{11}^{2} & = \\\\ {x}^{2}-2\\cdot 11x+{11}^{2} & = \\\\ (x-11{)}^{2} & \\end{aligned}\n$$\n\nTherefore, we obtain\n\n$$\n\\begin{aligned}({x}^{2}-22x+121)-4 & = \\\\ (x-11{)}^{2}-4 & .\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186272058 :knowledge-point/_questions [{:db/id #edb/ref 17592186184322 :knowledge-point/id #uuid "2a85fece-e40f-543c-b3c3-ae43a5175808" :knowledge-point/title "Completing the Square When the Leading Coefficient is Negative One: Odd Linear Terms"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "071c98e7-f045-5699-97e6-8ca98ff4c425" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{89}{4}-{(x+14)}^{2}" :db/id #edb/ref 17592186269336} {:answer/id #uuid "0b6551d7-ff9d-5fcb-9ba8-47eb76d9737a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{9}{4}-{(x+\\frac{7}{2})}^{2}" :db/id #edb/ref 17592186269367} {:answer/id #uuid "92214c5a-0fb3-5f9c-b2fd-8c3a954013bf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "59-{(x+14)}^{2}" :db/id #edb/ref 17592186270546} {:answer/id #uuid "b1f6b651-8575-5bc8-a027-fe8e7ce11c40" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{7}{2}-{(x+\\frac{7}{2})}^{2}" :db/id #edb/ref 17592186270861} {:answer/id #uuid "d730e81c-c1fd-5d3a-9ed2-255c3dad533b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{49}{4}-{(x+\\frac{7}{2})}^{2}" :db/id #edb/ref 17592186271160}] :answer-field/correct {:answer/id #uuid "0b6551d7-ff9d-5fcb-9ba8-47eb76d9737a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{9}{4}-{(x+\\frac{7}{2})}^{2}" :db/id #edb/ref 17592186269367} :answer-field/id #uuid "9e101ba8-4e79-5217-9a66-13f1e2c2b19e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186271788}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "5f049fbc-7296-56e3-bb5f-3d51d2204d7a" :question/math-academy-id "q-140330" :question/problem "Rewrite $-({x}^{2}+7x+10)$ by completing the square." :question/worked-solution "We begin by completing the square for the expression inside the parentheses:\n\n$$\n{x}^{2}+7x+10\n$$\n\nFirst, we rewrite the coefficient of the linear term as a product with $2$ as a factor:\n\n$$\n{x}^{2}+2\\cdot \\frac{7}{2}x+10\n$$\n\nThen, we *add* and *then subtract* ${(\\frac{7}{2})}^{2},$ writing the constant term $10$ last:\n\n$$\n{{x}^{2}+2\\cdot \\frac{7}{2}x+{(\\frac{7}{2})}^{2}}_{⏟}-{(\\frac{7}{2})}^{2}+10\n$$\n\nThe first three terms form a perfect square, which we factor as follows:\n\n$$\n{(x+\\frac{7}{2})}^{2}-{(\\frac{7}{2})}^{2}+10\n$$\n\nEvaluating the last two terms, we get\n\n$$\n{(x+\\frac{7}{2})}^{2}-\\frac{9}{4}.\n$$\n\nFinally, we substitute this result back into our original expression:\n\n$$\n\\begin{aligned}-({x}^{2}+7x+10) & =-({(x+\\frac{7}{2})}^{2}-\\frac{9}{4}) \\\\  & =-{(x+\\frac{7}{2})}^{2}+\\frac{9}{4} \\\\  & =\\frac{9}{4}-{(x+\\frac{7}{2})}^{2}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186272060 :knowledge-point/_questions [{:db/id #edb/ref 17592186184322 :knowledge-point/id #uuid "2a85fece-e40f-543c-b3c3-ae43a5175808" :knowledge-point/title "Completing the Square When the Leading Coefficient is Negative One: Odd Linear Terms"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2e0b9d03-98ee-5f65-8899-eb0ca3293f69" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{4}-{(y+\\frac{9}{2})}^{2}" :db/id #edb/ref 17592186269682} {:answer/id #uuid "51675449-e3ed-5d32-a5a1-dc181d745b38" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{161}{4}-{(y-\\frac{9}{2})}^{2}" :db/id #edb/ref 17592186269997} {:answer/id #uuid "64001e55-d244-54a8-918a-a1c0059b44a6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{4}-{(y+\\frac{9}{2})}^{2}" :db/id #edb/ref 17592186270154} {:answer/id #uuid "88d86ace-1240-59e6-93cf-c53adca2f146" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "61-{(y+18)}^{2}" :db/id #edb/ref 17592186270450} {:answer/id #uuid "e002a466-5bda-58b6-b497-ea8df55b4790" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{9}{4}-{(y+\\frac{9}{2})}^{2}" :db/id #edb/ref 17592186271234}] :answer-field/correct {:answer/id #uuid "2e0b9d03-98ee-5f65-8899-eb0ca3293f69" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{4}-{(y+\\frac{9}{2})}^{2}" :db/id #edb/ref 17592186269682} :answer-field/id #uuid "19597342-b978-5e00-8333-b2a8755a3138" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186271554}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "6187e130-749f-5a82-add1-d28e2491c294" :question/math-academy-id "q-140333" :question/problem "Rewrite $-({y}^{2}+9y+20)$ by completing the square." :question/worked-solution "We begin by completing the square for the expression inside the parentheses:\n\n$$\n{y}^{2}+9y+20\n$$\n\nFirst, we rewrite the coefficient of the linear term as a product with $2$ as a factor:\n\n$$\n{y}^{2}+2\\cdot \\frac{9}{2}y+20\n$$\n\nThen, we *add* and *then subtract* ${(\\frac{9}{2})}^{2},$ writing the constant term $20$ last:\n\n$$\n{{y}^{2}+2\\cdot \\frac{9}{2}y+{(\\frac{9}{2})}^{2}}_{⏟}-{(\\frac{9}{2})}^{2}+20\n$$\n\nThe first three terms form a perfect square, which we factor as follows:\n\n$$\n{(y+\\frac{9}{2})}^{2}-{(\\frac{9}{2})}^{2}+20\n$$\n\nEvaluating the last two terms, we get\n\n$$\n{(y+\\frac{9}{2})}^{2}-\\frac{1}{4}.\n$$\n\nFinally, we substitute this result back into our original expression:\n\n$$\n\\begin{aligned}-({y}^{2}+9y+20) & =-({(y+\\frac{9}{2})}^{2}-\\frac{1}{4}) \\\\  & =-{(y+\\frac{9}{2})}^{2}+\\frac{1}{4} \\\\  & =\\frac{1}{4}-{(y+\\frac{9}{2})}^{2}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186184484 :knowledge-point/_questions [{:db/id #edb/ref 17592186184212 :knowledge-point/id #uuid "3202d7cc-541b-553b-8ec1-d4ea85dd0590" :knowledge-point/title "Completing the Square on an Expression With a Negative Leading Coefficient"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2441e55c-3656-5b9c-9444-a562a3ff3b87" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-9{(z-\\frac{1}{3})}^{2}+10" :db/id #edb/ref 17592186269586} {:answer/id #uuid "4f3faa2d-7189-540c-8002-572e91da81bc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-9{(z+\\frac{1}{3})}^{2}+5" :db/id #edb/ref 17592186269984} {:answer/id #uuid "82317f98-eb55-5a2a-84b7-c0fc441aa39a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-9{(z-\\frac{1}{3})}^{2}-8" :db/id #edb/ref 17592186270394} {:answer/id #uuid "ca440db9-063c-5ec8-89e2-7e47d8b1e800" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-9{(z+\\frac{1}{3})}^{2}+10" :db/id #edb/ref 17592186271044} {:answer/id #uuid "f37d3db7-779c-579c-a14f-a3675bd5b658" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-9{(z+\\frac{1}{3})}^{2}+8" :db/id #edb/ref 17592186271404}] :answer-field/correct {:answer/id #uuid "ca440db9-063c-5ec8-89e2-7e47d8b1e800" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-9{(z+\\frac{1}{3})}^{2}+10" :db/id #edb/ref 17592186271044} :answer-field/id #uuid "02be3ebb-ff12-5196-b096-96eac16ef254" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186271509}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "2495fc0b-8e76-56e1-bf72-c223c52c4fc2" :question/math-academy-id "q-140378" :question/problem "Rewrite $-9{z}^{2}-6z+9$ by completing the square." :question/worked-solution "Notice that the leading coefficient is $-9.$ So, we take out a factor of $-9$ from the entire expression:\n\n$$\n-9({z}^{2}+\\frac{2}{3}z-1)\n$$\n\nLet's now complete the square for the expression inside the parentheses:\n\n$$\n{z}^{2}+\\frac{2}{3}z-1\n$$\n\nFirst, we rewrite the coefficient of the linear term as a product with $2$ as a factor:\n\n$$\n{z}^{2}+2\\cdot \\frac{1}{3}\\cdot z-1\n$$\n\nThen, we *add* and *then subtract* ${(\\frac{1}{3})}^{2},$ writing the constant term $1$ last:\n\n$$\n{{z}^{2}+2\\cdot \\frac{1}{3}\\cdot z+{(\\frac{1}{3})}^{2}}_{⏟}-{(\\frac{1}{3})}^{2}-1\n$$\n\nThe first three terms form a perfect square, which we factor as follows:\n\n$$\n{(z+\\frac{1}{3})}^{2}-{(\\frac{1}{3})}^{2}-1\n$$\n\nEvaluating the last two terms, we get\n\n$$\n{(z+\\frac{1}{3})}^{2}-\\frac{10}{9}.\n$$\n\nFinally, we substitute this result back into our original expression::\n\n$$\n\\begin{aligned}-9({z}^{2}+\\frac{2}{3}z-1) & =-9({(z+\\frac{1}{3})}^{2}-\\frac{10}{9}) \\\\  & =-9{(z+\\frac{1}{3})}^{2}+(-9)\\cdot (-\\frac{10}{9}) \\\\  & =-9{(z+\\frac{1}{3})}^{2}+10\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186272081 :knowledge-point/_questions [{:db/id #edb/ref 17592186184322 :knowledge-point/id #uuid "2a85fece-e40f-543c-b3c3-ae43a5175808" :knowledge-point/title "Completing the Square When the Leading Coefficient is Negative One: Odd Linear Terms"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4d854445-4b9d-5457-8fdd-3e9aafaf84c7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{45}{4}-{(y-10)}^{2}" :db/id #edb/ref 17592186269970} {:answer/id #uuid "6c18b098-7360-5163-a283-eff16352c701" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{25}{4}-{(y-\\frac{5}{2})}^{2}" :db/id #edb/ref 17592186270231} {:answer/id #uuid "89f2f572-b7c1-5dea-a169-978a09aab668" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{5}{2}+{(y-\\frac{5}{2})}^{2}" :db/id #edb/ref 17592186270461} {:answer/id #uuid "aa2bcef6-9c81-5bea-950e-d8b1ddb76848" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "20-{(y-10)}^{2}" :db/id #edb/ref 17592186270787} {:answer/id #uuid "ed555ea6-dfea-51d4-876e-75d752688105" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5}{4}-{(y-\\frac{5}{2})}^{2}" :db/id #edb/ref 17592186271354}] :answer-field/correct {:answer/id #uuid "ed555ea6-dfea-51d4-876e-75d752688105" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5}{4}-{(y-\\frac{5}{2})}^{2}" :db/id #edb/ref 17592186271354} :answer-field/id #uuid "880bee47-a8c3-50a6-937c-697f411c6825" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186271749}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "afc8b4da-a3f1-5590-a7d5-e7a094b395bd" :question/math-academy-id "q-140410" :question/problem "Rewrite $-{y}^{2}+5y-5$ by completing the square." :question/worked-solution "Notice that the leading coefficient is $-1.$ So, we take out a factor of $-1$ from the entire expression:\n\n$$\n-({y}^{2}-5y+5)\n$$\n\nLet's now complete the square for the expression inside the parentheses:\n\n$$\n{y}^{2}-5y+5\n$$\n\nFirst, we rewrite the coefficient of the linear term as a product with $2$ as a factor:\n\n$$\n{y}^{2}-2\\cdot \\frac{5}{2}y+5\n$$\n\nThen, we *add* and *then subtract* ${(\\frac{5}{2})}^{2},$ writing the constant term $5$ last:\n\n$$\n{{y}^{2}-2\\cdot \\frac{5}{2}y+{(\\frac{5}{2})}^{2}}_{⏟}-{(\\frac{5}{2})}^{2}+5\n$$\n\nThe first three terms form a perfect square, which we factor as follows:\n\n$$\n{(y-\\frac{5}{2})}^{2}-{(\\frac{5}{2})}^{2}+5\n$$\n\nEvaluating the last two terms, we get\n\n$$\n{(y-\\frac{5}{2})}^{2}-\\frac{5}{4}.\n$$\n\nFinally, we substitute this result back into our original expression:\n\n$$\n\\begin{aligned}-{y}^{2}+5y-5 & =-({(y-\\frac{5}{2})}^{2}-\\frac{5}{4}) \\\\  & =\\frac{5}{4}-{(y-\\frac{5}{2})}^{2}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186272085 :knowledge-point/_questions [{:db/id #edb/ref 17592186096611 :knowledge-point/id #uuid "8b7d0153-6e0a-5e19-83f1-960811dc5205" :knowledge-point/title "Differentiating the Product of a Constant and the Exponential Function, Plus a Polynomial"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0884ad38-9d14-5f8e-b665-d8b35b5af237" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "e+4" :db/id #edb/ref 17592186269346} {:answer/id #uuid "0db0ac08-c4ce-5d3f-845f-d38358413506" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "e+8" :db/id #edb/ref 17592186269388} {:answer/id #uuid "2934301c-7684-5c1f-b910-d7819431eba3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2e" :db/id #edb/ref 17592186269640} {:answer/id #uuid "7789397b-7630-5bd8-9c80-42e72f128cee" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2e+8" :db/id #edb/ref 17592186270328} {:answer/id #uuid "81639cc6-e903-5cd2-bc14-50bfc72b4d70" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2e+4" :db/id #edb/ref 17592186270388}] :answer-field/correct {:answer/id #uuid "7789397b-7630-5bd8-9c80-42e72f128cee" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2e+8" :db/id #edb/ref 17592186270328} :answer-field/id #uuid "c7c2979c-8072-5209-9ca0-20ccbaf77003" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186271876}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "d2ffa4af-5dbe-569b-8d78-f233584a8913" :question/math-academy-id "q-140431" :question/problem "Given that $f(x)=2{e}^{x}+4{x}^{2}-3$, find the slope of the tangent at $x=1.$" :question/worked-solution "First, using the addition and the power rules, we get\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}(2{e}^{x}+4{x}^{2}-3) \\\\  & =\\frac{\\text{d}}{\\text{d}x}(2{e}^{x})+\\frac{\\text{d}}{\\text{d}x}(4{x}^{2})+\\frac{\\text{d}}{\\text{d}x}(-3) \\\\  & =2\\frac{\\text{d}}{\\text{d}x}({e}^{x})+4\\frac{\\text{d}}{\\text{d}x}({x}^{2})+0 \\\\  & =2{e}^{x}+8x.\\end{aligned}\n$$\n\nTherefore, the slope of the tangent at $x=1$ is\n\n$$\n\\begin{aligned}{\\frac{\\text{d}f}{\\text{d}x}|}_{x=1} & ={(2{e}^{x}+8x)\\,|}_{x=1} \\\\  & =2\\cdot {e}^{1}+8\\cdot 1 \\\\  & =2e+8.\\end{aligned}\n$$"}]}
