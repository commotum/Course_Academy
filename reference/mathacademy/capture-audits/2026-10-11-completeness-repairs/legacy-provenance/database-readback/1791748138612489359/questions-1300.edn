#{[{:db/id #edb/ref 17592186399057 :knowledge-point/_questions [{:db/id #edb/ref 17592186115220 :knowledge-point/id #uuid "387e57ad-6f80-5b90-8adf-7bf05618b532" :knowledge-point/title "Solving a Trigonometric Equation Involving Secant with Non-Special Angles"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9f6b8877-60d4-55b2-8bac-f93e30946ac6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "27\\,013" :db/id #edb/ref 17592186399059} {:answer/id #uuid "cd75ca22-d221-528e-9374-a2127cff3475" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "31\\,805" :db/id #edb/ref 17592186399060} {:answer/id #uuid "c98b22aa-0045-5d2d-826a-877753c65569" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "12\\,156" :db/id #edb/ref 17592186399061} {:answer/id #uuid "0a6a6bc1-55ab-55da-a856-6d2b5f1bdd88" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "21\\,642" :db/id #edb/ref 17592186399062} {:answer/id #uuid "d2fc604b-14af-553c-9b93-ef74d9892f1b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "15\\,681" :db/id #edb/ref 17592186399063}] :answer-field/correct {:answer/id #uuid "9f6b8877-60d4-55b2-8bac-f93e30946ac6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "27\\,013" :db/id #edb/ref 17592186399059} :answer-field/id #uuid "dc8f8da8-d591-560f-9fd3-2166ffc07f23" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186399058}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "21067b43-552c-57fe-bdc4-8f094139d29a" :question/math-academy-id "q-76493" :question/problem "Given that ${x}_{1}$ and ${x}_{2}$ are the solutions to the equation $\\operatorname{sec}⁡x=-\\frac{7}{2}$ for ${0}^{∘}\\le x<{360}^{∘},$ what is the numerical value of ${x}_{1}\\cdot {x}_{2},$ rounded to the nearest integer?" :question/worked-solution "Recall that $\\operatorname{sec}⁡x=\\frac{1}{\\operatorname{cos}⁡x},$ therefore the given equation is equivalent to\n\n$$\n\\operatorname{cos}⁡x=-\\frac{2}{7}.\n$$\n\nFirst, we find the principal value:\n\n$$\n\\begin{aligned}x=\\operatorname{arccos}⁡(-\\frac{2}{7})=106.601\\,549{…}^{∘}≈{106.602}^{∘}.\\end{aligned}\n$$\n\nSince ${106.602}^{∘}$ lies inside the required domain, our first solution is ${x}_{1}={106.602}^{∘}.$\n\nOur first solution lies in the second quadrant and has a reference angle of ${\\theta }_{R}={73.398}^{∘}.$ Since $\\operatorname{cos}⁡x<0,$ the second solution must lie in the third quadrant, and it also has a reference angle ${\\theta }_{R}={73.398}^{∘}.$\n\n![](images/e3/e378560486eca17f870b21743718c9f984f2bd3bf5609601f1cea674e15018e6.png)\n\nSince the second solution ${x}_{2}$ lies in the $3$rd quadrant, we can find it using the reference angle as follows:\n\n$$\n\\begin{aligned}{x}_{2} & ={180}^{∘}+{\\theta }_{R} \\\\  & ={180}^{∘}+{73.398}^{∘} \\\\  & ={253.398}^{∘}\\end{aligned}\n$$\n\nFinally, \n\n$$\n{x}_{1}\\cdot {x}_{2}=106.602\\cdot 253.398≈27\\,013,\n$$\n\nrounded to the nearest integer."}] [{:db/id #edb/ref 17592186403864 :knowledge-point/_questions [{:db/id #edb/ref 17592186115181 :knowledge-point/id #uuid "a9a3d8db-a6e0-5c96-9c75-415d4a75cf4d" :knowledge-point/title "Identifying Equations With No Solutions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ab9ab64a-0cd3-5dc1-8bf9-3e5e921cb9ee" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186403866} {:answer/id #uuid "bba7a0a8-4e9b-57ba-ac88-a9232adfbc0a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186403867} {:answer/id #uuid "d0100248-920c-515e-a5f9-c80112f0657a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186403868} {:answer/id #uuid "583cbb8c-6819-5a17-9eea-b75d06519784" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I, II and III" :db/id #edb/ref 17592186403869} {:answer/id #uuid "2a3f912e-91b5-5c0f-b650-babdfaadb19e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186403870}] :answer-field/correct {:answer/id #uuid "bba7a0a8-4e9b-57ba-ac88-a9232adfbc0a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186403867} :answer-field/id #uuid "50a2c6d2-6a4a-5a62-a1fb-a094e9a83f71" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186403865}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "a83238f9-a8b1-5193-9f12-9adee2517d46" :question/math-academy-id "q-76503" :question/problem "Which of the following equations has no solutions for ${0}^{∘}\\le x<{360}^{∘}?$\n\nI. $\\operatorname{sec}⁡x=0$ $$\nII. $\\operatorname{sec}⁡x=8$\nIII. $\\operatorname{sec}⁡x=\\frac{7}{3}$" :question/worked-solution "Recall that the range of $\\operatorname{sec}⁡x$ for ${0}^{∘}\\le x<{360}^{∘}$ is given by\n\n$$\n\\operatorname{sec}⁡x\\in (-\\infty ,-1]\\cup [1,\\infty ).\n$$\n\nSo, the equation $\\operatorname{sec}⁡x=k$ has no solutions for $k\\in (-1,1).$ \n\nTherefore, of the given equations, only equation I has no solutions."}] [{:db/id #edb/ref 17592186345249 :knowledge-point/_questions [{:db/id #edb/ref 17592186100820 :knowledge-point/id #uuid "aa20dbfa-3f6f-5caf-9c10-906f2422f161" :knowledge-point/title "Finding the General Solution to a Trigonometric Equation Containing Tangent or Cotangent"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "549eb3ff-0d70-5d98-95ae-140c946d9434" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=\\frac{\\pi }{5}+n\\pi " :db/id #edb/ref 17592186342942} {:answer/id #uuid "71f52d6b-9b86-50ff-8f7e-cfe37e69e6cd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=\\frac{3\\pi }{8}+n\\pi " :db/id #edb/ref 17592186343224} {:answer/id #uuid "9788f504-fc7f-5f00-9fe6-ff56fdf4863f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=\\frac{\\pi }{8}+n\\pi " :db/id #edb/ref 17592186343567} {:answer/id #uuid "b6219bdb-a8f7-50e4-9cf6-285351b7c0ac" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=\\frac{3\\pi }{4}+n\\pi " :db/id #edb/ref 17592186343834} {:answer/id #uuid "f41eacee-7b5a-5190-8daf-3e7d61906f13" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=\\frac{3\\pi }{4}+2n\\pi " :db/id #edb/ref 17592186344386}] :answer-field/correct {:answer/id #uuid "71f52d6b-9b86-50ff-8f7e-cfe37e69e6cd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=\\frac{3\\pi }{8}+n\\pi " :db/id #edb/ref 17592186343224} :answer-field/id #uuid "5c72e057-5521-52b8-8355-dcc75ede7d96" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186344647}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "e4b36406-0f67-50c9-b15a-12ee8329088e" :question/math-academy-id "q-76741" :question/problem "What is the general solution to the equation $\\operatorname{cot}⁡x=\\frac{1}{\\sqrt{2}+1}?$ Assume that $n$ is an integer.\n\n*Hint: You may use the fact that $\\operatorname{tan}⁡(\\frac{3\\pi }{8})=1+\\sqrt{2}.$*" :question/worked-solution "Recall that $\\operatorname{cot}⁡x=\\frac{1}{\\operatorname{tan}⁡x}.$ Therefore, the given equation is equivalent to\n\n$$\n\\begin{aligned}\\frac{1}{\\operatorname{tan}⁡x} & =\\frac{1}{\\sqrt{2}+1} \\\\ \\operatorname{tan}⁡x & =\\sqrt{2}+1.\\end{aligned}\n$$\n\nNow, we find the principal value:\n\n$$\n{x}_{1}=\\text{arctan}(\\sqrt{2}+1)=\\frac{3\\pi }{8}\n$$\n\nThe tangent function has a period of $\\pi .$  Hence, the general solution for the given equation is\n\n$$\nx=\\frac{3\\pi }{8}+n\\pi .\n$$"}] [{:db/id #edb/ref 17592186345255 :knowledge-point/_questions [{:db/id #edb/ref 17592186115358 :knowledge-point/id #uuid "51739685-2d53-5c9b-870b-b557ffdf2768" :knowledge-point/title "Finding the Area of a Triangle by Solving for a Variable Given a Trigonometric Ratio of One Angle"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "74a1f4a2-14fe-58a7-8d95-3369048da2c2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "60" :db/id #edb/ref 17592186343246} {:answer/id #uuid "8d168dd0-b3c3-576d-90ff-6db8eda26288" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "120" :db/id #edb/ref 17592186343471} {:answer/id #uuid "96e525fb-0817-5487-aa3b-b0e69dfcf066" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "45" :db/id #edb/ref 17592186343558} {:answer/id #uuid "a521d3f7-e12f-5f7c-8950-f5892e2df150" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "105" :db/id #edb/ref 17592186343695} {:answer/id #uuid "c9795681-7425-5697-a020-bca804b477be" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "80" :db/id #edb/ref 17592186344006}] :answer-field/correct {:answer/id #uuid "c9795681-7425-5697-a020-bca804b477be" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "80" :db/id #edb/ref 17592186344006} :answer-field/id #uuid "be3dea8a-e41f-53a0-a63d-3c221e2798e4" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186344828}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "79db05b6-9295-5a92-a7f0-878c0e6e3e21" :question/math-academy-id "q-76770" :question/problem "![](images/f1/f1880dc62f774152ce5076a313928c0e8109ca174184704c5880891ed9243718.png)\n\nGiven that $\\operatorname{tan}⁡(m∠A)=\\frac{2}{5},$ calculate the area (in square units) of $△ABC$ shown above." :question/worked-solution "In this case, the area of the right triangle is\n\n$$\nA=\\frac{1}{2}AC\\cdot BC.\n$$\n\nWe are given that $\\operatorname{tan}⁡(m∠A)=\\frac{2}{5}.$ Notice that relative to $∠A,$ we have expressions for the lengths of the opposite side $\\overset{―}{BC}$ and adjacent side $\\overset{―}{AC}.$ Hence, we can use the tangent ratio to solve for $x:$\n\n$$\n\\begin{aligned}\\operatorname{tan}⁡(m∠A) & =\\frac{BC}{AC} \\\\ \\frac{2}{5} & =\\frac{2x+4}{6x+8} \\\\ 2(6x+8) & =5(2x+4) \\\\ 12x+16 & =10x+20 \\\\ 12x-10x & =20-16 \\\\ 2x & =4 \\\\ x & =2\\end{aligned}\n$$\n\nSo, the side lengths are\n\n$$\n\\begin{aligned}BC & =2x+4=2(2)+4=8, \\\\ AC & =6x+8=6(2)+8=20.\\end{aligned}\n$$\n\nTherefore, the area of $△ABC$ is\n\n$$\n\\begin{aligned}A & =\\frac{1}{2}AC\\cdot BC \\\\  & =\\frac{1}{2}\\cdot 20\\cdot 8 \\\\  & =80.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186345256 :knowledge-point/_questions [{:db/id #edb/ref 17592186115360 :knowledge-point/id #uuid "fe83dedc-3034-5e3a-b546-dd57c0ccc6e8" :knowledge-point/title "Finding the Area of a Triangle by Solving for a Variable Given an Angle"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "11080520-591d-552f-a2b5-376652328032" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3\\sqrt{3}" :db/id #edb/ref 17592186342388} {:answer/id #uuid "20d23199-1707-5c8a-9c95-20a93346eafc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3\\sqrt{3}}{2}" :db/id #edb/ref 17592186342508} {:answer/id #uuid "23574e97-dff3-5da7-b5f5-3cada9731425" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{9\\sqrt{3}}{2}" :db/id #edb/ref 17592186342530} {:answer/id #uuid "bb1702de-fd43-50d8-a686-676b7d54dfb7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "24\\sqrt{3}" :db/id #edb/ref 17592186343884} {:answer/id #uuid "f9127ae7-e1de-5695-9e51-049f89115cde" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6\\sqrt{3}" :db/id #edb/ref 17592186344429}] :answer-field/correct {:answer/id #uuid "f9127ae7-e1de-5695-9e51-049f89115cde" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6\\sqrt{3}" :db/id #edb/ref 17592186344429} :answer-field/id #uuid "2b740c15-4310-51b1-b74c-cbe3e504200f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186344566}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "c61332e0-ca58-508b-96a8-0bfc3b0688b0" :question/math-academy-id "q-76773" :question/problem "![](images/ca/ca9c6640b6cb239ae19b195731d8f605adae8826f66e10b075f7b0ad4a60690f.png)\n\nFind the area (in square units) of $△ABC$ shown above." :question/worked-solution "In this case, the area of the right triangle is\n\n$$\nA=\\frac{1}{2}AB\\cdot BC.\n$$\n\nWe are given that $m∠A={30}^{∘}.$ Notice that relative to $∠A,$ we have expressions for the lengths of the opposite side $\\overset{―}{BC}$ and adjacent side $\\overset{―}{AB}.$ Hence, we can use the tangent ratio to solve for $x:$\n\n$$\n\\begin{aligned}\\operatorname{tan}⁡(m∠A) & =\\frac{BC}{AB} \\\\ \\operatorname{tan}⁡({30}^{∘}) & =\\frac{\\sqrt{3}\\,x}{x+4} \\\\ \\frac{\\sqrt{3}}{3} & =\\frac{\\sqrt{3}\\,x}{x+4} \\\\ \\sqrt{3}(x+4) & =3\\cdot \\sqrt{3}\\,x \\\\ \\sqrt{3}\\,x+4\\sqrt{3} & =3\\sqrt{3}\\,x \\\\ -2\\sqrt{3}\\,x & =-4\\sqrt{3} \\\\ x & =\\frac{4\\sqrt{3}}{2\\sqrt{3}} \\\\ x & =2\\end{aligned}\n$$\n\nSo, the side lengths are \n\n$$\n\\begin{aligned}BC & =\\sqrt{3}\\,x=\\sqrt{3}(2)=2\\sqrt{3}, \\\\ AB & =x+4=2+4=6.\\end{aligned}\n$$\n\nTherefore, the area of $△ABC$ is\n\n$$\n\\begin{aligned}A & =\\frac{1}{2}\\cdot AB\\cdot BC \\\\  & =\\frac{1}{2}\\cdot 6\\cdot 2\\sqrt{3} \\\\  & =6\\sqrt{3}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186345262 :knowledge-point/_questions [{:db/id #edb/ref 17592186087670 :knowledge-point/id #uuid "12ff17ae-9319-5498-a5e0-1d49ddbef50a" :knowledge-point/title "Using Alternative Forms of Double-Angle Formula to Simplify Expressions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4a0075a5-c212-5332-8254-ebacab091f7b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{cos}⁡{44}^{∘}" :db/id #edb/ref 17592186342847} {:answer/id #uuid "579bc87b-bc15-55d2-9b88-65df7df9f603" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\operatorname{sin}⁡{22}^{∘}\\operatorname{cos}⁡{22}^{∘}" :db/id #edb/ref 17592186342969} {:answer/id #uuid "83360fb2-68cd-5170-8292-0cf16f4cf726" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{cos}^{2}⁡{44}^{∘}" :db/id #edb/ref 17592186343361} {:answer/id #uuid "dd6b13d2-42b5-583d-8200-ed5b37808ec0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{sin}⁡{44}^{∘}" :db/id #edb/ref 17592186344182} {:answer/id #uuid "fb1a1f8b-f9f2-5fba-9b53-4159efa314f6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{sin}⁡{25}^{∘}\\operatorname{cos}⁡{25}^{∘}" :db/id #edb/ref 17592186344446}] :answer-field/correct {:answer/id #uuid "4a0075a5-c212-5332-8254-ebacab091f7b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{cos}⁡{44}^{∘}" :db/id #edb/ref 17592186342847} :answer-field/id #uuid "f6797f23-b08c-5f40-9334-1a28a80d78c8" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186344925}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "ec9090ba-bb1f-5578-9f23-889023ae580e" :question/math-academy-id "q-7692" :question/problem "Express $2{cos}^{2}⁡{22}^{∘}-1$ as a single trigonometric ratio." :question/worked-solution "First, let's recall the double-angle formula for cosine:\n\n$$\n2{cos}^{2}⁡x-1=\\operatorname{cos}⁡2x\n$$\n\nSubstituting $x={22}^{∘}$ into the above, we get\n\n$$\n\\begin{aligned}2{cos}^{2}⁡{22}^{∘}-1 & =\\operatorname{cos}⁡2\\cdot {22}^{∘} \\\\  & =\\operatorname{cos}⁡{44}^{∘}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186235582 :knowledge-point/_questions [{:db/id #edb/ref 17592186235285 :knowledge-point/id #uuid "58a49d00-cc58-5228-af38-9369cf31d8c8" :knowledge-point/title "Finding a Scalar Factor When Direction Reverses"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1ab5b44a-6f14-5d8c-b994-0ff723092bf6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186234586} {:answer/id #uuid "2b5b4c72-e340-52b5-be53-6903f63361a5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4.5" :db/id #edb/ref 17592186234611} {:answer/id #uuid "cbe36434-9519-583f-9b69-c587e4937715" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{3}" :db/id #edb/ref 17592186234866} {:answer/id #uuid "ce1ea7c1-61ca-56ba-a7d9-91573e3d6a5b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{3}" :db/id #edb/ref 17592186234869} {:answer/id #uuid "f46ca5b6-1fd3-597e-9657-e4197a5f9d69" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186234933}] :answer-field/correct {:answer/id #uuid "1ab5b44a-6f14-5d8c-b994-0ff723092bf6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186234586} :answer-field/id #uuid "1aa48e98-a238-5102-8717-85e261cb4e21" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186234997}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "adcdd06d-1586-51df-9df4-c005428c239d" :question/math-academy-id "q-77451" :question/problem "![](images/28/28faea3a553c505a8a5ab9bc7dd6e784dd23a47c336c70d31218fbe249d57cff.png)\n\nConsider the picture above. Given that $c=\\lambda a+3b,$ find $\\lambda .$" :question/worked-solution "To find $\\lambda ,$ we want to match the expression\n\n$$\nc=\\lambda a+3b.\n$$\n\nWe are given that one of the components is $3b.$ So, we first draw the vector $3b$ from the origin. Then we complete the path to the point $C.$\n\n![](images/52/52421034c2919620a0a9aae844db0eba2d396e5d6f1152d69bee40ff56c4d8ad.png)\n\nLet $P$ be the endpoint of the vector $3b.$ Then\n\n$$\nc=\\overset{\\to }{OP}+\\overset{\\to }{PC}.\n$$\n\nIn $△OPC,$ we have:\n\n- $PC=3|a|$\n\n- $\\overset{\\to }{PC}$ and $a$ have opposite directions\n\nHence, $\\overset{\\to }{PC}=-3a.$\n\nAdditionally,\n\n$$\n\\begin{aligned}c & =\\overset{\\to }{OP}+\\overset{\\to }{PC} \\\\  & =3b-3a.\\end{aligned}\n$$\n\nConsequently, $c=\\lambda a+3b=-3a+3b.$\n\nSince $a∦b,$ the linear combination can only be written in one way. Equating the coefficients of $a,$ we get:\n\n$$\n\\lambda =-3\n$$"}] [{:db/id #edb/ref 17592186345298 :knowledge-point/_questions [{:db/id #edb/ref 17592186059800 :knowledge-point/id #uuid "a827b0d0-faa2-521f-b166-e13873b1da00" :knowledge-point/title "Finding an Entry of the Product of Two Matrices"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4e87020f-a1a2-5550-b424-ca8a36fb5e47" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186342885} {:answer/id #uuid "4ec62960-9b9f-5dbe-91ab-850722f4e729" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "16" :db/id #edb/ref 17592186342887} {:answer/id #uuid "64180b08-3f71-59dd-90e0-90dea28ee95e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "20" :db/id #edb/ref 17592186343089} {:answer/id #uuid "91130e08-082e-5cb7-a2c7-4dd80867866a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-8" :db/id #edb/ref 17592186343507} {:answer/id #uuid "bc7761b5-0a6c-5936-8c5a-de0e4a27cf87" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "18" :db/id #edb/ref 17592186343895}] :answer-field/correct {:answer/id #uuid "4ec62960-9b9f-5dbe-91ab-850722f4e729" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "16" :db/id #edb/ref 17592186342887} :answer-field/id #uuid "a00a19b4-db54-5703-b836-7c731faeed36" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186344776}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "6eeac7ee-9286-57c4-a413-7511fe459e52" :question/math-academy-id "q-77461" :question/problem "If $P=QR$, where \n$Q=[\\begin{aligned}5 & -1 & 3 & -1 \\\\ 2 & 4 & 6 & 2 \\\\ 4 & -2 & 4 & -5 \\\\ 1 & 3 & 6 & -3\\end{aligned}]$\nand \n$R=[\\begin{aligned}1 & 3 & -2 & -1 \\\\ 0 & 7 & 6 & 4 \\\\ 2 & 4 & 3 & 2 \\\\ 5 & 2 & 2 & -4\\end{aligned}]$, then ${p}_{34}=$" :question/worked-solution "Multiplying the $3$rd row in $Q$ by the $4$th column in $R$, we get\n\n$$\n\\begin{aligned}{p}_{34} & =[\\begin{aligned}4 & -2 & 4 & -5\\end{aligned}][\\begin{aligned}-1 \\\\ 4 \\\\ 2 \\\\ -4\\end{aligned}] \\\\  & =4\\cdot (-1)+(-2)\\cdot 4+4\\cdot 2+(-5)\\cdot (-4) \\\\  & =-4-8+8+20 \\\\  & =16.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186345301 :knowledge-point/_questions [{:db/id #edb/ref 17592186100871 :knowledge-point/id #uuid "a0a4fa3d-fc1a-5e95-a632-f3a25c9bc4b1" :knowledge-point/title "Determining the Dimension of the Product of Two Matrices"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a7f860f4-816a-5393-ae9d-2ecb0c1f468c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The product is undefined" :db/id #edb/ref 17592186343716} {:answer/id #uuid "af921b50-e88f-5ebd-b3e2-dba22eb65847" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1\\times 3" :db/id #edb/ref 17592186343782} {:answer/id #uuid "bd8558fc-a4cc-539d-b781-9288c5ab8bdf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3\\times 1" :db/id #edb/ref 17592186343906} {:answer/id #uuid "c2bd3920-bd82-5ac0-9594-335890c16575" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3\\times 3" :db/id #edb/ref 17592186343952} {:answer/id #uuid "ec6ccab9-827b-5ef9-8d9f-1b7428deeac4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1\\times 1" :db/id #edb/ref 17592186344314}] :answer-field/correct {:answer/id #uuid "ec6ccab9-827b-5ef9-8d9f-1b7428deeac4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1\\times 1" :db/id #edb/ref 17592186344314} :answer-field/id #uuid "dae74c21-b257-59e4-b24c-655b2133233b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186344870}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "9e32d224-c2ec-5642-95ee-f28fd98abe68" :question/math-academy-id "q-77475" :question/problem "Let\n$Y=[\\begin{aligned}\\sqrt{2} & -1 & 0\\end{aligned}]$\nand\n$U=[\\begin{aligned}-4 \\\\ 0 \\\\ \\sqrt{3}\\end{aligned}].$\nWhat are the dimensions of $YU?$" :question/worked-solution "We notice that $Y$ is a $1\\times 3$ matrix and $U$ is a $3\\times 1$ matrix. \n\nThere are $3$ columns in $Y$ and $3$ rows in $U.$ Since the number of columns in $Y$ equals the number of rows in $U,$ the matrices $Y$ and $U$ are conformable for multiplication. \n\nThe product $YU$ has dimensions $1\\times 1:$\n\n$$\n{Y}_{1\\times \\boxed{\\text{3}}}{\\times }_{✓}{U}_{\\boxed{\\text{3}}\\times 1}={YU}_{1\\times 1}\n$$"}] [{:db/id #edb/ref 17592186403885 :knowledge-point/_questions [{:db/id #edb/ref 17592186100871 :knowledge-point/id #uuid "a0a4fa3d-fc1a-5e95-a632-f3a25c9bc4b1" :knowledge-point/title "Determining the Dimension of the Product of Two Matrices"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "60592584-71a9-5dab-888c-405420e985f4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The product is undefined" :db/id #edb/ref 17592186403887} {:answer/id #uuid "803bf64e-e7ce-576c-8d72-84fb237b0900" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1\\times 1" :db/id #edb/ref 17592186403888} {:answer/id #uuid "1d361957-5943-53dc-96fc-7cd9606514fe" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3\\times 1" :db/id #edb/ref 17592186403889} {:answer/id #uuid "458d1885-5503-53b8-ada5-bebd8ce461d0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3\\times 3" :db/id #edb/ref 17592186403890} {:answer/id #uuid "a526ff5b-3dc1-5b6f-891e-1cefb24bf872" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1\\times 3" :db/id #edb/ref 17592186403891}] :answer-field/correct {:answer/id #uuid "458d1885-5503-53b8-ada5-bebd8ce461d0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3\\times 3" :db/id #edb/ref 17592186403890} :answer-field/id #uuid "3bc81805-e6d6-540d-8f35-85fe2c75a075" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186403886}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "9bc6ac30-b2f0-52c3-a082-54b213e2ff6d" :question/math-academy-id "q-77476" :question/problem "Let\n$E=[\\begin{aligned}3 \\\\ -1 \\\\ \\frac{3}{2}\\end{aligned}]$\nand\n$R=[\\begin{aligned}-1 & \\sqrt{3} & 1\\end{aligned}].$\nWhat are the dimensions of $ER?$" :question/worked-solution "We notice that $E$ is a $3\\times 1$ matrix and $R$ is a $1\\times 3$ matrix. \n\nThere is $1$ column in $E$ and $1$ row in $R.$ Since the number of columns in $E$ equals the number of rows in $R,$ the matrices $E$ and $R$ are conformable for multiplication. \n\nThe product $ER$ has dimensions $3\\times 3:$\n\n$$\n{E}_{3\\times \\boxed{\\text{1}}}{\\times }_{✓}{R}_{\\boxed{\\text{1}}\\times 3}={ER}_{3\\times 3}\n$$"}] [{:db/id #edb/ref 17592186152771 :knowledge-point/_questions [{:db/id #edb/ref 17592186152179 :knowledge-point/id #uuid "f63580eb-b476-51fa-a005-560f6e57d911" :knowledge-point/title "Computing the Image of a Point Under a Linear Transformation of a Plane"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "09d7242e-e655-57f3-9f0c-134be9b01c96" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-2,1)" :db/id #edb/ref 17592186342320} {:answer/id #uuid "262de546-7e96-56a3-9dc6-d91fca267a9d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(2,1)" :db/id #edb/ref 17592186342562} {:answer/id #uuid "457fc1aa-44c3-5380-bb9f-44dd3c8421d0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(1,0)" :db/id #edb/ref 17592186342810} {:answer/id #uuid "85d16cf8-1929-5dca-9938-79dcf848d827" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(0,2)" :db/id #edb/ref 17592186343387} {:answer/id #uuid "9bf698f4-5ba3-5a99-bc10-8892ad7b9148" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-2,0)" :db/id #edb/ref 17592186343612}] :answer-field/correct {:answer/id #uuid "262de546-7e96-56a3-9dc6-d91fca267a9d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(2,1)" :db/id #edb/ref 17592186342562} :answer-field/id #uuid "abcb4a57-9e42-537d-8bd8-ae3f5f9fcc1e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186344795}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "dd69ce92-0c38-503f-b13d-fc02108de3ac" :question/math-academy-id "q-77543" :question/problem "Consider the linear transformation $T$ with matrix representation $T,$ given by\n\n$$\nT=[\\begin{aligned}-2 & 0 \\\\ 1 & 2\\end{aligned}].\n$$\n\nWhat are the coordinates of the point ${A}^{′}$, the image of $A(-1,1)$ under the action of $T?$" :question/worked-solution "To find the image of $A$ under the action of $T$, we first create a column-vector $x$ containing the coordinates of $A:$\n\n$$\nx=[\\begin{aligned}-1 \\\\ 1\\end{aligned}].\n$$\n\nNow, we compute the image of $x$ under the action of $T$ by calculating the matrix product $Tx:$\n\n$$\n\\begin{aligned}Tx & =[\\begin{aligned}-2 & 0 \\\\ 1 & 2\\end{aligned}][\\begin{aligned}-1 \\\\ 1\\end{aligned}] \\\\  & =[\\begin{aligned}2 \\\\ 1\\end{aligned}].\\end{aligned}\n$$\n\nThe result, $Tx,$ contains the coordinates of ${A}^{′}.$ Therefore, ${A}^{′}(2,1).$"}] [{:db/id #edb/ref 17592186393737 :knowledge-point/_questions [{:db/id #edb/ref 17592186115409 :knowledge-point/id #uuid "f7e817a0-edcf-54ca-ba4c-ffe91af04675" :knowledge-point/title "Finding a Height of a Triangle"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5975ee7c-248f-52aa-92e6-7307c035348b" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/38/389163fbb07fef4fc36fca5dce7cbe86cd4830d810b0210fe47c2b7cedd4b8c8.png" :db/id #edb/ref 17592186393739} {:answer/id #uuid "69276a71-4933-599e-b951-26b490c52cbe" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/3e/3e2b6cde516dc1737124576ffdc212331e3ad74f728f47aece5911ed04cf7f5a.png" :db/id #edb/ref 17592186393740} {:answer/id #uuid "df0291cf-6864-5a2c-a3de-e53242dc7ff8" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/77/7720d00d73ea3d4b4cf4905cf57ec12a3953caeb135272ec2d5283dad1479efe.png" :db/id #edb/ref 17592186393741} {:answer/id #uuid "5358c8ed-0c53-52b2-9dde-eca396e3f641" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/c1/c1ecb1d567916c708cc6bbbd394517835e86b4105ae045cf5ef9490b181900fa.png" :db/id #edb/ref 17592186393742} {:answer/id #uuid "3896dd03-da28-567c-b00f-2916b9f8afe3" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/5f/5f4e50dfc88fdb9109961e2cef0dc0b1f7968d7b588e2f944450ac2969075bd7.png" :db/id #edb/ref 17592186393743}] :answer-field/correct {:answer/id #uuid "5975ee7c-248f-52aa-92e6-7307c035348b" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/38/389163fbb07fef4fc36fca5dce7cbe86cd4830d810b0210fe47c2b7cedd4b8c8.png" :db/id #edb/ref 17592186393739} :answer-field/id #uuid "8715746d-70c4-5d7d-a61a-15d532009b48" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186393738}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "813db841-ac50-5fa6-a6b6-270cab223353" :question/math-academy-id "q-77606" :question/problem "![](images/35/3507450dd4d81fb14269ec651cc3f93ef52d615797ac3e6f4f779a0df98debe2.png)\n\nGiven the triangle $△ABC$ shown above, which of the following diagrams represents the altitude  corresponding to $\\overset{―}{AB}?$" :question/worked-solution "The height (or altitude)  corresponding to $\\overset{―}{AB}$ is a line segment that \n\n- runs from the opposite vertex $C$ to the line $\\overset{⟷}{AB},$ and\n\n- is perpendicular to $\\overset{⟷}{AB}.$\n\nThe correct diagram is shown below:\n\n![](images/38/389163fbb07fef4fc36fca5dce7cbe86cd4830d810b0210fe47c2b7cedd4b8c8.png)"}] [{:db/id #edb/ref 17592186152772 :knowledge-point/_questions [{:db/id #edb/ref 17592186152180 :knowledge-point/id #uuid "15e8730b-c59a-5897-8c83-073b54f517a9" :knowledge-point/title "Computing the Image of a Line Given by an Equation in Standard Form"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "22d1c6d6-f50a-5e3f-98fd-d298c4ddb5d0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2x-y+12=0" :db/id #edb/ref 17592186342527} {:answer/id #uuid "52c7145d-678c-565e-80a5-6f24ddad86df" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2x+y-3=0" :db/id #edb/ref 17592186342931} {:answer/id #uuid "84d25803-e711-5701-95a5-329911a92774" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2x+3y-6=0" :db/id #edb/ref 17592186343375} {:answer/id #uuid "c6b5d10c-de41-59c8-9b05-7690930244e2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3x-2y+12=0" :db/id #edb/ref 17592186343981} {:answer/id #uuid "f18baa84-ae58-59aa-8e13-bacd6d59f8d3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x+2y-3=0" :db/id #edb/ref 17592186344363}] :answer-field/correct {:answer/id #uuid "c6b5d10c-de41-59c8-9b05-7690930244e2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3x-2y+12=0" :db/id #edb/ref 17592186343981} :answer-field/id #uuid "1e6de43e-b508-5c28-8c68-d7a6f646a0b9" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186344544}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "e32e993e-cfb5-51a2-b706-960009cef89a" :question/math-academy-id "q-77653" :question/problem "Consider the line $2x+y-3=0$ and linear transformation $T$ with matrix representation $T,$ given by\n\n$$\nT=[\\begin{aligned}-2 & 0 \\\\ 1 & 2\\end{aligned}].\n$$\n\nWhat is the equation of the image of the line under the action of $T?$" :question/worked-solution "First, notice that the line $2x+y-3=0$ passes through the points $A(0,3)$ and $B(1,1)$ since the coordinates of both points satisfy the equation.\n\nTo find the image of $A$ and $B$ under the action of $T$, we first create a matrix $X$ containing the coordinates of the points:\n\n$$\nX=[\\begin{aligned}0 & 1 \\\\ 3 & 1\\end{aligned}].\n$$\n\nNow, we compute the image of $X$ under the action of $T$ by calculating the matrix product $TX:$\n\n$$\n\\begin{aligned}TX & =[\\begin{aligned}-2 & 0 \\\\ 1 & 2\\end{aligned}][\\begin{aligned}0 & 1 \\\\ 3 & 1\\end{aligned}] \\\\  & =[\\begin{aligned}0 & -2 \\\\ 6 & 3\\end{aligned}].\\end{aligned}\n$$\n\nTherefore, the coordinates of the respective image points are ${A}^{′}(0,6)$ and ${B}^{′}(-2,3).$\n\nFinally, we write the equation of the line that passes through ${A}^{′}$ and ${B}^{′}:$\n\n$$\n\\begin{aligned}y-{y}_{1} & =\\frac{{y}_{2}-{y}_{1}}{{x}_{2}-{x}_{1}}(x-{x}_{1}) \\\\ y-6 & =\\frac{3-6}{-2-0}(x-0) \\\\ y-6 & =\\frac{3}{2}x \\\\ 2y-12 & =3x \\\\ 3x-2y+12 & =0\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186393758 :knowledge-point/_questions [{:db/id #edb/ref 17592186087781 :knowledge-point/id #uuid "85936915-4c9c-572c-af99-025fec0f7570" :knowledge-point/title "Computing the Image of a Line Segment Under the Action of a Linear Transformation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b8b95b62-9eac-5c79-b618-0298e1652616" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/15/15134cfea5a58d0351be842c28d087a50591d60fb6a9f8ee36bcf4b35fb950ed.png" :db/id #edb/ref 17592186393760} {:answer/id #uuid "810f1d21-088a-52c7-8b34-c361d3749bb5" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/e0/e055c227957074b5b8bb321cbc43f9c0f2796f7f7040616fe291098e9fd2dfb0.png" :db/id #edb/ref 17592186393761} {:answer/id #uuid "c597b2fb-5e49-5cfd-96c5-71b7925a4a9e" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/d6/d6e72adfafe111e75253f355d80d7d27c1a89bd2483c0db5618bee62c79f87ad.png" :db/id #edb/ref 17592186393762} {:answer/id #uuid "988f9b48-24b5-5ff5-8b0b-4a4252631376" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/19/19dc7b72e149547ff51758dadf84f94be080a68227239e07239ce0659ade5a5a.png" :db/id #edb/ref 17592186393763} {:answer/id #uuid "2ecd37a8-72a0-57e0-80f3-347934775efa" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/17/177ca7f40ef24cf2f45a15b78487700d1f0efd094c975079cf4704b46debefb1.png" :db/id #edb/ref 17592186393764}] :answer-field/correct {:answer/id #uuid "2ecd37a8-72a0-57e0-80f3-347934775efa" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/17/177ca7f40ef24cf2f45a15b78487700d1f0efd094c975079cf4704b46debefb1.png" :db/id #edb/ref 17592186393764} :answer-field/id #uuid "34779380-003f-5fa8-8d6a-ad93873e4a0e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186393759}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "f9161e73-0db0-599d-b045-fa10e5d3039c" :question/math-academy-id "q-77717" :question/problem "![](images/fc/fc7bebddc280debd4bde32393cabfa4a6a91a782d38e5406f374cc4eaa4ac68f.png)\n\nConsider the linear transformation $T$ with matrix representation $T,$ given by\n\n$$\nT=[\\begin{aligned}2 & -1 \\\\ 4 & 1\\end{aligned}].\n$$\n\nThe line segment $\\overset{―}{AB}$ is shown above. Which of the following is $\\overset{―}{{A}^{′}{B}^{′}},$ the image of $\\overset{―}{AB}$ under the action of $T?$" :question/worked-solution "To find the image of $\\overset{―}{AB}$ under the action of $T$, we first create a matrix $X$ containing the coordinates of the endpoints of $\\overset{―}{AB}:$\n\n$$\nX=[\\begin{aligned}2 & -2 \\\\ -1 & 5\\end{aligned}]\n$$\n\nNow, we compute the image of $X$ under the action of $T$ by calculating the matrix product $TX:$\n\n$$\n\\begin{aligned}TX & =[\\begin{aligned}2 & -1 \\\\ 4 & 1\\end{aligned}][\\begin{aligned}2 & -2 \\\\ -1 & 5\\end{aligned}] \\\\  & =[\\begin{aligned}5 & -9 \\\\ 7 & -3\\end{aligned}].\\end{aligned}\n$$\n\nTherefore, the coordinates of the respective endpoints of the image are ${A}^{′}(5,7)$ and ${B}^{′}(-9,-3),$ as shown below.\n\n![](images/17/177ca7f40ef24cf2f45a15b78487700d1f0efd094c975079cf4704b46debefb1.png)"}] [{:db/id #edb/ref 17592186345326 :knowledge-point/_questions [{:db/id #edb/ref 17592186152181 :knowledge-point/id #uuid "0c8f0fa1-a86a-577f-bdc9-fc7427faa18d" :knowledge-point/title "Computing the Image of a Line Given by an Equation in Slope-Intercept Form"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "29391770-0702-5a1d-8fe2-5650ed41436a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "12x+y+5=0" :db/id #edb/ref 17592186342585} {:answer/id #uuid "91dd3cad-c4e6-570b-92c7-8aa8196ddc24" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2x+y-15=0" :db/id #edb/ref 17592186343515} {:answer/id #uuid "94668d56-ed4e-5a53-9a3c-9ce0b4f02036" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2x+y+5=0" :db/id #edb/ref 17592186343534} {:answer/id #uuid "d5ad800b-e987-5854-8203-31879b8e1f2d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "13x+2y+30=0" :db/id #edb/ref 17592186344109} {:answer/id #uuid "f0baaadf-b29e-5ea2-800a-2a7ae6515e6c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4x-y-5=0" :db/id #edb/ref 17592186344352}] :answer-field/correct {:answer/id #uuid "d5ad800b-e987-5854-8203-31879b8e1f2d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "13x+2y+30=0" :db/id #edb/ref 17592186344109} :answer-field/id #uuid "02b72e69-323d-5616-8ed6-1ec52f7f4aa3" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186344499}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "73ad6a2e-aaec-5622-8188-773351aa5d67" :question/math-academy-id "q-77770" :question/problem "Consider the line $y=4x+5$ and linear transformation $T$ with matrix representation $T,$ given by\n\n$$\nT=[\\begin{aligned}2 & 0 \\\\ -1 & -3\\end{aligned}].\n$$\n\nWhat is the equation of the image of the line under the action of $T?$" :question/worked-solution "First, notice that the line $y=4x+5$ passes through the points $G(0,5)$ and $H(1,9)$ since the coordinates of both points satisfy the equation.\n\nTo find the image of $G$ and $H$ under the action of $T$, we first create a matrix $X$ containing the coordinates of the points:\n\n$$\nX=[\\begin{aligned}0 & 1 \\\\ 5 & 9\\end{aligned}].\n$$\n\nNow, we compute the image of $X$ under the action of $T$ by calculating the matrix product $TX:$\n\n$$\n\\begin{aligned}TX & =[\\begin{aligned}2 & 0 \\\\ -1 & -3\\end{aligned}][\\begin{aligned}0 & 1 \\\\ 5 & 9\\end{aligned}] \\\\  & =[\\begin{aligned}0 & 2 \\\\ -15 & -28\\end{aligned}].\\end{aligned}\n$$\n\nTherefore, the coordinates of the respective image points are ${G}^{′}(0,-15)$ and ${H}^{′}(2,-28).$\n\nFinally, we write the equation of the line that passes through ${G}^{′}$ and ${H}^{′}:$\n\n$$\n\\begin{aligned}y-{y}_{1} & =\\frac{{y}_{2}-{y}_{1}}{{x}_{2}-{x}_{1}}(x-{x}_{1}) \\\\ y-(-15) & =\\frac{-28-(-15)}{2-0}(x-0) \\\\ y+15 & =-\\frac{13}{2}x \\\\ 2y+30 & =-13x \\\\ 13x+2y+30 & =0\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186345333 :knowledge-point/_questions [{:db/id #edb/ref 17592186115183 :knowledge-point/id #uuid "65e15de1-ee72-55ea-accb-1124f3a0ac0c" :knowledge-point/title "Solving Trigonometric Equations Involving Cosecant Under a Modified Domain"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "05ae6a06-4330-54ef-9433-c5c677530ff1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{6\\pi }{5}" :db/id #edb/ref 17592186342293} {:answer/id #uuid "1d848a19-5850-569d-891e-af12d31cce5c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5{\\pi }^{2}}{16}" :db/id #edb/ref 17592186342484} {:answer/id #uuid "5735c8bc-a5bf-5456-8e38-dd27a7af277f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5{\\pi }^{2}}{6}" :db/id #edb/ref 17592186342964} {:answer/id #uuid "765b12b0-0b4e-5056-b17d-e6c391b48100" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5{\\pi }^{2}}{36}" :db/id #edb/ref 17592186343263} {:answer/id #uuid "9ef93109-94c1-5adc-8254-1c56bb5d8e94" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{6{\\pi }^{2}}{25}" :db/id #edb/ref 17592186343642}] :answer-field/correct {:answer/id #uuid "765b12b0-0b4e-5056-b17d-e6c391b48100" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5{\\pi }^{2}}{36}" :db/id #edb/ref 17592186343263} :answer-field/id #uuid "e6b87d1f-4463-5d15-83fa-d1424a0990e9" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186344895}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "eedaeea2-0b11-5fde-945c-2d7775198c4f" :question/math-academy-id "q-77789" :question/problem "Given that ${x}_{1}$ and ${x}_{2}$ are the solutions to the equation $\\operatorname{csc}⁡x=2$ for $-\\pi \\le x<\\pi ,$ what is the value of ${x}_{1}\\cdot {x}_{2}?$" :question/worked-solution "Recall that $\\operatorname{csc}⁡x=\\frac{1}{\\operatorname{sin}⁡x},$ therefore the given equation is equivalent to\n\n$$\n\\operatorname{sin}⁡x=\\frac{1}{2}.\n$$\n\nFirst, we have to find the principal value:\n\n$$\nx=\\operatorname{arcsin}⁡(\\frac{1}{2})=\\frac{\\pi }{6}.\n$$\n\nSince $\\frac{\\pi }{6}$ lies in the required domain, the first solution is ${x}_{1}=\\frac{\\pi }{6}.$\n\nOur first solution lies in the first quadrant and has a reference angle of ${\\theta }_{R}=\\frac{\\pi }{6}.$ Since $\\operatorname{sin}⁡x>0,$ the second solution must lie in the second quadrant, and it also has a reference angle ${\\theta }_{R}=\\frac{\\pi }{6}.$\n\n![](images/00/00d540b1f6412e4af2617452fbf0c58750d01e844d89d0d92cfacc0cb3e45e32.png)\n\nSince the second solution lies in the $2$nd quadrant, we can find it using the reference angle as follows:\n\n$$\n\\begin{aligned}{x}_{2} & =\\pi -{\\theta }_{R} \\\\  & =\\pi -\\frac{\\pi }{6} \\\\  & =\\frac{5\\pi }{6}\\end{aligned}\n$$\n\nTherefore, the solutions are $x=\\frac{\\pi }{6},\\frac{5\\pi }{6}.$\n\nFinally,\n\n$$\n\\frac{\\pi }{6}\\cdot \\frac{5\\pi }{6}=\\frac{5{\\pi }^{2}}{36}.\n$$"}] [{:db/id #edb/ref 17592186403912 :knowledge-point/_questions [{:db/id #edb/ref 17592186115222 :knowledge-point/id #uuid "80449399-3ae4-593f-8c3b-00bcdcc99727" :knowledge-point/title "Solving Trigonometric Equations Outside of the Range of Cosecant"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "58b18f41-8509-5c31-9dbb-9635295349d1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186403914} {:answer/id #uuid "598059e1-b2c7-54a4-9599-dbc6ec848611" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186403915} {:answer/id #uuid "83dd2cd4-2c4f-5617-94a2-2588cf41d996" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186403916} {:answer/id #uuid "741e7a8c-e9c9-55f2-9de3-94dad329bc8f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186403917} {:answer/id #uuid "130edb2f-0da8-5b81-8084-7e13495a2347" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186403918}] :answer-field/correct {:answer/id #uuid "130edb2f-0da8-5b81-8084-7e13495a2347" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186403918} :answer-field/id #uuid "b9adcf33-4ed6-541b-84fe-bae806183eb9" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186403913}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "97b65183-2af9-5046-876f-bba35987095c" :question/math-academy-id "q-77812" :question/problem "Which of the following equations has no solutions for $0\\le x<2\\pi ?$\n\nI. $\\operatorname{csc}⁡x+30=4\\operatorname{csc}⁡x$\nII. $5\\operatorname{csc}⁡x-1=2\\operatorname{csc}⁡x$\nIII. $\\operatorname{csc}⁡x=4\\operatorname{csc}⁡x-12$" :question/worked-solution "We first simplify the given equations, and get\n\n- $\\operatorname{csc}⁡x=10$\n- $\\operatorname{csc}⁡x=\\frac{1}{3}$\n- $\\operatorname{csc}⁡x=4$\n\nNow, recall that the range of $\\operatorname{csc}⁡x$ for $0\\le x<2\\pi $ is given by\n\n$$\n\\operatorname{csc}⁡x\\in (-\\infty ,-1]\\cup [1,\\infty ).\n$$\n\nSo, the equation $\\operatorname{csc}⁡x=k$ has no solutions for $k\\in (-1,1).$ \n\nTherefore, of the given equations, only equation II has no solutions."}] [{:db/id #edb/ref 17592186348055 :knowledge-point/_questions [{:db/id #edb/ref 17592186124662 :knowledge-point/id #uuid "020c3de3-bcaf-5ade-ba50-2f15e344157d" :knowledge-point/title "Evaluating a Limit at Infinity: Infinite Solutions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1a650abf-0d4a-58c9-91b9-30b7534b712f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186345583} {:answer/id #uuid "574c7aab-33d5-5705-a697-cbf07661dbf6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186346096} {:answer/id #uuid "66823d29-b84e-5f34-b53f-99b46b672528" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\infty " :db/id #edb/ref 17592186346249} {:answer/id #uuid "8f5f09bb-385f-5d57-b965-3d96a703c837" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186346596} {:answer/id #uuid "fd42716c-1a07-5b37-9871-bc437b2b3acb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\infty " :db/id #edb/ref 17592186347577}] :answer-field/correct {:answer/id #uuid "66823d29-b84e-5f34-b53f-99b46b672528" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\infty " :db/id #edb/ref 17592186346249} :answer-field/id #uuid "2c83bb76-8bd4-58e4-8174-3e8332186d58" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186347677}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "870f96d2-308d-527a-b806-56f8da4cc5de" :question/math-academy-id "q-78008" :question/problem "Calculate ${lim}_{x\\to -\\infty }\\,\\,\\frac{{x}^{3}+1}{2{x}^{2}+x}.$" :question/worked-solution "First, we divide both the numerator and the denominator by the highest power of $x$ in the denominator, which is ${x}^{2}.$ Then, by noting that the reciprocals shrink to $0$ in the limit, we can then evaluate the resulting expression.\n\n$$\n\\begin{aligned}{lim}_{x\\to -\\infty }\\,\\,\\frac{{x}^{3}+1}{2{x}^{2}+x} & ={lim}_{x\\to \\infty }\\,\\,\\frac{(\\frac{{x}^{3}}{{x}^{2}}+\\frac{1}{{x}^{2}})}{(\\frac{2{x}^{2}}{{x}^{2}}+\\frac{x}{{x}^{2}})} \\\\  & ={lim}_{x\\to -\\infty }\\,\\,\\frac{(x+\\frac{1}{{x}^{2}})}{(2+\\frac{1}{x})} \\\\  & ={lim}_{x\\to -\\infty }\\,\\,\\frac{(x+0)}{(2+0)} \\\\  & ={lim}_{x\\to -\\infty }\\,\\,\\frac{x}{2} \\\\  & =-\\infty .\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186348058 :knowledge-point/_questions [{:db/id #edb/ref 17592186078617 :knowledge-point/id #uuid "433ac237-32ff-591c-ab0d-e271f5beda30" :knowledge-point/title "Comparing a Polynomial Function and a Logarithmic Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "230e9980-3014-585c-9824-8ffbbfb87fa8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{4}" :db/id #edb/ref 17592186345666} {:answer/id #uuid "3e78aac2-9ed2-5d03-9615-aa9681a9b9cb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186345880} {:answer/id #uuid "605c3464-b0e3-5a0e-a579-17927c816f44" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{49}{8}" :db/id #edb/ref 17592186346184} {:answer/id #uuid "751d486d-e98c-52f2-a915-5c8e43475be7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186346383} {:answer/id #uuid "9969aa67-c3be-572e-b65c-16dbe705668e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\infty " :db/id #edb/ref 17592186346688}] :answer-field/correct {:answer/id #uuid "9969aa67-c3be-572e-b65c-16dbe705668e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\infty " :db/id #edb/ref 17592186346688} :answer-field/id #uuid "a15c11dd-a9fe-541b-9b8c-8e47ce3d3968" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186347888}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "3ed8e03b-15f7-5013-88f1-415c20c3fa96" :question/math-academy-id "q-78026" :question/problem "${lim}_{x\\to \\infty }(\\frac{{x}^{5}}{\\operatorname{ln}⁡(8x)}+6)=$" :question/worked-solution "Both the numerator and denominator approach $\\infty $ as $x\\to \\infty .$ However, since ${x}^{5}≫\\operatorname{ln}⁡(8x)$ for large values of $x,$ the numerator is growing much faster than the denominator. Consequently, we conclude that\n\n$$\n{lim}_{x\\to \\infty }\\frac{{x}^{5}}{\\operatorname{ln}⁡(8x)}=\\infty \n$$\n\nTherefore,\n\n$$\n{lim}_{x\\to \\infty }(\\frac{{x}^{5}}{\\operatorname{ln}⁡(8x)}+6)=\\infty \n$$"}] [{:db/id #edb/ref 17592186348060 :knowledge-point/_questions [{:db/id #edb/ref 17592186078618 :knowledge-point/id #uuid "c538b0a9-a084-5a83-a5fa-eca4e0270a93" :knowledge-point/title "Comparing an Exponential Function and a Logarithmic Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "08f4dadb-28d5-582a-b2ed-8ed6faec0d17" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{\\operatorname{ln}⁡6}" :db/id #edb/ref 17592186345421} {:answer/id #uuid "0d8dfa95-d908-5058-8424-56e86a5e56fa" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{e}{\\operatorname{ln}⁡6}" :db/id #edb/ref 17592186345459} {:answer/id #uuid "1064f00d-bc7f-5c7a-b35a-043241be2aef" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186345491} {:answer/id #uuid "89f10bff-844a-5272-bf2d-066f640d14c0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{e}^{2}}{\\operatorname{ln}⁡6}" :db/id #edb/ref 17592186346550} {:answer/id #uuid "dd3cacc9-07ac-5e10-a702-e49578e0954d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\infty " :db/id #edb/ref 17592186347292}] :answer-field/correct {:answer/id #uuid "dd3cacc9-07ac-5e10-a702-e49578e0954d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\infty " :db/id #edb/ref 17592186347292} :answer-field/id #uuid "5ea8fd09-6e18-5c7d-9352-b57872f05fa2" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186347771}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "7c3a8a5e-9f27-59d8-ab5a-abb566b24c3e" :question/math-academy-id "q-78030" :question/problem "Evaluate ${lim}_{x\\to \\infty }\\frac{{e}^{2x}}{\\operatorname{ln}⁡(6x)}.$" :question/worked-solution "Both the numerator and denominator approach $\\infty $ as $x\\to \\infty .$ However, since ${e}^{2x}≫\\operatorname{ln}⁡(6x)$ for large values of $x,$ the numerator is growing much faster than the denominator. Consequently, we conclude that\n\n$$\n{lim}_{x\\to \\infty }\\frac{{e}^{2x}}{\\operatorname{ln}⁡(6x)}=\\infty .\n$$"}] [{:db/id #edb/ref 17592186348063 :knowledge-poin