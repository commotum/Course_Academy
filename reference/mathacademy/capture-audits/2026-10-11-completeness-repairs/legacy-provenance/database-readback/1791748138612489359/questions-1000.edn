#{[{:db/id #edb/ref 17592186332858 :knowledge-point/_questions [{:db/id #edb/ref 17592186096627 :knowledge-point/id #uuid "5c6490a5-4923-58e8-99c3-d568a033800e" :knowledge-point/title "Computing Coefficients in a Partial Fractions Decomposition"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7f9bea82-b38e-5841-aebd-2d90d435d3f9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186331076} {:answer/id #uuid "a9cb0473-c108-5e1b-b9ef-fce32f58728a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186331456} {:answer/id #uuid "bff3872b-4b7d-5892-a9cb-b5f660bb2a14" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{5}{2}" :db/id #edb/ref 17592186331653} {:answer/id #uuid "df921d04-bc75-5a22-96f2-73388b9d0ad8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186331924} {:answer/id #uuid "f34074ee-e62c-5996-abbf-063c96890ed1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{5}{4}" :db/id #edb/ref 17592186332092}] :answer-field/correct {:answer/id #uuid "7f9bea82-b38e-5841-aebd-2d90d435d3f9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186331076} :answer-field/id #uuid "2cb3f2db-52ae-5ed2-9744-e38318f3fb12" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186332273}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "8bf4d6fe-76cd-565c-9382-083cab13afc5" :question/math-academy-id "q-51145" :question/problem "Given that \n\n$$\n\\frac{4{x}^{2}-3x+5}{({x}^{2}+2)(x-1)}=\\frac{2x+B}{{x}^{2}+2}+\\frac{2}{x-1},\n$$\n\nwhat is the value of $B?$" :question/worked-solution "Multiplying both sides of the given equality by $({x}^{2}+2)(x-1)$ gives\n\n$$\n\\begin{aligned}4{x}^{2}-3x+5 & =(2x+B)(x-1)+2({x}^{2}+2).\\end{aligned}\n$$\n\nLetting $x=0$ gives\n\n$$\n\\begin{aligned}4(0)^{2}-3(0)+5 & =(2(0)+B)(0-1)+2({0}^{2}+2) \\\\ 5 & =(B)(-1)+2(2) \\\\ 5 & =-B+4 \\\\ 1 & =-B \\\\ B & =-1.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186129813 :knowledge-point/_questions [{:db/id #edb/ref 17592186129116 :knowledge-point/id #uuid "a247a205-ca5c-5079-820c-cfa34b6f53db" :knowledge-point/title "Translating Problems With Constant Rates of Change Into Differential Equations"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0ff3695f-4968-57f8-af00-a415f06e0483" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\text{d}P}{\\text{d}t}=100" :db/id #edb/ref 17592186330085} {:answer/id #uuid "13b81038-d872-5ca5-992a-2dd223a7ad16" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\text{d}P}{\\text{d}t}=100+P" :db/id #edb/ref 17592186330113} {:answer/id #uuid "1e971fa7-f202-5ff0-bb2c-8759fc4463dc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\text{d}P}{\\text{d}t}=100k,\\,k>0" :db/id #edb/ref 17592186330213} {:answer/id #uuid "5d2532e1-0f49-5d4a-80a7-8c06f2dc48ea" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\text{d}P}{\\text{d}t}={e}^{100}" :db/id #edb/ref 17592186330780} {:answer/id #uuid "9598e48f-e958-5852-a95c-d70fae680128" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\text{d}P}{\\text{d}t}=100P" :db/id #edb/ref 17592186331277}] :answer-field/correct {:answer/id #uuid "0ff3695f-4968-57f8-af00-a415f06e0483" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\text{d}P}{\\text{d}t}=100" :db/id #edb/ref 17592186330085} :answer-field/id #uuid "2bb8e76e-8612-579b-862b-b2c6caf17420" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186332269}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "1cbb7150-61e1-50bf-8ac9-84dfe58c7fcf" :question/math-academy-id "q-51251" :question/problem "The population of pines in a forest increases by $100$ trees every year. What differential equation describes the rate of change of the population $P(t)$ of the pines? Assume that the time $t$ is measured in years." :question/worked-solution "If the pines population is $P,$ then the rate of change of the population is $\\frac{\\text{d}P}{\\text{d}t},$ where $t$ is the time in years.\n\nSince $100$ new pines are added every year, the rate of change of the population of the pines is given by the differential equation\n\n$$\n\\frac{\\text{d}P}{\\text{d}t}=100.\n$$"}] [{:db/id #edb/ref 17592186332866 :knowledge-point/_questions [{:db/id #edb/ref 17592186129119 :knowledge-point/id #uuid "255dee12-5f44-536b-b679-5a894843395d" :knowledge-point/title "Translating Problems With Proportional Rates of Change Into Differential Equations"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6840470a-70d6-5804-b3cb-88a0c12a3127" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\text{d}B}{\\text{d}t}=B" :db/id #edb/ref 17592186330888} {:answer/id #uuid "82a09dc0-8938-5a2b-a4e6-81bcb7a21ef3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\text{d}B}{\\text{d}t}=\\frac{k}{B},\\,\\,k>0" :db/id #edb/ref 17592186331103} {:answer/id #uuid "96163e8d-e6e8-5255-883a-60386894bfe1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\text{d}B}{\\text{d}t}=-\\frac{k}{B},\\,\\,k>0" :db/id #edb/ref 17592186331281} {:answer/id #uuid "d5ddb1da-5410-5e3b-a981-46b37e811d4d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\text{d}B}{\\text{d}t}=-kB,\\,\\,k>0" :db/id #edb/ref 17592186331844} {:answer/id #uuid "e932b754-ebb2-556a-a8f7-1616e5abef31" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\text{d}B}{\\text{d}t}=k-\\frac{1}{B},\\,\\,k>0" :db/id #edb/ref 17592186331999}] :answer-field/correct {:answer/id #uuid "d5ddb1da-5410-5e3b-a981-46b37e811d4d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\text{d}B}{\\text{d}t}=-kB,\\,\\,k>0" :db/id #edb/ref 17592186331844} :answer-field/id #uuid "5b3c1d96-319e-5645-a139-8d6ce71b1306" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186332378}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "463aab95-898d-5e27-959a-1acad2e1639f" :question/math-academy-id "q-51254" :question/problem "The number of bacteria in a particular crop at any given moment decreases at a rate that is proportional to the number of bacteria at that moment.\nWhat differential equation describes the rate of change of the number of bacteria $B$ at time $t?$" :question/worked-solution "Let's highlight the important words in the given statement:\n\n*The **number of bacteria** in a particular crop at any given moment **decreases** at a **rate** that is **proportional** to **the number of bacteria** at that moment..* \n\nWe note the following:\n\n- The question describes the *rate* at which the *number of bacteria* in a particular crop varies. Therefore, this is a statement about the quantity \n\n$$\n\\frac{\\text{d}B}{\\text{d}t}.\n$$\n\n- We're told that $\\frac{\\text{d}B}{\\text{d}t}$ is *proportional to* the *number of bacteria* at the moment. In other words,\n\n$$\n\\frac{\\text{d}B}{\\text{d}t}∝B.\n$$\n\nRecall that $∝$ means \"is proportional to.\"\n\n- Finally, we want to replace the proportionality symbol with an equality symbol. Let $k$ be a positive constant. Since the number of bacteria *decreases* with time, our derivative should be *negative*. Therefore, we can rewrite our proportionality statement as\n\n$$\n\\frac{\\text{d}B}{\\text{d}t}=-kB.\n$$"}] [{:db/id #edb/ref 17592186332869 :knowledge-point/_questions [{:db/id #edb/ref 17592186092265 :knowledge-point/id #uuid "a9102c1c-1c38-58dd-9932-b04bd24a6846" :knowledge-point/title "Differentiating a General Logarithm Function Using the Chain Rule"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1040edda-0303-5346-ac49-2025a711486e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{(1-x)ln⁡(10)}" :db/id #edb/ref 17592186330092} {:answer/id #uuid "1b3385ec-93b4-59c7-a196-58be5d17d757" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{10}{(1-x)}" :db/id #edb/ref 17592186330189} {:answer/id #uuid "430a86b3-46fa-5177-b8b1-9abf9afaa40a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{(1-x)}" :db/id #edb/ref 17592186330550} {:answer/id #uuid "6e2c3511-369b-5b02-8467-198f1bcf8279" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(1-x)ln⁡(10)" :db/id #edb/ref 17592186330941} {:answer/id #uuid "afdc0472-7689-57f5-b5c2-148cb66217a8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{ln⁡(10)}{(1-x)}" :db/id #edb/ref 17592186331507}] :answer-field/correct {:answer/id #uuid "1040edda-0303-5346-ac49-2025a711486e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{(1-x)ln⁡(10)}" :db/id #edb/ref 17592186330092} :answer-field/id #uuid "85a34950-0b5d-5d67-b7f8-2bcede974234" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186332436}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "0c643137-d804-5b6f-93e8-568de57f1d93" :question/math-academy-id "q-51317" :question/problem "Find ${y}^{′}$ for $y=log⁡(1-x).$" :question/worked-solution "First, we express $y$ as the composite function\n\n$$\ny=log⁡u={log}_{10}⁡(u),\\,u=1-x.\n$$\n\nDifferentiating gives\n\n$$\n\\frac{\\text{d}y}{\\text{d}u}=\\frac{1}{uln⁡(10)},\\,\\frac{\\text{d}u}{\\text{d}x}=-1.\n$$\n\nWe now apply the chain rule, and get\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}y}{\\text{d}u}\\cdot \\frac{\\text{d}u}{\\text{d}x} \\\\  & =\\frac{1}{uln⁡(10)}\\cdot (-1) \\\\  & =\\frac{1}{(1-x)ln⁡(10)}\\cdot (-1) \\\\  & =-\\frac{1}{(1-x)ln⁡(10)}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186332873 :knowledge-point/_questions [{:db/id #edb/ref 17592186119978 :knowledge-point/id #uuid "8c0b7d95-c699-5762-aa44-449712f035c7" :knowledge-point/title "Calculating the Derivative of the Inverse of a Polynomial Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4b727927-159a-5fe5-a64a-6115a05702ab" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{9}{5-10{h}^{-1}(x)}" :db/id #edb/ref 17592186330633} {:answer/id #uuid "626b77f3-44ba-50fa-9b4f-747cba46c5bf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-10" :db/id #edb/ref 17592186330833} {:answer/id #uuid "abef283a-96fd-5d43-9839-c721e873e525" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{10}" :db/id #edb/ref 17592186331477} {:answer/id #uuid "de31ec1c-d18c-57c3-889f-c9f961627921" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "10{h}^{-1}(x)" :db/id #edb/ref 17592186331914} {:answer/id #uuid "eb34821c-31b6-535d-a27a-3ffd7caa245d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{10{h}^{-1}(x)}" :db/id #edb/ref 17592186332013}] :answer-field/correct {:answer/id #uuid "abef283a-96fd-5d43-9839-c721e873e525" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{10}" :db/id #edb/ref 17592186331477} :answer-field/id #uuid "fbb88348-b18d-5779-8ef2-642d021be174" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186332644}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "19c0268a-8fa3-5a09-89dc-e326b80c48a0" :question/math-academy-id "q-51346" :question/problem "If $h(x)=5-10x,$ find ${({h}^{-1})}^{′}(x)$ as a function of ${h}^{-1}(x).$" :question/worked-solution "**Step 1:** First, we write the inverse function implicitly. The given function is $y=5-10x,$ and to write the inverse function implicitly, we swap $x$ and $y$ as follows:\n\n$$\nx=5-10y\n$$\n\nNote that in the equation above, we have $y={h}^{-1}(x).$\n\n**Step 2:** Next, we differentiate. The overall goal is to find $\\frac{\\text{d}y}{\\text{d}x},$ but the equation is already solved for $x,$ so we compute $\\frac{\\text{d}x}{\\text{d}y}$ and then take the reciprocal:\n\n$$\n\\begin{aligned}\\frac{\\text{d}x}{\\text{d}y} & =\\frac{\\text{d}}{\\text{d}y}(5-10y) \\\\ \\frac{\\text{d}x}{\\text{d}y} & =-10 \\\\ \\frac{\\text{d}y}{\\text{d}x} & =-\\frac{1}{10}\\end{aligned}\n$$\n\n**Step 3:** Lastly, we write the result in terms of ${h}^{-1}(x).$ Since $y={h}^{-1}(x),$ we have\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}[{h}^{-1}(x)] & =-\\frac{1}{10} \\\\ {({h}^{-1})}^{′}(x) & =-\\frac{1}{10}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186332874 :knowledge-point/_questions [{:db/id #edb/ref 17592186119979 :knowledge-point/id #uuid "0196af83-9ef6-5bab-9f50-0aacf488f0cc" :knowledge-point/title "Calculating the Derivative of the Inverse of a Composite Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "36a5829f-8fb5-5220-9a62-df953efe17f6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\sqrt{2{h}^{-1}(x)+5}" :db/id #edb/ref 17592186330440} {:answer/id #uuid "a8361423-3584-5605-8b3e-75e7c63bf9a9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{2{h}^{-1}(x)+5}" :db/id #edb/ref 17592186331447} {:answer/id #uuid "aaffd22a-c17e-5b44-b412-6c5bb1e52839" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{2{h}^{-1}(x)+5}}{4}" :db/id #edb/ref 17592186331465} {:answer/id #uuid "d7ae6d38-d6c6-5d1c-8616-d987f049ea55" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4\\sqrt{2{h}^{-1}(x)+5}" :db/id #edb/ref 17592186331860} {:answer/id #uuid "fea2d729-c658-5748-9e5e-6ab0aa1ad612" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{4}{\\sqrt{2{h}^{-1}(x)+5}}" :db/id #edb/ref 17592186332193}] :answer-field/correct {:answer/id #uuid "a8361423-3584-5605-8b3e-75e7c63bf9a9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{2{h}^{-1}(x)+5}" :db/id #edb/ref 17592186331447} :answer-field/id #uuid "0a22b11e-c1fe-5207-abdd-06c9964565db" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186332209}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "cf33d691-a1fd-5629-a53c-c90ffc853605" :question/math-academy-id "q-51347" :question/problem "If $h(x)=\\sqrt{2x+5},$ find ${({h}^{-1})}^{′}(x)$ as a function of ${h}^{-1}(x).$" :question/worked-solution "**Step 1:** First, we write the inverse function implicitly. The given function is $y=\\sqrt{2x+5},$ and to write the inverse function implicitly, we swap $x$ and $y$ as follows:\n\n$$\nx=\\sqrt{2y+5}\n$$\n\nNote that in the equation above, we have $y={h}^{-1}(x).$\n\n**Step 2:** Next, we differentiate. The overall goal is to find $\\frac{\\text{d}y}{\\text{d}x},$ but the equation is already solved for $x,$ so we compute $\\frac{\\text{d}x}{\\text{d}y}$ and then take the reciprocal:\n\n$$\n\\begin{aligned}\\frac{\\text{d}x}{\\text{d}y} & =\\frac{\\text{d}}{\\text{d}y}(\\sqrt{2y+5}) \\\\ \\frac{\\text{d}x}{\\text{d}y} & =\\frac{\\text{d}}{\\text{d}y}((2y+5)^{1/2}) \\\\ \\frac{\\text{d}x}{\\text{d}y} & =\\frac{1}{2}(2y+5)^{-1/2}\\cdot 2 \\\\ \\frac{\\text{d}x}{\\text{d}y} & =\\frac{1}{\\sqrt{2y+5}} \\\\ \\frac{\\text{d}y}{\\text{d}x} & =\\sqrt{2y+5}\\end{aligned}\n$$\n\n**Step 3:** Lastly, we write the result in terms of ${h}^{-1}(x).$ Since $y={h}^{-1}(x),$ we have\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}[{h}^{-1}(x)] & =\\sqrt{2{h}^{-1}(x)+5} \\\\ {({h}^{-1})}^{′}(x) & =\\sqrt{2{h}^{-1}(x)+5}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186079061 :knowledge-point/_questions [{:db/id #edb/ref 17592186078390 :knowledge-point/id #uuid "697f9bd8-9edf-5643-8cdb-a821b6dce09c" :knowledge-point/title "Finding the Center and Radius of a Circle by Completing the Square"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a6ffeffb-ef59-54f5-be3f-a2062b83999e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "center: $(2,-3)$, radius: $4$" :db/id #edb/ref 17592186077145} {:answer/id #uuid "a8e22452-4b20-5bf4-9090-9c4baa1361ca" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "center: $(3,-2)$, radius: $16$" :db/id #edb/ref 17592186077146} {:answer/id #uuid "c8f09b0a-5fff-5884-866a-7cd7c2b038b1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "center: $(3,-2)$, radius: $8$" :db/id #edb/ref 17592186077147} {:answer/id #uuid "d6f5be55-2167-551f-a536-04e193c35eb9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "center: $(-2, 3)$, radius: $4$" :db/id #edb/ref 17592186077148} {:answer/id #uuid "00169a7a-33bd-5ce6-8aa9-6f23a52c4730" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "center: $(2,-3)$, radius: $16$" :db/id #edb/ref 17592186077149}] :answer-field/id #uuid "b0de6a19-461b-5d8f-8397-c1cfef2f142b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186077144} {:answer-field/choices [{:answer/id #uuid "ae470676-bc8c-59ed-9ddf-e6bfad4e99f2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "center: $(2,-3)$, radius: $4$" :db/id #edb/ref 17592186396095} {:answer/id #uuid "3958fd13-48da-5731-9bd7-2332d7318f31" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "center: $(2,-3)$, radius: $16$" :db/id #edb/ref 17592186396096} {:answer/id #uuid "445b916b-1ba8-5248-91b4-ef8043ebe2f7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "center: $(-2,3)$, radius: $4$" :db/id #edb/ref 17592186396097} {:answer/id #uuid "1caf2e7f-b2a3-5b2b-9e2c-a85b6dd512fd" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "center: $(3,-2)$, radius: $8$" :db/id #edb/ref 17592186396098} {:answer/id #uuid "6d7bd3d5-18da-5a40-acfa-fa44fce357be" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "center: $(3,-2)$, radius: $16$" :db/id #edb/ref 17592186396099}] :answer-field/correct {:answer/id #uuid "445b916b-1ba8-5248-91b4-ef8043ebe2f7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "center: $(-2,3)$, radius: $4$" :db/id #edb/ref 17592186396097} :answer-field/id #uuid "8f64383e-34d9-58e2-8c5a-1486b312000b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186396094}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "dd6c82b9-14ab-538d-aa0f-037306546c3d" :question/math-academy-id "q-5144" :question/problem "Find the center and radius of the circle whose equation is ${x}^{2}+{y}^{2}+4x-6y=3.$" :question/worked-solution "To find the center and radius of the circle, we need to group $x$ and $y$ terms and complete the squares.\n\n$$\n\\begin{aligned}{x}^{2}+{y}^{2}+4x-6y & =3 \\\\ ({x}^{2}+4x)+({y}^{2}-6y) & =3 \\\\ ({x}^{2}+2\\cdot 2x+{2}^{2})+({y}^{2}-2\\cdot 3y+{3}^{2}) & =3+{2}^{2}+{3}^{2} \\\\ ({x}^{2}+2\\cdot 2x+4)+({y}^{2}-2\\cdot 3y+9) & =16\\end{aligned}\n$$\n\nNow, we can factor the perfect squares and get\n\n$$\n\\begin{aligned}(x+2)^{2}+(y-3)^{2} & ={4}^{2} \\\\ (x-(-2))^{2}+(y-3)^{2} & ={4}^{2}.\\end{aligned}\n$$\n\nTherefore, the circle is centered at $(-2,3)$ and its radius is $4.$"}] [{:db/id #edb/ref 17592186396100 :knowledge-point/_questions [{:db/id #edb/ref 17592186078390 :knowledge-point/id #uuid "697f9bd8-9edf-5643-8cdb-a821b6dce09c" :knowledge-point/title "Finding the Center and Radius of a Circle by Completing the Square"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "da01d3e1-9120-5411-866d-68f2c61e8b78" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "center: $(-4,-5)$, radius: $7$" :db/id #edb/ref 17592186396102} {:answer/id #uuid "7347a868-a565-5dcd-9bc6-dcb157568620" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "center: $(-4,-5)$, radius: $8$" :db/id #edb/ref 17592186396103} {:answer/id #uuid "4a914338-4d65-53bf-b781-37800f0d7a7e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "center: $(-4,-5)$, radius: $4$" :db/id #edb/ref 17592186396104} {:answer/id #uuid "ebef622a-7402-5186-b9c9-cdb47181e259" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "center: $(4,5)$, radius: $8$" :db/id #edb/ref 17592186396105} {:answer/id #uuid "dff6112c-7516-520a-ad8d-0c891d4eb56c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "center: $(4,5)$, radius: $7$" :db/id #edb/ref 17592186396106}] :answer-field/correct {:answer/id #uuid "dff6112c-7516-520a-ad8d-0c891d4eb56c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "center: $(4,5)$, radius: $7$" :db/id #edb/ref 17592186396106} :answer-field/id #uuid "f7cc307e-c24b-55cb-bd12-ec807df438fc" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186396101}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "6ac8461a-29d0-5698-901e-84a35dae5276" :question/math-academy-id "q-5183" :question/problem "Find the center and radius of the circle whose equation is ${y}^{2}-8x-10y+{x}^{2}=8.$" :question/worked-solution "To find the center and radius of the circle, we need to group $x$ and $y$ terms and complete the squares.\n\n$$\n\\begin{aligned}{y}^{2}-8x-10y+{x}^{2} & =8 \\\\ ({x}^{2}-8x)+({y}^{2}-10y) & =8 \\\\ ({x}^{2}-2\\cdot 4x+{4}^{2})+({y}^{2}-2\\cdot 5y+{5}^{2}) & =8+{4}^{2}+{5}^{2} \\\\ ({x}^{2}-2\\cdot 4x+{4}^{2})+({y}^{2}-2\\cdot 5y+{5}^{2}) & =49\\end{aligned}\n$$\n\nNow, we can factor the perfect squares and get\n\n$$\n\\begin{aligned}(x-4)^{2}+(y-5)^{2} & ={7}^{2}.\\end{aligned}\n$$\n\nTherefore, the circle is centered at $(4,5)$ and its radius is $7.$"}] [{:db/id #edb/ref 17592186332889 :knowledge-point/_questions [{:db/id #edb/ref 17592186096635 :knowledge-point/id #uuid "a7eb3fea-e4cf-5537-9a33-06b9d2b35c6b" :knowledge-point/title "Solving a System Containing Fractions in Both Equations Using Elimination"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0e908bba-8bc6-5c10-9c84-aecd35277512" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "v=3,\\,w=-4" :db/id #edb/ref 17592186330073} {:answer/id #uuid "5f4731c8-fa0d-53b2-bd23-87efb29ee2cf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "v=5,\\,w=0" :db/id #edb/ref 17592186330798} {:answer/id #uuid "65844d51-bacc-5d3d-a1e1-675d53338e6c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "v=4,\\,w=-5" :db/id #edb/ref 17592186330855} {:answer/id #uuid "ba117ea5-28cb-50ec-9e7c-bd0a5d4c558e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "v=-3,\\,w=-5" :db/id #edb/ref 17592186331592} {:answer/id #uuid "d39b148c-e51a-5bb7-a7b5-5480c62f13a8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "v=-3,\\,w=7" :db/id #edb/ref 17592186331827}] :answer-field/correct {:answer/id #uuid "ba117ea5-28cb-50ec-9e7c-bd0a5d4c558e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "v=-3,\\,w=-5" :db/id #edb/ref 17592186331592} :answer-field/id #uuid "e56dda56-b48f-5387-836b-e5ed6f439972" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186332604}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "f4c56a55-59ed-53e3-ab00-d41b4f2401b3" :question/math-academy-id "q-52202" :question/problem "Solve the following system of equations:\n\n$$\n{\\begin{aligned}\\frac{5}{3}v-2w=5 \\\\ -v-\\frac{2}{5}w=5\\end{aligned}\n$$" :question/worked-solution "To get rid of fractions, we multiply the first equation by $3$ and the second equation by $5,$ as follows:\n\n$$\n{\\begin{aligned}\\frac{5}{3}v-2w=5 & |\\times 3 \\\\ -v-\\frac{2}{5}w=5 & |\\times 5\\end{aligned}\\,⟹\\,{\\begin{aligned}5v-6w=15 \\\\ -5v-2w=25\\end{aligned}\n$$\n\nWe will use the elimination method to solve the system. We can eliminate $v$ by adding the two equations:\n\n$$\n\\begin{aligned}\\cancel{5v}-6w & =15 \\\\ -\\cancel{5v}-2w & =25 \\\\ (-6w-2w) & =(15+25) \\\\ -8w & =40 \\\\ w & =-5\\end{aligned}\n$$\n\nFinally, we substitute $w=-5$ into the first equation to solve for $v:$\n\n$$\n\\begin{aligned}5v-6w & =15 \\\\ 5v-6(-5) & =15 \\\\ 5v+30 & =15 \\\\ 5v & =-15 \\\\ v & =-3\\end{aligned}\n$$\n\nTherefore, the solution to the system is $v=-3,\\,w=-5.$"}] [{:db/id #edb/ref 17592186403037 :knowledge-point/_questions [{:db/id #edb/ref 17592186110658 :knowledge-point/id #uuid "0cd1bb61-2770-5096-83d6-d1e4a7189e9a" :knowledge-point/title "Working With Systems Containing \"Or Equal To\" Inequalities"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c6c66b28-305f-5672-966e-0edbadb3f68b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\begin{aligned}y\\ge 3x+1 \\\\ y\\ge 2\\end{aligned}" :db/id #edb/ref 17592186403039} {:answer/id #uuid "22d57f63-0dab-54f1-a015-47cd4fa3ad27" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\begin{aligned}y\\ge 3x+1 \\\\ y\\le 2\\end{aligned}" :db/id #edb/ref 17592186403040} {:answer/id #uuid "c282cd0f-a1b4-575a-bd8d-6fbc31f00808" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\begin{aligned}y\\ge 3x+1 \\\\ y<2\\end{aligned}" :db/id #edb/ref 17592186403041} {:answer/id #uuid "dcc09857-90e2-5fa6-8e10-a5896664af24" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\begin{aligned}y\\le 3x+1 \\\\ y\\le 2\\end{aligned}" :db/id #edb/ref 17592186403042} {:answer/id #uuid "076f9837-2705-5d0a-9c57-71c316b16391" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\begin{aligned}y\\le 3x+1 \\\\ y\\ge 2\\end{aligned}" :db/id #edb/ref 17592186403043}] :answer-field/correct {:answer/id #uuid "c6c66b28-305f-5672-966e-0edbadb3f68b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\begin{aligned}y\\ge 3x+1 \\\\ y\\ge 2\\end{aligned}" :db/id #edb/ref 17592186403039} :answer-field/id #uuid "6391aa03-c66c-510d-8de3-714552c986fb" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186403038}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "9187138f-ae2f-5a56-952a-6135b67724bf" :question/math-academy-id "q-52413" :question/problem "![](images/75/75a7f3bfae55a97fbc0c05e2e0356d21de6ceabcc82ac3e1c965838a636f5ecc.png)\n\nWhich of the following systems of inequalities defines the shaded region shown above?" :question/worked-solution "Consider the line $y=3x+1.$ Since the line is solid, the inequality is an \"or equal to\" inequality. Also, since the shaded region lies *above* the line, the inequality is a \"greater than\" inequality. So the corresponding inequality is\n\n$$\ny\\ge 3x+1.\n$$\n\n    \n\nNow consider the line $y=2.$ Since the line is solid, the inequality is an \"or equal to\" inequality. Also, since the shaded region lies *above* the line, the inequality is a \"greater than\" inequality. So the corresponding inequality is\n\n$$\ny\\ge 2.\n$$\n\nTherefore, the system of inequalities that defines the shaded region is\n\n$$\n{\\begin{aligned}y\\ge 3x+1 \\\\ y\\ge 2.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186403044 :knowledge-point/_questions [{:db/id #edb/ref 17592186110651 :knowledge-point/id #uuid "fbd52408-5f2f-58c9-9a88-bd992fe8752c" :knowledge-point/title "Working With Systems Containing Strict Inequalities"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "599f73e4-3ca9-5922-b9a5-51c11d904876" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\begin{aligned}y<2x+6 \\\\ y>5\\end{aligned}" :db/id #edb/ref 17592186403046} {:answer/id #uuid "88ca59a7-54b0-51b6-8e85-e1665efeaa4a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\begin{aligned}y<2x+6 \\\\ y<5\\end{aligned}" :db/id #edb/ref 17592186403047} {:answer/id #uuid "cc2ec7bb-7f05-5512-a12e-01138a6573c3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\begin{aligned}y\\le 2x+6 \\\\ y\\le 5\\end{aligned}" :db/id #edb/ref 17592186403048} {:answer/id #uuid "17af44de-3d26-5293-8028-23cd473e2e0b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\begin{aligned}y>2x+6 \\\\ y<5\\end{aligned}" :db/id #edb/ref 17592186403049} {:answer/id #uuid "b7ebc338-a51c-54a2-9008-89b303d45e94" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\begin{aligned}y>2x+6 \\\\ y>5\\end{aligned}" :db/id #edb/ref 17592186403050}] :answer-field/correct {:answer/id #uuid "88ca59a7-54b0-51b6-8e85-e1665efeaa4a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\begin{aligned}y<2x+6 \\\\ y<5\\end{aligned}" :db/id #edb/ref 17592186403047} :answer-field/id #uuid "057029ec-da64-5909-af01-3dd51581c107" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186403045}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "d48a81ca-ca4e-5354-bd11-f73315ba7d7f" :question/math-academy-id "q-52461" :question/problem "![](images/ba/ba01cf5268f2bd62835c925a5eb793c0d98663948899c9e9aba2eeacd37ff30a.png)\n\nWhich of the following systems of inequalities defines the shaded region shown above?" :question/worked-solution "Consider the line $y=2x+6.$ Since the line is dashed, the inequality is strict. Also, since the shaded region lies *below* the line, the inequality is a \"less than\" inequality. So the corresponding inequality is\n\n$$\ny<2x+6.\n$$\n\n    \n\nNow consider the line $y=5.$ Since the line is dashed, the inequality is strict. Also, since the shaded region lies *below* the line, the inequality is a \"less than\" inequality. So the corresponding inequality is\n\n$$\ny<5.\n$$\n\nTherefore, the system of inequalities that defines the shaded region is\n\n$$\n{\\begin{aligned}y<2x+6 \\\\ y<5.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186332891 :knowledge-point/_questions [{:db/id #edb/ref 17592186184323 :knowledge-point/id #uuid "564f2cf7-aaaf-5dea-b619-a560c3151fcc" :knowledge-point/title "Completing the Square on an Expression With a Positive Leading Coefficient"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "17a3a43a-0340-5e3c-9bcf-b1d4cc0763a1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2{(x-1)}^{2}+3" :db/id #edb/ref 17592186330152} {:answer/id #uuid "4b779a67-3896-55fc-be1f-97694c6c476f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2{(x-1)}^{2}+2" :db/id #edb/ref 17592186330635} {:answer/id #uuid "af563452-6627-5310-af3e-8f3e9187bdf8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{(x-1)}^{2}+2" :db/id #edb/ref 17592186331496} {:answer/id #uuid "efd2938a-788b-5b82-8a39-c673b2cf6bd5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2{(x-1)}^{2}+1" :db/id #edb/ref 17592186332058} {:answer/id #uuid "effab392-c1df-59af-aa5f-e43acece335d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2{(x+1)}^{2}+3" :db/id #edb/ref 17592186332060}] :answer-field/correct {:answer/id #uuid "efd2938a-788b-5b82-8a39-c673b2cf6bd5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2{(x-1)}^{2}+1" :db/id #edb/ref 17592186332058} :answer-field/id #uuid "59e8f7ca-397d-5324-b14e-634be47e4ef9" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186332374}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "0793571e-bec3-5375-a73d-bbdb84782691" :question/math-academy-id "q-52522" :question/problem "Rewrite $2{x}^{2}-4x+3$ by completing the square." :question/worked-solution "Notice that the leading coefficient is $2.$ So, we take out a factor of $2$ from the entire expression:\n\n$$\n2({x}^{2}-2x+\\frac{3}{2})\n$$\n\nLet's now complete the square for the expression inside the parentheses:\n\n$$\n{x}^{2}-2x+\\frac{3}{2}\n$$\n\nFirst, we rewrite the coefficient of the linear term as a product with $2$ as a factor:\n\n$$\n{x}^{2}-2\\cdot 1x+\\frac{3}{2}\n$$\n\nThen, we *add* and *then subtract* ${1}^{2},$ writing the constant term $\\frac{3}{2}$ last:\n\n$$\n{{x}^{2}-2\\cdot 1x+{1}^{2}}_{⏟}-{1}^{2}+\\frac{3}{2}\n$$\n\nThe first three terms form a perfect square, which we factor as follows:\n\n$$\n(x-1)^{2}-{1}^{2}+\\frac{3}{2}\n$$\n\nEvaluating the last two terms, we get\n\n$$\n(x-1)^{2}+\\frac{1}{2}\n$$\n\nFinally, we substitute this result back into our original expression:\n\n$$\n\\begin{aligned}2({x}^{2}-2x+\\frac{3}{2}) & =2((x-1)^{2}+\\frac{1}{2}) \\\\  & =2{(x-1)}^{2}+2\\cdot \\frac{1}{2} \\\\  & =2{(x-1)}^{2}+1\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186332892 :knowledge-point/_questions [{:db/id #edb/ref 17592186184323 :knowledge-point/id #uuid "564f2cf7-aaaf-5dea-b619-a560c3151fcc" :knowledge-point/title "Completing the Square on an Expression With a Positive Leading Coefficient"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "11a795cb-9f0e-5939-900e-adafa303f8bf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6{(x-\\frac{1}{6})}^{2}-\\frac{1}{9}" :db/id #edb/ref 17592186330103} {:answer/id #uuid "586c59c4-4661-5f6d-8c14-a8719591fc01" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6{(x-\\frac{1}{6})}^{2}-\\frac{1}{6}" :db/id #edb/ref 17592186330738} {:answer/id #uuid "72076787-7552-58b8-8ad4-00b516cbaf7a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{(6x-\\frac{1}{3})}^{2}+\\frac{1}{9}" :db/id #edb/ref 17592186330976} {:answer/id #uuid "98ee28e9-1737-5e3b-81c5-05141104f588" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{(6x-\\frac{1}{3})}^{2}+\\frac{1}{6}" :db/id #edb/ref 17592186331315} {:answer/id #uuid "f630c36b-13b8-5df3-93c0-7e5b92d1a0cd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6{(x-\\frac{1}{6})}^{2}+\\frac{1}{3}" :db/id #edb/ref 17592186332110}] :answer-field/correct {:answer/id #uuid "586c59c4-4661-5f6d-8c14-a8719591fc01" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6{(x-\\frac{1}{6})}^{2}-\\frac{1}{6}" :db/id #edb/ref 17592186330738} :answer-field/id #uuid "3d388fcd-2c84-5c86-86ee-03feb01e614c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186332301}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "38a732d9-8b0e-58f3-ab88-f23eff634c61" :question/math-academy-id "q-52537" :question/problem "Rewrite $6{x}^{2}-2x$ by completing the square." :question/worked-solution "Notice that the leading coefficient is $6.$ So, we take out a factor of $6$ from the entire expression:\n\n$$\n6({x}^{2}-\\frac{1}{3}x)\n$$\n\nLet's now complete the square for the expression inside the parentheses:\n\n$$\n{x}^{2}-\\frac{1}{3}x\n$$\n\nFirst, we rewrite the coefficient of the linear term as a product with $2$ as a factor:\n\n$$\n{x}^{2}-2\\cdot \\frac{1}{6}x\n$$\n\nThen, we *add* and *then subtract* ${(\\frac{1}{6})}^{2}:$ \n\n$$\n{{x}^{2}-2\\cdot \\frac{1}{6}x+{(\\frac{1}{6})}^{2}}_{⏟}-{(\\frac{1}{6})}^{2}\n$$\n\nThe first three terms form a perfect square, which we factor as follows:\n\n$$\n{(x-\\frac{1}{6})}^{2}-{(\\frac{1}{6})}^{2}\n$$\n\nEvaluating the last term, we get\n\n$$\n{(x-\\frac{1}{6})}^{2}-\\frac{1}{36}\n$$\n\nFinally, we substitute this result back into our original expression:\n\n$$\n\\begin{aligned}6({x}^{2}-\\frac{1}{3}x) & =6({(x-\\frac{1}{6})}^{2}-\\frac{1}{36}) \\\\  & =6{(x-\\frac{1}{6})}^{2}-6\\cdot \\frac{1}{36} \\\\  & =6{(x-\\frac{1}{6})}^{2}-\\frac{1}{6}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186184806 :knowledge-point/_questions [{:db/id #edb/ref 17592186184212 :knowledge-point/id #uuid "3202d7cc-541b-553b-8ec1-d4ea85dd0590" :knowledge-point/title "Completing the Square on an Expression With a Negative Leading Coefficient"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "01ddff9c-ac54-5bdb-8e05-4c9e80b9afd9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3{(y+1)}^{2}+\\frac{4}{3}" :db/id #edb/ref 17592186329975} {:answer/id #uuid "30d8498f-8b3e-524c-b327-f7f1af56ad01" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3{(y-1)}^{2}-\\frac{4}{3}" :db/id #edb/ref 17592186330381} {:answer/id #uuid "4d8ac45d-48a3-5d22-9f35-e862992b052f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3{(y+1)}^{2}-4" :db/id #edb/ref 17592186330655} {:answer/id #uuid "f1e12e2d-9ac1-56f3-b293-e94794a6a02c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3{(y-\\frac{1}{3})}^{2}+4" :db/id #edb/ref 17592186332078} {:answer/id #uuid "fcb7f176-7c6f-5b6e-950c-ed129b00ef62" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3{(y-1)}^{2}+4" :db/id #edb/ref 17592186332171}] :answer-field/correct {:answer/id #uuid "fcb7f176-7c6f-5b6e-950c-ed129b00ef62" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3{(y-1)}^{2}+4" :db/id #edb/ref 17592186332171} :answer-field/id #uuid "064cff71-f6ed-52e2-8855-063c335fc1b1" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186332205}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "f4b82526-21d1-5906-b903-379b7a33781d" :question/math-academy-id "q-52544" :question/problem "Rewrite $-3{y}^{2}+6y+1$ by completing the square." :question/worked-solution "Notice that the leading coefficient is $-3.$ So, we take out a factor of $-3$ from the entire expression:\n\n$$\n-3({y}^{2}-2y-\\frac{1}{3})\n$$\n\nLet's now complete the square for the expression inside the parentheses:\n\n$$\n{y}^{2}-2y-\\frac{1}{3}\n$$\n\nFirst, we rewrite the coefficient of the linear term as a product with $2$ as a factor:\n\n$$\n{y}^{2}-2\\cdot 1y-\\frac{1}{3}\n$$\n\nThen, we *add* and *then subtract* ${1}^{2},$ writing the constant term $\\frac{1}{3}$ last:\n\n$$\n{{y}^{2}-2\\cdot 1y+{1}^{2}}_{⏟}-{1}^{2}-\\frac{1}{3}\n$$\n\nThe first three terms form a perfect square, which we factor as follows:\n\n$$\n(y-1)^{2}-{1}^{2}-\\frac{1}{3}\n$$\n\nEvaluating the last two terms, we get\n\n$$\n(y-1)^{2}-\\frac{4}{3}.\n$$\n\nFinally, we substitute this result back into our original expression:\n\n$$\n\\begin{aligned}-3({y}^{2}-2y-\\frac{1}{3}) & =-3({(y-1)}^{2}-\\frac{4}{3}) \\\\  & =-3{(y-1)}^{2}+(-3)\\cdot (-\\frac{4}{3}) \\\\  & =-3{(y-1)}^{2}+4\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186392742 :knowledge-point/_questions [{:db/id #edb/ref 17592186115410 :knowledge-point/id #uuid "6a76efbd-cefd-5aa0-953e-8ab50bec7ae0" :knowledge-point/title "Finding a Height Corresponding to an Extended Base"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c69a7c27-09ce-5cf4-9117-95fab7c198f2" :answer/type {:db/id #edb/ref 17