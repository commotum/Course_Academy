fficulty/easy} :question/id #uuid "ea8e67f7-a331-5a5a-8338-679b56a16346" :question/math-academy-id "q-48080" :question/problem "![](images/37/374abcb470bfde0688def89290c8c1d639bf025afde150ccb9dd848c1fcc9a0f.png)\n\nWhat are the points of discontinuity of the function plotted above?" :question/worked-solution "The graph breaks at $x=-2$ and $x=0$ meaning that we can't draw the plot without taking our pencil off of the paper when passing through these points.\n\nTherefore, the correct answer is $x=-2$ and $x=0.$"}] [{:db/id #edb/ref 17592186392615 :knowledge-point/_questions [{:db/id #edb/ref 17592186068695 :knowledge-point/id #uuid "6cd6c125-ecaf-5847-a802-ec1b3594a15c" :knowledge-point/title "Determining Whether a Function Is Continuous at a Given Point"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e5cffd7b-e09a-5e8f-9bc6-d30e9bf80623" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/c6/c6f0914f0b218164bc99fdefe7d83dffe4591a6b704e2243013d05c2b117ef17.png" :db/id #edb/ref 17592186392617} {:answer/id #uuid "3ba0ee0f-2ced-5835-84e5-0ed53e1549d3" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/c2/c2f85d1a2becc7bfe6f71d7f6fcb178f4707f4b41956015eabb38610de95feca.png" :db/id #edb/ref 17592186392618} {:answer/id #uuid "d5853982-4adc-5148-b192-1f951c92f732" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/14/14349b3dee80a6d451efedc55b91b5e709139f1a93fabf539d605843513f6141.png" :db/id #edb/ref 17592186392619} {:answer/id #uuid "a3c69f46-c3ba-5974-ae7f-6acba3a9675b" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/30/3073f651e0194c8675629f8fc52d45694a64680e3208b8fd7ef066e38d715033.png" :db/id #edb/ref 17592186392620} {:answer/id #uuid "b9c4e630-276e-54fd-922f-6f7389462a61" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "i