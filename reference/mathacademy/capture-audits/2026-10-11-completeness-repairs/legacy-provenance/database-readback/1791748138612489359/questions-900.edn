f81462e22e1becb284736a.png" :db/id #edb/ref 17592186392591} {:answer/id #uuid "b8e33187-d6c4-5fbc-b100-c663848334e6" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/bf/bf943c2d6f9281c62f82712485bce8ab06b7312e8156baf0b961e858e0f28ea6.png" :db/id #edb/ref 17592186392592} {:answer/id #uuid "218adc50-a59c-5ded-a9cc-466c8124d139" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/1e/1ef7e9ce0d1db1e60721d5f44b094d23091fd42b02b3b93832f4b17523241c87.png" :db/id #edb/ref 17592186392593} {:answer/id #uuid "8bee35bf-0fbc-59b3-ad02-d3fba93e60a8" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/8e/8e9b1f8848e09eb936116d39dc72b9d15bded2426b2e4de23f88e257cbe9d46f.png" :db/id #edb/ref 17592186392594}] :answer-field/correct {:answer/id #uuid "04671946-230b-5e70-8f2c-ff566e8b3b34" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/d2/d297db86c650af71f2d116f65470aa46445aceede8f81462e22e1becb284736a.png" :db/id #edb/ref 17592186392591} :answer-field/id #uuid "36fddb3c-5df5-5efe-9d09-31fdd773672d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186392589}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "d2d358ee-4f00-5039-8abe-a47808bd6f20" :question/math-academy-id "q-47669" :question/problem "Which of the following functions is not differentiable over the entire interval $x\\in (-1,1)$ due to the existence of a vertical tangent in the interval?" :question/worked-solution "Notice that the function $y=h(x)$ has a vertical tangent at $x=0$ and is therefore not differentiable at $x=0.$ \nTherefore, the correct answer is $y=h(x).$\n\nThe other graphs do not have a vertical tangent inside the interval $(-1,1).$\n\n- The function $y=f(x)$ has a corner point at $x=0.$\n\n- The function $y=g(x)$ is smooth and continuous over the entire interval $x\\in (-1,1).$\n\n- The functions $y=p(x)$ and $y=q(x)$ are not defined at $x=0.$"}] [{:db/id #edb/ref 17592186329826 :knowledge-point/_questions [{:db/id #edb/ref 17592186115381 :knowledge-point/id #uuid "1b4100f8-8a66-5243-b0b6-c36b9d17dac3" :knowledge-point/title "Determining Which Functions are Differentiable at a Given Point From the Function Expressions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "20ac00fa-c573-50b2-9181-c5c47c436adb" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186327214} {:answer/id #uuid "6664d395-2cd4-57fa-8267-dad7b7f6653c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186327822} {:answer/id #uuid "ad7699cf-1310-5e2c-8483-50775b4a0f7d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186328441} {:answer/id #uuid "c8d74407-8722-5f57-a238-174a8da68bde" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186328700} {:answer/id #uuid "cf91c4ec-315b-5bb2-ba9b-e695b2ead9ad" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186328760}] :answer-field/correct {:answer/id #uuid "6664d395-2cd4-57fa-8267-dad7b7f6653c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186327822} :answer-field/id #uuid "01e41401-65d6-5b8b-a09b-c7db46fa5956" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186329187}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "8298d153-fa1d-58c6-bfcd-efab6041f9f0" :question/math-academy-id "q-47681" :question/problem "Which of the following statements are true regarding the function given below?\n\n$$\nf(x)={\\begin{aligned}{x}^{3}+1, & x\\ne 1 \\\\ 3, & x=1\\end{aligned}\\,\n$$\n\n- It is continuous and differentiable at $x=1$\n- It is **not** differentiable at $x=1$\n- It is differentiable on the interval $(-1,2)$" :question/worked-solution "Let's analyze each statement individually. \n\n- Statement I is false.  At $x=1$, we have \n\n$$\n\\begin{aligned}{lim}_{x\\to {1}^{+}}f(x) & ={lim}_{x\\to {1}^{+}}({x}^{3}+1)={1}^{3}+1=2 \\\\ {lim}_{x\\to {1}^{-}}f(x) & ={lim}_{x\\to {1}^{-}}({x}^{3}+1)={1}^{3}+1=2.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n{lim}_{x\\to {1}^{+}}f(x)={lim}_{x\\to {1}^{-}}f(x)\\ne f(1)=3,\n$$\n\nand so $f(x)$ is not continuous at $x=1$ ($f(x)$ has a removable discontinuity at $x=1$).\n\n- Statement II is true. Since  $f(x)$ is not continuous at $x=1,$ it is also not differentiable there (because differentiability implies continuity).\n\n- Statement III is false. Since $f(x)$ is not differentiable at $x=1,$ it is not differentiable on any interval containing this point. Consequently, it is not differentiable on $(-1,2).$\n\nTherefore, only statement II is true."}] [{:db/id #edb/ref 17592186329835 :knowledge-point/_questions [{:db/id #edb/ref 17592186119954 :knowledge-point/id #uuid "744b0e69-71f9-5ca0-a200-8968a9ec192e" :knowledge-point/title "Determining Vertical Asymptotes of a Rational Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "29a0fc8a-86ac-5ab6-acd1-3ec0072b7256" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=-2" :db/id #edb/ref 17592186327288} {:answer/id #uuid "b4bd35f1-1cf5-5986-8bcd-cae0e1e256a0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=\\sqrt{2}" :db/id #edb/ref 17592186328506} {:answer/id #uuid "e6a685ba-076b-591a-b200-e9ee6e74f0b0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=2" :db/id #edb/ref 17592186328951} {:answer/id #uuid "f1f4c678-2ef4-5109-bc2c-e164d61c301e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=5" :db/id #edb/ref 17592186329047} {:answer/id #uuid "f598a74d-ecb1-5d47-9ac6-e6464cddea05" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "There are no vertical asymptotes." :db/id #edb/ref 17592186329083}] :answer-field/correct {:answer/id #uuid "b4bd35f1-1cf5-5986-8bcd-cae0e1e256a0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=\\sqrt{2}" :db/id #edb/ref 17592186328506} :answer-field/id #uuid "5859fa75-27d1-5a4e-9275-4eb9c181d62a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186329341}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "e2ba45bb-fcdc-536e-a19c-0143c96613a0" :question/math-academy-id "q-47854" :question/problem "Find the vertical asymptotes of $y=f(x)=\\frac{5}{x-\\sqrt{2}}.$" :question/worked-solution "There are no common factors in the numerator and denominator. So, we find the vertical asymptotes by setting the denominator equal to zero:\n\n$$\nx-\\sqrt{2}=0\\,⟹\\,x=\\sqrt{2}.\n$$\n\nConsequently, $x=\\sqrt{2}$ is the only vertical asymptote of $y=f(x),$ as shown below. \n\n![](images/09/09c19a6049d77a2b57c093ca714627a453c99bf52af27ae656ad1f4e779d1866.png)"}] [{:db/id #edb/ref 17592186329837 :knowledge-point/_questions [{:db/id #edb/ref 17592186078428 :knowledge-point/id #uuid "1d752aac-6187-595d-8818-b0179fd7380e" :knowledge-point/title "Evaluating a Definite Integral Using Multiple Properties of Definite Integrals"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "07c7c09f-3771-5ac2-8492-cb564408d161" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186326995} {:answer/id #uuid "09a6f667-741d-5bd1-8b8a-e0169fa9064e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186327016} {:answer/id #uuid "5b54c3bd-e1c0-5f6e-949c-a3321c243ed7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186327735} {:answer/id #uuid "b402004a-0bc7-5a2a-89cb-61969dcaee78" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186328497} {:answer/id #uuid "b930f089-e00a-5693-9851-95f660218c94" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "9" :db/id #edb/ref 17592186328551}] :answer-field/correct {:answer/id #uuid "b930f089-e00a-5693-9851-95f660218c94" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "9" :db/id #edb/ref 17592186328551} :answer-field/id #uuid "a5a34845-2a7f-510c-bb16-9154a49b42a1" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186329468}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "99d67546-ee63-5a73-9d7b-983a73ffa720" :question/math-academy-id "q-4790" :question/problem "Suppose that $f(x)$ is a function such that ${\\int }_{3}^{0}\\frac{1}{3}f(x)\\,\\text{d}x=-1$ and ${\\int }_{3}^{5}f(x)\\,\\text{d}x=6.$ What is the value of ${\\int }_{0}^{5}f(x)\\,\\text{d}x?$" :question/worked-solution "Let's simplify one of the given integrals:\n\n$$\n\\begin{aligned}{\\int }_{3}^{0}\\frac{1}{3}\\,f(x)\\,\\text{d}x & =-1 \\\\ \\frac{1}{3}{\\int }_{3}^{0}\\,f(x)\\,\\text{d}x & =-1 \\\\ -\\frac{1}{3}{\\int }_{0}^{3}f(x)\\,\\text{d}x & =-1 \\\\ {\\int }_{0}^{3}f(x)\\,\\text{d}x & =3\\end{aligned}\n$$\n\nThen, from the adjacent intervals rule, we get \n\n$$\n\\begin{aligned}{\\int }_{0}^{5}f(x)\\,\\text{d}x & ={\\int }_{0}^{3}f(x)\\,\\text{d}x+{\\int }_{3}^{5}f(x)\\,\\text{d}x \\\\  & =3+6 \\\\  & =9.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186402909 :knowledge-point/_questions [{:db/id #edb/ref 17592186064162 :knowledge-point/id #uuid "a595bc07-ad64-537d-be42-06144814b97d" :knowledge-point/title "Identifying Extrema of a Function Given Its Graph"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5af784ce-3cef-5945-8932-b03fe43316e6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$A$ and $C$ only" :db/id #edb/ref 17592186402911} {:answer/id #uuid "9673d400-5f29-5ce5-b5e9-8047de8eb008" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$B$ and $D$ only" :db/id #edb/ref 17592186402912} {:answer/id #uuid "eb5c6830-b8b8-54b9-9b05-279cc0d24408" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$B$ and $C$ only" :db/id #edb/ref 17592186402913} {:answer/id #uuid "f088b713-a43a-50e7-9574-07ac077ab3d9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$C$ only" :db/id #edb/ref 17592186402914} {:answer/id #uuid "62bbee0f-e18c-5110-a2d4-144a718f657e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$B$ only" :db/id #edb/ref 17592186402915}] :answer-field/correct {:answer/id #uuid "9673d400-5f29-5ce5-b5e9-8047de8eb008" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$B$ and $D$ only" :db/id #edb/ref 17592186402912} :answer-field/id #uuid "01f254e3-3027-52e3-8cb7-edd707cacbbe" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186402910}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "62b39803-cf8b-5f2a-91f9-b83f48f12d0e" :question/math-academy-id "q-47919" :question/problem "![](images/d9/d9d8fb6d663d8dfd0cce24ae3817c936e2e97ab2df7aefeaa0c734caf0311b94.png)\n\nThe graph of $y=f(x)$ is plotted above. Given that $f(x)$ is defined on the interval $x\\in [-3,10]$, which points represent the global maximum of $f(x)?$" :question/worked-solution "The global extrema of a function are the lowest or highest points of the function's graph over its entire domain.\n\nThe lowest point is the global minimum, whereas the highest point is the global maximum.\n\nAccording to the graph, the highest points are $B$ and $D$, and so these points represents the global maximum of $f(x).$"}] [{:db/id #edb/ref 17592186329841 :knowledge-point/_questions [{:db/id #edb/ref 17592186096621 :knowledge-point/id #uuid "3c547746-49c8-5a4a-85fe-c6b75493a354" :knowledge-point/title "Differentiating a Quotient Containing Other Functions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "24cdb15d-92a4-57bb-b3ae-70ee6398efed" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{e}^{x}sin⁡x-cos⁡x}{{sin}^{2}⁡x}" :db/id #edb/ref 17592186327252} {:answer/id #uuid "28cffc72-f500-56eb-b62d-297789e3d352" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{e}^{x}(cos⁡x+sin⁡x)}{{cos}^{2}⁡x}" :db/id #edb/ref 17592186327280} {:answer/id #uuid "537f4f22-dc76-5ecc-941c-28735a7fbb3e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{e}^{x}sin⁡x-cos⁡x}{{cos}^{2}⁡x}" :db/id #edb/ref 17592186327658} {:answer/id #uuid "6cb04a5b-8198-547f-9f85-6d03684ff103" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{e}^{x}(sin⁡x-cos⁡x)}{cos⁡x}" :db/id #edb/ref 17592186327873} {:answer/id #uuid "6ebf154b-78ed-5323-9bc6-5af4e4ce0e17" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{e}^{x}(sin⁡x-cos⁡x)}{{cos}^{2}⁡x}" :db/id #edb/ref 17592186327893}] :answer-field/correct {:answer/id #uuid "28cffc72-f500-56eb-b62d-297789e3d352" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{e}^{x}(cos⁡x+sin⁡x)}{{cos}^{2}⁡x}" :db/id #edb/ref 17592186327280} :answer-field/id #uuid "1139e71c-df1c-5f00-8bad-e71886ea7ae5" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186329215}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "5ace0fb1-1a71-5cfd-952c-d11857b972c9" :question/math-academy-id "q-47943" :question/problem "If $f(x)=\\frac{{e}^{x}}{cos⁡x},$ find ${f}^{′}(x).$" :question/worked-solution "In this case, the expression for $f(x)$ is a quotient $\\frac{u(x)}{v(x)}$ with $u(x)={e}^{x}$ and $v(x)=cos⁡x.$ \n\nTherefore, we apply the quotient rule as follows:\n\n$$\n\\begin{aligned}\\begin{aligned}{f}^{′}(x) & =\\frac{{u}^{′}(x)\\cdot v(x)-u(x)\\cdot {v}^{′}(x)}{[v(x)]^{2}} \\\\  & =\\frac{({e}^{x})^{′}\\cdot cos⁡x-{e}^{x}\\cdot (cos⁡x)^{′}}{(cos⁡x)^{2}} \\\\  & =\\frac{{e}^{x}cos⁡x+{e}^{x}sin⁡x}{(cos⁡x)^{2}} \\\\  & =\\frac{{e}^{x}(cos⁡x+sin⁡x)}{{cos}^{2}⁡x}\\end{aligned}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186329845 :knowledge-point/_questions [{:db/id #edb/ref 17592186059676 :knowledge-point/id #uuid "711f198b-26b4-5185-812a-102329d49313" :knowledge-point/title "Finding the Derivative of an Expression With the Tangent Trigonometric Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "026a56b8-1115-5684-ac6e-ef1630e64970" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1+\\sqrt{x}{sec}^{2}⁡x}{2\\sqrt{x}}" :db/id #edb/ref 17592186326960} {:answer/id #uuid "0393bd6c-c00c-5794-bb05-1c8299be09b2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1+2{sec}^{2}⁡\\sqrt{x}}{2\\sqrt{x}}" :db/id #edb/ref 17592186326972} {:answer/id #uuid "25ff194a-cfcd-58a0-adba-8bc91fdf1efe" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1+2x{sec}^{2}⁡x}{2\\sqrt{x}}" :db/id #edb/ref 17592186327262} {:answer/id #uuid "44d191be-38a4-500e-8cfb-76a9d83fe2e6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1+2\\sqrt{x}sec⁡x}{2\\sqrt{x}}" :db/id #edb/ref 17592186327534} {:answer/id #uuid "9336f84c-bb60-54b1-ba79-495700d341f9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1+2\\sqrt{x}{sec}^{2}⁡x}{2\\sqrt{x}}" :db/id #edb/ref 17592186328218}] :answer-field/correct {:answer/id #uuid "9336f84c-bb60-54b1-ba79-495700d341f9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1+2\\sqrt{x}{sec}^{2}⁡x}{2\\sqrt{x}}" :db/id #edb/ref 17592186328218} :answer-field/id #uuid "39c98579-7ff9-5677-8870-c03daabb35df" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186329297}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "db3973ed-197d-5377-b8db-60e027e16ad0" :question/math-academy-id "q-47983" :question/problem "Find the derivative of $y=\\sqrt{x}+tan⁡x.$" :question/worked-solution "We know that $\\frac{\\text{d}}{\\text{d}x}(tan⁡x)={sec}^{2}⁡x.$ Applying this formula, we have\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}}{\\text{d}x}(\\sqrt{x}+tan⁡x) \\\\  & =\\frac{1}{2\\sqrt{x}}+{sec}^{2}⁡x \\\\  & =\\frac{1+2\\sqrt{x}{sec}^{2}⁡x}{2\\sqrt{x}}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186329846 :knowledge-point/_questions [{:db/id #edb/ref 17592186059675 :knowledge-point/id #uuid "0de0627b-2568-5c02-8928-d14344df5a2f" :knowledge-point/title "Finding the Derivative of an Expression With Sine or Cosine Trigonometric Functions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "58178d4f-4abd-58b7-80f3-235da8563710" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2sin⁡x-2{x}^{-1}" :db/id #edb/ref 17592186327707} {:answer/id #uuid "6e8ba3a3-8163-54a7-a89c-617f3758ea02" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2sin⁡x-2{x}^{-3}" :db/id #edb/ref 17592186327890} {:answer/id #uuid "abf48582-4f98-5a96-ba7c-6645540d8053" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2sin⁡x-2{x}^{-3}" :db/id #edb/ref 17592186328424} {:answer/id #uuid "b8c3ad30-bf9c-5740-9f1f-85721ef68822" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2sin⁡x+2{x}^{-3}" :db/id #edb/ref 17592186328543} {:answer/id #uuid "fb5d65e6-8cdc-5871-afa6-4d5b3c079a97" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2sin⁡x-2{x}^{-2}" :db/id #edb/ref 17592186329139}] :answer-field/correct {:answer/id #uuid "abf48582-4f98-5a96-ba7c-6645540d8053" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2sin⁡x-2{x}^{-3}" :db/id #edb/ref 17592186328424} :answer-field/id #uuid "fa72fd76-960d-5bcb-9cf5-7f47b8602241" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186329616}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "f32d0b6b-0338-505d-81ba-ba8c8d1669de" :question/math-academy-id "q-47985" :question/problem "Find the derivative of $y=-2cos⁡x+{x}^{-2}.$" :question/worked-solution "We know that $\\frac{\\text{d}}{\\text{d}x}(cos⁡x)=-sin⁡x.$ Applying this formula, we have\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}}{\\text{d}x}(-2cos⁡x+{x}^{-2}) \\\\  & =-2(-sin⁡x)+(-2){x}^{-2-1} \\\\  & =2sin⁡x-2{x}^{-3}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186329847 :knowledge-point/_questions [{:db/id #edb/ref 17592186119978 :knowledge-point/id #uuid "8c0b7d95-c699-5762-aa44-449712f035c7" :knowledge-point/title "Calculating the Derivative of the Inverse of a Polynomial Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "38ba450c-d188-5534-a6ad-9cafd867771b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{2{({g}^{-1}(x))}^{2}}{{({g}^{-1}(x))}^{3}+1}" :db/id #edb/ref 17592186327431} {:answer/id #uuid "5ac51d0f-a480-5257-9373-a102ae71dd07" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{{g}^{-1}(x)}{2{g}^{-1}(x)+2}" :db/id #edb/ref 17592186327728} {:answer/id #uuid "750ebad7-1376-571e-b002-d5de0ee49d71" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{2{g}^{-1}(x)}{{({g}^{-1}(x))}^{2}+2}" :db/id #edb/ref 17592186327940} {:answer/id #uuid "b6596677-9e79-5e4d-84e5-b8e191d29f04" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{{({g}^{-1}(x))}^{2}}{2{({g}^{-1}(x))}^{3}+2}" :db/id #edb/ref 17592186328519} {:answer/id #uuid "f6eb08b3-97ab-5448-916e-1bc51afd4120" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{{g}^{-1}(x)}{{({g}^{-1}(x))}^{3}+2}" :db/id #edb/ref 17592186329100}] :answer-field/correct {:answer/id #uuid "b6596677-9e79-5e4d-84e5-b8e191d29f04" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{{({g}^{-1}(x))}^{2}}{2{({g}^{-1}(x))}^{3}+2}" :db/id #edb/ref 17592186328519} :answer-field/id #uuid "fc99300b-987e-5768-8111-394ddb19ea49" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186329622}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "22ff07e4-057d-5a67-9809-969ec3b995f3" :question/math-academy-id "q-47990" :question/problem "If $g(x)=-{x}^{2}+\\frac{2}{x},$ find ${({g}^{-1})}^{′}(x)$ as a function of ${g}^{-1}(x).$" :question/worked-solution "**Step 1:** First, we write the inverse function implicitly. The given function is $y=-{x}^{2}+\\frac{2}{x},$ and to write the inverse function implicitly, we swap $x$ and $y$ as follows:\n\n$$\nx=-{y}^{2}+\\frac{2}{y}\n$$\n\nNote that in the equation above, we have $y={g}^{-1}(x).$\n\n**Step 2:** Next, we differentiate. The overall goal is to find $\\frac{\\text{d}y}{\\text{d}x},$ but the equation is already solved for $x,$ so we compute $\\frac{\\text{d}x}{\\text{d}y}$ and then take the reciprocal:\n\n$$\n\\begin{aligned}\\frac{\\text{d}x}{\\text{d}y} & =\\frac{\\text{d}}{\\text{d}y}(-{y}^{2}+\\frac{2}{y}) \\\\ \\frac{\\text{d}x}{\\text{d}y} & =-2y-\\frac{2}{{y}^{2}} \\\\ \\frac{\\text{d}x}{\\text{d}y} & =-\\frac{2{y}^{3}+2}{{y}^{2}} \\\\ \\frac{\\text{d}y}{\\text{d}x} & =-\\frac{{y}^{2}}{2{y}^{3}+2}\\end{aligned}\n$$\n\n**Step 3:** Lastly, we write the result in terms of ${g}^{-1}(x).$ Since $y={g}^{-1}(x),$ we have\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}[{g}^{-1}(x)] & =-\\frac{({g}^{-1}(x))^{2}}{2({g}^{-1}(x))^{3}+2} \\\\ {({g}^{-1})}^{′}(x) & =-\\frac{({g}^{-1}(x))^{2}}{2({g}^{-1}(x))^{3}+2}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186329849 :knowledge-point/_questions [{:db/id #edb/ref 17592186096621 :knowledge-point/id #uuid "3c547746-49c8-5a4a-85fe-c6b75493a354" :knowledge-point/title "Differentiating a Quotient Containing Other Functions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5d04b0f4-3b5e-5a83-ab7c-fadd2fae0aa3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{xcos⁡x+2sin⁡x}{{x}^{3}}" :db/id #edb/ref 17592186327753} {:answer/id #uuid "79438a62-c77a-5744-9802-65b0e97ef42c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{cos⁡x-2xsin⁡x}{{x}^{4}}" :db/id #edb/ref 17592186327973} {:answer/id #uuid "85f38040-e7a5-59fd-a359-c862f85f6a27" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{xcos⁡x-2sin⁡x}{{x}^{3}}" :db/id #edb/ref 17592186328088} {:answer/id #uuid "a8c4ce4c-f609-552a-9123-d8fd254ccab0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2xcos⁡x-xsin⁡x}{{x}^{3}}" :db/id #edb/ref 17592186328396} {:answer/id #uuid "c0e8be1f-f487-5a62-b564-e74b12097ed9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{xsin⁡x-2cos⁡x}{{x}^{4}}" :db/id #edb/ref 17592186328619}] :answer-field/correct {:answer/id #uuid "85f38040-e7a5-59fd-a359-c862f85f6a27" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{xcos⁡x-2sin⁡x}{{x}^{3}}" :db/id #edb/ref 17592186328088} :answer-field/id #uuid "9f86cadc-4440-532f-bf1a-6161f5f6bfb9" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186329450}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "b3c4b5b5-b682-57e6-baf5-0601260b1ed0" :question/math-academy-id "q-47998" :question/problem "If $f(x)=\\frac{sin⁡x}{{x}^{2}},$ find ${f}^{′}(x).$" :question/worked-solution "In this case, the expression for $f(x)$ is a quotient $\\frac{u(x)}{v(x)}$ with $u(x)=sin⁡x$ and $v(x)={x}^{2}.$ \n\nTherefore, we apply the quotient rule as follows:\n\n$$\n\\begin{aligned}\\begin{aligned}{f}^{′}(x) & =\\frac{{u}^{′}(x)\\cdot v(x)-u(x)\\cdot {v}^{′}(x)}{[v(x)]^{2}} \\\\  & =\\frac{(sin⁡x)^{′}\\cdot {x}^{2}-sin⁡x\\cdot ({x}^{2})^{′}}{({x}^{2})^{2}} \\\\  & =\\frac{{x}^{2}cos⁡x-2xsin⁡x}{{x}^{4}} \\\\  & =\\frac{x(xcos⁡x-2sin⁡x)}{{x}^{4}} \\\\  & =\\frac{xcos⁡x-2sin⁡x}{{x}^{3}}\\end{aligned}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186329850 :knowledge-point/_questions [{:db/id #edb/ref 17592186092260 :knowledge-point/id #uuid "a83f86ab-a008-5487-b118-f1495a0fe4d6" :knowledge-point/title "Differentiating an Exponential Function with a Linear Exponent"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "016b59fa-7dd1-5430-8a0d-9d17b256b87e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-8{e}^{4x-1}+3" :db/id #edb/ref 17592186326950} {:answer/id #uuid "1a09b33b-87d5-53a9-afee-f8e02962d4c3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}{e}^{4x-1}" :db/id #edb/ref 17592186327160} {:answer/id #uuid "35f572ac-b945-560e-89f5-d45ed6858e1a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8{e}^{4x-1}+3" :db/id #edb/ref 17592186327403} {:answer/id #uuid "bab77687-86e3-5b97-960a-d832566921c3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-8{e}^{4x-2}" :db/id #edb/ref 17592186328563} {:answer/id #uuid "bfa829b5-29ee-5ba4-a1c8-72e5faa0588a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-8{e}^{4x-1}" :db/id #edb/ref 17592186328611}] :answer-field/correct {:answer/id #uuid "bfa829b5-29ee-5ba4-a1c8-72e5faa0588a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-8{e}^{4x-1}" :db/id #edb/ref 17592186328611} :answer-field/id #uuid "a2f4dd66-f6d3-5f50-8ce9-b004c416733f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186329462}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "dd0c521a-06b7-559f-8b78-1152ec8cbcd7" :question/math-academy-id "q-48007" :question/problem "Calculate ${f}^{′}(x)$ if $f(x)=-2{e}^{4x-1}+3.$" :question/worked-solution "First, we express $f(x)$ as the composite function\n\n$$\nf=-2{e}^{u}+3,\\,u=4x-1.\n$$\n\nDifferentiating gives\n\n$$\n\\frac{\\text{d}f}{\\text{d}u}=-2{e}^{u},\\,\\frac{\\text{d}u}{\\text{d}x}=4.\n$$\n\nWe now apply the chain rule, and get\n\n$$\n\\begin{aligned}\\frac{\\text{d}f}{\\text{d}x} & =\\frac{\\text{d}f}{\\text{d}u}\\cdot \\frac{\\text{d}u}{\\text{d}x} \\\\  & =-2{e}^{u}\\cdot 4 \\\\  & =-8{e}^{u} \\\\  & =-8{e}^{4x-1}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186392602 :knowledge-point/_questions [{:db/id #edb/ref 17592186068696 :knowledge-point/id #uuid "31eacf5a-75a5-5b38-8c24-4b1598ecf3a7" :knowledge-point/title "Identifying Points of Discontinuity"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d495799e-2f9d-5146-a399-506d9d32ad84" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/c9/c9ba1e63c665ad63597c822828fdf26ec0fefade083df5ea828f57a49d3aa149.png" :db/id #edb/ref 17592186392604} {:answer/id #uuid "c796e42f-5eb7-5d3a-900e-6d5fb58916e3" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/fc/fc1d428500558ed62fbf5f7e0c13604cbc759629cedb63a8f9c2f7fc0b412480.png" :db/id #edb/ref 17592186392605} {:answer/id #uuid "742220de-47f9-5f30-8679-f64626ac489f" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/d9/d9185fb471c9806d490133c6ea5a54ef69878f89ca0e0be66008ec3626bfe346.png" :db/id #edb/ref 17592186392606} {:answer/id #uuid "11ce7ab1-ca48-5c69-b7f7-b7ff62f3ea3d" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/49/49e7b3c3cd4e6410b95a307f74c90079ec61c2d3540f86a357db88c77039ca44.png" :db/id #edb/ref 17592186392607} {:answer/id #uuid "c37ded1b-1a1e-52ed-a977-31d60b87248f" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/bd/bd662a57e07bf3f0319a00a15dc5c520a172d59672eae24f7999a4535da0b9ee.png" :db/id #edb/ref 17592186392608}] :answer-field/correct {:answer/id #uuid "c796e42f-5eb7-5d3a-900e-6d5fb58916e3" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/fc/fc1d428500558ed62fbf5f7e0c13604cbc759629cedb63a8f9c2f7fc0b412480.png" :db/id #edb/ref 17592186392605} :answer-field/id #uuid "ac8479b0-0f39-5a85-82ad-a7d9ee04b2a6" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186392603}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "c3d5f3e1-0f7f-56ba-9eea-f720be7a7122" :question/math-academy-id "q-48038" :question/problem "Select the function that has a discontinuity at $x=1.$" :question/worked-solution "The correct answer is shown below. Notice that the function contains a break exactly at $x=1$ and it's impossible to draw its graph without taking our pencil off of the paper.\n\n![](images/3c/3c8a198c1ec835590a3d755b964929ef9ac9a30e4268b2fdc80dacdb394899d8.png)\n\nAll the other given graphs can be plotted without taking the pencil off of the paper."}] [{:db/id #edb/ref 17592186329854 :knowledge-point/_questions [{:db/id #edb/ref 17592186068697 :knowledge-point/id #uuid "3f92e521-e7ab-56ba-8eac-0484b140b1a2" :knowledge-point/title "Determining the Behavior of a Function in the Neighborhood of a Point"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0ee867b9-645a-512d-9f99-f3aa8226ad71" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186327063} {:answer/id #uuid "4558acbf-a492-5e1c-acde-0aa26d25d7f5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186327540} {:answer/id #uuid "a58a5f87-8e65-5592-8409-a19f0dfcd0ee" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186328364} {:answer/id #uuid "b013ab09-8aad-54e4-9a17-87cdc1aa5d04" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186328460} {:answer/id #uuid "c6636203-3372-5d9c-9639-986cdeaf7e30" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186328677}] :answer-field/correct {:answer/id #uuid "0ee867b9-645a-512d-9f99-f3aa8226ad71" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186327063} :answer-field/id #uuid "e45de7c6-c5ce-5b9d-a7b8-ea5254d09158" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186329581}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "96069899-bca3-51de-b64c-6e29072ea13e" :question/math-academy-id "q-48062" :question/problem "![](images/d9/d9db7f2a491ae3065dbe8434a71d378c4fed8fec16c82e2fd76dcb209c786809.png)\n\nThe graph of $y=f(x)$ is shown above. Which of the following statements are true? \n\n- $f(x)$ is defined at $x=1$\n- ${lim}_{x\\to \\,1}f(x)$ exists\n- $f(x)$ is continuous at $x=1$" :question/worked-solution "By inspecting the graph, we can conclude the following:\n\n- Statement I is false. From the graph we can see that no value has been assigned to $f(x)$ at $x=1.$\n\n- Statement II is true. Indeed, \n\n$$\n\\begin{aligned}{lim}_{x\\to \\,{1}^{-}}f(x) & =1, \\\\ {lim}_{x\\to \\,{1}^{+}}f(x) & =1.\\end{aligned}\n$$\n\nHence, \n${lim}_{x\\to \\,1}f(x)=1.$\n\n- Statement III is false. The function is not even defined at $x=1.$ The graph contains a break at $x=1.$ It's impossible to draw the graph of $f(x)$ without taking our pencil off of the paper."}] [{:db/id #edb/ref 17592186329855 :knowledge-point/_questions [{:db/id #edb/ref 17592186068697 :knowledge-point/id #uuid "3f92e521-e7ab-56ba-8eac-0484b140b1a2" :knowledge-point/title "Determining the Behavior of a Function in the Neighborhood of a Point"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4f05bd8f-eb2f-57d7-ae18-c11817bd78b7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186327620} {:answer/id #uuid "83335e31-f97c-5df4-863a-ef88150fb6f3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I, II and III" :db/id #edb/ref 17592186328065} {:answer/id #uuid "9a9a91aa-3ed8-5151-bcb5-e59ccd13d6bc" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186328272} {:answer/id #uuid "ce9e8871-1f30-5744-8374-042f56698b0e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186328750} {:answer/id #uuid "d6472410-aa22-5e41-a0c0-09e47c3fb93c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186328811}] :answer-field/correct {:answer/id #uuid "83335e31-f97c-5df4-863a-ef88150fb6f3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I, II and III" :db/id #edb/ref 17592186328065} :answer-field/id #uuid "23e84077-b88d-5119-bcf7-6c45cbfd0278" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186329249}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "1e01edc7-98f4-52fe-bf43-cb1e05ae0d4a" :question/math-academy-id "q-48065" :question/problem "![](images/fa/fa15192923f9fd7370818fcb6b05b24b3bb6901dfbf90dd53539d71fd0f8b0bf.png)\n\nThe graph of $y=f(x)$ is shown above. Which of the following statements are true? \n\n- $f(x)$ is defined at $x=2$\n- ${lim}_{x\\to \\,2}f(x)=f(2)$\n- $f(x)$ is continuous at $x=2$" :question/worked-solution "By inspecting the graph, we can conclude the following:\n\n- Statement I is true. Indeed, $f(x)$ is defined at $x=2$ and $f(2)=1.$\n\n- Statement II is true. Indeed, from the graph we see that\n\n$$\n\\begin{aligned}{lim}_{x\\to \\,{2}^{-}}f(x) & =1, \\\\ {lim}_{x\\to \\,{2}^{+}}f(x) & =1.\\end{aligned}\n$$\n\nHence, ${lim}_{x\\to \\,2}f(x)=1=f(2).$\n\n- Statement III is true. The graph of $f(x)$ can be drawn without taking our pencil off of the paper in the neighborhood of $x=2.$"}] [{:db/id #edb/ref 17592186329858 :knowledge-point/_questions [{:db/id #edb/ref 17592186092382 :knowledge-point/id #uuid "db808f48-6d0c-5b35-9342-b1817df65172" :knowledge-point/title "Calculating the Equation of a Tangent Line to a Curve at a Point"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "02cb37f5-2f1d-5582-9b0a-ba3d5ae84781" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=x-12" :db/id #edb/ref 17592186326967} {:answer/id #uuid "12f35963-b5fb-5ee8-a217-7821558518c7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=4x-3" :db/id #edb/ref 17592186327097} {:answer/id #uuid "29f970a0-530a-5098-9cef-2daea001ef9c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=4x-1" :db/id #edb/ref 17592186327295} {:answer/id #uuid "39dad4a5-4110-5374-97bc-fe41c7c0f5d8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=5x-5" :db/id #edb/ref 17592186327440} {:answer/id #uuid "83d0f077-ab57-54f6-80e1-8b63e8a4c95e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=5x-2" :db/id #edb/ref 17592186328072}] :answer-field/correct {:answer/id #uuid "83d0f077-ab57-54f6-80e1-8b63e8a4c95e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=5x-2" :db/id #edb/ref 17592186328072} :answer-field/id #uuid "324d4519-c59d-5772-95b5-cc69664e41ef" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186329278}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "a5a7a5a2-50a1-5b97-8ac0-810e9082e127" :question/math-academy-id "q-4807" :question/problem "Find the equation of the tangent to the curve $y=2{x}^{2}+x$ at the point $(1,3).$" :question/worked-solution "Let $f(x)=2{x}^{2}+x.$ Computing the derivative ${f}^{′}(x)$ gives\n\n$$\n\\begin{aligned}{f}^{′}(x)=\\frac{\\text{d}}{\\text{d}x}(2{x}^{2}+x)=4x+1.\\end{aligned}\n$$\n\nWe then compute ${f}^{′}(1)$, which gives\n\n$$\n\\begin{aligned}{f}^{′}(1)=4(1)+1=5\\,.\\end{aligned}\n$$\n\nFinally, we use the point-slope form with $m=5$ and the coordinates of our point $(1,3),$ and get\n\n$$\n\\begin{aligned}y-{y}_{1} & =m(x-{x}_{1}) \\\\ y-(3) & =5(x-1) \\\\ y & =5x-5+3 \\\\ y & =5x-2.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186069368 :knowledge-point/_questions [{:db/id #edb/ref 17592186068696 :knowledge-point/id #uuid "31eacf5a-75a5-5b38-8c24-4b1598ecf3a7" :knowledge-point/title "Identifying Points of Discontinuity"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9aa17146-c6c7-5f57-99cb-8b4f88241e1c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$x = 2$ and $x = 0$" :db/id #edb/ref 17592186067379} {:answer/id #uuid "f56223ce-52c2-5805-b123-5b321403e168" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$x = 0$ only" :db/id #edb/ref 17592186067380} {:answer/id #uuid "fe31fb35-056a-5723-b579-c5fcb9207404" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$x = 2$ only" :db/id #edb/ref 17592186067381} {:answer/id #uuid "0f09c3a6-6f34-51bf-9fbc-ff068943f2ad" :answer/type {:db/id #edb/ref 