#{[{:db/id #edb/ref 17592186329715 :knowledge-point/_questions [{:db/id #edb/ref 17592186188222 :knowledge-point/id #uuid "141d61c7-1d82-52fe-b977-19daa910da9b" :knowledge-point/title "Simplifying an Expression by Factoring Alternative Forms of the Secant-Tangent Identity"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "43371a21-e3c4-54a0-9206-f820869cdf7c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{tan}^{4}⁡\\theta " :db/id #edb/ref 17592186327520} {:answer/id #uuid "5b837a3e-7895-581c-9547-40fad30c41d6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186327738} {:answer/id #uuid "7323b252-fad1-5e66-a205-f98c81464280" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-{tan}^{4}⁡\\theta " :db/id #edb/ref 17592186327932} {:answer/id #uuid "a0d1151f-bdbb-5b1c-9ec7-0cc63db29b89" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2{tan}^{2}⁡\\theta " :db/id #edb/ref 17592186328329} {:answer/id #uuid "f467c0f8-8dd0-5354-a064-9d4356dc82bf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{tan}^{2}⁡\\theta " :db/id #edb/ref 17592186329073}] :answer-field/correct {:answer/id #uuid "43371a21-e3c4-54a0-9206-f820869cdf7c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{tan}^{4}⁡\\theta " :db/id #edb/ref 17592186327520} :answer-field/id #uuid "c5d3df98-9ad8-500d-858a-a65793ee1efc" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186329533}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "52f9b951-61b8-5687-9876-13fa3e1021d9" :question/math-academy-id "q-43292" :question/problem "${csc}^{2}⁡\\theta {tan}^{4}⁡\\theta -{sec}^{2}⁡\\theta {sin}^{2}⁡\\theta =$" :question/worked-solution "First, we recall the following identities: \n\n$$\n\\operatorname{tan}⁡\\theta =\\frac{\\operatorname{sin}⁡\\theta }{\\operatorname{cos}⁡\\theta }\\,\\operatorname{sec}⁡\\theta =\\frac{1}{\\operatorname{cos}⁡\\theta }\\,\\operatorname{csc}⁡\\theta =\\frac{1}{\\operatorname{sin}⁡\\theta }\n$$\n\nUsing the above identity, we can simplify our expression as follows:\n\n$$\n\\begin{aligned}{csc}^{2}⁡\\theta {tan}^{4}⁡\\theta -{sec}^{2}⁡\\theta {sin}^{2}⁡\\theta  & =\\frac{1}{{sin}^{2}⁡\\theta }\\frac{{sin}^{4}⁡\\theta }{{cos}^{4}⁡\\theta }-\\frac{1}{{cos}^{2}⁡\\theta }{sin}^{2}⁡\\theta  \\\\  & =\\frac{1}{{sin}^{2}⁡\\theta }\\frac{{sin}^{2}⁡\\theta \\cdot {sin}^{2}⁡\\theta }{{cos}^{4}⁡\\theta }-\\frac{{sin}^{2}⁡\\theta }{{cos}^{2}⁡\\theta } \\\\  & =\\frac{1}{\\cancel{{sin}^{2}⁡\\theta }}\\frac{\\cancel{{sin}^{2}⁡\\theta }\\cdot {sin}^{2}⁡\\theta }{{cos}^{4}⁡\\theta }-\\frac{{sin}^{2}⁡\\theta }{{cos}^{2}⁡\\theta } \\\\  & =\\frac{1}{{cos}^{2}⁡\\theta }\\frac{{sin}^{2}⁡\\theta }{{cos}^{2}⁡\\theta }-\\frac{{sin}^{2}⁡\\theta }{{cos}^{2}⁡\\theta } \\\\  & ={sec}^{2}⁡\\theta {tan}^{2}⁡\\theta -{tan}^{2}⁡\\theta  \\\\  & ={tan}^{2}⁡\\theta ({sec}^{2}⁡\\theta -1)\\end{aligned}\n$$\n\nNext, we recall the different forms of the secant-tangent Identity:\n\n$$\n\\begin{aligned} & (1) & 1+{tan}^{2}⁡\\theta ={sec}^{2}⁡\\theta  \\\\  & (2) & {tan}^{2}⁡\\theta ={sec}^{2}⁡\\theta -1 \\\\  & (3) & {sec}^{2}⁡\\theta -{tan}^{2}⁡\\theta =1\\end{aligned}\n$$\n\nFinally, we can rewrite our expression using $(2),$ as follows:\n\n$$\n\\begin{aligned}{tan}^{2}⁡\\theta ({sec}^{2}⁡\\theta -1) & ={tan}^{2}⁡\\theta \\cdot {tan}^{2}⁡\\theta ={tan}^{4}⁡\\theta \\end{aligned}\n$$\n\nTherefore, we conclude that\n\n$$\n{csc}^{2}⁡\\theta {tan}^{4}⁡\\theta -{sec}^{2}⁡\\theta {sin}^{2}⁡\\theta ={tan}^{4}⁡\\theta .\n$$"}] [{:db/id #edb/ref 17592186329718 :knowledge-point/_questions [{:db/id #edb/ref 17592186059643 :knowledge-point/id #uuid "1bc8c875-3393-5fd6-90cf-87737e16f2f2" :knowledge-point/title "Simplifying a Trigonometric Expression Using a Common Denominator and the Pythagorean Identity"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "16d51a21-90c5-5b54-a6e4-e0b0b8a2ed02" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{sec}⁡t+1" :db/id #edb/ref 17592186327134} {:answer/id #uuid "40320fe3-c500-5dcb-a7c9-96f211e3f18e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{sec}⁡t" :db/id #edb/ref 17592186327498} {:answer/id #uuid "7a98372a-b734-5075-bb5b-a84d747704c2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\operatorname{sec}⁡t-1" :db/id #edb/ref 17592186327984} {:answer/id #uuid "95f2320a-4032-50dc-aeeb-456b3b00cb5f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\operatorname{sec}⁡t+1" :db/id #edb/ref 17592186328238} {:answer/id #uuid "ace65715-85a6-5e2d-ba3b-d82ca77a9505" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\operatorname{sec}⁡t" :db/id #edb/ref 17592186328434}] :answer-field/correct {:answer/id #uuid "40320fe3-c500-5dcb-a7c9-96f211e3f18e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{sec}⁡t" :db/id #edb/ref 17592186327498} :answer-field/id #uuid "34fb1090-54c7-5d88-a697-5bc7387e677b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186329286}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "db749ad3-a154-5aac-9219-0c39bfac704c" :question/math-academy-id "q-43298" :question/problem "$\\operatorname{sin}⁡t(\\frac{\\operatorname{cos}⁡t}{\\operatorname{sin}⁡t}+\\frac{\\operatorname{sin}⁡t}{\\operatorname{cos}⁡t})=$" :question/worked-solution "First, we expand the parentheses:\n\n$$\n\\begin{aligned}\\operatorname{sin}⁡t(\\frac{\\operatorname{cos}⁡t}{\\operatorname{sin}⁡t}+\\frac{\\operatorname{sin}⁡t}{\\operatorname{cos}⁡t}) & =\\operatorname{sin}⁡t\\cdot \\frac{\\operatorname{cos}⁡t}{\\operatorname{sin}⁡t}+\\operatorname{sin}⁡t\\cdot \\frac{\\operatorname{sin}⁡t}{\\operatorname{cos}⁡t} \\\\  & =\\frac{\\operatorname{cos}⁡t\\cdot \\operatorname{sin}⁡t}{\\operatorname{sin}⁡t}+\\frac{{sin}^{2}⁡t}{\\operatorname{cos}⁡t} \\\\  & =\\frac{\\operatorname{cos}⁡t\\cdot \\cancel{\\operatorname{sin}⁡t}}{\\cancel{\\operatorname{sin}⁡t}}+\\frac{{sin}^{2}⁡t}{\\operatorname{cos}⁡t} \\\\  & =\\operatorname{cos}⁡t+\\frac{{sin}^{2}⁡t}{\\operatorname{cos}⁡t}\\end{aligned}\n$$\n\nWe put both terms over a common denominator, and combine the two fractions:\n\n$$\n\\begin{aligned}\\operatorname{cos}⁡\\theta +\\frac{{sin}^{2}⁡t}{\\operatorname{cos}⁡t} & =\\frac{\\operatorname{cos}⁡t}{1}+\\frac{{sin}^{2}⁡t}{\\operatorname{cos}⁡t} \\\\  & =\\frac{\\operatorname{cos}⁡t\\cdot \\operatorname{cos}⁡t}{1\\cdot \\operatorname{cos}⁡t}+\\frac{{sin}^{2}⁡t}{\\operatorname{cos}⁡t} \\\\  & =\\frac{{cos}^{2}⁡t+{sin}^{2}⁡t}{\\operatorname{cos}⁡t}\\end{aligned}\n$$\n\nFinally, we simplify using the Pythagorean identity, as follows:\n\n$$\n\\begin{aligned}\\frac{{cos}^{2}⁡t+{sin}^{2}⁡t}{\\operatorname{cos}⁡t}=\\frac{1}{\\operatorname{cos}⁡t}=\\operatorname{sec}⁡t\\end{aligned}\n$$\n\nTherefore, we conclude that\n\n$$\n\\operatorname{sin}⁡t(\\frac{\\operatorname{cos}⁡t}{\\operatorname{sin}⁡t}+\\frac{\\operatorname{sin}⁡t}{\\operatorname{cos}⁡t})=\\operatorname{sec}⁡t.\n$$"}] [{:db/id #edb/ref 17592186329719 :knowledge-point/_questions [{:db/id #edb/ref 17592186059656 :knowledge-point/id #uuid "e85a2d68-d49f-5bf4-ab62-13ad8c35b0d4" :knowledge-point/title "Simplifying Expression Using an Alternate Form of the Pythagorean Identity"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1d9790e4-77cb-5ff4-ac43-39c78331e808" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{cot}^{2}⁡\\theta " :db/id #edb/ref 17592186327191} {:answer/id #uuid "9939c042-c8aa-5188-bbb4-1c3c3f7a7f48" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{cos}⁡\\theta " :db/id #edb/ref 17592186328257} {:answer/id #uuid "a407281c-48ae-50b3-a5ba-d986468525b5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{cos}⁡\\theta \\operatorname{cot}⁡\\theta " :db/id #edb/ref 17592186328354} {:answer/id #uuid "a8f911ba-6e39-5c15-993b-525d98cd4ba0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1-\\operatorname{cos}⁡\\theta " :db/id #edb/ref 17592186328397} {:answer/id #uuid "e51dd51b-095f-57d7-a137-944306de7d23" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{cos}^{2}⁡\\theta " :db/id #edb/ref 17592186328940}] :answer-field/correct {:answer/id #uuid "a407281c-48ae-50b3-a5ba-d986468525b5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{cos}⁡\\theta \\operatorname{cot}⁡\\theta " :db/id #edb/ref 17592186328354} :answer-field/id #uuid "37d7ae64-5756-5393-953b-b3fac5aef0ce" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186329293}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "3eb8e400-2919-528a-91cb-5d1221ea0b97" :question/math-academy-id "q-43308" :question/problem "Which of the following is equivalent to $(1-\\operatorname{sin}⁡\\theta )(1+\\operatorname{csc}⁡\\theta )?$" :question/worked-solution "First, use the identity $\\operatorname{csc}⁡\\theta =\\frac{1}{\\operatorname{sin}⁡\\theta }:$ \n\n$$\n\\begin{aligned}(1-\\operatorname{sin}⁡\\theta )(1+\\operatorname{csc}⁡\\theta ) & =(1-\\operatorname{sin}⁡\\theta )(1+\\frac{1}{\\operatorname{sin}⁡\\theta }) \\\\  & =(1-\\operatorname{sin}⁡\\theta )(\\frac{\\operatorname{sin}⁡\\theta +1}{\\operatorname{sin}⁡\\theta }) \\\\  & =\\frac{(1-\\operatorname{sin}⁡\\theta )(1+\\operatorname{sin}⁡\\theta )}{\\operatorname{sin}⁡\\theta }\\end{aligned}\n$$\n\nThen, we expand the parentheses in the numerator:\n\n$$\n\\begin{aligned}\\frac{(1-\\operatorname{sin}⁡\\theta )(1+\\operatorname{sin}⁡\\theta )}{\\operatorname{sin}⁡\\theta } & =\\frac{1-{sin}^{2}⁡\\theta }{\\operatorname{sin}⁡\\theta }\\end{aligned}\n$$\n\nNext, we rewrite the numerator using $1-{sin}^{2}⁡\\theta ={cos}^{2}⁡\\theta $ and simplify:\n\n$$\n\\begin{aligned}\\frac{1-{sin}^{2}⁡\\theta }{\\operatorname{sin}⁡\\theta } & =\\frac{{cos}^{2}⁡\\theta }{\\operatorname{sin}⁡\\theta } \\\\  & =\\operatorname{cos}⁡\\theta \\cdot \\frac{\\operatorname{cos}⁡\\theta }{\\operatorname{sin}⁡\\theta } \\\\  & =\\operatorname{cos}⁡\\theta \\operatorname{cot}⁡\\theta .\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186329721 :knowledge-point/_questions [{:db/id #edb/ref 17592186105904 :knowledge-point/id #uuid "cafdb077-0e02-5e7a-bf78-c3a8aacfb6f7" :knowledge-point/title "Calculating an Angle or Side of a Triangle Given the Area of a Triangle"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "55cfe684-dc18-5ab1-b164-6d50fade618a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{45}^{∘}" :db/id #edb/ref 17592186327676} {:answer/id #uuid "8d23ee9d-454e-5907-a98d-d759e11996ed" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{25}^{∘}" :db/id #edb/ref 17592186328151} {:answer/id #uuid "b7359851-720e-5ab4-876a-6265d25f515d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{40}^{∘}" :db/id #edb/ref 17592186328528} {:answer/id #uuid "cf531d87-8a79-5162-b024-e25dc07d7e53" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{30}^{∘}" :db/id #edb/ref 17592186328757} {:answer/id #uuid "e7164a97-e526-5ef2-8ced-7e38b414e248" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{35}^{∘}" :db/id #edb/ref 17592186328954}] :answer-field/correct {:answer/id #uuid "cf531d87-8a79-5162-b024-e25dc07d7e53" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{30}^{∘}" :db/id #edb/ref 17592186328757} :answer-field/id #uuid "fbc9b871-5875-5e5c-8a91-d0aec6bf5882" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186329619}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "55d7cd50-6834-55b6-a52f-4f6d251b49dd" :question/math-academy-id "q-43339" :question/problem "![](images/85/85b13f2236c5f00da34ea71fdbfc967882fa6e66c347f6ef40c0604391a5d68e.png)\n\nThe area of ​​the triangle $△ABC$ is $15{\\text{ cm}}^{2}.$ Find $m∠A.$" :question/worked-solution "The formula for the area of the triangle is \n\n$$\nA=\\frac{1}{2}bc\\operatorname{sin}⁡A,\n$$\n\nwhere $∠A$ is between the sides of lengths $b$ and $c.$ \n\nHere\n\n$$\n\\begin{aligned}c & =AB=5\\,\\text{ cm}, \\\\ b & =AC=12\\,\\text{cm}\\end{aligned}\n$$\n\nTherefore, we can calculate $m∠A$ as follows:\n\n$$\n\\begin{aligned}A & =\\frac{1}{2}\\cdot b\\cdot c\\cdot \\operatorname{sin}⁡A \\\\ 15 & =\\frac{1}{2}\\cdot 12\\cdot 5\\cdot \\operatorname{sin}⁡A \\\\ 15 & =30\\cdot \\operatorname{sin}⁡A \\\\ \\frac{15}{30} & =\\operatorname{sin}⁡A \\\\ \\operatorname{sin}⁡A & =\\frac{1}{2} \\\\ m∠A & ={30}^{∘}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186329723 :knowledge-point/_questions [{:db/id #edb/ref 17592186129122 :knowledge-point/id #uuid "1eeb42af-74ee-53d7-af9f-be171f77968f" :knowledge-point/title "Calculating the Period of a Transformed Sinusoidal Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0f720e8d-bb1b-59ca-9ab6-dc161291bf7c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{60}^{∘}" :db/id #edb/ref 17592186327071} {:answer/id #uuid "5fc7ca04-3dfc-5466-a866-a199437da7e3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{30}^{∘}" :db/id #edb/ref 17592186327775} {:answer/id #uuid "7851f496-18f4-5ce9-b27a-0a6147c6176e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{45}^{∘}" :db/id #edb/ref 17592186327963} {:answer/id #uuid "85974f52-6385-50ae-a81b-e8bc2b19d899" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{15}^{∘}" :db/id #edb/ref 17592186328085} {:answer/id #uuid "dfb14292-bdff-5641-bc24-4dffec7b4e6f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{75}^{∘}" :db/id #edb/ref 17592186328894}] :answer-field/correct {:answer/id #uuid "7851f496-18f4-5ce9-b27a-0a6147c6176e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{45}^{∘}" :db/id #edb/ref 17592186327963} :answer-field/id #uuid "c2a5f161-27b6-5dd4-aa10-c1cb6123c7a0" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186329527}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "72d5418e-aa83-5e26-b56d-9365871c6a6c" :question/math-academy-id "q-43411" :question/problem "What is the period of the function $f(x)=\\operatorname{cos}⁡(8x+{90}^{∘})?$" :question/worked-solution "Given a function in the form $y=A\\operatorname{cos}⁡(Bx+C)+D,$ the period is ${360}^{∘}.$\n\nIn our case, we have that $B=8.$ Therefore, the period is $\\frac{{360}^{∘}}{8}={45}^{∘}.$"}] [{:db/id #edb/ref 17592186111178 :knowledge-point/_questions [{:db/id #edb/ref 17592186110553 :knowledge-point/id #uuid "03491655-9b81-5fc0-bf20-e4f74a9c72ad" :knowledge-point/title "Simplifying an Expression Using the Secant-Tangent Identity: Replacing a Squared Tangent"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3181638b-4d66-589a-b061-04d74bf07e12" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186327372} {:answer/id #uuid "4fd3b151-608d-541d-b9c4-1224e1328c24" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186327630} {:answer/id #uuid "584096c0-c59b-5b5c-802a-e72a377ffdcd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2{sec}^{2}⁡\\theta " :db/id #edb/ref 17592186327708} {:answer/id #uuid "5b36cc0f-2f9f-59d1-bc2e-d088509a383f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\operatorname{sec}⁡\\theta " :db/id #edb/ref 17592186327734} {:answer/id #uuid "9b4c20ff-9024-5eb1-89f9-dc0efac40673" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186328278}] :answer-field/correct {:answer/id #uuid "4fd3b151-608d-541d-b9c4-1224e1328c24" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186327630} :answer-field/id #uuid "bac4f7c2-82a2-5f28-8ff9-2ad956252386" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186329515}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "a581c5d1-c937-510f-8cbd-8478ab152d79" :question/math-academy-id "q-43617" :question/problem "$\\frac{1+{tan}^{2}⁡\\theta }{{sec}^{2}⁡\\theta }=$" :question/worked-solution "First, let's recall the secant-tangent identity:\n\n$$\n1+{tan}^{2}⁡\\theta ={sec}^{2}⁡\\theta \n$$\n\nWe rewrite the given expression using the secant-tangent identity as follows:\n\n$$\n\\begin{aligned}\\frac{1+{tan}^{2}⁡\\theta }{{sec}^{2}⁡\\theta } & =\\frac{{sec}^{2}⁡\\theta }{{sec}^{2}⁡\\theta } \\\\  & =\\frac{\\cancel{{sec}^{2}⁡\\theta }}{\\cancel{{sec}^{2}⁡\\theta }} \\\\  & =1\\end{aligned}\n$$\n\nTherefore, we conclude that\n\n$$\n\\frac{1+{tan}^{2}⁡\\theta }{{sec}^{2}⁡\\theta }=1.\n$$"}] [{:db/id #edb/ref 17592186392554 :knowledge-point/_questions [{:db/id #edb/ref 17592186110585 :knowledge-point/id #uuid "46e1513d-0944-5c09-8a7e-e1d9ae81bae5" :knowledge-point/title "Graphing the Inverse Tangent Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "704dd449-03cc-5cb5-8d71-9633864418fd" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/90/901cc06ce7661348fa18bb172f0a014e0c0d49e6f0a788cfe5926faa6e3061b0.png" :db/id #edb/ref 17592186392556} {:answer/id #uuid "ab422978-41b5-5448-9e5c-293965809dac" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/b2/b2939d0005167bb5771d7a566af50eff3c0d595ff95666d97d0d52597518f814.png" :db/id #edb/ref 17592186392557} {:answer/id #uuid "537f4564-f5f1-5ad4-9cdb-0876e35602eb" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/d7/d7984b9098d02bfc2b1e9a422aef919533abce54fbb94117e709c7613b0870a3.png" :db/id #edb/ref 17592186392558} {:answer/id #uuid "3969e61c-1862-53e5-8d39-b6a5cccbc85b" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/7a/7aadddedfe33accf816c81268b8873d02a324034e6ab26bdbfa9895989e7e63e.png" :db/id #edb/ref 17592186392559} {:answer/id #uuid "99f07ab8-6830-58b2-8709-6db297f0d693" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/e7/e7aff749f5804fb774a334918b62ff9f20fd8e384fcebbc372e811ce51729d4a.png" :db/id #edb/ref 17592186392560}] :answer-field/correct {:answer/id #uuid "537f4564-f5f1-5ad4-9cdb-0876e35602eb" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/d7/d7984b9098d02bfc2b1e9a422aef919533abce54fbb94117e709c7613b0870a3.png" :db/id #edb/ref 17592186392558} :answer-field/id #uuid "51b945ad-4e83-57d3-875d-408d14586c43" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186392555}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "e78d2563-d22e-5b86-b89f-f6aab65d4ec5" :question/math-academy-id "q-43659" :question/problem "What is the graph of $y=\\operatorname{arctan}⁡x?$" :question/worked-solution "Let's recall some of the basic properties of $y=\\operatorname{arctan}⁡x:$\n\n- The domain is all real numbers.\n\n- There is a zero at $x=0.$\n\n- The function is negative over $(-\\infty ,0)$ and positive over $(0,\\infty ).$\n\n- The function is strictly increasing in its entire domain.\n\n- $y\\to -\\frac{\\pi }{2}$ (from above) as $x\\to -\\infty .$\n\n- $y\\to \\frac{\\pi }{2}$ (from below) as $x\\to \\infty .$\n\n- The lines $y=\\pm \\frac{\\pi }{2}$ are horizontal asymptotes of the function.\n\nOf the given functions, the only one that has all of these properties is as follows:\n\n![](images/d7/d7984b9098d02bfc2b1e9a422aef919533abce54fbb94117e709c7613b0870a3.png)"}] [{:db/id #edb/ref 17592186329753 :knowledge-point/_questions [{:db/id #edb/ref 17592186175922 :knowledge-point/id #uuid "ae4289af-e251-514c-981e-5c6d21992ad3" :knowledge-point/title "Finding the Equation of a Perpendicular Line"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7e922a42-6deb-5bc6-a4f2-a8d06f3fea60" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=2x+6" :db/id #edb/ref 17592186328024} {:answer/id #uuid "d59f7611-aece-5245-9299-86b545be9496" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=-\\frac{1}{2}x+6" :db/id #edb/ref 17592186328803} {:answer/id #uuid "dd0e28cc-1799-536e-bd55-0a06dc16bb67" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=\\frac{1}{2}x" :db/id #edb/ref 17592186328867} {:answer/id #uuid "de5640a4-5333-5d9b-b991-e89e51fe95ab" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=-6x-2" :db/id #edb/ref 17592186328881} {:answer/id #uuid "ed73643a-713f-5f7a-aea6-c63401f50949" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=-2x+6" :db/id #edb/ref 17592186329014}] :answer-field/correct {:answer/id #uuid "d59f7611-aece-5245-9299-86b545be9496" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=-\\frac{1}{2}x+6" :db/id #edb/ref 17592186328803} :answer-field/id #uuid "2512d590-4b14-5e67-bd6c-bb6c4cebbb08" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186329251}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "36e2ce70-a218-5096-a57b-5f93338562ee" :question/math-academy-id "q-44337" :question/problem "![](images/c9/c9c426e75153bd893e3dbef39bd8a837991d8c3ec6a48b41aeb27df6c4250660.png)\n\nIn the diagram above, the equation of the line ${l}_{1}$ is $y=2x-1$ and ${l}_{2}$ is perpendicular to ${l}_{1}.$ What is the equation of the line ${l}_{2}?$" :question/worked-solution "Since perpendicular lines have slopes that are negative reciprocals of each other, the slope of ${l}_{2}$ is the negative reciprocal of the slope of ${l}_{1}.$ Since ${l}_{1}$ has a slope of $2,$ the line ${l}_{2}$ must have a slope of $-\\frac{1}{2}.$\n\nOur perpendicular line must have the slope $m=-\\frac{1}{2}$ and a $y$-intercept of $6.$ Therefore, it can be written in slope-intercept form as\n\n$$\ny=-\\frac{1}{2}x+6.\n$$"}] [{:db/id #edb/ref 17592186111184 :knowledge-point/_questions [{:db/id #edb/ref 17592186110600 :knowledge-point/id #uuid "e732f270-1d6f-5ff8-8792-d9b329ea858d" :knowledge-point/title "Determining Whether Two Lines in Standard Form are Perpendicular"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "04aa8a38-9ecc-5e87-9899-fa2c52620615" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=5x-4" :db/id #edb/ref 17592186326982} {:answer/id #uuid "2a0d4423-cdbd-59bc-9519-c02229ca242c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=-x+1" :db/id #edb/ref 17592186327296} {:answer/id #uuid "842c8b78-fb24-5dfb-9556-59ef1eff7a4f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=\\frac{1}{5}x-6" :db/id #edb/ref 17592186328076} {:answer/id #uuid "8f307607-46e6-546c-b68f-66ba5c7a0d68" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=-\\frac{1}{5}x+15" :db/id #edb/ref 17592186328184} {:answer/id #uuid "b9b36271-f849-5b31-8979-398e7e127d62" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=-5x-1" :db/id #edb/ref 17592186328554}] :answer-field/correct {:answer/id #uuid "04aa8a38-9ecc-5e87-9899-fa2c52620615" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=5x-4" :db/id #edb/ref 17592186326982} :answer-field/id #uuid "637a8d42-8d66-59a6-9b11-fb936c324619" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186329359}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "f8ebc497-48a2-5b22-a14f-221db06dd5d2" :question/math-academy-id "q-44404" :question/problem "Which of the following lines is perpendicular to $x+5y=10?$" :question/worked-solution "For the two lines to be perpendicular, their slopes must multiply to $-1.$\n\nTo find the slope of the given line $x+5y=10,$ we convert to slope-intercept form:\n\n$$\n\\begin{aligned}x+5y & =10 \\\\ 5y & =-x+10 \\\\ y & =-\\frac{1}{5}x+2\\end{aligned}\n$$\n\nIn slope-intercept form, the slope is the $x$-coefficient. So, the slope of the given line is $-\\frac{1}{5}.$\n\nLooking at the answer choices, the line $y=5x-4$ has a slope of $5.$\n\nMultiplying the slopes together, we have\n\n$$\n(-\\frac{1}{5})\\cdot 5=-1.\n$$\n\nSince the slopes multiply to $-1,$ we conclude that the line $y=5x-4$ is perpendicular to the given line."}] [{:db/id #edb/ref 17592186329754 :knowledge-point/_questions [{:db/id #edb/ref 17592186110601 :knowledge-point/id #uuid "6f3d7d62-686b-59c4-9ea1-695c6be3180b" :knowledge-point/title "Determining Unknown Parameters Given Two Perpendicular Lines"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7c5cea50-fecb-5d5b-8a89-f4f34d327f19" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186328005} {:answer/id #uuid "7f3ca05e-2e03-5005-8439-1e9b0e51d16a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-6" :db/id #edb/ref 17592186328028} {:answer/id #uuid "d0d0efcf-7b5d-51ae-a082-657d77e63c13" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{6}" :db/id #edb/ref 17592186328768} {:answer/id #uuid "df927e48-fbac-512c-b73b-41214fbca6fb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{2}" :db/id #edb/ref 17592186328892} {:answer/id #uuid "e4e47ca3-6ef9-5cec-9235-9aa609798010" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{3}{2}" :db/id #edb/ref 17592186328939}] :answer-field/correct {:answer/id #uuid "7f3ca05e-2e03-5005-8439-1e9b0e51d16a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-6" :db/id #edb/ref 17592186328028} :answer-field/id #uuid "4e4084a6-ffaf-52c0-9e02-59ab5e2b3839" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186329328}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "fa337919-23eb-5736-a04b-9af0d92af77d" :question/math-academy-id "q-44407" :question/problem "The lines $4x-8y=7$ and $3y-px=9$ are perpendicular. The value of $p=$" :question/worked-solution "For the two lines to be perpendicular, their slopes must multiply to $-1.$\n\nTo find the slope of $4x-8y=7,$ we convert to slope-intercept form:\n\n$$\n\\begin{aligned}4x-8y & =7 \\\\ -8y & =-4x+7 \\\\ 8y & =4x-7 \\\\ y & =\\frac{1}{2}x-\\frac{7}{8}\\end{aligned}\n$$\n\nTo find the slope of $3y-px=9,$ we convert to slope-intercept form:\n\n$$\n\\begin{aligned}3y-px & =9 \\\\ 3y & =px+9 \\\\ y & =\\frac{p}{3}x+3\\end{aligned}\n$$\n\nTherefore:\n\n- The slope of the line $4x-8y=7$ is $\\frac{1}{2}.$\n\n- The slope of the line $3y-px=9$ is $\\frac{p}{3}.$\n\nMultiplying the slopes together, we have\n\n$$\n\\frac{1}{2}\\cdot \\frac{p}{3}=-1\\,⟹\\,p=-6.\n$$"}] [{:db/id #edb/ref 17592186329760 :knowledge-point/_questions [{:db/id #edb/ref 17592186110602 :knowledge-point/id #uuid "a6fee8d5-e1f7-599d-a74c-abc44d973065" :knowledge-point/title "Finding Equations of Perpendicular Horizontal and Vertical Lines"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "15a5593e-d6ed-5927-b3a1-d1daf628097e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=-7" :db/id #edb/ref 17592186327122} {:answer/id #uuid "30c1bcff-f9d0-5c30-91f5-4ef435a4a0c0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=-9" :db/id #edb/ref 17592186327366} {:answer/id #uuid "76680e20-3119-50e8-b90e-149dee6da095" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=-7" :db/id #edb/ref 17592186327947} {:answer/id #uuid "9aeb19e0-e051-568b-87f4-243574507bc2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=5" :db/id #edb/ref 17592186328276} {:answer/id #uuid "b5707a21-7927-57dc-8dfb-375cdb25c534" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=-9" :db/id #edb/ref 17592186328513}] :answer-field/correct {:answer/id #uuid "15a5593e-d6ed-5927-b3a1-d1daf628097e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=-7" :db/id #edb/ref 17592186327122} :answer-field/id #uuid "b1cd0532-96ff-5c54-9e68-ab598a48b1e0" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186329496}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "30c4eaa9-084c-53b2-8078-d461a7041d34" :question/math-academy-id "q-44691" :question/problem "Determine the equation of the line that passes through the point $(-7,-9)$ and is perpendicular to $y=5.$" :question/worked-solution "Since the line $y=5$ is a horizontal line, a perpendicular line would need to be vertical. So, the perpendicular line must take the form $x=k$ for some value of $k.$\n\nThe perpendicular line needs to go through the point $(-7,-9),$ which has an $x$-coordinate of $-7.$ So, the perpendicular line is $x=-7.$"}] [{:db/id #edb/ref 17592186392568 :knowledge-point/_questions [{:db/id #edb/ref 17592186068687 :knowledge-point/id #uuid "b3ff37f0-6e45-5da4-ac87-1b93c8df3e80" :knowledge-point/title "Representing Solutions of Compound Inequalities on Number Lines"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f2430143-e3ef-56c0-9f1f-964a44b1fe36" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/91/91ec8574742229a2c7fd5af8920f9137e2b25e28a6f02a7cf1edcc8a4db4b6d5.png" :db/id #edb/ref 17592186392570} {:answer/id #uuid "42638bec-e49e-5814-a427-d1911ca95c41" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/1a/1a3b83780bbd15328077dc45eef965aaf311e704990ee3cb45078d76c96183a2.png" :db/id #edb/ref 17592186392571} {:answer/id #uuid "304db39b-9fd8-57ff-a43e-494c6882a179" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/c8/c8c019b0d7a2b34e9791394ce1ac50f8db22b1d7fb9296a8c119a80a583d63ef.png" :db/id #edb/ref 17592186392572} {:answer/id #uuid "2102c409-a8fd-5bbe-a29f-a0866257c255" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/d3/d3ff8ace8f19f48631b57968c7aad223613e65f5be6f67a3196bd5fa9158ae51.png" :db/id #edb/ref 17592186392573} {:answer/id #uuid "95f7974a-4774-510c-92d0-7a4e59b60df1" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/5a/5a8e25a0a97ec193574fd8099e2dfdce70ed887e9f527b855b1ca0957ae7885b.png" :db/id #edb/ref 17592186392574}] :answer-field/correct {:answer/id #uuid "f2430143-e3ef-56c0-9f1f-964a44b1fe36" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/91/91ec8574742229a2c7fd5af8920f9137e2b25e28a6f02a7cf1edcc8a4db4b6d5.png" :db/id #edb/ref 17592186392570} :answer-field/id #uuid "fe31165c-2ea1-57a8-ac77-e3f03a131397" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186392569}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "e996239f-cafe-55a4-9e1e-af5edfdca48f" :question/math-academy-id "q-44761" :question/problem "Which of the following number lines gives the solution to $-1<-5x-6<4?$" :question/worked-solution "We isolate $x$ by applying the addition and multiplication principles, as usual:\n\n$$\n\\begin{aligned}-1 & <-5x-6<4 \\\\ -1+6 & <-5x-6+6<4+6 \\\\ 5 & <-5x<10\\end{aligned}\n$$\n\nAt this point, we need to divide by $-5.$ However, because we are dividing by a negative, we also need to flip the signs of the inequalities.\n\n$$\n\\begin{aligned}5 & <-5x<10 \\\\ \\frac{5}{-5} & >\\frac{-5x}{-5}>\\frac{10}{-5} \\\\ -1 & >x>-2\\end{aligned}\n$$\n\nThe solution can be written as $-1>x>-2$, but this is somewhat difficult to read because the larger number is on the left rather than the right. So, we will rewrite the solution by reversing the order of the numbers: \n\n$$\n-2<x<-1\n$$\n\nWe can represent this solution using a number line, as follows.\n\n![](images/91/91ec8574742229a2c7fd5af8920f9137e2b25e28a6f02a7cf1edcc8a4db4b6d5.png)"}] [{:db/id #edb/ref 17592186329766 :knowledge-point/_questions [{:db/id #edb/ref 17592186129094 :knowledge-point/id #uuid "eac988ba-ea97-52c7-90a7-d451ee7f49e5" :knowledge-point/title "Finding the Intervals on Which a Rational Function Is Continuous"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "184cb986-356b-5b99-a26d-3c28037cbf9b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-2,\\infty )" :db/id #edb/ref 17592186327143} {:answer/id #uuid "229a8b7a-fb69-51c8-9752-e403414ceb1f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-\\infty ,2)\\cup [2,\\infty )" :db/id #edb/ref 17592186327233} {:answer/id #uuid "4b9f6c3f-8609-5e1f-ae1c-e5a050990595" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-\\infty ,-2)\\cup (-2,\\infty )" :db/id #edb/ref 17592186327596} {:answer/id #uuid "7ae44e58-9700-5cdf-bf75-0cbc7d570e5a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(2,\\infty )" :db/id #edb/ref 17592186327991} {:answer/id #uuid "efcfb790-d29a-5a46-b95a-2182bff9ba84" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-\\infty ,-2]\\cup (-2,\\infty )" :db/id #edb/ref 17592186329028}] :answer-field/correct {:answer/id #uuid "4b9f6c3f-8609-5e1f-ae1c-e5a050990595" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-\\infty ,-2)\\cup (-2,\\infty )" :db/id #edb/ref 17592186327596} :answer-field/id #uuid "02a29085-f6a5-57a6-b07d-857f7c485ce9" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186329190}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "abf06e7d-1262-50fe-8aac-916db45605bd" :question/math-academy-id "q-4561" :question/problem "Determine the largest union of intervals on which the function $f(x)=\\frac{{x}^{2}}{2x+4}$ is continuous." :question/worked-solution "This is a rational function, so it is continuous at all points in its domain. To find its domain, we start by factoring the denominator:\n\n$$\n\\begin{aligned}f(x) & =\\frac{{x}^{2}}{2x+4} \\\\  & =\\frac{{x}^{2}}{2(x+2)}\\end{aligned}\n$$\n\n \n\nThis function is continuous everywhere except at the excluded point $x=-2.$\n\nTherefore, the domain consists of the union of the intervals $(-\\infty ,-2)$ and $(-2,\\infty ),$ namely\n\n$$\n(-\\infty ,-2)\\cup (-2,\\infty )\n$$\n\nand the function is also continuous on this union of intervals."}] [{:db/id #edb/ref 17592186329768 :knowledge-point/_questions [{:db/id #edb/ref 17592186100994 :knowledge-point/id #uuid "8e9df1ae-8176-555b-987d-94773c27d435" :knowledge-point/title "Finding the Radius of a Circle on the Coordinate Plane Using the Distance Formula"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1f69a451-fc1a-53c3-99ba-8794adb192de" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186327206} {:answer/id #uuid "336a30a2-8421-5c3f-9236-26d06f04d9ba" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3\\sqrt{5}" :db/id #edb/ref 17592186327378} {:answer/id #uuid "339042f1-7a53-52e5-9e12-f3fd477136df" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{5}" :db/id #edb/ref 17592186327381} {:answer/id #uuid "5620faab-8634-5c06-8781-d34feae4212a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\sqrt{5}" :db/id #edb/ref 17592186327679} {:answer/id #uuid "a6b816b2-1418-5f58-be00-510d1833ac0b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186328380}] :answer-field/correct {:answer/id #uuid "339042f1-7a53-52e5-9e12-f3fd477136df" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{5}" :db/id #edb/ref 17592186327381} :answer-field/id #uuid "e7cc9205-adbc-534f-bd1f-78044226c4d1" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186329585}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "1784a5ba-0bb5-56cc-a185-96af988fd7de" :question/math-academy-id "q-45759" :question/problem "The points $A$ and $B$ have coordinates $(0,-3)$ and $(4,-5)$, respectively, and the segment $\\overset{―}{AB}$ is a diameter of a circle. Find the radius of the circle." :question/worked-solution "The diameter can be calculated using the distance formula: \n\n$$\n\\begin{aligned}d & =\\sqrt{{({x}_{1}-{x}_{2})}^{2}+{({y}_{1}-{y}_{2})}^{2}} \\\\  & =\\sqrt{{(4-0)}^{2}+(-5-(-3))^{2}} \\\\  & =\\sqrt{{4}^{2}+{(-2)}^{2}} \\\\  & =\\sqrt{16+4} \\\\  & =2\\sqrt{5}.\\end{aligned}\n$$\n\nThe radius is half the diameter:\n\n$$\nr=\\frac{d}{2}=\\frac{2\\sqrt{5}}{2}=\\sqrt{5}\n$$"}] [{:db/id #edb/ref 17592186329770 :knowledge-point/_questions [{:db/id #edb/ref 17592186129082 :knowledge-point/id #uuid "98d6004a-547a-5b0b-9748-9571cc3ee632" :knowledge-point/title "Computing a Tangent or Cotangent Using the Pythagorean Identity"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0697fb32-13a8-5152-929c-1cbc92697a41" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{4\\sqrt{5}}{12}" :db/id #edb/ref 17592186326990} {:answer/id #uuid "29cbd9c5-1f6a-5f93-bfe0-6e1833448eef" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{25}{12}" :db/id #edb/ref 17592186327292} {:answer/id #uuid "5f59d2b0-87ec-535c-98db-46f721956829" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5\\sqrt{5}}{12}" :db/id #edb/ref 17592186327771} {:answer/id #uuid "875b0e21-3bdb-537e-83a7-6070520501cf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{25}{12}" :db/id #edb/ref 17592186328098} {:answer/id #uuid "8c78c851-07e7-51bc-a294-83ea44fc4afa" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{5\\sqrt{5}}{12}" :db/id #edb/ref 17592186328139}] :answer-field/correct {:answer/id #uuid "29cbd9c5-1f6a-5f93-bfe0-6e1833448eef" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{25}{12}" :db/id #edb/ref 17592186327292} :answer-field/id #uuid "6067e08a-a253-5424-8dcb-5049856ea945" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186329354}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "c5295f76-3e41-52a4-88d5-2769f2995c21" :question/math-academy-id "q-45875" :question/problem "If $\\operatorname{csc}⁡\\theta =\\frac{5}{3}$ and $\\frac{\\pi }{2}<\\theta <\\pi $ then what is the value of $\\operatorname{tan}⁡\\theta +\\operatorname{cot}⁡\\theta ?$" :question/worked-solution "As $\\operatorname{csc}⁡\\theta =\\frac{5}{3}$ then $\\operatorname{sin}⁡\\theta =\\frac{1}{\\operatorname{csc}⁡\\theta }=\\frac{3}{5}.$\n\nLet's sketch our angle $\\theta $ in the coordinate plane.\n\n![](images/aa/aaba5af0542d29ef91d4b0e17907a81e32bccc402c48b32c205e7298630b5bc0.png)\n\nWe're given that $\\operatorname{sin}⁡\\theta =\\frac{3}{5}$ We can use the Pythagorean identity to find $\\operatorname{cos}⁡\\theta :$\n\n$$\n\\begin{aligned}{sin}^{2}⁡\\theta +{cos}^{2}⁡\\theta  & =1 \\\\ {cos}^{2}⁡\\theta  & =1-{sin}^{2}⁡\\theta  \\\\ \\operatorname{cos}⁡\\theta  & =\\pm \\sqrt{1-{sin}^{2}⁡\\theta }\\end{aligned}\n$$\n\nSubstituting $\\operatorname{sin}⁡\\theta =\\frac{3}{5}$ gives\n\n$$\n\\begin{aligned}\\operatorname{cos}⁡\\theta  & =\\pm \\sqrt{1-{(\\frac{3}{5})}^{2}} \\\\  & =\\pm \\sqrt{1-\\frac{9}{25}} \\\\  & =\\pm \\sqrt{\\frac{16}{25}} \\\\  & =\\pm \\frac{4}{5}.\\end{aligned}\n$$\n\nWe select the negative answer since $\\operatorname{cos}⁡\\theta $ is negative in the second quadrant. So, $\\operatorname{cos}⁡\\theta =-\\frac{4}{5}.$\n\nFinally, knowing that $\\operatorname{cot}⁡\\theta =\\frac{\\operatorname{cos}⁡\\theta }{\\operatorname{sin}⁡\\theta },$ and $\\operatorname{tan}⁡\\theta =\\frac{\\operatorname{sin}⁡\\theta }{\\operatorname{cos}⁡\\theta }$ we have:\n\n- $\\operatorname{cot}⁡\\theta =\\frac{(-\\frac{4}{5})}{(\\frac{3}{5})}=-\\frac{4}{3}$\n\n- $\\operatorname{tan}⁡\\theta =\\frac{(\\frac{3}{5})}{(-\\frac{4}{5})}=-\\frac{3}{4}.$\n\nFinally, we have\n\n$\\operatorname{tan}⁡\\theta +\\operatorname{cot}⁡\\theta =-\\frac{4}{3}-\\frac{3}{4}=-\\frac{25}{12}.$"}] [{:db/id #edb/ref 17592186329783 :knowledge-point/_questions [{:db/id #edb/ref 17592186083235 :knowledge-point/id #uuid "2de6dbad-0ca5-5a17-a04b-cdfd72d6dab5" :knowledge-point/title "Factoring an Expression Containing a Sum of Squares"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2a1351ff-6581-5cc5-90e7-dd06f6e8c14b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-4(5+3\\text{i}m)(5-3\\text{i}m)" :db/id #edb/ref 17592186327297} {:answer/id #uuid "80b6fe9e-0506-5dda-971f-dc0d61ec4a3f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-(3+5\\text{i}m)(3-5\\text{i}m)" :db/id #edb/ref 17592186328042} {:answer/id #uuid "8d7c8efa-e9ed-5427-9384-353a1c64efa7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-(5+3\\text{i}m)(5-3\\text{i}m)" :db/id #edb/ref 17592186328157} {:answer/id #uuid "9cc57fa3-bb89-5a7a-bd30-97bbd6466a0e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-5(3+4\\text{i}m)(3-4\\text{i}m)" :db/id #edb/ref 17592186328287} {:answer/id #uuid "d3280bbc-cdd4-5168-adda-2abb101ed90e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-5(4+3\\text{i}m)(4-3\\text{i}m)" :db/id #edb/ref 17592186328788}] :answer-field/correct {:answer/id #uuid "2a1351ff-6581-5cc5-90e7-dd06f6e8c14b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-4(5+3\\text{i}m)(5-3\\text{i}m)" :db/id #edb/ref 17592186327297} :answer-field/id #uuid "5c8abfda-8c32-53b8-bdc8-9bf64abd97ce" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186329350}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "54d3d1e2-2e59-5152-a868-718f646fc4f9" :question/math-academy-id "q-46507" :question/problem "The expression $-100-36{m}^{2}$ is equivalent to" :question/worked-solution "First, let's factor out $-4$ from the expression. We have\n\n$$\n-100-36{m}^{2}=-4(25+9{m}^{2}).\n$$\n\nLet's now focus on factoring the expression $(25+9{m}^{2}).$\n\nTo factor a sum of squares, we first write it as a difference. Then, we rewrite the second term using ${\\text{i}}^{2}=-1.$ Finally, we factor as a difference of squares.\n\n$$\n\\begin{aligned}25+9{m}^{2} & =25-(-9{m}^{2}) \\\\  & =25-(9{\\text{i}}^{2}{m}^{2}) \\\\  & ={5}^{2}-{(3\\text{i}m)}^{2} \\\\  & =(5+3\\text{i}m)(5-3\\text{i}m)\\end{aligned}\n$$\n\nFinally, substituting this back into the expression, we get\n\n$$\n-4(25+9{m}^{2})=-4(5+3\\text{i}m)(5-3\\text{i}m).\n$$"}] [{:db/id #edb/ref 17592186329785 :knowledge-point/_questions [{:db/id #edb/ref 17592186083248 :knowledge-point/id #uuid "b2478305-485c-53a6-9d6c-a72e0764dd4e" :knowledge-point/title "Finding a Quadratic Polynomial Given Two Real Roots and a Leading Coefficient"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2d53f205-3f13-5653-97f7-16a13fccb6b5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{t}^{2}-25" :db/id #edb/ref 17592186327333} {:answer/id #uuid "2e0027e4-9313-5ed2-941a-ed87cac9171d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4{t}^{2}+100" :db/id #edb/ref 17592186327346} {:answer/id #uuid "97aead54-9510-5fc5-aa9f-eeb7b75426e3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4{t}^{2}-25" :db/id #edb/ref 17592186328249} {:answer/id #uuid "bb42db12-58ef-5359-a1c1-28a86be9c910" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4{t}^{2}-100" :db/id #edb/ref 17592186328567} {:answer/id #uuid "cb0f7336-c824-5328-b9af-5399374350f9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{t}^{2}+25" :db/id #edb/ref 17592186328713}] :answer-field/correct {:answer/id #uuid "bb42db12-58ef-5359-a1c1-28a86be9c910" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4{t}^{2}-100" :db/id #edb/ref 17592186328567} :answer-field/id #uuid "9e7458a1-7227-5719-a279-7114bb1314ad" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186329449}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "5c80b75c-c4ac-520f-a68d-126d07fda083" :question/math-academy-id "q-46582" :question/problem "The quadratic polynomial $P(t)$ has roots ${t}_{1}=-5,{t}_{2}=5,$ and the coefficient of the quadratic term is $4.$ Find $P(t).$" :question/worked-solution "Since our quadratic polynomial has roots ${t}_{1}=-5$ and ${t}_{2}=5,$ and the coefficient of the quadratic term is $a=4,$ we can write the polynomial as follows:\n\n$$\n\\begin{aligned}a(t-{t}_{1})(t-{t}_{2}) & =(4)(t-(-5))(t-5) \\\\  & =4(t+5)(t-5)\\end{aligned}\n$$\n\nExpanding the parentheses, we obtain\n\n$$\n\\begin{aligned}4(t+5)(t-5) & =4({t}^{2}-25) \\\\  & =4{t}^{2}-100.\\end{aligned}\n$$\n\nTherefore, $P(t)=4{t}^{2}-100.$"}] [{:db/id #edb/ref 17592186329786 :knowledge-point/_questions [{:db/id #edb/ref 17592186083237 :knowledge-point/id #uuid "4b0262c8-c029-5a72-846b-1b4f4f3306ba" :knowledge-point/title "Finding a Quadratic Polynomial Given a Double Root and a Leading Coefficient"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "01e9cc2a-2e40-5eac-8225-9a3647af4013" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3{y}^{2}-18y-27" :db/id #edb/ref 17592186326953} {:answer/id #uuid "397d37fa-9c19-5957-8545-f3e9c8b2907e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3{y}^{2}-18y+27" :db/id #edb/ref 17592186327435} {:answer/id #uuid "6c86f783-35aa-5013-881b-97dcb72fefca" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3{y}^{2}-9y-27" :db/id #edb/ref 17592186327870} {:answer/id #uuid "bdba8a19-4868-5b73-b78a-b2f2642ee9f6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3{y}^{2}-9y+27" :db/id #edb/ref 17592186328591} {:answer/id #uuid "d9689658-04a0-54b7-9816-4e531d6a63dc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3{y}^{2}-24y+27" :db/id #edb/ref 17592186328834}] :answer-field/correct {:answer/id #uuid "397d37fa-9c19-5957-8545-f3e9c8b2907e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3{y}^{2}-18y+27" :db/id #edb/ref 17592186327435} :answer-field/id #uuid "2d4f3164-f7c0-5641-841e-102bb0a49284" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186329265}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "d6f211f1-c9b6-5172-aa3d-db8224b3a9c4" :question/math-academy-id "q-46588" :question/problem "The quadratic polynomial $P(y)$ has the double root ${y}_{1}={y}_{2}=3,$ and the coefficient of the quadratic term is $a=3.$ Find $P(y).$" :question/worked-solution "Since our quadratic polynomial has the double root ${y}_{1}={y}_{2}=3,$ and the coefficient of the quadratic term is $a=3,$ we can write the polynomial as follows:\n\n$$\n\\begin{aligned}a(y-{y}_{1})^{2} & =3{(y-3)}^{2}\\end{aligned}\n$$\n\nExpanding the parentheses, we obtain\n\n$$\n\\begin{aligned}3{(y-3)}^{2} & =3({y}^{2}-6y+9) \\\\  & =3{y}^{2}-18y+27.\\end{aligned}\n$$\n\nTherefore, $P(y)=3{y}^{2}-18y+27.$"}] [{:db/id #edb/ref 17592186329791 :knowledge-point/_questions [{:db/id #edb/ref 17592186083238 :knowledge-point/id #uuid "70c149d8-3739-564c-97c5-6636860ad0c4" :knowledge-point/title "Finding a Quadratic Polynomial Given Two Imaginary or Complex Roots"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0022c81d-7249-57ea-b85c-faca52fa725e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2{z}^{2}-12z-13" :db/id #edb/ref 17592186326934} {:answer/id #uuid "1c62967a-35b8-51ec-b618-768b175287e4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2{z}^{2}+12z-26" :db/id #edb/ref 17592186327179} {:answer/id #uuid "3f0e210e-e687-5df2-8531-30a91aae299d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2{z}^{2}+6z-13" :db/id #edb/ref 17592186327485} {:answer/id #uuid "80f269b1-70e4-5874-ac0d-1c99549a7558" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2{z}^{2}-6z+9" :db/id #edb/ref 17592186328046} {:answer/id #uuid "8cf7a053-7d48-5047-9768-06a394556fb8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2{z}^{2}+12z-5" :db/id #edb/ref 17592186328150}] :answer-field/correct {:answer/id #uuid "1c62967a-35b8-51ec-b618-768b175287e4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2{z}^{2}+12z-26" :db/id #edb/ref 17592186327179} :answer-field/id #uuid "f5ac5061-3c66-50a0-9298-0fb8d6af5746" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186329607}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "99f2b811-f0ad-5df2-9c8e-3f3014230013" :question/math-academy-id "q-46664" :question/problem "The quadratic polynomial $f(z)$ has real coefficients, has roots ${z}_{1}=3+2\\text{i}$ and ${z}_{2}=3-2\\text{i},$ and the coefficient of the quadratic term is $-2.$ Find $f(z).$" :question/worked-solution "Since our quadratic polynomial has roots ${z}_{1}=3+2\\text{i}$ and ${z}_{2}=3-2\\text{i},$ and the coefficient of the quadratic term is $a=-2,$ we can write the polynomial as follows:\n\n$$\n\\begin{aligned}a(z-{z}_{1})(z-{z}_{2}) & =(-2)(z-(3+2\\text{i}))(z-(3-2\\text{i}))\\end{aligned}\n$$\n\nExpanding the parentheses, we obtain\n\n$$\n\\begin{aligned}(-2)(z-(3+2\\text{i}))(z-(3-2\\text{i})) & =(-2)({z}^{2}-(3+2\\text{i})z-(3-2\\text{i})z+(3+2\\text{i})(3-2\\text{i})) \\\\  & =(-2)({z}^{2}-(3+2\\text{i}+3-2\\text{i})z+({3}^{2}-{2}^{2}{\\text{i}}^{2})) \\\\  & =(-2)({z}^{2}-6z+(9+4)) \\\\  & =-2{z}^{2}+12z-26.\\end{aligned}\n$$\n\nTherefore, $f(z)=-2{z}^{2}+12z-26.$"}] [{:db/id #edb/ref 17592186329792 :knowledge-point/_questions [{:db/id #edb/ref 17592186083238 :knowledge-point/id #uuid "70c149d8-3739-564c-97c5-6636860ad0c4" :knowledge-point/title "Finding a Quadratic Polynomial Given Two Imaginary or Complex Roots"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "43f2712e-bbf9-5d64-b4a4-19fa66e817ec" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2{v}^{2}-12v+50" :db/id #edb/ref 17592186327527} {:answer/id #uuid "7dea58a2-f43b-55a7-9363-8cbf0140d0fd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2{v}^{2}-6v+50" :db/id #edb/ref 17592186328021} {:answer/id #uuid "a6c61ffe-0e5e-5090-911a-89611958a46f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2{v}^{2}+8v-14" :db/id #edb/ref 17592186328382} {:answer/id #uuid "ee5b7e26-c574-59a3-b54b-9724ee8d1044" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2{v}^{2}-16v-14" :db/id #edb/ref 17592186329017} {:answer/id #uuid "ff80448e-3917-589d-a32d-f1e60b6bfd66" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2{v}^{2}+6v+25" :db/id #edb/ref 17592186329178}] :answer-field/correct {:answer/id #uuid "43f2712e-bbf9-5d64-b4a4-19fa66e817ec" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2{v}^{2}-12v+50" :db/id #edb/ref 17592186327527} :answer-field/id #uuid "92a83e02-7c9e-5529-ab3d-121fdc72ecd6" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186329430}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "af81e241-3fd9-5579-878e-052d0c216987" :question/math-academy-id "q-46669" :question/problem "The quadratic polynomial $f(v)$ has real coefficients, has roots ${v}_{1}=3+4\\text{i}$ and ${v}_{2}=3-4\\text{i},$ and the coefficient of the quadratic term is $2.$ Find $f(v).$" :question/worked-solution "Since our quadratic polynomial has roots ${v}_{1}=3+4\\text{i}$ and ${v}_{2}=3-4\\text{i},$ and the coefficient of the quadratic term is $a=2,$ we can write the polynomial as follows:\n\n$$\n\\begin{aligned}a(v-{v}_{1})(v-{v}_{2}) & =2(v-(3+4\\text{i}))(v-(3-4\\text{i}))\\end{aligned}\n$$\n\nExpanding the parentheses, we obtain\n\n$$\n\\begin{aligned}2(v-(3+4\\text{i}))(v-(3-4\\text{i})) & =2({v}^{2}-(3+4\\text{i})v-(3-4\\text{i})v+(3+4\\text{i})(3-4\\text{i})) \\\\  & =2({v}^{2}-(3+4\\text{i}+3-4\\text{i})v+({3}^{2}-{4}^{2}{\\text{i}}^{2})) \\\\  & =2({v}^{2}-6v+(9+16)) \\\\  & =2{v}^{2}-12v+50.\\end{aligned}\n$$\n\nTherefore, $f(v)=2{v}^{2}-12v+50.$"}] [{:db/id #edb/ref 17592186329795 :knowledge-point/_questions [{:db/id #edb/ref 17592186078557 :knowledge-point/id #uuid "045722b6-b558-522b-86e1-322c64e2848f" :knowledge-point/title "Calculating the Limit of a Rational Function with a Radical in the Denominator"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0801cf1c-5fd2-5cc2-8874-bb033ff63b06" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{4}" :db/id #edb/ref 17592186326999} {:answer/id #uuid "21618e1a-d4b1-5642-ac4b-4adec6bcb616" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\infty " :db/id #edb/ref 17592186327222} {:answer/id #uuid "2a3ed060-8f3d-5e5f-a548-ad4adb40f6c7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186327301} {:answer/id #uuid "3f5696e8-74ce-57d4-98a1-81edbd390bcf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186327489} {:answer/id #uuid "9d7d71e6-17cd-53a0-9ad8-987841eae685" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\text{DNE}" :db/id #edb/ref 17592186328296}] :answer-field/correct {:answer/id #uuid "2a3ed060-8f3d-5e5f-a548-ad4adb40f6c7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186327301} :answer-field/id #uuid "914d0201-289f-570f-b5ca-55e4260ae1f3" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186329425}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "005f9ab9-467f-5576-9116-815c97776952" :question/math-academy-id "q-46830" :question/problem "Evaluate ${lim}_{x\\to {4}^{+}}\\frac{x-4}{\\sqrt{3x-3}-3}.$" :question/worked-solution "If we attempt to evaluate the limit by simply evaluating the function at $x=4$, we get an indeterminate form:\n\n$$\n\\begin{aligned}{lim}_{x\\to {4}^{+}}\\frac{x-4}{\\sqrt{3x-3}-3} & =\\frac{4-4}{\\sqrt{3(4)-3}-3}=\\frac{0}{0}\\end{aligned}\n$$\n\nSo, we need to first simplify the limit. Since the radical is in the denominator, we can multiply the numerator and the denominator by the conjugate of the denominator. We get\n\n$$\n\\begin{aligned}{lim}_{x\\to {4}^{+}}\\frac{x-4}{\\sqrt{3x-3}-3} & ={lim}_{x\\to {4}^{+}}\\frac{(x-4)(\\sqrt{3x-3}+3)}{(\\sqrt{3x-3}-3)(\\sqrt{3x-3}+3)} \\\\  & ={lim}_{x\\to {4}^{+}}\\frac{(x-4)(\\sqrt{3x-3}+3)}{{(\\sqrt{3x-3})}^{2}-{3}^{2}} \\\\  & ={lim}_{x\\to {4}^{+}}\\frac{(x-4)(\\sqrt{3x-3}+3)}{3x-3-9} \\\\  & ={lim}_{x\\to {4}^{+}}\\frac{(x-4)(\\sqrt{3x-3}+3)}{3x-12} \\\\  & ={lim}_{x\\to {4}^{+}}\\frac{(x-4)(\\sqrt{3x-3}+3)}{3(x-4)} \\\\  & ={lim}_{x\\to {4}^{+}}\\frac{\\sqrt{3x-3}+3}{3} \\\\  & =\\frac{\\sqrt{3(4)-3}+3}{3} \\\\  & =\\frac{3+3}{3} \\\\  & =2.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186329796 :knowledge-point/_questions [{:db/id #edb/ref 17592186078536 :knowledge-point/id #uuid "a441c8ef-b5b3-5438-97b9-53e4eb7b2d75" :knowledge-point/title "Calculating the Limit of a Rational Function with a Radical in the Numerator"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0f3b50a7-1a31-52bc-91a4-f6b268955f83" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\infty " :db/id #edb/ref 17592186327070} {:answer/id #uuid "10710463-0db1-5838-be7b-4f17aca898c1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{8}" :db/id #edb/ref 17592186327081} {:answer/id #uuid "196dae27-2242-5069-9416-9d2435e009f6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{24}" :db/id #edb/ref 17592186327154} {:answer/id #uuid "519f1ddd-7a1e-5d1a-a24e-d9445baa5f01" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{16}" :db/id #edb/ref 17592186327645} {:answer/id #uuid "fe2ff551-9a15-5bb4-987f-b343fdf4c92b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\text{DNE}" :db/id #edb/ref 17592186329168}] :answer-field/correct {:answer/id #uuid "519f1ddd-7a1e-5d1a-a24e-d9445baa5f01" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{16}" :db/id #edb/ref 17592186327645} :answer-field/id #uuid "3556b158-4519-5e67-be7a-f8d92924db68" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186329288}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "83a2f35e-6a3d-5f89-a27d-35edfe302559" :question/math-academy-id "q-46831" :question/problem "Evaluate ${lim}_{x\\to 2}\\frac{\\sqrt{x+2}-2}{{x}^{2}-4}.$" :question/worked-solution "If we attempt to evaluate the limit, we get an indeterminate form:\n\n$$\n\\begin{aligned}{lim}_{x\\to 2}\\frac{\\sqrt{x+2}-2}{{x}^{2}-4} & =\\frac{\\sqrt{2+2}-2}{{2}^{2}-4}=\\frac{0}{0}\\end{aligned}\n$$\n\nSo, we need to first simplify the limit. Since the radical is in the numerator, we can multiply the numerator and the denominator by the conjugate of the numerator. We get\n\n$$\n\\begin{aligned}{lim}_{x\\to 2}\\frac{\\sqrt{x+2}-2}{{x}^{2}-4} & ={lim}_{x\\to 2}\\frac{\\sqrt{x+2}-2}{(x-2)(x+2)} \\\\  & ={lim}_{x\\to 2}\\frac{(\\sqrt{x+2}-2)(\\sqrt{x+2}+2)}{(x-2)(x+2)(\\sqrt{x+2}+2)} \\\\  & ={lim}_{x\\to 2}\\frac{{(\\sqrt{x+2})}^{2}-{2}^{2}}{(x-2)(x+2)(\\sqrt{x+2}+2)} \\\\  & ={lim}_{x\\to 2}\\frac{x+2-4}{(x-2)(x+2)(\\sqrt{x+2}+2)} \\\\  & ={lim}_{x\\to 2}\\frac{x-2}{(x-2)(x+2)(\\sqrt{x+2}+2)} \\\\  & ={lim}_{x\\to 2}\\frac{1}{(x+2)(\\sqrt{x+2}+2)} \\\\  & =\\frac{1}{(2+2)(\\sqrt{2+2}+2)} \\\\  & =\\frac{1}{16}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186329802 :knowledge-point/_questions [{:db/id #edb/ref 17592186124671 :knowledge-point/id #uuid "e37b91f0-ea0a-58b0-98d0-8f3626578dd6" :knowledge-point/title "Computing the Limit of Cotangent Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3552e823-ed7e-5411-8a4d-a7a161d920bc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\infty " :db/id #edb/ref 17592186327395} {:answer/id #uuid "3f22fb2d-15a6-595d-8e20-54b09e482167" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\text{DNE}" :db/id #edb/ref 17592186327487} {:answer/id #uuid "6874f84d-9c2d-5c6c-8e62-74ddd0d5cfc7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186327835} {:answer/id #uuid "7b8ddd5a-8d1e-5b11-a6bc-864708f334f9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\infty " :db/id #edb/ref 17592186327996} {:answer/id #uuid "bc89a2bc-ead2-5238-9aae-15a92a90fa81" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186328574}] :answer-field/correct {:answer/id #uuid "3f22fb2d-15a6-595d-8e20-54b09e482167" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\text{DNE}" :db/id #edb/ref 17592186327487} :answer-field/id #uuid "10bd8af9-359c-5678-a39c-41fc93bcc176" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186329211}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "5898d1b3-7352-5733-948f-e0e93cd0becf" :question/math-academy-id "q-47039" :question/problem "Calculate ${lim}_{x\\to \\pi }\\operatorname{cot}⁡x.$" :question/worked-solution "First, let's attempt to evaluate the limit by direct substitution:\n\n$$\n\\begin{aligned}{lim}_{x\\to \\pi }\\operatorname{cot}⁡(x) & =\\operatorname{cot}⁡(\\pi ) \\\\  & =\\frac{\\operatorname{cos}⁡\\pi }{\\operatorname{sin}⁡\\pi } \\\\  & =\\frac{-1}{0},\\end{aligned}\n$$\n\nwhich is undefined.\n\nTherefore, to find the limit, let's sketch the graph of $y=\\operatorname{cot}⁡(x).$\n\n![](images/5e/5e9d0e9d944cda9c97555ffdeac5aa245905f800cd99e11f5d172203bad3892d.png)\n\nAs $x$ approaches $\\pi $ from the left, the values of $y=\\operatorname{cot}⁡(x)$ are negative and decrease without bound. Therefore\n\n$$\n{lim}_{x\\to {\\pi }^{-}}\\operatorname{cot}⁡(x)=-\\infty \n$$\n\nHowever, as $x$ approaches $\\pi $ from the right, the values of $y=\\operatorname{cot}⁡(x)$ are positive and grow without bound. Therefore\n\n$$\n{lim}_{x\\to {\\pi }^{+}}\\operatorname{cot}⁡(x)=\\infty \n$$\n\nSince the two limits are not equal, we conclude that\n\n$$\n{lim}_{x\\to \\pi }\\operatorname{cot}⁡(x)=\\text{DNE}.\n$$"}] [{:db/id #edb/ref 17592186329806 :knowledge-point/_questions [{:db/id #edb/ref 17592186115372 :knowledge-point/id #uuid "6835b52b-adaa-5c66-9f6d-d32591864659" :knowledge-point/title "Evaluating Infinite Limits Using the Laws of Exponents and the Algebra of Limits"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "17028eac-4ec5-5412-a437-179e2341db73" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\infty " :db/id #edb/ref 17592186327136} {:answer/id #uuid "699925f0-6e8c-5f1a-b77d-e1c6f323fb8f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186327842} {:answer/id #uuid "aa0370f2-56b3-5cc8-a52d-9b4a98865995" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\text{DNE}" :db/id #edb/ref 17592186328406} {:answer/id #uuid "cdfe3a0e-970e-5bb9-8a35-e018230647f4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186328745} {:answer/id #uuid "f5621511-1f8d-5799-9acc-c62ea19974de" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\infty " :db/id #edb/ref 17592186329079}] :answer-field/correct {:answer/id #uuid "cdfe3a0e-970e-5bb9-8a35-e018230647f4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186328745} :answer-field/id #uuid "1f990210-b8a8-5e34-9486-0ad7ae987df5" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186329237}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "66cb54a9-7be0-554a-a6fe-eb1aaa1b6f8b" :question/math-academy-id "q-47073" :question/problem "${lim}_{x\\to -\\infty }{2}^{3x-8}=$" :question/worked-solution "We can use the laws of exponents and the algebra of limits to rewrite the given limit, as follows:\n\n$$\n\\begin{aligned}{lim}_{x\\to -\\infty }{2}^{3x-8} & ={lim}_{x\\to -\\infty }{2}^{3x}\\cdot {2}^{-8} \\\\  & ={lim}_{x\\to -\\infty }{({2}^{3})}^{x}\\cdot {2}^{-8} \\\\  & ={lim}_{x\\to -\\infty }{8}^{x}\\cdot (\\frac{1}{256}) \\\\  & =(\\frac{1}{256})\\cdot {lim}_{x\\to -\\infty }{8}^{x}\\end{aligned}\n$$\n\nNext, we recall the graph of $y={8}^{x}.$\n\n![](images/85/85319605a7c7b57d4c7ed29b8d409e3169f3331775580b91b70e2be99fef7986.png)\n\nFrom the graph, we see that the function decreases to zero as $x$ decreases. Therefore,\n\n$$\n{lim}_{x\\to -\\infty }{8}^{x}=0.\n$$\n\nSo, we conclude that \n\n$$\n(\\frac{1}{256})\\cdot {lim}_{x\\to -\\infty }{8}^{x}=(\\frac{1}{256})\\cdot 0=0\n$$"}] [{:db/id #edb/ref 17592186392582 :knowledge-point/_questions [{:db/id #edb/ref 17592186092240 :knowledge-point/id #uuid "55a323ba-f2a7-5a49-abd4-a9812518ef8c" :knowledge-point/title "Determining the Equation of a Normal Line to a Curve at a Point"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "10131252-4695-56ed-8c59-747e545f594c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "71" :db/id #edb/ref 17592186392584} {:answer/id #uuid "e6984861-e3cb-5365-9e9e-1ecd4311dcb8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "61" :db/id #edb/ref 17592186392585} {:answer/id #uuid "859687f9-c59b-551f-aaa5-e7e3c04ba6c0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-81" :db/id #edb/ref 17592186392586} {:answer/id #uuid "95424aa7-6153-5c48-9071-e6e5ac4c3b4c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "81" :db/id #edb/ref 17592186392587} {:answer/id #uuid "41016988-d005-506a-b687-2940e1c88cd8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-71" :db/id #edb/ref 17592186392588}] :answer-field/correct {:answer/id #uuid "95424aa7-6153-5c48-9071-e6e5ac4c3b4c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "81" :db/id #edb/ref 17592186392587} :answer-field/id #uuid "c9549a2f-75a6-5fa7-b3e3-19c27b3b484f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186392583}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "414ee72f-747c-573a-9cad-a9cbdad6101a" :question/math-academy-id "q-47410" :question/problem "The equation of the normal line to the curve $y=3{x}^{2}+4x$ at the point $(1,7)$ is given by $x+py=q$ where $p$ and $q$ are constants. Find the value of $p+q.$" :question/worked-solution "Let $f(x)=3{x}^{2}+4x.$ First, we compute the derivative:\n\n$$\n\\begin{aligned}{f}^{′}(x)=\\frac{\\text{d}}{\\text{d}x}(3{x}^{2}+4x)=6x+4\\end{aligned}\n$$\n\nThen, we compute the slope of the tangent at the point $(1,7):$\n\n$$\n\\begin{aligned}m={f}^{′}(1)=6(1)+4=10\\end{aligned}\n$$\n\nTherefore, the slope of the normal line ${m}^{′}$ is\n\n$$\n{m}^{′}=-\\frac{1}{m}=-\\frac{1}{10}.\n$$\n\nFinally, the equation of the normal line is\n\n$$\n\\begin{aligned}y-(7) & =-\\frac{1}{10}(x-1) \\\\ 10y-70 & =-x+1 \\\\ x+10y & =71.\\end{aligned}\n$$\n\nTherefore, $p+q=10+71=81.$"}] [{:db/id #edb/ref 17592186329815 :knowledge-point/_questions [{:db/id #edb/ref 17592186092384 :knowledge-point/id #uuid "4a05f6c0-98ab-5197-922e-8e8dff1d4302" :knowledge-point/title "Calculating the Slope of a Normal Line to a Curve at a Point"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "298a6c80-4207-50f6-8a34-1d93a5f89fed" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{3}" :db/id #edb/ref 17592186327287} {:answer/id #uuid "307e57c3-1572-5e33-a5f9-3472b90bf91f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186327363} {:answer/id #uuid "e1ee7da7-a08a-5f34-86ea-f3f106a5f98c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186328912} {:answer/id #uuid "e33c1589-993a-5e15-9743-78a5a9f95009" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{2}" :db/id #edb/ref 17592186328926} {:answer/id #uuid "fb9c839b-8755-5fd8-b8d8-b4929a06d14c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{3}" :db/id #edb/ref 17592186329142}] :answer-field/correct {:answer/id #uuid "fb9c839b-8755-5fd8-b8d8-b4929a06d14c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{3}" :db/id #edb/ref 17592186329142} :answer-field/id #uuid "197f2e71-4c00-5a81-830b-269b6b29fd90" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186329228}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "704dafc6-9839-55e3-9683-dc5e275270d6" :question/math-academy-id "q-47449" :question/problem "Find the slope of the normal line to the curve $y={x}^{2}+x$ at the point $(1,2).$" :question/worked-solution "Let $f(x)={x}^{2}+x.$ First, we compute the derivative:\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}({x}^{2}+x) \\\\  & =2x+1\\end{aligned}\n$$\n\nThen, we compute the slope of the tangent at the point $(1,2):$\n\n$$\nm={f}^{′}(1)=2(1)+1=3\n$$\n\nTherefore, the slope of the normal line ${m}^{′}$ is\n\n$$\n{m}^{′}=-\\frac{1}{m}=-\\frac{1}{3}.\n$$"}] [{:db/id #edb/ref 17592186329816 :knowledge-point/_questions [{:db/id #edb/ref 17592186176051 :knowledge-point/id #uuid "0e2a8cf2-64db-5b2f-b0f7-0c727cf492a9" :knowledge-point/title "Describing Properties of the Secant Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "029e14a6-a3da-5d56-bd50-24aa3841ff59" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II" :db/id #edb/ref 17592186326964} {:answer/id #uuid "09838c12-324b-5f86-b8eb-b9a50a5b99f2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186327012} {:answer/id #uuid "58d2b82d-ca43-5016-b810-dc807085c710" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186327713} {:answer/id #uuid "d9fe1f38-597e-53c5-aa82-041838d9bba1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III" :db/id #edb/ref 17592186328838} {:answer/id #uuid "ed61f5fa-bf44-559a-b259-d059d2ed706f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186329011}] :answer-field/correct {:answer/id #uuid "ed61f5fa-bf44-559a-b259-d059d2ed706f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186329011} :answer-field/id #uuid "dc0b4dd2-5359-5754-b6be-a086a2742846" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186329570}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "4ce070dc-f77b-529a-a508-4630f3613570" :question/math-academy-id "q-47455" :question/problem "Which of the following statements are true regarding the function $y=sec⁡x?$\n\n- The period of the function is $\\pi .$\n- The function is increasing in the interval $(-\\frac{\\pi }{2},0].$\n- The function has no zeros." :question/worked-solution "Let's plot the graph of $y=sec⁡x.$\n\n![](images/77/779d7a31646a229492a8165c8212a5c83ad7d37d843c1c1b3b36766a74bc5124.png)\n\nLet's go through each statement.\n\n- Statement I is false. The period of the function is $2\\pi .$\n\n- Statement II is false. The function $y=sec⁡x$ is decreasing on $(-\\frac{\\pi }{2},0].$\n\n- Statement III is true. The function has no zeros."}] [{:db/id #edb/ref 17592186115883 :knowledge-point/_questions [{:db/id #edb/ref 17592186115382 :knowledge-point/id #uuid "7dcbd56f-0fc2-59c5-a016-4272be4734c7" :knowledge-point/title "Determining the Points at Which a Function is Not Differentiable"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "814a3015-040d-5d38-8d89-66e613ea9c28" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$x =-2$, $x = 0$, and $x = 2$" :db/id #edb/ref 17592186114236} {:answer/id #uuid "bbc4ca4a-1ffc-505e-9c15-eada8368fb5c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$x = 2$ only" :db/id #edb/ref 17592186114237} {:answer/id #uuid "c9f356c3-5dd2-587a-aa58-7ab4bc07f2f0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$x =-2$ only" :db/id #edb/ref 17592186114238} {:answer/id #uuid "cd84e69a-febf-59d0-8ce5-b1b9373d8954" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$x = 0$ only" :db/id #edb/ref 17592186114239} {:answer/id #uuid "551564d0-36a1-5e6f-a7f1-ebd7c47f4f37" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$x =-2$ and $x = 2$ only" :db/id #edb/ref 17592186114240}] :answer-field/id #uuid "3caeafb3-6b65-5977-a595-ae7d734d711e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186114235} {:answer-field/choices [{:answer/id #uuid "6f7c45a8-6d0f-5a1d-b8dc-4e8e1b4b6ce1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$x=2$ only" :db/id #edb/ref 17592186396662} {:answer/id #uuid "f7475fa2-2dfb-5ab6-af30-4b6beda786d6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$x=-2$ and $x=2$ only" :db/id #edb/ref 17592186396663} {:answer/id #uuid "1541152a-7611-5c14-a588-d1e5cc5e22df" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$x=-2$, $x=0$, and $x=2$" :db/id #edb/ref 17592186396664} {:answer/id #uuid "453cb038-db89-5863-98ef-ba1dcdd04c12" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$x=0$ only" :db/id #edb/ref 17592186396665} {:answer/id #uuid "edc154f2-6797-5d5a-be28-0f6a1f59d668" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$x=-2$ only" :db/id #edb/ref 17592186396666}] :answer-field/correct {:answer/id #uuid "1541152a-7611-5c14-a588-d1e5cc5e22df" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$x=-2$, $x=0$, and $x=2$" :db/id #edb/ref 17592186396664} :answer-field/id #uuid "71e2164a-d23d-528c-85fa-147024e56737" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186396661}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "097f3e11-2ce8-55f7-bbfa-1640ee282b68" :question/math-academy-id "q-47650" :question/problem "![](images/8e/8e7daf95fadbe2262a09e8183f00d63075655f3b97dd363984c192ac3414ad17.png)\n\nConsider the function $y=f(x)$ whose graph is plotted above. At which points is the function $f(x)$ **not** differentiable?" :question/worked-solution "The function is not differentiable wherever it has a discontinuity, corner, cusp, or vertical tangent.\n\n- At $x=-2$ the function has a cusp, so it's not differentiable there.\n\n- At $x=0$ the function has a jump discontinuity, so it's not differentiable there.\n\n- At $x=2$ the function has an infinite discontinuity, so it's not differentiable there.\n\nTherefore, the correct answer is $x=-2$, $x=0$, and $x=2.$"}] [{:db/id #edb/ref 17592186115885 :knowledge-point/_questions [{:db/id #edb/ref 17592186115382 :knowledge-point/id #uuid "7dcbd56f-0fc2-59c5-a016-4272be4734c7" :knowledge-point/title "Determining the Points at Which a Function is Not Differentiable"}] :question/answer-fields [{:answer-fiel