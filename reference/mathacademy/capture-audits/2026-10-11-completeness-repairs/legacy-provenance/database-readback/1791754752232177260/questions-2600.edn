#{[{:db/id #edb/ref 17592186403412 :knowledge-point/_questions [{:db/id #edb/ref 17592186096616 :knowledge-point/id #uuid "cef7fc21-23f4-5d6a-a208-9963ef23c784" :knowledge-point/title "Calculating the Slope of the Tangent Line of a Logarithmic Function at a Point"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8c631962-dd2a-53db-b827-84d94e8f7e53" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{9}{\\operatorname{ln}⁡10}-3" :db/id #edb/ref 17592186403414} {:answer/id #uuid "8f33e14e-f91d-5c5f-9b34-7c61ede2d34c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{\\operatorname{ln}⁡10}+27" :db/id #edb/ref 17592186403415} {:answer/id #uuid "33140677-5da7-59ef-8215-135fba67dffb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{3\\operatorname{ln}⁡10}+3" :db/id #edb/ref 17592186403416} {:answer/id #uuid "7fefc24f-ce9e-58b5-aba2-9f2cb372222e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{\\operatorname{ln}⁡10}-9" :db/id #edb/ref 17592186403417} {:answer/id #uuid "cc3a5a72-8cb5-5f5c-812b-2114a27a36be" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{\\operatorname{ln}⁡10}+9" :db/id #edb/ref 17592186403418}] :answer-field/correct {:answer/id #uuid "8f33e14e-f91d-5c5f-9b34-7c61ede2d34c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{\\operatorname{ln}⁡10}+27" :db/id #edb/ref 17592186403415} :answer-field/id #uuid "1fcab4c2-5aab-5cee-8699-609d2431de61" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186403413}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "ddfac57c-89c4-597b-b080-b0ac4a48d4c1" :question/math-academy-id "q-70903" :question/problem "Given that $y=3\\operatorname{log}⁡x+{x}^{3}-4$, find the slope of the tangent at $x=3.$" :question/worked-solution "To find the slope of the tangent at a given point, we have to find $\\frac{\\text{d}y}{\\text{d}x}$ at that point.\n\nTaking the derivative, we have\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}=\\frac{3}{x\\operatorname{ln}⁡10}+3{x}^{2}\\,.\n$$\n\nTherefore, the slope of the tangent at $x=1$ is \n\n$$\n\\begin{aligned}{\\frac{\\text{d}y}{\\text{d}x}|}_{x=3} & ={(\\frac{3}{x\\operatorname{ln}⁡10}+3{x}^{2})|}_{x=3} \\\\  & =\\frac{3}{3\\cdot \\operatorname{ln}⁡10}+3\\cdot {3}^{2} \\\\  & =\\frac{1}{\\operatorname{ln}⁡10}+27\\,.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186403419 :knowledge-point/_questions [{:db/id #edb/ref 17592186124507 :knowledge-point/id #uuid "8db2909b-26fd-53bf-8ce2-9fca4451efc3" :knowledge-point/title "Describing Traces of Ellipsoids"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "441ad13a-04d3-57c6-a04e-0fc82c408cbc" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The circle of radius $\\sqrt{3}$ centered at $(0,4)$" :db/id #edb/ref 17592186403421} {:answer/id #uuid "341432ad-44c3-5414-b4d8-57e378337db7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The circle of radius $12$ centered at $(0,0)$" :db/id #edb/ref 17592186403422} {:answer/id #uuid "826e586e-0569-5bb6-96de-10fe4b4015a7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The circle of radius $2$ centered at $(0,-4)$" :db/id #edb/ref 17592186403423} {:answer/id #uuid "9c58bd12-17f3-5565-aa62-7cb54d35d4f4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The circle of radius $4$ centered at $(4,0)$" :db/id #edb/ref 17592186403424} {:answer/id #uuid "a7d92dd1-4df6-5c59-877d-4394830adaba" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The circle of radius $2\\sqrt{3}$ centered at $(-4,0)$" :db/id #edb/ref 17592186403425}] :answer-field/correct {:answer/id #uuid "a7d92dd1-4df6-5c59-877d-4394830adaba" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The circle of radius $2\\sqrt{3}$ centered at $(-4,0)$" :db/id #edb/ref 17592186403425} :answer-field/id #uuid "0c3aa403-fc33-5342-8a02-494977341c7c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186403420}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "1624d2db-d10f-59ae-bae3-c241890eb9fd" :question/math-academy-id "q-70926" :question/problem "What is the projection of the intersection between the sphere ${x}^{2}+(y+4)^{2}+{z}^{2}=16$ and the plane $x=2$ onto the $yz$-plane." :question/worked-solution "To find the intersection of the sphere and the plane $x=2$, we substitute $x=2$ into the equation of the sphere:\n\n$$\n\\begin{aligned}(2)^{2}+(y+4)^{2}+{z}^{2} & =16 \\\\ 4+(y+4)^{2}+{z}^{2} & =16 \\\\ (y+4)^{2}+{z}^{2} & =12 \\\\ (y+4)^{2}+{z}^{2} & =(2\\sqrt{3})^{2}\\end{aligned}\n$$\n\nProjecting this onto the $yz$-plane gives us the circle of radius $2\\sqrt{3}$ centered at $(-4,0).$"}] [{:db/id #edb/ref 17592186393050 :knowledge-point/_questions [{:db/id #edb/ref 17592186087656 :knowledge-point/id #uuid "89462485-2e28-5727-82c7-7afd0cac6d77" :knowledge-point/title "Finding the Center and Radius of a Circle Given Its Equation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "414d2687-cf0f-5475-b4de-9ae0e2a91b57" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The center is $(-1,-6)$ and radius is $4$" :db/id #edb/ref 17592186393052} {:answer/id #uuid "b904b162-87b0-576b-9c8a-3c647aa88565" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The center is $(-1,-6)$ and radius is $16$" :db/id #edb/ref 17592186393053} {:answer/id #uuid "e0376e6b-94e1-5393-8f70-58f85be3025d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The center is $(1,6)$ and radius is $4$" :db/id #edb/ref 17592186393054} {:answer/id #uuid "a1fe974f-7739-5447-8c15-65e11281c360" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The center is $(1,-6)$ and radius is $4$" :db/id #edb/ref 17592186393055} {:answer/id #uuid "1a4bb814-df36-50ef-990c-594eb222e321" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The center is $(1,6)$ and radius is $16$" :db/id #edb/ref 17592186393056}] :answer-field/correct {:answer/id #uuid "414d2687-cf0f-5475-b4de-9ae0e2a91b57" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The center is $(-1,-6)$ and radius is $4$" :db/id #edb/ref 17592186393052} :answer-field/id #uuid "85727bd6-7f77-5807-aa8a-f0686b43c486" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186393051}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "fed78696-d1d3-57b4-8aa2-ab1ef29e5f93" :question/math-academy-id "q-70933" :question/problem "What is the center and radius of the circle with equation $(x+1)^{2}+(y+6)^{2}=16?$" :question/worked-solution "The general equation of a circle with radius $r$ centered at the point $(a,b)$ is \n\n$$\n(x-a)^{2}+(y-b)^{2}={r}^{2}.\n$$\n\nLet's compare the general equation to our equation side-by-side as follows:\n\n$$\n\\begin{aligned}(x-a)^{2}+(y-b)^{2} & ={r}^{2} \\\\ (x+1)^{2}+(y+6)^{2} & =16 \\\\ (x-(-1))^{2}+(y-(-6))^{2} & ={4}^{2}.\\end{aligned}\n$$\n\nWe see that $a=-1,$ $b=-6,$ and $r=4.$ \n\nTherefore, the circle is centered at $(-1,-6)$ and its radius is $4.$"}] [{:db/id #edb/ref 17592186338856 :knowledge-point/_questions [{:db/id #edb/ref 17592186100873 :knowledge-point/id #uuid "71ff07eb-2e16-529e-b17c-1bf7cb9703bd" :knowledge-point/title "Finding an Entry of the Product of Two Matrices"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "108d6bbd-0580-5e01-b5da-7d66c9de2677" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "58" :db/id #edb/ref 17592186336189} {:answer/id #uuid "23395dc3-a44d-5e00-8ded-065282a293f6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186336360} {:answer/id #uuid "473ce54b-c3d5-51fb-9d6b-a1bfee206728" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186336693} {:answer/id #uuid "6503e9be-0e27-5e84-8fd2-9a826704f72c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186336935} {:answer/id #uuid "ffcf5573-0517-5ba5-b572-8c6b996ce926" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186338275}] :answer-field/correct {:answer/id #uuid "23395dc3-a44d-5e00-8ded-065282a293f6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186336360} :answer-field/id #uuid "5d203bbd-ae08-54f5-b289-51a54374a681" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186338438}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "01084ebc-a27f-547f-baec-04fae1ac84bf" :question/math-academy-id "q-70958" :question/problem "Let $R=PQ.$ What is the value of ${r}_{25}$, if\n\n$$\nP=[\\begin{aligned}1 & -2 \\\\ 3 & -4 \\\\ 4 & -6 \\\\ 1 & -8 \\\\ 3 & -9\\end{aligned}],\\,Q=[\\begin{aligned}0 & 1 & 2 & -1 & 10 \\\\ 2 & 0 & 5 & -2 & 7\\end{aligned}]?\n$$" :question/worked-solution "Multiplying the $2$nd row of $P$ by the $5$th column of $Q$, we get\n\n$$\n\\begin{aligned}{r}_{25} & =[\\begin{aligned}1 & -2 \\\\ 3 & -4 \\\\ 4 & -6 \\\\ 1 & -8 \\\\ 3 & -9\\end{aligned}][\\begin{aligned}0 & 1 & 2 & -1 & 10 \\\\ 2 & 0 & 5 & -2 & 7\\end{aligned}] \\\\  & =[\\begin{aligned}3 & -4\\end{aligned}][\\begin{aligned}10 \\\\ 7\\end{aligned}] \\\\  & =3\\cdot 10+(-4)\\cdot 7 \\\\  & =30-28 \\\\  & =2.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186338858 :knowledge-point/_questions [{:db/id #edb/ref 17592186119933 :knowledge-point/id #uuid "b02f02f1-f270-55e0-a7a9-0b729c4d82c0" :knowledge-point/title "Finding the Parametric Equation of the Plane Parallel To Two Given Vectors"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "00227479-5977-5397-9100-1b17106f6f34" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "None of the listed" :db/id #edb/ref 17592186336032} {:answer/id #uuid "7a23ffb5-90fe-5574-8788-b35cd3472639" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "r=s⟨2,-4,1⟩+t⟨0,-1,\\sqrt{3}⟩,\\,s,t\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186337130} {:answer/id #uuid "8bc69e15-be00-5985-8928-5ae6da0b85fc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "r=⟨2,-4,1⟩+s⟨-1,0,4⟩+t⟨0,-1,\\sqrt{3}⟩,\\,s,t\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186337298} {:answer/id #uuid "9df3fd4f-c200-56e8-801d-837062abe73d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "r=⟨-1,0,4⟩+s⟨2,-4,1⟩+t⟨0,-1,\\sqrt{3}⟩,\\,s,t\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186337460} {:answer/id #uuid "f73323f6-d68a-5f33-a1ce-fe11e5050b22" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "r=⟨0,-1,\\sqrt{3}⟩+s⟨2,-4,1⟩+t⟨-1,0,4⟩,\\,s,t\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186338199}] :answer-field/correct {:answer/id #uuid "9df3fd4f-c200-56e8-801d-837062abe73d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "r=⟨-1,0,4⟩+s⟨2,-4,1⟩+t⟨0,-1,\\sqrt{3}⟩,\\,s,t\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186337460} :answer-field/id #uuid "4d334158-7c9e-5eb8-85d7-5810eda2f8fb" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186338412}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "a2b043ce-2959-5d1e-9542-cf409b778a9f" :question/math-academy-id "q-70965" :question/problem "Find a parametric equation of the plane that passes through the point $Q(-1,0,4)$ and is parallel to the vectors ${v}_{1}=⟨2,-4,1⟩$  and ${v}_{2}=⟨0,-1,\\sqrt{3}⟩.$" :question/worked-solution "A parametric equation of a plane is given by \n\n$$\nr=p+sb+tc,\n$$\n\nwhere $p$ is the position vector of a point on the plane and the vectors $b$ and $c$ are parallel to the plane but not to each other.\n\nHere, the position vector of the given point $Q$ is $p=⟨-1,0,4⟩$ and the two vectors that are parallel to the plane (but not to each other) are ${v}_{1}=⟨2,-4,1⟩$  and ${v}_{2}=⟨0,-1,\\sqrt{3}⟩.$\n\nSo, a parametric equation of the plane is given by\n\n$$\nr=⟨-1,0,4⟩+s⟨2,-4,1⟩+t⟨0,-1,\\sqrt{3}⟩,\\,s,t\\in (-\\infty ,\\infty ).\n$$"}] [{:db/id #edb/ref 17592186338859 :knowledge-point/_questions [{:db/id #edb/ref 17592186119933 :knowledge-point/id #uuid "b02f02f1-f270-55e0-a7a9-0b729c4d82c0" :knowledge-point/title "Finding the Parametric Equation of the Plane Parallel To Two Given Vectors"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "42395827-35cc-56c8-be64-dcb4273beb95" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "r=[\\begin{aligned}3 \\\\ -1 \\\\ 0\\end{aligned}]+s[\\begin{aligned}0 \\\\ -3 \\\\ 1\\end{aligned}]+t[\\begin{aligned}-2 \\\\ 4 \\\\ 5\\end{aligned}],\\,s,t\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186336657} {:answer/id #uuid "5349233e-7692-537c-ab4f-6921abbd6820" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "r=[\\begin{aligned}-2 \\\\ 4 \\\\ 5\\end{aligned}]+s[\\begin{aligned}0 \\\\ -3 \\\\ 1\\end{aligned}]+t[\\begin{aligned}3 \\\\ -1 \\\\ 0\\end{aligned}],\\,s,t\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186336799} {:answer/id #uuid "c2b1e1d5-44e4-596d-90f9-5b7e79325c48" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "None of the listed" :db/id #edb/ref 17592186337760} {:answer/id #uuid "cb765184-ca7f-53c4-8a04-924ee20493f9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "r=[\\begin{aligned}0 \\\\ -3 \\\\ 1\\end{aligned}]+s[\\begin{aligned}3 \\\\ -1 \\\\ 0\\end{aligned}]+t[\\begin{aligned}-2 \\\\ 4 \\\\ 5\\end{aligned}],\\,s,t\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186337820} {:answer/id #uuid "d44b3488-6f16-5c26-83ce-79fefd89325b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "r=s[\\begin{aligned}3 \\\\ -1 \\\\ 0\\end{aligned}]+t[\\begin{aligned}0 \\\\ -3 \\\\ 1\\end{aligned}],\\,s,t\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186337888}] :answer-field/correct {:answer/id #uuid "42395827-35cc-56c8-be64-dcb4273beb95" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "r=[\\begin{aligned}3 \\\\ -1 \\\\ 0\\end{aligned}]+s[\\begin{aligned}0 \\\\ -3 \\\\ 1\\end{aligned}]+t[\\begin{aligned}-2 \\\\ 4 \\\\ 5\\end{aligned}],\\,s,t\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186336657} :answer-field/id #uuid "084f387c-20ba-5d6f-b73f-8af29575ee3a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186338289}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "fa39d1dc-83da-58ae-8807-0b3c8eeb9df3" :question/math-academy-id "q-70968" :question/problem "Find a parametric equation of the plane that passes through the point $S(3,-1,0)$ and is parallel to the vectors ${v}_{1}=[\\begin{aligned}0 \\\\ -3 \\\\ 1\\end{aligned}]$  and ${v}_{2}=[\\begin{aligned}-2 \\\\ 4 \\\\ 5\\end{aligned}].$" :question/worked-solution "A parametric equation of a plane is given by \n\n$$\nr=p+sb+tc,\n$$\n\nwhere $p$ is the position vector of a point on the plane and the vectors $b$ and $c$ are parallel to the plane but not to each other.\n\nHere, the position vector of the given point $S$ is $p=[\\begin{aligned}3 \\\\ -1 \\\\ 0\\end{aligned}]$, and the two vectors that are parallel to the plane (but not to each other) are ${v}_{1}=[\\begin{aligned}0 \\\\ -3 \\\\ 1\\end{aligned}]$  and ${v}_{2}=[\\begin{aligned}-2 \\\\ 4 \\\\ 5\\end{aligned}].$\n\nSo, a parametric equation of the plane is given by\n\n$$\nr=[\\begin{aligned}3 \\\\ -1 \\\\ 0\\end{aligned}]+s[\\begin{aligned}0 \\\\ -3 \\\\ 1\\end{aligned}]+t[\\begin{aligned}-2 \\\\ 4 \\\\ 5\\end{aligned}],\\,s,t\\in (-\\infty ,\\infty ).\n$$"}] [{:db/id #edb/ref 17592186338862 :knowledge-point/_questions [{:db/id #edb/ref 17592186119934 :knowledge-point/id #uuid "62196ae9-df2e-5a3a-bc0a-1c0f4c40af3e" :knowledge-point/title "Finding a Normal Vector To a Plane Given by Parametric Equation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "027279ba-c86b-5b53-9b4f-d91a6c95b4d9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨1,2,-1⟩" :db/id #edb/ref 17592186336052} {:answer/id #uuid "2b335037-3eda-5eb1-a665-40e27aacca2d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨-5,3,1⟩" :db/id #edb/ref 17592186336439} {:answer/id #uuid "3cc9ad4f-0956-53af-9375-a4dc1247e499" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨-5,3,0⟩" :db/id #edb/ref 17592186336605} {:answer/id #uuid "924674c9-4ac4-5fac-bce9-febfcdbeeeee" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨7,-3,1⟩" :db/id #edb/ref 17592186337359} {:answer/id #uuid "faf5ff12-8cff-5606-9806-8c51dfe352b9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨0,-1,3⟩" :db/id #edb/ref 17592186338232}] :answer-field/correct {:answer/id #uuid "2b335037-3eda-5eb1-a665-40e27aacca2d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨-5,3,1⟩" :db/id #edb/ref 17592186336439} :answer-field/id #uuid "0006422d-58d9-51c7-8d8f-f4fd7450f036" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186338278}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "b2e1c378-a183-516b-92fd-1753dcbc375f" :question/math-academy-id "q-70972" :question/problem "Find a normal vector to the plane\n\n$$\nr=[\\begin{aligned}\\frac{1}{2} \\\\ -1 \\\\ 13\\end{aligned}]+t[\\begin{aligned}0 \\\\ -1 \\\\ 3\\end{aligned}]+s[\\begin{aligned}1 \\\\ 2 \\\\ -1\\end{aligned}],\\,t,\\,s\\in (-\\infty ,\\infty ).\n$$" :question/worked-solution "From the parametric equation, we have that $v=⟨0,-1,3⟩$ and $w=⟨1,2,-1⟩$ are parallel to the plane.\n\nNow, we need to find a normal vector of the plane. To do that, we use the cross product of $v$ and $w$ as follows:\n\n$$\n\\begin{aligned}n & =v\\times w \\\\  & =[\\begin{aligned}0 \\\\ -1 \\\\ 3\\end{aligned}]\\times [\\begin{aligned}1 \\\\ 2 \\\\ -1\\end{aligned}] \\\\  & =\\left|\\begin{aligned}i & j & k \\\\ 0 & -1 & 3 \\\\ 1 & 2 & -1\\end{aligned}\\right| \\\\  & =-5i+3j+k \\\\  & =⟨-5,3,1⟩.\\end{aligned}\n$$\n\nTherefore, a normal vector to the plane is $n=⟨-5,3,1⟩.$"}] [{:db/id #edb/ref 17592186338863 :knowledge-point/_questions [{:db/id #edb/ref 17592186119934 :knowledge-point/id #uuid "62196ae9-df2e-5a3a-bc0a-1c0f4c40af3e" :knowledge-point/title "Finding a Normal Vector To a Plane Given by Parametric Equation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "13372795-1d9c-59ee-ba7f-59bbde3f9d61" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨3,0,3⟩" :db/id #edb/ref 17592186336213} {:answer/id #uuid "14870064-b7e8-54d0-99ca-4b64bfe2bd62" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨3,0,4⟩" :db/id #edb/ref 17592186336226} {:answer/id #uuid "2c7f5521-fd3a-51c7-9ecf-a3af94ee1454" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨1,-1,1⟩" :db/id #edb/ref 17592186336454} {:answer/id #uuid "6249715c-fc3f-56fb-9993-32d1a515b62a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨4,0,-3⟩" :db/id #edb/ref 17592186336915} {:answer/id #uuid "c671655c-abd1-563c-aef5-4ee4cece1841" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨4,1,-3⟩" :db/id #edb/ref 17592186337791}] :answer-field/correct {:answer/id #uuid "c671655c-abd1-563c-aef5-4ee4cece1841" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨4,1,-3⟩" :db/id #edb/ref 17592186337791} :answer-field/id #uuid "be9468de-a381-56af-b583-e970a0ac913c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186338618}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "3cd142bb-0e37-5169-9871-c05d6282caa6" :question/math-academy-id "q-70974" :question/problem "Find a normal vector to the plane\n\n$$\nr=[\\begin{aligned}1 \\\\ 12 \\\\ \\frac{3}{4}\\end{aligned}]+t[\\begin{aligned}3 \\\\ 0 \\\\ 4\\end{aligned}]+s[\\begin{aligned}1 \\\\ -1 \\\\ 1\\end{aligned}],\\,t,\\,s\\in (-\\infty ,\\infty ).\n$$" :question/worked-solution "From the parametric equation, we have that $v=⟨3,0,4⟩$ and $w=⟨1,-1,1⟩$ are parallel to the plane.\n\nNow, we need to find a normal vector of the plane. To do that, we use the cross product of $v$ and $w$ as follows:\n\n$$\n\\begin{aligned}n & =v\\times w \\\\  & =[\\begin{aligned}3 \\\\ 0 \\\\ 4\\end{aligned}]\\times [\\begin{aligned}1 \\\\ -1 \\\\ 1\\end{aligned}] \\\\  & =\\left|\\begin{aligned}i & j & k \\\\ 3 & 0 & 4 \\\\ 1 & -1 & 1\\end{aligned}\\right| \\\\  & =4i+j-3k \\\\  & =⟨4,1,-3⟩.\\end{aligned}\n$$\n\nTherefore, a normal vector to the plane is $n=⟨4,1,-3⟩.$"}] [{:db/id #edb/ref 17592186338867 :knowledge-point/_questions [{:db/id #edb/ref 17592186087657 :knowledge-point/id #uuid "47863922-b0d5-5a0b-8a01-ffefe3b3c929" :knowledge-point/title "Finding the Equation of a Circle Given the Endpoints of a Diameter"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "301aa6a7-5ee2-5a20-9033-4674a143461b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(x+3)^{2}+(y+3)^{2}=4" :db/id #edb/ref 17592186336492} {:answer/id #uuid "64b4c7ae-6592-5435-9dcf-3efafb11647a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(x-3)^{2}+(y-3)^{2}=16" :db/id #edb/ref 17592186336934} {:answer/id #uuid "7faacc68-2956-5fc6-9e73-4fc524688331" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(x+3)^{2}-(y+3)^{2}=4" :db/id #edb/ref 17592186337190} {:answer/id #uuid "8864933a-7a46-5b44-8a98-d9f22b098b5a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(x-3)^{2}+(y-3)^{2}=4" :db/id #edb/ref 17592186337262} {:answer/id #uuid "ed738468-0ab1-5dc7-96f4-55c16f6a1c9d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(x+3)^{2}+(y+3)^{2}=16" :db/id #edb/ref 17592186338104}] :answer-field/correct {:answer/id #uuid "64b4c7ae-6592-5435-9dcf-3efafb11647a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(x-3)^{2}+(y-3)^{2}=16" :db/id #edb/ref 17592186336934} :answer-field/id #uuid "a6d043a5-1717-5a07-aecc-41e08ef6bda7" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186338587}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "0ffdebd9-641e-5fc7-a83b-a3474a188cc9" :question/math-academy-id "q-70987" :question/problem "![](images/b6/b6a4e9a8f4a1c6dcaaad453b843896f3fc56ae22a37d481dcb4cfe54cc53361d.png)\n\nThe line segment $\\overset{―}{XY}$ is a diameter of a circle. Given that $X$ and $Y$ have coordinates $(7,3)$ and $(-1,3)$, respectively, what is the equation of the circle?" :question/worked-solution "The general equation of a circle with radius $r$ centered at the point $(a,b)$ is  \n\n$$\n(x-a)^{2}+(y-b)^{2}={r}^{2}.\n$$\n\nUsing the distance formula to compute the distance between the points $X(7,3)$ and $Y(-1,3),$ we find that the length of the diameter is \n\n$$\n\\begin{aligned}XY & =\\sqrt{{(7-(-1))}^{2}+{(3-3)}^{2}} \\\\  & =\\sqrt{{8}^{2}+{0}^{2}} \\\\  & =\\sqrt{64} \\\\  & =8.\\end{aligned}\n$$\n\nSo the radius of the circle is \n\n$$\nr=\\frac{8}{2}=4.\n$$\n\nSince the center of a circle is the midpoint of the diameter, to find the center we use the midpoint formula as follows:\n\n$$\n(\\frac{{x}_{1}+{x}_{2}}{2},\\frac{{y}_{1}+{y}_{2}}{2})=(\\frac{7+(-1)}{2},\\frac{3+3}{2})=(3,3)\n$$\n\nSo our circle has radius $r=4$ and center $(a,b)=(3,3),$ and therefore it is represented by the following equation:\n\n$$\n\\begin{aligned}(x-a)^{2}+(y-b)^{2} & ={r}^{2} \\\\ (x-3)^{2}+(y-3)^{2} & ={4}^{2} \\\\ (x-3)^{2}+(y-3)^{2} & =16\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186338869 :knowledge-point/_questions [{:db/id #edb/ref 17592186176050 :knowledge-point/id #uuid "eed0c7c3-0bb5-56eb-a9ca-9ec4dc7b3efe" :knowledge-point/title "Utilizing the Periodicity Property of the Tangent Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "37934bed-1f9a-50c5-9a8d-e5b0b59e71a5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5-5\\pi " :db/id #edb/ref 17592186336549} {:answer/id #uuid "4b39580e-c808-5289-b894-51d8505df304" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5\\pi " :db/id #edb/ref 17592186336729} {:answer/id #uuid "5de9a8b6-2bf6-5e41-98c3-3ffaa96e81dc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186336881} {:answer/id #uuid "81ac5deb-9cc0-5543-8625-93f7cbf3fed8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186337211} {:answer/id #uuid "b2061940-30fc-5eef-a2d6-609b6aeedec0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186337622}] :answer-field/correct {:answer/id #uuid "b2061940-30fc-5eef-a2d6-609b6aeedec0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186337622} :answer-field/id #uuid "0ab98c3a-7c21-528d-8351-dfb2882c1ded" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186338295}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "35b95266-3a2f-569f-acd3-81fb0b0052f7" :question/math-academy-id "q-70998" :question/problem "If $tan⁡x=3,$ for some $x$, find the value of $tan⁡(x+5\\pi )+2.$" :question/worked-solution "The period of $y=tan⁡x$ is $\\pi .$ Therefore, for integer $n$ we have\n\n$$\ntan⁡x=tan⁡(x+n\\pi ).\n$$\n\nSubstituting $n=5$ into the right-hand-side of the above gives\n\n$$\n\\begin{aligned}tan⁡x=tan⁡(x+5\\cdot \\pi )=tan⁡(x+5\\pi ).\\end{aligned}\n$$\n\nTherefore, if $tan⁡x=3,$ we get that $tan⁡(x+5\\pi )=3.$\n\nFinally, then\n\n$$\ntan⁡(x+5\\pi )+2=(3)+2=5.\n$$"}] [{:db/id #edb/ref 17592186338876 :knowledge-point/_questions [{:db/id #edb/ref 17592186119827 :knowledge-point/id #uuid "d44cf726-a4a6-5ac9-a63c-7464fe5566c5" :knowledge-point/title "Finding the Cartesian Equation of a Line Given in Parametric or Vector Form"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4687a476-743c-5663-8059-be516a1b00d0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{x-10}{3}=\\frac{y}{-7}=\\frac{z+6}{-5}" :db/id #edb/ref 17592186336687} {:answer/id #uuid "4ee0f395-cc46-5d7d-8c23-3711b1bbc7db" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{x}{3}=\\frac{y}{-7}=\\frac{z}{-5}" :db/id #edb/ref 17592186336761} {:answer/id #uuid "5eb4e60c-fc92-5e6a-873c-9adb63a08f65" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{x-3}{10}=\\frac{z+5}{-6},\\,y=-7" :db/id #edb/ref 17592186336892} {:answer/id #uuid "ae824b75-7b04-55e9-9b91-a0db68311c7f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{x+10}{3}=\\frac{y}{-7}=\\frac{z-6}{-5}" :db/id #edb/ref 17592186337598} {:answer/id #uuid "aeb80ffc-9a94-5fa5-b322-54fc8ccc30cc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{x+3}{10}=\\frac{z-5}{-6},\\,y=7" :db/id #edb/ref 17592186337600}] :answer-field/correct {:answer/id #uuid "4687a476-743c-5663-8059-be516a1b00d0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{x-10}{3}=\\frac{y}{-7}=\\frac{z+6}{-5}" :db/id #edb/ref 17592186336687} :answer-field/id #uuid "e26532ed-39ca-568b-b8c1-04064e77541d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186338676}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "5a15416a-0d95-55a8-b911-87d641acee2e" :question/math-academy-id "q-71028" :question/problem "Consider the straight line with the vector equation\n\n$$\nr=[\\begin{aligned}10 \\\\ 0 \\\\ -6\\end{aligned}]+t[\\begin{aligned}3 \\\\ -7 \\\\ -5\\end{aligned}]\n$$\n\nfor $t\\in (-\\infty ,\\infty ).$ Find the Cartesian equation of this line." :question/worked-solution "We have the vector equation \n\n$$\nr=[\\begin{aligned}10 \\\\ 0 \\\\ -6\\end{aligned}]+t[\\begin{aligned}3 \\\\ -7 \\\\ -5\\end{aligned}],\\,t\\in (-\\infty ,\\infty ).\n$$\n\nThis implies that the straight line passes through the point $P(10,0,-6)$ and is parallel to the vector $v=⟨3,-7,-5⟩.$ So, its Cartesian (canonical) equation is given by\n\n$$\n\\frac{x-10}{3}=\\frac{y-0}{-7}=\\frac{z-(-6)}{-5}=t,\\,t\\in (-\\infty ,\\infty ).\n$$\n\nSimplifying, we reach\n\n$$\n\\frac{x-10}{3}=\\frac{y}{-7}=\\frac{z+6}{-5}.\n$$"}] [{:db/id #edb/ref 17592186338878 :knowledge-point/_questions [{:db/id #edb/ref 17592186119828 :knowledge-point/id #uuid "cbc74baa-313b-51e7-8ae1-5e9fe0761256" :knowledge-point/title "Finding the Cartesian Equation of a Line Given Two Points on the Line"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "68dc5f00-83c7-53e1-a431-3f9ecb95097f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{x+9}{4}=\\frac{y+3}{-5}=\\frac{z-7}{3}" :db/id #edb/ref 17592186336965} {:answer/id #uuid "99e37d85-5446-5b2d-8f13-39450e565e90" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{x-4}{9}=\\frac{y+5}{3}=\\frac{z-3}{-7}" :db/id #edb/ref 17592186337431} {:answer/id #uuid "a40025cc-d4e3-56de-865a-c669abbecae2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{x+4}{9}=\\frac{y-5}{3}=\\frac{z+3}{-7}" :db/id #edb/ref 17592186337521} {:answer/id #uuid "da18075b-505b-551d-a5e1-c55e43718c88" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{x-9}{4}=\\frac{y-3}{-5}=\\frac{z+7}{3}" :db/id #edb/ref 17592186337932} {:answer/id #uuid "deeb58c9-e2b4-5a3a-942e-1cd0a54981a2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{x}{4}=\\frac{y}{-5}=\\frac{z}{3}" :db/id #edb/ref 17592186337977}] :answer-field/correct {:answer/id #uuid "da18075b-505b-551d-a5e1-c55e43718c88" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{x-9}{4}=\\frac{y-3}{-5}=\\frac{z+7}{3}" :db/id #edb/ref 17592186337932} :answer-field/id #uuid "b0db96f4-8315-5937-8bf9-ee8849260120" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186338601}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "489a2b97-718c-5e30-886b-642db6f4e1ba" :question/math-academy-id "q-71030" :question/problem "Find a Cartesian equation of the straight line that passes through $P(9,3,-7)$ and is parallel to $v=⟨4,-5,3⟩.$" :question/worked-solution "Remember that the Cartesian (canonical) equation of the straight line that passes through the point $P({x}_{0},{y}_{0},{z}_{0})$ and is parallel to the vector $v=⟨{v}_{x},{v}_{y},{v}_{z}⟩$, is given by\n\n$$\n\\frac{x-{x}_{0}}{{v}_{x}}=\\frac{y-{y}_{0}}{{v}_{y}}=\\frac{z-{z}_{0}}{{v}_{z}}=t,\\,t\\in (-\\infty ,\\infty ).\n$$\n\nSo, we have\n\n$$\n\\frac{x-9}{4}=\\frac{y-3}{-5}=\\frac{z-(-7)}{3}=t,\\,t\\in (-\\infty ,\\infty )\n$$\n\nor equivalently\n\n$$\n\\frac{x-9}{4}=\\frac{y-3}{-5}=\\frac{z+7}{3}.\n$$"}] [{:db/id #edb/ref 17592186338880 :knowledge-point/_questions [{:db/id #edb/ref 17592186119842 :knowledge-point/id #uuid "07c209a4-5c69-561e-9015-28b0f6e436e5" :knowledge-point/title "Finding the Cartesian Equation of a Line When a Component of the Direction Vector is Zero"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1e0b4186-9928-58b4-8819-35423e1e0068" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{y-6}{10}=\\frac{z+2}{3},\\,x=-3" :db/id #edb/ref 17592186336310} {:answer/id #uuid "50820664-a7f6-5b55-9476-029673b80c78" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{x}{-3}=\\frac{y-10}{6}=\\frac{z-3}{-2}" :db/id #edb/ref 17592186336771} {:answer/id #uuid "933a9135-02ba-5925-965d-ddb23e164c75" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{y+6}{10}=\\frac{z-2}{3},\\,x=3" :db/id #edb/ref 17592186337373} {:answer/id #uuid "de1fd4dc-f550-5479-9beb-f535161eede1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "None of the listed" :db/id #edb/ref 17592186337963} {:answer/id #uuid "fa860762-e327-5c0a-92c1-afb3900761b6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{x}{-3}=\\frac{y+10}{6}=\\frac{z+3}{-2}" :db/id #edb/ref 17592186338228}] :answer-field/correct {:answer/id #uuid "1e0b4186-9928-58b4-8819-35423e1e0068" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{y-6}{10}=\\frac{z+2}{3},\\,x=-3" :db/id #edb/ref 17592186336310} :answer-field/id #uuid "1a12a0a6-eca3-5324-87ae-e350ea1c6ee0" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186338324}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "d55a1be6-a075-557b-b7ae-a0512fb81218" :question/math-academy-id "q-71035" :question/problem "Find the Cartesian equation for the line with the following vector equation:\n\n$$\nr=[\\begin{aligned}-3 \\\\ 6 \\\\ -2\\end{aligned}]+t[\\begin{aligned}0 \\\\ 10 \\\\ 3\\end{aligned}],\\,t\\in (-\\infty ,\\infty )\n$$" :question/worked-solution "Using the usual formula, we get\n\n$$\n\\frac{x-(-3)}{0}=\\frac{y-6}{10}=\\frac{z-(-2)}{3}=t,\\,t\\in (-\\infty ,\\infty ),\n$$\n\nor equivalently\n\n$$\n\\frac{x+3}{0}=\\frac{y-6}{10}=\\frac{z+2}{3},\n$$\n\nwhich is problematic because $\\frac{x+3}{0}$ involves division by zero.\n\nHowever, notice that in our line, the $x$ component always maintains the constant value of $x=-3:$\n\n$$\nr=[\\begin{aligned}-3 \\\\ 6+10t \\\\ -2+3t\\end{aligned}],\\,t\\in (-\\infty ,\\infty )\n$$\n\nSo, in the Cartesian equation, we remove the $\\frac{x+3}{0}$ part and instead write $x=-3$, as follows:\n\n$$\n\\frac{y-6}{10}=\\frac{z+2}{3},\\,x=-3\n$$"}] [{:db/id #edb/ref 17592186393064 :knowledge-point/_questions [{:db/id #edb/ref 17592186119936 :knowledge-point/id #uuid "d11f13f0-1cfa-59ec-a04a-9483d942b1aa" :knowledge-point/title "Finding the Parametric Equation of the Plane Passing Through Three Given Points"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "11fe6c60-77f7-596d-b73e-0a2b1a46b507" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "r=⟨3,6,2⟩+s⟨-1,-15,-2⟩+t⟨2,-9,0⟩,\\,s,t\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186393066} {:answer/id #uuid "18c27f61-10ac-5e9a-9262-ba682e6d266e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The plane is undefined" :db/id #edb/ref 17592186393067} {:answer/id #uuid "a673c983-c8f1-5b15-8abb-116913587299" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "r=⟨3,6,2⟩+s⟨-1,-15,-2⟩+t⟨0,-6,-1⟩,\\,s,t\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186393068} {:answer/id #uuid "f377602b-aa7b-52c3-8d62-a25cd478c050" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "r=⟨3,6,2⟩+s⟨0,-6,-1⟩+t⟨3,0,1⟩,\\,s,t\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186393069} {:answer/id #uuid "37a16cbe-c7b9-5d98-99c1-895ad8adbfef" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "r=⟨3,6,2⟩+s⟨2,-9,0⟩+t⟨3,0,1⟩,\\,s,t\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186393070}] :answer-field/correct {:answer/id #uuid "a673c983-c8f1-5b15-8abb-116913587299" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "r=⟨3,6,2⟩+s⟨-1,-15,-2⟩+t⟨0,-6,-1⟩,\\,s,t\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186393068} :answer-field/id #uuid "141932d6-a6f5-58b4-ba12-7fe47a40ab43" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186393065}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "901f1360-df93-5e5e-ac60-c5607de4f628" :question/math-academy-id "q-71036" :question/problem "Find a parametric equation of the plane that passes through the points $P(3,6,2),\\,Q(2,-9,0)$, and $R(3,0,1).$" :question/worked-solution "First, we need to find two vectors that are parallel to the plane (but not to each other). Let's use the displacement vectors $\\overset{\\to }{PQ}$ and $\\overset{\\to }{PR},$ as follows:\n\n$$\n\\begin{aligned}\\overset{\\to }{PQ} & =⟨2,-9,0⟩-⟨3,6,2⟩ \\\\  & =⟨-1,-15,-2⟩ \\\\ \\overset{\\to }{PR} & =⟨3,0,1⟩-⟨3,6,2⟩ \\\\  & =⟨0,-6,-1⟩\\end{aligned}\n$$\n\nNow, if we consider the position vector $p=⟨3,6,2⟩$ of the point $P,$ then the corresponding parametric equation of the plane is given by\n\n$$\n\\begin{aligned}r & =p+s\\overset{\\to }{PQ}+t\\overset{\\to }{PR} \\\\ r & =⟨3,6,2⟩+s⟨-1,-15,-2⟩+t⟨0,-6,-1⟩,\\,s,t\\in (-\\infty ,\\infty ).\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186366205 :knowledge-point/_questions [{:db/id #edb/ref 17592186119936 :knowledge-point/id #uuid "d11f13f0-1cfa-59ec-a04a-9483d942b1aa" :knowledge-point/title "Finding the Parametric Equation of the Plane Passing Through Three Given Points"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "abe04ef1-0077-539a-b85c-52caa98344a5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "r=⟨1,1,1⟩+s⟨0,1,1⟩+t⟨-3,2,4⟩,\\,s,t\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186366207} {:answer/id #uuid "4a96f288-3fd0-537b-806e-046844764150" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The plane is undefined" :db/id #edb/ref 17592186366208} {:answer/id #uuid "fac45cd4-59c7-516c-bd74-1e4a54e263c2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "r=⟨1,1,1⟩+s⟨-3,2,4⟩+t⟨1,1,1⟩,\\,s,t\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186366209} {:answer/id #uuid "4e15b755-6aa5-59e8-8ede-166d794590c7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "r=⟨1,1,1⟩+s⟨0,1,1⟩+t⟨1,1,1⟩,\\,s,t\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186366210} {:answer/id #uuid "6d4ca503-3a78-5aa5-ac98-b7e77b80a651" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "r=⟨1,1,1⟩+s⟨0,1,1⟩+t⟨-4,1,3⟩,\\,s,t\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186366211}] :answer-field/correct {:answer/id #uuid "6d4ca503-3a78-5aa5-ac98-b7e77b80a651" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "r=⟨1,1,1⟩+s⟨0,1,1⟩+t⟨-4,1,3⟩,\\,s,t\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186366211} :answer-field/id #uuid "3b9dde6c-05bb-5b0d-9060-015e400fc047" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186366206}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "340957e8-d465-5c3d-b1df-5f238a4c6329" :question/math-academy-id "q-71040" :question/problem "Find a parametric equation of the plane that passes through the points $C(1,1,1)$ and $D(-3,2,4)$, and is parallel to the vector $v=⟨0,1,1⟩.$" :question/worked-solution "First, we need to find two vectors that are parallel to the plane (but not to each other). We already have one vector $v=⟨0,1,1⟩.$ Let's also use the displacement vector $\\overset{\\to }{CD}$, as follows:\n\n$$\n\\begin{aligned}\\overset{\\to }{CD} & =⟨-3,2,4⟩-⟨1,1,1⟩ \\\\  & =⟨-4,1,3⟩\\end{aligned}\n$$\n\nNow, if we consider the position vector $c=⟨1,1,1⟩$ of the point $C,$ then the corresponding parametric equation of the plane is given by\n\n$$\n\\begin{aligned}r & =c+sv+t\\overset{\\to }{CD} \\\\ r & =⟨1,1,1⟩+s⟨0,1,1⟩+t⟨-4,1,3⟩,\\,s,t\\in (-\\infty ,\\infty ).\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186338885 :knowledge-point/_questions [{:db/id #edb/ref 17592186119842 :knowledge-point/id #uuid "07c209a4-5c69-561e-9015-28b0f6e436e5" :knowledge-point/title "Finding the Cartesian Equation of a Line When a Component of the Direction Vector is Zero"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5d62ea8b-6e9e-5022-91fe-53a644c300c5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{x+3}{7}=\\frac{y-1}{-3},\\,z=-6" :db/id #edb/ref 17592186336878} {:answer/id #uuid "66acea60-d3a4-5ac0-8ea0-7c9fbe25b6b2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{x+7}{3}=\\frac{y-3}{-1},\\,z=0" :db/id #edb/ref 17592186336948} {:answer/id #uuid "723fd5ed-33ed-5428-814e-1d3978a8c781" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{x-3}{7}=\\frac{y+1}{-3}=z-6" :db/id #edb/ref 17592186337055} {:answer/id #uuid "76f3443d-ef8a-5477-b57b-73c45cafa5bb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{x-7}{3}=\\frac{y+3}{-1},\\,z=0" :db/id #edb/ref 17592186337102} {:answer/id #uuid "d5f9d917-fd3b-5507-b0e2-5b54f65a6141" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{x-3}{7}=\\frac{y+1}{-3},\\,z=6" :db/id #edb/ref 17592186337895}] :answer-field/correct {:answer/id #uuid "d5f9d917-fd3b-5507-b0e2-5b54f65a6141" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{x-3}{7}=\\frac{y+1}{-3},\\,z=6" :db/id #edb/ref 17592186337895} :answer-field/id #uuid "6457376e-bcd6-51d2-af91-27301347c726" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186338455}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "2a6a8e27-9a19-5fb3-94f8-af73e4c67f56" :question/math-academy-id "q-71048" :question/problem "Find the Cartesian equation for the line with the following vector equation:\n\n$$\nr=[\\begin{aligned}3 \\\\ -1 \\\\ 6\\end{aligned}]+t[\\begin{aligned}7 \\\\ -3 \\\\ 0\\end{aligned}],\\,t\\in (-\\infty ,\\infty )\n$$" :question/worked-solution "Using the usual formula, we get\n\n$$\n\\frac{x-3}{7}=\\frac{y-(-1)}{-3}=\\frac{z-6}{0}=t,\\,t\\in (-\\infty ,\\infty ),\n$$\n\nor equivalently\n\n$$\n\\frac{x-3}{7}=\\frac{y+1}{-3}=\\frac{z-6}{0},\n$$\n\nwhich is problematic because $\\frac{z-6}{0}$ involves division by zero.\n\nHowever, notice that in our line, the $z$ component always maintains the constant value of $z=6:$\n\n$$\nr=[\\begin{aligned}3+7t \\\\ -1-3t \\\\ 6\\end{aligned}],\\,t\\in (-\\infty ,\\infty )\n$$\n\nSo, in the Cartesian equation, we remove the $\\frac{z-6}{0}$ part and instead write $z=6$, as follows:\n\n$$\n\\frac{x-3}{7}=\\frac{y+1}{-3},\\,z=6\n$$"}] [{:db/id #edb/ref 17592186338888 :knowledge-point/_questions [{:db/id #edb/ref 17592186064318 :knowledge-point/id #uuid "70029065-69c3-585d-a6a1-cc9d2485a60a" :knowledge-point/title "Applying the Definition of Continuity to Evaluate a Limit"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "144aa466-fc47-529b-95bd-84f4d3861d51" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "9" :db/id #edb/ref 17592186336223} {:answer/id #uuid "1b9d7eef-900c-52cb-b1c7-b63f1efceae9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186336289} {:answer/id #uuid "93ed488f-6935-56e6-be2e-80f5fbe53a43" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186337383} {:answer/id #uuid "a7b36ae3-d363-5e51-90f6-5648576ae0d5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186337549} {:answer/id #uuid "faa555a1-33e5-5b0d-9db8-9add99459918" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186338231}] :answer-field/correct {:answer/id #uuid "1b9d7eef-900c-52cb-b1c7-b63f1efceae9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186336289} :answer-field/id #uuid "e590fe1f-5e64-5f83-9bfa-dbf4e8777a47" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186338682}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "05c16066-c0df-52d0-bb6d-c89ff088cac5" :question/math-academy-id "q-71070" :question/problem "If $f(x)$ is continuous at $x=0$ and $f(0)=2,$ then what is the value of\n\n$$\n{lim}_{x\\to {0}^{+}}{({(f(x))}^{2}-3)}^{2}\\,?\n$$" :question/worked-solution "We're told that $f(x)$ is continuous at $x=0.$ According to the definition of continuity, this means that ${lim}_{x\\to 0}f(x)$ exists, and\n\n$$\n{lim}_{x\\to {0}^{+}}f(x)=f(0)=2.\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}{lim}_{x\\to {0}^{+}}{({(f(x))}^{2}-3)}^{2} & ={({2}^{2}-3)}^{2}={1}^{2}=1.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186338889 :knowledge-point/_questions [{:db/id #edb/ref 17592186064318 :knowledge-point/id #uuid "70029065-69c3-585d-a6a1-cc9d2485a60a" :knowledge-point/title "Applying the Definition of Continuity to Evaluate a Limit"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4ebd0c10-a6d6-5cc9-a5c9-ddcd47d050cf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186336759} {:answer/id #uuid "507f8e57-664f-5400-bbd8-d4a57da67ea3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "25" :db/id #edb/ref 17592186336770} {:answer/id #uuid "6645f6bd-0246-5646-be59-dcadbe943286" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "16" :db/id #edb/ref 17592186336944} {:answer/id #uuid "85e73ccf-7925-5618-8951-5d04909c6605" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "36" :db/id #edb/ref 17592186337242} {:answer/id #uuid "8b5a9a94-cb73-580d-9c82-f44e0061dd54" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "9" :db/id #edb/ref 17592186337294}] :answer-field/correct {:answer/id #uuid "6645f6bd-0246-5646-be59-dcadbe943286" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "16" :db/id #edb/ref 17592186336944} :answer-field/id #uuid "6565ac07-4add-5790-8623-4f26a36b8a37" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186338457}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "e4f90488-b0ea-572b-b9cc-768b8c7e07c2" :question/math-academy-id "q-71071" :question/problem "If $f(x)$ is continuous at $x=4$ and $f(4)=2,$ then what is ${lim}_{x\\to 4}{({x}^{2}-6f(x))}^{2}?$" :question/worked-solution "We're told that $f(x)$ is continuous at $x=4.$ According to the definition of continuity, this means that ${lim}_{x\\to 4}f(x)$ exists, and\n\n$$\n{lim}_{x\\to 4}f(x)=f(4)=2.\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}{lim}_{x\\to 4}{({x}^{2}-6f(x))}^{2} & ={({4}^{2}-6(2))}^{2} \\\\  & ={(16-12)}^{2} \\\\  & ={4}^{2} \\\\  & =16.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186338891 :knowledge-point/_questions [{:db/id #edb/ref 17592186064317 :knowledge-point/id #uuid "fa1ddb40-3494-541c-b23e-b15dd98bf669" :knowledge-point/title "Identifying the Reason for a Discontinuity"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "53623a55-b77d-5351-9fc2-d973dfa306f4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$f(-1)$ does not exist" :db/id #edb/ref 17592186336802} {:answer/id #uuid "79c71031-97e9-5e1d-a6ba-e74f9e41cc73" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{lim}_{x\\to (-1)}f(x)\\ne f(-1)" :db/id #edb/ref 17592186337129} {:answer/id #uuid "976f1ad0-705e-5259-a60b-4f7ca8ac9ef3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "${lim}_{x\\to (-1)^{-}}f(x)$ does not exist" :db/id #edb/ref 17592186337413} {:answer/id #uuid "aaa26b4e-cfda-5c6f-8638-0760a72b3b60" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "${lim}_{x\\to (-1)^{+}}f(x)$ does not exist" :db/id #edb/ref 17592186337570} {:answer/id #uuid "fb13ed6b-6c19-5ee0-9d99-95a01f90eaeb" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "${lim}_{x\\to (-1)}f(x)$ does not exist" :db/id #edb/ref 17592186338236}] :answer-field/correct {:answer/id #uuid "79c71031-97e9-5e1d-a6ba-e74f9e41cc73" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{lim}_{x\\to (-1)}f(x)\\ne f(-1)" :db/id #edb/ref 17592186337129} :answer-field/id #uuid "af56593a-6a9e-589a-b62d-3c3c78f2abea" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186338599}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "c90a0801-6b26-5a6a-b72a-693261024597" :question/math-academy-id "q-71079" :question/problem "For what reason does the function $f(x)$ given below have a discontinuity at $x=-1?$\n\n$$\nf(x)=\\{\\begin{aligned}\\frac{{x}^{2}+1}{2}, & x<-1 \\\\ 2, & x=-1 \\\\ \\frac{2}{{x}^{2}+1}, & x>-1\\end{aligned}\n$$" :question/worked-solution "Let's check the conditions necessary for $f(x)$ to be continuous at $x=-1.$\n\n- $f(-1)=2,$ so $f(-1)$ exists. $✓$\n\n- We calculate the one-sided limits and check if they coincide:\n\n$$\n\\begin{aligned}{lim}_{x\\to (-1)^{-}}f(x) & ={lim}_{x\\to (-1)^{-}}(\\frac{{x}^{2}+1}{2}) \\\\  & =\\frac{(-1)^{2}+1}{2} \\\\  & =\\frac{1+1}{2} \\\\  & =1, \\\\ {lim}_{x\\to (-1)^{+}}f(x) & ={lim}_{x\\to (-1)^{+}}(\\frac{2}{{x}^{2}+1}) \\\\  & =\\frac{2}{(-1)^{2}+1} \\\\  & =\\frac{2}{1+1} \\\\  & =1.\\end{aligned}\n$$\n\nTherefore, the overall limit exists and ${lim}_{x\\to (-1)}f(x)=1$ $✓$\n\n- The limit of the function is not equal to the function value: ${lim}_{x\\to (-1)}f(x)=1,$ while $f(-1)=2.$ $\\,\\,\\times $\n\nTherefore, the function $f(x)$ has a discontinuity at $x=-1$ because ${lim}_{x\\to (-1)}f(x)\\ne f(-1).$"}] [{:db/id #edb/ref 17592186338897 :knowledge-point/_questions [{:db/id #edb/ref 17592186064263 :knowledge-point/id #uuid "43e68991-37f0-543e-a4da-b78b395a8494" :knowledge-point/title "Determining the Position of a Particle Given Its Acceleration, Initial Velocity and Initial Position"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2aefedc4-27d9-54a2-8573-f51f9d7f581c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x(t)={t}^{2}+{t}^{3}+4t+2." :db/id #edb/ref 17592186336434} {:answer/id #uuid "64a7cf2e-743a-5ae9-a3b3-39dd959007fc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x(t)=\\frac{1}{2}{t}^{2}-{t}^{3}+4t+2" :db/id #edb/ref 17592186336933} {:answer/id #uuid "664f4703-f165-5d27-b633-1b56ff447e32" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x(t)={t}^{2}-{t}^{3}+2t+2." :db/id #edb/ref 17592186336945} {:answer/id #uuid "72c9134b-e660-5c5c-bc37-f07120bfc930" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x(t)=\\frac{1}{2}{t}^{2}-{t}^{3}+6t." :db/id #edb/ref 17592186337064} {:answer/id #uuid "c1585c37-ef87-5746-8692-9db319d1ee04" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x(t)=\\frac{1}{2}{t}^{2}+{t}^{3}+6t-2." :db/id #edb/ref 17592186337750}] :answer-field/correct {:answer/id #uuid "64a7cf2e-743a-5ae9-a3b3-39dd959007fc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x(t)=\\frac{1}{2}{t}^{2}-{t}^{3}+4t+2" :db/id #edb/ref 17592186336933} :answer-field/id #uuid "52dd2f56-1deb-5ef5-bceb-35cca96b6e4b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186338420}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "ba22cd98-5399-5a26-89d7-865b0c3ece95" :question/math-academy-id "q-7111" :question/problem "A particle moves along a straight line relative to a fixed origin $O$ with acceleration $a(t)=1-6t,$ where $t\\ge 0$ is the time. If the particle has position $x=2$ and velocity $v=4$ when $t=0,$ calculate the position $x$ of the particle at time $t>0.$" :question/worked-solution "We start by integrating the acceleration to get the velocity $v(t):$\n\n$$\n\\begin{aligned}v(t) & =\\int a(t)\\,\\text{d}t \\\\  & =\\int (1-6t)\\,\\text{d}t \\\\  & =t-3{t}^{2}+C\\end{aligned}\n$$\n\nTo determine $C,$ we use the fact that $v(0)=4.$ Substituting this into the above gives\n\n$$\n\\begin{aligned}4 & =(0)-3(0)^{2}+C \\\\ C & =4.\\end{aligned}\n$$\n\nSo the velocity is given by $v(t)=t-3{t}^{2}+4.$\n\nNow, we integrate the velocity to get $x(t):$\n\n$$\n\\begin{aligned}x(t) & =\\int v(t)\\,\\text{d}t \\\\  & =\\int (t-3{t}^{2}+4)\\,\\text{d}t \\\\  & =\\frac{1}{2}{t}^{2}-{t}^{3}+4t+K\\end{aligned}\n$$\n\nTo determine $K,$ we use the fact that $x(0)=2.$ Substituting this into the above gives\n\n$$\n\\begin{aligned}2 & =\\frac{1}{2}(0)^{2}-(0)^{3}+4(0)+K \\\\ K & =2.\\end{aligned}\n$$\n\nTherefore, the position $x$ of the particle at time $t$ is \n\n$$\nx(t)=\\frac{1}{2}{t}^{2}-{t}^{3}+4t+2.\n$$"}] [{:db/id #edb/ref 17592186338901 :knowledge-point/_questions [{:db/id #edb/ref 17592186105734 :knowledge-point/id #uuid "9331987e-8676-5bdb-b4ce-2129b1b09a8c" :knowledge-point/title "Calculating the Altitude of a Triangle Given Its Vertices"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "093467b9-0067-542c-b65c-633c1cfc4b53" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{3}" :db/id #edb/ref 17592186336113} {:answer/id #uuid "3859e15a-56e5-569e-825a-f822ed3eac71" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3\\sqrt{6}}{2}" :db/id #edb/ref 17592186336557} {:answer/id #uuid "6c2eb1b1-c7b8-5381-b418-d9244be8d489" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\sqrt{3}" :db/id #edb/ref 17592186336991} {:answer/id #uuid "d8d294a1-32a0-5b4f-94b7-ee30ffc9011a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{6}" :db/id #edb/ref 17592186337918} {:answer/id #uuid "de85db2c-4065-5f60-92b7-7fdad6d31158" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3\\sqrt{2}" :db/id #edb/ref 17592186337972}] :answer-field/correct {:answer/id #uuid "d8d294a1-32a0-5b4f-94b7-ee30ffc9011a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{6}" :db/id #edb/ref 17592186337918} :answer-field/id #uuid "8d1b4065-470d-599f-81c3-c9f0fd87b16f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186338536}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "9999542b-9f9f-5d86-95f6-bcd8d4190efb" :question/math-academy-id "q-71116" :question/problem "Calculate the length of the altitude $ZH$ of the $△\\,WYZ$, if $W(2,3,2)$, $Y(1,2,1)$, $Z(1,-1,1).$" :question/worked-solution "Note that the length of the altitude $ZH$ can be related to the area of $△\\,WYZ$ as follows:\n\n$$\n{A}_{△}=\\frac{1}{2}ZH\\cdot WY\n$$\n\nSo, to find $ZH,$ we first find ${A}_{△}.$ To start, we find the vectors $\\overset{\\to }{WY}$ and $\\overset{\\to }{WZ}:$\n\n$$\n\\begin{aligned}\\overset{\\to }{WY} & =y-w \\\\  & =(i+2j+k)-(2i+3j+2k) \\\\  & =-i-j-k \\\\  & =⟨-1,-1,-1⟩ \\\\ \\overset{\\to }{WZ} & =z-w \\\\  & =(i-j+k)-(2i+3j+2k) \\\\  & =-i-4j-k \\\\  & =⟨-1,-4,-1⟩\\end{aligned}\n$$\n\nNow, we have\n\n$$\n\\begin{aligned}\\overset{\\to }{WY}\\times \\overset{\\to }{WZ} & =|\\begin{aligned}i & j & k \\\\ -1 & -1 & -1 \\\\ -1 & -4 & -1\\end{aligned}| \\\\  & =|\\begin{aligned}-1 & -1 \\\\ -4 & -1\\end{aligned}|i-|\\begin{aligned}-1 & -1 \\\\ -1 & -1\\end{aligned}|j+|\\begin{aligned}-1 & -1 \\\\ -1 & -4\\end{aligned}|k \\\\  & =((-1)\\cdot (-1)-(-4)\\cdot (-1))i-((-1)\\cdot (-1)-(-1)\\cdot (-1))j+((-1)\\cdot (-4)-(-1)\\cdot (-1))k \\\\  & =-3i+3k \\\\  & =⟨-3,0,3⟩.\\end{aligned}\n$$\n\nTherefore, the area of the parallelogram spanned by $\\overset{\\to }{WY}$ and $\\overset{\\to }{WZ}$ is\n\n$$\n\\begin{aligned}A & =|\\overset{\\to }{WY}\\times \\overset{\\to }{WZ}| \\\\  & =\\sqrt{(-3)^{2}+{0}^{2}+{3}^{2}} \\\\  & =\\sqrt{18} \\\\  & =3\\sqrt{2}.\\end{aligned}\n$$\n\nThe area of the triangle is half of the area of the respective parallelogram. So, the area of $△\\,WYZ$ is\n\n$$\n{A}_{△}=\\frac{1}{2}A=\\frac{3\\sqrt{2}}{2}.\n$$\n\nLet's also compute $WY$ since it appears in the formula:\n\n$$\n\\begin{aligned}WY & =|\\overset{\\to }{WY}| \\\\  & =\\sqrt{(-1)^{2}+(-1)^{2}+(-1)^{2}} \\\\  & =\\sqrt{3}.\\end{aligned}\n$$\n\n \n\nFinally, using the formula ${A}_{△}=\\frac{1}{2}ZH\\cdot WY,$ we get\n\n$$\n\\begin{aligned}{A}_{△} & =\\frac{1}{2}ZH\\cdot WY \\\\ \\frac{3\\sqrt{2}}{2} & =\\frac{1}{2}ZH\\cdot \\sqrt{3} \\\\ 3\\sqrt{2} & =ZH\\cdot \\sqrt{3} \\\\ ZH & =\\frac{3\\sqrt{2}}{\\sqrt{3}} \\\\ ZH & =\\sqrt{6}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186338903 :knowledge-point/_questions [{:db/id #edb/ref 17592186124502 :knowledge-point/id #uuid "64e7d2fb-003c-58c0-ab80-159e50748cc7" :knowledge-point/title "Calculating Intercepts of Spheres and Ellipsoids"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "137c4cf0-cd34-5bf3-8f1b-d7ebc8a8387a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$(0,0,0)$ only" :db/id #edb/ref 17592186336217} {:answer/id #uuid "3f3c3301-bbd6-5dcf-b2fe-7e23ffba2f65" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$(0,0,\\frac{11}{6})$ only" :db/id #edb/ref 17592186336626} {:answer/id #uuid "450134b7-7793-5e79-bedf-b78f8ecf39bf" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$(0,0,-\\frac{11}{6})$ and $(0,0,\\frac{11}{6})$" :db/id #edb/ref 17592186336675} {:answer/id #uuid "71fc6780-d759-5ca8-b7b0-c27afef7a8fd" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$(0,0,-\\sqrt{11})$ and $(0,0,\\sqrt{11})$" :db/id #edb/ref 17592186337052} {:answer/id #uuid "9f05902f-d803-56bd-afb7-40d0544ddc66" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$(0,0,0)$ and $(0,0,\\frac{11}{6})$" :db/id #edb/ref 17592186337469}] :answer-field/correct {:answer/id #uuid "450134b7-7793-5e79-bedf-b78f8ecf39bf" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$(0,0,-\\frac{11}{6})$ and $(0,0,\\frac{11}{6})$" :db/id #edb/ref 17592186336675} :answer-field/id #uuid "3f8c4647-f9a9-5e22-8365-dfc4098f493e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186338393}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "a0a32df2-c60c-5dd6-84db-2be85445005e" :question/math-academy-id "q-71118" :question/problem "Given the ellipsoid $\\frac{(x+1)^{2}}{4}+\\frac{(y-2)^{2}}{9}+\\frac{{z}^{2}}{11}=1$, find its intercepts with the $z$-axis." :question/worked-solution "To find the $z$-intercepts, we plug $x=0$ and $y=0$ into the equation:\n\n$$\n\\begin{aligned}\\frac{(0+1)^{2}}{4}+\\frac{(0-2)^{2}}{9}+\\frac{{z}^{2}}{11} & =1 \\\\ \\frac{1}{4}+\\frac{4}{9}+\\frac{{z}^{2}}{11} & =1 \\\\ \\frac{{z}^{2}}{11} & =\\frac{11}{36} \\\\ {z}^{2} & =\\frac{121}{36} \\\\ z & =\\pm \\frac{11}{6}\\end{aligned}\n$$\n\nHence, we get the solutions $z=-\\frac{11}{6}$ and $z=\\frac{11}{6}.$\n\nTherefore, the intercepts with the $z$-axis are $(0,0,-\\frac{11}{6})$ and $(0,0,\\frac{11}{6}).$"}] [{:db/id #edb/ref 17592186338904 :knowledge-point/_questions [{:db/id #edb/ref 17592186105734 :knowledge-point/id #uuid "9331987e-8676-5bdb-b4ce-2129b1b09a8c" :knowledge-point/title "Calculating the Altitude of a Triangle Given Its Vertices"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3f3c7d45-2508-558a-a671-704a2f709aa7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3\\sqrt{2}" :db/id #edb/ref 17592186336627} {:answer/id #uuid "733fefab-043d-5fe4-93ed-cf5c6a3298cd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6\\sqrt{2}" :db/id #edb/ref 17592186337070} {:answer/id #uuid "ca0454d2-6cd6-50e2-9a7f-17ac15f3a137" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\sqrt{6}" :db/id #edb/ref 17592186337812} {:answer/id #uuid "d3fb8394-0a4f-5554-bef2-b4565678aeac" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\sqrt{2}" :db/id #edb/ref 17592186337886} {:answer/id #uuid "f7adc41f-f450-52b1-9898-009b7b23875a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\sqrt{3}" :db/id #edb/ref 17592186338203}] :answer-field/correct {:answer/id #uuid "d3fb8394-0a4f-5554-bef2-b4565678aeac" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\sqrt{2}" :db/id #edb/ref 17592186337886} :answer-field/id #uuid "c1e3142c-b7af-51c6-a353-db8d28d28403" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186338622}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "6da0a984-327a-597f-9055-73fa298d90dc" :question/math-academy-id "q-71128" :question/problem "Calculate the length of the altitude $DH$ of the $△\\,DMA$, if $D(-1,2,1)$, $M(-1,0,-1)$, $A(1,-2,1).$" :question/worked-solution "Note that the length of the altitude $DH$ can be related to the area of $△\\,DMA$ as follows:\n\n$$\n{A}_{△}=\\frac{1}{2}DH\\cdot MA\n$$\n\nSo, to find $DH,$ we first find ${A}_{△}.$ To start, we find the vectors $\\overset{\\to }{MD}$ and $\\overset{\\to }{MA}:$\n\n$$\n\\begin{aligned}\\overset{\\to }{MD} & =d-m \\\\  & =(-i+2j+k)-(-i-k) \\\\  & =2j+2k \\\\  & =⟨0,2,2⟩ \\\\ \\overset{\\to }{MA} & =a-m \\\\  & =(i-2j+k)-(-i-k) \\\\  & =2i-2j+2k \\\\  & =⟨2,-2,2⟩\\end{aligned}\n$$\n\nNow, we have\n\n$$\n\\begin{aligned}\\overset{\\to }{MD}\\times \\overset{\\to }{MA} & =|\\begin{aligned}i & j & k \\\\ 0 & 2 & 2 \\\\ 2 & -2 & 2\\end{aligned}| \\\\  & =|\\begin{aligned}2 & 2 \\\\ -2 & 2\\end{aligned}|i-|\\begin{aligned}0 & 2 \\\\ 2 & 2\\end{aligned}|j+|\\begin{aligned}0 & 2 \\\\ 2 & -2\\end{aligned}|k \\\\  & =(2\\cdot 2-(-2)\\cdot 2)i-(0\\cdot 2-2\\cdot 2)j+(0\\cdot (-2)-2\\cdot 2)k \\\\  & =8i+4j-4k \\\\  & =⟨8,4,-4⟩.\\end{aligned}\n$$\n\nTherefore, the area of the parallelogram spanned by $\\overset{\\to }{MD}$ and $\\overset{\\to }{MA}$ is\n\n$$\n\\begin{aligned}A & =|\\overset{\\to }{MD}\\times \\overset{\\to }{MA}| \\\\  & =\\sqrt{{8}^{2}+{4}^{2}+(-4)^{2}} \\\\  & =\\sqrt{96} \\\\  & =4\\sqrt{6}.\\end{aligned}\n$$\n\nThe area of the triangle is half of the area of the respective parallelogram. So, the area of $△\\,DMA$ is\n\n$$\n{A}_{△}=\\frac{1}{2}A=\\frac{4\\sqrt{6}}{2}=2\\sqrt{6}.\n$$\n\nLet's also compute $MA$ since it appears in the formula:\n\n$$\n\\begin{aligned}MA & =|\\overset{\\to }{MA}| \\\\  & =\\sqrt{{2}^{2}+(-2)^{2}+{2}^{2}} \\\\  & =\\sqrt{12} \\\\  & =2\\sqrt{3}.\\end{aligned}\n$$\n\n \n\nFinally, using the formula ${A}_{△}=\\frac{1}{2}DH\\cdot MA,$ we get\n\n$$\n\\begin{aligned}{A}_{△} & =\\frac{1}{2}DH\\cdot MA \\\\ 2\\sqrt{6} & =\\frac{1}{2}DH\\cdot 2\\sqrt{3} \\\\ 2\\sqrt{6} & =DH\\cdot \\sqrt{3} \\\\ DH & =\\frac{2\\sqrt{6}}{\\sqrt{3}} \\\\ DH & =2\\sqrt{2}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186176559 :knowledge-point/_questions [{:db/id #edb/ref 17592186175952 :knowledge-point/id #uuid "be9ac99c-424e-5e90-b26f-c26e4da704d7" :knowledge-point/title "Finding the Final Position of a Particle"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "62be3c05-a4ae-5efb-9948-679341242985" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "92" :db/id #edb/ref 17592186336919} {:answer/id #uuid "8405c10d-b8b6-5c71-8189-17737f465d6b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "105" :db/id #edb/ref 17592186337224} {:answer/id #uuid "88db8cb5-299e-5069-9bcf-7be99175abe6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "100" :db/id #edb/ref 17592186337266} {:answer/id #uuid "8a915290-5bd6-518d-95de-cb51f1f093a5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "97" :db/id #edb/ref 17592186337282} {:answer/id #uuid "bea68b0e-1b25-5071-ad8e-8a44fba3ec1d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "93" :db/id #edb/ref 17592186337727}] :answer-field/correct {:answer/id #uuid "8405c10d-b8b6-5c71-8189-17737f465d6b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "105" :db/id #edb/ref 17592186337224} :answer-field/id #uuid "740967d6-ac89-5f9b-b1f3-bcaa5e18f367" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186338475}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "f38c2d58-f071-5d09-92ca-36e11adfb46f" :question/math-academy-id "q-7113" :question/problem "A particle $P$ moves along the $x$-axis and its velocity at time $t>0$ is given by $v(t)=4t+3{t}^{2}.$ At time $t=1$ the particle is located at the position $x=12.$ What is the position of the particle at time $t=4?$" :question/requires-calculator true :question/worked-solution "The position of the particle at $t=4$ is equal to its position at $t=1$ plus the total displacement over $t\\in [1,4].$ Therefore, we can calculate it as follows:\n\n$$\nx(4)=x(1)+{\\int }_{1}^{4}v(t)\\,\\text{d}t\n$$\n\nCarrying out the computations, we get\n\n$$\n\\begin{aligned}x(4) & =12+{\\int }_{1}^{4}(4t+3{t}^{2})\\text{d}t \\\\  & =12+[2{t}^{2}+{t}^{3}]_{1}^{4} \\\\  & =12+([2(4)^{2}+{4}^{3}]-[2(1)^{2}+{1}^{3}]) \\\\  & =12+([32+64]-[2+1]) \\\\  & =12+(96-3) \\\\  & =12+93 \\\\  & =105\\end{aligned}\n$$\n\nSo the position of the particle at $t=4$ is $x=105.$"}] [{:db/id #edb/ref 17592186393091 :knowledge-point/_questions [{:db/id #edb/ref 17592186119781 :knowledge-point/id #uuid "ecdc6a5a-5aba-5547-97aa-db3cd2e90ae6" :knowledge-point/title "Calculating a Minor in a NxN Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "fdecdb2a-be1a-535a-bee9-9659ab7d1d37" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "|\\begin{aligned}-7 & 3 & \\,1 \\\\ -2 & 0 & \\,2 \\\\ 11 & 3 & \\,-3\\end{aligned}|" :db/id #edb/ref 17592186393093} {:answer/id #uuid "81a8a04c-db9c-57ca-b056-75bc4bda4bb7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "|\\begin{aligned}-7 & 0 & \\,1 \\\\ 10 & -1 & \\,0 \\\\ -2 & 0 & \\,2\\end{aligned}|" :db/id #edb/ref 17592186393094} {:answer/id #uuid "07c43492-f6dd-5136-82a3-13dad2882b0c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "|\\begin{aligned}-7 & 0 & \\,1 \\\\ 10 & -1 & \\,0 \\\\ 11 & 0 & \\,-3\\end{aligned}|" :db/id #edb/ref 17592186393095} {:answer/id #uuid "01e785ae-c084-571e-93e7-3cc45466fd54" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "|\\begin{aligned}3 & 0 & \\,1 \\\\ 1 & -1 & \\,0 \\\\ 0 & 3 & \\,2\\end{aligned}|" :db/id #edb/ref 17592186393096} {:answer/id #uuid "435c0dce-546b-54b9-bdab-d4baeb3c9ec3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "|\\begin{aligned}10 & 1 & \\,0 \\\\ -2 & 0 & \\,2 \\\\ 11 & 3 & \\,-3\\end{aligned}|" :db/id #edb/ref 17592186393097}] :answer-field/correct {:answer/id #uuid "fdecdb2a-be1a-535a-bee9-9659ab7d1d37" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "|\\begin{aligned}-7 & 3 & \\,1 \\\\ -2 & 0 & \\,2 \\\\ 11 & 3 & \\,-3\\end{aligned}|" :db/id #edb/ref 17592186393093} :answer-field/id #uuid "b15b527c-7c8f-54df-aefc-bcdbdc70d5ff" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186393092}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "caf1e0fb-eb87-5e71-a542-0c1755eff5ab" :question/math-academy-id "q-71189" :question/problem "What is the minor of ${p}_{23}$ in  $P=[\\begin{aligned}-7 & 3 & 0 & \\,1 \\\\ 10 & 1 & -1 & \\,0 \\\\ -2 & 0 & 3 & \\,2 \\\\ 11 & 3 & 0 & \\,-3\\end{aligned}]?$" :question/worked-solution "To get the minor of ${p}_{23}$, we remove the  $2$nd row and the $3$rd column:\n\n$$\nP=[\\begin{aligned}-7 & 3 & ∗ & 1 \\\\ ∗ & ∗ & -1 & ∗ \\\\ -2 & 0 & ∗ & 2 \\\\ 11 & 3 & ∗ & -3\\end{aligned}]\n$$\n\nSo, the minor is \n\n$$\n{M}_{23}=|\\begin{aligned}-7 & 3 & \\,1 \\\\ -2 & 0 & \\,2 \\\\ 11 & 3 & \\,-3\\end{aligned}|.\n$$"}] [{:db/id #edb/ref 17592186393098 :knowledge-point/_questions [{:db/id #edb/ref 17592186119781 :knowledge-point/id #uuid "ecdc6a5a-5aba-5547-97aa-db3cd2e90ae6" :knowledge-point/title "Calculating a Minor in a NxN Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ecf02146-e1b0-5539-b4e5-5e4db585f712" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "|\\begin{aligned}2 & -1 & 1 \\\\ 5 & -1 & 0 \\\\ 9 & -3 & 0\\end{aligned}|" :db/id #edb/ref 17592186393100} {:answer/id #uuid "639ab66c-d0ba-5e67-b27c-fee7c12393fd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "|\\begin{aligned}2 & -1 & 0 \\\\ 5 & -1 & 1 \\\\ 7 & 10 & 8\\end{aligned}|" :db/id #edb/ref 17592186393101} {:answer/id #uuid "e0e8b3c9-465c-55d4-b781-46d61c898c4b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "|\\begin{aligned}2 & 1 & 0 \\\\ 5 & 0 & 1 \\\\ 7 & 2 & 8\\end{aligned}|" :db/id #edb/ref 17592186393102} {:answer/id #uuid "e9c7b7b0-99e1-5530-8565-49e93df10d3b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "|\\begin{aligned}2 & -1 & 1 \\\\ 5 & -1 & 0 \\\\ 7 & 10 & 8\\end{aligned}|" :db/id #edb/ref 17592186393103} {:answer/id #uuid "923bf90c-f200-5ae2-850a-6b9cff1e3bf2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "|\\begin{aligned}-1 & 0 & 1 \\\\ 10 & 2 & 8 \\\\ -3 & 0 & 3\\end{aligned}|" :db/id #edb/ref 17592186393104}] :answer-field/correct {:answer/id #uuid "ecf02146-e1b0-5539-b4e5-5e4db585f712" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "|\\begin{aligned}2 & -1 & 1 \\\\ 5 & -1 & 0 \\\\ 9 & -3 & 0\\end{aligned}|" :db/id #edb/ref 17592186393100} :answer-field/id #uuid "dd952f15-a2c4-53c4-ab18-fdcc2715d46f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186393099}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "c5a3f02c-617a-514d-b9f7-86ea907e6206" :question/math-academy-id "q-71190" :question/problem "What is the minor of ${u}_{34}$ in  $U=[\\begin{aligned}2 & -1 & 1 & 0 \\\\ 5 & -1 & 0 & 1 \\\\ 7 & 10 & 2 & 8 \\\\ 9 & -3 & 0 & 3\\end{aligned}]?$" :question/worked-solution "To get the minor of ${u}_{34}$, we remove the  $3$rd row and the $4$th column:\n\n$$\nU=[\\begin{aligned}2 & -1 & 1 & ∗ \\\\ 5 & -1 & 0 & ∗ \\\\ ∗ & ∗ & ∗ & 8 \\\\ 9 & -3 & 0 & ∗\\end{aligned}]\n$$\n\nSo, the minor is \n\n$$\n{M}_{34}=|\\begin{aligned}2 & -1 & 1 \\\\ 5 & -1 & 0 \\\\ 9 & -3 & 0\\end{aligned}|.\n$$"}] [{:db/id #edb/ref 17592186338919 :knowledge-point/_questions [{:db/id #edb/ref 17592186124439 :knowledge-point/id #uuid "b0325887-ce25-5d6f-bf27-d85541e1dbe0" :knowledge-point/title "Finding the Tangent Vector to a Curve at a Point"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "11a4a9dc-c717-5035-ba3e-987961f9ee72" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨1,0,1⟩" :db/id #edb/ref 17592186336198} {:answer/id #uuid "3f159693-7272-539b-8d07-778a3ed4938c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨-1,0,3⟩" :db/id #edb/ref 17592186336624} {:answer/id #uuid "596e8a9c-9c2e-5135-a08e-ad772219a349" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨1,0,3⟩" :db/id #edb/ref 17592186336849} {:answer/id #uuid "749562ba-1b02-5f83-a973-8bffa1c80cac" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨1,0,-3⟩" :db/id #edb/ref 17592186337081} {:answer/id #uuid "de8038e5-bdf2-5d72-8003-0ca0304fe0a1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨3,0,1⟩" :db/id #edb/ref 17592186337971}] :answer-field/correct {:answer/id #uuid "596e8a9c-9c2e-5135-a08e-ad772219a349" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨1,0,3⟩" :db/id #edb/ref 17592186336849} :answer-field/id #uuid "9f6508aa-26cc-5e67-a21e-e797c69eabff" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186338568}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "8b7dd45b-b8d1-582b-9fbf-c50179d63d9b" :question/math-academy-id "q-71221" :question/problem "The curve $C$ is the intersection of a surface $S,$ defined by $z=f(x,y),$ with the plane $y=1.$ Given that the point $P(-1,1,-1)$ lies on $C$, and that ${f}_{x}=3{e}^{x+y}-\\operatorname{ln}⁡|xy|$, which of the following gives a tangent vector to $C$ at $P?$" :question/worked-solution "The curve $C$ is the intersection of the surface with the plane $y=1.$ Hence, the slope of the tangent to the curve $C$ at the point $P$ will be given by the partial derivative ${f}_{x}(-1,1).$ \n\nTo get the slope, we evaluate the partial derivative ${f}_{x}(x,y)$ at $(-1,1):$\n\n$$\n\\begin{aligned}{f}_{x}(-1,1) & =3{e}^{-1+1}-\\operatorname{ln}⁡|(-1)\\cdot 1| \\\\  & =3\\cdot 1-\\operatorname{ln}⁡1 \\\\  & =3-0 \\\\  & =3\\end{aligned}\n$$\n\n \n\nNow, we use the point-slope form of a straight line:\n\n$$\n\\begin{aligned}z-f(-1,1) & ={f}_{x}(-1,1)(x-(-1)) \\\\ z-(-1) & =3(x+1) \\\\ z+1 & =3x+3 \\\\ z & =3x+2\\end{aligned}\n$$\n\nTherefore, the tangent line to the curve $C$ at $P(-1,1,-1)$ can be given as the intersection of two planes:\n\n$$\n{\\begin{aligned}y=1 \\\\ z=3x+2\\end{aligned}\n$$\n\nNext, notice that:\n\n- For the plane $y=1,$ a normal vector to the plane is ${n}_{1}=⟨0,1,0⟩.$\n\n- For the plane $z=3x+2$ (or $3x-z+2=0$), a normal vector to the plane is ${n}_{2}=⟨3,0,-1⟩.$\n\nFinally, to find a direction vector for the tangent line, we calculate the cross product of these normal vectors:\n\n$$\n\\begin{aligned}{n}_{1}\\times {n}_{2} & =⟨0,1,0⟩\\times ⟨3,0,-1⟩ \\\\  & =\\left|\\begin{aligned}i & j & k \\\\ 0 & 1 & 0 \\\\ 3 & 0 & -1\\end{aligned}\\right| \\\\  & =-i-3\\,k \\\\  & =⟨-1,0,-3⟩\\end{aligned}\n$$\n\nFinally, since $⟨-1,0,-3⟩$ is parallel to the tangent line, then $-⟨-1,0,-3⟩=⟨1,0,3⟩$ is also parallel to it."}] [{:db/id #edb/ref 17592186393112 :knowledge-point/_questions [{:db/id #edb/ref 17592186115391 :knowledge-point/id #uuid "b19f5f01-948e-5f44-8016-63073ed31dbc" :knowledge-point/title "Using the Scalar Function Multiple Rule for Differentiation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9538c922-626d-57e3-875e-1c3a6b6e5675" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}(4{t}^{2}+t){e}^{t} \\\\ ({t}^{2}-1){e}^{t} \\\\ {e}^{t}\\end{aligned}]" :db/id #edb/ref 17592186393114} {:answer/id #uuid "8c39359a-bdf1-5f7a-abe2-7ec39aa9faf5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}(2{t}^{3}+6{t}^{2}-3){e}^{t} \\\\ ({t}^{2}+2t+1){e}^{t} \\\\ (4t-3){e}^{t}\\end{aligned}]" :db/id #edb/ref 17592186393115} {:answer/id #uuid "cd118cf1-a60f-5278-b6b0-774581fb4af6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}(-5{t}^{3}-3{t}^{2}+1){e}^{t} \\\\ (3{t}^{2}-t-1){e}^{t} \\\\ (t+2){e}^{t}\\end{aligned}]" :db/id #edb/ref 17592186393116} {:answer/id #uuid "0231d3d9-379e-569f-8987-f29126252cf1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}({t}^{2}-4t+4) \\\\ ({t}^{2}-1) \\\\ (2t+3)\\end{aligned}]" :db/id #edb/ref 17592186393117} {:answer/id #uuid "52e3e13a-2c9a-5dea-92ad-1d1be14d9577" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}7{t}^{3}{e}^{t} \\\\ {t}^{2}{e}^{t} \\\\ 4t{e}^{t}\\end{aligned}]" :db/id #edb/ref 17592186393118}] :answer-field/correct {:answer/id #uuid "8c39359a-bdf1-5f7a-abe2-7ec39aa9faf5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}(2{t}^{3}+6{t}^{2}-3){e}^{t} \\\\ ({t}^{2}+2t+1){e}^{t} \\\\ (4t-3){e}^{t}\\end{aligned}]" :db/id #edb/ref 17592186393115} :answer-field/id #uuid "c5faccf8-2ac3-56c6-9185-9f48d31adb8d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186393113}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "1c08c320-55ed-59e1-87a0-c92a722748de" :question/math-academy-id "q-71233" :question/problem "Find ${(u(t)f(t))}^{′}$ where $f(t)=[\\begin{aligned}2{t}^{3}-3 \\\\ {t}^{2}+1 \\\\ 4t-7\\end{aligned}]$ and $u(t)={e}^{t}.$" :question/worked-solution "Using the scalar function multiple rule, we can write\n\n$$\n{(u(t)f(t))}^{′}={u}^{′}(t)f(t)+u(t){f}^{′}(t)\n$$\n\nLet's find ${u}^{′}(t)$ and ${f}^{′}(t).$\n\n$$\n\\begin{aligned}{f}^{′}(t) & =[\\begin{aligned}\\frac{\\text{d}}{\\text{d}t}(2{t}^{3}-3) \\\\ \\frac{\\text{d}}{\\text{d}t}({t}^{2}+1) \\\\ \\frac{\\text{d}}{\\text{d}t}(4t-7)\\end{aligned}]=[\\begin{aligned}6{t}^{2} \\\\ 2t \\\\ 4\\end{aligned}] \\\\ {u}^{′}(t) & =\\frac{\\text{d}}{\\text{d}t}({e}^{t})={e}^{t}\\end{aligned}\n$$\n\nTherefore, we obtain:\n\n$$\n\\begin{aligned}{(u(t)f(t))}^{′} & ={u}^{′}(t)f(t)+u(t){f}^{′}(t) \\\\  & ={e}^{t}[\\begin{aligned}2{t}^{3}-3 \\\\ {t}^{2}+1 \\\\ 4t-7\\end{aligned}]+{e}^{t}[\\begin{aligned}6{t}^{2} \\\\ 2t \\\\ 4\\end{aligned}] \\\\  & =[\\begin{aligned}(2{t}^{3}-3){e}^{t} \\\\ ({t}^{2}+1){e}^{t} \\\\ (4t-7){e}^{t}\\end{aligned}]+[\\begin{aligned}6{t}^{2}{e}^{t} \\\\ 2t{e}^{t} \\\\ 4{e}^{t}\\end{aligned}] \\\\  & =[\\begin{aligned}(2{t}^{3}+6{t}^{2}-3){e}^{t} \\\\ ({t}^{2}+2t+1){e}^{t} \\\\ (4t-3){e}^{t}\\end{aligned}]\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186403461 :knowledge-point/_questions [{:db/id #edb/ref 17592186068900 :knowledge-point/id #uuid "66ade855-4b16-514b-b44a-1d6b9d61ef28" :knowledge-point/title "Identifying the Shift Applied to an Exponential Decay Curve"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d8efb215-a4e3-57a5-9c28-aeceec68ab3d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y={(\\frac{1}{3})}^{x}+2" :db/id #edb/ref 17592186403463} {:answer/id #uuid "dc7c1d24-77af-5b22-8748-eb78e3181bee" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y={(\\frac{1}{3})}^{x}-3" :db/id #edb/ref 17592186403464} {:answer/id #uuid "ac8a280a-f3e5-57ca-a313-b4a7d3f28178" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y={(\\frac{1}{3})}^{x}" :db/id #edb/ref 17592186403465} {:answer/id #uuid "2e259bca-b084-538c-98c1-c8f9fb1db908" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y={(\\frac{1}{3})}^{x}+3" :db/id #edb/ref 17592186403466} {:answer/id #uuid "54400882-3ae8-5fef-9856-f37d1e3a6878" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y={(\\frac{1}{3})}^{x}-2" :db/id #edb/ref 17592186403467}] :answer-field/correct {:answer/id #uuid "d8efb215-a4e3-57a5-9c28-aeceec68ab3d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y={(\\frac{1}{3})}^{x}+2" :db/id #edb/ref 17592186403463} :answer-field/id #uuid "153448b6-9533-5575-9ff3-816d932b2ca7" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186403462}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "d28d182e-64fa-5ae5-be71-7e9fd891464e" :question/math-academy-id "q-7124" :question/problem "![](images/1a/1a54cae748796775b76ade4d9060d4eafe6bb84fd45ce725bd516a7db2681ba9.png)\n\nThe graph above shows the curve $y={(\\frac{1}{3})}^{x}+c.$ Determine the value of $c$ and find the equation of the curve." :question/worked-solution "The horizontal asymptote of $y={(\\frac{1}{3})}^{x}$ is $y=0.$ \n\nThe vertical translation $y={(\\frac{1}{3})}^{x}+c$ shifts the asymptote to $y=c.$\n\nIn the graph above, the horizontal asymptote is $y=2.$ Therefore, $c=2.$"}] [{:db/id #edb/ref 17592186338930 :knowledge-point/_questions [{:db/id #edb/ref 17592186124461 :knowledge-point/id #uuid "d5baf28d-c2c0-57bd-9433-c47043009f0d" :knowledge-point/title "Finding a Normal Vector to a Level Curve"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "049b7f23-d6a7-5be3-a6ca-ac19b8a84234" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-j" :db/id #edb/ref 17592186336070} {:answer/id #uuid "123c36c6-7310-581c-8de4-b675e090dc56" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "i+i" :db/id #edb/ref 17592186336203} {:answer/id #uuid "4b49d759-d015-5843-b6e9-3497dc09edfe" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "i-i" :db/id #edb/ref 17592186336730} {:answer/id #uuid "6e16ffd6-406d-50b5-9b6a-0f4b899fc6bd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-i" :db/id #edb/ref 17592186337009} {:answer/id #uuid "ccd3f738-ef19-5d09-afcb-04a5b6bdd7fa" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{5}}{5}(-2i+i)" :db/id #edb/ref 17592186337828}] :answer-field/correct {:answer/id #uuid "6e16ffd6-406d-50b5-9b6a-0f4b899fc6bd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-i" :db/id #edb/ref 17592186337009} :answer-field/id #uuid "60184a90-8959-560b-aa4a-378830d13dbb" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186338445}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "436e814d-020d-5b28-b909-495bbb1c431a" :question/math-academy-id "q-71374" :question/problem "Find a unit normal vector to the level curve of the function $f(x,y)=x+3y-2xy$ that passes through the point where $(x,y)=(\\frac{3}{2},1).$" :question/worked-solution "A normal vector to the level curve that passes through the point where $(x,y)=(\\frac{3}{2},1)$, can be found by computing $∇f(\\frac{3}{2},1).$ \n\nSo, we first find the gradient of $f(x,y)$ and evaluate it at $(x,y)=(\\frac{3}{2},1):$\n\n$$\n\\begin{aligned}∇f(x,y) & =\\frac{∂}{∂x}(x+3y-2xy)\\text{ }i+\\frac{∂}{∂y}(x+3y-2xy)\\text{ }j \\\\  & =(1-2y)\\text{ }i+(3-2x)\\text{ }j \\\\ ∇f(\\frac{3}{2},1) & =(1-2(1))\\text{ }i+(3-2(\\frac{3}{2}))\\text{ }j \\\\  & =-i\\end{aligned}\n$$\n\nFinally, we normalize $∇f(\\frac{3}{2},1):$\n\n$$\n\\begin{aligned}\\frac{∇f(\\frac{3}{2},1)}{‖∇f(\\frac{3}{2},1)‖} & =\\frac{-i}{1}=-i\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186338936 :knowledge-point/_questions [{:db/id #edb/ref 17592186124462 :knowledge-point/id #uuid "3b2f7fab-cebe-519a-83e3-a0831cac289d" :knowledge-point/title "Finding the Equation of the Normal Line to a Plane Curve Using the Gradient"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "923db4e3-1672-5a50-9581-8d103a4e9394" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x+2y-2=0" :db/id #edb/ref 17592186337357} {:answer/id #uuid "a0ca54cd-1662-5f06-ad4a-139620f93cc6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-x+y-1=0" :db/id #edb/ref 17592186337484} {:answer/id #uuid "a201c603-2105-5c16-ac28-6ea1909ee0e3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x+y-1=0" :db/id #edb/ref 17592186337500} {:answer/id #uuid "f0aa3752-46b2-55e2-872a-d4d7eb4de111" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x+y+1=0" :db/id #edb/ref 17592186338139} {:answer/id #uuid "f7b5b220-5b4e-5b43-8acc-b11f2fdd7f50" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x-y+1=0" :db/id #edb/ref 17592186338205}] :answer-field/correct {:answer/id #uuid "a201c603-2105-5c16-ac28-6ea1909ee0e3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x+y-1=0" :db/id #edb/ref 17592186337500} :answer-field/id #uuid "a093c235-9586-5c2c-a6e1-6f61aa48334d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186338573}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "47afea57-2ac6-5bfd-8472-520b5199e74f" :question/math-academy-id "q-71393" :question/problem "Consider the plane curve $\\operatorname{ln}⁡(x+y)=2xy.$  Find the equation of the normal line to the curve at the point $(0,1).$" :question/worked-solution "First, we bring all variables to one side:\n\n$$\n\\begin{aligned}\\operatorname{ln}⁡(x+y) & =2xy \\\\ \\operatorname{ln}⁡(x+y)-2xy & =0\\end{aligned}\n$$\n\nIf we set $f(x,y)=\\operatorname{ln}⁡(x+y)-2xy$, our curve can be viewed as the level curve $f(x,y)=0.$  \n\nA normal vector to the level curve that passes through the point $(0,1)$ can be found by computing $∇f(0,1).$ \n\nSo, we find the gradient and evaluate it at $(0,1):$\n\n$$\n\\begin{aligned}∇f(x,y) & ={f}_{x}(x,y)\\,i+{f}_{y}(x,y)\\,j \\\\  & =\\frac{∂}{∂x}(\\operatorname{ln}⁡(x+y)-2xy)\\,i+\\frac{∂}{∂y}(\\operatorname{ln}⁡(x+y)-2xy)\\,j \\\\  & =(\\frac{1}{x+y}-2y)\\,i+(\\frac{1}{x+y}-2x)\\,j \\\\ ∇f(0,1) & =(\\frac{1}{0+1}-2(1))\\,i+(\\frac{1}{0+1}-2(0))\\,j \\\\  & =-i+j \\\\  & =⟨-1,1⟩\\end{aligned}\n$$\n\nHence, $∇f(0,1)=⟨-1,1⟩$ is a normal vector to the curve at $(0,1).$\n\nFinally, the Cartesian equation of the line that is parallel to $v=⟨{v}_{x},{v}_{y}⟩$ and passes through the point $({x}_{0},{y}_{0})$ can be written as:\n\n$$\n\\begin{aligned}\\frac{x-{x}_{0}}{{v}_{x}} & =\\frac{y-{y}_{0}}{{v}_{y}} \\\\ \\frac{x-0}{-1} & =\\frac{y-1}{1} \\\\ -x & =y-1 \\\\ x+y-1 & =0\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186379903 :knowledge-point/_questions [{:db/id #edb/ref 17592186124475 :knowledge-point/id #uuid "74f126da-5f3b-5af8-9aee-d6f0a4c61c49" :knowledge-point/title "Determining the Shape of a Level Curve"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0b971f02-4dda-55b8-a905-b2c02dc4ccd6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I, II, and III" :db/id #edb/ref 17592186379905} {:answer/id #uuid "666233fa-03e9-5d3f-9041-88cf94599702" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186379906} {:answer/id #uuid "40ff7db2-1368-5950-8bc5-efe42e64ccf3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186379907} {:answer/id #uuid "2f8e1c50-ad71-5b07-b586-a803f3ecc2ff" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186379908} {:answer/id #uuid "5d03f4b2-8f1e-55e5-9224-e865497962c3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186379909}] :answer-field/correct {:answer/id #uuid "2f8e1c50-ad71-5b07-b586-a803f3ecc2ff" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186379908} :answer-field/id #uuid "7cfafc86-a646-52b6-ac85-752f96950f81" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186379904}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "d3aaf864-2fae-5bdc-a851-6e2a3303364c" :question/math-academy-id "q-71398" :question/problem "The level curves of the function $f(x,y)=\\sqrt{{x}^{2}+2y}$ are given by $f(x,y)=c.$ Which of the following statements are true?\n\n- $c=0$ gives a circle\n- $c=1$ gives a hyperbola\n- $c=2$ gives a parabola" :question/worked-solution "Setting $f(x,y)=c$ gives:\n\n$$\n\\begin{aligned}\\sqrt{{x}^{2}+2y} & =c \\\\ {x}^{2}+2y & ={c}^{2}\\end{aligned}\n$$\n\nTherefore:\n\n- If $c=0$ then the level curve is $y=-\\frac{{x}^{2}}{2},$ which is not a circle.\n\n- If $c=1$ then the level curve is $y=\\frac{1}{2}-\\frac{{x}^{2}}{2},$ which is not a hyperbola.\n\n- If $c=2$ then the level curve is $y=2-\\frac{{x}^{2}}{2},$ which is a parabola.\n\nSo, only statement III is true."}] [{:db/id #edb/ref 17592186385529 :knowledge-point/_questions [{:db/id #edb/ref 17592186124444 :knowledge-point/id #uuid "fe2c7ce2-f053-57af-9f4d-54bd3a41648a" :knowledge-point/title "Calculating the Gradient of a Function of Three Variables"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7ac0e82c-e65c-52b4-92cf-ea9eef5506dc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\pi \\text{ }i-\\pi \\text{ }j+\\text{ }k" :db/id #edb/ref 17592186385531} {:answer/id #uuid "725ac3d7-7213-5bdb-b47f-4954c2a469c7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\pi \\text{ }i+\\pi \\text{ }j+\\pi \\text{ }k" :db/id #edb/ref 17592186385532} {:answer/id #uuid "44d96ff8-6e7a-5e3c-bdfc-e4fa56a64251" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\pi \\text{ }i+\\pi \\text{ }j+\\text{ }k" :db/id #edb/ref 17592186385533} {:answer/id #uuid "5a3bbb8f-e6f1-5641-8261-340795b58dda" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\text{ }i-\\pi \\text{ }j+\\text{ }k" :db/id #edb/ref 17592186385534} {:answer/id #uuid "fa3e1f03-a9e4-5b31-b950-95579c95df2e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\pi \\text{ }i+\\pi \\text{ }j+\\text{ }k" :db/id #edb/ref 17592186385535}] :answer-field/correct {:answer/id #uuid "7ac0e82c-e65c-52b4-92cf-ea9eef5506dc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\pi \\text{ }i-\\pi \\text{ }j+\\text{ }k" :db/id #edb/ref 17592186385531} :answer-field/id #uuid "7027997b-9ea2-56b2-bbd7-bdf567a4b72d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186385530}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "aef7acb8-89a1-5016-aa4c-ee6f59af7efc" :question/math-academy-id "q-71426" :question/problem "Evaluate $∇h(x,y,z)$ at the point $(1,-1,\\pi )$ if $h(x,y,z)=\\operatorname{sin}⁡(xyz).$" :question/worked-solution "First, we find the partial derivatives:\n\n$$\n\\begin{aligned}{h}_{x}(x,y,z) & =\\frac{∂}{∂x}(\\operatorname{sin}⁡(xyz)) \\\\  & =yz\\operatorname{cos}⁡(xyz) \\\\ {h}_{y}(x,y,z) & =\\frac{∂}{∂y}(\\operatorname{sin}⁡(xyz)) \\\\  & =xz\\operatorname{cos}⁡(xyz) \\\\ {h}_{z}(x,y,z) & =\\frac{∂}{∂z}(\\operatorname{sin}⁡(xyz)) \\\\  & =xy\\operatorname{cos}⁡(xyz)\\end{aligned}\n$$\n\n \nHence, the gradient is\n\n$$\n\\begin{aligned}∇h(x,y,z) & ={h}_{x}(x,y,z)\\text{ }i+{h}_{x}(x,y,z)\\text{ }j+{h}_{x}(x,y,z)\\text{ }k \\\\  & =yz\\operatorname{cos}⁡(xyz)\\text{ }i+xz\\operatorname{cos}⁡(xyz)\\text{ }j+xy\\operatorname{cos}⁡(xyz)\\text{ }k \\\\ ∇h(1,-1,\\pi ) & =(-1)(\\pi )\\operatorname{cos}⁡(-\\pi )\\text{ }i+(1)(\\pi )\\operatorname{cos}⁡(-\\pi )\\text{ }j+(1)(-1)\\operatorname{cos}⁡(-\\pi )\\text{ }k \\\\  & =(-\\pi )(-1)\\text{ }i+\\pi (-1)\\text{ }j-(-1)\\text{ }k \\\\  & =\\pi \\text{ }i-\\pi \\text{ }j+\\text{ }k\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186366219 :knowledge-point/_questions [{:db/id #edb/ref 17592186147427 :knowledge-point/id #uuid "a19140af-1870-5dee-86a2-6052451803d4" :knowledge-point/title "Identifying the Intersection of Two Planes"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ab715e39-7262-53f8-a589-7932e5948409" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186366221} {:answer/id #uuid "4df91f2a-726d-5a75-89e2-fbf683b5f3e6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186366222} {:answer/id #uuid "15089811-be63-5322-bff3-9d9751b255f4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186366223} {:answer/id #uuid "73dbba28-230f-587a-b4f0-389b59e14572" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186366224} {:answer/id #uuid "d97b5ca9-cd86-5251-bc55-f166bb43da71" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186366225}] :answer-field/correct {:answer/id #uuid "15089811-be63-5322-bff3-9d9751b255f4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186366223} :answer-field/id #uuid "8a7171c3-579f-5a05-8896-bebb6c2c2177" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186366220}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "96c9a429-d310-55eb-845b-95fc86ca78d5" :question/math-academy-id "q-71448" :question/problem "Given the two planes $x-2y+z=0$ and $x-y+1=0$, which of the following statements are true?\n\n- The normal vectors of the planes are parallel.\n- The cross product of the normal vectors of the planes is equal to $0.$\n- The planes intersect on a line." :question/worked-solution "First, notice that:\n\n- For the plane $x-2y+z=0,$ a normal vector to the plane is ${n}_{1}=⟨1,-2,1⟩.$\n\n- For the plane $x-y+1=0,$ a normal vector to the plane is ${n}_{2}=⟨1,-1,0⟩.$\n\nNow, let's consider the statements.\n\n- Statements I and II are false. Indeed, computing the cross product of the normal vectors, we get\n\n$$\n\\begin{aligned}{n}_{1}\\times {n}_{2} & =⟨1,-2,1⟩\\times ⟨1,-1,0⟩ \\\\  & =\\left|\\begin{aligned}i & j & k \\\\ 1 & -2 & 1 \\\\ 1 & -1 & 0\\end{aligned}\\right| \\\\  & =i+j+k \\\\  & =⟨1,1,1⟩\\ne 0.\\end{aligned}\n$$\n\nSince ${n}_{1}\\times {n}_{2}\\ne 0$, the vectors ${n}_{1}$ and ${n}_{2}$ are not parallel.\n\n- Statement III is true. Indeed, two non-parallel planes in $3$-dimensional space must intersect on a line.\n\nTherefore, only statement III is true."}] [{:db/id #edb/ref 17592186338945 :knowledge-point/_questions [{:db/id #edb/ref 17592186092193 :knowledge-point/id #uuid "4ed5facf-f654-5890-974f-bbdcd9641515" :knowledge-point/title "Applying De Moivre's Theorem to Fractions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0ebbca7a-6aa7-54dc-9f74-c4ad0484ba9b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\operatorname{cos}⁡(3\\theta )+2\\text{i}\\operatorname{sin}⁡(3\\theta )" :db/id #edb/ref 17592186336172} {:answer/id #uuid "74e7e0a2-11e8-5bdf-9a4b-064f2cb3a59f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{cos}⁡(6\\theta )-\\text{i}\\operatorname{sin}⁡(6\\theta )" :db/id #edb/ref 17592186337085} {:answer/id #uuid "98a599e8-dc6d-5258-8147-8b55cbd27282" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6\\operatorname{cos}⁡(\\theta )+6\\text{i}\\operatorname{sin}⁡(\\theta )" :db/id #edb/ref 17592186337421} {:answer/id #uuid "c21c538f-aea8-54a9-a544-4b1ce34929b7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{cos}⁡(6\\theta )+\\text{i}\\operatorname{sin}⁡(6\\theta )" :db/id #edb/ref 17592186337757} {:answer/id #uuid "d448d8a7-ba02-5464-ade6-1bd3866a205f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3\\operatorname{cos}⁡(2\\theta )-3\\text{i}\\operatorname{sin}⁡(2\\theta )" :db/id #edb/ref 17592186337887}] :answer-field/correct {:answer/id #uuid "74e7e0a2-11e8-5bdf-9a4b-064f2cb3a59f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{cos}⁡(6\\theta )-\\text{i}\\operatorname{sin}⁡(6\\theta )" :db/id #edb/ref 17592186337085} :answer-field/id #uuid "7d6bb9fd-afac-592d-97a0-68e60889667e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186338500}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "6f604609-4011-5a69-9aea-4ff0b17e67cc" :question/math-academy-id "q-71452" :question/problem "Simplify the expression $\\frac{1}{{[\\operatorname{cos}⁡(\\theta )+\\text{i}\\operatorname{sin}⁡(\\theta )]}^{6}}.$" :question/worked-solution "First, note that\n\n$$\n\\frac{1}{{[\\operatorname{cos}⁡(\\theta )+\\text{i}\\operatorname{sin}⁡(\\theta )]}^{6}}={[\\operatorname{cos}⁡(\\theta )+\\text{i}\\operatorname{sin}⁡(\\theta )]}^{-6}.\n$$\n\nDe Moivre's Theorem states that\n\n$$\n{[\\operatorname{cos}⁡(\\phi )+\\text{i}\\operatorname{sin}⁡(\\phi )]}^{n}=\\operatorname{cos}⁡(n\\phi )+\\text{i}\\operatorname{sin}⁡(n\\phi ).\n$$\n\nIn our expression, we have $n=-6$ and $\\phi =\\theta .$ Substituting in these values, we get\n\n$$\n\\begin{aligned}\\frac{1}{{[\\operatorname{cos}⁡(\\theta )+\\text{i}\\operatorname{sin}⁡(\\theta )]}^{6}} & ={[\\operatorname{cos}⁡(\\theta )+\\text{i}\\operatorname{sin}⁡(\\theta )]}^{-6} \\\\  & =\\operatorname{cos}⁡(-6\\theta )+\\text{i}\\operatorname{sin}⁡(-6\\theta ).\\end{aligned}\n$$\n\nFinally, using the fact that $\\operatorname{cos}⁡(-\\phi )=\\operatorname{cos}⁡(\\phi )$ and $\\operatorname{sin}⁡(-\\phi )=-\\operatorname{sin}⁡(\\phi )$ for any input $\\phi ,$ we have\n\n$$\n\\operatorname{cos}⁡(-6\\theta )+\\text{i}\\operatorname{sin}⁡(-6\\theta )=\\operatorname{cos}⁡(6\\theta )-\\text{i}\\operatorname{sin}⁡(6\\theta ).\n$$"}] [{:db/id #edb/ref 17592186338951 :knowledge-point/_questions [{:db/id #edb/ref 17592186147427 :knowledge-point/id #uuid "a19140af-1870-5dee-86a2-6052451803d4" :knowledge-point/title "Identifying the Intersection of Two Planes"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3e2af9cd-f9db-5fc9-8508-c2ba1287e6d2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186336616} {:answer/id #uuid "50c7c369-3431-583c-b3ba-dcf5cf8e6396" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186336772} {:answer/id #uuid "797b27ec-b464-5a02-98e5-4ee61ae53020" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186337124} {:answer/id #uuid "9be98a9a-295e-5a46-8190-87c5fa70b702" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186337445} {:answer/id #uuid "f6c17eec-564b-5903-b73e-2e8ff9b63df5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186338197}] :answer-field/correct {:answer/id #uuid "3e2af9cd-f9db-5fc9-8508-c2ba1287e6d2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186336616} :answer-field/id #uuid "f48d4703-a664-5aa9-a3f6-2820a939fe7d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186338704}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "eb6d9712-df0c-5f4b-a820-ccc73d9a1ec9" :question/math-academy-id "q-71468" :question/problem "Given the two planes $2x-4y+6z+2=0$ and $-x+2y-3z=0$, which of the following statements are true?\n\n- The cross product of the normal vectors of the planes is equal to $0.$\n- The planes intersect on a straight line.\n- The planes are coincident." :question/worked-solution "First, notice that:\n\n- For the plane $2x-4y+6z+2=0,$ a normal vector to the plane is ${n}_{1}=⟨2,-4,6⟩.$\n\n- For the plane $-x+2y-3z=0,$ a normal vector to the plane is ${n}_{2}=⟨-1,2,-3⟩.$\n\nNow, let's consider the statements.\n\n- Statement I is true. Indeed, computing the cross product of the normal vectors, we get\n\n$$\n\\begin{aligned}{n}_{1}\\times {n}_{2} & =⟨2,-4,6⟩\\times ⟨-1,2,-3⟩ \\\\  & =\\left|\\begin{aligned}i & j & k \\\\ 2 & -4 & 6 \\\\ -1 & 2 & -3\\end{aligned}\\right| \\\\  & =0i+0j+0k \\\\  & =0.\\end{aligned}\n$$\n\n- Statement II is false. Since ${n}_{1}\\times {n}_{2}=0$, the vectors ${n}_{1}$ and ${n}_{2}$ are parallel. Hence, the corresponding planes are also parallel. So, the planes can't intersect on a line.\n\n- Statement III is false. Indeed,  the second plane passes through the origin  $O(0,0,0)$ but the first plane doesn't: \n\n$$\n2(0)-4(0)+6(0)+2=2\\ne 0\n$$\n\n So, the planes can't be coincident.\n\nTherefore, only statement I is true."}] [{:db/id #edb/ref 17592186385550 :knowledge-point/_questions [{:db/id #edb/ref 17592186124447 :knowledge-point/id #uuid "67cfec73-130c-5b68-a2e0-5f12837bfc81" :knowledge-point/title "Calculating the Gradient Using the Properties of the Gradient"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "be7f21f4-cabe-54eb-bc85-93d694a5ed38" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "({x}^{2}+{y}^{2}+2x){e}^{xy}\\text{ }i+({x}^{2}+{y}^{2}+2y){e}^{xy}\\text{ }j" :db/id #edb/ref 17592186385552} {:answer/id #uuid "4ec1d0e5-cc37-5321-849e-8e1b3950c06b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "({x}^{2}y+{y}^{3}){e}^{xy}\\text{ }i+({x}^{3}+x{y}^{2}){e}^{xy}\\text{ }j" :db/id #edb/ref 17592186385553} {:answer/id #uuid "3ad1fd13-781b-5d24-9468-b6d312c780db" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "({x}^{2}y+{y}^{3}+2x){e}^{xy}\\text{ }i+({x}^{3}+x{y}^{2}+2y){e}^{xy}\\text{ }j" :db/id #edb/ref 17592186385554} {:answer/id #uuid "f82a086d-2718-5c14-b976-c8999ecd57bb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "({x}^{2}y+{y}^{3}+2x)\\text{ }i+({x}^{3}+x{y}^{2}+2y)\\text{ }j" :db/id #edb/ref 17592186385555} {:answer/id #uuid "2e9d2f1c-dc91-5316-9ad5-65fd3a68e1cd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2x{e}^{xy}\\text{ }i+2y{e}^{xy}\\text{ }j" :db/id #edb/ref 17592186385556}] :answer-field/correct {:answer/id #uuid "3ad1fd13-781b-5d24-9468-b6d312c780db" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "({x}^{2}y+{y}^{3}+2x){e}^{xy}\\text{ }i+({x}^{3}+x{y}^{2}+2y){e}^{xy}\\text{ }j" :db/id #edb/ref 17592186385554} :answer-field/id #uuid "e3b75486-11a8-5732-8e0c-87ceee70a576" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186385551}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "48290c67-cc9b-570f-83c1-2b1af7db25a9" :question/math-academy-id "q-71484" :question/problem "Find the gradient of the product $g(x,y)h(x,y),$ given that \n\n$$\n\\begin{aligned}g(x,y) & ={e}^{xy},\\, &  & ∇g(x,y)=y{e}^{xy}\\text{ }i+x{e}^{xy}\\text{ }j, &  &  \\\\ h(x,y) & ={x}^{2}+{y}^{2},\\, &  & ∇h(x,y)=2x\\text{ }i+2y\\text{ }j. &  & \\end{aligned}\n$$" :question/worked-solution "The gradient of the product of two functions $g(x,y)$ and $h(x,y)$ is given by:\n\n$$\n∇[gh]=h\\,∇\\,g+g\\,∇\\,h\n$$\n\nUsing the product rule, we obtain:\n\n$$\n\\begin{aligned}∇[g(x,y)h(x,y)] & =h(x,y)∇g(x,y)+g(x,y)∇h(x,y) \\\\  & =({x}^{2}+{y}^{2})(y{e}^{xy}\\text{ }i+x{e}^{xy}\\text{ }j)+{e}^{xy}(2x\\text{ }i+2y\\text{ }j) \\\\  & =(({x}^{2}+{y}^{2})y{e}^{xy}\\text{ }i+({x}^{2}+{y}^{2})x{e}^{xy}\\text{ }j)+(2x{e}^{xy}\\text{ }i+2y{e}^{xy}\\text{ }j) \\\\  & =({x}^{2}y+{y}^{3}+2x){e}^{xy}\\text{ }i+({x}^{3}+x{y}^{2}+2y){e}^{xy}\\text{ }j\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186338954 :knowledge-point/_questions [{:db/id #edb/ref 17592186087859 :knowledge-point/id #uuid "30bb1401-f704-520c-a23e-5a238e44960e" :knowledge-point/title "Finding the Equation of a Circle Given a Description"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1f9ae437-1d85-50ec-958b-e8760b5b0e64" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{x}^{2}+{y}^{2}=125" :db/id #edb/ref 17592186336328} {:answer/id #uuid "308f53c4-2ae7-55da-984b-1a65d78f95cf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{x}^{2}+{y}^{2}=25" :db/id #edb/ref 17592186336497} {:answer/id #uuid "73254016-15bc-578d-98b1-e2110dfab2dc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{x}^{2}+{y}^{2}=75" :db/id #edb/ref 17592186337068} {:answer/id #uuid "90833b0d-0556-5041-9d09-6af44e6c3d8e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{x}^{2}+{y}^{2}=5" :db/id #edb/ref 17592186337342} {:answer/id #uuid "a58f261c-1656-5a28-9ad6-6ecc994c1001" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{x}^{2}+{y}^{2}=10" :db/id #edb/ref 17592186337535}] :answer-field/correct {:answer/id #uuid "308f53c4-2ae7-55da-984b-1a65d78f95cf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{x}^{2}+{y}^{2}=25" :db/id #edb/ref 17592186336497} :answer-field/id #uuid "064b2f2d-b064-5112-8c60-48e6b84edd0a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186338286}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "e777ee84-35c1-5291-bae1-8ca4f484b4c9" :question/math-academy-id "q-71506" :question/problem "Which equation describes the set of all points $(x,y)$ in the coordinate plane that are $5$ units away from the origin?" :question/worked-solution "The set of all points $(x,y)$ that are a distance $5$ from the origin defines a circle with radius $r=5$ centered at the origin, as shown below.\n\n![](images/39/398adead10233d1af61cd9aa44f14d51eba9c195d30c9d6b16015a3391403908.png)\n\nSo, the required equation is\n\n$$\n\\begin{aligned}{x}^{2}+{y}^{2} & ={r}^{2} \\\\ {x}^{2}+{y}^{2} & ={5}^{2} \\\\ {x}^{2}+{y}^{2} & =25.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186083920 :knowledge-point/_questions [{:db/id #edb/ref 17592186083254 :knowledge-point/id #uuid "646467d1-f764-5a3c-b03b-7d74e588611d" :knowledge-point/title "Calculating the Speed of a Particle at a Given Time"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "28186592-08bc-549e-9c22-c79ee3ea6745" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186336408} {:answer/id #uuid "3025f42b-c5db-534a-b7db-5eb1874e4c83" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{5}" :db/id #edb/ref 17592186336493} {:answer/id #uuid "61f846a2-1971-5874-84e8-c682412f989c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186336914} {:answer/id #uuid "7bbd7131-4a34-5bb1-b11e-243d31511be7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3\\sqrt{5}" :db/id #edb/ref 17592186337150} {:answer/id #uuid "a724f86f-6e25-582e-8cc1-02e5086a17ff" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{10}" :db/id #edb/ref 17592186337545}] :answer-field/correct {:answer/id #uuid "61f846a2-1971-5874-84e8-c682412f989c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186336914} :answer-field/id #uuid "3f0ed294-f84f-5efe-be0c-4f49c2d7af7f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186338389}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "6995c088-70db-5fcb-a926-3a5bb8ce6736" :question/math-academy-id "q-7151" :question/problem "The position vector $r$ of a particle $P$ (relative to a fixed origin $O$) at time $t$ is given by\n\n$$\nr=⟨\\frac{{t}^{2}}{2},\\,3t+7⟩,\\,t>0.\n$$\n\nCalculate the speed of the particle at time $t=4.$" :question/worked-solution "First, we calculate the velocity vector $v.$ Differentiating the position vector, we get\n\n$$\n\\begin{aligned}v & =\\frac{\\text{d}r}{\\text{d}t} \\\\  & =⟨\\frac{\\text{d}x}{\\text{d}t},\\frac{\\text{d}y}{\\text{d}t}⟩ \\\\  & =⟨\\frac{\\text{d}}{\\text{d}t}(\\frac{{t}^{2}}{2}),\\frac{\\text{d}}{\\text{d}t}(3t+7)⟩ \\\\  & =⟨t,3⟩.\\end{aligned}\n$$\n\nTo find the velocity when $t=4,$ we substitute in the above:\n\n$$\nv=⟨4,3⟩\n$$\n\nTo find the speed at $t=4$ we calculate the magnitude of $v(4),$ and we get\n\n$$\n\\begin{aligned}|v(4)| & =\\sqrt{{4}^{2}+{3}^{2}} \\\\  & =\\sqrt{16+9} \\\\  & =\\sqrt{25} \\\\  & =5.\\end{aligned}\n$$\n\nSo, the speed when $t=4$ is $5.$"}] [{:db/id #edb/ref 17592186338957 :knowledge-point/_questions [{:db/id #edb/ref 17592186092384 :knowledge-point/id #uuid "4a05f6c0-98ab-5197-922e-8e8dff1d4302" :knowledge-point/title "Calculating the Slope of a Normal Line to a Curve at a Point"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "105a0ee2-ecfe-5f6b-abf3-c2b8990ff5e8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{4}" :db/id #edb/ref 17592186336186} {:answer/id #uuid "8afbf511-93b1-574c-aea0-f719ed534072" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{4}{5}" :db/id #edb/ref 17592186337288} {:answer/id #uuid "9b55a9ee-2b2e-5710-b96a-5529ce814f84" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186337440} {:answer/id #uuid "b83a05a7-995d-5078-bf9a-4b58abb10a90" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186337665} {:answer/id #uuid "e2cfabde-266f-53a5-a5bf-2a8c9659561a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{4}" :db/id #edb/ref 17592186338007}] :answer-field/correct {:answer/id #uuid "105a0ee2-ecfe-5f6b-abf3-c2b8990ff5e8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{4}" :db/id #edb/ref 17592186336186} :answer-field/id #uuid "fb39a159-1af8-51a3-9955-b31d00f03bbf" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186338721}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "0b93f0c3-f4cf-5391-8374-d4b6970c54ae" :question/math-academy-id "q-71524" :question/problem "Find the slope of the normal line to the curve $y={x}^{2}-5$ at the point $(2,-1).$" :question/worked-solution "Let $f(x)={x}^{2}-5.$ First, we compute the derivative:\n\n$$\n\\begin{aligned}{f}^{′}(x)=\\frac{\\text{d}}{\\text{d}x}({x}^{2}-5)=2x\\end{aligned}\n$$\n\nThen, we compute the slope of the tangent at the point $(2,-1):$\n\n$$\n\\begin{aligned}m={f}^{′}(2)=2(2)=4\\end{aligned}\n$$\n\nTherefore, the slope of the normal line ${m}^{′}$ is\n\n$$\n{m}^{′}=-\\frac{1}{m}=-\\frac{1}{4}.\n$$"}] [{:db/id #edb/ref 17592186379938 :knowledge-point/_questions [{:db/id #edb/ref 17592186105916 :knowledge-point/id #uuid "e598ad1e-cee5-5d5f-b2a9-c067e4625cf6" :knowledge-point/title "Calculating a Scalar Projection Using Angles and Magnitudes"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8ae36112-5d67-541f-8618-63c91ad25131" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{3}" :db/id #edb/ref 17592186379940} {:answer/id #uuid "e10ff8bd-44a5-5190-acb6-446d018c9704" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{\\sqrt{3}}{2}" :db/id #edb/ref 17592186379941} {:answer/id #uuid "4323e039-1d0d-5d26-a6ff-3ece5246be8f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186379942} {:answer/id #uuid "aa3e86b8-2db7-52af-8116-994cefeff282" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\sqrt{3}" :db/id #edb/ref 17592186379943} {:answer/id #uuid "8dbbcd7c-a0a4-54df-8f2f-41d5c56772be" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186379944}] :answer-field/correct {:answer/id #uuid "aa3e86b8-2db7-52af-8116-994cefeff282" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\sqrt{3}" :db/id #edb/ref 17592186379943} :answer-field/id #uuid "9d208d89-fa96-5758-89de-b77ebf18b4c9" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186379939}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "90337284-e168-5a3e-b426-ab4b7cb72992" :question/math-academy-id "q-71533" :question/problem "Suppose $|\\,p\\,|=2$ and the angle between vectors $p$ and $q$ is $\\theta =\\frac{5\\pi }{6}.$ Find the scalar projection of $p$ onto $q.$" :question/worked-solution "Using the formula for the scalar projection, we obtain\n\n$$\n\\begin{aligned}{\\text{comp}}_{q}\\,p & =|\\,p\\,|\\operatorname{cos}⁡\\theta  \\\\  & =2\\operatorname{cos}⁡(\\frac{5\\pi }{6}) \\\\  & =2\\cdot (-\\frac{\\sqrt{3}}{2}) \\\\  & =-\\sqrt{3}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186088284 :knowledge-point/_questions [{:db/id #edb/ref 17592186087763 :knowledge-point/id #uuid "9ec9e0af-bbdc-5a29-bdbb-602e4d1f016a" :knowledge-point/title "Finding the Acceleration Vector of a Particle Given Its Velocity Vector"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "94c87ef4-516b-5fd3-946b-8f9c62c98016" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "a = ⟨5, 2t⟩" :db/id #edb/ref 17592186086359} {:answer/id #uuid "9e58aea6-19dc-5488-bc80-93d7632e221f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "a = ⟨ - 8, 4⟩" :db/id #edb/ref 17592186086360} {:answer/id #uuid "39afe4ac-830b-58c4-b06b-d3fb4983f0bc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "a = ⟨5t, 2t^{2}⟩" :db/id #edb/ref 17592186086361} {:answer/id #uuid "5f00365e-8d58-5b9f-b448-aa58586fbb31" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "a = ⟨5, 4t⟩" :db/id #edb/ref 17592186086362} {:answer/id #uuid "6586d8bf-7a12-561b-af59-2bdb282646dc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "a = ⟨5, 2⟩" :db/id #edb/ref 17592186086363}] :answer-field/id #uuid "c8eeedcb-7380-5490-8e80-bea8245eee54" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186086358} {:answer-field/choices [{:answer/id #uuid "2ed876eb-e8b1-58fc-a7c7-49ce58aab2a1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "a=⟨-8,\\,4⟩" :db/id #edb/ref 17592186393148} {:answer/id #uuid "6c9432b2-20cf-5e0d-b627-365bf8bb517b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "a=⟨5t,\\,2{t}^{2}⟩" :db/id #edb/ref 17592186393149} {:answer/id #uuid "5aeefe63-a288-5b47-85c7-d2a2775613d9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "a=⟨5,\\,2t⟩" :db/id #edb/ref 17592186393150} {:answer/id #uuid "ee5fa715-a949-54b8-a77a-babd9c98996a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "a=⟨5,\\,4t⟩" :db/id #edb/ref 17592186393151} {:answer/id #uuid "5f894125-91dc-5e2c-bd9f-0d467b5542d7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "a=⟨5,\\,2⟩" :db/id #edb/ref 17592186393152}] :answer-field/correct {:answer/id #uuid "ee5fa715-a949-54b8-a77a-babd9c98996a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "a=⟨5,\\,4t⟩" :db/id #edb/ref 17592186393151} :answer-field/id #uuid "78dfd377-d2e6-5c1a-8aa3-e854870d70f7" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186393147}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "fca59699-e72b-5149-821a-1daf54baaef5" :question/math-academy-id "q-7156" :question/problem "The velocity vector $v=⟨u,v⟩$ of a particle $P$ at time $t$ is given by\n\n$$\nv=⟨5t-8,\\,2{t}^{2}+4⟩.\n$$\n\nCalculate the acceleration vector $a.$" :question/worked-solution "To compute the acceleration vector, we differentiate the velocity vector:\n\n$$\n\\begin{aligned}a & =\\frac{\\text{d}v}{\\text{d}t} \\\\  & =⟨\\frac{\\text{d}u}{\\text{d}t},\\,\\frac{\\text{d}v}{\\text{d}t}⟩ \\\\  & =⟨\\frac{\\text{d}}{\\text{d}t}(5t-8),\\,\\frac{\\text{d}}{\\text{d}t}(2{t}^{2}+4)⟩ \\\\  & =⟨5,\\,4t⟩\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186393160 :knowledge-point/_questions [{:db/id #edb/ref 17592186087764 :knowledge-point/id #uuid "380357c3-4914-5137-9449-0e02076cb248" :knowledge-point/title "Finding the Acceleration Vector of a Particle Given Its Position Vector"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5bb87f44-9e54-547c-bf05-ae2ff892adc9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "a=⟨4{t}^{3},\\,6⟩" :db/id #edb/ref 17592186393162} {:answer/id #uuid "9e4c5bec-76b9-51aa-955d-d6d64eddf07d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "a=⟨6{t}^{3},\\,4⟩" :db/id #edb/ref 17592186393163} {:answer/id #uuid "783f3cce-1dea-53dc-8a90-43631ed18539" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "a=⟨{t}^{4},\\,3t⟩" :db/id #edb/ref 17592186393164} {:answer/id #uuid "08c13741-b540-5324-ade7-9e8d1017f6ed" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "a=⟨{t}^{3},\\,3⟩" :db/id #edb/ref 17592186393165} {:answer/id #uuid "beb86fd9-f93a-555f-a0ac-cfee71d85783" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "a=⟨4{t}^{3},\\,6t⟩" :db/id #edb/ref 17592186393166}] :answer-field/correct {:answer/id #uuid "5bb87f44-9e54-547c-bf05-ae2ff892adc9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "a=⟨4{t}^{3},\\,6⟩" :db/id #edb/ref 17592186393162} :answer-field/id #uuid "f76bc762-0563-53c1-a43e-9693c4d41279" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186393161}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "018374cc-40c9-5d0d-a1b9-641708c13290" :question/math-academy-id "q-7165" :question/problem "The position vector $r$ of a particle $P$ (relative to a fixed origin $O$) at time $t$ is given by\n\n$$\nr=⟨\\frac{{t}^{5}}{5},\\,3{t}^{2}-1⟩.\n$$\n\nCalculate the acceleration vector $a.$" :question/worked-solution "To compute the acceleration vector, we need to differentiate the velocity vector. So first, we need to compute the velocity vector, which we can do this by differentiating the position vector:\n\n$$\n\\begin{aligned}v & =\\frac{\\text{d}r}{\\text{d}t} \\\\  & =⟨\\frac{\\text{d}x}{\\text{d}t},\\,\\frac{\\text{d}y}{\\text{d}t}⟩ \\\\  & =⟨\\frac{\\text{d}}{\\text{d}t}(\\frac{{t}^{5}}{5}),\\,\\frac{\\text{d}}{\\text{d}t}(3{t}^{2}-1)⟩ \\\\  & =⟨{t}^{4},\\,6t⟩\\end{aligned}\n$$\n\nNow, to compute the acceleration vector, we differentiate the velocity vector:\n\n$$\n\\begin{aligned}a & =\\frac{\\text{d}v}{\\text{d}t} \\\\  & =⟨\\frac{\\text{d}u}{\\text{d}t},\\,\\frac{\\text{d}v}{\\text{d}t}⟩ \\\\  & =⟨\\frac{\\text{d}}{\\text{d}t}({t}^{4}),\\,\\frac{\\text{d}}{\\text{d}t}(6t)⟩ \\\\  & =⟨4{t}^{3},\\,6⟩\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186393167 :knowledge-point/_questions [{:db/id #edb/ref 17592186105702 :knowledge-point/id #uuid "c0670172-77cb-5e88-b78d-e5136c06095f" :knowledge-point/title "Calculating a Vector Projection Using Components"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2b3a993e-29b5-59cb-99e5-ded901d8bd0a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨0,0,0⟩" :db/id #edb/ref 17592186393169} {:answer/id #uuid "c7002ec2-9546-5f0e-821c-ebe64ba0bd6c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨\\frac{4}{19},\\frac{12}{19},-\\frac{12}{19}⟩" :db/id #edb/ref 17592186393170} {:answer/id #uuid "7366fd93-b330-5afb-bffc-fc0a9d70dc12" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨\\frac{1}{5},\\frac{2}{5},-\\frac{1}{5}⟩" :db/id #edb/ref 17592186393171} {:answer/id #uuid "3da3af95-6571-5bb0-ac07-5accef6e0a78" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186393172} {:answer/id #uuid "736a78cf-613a-5d25-a09d-d0901781721f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨\\frac{3}{17},\\frac{1}{17},\\frac{1}{17}⟩" :db/id #edb/ref 17592186393173}] :answer-field/correct {:answer/id #uuid "c7002ec2-9546-5f0e-821c-ebe64ba0bd6c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨\\frac{4}{19},\\frac{12}{19},-\\frac{12}{19}⟩" :db/id #edb/ref 17592186393170} :answer-field/id #uuid "81ed75df-1ce1-5ebc-81a9-b722c6382e6e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186393168}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "4a5f805d-9915-543e-b3c6-5d61cd49da57" :question/math-academy-id "q-71662" :question/problem "Let $c=[\\begin{aligned}1 \\\\ 2 \\\\ 1\\end{aligned}]$ and $d=[\\begin{aligned}1 \\\\ 3 \\\\ -3\\end{aligned}].$ Find the vector projection of $c$ onto $d.$" :question/worked-solution "Using the formula for the vector projection, we obtain\n\n$$\n\\begin{aligned}{\\text{proj}}_{d}\\,c & =\\frac{c\\cdot d}{d\\cdot d}d \\\\  & =\\frac{{c}_{x}{d}_{x}+{c}_{y}{d}_{y}+{c}_{z}{d}_{z}}{{d}_{x}^{2}+{d}_{y}^{2}+{d}_{z}^{2}}d \\\\  & =\\frac{1\\cdot 1+2\\cdot 3+1\\cdot (-3)}{{1}^{2}+{3}^{2}+(-3)^{2}}d \\\\  & =\\frac{4}{19}⟨1,3,-3⟩ \\\\  & =⟨\\frac{4}{19},\\frac{12}{19},-\\frac{12}{19}⟩.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186338970 :knowledge-point/_questions [{:db/id #edb/ref 17592186064181 :knowledge-point/id #uuid "9836abbe-e172-5c2f-8b19-145ef6d5c02d" :knowledge-point/title "Integrating Cosecant Squared"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3b98751b-5a6f-5701-a079-66efabd0c54e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3tan⁡y+C" :db/id #edb/ref 17592186336591} {:answer/id #uuid "6c064b7d-ae95-54c0-99a2-5b48ab4e6e2b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3cot⁡y+C" :db/id #edb/ref 17592186336987} {:answer/id #uuid "898bc83c-2d65-5f25-8fe3-14152653f4f1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3tan⁡y+C" :db/id #edb/ref 17592186337272} {:answer/id #uuid "bab226dc-1012-58ab-b0e7-c57b6031dacd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3cot⁡y+C" :db/id #edb/ref 17592186337686} {:answer/id #uuid "fe8ec3ab-b777-58b0-80b5-c49a97bea68f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3csc⁡ycot⁡y+C" :db/id #edb/ref 17592186338265}] :answer-field/correct {:answer/id #uuid "6c064b7d-ae95-54c0-99a2-5b48ab4e6e2b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3cot⁡y+C" :db/id #edb/ref 17592186336987} :answer-field/id #uuid "0033f394-fd38-57df-b724-8ce5cc5ff702" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186338279}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "2e4929ca-7804-5d00-ada3-f06fc525c774" :question/math-academy-id "q-71663" :question/problem "$\\int -3{csc}^{2}⁡y\\,\\text{d}y=$" :question/worked-solution "Recall that \n\n$$\n\\int {csc}^{2}⁡y\\,\\text{d}y=-cot⁡y+C\n$$\n\nTherefore, we get\n\n$$\n\\begin{aligned}\\begin{aligned}\\int -3{csc}^{2}⁡y\\,\\text{d}y & =-3\\int {csc}^{2}⁡y\\,\\text{d}y \\\\  & =-3(-cot⁡y)+C \\\\  & =3cot⁡y+C.\\end{aligned}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186338971 :knowledge-point/_questions [{:db/id #edb/ref 17592186064181 :knowledge-point/id #uuid "9836abbe-e172-5c2f-8b19-145ef6d5c02d" :knowledge-point/title "Integrating Cosecant Squared"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "29f94094-a13e-59d3-8e01-6476ad259936" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "sec⁡ytan⁡y+C" :db/id #edb/ref 17592186336421} {:answer/id #uuid "4bbf7e18-db54-5ad4-94b3-6740e294fa86" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "tan⁡y+C" :db/id #edb/ref 17592186336736} {:answer/id #uuid "5a246749-d6a8-5b61-ab0c-eb37e92ba4e3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-tan⁡y+C" :db/id #edb/ref 17592186336853} {:answer/id #uuid "7eef5879-dbe7-5b97-97a6-26e4a74a9d5b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "cot⁡y+C" :db/id #edb/ref 17592186337182} {:answer/id #uuid "cbbba5ec-56d3-5218-abf9-36a5e07211a3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-cot⁡y+C" :db/id #edb/ref 17592186337821}] :answer-field/correct {:answer/id #uuid "7eef5879-dbe7-5b97-97a6-26e4a74a9d5b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "cot⁡y+C" :db/id #edb/ref 17592186337182} :answer-field/id #uuid "709f437f-6931-5254-8a8a-e5df59c326ec" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186338469}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "e6d46060-4d10-5e18-98aa-e065865069a6" :question/math-academy-id "q-71664" :question/problem "$\\int -{csc}^{2}⁡y\\,\\text{d}y=$" :question/worked-solution "Recall that \n\n$$\n\\int {csc}^{2}⁡y\\,\\text{d}y=-cot⁡y+C\n$$\n\nTherefore, we get\n\n$$\n\\begin{aligned}\\begin{aligned}\\int -{csc}^{2}⁡y\\,\\text{d}y & =-\\int {csc}^{2}⁡y\\,\\text{d}y \\\\  & =-(-cot⁡y)+C \\\\  & =cot⁡y+C.\\end{aligned}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186338981 :knowledge-point/_questions [{:db/id #edb/ref 17592186059770 :knowledge-point/id #uuid "14d047c8-f032-5ff3-aced-65d40bfeeaad" :knowledge-point/title "Finding the Augmented Matrix of a Linear System With Variables Other Than x, y, z"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0ddc44f3-1a32-52a9-9031-b6a56a4c5108" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & -1 & -1 \\\\ -1 & -1 & 1\\end{aligned}]" :db/id #edb/ref 17592186336161} {:answer/id #uuid "0ea49bc6-7ef7-57db-bb92-09c032a1d6f7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}-1 & 1 \\\\ -1 & -1 \\\\ -1 & 1\\end{aligned}]" :db/id #edb/ref 17592186336170} {:answer/id #uuid "30d03117-bdb7-5d97-9599-7a98774e36e8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}-1 & 1 & -1 \\\\ -1 & -1 & 1\\end{aligned}]" :db/id #edb/ref 17592186336498} {:answer/id #uuid "424af963-b37e-5232-9f21-c41fe8e366ad" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}-1 & 1 & -1 \\\\ 1 & 1 & 1\\end{aligned}]" :db/id #edb/ref 17592186336659} {:answer/id #uuid "6e0b194c-4ec3-5eb9-8d66-12bf1b7385e2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}-1 & 1 & 1 \\\\ -1 & -1 & -1\\end{aligned}]" :db/id #edb/ref 17592186337008}] :answer-field/correct {:answer/id #uuid "0ddc44f3-1a32-52a9-9031-b6a56a4c5108" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & -1 & -1 \\\\ -1 & -1 & 1\\end{aligned}]" :db/id #edb/ref 17592186336161} :answer-field/id #uuid "72df1cb2-a890-5c64-9b81-0a1f27f75747" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186338472}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "1731054d-ea13-5a85-8abe-142bb7f3ad7f" :question/math-academy-id "q-71734" :question/problem "What is the augmented matrix for the following system of linear equations?\n\n$$\n\\begin{aligned}\\{\\begin{aligned}u-v=-1 \\\\ -u-v=1\\end{aligned}\\end{aligned}\n$$" :question/worked-solution "Notice that the system is already organized so that the variables are in the order $u,v$ on the left-hand side, the constants are on the right-hand side, and every variable has a coefficient.   \n\nThe coefficient matrix consists of the coefficients of the variables: \n\n$$\n[\\begin{aligned}1 & -1 \\\\ -1 & -1\\end{aligned}]\n$$\n\nThe augmented matrix is the coefficient matrix augmented with the column that represents the right-hand sides of the equations:\n\n$$\n[\\begin{aligned}1 & -1 & -1 \\\\ -1 & -1 & 1\\end{aligned}]\n$$"}] [{:db/id #edb/ref 17592186064946 :knowledge-point/_questions [{:db/id #edb/ref 17592186064371 :knowledge-point/id #uuid "45b380ed-1974-5876-8c88-a45773741b48" :knowledge-point/title "Calculating the Speed of a Particle at a Particular Moment"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "899c0898-cc24-5360-b626-1256d90ee17e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1.5cm/s" :db/id #edb/ref 17592186063733} {:answer/id #uuid "c6aaecc1-1a6e-5ad3-9010-833d1cbbb472" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2.0cm/s" :db/id #edb/ref 17592186063734} {:answer/id #uuid "d2a83fe4-2550-5f4e-bded-f0e0495d3bad" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2.5cm/s" :db/id #edb/ref 17592186063735} {:answer/id #uuid "1db5a007-393b-5b2a-820b-7b0e9ee282a0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3.0cm/s" :db/id #edb/ref 17592186063736} {:answer/id #uuid "3d517248-0d79-5d46-92c9-c67e3e69e7db" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4.0cm/s" :db/id #edb/ref 17592186063737}] :answer-field/id #uuid "1533643d-1ad3-5fcd-8671-813502553b72" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186063732} {:answer-field/choices [{:answer/id #uuid "309fb741-f2ee-5d42-a410-6d3722af473d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1.5\\,\\text{cm/s}" :db/id #edb/ref 17592186393175} {:answer/id #uuid "0ba94734-6539-5f8b-b9fa-953023f4379c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2.5\\,\\text{cm/s}" :db/id #edb/ref 17592186393176} {:answer/id #uuid "827e042d-b06c-59c7-b91a-f5e840050abb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2.0\\,\\text{cm/s}" :db/id #edb/ref 17592186393177} {:answer/id #uuid "dafb3fc0-f6a1-5617-964a-36080cd6f04c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3.0\\,\\text{cm/s}" :db/id #edb/ref 17592186393178} {:answer/id #uuid "577baa3c-ff60-5e2e-9451-c051fd6e20b6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4.0\\,\\text{cm/s}" :db/id #edb/ref 17592186393179}] :answer-field/correct {:answer/id #uuid "0ba94734-6539-5f8b-b9fa-953023f4379c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2.5\\,\\text{cm/s}" :db/id #edb/ref 17592186393176} :answer-field/id #uuid "89bc4a65-3fa0-525a-8a5b-ebdeb649b1a9" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186393174}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "c20eb755-854c-51a7-aed2-16e438744a82" :question/math-academy-id "q-7175" :question/problem "The position $s(t)$ of a particle (in centimeters) at time $t$ seconds is given by \n\n$$\ns(t)=\\frac{5t-10}{t},\\,t>0.\n$$\n\nCalculate the speed of the particle when $t=2\\,\\text{s}.$" :question/requires-calculator true :question/worked-solution "First, we calculate the velocity function by differentiating the position function:\n\n$$\n\\begin{aligned}v(t) & =\\frac{\\text{d}s}{\\text{d}t} \\\\  & =\\frac{\\text{d}}{\\text{d}t}(\\frac{5t-10}{t}) \\\\  & =\\frac{10}{{t}^{2}}\\end{aligned}\n$$\n\nWhen $t=2,$ the velocity is\n\n$$\nv(2)=\\frac{10}{(2)^{2}}=\\frac{10}{4}=2.5.\n$$\n\nTherefore, the speed is $|2.5|=2.5\\,\\text{cm/s}.$"}] [{:db/id #edb/ref 17592186338983 :knowledge-point/_questions [{:db/id #edb/ref 17592186064182 :knowledge-point/id #uuid "90033e91-fdb2-5aa0-8cce-76762a38ffd2" :knowledge-point/title "Integrating Using Arcsine"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "753fa037-4869-57bb-ac4a-0f8226e93dce" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8{x}^{2}-\\operatorname{arccos}⁡x+C" :db/id #edb/ref 17592186337088} {:answer/id #uuid "7de44454-c056-5b46-a5ff-feadd65645cc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4{x}^{2}-\\operatorname{arcsin}⁡x+C" :db/id #edb/ref 17592186337171} {:answer/id #uuid "af75991e-fe31-5097-bab1-f9f7833dfa8f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4{x}^{2}-\\operatorname{arctan}⁡x+C" :db/id #edb/ref 17592186337609} {:answer/id #uuid "cddee891-ba94-5bd0-9d64-b60f3812c423" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8{x}^{2}-\\operatorname{arcsin}⁡x+C" :db/id #edb/ref 17592186337835} {:answer/id #uuid "f64bcadb-6519-5fea-93f7-63aa02c92d1d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4{x}^{2}-\\operatorname{arccos}⁡x+C" :db/id #edb/ref 17592186338190}] :answer-field/correct {:answer/id #uuid "7de44454-c056-5b46-a5ff-feadd65645cc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4{x}^{2}-\\operatorname{arcsin}⁡x+C" :db/id #edb/ref 17592186337171} :answer-field/id #uuid "f6a689b3-7d92-5c9d-b9a2-6c4b6c753f86" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186338710}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "f5352827-e02f-55d1-bc3e-a103f93321ab" :question/math-academy-id "q-71761" :question/problem "$\\int (8x-\\frac{1}{\\sqrt{1-{x}^{2}}})\\text{d}x=$" :question/worked-solution "Recall that \n\n$$\n\\int \\frac{1}{\\sqrt{1-{x}^{2}}}\\,\\text{d}x=\\operatorname{arcsin}⁡x+C.\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}\\int (8x-\\frac{1}{\\sqrt{1-{x}^{2}}})\\text{d}x & =\\int 8x\\,\\text{d}x-\\int \\frac{1}{\\sqrt{1-{x}^{2}}}\\,\\text{d}x \\\\  & =8\\int x\\,\\text{d}x-\\int \\frac{1}{\\sqrt{1-{x}^{2}}}\\,\\text{d}x \\\\  & =4{x}^{2}-\\operatorname{arcsin}⁡x+C.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186338984 :knowledge-point/_questions [{:db/id #edb/ref 17592186064183 :knowledge-point/id #uuid "d7256d2e-7105-5a4e-8d0a-5e00dfc1e311" :knowledge-point/title "Integrating Using Arctangent"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2c05b9ce-0e54-531e-9602-9aa81d5949a6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{x}^{5}+7\\operatorname{arctan}⁡x+C" :db/id #edb/ref 17592186336447} {:answer/id #uuid "627ef198-a214-5417-80e9-b45a792ad5f0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{x}^{5}+7\\text{ arcsec }x+C" :db/id #edb/ref 17592186336916} {:answer/id #uuid "71c35c47-7b7b-5fef-b294-b9cb841b489c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5{x}^{5}+7\\operatorname{arctan}⁡x+C" :db/id #edb/ref 17592186337048} {:answer/id #uuid "bb6f9d28-d3e5-53a1-a5e5-29186ee63437" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{x}^{5}+7\\text{ arccot }x+C" :db/id #edb/ref 17592186337694} {:answer/id #uuid "edeaae97-ac2c-562a-abdb-dd6daecb94ce" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5{x}^{5}+7\\operatorname{arcsin}⁡x+C" :db/id #edb/ref 17592186338111}] :answer-field/correct {:answer/id #uuid "2c05b9ce-0e54-531e-9602-9aa81d5949a6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{x}^{5}+7\\operatorname{arctan}⁡x+C" :db/id #edb/ref 17592186336447} :answer-field/id #uuid "31ce09db-263d-5513-8b14-b7d2cd24d8f1" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186338372}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "8482c878-eb98-5b38-8c38-4c3a4a08ab5b" :question/math-academy-id "q-71768" :question/problem "If ${f}^{′}(x)=5{x}^{4}+\\frac{7}{1+{x}^{2}},$ then $f(x)=$" :question/worked-solution "Recall that \n\n$$\n\\int \\frac{1}{1+{x}^{2}}\\text{d}x=\\operatorname{arctan}⁡x+C.\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}f(x)=\\int {f}^{′}(x)\\,\\text{d}x & =\\int (5{x}^{4}+\\frac{7}{1+{x}^{2}})\\text{d}x \\\\  & =\\int 5{x}^{4}\\,\\text{d}x+\\int \\frac{7}{1+{x}^{2}}\\,\\text{d}x \\\\  & =5\\int {x}^{4}\\,\\text{d}x+7\\int \\frac{1}{1+{x}^{2}}\\,\\text{d}x \\\\  & =5\\cdot \\frac{{x}^{5}}{5}+7\\operatorname{arctan}⁡x+C \\\\  & ={x}^{5}+7\\operatorname{arctan}⁡x+C.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186379945 :knowledge-point/_questions [{:db/id #edb/ref 17592186192764 :knowledge-point/id #uuid "f3149834-ef92-5016-a84a-40b207fee519" :knowledge-point/title "Identifying Open and Closed Sets of Real Numbers"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b9e78cd0-978d-506e-868e-8f83ca2997fd" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186379947} {:answer/id #uuid "37dec8a5-f8e6-5cc7-8e9a-857e6b978568" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186379948} {:answer/id #uuid "043e74e4-44a8-5f9f-a9d4-625b37cab07b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186379949} {:answer/id #uuid "f95e0e68-6456-5561-b1dc-7e93d3d74f97" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I, II and III" :db/id #edb/ref 17592186379950} {:answer/id #uuid "d9ce9216-f20f-5028-a7db-a11d12ae2903" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186379951}] :answer-field/correct {:answer/id #uuid "043e74e4-44a8-5f9f-a9d4-625b37cab07b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186379949} :answer-field/id #uuid "9a2667ff-2890-55a8-93a7-c69f02f7fbdb" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186379946}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "d4218ace-9c46-5876-8096-9bc751d57412" :question/math-academy-id "q-71793" :question/problem "Which of the following sets are closed?\n\n- $[-2,2]$\n- $[3,9]$\n- $[-1,1)\\cup (3,4]$" :question/worked-solution "Recall that:\n\n- A set is *open* if it does not contain any of its boundary points. In other words, an open set consists only of the interior points of the set.\n\n- A set is *closed* if it contains **all** of its boundary points. In other words, a closed set consists of all the interior and all the boundary points of the set.\n\nAmong the given sets, only $[-2,2]$ and $[3,9]$ are closed because:\n\n- The boundary points of $[-2,2]$ are $-2$, and $2.$ Both of them lie in the set.\n\n- The boundary points of $[3,9]$ are $3$, and $9.$ Both of them lie in the set.\n\nThe other set is not closed because $[-1,1)\\cup (3,4]$ has a boundary point $1$, which does not lie in the set.\n\nTherefore, the correct answer is \"I and II only\"."}] [{:db/id #edb/ref 17592186379959 :knowledge-point/_questions [{:db/id #edb/ref 17592186192764 :knowledge-point/id #uuid "f3149834-ef92-5016-a84a-40b207fee519" :knowledge-point/title "Identifying Open and Closed Sets of Real Numbers"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e5f1dd57-43e7-5134-89fd-b1f1e3038ace" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186379961} {:answer/id #uuid "c4feb077-a267-505c-831a-200f40aea191" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186379962} {:answer/id #uuid "714f89d8-1d11-59c9-ad7e-699414828708" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186379963} {:answer/id #uuid "e3d7b5a7-c514-559c-bac4-f3da5f896b7b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186379964} {:answer/id #uuid "4033cbd4-eb1f-58a8-b330-03e076419290" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186379965}] :answer-field/correct {:answer/id #uuid "e5f1dd57-43e7-5134-89fd-b1f1e3038ace" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186379961} :answer-field/id #uuid "e9fc4fee-b20d-58a2-80e0-8f8db607a662" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186379960}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "f9b6f2b8-c18f-5a12-b634-f89ac5f5481f" :question/math-academy-id "q-71796" :question/problem "Which of the following sets are closed?\n\n- $(6,10]$\n- $[2,5]$\n- $[0,1]\\cup [3,4]$" :question/worked-solution "Recall that:\n\n- A set is *open* if it does not contain any of its boundary points. In other words, an open set consists only of the interior points of the set.\n\n- A set is *closed* if it contains **all** of its boundary points. In other words, a closed set consists of all the interior and all the boundary points of the set.\n\nAmong the given sets, only $[2,5]$ and $[0,1]\\cup [3,4]$ are closed because:\n\n- The boundary points of $[2,5]$ are $2$ and $5.$ Both of them lie in the set.\n\n- The boundary points of $[0,1]\\cup [3,4]$ are $0,1,3,$ and $4.$ All of them lie in the set.\n\nThe other set is not closed because $(6,10]$ has a boundary point $6$, which does not lie in the set.\n\nTherefore, the correct answer is \"II and III only\"."}] [{:db/id #edb/ref 17592186393180 :knowledge-point/_questions [{:db/id #edb/ref 17592186087889 :knowledge-point/id #uuid "e0cdcbc5-c10b-5dd1-af9a-410d2d44a4c5" :knowledge-point/title "Calculating the Acceleration of a Particle Given Its Velocity"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "89cf84e6-fa60-5c64-b93b-865747b163cd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "a(t)=1+\\frac{1}{{t}^{2}}" :db/id #edb/ref 17592186393182} {:answer/id #uuid "ce91f5ac-68b0-5d12-b408-5805719d5633" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "a(t)=1-\\frac{1}{{t}^{2}}" :db/id #edb/ref 17592186393183} {:answer/id #uuid "9153eb0d-2401-550a-8773-be6e4eb8e8c8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "a(t)=\\frac{1}{{t}^{2}}" :db/id #edb/ref 17592186393184} {:answer/id #uuid "adae588b-ff36-562f-b371-73f948870d37" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "a(t)=t+\\frac{1}{t}" :db/id #edb/ref 17592186393185} {:answer/id #uuid "d5256482-56c1-5d4e-a0c1-dc867d2591d7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "a(t)=t-\\frac{1}{t}" :db/id #edb/ref 17592186393186}] :answer-field/correct {:answer/id #uuid "89cf84e6-fa60-5c64-b93b-865747b163cd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "a(t)=1+\\frac{1}{{t}^{2}}" :db/id #edb/ref 17592186393182} :answer-field/id #uuid "0524bc50-6e64-5c83-9e81-cb4394c0bfc4" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186393181}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "2e5248e4-d160-51d4-9bba-1d38c3c5aabb" :question/math-academy-id "q-7186" :question/problem "The velocity $v$ of a particle at time $t$ is given by $v(t)=\\frac{{t}^{2}-1}{t}.$ Calculate the acceleration of the particle at time $t.$" :question/worked-solution "We differentiate $v(t)$ to calculate $a(t):$\n\n$$\n\\begin{aligned}a(t) & =\\frac{\\text{d}v}{\\text{d}t} \\\\  & =\\frac{\\text{d}}{\\text{d}t}(\\frac{{t}^{2}-1}{t}) \\\\  & =\\frac{\\text{d}}{\\text{d}t}(t-\\frac{1}{t}) \\\\  & =\\frac{\\text{d}}{\\text{d}t}(t-{t}^{-1}) \\\\  & =1-(-{t}^{-2}) \\\\  & =1+\\frac{1}{{t}^{2}}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186339007 :knowledge-point/_questions [{:db/id #edb/ref 17592186087700 :knowledge-point/id #uuid "a75c67e5-3469-5730-9181-54df4ec6d5b2" :knowledge-point/title "Determining the Inverse of a Larger Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "43339e1d-1bfa-55d0-b3c2-c8e4ad7e48be" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186336667} {:answer/id #uuid "7483dbfb-2a05-5002-b015-71ac4bbb50b4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186337079} {:answer/id #uuid "9bc56d9f-7969-5603-8164-402febf66e59" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186337442} {:answer/id #uuid "b2a235c2-3d22-5e37-8f24-ef0a23a374c2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186337626} {:answer/id #uuid "cf0d9494-e399-55f1-8b32-0a285f986f3f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186337843}] :answer-field/correct {:answer/id #uuid "b2a235c2-3d22-5e37-8f24-ef0a23a374c2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186337626} :answer-field/id #uuid "0b488541-8354-522a-b07d-347ec327f286" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186338298}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "8aec4565-777c-5fd0-95ff-9f5ced653b55" :question/math-academy-id "q-71879" :question/problem "Consider the matrices\n\n$$\nA=[\\begin{aligned}0 & -1 & -1 \\\\ 0 & 1 & 0 \\\\ 1 & 1 & 1\\end{aligned}],\\,B=[\\begin{aligned}1 & 0 & 1 \\\\ 0 & 2 & 0 \\\\ -1 & -1 & 0\\end{aligned}],\\,C=[\\begin{aligned}0 & -\\frac{1}{2} & -1 \\\\ 0 & \\frac{1}{2} & 0 \\\\ 1 & \\frac{1}{2} & 1\\end{aligned}].\n$$\n\nWhich of the following statements are true?\n\nI. $AB=BA={I}_{3}$\n\nII. $BC=CB={I}_{3}$\n\nIII. $A={B}^{-1}$" :question/worked-solution "- First, we check whether $AB=BA={I}_{3}.$ Computing $AB$, we get\n\n$$\n\\begin{aligned}AB & =[\\begin{aligned}0 & -1 & -1 \\\\ 0 & 1 & 0 \\\\ 1 & 1 & 1\\end{aligned}][\\begin{aligned}1 & 0 & 1 \\\\ 0 & 2 & 0 \\\\ -1 & -1 & 0\\end{aligned}] \\\\  & =[\\begin{aligned}∗ & -1 & ∗ \\\\ ∗ & ∗ & ∗ \\\\ ∗ & ∗ & ∗\\end{aligned}] \\\\  & \\ne {I}_{3}.\\,\\times \\end{aligned}\n$$\n\nSo, statement I is false. As a result, $A\\ne {B}^{-1}$ and statement III is false too.\n\n- Now, we check whether $BC=CB={I}_{3}.$ Computing $BC$, we get\n\n$$\n\\begin{aligned}BC & =[\\begin{aligned}1 & 0 & 1 \\\\ 0 & 2 & 0 \\\\ -1 & -1 & 0\\end{aligned}][\\begin{aligned}0 & -\\frac{1}{2} & -1 \\\\ 0 & \\frac{1}{2} & 0 \\\\ 1 & \\frac{1}{2} & 1\\end{aligned}] \\\\  & =[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 1\\end{aligned}] \\\\  & ={I}_{3}.\\,✓\\end{aligned}\n$$\n\nLikewise, computing $CB$, we get\n\n$$\n\\begin{aligned}CB & =[\\begin{aligned}0 & -\\frac{1}{2} & -1 \\\\ 0 & \\frac{1}{2} & 0 \\\\ 1 & \\frac{1}{2} & 1\\end{aligned}][\\begin{aligned}1 & 0 & 1 \\\\ 0 & 2 & 0 \\\\ -1 & -1 & 0\\end{aligned}] \\\\  & =[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 1\\end{aligned}] \\\\  & ={I}_{3}.\\,✓\\end{aligned}\n$$\n\nSo, statement II is true.\n\nTherefore, the correct answer is \"II only\"."}] [{:db/id #edb/ref 17592186403502 :knowledge-point/_questions [{:db/id #edb/ref 17592186176099 :knowledge-point/id #uuid "bee6d4bf-79da-5eb3-a214-8c045dbce5bd" :knowledge-point/title "Calculating the Velocity of a Particle at the Moment When Its Acceleration is Zero"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e800b9e5-7a04-5a52-83f0-e3afcf5ec850" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "t=4,\\,v=10.75" :db/id #edb/ref 17592186403504} {:answer/id #uuid "353897c1-d771-528a-9201-b28cc593f791" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "t=4.5,\\,v=27.5" :db/id #edb/ref 17592186403505} {:answer/id #uuid "351b1c52-f2f1-52fc-bd66-0b6482b93763" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "t=4.5,\\,v=12" :db/id #edb/ref 17592186403506} {:answer/id #uuid "e50e1c45-ecbd-5feb-9363-3cbef9942625" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "t=3.5,\\,v=26.5" :db/id #edb/ref 17592186403507} {:answer/id #uuid "61d395f2-5e29-597d-bed3-c8a2e676c54f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "t=4,\\,v=22.5" :db/id #edb/ref 17592186403508}] :answer-field/correct {:answer/id #uuid "353897c1-d771-528a-9201-b28cc593f791" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "t=4.5,\\,v=27.5" :db/id #edb/ref 17592186403505} :answer-field/id #uuid "f245a54a-e7b7-5958-90da-5850b106775b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186403503}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "e823f661-78ed-5c49-931f-9f7b092bd2fe" :question/math-academy-id "q-7188" :question/problem "A particle $P$ is traveling along the $x$-axis with displacement $s(t)$ from a fixed origin $O$ given by\n\n$$\ns(t)=-\\frac{2}{9}{t}^{3}+3{t}^{2}+14t+17,\\,t\\ge 0.\n$$\n\nFind the time at which the acceleration is zero, and find the value of the velocity at this moment." :question/worked-solution "First, we calculate $v(t)$ by differentiating $s(t):$\n\n$$\n\\begin{aligned}v(t) & =\\frac{\\text{d}s}{\\text{d}t} \\\\  & =\\frac{\\text{d}}{\\text{d}t}(-\\frac{2}{9}{t}^{3}+3{t}^{2}+14t+17) \\\\  & =-\\frac{2}{3}{t}^{2}+6t+14\\end{aligned}\n$$\n\n \n\nNow, we differentiate $v(t)$ to find $a(t):$\n\n$$\n\\begin{aligned}a(t) & =\\frac{\\text{d}v}{\\text{d}t} \\\\  & =\\frac{\\text{d}}{\\text{d}t}(-\\frac{2}{3}{t}^{2}+6t+14) \\\\  & =-\\frac{4}{3}t+6\\end{aligned}\n$$\n\nNext, we put $a=0$ to find the time when the acceleration is zero:\n\n$$\n\\begin{aligned}0 & =-\\frac{4}{3}t+6 \\\\ \\frac{4}{3}t & =6 \\\\ t & =4.5\\end{aligned}\n$$\n\nSo the acceleration is zero when $t=4.5.$ To find the velocity at this moment, we substitute this back into $v(t)$ to get\n\n$$\nv(4.5)=-\\frac{2}{3}(4.5)^{2}+6(4.5)+14=27.5.\n$$"}] [{:db/id #edb/ref 17592186125215 :knowledge-point/_questions [{:db/id #edb/ref 17592186124634 :knowledge-point/id #uuid "69b456ea-44de-59f0-b2c8-bc5b9495974f" :knowledge-point/title "Identifying True Statements From a Diagram"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b1793201-129d-586e-ba24-541ba48b5c56" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186123891} {:answer/id #uuid "ff9979eb-2f5f-5641-b566-095402b98985" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186123892} {:answer/id #uuid "174b13df-1819-52c0-b5dd-babbb464d829" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186123893} {:answer/id #uuid "6abbfeac-0ca1-52bd-a312-0a8d54ebc6e3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186123894} {:answer/id #uuid "724021fa-12d5-5bce-88d9-660e915c99f7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186123895}] :answer-field/id #uuid "9cdcce04-52ff-5754-bdb6-3f3b4c6b0a0d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186123890} {:answer-field/choices [{:answer/id #uuid "8c6a2427-827f-55eb-bf09-ebcc7fd2c160" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186377663} {:answer/id #uuid "0aa85b94-e0b7-5a39-a687-25c26ac8a992" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186377664} {:answer/id #uuid "3cf29082-1439-5153-bffc-8384f7245b71" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186377665} {:answer/id #uuid "288951d1-06aa-5510-80fc-1f9fb37f3b24" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186377666} {:answer/id #uuid "3a3a8f6e-f673-50c6-adfc-b3f584da1e61" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186377667}] :answer-field/correct {:answer/id #uuid "0aa85b94-e0b7-5a39-a687-25c26ac8a992" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186377664} :answer-field/id #uuid "51216ded-5b95-57bb-8fa7-e64432a5fb63" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186377662}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "9e699ccb-274c-55bb-b36e-2ab5da35b953" :question/math-academy-id "q-71882" :question/problem "![](images/33/33d777f400b53d2272636fc9c465cf83c22932d8172c5d8a35bcdd2bdaae09a1.png)\n\nConsider the set $M,$ depicted by the shaded region above. Which of the following statements are true?\n\n- $A$ is a boundary point of the set $M$\n- $B$ is a boundary point of the set $M$\n- $C$ is an interior point of the set $M$" :question/worked-solution "Let $\\delta >0.$ A *neighborhood* of a point ${x}_{0}$ is the set of points whose distance from ${x}_{0}$ is less than $\\delta .$\n\n$$\n{x:|x-{x}_{0}|<\\delta }\n$$\n\nIn two-dimensional space, a neighborhood of ${x}_{0}$ is the open disc $|x-{x}_{0}|<\\delta ,$ as shown below.\n\n![](images/50/50a6c72e169f3104eb0b9958673cc6644f770e6bcc3ebf23360eb20189325a28.png)\n\nFurthermore, we have the following definitions:\n\n- A point ${x}_{0}$ is an *interior point* of a set $S$ if $S$ contains *some* neighborhood of ${x}_{0}.$ The set of all interior points of $S$ is called the *interior* of $S.$\n\n- A point ${x}_{0}$ is a *boundary point* of a set $S$ if *every* neighborhood of ${x}_{0}$ contains points that are in $S$ and points that are not in $S.$ \nThe set of all boundary points of $S$ is called the *boundary* of $S.$\n\nWith that in mind, let's examine the statements in turn.\n\n$$\n\n$$\n\n![](images/46/46670ef62c2afa2e5aa5c0eb4d1684493f35ab4f9a82aa5375994bf1cb2cb154.png)\n\n$$\n\n$$\n\n- Statement I is true. Indeed, $A$ is a boundary point because every open neighborhood of $A$ contains points that belong to $M$ and points that do not belong to $M.$\n\n- Statement II is false. The point $B$ is an interior point since there exists an open neighborhood of $B$ that is fully contained inside the set $M.$\n\n- Statement III is true. Indeed, $C$ is an interior point since there exists an open neighborhood of $C$ that is fully contained inside the set $M.$\n\nTherefore, the correct answer is 'I and III only'."}] [{:db/id #edb/ref 17592186339008 :knowledge-point/_questions [{:db/id #edb/ref 17592186192787 :knowledge-point/id #uuid "f89386f9-8a2b-56eb-8521-7c1ddafcfd96" :knowledge-point/title "Identifying the Interior of a Set"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "07a430fa-18ac-5b72-b213-7419118f4d28" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0<{x}^{2}+{y}^{2}<1" :db/id #edb/ref 17592186336091} {:answer/id #uuid "261681af-6b12-54ce-90d1-a8bbf77d214c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0\\le {x}^{2}+{y}^{2}<2" :db/id #edb/ref 17592186336389} {:answer/id #uuid "3bf8ee8f-a53d-5a4a-970b-d8f88bbf5f34" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0<{x}^{2}+{y}^{2}<4" :db/id #edb/ref 17592186336596} {:answer/id #uuid "b7fe65d2-d5b1-57e7-967d-53f4f7eb8d9c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0<{x}^{2}+{y}^{2}<2" :db/id #edb/ref 17592186337661} {:answer/id #uuid "ec60a4d0-fed3-50cf-8700-ae050890c608" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0\\le {x}^{2}+{y}^{2}\\le 4" :db/id #edb/ref 17592186338092}] :answer-field/correct {:answer/id #uuid "3bf8ee8f-a53d-5a4a-970b-d8f88bbf5f34" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0<{x}^{2}+{y}^{2}<4" :db/id #edb/ref 17592186336596} :answer-field/id #uuid "3f1f5949-3ba9-562b-a461-7c260db2239f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186338390}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "a329f0e7-fa8c-5ef6-8758-63f7881531f4" :question/math-academy-id "q-71888" :question/problem "Consider the set $A,$ defined by \n\n$$\nA={(x,y)\\in {R}^{2}\\,:\\,0\\le {x}^{2}+{y}^{2}<4,\\,0\\le y<2}.\n$$\n\nThe interior of $A$ is given by\n\n$$\n\\text{int}\\,A={(x,y)\\in {R}^{2}\\,:\\,,\\,0<y<2}.\n$$\n\nWhat is the missing expression?" :question/worked-solution "The boundary of a set $A,$ denoted $∂A,$ is the set that contains all the boundary points of $A.$\n\nThe set $A$ and its boundary $∂A$ are shown below.\n\n![](images/f4/f4ee8fbf9a7670a7d0e0b7488bccbf014f8db8fff0154c7db025f2b071aec566.png)\n\nThe interior of a set $A,$ denoted $\\text{int}\\,A,$ is the set containing all the interior points of $A.$ It contains every point in $A$ except the boundary points: \n\n$$\n\\text{int}\\,A=A-∂A\n$$\n\nThe interior of $A$ is shown below.\n\n![](images/9f/9fc733f6966b016c93b6ee6a305c5af5ee4fa432dad5d95e28061fd2a0d33efb.png)\n\nSo, in this case, the interior of $A$ is given by\n\n$$\n\\text{int}\\,A={(x,y)\\in {R}^{2}\\,:\\,0<{x}^{2}+{y}^{2}<4,\\,0<y<2}.\n$$"}] [{:db/id #edb/ref 17592186339009 :knowledge-point/_questions [{:db/id #edb/ref 17592186064171 :knowledge-point/id #uuid "3f9548e6-28ef-5a97-ab04-dfb1b6e23c16" :knowledge-point/title "Integrating the Exponential Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "23784fc4-3a90-53e4-89bb-df7f53cf6d59" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}{e}^{x}+C" :db/id #edb/ref 17592186336365} {:answer/id #uuid "2c3c2a30-99f8-537b-8508-e5713aa27c9e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}{e}^{2x}+C" :db/id #edb/ref 17592186336450} {:answer/id #uuid "67383a40-44c5-5a00-bfa0-07f13c0dcbe6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{e}^{x}+C" :db/id #edb/ref 17592186336953} {:answer/id #uuid "b945ae93-7849-5d6e-b645-1e8c14a1d6cf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}{e}^{1/2x}+C" :db/id #edb/ref 17592186337675} {:answer/id #uuid "fbb744da-ccfd-5f44-8169-07909ef53f32" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2{e}^{x}+C" :db/id #edb/ref 17592186338242}] :answer-field/correct {:answer/id #uuid "23784fc4-3a90-53e4-89bb-df7f53cf6d59" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}{e}^{x}+C" :db/id #edb/ref 17592186336365} :answer-field/id #uuid "f9fc2e0f-aa1f-50b5-8ba0-74df5403bd7c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186338718}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "7119fae9-f265-530e-8dcf-9a8fd6ab825e" :question/math-academy-id "q-71900" :question/problem "$\\int \\frac{1}{2}{e}^{x}\\,\\text{d}x=$" :question/worked-solution "Factoring out the constant $\\frac{1}{2}$ and calculating the resulting integral, we get\n\n$$\n\\begin{aligned}\\int \\frac{1}{2}{e}^{x}\\,\\text{d}x & =\\frac{1}{2}\\int {e}^{x}\\,\\text{d}x \\\\  & =\\frac{1}{2}{e}^{x}+C.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186339012 :knowledge-point/_questions [{:db/id #edb/ref 17592186092386 :knowledge-point/id #uuid "44f09c22-7107-5c80-9c91-a7b58cb639b2" :knowledge-point/title "Estimating a Derivative From a Table Using a Forward Difference Approximation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0cd0adb6-1bd2-5705-9d99-f43d55b4d0bc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186336152} {:answer/id #uuid "12826623-37f5-5d60-82a4-81c8304ec69f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186336208} {:answer/id #uuid "23db118c-27be-5c6d-b298-fab8ffd8ebb8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186336369} {:answer/id #uuid "983e0a91-3664-58ec-a60b-1abfffdd593f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186337420} {:answer/id #uuid "fc8da3a7-b71b-51b9-848c-28049a316986" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186338253}] :answer-field/correct {:answer/id #uuid "12826623-37f5-5d60-82a4-81c8304ec69f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186336208} :answer-field/id #uuid "a3604013-2c08-5a12-919c-0ddaa43dfc91" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186338580}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "0a435c9a-da6e-5d88-b3b2-e3df2e3a1da1" :question/math-academy-id "q-71915" :question/problem "A function $p(t)$ has values according to the table below:\n\n| $t$ | $-2$ | $-1$ | $0$ | $1$ | $2$ | $3$ |\n| --- | --- | --- | --- | --- | --- | --- |\n| $p(t)$ | $3$ | $6$ | $9$ | $5$ | $1$ | $0$ |\n\nApproximate ${p}^{′}(t)$ at the point $t=0$ using a forward difference approximation." :question/worked-solution "We use the forward difference approximation\n\n$$\n{p}^{′}(t)≈\\frac{p(t+h)-p(t)}{h}\n$$\n\nat the point $t=0.$ We choose the step size $h$ to be as small as possible, in this case $h=1.$ This gives \n\n$$\n\\begin{aligned}{p}^{′}(0) & ≈\\frac{p(0+1)-p(0)}{1} \\\\  & =\\frac{p(1)-p(0)}{1} \\\\  & =5-9 \\\\  & =-4.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186339014 :knowledge-point/_questions [{:db/id #edb/ref 17592186092387 :knowledge-point/id #uuid "419134c3-3177-5d7d-86f6-899a73338b1c" :knowledge-point/title "Estimating a Derivative From a Graph Using a Forward Difference Approximation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2a2f0ad6-e62c-58a2-9002-9bab955f7c3e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186336425} {:answer/id #uuid "6ca5a669-e3b2-532b-a3fd-de673bfe5433" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186336996} {:answer/id #uuid "b8f5dc7a-4b60-596c-a77c-4c1880566b85" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186337671} {:answer/id #uuid "cb2ae886-e224-5d41-9e6a-e9cd18e64fea" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186337817} {:answer/id #uuid "e523cecf-ac3c-528d-b904-4c25cb796b39" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186338029}] :answer-field/correct {:answer/id #uuid "cb2ae886-e224-5d41-9e6a-e9cd18e64fea" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186337817} :answer-field/id #uuid "960ebabc-88cc-5fb7-a072-2b46fe3d5a3d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186338555}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "a7cfbba0-e1ec-5e2b-8311-cfe63691a6aa" :question/math-academy-id "q-71921" :question/problem "![](images/21/21e310adffbad6309176ea26549e0e43efe3d8e3d7f2f0b018902be16781802d.png)\n\nThe graph of the function $y=g(x)$ is shown above. Approximate ${g}^{′}(x)$ at the point $x=1.5$ using a forward difference approximation with step size $h=1.$" :question/worked-solution "We use the forward difference approximation\n\n$$\n{g}^{′}(x)≈\\frac{g(x+h)-g(x)}{h}\n$$\n\n \nat the point $x=1.5.$ Applying the above formula with $x=1.5$ and $h=1$ gives\n\n$$\n\\begin{aligned}{g}^{′}(1.5) & ≈\\frac{g(1.5+1)-g(1.5)}{1} \\\\  & =\\frac{g(2.5)-g(1.5)}{1} \\\\  & =4-2 \\\\  & =2.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186339023 :knowledge-point/_questions [{:db/id #edb/ref 17592186096843 :knowledge-point/id #uuid "0a312840-0d35-50bb-94b3-b04778f4efc3" :knowledge-point/title "Differentiating a Function Using the Chain Rule and Prime Notation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2d2f6517-e258-513a-b912-2250e7c54e17" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-15(2+5x{)}^{2}" :db/id #edb/ref 17592186336461} {:answer/id #uuid "3b2c8729-231c-5b49-a873-246a32aa4645" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-15(2-5x{)}^{3}" :db/id #edb/ref 17592186336588} {:answer/id #uuid "77d335ef-89db-5392-8e96-2e5663d37f72" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "15(2+5x{)}^{2}" :db/id #edb/ref 17592186337111} {:answer/id #uuid "84c34e15-f7f7-51bd-91ad-be1849bcac42" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "15(2-5x{)}^{2}" :db/id #edb/ref 17592186337229} {:answer/id #uuid "ba6755f1-59bc-5601-b289-66317d2b0d63" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-15(2-5x{)}^{2}" :db/id #edb/ref 17592186337682}] :answer-field/correct {:answer/id #uuid "ba6755f1-59bc-5601-b289-66317d2b0d63" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-15(2-5x{)}^{2}" :db/id #edb/ref 17592186337682} :answer-field/id #uuid "20dca297-5492-547a-957c-959f9e7520f3" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186338339}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "ccad926b-6344-5bec-99bc-507d50cda1e3" :question/math-academy-id "q-71956" :question/problem "Given that $f(x)={(2-5x)}^{3},$ find ${f}^{′}(x).$" :question/worked-solution "Let $g(x)=2-5x$ and $f(g(x))=g(x{)}^{3}.$ \n\nDifferentiating, we have\n\n$$\n\\begin{aligned}{f}^{′}(g(x)) & =({g}^{3}{)}^{′}=3{g}^{2}, \\\\ {g}^{′}(x) & =(2-5x{)}^{′}=-5.\\end{aligned}\n$$\n\nThen, using the chain rule, \n\n$$\n\\begin{aligned}{f}^{′}(x) & ={f}^{′}(g(x))\\cdot {g}^{′}(x) \\\\  & =3{g}^{2}\\cdot (-5) \\\\  & =-15(2-5x{)}^{2}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186339025 :knowledge-point/_questions [{:db/id #edb/ref 17592186087765 :knowledge-point/id #uuid "c514865c-02d0-5d59-938b-fdd739cdb257" :knowledge-point/title "Finding the Velocity Vector Given the Acceleration Vector"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "02b1e407-9f34-5917-a8e8-6429929466cd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "v=⟨t+4,2t+3⟩" :db/id #edb/ref 17592186336056} {:answer/id #uuid "14e6a034-a578-53fc-b1ce-917071816975" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "v=⟨3t+1,4t+2⟩" :db/id #edb/ref 17592186336230} {:answer/id #uuid "d3f11555-6307-5255-ae09-7413e8abe54d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "v=⟨4t+3,3t+1⟩" :db/id #edb/ref 17592186337885} {:answer/id #uuid "e8f4a806-a467-5bec-b324-ee521855fcf3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "v=⟨2t+4,4t+2⟩" :db/id #edb/ref 17592186338065} {:answer/id #uuid "feba51d7-bede-5389-9736-715ce5cf40e0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "v=⟨t+3,2t+1⟩" :db/id #edb/ref 17592186338269}] :answer-field/correct {:answer/id #uuid "feba51d7-bede-5389-9736-715ce5cf40e0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "v=⟨t+3,2t+1⟩" :db/id #edb/ref 17592186338269} :answer-field/id #uuid "c96e533a-33a6-500d-a486-1991eb428088" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186338638}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "80cdc2c0-175f-5f4a-ab26-00baffb7a933" :question/math-academy-id "q-7196" :question/problem "The acceleration $a$ at time $t$ of a particle $P$ moving in the $xy$-plane is given by\n\n$$\na=⟨1,2⟩.\n$$\n\nGiven that the particle has velocity $v=⟨4,3⟩$ when $t=1$, calculate the velocity vector of $P$ at time $t.$" :question/worked-solution "To compute the velocity vector, we need to integrate the acceleration vector:\n\n$$\n\\begin{aligned}v(t) & =\\int a(t)\\,\\text{d}t \\\\  & =\\int ⟨1,2⟩\\,\\text{d}t \\\\  & =⟨\\int 1\\,\\text{d}t,\\int 2\\,\\text{d}t⟩ \\\\  & =⟨t+{C}_{1},2t+{C}_{2}⟩\\end{aligned}\n$$\n\nNow, we can solve for the constants of integration using the fact that $v(1)=⟨4,3⟩.$ Substituting $t=1,$ we get\n\n$$\n\\begin{aligned}v(1) & =⟨1+{C}_{1},2(1)+{C}_{2}⟩ \\\\ ⟨4,3⟩ & =⟨1+{C}_{1},2+{C}_{2}⟩.\\end{aligned}\n$$\n\nSo, we must have\n\n$$\n\\begin{aligned}4 & =1+{C}_{1} \\\\ {C}_{1} & =3,\\end{aligned}\n$$\n\nand\n\n$$\n\\begin{aligned}3 & =2+{C}_{2} \\\\ {C}_{2} & =1.\\end{aligned}\n$$\n\nTherefore, the velocity vector is\n\n$$\nv=⟨t+3,2t+1⟩.\n$$"}] [{:db/id #edb/ref 17592186339030 :knowledge-point/_questions [{:db/id #edb/ref 17592186087703 :knowledge-point/id #uuid "4e64e0c3-f8f5-5c38-ae75-1aed92e0ac01" :knowledge-point/title "Solving for a Variable in a Singular Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3f062ffd-0731-5c9d-b5df-1e280483ad62" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "t=-\\frac{3}{4}" :db/id #edb/ref 17592186336623} {:answer/id #uuid "87e8b87b-9219-5612-bc47-0727af4eb0b5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "t=0" :db/id #edb/ref 17592186337259} {:answer/id #uuid "9d1a9b12-eb65-52f2-be17-471977096571" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "t=5" :db/id #edb/ref 17592186337454} {:answer/id #uuid "db1521d6-6365-5c27-8635-662375c34db6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "t=-5" :db/id #edb/ref 17592186337942} {:answer/id #uuid "e0112779-824d-50fa-a23d-b42b80a0e397" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "t=\\frac{3}{4}" :db/id #edb/ref 17592186337989}] :answer-field/correct {:answer/id #uuid "87e8b87b-9219-5612-bc47-0727af4eb0b5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "t=0" :db/id #edb/ref 17592186337259} :answer-field/id #uuid "82b667e3-83f0-533b-abd1-94355475f197" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186338510}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "35c7dc25-96f0-5d9f-9d6a-dfbf5fcfb320" :question/math-academy-id "q-71969" :question/problem "If $M=[\\begin{aligned}t & 4 \\\\ t & 10\\end{aligned}]$ is a singular matrix, calculate the value of $t.$" :question/worked-solution "The matrix $M$ is singular if and only if $det(M)=0.$ Calculating the determinant, we get\n\n$$\n\\begin{aligned}det(M) & =t\\cdot 10-t\\cdot 4 \\\\  & =10t-4t \\\\  & =6t\\end{aligned}\n$$\n\nNow, we set the determinant equal to $0$ and solve for $t:$\n\n$$\n\\begin{aligned}6t & =0 \\\\ t & =0\\end{aligned}\n$$\n\nTherefore, the value of $t$ is $t=0.$"}] [{:db/id #edb/ref 17592186373160 :knowledge-point/_questions [{:db/id #edb/ref 17592186087734 :knowledge-point/id #uuid "9be02ade-3dd2-5ec3-a532-78d1151dc89f" :knowledge-point/title "Writing a Complex Number Shown on an Argand Diagram in Exponential Form"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "92a3192e-9980-5b6e-995e-e901475c202b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "z=4\\sqrt{2}\\,{\\text{e}}^{5\\pi \\text{i}/4}" :db/id #edb/ref 17592186373162} {:answer/id #uuid "8e7a03da-376f-5f43-b2e3-5bb08e406633" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "z=3\\sqrt{2}\\,{\\text{e}}^{5\\pi \\text{i}/4}" :db/id #edb/ref 17592186373163} {:answer/id #uuid "aeff9ff1-81f5-544c-a33e-0126a1e4496d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "z=4\\,{\\text{e}}^{3\\pi \\text{i}/2}" :db/id #edb/ref 17592186373164} {:answer/id #uuid "a70e13e0-8903-5218-89fa-1105c69fb4f4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "z=4\\,{\\text{e}}^{3\\pi \\text{i}/4}" :db/id #edb/ref 17592186373165} {:answer/id #uuid "4b187e20-0d76-5b76-bb07-602904c533d9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "z=4\\sqrt{2}\\,{\\text{e}}^{3\\pi \\text{i}/4}" :db/id #edb/ref 17592186373166}] :answer-field/correct {:answer/id #uuid "92a3192e-9980-5b6e-995e-e901475c202b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "z=4\\sqrt{2}\\,{\\text{e}}^{5\\pi \\text{i}/4}" :db/id #edb/ref 17592186373162} :answer-field/id #uuid "22bd1b3e-2ba7-599f-8f8a-d8820b27736b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186373161}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "2261451e-0663-5bd3-96e6-ee90552101b5" :question/math-academy-id "q-71974" :question/problem "![](images/18/18f848a65a00388e813290220a6b039652728d703ae7c07d34a755fc0c82f05c.png)\n\nWrite the complex number $z$, shown on the Argand diagram above, in exponential form." :question/worked-solution "The complex number shown in the Argand diagram can be written as\n\n$$\n\\begin{aligned}z & =x+\\text{i}y \\\\  & =-4-4\\text{i}.\\end{aligned}\n$$\n\nTo write it in the form $z=r{\\text{e}}^{\\text{i}\\theta },$ where $r=|z|$ and $\\theta =\\operatorname{arg}⁡(z),$ we first calculate $r:$\n\n$$\n\\begin{aligned}r=|z| & =\\sqrt{{x}^{2}+{y}^{2}} \\\\  & =\\sqrt{(-4)^{2}+(-4)^{2}} \\\\  & =4\\sqrt{2}\\end{aligned}\n$$\n\nNow, since $z$ lies in the third quadrant, we can find the angle $\\theta $ as\n\n$$\n\\begin{aligned}\\theta =\\operatorname{arg}⁡(z) & =\\pi +|\\operatorname{arctan}⁡(\\frac{y}{x})| \\\\  & =\\pi +|\\operatorname{arctan}⁡(\\frac{-4}{-4})| \\\\  & =\\pi +|\\operatorname{arctan}⁡(1)| \\\\  & =\\pi +\\frac{\\pi }{4} \\\\  & =\\frac{5\\pi }{4}.\\end{aligned}\n$$\n\nFinally, substituting $r=4\\sqrt{2}$ and $\\theta =\\frac{5\\pi }{4}$ into $z=r{e}^{\\text{i}\\theta },$ we get \n\n$$\nz=4\\sqrt{2}\\,{\\text{e}}^{5\\pi \\text{i}/4}.\n$$"}] [{:db/id #edb/ref 17592186339036 :knowledge-point/_questions [{:db/id #edb/ref 17592186087735 :knowledge-point/id #uuid "01caf021-de3e-5e2a-89ce-ba289b65c0ff" :knowledge-point/title "Writing a Complex Number in Exponential Form"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "19ba13a7-a8af-592d-b200-b237e09d7313" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "z=3\\,{\\text{e}}^{3\\pi \\text{i}/4}" :db/id #edb/ref 17592186336269} {:answer/id #uuid "3f18755a-6590-52bf-825a-3181c701a71d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "z=2\\,{\\text{e}}^{5\\pi \\text{i}/6}" :db/id #edb/ref 17592186336625} {:answer/id #uuid "74eb7548-5b21-5ab1-b315-9aba5080f6e6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "z=4\\,{\\text{e}}^{2\\pi \\text{i}/3}" :db/id #edb/ref 17592186337086} {:answer/id #uuid "a7fb877f-dfa1-5ad1-a96d-bc31e563bd26" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "z=4\\,{\\text{e}}^{5\\pi \\text{i}/6}" :db/id #edb/ref 17592186337551} {:answer/id #uuid "ce965180-c460-5735-ba71-a16c78ddb8a2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "z=2\\,{\\text{e}}^{2\\pi \\text{i}/3}" :db/id #edb/ref 17592186337839}] :answer-field/correct {:answer/id #uuid "74eb7548-5b21-5ab1-b315-9aba5080f6e6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "z=4\\,{\\text{e}}^{2\\pi \\text{i}/3}" :db/id #edb/ref 17592186337086} :answer-field/id #uuid "2137d245-5e38-588c-bf3d-27b3cfc9ed11" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186338340}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "a3bc38ff-6706-540c-bfc8-3a2f9e0a0e13" :question/math-academy-id "q-71982" :question/problem "Write the complex number $z=-2+2\\sqrt{3}\\,\\text{i}$ in exponential form." :question/worked-solution "To write our complex number in the form $z=r{\\text{e}}^{\\text{i}\\theta },$ where $r=|z|$ and $\\theta =\\operatorname{arg}⁡(z),$ we first calculate $r:$\n\n$$\n\\begin{aligned}r=|z| & =\\sqrt{{x}^{2}+{y}^{2}} \\\\  & =\\sqrt{(-2)^{2}+{(2\\sqrt{3})}^{2}} \\\\  & =4\\end{aligned}\n$$\n\nNow, since $z$ lies in the second quadrant, we can find the angle $\\theta $ as\n\n$$\n\\begin{aligned}\\theta =\\operatorname{arg}⁡(z) & =\\pi -|\\operatorname{arctan}⁡(\\frac{y}{x})| \\\\  & =\\pi -|\\operatorname{arctan}⁡(-\\frac{2\\sqrt{3}}{2})| \\\\  & =\\pi -|\\operatorname{arctan}⁡(-\\sqrt{3})| \\\\  & =\\pi -\\frac{\\pi }{3} \\\\  & =\\frac{2\\pi }{3}.\\end{aligned}\n$$\n\nFinally, substituting $r=4$ and $\\theta =\\frac{2\\pi }{3}$ into $z=r{e}^{\\text{i}\\theta },$ we get \n\n$$\nz=4\\,{\\text{e}}^{2\\pi \\text{i}/3}.\n$$"}] [{:db/id #edb/ref 17592186339038 :knowledge-point/_questions [{:db/id #edb/ref 17592186087846 :knowledge-point/id #uuid "37a4168b-1425-5f3a-a577-4b5884906a52" :knowledge-point/title "Calculating the Sum of a Complex Number and Its Conjugate"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "131e439a-9165-56c6-8fdd-b21c8dea91e1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8+14\\text{i}" :db/id #edb/ref 17592186336212} {:answer/id #uuid "1b6aa3b5-1f23-581f-bd0e-52f0682b50a0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186336285} {:answer/id #uuid "1e6f5eb4-3b18-507b-9c32-4ce046ab8046" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "13" :db/id #edb/ref 17592186336313} {:answer/id #uuid "d95dea67-8da9-5f2b-8c58-9a5fb247332b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "14\\text{i}" :db/id #edb/ref 17592186337923} {:answer/id #uuid "f90cfae7-9eea-5dc8-8b18-628804095bea" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186338215}] :answer-field/correct {:answer/id #uuid "1b6aa3b5-1f23-581f-bd0e-52f0682b50a0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186336285} :answer-field/id #uuid "bd3178b7-71a4-5c4f-9b23-601af5c49da4" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186338617}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "568e1d1c-4c3e-536f-acb0-c6800da06527" :question/math-academy-id "q-71986" :question/problem "If $z=4+7\\text{i}$, calculate $z+\\overset{―}{z}.$" :question/worked-solution "**Method 1**\n\nWhen we add a complex number and its conjugate, the result is always twice the real part of the complex number.\n\nFor the given complex number $z=4+7\\text{i},$ the real part is $Re(z)=4,$ so we have\n\n$$\n\\begin{aligned}z+\\overset{―}{z} & =2\\text{Re}(z) \\\\  & =2(4) \\\\  & =8.\\end{aligned}\n$$\n\n**Method 2**\n\nAlternatively, we can actually carry out the process of adding the complex number and its conjugate.\n\nTo obtain the conjugate of the complex number $z=4+7\\text{i},$ we flip the sign of the imaginary part and get $\\overset{―}{z}=4-7\\text{i}.$\n\nAdding, we get\n\n$$\n\\begin{aligned}z+\\overset{―}{z} & =(4+7\\text{i})+(4-7\\text{i}) \\\\  & =(4+4)+\\text{i}(7-7) \\\\  & =8+\\text{i}0 \\\\  & =8.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186064947 :knowledge-point/_questions [{:db/id #edb/ref 17592186064272 :knowledge-point/id #uuid "fa38f112-466c-50e9-ac08-be72b6f53782" :knowledge-point/title "Relating a Derivative to a Rate of Change"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "148eb00f-3a9c-5cde-b11e-4aa6e5df5baf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "N(t)=r(t)" :db/id #edb/ref 17592186336227} {:answer/id #uuid "3ce9ccdf-1421-5fcb-b41e-795e91107452" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "N(t)={r}^{′}(t)" :db/id #edb/ref 17592186336606} {:answer/id #uuid "3d4ac506-d0f2-599b-b8f3-e6dce6983161" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{N}^{′}(t)=r(t)" :db/id #edb/ref 17592186336611} {:answer/id #uuid "80a522d2-bd93-5515-9735-bcaf1eb17692" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "N(t)=-{r}^{′}(t)" :db/id #edb/ref 17592186337197} {:answer/id #uuid "e3743113-4ad5-561d-af41-cbb9230afbba" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{N}^{′}(t)=-r(t)" :db/id #edb/ref 17592186338017}] :answer-field/correct {:answer/id #uuid "3d4ac506-d0f2-599b-b8f3-e6dce6983161" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{N}^{′}(t)=r(t)" :db/id #edb/ref 17592186336611} :answer-field/id #uuid "874c5434-9157-538e-be59-176244d35d61" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186338525}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "97f8f938-0d50-59f5-922b-f7bea8bb44f7" :question/math-academy-id "q-72004" :question/problem "Jason, a biologist, is measuring the growth of bacteria in a Petri dish by recording the following two numbers for different values of $t,$ where $t$ is the time, in hours, since he started his observations:\n\n- $N(t)$ - the number of bacteria in the dish.\n\n- $r(t)$ - the rate at which the number of bacteria in the dish is increasing.\n\nWhat is the relationship between $N(t)$ and $r(t)?$" :question/worked-solution "The function $N(t)$ gives the number of bacteria inside the dish after $t$ hours. Then,\n\n$$\n{N}^{′}(t)=\\frac{\\text{d}N(t)}{\\text{d}t}=\\frac{\\text{Change in }N}{\\text{Change in }t}.\n$$\n\nThus, ${N}^{′}(t)$ gives the rate at which the number of bacteria is increasing at time $t$, which is the same as $r(t).$ Therefore, the relationship between $N(t)$ and $r(t)$ is ${N}^{′}(t)=r(t).$"}] [{:db/id #edb/ref 17592186382214 :knowledge-point/_questions [{:db/id #edb/ref 17592186124466 :knowledge-point/id #uuid "9d090462-a031-5f96-ac13-90dac882edab" :knowledge-point/title "Identifying Points Where Partial Derivatives Exist"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1e570ff9-ba40-51a6-b10f-3e8b4b8a1efc" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186382216} {:answer/id #uuid "96ff9ddf-e7f3-5cb7-a289-9f327d912d8a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186382217} {:answer/id #uuid "5e4439ab-e45c-5c5c-a37e-64c3b1f4c2d2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186382218} {:answer/id #uuid "4eab8f87-78e7-5b92-8311-4b200cac830b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186382219} {:answer/id #uuid "b8ea48c5-1f06-568b-b1c8-d61be82ec911" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186382220}] :answer-field/correct {:answer/id #uuid "4eab8f87-78e7-5b92-8311-4b200cac830b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186382219} :answer-field/id #uuid "8c517d13-4ce6-527a-b3ce-ca2edcfc9904" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186382215}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "fa8a43bb-df08-5eee-88ea-f9abcdd2fb8a" :question/math-academy-id "q-72011" :question/problem "Which of the following statements are true about the function $f(x,y)={e}^{\\sqrt{x-y}}?$\n\n- ${f}_{y}(1,-1)$ is defined\n- Both partial derivatives exist at the point $(1,0)$\n- ${f}_{x}(1,1)$ is defined" :question/worked-solution "First, we compute the partial derivatives of $f(x,y):$  \n\n$$\n\\begin{aligned}\\frac{∂f}{∂x} & ={e}^{\\sqrt{x-y}}\\cdot \\frac{1}{2\\sqrt{x-y}} \\\\  & =\\frac{{e}^{\\sqrt{x-y}}}{2\\sqrt{x-y}} \\\\ \\frac{∂f}{∂y} & ={e}^{\\sqrt{x-y}}\\cdot \\frac{-1}{2\\sqrt{x-y}} \\\\  & =-\\frac{{e}^{\\sqrt{x-y}}}{2\\sqrt{x-y}}\\end{aligned}\n$$\n\nNow, let's examine the statements one-by-one. \n\n- Statement I is true. Indeed, the function $f$ is defined at $(1,-1)$, where we have \n\n$$\nf(1,-1)={e}^{\\sqrt{1-(-1)}}={e}^{\\sqrt{2}},\n$$\n\nand ${f}_{y}$ is also defined at $(1,-1):$\n\n$$\n\\begin{aligned}{f}_{y}(1,-1)=-\\frac{{e}^{\\sqrt{1-(-1)}}}{2\\sqrt{1-(-1)}}=-\\frac{{e}^{\\sqrt{2}}}{2\\sqrt{2}}\\end{aligned}\n$$\n\n- Statement II is true. Indeed, the function $f$ is defined at $(1,0)$, where we have \n\n$$\nf(1,0)={e}^{\\sqrt{1-0}}={e}^{1}=e,\n$$\n\nand both partial derivatives are also defined at $(1,0):$\n\n$$\n\\begin{aligned}{f}_{x}(1,0) & =\\frac{{e}^{\\sqrt{1-0}}}{2\\sqrt{1-0}}=\\frac{{e}^{1}}{2\\sqrt{1}}=\\frac{e}{2} \\\\ {f}_{y}(1,0) & =-\\frac{{e}^{\\sqrt{1-0}}}{2\\sqrt{1-0}}=-\\frac{{e}^{1}}{2\\sqrt{1}}=-\\frac{e}{2}\\end{aligned}\n$$\n\n- Statement III is false. If we substitute $(1,1)$ into ${f}_{x}$, we get\n\n$$\n{f}_{x}(1,1)=\\frac{{e}^{\\sqrt{1-1}}}{2\\sqrt{1-1}}=\\frac{{e}^{0}}{2\\sqrt{0}}=\\frac{1}{0}\n$$\n\nwhich is undefined since we have division by zero.\n\nTherefore, the correct answer is 'I and II  only'."}] [{:db/id #edb/ref 17592186382228 :knowledge-point/_questions [{:db/id #edb/ref 17592186129164 :knowledge-point/id #uuid "16601513-9b74-5cec-9af6-2d99b98e1ab3" :knowledge-point/title "Evaluating a Repeated Integral"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "cddc54b8-42c6-59ad-be4f-27deac556567" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "20" :db/id #edb/ref 17592186382230} {:answer/id #uuid "adc21c33-8e05-5403-9aab-71bdea44327d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{14}{3}" :db/id #edb/ref 17592186382231} {:answer/id #uuid "d63fd35c-57ed-55b1-aad6-9e0de6bfe01e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{12}{5}" :db/id #edb/ref 17592186382232} {:answer/id #uuid "89988190-8431-560d-98b5-49aa050411e7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "18" :db/id #edb/ref 17592186382233} {:answer/id #uuid "7cfc4568-11c3-5b4e-b87e-b3902cd5e5d2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{15}{4}" :db/id #edb/ref 17592186382234}] :answer-field/correct {:answer/id #uuid "cddc54b8-42c6-59ad-be4f-27deac556567" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "20" :db/id #edb/ref 17592186382230} :answer-field/id #uuid "7557a25a-ccc4-50c5-9e2e-316621389487" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186382229}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "f97540c3-b516-5fa0-be68-d3eff2953e83" :question/math-academy-id "q-72050" :question/problem "${\\int }_{0}^{1}{\\int }_{2}^{4}{x}^{3}{y}^{2}\\,\\text{d}x\\,\\text{d}y=$" :question/worked-solution "First, we evaluate the inner integral by integrating with respect to $x$, treating $y$ as a constant:    \n\n$$\n\\begin{aligned}{\\int }_{0}^{1}[{\\int }_{2}^{4}{x}^{3}{y}^{2}\\,\\text{d}x]\\text{d}y & ={\\int }_{0}^{1}{y}^{2}[{\\int }_{2}^{4}{x}^{3}\\,\\text{d}x]\\text{d}y \\\\  & ={\\int }_{0}^{1}{y}^{2}{[\\frac{\\,{x}^{4}}{4}]}_{2}^{4}\\,\\text{d}y \\\\  & ={\\int }_{0}^{1}{y}^{2}(\\frac{256}{4}-\\frac{16}{4})\\text{d}y \\\\  & ={\\int }_{0}^{1}60{y}^{2}\\,\\text{d}y\\end{aligned}\n$$\n\nThen, we integrate with respect to $y:$\n\n$$\n\\begin{aligned}{\\int }_{0}^{1}60{y}^{2}\\,\\text{d}y & =60{[\\frac{{y}^{3}}{3}]}_{0}^{1} \\\\  & =60\\cdot \\frac{1}{3} \\\\  & =20\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186339051 :knowledge-point/_questions [{:db/id #edb/ref 17592186129168 :knowledge-point/id #uuid "85335de6-e1dc-5a2f-b30a-806627759030" :knowledge-point/title "Identifying Type II Regions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "304d5c58-6d45-56a3-99aa-d17f8b68ab8b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "None of the listed" :db/id #edb/ref 17592186336495} {:answer/id #uuid "5441b55a-4a1a-594f-9724-97328f24db28" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/11/11311a36be324ae3a62fa1333203f722364ba99c6b0aefbff5672cf18df1e8f7.png" :db/id #edb/ref 17592186336811} {:answer/id #uuid "63378892-552b-57c0-a27d-54ec70f96e47" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/72/7231c566a92c547b6fa950052ddfbe90cf08faf794937295226c468764701a3d.png" :db/id #edb/ref 17592186336925} {:answer/id #uuid "c790838e-f2a9-5918-bdd1-8e5421ebd3d0" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/d2/d25e6ae97e93e13491cac3937cae0928694f843479de353be8e5874fb0e726f1.png" :db/id #edb/ref 17592186337803} {:answer/id #uuid "f926c30c-f403-58a7-a6b8-aec9711a7738" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/cc/ccc416dcf8464cc7fb7e6ea5aad60803a4c1bb273fe6f1069bfbb3e2fe124b64.png" :db/id #edb/ref 17592186338216}] :answer-field/correct {:answer/id #uuid "63378892-552b-57c0-a27d-54ec70f96e47" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/72/7231c566a92c547b6fa950052ddfbe90cf08faf794937295226c468764701a3d.png" :db/id #edb/ref 17592186336925} :answer-field/id #uuid "2b60ff15-436e-5d40-8454-d27cd64273f2" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186338356}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "9bfc53ce-85fd-5d88-8915-7ff8d8881ed6" :question/math-academy-id "q-72055" :question/problem "Which of the following is a type II region in two-dimensional space?" :question/worked-solution "A type II region can be written as\n\n$$\nD={(x,y)\\,:\\,a\\le y\\le b,\\,g(y)\\le x\\le f(y)},\n$$\n\nwhere $f$ and $g$ are continuous functions.\n\nA type II region has the property that a horizontal line drawn through the region intersects the region in a single interval only.\n\nAmong the given options, the only type II region is the following.\n\n![](images/fe/fe16f5f3d1e9663a7e0df88d71639016bfb3357a6745ee6f125968978fd54c12.png)"}] [{:db/id #edb/ref 17592186339052 :knowledge-point/_questions [{:db/id #edb/ref 17592186105715 :knowledge-point/id #uuid "cf98ee24-7774-5674-8a1e-63f4f6d225c0" :knowledge-point/title "Integrating a Reciprocal Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1f88c79e-e25c-5fcd-a473-3f9adb3d4e9e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{\\sqrt{7}}{7}ln⁡|x|+C" :db/id #edb/ref 17592186336327} {:answer/id #uuid "58b493c2-73d3-5db1-af15-0200a2937632" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{\\sqrt{7}}{ln⁡|x|}+C" :db/id #edb/ref 17592186336844} {:answer/id #uuid "daf20704-2d65-5753-af90-f6e026c52e12" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{7}ln⁡|x|+C" :db/id #edb/ref 17592186337940} {:answer/id #uuid "ec4261ce-b5b3-5551-9fbd-56937e1eea24" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{7}{\\sqrt{7}}ln⁡|x|+C" :db/id #edb/ref 17592186338091} {:answer/id #uuid "f7a97ce9-ff10-5758-b496-1ffe87d0bb3c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-ln⁡|\\sqrt{7}x|+C" :db/id #edb/ref 17592186338202}] :answer-field/correct {:answer/id #uuid "1f88c79e-e25c-5fcd-a473-3f9adb3d4e9e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{\\sqrt{7}}{7}ln⁡|x|+C" :db/id #edb/ref 17592186336327} :answer-field/id #uuid "f930863c-55bb-55cc-bd9d-51b8ae4abea3" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186338715}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "d9daecf1-e255-5c0c-a433-fdc798f551aa" :question/math-academy-id "q-72059" :question/problem "Calculate $\\int -\\frac{1}{\\sqrt{7}x}\\,\\text{d}x.$" :question/worked-solution "First, we apply the constant factor rule and take the coefficient $-\\frac{1}{\\sqrt{7}}=-\\frac{1}{\\sqrt{7}}\\frac{\\sqrt{7}}{\\sqrt{7}}=-\\frac{\\sqrt{7}}{7}$ out of the integral. Then we compute the integral of $\\frac{1}{x},$ and get\n\n$$\n\\begin{aligned}\\int -\\frac{1}{\\sqrt{7}x}\\,\\text{d}x & =-\\frac{1}{\\sqrt{7}}\\int \\frac{1}{x}\\,\\,\\text{d}x \\\\  & =-\\frac{\\sqrt{7}}{7}ln⁡|x|+C.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186339055 :knowledge-point/_questions [{:db/id #edb/ref 17592186092242 :knowledge-point/id #uuid "6b175cb1-6615-540f-9145-224a838e37d0" :knowledge-point/title "Estimating a Derivative Given a Graph Using a Backward Difference Approximation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3fe41587-c3f7-5479-b239-47cfa8fef036" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186336633} {:answer/id #uuid "5d43e33c-77e5-5307-a409-7bca8540a7e5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186336877} {:answer/id #uuid "809e0d21-914e-52aa-99d0-f75bf9d82085" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{2}" :db/id #edb/ref 17592186337196} {:answer/id #uuid "b32bc383-231f-5724-a292-f0e334d095ab" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186337630} {:answer/id #uuid "cc219e1b-1b2d-5eef-92e1-8216c629b871" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186337823}] :answer-field/correct {:answer/id #uuid "5d43e33c-77e5-5307-a409-7bca8540a7e5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186336877} :answer-field/id #uuid "9d180c05-ad48-5e0d-92e1-00bb1d157e3b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186338566}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "c7480396-2066-56b4-9d58-774c761ad733" :question/math-academy-id "q-72074" :question/problem "![](images/89/894d659f3ef4544eeda653f5e098d9ca26f3e06899798441534a1bf395628d0e.png)\n\nThe graph of the function $f(x)$ is shown above. \nApproximate ${f}^{′}(x)$ at the point $x=3$ using a backward difference approximation with step size $h=2.$" :question/worked-solution "We use the backward difference approximation formula\n\n$$\n{f}^{′}(x)≈\\frac{f(x)-f(x-h)}{h},\n$$\n\n \nat the point $x=3.$ Applying the above formula with $x=3$ and $h=2$ gives \n\n$$\n\\begin{aligned}{f}^{′}(3) & ≈\\frac{f(3)-f(3-2)}{2} \\\\  & =\\frac{f(3)-f(1)}{2} \\\\  & =\\frac{0-(-1)}{2} \\\\  & =\\frac{1}{2}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186129850 :knowledge-point/_questions [{:db/id #edb/ref 17592186129173 :knowledge-point/id #uuid "8537cc22-8d18-57c8-9ebf-921bd4d06ae7" :knowledge-point/title "Computing a Double Summation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0ee3daa0-63ea-57fd-8203-29e8ffd77480" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186336174} {:answer/id #uuid "12b2522f-4758-5d90-8080-b542234b7547" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "16" :db/id #edb/ref 17592186336210} {:answer/id #uuid "39fbd0e6-1e9a-5d05-a795-60d8cfddca47" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "18" :db/id #edb/ref 17592186336577} {:answer/id #uuid "d237224f-7536-5f2e-8a8f-f0e65701610b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "22" :db/id #edb/ref 17592186337874} {:answer/id #uuid "f10ed6bc-4030-5ec3-a3e8-ed644aee61ba" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "12" :db/id #edb/ref 17592186338143}] :answer-field/correct {:answer/id #uuid "39fbd0e6-1e9a-5d05-a795-60d8cfddca47" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "18" :db/id #edb/ref 17592186336577} :answer-field/id #uuid "58439c8e-2c44-5252-9a32-9e790d2edd09" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186338427}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "6e16a192-c647-58f3-9bd2-bc5597aebc2c" :question/math-academy-id "q-72094" :question/problem "${\\sum }_{j=1}^{2}{\\sum }_{i=1}^{3}ij=$" :question/worked-solution "First, we write out the inner summation by summing over the index $i:$\n\n$$\n\\begin{aligned}{\\sum }_{j=1}^{2}{\\sum }_{i=1}^{3}ij & ={\\sum }_{j=1}^{2}[{\\sum }_{i=1}^{3}ij] \\\\  & ={\\sum }_{j=1}^{2}(1j+2j+3j) \\\\  & ={\\sum }_{j=1}^{2}(j+2j+3j) \\\\  & ={\\sum }_{j=1}^{2}6j\\end{aligned}\n$$\n\nNext, we sum over the index $j:$\n\n$$\n\\begin{aligned}{\\sum }_{j=1}^{2}6j & =6\\cdot 1+6\\cdot 2 \\\\  & =6+12 \\\\  & =18\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186339059 :knowledge-point/_questions [{:db/id #edb/ref 17592186064152 :knowledge-point/id #uuid "159b4d58-b34d-52cd-aad2-2c058f772ad2" :knowledge-point/title "Interpreting the Derivative of a Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "08f73173-53b3-594c-9f00-73f6211f3aba" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The rate at which the perimeter changes as each side changes" :db/id #edb/ref 17592186336106} {:answer/id #uuid "2f86ab33-c24f-513c-9f78-18726fd0321b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The rate at which the area changes as each side changes" :db/id #edb/ref 17592186336488} {:answer/id #uuid "8526b1a3-6e9c-580f-9c0b-82c5736c43b1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The rate at which each side changes as the perimeter changes" :db/id #edb/ref 17592186337231} {:answer/id #uuid "95ba1001-8463-59e2-bed5-38495c9afaab" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The rate at which the perimeter changes as the area changes" :db/id #edb/ref 17592186337400} {:answer/id #uuid "eddb83ed-12b2-59b9-8dd1-0e4ed245941a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The rate at which each side changes as the area changes" :db/id #edb/ref 17592186338109}] :answer-field/correct {:answer/id #uuid "08f73173-53b3-594c-9f00-73f6211f3aba" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The rate at which the perimeter changes as each side changes" :db/id #edb/ref 17592186336106} :answer-field/id #uuid "aa385052-bba0-5f25-abff-7baf2aaa746f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186338590}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "c47d8541-4bf8-5eff-901b-cba03fe2cd37" :question/math-academy-id "q-72104" :question/problem "Consider a regular pentagon such that the length $s$ of each side varies. What is the best interpretation of ${P}^{′}(s)$ if $P$ is the perimeter of the pentagon?" :question/worked-solution "The function $P(s)$ gives the perimeter of a pentagon with side $s.$ So,\n\n$$\n{P}^{′}(s)=\\frac{\\text{d}P}{\\text{d}s}=\\frac{\\text{Change in }P}{\\text{Change in }s}.\n$$\n\nTherefore, ${P}^{′}(s)$ is the rate at which the perimeter changes as each side changes."}] [{:db/id #edb/ref 17592186339060 :knowledge-point/_questions [{:db/id #edb/ref 17592186064272 :knowledge-point/id #uuid "fa38f112-466c-50e9-ac08-be72b6f53782" :knowledge-point/title "Relating a Derivative to a Rate of Change"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1bd3314e-09b5-5ed6-b34d-9c8eb2cd078f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{A}^{′}(t)=r(t)" :db/id #edb/ref 17592186336291} {:answer/id #uuid "5f89b95a-dc2f-5355-a891-5f7ad0897f2f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "A(t)=-{r}^{′}(t)" :db/id #edb/ref 17592186336898} {:answer/id #uuid "d84adbce-e1e5-541f-ae42-248e49f85aef" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{A}^{′}(t)=-r(t)" :db/id #edb/ref 17592186337909} {:answer/id #uuid "eb90804a-9cb1-5c0e-93ff-93893405ab87" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "A(t)={r}^{′}(t)" :db/id #edb/ref 17592186338088} {:answer/id #uuid "f843d514-c114-567f-8b4e-d0d7f91897e0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "A(t)=r(t)" :db/id #edb/ref 17592186338207}] :answer-field/correct {:answer/id #uuid "1bd3314e-09b5-5ed6-b34d-9c8eb2cd078f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{A}^{′}(t)=r(t)" :db/id #edb/ref 17592186336291} :answer-field/id #uuid "27c52aef-834f-5c1c-9709-b11a313c17d7" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186338353}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "4da77317-b047-59f4-8384-7a00ca57d0df" :question/math-academy-id "q-72105" :question/problem "Douglas, a pilot, is flying a plane. The plane's control systems record two measurements for different values of $t,$ where $t$ is the time, in minutes, since take off. The two measurements are:\n\n- $A(t)$ - the altitude (height) of the plane\n\n- $r(t)$ the rate at which the altitude is increasing\n\nWhat is the relationship between $A(t)$ and $r(t)?$" :question/worked-solution "The function $A(t)$ gives the altitude of the plane after $t$ hours. Then,\n\n$$\n{A}^{′}(t)=\\frac{\\text{d}A(t)}{\\text{d}t}=\\frac{\\text{Change in }A}{\\text{Change in }t}.\n$$\n\nThus, ${A}^{′}(t)$ gives the rate at which the altitude is increasing at time $t$, which is the same as $r(t).$ Therefore, the relationship between $A(t)$ and $r(t)$ is ${A}^{′}(t)=r(t).$"}] [{:db/id #edb/ref 17592186375307 :knowledge-point/_questions [{:db/id #edb/ref 17592186129167 :knowledge-point/id #uuid "64d342be-ebaf-5e94-b641-ea8ce6f14c12" :knowledge-point/title "Identifying Type I Regions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9db76155-8671-5467-8f85-0d2112f29767" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{(x,y)\\,:\\,0\\le x\\le 2,\\,0\\le y\\le 3-(x-1)^{2}}" :db/id #edb/ref 17592186375309} {:answer/id #uuid "157b2c25-5099-5a77-a1cb-81b2c8477282" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{(x,y)\\,:\\,1\\le x\\le 2,\\,0\\le y\\le 3-(x-1)^{2}}" :db/id #edb/ref 17592186375310} {:answer/id #uuid "4ed955ce-ddd7-5600-92b9-fa5809520e43" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{(x,y)\\,:\\,1\\le x\\le \\sqrt{3-y}+1,\\,2\\le y\\le 3}" :db/id #edb/ref 17592186375311} {:answer/id #uuid "a5af797e-ba24-5523-92e5-1255fde9881a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{(x,y)\\,:\\,1\\le x\\le 2,\\,0\\le y\\le (x-1)^{2}+3}" :db/id #edb/ref 17592186375312} {:answer/id #uuid "46705277-fd7c-564a-b8ea-f2c9d078002b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{(x,y)\\,:\\,1\\le x\\le \\sqrt{3-y}+1,\\,0\\le y\\le 3}" :db/id #edb/ref 17592186375313}] :answer-field/correct {:answer/id #uuid "157b2c25-5099-5a77-a1cb-81b2c8477282" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{(x,y)\\,:\\,1\\le x\\le 2,\\,0\\le y\\le 3-(x-1)^{2}}" :db/id #edb/ref 17592186375310} :answer-field/id #uuid "e789573f-de55-535f-afca-3eee3bb4aa74" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186375308}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "76027899-49f4-5ed4-93bc-de501abde637" :question/math-academy-id "q-72124" :question/problem "![](images/d1/d1c2f0e830c6d3beca27886e839816f46a00be322c9d7cff18248d118ed0e617.png)\n\nWhich of the following represents the shaded region above as a type I region in two-dimensional space?" :question/worked-solution "A type I region can be written as\n\n$$\nD={(x,y)\\,:\\,a\\le x\\le b,\\,g(x)\\le y\\le f(x)},\n$$\n\nwhere $f$ and $g$ are continuous functions.\n\nTo express the given region as a type I region, we first rewrite all of the given curves as functions of $x:$\n\n$$\nx=\\sqrt{3-y}+1\\,⟹\\,y=3-(x-1)^{2}\n$$\n\nThe function $y=0$ is already written as a function of $x.$\n\nNotice that the region lies between the vertical lines $x=1$ and $x=2.$ So, we have $0\\le x\\le 1.$\n\nWe draw a vertical arrow through the region to determine the lower function $g(x)$ and the upper function $f(x).$ A vertical line should intersect the region in a single interval only for it to be a type I region.\n\n![](images/be/be799df2140d3a437bb311427dcae0e297cb6bd3844f88932157eb6ace6e7e59.png)\n\nThe vertical line enters the region through the lower function $y=0$ and leaves through the upper function $y=3-(x-1)^{2}.$ So, we have $0\\le y\\le 3-(x-1)^{2}.$\n\nTherefore, we obtain\n\n$$\nD={(x,y)\\,:\\,1\\le x\\le 2,\\,0\\le y\\le 3-(x-1)^{2}}.\n$$"}] [{:db/id #edb/ref 17592186339064 :knowledge-point/_questions [{:db/id #edb/ref 17592186064283 :knowledge-point/id #uuid "3ec11481-cea2-514b-aa78-707fcf8838cc" :knowledge-point/title "Differentiating a Power of a Trigonometric Function Using the Chain Rule"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b52aa7c5-0426-5772-8576-0d06507ee246" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-28\\operatorname{cos}⁡x{sin}^{6}⁡x" :db/id #edb/ref 17592186337642} {:answer/id #uuid "bca0ac11-5889-590d-b18f-dc821e5d6c5b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-28{cos}^{6}⁡x\\operatorname{sin}⁡x" :db/id #edb/ref 17592186337708} {:answer/id #uuid "ec2962a1-647e-5d8b-9492-8e3b141a6e17" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-28{sin}^{6}⁡x" :db/id #edb/ref 17592186338090} {:answer/id #uuid "f9f6bad8-7c0c-55c3-aec1-1f849a332783" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4\\operatorname{cos}⁡x{sin}^{6}⁡x" :db/id #edb/ref 17592186338224} {:answer/id #uuid "ff8e2ee2-8bc8-5f48-a816-f19ea88144d4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4{cos}^{6}⁡x" :db/id #edb/ref 17592186338274}] :answer-field/correct {:answer/id #uuid "bca0ac11-5889-590d-b18f-dc821e5d6c5b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-28{cos}^{6}⁡x\\operatorname{sin}⁡x" :db/id #edb/ref 17592186337708} :answer-field/id #uuid "05250791-7660-5c5c-b045-5bac1563c939" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186338283}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "6e3f0d37-02ff-5992-af83-461909d51264" :question/math-academy-id "q-72157" :question/problem "Find ${f}^{′}(x)$ when $f(x)=4{cos}^{7}⁡(x).$" :question/worked-solution "First, we express\n\n$$\nf(x)=4(\\operatorname{cos}⁡x)^{7}.\n$$\n\nNow, we see that $f(x)$ can be expressed as the composite function\n\n$$\nf=4{u}^{7},\\,u=\\operatorname{cos}⁡x.\n$$\n\nDifferentiating, we get\n\n$$\n\\frac{\\text{d}f}{\\text{d}u}=28{u}^{6},\\,\\frac{\\text{d}u}{\\text{d}x}=-\\operatorname{sin}⁡x.\n$$\n\nWe now apply the chain rule, and get\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{\\text{d}f}{\\text{d}u}\\cdot \\frac{\\text{d}u}{\\text{d}x} \\\\  & =28{u}^{6}\\cdot (-\\operatorname{sin}⁡x) \\\\  & =28(\\operatorname{cos}⁡x)^{6}(-\\operatorname{sin}⁡x) \\\\  & =-28{cos}^{6}⁡x\\operatorname{sin}⁡x.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186403537 :knowledge-point/_questions [{:db/id #edb/ref 17592186078483 :knowledge-point/id #uuid "47989094-35d2-561f-add4-f1d427cd8a20" :knowledge-point/title "Finding a Position Vector Given a Velocity Vector"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "783ded5c-224b-59ae-b32b-ec19000aa60d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "r=⟨{t}^{3}-{t}^{2}+2,\\,2{t}^{4}-42⟩" :db/id #edb/ref 17592186403539} {:answer/id #uuid "06d02cfb-4919-5c32-955c-bd2e1e9b658c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "r=⟨{t}^{3}-2{t}^{2}+2,\\,{t}^{4}-24⟩" :db/id #edb/ref 17592186403540} {:answer/id #uuid "ad5eefc7-8bc8-5e3a-b849-484cdc6a8daa" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "r=⟨{t}^{3}-{t}^{2}+2,\\,2{t}^{4}-24⟩" :db/id #edb/ref 17592186403541} {:answer/id #uuid "f970c01f-ad2a-5aad-bf67-ace81ba81fd2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "r=⟨{t}^{3}-{t}^{2},\\,2{t}^{4}-42⟩" :db/id #edb/ref 17592186403542} {:answer/id #uuid "dd440fad-abbb-55d5-b8ef-41b50f1b49d1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "r=⟨{t}^{3}-{t}^{2}+12,\\,2{t}^{4}-72⟩" :db/id #edb/ref 17592186403543}] :answer-field/correct {:answer/id #uuid "dd440fad-abbb-55d5-b8ef-41b50f1b49d1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "r=⟨{t}^{3}-{t}^{2}+12,\\,2{t}^{4}-72⟩" :db/id #edb/ref 17592186403543} :answer-field/id #uuid "a072aa51-1711-5bcb-b3f7-621b3a6f46ec" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186403538}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "4e1070d0-6a3b-5c88-bdfe-23bfbc7b2d02" :question/math-academy-id "q-7217" :question/problem "The velocity $v$ at time $t$ of a particle $P$ moving in the $xy$-plane is given by\n\n$$\nv=⟨t(3t-2),\\,8{t}^{3}⟩.\n$$\n\nGiven that the particle is at the position $(30,90)$ when $t=3,$ calculate the position vector of $P$ at time $t.$" :question/worked-solution "To compute the position vector, we need to integrate the velocity vector:\n\n$$\n\\begin{aligned}r(t) & =\\int v(t)\\,\\text{d}t \\\\  & =\\int ⟨t(3t-2),\\,8{t}^{3}⟩\\,\\text{d}t \\\\  & =⟨\\int t(3t-2)\\,\\text{d}t,\\,\\int 8{t}^{3}\\,\\text{d}t⟩ \\\\  & =⟨{t}^{3}-{t}^{2}+{C}_{1},\\,2{t}^{4}+{C}_{2}⟩\\end{aligned}\n$$\n\nNow, we can solve for the constants of integration using the fact that $r(3)=⟨30,90⟩.$ Substituting $t=3,$ we get\n\n$$\n\\begin{aligned}r(3) & =⟨(3)^{3}-(3)^{2}+{C}_{1},\\,2(3)^{4}+{C}_{2}⟩ \\\\ ⟨30,90⟩ & =⟨18+{C}_{1},162+{C}_{2}⟩,\\end{aligned}\n$$\n\nso we must have ${C}_{1}=12$ and ${C}_{2}=-72.$ Therefore, the position vector is\n\n$$\nr(t)=⟨{t}^{3}-{t}^{2}+12,\\,2{t}^{4}-72⟩.\n$$"}] [{:db/id #edb/ref 17592186339066 :knowledge-point/_questions [{:db/id #edb/ref 17592186064284 :knowledge-point/id #uuid "a483e892-90f2-51f4-80cd-2b1200cd0c37" :knowledge-point/title "Differentiating a Composition of Trigonometric Functions Using the Chain Rule"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "35d0b5a0-960c-537b-b36b-f81b09719172" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3\\operatorname{sec}⁡x\\operatorname{tan}⁡(-\\operatorname{sin}⁡x)" :db/id #edb/ref 17592186336532} {:answer/id #uuid "8659cf38-7f28-521b-9eb6-a1f4bb5d55a9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3\\operatorname{sin}⁡x\\operatorname{sec}⁡(-\\operatorname{sin}⁡x)\\operatorname{tan}⁡(-\\operatorname{sin}⁡x)" :db/id #edb/ref 17592186337248} {:answer/id #uuid "cf2b4496-4d43-50c5-b8f4-50cbe3748941" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3\\operatorname{cos}⁡x\\operatorname{sec}⁡(\\operatorname{cos}⁡x)\\operatorname{tan}⁡(\\operatorname{cos}⁡x)" :db/id #edb/ref 17592186337845} {:answer/id #uuid "e5a21dd0-44ef-54d6-bc1c-1c98a20cbcd7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3\\operatorname{sin}⁡x\\operatorname{sec}⁡x\\operatorname{tan}⁡(\\operatorname{cos}⁡x)" :db/id #edb/ref 17592186338037} {:answer/id #uuid "f7b439b8-4fb4-5bd2-b82d-c5283f54f75b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3\\operatorname{sin}⁡x\\operatorname{sec}⁡(\\operatorname{cos}⁡x)\\operatorname{tan}⁡(\\operatorname{cos}⁡x)" :db/id #edb/ref 17592186338204}] :answer-field/correct {:answer/id #uuid "f7b439b8-4fb4-5bd2-b82d-c5283f54f75b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3\\operatorname{sin}⁡x\\operatorname{sec}⁡(\\operatorname{cos}⁡x)\\operatorname{tan}⁡(\\operatorname{cos}⁡x)" :db/id #edb/ref 17592186338204} :answer-field/id #uuid "76164faf-c99c-514d-8f55-17d4f55b16c4" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186338480}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "bdadc1fd-0dca-59ce-bd49-88a477cdb0a0" :question/math-academy-id "q-72173" :question/problem "Find the derivative of $y=3\\operatorname{sec}⁡(\\operatorname{cos}⁡x).$" :question/worked-solution "First, we express $y$ as the composite function\n\n$$\ny=3\\operatorname{sec}⁡u,\\,u=\\operatorname{cos}⁡x.\n$$\n\nDifferentiating gives\n\n$$\n\\frac{\\text{d}y}{\\text{d}u}=3\\operatorname{sec}⁡u\\operatorname{tan}⁡u,\\,\\frac{\\text{d}u}{\\text{d}x}=-\\operatorname{sin}⁡x.\n$$\n\nWe now apply the chain rule, and get\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}y}{\\text{d}u}\\cdot \\frac{\\text{d}u}{\\text{d}x} \\\\  & =3\\operatorname{sec}⁡u\\operatorname{tan}⁡u\\cdot (-\\operatorname{sin}⁡x) \\\\  & =-3\\operatorname{sin}⁡x\\operatorname{sec}⁡(\\operatorname{cos}⁡x)\\operatorname{tan}⁡(\\operatorname{cos}⁡x).\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186079196 :knowledge-point/_questions [{:db/id #edb/ref 17592186078504 :knowledge-point/id #uuid "279c5e4e-db19-584b-becb-10864fcba188" :knowledge-point/title "Finding a Position Vector Given an Acceleration Vector"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "cab57635-f418-5983-befd-a20ffd9eccbf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "r = ⟨t^{3} - t^{2}, 2t^{2} - 2⟩" :db/id #edb/ref 17592186077955} {:answer/id #uuid "07395ddc-381a-5351-aed1-72fc51cba8f3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "r = ⟨t^{3} - t, 2t^{2} - 2t + 6⟩" :db/id #edb/ref 17592186077956} {:answer/id #uuid "07bdef2f-8f89-5da7-a451-659a422289ec" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "r = ⟨2t^{3} - 2t^{2}, t^{2} - t⟩" :db/id #edb/ref 17592186077957} {:answer/id #uuid "5813ad31-b965-5f02-8647-c303e979a41a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "r = ⟨t^{3} - 2t^{2} + 4t, t^{2} - 2t + 6⟩" :db/id #edb/ref 17592186077958} {:answer/id #uuid "6a559519-ac1d-518c-aa1f-2d4402a2ad96" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "r = ⟨t^{3} + 4t, t^{2} - t⟩" :db/id #edb/ref 17592186077959}] :answer-field/id #uuid "ce4a844e-d0ea-58aa-9301-81a7518883c5" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186077954} {:answer-field/choices [{:answer/id #uuid "3fb179c5-0c95-5eb7-b275-9ca460f5d11c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "r=⟨{t}^{3}-2{t}^{2}+4t,\\,{t}^{2}-2t+6⟩" :db/id #edb/ref 17592186403545} {:answer/id #uuid "cbbdc519-f4c7-5a08-a7dd-3f88bedcf9c8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "r=⟨2{t}^{3}-2{t}^{2},\\,{t}^{2}-t⟩" :db/id #edb/ref 17592186403546} {:answer/id #uuid "3a4412af-fcc5-5a70-8cc1-058a234b657a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "r=⟨{t}^{3}-{t}^{2},\\,2{t}^{2}-2⟩" :db/id #edb/ref 17592186403547} {:answer/id #uuid "4f5fe75f-182c-5dc8-bb6d-6b2a54417938" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "r=⟨{t}^{3}-t,\\,2{t}^{2}-2t+6⟩" :db/id #edb/ref 17592186403548} {:answer/id #uuid "4892e60d-0f8b-54a6-a9fb-aedd25ed041e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "r=⟨{t}^{3}+4t,\\,{t}^{2}-t⟩" :db/id #edb/ref 17592186403549}] :answer-field/correct {:answer/id #uuid "3a4412af-fcc5-5a70-8cc1-058a234b657a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "r=⟨{t}^{3}-{t}^{2},\\,2{t}^{2}-2⟩" :db/id #edb/ref 17592186403547} :answer-field/id #uuid "66b0a37a-393b-5f66-b851-8ee2229ca9f6" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186403544}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "83a0e0a1-0c0d-5f48-8e86-38cbeffbfb71" :question/math-academy-id "q-7221" :question/problem "The acceleration $a$ at time $t$ of a particle $P$ moving in the $xy$-plane is given by\n\n$$\na(t)=⟨6t-2,4⟩.\n$$\n\nGiven that the particle is at the position $(0,0)$ and has velocity $⟨1,\\,4⟩$ when $t=1,$ calculate the position vector of $P$ at time $t.$" :question/worked-solution "To compute the position vector, we need to integrate the velocity vector. To find the velocity vector, we first need to integrate the acceleration vector. \n\n$$\n\\begin{aligned}v(t) & =\\int a(t)\\,\\text{d}t \\\\  & =\\int ⟨6t-2,4⟩\\,\\text{d}t \\\\  & =⟨\\int (6t-2)\\,\\text{d}t,\\,\\int 4\\,\\text{d}t⟩ \\\\  & =⟨3{t}^{2}-2t+{C}_{1},\\,4t+{C}_{2}⟩\\end{aligned}\n$$\n\nWe can solve for the constants of integration using the fact that $v(1)=⟨1,4⟩.$ Substituting $t=1,$ we get\n\n$$\n\\begin{aligned}v(1) & =⟨3(1)^{2}-2(1)+{C}_{1},\\,4(1)+{C}_{2}⟩ \\\\ ⟨1,4⟩ & =⟨1+{C}_{1},4+{C}_{2}⟩,\\end{aligned}\n$$\n\nso we must have ${C}_{1}=0$ and ${C}_{2}=0.$ Therefore, the velocity vector is\n\n$$\n\\begin{aligned}v(t) & =⟨3{t}^{2}-2t,\\,4t⟩.\\end{aligned}\n$$\n\nWe can compute the position vector by integrating the velocity vector.\n\n$$\n\\begin{aligned}r(t) & =\\int v(t)\\,\\text{d}t \\\\  & =\\int ⟨3{t}^{2}-2t,\\,4t⟩\\,\\text{d}t \\\\  & =⟨\\int (3{t}^{2}-2t)\\,\\text{d}t,\\,\\int 4t\\,\\text{d}t⟩ \\\\  & =⟨{t}^{3}-{t}^{2}+{C}_{3},\\,2{t}^{2}+{C}_{4}⟩\\end{aligned}\n$$\n\nNow, we can solve for the constants of integration using the fact that $r(1)=⟨0,0⟩.$ Substituting $t=1,$ we get\n\n$$\n\\begin{aligned}r(1) & =⟨(1)^{3}-(1)^{2}+{C}_{3},\\,2(1)^{2}+{C}_{4}⟩ \\\\ ⟨0,0⟩ & =⟨{C}_{3},2+{C}_{4}⟩,\\end{aligned}\n$$\n\nso we must have ${C}_{3}=0$ and ${C}_{4}=-2.$ Therefore, the position of $P$ at time $t$ is\n\n$$\n\\begin{aligned}r(t) & =⟨{t}^{3}-{t}^{2},\\,2{t}^{2}-2⟩.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186339074 :knowledge-point/_questions [{:db/id #edb/ref 17592186054677 :knowledge-point/id #uuid "619182bf-107d-5217-a306-ec4f7c1109eb" :knowledge-point/title "Finding the Derivative of a Function Given in Implicit Form Using the Product Rule"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0a0fc10a-2cbd-5633-bb2f-ea7aaaa841c2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{6{x}^{2}+\\operatorname{sin}⁡(y)}{x\\operatorname{sin}⁡(y)+3{y}^{2}}" :db/id #edb/ref 17592186336123} {:answer/id #uuid "16292cbd-8350-5bd3-96d9-795ef552cf0a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{6{x}^{2}-\\operatorname{sin}⁡(y)}{x\\operatorname{cos}⁡(y)+3{y}^{2}}" :db/id #edb/ref 17592186336240} {:answer/id #uuid "1e57b365-540c-5e8a-8331-f6790e70b06d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{6{x}^{2}-\\operatorname{sin}⁡(y)}{x\\operatorname{cos}⁡(y)+2{y}^{3}}" :db/id #edb/ref 17592186336311} {:answer/id #uuid "23a544b4-0d38-57bb-983c-e904eb2a25c2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{6{x}^{2}+\\operatorname{sin}⁡(y)}{x\\operatorname{cos}⁡(y)+{y}^{2}}" :db/id #edb/ref 17592186336367} {:answer/id #uuid "ee47ac7c-c346-5761-8902-7e42ed6ca55e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{6{x}^{2}+\\operatorname{sin}⁡(y)}{x\\operatorname{cos}⁡(y)+3{y}^{2}}" :db/id #edb/ref 17592186338116}] :answer-field/correct {:answer/id #uuid "16292cbd-8350-5bd3-96d9-795ef552cf0a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{6{x}^{2}-\\operatorname{sin}⁡(y)}{x\\operatorname{cos}⁡(y)+3{y}^{2}}" :db/id #edb/ref 17592186336240} :answer-field/id #uuid "f6bf4581-0ffc-537f-82d9-87405f04b109" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186338711}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "454b7cf5-7862-57c7-a910-8dbc0dac1fcc" :question/math-academy-id "q-72213" :question/problem "Calculate $\\frac{\\text{d}y}{\\text{d}x}$ for $x\\operatorname{sin}⁡(y)+{y}^{3}=2{x}^{3}.$" :question/worked-solution "First, we differentiate both sides of the equation with respect to $x,$ assuming that $y=y(x).$\n\nNote that to differentiate the $x\\operatorname{sin}⁡y$ term, we will need to use the product rule.\n\n$$\n\\begin{aligned}x\\operatorname{sin}⁡(y)+{y}^{3}=2{x}^{3} \\\\ \\frac{\\text{d}}{\\text{d}x}(x\\operatorname{sin}⁡(y)+{y}^{3}) & =\\frac{\\text{d}}{\\text{d}x}(2{x}^{3}) \\\\ \\frac{\\text{d}}{\\text{d}x}(x\\operatorname{sin}⁡(y))+\\frac{\\text{d}}{\\text{d}x}({y}^{3}) & =\\frac{\\text{d}}{\\text{d}x}(2{x}^{3}) \\\\ [x(\\operatorname{cos}⁡(y)\\cdot \\frac{\\text{d}y}{\\text{d}x})+\\operatorname{sin}⁡(y)]+3{y}^{2}\\frac{\\text{d}y}{\\text{d}x} & =6{x}^{2} \\\\ x\\operatorname{cos}⁡(y)\\frac{\\text{d}y}{\\text{d}x}+\\operatorname{sin}⁡(y)+3{y}^{2}\\frac{\\text{d}y}{\\text{d}x} & =6{x}^{2}\\end{aligned}\n$$\n\nNow we solve the equation for $\\frac{\\text{d}y}{\\text{d}x},$ as follows:\n\n$$\n\\begin{aligned}x\\operatorname{cos}⁡(y)\\frac{\\text{d}y}{\\text{d}x}+3{y}^{2}\\frac{\\text{d}y}{\\text{d}x} & =6{x}^{2}-\\operatorname{sin}⁡(y) \\\\ \\frac{\\text{d}y}{\\text{d}x}(x\\operatorname{cos}⁡(y)+3{y}^{2}) & =6{x}^{2}-\\operatorname{sin}⁡(y) \\\\ \\frac{\\text{d}y}{\\text{d}x} & =\\frac{6{x}^{2}-\\operatorname{sin}⁡(y)}{x\\operatorname{cos}⁡(y)+3{y}^{2}}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186393201 :knowledge-point/_questions [{:db/id #edb/ref 17592186096810 :knowledge-point/id #uuid "0b47a8b7-722d-564e-8e7a-ad07577d6f6b" :knowledge-point/title "Determining the Rate of Change of an XY-Coordinate"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "21689172-4d3c-58f4-ab05-b3ede303077e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-4\\,\\text{cm}/\\text{s}" :db/id #edb/ref 17592186393203} {:answer/id #uuid "f697959f-44b8-5210-9f7e-1979d2a5ae7a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "7\\,\\text{cm}/\\text{s}" :db/id #edb/ref 17592186393204} {:answer/id #uuid "586238f7-2f99-5a8a-9664-756d8fb42861" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "9\\,\\text{cm}/\\text{s}" :db/id #edb/ref 17592186393205} {:answer/id #uuid "21422ed5-2d8c-51a5-ac65-50e7a6c83355" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6\\,\\text{cm}/\\text{s}" :db/id #edb/ref 17592186393206} {:answer/id #uuid "454121d4-7104-549f-b640-3e2b0c443a68" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-6\\,\\text{cm}/\\text{s}" :db/id #edb/ref 17592186393207}] :answer-field/correct {:answer/id #uuid "454121d4-7104-549f-b640-3e2b0c443a68" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-6\\,\\text{cm}/\\text{s}" :db/id #edb/ref 17592186393207} :answer-field/id #uuid "db06fc53-130e-5887-91ac-6c046aa2906d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186393202}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "a4c40fff-4d18-5542-8848-571c276df41d" :question/math-academy-id "q-72231" :question/problem "A particle $P$ is moving along the curve $y={x}^{2}-6x$ such that the $x$-coordinate of $P$ is changing at the rate of $3\\,\\text{cm}/\\text{s}.$ Find the rate of change of the $y$-coordinate when $x=2\\,\\text{cm}.$" :question/worked-solution "Differentiating the given relation with respect to $t$ using implicit differentiation, we get\n\n$$\n\\begin{aligned}y & ={x}^{2}-6x \\\\ \\frac{\\text{d}}{\\text{d}t}(y) & =\\frac{\\text{d}}{\\text{d}t}({x}^{2}-6x) \\\\ \\frac{\\text{d}y}{\\text{d}t} & =\\frac{\\text{d}x}{\\text{d}t}\\cdot \\frac{\\text{d}}{\\text{d}x}({x}^{2}-6x) \\\\ \\frac{\\text{d}y}{\\text{d}t} & =\\frac{\\text{d}x}{\\text{d}t}\\cdot (2x-6).\\end{aligned}\n$$\n\nNow, we can substitute the given information $\\frac{\\text{d}x}{\\text{d}t}=3\\,\\text{cm}/\\text{s}$ and $x=2$ and get\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}t} & =3\\cdot (2\\cdot 2-6)\\,\\text{cm}/\\text{s} \\\\  & =-6\\,\\text{cm}/\\text{s}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186373181 :knowledge-point/_questions [{:db/id #edb/ref 17592186087833 :knowledge-point/id #uuid "57e19ee3-db9a-58d7-8ca3-4e8801aee656" :knowledge-point/title "Determining the Equation of a Tall Ellipse"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6805f839-3bcd-57e0-afc7-fccf7bbdeae6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{(x-3)^{2}}{4}+\\frac{(y+2)^{2}}{25}=1" :db/id #edb/ref 17592186373183} {:answer/id #uuid "2365b4a0-4a4e-5c09-8c6f-06c3940e1f92" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{(x+3)^{2}}{4}+\\frac{(y-2)^{2}}{25}=1" :db/id #edb/ref 17592186373184} {:answer/id #uuid "1389bd33-3c64-5352-8c10-4e2a1ccf402e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{(x-2)^{2}}{4}+\\frac{(y+3)^{2}}{10}=1" :db/id #edb/ref 17592186373185} {:answer/id #uuid "50ed5beb-40df-5cbb-b518-b7088703743f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{(x-2)^{2}}{10}+\\frac{(y+3)^{2}}{4}=1" :db/id #edb/ref 17592186373186} {:answer/id #uuid "a7318fc4-07ec-5dda-9f48-5c543101ca23" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{(x+3)^{2}}{25}+\\frac{(y-2)^{2}}{4}=1" :db/id #edb/ref 17592186373187}] :answer-field/correct {:answer/id #uuid "2365b4a0-4a4e-5c09-8c6f-06c3940e1f92" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{(x+3)^{2}}{4}+\\frac{(y-2)^{2}}{25}=1" :db/id #edb/ref 17592186373184} :answer-field/id #uuid "630a029c-6e06-5fd5-84a7-4a8213f014cb" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186373182}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "f15691a7-e2ba-5a41-93ce-4813f75267cf" :question/math-academy-id "q-72251" :question/problem "![](images/82/8289d16711c1ce0a97e056b44acd949908ed97ce6ae2e4c68d1e5b9022846d01.png)\n\nWhat is the equation of the ellipse given above?" :question/worked-solution "Remember that the general equation of an ellipse centered at $(h,k)$ with a horizontal radius of length $a$ and a vertical radius of length $b$ is given by\n\n$$\n\\frac{(x-h)^{2}}{{a}^{2}}+\\frac{(y-k)^{2}}{{b}^{2}}=1.\n$$\n\n \n\nHere, the ellipse is centered at $(-3,2),$ the horizontal radius has length $a=2,$ and the vertical radius has length $b=5.$ Therefore, the equation of the ellipse is\n\n$$\n\\begin{aligned}\\frac{(x-h)^{2}}{{a}^{2}}+\\frac{(y-k)^{2}}{{b}^{2}} & =1 \\\\ \\frac{(x-(-3))^{2}}{{2}^{2}}+\\frac{(y-2)^{2}}{{5}^{2}} & =1 \\\\ \\frac{(x+3)^{2}}{4}+\\frac{(y-2)^{2}}{25} & =1.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186339078 :knowledge-point/_questions [{:db/id #edb/ref 17592186087833 :knowledge-point/id #uuid "57e19ee3-db9a-58d7-8ca3-4e8801aee656" :knowledge-point/title "Determining the Equation of a Tall Ellipse"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0d360012-b71b-5e3d-a5ed-050551fedc08" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{(x+2)^{2}}{6}+\\frac{(y+2)^{2}}{8}=1" :db/id #edb/ref 17592186336156} {:answer/id #uuid "363d6738-eccc-55d0-b37d-dc6eeb5492c9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{(x-2)^{2}}{9}+\\frac{(y+2)^{2}}{16}=1" :db/id #edb/ref 17592186336536} {:answer/id #uuid "799fad89-4775-5c00-9f34-a99bb77a3ae6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{(x-2)^{2}}{8}+\\frac{(y-2)^{2}}{6}=1" :db/id #edb/ref 17592186337125} {:answer/id #uuid "975b13c5-78a1-50ac-8fca-df15265468b8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{(x+2)^{2}}{9}+\\frac{(y+2)^{2}}{16}=1" :db/id #edb/ref 17592186337411} {:answer/id #uuid "a0e5af31-ccd8-5042-a136-b3b71e9698e8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{(x-2)^{2}}{9}+\\frac{(y-2)^{2}}{16}=1" :db/id #edb/ref 17592186337486}] :answer-field/correct {:answer/id #uuid "975b13c5-78a1-50ac-8fca-df15265468b8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{(x+2)^{2}}{9}+\\frac{(y+2)^{2}}{16}=1" :db/id #edb/ref 17592186337411} :answer-field/id #uuid "e195d8c3-ee86-56e6-9272-e56918978464" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186338674}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "82c10773-d500-51bb-9b6a-76b40d3c3844" :question/math-academy-id "q-72252" :question/problem "![](images/28/28079ead5ebb4649900653172d11c25f3ff489c6b34772094a1ba947c18ef3e1.png)\n\nWhat is the equation of the ellipse given above?" :question/worked-solution "Remember that the general equation of an ellipse centered at $(h,k)$ with a horizontal radius of length $a$ and a vertical radius of length $b$ is given by\n\n$$\n\\frac{(x-h)^{2}}{{a}^{2}}+\\frac{(y-k)^{2}}{{b}^{2}}=1.\n$$\n\n \n\nHere, the ellipse is centered at $(-2,-2),$ the horizontal radius has length $a=3,$ and the vertical radius has length $b=4.$ Therefore, the equation of the ellipse is\n\n$$\n\\begin{aligned}\\frac{(x-h)^{2}}{{a}^{2}}+\\frac{(y-k)^{2}}{{b}^{2}} & =1 \\\\ \\frac{(x-(-2))^{2}}{{3}^{2}}+\\frac{(y-(-2))^{2}}{{4}^{2}} & =1 \\\\ \\frac{(x+2)^{2}}{9}+\\frac{(y+2)^{2}}{16} & =1.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186339079 :knowledge-point/_questions [{:db/id #edb/ref 17592186054677 :knowledge-point/id #uuid "619182bf-107d-5217-a306-ec4f7c1109eb" :knowledge-point/title "Finding the Derivative of a Function Given in Implicit Form Using the Product Rule"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4b322d9c-37ab-52f7-9c7e-158b2aad5a2b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{6{x}^{2}-2xy}{{x}^{2}+4}" :db/id #edb/ref 17592186336727} {:answer/id #uuid "4fa8641b-f12e-5282-8639-b287c9ca081d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{6x-xy}{{x}^{2}+4}" :db/id #edb/ref 17592186336764} {:answer/id #uuid "778b8f44-4e6f-5e84-b5d0-3856a65b2fcc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{6-2xy}{{x}^{2}+4}" :db/id #edb/ref 17592186337107} {:answer/id #uuid "8e0a7e37-7922-5237-be4e-0d4daf2edd15" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{6x-2y}{{x}^{2}+4}" :db/id #edb/ref 17592186337313} {:answer/id #uuid "d8ffdd28-a653-5368-a470-1763333eed55" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{6x+2xy}{{x}^{2}-4}" :db/id #edb/ref 17592186337920}] :answer-field/correct {:answer/id #uuid "4b322d9c-37ab-52f7-9c7e-158b2aad5a2b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{6{x}^{2}-2xy}{{x}^{2}+4}" :db/id #edb/ref 17592186336727} :answer-field/id #uuid "f8ea9a9d-1024-53db-ae2f-47b539ab86b2" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186338714}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "3b84d5b9-93df-56c4-be18-4346c8b72764" :question/math-academy-id "q-72260" :question/problem "Calculate $\\frac{\\text{d}y}{\\text{d}x}$ for ${x}^{2}y+4y=2{x}^{3}.$" :question/worked-solution "First, we differentiate both sides of the equation with respect to $x,$ assuming that $y=y(x).$\n\nNote that to differentiate the ${x}^{2}y$ term, we will need to use the product rule.\n\n$$\n\\begin{aligned}{x}^{2}y+4y & =2{x}^{3} \\\\ \\frac{\\text{d}}{\\text{d}x}({x}^{2}y+4y) & =\\frac{\\text{d}}{\\text{d}x}(2{x}^{3}) \\\\ \\frac{\\text{d}}{\\text{d}x}({x}^{2}y)+\\frac{\\text{d}}{\\text{d}x}(4y) & =\\frac{\\text{d}}{\\text{d}x}(2{x}^{3}) \\\\ [{x}^{2}\\frac{\\text{d}y}{\\text{d}x}+y\\cdot 2x]+4\\frac{\\text{d}y}{\\text{d}x} & =6{x}^{2} \\\\ {x}^{2}\\frac{\\text{d}y}{\\text{d}x}+2xy+4\\frac{\\text{d}y}{\\text{d}x} & =6{x}^{2}\\end{aligned}\n$$\n\nNow we solve the equation for $\\frac{\\text{d}y}{\\text{d}x},$ as follows:\n\n$$\n\\begin{aligned}{x}^{2}\\frac{\\text{d}y}{\\text{d}x}+4\\frac{\\text{d}y}{\\text{d}x} & =6{x}^{2}-2xy \\\\ \\frac{\\text{d}y}{\\text{d}x}({x}^{2}+4) & =6{x}^{2}-2xy \\\\ \\frac{\\text{d}y}{\\text{d}x} & =\\frac{6{x}^{2}-2xy}{{x}^{2}+4}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186382242 :knowledge-point/_questions [{:db/id #edb/ref 17592186129165 :knowledge-point/id #uuid "d237f9fb-b5d2-53e0-bc28-ee50d9e08852" :knowledge-point/title "Evaluating a Double Integral Over a Rectangular Domain"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "334017b1-e361-54a4-8bd7-ca3fddb53769" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "16" :db/id #edb/ref 17592186382244} {:answer/id #uuid "b283798d-d944-5382-a5ed-61178e89abfc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "36" :db/id #edb/ref 17592186382245} {:answer/id #uuid "18a8f39a-f185-50c2-9632-4d71fb32f621" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "32" :db/id #edb/ref 17592186382246} {:answer/id #uuid "8febf0a3-ae0e-5e0b-ac73-ff0a95aeecb9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "48" :db/id #edb/ref 17592186382247} {:answer/id #uuid "323026fa-38e0-54a0-a86c-1691c6406fe7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "24" :db/id #edb/ref 17592186382248}] :answer-field/correct {:answer/id #uuid "18a8f39a-f185-50c2-9632-4d71fb32f621" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "32" :db/id #edb/ref 17592186382246} :answer-field/id #uuid "ef6b8e71-5f3a-569e-b59b-a38b1bed9ae6" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186382243}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "d63f493d-43c5-52a2-9f1e-5afe59523cca" :question/math-academy-id "q-72266" :question/problem "Evaluate the double integral ${∬}_{D}9{x}^{2}{y}^{2}\\,\\text{d}A,$ where \n$D={(x,y)\\,:\\,-2\\le x\\le 2,\\,-1\\le y\\le 1}.$" :question/worked-solution "First, we express our double integral as a repeated integral:        \n\n$$\n\\begin{aligned}{∬}_{D}9{x}^{2}{y}^{2}\\,\\text{d}A & ={\\int }_{-1}^{1}[{\\int }_{-2}^{2}9{x}^{2}{y}^{2}\\,\\text{d}x]\\text{d}y\\end{aligned}\n$$\n\nNow, we evaluate the inner integral by integrating with respect to $x$, treating $y$ as a constant:\n\n$$\n\\begin{aligned}{\\int }_{-1}^{1}[{\\int }_{-2}^{2}9{x}^{2}{y}^{2}\\,\\text{d}x]\\text{d}y & ={\\int }_{-1}^{1}9{y}^{2}[{\\int }_{-2}^{2}{x}^{2}\\,\\text{d}x]\\text{d}y \\\\  & ={\\int }_{-1}^{1}9{y}^{2}{[\\frac{{x}^{3}}{3}]}_{-2}^{2}\\text{d}y \\\\  & ={\\int }_{-1}^{1}9{y}^{2}(\\frac{{2}^{3}}{3}-\\frac{(-2)^{3}}{3})\\,\\text{d}y \\\\  & ={\\int }_{-1}^{1}9{y}^{2}\\cdot \\frac{16}{3}\\,\\text{d}y \\\\  & ={\\int }_{-1}^{1}48{y}^{2}\\,\\text{d}y\\end{aligned}\n$$\n\nFinally, we integrate with respect to $y:$\n\n$$\n\\begin{aligned}{\\int }_{-1}^{1}48{y}^{2}\\,\\text{d}y & =[16{y}^{3}]_{-1}^{1} \\\\  & =16({1}^{3}-(-1)^{3}) \\\\  & =16\\cdot 2 \\\\  & =32\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186403550 :knowledge-point/_questions [{:db/id #edb/ref 17592186087822 :knowledge-point/id #uuid "79daf9dd-814d-562b-b3bc-b066bd2dfb90" :knowledge-point/title "Identifying the Shift Applied to an Exponential Growth Curve"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "93a712bc-5c5d-5646-9703-82e77d69b46e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=-3({3}^{x})" :db/id #edb/ref 17592186403552} {:answer/id #uuid "c63beba4-7686-58ae-845d-111254d3e6ae" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y={3}^{x}-1" :db/id #edb/ref 17592186403553} {:answer/id #uuid "5996d30b-a352-5547-9b35-f09224ff8616" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y={3}^{x}-3" :db/id #edb/ref 17592186403554} {:answer/id #uuid "e2d5db3c-106b-5a20-8512-215f226e23f6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y={3}^{x}-2" :db/id #edb/ref 17592186403555} {:answer/id #uuid "3d9e24e9-f8f1-50d2-a309-392b65ff2168" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=-2({3}^{x})" :db/id #edb/ref 17592186403556}] :answer-field/correct {:answer/id #uuid "e2d5db3c-106b-5a20-8512-215f226e23f6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y={3}^{x}-2" :db/id #edb/ref 17592186403555} :answer-field/id #uuid "7f6e4f21-8993-51e5-a1c9-737356240b0e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186403551}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "bbca085f-0b60-5f9a-bdc1-1da6491170fe" :question/math-academy-id "q-7230" :question/problem "![](images/87/8764149ca0000522277d48bf48f4ef14ba06f7e4793ba1a58ef639ff7af3a3b9.png)\n\nThe graph above shows the curve $y={3}^{x}+c.$ Determine the value of $c$ and find the equation of the curve." :question/worked-solution "The horizontal asymptote of $y={3}^{x}$ is $y=0.$ The vertical translation $y={3}^{x}+c$ shifts the asymptote to $y=c.$\n\nIn the graph above, the horizontal asymptote is $y=-2.$ Therefore, $c=-2.$"}] [{:db/id #edb/ref 17592186339087 :knowledge-point/_questions [{:db/id #edb/ref 17592186124505 :knowledge-point/id #uuid "e9078ab1-37a4-5e96-ae12-a83d5cd8804e" :knowledge-point/title "Identifying Properties of a Hyperbolic Paraboloid"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "41853b1b-f128-539e-ab88-ca5d59dc0e05" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-1,-4,5)" :db/id #edb/ref 17592186336650} {:answer/id #uuid "70528fdb-7a33-5672-975b-ede680fbc8ed" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(1,-4,5)" :db/id #edb/ref 17592186337032} {:answer/id #uuid "c2e1c5a4-62d6-5436-af43-17c9bfc5613e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-4,1,5)" :db/id #edb/ref 17592186337762} {:answer/id #uuid "c6b771d8-baa4-5b37-b891-b67f5cd45988" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(1,-4,-5)" :db/id #edb/ref 17592186337793} {:answer/id #uuid "cd2de5c5-4809-5d29-8d83-1b351dad1988" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-1,4,-5)" :db/id #edb/ref 17592186337830}] :answer-field/correct {:answer/id #uuid "70528fdb-7a33-5672-975b-ede680fbc8ed" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(1,-4,5)" :db/id #edb/ref 17592186337032} :answer-field/id #uuid "d289b150-0a1d-5b56-9cb1-7dfd34466e9f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186338650}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "14b3d36d-0d61-5644-876e-58f0a854730d" :question/math-academy-id "q-72303" :question/problem "Find the saddle point of the hyperbolic paraboloid $z-5=5(x-1)^{2}-3(y+4)^{2}.$" :question/worked-solution "The general equation of a hyperbolic paraboloid with a saddle point at $({x}_{0},{y}_{0},{z}_{0})$ is \n\n$$\nz-{z}_{0}=\\frac{(x-{x}_{0})^{2}}{{a}^{2}}-\\frac{(y-{y}_{0})^{2}}{{b}^{2}}.\n$$\n\nTo find the saddle point, we rewrite our equation as follows:\n\n$$\n\\begin{aligned}z-5 & =5(x-1)^{2}-3(y+4)^{2} \\\\ z-5 & =\\frac{(x-1)^{2}}{1/5}-\\frac{(y+4)^{2}}{1/3} \\\\ z-5 & =\\frac{(x-1)^{2}}{1/5}-\\frac{(y-(-4))^{2}}{1/3}\\end{aligned}\n$$\n\nThis gives us the equation of a hyperbolic paraboloid with a saddle point at $(1,-4,5).$"}] [{:db/id #edb/ref 17592186403557 :knowledge-point/_questions [{:db/id #edb/ref 17592186087822 :knowledge-point/id #uuid "79daf9dd-814d-562b-b3bc-b066bd2dfb90" :knowledge-point/title "Identifying the Shift Applied to an Exponential Growth Curve"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "760d4f2f-67c3-578b-90ce-e44b5cc0e475" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y={2}^{x}-2" :db/id #edb/ref 17592186403559} {:answer/id #uuid "a42ff124-ce1b-58ec-a4c4-728cb4b536df" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=-3({2}^{x})" :db/id #edb/ref 17592186403560} {:answer/id #uuid "9bb95f56-7efa-56a4-ab5b-5f4220d4b140" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y={2}^{x}-3" :db/id #edb/ref 17592186403561} {:answer/id #uuid "840799e0-019f-5e56-960e-e4dce9f6a43e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y={3}^{x}-4" :db/id #edb/ref 17592186403562} {:answer/id #uuid "97c4002b-68c4-5b92-bb46-3a3c52c7bbac" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=3({2}^{x})" :db/id #edb/ref 17592186403563}] :answer-field/correct {:answer/id #uuid "9bb95f56-7efa-56a4-ab5b-5f4220d4b140" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y={2}^{x}-3" :db/id #edb/ref 17592186403561} :answer-field/id #uuid "117f36b7-d2dd-58cf-81f2-744857f29ebf" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186403558}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "bb2d08ab-7e1f-579d-8314-e037ebc00133" :question/math-academy-id "q-7232" :question/problem "![](images/2a/2ad72b3df34f32d6a76f79f6801887bd6fe1d762fefd74071517a754b1890ac2.png)\n\nThe graph above shows the curve $y={2}^{x}+c.$ Determine the value of $c$ and find the equation of the curve." :question/worked-solution "The horizontal asymptote of $y={2}^{x}$ is $y=0.$ The vertical translation $y={2}^{x}+c$ shifts the asymptote to $y=c.$\n\nIn the graph above, the horizontal asymptote is $y=-3.$ Therefore, $c=-3.$"}] [{:db/id #edb/ref 17592186375328 :knowledge-point/_questions [{:db/id #edb/ref 17592186129167 :knowledge-point/id #uuid "64d342be-ebaf-5e94-b641-ea8ce6f14c12" :knowledge-point/title "Identifying Type I Regions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "94d1678f-c40b-5af3-9c01-5e44121bc63a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "D={(x,y)\\,:\\,1\\le x\\le y+1,\\,0\\le y\\le \\frac{1}{2}(x-1)^{2}}" :db/id #edb/ref 17592186375330} {:answer/id #uuid "84793cb4-e8f5-5b93-983f-4e8cd175b741" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "D={(x,y)\\,:\\,1\\le x\\le 3,\\,\\frac{1}{2}(x-1)^{2}\\le y\\le x-1}" :db/id #edb/ref 17592186375331} {:answer/id #uuid "ef5ce8c7-a9c2-5498-ac15-36a28bbba91d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "D={(x,y)\\,:\\,0\\le y\\le 2,\\,0\\le x\\le \\sqrt{y}+1}" :db/id #edb/ref 17592186375332} {:answer/id #uuid "a8532342-6134-55eb-82d5-4bcf4a8d4a3a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "D={(x,y)\\,:\\,0\\le y\\le 2,\\,0\\le x\\le y+1}" :db/id #edb/ref 17592186375333} {:answer/id #uuid "c8beef18-d508-5038-9945-f9210d0f3975" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "D={(x,y)\\,:\\,1\\le x\\le 3,\\,\\frac{1}{2}(x-1)^{2}\\le y\\le x+1}" :db/id #edb/ref 17592186375334}] :answer-field/correct {:answer/id #uuid "84793cb4-e8f5-5b93-983f-4e8cd175b741" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "D={(x,y)\\,:\\,1\\le x\\le 3,\\,\\frac{1}{2}(x-1)^{2}\\le y\\le x-1}" :db/id #edb/ref 17592186375331} :answer-field/id #uuid "06791450-79a7-57ff-982c-0a9c0c48c94a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186375329}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "b8dcd36b-62ff-51dd-911e-391155781896" :question/math-academy-id "q-72322" :question/problem "![](images/88/8861ad010cbd19d897ace4c8da2fdaeca25e9d2319ab95d3b338e6db49aa21ae.png)\n\nWhich of the following represents the shaded region above as a type I region in two-dimensional space?" :question/worked-solution "A type I region can be written as\n\n$$\nD={(x,y)\\,:\\,a\\le x\\le b,\\,g(x)\\le y\\le f(x)},\n$$\n\nwhere $f$ and $g$ are continuous functions.\n\nTo express the given region as a type I region, we first rewrite all of the given curves as functions of $x:$\n\n$$\nx=y+1\\,⟹\\,y=x-1\n$$\n\nThe function $y=\\frac{1}{2}(x-1)^{2}$ is already written as a function of $x.$\n\nNotice that the region lies between the vertical lines $x=1$ and $x=3.$ So, we have $1\\le x\\le 3.$\n\nWe draw a vertical arrow through the region to determine the lower function $g(x)$ and the upper function $f(x).$ A vertical line should intersect the region in a single interval only for it to be a type I region.\n\n![](images/15/15f9c5d526747b80766a8a3250fa2e705d5d7d9561c52e08492b7a18f1483eb6.png)\n\nThe vertical line enters the region through the lower function $y=\\frac{1}{2}(x-1)^{2}$ and leaves through the upper function $y=x-1.$ So, we have $\\frac{1}{2}(x-1)^{2}\\le y\\le x-1.$\n\nTherefore, we obtain\n\n$$\nD={(x,y)\\,:\\,1\\le x\\le 3,\\,\\frac{1}{2}(x-1)^{2}\\le y\\le x-1}.\n$$"}] [{:db/id #edb/ref 17592186339090 :knowledge-point/_questions [{:db/id #edb/ref 17592186068690 :knowledge-point/id #uuid "9f29435f-b112-5999-b0ca-9003d9e622e1" :knowledge-point/title "Calculating an Indeterminate Limit of the Form Infinity Divided by Infinity Using L'Hopital's Rule"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2905b3c7-5120-5928-8659-ab7cf49215cf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\infty " :db/id #edb/ref 17592186336415} {:answer/id #uuid "9c9f02de-6945-5986-9bd6-77c4fda53a38" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186337447} {:answer/id #uuid "c4c17bce-f321-5a5a-b8a2-e2f57aa0f0a6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186337781} {:answer/id #uuid "d1424795-2c4b-569b-984c-33e713fb9a2d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186337866} {:answer/id #uuid "f3baaf2a-856c-5b97-ba7e-56d8806079c7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186338162}] :answer-field/correct {:answer/id #uuid "f3baaf2a-856c-5b97-ba7e-56d8806079c7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186338162} :answer-field/id #uuid "1d342821-bbce-5fd1-b3bb-822b8446cf81" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186338330}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "83ace1c9-0a10-59aa-bb99-7a86a6dbfa17" :question/math-academy-id "q-72333" :question/problem "Evaluate ${lim}_{x\\to {0}^{+}}\\frac{\\operatorname{ln}⁡x}{{e}^{1/x}}.$" :question/worked-solution "Here the limits of the numerator and denominator are ${lim}_{x\\to {0}^{+}}\\operatorname{ln}⁡x=-\\infty $ and ${lim}_{x\\to {0}^{+}}{e}^{1/x}=\\infty ,$ respectively, so we have the case $\\frac{-\\infty }{\\infty }.$\n\nApplying L'Hopital's rule, we obtain\n\n$$\n\\begin{aligned}{lim}_{x\\to {0}^{+}}\\frac{\\operatorname{ln}⁡x}{{e}^{1/x}} & ={lim}_{x\\to {0}^{+}}\\frac{[\\operatorname{ln}⁡x]^{′}}{[{e}^{1/x}]^{′}} \\\\  & ={lim}_{x\\to {0}^{+}}\\frac{(\\frac{1}{x})}{{e}^{1/x}(-\\frac{1}{{x}^{2}})} \\\\  & =-{lim}_{x\\to {0}^{+}}\\frac{{x}^{-1}}{{e}^{1/x}\\cdot {x}^{-2}} \\\\  & =-{lim}_{x\\to {0}^{+}}\\frac{x}{{e}^{1/x}} \\\\  & =0.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186339092 :knowledge-point/_questions [{:db/id #edb/ref 17592186068690 :knowledge-point/id #uuid "9f29435f-b112-5999-b0ca-9003d9e622e1" :knowledge-point/title "Calculating an Indeterminate Limit of the Form Infinity Divided by Infinity Using L'Hopital's Rule"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2dd6dd70-5f78-54b6-ac97-950f2f384aef" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186336473} {:answer/id #uuid "4e08260e-b4f6-5c7a-ad2d-8294f523a3ac" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186336757} {:answer/id #uuid "5b538add-4209-5721-8b56-652729cc391f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186336862} {:answer/id #uuid "7d7564a4-f738-5faf-a2c3-bdd625a0ef99" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{4}" :db/id #edb/ref 17592186337163} {:answer/id #uuid "bb83b45c-700e-5a49-955e-7ea35708e865" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\infty " :db/id #edb/ref 17592186337697}] :answer-field/correct {:answer/id #uuid "4e08260e-b4f6-5c7a-ad2d-8294f523a3ac" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186336757} :answer-field/id #uuid "64250102-7382-5959-9fea-4e5f4501809d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186338454}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "d0dae206-0030-50d7-a470-3e9d541986a9" :question/math-academy-id "q-72336" :question/problem "Evaluate ${lim}_{x\\to 0}\\frac{(\\frac{1}{{x}^{2}})}{(\\frac{1}{{x}^{4}}-1)}.$" :question/worked-solution "Here the limits of the numerator and denominator are ${lim}_{x\\to 0}\\frac{1}{{x}^{2}}=\\infty $ and ${lim}_{x\\to 0}(\\frac{1}{{x}^{4}}-1)=\\infty ,$ respectively, so we have the case $\\frac{\\infty }{\\infty }.$\n\nApplying L'Hopital's rule, we obtain\n\n$$\n\\begin{aligned}{lim}_{x\\to 0}\\frac{(\\frac{1}{{x}^{2}})}{(\\frac{1}{{x}^{4}}-1)} & ={lim}_{x\\to 0}\\frac{{[\\frac{1}{{x}^{2}}]}^{′}}{{[\\frac{1}{{x}^{4}}-1]}^{′}} \\\\  & ={lim}_{x\\to 0}\\frac{(-\\frac{2}{{x}^{3}})}{(-\\frac{4}{{x}^{5}})} \\\\  & ={lim}_{x\\to 0}\\frac{2{x}^{-3}}{4{x}^{-5}} \\\\  & ={lim}_{x\\to 0}\\frac{{x}^{2}}{2} \\\\  & =0.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186069507 :knowledge-point/_questions [{:db/id #edb/ref 17592186068690 :knowledge-point/id #uuid "9f29435f-b112-5999-b0ca-9003d9e622e1" :knowledge-point/title "Calculating an Indeterminate Limit of the Form Infinity Divided by Infinity Using L'Hopital's Rule"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2c029288-0577-53f2-b622-20d182eb4958" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\infty " :db/id #edb/ref 17592186336446} {:answer/id #uuid "537b5f65-839c-5501-a32d-7c7e7a49a12b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186336806} {:answer/id #uuid "77455b1e-3f23-5bec-b73a-1b6c9dc86ab2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186337106} {:answer/id #uuid "9e26fb10-c993-50f5-8b93-429253440f15" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\infty " :db/id #edb/ref 17592186337463} {:answer/id #uuid "e2592f07-77fc-5726-895f-b9958ca63d12" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186338000}] :answer-field/correct {:answer/id #uuid "e2592f07-77fc-5726-895f-b9958ca63d12" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186338000} :answer-field/id #uuid "d7f9d37f-e6cb-53f6-b39d-a73c1eb6742f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186338656}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "8a9948ce-563f-5b0f-bd31-1937130137d2" :question/math-academy-id "q-72339" :question/problem "Evaluate ${lim}_{x\\to {0}^{+}}\\frac{\\operatorname{ln}⁡(\\operatorname{sin}⁡x)}{\\operatorname{csc}⁡x}.$" :question/worked-solution "Here the limits of the numerator and denominator are ${lim}_{x\\to {0}^{+}}\\operatorname{ln}⁡(\\operatorname{sin}⁡x)=-\\infty $ and ${lim}_{x\\to {0}^{+}}\\operatorname{csc}⁡x=\\infty ,$ respectively, so we have the case $\\frac{-\\infty }{\\infty }.$\n\nApplying L'Hopital's rule, we obtain\n\n$$\n\\begin{aligned}{lim}_{x\\to {0}^{+}}\\frac{\\operatorname{ln}⁡(\\operatorname{sin}⁡x)}{\\operatorname{csc}⁡x} & ={lim}_{x\\to {0}^{+}}\\frac{{[\\operatorname{ln}⁡(\\operatorname{sin}⁡x)]}^{′}}{[\\operatorname{csc}⁡x]^{′}} \\\\  & ={lim}_{x\\to {0}^{+}}\\frac{\\operatorname{cot}⁡x}{-\\operatorname{csc}⁡x\\operatorname{cot}⁡x} \\\\  & =-{lim}_{x\\to {0}^{+}}\\frac{\\cancel{\\operatorname{cot}⁡x}}{\\operatorname{csc}⁡x\\cancel{\\operatorname{cot}⁡x}} \\\\  & =-{lim}_{x\\to {0}^{+}}\\frac{1}{\\operatorname{csc}⁡x} \\\\  & =-{lim}_{x\\to {0}^{+}}\\operatorname{sin}⁡x \\\\  & =0.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186403564 :knowledge-point/_questions [{:db/id #edb/ref 17592186129169 :knowledge-point/id #uuid "7948909f-8dcb-5cc0-a00f-f505a41e4004" :knowledge-point/title "Classifying a Region as Type I, Type II, Both, or Neither"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "cebe51cf-7c64-56b5-90cf-d131aa350434" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186403566} {:answer/id #uuid "bb98efc4-1808-5a18-907a-2ed362b46813" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186403567} {:answer/id #uuid "715194f5-7e2b-5553-92e1-418bb1db22f9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186403568} {:answer/id #uuid "52989cfd-9a0b-5436-a602-9bec29db010b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186403569} {:answer/id #uuid "23c11e6d-f7bd-5794-99cd-309344d7fab8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186403570}] :answer-field/correct {:answer/id #uuid "52989cfd-9a0b-5436-a602-9bec29db010b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186403569} :answer-field/id #uuid "1886eec5-845d-5de6-8b01-c5885246a233" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186403565}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "d94b1132-4667-52b0-83fe-bd8235741b13" :question/math-academy-id "q-72345" :question/problem "Which of the following statements are true regarding the finite region bounded between the line $y=x$ and the curve $y={x}^{3},$ in the first quadrant?\n\nI. It is a type I region\nII. It is a type II region\nIII. It's neither a type I nor a type II region" :question/worked-solution "First, notice that\n\n$$\ny={x}^{3}\\,⟹\\,x=\\sqrt[3]{y}.\n$$\n\nNow, let's sketch our region.\n\n![](images/1d/1d1c1cbe30e6f612f824adc76d712a98194ffccc5edefc11cccdaf07204513ba.png)\n\nWe have the following:\n\n- Any vertical line through the region intersects it on a single interval. Furthermore, we can represent our region as\n\n$$\nD={(x,y)\\,:\\,0\\le x\\le 1,\\,{x}^{3}\\le y\\le x}.\n$$\n\nSo, this is a type I region.\n\n- Any horizontal line through the region intersects it on a single interval. Furthermore, we can represent our region as\n\n$$\nD={(x,y)\\,:\\,0\\le y\\le 1,\\,y\\le x\\le \\sqrt[3]{y}}.\n$$\n\nSo, this is a type II region.\n\nTherefore, only statements I and II are true."}] [{:db/id #edb/ref 17592186339100 :knowledge-point/_questions [{:db/id #edb/ref 17592186068722 :knowledge-point/id #uuid "b89c50f3-2181-5b61-96cb-386ef88d2035" :knowledge-point/title "Integrating an Expression Involving a Power Function Multiplied by Its Derivative"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "181818f9-ee5d-570b-8805-3453bec6da26" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\sqrt{(1+{x}^{5})^{3}}+C" :db/id #edb/ref 17592186336257} {:answer/id #uuid "324b72d3-41e0-5026-af58-5b34dc0551ad" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\sqrt{1+{x}^{5}}+C" :db/id #edb/ref 17592186336509} {:answer/id #uuid "601c5f25-3385-59f3-b9ec-6f4783410687" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{1+{x}^{5}}}{2}+C" :db/id #edb/ref 17592186336901} {:answer/id #uuid "d13e9d9a-a682-5a93-b274-9657dd12c702" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2x\\sqrt{1+{x}^{5}}+C" :db/id #edb/ref 17592186337864} {:answer/id #uuid "e2d6ab9a-d942-55d2-8674-766bbfa15318" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{(1+{x}^{5})^{3}}}{2}+C" :db/id #edb/ref 17592186338008}] :answer-field/correct {:answer/id #uuid "324b72d3-41e0-5026-af58-5b34dc0551ad" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\sqrt{1+{x}^{5}}+C" :db/id #edb/ref 17592186336509} :answer-field/id #uuid "1287170e-aae1-5d7e-9ef3-ec229bb6713f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186338307}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "94a2c36c-7f20-5b89-950f-742f856d9127" :question/math-academy-id "q-72382" :question/problem "Calculate $\\int \\frac{5{x}^{4}}{\\sqrt{1+{x}^{5}}}\\,\\text{d}x.$" :question/worked-solution "We note that $5{x}^{4}$ is the derivative of the quantity in the radical. So we make a substitution\n\n$$\nu=1+{x}^{5}.\n$$\n\nIts derivative is given by\n\n$$\n\\begin{aligned}\\frac{\\text{d}u}{\\text{d}x} & =5{x}^{4}\\,⟹\\,\\text{d}u=5{x}^{4}\\,\\text{d}x,\\end{aligned}\n$$\n\nand rewriting our integral, we get\n\n$$\n\\begin{aligned}\\int \\frac{5{x}^{4}}{\\sqrt{1+{x}^{5}}}\\,\\text{d}x & =\\int \\frac{1}{\\sqrt{1+{x}^{5}}}\\,5{x}^{4}\\,\\text{d}x \\\\  & =\\int \\frac{1}{\\sqrt{u}}\\,\\text{d}u \\\\  & =\\int \\frac{1}{{u}^{1/2}}\\,\\text{d}u \\\\  & =\\int {u}^{-1/2}\\,\\text{d}u.\\end{aligned}\n$$\n\nWe can now solve the integral using the power rule:\n\n$$\n\\begin{aligned}\\int {u}^{-1/2}\\,\\text{d}u & =\\frac{{u}^{1/2}}{(\\frac{1}{2})}+C \\\\  & =2{u}^{1/2}+C \\\\  & =2\\sqrt{u}+C\\end{aligned}\n$$\n\nLastly, we substitute $u=1+{x}^{5}$ back in the expression. So the final result is\n\n$$\n\\begin{aligned}\\int \\frac{5{x}^{4}}{\\sqrt{1+{x}^{5}}}\\,\\text{d}x & =2\\sqrt{1+{x}^{5}}+C.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186339103 :knowledge-point/_questions [{:db/id #edb/ref 17592186087824 :knowledge-point/id #uuid "0b70a3b7-90a7-5a83-b71f-304f7f25c4ef" :knowledge-point/title "Identifying the Shift and Stretch Applied to an Exponential Growth Curve"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "121b16a2-0458-5600-9a6f-f4f6e552fd5d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=3({2}^{x})-2" :db/id #edb/ref 17592186336202} {:answer/id #uuid "4c671da3-c302-5f3c-9ea5-2dc6dac2cc6c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=3({2}^{x})+2" :db/id #edb/ref 17592186336742} {:answer/id #uuid "6fed05ea-acde-5be8-b414-01135dc6f042" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=3({2}^{x})-1" :db/id #edb/ref 17592186337023} {:answer/id #uuid "826ab4ce-caa8-5db7-9188-f1b3cd74a9bb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y={2}^{x}-1" :db/id #edb/ref 17592186337218} {:answer/id #uuid "9cf95245-48b9-524a-917b-0ba71da5cdb8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=2({2}^{x})-1" :db/id #edb/ref 17592186337452}] :answer-field/correct {:answer/id #uuid "6fed05ea-acde-5be8-b414-01135dc6f042" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=3({2}^{x})-1" :db/id #edb/ref 17592186337023} :answer-field/id #uuid "0eab9c10-198f-58c5-918e-000cc777273e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186338303}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "9f0333a8-0cc0-5b0c-9999-f5175286f364" :question/math-academy-id "q-7239" :question/problem "![](images/1c/1ca11413bbce2ff307e494fb5a79028535b76cff24619e6921620f88c3e274ec.png)\n\nThe graph above shows $y=k({2}^{x})+c.$  Determine the values of $k$ and $c$ and find the equation of the curve." :question/worked-solution "The horizontal asymptote of the curve $y=k({2}^{x})+c$ is $y=c.$ In the graph above, the horizontal asymptote is $y=-1,$ so $c=-1.$\n\nTherefore, our function takes the form\n\n$$\ny=k({2}^{x})-1.\n$$\n\nWe can solve for $k$ by finding a point on the graph and substituting for $x$ and $y.$ The labeled point on the graph is $(0,2),$ so we substitute $x=0$ and $y=2$ into the function and solve for $k:$\n\n$$\n\\begin{aligned}y & =k({2}^{x})-1 \\\\ 2 & =k({2}^{0})-1 \\\\ 2 & =k(1)-1 \\\\ 2 & =k-1 \\\\ 3 & =k\\end{aligned}\n$$\n\nTherefore, the curve is $y=3({2}^{x})-1.$"}] [{:db/id #edb/ref 17592186366254 :knowledge-point/_questions [{:db/id #edb/ref 17592186129173 :knowledge-point/id #uuid "8537cc22-8d18-57c8-9ebf-921bd4d06ae7" :knowledge-point/title "Computing a Double Summation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8cdaccea-2f1f-579c-b237-2d5393055b73" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186366256} {:answer/id #uuid "aaa1a53e-523b-569f-83dd-047da5436dc5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186366257} {:answer/id #uuid "aabe863f-76d5-5c86-94b0-a588b897eac6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186366258} {:answer/id #uuid "02cf9849-79e2-570a-93e1-9506dfe614b5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186366259} {:answer/id #uuid "4a8a378b-ad0f-59e3-b2db-2bb3d3c2a896" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-6" :db/id #edb/ref 17592186366260}] :answer-field/correct {:answer/id #uuid "02cf9849-79e2-570a-93e1-9506dfe614b5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186366259} :answer-field/id #uuid "11de832f-cbe6-5fad-ae01-189beccacca5" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186366255}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "a4955833-cb02-5857-a78e-70ed3219424f" :question/math-academy-id "q-72396" :question/problem "${\\sum }_{i=1}^{3}{\\sum }_{j=1}^{3}(i-j)=$" :question/worked-solution "First, we write out the inner summation by summing over the index $j:$\n\n$$\n\\begin{aligned}{\\sum }_{i=1}^{3}{\\sum }_{j=1}^{3}(i-j) & ={\\sum }_{i=1}^{3}[{\\sum }_{j=1}^{3}(i-j)] \\\\  & ={\\sum }_{i=1}^{3}((i-1)+(i-2)+(i-3)) \\\\  & ={\\sum }_{i=1}^{3}(3i-6)\\end{aligned}\n$$\n\nNext, we sum over the index $i:$\n\n$$\n\\begin{aligned}{\\sum }_{i=1}^{3}(3i-6) & =(3\\cdot 1-6)+(3\\cdot 2-6)+(3\\cdot 3-6) \\\\  & =-3+0+3 \\\\  & =0\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186339109 :knowledge-point/_questions [{:db/id #edb/ref 17592186087824 :knowledge-point/id #uuid "0b70a3b7-90a7-5a83-b71f-304f7f25c4ef" :knowledge-point/title "Identifying the Shift and Stretch Applied to an Exponential Growth Curve"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "49005b9e-8885-518c-a503-38932dbc77f8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=1.5({2}^{x})+4" :db/id #edb/ref 17592186336710} {:answer/id #uuid "a7777608-b4d4-5368-84cb-c7a407165b82" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=1.5({2}^{x})+3" :db/id #edb/ref 17592186337546} {:answer/id #uuid "ba7873cf-81b9-5aaf-8051-9f548d554ab8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=0.5({2}^{x})+4" :db/id #edb/ref 17592186337684} {:answer/id #uuid "c3ad9d29-36d5-5b4e-bad4-d6181862fae0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=1.5({2}^{x})+5" :db/id #edb/ref 17592186337768} {:answer/id #uuid "e97102d4-c948-5475-a8f4-3282b09cc04f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=0.5({2}^{x})+5" :db/id #edb/ref 17592186338069}] :answer-field/correct {:answer/id #uuid "49005b9e-8885-518c-a503-38932dbc77f8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=1.5({2}^{x})+4" :db/id #edb/ref 17592186336710} :answer-field/id #uuid "08a06ece-0b13-5c0a-9459-301060485f8d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186338290}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "5a92c523-6f37-5b9d-8ed7-2c5b4d7360ee" :question/math-academy-id "q-7241" :question/problem "![](images/3a/3a78c4fc61bbf60e1cdfdba6303ecc1a9d5e09caa21d0879556106893a931a09.png)\n\nThe graph above shows $y=k({2}^{x})+c.$  Determine the values of $k$ and $c$ and find the equation of the curve." :question/worked-solution "The horizontal asymptote of the curve $y=k({2}^{x})+c$ is $y=c.$ In the graph above, the horizontal asymptote is $y=4,$ so $c=4.$\n\nTherefore, our function takes the form\n\n$$\ny=k({2}^{x})+4.\n$$\n\nWe can solve for $k$ by finding a point on the graph and substituting for $x$ and $y.$ The labeled point on the graph is $(0,5.5),$ so we substitute $x=0$ and $y=5.5$ into the function and solve for $k:$\n\n$$\n\\begin{aligned}y & =k({2}^{x})+4 \\\\ 5.5 & =k({2}^{0})+4 \\\\ 5.5 & =k(1)+4 \\\\ 5.5 & =k+4 \\\\ 1.5 & =k\\end{aligned}\n$$\n\nTherefore, the curve is $y=1.5({2}^{x})+4.$"}] [{:db/id #edb/ref 17592186398961 :knowledge-point/_questions [{:db/id #edb/ref 17592186064203 :knowledge-point/id #uuid "e2b47545-fdf1-5e6a-b0bb-bbbecb8067cc" :knowledge-point/title "Integrating an Algebraic Function With Positive Integer Exponent"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6058cb14-4722-5ae2-982a-1d1d72759305" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-(7-2x)^{8}+C" :db/id #edb/ref 17592186398963} {:answer/id #uuid "615ab3c3-1cc9-56db-a561-9ade7641ace4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{2}(7-2x)^{8}+C" :db/id #edb/ref 17592186398964} {:answer/id #uuid "2b200597-1f86-5ecd-b8bc-18b09c132aad" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(7-2x)^{8}+C" :db/id #edb/ref 17592186398965} {:answer/id #uuid "13a3fa38-b420-5956-8a4b-2194f2d8ef30" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{8}(7-2x)^{8}+C" :db/id #edb/ref 17592186398966} {:answer/id #uuid "5674f007-df38-5b04-ac90-1342c70182a8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}(7-2x)^{8}+C" :db/id #edb/ref 17592186398967}] :answer-field/correct {:answer/id #uuid "6058cb14-4722-5ae2-982a-1d1d72759305" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-(7-2x)^{8}+C" :db/id #edb/ref 17592186398963} :answer-field/id #uuid "6ee57767-a470-5ed2-888e-e7479cb9accb" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186398962}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "8c75bb9c-44e2-5f73-9a68-3c296ae237a7" :question/math-academy-id "q-72424" :question/problem "$\\int 16(7-2x)^{7}\\,\\text{d}x=$" :question/worked-solution "Let $u=7-2x.$ Then differentiating with respect to $x$ gives\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=-2\\,⟹\\,\\text{d}x=-\\frac{1}{2}\\text{d}u.\n$$\n\nWe now write our integral in terms of $u,$ calculate the integral as normal, and write the final answer in terms of $x$ at the very end:\n\n$$\n\\begin{aligned}\\int 16(7-2x)^{7}\\,\\text{d}x & =\\int 16{u}^{7}\\cdot (-\\frac{1}{2})\\,\\text{d}u \\\\  & =16\\int {u}^{7}\\cdot (-\\frac{1}{2})\\,\\text{d}u \\\\  & =16\\cdot (-\\frac{1}{2})\\int {u}^{7}\\,\\text{d}u \\\\  & =-8\\cdot \\frac{{u}^{8}}{8}+C \\\\  & =-{u}^{8}+C \\\\  & =-(7-2x)^{8}+C\\end{aligned}\n$$\n\nLet's double-check that our result is correct. If we differentiate the result, then it should come out to the original integrand:\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}[-(7-2x)^{8}+C] & =-\\frac{\\text{d}}{\\text{d}x}[(7-2x)^{8}]+\\frac{\\text{d}}{\\text{d}x}(C) \\\\  & =-8(7-2x)^{7}\\cdot \\frac{\\text{d}}{\\text{d}x}(7-2x)+0 \\\\  & =-8(7-2x)^{7}\\cdot (-2) \\\\  & =16(7-2x)^{7}\\,✓\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186339116 :knowledge-point/_questions [{:db/id #edb/ref 17592186064207 :knowledge-point/id #uuid "bdbfa506-08a1-5e43-b958-2ae373df775d" :knowledge-point/title "Integrating a Linear Rational Function and Simplifying the Arbitrary Constant"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0ea8c3ea-0518-506a-9945-ef3bf2bf7936" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\operatorname{ln}⁡(K|7-x|)" :db/id #edb/ref 17592186336171} {:answer/id #uuid "6ae31738-7e11-5b61-bda5-73b51a186dc1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{7}\\operatorname{ln}⁡(K|7-x|)" :db/id #edb/ref 17592186336978} {:answer/id #uuid "9dd74f15-1558-5167-ae1a-0738b496e927" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}\\operatorname{ln}⁡(K|7-x|)" :db/id #edb/ref 17592186337459} {:answer/id #uuid "afeaa9dd-27fb-515f-9b9a-a9fc160293f8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{ln}⁡(K|7-x|)" :db/id #edb/ref 17592186337612} {:answer/id #uuid "c8d07741-d286-59ef-b0bc-34120b2124b6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{7}\\operatorname{ln}⁡(K|7-x|)" :db/id #edb/ref 17592186337807}] :answer-field/correct {:answer/id #uuid "0ea8c3ea-0518-506a-9945-ef3bf2bf7936" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\operatorname{ln}⁡(K|7-x|)" :db/id #edb/ref 17592186336171} :answer-field/id #uuid "14072edb-e48a-597d-a3df-afce4caaaa51" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186338311}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "b16baf99-001c-5b72-bc61-2ffc6c75b449" :question/math-academy-id "q-72445" :question/problem "Calculate $\\int \\frac{1}{7-x}\\,\\text{d}x.$ Assume that $K$ is an arbitrary positive constant." :question/worked-solution "First, let $u=7-x.$ Then differentiating with respect to $x$ gives\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=-1\\,⟹\\,\\text{d}x=-\\text{d}u.\n$$\n\nWe can now rewrite the integral in terms of $u,$ solve it, and write the final answer in terms of $x$ as follows:\n\n$$\n\\begin{aligned}\\int \\frac{1}{7-x}\\,\\text{d}x & =\\int \\frac{1}{u}\\cdot (-1)\\,\\text{d}u \\\\  & =-\\int \\frac{1}{u}\\,\\text{d}u \\\\  & =-\\operatorname{ln}⁡|u|+C \\\\  & =-\\operatorname{ln}⁡|7-x|+C\\end{aligned}\n$$\n\nWe can further simplify the above by writing $C=-\\operatorname{ln}⁡K$ for another arbitrary constant $K,$ and then we can combine the two terms using the laws of logarithms, as follows:\n\n$$\n\\begin{aligned}-\\operatorname{ln}⁡|7-x|+C & =-\\operatorname{ln}⁡|7-x|-\\operatorname{ln}⁡K \\\\  & =-(\\operatorname{ln}⁡|7-x|+\\operatorname{ln}⁡K) \\\\  & =-\\operatorname{ln}⁡(K|7-x|)\\end{aligned}\n$$\n\nSo, we finally conclude that\n\n$$\n\\int \\frac{1}{7-x}\\,\\text{d}x=-\\operatorname{ln}⁡(K|7-x|).\n$$"}]}
