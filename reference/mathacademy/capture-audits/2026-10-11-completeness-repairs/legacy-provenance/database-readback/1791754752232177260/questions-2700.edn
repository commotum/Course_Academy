#{[{:db/id #edb/ref 17592186339117 :knowledge-point/_questions [{:db/id #edb/ref 17592186064207 :knowledge-point/id #uuid "bdbfa506-08a1-5e43-b958-2ae373df775d" :knowledge-point/title "Integrating a Linear Rational Function and Simplifying the Arbitrary Constant"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "07b76063-8fda-596f-8106-cbb57f2ef69a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}\\operatorname{ln}⁡(K|5-2x|)" :db/id #edb/ref 17592186336093} {:answer/id #uuid "86f6a2e9-4d29-5e23-9617-09660280aaa3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\operatorname{ln}⁡(K|5-2x|)" :db/id #edb/ref 17592186337252} {:answer/id #uuid "b4ead48b-c59a-570e-a7de-39bcbc22b8fe" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{ln}⁡(K|5-2x|)" :db/id #edb/ref 17592186337638} {:answer/id #uuid "bec88b66-0b15-559a-8f7c-3341c51c2ee0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{2}\\operatorname{ln}⁡(K|5-2x|)" :db/id #edb/ref 17592186337729} {:answer/id #uuid "f6322442-f9d7-5f7c-ac2d-896d214f1436" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2\\operatorname{ln}⁡(K|5-2x|)" :db/id #edb/ref 17592186338188}] :answer-field/correct {:answer/id #uuid "bec88b66-0b15-559a-8f7c-3341c51c2ee0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{2}\\operatorname{ln}⁡(K|5-2x|)" :db/id #edb/ref 17592186337729} :answer-field/id #uuid "209f233a-25a9-55a5-ab33-40122ec3bf02" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186338337}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "2d475585-492e-5142-bfa4-12e97136e061" :question/math-academy-id "q-72446" :question/problem "Calculate $\\int \\frac{1}{5-2x}\\,\\text{d}x.$ Assume that $K$ is an arbitrary positive constant." :question/worked-solution "First, let $u=5-2x.$ Then differentiating with respect to $x$ gives\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=-2\\,⟹\\,\\text{d}x=-\\frac{1}{2}\\text{d}u.\n$$\n\nWe can now rewrite the integral in terms of $u,$ solve it, and write the final answer in terms of $x$ as follows:\n\n$$\n\\begin{aligned}\\int \\frac{1}{5-2x}\\,\\text{d}x & =\\int \\frac{1}{u}\\cdot (-\\frac{1}{2})\\,\\text{d}u \\\\  & =-\\frac{1}{2}\\int \\frac{1}{u}\\,\\text{d}u \\\\  & =-\\frac{1}{2}\\operatorname{ln}⁡|u|+C \\\\  & =-\\frac{1}{2}\\operatorname{ln}⁡|5-2x|+C\\end{aligned}\n$$\n\nWe can further simplify the above by writing $C=-\\frac{1}{2}\\operatorname{ln}⁡K$ for another arbitrary constant $K,$ and then we can combine the two terms using the laws of logarithms, as follows:\n\n$$\n\\begin{aligned}-\\frac{1}{2}\\operatorname{ln}⁡|5-2x|+C & =-\\frac{1}{2}\\operatorname{ln}⁡|5-2x|-\\frac{1}{2}\\operatorname{ln}⁡K \\\\  & =-\\frac{1}{2}(\\operatorname{ln}⁡|5-2x|+\\operatorname{ln}⁡K) \\\\  & =-\\frac{1}{2}\\operatorname{ln}⁡(K|5-2x|)\\end{aligned}\n$$\n\nSo, we finally conclude that\n\n$$\n\\int \\frac{1}{5-2x}\\text{d}x=-\\frac{1}{2}\\operatorname{ln}⁡(K|5-2x|).\n$$"}] [{:db/id #edb/ref 17592186339119 :knowledge-point/_questions [{:db/id #edb/ref 17592186064208 :knowledge-point/id #uuid "af32f07f-fa65-5ede-a506-735dc2d3a5ef" :knowledge-point/title "Integrating a Combination of Linear Rational Functions Using the General Formula"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1f5cd12b-daf8-57b4-a508-5b25997dfab6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}\\operatorname{ln}⁡(K|(2x+1)(2x-1)|)" :db/id #edb/ref 17592186336323} {:answer/id #uuid "4b0ccfc1-4a8e-5fe1-b80c-9d8713467d76" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{ln}⁡(K|\\frac{2x+1}{2x-1}|)" :db/id #edb/ref 17592186336723} {:answer/id #uuid "4e0854d1-efd5-57d5-ad92-34e8d95cd84e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\operatorname{ln}⁡(K|(2x+1)(2x-1)|)" :db/id #edb/ref 17592186336758} {:answer/id #uuid "89828476-cdcf-5b30-b125-067c9a0a1d66" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\operatorname{ln}⁡(K|\\frac{2x+1}{2x-1}|)" :db/id #edb/ref 17592186337271} {:answer/id #uuid "8e9493db-04ea-5567-b436-e98702a20a0a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}\\operatorname{ln}⁡(K|\\frac{2x+1}{2x-1}|)" :db/id #edb/ref 17592186337316}] :answer-field/correct {:answer/id #uuid "1f5cd12b-daf8-57b4-a508-5b25997dfab6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}\\operatorname{ln}⁡(K|(2x+1)(2x-1)|)" :db/id #edb/ref 17592186336323} :answer-field/id #uuid "dd143701-6720-5620-9d38-200cfec896ea" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186338665}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "b89e488e-b744-5dec-bdcd-c1a1eb5f6a8b" :question/math-academy-id "q-72449" :question/problem "Calculate $\\int (\\frac{1}{2x+1}+\\frac{1}{2x-1})\\,\\text{d}x.$ Assume that $K$ is an arbitrary positive constant." :question/worked-solution "Let's solve this using the general formula:\n\n$$\n\\begin{aligned}\\int (\\frac{1}{2x+1}+\\frac{1}{2x-1})\\,\\text{d}x & =\\int \\frac{1}{2x+1}\\,\\text{d}x+\\int \\frac{1}{2x-1}\\,\\text{d}x \\\\  & =\\frac{1}{2}\\operatorname{ln}⁡|2x+1|+\\frac{1}{2}\\operatorname{ln}⁡|2x-1|+C \\\\  & =\\frac{1}{2}\\operatorname{ln}⁡|(2x+1)(2x-1)|+\\frac{1}{2}\\text{ }\\operatorname{ln}⁡K \\\\  & =\\frac{1}{2}\\operatorname{ln}⁡(K|(2x+1)(2x-1)|)\\end{aligned}\n$$\n\nNotice that we used the laws of logarithms to write the result as a single logarithm."}] [{:db/id #edb/ref 17592186339123 :knowledge-point/_questions [{:db/id #edb/ref 17592186068723 :knowledge-point/id #uuid "8fe2a279-0b92-561e-b17d-b902f43725ac" :knowledge-point/title "Integrating an Expression Involving a Power Function Multiplied by a Constant Multiple of Its Derivative"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0e59935f-f93b-599b-9816-d15f61104595" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\sqrt{({x}^{2}-5)^{3}}+C" :db/id #edb/ref 17592186336167} {:answer/id #uuid "1ccce204-ca7a-5eee-bc02-3fcc7e16e632" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3\\sqrt{({x}^{2}-5)^{3}}+C" :db/id #edb/ref 17592186336299} {:answer/id #uuid "4b5b5f53-8881-5e03-8cde-ddfcc41895a3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{({x}^{2}-5)^{3}}+C" :db/id #edb/ref 17592186336732} {:answer/id #uuid "75e7362c-a6a5-5145-bf5d-1527db0f317d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{3}\\sqrt{({x}^{2}-5)^{3}}+C" :db/id #edb/ref 17592186337095} {:answer/id #uuid "7bc5cfb0-4b70-528a-a0e4-e88e561188b5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}\\sqrt{({x}^{2}-5)^{3}}+C" :db/id #edb/ref 17592186337152}] :answer-field/correct {:answer/id #uuid "75e7362c-a6a5-5145-bf5d-1527db0f317d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{3}\\sqrt{({x}^{2}-5)^{3}}+C" :db/id #edb/ref 17592186337095} :answer-field/id #uuid "80b5679a-f4f7-56bb-9b5b-253ee5665aec" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186338504}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "de70203f-dd05-5f0d-9800-283717012618" :question/math-academy-id "q-72467" :question/problem "Calculate $\\int x\\sqrt{{x}^{2}-5}\\,\\text{d}x.$" :question/worked-solution "In this case, the $x$ that's outside the square root isn't quite the derivative of $({x}^{2}-5).$ But the derivative is $2x,$ so we're only out by a constant factor.\n\nSo we make the substitution\n\n$$\nu={x}^{2}-5.\n$$\n\nIts derivative is given by\n\n$$\n\\begin{aligned}\\frac{\\text{d}u}{\\text{d}x} & =2x\\,⟹\\,\\frac{1}{2}\\text{d}u=x\\,\\text{d}x,\\end{aligned}\n$$\n\nand we can now write our integral in terms of $u,$ as follows:\n\n$$\n\\begin{aligned}\\int x\\sqrt{{x}^{2}-5}\\,\\text{d}x & =\\int \\sqrt{{x}^{2}-5}\\cdot x\\,\\text{d}x \\\\  & =\\int \\sqrt{u}\\cdot \\frac{1}{2}\\text{d}u \\\\  & =\\frac{1}{2}\\int {u}^{1/2}\\,\\text{d}u\\end{aligned}\n$$\n\nFinally, we can solve the integral in terms of $u$ and then write the final result in terms of $x.$ We get\n\n$$\n\\begin{aligned}\\frac{1}{2}\\int {u}^{1/2}\\,\\text{d}u & =\\frac{1}{2}\\cdot \\frac{{u}^{3/2}}{(\\frac{3}{2})}+C \\\\  & =\\frac{1}{2}\\cdot \\frac{2}{3}\\cdot {u}^{3/2}+C \\\\  & =\\frac{1}{3}{u}^{3/2}+C \\\\  & =\\frac{1}{3}\\sqrt{{u}^{3}}+C \\\\  & =\\frac{1}{3}\\sqrt{({x}^{2}-5)^{3}}+C.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186111390 :knowledge-point/_questions [{:db/id #edb/ref 17592186110669 :knowledge-point/id #uuid "34645eb8-3624-5ff3-817d-28f8d0cee4ba" :knowledge-point/title "Identifying the Scaling Constant From a Graph"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1dc7ed7d-8822-50d6-adbe-ad3f4f94cc16" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186336309} {:answer/id #uuid "2855b2b9-6a8b-51fc-bc86-192bc1d62f6f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{3}" :db/id #edb/ref 17592186336410} {:answer/id #uuid "62f307be-5f4b-5771-b9ee-77edd782e456" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186336922} {:answer/id #uuid "75294229-d638-5281-9b75-127f796a0330" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186337087} {:answer/id #uuid "a40c3d37-1f3e-56af-9259-897cf2fc43fe" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{3}" :db/id #edb/ref 17592186337522}] :answer-field/correct {:answer/id #uuid "1dc7ed7d-8822-50d6-adbe-ad3f4f94cc16" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186336309} :answer-field/id #uuid "dfe47395-e6a4-5174-8bac-b9841d8af59f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186338671}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "7ca56a13-e2a8-587b-a791-0b4526ed9f52" :question/math-academy-id "q-7249" :question/problem "![](images/db/db4c6694a3bc172aea8a47f1a828eac8235286b7ce6b7e327574790a6c31c270.png)\n\nThe graph above shows $y=k{(\\frac{1}{3})}^{x}.$ What is the value of $k?$" :question/worked-solution "To plot the graph of $y=k{(\\frac{1}{3})}^{x}$ we take the graph of $y={(\\frac{1}{3})}^{x}$ and stretch it vertically by a scale factor of  $k.$ Under the action of this transformation, the $y$-intercept is mapped from $(0,1)$ to $(0,k).$\n\nComparing the point $(0,3)$ on the graph to $(0,k),$ we see that we must have $k=3.$"}] [{:db/id #edb/ref 17592186403578 :knowledge-point/_questions [{:db/id #edb/ref 17592186129114 :knowledge-point/id #uuid "2d390841-351e-54f5-ad19-90b6ebae5799" :knowledge-point/title "Identifying Matrices in Row Echelon Form"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "037eeb73-f010-5239-b320-397bc7facb77" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$A$ and $C$ only" :db/id #edb/ref 17592186403580} {:answer/id #uuid "48b44963-1902-5c0d-9522-c534c3678776" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$A$ only" :db/id #edb/ref 17592186403581} {:answer/id #uuid "0eeb9a23-f447-585f-9585-f82e287918e0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$B$ and $C$ only" :db/id #edb/ref 17592186403582} {:answer/id #uuid "c1989825-0208-5721-8305-7b2993765c83" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$A$ and $B$ only" :db/id #edb/ref 17592186403583} {:answer/id #uuid "610ceecf-c4a9-5885-8266-6104d4f37cf1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$B$ only" :db/id #edb/ref 17592186403584}] :answer-field/correct {:answer/id #uuid "037eeb73-f010-5239-b320-397bc7facb77" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$A$ and $C$ only" :db/id #edb/ref 17592186403580} :answer-field/id #uuid "d8c3e5f4-9bc1-505b-a784-0a6ba8cc7e8a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186403579}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "307a31ed-3320-5bc6-9033-1067b69032de" :question/math-academy-id "q-72491" :question/problem "Which of the following matrices are **not** in row echelon form?\n\n$$\nA=[\\begin{aligned}6 & 0 & 3 & 0 \\\\ 0 & 0 & 3 & 1 \\\\ 0 & 0 & 0 & 2 \\\\ 0 & 0 & 6 & 0 \\\\ 0 & 0 & 0 & 0\\end{aligned}],\\,B=[\\begin{aligned}1 & 0 & 5 & 1 & -5 \\\\ 0 & 0 & 2 & 1 & 0 \\\\ 0 & 0 & 0 & 0 & 4\\end{aligned}],\\,C=[\\begin{aligned}5 & 5 & 3 & 4 \\\\ 0 & 1 & 5 & 3 \\\\ 0 & 2 & 2 & 2 \\\\ 0 & 0 & -7 & 4\\end{aligned}].\n$$" :question/worked-solution "Remember that a matrix is in row echelon form if it satisfies the following conditions:\n\nI. All the zero rows (rows with only zeros), if any, are placed at the *bottom* of the matrix.\n\nII. Each leading entry of a row is in a column *to the right* of the leading entry of the row above it.\n\nWith that in mind, let's look at each matrix in turn.\n\n- The matrix $A$ is not in row echelon form since the leading entry ${a}_{43}\\ne 0$ (condition II is violated). \n\n$$\nA=[\\begin{aligned}6 & 0 & 3 & 0 \\\\ 0 & 0 & 3 & 1 \\\\ 0 & 0 & 0 & 2 \\\\ 0 & 0 & 6 & 0 \\\\ 0 & 0 & 0 & 0\\end{aligned}]\n$$\n\n- The matrix $B$ is in row echelon form (both conditions are satisfied).\n\n$$\nB=[\\begin{aligned}1 & 0 & 5 & 1 & -5 \\\\ 0 & 0 & 2 & 1 & 0 \\\\ 0 & 0 & 0 & 0 & 4\\end{aligned}]\n$$\n\n- The matrix $C$ is not in row echelon form since the leading entry ${c}_{32}\\ne 0$ (condition II is violated). \n\n$$\nC=[\\begin{aligned}5 & 5 & 3 & 4 \\\\ 0 & 1 & 5 & 3 \\\\ 0 & 2 & 2 & 2 \\\\ 0 & 0 & -7 & 4\\end{aligned}]\n$$\n\nTherefore, only $A$ and $C$ are **not** in row echelon form."}] [{:db/id #edb/ref 17592186403585 :knowledge-point/_questions [{:db/id #edb/ref 17592186129114 :knowledge-point/id #uuid "2d390841-351e-54f5-ad19-90b6ebae5799" :knowledge-point/title "Identifying Matrices in Row Echelon Form"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d2449f17-fb24-5f21-b93a-91da7cb73b6f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$A$ and $C$ only" :db/id #edb/ref 17592186403587} {:answer/id #uuid "f82dd2a1-af9f-5176-9521-a602fb86b66c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$A$ only" :db/id #edb/ref 17592186403588} {:answer/id #uuid "a73d0fd1-33f8-5fef-91ee-18ea7bc00233" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$B$ and $C$ only" :db/id #edb/ref 17592186403589} {:answer/id #uuid "1e393d24-d14c-55d4-9c1c-d1fb4487bb44" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$C$ only" :db/id #edb/ref 17592186403590} {:answer/id #uuid "0a24998d-88d6-567d-b060-eecb883f1a8b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$B$ only" :db/id #edb/ref 17592186403591}] :answer-field/correct {:answer/id #uuid "1e393d24-d14c-55d4-9c1c-d1fb4487bb44" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$C$ only" :db/id #edb/ref 17592186403590} :answer-field/id #uuid "80541a17-4cbb-5d55-a794-14a52b470ccb" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186403586}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "ba6bcd83-87df-5c0b-b121-63a0ff1205ca" :question/math-academy-id "q-72492" :question/problem "Which of the following matrices are **not** in row echelon form?\n\n$$\nA=[\\begin{aligned}1 & 3 & 5 \\\\ 0 & 1 & 2 \\\\ 0 & 0 & 0\\end{aligned}],\\,B=[\\begin{aligned}1 & 0 & 0 & 0 \\\\ 0 & 5 & 0 & 4 \\\\ 0 & 0 & 0 & 2 \\\\ 0 & 0 & 0 & 0\\end{aligned}],\\,C=[\\begin{aligned}0 & 2 & 3 \\\\ 0 & -1 & -2 \\\\ 0 & 0 & -1\\end{aligned}].\n$$" :question/worked-solution "Remember that a matrix is in row echelon form if it satisfies the following conditions:\n\nI. All the zero rows (rows with only zeros), if any, are placed at the *bottom* of the matrix.\n\nII. Each leading entry of a row is in a column *to the right* of the leading entry of the row above it.\n\nWith that in mind, let's look at each matrix in turn.\n\n- The matrix $A$ is in row echelon form (both conditions are satisfied).\n\n$$\nA=[\\begin{aligned}1 & 3 & 5 \\\\ 0 & 1 & 2 \\\\ 0 & 0 & 0\\end{aligned}]\n$$\n\n- The matrix $B$ is in row echelon form (both conditions are satisfied).\n\n$$\nB=[\\begin{aligned}1 & 0 & 0 & 0 \\\\ 0 & 5 & 0 & 4 \\\\ 0 & 0 & 0 & 2 \\\\ 0 & 0 & 0 & 0\\end{aligned}]\n$$\n\n- The matrix $C$ is not in row echelon form since the leading entry ${c}_{22}\\ne 0$ (condition II is violated). \n\n$$\nC=[\\begin{aligned}0 & 2 & 3 \\\\ 0 & -1 & -2 \\\\ 0 & 0 & -1\\end{aligned}]\n$$\n\nTherefore, only $C$ is **not** in row echelon form."}] [{:db/id #edb/ref 17592186339129 :knowledge-point/_questions [{:db/id #edb/ref 17592186110599 :knowledge-point/id #uuid "29005c66-9f30-5862-926f-8a09320d404c" :knowledge-point/title "Determining Whether Two Lines in Slope-Intercept Form are Perpendicular"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ad7f19f7-5593-5372-821e-d1252d3b8446" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=x" :db/id #edb/ref 17592186337587} {:answer/id #uuid "c0e66778-1d33-59c9-9c63-84193616625d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=-2x-3" :db/id #edb/ref 17592186337745} {:answer/id #uuid "cf4a56a8-6d0c-5363-9d42-b65beb462d50" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=-\\frac{x}{2}x+5" :db/id #edb/ref 17592186337846} {:answer/id #uuid "cf58d7b6-9e04-5b2a-b15f-7c5224686dfe" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=-\\frac{x}{2}x-1" :db/id #edb/ref 17592186337847} {:answer/id #uuid "f9e1b841-fe74-5a6f-9da0-dd60389da801" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=2x+19" :db/id #edb/ref 17592186338222}] :answer-field/correct {:answer/id #uuid "f9e1b841-fe74-5a6f-9da0-dd60389da801" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=2x+19" :db/id #edb/ref 17592186338222} :answer-field/id #uuid "833a989b-8bb1-589d-92ce-6ba9062090a9" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186338511}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "cdd0bbdf-150a-52db-a038-e888ce1f0809" :question/math-academy-id "q-72524" :question/problem "Which of the following lines is perpendicular to $y=-\\frac{x}{2}+7?$" :question/worked-solution "For the two lines to be perpendicular, their slopes must multiply to $-1.$\n\nThe line $y=-\\frac{x}{2}+7$ is in slope-intercept form, and its slope is $-\\frac{1}{2}.$\n\nLooking at the answer choices, the line $y=2x+19$ has a slope of $2.$\n\nMultiplying the slopes together, we have\n\n$$\n-\\frac{1}{2}\\cdot 2=-1.\n$$\n\nSince the slopes multiply to $-1,$ we conclude that the line $y=2x+19$ is perpendicular to the given line."}] [{:db/id #edb/ref 17592186403592 :knowledge-point/_questions [{:db/id #edb/ref 17592186068900 :knowledge-point/id #uuid "66ade855-4b16-514b-b44a-1d6b9d61ef28" :knowledge-point/title "Identifying the Shift Applied to an Exponential Decay Curve"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "128902a2-01ba-574b-8cb8-9e24d91588d6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y={(\\frac{1}{2})}^{x}+3" :db/id #edb/ref 17592186403594} {:answer/id #uuid "d421b62c-91bc-51bd-9a1e-dcb674541fa2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y={(\\frac{1}{2})}^{x}" :db/id #edb/ref 17592186403595} {:answer/id #uuid "89b95e28-4bdc-577f-9fef-39eb015deed9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y={(\\frac{1}{2})}^{x}-1" :db/id #edb/ref 17592186403596} {:answer/id #uuid "1f9a6792-46dd-54a0-852a-c3ce900255d8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y={(\\frac{1}{2})}^{x}+1" :db/id #edb/ref 17592186403597} {:answer/id #uuid "cdf02042-68e8-57bc-821d-c4e709f6e6d5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y={(\\frac{1}{2})}^{x}+2" :db/id #edb/ref 17592186403598}] :answer-field/correct {:answer/id #uuid "1f9a6792-46dd-54a0-852a-c3ce900255d8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y={(\\frac{1}{2})}^{x}+1" :db/id #edb/ref 17592186403597} :answer-field/id #uuid "86226cb6-da89-5070-bdaf-be3482566831" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186403593}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "c80543b3-4997-5175-82f2-660b5af23e52" :question/math-academy-id "q-7253" :question/problem "![](images/50/50be1f4a894e86b5f06fba18655caca163c3d4c7a3423d2ecf159aa49975eb8c.png)\n\nThe graph above shows the curve $y={(\\frac{1}{2})}^{x}+c.$ Determine the value of $c$ and find the equation of the curve." :question/worked-solution "The horizontal asymptote of $y={(\\frac{1}{2})}^{x}$ is $y=0.$\n\nThe vertical translation $y={(\\frac{1}{2})}^{x}+c$ shifts the asymptote to $y=c.$\n\nIn the graph above, the horizontal asymptote is $y=1.$ Therefore, $c=1.$"}] [{:db/id #edb/ref 17592186069509 :knowledge-point/_questions [{:db/id #edb/ref 17592186068724 :knowledge-point/id #uuid "18ce1807-3a09-5ebd-b3cd-a91db8d2b4a8" :knowledge-point/title "Integrating a Rational Function Using Natural Logarithms"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1a56f775-026e-59fc-b647-34d85fe8bf61" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{ln}⁡|3{x}^{2}-1|+C" :db/id #edb/ref 17592186336275} {:answer/id #uuid "a1728457-38ba-5bbb-927c-7282a90dc1b9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{ln}⁡|{x}^{3}-1|+C" :db/id #edb/ref 17592186337496} {:answer/id #uuid "b51f8e66-052a-5029-8ff7-97299bdc0642" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{ln}⁡|{x}^{3}-x|+C" :db/id #edb/ref 17592186337639} {:answer/id #uuid "f743a007-0c6c-5682-a772-447548f069d7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{ln}⁡|3{x}^{2}-x|+C" :db/id #edb/ref 17592186338200} {:answer/id #uuid "f9436168-b71c-5730-9e91-324b6cdb60f6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{ln}⁡|\\frac{1}{{x}^{3}-1}|+C" :db/id #edb/ref 17592186338217}] :answer-field/correct {:answer/id #uuid "b51f8e66-052a-5029-8ff7-97299bdc0642" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{ln}⁡|{x}^{3}-x|+C" :db/id #edb/ref 17592186337639} :answer-field/id #uuid "e9839270-94f7-5e94-999d-41a70f88e25f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186338685}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "604f6b09-192e-50e6-8477-dce586313508" :question/math-academy-id "q-72566" :question/problem "$\\int \\frac{3{x}^{2}-1}{{x}^{3}-x}\\,\\text{d}x=$" :question/worked-solution "Let $u={x}^{3}-x.$ Then\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=3{x}^{2}-1\\,⟹\\,\\text{d}u=(3{x}^{2}-1)\\,\\text{d}x,\n$$\n\nand we can solve the resulting integral as follows:\n\n$$\n\\begin{aligned}\\int \\frac{3{x}^{2}-1}{{x}^{3}-x}\\,\\text{d}x & =\\int \\frac{1}{{x}^{3}-x}\\cdot (3{x}^{2}-1)\\,\\text{d}x \\\\  & =\\int \\frac{1}{u}\\,\\text{d}u \\\\  & =\\operatorname{ln}⁡|u|+C \\\\  & =\\operatorname{ln}⁡|{x}^{3}-x|+C\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186341834 :knowledge-point/_questions [{:db/id #edb/ref 17592186175923 :knowledge-point/id #uuid "44b9b212-27c4-5d6d-a221-cd85c25fc956" :knowledge-point/title "Finding the Equation of a Line Perpendicular to a Line Through Two Points"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "460f3e7e-a692-5e84-84d3-bb04895e42c1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=2x+9" :db/id #edb/ref 17592186339750} {:answer/id #uuid "7de51bcc-dba4-5f66-9ed1-e89e2285349b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=x+3" :db/id #edb/ref 17592186340264} {:answer/id #uuid "a496b65e-0fa0-5379-bb60-a181cb54a9be" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=\\frac{1}{2}x+6" :db/id #edb/ref 17592186340623} {:answer/id #uuid "dc1a70a6-b427-555b-b378-aaf49435f770" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=x+7" :db/id #edb/ref 17592186341084} {:answer/id #uuid "f252e1db-2d4f-5cfe-b195-696e6f606c03" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=\\frac{1}{2}x-3" :db/id #edb/ref 17592186341262}] :answer-field/correct {:answer/id #uuid "a496b65e-0fa0-5379-bb60-a181cb54a9be" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y=\\frac{1}{2}x+6" :db/id #edb/ref 17592186340623} :answer-field/id #uuid "f4e67ea3-0bdd-589c-834c-8bb372afcf1d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186341816}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "99fe5e6a-20b3-53d0-a013-c1c2c0d3ad0c" :question/math-academy-id "q-72568" :question/problem "Find the equation of the line that passes through the point $(-2,5)$ and is perpendicular to the line passing through the points $(6,1)$ and $(4,5).$" :question/worked-solution "Perpendicular lines have slopes which are negative reciprocals of each other.\n\nFirst, let's find the slope ${m}_{1}$ of the line passing through the points $(6,1)$ and $(4,5):$\n\n$$\n\\begin{aligned}{m}_{1} & =\\frac{{y}_{2}-{y}_{1}}{{x}_{2}-{x}_{1}} \\\\  & =\\frac{5-1}{4-6} \\\\  & =\\frac{4}{-2} \\\\  & =-2\\end{aligned}\n$$\n\nSince we want a perpendicular line, the slope $m$ of the line we're trying to find must satisfy\n\n$$\nm\\cdot (-2)=-1\\,⇒\\,m=\\frac{1}{2}.\n$$\n\nWe know that the line passes through the point $(-2,5).$ Using point-slope form and simplifying, we obtain the equation of the line:\n\n$$\n\\begin{aligned}y-{y}_{1} & =m(x-{x}_{1}) \\\\ y-5 & =\\frac{1}{2}(x-(-2)) \\\\ y-5 & =\\frac{1}{2}(x+2) \\\\ y-5 & =\\frac{1}{2}x+1 \\\\ y & =\\frac{1}{2}x+6\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186341836 :knowledge-point/_questions [{:db/id #edb/ref 17592186175924 :knowledge-point/id #uuid "c52fd5dd-780e-5dab-805f-561383873dd4" :knowledge-point/title "Finding the Equation of a Line Perpendicular to a Line in Standard Form"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3e1988b7-4bc8-5bda-86c5-639e0552dedd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2x-3y=7" :db/id #edb/ref 17592186339683} {:answer/id #uuid "51dac7ff-2d97-5661-b543-ad769758a707" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x+y=6" :db/id #edb/ref 17592186339880} {:answer/id #uuid "6d11b816-6f21-575c-a776-01785873cb84" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2x-3y=5" :db/id #edb/ref 17592186340089} {:answer/id #uuid "803a7a88-7553-50e1-862d-0b786cfc737c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2x+3y=13" :db/id #edb/ref 17592186340279} {:answer/id #uuid "af6755f9-b09b-562d-a589-5067ac2ec549" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2x+3y=7" :db/id #edb/ref 17592186340728}] :answer-field/correct {:answer/id #uuid "803a7a88-7553-50e1-862d-0b786cfc737c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2x+3y=13" :db/id #edb/ref 17592186340279} :answer-field/id #uuid "58e7ea68-a247-56ce-a08d-252af6a5df70" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186341536}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "ad191a02-5856-5306-8980-ab9514c55d3b" :question/math-academy-id "q-72571" :question/problem "Find the equation of the line that passes through the point $(5,1)$ and is perpendicular to the line passing through the points $(1,5)$ and $(-3,-1).$" :question/worked-solution "Perpendicular lines have slopes which are negative reciprocals of each other.\n\nFirst, let's find the slope ${m}_{1}$ of the line passing through the points $(1,5)$ and $(-3,-1):$\n\n$$\n\\begin{aligned}{m}_{1} & =\\frac{{y}_{2}-{y}_{1}}{{x}_{2}-{x}_{1}} \\\\  & =\\frac{-1-5}{-3-1} \\\\  & =\\frac{-6}{-4} \\\\  & =\\frac{3}{2}\\end{aligned}\n$$\n\nSince we want a perpendicular line, the slope $m$ of the line we're trying to find must satisfy\n\n$$\nm\\cdot (\\frac{3}{2})=-1\\,⇒\\,m=-\\frac{2}{3}.\n$$\n\nWe know that the line passes through the point $(5,1).$ Using point-slope form and simplifying, we obtain the equation of the line:\n\n$$\n\\begin{aligned}y-{y}_{1} & =m(x-{x}_{1}) \\\\ y-1 & =-\\frac{2}{3}(x-5) \\\\ y-1 & =-\\frac{2}{3}x+\\frac{10}{3} \\\\ y & =-\\frac{2}{3}x+\\frac{13}{3}\\end{aligned}\n$$\n\nHowever, we want to write the equation in standard form. So, we will bring the $x$ term to the left-hand side and multiply both sides of the equation by $3:$\n\n$$\n\\begin{aligned}y & =-\\frac{2}{3}x+\\frac{13}{3} \\\\ \\frac{2}{3}x+y & =\\frac{13}{3} \\\\ 3\\cdot (\\frac{2}{3}x+y) & =3\\cdot \\frac{13}{3} \\\\ 2x+3y & =13\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186405146 :knowledge-point/_questions [{:db/id #edb/ref 17592186129113 :knowledge-point/id #uuid "f5d1d859-0b86-5507-a7bf-3d805a85adf3" :knowledge-point/title "Identifying Augmented Matrices in Row Echelon Form"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9415a6bc-b845-5416-a630-c09cf1de4075" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$A$ and $C$ only" :db/id #edb/ref 17592186405148} {:answer/id #uuid "d774e169-e628-59dd-b3d3-32eef4cc221b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$A$ only" :db/id #edb/ref 17592186405149} {:answer/id #uuid "820bcbf2-b300-5622-88e4-cea1d1927af8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$A$ and $B$ only" :db/id #edb/ref 17592186405150} {:answer/id #uuid "6a49ee16-b14b-5b39-9515-f019516811a9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$C$ only" :db/id #edb/ref 17592186405151} {:answer/id #uuid "47b78352-073a-55e3-977a-ffd9d1cb0ba1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$B$ only" :db/id #edb/ref 17592186405152}] :answer-field/correct {:answer/id #uuid "47b78352-073a-55e3-977a-ffd9d1cb0ba1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$B$ only" :db/id #edb/ref 17592186405152} :answer-field/id #uuid "cca85be9-de3b-5573-9094-83fec95f1da6" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186405147}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "bbb2727c-01c4-5345-9e38-1d38c7fb43da" :question/math-academy-id "q-72575" :question/problem "Which of the following augmented matrices have coefficient matrices that are **not** in row echelon form? Treat the final column of each augmented matrix as its constants column.\n\n$$\nA=[\\begin{aligned}1 & 2 & -3 & 0 \\\\ 0 & 2 & 0 & 3 \\\\ 0 & 0 & 0 & 3 \\\\ 0 & 0 & 0 & 4\\end{aligned}],\\,B=[\\begin{aligned}0 & 0 & 4 & 9 \\\\ 0 & 3 & 0 & 1 \\\\ 2 & 1 & 5 & 5\\end{aligned}],\\,C=[\\begin{aligned}2 & 0 & 0 & 0 & -1 & 6 \\\\ 0 & -2 & 0 & 0 & 2 & 4 \\\\ 0 & 0 & 0 & 0 & -3 & 1\\end{aligned}].\n$$" :question/worked-solution "A coefficient matrix, obtained by omitting the final column of its augmented matrix, is in row echelon form if it satisfies the following conditions:\n\n- All the zero rows (rows with only zeros), if any, are placed at the *bottom* of the matrix.\n- Each leading entry of a row is in a column *to the right* of the leading entry of the row above it.\n\nWith that in mind, let's look at each matrix in turn.\n\n- The coefficient matrix of $A$ is in row echelon form (both conditions are satisfied).\n\n$$\nA=[\\begin{aligned}1 & 2 & -3 & 0 \\\\ 0 & 2 & 0 & 3 \\\\ 0 & 0 & 0 & 3 \\\\ 0 & 0 & 0 & 4\\end{aligned}]\n$$\n\n- The coefficient matrix of $B$ is not in row echelon form since the leading entries of its first two rows are in columns $3$ and $2,$ respectively (condition II is violated).\n\n$$\nB=[\\begin{aligned}0 & 0 & 4 & 9 \\\\ 0 & 3 & 0 & 1 \\\\ 2 & 1 & 5 & 5\\end{aligned}]\n$$\n\n- The coefficient matrix of $C$ is in row echelon form (both conditions are satisfied).\n\n$$\nC=[\\begin{aligned}2 & 0 & 0 & 0 & -1 & 6 \\\\ 0 & -2 & 0 & 0 & 2 & 4 \\\\ 0 & 0 & 0 & 0 & -3 & 1\\end{aligned}]\n$$\n\nTherefore, only $B$ has a coefficient matrix that is **not** in row echelon form."}] [{:db/id #edb/ref 17592186341840 :knowledge-point/_questions [{:db/id #edb/ref 17592186068724 :knowledge-point/id #uuid "18ce1807-3a09-5ebd-b3cd-a91db8d2b4a8" :knowledge-point/title "Integrating a Rational Function Using Natural Logarithms"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "424f1750-2255-5cd3-97f1-bff8ae1f779e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2\\operatorname{ln}⁡|2-5{x}^{5}|+C" :db/id #edb/ref 17592186339710} {:answer/id #uuid "64a24bd8-02d1-5da1-875a-ff8313d79449" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2}{5(2-5{x}^{5})^{2}}+C" :db/id #edb/ref 17592186340018} {:answer/id #uuid "cd66158f-066f-573b-a023-86fcc42573cc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{5}{2(2-5{x}^{5})^{2}}+C" :db/id #edb/ref 17592186340950} {:answer/id #uuid "d40a6f74-0d5f-5192-b1f2-24adfd672a83" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5}{2}\\operatorname{ln}⁡|2-5{x}^{5}|+C" :db/id #edb/ref 17592186341003} {:answer/id #uuid "f1c87e78-2256-558f-a463-3af7ee7e05a4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{2}{5}\\operatorname{ln}⁡|2-5{x}^{5}|+C" :db/id #edb/ref 17592186341259}] :answer-field/correct {:answer/id #uuid "f1c87e78-2256-558f-a463-3af7ee7e05a4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{2}{5}\\operatorname{ln}⁡|2-5{x}^{5}|+C" :db/id #edb/ref 17592186341259} :answer-field/id #uuid "c4f33047-2f0b-50bf-84ac-e403b1fabf2c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186341723}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "958efc2b-d91b-53e5-b712-1690bc1b7068" :question/math-academy-id "q-72605" :question/problem "$\\int \\frac{10{x}^{4}}{2-5{x}^{5}}\\,\\text{d}x=$" :question/worked-solution "Let $u=2-5{x}^{5}.$ Then\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=-25{x}^{4}\\,⟹\\,(-\\frac{1}{25})\\text{d}u={x}^{4}\\,\\text{d}x,\n$$\n\nand we can solve the resulting integral as follows:\n\n$$\n\\begin{aligned}\\int \\frac{10{x}^{4}}{2-5{x}^{5}}\\,\\text{d}x & =10\\int \\frac{1}{2-5{x}^{5}}\\cdot {x}^{4}\\,\\text{d}x \\\\  & =10\\int \\frac{1}{u}\\cdot (-\\frac{1}{25})\\text{d}u \\\\  & =-\\frac{10}{25}\\int \\frac{1}{u}\\,\\text{d}u \\\\  & =-\\frac{2}{5}\\int \\frac{1}{u}\\,\\text{d}u \\\\  & =-\\frac{2}{5}\\operatorname{ln}⁡|u|+C \\\\  & =-\\frac{2}{5}\\operatorname{ln}⁡|2-5{x}^{5}|+C\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186341843 :knowledge-point/_questions [{:db/id #edb/ref 17592186087768 :knowledge-point/id #uuid "3520d323-c6a4-5bce-bac1-1f4c02bd0068" :knowledge-point/title "Finding the Equation of a Circle Given the Center and a Point on the Circle"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "44ceba2e-461c-5d6f-94d0-fffabcaa7f4e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(x-3)^{2}+(y-3)^{2}=\\sqrt{41}" :db/id #edb/ref 17592186339737} {:answer/id #uuid "67364410-21ff-5ab6-b499-984469e0f0b3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(x-3)^{2}+(y+3)^{2}=41" :db/id #edb/ref 17592186340042} {:answer/id #uuid "7e6b7a0c-3051-526a-9636-efd77cb0b591" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(x+3)^{2}+(y+3)^{2}=41" :db/id #edb/ref 17592186340268} {:answer/id #uuid "c00a31e7-30ad-5958-a723-a2568cb7ceb8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(x-3)^{2}+(y+3)^{2}=\\sqrt{41}" :db/id #edb/ref 17592186340844} {:answer/id #uuid "ccdecbe3-6add-5929-86dd-7b81307f2bae" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(x+3)^{2}+(y+3)^{2}=\\sqrt{41}" :db/id #edb/ref 17592186340941}] :answer-field/correct {:answer/id #uuid "67364410-21ff-5ab6-b499-984469e0f0b3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(x-3)^{2}+(y+3)^{2}=41" :db/id #edb/ref 17592186340042} :answer-field/id #uuid "59370454-96d7-5c69-8869-e408beefd110" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186341537}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "b538b794-53e2-55d6-941e-f772138f1dd6" :question/math-academy-id "q-72621" :question/problem "![](images/6e/6e68ede9db2528ea607fc6fd63f0ec4ca1c1378982239913ef49153e1cf5b609.png)\n\nThe circle above is centered at $C(3,-3)$ and the point $X(-1,2)$ lies on the circumference. Find the equation of the circle." :question/worked-solution "The general equation of a circle with radius $r$ centered at the point $(a,b)$ is\n\n$$\n(x-a)^{2}+(y-b)^{2}={r}^{2}.\n$$\n\nThe length of the radius is \n\n$$\n\\begin{aligned}CX & =\\sqrt{{(-1-3)}^{2}+{(2-(-3))}^{2}} \\\\  & =\\sqrt{(-4)^{2}+{5}^{2}} \\\\  & =\\sqrt{41}.\\end{aligned}\n$$\n\nSo, our circle is generated by the following equation:\n\n$$\n\\begin{aligned}(x-a)^{2}+(y-b)^{2} & ={r}^{2} \\\\ (x-3)^{2}+(y-(-3))^{2} & =(\\sqrt{41})^{2} \\\\ (x-3)^{2}+(y+3)^{2} & =41\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186341845 :knowledge-point/_questions [{:db/id #edb/ref 17592186059641 :knowledge-point/id #uuid "3332b534-bd04-5e86-995e-1e6d691d8e1b" :knowledge-point/title "Simplifying an Expression by Factoring and Using the Pythagorean Identity"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "733d9013-5828-5e8a-a6ca-98d0ee84db3d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2\\operatorname{sin}⁡x+\\operatorname{cos}⁡x" :db/id #edb/ref 17592186340151} {:answer/id #uuid "9e08cb06-fa94-559a-b45f-0247593ae993" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{sin}⁡x-\\operatorname{cos}⁡x" :db/id #edb/ref 17592186340553} {:answer/id #uuid "ce427bad-7fbf-553d-94e7-4eac1f2a458e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{sin}⁡x+3\\operatorname{cos}⁡x" :db/id #edb/ref 17592186340960} {:answer/id #uuid "d512d53f-d1ef-5fcf-a459-a5ecee4d6396" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{sin}⁡x+2\\operatorname{cos}⁡x" :db/id #edb/ref 17592186341012} {:answer/id #uuid "ddb559b7-bf25-5a4d-8461-b1784d7b4dd7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\operatorname{sin}⁡x+\\operatorname{cos}⁡x" :db/id #edb/ref 17592186341097}] :answer-field/correct {:answer/id #uuid "d512d53f-d1ef-5fcf-a459-a5ecee4d6396" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{sin}⁡x+2\\operatorname{cos}⁡x" :db/id #edb/ref 17592186341012} :answer-field/id #uuid "7c77d87a-34f1-5f64-8f04-06a22766d6be" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186341597}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "5b1e203a-fce6-56f0-bd3a-5a969f3f611d" :question/math-academy-id "q-72711" :question/problem "Simplify the trigonometric expression $\\operatorname{sin}⁡x+2{cos}^{3}⁡x+2{sin}^{2}⁡x\\operatorname{cos}⁡x.$" :question/worked-solution "First, we factor the expression:\n\n$$\n\\operatorname{sin}⁡x+2{cos}^{3}⁡x+2{sin}^{2}⁡x\\operatorname{cos}⁡x=\\operatorname{sin}⁡x+2\\operatorname{cos}⁡x({cos}^{2}⁡x+{sin}^{2}⁡x)\n$$\n\nThen, we use ${cos}^{2}⁡x+{sin}^{2}⁡x=1$ to simplify the expression in the parentheses:\n\n$$\n\\begin{aligned}\\operatorname{sin}⁡x+2\\operatorname{cos}⁡x({cos}^{2}⁡x+{sin}^{2}⁡x) & =\\operatorname{sin}⁡x+2\\operatorname{cos}⁡x\\cdot 1 \\\\  & =\\operatorname{sin}⁡x+2\\operatorname{cos}⁡x\\end{aligned}\n$$\n\nHence, we conclude that\n\n$$\n\\operatorname{sin}⁡x+2{cos}^{3}⁡x+2{sin}^{2}⁡x\\operatorname{cos}⁡x=\\operatorname{sin}⁡x+2\\operatorname{cos}⁡x.\n$$"}] [{:db/id #edb/ref 17592186341846 :knowledge-point/_questions [{:db/id #edb/ref 17592186059642 :knowledge-point/id #uuid "868125f0-22e0-57fc-9620-f3242419a689" :knowledge-point/title "Simplifying a Rational Expression Using the Pythagorean Identity"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "18d5cf9e-61a5-56dc-ab85-48cc3361b6cc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\operatorname{tan}⁡x+\\operatorname{sec}⁡x" :db/id #edb/ref 17592186339348} {:answer/id #uuid "2a4a8bfb-24ab-5d4f-85c0-b03c7be1078c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\operatorname{tan}⁡x" :db/id #edb/ref 17592186339502} {:answer/id #uuid "5af65e91-2dda-5a02-a6b9-84e591e12cdb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{tan}⁡x+1" :db/id #edb/ref 17592186339956} {:answer/id #uuid "94adee08-1ae4-5711-87c2-0b92afcedb4b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{tan}⁡x+\\operatorname{sec}⁡x" :db/id #edb/ref 17592186340463} {:answer/id #uuid "a2128603-79a4-5ac2-aad8-d0e79ce06174" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\operatorname{tan}⁡x-\\operatorname{sec}⁡x" :db/id #edb/ref 17592186340599}] :answer-field/correct {:answer/id #uuid "94adee08-1ae4-5711-87c2-0b92afcedb4b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{tan}⁡x+\\operatorname{sec}⁡x" :db/id #edb/ref 17592186340463} :answer-field/id #uuid "7ffbbed8-ad51-5238-b319-cf240d8126f8" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186341605}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "508dcfe6-ec7a-5fa0-ab23-63e62cd88ad5" :question/math-academy-id "q-72712" :question/problem "Simplify the trigonometric expression $\\frac{{sin}^{3}⁡x+\\operatorname{sin}⁡x{cos}^{2}⁡x+1}{\\operatorname{cos}⁡x}.$" :question/worked-solution "First, we factor $\\operatorname{sin}⁡x$ from the first two terms:\n\n$$\n\\frac{{sin}^{3}⁡x+\\operatorname{sin}⁡x{cos}^{2}⁡x+1}{\\operatorname{cos}⁡x}=\\frac{\\operatorname{sin}⁡x({sin}^{2}⁡x+{cos}^{2}⁡x)+1}{\\operatorname{cos}⁡x}\n$$\n\nNext, we use the Pythagorean identity to rewrite the expression in the parentheses, and then we simplify the resulting expression as much as possible:\n\n$$\n\\begin{aligned}\\frac{\\operatorname{sin}⁡x({sin}^{2}⁡x+{cos}^{2}⁡x)+1}{\\operatorname{cos}⁡x} & =\\frac{\\operatorname{sin}⁡x+1}{\\operatorname{cos}⁡x} \\\\  & =\\frac{\\operatorname{sin}⁡x}{\\operatorname{cos}⁡x}+\\frac{1}{\\operatorname{cos}⁡x} \\\\  & =\\operatorname{tan}⁡x+\\operatorname{sec}⁡x\\end{aligned}\n$$\n\nHence, we conclude that:\n\n$$\n\\frac{{sin}^{3}⁡x+\\operatorname{sin}⁡x{cos}^{2}⁡x+1}{\\operatorname{cos}⁡x}=\\operatorname{tan}⁡x+\\operatorname{sec}⁡x\n$$"}] [{:db/id #edb/ref 17592186385557 :knowledge-point/_questions [{:db/id #edb/ref 17592186119775 :knowledge-point/id #uuid "74764043-e1e7-56d6-8f53-9d287a30e538" :knowledge-point/title "Calculating a Determinant After Switching Two Rows"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "07c9312f-a209-5f87-ba1c-5386579d3bd4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "69" :db/id #edb/ref 17592186385559} {:answer/id #uuid "66f9fe22-3a07-5c23-9891-3cd2ed9aaf28" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-69" :db/id #edb/ref 17592186385560} {:answer/id #uuid "021f7c92-ef0d-5de9-bbfa-11ad3cbd3683" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "23" :db/id #edb/ref 17592186385561} {:answer/id #uuid "ccfef29b-6d70-59f9-a92f-9b34777975d3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "Undefined" :db/id #edb/ref 17592186385562} {:answer/id #uuid "eb51bd1c-5c18-5345-9235-64937bfb3725" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186385563}] :answer-field/correct {:answer/id #uuid "07c9312f-a209-5f87-ba1c-5386579d3bd4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "69" :db/id #edb/ref 17592186385559} :answer-field/id #uuid "e5c1ce63-8b9e-5445-9f07-9e20c1f3be11" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186385558}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "457d76f4-06af-5356-9e00-91c260ff5a27" :question/math-academy-id "q-72725" :question/problem "Suppose $C$ is a $9\\times 9$ matrix and $det(C)=-69.$ The matrix $D$ is obtained from $C$ by applying the elementary row operation ${R}_{5}↔{R}_{8}$ (switching the fifth and the eighth rows). What is the value of $det(D)?$" :question/worked-solution "Since swapping any two rows changes the sign of the determinant to the opposite sign, we have\n\n$$\n\\begin{aligned}det(D) & =-det(C) \\\\  & =-(-69) \\\\  & =69.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186393215 :knowledge-point/_questions [{:db/id #edb/ref 17592186092184 :knowledge-point/id #uuid "4691976a-d825-5f6c-aed7-0d9b45560952" :knowledge-point/title "Solving a 2x2 System of Equations Using an Inverse Matrix With Reorganization"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "40c24857-06a2-5e0b-85d2-5f2b717c9839" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=-\\frac{1}{7}[\\begin{aligned}2 & -1 \\\\ 1 & 3\\end{aligned}][\\begin{aligned}4 \\\\ -1\\end{aligned}]" :db/id #edb/ref 17592186393217} {:answer/id #uuid "54b091df-4df8-574b-ab7b-0a3fde77dee4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=\\frac{1}{5}[\\begin{aligned}2 & -1 \\\\ 1 & 3\\end{aligned}][\\begin{aligned}4 \\\\ -1\\end{aligned}]" :db/id #edb/ref 17592186393218} {:answer/id #uuid "30420fca-ad93-57fd-ba3b-06ad555ade16" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=\\frac{1}{7}[\\begin{aligned}2 & 1 \\\\ -1 & 3\\end{aligned}][\\begin{aligned}4 \\\\ -1\\end{aligned}]" :db/id #edb/ref 17592186393219} {:answer/id #uuid "e0dddfb6-deca-5831-988a-cc662b273194" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=\\frac{1}{5}[\\begin{aligned}3 & 1 \\\\ -1 & 2\\end{aligned}][\\begin{aligned}4 \\\\ -1\\end{aligned}]" :db/id #edb/ref 17592186393220} {:answer/id #uuid "4d2b60cb-753e-5c81-be84-11c5779434a8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=\\frac{1}{7}[\\begin{aligned}1 & 2 \\\\ 3 & -1\\end{aligned}][\\begin{aligned}4 \\\\ -1\\end{aligned}]" :db/id #edb/ref 17592186393221}] :answer-field/correct {:answer/id #uuid "30420fca-ad93-57fd-ba3b-06ad555ade16" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=\\frac{1}{7}[\\begin{aligned}2 & 1 \\\\ -1 & 3\\end{aligned}][\\begin{aligned}4 \\\\ -1\\end{aligned}]" :db/id #edb/ref 17592186393219} :answer-field/id #uuid "b977679f-6256-57c2-8887-0c386f7a473b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186393216}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "cf30e2dd-fc54-551b-b230-ad61e11fe0db" :question/math-academy-id "q-72726" :question/problem "Which of the following represents the solution to the system of linear equations given below?\n\n$$\n\\{\\begin{aligned}3x-y=4 \\\\ x=-2y-1\\end{aligned}\n$$" :question/worked-solution "First, we reorganize the equations so that they are in the right order, to get\n\n$$\n\\{\\begin{aligned}3x-y=4 \\\\ x+2y=-1.\\end{aligned}\n$$\n\nNow, we can represent this system of equations in the form $Ax=b:$\n\n$$\n[\\begin{aligned}3 & -1 \\\\ 1 & 2\\end{aligned}][\\begin{aligned}x \\\\ y\\end{aligned}]=[\\begin{aligned}4 \\\\ -1\\end{aligned}].\n$$\n\nTo find the solution, we need to calculate the inverse of the coefficient matrix $A=[\\begin{aligned}3 & -1 \\\\ 1 & 2\\end{aligned}].$ This gives\n\n$$\n\\begin{aligned}{A}^{-1} & =\\frac{1}{3\\cdot 2-(-1)\\cdot 1}[\\begin{aligned}2 & 1 \\\\ -1 & 3\\end{aligned}] \\\\  & =\\frac{1}{7}[\\begin{aligned}2 & 1 \\\\ -1 & 3\\end{aligned}].\\end{aligned}\n$$\n\nWe can now find the solution to this system as:\n\n$$\n\\begin{aligned}x & ={A}^{-1}b \\\\  & =\\frac{1}{7}[\\begin{aligned}2 & 1 \\\\ -1 & 3\\end{aligned}][\\begin{aligned}4 \\\\ -1\\end{aligned}]\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186341852 :knowledge-point/_questions [{:db/id #edb/ref 17592186092184 :knowledge-point/id #uuid "4691976a-d825-5f6c-aed7-0d9b45560952" :knowledge-point/title "Solving a 2x2 System of Equations Using an Inverse Matrix With Reorganization"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0cae29bf-6657-5948-b4ac-de9d15a83b80" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=[\\begin{aligned}-1 & -1 \\\\ 1 & 2\\end{aligned}][\\begin{aligned}2 \\\\ 1\\end{aligned}]" :db/id #edb/ref 17592186339243} {:answer/id #uuid "1c79ef91-d60f-5461-9182-a09de75ab44e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=[\\begin{aligned}1 & 1 \\\\ -1 & -2\\end{aligned}][\\begin{aligned}0 \\\\ 2\\end{aligned}]" :db/id #edb/ref 17592186339373} {:answer/id #uuid "50658568-e9ab-5946-9ac1-0eb64885c225" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=[\\begin{aligned}2 & 1 \\\\ -1 & -1\\end{aligned}][\\begin{aligned}1 \\\\ 2\\end{aligned}]" :db/id #edb/ref 17592186339861} {:answer/id #uuid "7a038809-9690-59a5-9f4d-8538600ea5bc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=[\\begin{aligned}1 & -1 \\\\ -2 & 1\\end{aligned}][\\begin{aligned}2 \\\\ 0\\end{aligned}]" :db/id #edb/ref 17592186340216} {:answer/id #uuid "af86119f-4c68-5d25-8752-90c8805840da" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=[\\begin{aligned}1 & -1 \\\\ 1 & -2\\end{aligned}][\\begin{aligned}1 \\\\ 2\\end{aligned}]" :db/id #edb/ref 17592186340730}] :answer-field/correct {:answer/id #uuid "af86119f-4c68-5d25-8752-90c8805840da" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=[\\begin{aligned}1 & -1 \\\\ 1 & -2\\end{aligned}][\\begin{aligned}1 \\\\ 2\\end{aligned}]" :db/id #edb/ref 17592186340730} :answer-field/id #uuid "39ce73d2-08ab-546f-9ccf-5116afbbd6e4" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186341484}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "ae55f4eb-c009-586b-a5eb-f77f0f124cd0" :question/math-academy-id "q-72733" :question/problem "Which of the following represents the solution to the system of linear equations given below?\n\n$$\n\\begin{aligned}\\{\\begin{aligned}2x=y+1 \\\\ x-y=2\\end{aligned}\\end{aligned}\n$$" :question/worked-solution "First, we reorganize the equations so that they are in the right order, to get\n\n$$\n\\begin{aligned}\\{\\begin{aligned}2x-y=1 \\\\ x-y=2\\end{aligned}\\end{aligned}\n$$\n\nNow, we can represent this system of equations in the form $Ax=b:$\n\n$$\n[\\begin{aligned}2 & -1 \\\\ 1 & -1\\end{aligned}][\\begin{aligned}x \\\\ y\\end{aligned}]=[\\begin{aligned}1 \\\\ 2\\end{aligned}].\n$$\n\nTo find the solution, we need to calculate the inverse of the coefficient matrix $A=[\\begin{aligned}2 & -1 \\\\ 1 & -1\\end{aligned}].$ This gives\n\n$$\n\\begin{aligned}{A}^{-1} & =\\frac{1}{(-1)\\cdot 2-(-1)\\cdot 1}[\\begin{aligned}-1 & 1 \\\\ -1 & 2\\end{aligned}] \\\\  & =\\frac{1}{-1}[\\begin{aligned}-1 & 1 \\\\ -1 & 2\\end{aligned}] \\\\  & =[\\begin{aligned}1 & -1 \\\\ 1 & -2\\end{aligned}].\\end{aligned}\n$$\n\nWe can now represent the solution to this system, as follows:\n\n$$\n\\begin{aligned}x & ={A}^{-1}b \\\\  & =[\\begin{aligned}1 & -1 \\\\ 1 & -2\\end{aligned}][\\begin{aligned}1 \\\\ 2\\end{aligned}]\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186393222 :knowledge-point/_questions [{:db/id #edb/ref 17592186059772 :knowledge-point/id #uuid "c27a3f3c-77c7-55e9-8714-1f24c4a48063" :knowledge-point/title "Applying Row Operations To an Augmented Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6756ed00-330f-5c8c-8a4d-fbb86cdc2c8e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & 3 & 2 \\\\ 0 & 5 & 4\\end{aligned}]" :db/id #edb/ref 17592186393224} {:answer/id #uuid "8dfcb35e-95c9-5403-a320-dcd7face84d5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & 3 & 2 \\\\ 0 & -5 & -4\\end{aligned}]" :db/id #edb/ref 17592186393225} {:answer/id #uuid "d3557d97-0c1d-5853-b9fd-91ee81522e54" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & 3 & 2 \\\\ 0 & 4 & -5\\end{aligned}]" :db/id #edb/ref 17592186393226} {:answer/id #uuid "7936a577-d3bd-55bd-b9c4-bfcbd8d64f15" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & 3 & 2 \\\\ 0 & -4 & 5\\end{aligned}]" :db/id #edb/ref 17592186393227} {:answer/id #uuid "3c473b8d-8970-5a89-afb6-b17390deb661" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & 3 & 2 \\\\ 0 & 4 & 5\\end{aligned}]" :db/id #edb/ref 17592186393228}] :answer-field/correct {:answer/id #uuid "3c473b8d-8970-5a89-afb6-b17390deb661" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & 3 & 2 \\\\ 0 & 4 & 5\\end{aligned}]" :db/id #edb/ref 17592186393228} :answer-field/id #uuid "43860d4a-16fb-54d3-8d76-5164ce10d9b3" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186393223}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "7e529998-60b8-53c0-bae5-50351fb55c46" :question/math-academy-id "q-72757" :question/problem "Consider the augmented matrix $T,$ given by\n\n$$\nT=[\\begin{aligned}1 & 3 & 2 \\\\ -2 & -2 & 1\\end{aligned}].\n$$\n\nWhat matrix results from carrying out the row operation ${R}_{2}:={R}_{2}+2{R}_{1}$ on $T?$" :question/worked-solution "The operation ${R}_{2}:={R}_{2}+2{R}_{1}$ means that we need to add $2$ times the first row to the second row. \n\nApplying this row operation, we obtain the following:  \n\n$$\n\\begin{aligned}T & =[\\begin{aligned}1 & 3 & 2 \\\\ -2 & -2 & 1\\end{aligned}]\\,{R}_{2}:={R}_{2}+2\\cdot {R}_{1} \\\\  & ∼[\\begin{aligned}1 & 3 & 2 \\\\ -2+(2)(1) & -2+(2)(3) & 1+(2)(2)\\end{aligned}] \\\\  & ∼[\\begin{aligned}1 & 3 & 2 \\\\ 0 & 4 & 5\\end{aligned}]\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186341858 :knowledge-point/_questions [{:db/id #edb/ref 17592186105906 :knowledge-point/id #uuid "5dd3dcff-06d2-5d61-9863-0f5b541d8d4b" :knowledge-point/title "Finding the Area of a Triangle Given the Area of a Quadrilateral"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0f07a6b5-32ea-529d-9160-238820145dc6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "34{\\text{ cm}}^{2}" :db/id #edb/ref 17592186339267} {:answer/id #uuid "174b9032-2956-564a-826e-c2c81592003e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "23{\\text{ cm}}^{2}" :db/id #edb/ref 17592186339336} {:answer/id #uuid "508acfdf-0761-5691-be12-cc8ecd53beb4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "19{\\text{ cm}}^{2}" :db/id #edb/ref 17592186339862} {:answer/id #uuid "84059e1d-50ea-57c1-a02c-e73cba67744f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "13{\\text{ cm}}^{2}" :db/id #edb/ref 17592186340317} {:answer/id #uuid "f79db4a6-d5f5-5ae3-9697-f4ab3f3df76c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "25{\\text{ cm}}^{2}" :db/id #edb/ref 17592186341318}] :answer-field/correct {:answer/id #uuid "508acfdf-0761-5691-be12-cc8ecd53beb4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "19{\\text{ cm}}^{2}" :db/id #edb/ref 17592186339862} :answer-field/id #uuid "ea1b3e9c-7be4-50dc-84b7-55a05c94254f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186341796}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "d86eb6a4-4303-50bf-b47a-fa898e3f8037" :question/math-academy-id "q-72764" :question/problem "![](images/f5/f53996727138b9442ac041cf492618db8287b54ba652c4f9e375cdde27dc1862.png)\n\nThe area of $ABCD$ is $34{\\text{ cm}}^{2}.$   What is the area of $△BCD$ rounded to the nearest integer?" :question/worked-solution "Let's start by finding the area of $△ABD.$ We get \n\n$$\n\\begin{aligned}{A}_{△ABD} & =\\frac{1}{2}\\cdot AB\\cdot AD\\cdot \\operatorname{sin}⁡A \\\\  & =\\frac{1}{2}\\cdot 9\\cdot 15\\cdot \\operatorname{sin}⁡{52}^{∘} \\\\  & =67.5\\cdot \\operatorname{sin}⁡{52}^{∘} \\\\  & =53.190… \\\\  & ≈53{\\text{ cm}}^{2}\\end{aligned}\n$$\n\nrounded to the nearest integer.\n\nThe difference of the areas of $△ABD$ and the quadrilateral $ABCD$ gives the area of $△BCD.$ Therefore, \n\n$$\n\\begin{aligned}{A}_{△BCD} & ={A}_{△ABD}-{A}_{ABCD} \\\\  & =53-34 \\\\  & =19{\\text{ cm}}^{2}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186341859 :knowledge-point/_questions [{:db/id #edb/ref 17592186105905 :knowledge-point/id #uuid "3173d361-b91d-5699-97d8-6595ef59d0a3" :knowledge-point/title "Calculating the Area of a Quadrilateral"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4d011d15-855e-593b-a305-503c6f4d7b4a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "65" :db/id #edb/ref 17592186339829} {:answer/id #uuid "5049855a-0cf1-52ff-a6d7-82ad580a1998" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "135" :db/id #edb/ref 17592186339858} {:answer/id #uuid "65970e9b-6b55-55f9-87cb-642a2bfcf59a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "132" :db/id #edb/ref 17592186340026} {:answer/id #uuid "810e57dc-6211-51e2-9530-7c30c274a5a4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "98" :db/id #edb/ref 17592186340286} {:answer/id #uuid "941f7586-f901-520c-ba5a-d3f77fa4895c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "112" :db/id #edb/ref 17592186340460}] :answer-field/correct {:answer/id #uuid "5049855a-0cf1-52ff-a6d7-82ad580a1998" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "135" :db/id #edb/ref 17592186339858} :answer-field/id #uuid "59a7e60a-6a2a-50ed-b8ee-1ebc1c309e07" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186341540}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "c1e965d5-3d0b-5c28-9671-3eb1e1598d0f" :question/math-academy-id "q-72768" :question/problem "![](images/36/36af7324fd2112d94feddc5a1a02a91d97bbc0866cb93a6ca711dd73f566305a.png)\n\nFind, to the nearest integer, the area of the parallelogram $ABCD.$" :question/worked-solution "The diagonal $\\overset{―}{AC}$ divides the parallelogram into two congruent triangles. Therefore, the area of the parallelogram is twice the area of $△ACB$ (see the illustration below).\n\n![](images/7c/7cfcb5cdf77b4afbf25afd64e37bb33f0ab2c211e09659181bfc16db0ccd2db7.png)\n\n Computing the area of $△ACB,$ we find\n \n\n$$\n\\begin{aligned}{A}_{ACD} & =\\frac{1}{2}(18)(8)\\operatorname{sin}⁡{70}^{∘} \\\\  & =72\\cdot \\operatorname{sin}⁡{70}^{∘} \\\\  & ≈67.658,\\end{aligned}\n$$\n\nrounded to three decimal places. Consequently,\n\n$$\n\\begin{aligned}{A}_{ABCD} & =2{A}_{ACB} \\\\  & =2\\cdot 67.658 \\\\  & =135.316.\\end{aligned}\n$$\n\nSo, to the nearest integer, the area of the parallelogram is $135.$"}] [{:db/id #edb/ref 17592186393236 :knowledge-point/_questions [{:db/id #edb/ref 17592186059772 :knowledge-point/id #uuid "c27a3f3c-77c7-55e9-8714-1f24c4a48063" :knowledge-point/title "Applying Row Operations To an Augmented Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "756e234a-8217-5c8b-abaa-69ea121a0c6c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & -2 & 1 & -1 \\\\ 0 & 1 & 0 & 1 \\\\ 7 & -1 & 3 & 1\\end{aligned}]" :db/id #edb/ref 17592186393238} {:answer/id #uuid "f11a15bf-be0f-553b-b1be-80f41c622717" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & -2 & 1 & -1 \\\\ 0 & 5 & 0 & 5 \\\\ 7 & -1 & 3 & 1\\end{aligned}]" :db/id #edb/ref 17592186393239} {:answer/id #uuid "1a9cf17b-a149-5bc6-9345-792b1cc2a3c0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & -2 & 1 & -1 \\\\ 0 & -5 & 0 & 5 \\\\ 7 & -1 & 3 & 1\\end{aligned}]" :db/id #edb/ref 17592186393240} {:answer/id #uuid "1d4576b0-5970-52fb-8377-b193cb931a98" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & -2 & 1 & -1 \\\\ 0 & -1 & 0 & 1 \\\\ 7 & -1 & 3 & 1\\end{aligned}]" :db/id #edb/ref 17592186393241} {:answer/id #uuid "4cfa023b-7905-5d00-83b5-528df496267c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & -2 & 1 & -1 \\\\ 0 & 1 & 0 & -1 \\\\ 7 & -1 & 3 & 1\\end{aligned}]" :db/id #edb/ref 17592186393242}] :answer-field/correct {:answer/id #uuid "f11a15bf-be0f-553b-b1be-80f41c622717" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & -2 & 1 & -1 \\\\ 0 & 5 & 0 & 5 \\\\ 7 & -1 & 3 & 1\\end{aligned}]" :db/id #edb/ref 17592186393239} :answer-field/id #uuid "bdfc7f8f-fcd9-55fe-82a8-5f2ff5b50086" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186393237}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "2facacda-0611-5507-a35e-091ce7069bfa" :question/math-academy-id "q-72781" :question/problem "Consider the augmented matrix $N,$ given by\n\n$$\nN=[\\begin{aligned}1 & -2 & 1 & -1 \\\\ 2 & 1 & 2 & 3 \\\\ 7 & -1 & 3 & 1\\end{aligned}].\n$$\n\nWhat matrix results from carrying out the row operation ${R}_{2}:={R}_{2}+(-2)\\cdot {R}_{1}$ on $N?$" :question/worked-solution "The operation ${R}_{2}:={R}_{2}+(-2)\\cdot {R}_{1}$ means that we need to add $-2$ times the first row to the second row.\n\nApplying this row operation, we obtain the following:\n\n$$\n\\begin{aligned}N & =[\\begin{aligned}1 & -2 & 1 & -1 \\\\ 2 & 1 & 2 & 3 \\\\ 7 & -1 & 3 & 1\\end{aligned}]\\,{R}_{2}:={R}_{2}+(-2)\\cdot {R}_{1} \\\\  & ∼[\\begin{aligned}1 & -2 & 1 & -1 \\\\ 2+(-2)(1) & 1+(-2)(-2) & 2+(-2)(1) & 3+(-2)(-1) \\\\ 7 & -1 & 3 & 1\\end{aligned}] \\\\  & ∼[\\begin{aligned}1 & -2 & 1 & -1 \\\\ 0 & 5 & 0 & 5 \\\\ 7 & -1 & 3 & 1\\end{aligned}]\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186064950 :knowledge-point/_questions [{:db/id #edb/ref 17592186064262 :knowledge-point/id #uuid "0c234eb8-4a5b-52e1-8854-c183b68184bd" :knowledge-point/title "Determining the Position of a Particle Given Its Velocity and Initial Position"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4388ef43-fe94-5421-acdd-c6a1590a53cb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x(t)=9t+1" :db/id #edb/ref 17592186339720} {:answer/id #uuid "80ca8a93-66a2-59da-a40a-1d062afa9efe" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x(t)=9t" :db/id #edb/ref 17592186340283} {:answer/id #uuid "83eb9448-9014-55fc-b978-85a3dd0f45d2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x(t)=9t-9" :db/id #edb/ref 17592186340316} {:answer/id #uuid "9bc13499-3b34-59c1-a63a-2b6b94f92a5c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x(t)=9" :db/id #edb/ref 17592186340529} {:answer/id #uuid "a8c202e1-a092-59ce-aee9-f2474d57754f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x(t)=0" :db/id #edb/ref 17592186340663}] :answer-field/correct {:answer/id #uuid "83eb9448-9014-55fc-b978-85a3dd0f45d2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x(t)=9t-9" :db/id #edb/ref 17592186340316} :answer-field/id #uuid "f90189a6-f1b9-5e5c-97ab-aa0c39581484" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186341823}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "4bcd3d6d-85e2-53be-bfd3-fe166f94d8e5" :question/math-academy-id "q-7282" :question/problem "A particle moves along a straight line relative to a fixed origin $O$ with velocity $v(t)=9,$ where $t$ is the time. If the particle is at the position $x=0$ when $t=1,$ calculate the position $x$ of the particle at time $t>0.$" :question/requires-calculator true :question/worked-solution "We start by integrating the velocity to get $x(t):$\n\n$$\n\\begin{aligned}x(t) & =\\int v(t)\\,\\text{d}t \\\\  & =\\int 9\\,\\text{d}t \\\\  & =9t+C\\end{aligned}\n$$\n\nTo determine $C$, we use the fact that $x(1)=0.$ Substituting this into the above gives\n\n$$\n\\begin{aligned}0 & =9(1)+C \\\\ C & =-9.\\end{aligned}\n$$\n\nTherefore, the position $x$ of the particle at time $t$ is \n\n$$\nx(t)=9t-9.\n$$"}] [{:db/id #edb/ref 17592186341864 :knowledge-point/_questions [{:db/id #edb/ref 17592186092167 :knowledge-point/id #uuid "d8c7ab50-5a8b-5bcd-8483-cec8bf6bd3ce" :knowledge-point/title "Solving a Trigonometric Equation Involving Tangent with Non-Special Angles"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0ad93dd9-f865-5592-811e-14f384c64bbf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8.2" :db/id #edb/ref 17592186339219} {:answer/id #uuid "31074855-d3da-586d-8c04-526c3ec62d18" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "7.8" :db/id #edb/ref 17592186339558} {:answer/id #uuid "3342aa60-3377-5de6-abd0-ce1b0d538d0f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8.4" :db/id #edb/ref 17592186339583} {:answer/id #uuid "86a98dfc-6975-5761-a79b-d41b66fce8b9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.8" :db/id #edb/ref 17592186340339} {:answer/id #uuid "a3814b4e-90bf-5084-b757-74d52e377f50" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8.0" :db/id #edb/ref 17592186340610}] :answer-field/correct {:answer/id #uuid "0ad93dd9-f865-5592-811e-14f384c64bbf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8.2" :db/id #edb/ref 17592186339219} :answer-field/id #uuid "c29068c9-aa1b-5e85-b568-8a54965ad3b8" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186341718}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "5bb6f7b5-fd38-5f44-84f6-733c5b1973e6" :question/math-academy-id "q-72824" :question/problem "Given that ${x}_{1}$ and ${x}_{2}$ are the solutions to the equation $\\operatorname{tan}⁡x=-8$ for $0\\le x<2\\pi ,$ what is the value of ${x}_{1}\\cdot {x}_{2},$ rounded to one decimal place?" :question/worked-solution "First, we find the principal value:\n\n$$\nx=\\operatorname{arctan}⁡(-8)=-1.446\\,4…≈-1.446\\,4.\n$$\n\nSince $-1.446\\,4$ lies outside the given domain, it is not a solution.\n\nTo generate more solutions, we add integer multiples of $\\pi .$ Hence,\n\n$$\n\\begin{aligned}{x}_{1} & =\\pi -1.446\\,4≈1.695\\,2, \\\\ {x}_{2} & =2\\pi -1.446\\,4≈4.836\\,8.\\end{aligned}\n$$\n\nFinally, \n\n$$\n{x}_{1}\\cdot {x}_{2}≈1.695\\,2\\cdot 4.836\\,8≈8.2\n$$\n\nrounded to one decimal place."}] [{:db/id #edb/ref 17592186341866 :knowledge-point/_questions [{:db/id #edb/ref 17592186064262 :knowledge-point/id #uuid "0c234eb8-4a5b-52e1-8854-c183b68184bd" :knowledge-point/title "Determining the Position of a Particle Given Its Velocity and Initial Position"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "030f864c-4fe8-549d-af96-e97726443f51" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x(t)=6t+3" :db/id #edb/ref 17592186339151} {:answer/id #uuid "0e6e0da6-0630-5e05-b1c9-496620bcd938" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x(t)={t}^{3}+{t}^{2}-5" :db/id #edb/ref 17592186339260} {:answer/id #uuid "50eb5854-e7b4-5074-9585-6b0b878655a4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x(t)={t}^{3}+{t}^{2}" :db/id #edb/ref 17592186339867} {:answer/id #uuid "98225b29-e168-596d-a3e1-abe2a661e410" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x(t)=4t+7" :db/id #edb/ref 17592186340495} {:answer/id #uuid "a662f1f6-40d3-5f4e-9954-53f79686f9e6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x(t)={t}^{3}+{t}^{2}+3" :db/id #edb/ref 17592186340639}] :answer-field/correct {:answer/id #uuid "a662f1f6-40d3-5f4e-9954-53f79686f9e6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x(t)={t}^{3}+{t}^{2}+3" :db/id #edb/ref 17592186340639} :answer-field/id #uuid "0bad20ca-f454-584c-b7a3-1bab375f050a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186341401}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "172f42b8-4e20-57a1-8447-38d9c7f98da1" :question/math-academy-id "q-7283" :question/problem "A particle moves along a straight line relative to a fixed origin $O$ with velocity $v(t)=3{t}^{2}+2t,$ where $t$ is the time. If the particle is at the position $x=15$ when $t=2,$ calculate the position $x$ of the particle at time $t>0.$" :question/worked-solution "We start by integrating the velocity to get $x(t):$\n\n$$\n\\begin{aligned}x(t) & =\\int v(t)\\,\\text{d}t \\\\  & =\\int (3{t}^{2}+2t)\\,\\text{d}t \\\\  & ={t}^{3}+{t}^{2}+C\\end{aligned}\n$$\n\nTo determine $C,$ we use the fact that $x(2)=15.$ Substituting this into the above gives\n\n$$\n\\begin{aligned}15 & =(2)^{3}+(2)^{2}+C \\\\ 15 & =8+4+C \\\\ C & =3.\\end{aligned}\n$$\n\nTherefore, the position $x$ of the particle at time $t$ is \n\n$$\nx(t)={t}^{3}+{t}^{2}+3.\n$$"}] [{:db/id #edb/ref 17592186341870 :knowledge-point/_questions [{:db/id #edb/ref 17592186092171 :knowledge-point/id #uuid "5f607558-5a7f-52df-b344-57f2f84791e9" :knowledge-point/title "Solving a Trigonometric Equation Involving Cosine with Non-Special Angles"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "416a58ae-ce76-5e02-96f0-d7597149753a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5.5" :db/id #edb/ref 17592186339708} {:answer/id #uuid "6db8cad2-a957-58f3-ad26-db45b399e754" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4.8" :db/id #edb/ref 17592186340098} {:answer/id #uuid "a1cd8970-9cb3-5318-9504-b8c8a617dc91" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6.1" :db/id #edb/ref 17592186340596} {:answer/id #uuid "b6c00063-961c-57de-9996-aa7c34c1b08f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4.9" :db/id #edb/ref 17592186340780} {:answer/id #uuid "ff350533-a65b-5d8c-9636-be091780422d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5.1" :db/id #edb/ref 17592186341376}] :answer-field/correct {:answer/id #uuid "ff350533-a65b-5d8c-9636-be091780422d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5.1" :db/id #edb/ref 17592186341376} :answer-field/id #uuid "90108bbe-e3f9-552f-9a17-4a20b275ed27" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186341634}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "40af3b43-8968-5b55-af69-0a7608e19327" :question/math-academy-id "q-72838" :question/problem "Given that ${x}_{1}$ and ${x}_{2}$ are the solutions to the equation $\\operatorname{cos}⁡x=\\frac{4}{7}$ for $0\\le x<2\\pi ,$ what is the value of ${x}_{1}\\cdot {x}_{2},$ rounded to one decimal place?" :question/worked-solution "First, we find the principal value:\n\n$$\n\\begin{aligned}x=\\operatorname{arccos}⁡(\\frac{4}{7})=0.962\\,550…≈0.962\\,6\\end{aligned}\n$$\n\nSince $0.962\\,6$ lies inside the specified domain, our first solution is ${x}_{1}=0.962\\,6.$\n\nOur first solution lies in the first quadrant and has a reference angle of ${\\theta }_{R}=0.962\\,6.$ Since $\\operatorname{cos}⁡x>0,$ the second solution must lie in the fourth quadrant, and it also has a reference angle ${\\theta }_{R}=0.962\\,6.$\n\n![](images/b2/b2cd7e76526632d8507ba484246a560829882e7f10d9814f01593f7a48d9a2ac.png)\n\nSince the second solution ${x}_{2}$ lies in the $4$th quadrant, we can find it using the reference angle as follows:\n\n$$\n\\begin{aligned}{x}_{2} & =2\\pi -{\\theta }_{R} \\\\  & =2\\pi -0.962\\,6 \\\\  & =5.320\\,6\\end{aligned}\n$$\n\nFinally,\n\n$$\n{x}_{1}{x}_{2}≈0.962\\,6\\cdot 5.320\\,6≈5.1\n$$\n\nrounded to one decimal place."}] [{:db/id #edb/ref 17592186341871 :knowledge-point/_questions [{:db/id #edb/ref 17592186064262 :knowledge-point/id #uuid "0c234eb8-4a5b-52e1-8854-c183b68184bd" :knowledge-point/title "Determining the Position of a Particle Given Its Velocity and Initial Position"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "05d966cc-8fed-5585-9802-da0009c421f2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x(t)=\\frac{1}{8}{t}^{2}-\\frac{1}{3}{t}^{3}-\\frac{63}{8}" :db/id #edb/ref 17592186339178} {:answer/id #uuid "7a5bdb47-642c-5847-b415-7acd09462b3e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x(t)=\\frac{1}{8}{t}^{2}-\\frac{1}{3}{t}^{3}+4" :db/id #edb/ref 17592186340221} {:answer/id #uuid "ab6c10e8-5890-5117-ba59-b6c73fa45d62" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x(t)=\\frac{1}{4}-2t" :db/id #edb/ref 17592186340689} {:answer/id #uuid "e28cd841-ca6d-595a-825e-c4c1810fa0a5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x(t)=\\frac{1}{8}{t}^{2}-\\frac{1}{3}{t}^{3}+1" :db/id #edb/ref 17592186341135} {:answer/id #uuid "f7f93847-8a6b-5df2-9c42-ff3305643c26" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x(t)=\\frac{1}{8}{t}^{2}-\\frac{1}{3}{t}^{3}+\\frac{7}{8}" :db/id #edb/ref 17592186341320}] :answer-field/correct {:answer/id #uuid "f7f93847-8a6b-5df2-9c42-ff3305643c26" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x(t)=\\frac{1}{8}{t}^{2}-\\frac{1}{3}{t}^{3}+\\frac{7}{8}" :db/id #edb/ref 17592186341320} :answer-field/id #uuid "741f9a31-4ea0-5b35-9dc9-dd1dfde7fb98" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186341584}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "35ab132d-9e7c-5e1c-baf1-f58667f680d8" :question/math-academy-id "q-7284" :question/problem "A particle moves along a straight line relative to a fixed origin $O$ with velocity $v(t)=\\frac{1}{4}t-{t}^{2},$ where $t>0$ is the time. If the particle is at the position $x=-7$ when $t=3,$ calculate the position $x$ of the particle at time $t.$" :question/worked-solution "We start by integrating the velocity to get $x(t):$\n\n$$\n\\begin{aligned}x(t) & =\\int v(t)\\,\\text{d}t \\\\  & =\\int (\\frac{1}{4}t-{t}^{2})\\text{d}t \\\\  & =\\frac{1}{8}{t}^{2}-\\frac{1}{3}{t}^{3}+C\\end{aligned}\n$$\n\nTo determine $C,$ we use the fact that $x(3)=-7.$ Substituting this into the above gives\n\n$$\n\\begin{aligned}-7 & =\\frac{1}{8}(3)^{2}-\\frac{1}{3}(3)^{3}+C \\\\ -7 & =-\\frac{63}{8}+C \\\\ C & =\\frac{7}{8}.\\end{aligned}\n$$\n\nTherefore, the position $x$ of the particle at time $t$ is \n\n$$\nx(t)=\\frac{1}{8}{t}^{2}-\\frac{1}{3}{t}^{3}+\\frac{7}{8}.\n$$"}] [{:db/id #edb/ref 17592186341876 :knowledge-point/_questions [{:db/id #edb/ref 17592186092164 :knowledge-point/id #uuid "e9f482ac-9771-52a3-9517-8494c3de6379" :knowledge-point/title "Solving a Trigonometric Equation Involving Cosine with Quadrantal Angles"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "48a7f416-9ccc-595c-937e-87b4c13463c5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x={30}^{∘},\\,{210}^{∘}" :db/id #edb/ref 17592186339775} {:answer/id #uuid "6d4e1aa1-9741-5265-a620-2ea9b913f9f4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x={0}^{∘}" :db/id #edb/ref 17592186340094} {:answer/id #uuid "aebf971f-72a5-59d6-b10a-ed17ef40c94d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x={180}^{∘}" :db/id #edb/ref 17592186340722} {:answer/id #uuid "d9cf140c-f381-5614-bcb7-c52362b8a27c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x={60}^{∘},\\,{240}^{∘}" :db/id #edb/ref 17592186341061} {:answer/id #uuid "e6edd2e5-fda5-5b71-a1c5-87184ab67800" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x={90}^{∘}" :db/id #edb/ref 17592186341170}] :answer-field/correct {:answer/id #uuid "aebf971f-72a5-59d6-b10a-ed17ef40c94d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x={180}^{∘}" :db/id #edb/ref 17592186340722} :answer-field/id #uuid "ce966d3f-597e-52d1-908c-5971b6d20f49" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186341742}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "3dee65bc-3bdf-57d3-9d7b-8a1802789c99" :question/math-academy-id "q-72845" :question/problem "Find the solution(s) to the equation $\\frac{\\operatorname{cos}⁡x+3}{2}=1$ for ${0}^{∘}\\le x<{360}^{∘}.$" :question/worked-solution "First, we rearrange the equation, isolating $\\operatorname{cos}⁡x:$\n\n$$\n\\begin{aligned}\\frac{\\operatorname{cos}⁡x+3}{2} & =1 \\\\ \\operatorname{cos}⁡x+3 & =2 \\\\ \\operatorname{cos}⁡x & =-1\\end{aligned}\n$$\n\nNotice that the solutions to $\\operatorname{cos}⁡x=1$ correspond to the values of $x$ at which $\\operatorname{cos}⁡x$ attains its minimum value.\n\nNow, we find the principal value:\n\n$$\n\\begin{aligned}x=\\operatorname{arccos}⁡(-1)={180}^{∘}\\end{aligned}\n$$\n\nSince ${180}^{∘}$ lies inside the required domain, our first solution is ${x}_{1}={180}^{∘}.$\n\nThis solution is a quadrantal angle. To find the remaining solutions, we use our knowledge of the cosine function. We know that the cosine function has its minimum values at\n\n$$\nx={180}^{∘}+{360}^{∘}\\cdot n.\n$$\n\nSince the domain ${0}^{∘}\\le x<{360}^{∘}$ is one period, and we have already found one minimum value in this period, we conclude that $x={180}^{∘}$ is the only solution."}] [{:db/id #edb/ref 17592186341878 :knowledge-point/_questions [{:db/id #edb/ref 17592186059773 :knowledge-point/id #uuid "691b9107-a935-5965-b3ac-0f3a193ce9bd" :knowledge-point/title "Identifying the Appropriate Row Operation To Transform One Matrix Into Another"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "14beb007-c69a-5ab7-974c-8b10dc220da9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{R}_{2}:={R}_{2}+{R}_{3}" :db/id #edb/ref 17592186339312} {:answer/id #uuid "195eaddc-f871-5643-a440-887c3d944ede" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{R}_{2}:={R}_{2}+2{R}_{3}" :db/id #edb/ref 17592186339352} {:answer/id #uuid "5638c8ca-be0f-53bb-8e47-8a06ac66a0a5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{R}_{1}↔{R}_{2}" :db/id #edb/ref 17592186339916} {:answer/id #uuid "a87e9a85-4c7f-5663-9658-9578bf406123" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{R}_{2}:={R}_{2}+4{R}_{1}" :db/id #edb/ref 17592186340659} {:answer/id #uuid "dd65c7d4-9bf4-5a81-bb2c-8537f1f6b07f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{R}_{2}↔{R}_{3}" :db/id #edb/ref 17592186341094}] :answer-field/correct {:answer/id #uuid "a87e9a85-4c7f-5663-9658-9578bf406123" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{R}_{2}:={R}_{2}+4{R}_{1}" :db/id #edb/ref 17592186340659} :answer-field/id #uuid "327a5532-0a35-5d86-90b5-6ede866a293a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186341471}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "4a88dee0-a622-519b-8c88-19f1fcfff46b" :question/math-academy-id "q-72854" :question/problem "Which of the following elementary row operations transforms the matrix $X$ into the matrix $W$, where\n\n$$\nX=[\\begin{aligned}1 & 1 & 2 \\\\ -4 & -1 & 1 \\\\ 2 & 1 & 6\\end{aligned}],\\,W=[\\begin{aligned}1 & 1 & 2 \\\\ 0 & 3 & 9 \\\\ 2 & 1 & 6\\end{aligned}]?\n$$" :question/worked-solution "First, notice that the $1$st and the $3$rd rows are the same in both matrices. The only row that has changed is the $2$nd row. \n\nBy considering the given row operations that modify the $2$nd row, we notice that\n\n$$\n\\begin{aligned}X & =[\\begin{aligned}1 & 1 & 2 \\\\ -4 & -1 & 1 \\\\ 2 & 1 & 6\\end{aligned}]\\,{R}_{2}:={R}_{2}+4\\cdot {R}_{1} \\\\  & ∼[\\begin{aligned}1 & 1 & 2 \\\\ 0 & 3 & 9 \\\\ 2 & 1 & 6\\end{aligned}] \\\\  & =W.\\end{aligned}\n$$\n\nTherefore, the required row operation is\n\n$$\n{R}_{2}:={R}_{2}+4{R}_{1}.\n$$"}] [{:db/id #edb/ref 17592186341881 :knowledge-point/_questions [{:db/id #edb/ref 17592186059774 :knowledge-point/id #uuid "0464b51e-8568-521e-96a5-a65c04569c2a" :knowledge-point/title "Identifying the Appropriate Row Operation To Transform a Given Entry to a Desired Value"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "44ff5f78-99ee-52f3-bd1d-6f04102d7f6c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{R}_{3}:={R}_{3}-3{R}_{1}" :db/id #edb/ref 17592186339741} {:answer/id #uuid "64bc7a5d-f05c-508b-8e6f-0c816e66dd68" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{R}_{3}↔{R}_{1}" :db/id #edb/ref 17592186340019} {:answer/id #uuid "66d5039f-7e91-5441-b9ac-066a1add60d4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{R}_{3}↔{R}_{2}" :db/id #edb/ref 17592186340032} {:answer/id #uuid "6efcee92-7f3a-5b03-8419-b8d8e7b73d4d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{R}_{3}:={R}_{3}-2{R}_{2}" :db/id #edb/ref 17592186340112} {:answer/id #uuid "98eddd1d-580c-5f43-aabf-9b49e45c9fcb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{R}_{3}:=\\frac{1}{3}{R}_{3}" :db/id #edb/ref 17592186340508}] :answer-field/correct {:answer/id #uuid "44ff5f78-99ee-52f3-bd1d-6f04102d7f6c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{R}_{3}:={R}_{3}-3{R}_{1}" :db/id #edb/ref 17592186339741} :answer-field/id #uuid "51eb3628-ef5f-5e6a-a72e-2dd27e5eda70" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186341527}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "d64eac74-31dd-5514-b904-fdc9f48abd1b" :question/math-academy-id "q-72860" :question/problem "Given that\n$S=[\\begin{aligned}1 & -1 & 1 \\\\ 3 & 2 & 1 \\\\ 1 & 1 & 3\\end{aligned}]$,\nwhich of the following elementary row operations makes ${a}_{33}=0?$" :question/worked-solution "Of the given options, we consider the row operation \n\n$$\n{R}_{3}:={R}_{3}-3{R}_{1}={R}_{3}+(-3)\\cdot {R}_{1}\n$$\n\nApplying the above row operation, we obtain the following:\n\n$$\n\\begin{aligned}S & =[\\begin{aligned}1 & -1 & 1 \\\\ 3 & 2 & 1 \\\\ 1 & 1 & 3\\end{aligned}]\\,{R}_{3}:={R}_{3}+(-3)\\cdot {R}_{1} \\\\  & ∼[\\begin{aligned}1 & -1 & 1 \\\\ 3 & 2 & 1 \\\\ -2 & 4 & 0\\end{aligned}]\\end{aligned}\n$$\n\nTherefore, the required row operation is \n\n$$\n{R}_{3}:={R}_{3}+(-3)\\cdot {R}_{1}\n$$\n\nor simply\n\n$$\n{R}_{3}:={R}_{3}-3{R}_{1}.\n$$"}] [{:db/id #edb/ref 17592186403599 :knowledge-point/_questions [{:db/id #edb/ref 17592186087724 :knowledge-point/id #uuid "6381faa4-5dfd-58fa-ace7-411fd2a97e98" :knowledge-point/title "Calculating the x-Intercepts of an Ellipse By Completing the Square"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ef8edbea-4da2-562c-be95-1803e0e50af8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(5\\pm \\sqrt{\\frac{3}{2}},0)" :db/id #edb/ref 17592186403601} {:answer/id #uuid "e45d242e-ec58-51d9-b98e-0c301509d596" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(10\\pm \\frac{3\\sqrt{2}}{2},0)" :db/id #edb/ref 17592186403602} {:answer/id #uuid "9141967a-e95f-5916-97f3-21bd825b34c3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "There is no $x$-intercept" :db/id #edb/ref 17592186403603} {:answer/id #uuid "3903afea-29b9-5179-b7c5-dc45513572f2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(5\\pm \\frac{\\sqrt{3}}{2},0)" :db/id #edb/ref 17592186403604} {:answer/id #uuid "88c9f761-6944-512d-b426-301b6d2b5ff0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(10\\pm \\frac{\\sqrt{3}}{2},0)" :db/id #edb/ref 17592186403605}] :answer-field/correct {:answer/id #uuid "ef8edbea-4da2-562c-be95-1803e0e50af8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(5\\pm \\sqrt{\\frac{3}{2}},0)" :db/id #edb/ref 17592186403601} :answer-field/id #uuid "629087fb-db7f-51a8-827b-0862fb389bb9" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186403600}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "3538d2b4-fd15-5d04-9456-067812f7d246" :question/math-academy-id "q-72913" :question/problem "Calculate the points where the ellipse $2{x}^{2}+3{y}^{2}-20x+6y+47=0$ intercepts the $x$-axis." :question/worked-solution "To calculate the $x$-intercepts, we need to substitute $y=0$ into the equation of the ellipse and solve the resulting equation for $x.$ We do this and solve the resulting equation by completing the square:\n\n$$\n\\begin{aligned}2{x}^{2}+3{y}^{2}-20x+6y+47 & =0 \\\\ 2{x}^{2}+3(0)^{2}-20x+6(0)+47 & =0 \\\\ 2{x}^{2}-20x+47 & =0 \\\\ 2[{x}^{2}-10x]+47 & =0 \\\\ 2[(x-5)^{2}-25]+47 & =0 \\\\ 2(x-5)^{2}-50+47 & =0 \\\\ 2(x-5)^{2} & =3 \\\\ (x-5)^{2} & =\\frac{3}{2} \\\\ x-5 & =\\pm \\sqrt{\\frac{3}{2}} \\\\ x & =5\\pm \\sqrt{\\frac{3}{2}}\\end{aligned}\n$$\n\nTherefore, the ellipse intercepts the $x$-axis at $(5-\\sqrt{\\frac{3}{2}},0)$ and $(5+\\sqrt{\\frac{3}{2}},0).$"}] [{:db/id #edb/ref 17592186341886 :knowledge-point/_questions [{:db/id #edb/ref 17592186087724 :knowledge-point/id #uuid "6381faa4-5dfd-58fa-ace7-411fd2a97e98" :knowledge-point/title "Calculating the x-Intercepts of an Ellipse By Completing the Square"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5bedf0ef-d091-529c-9452-055d4df48089" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(2\\pm \\sqrt{3},0)" :db/id #edb/ref 17592186339962} {:answer/id #uuid "7b290d59-ce77-5ad9-b904-8c21b160ec07" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-3\\pm \\sqrt{2},0)" :db/id #edb/ref 17592186340231} {:answer/id #uuid "907bfe3d-4729-5dfa-8728-e4a9413ce8e3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-2\\pm \\sqrt{3},0)" :db/id #edb/ref 17592186340423} {:answer/id #uuid "d409ed3f-53f8-5d27-b84d-7ce80fe544a8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(5,0)" :db/id #edb/ref 17592186341002} {:answer/id #uuid "ea330265-17ea-5ce6-9db7-de0ab2bee739" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "There is no $x$-intercept" :db/id #edb/ref 17592186341195}] :answer-field/correct {:answer/id #uuid "5bedf0ef-d091-529c-9452-055d4df48089" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(2\\pm \\sqrt{3},0)" :db/id #edb/ref 17592186339962} :answer-field/id #uuid "98d12b9f-78ac-5e61-9bc9-9638586d0302" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186341648}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "0e89bb93-f1e6-5d54-9eb6-f01d87f935ca" :question/math-academy-id "q-72914" :question/problem "Calculate the points where the ellipse ${x}^{2}+{y}^{2}-4x-2y+1=0$ intercepts the $x$-axis." :question/worked-solution "To calculate the $x$-intercepts, we need to substitute $y=0$ into the equation of the ellipse and solve the resulting equation for $x.$ We do this and solve the resulting equation by completing the square:\n\n$$\n\\begin{aligned}{x}^{2}+{y}^{2}-4x-2y+1 & =0 \\\\ {x}^{2}+{0}^{2}-4x-2(0)+1 & =0 \\\\ {x}^{2}-4x+1 & =0 \\\\ (x-2)^{2}-4+1 & =0 \\\\ (x-2)^{2} & =3 \\\\ x-2 & =\\pm \\sqrt{3} \\\\ x & =2\\pm \\sqrt{3}\\end{aligned}\n$$\n\nTherefore, the ellipse intercepts the $x$-axis at $(2-\\sqrt{3},0)$ and $(2+\\sqrt{3},0).$"}] [{:db/id #edb/ref 17592186403606 :knowledge-point/_questions [{:db/id #edb/ref 17592186087726 :knowledge-point/id #uuid "d21d6066-f7c8-5a47-b150-d0ae25d2d60b" :knowledge-point/title "Determining the Center and Axis Lengths Given an Inhomogeneous Polynomial Equation of an Ellipse"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7c381e28-47d1-516c-ba70-7941c1b4c573" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$4$ and $1$" :db/id #edb/ref 17592186403608} {:answer/id #uuid "c7ab0ed2-8c80-5ee7-ad45-3c43ece3b795" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$8$ and $4$" :db/id #edb/ref 17592186403609} {:answer/id #uuid "e0ac736d-0463-57d0-9db1-2a7177ddc558" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$8$ and $2$" :db/id #edb/ref 17592186403610} {:answer/id #uuid "b2703eaa-98a6-5759-b55c-68a1aa801db2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$4$ and $2$" :db/id #edb/ref 17592186403611} {:answer/id #uuid "cfd845e5-ca89-50e3-8d11-42ad65bcd599" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$2$ and $1$" :db/id #edb/ref 17592186403612}] :answer-field/correct {:answer/id #uuid "b2703eaa-98a6-5759-b55c-68a1aa801db2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$4$ and $2$" :db/id #edb/ref 17592186403611} :answer-field/id #uuid "66032e6a-59fa-5bca-a1f1-2d6e69a901e8" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186403607}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "a0bc6070-452c-59d7-b850-234ba4c8bcd8" :question/math-academy-id "q-72934" :question/problem "Determine  the lengths of the major and minor axes of the ellipse whose equation is ${x}^{2}+4{y}^{2}-4x+16y=-16.$" :question/worked-solution "First, we must group the $x$ terms and the $y$ terms:\n\n$$\n\\begin{aligned}{x}^{2}+4{y}^{2}-4x+16y & =-16 \\\\ ({x}^{2}-4x)+(4{y}^{2}+16y) & =-16\\end{aligned}\n$$\n\nNow, we must complete the square for both the $x$ and $y$ terms, as follows:\n\n$$\n\\begin{aligned}({x}^{2}-4x)+(4{y}^{2}+16y) & =-16 \\\\ ({x}^{2}-4x)+4({y}^{2}+4y) & =-16 \\\\ [(x-2)^{2}-4]+4[(y+2)^{2}-4] & =-16 \\\\ (x-2)^{2}-4+4(y+2)^{2}-16 & =-16\\end{aligned}\n$$\n\nFinally, we rearrange the equation into the desired form:\n\n$$\n\\begin{aligned}(x-2)^{2}-4+4(y+2)^{2}-16 & =-16 \\\\ (x-2)^{2}+4(y+2)^{2} & =-16+16+4 \\\\ (x-2)^{2}+4(y+2)^{2} & =4 \\\\ \\frac{(x-2)^{2}}{4}+\\frac{(y+2)^{2}}{1} & =1 \\\\ \\frac{(x-2)^{2}}{{2}^{2}}+\\frac{(y+2)^{2}}{{1}^{2}} & =1\\end{aligned}\n$$\n\nSince $2>1,$ the length of the major axis is $2\\cdot 2=4,$ and the length of the minor axis is $2\\cdot 1=2.$"}] [{:db/id #edb/ref 17592186341896 :knowledge-point/_questions [{:db/id #edb/ref 17592186096804 :knowledge-point/id #uuid "0a16e7b6-2a09-5aeb-9a8b-ea8fb1d59807" :knowledge-point/title "Calculating the Derivative of a Function From Its Graph"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "062499b4-be47-5b28-982d-86c642bba935" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186339180} {:answer/id #uuid "0c2e9142-707f-5bcc-a580-ee524bee6fdb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{4}{3}" :db/id #edb/ref 17592186339234} {:answer/id #uuid "359a8a35-2225-5f23-8b9d-aae7b68bb0a4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{2}" :db/id #edb/ref 17592186339604} {:answer/id #uuid "96928fb6-9fc9-5f9b-b89c-531b735c25b5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{2}{3}" :db/id #edb/ref 17592186340487} {:answer/id #uuid "c6587bc5-7cad-5be9-a21b-564e512cd0a5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{3}" :db/id #edb/ref 17592186340885}] :answer-field/correct {:answer/id #uuid "96928fb6-9fc9-5f9b-b89c-531b735c25b5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{2}{3}" :db/id #edb/ref 17592186340487} :answer-field/id #uuid "4f07086c-8b55-5351-9a76-5d3e1c547bcf" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186341518}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "241c4369-248c-546e-84df-6e2b47d7a0e2" :question/math-academy-id "q-72998" :question/problem "![](images/6d/6d5146afb9508532145180a4f632c0b5c4495487b0a9a89cfd4f71e134b95f50.png)\n\nThe graph of the function $y=f(x)$ is given above. Find ${f}^{′}(-1.5).$" :question/worked-solution "To compute ${f}^{′}(-1.5),$ we need to find the slope of the tangent to $f(x)$ at $x=-1.5.$\n\nLet's consider the graph of $y=f(x)$ on $[-2,1].$ Notice that $x=-1.5$ lies in this interval.\n\n![](images/22/2216d3014a8c74102d5e298c300092a575798de0b66d89914716898bc16ac655.png)\n\nThe slope of $y=f(x)$ on $x\\in (-2,1)$ is constant and equals\n\n$$\n\\begin{aligned}\\frac{Δf}{Δx} & =\\frac{0-2}{1-(-2)}=-\\frac{2}{3}.\\end{aligned}\n$$\n\nTherefore, ${f}^{′}(-1.5)=-\\frac{2}{3}.$"}] [{:db/id #edb/ref 17592186341897 :knowledge-point/_questions [{:db/id #edb/ref 17592186119956 :knowledge-point/id #uuid "231604dc-fe8f-59be-90fe-37af7a1bb648" :knowledge-point/title "Identifying When a Rational Function has no Vertical Asymptotes"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "376f085b-77ed-5e18-bbad-6721aae3af84" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=2" :db/id #edb/ref 17592186339626} {:answer/id #uuid "b91a65c8-9a0b-56ec-9d6d-f87b5d22dd2d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=-2" :db/id #edb/ref 17592186340788} {:answer/id #uuid "c749d57a-0aa3-57ce-847c-3cb03b25ce49" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "No vertical asymptotes" :db/id #edb/ref 17592186340895} {:answer/id #uuid "e993d552-3194-5781-abb3-16538d649d32" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$x=0$, $x=-2$" :db/id #edb/ref 17592186341190} {:answer/id #uuid "fdb3a956-1ef1-5c3b-89cd-d12677010c7b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=-10" :db/id #edb/ref 17592186341369}] :answer-field/correct {:answer/id #uuid "c749d57a-0aa3-57ce-847c-3cb03b25ce49" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "No vertical asymptotes" :db/id #edb/ref 17592186340895} :answer-field/id #uuid "6802aeef-3bad-5c37-81c1-c577e7e557d8" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186341560}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "f02481a9-b93c-590a-b202-053a18900f95" :question/math-academy-id "q-73015" :question/problem "Find the vertical asymptotes of $f(x)=\\frac{{x}^{3}+2{x}^{2}}{2x+4}.$" :question/worked-solution "Let's simplify the expression by factoring both the numerator and the denominator:\n\n$$\n\\begin{aligned}\\frac{{x}^{3}+2{x}^{2}}{2x+4} & =\\frac{{x}^{2}(x+2)}{2(x+2)}=\\frac{{x}^{2}}{2}.\\end{aligned}\n$$\n\nSince the denominator is never zero, we conclude that this function has no vertical asymptotes. A plot of the function is below. Note that it is not defined at $x=-2.$\n\n![](images/3a/3ad83a79ccd47d9d035ac5a3f47b929a1e6b3939cdaddee9ff0f2d6a3cf07e56.png)"}] [{:db/id #edb/ref 17592186234328 :knowledge-point/_questions [{:db/id #edb/ref 17592186179659 :knowledge-point/id #uuid "44e3a595-a9ae-5d8c-9aa5-c8e3403fcb28" :knowledge-point/title "Simplifying a Variable Expression Containing a Quotient of Factorials"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2ae24c67-169d-568f-9906-74f5b3cc2e0b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "n(n+1)" :db/id #edb/ref 17592186339505} {:answer/id #uuid "35c068a3-dbe1-516f-a719-8c52f792f017" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{n}^{2}(n+1)" :db/id #edb/ref 17592186339606} {:answer/id #uuid "4cc01694-bcd6-5105-860b-e7ae3171d223" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "n(n-2)" :db/id #edb/ref 17592186339824} {:answer/id #uuid "9d31eea3-a5b0-5f91-81ac-06d7e2e82a81" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(n-1)(n+1)" :db/id #edb/ref 17592186340545} {:answer/id #uuid "cb8da782-b040-553f-a209-d1c9c3875b8e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "n(n-1)" :db/id #edb/ref 17592186340932}] :answer-field/correct {:answer/id #uuid "2ae24c67-169d-568f-9906-74f5b3cc2e0b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "n(n+1)" :db/id #edb/ref 17592186339505} :answer-field/id #uuid "20784676-1346-5beb-bf37-2d8560fbcb5c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186341437}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "81d120ad-3169-5d64-9a97-a76dfeab46ec" :question/math-academy-id "q-73023" :question/problem "Given that $n\\ge 1$ is an integer, simplify $\\frac{(n+1)!}{(n-1)!}.$" :question/worked-solution "First, notice the following:\n\n$$\n(n+1)!=(n+1)\\cdot n\\cdot (n-1)!\n$$\n\nThen, we cancel the $(n-1)!$ that occurs in both the numerator and the denominator:\n\n$$\n\\begin{aligned}\\frac{(n+1)!}{(n-1)!} & =\\frac{(n+1)\\cdot n\\cdot (n-1)!}{(n-1)!} \\\\  & =\\frac{(n+1)\\cdot n\\cdot \\cancel{(n-1)!}}{\\cancel{(n-1)!}} \\\\  & =n(n+1)\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186234331 :knowledge-point/_questions [{:db/id #edb/ref 17592186179659 :knowledge-point/id #uuid "44e3a595-a9ae-5d8c-9aa5-c8e3403fcb28" :knowledge-point/title "Simplifying a Variable Expression Containing a Quotient of Factorials"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "29487ed3-a525-52dd-9167-d626037dc815" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{n+2}" :db/id #edb/ref 17592186339491} {:answer/id #uuid "7f774ed2-5f28-52ae-865d-32a61cabb3ca" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{n+1}" :db/id #edb/ref 17592186340273} {:answer/id #uuid "9c213996-40cb-543e-9a55-403ef758636c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "n+2" :db/id #edb/ref 17592186340533} {:answer/id #uuid "9d2f4e0c-cc16-5245-84c3-7f919dd4a20d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{{n}^{2}+n}" :db/id #edb/ref 17592186340543} {:answer/id #uuid "dca1f91a-c517-5f9d-abf6-091011b8edcd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "n+1" :db/id #edb/ref 17592186341087}] :answer-field/correct {:answer/id #uuid "29487ed3-a525-52dd-9167-d626037dc815" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{n+2}" :db/id #edb/ref 17592186339491} :answer-field/id #uuid "247d41fd-6e73-5f0c-95b3-a198cf2975b2" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186341444}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "72330c15-2550-5193-88bf-8afccb0b16d4" :question/math-academy-id "q-73028" :question/problem "Given that $n\\ge -1$ is an integer, simplify $\\frac{(n+1)!}{(n+2)!}.$" :question/worked-solution "First, notice the following:\n\n$$\n(n+2)!=(n+2)\\cdot (n+1)!\n$$\n\nThen, we cancel the $(n+1)!$ that occurs in both the numerator and the denominator:\n\n$$\n\\begin{aligned}\\frac{(n+1)!}{(n+2)!} & =\\frac{(n+1)!}{(n+2)\\cdot (n+1)!} \\\\  & =\\frac{\\cancel{(n+1)!}}{(n+2)\\cdot \\cancel{(n+1)!}} \\\\  & =\\frac{1}{n+2}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186341899 :knowledge-point/_questions [{:db/id #edb/ref 17592186119957 :knowledge-point/id #uuid "68ba4c5d-8b91-57bc-b98b-0e9f8d8f1f67" :knowledge-point/title "Determining the Vertical Asymptotes for the Sum of Two Rational Functions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "52a883e7-4d2a-532d-9bbd-dce6962edcc3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=-1" :db/id #edb/ref 17592186339890} {:answer/id #uuid "5a4e1d9b-7c6a-5c7d-b288-86ddd171b3c1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$x=1$, $x=-1$" :db/id #edb/ref 17592186339949} {:answer/id #uuid "89cc96ba-2754-55f6-8b86-473c4e42f001" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$x=\\frac{1}{2}$, $x=1$" :db/id #edb/ref 17592186340358} {:answer/id #uuid "8f1ac77d-4b8a-5f0e-932d-f01c276b93ed" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=2" :db/id #edb/ref 17592186340415} {:answer/id #uuid "a9c87c4a-a6d6-5db3-8002-3e4994f240d6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=0" :db/id #edb/ref 17592186340674}] :answer-field/correct {:answer/id #uuid "5a4e1d9b-7c6a-5c7d-b288-86ddd171b3c1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$x=1$, $x=-1$" :db/id #edb/ref 17592186339949} :answer-field/id #uuid "929e3387-fa4c-54fe-ab80-91ba52610238" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186341637}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "d13dc12b-246a-57c9-9dc3-693e68fcfaf7" :question/math-academy-id "q-73031" :question/problem "Find the vertical asymptotes of $f(x)=\\frac{1}{x-1}+\\frac{1}{x+1}.$" :question/worked-solution "First, let's put the two terms over a common denominator:\n\n$$\n\\begin{aligned}\\frac{1}{x-1}+\\frac{1}{x+1} & =\\frac{x+1+(x-1)}{(x-1)(x+1)}=\\frac{2x}{(x-1)(x+1)}\\end{aligned}\n$$\n\nThere are no common factors in the numerator and denominator, so we proceed to set the denominator equal to zero and get\n\n$$\n(x-1)(x+1)=0\\,⟹\\,x=1\\,,\\,x=-1.\n$$\n\nTherefore, the vertical asymptotes are at $x=1$ and $x=-1.$"}] [{:db/id #edb/ref 17592186234332 :knowledge-point/_questions [{:db/id #edb/ref 17592186179660 :knowledge-point/id #uuid "644b7f09-7f66-50f2-8eba-ef6e009429d0" :knowledge-point/title "Simplifying a Variable Expression Containing a Quotient With Many Factorials"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "04802008-4ed6-5b73-83f5-d29dc06587f8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "k+1" :db/id #edb/ref 17592186339160} {:answer/id #uuid "1ba86355-0ac6-5962-ae05-e44d9250bd1a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{k}^{2}+k" :db/id #edb/ref 17592186339366} {:answer/id #uuid "af54b886-24b1-56d3-9d8e-4c71dd5f011f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{k+2}" :db/id #edb/ref 17592186340727} {:answer/id #uuid "f4bcde05-f467-51e7-b960-da690faabda6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{k}{k+2}" :db/id #edb/ref 17592186341287} {:answer/id #uuid "f7792b0b-5d92-53fc-957c-3f59a201b930" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{{k}^{2}+2k}" :db/id #edb/ref 17592186341316}] :answer-field/correct {:answer/id #uuid "af54b886-24b1-56d3-9d8e-4c71dd5f011f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{k+2}" :db/id #edb/ref 17592186340727} :answer-field/id #uuid "e83b7853-94c1-56fb-bb60-7f7706a1acaa" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186341792}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "4c27af90-5244-552c-a6c5-2d976ec6599f" :question/math-academy-id "q-73037" :question/problem "Given that $k\\ge -1$ is an integer, $\\frac{(k+2)((k+1)!)^{2}}{((k+2)!)^{2}}=$" :question/worked-solution "First, we notice that\n\n$$\n(k+2)!=(k+2)(k+1)!\n$$\n\nThen, we can cancel the $k!$ that occurs in both the numerator and the denominator:\n\n$$\n\\begin{aligned}\\frac{(k+2)((k+1)!)^{2}}{((k+2)!)^{2}} & =\\frac{(k+2)\\cdot (k+1)!\\cdot (k+1)!}{(k+2)!\\cdot (k+2)!} \\\\  & =\\frac{(k+2)\\cdot (k+1)!\\cdot (k+1)!}{(k+2)\\cdot (k+1)!\\cdot (k+2)\\cdot (k+1)!} \\\\  & =\\frac{\\cancel{(k+2)}\\cdot \\cancel{(k+1)!}\\cdot \\cancel{(k+1)!}}{(k+2)\\cdot \\cancel{(k+1)!}\\cdot \\cancel{(k+2)}\\cdot \\cancel{(k+1)!}} \\\\  & =\\frac{1}{k+2}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186341901 :knowledge-point/_questions [{:db/id #edb/ref 17592186059671 :knowledge-point/id #uuid "143766e0-0ef5-5caf-b699-d394d4a707e9" :knowledge-point/title "Using the Double-Angle Formula to Simplify Products"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1d39e1d2-809f-5155-a07c-2be82fe6f5c9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{tan}⁡(\\frac{3\\pi }{7})" :db/id #edb/ref 17592186339382} {:answer/id #uuid "40729786-50b6-5ff5-b256-a96bf88930f0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{cos}⁡(\\frac{6\\pi }{7})" :db/id #edb/ref 17592186339704} {:answer/id #uuid "ab3fcfc4-5970-535a-9851-ae25c946b062" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{sin}⁡(\\frac{3\\pi }{14})" :db/id #edb/ref 17592186340688} {:answer/id #uuid "dc526537-6440-5beb-89ba-a669341bd361" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{sin}⁡(\\frac{6\\pi }{7})" :db/id #edb/ref 17592186341086} {:answer/id #uuid "f54d10f1-3bdb-508e-83f2-6340ec8fe28b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\operatorname{sin}⁡(\\frac{3\\pi }{7})" :db/id #edb/ref 17592186341292}] :answer-field/correct {:answer/id #uuid "dc526537-6440-5beb-89ba-a669341bd361" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{sin}⁡(\\frac{6\\pi }{7})" :db/id #edb/ref 17592186341086} :answer-field/id #uuid "6bdfe7ee-6a1b-5a6c-8716-9c970e741c65" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186341565}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "188c3216-6730-58aa-bfa7-8985bab845cd" :question/math-academy-id "q-7305" :question/problem "Express $2\\operatorname{sin}⁡(\\frac{3\\pi }{7})\\operatorname{cos}⁡(\\frac{3\\pi }{7})$ as a single trigonometric ratio." :question/worked-solution "First, let's recall the double-angle formula for sine: \n\n$$\n2\\operatorname{sin}⁡x\\operatorname{cos}⁡x=\\operatorname{sin}⁡2x\n$$\n\nSubstituting $x=\\frac{3\\pi }{7}$ into the above, we get\n\n$$\n\\begin{aligned}2\\operatorname{sin}⁡(\\frac{3\\pi }{7})\\operatorname{cos}⁡(\\frac{3\\pi }{7}) & =\\operatorname{sin}⁡(2\\cdot \\frac{3\\pi }{7})=\\operatorname{sin}⁡(\\frac{6\\pi }{7}).\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186341903 :knowledge-point/_questions [{:db/id #edb/ref 17592186119978 :knowledge-point/id #uuid "8c0b7d95-c699-5762-aa44-449712f035c7" :knowledge-point/title "Calculating the Derivative of the Inverse of a Polynomial Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "77835525-c85a-5e0e-8661-a77b9e9f9635" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{{({f}^{-1}(x))}^{2}+1}" :db/id #edb/ref 17592186340193} {:answer/id #uuid "847000bf-bad5-5621-b77c-addb39a169b1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{({f}^{-1}(x))}^{2}+9" :db/id #edb/ref 17592186340319} {:answer/id #uuid "9d5543a6-95dd-5074-ad79-4ceaa79597b9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{3{({f}^{-1}(x))}^{2}+3}" :db/id #edb/ref 17592186340547} {:answer/id #uuid "c706794d-0369-5d7f-afcb-6bbb7413b70e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "9{({f}^{-1}(x))}^{2}+9" :db/id #edb/ref 17592186340890} {:answer/id #uuid "d002bc1c-552f-5278-a9ef-5d964aff0290" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{9{({f}^{-1}(x))}^{2}+9}" :db/id #edb/ref 17592186340979}] :answer-field/correct {:answer/id #uuid "d002bc1c-552f-5278-a9ef-5d964aff0290" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{9{({f}^{-1}(x))}^{2}+9}" :db/id #edb/ref 17592186340979} :answer-field/id #uuid "8bc3a6fc-cec4-58ff-8a2a-b743cc9a1cbc" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186341627}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "bac49aac-db35-5de6-9958-1ba30afe81ea" :question/math-academy-id "q-73064" :question/problem "If $f(x)=3{x}^{3}+9x,$ find ${({f}^{-1})}^{′}(x)$ as a function of ${f}^{-1}(x).$" :question/worked-solution "**Step 1:** First, we write the inverse function implicitly. The given function is $y=3{x}^{3}+9x,$ and to write the inverse function implicitly, we swap $x$ and $y$ as follows:\n\n$$\nx=3{y}^{3}+9y\n$$\n\nNote that in the equation above, we have $y={f}^{-1}(x).$\n\n**Step 2:** Next, we differentiate. The overall goal is to find $\\frac{\\text{d}y}{\\text{d}x},$ but the equation is already solved for $x,$ so we compute $\\frac{\\text{d}x}{\\text{d}y}$ and then take the reciprocal:\n\n$$\n\\begin{aligned}\\frac{\\text{d}x}{\\text{d}y} & =\\frac{\\text{d}}{\\text{d}y}(3{y}^{3}+9y) \\\\ \\frac{\\text{d}x}{\\text{d}y} & =9{y}^{2}+9 \\\\ \\frac{\\text{d}y}{\\text{d}x} & =\\frac{1}{9{y}^{2}+9}\\end{aligned}\n$$\n\n**Step 3:** Lastly, we write the result in terms of ${f}^{-1}(x).$ Since $y={f}^{-1}(x),$ we have\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}[{f}^{-1}(x)] & =\\frac{1}{9{({f}^{-1}(x))}^{2}+9} \\\\ {({f}^{-1})}^{′}(x) & =\\frac{1}{9{({f}^{-1}(x))}^{2}+9}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186341908 :knowledge-point/_questions [{:db/id #edb/ref 17592186068700 :knowledge-point/id #uuid "81247553-750f-5bf7-a1c4-698ad63b5ae4" :knowledge-point/title "Identifying True Statements Regarding Left- and Right-Continuity"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "33ab5c9a-741e-507f-8a99-07a9f7aa451c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186339588} {:answer/id #uuid "3bf55990-23dc-5693-8dde-0dd252a432b1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I, II and III" :db/id #edb/ref 17592186339663} {:answer/id #uuid "48fe273f-13eb-5f78-8272-5b9b3a2db061" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "None" :db/id #edb/ref 17592186339782} {:answer/id #uuid "4a2895ac-425c-5001-bb2a-284e8601acaf" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186339796} {:answer/id #uuid "ea2ab1df-0cb6-5919-a2be-e9cca71bcc58" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186341194}] :answer-field/correct {:answer/id #uuid "4a2895ac-425c-5001-bb2a-284e8601acaf" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186339796} :answer-field/id #uuid "bf84d3cb-0dfa-513a-bcdd-3183ad8dee6c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186341710}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "79464211-37d1-5cac-b164-284bb9d9308a" :question/math-academy-id "q-73105" :question/problem "![](images/ad/ad3fb8a0cce2a6dac706d7876aca0a2339fe49c05cb7aa6ae54de86735ceafab.png)\n\nWhich of the following statements are true regarding the function $y=f(x)$ plotted above?\n\nI. The function is left-continuous at $x=3$\n\nII. The function is right-continuous at $x=3$\n\nIII. The function is continuous at $x=3$" :question/worked-solution "Let's look at each statement in turn:\n\n- Statement I is false. The function is not left-continuous at $x=3,$ since the left-sided limit is not equal to the function value:\n\n$$\n{lim}_{x\\to {3}^{-}}f(x)=3\\ne 1=f(3)\n$$\n\n- Statement II is true. The function is right-continuous at $x=3,$ since the right-sided limit is equal to the function value:\n\n$$\n{lim}_{x\\to {3}^{+}}f(x)=1=f(3)\n$$\n\n- Statement III is false. In order for the function to be continuous at $x=3,$ it must be both left-continuous and right-continuous. However, we have already determined that the function is not left-continuous at this point.\n\nIn conclusion, only statement II is true."}] [{:db/id #edb/ref 17592186393243 :knowledge-point/_questions [{:db/id #edb/ref 17592186064369 :knowledge-point/id #uuid "81d5fa54-0b80-52c1-97d7-6f8fb231f692" :knowledge-point/title "Calculating the Velocity of a Particle"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "eb230c0d-ae6c-5b91-bc69-b46c43b715a5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "v(t)=\\frac{t}{{t}^{2}+1}" :db/id #edb/ref 17592186393245} {:answer/id #uuid "6bdfcb55-fac4-5a73-87fa-24281ab750d8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "v(t)=\\frac{1}{\\operatorname{ln}⁡({t}^{2}+1)}" :db/id #edb/ref 17592186393246} {:answer/id #uuid "68292ac4-6ee0-5e6f-91bd-ec10d542dd55" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "v(t)=\\frac{2t}{\\operatorname{ln}⁡({t}^{2}+1)}" :db/id #edb/ref 17592186393247} {:answer/id #uuid "66957c8b-c836-5083-b60f-a4cfaf5cea07" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "v(t)=\\frac{2t}{{t}^{2}+1}" :db/id #edb/ref 17592186393248} {:answer/id #uuid "5bf45832-46e1-5812-a6e9-ef6cb9915057" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "v(t)=\\frac{1}{{t}^{2}+1}" :db/id #edb/ref 17592186393249}] :answer-field/correct {:answer/id #uuid "66957c8b-c836-5083-b60f-a4cfaf5cea07" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "v(t)=\\frac{2t}{{t}^{2}+1}" :db/id #edb/ref 17592186393248} :answer-field/id #uuid "cc7bca80-d5b9-56af-82b2-e4c24799c712" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186393244}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "2c45107f-9360-503e-9bf0-50d3816b1ed2" :question/math-academy-id "q-73136" :question/problem "The position $x$ of a particle at time $t$ is given by $x(t)=\\operatorname{ln}⁡({t}^{2}+1).$ Calculate the velocity at time $t.$" :question/worked-solution "The velocity is the derivative of the position function $x(t)$ with respect to time:\n\n$$\n\\begin{aligned}v(t) & =\\frac{\\text{d}x}{\\text{d}t} \\\\  & =\\frac{\\text{d}}{\\text{d}t}(\\operatorname{ln}⁡({t}^{2}+1)) \\\\  & =\\frac{1}{{t}^{2}+1}\\cdot 2t \\\\  & =\\frac{2t}{{t}^{2}+1}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186341912 :knowledge-point/_questions [{:db/id #edb/ref 17592186129176 :knowledge-point/id #uuid "31c3678b-4f00-54d6-bb84-c7718fd622cb" :knowledge-point/title "Identifying the Leading Entries of a Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2f4e341c-3d98-5b25-89d4-d22cc7d833da" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186339541} {:answer/id #uuid "4ca90275-1867-5588-92e4-c504069e453d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186339823} {:answer/id #uuid "d83362ef-2e49-5554-adbe-d990d07055ba" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186341047} {:answer/id #uuid "ec02ca2e-05e7-5239-8830-86756a101aa2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186341208} {:answer/id #uuid "ee593e53-439e-5886-9175-95bb3c75d6ed" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186341230}] :answer-field/correct {:answer/id #uuid "d83362ef-2e49-5554-adbe-d990d07055ba" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186341047} :answer-field/id #uuid "f911437e-8954-5fac-bd5b-2b1dad53e9a1" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186341824}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "a5a8f2f1-6cb7-517c-b610-e099919e39b1" :question/math-academy-id "q-73145" :question/problem "What is the sum of the leading entries of the $1$st and $4$th rows in the matrix $A,$ given below?\n\n$$\nA=[\\begin{aligned}0 & 0 & 1 & 3 \\\\ 4 & 3 & 0 & 0 \\\\ -2 & 0 & -1 & 8 \\\\ 0 & -3 & 0 & 2\\end{aligned}]\n$$" :question/worked-solution "The first non-zero entry of each row (from left to right) is the leading entry. \n\nTherefore, the leading entries of the $1$st and $4$th rows of $A$ are $1$ and $-3$, respectively.\n\n$$\nA=[\\begin{aligned}0 & 0 & 1 & 3 \\\\ 4 & 3 & 0 & 0 \\\\ -2 & 0 & -1 & 8 \\\\ 0 & -3 & 0 & 2\\end{aligned}]\n$$\n\nSo, the answer is $1+(-3)=-2.$"}] [{:db/id #edb/ref 17592186341914 :knowledge-point/_questions [{:db/id #edb/ref 17592186129176 :knowledge-point/id #uuid "31c3678b-4f00-54d6-bb84-c7718fd622cb" :knowledge-point/title "Identifying the Leading Entries of a Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8b0dc145-a3df-5cd3-b924-0c7d2acfad3c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186340372} {:answer/id #uuid "9eab495f-1840-5186-a25d-6011114174e8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186340559} {:answer/id #uuid "a62dda53-6d81-561d-8c65-9866d1b6e9ed" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186340634} {:answer/id #uuid "f65a4cfc-78a9-5852-82a7-6c79df4e7f8a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186341306} {:answer/id #uuid "fe9c5424-e43f-5a5b-a9ce-2a60eb841091" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "10" :db/id #edb/ref 17592186341374}] :answer-field/correct {:answer/id #uuid "f65a4cfc-78a9-5852-82a7-6c79df4e7f8a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186341306} :answer-field/id #uuid "f7d05b3d-96d3-5555-b774-1c5d834596a3" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186341821}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "150469bf-3b37-5806-a5a4-fe5648ae21a5" :question/math-academy-id "q-73148" :question/problem "What is the sum of the leading entries of the $1$st, $2$nd, and $3$rd rows in the matrix $A,$ given below?\n\n$$\nA=[\\begin{aligned}0 & -7 & 2 & 0 \\\\ 0 & 0 & 5 & 6 \\\\ 3 & 0 & 2 & -1 \\\\ -1 & 0 & 0 & 1\\end{aligned}]\n$$" :question/worked-solution "The first non-zero entry of each row (from left to right) is the leading entry. \n\nTherefore, the leading entries of the $1$st, $2$nd, and $3$rd rows of $A$ are $-7$, $5$, and $3$, respectively.\n\n$$\nA=[\\begin{aligned}0 & -7 & 2 & 0 \\\\ 0 & 0 & 5 & 6 \\\\ 3 & 0 & 2 & -1 \\\\ -1 & 0 & 0 & 1\\end{aligned}]\n$$\n\nSo, the answer is $-7+5+3=1.$"}] [{:db/id #edb/ref 17592186393250 :knowledge-point/_questions [{:db/id #edb/ref 17592186096631 :knowledge-point/id #uuid "cdc82e49-5df6-5096-a8fd-e00017fb1e3a" :knowledge-point/title "Expressing a Definite Integral as the Limit of a Left Riemann Sum"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ce3626c4-68fc-5111-92bb-c6a72ef04b3f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{lim}_{n\\to \\infty }{\\sum }_{i=0}^{n-1}[ln⁡(e+\\frac{4ie}{n})\\cdot \\frac{4e}{n}]" :db/id #edb/ref 17592186393252} {:answer/id #uuid "51976397-23e1-57d8-a039-644bf6317f62" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{lim}_{n\\to \\infty }{\\sum }_{i=0}^{n-1}[{e}^{(-2i/n)}\\cdot \\frac{1}{n}]" :db/id #edb/ref 17592186393253} {:answer/id #uuid "9d2df163-f8cb-55a5-aa92-94fe12f6f8d2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{lim}_{n\\to \\infty }{\\sum }_{i=0}^{n-1}[ln⁡(e+\\frac{2ie}{n})\\cdot \\frac{2e}{n}]" :db/id #edb/ref 17592186393254} {:answer/id #uuid "680c2096-a3a6-56c7-af41-ad8e3a2a9b3e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{lim}_{n\\to \\infty }{\\sum }_{i=0}^{n-1}[{e}^{(2i/n)}\\cdot \\frac{2}{n}]" :db/id #edb/ref 17592186393255} {:answer/id #uuid "7e48b7d1-54ea-5e38-b291-212dbf407565" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{lim}_{n\\to \\infty }{\\sum }_{i=0}^{n-1}[ln⁡(e+\\frac{ie}{n})\\cdot \\frac{e}{n}]" :db/id #edb/ref 17592186393256}] :answer-field/correct {:answer/id #uuid "9d2df163-f8cb-55a5-aa92-94fe12f6f8d2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{lim}_{n\\to \\infty }{\\sum }_{i=0}^{n-1}[ln⁡(e+\\frac{2ie}{n})\\cdot \\frac{2e}{n}]" :db/id #edb/ref 17592186393254} :answer-field/id #uuid "ae6ae5ee-b93f-55d8-b530-ad34a29b014a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186393251}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "d2f3eda7-3ae2-5c51-adcd-171934d8313e" :question/math-academy-id "q-73156" :question/problem "What is ${\\int }_{e}^{3e}ln⁡x\\,\\text{d}x$ expressed as the limit of a left Riemann sum?" :question/worked-solution "The definite integral can be defined in terms of the limit of a left Riemann sum as\n\n$$\n{\\int }_{a}^{b}f(x)\\text{d}x={lim}_{n\\to \\infty }{\\sum }_{i=0}^{n-1}f({x}_{i})\\cdot Δx,\n$$\n\n    \n\nwhere $Δx=\\frac{b-a}{n}$ and ${x}_{i}=a+iΔx.$\n\nIn the definite integral\n\n$$\n{\\int }_{e}^{3e}ln⁡x\\,\\text{d}x,\n$$\n\nthe function is $f(x)=ln⁡x,$ the lower bound is $a=e,$ and the upper bound is $b=3e.$ So, we have\n\n$$\nΔx=\\frac{3e-e}{n}=\\frac{2e}{n},\n$$\n\nand therefore\n\n$$\n\\begin{aligned}{\\int }_{e}^{3e}ln⁡x\\,\\text{d}x & ={lim}_{n\\to \\infty }{\\sum }_{i=0}^{n-1}f({x}_{i})\\cdot Δx \\\\  & ={lim}_{n\\to \\infty }{\\sum }_{i=0}^{n-1}[f(e+i\\cdot \\frac{2e}{n})\\cdot \\frac{2e}{n}] \\\\  & ={lim}_{n\\to \\infty }{\\sum }_{i=0}^{n-1}[f(e+\\frac{2ie}{n})\\cdot \\frac{2e}{n}] \\\\  & ={lim}_{n\\to \\infty }{\\sum }_{i=0}^{n-1}[ln⁡(e+\\frac{2ie}{n})\\cdot \\frac{2e}{n}].\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186393264 :knowledge-point/_questions [{:db/id #edb/ref 17592186096633 :knowledge-point/id #uuid "29b136d3-69bc-51ef-a262-dbee8af377d2" :knowledge-point/title "Expressing a Definite Integral as the Limit of a Right Riemann Sum"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "516433a3-ddcf-5286-911f-d1661221641b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{lim}_{n\\to \\infty }{\\sum }_{k=1}^{n}[-2{(\\frac{5k}{n})}^{-2}\\cdot \\frac{5}{n}]" :db/id #edb/ref 17592186393266} {:answer/id #uuid "91a60e1f-ff52-5d12-8845-6de6b6f23736" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{lim}_{n\\to \\infty }{\\sum }_{k=1}^{n}[-2{(-2+\\frac{5k}{n})}^{3}\\cdot \\frac{5}{n}]" :db/id #edb/ref 17592186393267} {:answer/id #uuid "6006a006-5f33-5ef4-b609-573993a53f00" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{lim}_{n\\to \\infty }{\\sum }_{k=1}^{n}[-2{(2+\\frac{k}{n})}^{3}\\cdot \\frac{1}{n}]" :db/id #edb/ref 17592186393268} {:answer/id #uuid "8ff05667-12f6-5f44-9206-bc6cf51be751" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{lim}_{n\\to \\infty }{\\sum }_{k=1}^{n}[-{(-1+\\frac{5k}{n})}^{3}\\cdot \\frac{5}{n}]" :db/id #edb/ref 17592186393269} {:answer/id #uuid "af9dfa31-4950-5539-b718-f5c060dd0d43" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{lim}_{n\\to \\infty }{\\sum }_{k=1}^{n}[-2(5+\\frac{2k}{n})\\cdot \\frac{2}{n}]" :db/id #edb/ref 17592186393270}] :answer-field/correct {:answer/id #uuid "91a60e1f-ff52-5d12-8845-6de6b6f23736" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{lim}_{n\\to \\infty }{\\sum }_{k=1}^{n}[-2{(-2+\\frac{5k}{n})}^{3}\\cdot \\frac{5}{n}]" :db/id #edb/ref 17592186393267} :answer-field/id #uuid "97365ecd-a18f-5653-861f-4053aa6db95b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186393265}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "f5568099-5914-5fb0-903c-d4010e585001" :question/math-academy-id "q-73180" :question/problem "What is ${\\int }_{-2}^{3}-2{x}^{3}\\text{d}x$ expressed as the limit of a right Riemann sum?" :question/worked-solution "The definite integral can be defined in terms of the limit of a right Riemann sum as\n\n$$\n{\\int }_{a}^{b}f(x)\\,\\text{d}x={lim}_{n\\to \\infty }{\\sum }_{k=1}^{n}f({x}_{k})\\cdot Δx,\n$$\n\nwhere ${x}_{k}=a+kΔx$ and $Δx=\\frac{b-a}{n}.$\n\nIn the definite integral\n\n$$\n{\\int }_{-2}^{3}-2{x}^{3}\\text{d}x,\n$$\n\nthe function is $f(x)=-2{x}^{3},$ the lower bound is $a=-2$ and the upper bound is $b=3.$ So, we have\n\n$$\nΔx=\\frac{3-(-2)}{n}=\\frac{5}{n}.\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}{\\int }_{-2}^{3}-2{x}^{3}\\text{d}x & ={lim}_{n\\to \\infty }{\\sum }_{k=1}^{n}f({x}_{k})\\cdot Δx \\\\  & ={lim}_{n\\to \\infty }{\\sum }_{k=1}^{n}[f(-2+k\\cdot \\frac{5}{n})\\cdot \\frac{5}{n}] \\\\  & ={lim}_{n\\to \\infty }{\\sum }_{k=1}^{n}[f(-2+\\frac{5k}{n})\\cdot \\frac{5}{n}] \\\\  & ={lim}_{n\\to \\infty }{\\sum }_{k=1}^{n}[-2{(-2+\\frac{5k}{n})}^{3}\\cdot \\frac{5}{n}].\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186393278 :knowledge-point/_questions [{:db/id #edb/ref 17592186096817 :knowledge-point/id #uuid "e0d98b82-24d2-5b2c-b596-0300778bd187" :knowledge-point/title "Calculating a Two-Term Partial Fraction Decomposition"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "df5097ab-aeed-5dd2-a4ac-84a7912ba470" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$A=1$ and $B=4$" :db/id #edb/ref 17592186393280} {:answer/id #uuid "e7c9cc94-3908-54a8-9499-857e6df7b5d2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$A=4$ and $B=2$" :db/id #edb/ref 17592186393281} {:answer/id #uuid "a5117579-9f3d-5b5b-bd73-6a66279018b8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$A=2$ and $B=1$" :db/id #edb/ref 17592186393282} {:answer/id #uuid "d57fb7dd-ef0f-5819-8fc5-009e2372e7ae" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$A=2$ and $B=-1$" :db/id #edb/ref 17592186393283} {:answer/id #uuid "fdc0b9fc-a2e6-5d8a-9c55-1ce7d90a1edf" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$A=-2$ and $B=-1$" :db/id #edb/ref 17592186393284}] :answer-field/correct {:answer/id #uuid "d57fb7dd-ef0f-5819-8fc5-009e2372e7ae" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$A=2$ and $B=-1$" :db/id #edb/ref 17592186393283} :answer-field/id #uuid "9e286ea8-8e5b-5a6b-a9dc-7462355f83f9" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186393279}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "8e5d3142-b826-521f-9a5c-2fb700156ee4" :question/math-academy-id "q-73189" :question/problem "Given that \n\n$$\n\\frac{2x+1}{(x+1)^{2}}=\\frac{A}{x+1}+\\frac{B}{(x+1)^{2}},\n$$\n\nfind the real constants $A$ and $B.$" :question/worked-solution "Multiplying both sides of the given equality by $(x+1)^{2}$ gives\n\n$$\n\\begin{aligned}2x+1 & =A(x+1)+B.\\end{aligned}\n$$\n\nLetting $x=-1$  gives\n\n$$\n\\begin{aligned}2(-1)+1 & =A(-1+1)+B \\\\ -1 & =B.\\end{aligned}\n$$\n\nLetting $x=0$ and using our value for $B$ gives\n\n$$\n\\begin{aligned}2(0)+1 & =A(0+1)-1 \\\\ 2 & =A\\end{aligned}\n$$\n\nTherefore, $A=2$ and $B=-1.$"}] [{:db/id #edb/ref 17592186341922 :knowledge-point/_questions [{:db/id #edb/ref 17592186096816 :knowledge-point/id #uuid "0f247351-8c81-595e-bb30-26630159819c" :knowledge-point/title "Calculating a Missing Coefficient"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0a9382f0-7a0d-5fdf-b6b4-fcd28ebbe39a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186339217} {:answer/id #uuid "3a3d14e6-bba3-5ffb-918b-631b55a400f9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186339650} {:answer/id #uuid "3a9bdf12-ba46-5ab6-bd2b-5d7ddb245855" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186339653} {:answer/id #uuid "5755ea0e-2f23-5d0e-bce6-ca54b7a0aa7b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186339927} {:answer/id #uuid "ae7fad86-5186-5452-a484-01b2b17a50d5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186340721}] :answer-field/correct {:answer/id #uuid "3a9bdf12-ba46-5ab6-bd2b-5d7ddb245855" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186339653} :answer-field/id #uuid "268d95a7-d6ca-5d10-b5ce-e2cd1c539891" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186341448}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "3df5e280-10bc-5c40-be58-baa686dafca8" :question/math-academy-id "q-73195" :question/problem "Given that \n\n$$\n\\frac{5x-2}{(x+3)^{2}}=\\frac{A}{x+3}-\\frac{17}{(x+3)^{2}},\n$$\n\nwhat is the value of $A?$" :question/worked-solution "Multiplying both sides of the given equality by $(x+3)^{2}$ gives\n\n$$\n\\begin{aligned}5x-2 & =A(x+3)-17.\\end{aligned}\n$$\n\nLetting $x=0$  gives\n\n$$\n\\begin{aligned}5(0)-2 & =A(0+3)-17 \\\\ -2 & =3A-17 \\\\ 15 & =3A \\\\ A & =5.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186403620 :knowledge-point/_questions [{:db/id #edb/ref 17592186175939 :knowledge-point/id #uuid "f8f3989e-bde0-5b3a-8d45-08f34d330c3f" :knowledge-point/title "Determining Intervals of Increasing or Decreasing Displacement"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "dc080a13-8e0c-5832-9bea-08398f14a3f0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[0,\\frac{1}{4})" :db/id #edb/ref 17592186403622} {:answer/id #uuid "c0cca4dd-1e7a-5b07-a0de-042fce6f3d42" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(\\frac{1}{2},\\infty )" :db/id #edb/ref 17592186403623} {:answer/id #uuid "37d286fa-57c9-5bfb-a268-edcd61ddcadd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[0,1)" :db/id #edb/ref 17592186403624} {:answer/id #uuid "36bdbd94-1ad2-595f-a5b8-8b35a41f1e19" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[0,\\frac{1}{2})" :db/id #edb/ref 17592186403625} {:answer/id #uuid "811209a9-afb1-5f47-8576-6515ea37eb32" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(\\frac{1}{4},\\infty )" :db/id #edb/ref 17592186403626}] :answer-field/correct {:answer/id #uuid "36bdbd94-1ad2-595f-a5b8-8b35a41f1e19" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[0,\\frac{1}{2})" :db/id #edb/ref 17592186403625} :answer-field/id #uuid "04f008a8-35a2-5209-a21c-d7193e72a599" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186403621}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "08503449-abde-5746-b6d7-46180193efed" :question/math-academy-id "q-73210" :question/problem "The displacement $s,$ in meters, relative to a fixed origin $O$ of a particle moving in a straight line along the $x$-axis is given by $s(t)=t{e}^{-2t}$, where $t\\ge 0$ is the time, measured in seconds. Find the time intervals in which the particle is moving in the direction of increasing $x.$" :question/worked-solution "If the particle moves in the direction of increasing $x,$ then its velocity is positive. \n\nFirst, we calculate the velocity function by differentiating the position function:\n\n$$\n\\begin{aligned}v(t) & =\\frac{\\text{d}s}{\\text{d}t} \\\\  & =\\frac{\\text{d}}{\\text{d}t}(t{e}^{-2t}) \\\\  & ={e}^{-2t}(1-2t)\\end{aligned}\n$$\n\nTo calculate time intervals in which the particle is moving in the direction of increasing $x$, we solve $v(t)>0:$\n\n$$\n\\begin{aligned}v(t) & >0 \\\\ {e}^{-2t}(1-2t) & >0 \\\\ 1-2t & >0 \\\\ 2t & <1 \\\\ t & <\\frac{1}{2}\\end{aligned}\n$$\n\nHence, the time interval in which the particle is moving to the direction of increasing $x$ is $t\\in [0,\\frac{1}{2}).$"}] [{:db/id #edb/ref 17592186393285 :knowledge-point/_questions [{:db/id #edb/ref 17592186124502 :knowledge-point/id #uuid "64e7d2fb-003c-58c0-ab80-159e50748cc7" :knowledge-point/title "Calculating Intercepts of Spheres and Ellipsoids"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "92574954-56db-5e22-8577-4044312d87ef" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$(0,0,0)$ and $(0,0,\\frac{5}{2})$" :db/id #edb/ref 17592186393287} {:answer/id #uuid "d26ac35c-3433-55c1-aba9-04ac4fb4be37" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$(0,0,\\frac{3}{2})$ and $(0,0,\\frac{5}{2})$" :db/id #edb/ref 17592186393288} {:answer/id #uuid "da7d850c-c7da-5536-9a3e-8dfd4dedca68" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$(0,0,0)$ and $(0,0,2)$" :db/id #edb/ref 17592186393289} {:answer/id #uuid "9f21d78c-dfb5-5f80-8f9d-1894eb115cb5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$(0,0,\\frac{9}{4})$ and $(0,0,\\frac{7}{4})$" :db/id #edb/ref 17592186393290} {:answer/id #uuid "1d2f6bf3-3c38-5c3a-982b-11d71b8fcc1d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$(0,0,\\frac{5}{2})$ only" :db/id #edb/ref 17592186393291}] :answer-field/correct {:answer/id #uuid "d26ac35c-3433-55c1-aba9-04ac4fb4be37" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$(0,0,\\frac{3}{2})$ and $(0,0,\\frac{5}{2})$" :db/id #edb/ref 17592186393288} :answer-field/id #uuid "4865ffc5-356e-5dc2-8e39-a104fadf276d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186393286}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "968294df-641c-514f-b1fc-74e1ba659362" :question/math-academy-id "q-73215" :question/problem "Given the ellipsoid $\\frac{(x-3)^{2}}{12}+\\frac{(y-1)^{2}}{8}+\\frac{(z-2)^{2}}{2}=1$, find its intercepts with the $z$-axis." :question/worked-solution "To find the $z$-intercepts, we plug $x=0$ and $y=0$ into the equation:\n\n$$\n\\begin{aligned}\\frac{(0-3)^{2}}{12}+\\frac{(0-1)^{2}}{8}+\\frac{(z-2)^{2}}{2} & =1 \\\\ \\frac{3}{4}+\\frac{1}{8}+\\frac{(z-2)^{2}}{2} & =1 \\\\ \\frac{7}{8}+\\frac{(z-2)^{2}}{2} & =1 \\\\ \\frac{(z-2)^{2}}{2} & =\\frac{1}{8} \\\\ (z-2)^{2} & =\\frac{1}{4} \\\\ z-2 & =\\pm \\frac{1}{2} \\\\ z & =2\\pm \\frac{1}{2}\\end{aligned}\n$$\n\nHence, we get the solutions $z=\\frac{3}{2}$ and $z=\\frac{5}{2}.$\n\nTherefore, the intercepts with the $z$-axis are $(0,0,\\frac{3}{2})$ and $(0,0,\\frac{5}{2}).$"}] [{:db/id #edb/ref 17592186341928 :knowledge-point/_questions [{:db/id #edb/ref 17592186115380 :knowledge-point/id #uuid "794398c0-ffbf-5971-a411-f236607f56b8" :knowledge-point/title "Determining Whether a Function is Differentiable at a Point Given a Graph"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3115a701-908d-5194-89b5-3934f2aee943" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186339559} {:answer/id #uuid "3ef63771-16e0-5c66-87bb-9773a47f39ce" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186339696} {:answer/id #uuid "4084d34d-cdd6-5521-90d7-5d09fec010be" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186339705} {:answer/id #uuid "5f7cee9c-67f1-509a-a047-56e0f6f1ef9b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186339975} {:answer/id #uuid "9f5901ab-7568-583f-a1e8-bd3745447399" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186340567}] :answer-field/correct {:answer/id #uuid "9f5901ab-7568-583f-a1e8-bd3745447399" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186340567} :answer-field/id #uuid "941f6918-d68b-5b25-9b9f-c8698c202566" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186341640}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "fa88d46b-d2ce-5164-bbed-10d691e29ef6" :question/math-academy-id "q-73250" :question/problem "![](images/a8/a8a70a2f28585b63d2a083b42eb6ad54bfb581b5f13c699a3bc3c8d836afaee8.png)\n\nGiven the plot of the function $y=f(x)$ above, which of the following statements are true?\n\nI. The function is continuous at $x=1$\n\nII. The function is continuous at $x=0$\n\nIII. The function is differentiable at $x=0$" :question/worked-solution "- Statement I is false. From the graph we can see that $f(x)$ has a removable discontinuity at $x=1.$\n\n- Statement II is true. The graph can be drawn in a neighborhood of $x=0$ without taking the pencil off the paper.\n\n- Statement III is false. The function $f(x)$ has a corner point at $x=0$ and so it is not differentiable there.\n\nTherefore, only statement II is true."}] [{:db/id #edb/ref 17592186341929 :knowledge-point/_questions [{:db/id #edb/ref 17592186115380 :knowledge-point/id #uuid "794398c0-ffbf-5971-a411-f236607f56b8" :knowledge-point/title "Determining Whether a Function is Differentiable at a Point Given a Graph"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "43206143-d3e7-5558-906d-23db6302ae10" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186339717} {:answer/id #uuid "5aac758e-2f12-517d-8ce4-fe8a5696f212" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186339951} {:answer/id #uuid "9c49a7a3-a3b7-5ac2-9f14-8aeb96443d71" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186340536} {:answer/id #uuid "be0a87e6-ce52-5475-84fa-d3314aa5b89d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186340822} {:answer/id #uuid "dd1f61f7-02e8-5317-a136-be60633289a9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186341093}] :answer-field/correct {:answer/id #uuid "dd1f61f7-02e8-5317-a136-be60633289a9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186341093} :answer-field/id #uuid "315e5c79-1bab-5a2f-a733-2981ea179e3a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186341466}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "fb7ec702-6570-50d7-8199-a59c190c3e40" :question/math-academy-id "q-73252" :question/problem "![](images/1f/1f2d8b9faac6c300b41902cea5065bf8bafb02c137232ee79779a4dc3ff67f33.png)\n\nGiven the plot of the function $y=f(x)$ above, which of the following statements are true?\n\nI. The function is continuous at $x=-1$\n\nII. The function is differentiable at $x=1$\n\nIII. The function is continuous at $x=2$" :question/worked-solution "- Statement I is true. The graph can be drawn in a neighborhood of $x=-1$ without taking the pencil off the paper.\n\n- Statement II is false. From the graph we can see that $f(x)$ has a removable discontinuity at $x=1.$ So, it can't be differentiable there.\n\n- Statement III is true. The graph can be drawn in a neighborhood of $x=2$ without taking the pencil off the paper.\n\nTherefore, only statements I and III  are true."}] [{:db/id #edb/ref 17592186341930 :knowledge-point/_questions [{:db/id #edb/ref 17592186198354 :knowledge-point/id #uuid "58427e6a-8e77-5c01-a578-a7dc4b8f8812" :knowledge-point/title "Finding the Projection of the Intersection of a Surface and a Tilted Plane"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "22e57b08-ba93-5d11-8440-4445430e0dfe" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{(x-2)^{2}}{3/2}+\\frac{(y+1)^{2}}{1/2}=1." :db/id #edb/ref 17592186339426} {:answer/id #uuid "67d94158-cf43-5135-8af0-98ef7634cd45" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{(x-2)^{2}}{3/2}+\\frac{(y+1)^{2}}{2}=1." :db/id #edb/ref 17592186340053} {:answer/id #uuid "7527a218-8a99-584d-87b1-11c3577e8e61" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{(x-2)^{2}}{2/3}+\\frac{(y+1)^{2}}{2}=1." :db/id #edb/ref 17592186340177} {:answer/id #uuid "c28facb1-2fa6-599e-84e6-21bf0f6f6d5a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{(x-2)^{2}}{1/2}+\\frac{{y}^{2}}{3/2}=1." :db/id #edb/ref 17592186340860} {:answer/id #uuid "df7c8128-c1b1-531f-976e-2285e6b7fd3d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{(x-2)^{2}}{2/3}+\\frac{{y}^{2}}{1/2}=1." :db/id #edb/ref 17592186341115}] :answer-field/correct {:answer/id #uuid "67d94158-cf43-5135-8af0-98ef7634cd45" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{(x-2)^{2}}{3/2}+\\frac{(y+1)^{2}}{2}=1." :db/id #edb/ref 17592186340053} :answer-field/id #uuid "9cae6438-5e1d-58bd-a27d-aeecb7a0c2a5" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186341657}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "ee3d8721-374e-5615-9e25-19f56535791f" :question/math-academy-id "q-73257" :question/problem "Find the projection of the intersection between the ellipsoid $\\frac{(x-2)^{2}}{3}+\\frac{{y}^{2}}{6}+\\frac{{z}^{2}}{12}=1$ and the plane $z-y=3$ onto the $xy$-plane." :question/worked-solution "Since we want to find the projection onto the $xy$-plane, we need to eliminate the variable $z.$ First, we solve the equation of the plane for $z$, as follows:\n\n$$\n\\begin{aligned}z-y=3\\,⟹\\,z=y+3\\end{aligned}\n$$\n\nSubstituting the expression for $z$ into the equation of the ellipsoid, we obtain:\n\n$$\n\\begin{aligned}\\frac{(x-2)^{2}}{3}+\\frac{{y}^{2}}{6}+\\frac{(y+3)^{2}}{12} & =1 \\\\ \\frac{(x-2)^{2}}{3}+\\frac{{y}^{2}}{6}+\\frac{{y}^{2}+6y+9}{12} & =1 \\\\ \\frac{(x-2)^{2}}{3}+\\frac{2{y}^{2}}{12}+\\frac{{y}^{2}+6y+9}{12} & =1 \\\\ \\frac{(x-2)^{2}}{3}+\\frac{3{y}^{2}+6y+9}{12} & =1 \\\\ \\frac{(x-2)^{2}}{3}+\\frac{{y}^{2}+2y+3}{4} & =1\\end{aligned}\n$$\n\nFinally, by completing the square for the variable $y$, we have:\n\n$$\n\\begin{aligned}\\frac{(x-2)^{2}}{3}+\\frac{{y}^{2}+2y+3}{4} & =1 \\\\ \\frac{(x-2)^{2}}{3}+\\frac{({y}^{2}+2y+1)+2}{4} & =1 \\\\ \\frac{(x-2)^{2}}{3}+\\frac{(y+1)^{2}+2}{4} & =1 \\\\ \\frac{(x-2)^{2}}{3}+\\frac{(y+1)^{2}}{4}+\\frac{1}{2} & =1 \\\\ \\frac{(x-2)^{2}}{3}+\\frac{(y+1)^{2}}{4} & =\\frac{1}{2} \\\\ \\frac{2(x-2)^{2}}{3}+\\frac{(y+1)^{2}}{2} & =1 \\\\ \\frac{(x-2)^{2}}{3/2}+\\frac{(y+1)^{2}}{2} & =1\\end{aligned}\n$$\n\nTherefore, the projection of the intersection is the ellipse $\\frac{(x-2)^{2}}{3/2}+\\frac{(y+1)^{2}}{2}=1.$"}] [{:db/id #edb/ref 17592186341931 :knowledge-point/_questions [{:db/id #edb/ref 17592186115382 :knowledge-point/id #uuid "7dcbd56f-0fc2-59c5-a016-4272be4734c7" :knowledge-point/title "Determining the Points at Which a Function is Not Differentiable"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "63c09d2b-8c9b-5509-81a7-7a4ec011c9b8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186340014} {:answer/id #uuid "7903e95a-ccd2-529e-86e6-62c10f3301dc" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186340205} {:answer/id #uuid "9527f9dd-2ba6-502d-a176-fedc1376b1f4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186340474} {:answer/id #uuid "a7e3b118-efee-58f5-9b54-c9a03e9e8d33" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186340651} {:answer/id #uuid "edac5d81-7bbb-54f0-b1fd-a6545f5441ed" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186341224}] :answer-field/correct {:answer/id #uuid "edac5d81-7bbb-54f0-b1fd-a6545f5441ed" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186341224} :answer-field/id #uuid "bec2c4de-3d83-56d3-8768-b4620098a5b3" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186341708}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "ef354870-3599-55d1-9c3b-8b4fa57a2d1f" :question/math-academy-id "q-73260" :question/problem "Given that a function $f(x)$ is continuous at $x=0$, has a corner point at $x=2,$ and is differentiable at $x=4$, which of the following statements must be true for **any** $f(x)$ that satisfy these criteria?\n\nI. ${lim}_{x\\to 4}f(x)=f(4).$\n\nII. It is **not** differentiable at $x=2$\n\nIII. It is differentiable at $x=0$" :question/worked-solution "- Statement I is true. Differentiability implies continuity. Hence, ${lim}_{x\\to 4}f(x)=f(4).$\n\n- Statement II is true. The function has a corner point at $x=2$, so it's not differentiable there.\n\n- Statement III is false.  Continuity does not imply differentiability. For instance, the function  $g(x)=|x|$ is continuous at $x=0$ but it is not differentiable there."}] [{:db/id #edb/ref 17592186341937 :knowledge-point/_questions [{:db/id #edb/ref 17592186175909 :knowledge-point/id #uuid "92e86e5f-31cd-57ae-a142-023c816d0b33" :knowledge-point/title "Evaluating the Definite Integral of a Trigonometric Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1beaf82b-ca6d-5426-aa13-fd5815d423b3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{2}" :db/id #edb/ref 17592186339368} {:answer/id #uuid "82061933-a612-5dfb-af1d-c4e789553102" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186340298} {:answer/id #uuid "8d319e2e-bf9d-56aa-8999-7345e8362465" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186340395} {:answer/id #uuid "c7389d59-06bc-5dbe-9262-9447a8c813ed" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186340894} {:answer/id #uuid "f480be00-0128-5082-93a6-d17b5a45580c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186341284}] :answer-field/correct {:answer/id #uuid "82061933-a612-5dfb-af1d-c4e789553102" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186340298} :answer-field/id #uuid "6548d467-5048-50dd-98ac-f013e5313bb6" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186341557}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "41bab868-1060-5798-adf0-32f97366917b" :question/math-academy-id "q-73286" :question/problem "${\\int }_{0}^{\\pi /3}\\operatorname{sin}⁡x\\,\\text{d}x=$" :question/worked-solution "Taking the antiderivative and evaluating the difference at the bounds, we get\n\n$$\n\\begin{aligned}\\begin{aligned}{\\int }_{0}^{\\pi /3}\\operatorname{sin}⁡x\\,\\text{d}x & =-\\operatorname{cos}⁡x\\,{|}_{0}^{\\pi /3} \\\\  & =-\\operatorname{cos}⁡(\\frac{\\pi }{3})-(-\\operatorname{cos}⁡(0)) \\\\  & =-\\frac{1}{2}-(-1) \\\\  & =-\\frac{1}{2}+1 \\\\  & =\\frac{1}{2}.\\end{aligned}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186341938 :knowledge-point/_questions [{:db/id #edb/ref 17592186175909 :knowledge-point/id #uuid "92e86e5f-31cd-57ae-a142-023c816d0b33" :knowledge-point/title "Evaluating the Definite Integral of a Trigonometric Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "090a45ae-4a14-53bd-bff9-96bc2c7a0d8a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1-\\sqrt{3}}{3}" :db/id #edb/ref 17592186339206} {:answer/id #uuid "4c52d9ff-6ce1-5908-b527-e5d1742ab70a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3-\\sqrt{3}}{3}" :db/id #edb/ref 17592186339819} {:answer/id #uuid "5588d6f2-8c6f-5a01-b89a-7b7a17265739" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{3}+3}{3}" :db/id #edb/ref 17592186339912} {:answer/id #uuid "d3238de0-22ee-5721-a21d-7e7f9b4dbeca" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{\\sqrt{3}+1}{3}" :db/id #edb/ref 17592186340998} {:answer/id #uuid "e96c033c-24e5-59d6-9c28-291c33500939" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{\\sqrt{3}+3}{3}" :db/id #edb/ref 17592186341187}] :answer-field/correct {:answer/id #uuid "e96c033c-24e5-59d6-9c28-291c33500939" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{\\sqrt{3}+3}{3}" :db/id #edb/ref 17592186341187} :answer-field/id #uuid "1da3650a-fb35-5fa8-b4ff-0230c249cc80" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186341433}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "98dd252e-cda8-57e3-b4c8-968d1e2d356e" :question/math-academy-id "q-73289" :question/problem "${\\int }_{\\pi /3}^{3\\pi /4}(-{csc}^{2}⁡x)\\,\\text{d}x=$" :question/worked-solution "Taking the antiderivative and evaluating the difference at the bounds, we get\n\n$$\n\\begin{aligned}\\begin{aligned}{\\int }_{\\pi /3}^{3\\pi /4}(-{csc}^{2}⁡x)\\,\\text{d}x & =\\operatorname{cot}⁡x\\,{|}_{\\pi /3}^{3\\pi /4} \\\\  & =\\operatorname{cot}⁡(\\frac{3\\pi }{4})-\\operatorname{cot}⁡(\\frac{\\pi }{3}) \\\\  & =-1-\\frac{\\sqrt{3}}{3} \\\\  & =-\\frac{\\sqrt{3}+3}{3}.\\end{aligned}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186341942 :knowledge-point/_questions [{:db/id #edb/ref 17592186096757 :knowledge-point/id #uuid "6ad216da-1bcf-5b87-9436-918ef1e5015a" :knowledge-point/title "Calculating the Area Bounded Above a Curve and Below the X-Axis"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0f0ed4f0-5448-5823-ac10-8ddabe75ea69" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3\\pi }{2}" :db/id #edb/ref 17592186339268} {:answer/id #uuid "241985ac-301e-578c-95ae-6d6852c9ad8e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5\\pi }{8}" :db/id #edb/ref 17592186339442} {:answer/id #uuid "55763794-df42-55a8-8a7a-2ca29903f3d9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\pi }{4}" :db/id #edb/ref 17592186339911} {:answer/id #uuid "84082d48-91f0-5d8c-8b1b-8c1e64192756" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\pi " :db/id #edb/ref 17592186340318} {:answer/id #uuid "a8a484cc-a6f3-56a4-859a-79aa0750ab52" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\pi }{2}" :db/id #edb/ref 17592186340662}] :answer-field/correct {:answer/id #uuid "a8a484cc-a6f3-56a4-859a-79aa0750ab52" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\pi }{2}" :db/id #edb/ref 17592186340662} :answer-field/id #uuid "d6eb5369-5d5c-58c3-a712-06128a8af0a8" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186341758}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "c981b646-bf72-5637-bcb5-fa81d4699700" :question/math-academy-id "q-73329" :question/problem "![](images/d7/d787ab7b213815ceb2cee11cf3f4a629c0f24b8328b33ae773be1e63f9f9a517.png)\n\nA region is bounded by the curve $y=-\\frac{2}{1+{x}^{2}}$, the $x$-axis, and the lines $x=0$ and $x=1$, as shown above. What is the area of the region?" :question/worked-solution "To find the area, we just need to compute the corresponding definite integral:\n\n$$\n\\begin{aligned}A & ={\\int }_{a}^{b}y(x)\\,\\text{d}x \\\\  & ={\\int }_{0}^{1}\\frac{-2}{1+{x}^{2}}\\,\\text{d}x \\\\  & =-2{\\int }_{0}^{1}\\frac{1}{1+{x}^{2}}\\,\\text{d}x \\\\  & =-2\\operatorname{arctan}⁡x{|}_{0}^{1} \\\\  & =-2(\\operatorname{arctan}⁡(1)-\\operatorname{arctan}⁡(0)) \\\\  & =-2(\\frac{\\pi }{4}-0) \\\\  & =-\\frac{\\pi }{2}.\\end{aligned}\n$$\n\nSince the region lies below the $x$-axis, we obtained a negative number. So the area that we want is $\\frac{\\pi }{2}.$"}] [{:db/id #edb/ref 17592186341943 :knowledge-point/_questions [{:db/id #edb/ref 17592186096757 :knowledge-point/id #uuid "6ad216da-1bcf-5b87-9436-918ef1e5015a" :knowledge-point/title "Calculating the Area Bounded Above a Curve and Below the X-Axis"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "30abb31d-0cea-5c7a-831e-96f5de788129" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\pi }{3}" :db/id #edb/ref 17592186339554} {:answer/id #uuid "6c6421ba-9fc4-5b06-b42e-97b8e9630769" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2\\pi }{3}" :db/id #edb/ref 17592186340085} {:answer/id #uuid "8323ac06-5123-5d38-a2e5-414f42c84379" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\pi }{2}" :db/id #edb/ref 17592186340307} {:answer/id #uuid "e6899588-5e41-526e-95e9-1b4de17de58f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\pi }{6}" :db/id #edb/ref 17592186341168} {:answer/id #uuid "ead28d9d-44e7-5693-be9e-8e7172b9ab41" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\pi }{4}" :db/id #edb/ref 17592186341201}] :answer-field/correct {:answer/id #uuid "30abb31d-0cea-5c7a-831e-96f5de788129" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\pi }{3}" :db/id #edb/ref 17592186339554} :answer-field/id #uuid "05af01ca-4de3-5a04-b54e-282cded90f04" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186341394}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "091e393b-fab2-5cbe-beb6-54d3099ab9eb" :question/math-academy-id "q-73333" :question/problem "![](images/18/1819bad0219f1709a01100daad00beb25a8bbc3688f9fe7c41be53bad8010455.png)\n\nA region is bounded by the curve $y=-\\frac{1}{\\sqrt{1-{x}^{2}}}$, the $x$-axis, and the lines $x=-0.5$ and $x=0.5$, as shown above. What is the area of the region?" :question/worked-solution "To find the area, we just need to compute the corresponding definite integral:\n\n$$\n\\begin{aligned}\\begin{aligned}A & ={\\int }_{a}^{b}y(x)\\,\\text{d}x \\\\  & ={\\int }_{-0.5}^{0.5}-\\frac{1}{\\sqrt{1-{x}^{2}}}\\,\\text{d}x \\\\  & =-{\\int }_{-0.5}^{0.5}\\frac{1}{\\sqrt{1-{x}^{2}}}\\,\\text{d}x \\\\  & =-\\operatorname{arcsin}⁡x{|}_{-0.5}^{0.5} \\\\  & =-(\\operatorname{arcsin}⁡(0.5)-\\operatorname{arcsin}⁡(-0.5)) \\\\  & =-\\frac{\\pi }{6}+(-\\frac{\\pi }{6}) \\\\  & =-\\frac{\\pi }{3}.\\end{aligned}\\end{aligned}\n$$\n\nSince the region lies below the $x$-axis, we obtained a negative number. So the area that we want is $\\frac{\\pi }{3}.$"}] [{:db/id #edb/ref 17592186364330 :knowledge-point/_questions [{:db/id #edb/ref 17592186078427 :knowledge-point/id #uuid "9693b76e-ba77-5314-bfbf-508b25bb1072" :knowledge-point/title "Evaluating a Definite Integral Given Integrals Over Adjacent Intervals"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2548572d-1828-5c15-9c24-9f69c26499fe" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "20" :db/id #edb/ref 17592186364332} {:answer/id #uuid "cdf16357-ff08-50aa-8d48-287a20aa338c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "15" :db/id #edb/ref 17592186364333} {:answer/id #uuid "fa312d6c-985e-5953-8527-699e0ddc3fc7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186364334} {:answer/id #uuid "ccf0fdd7-7278-5aa7-85cf-08123b8757dd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2}{5}" :db/id #edb/ref 17592186364335} {:answer/id #uuid "33458f8c-ced5-59e6-a323-8288679d085f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "25" :db/id #edb/ref 17592186364336}] :answer-field/correct {:answer/id #uuid "33458f8c-ced5-59e6-a323-8288679d085f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "25" :db/id #edb/ref 17592186364336} :answer-field/id #uuid "d18620e4-b83a-5036-9cc0-164c3885d9ea" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186364331}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "55c20ddf-7f41-5979-9443-af4fb8f03ef0" :question/math-academy-id "q-73342" :question/problem "Given that ${\\int }_{-2}^{-1}f(x)\\,\\text{d}x=\\frac{1}{2}$ and ${\\int }_{-1}^{1}f(x)\\,\\text{d}x=2$ then what is ${\\int }_{-2}^{1}(5+4f(x))\\,\\text{d}x?$" :question/worked-solution "From the adjacent intervals rule, we know that\n\n$$\n\\begin{aligned}{\\int }_{-2}^{-1}f(x)\\,\\text{d}x+{\\int }_{-1}^{1}f(x)\\,\\text{d}x={\\int }_{-2}^{1}f(x)\\,\\text{d}x.\\end{aligned}\n$$\n\nPlugging in the known information into the above gives the following:\n\n$$\n\\begin{aligned}\\frac{1}{2}+2={\\int }_{-2}^{1}f(x)\\,\\text{d}x \\\\ \\frac{5}{2}={\\int }_{-2}^{1}f(x)\\,\\text{d}x\\end{aligned}\n$$\n\n \n\nFinally, we compute the desired integral and get\n\n$$\n\\begin{aligned}{\\int }_{-2}^{1}(5+4f(x))\\,\\text{d}x & =5{\\int }_{-2}^{1}\\,\\text{d}x+4{\\int }_{-2}^{1}f(x)\\,\\text{d}x \\\\  & =5\\cdot x\\,{|}_{-2}^{1}+4(\\frac{5}{2}) \\\\  & =5(1-(-2))+10 \\\\  & =25.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186341950 :knowledge-point/_questions [{:db/id #edb/ref 17592186064160 :knowledge-point/id #uuid "a8756e5e-3ce4-5c02-8700-8e2f3fa81e9b" :knowledge-point/title "Completing the Mean Value Theorem Statement From the Graph of a Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "35102060-e421-5506-b343-09ab844dcdd1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{f}^{′}(c)=\\frac{5}{9}" :db/id #edb/ref 17592186339597} {:answer/id #uuid "3e7b5055-954d-56ea-9384-032671a551c9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{f}^{′}(c)=9" :db/id #edb/ref 17592186339690} {:answer/id #uuid "70fee4d5-6581-5186-a5bf-b5b3ca040f72" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{f}^{′}(c)=-\\frac{5}{9}" :db/id #edb/ref 17592186340131} {:answer/id #uuid "e1deaa2b-6f07-5248-b1cb-cdb339d56ea5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{f}^{′}(c)=\\frac{9}{5}" :db/id #edb/ref 17592186341130} {:answer/id #uuid "f987b3a5-c671-59d7-bae5-89eb545532fc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "f(c)=5" :db/id #edb/ref 17592186341334}] :answer-field/correct {:answer/id #uuid "35102060-e421-5506-b343-09ab844dcdd1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{f}^{′}(c)=\\frac{5}{9}" :db/id #edb/ref 17592186339597} :answer-field/id #uuid "d24fb5cd-bc17-56ab-a997-f30e8a335899" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186341752}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "af62622e-80ea-518f-a1c6-117cefb012fa" :question/math-academy-id "q-73349" :question/problem "![](images/63/6393810d90b8d340dbde041c43cb7e146cb59fedfcfd4a678827d291ea502b00.png)\n\nThe function $y=f(x)$ above is continuous on the interval $[-5,4]$ and differentiable on  $(-5,4).$  What is the missing part of the sentence in the statement below?\n\n*The mean value theorem states that there exists a point $c\\in (-5,4)$ such that $\\text{_______}\\,.$ *" :question/worked-solution "Given that $f(x)$ is continuous on $[a,b]$ and differentiable on  $(a,b)$, the mean value theorem states the following: \n\n*There exists a point $c\\in (a,b)$ such that*\n\n$$\n{f}^{′}(c)=\\frac{f(b)-f(a)}{b-a}.\n$$\n\nIn our case, we have $a=-5$ and $b=4.$ Thus, \n\n$$\n\\begin{aligned}{f}^{′}(c) & =\\frac{f(4)-f(-5)}{4-(-5)} \\\\  & =\\frac{7-2}{4+5} \\\\  & =\\frac{5}{9}.\\end{aligned}\n$$\n\nTherefore, the complete sentence is as follows:\n\n *The mean value theorem states that there exists a point $c\\in (-5,4)$ such that ${f}^{′}(c)=\\frac{5}{9}.$*"}] [{:db/id #edb/ref 17592186341958 :knowledge-point/_questions [{:db/id #edb/ref 17592186096819 :knowledge-point/id #uuid "9e9c4ef2-0491-5b42-8679-4fe7dfbd7b00" :knowledge-point/title "Finding a Partial Fraction Decomposition With Higher Order Factors"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "047cccdf-27f1-5cfb-b786-1c8d86f2746c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-32" :db/id #edb/ref 17592186339159} {:answer/id #uuid "49e879e3-cea2-5684-be86-6af3707f8d5a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-36" :db/id #edb/ref 17592186339792} {:answer/id #uuid "8aaa2710-0d0f-52e4-8149-15fbc048e9dd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "54" :db/id #edb/ref 17592186340367} {:answer/id #uuid "91914e32-168a-51fa-af34-cb11e5d0549f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-48" :db/id #edb/ref 17592186340434} {:answer/id #uuid "d67f00c6-3a76-5e96-adcd-17772f5a5452" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "42" :db/id #edb/ref 17592186341029}] :answer-field/correct {:answer/id #uuid "91914e32-168a-51fa-af34-cb11e5d0549f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-48" :db/id #edb/ref 17592186340434} :answer-field/id #uuid "02bffc3a-26ca-54b9-a2e5-c7f8ef639d65" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186341388}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "6fc41a67-28eb-5a31-90bd-82ff488b2606" :question/math-academy-id "q-73384" :question/problem "Given that \n\n$$\n\\frac{10-{x}^{2}}{(x-4)^{3}}=\\frac{A}{x-4}+\\frac{B}{(x-4)^{2}}+\\frac{C}{(x-4)^{3}},\n$$\n\nwhere $A$, $B$ and $C$ are real constants, find the value of $A\\cdot B\\cdot C.$" :question/worked-solution "Multiplying both sides of the given equality by $(x-4)^{3}$ gives\n\n$$\n\\begin{aligned}10-{x}^{2} & =A(x-4)^{2}+B(x-4)+C.\\end{aligned}\n$$\n\nLetting $x=4$ gives\n\n$$\n\\begin{aligned}10-{4}^{2} & =A(4-4)^{2}+B(4-4)+C \\\\ -6 & =A(0)+B(0)+C \\\\ C & =-6.\\end{aligned}\n$$\n\nLetting $x=0$ and using our value for $C$ gives\n\n$$\n\\begin{aligned}10-{0}^{2} & =A(0-4)^{2}+B(0-4)-6 \\\\ 10 & =16A-4B-6 \\\\ 0 & =16A-4B-16 \\\\ 0 & =4A-B-4 \\\\ B & =4A-4.\\,\\,(1)\\end{aligned}\n$$\n\nNow, letting $x=3$ and using our value for $C$ gives\n\n$$\n\\begin{aligned}10-{3}^{2} & =A(3-4)^{2}+B(3-4)-6 \\\\ 1 & =A-B-6 \\\\ 0 & =A-B-7 \\\\ B & =A-7.\\,\\,(2)\\end{aligned}\n$$\n\nFrom $(1)$ and $(2)$ we have\n\n$$\n\\begin{aligned}4A-4 & =A-7 \\\\ 3A & =-3 \\\\ A & =-1.\\end{aligned}\n$$\n\nNow we substitute the value of $A$ into $(2)$  to get the value of $B:$\n\n$$\n\\begin{aligned}B & =-1-7=-8\\end{aligned}\n$$\n\nFinally,\n\n$$\n\\begin{aligned}A\\cdot B\\cdot C & =-1\\cdot (-8)\\cdot (-6)=-48.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186341959 :knowledge-point/_questions [{:db/id #edb/ref 17592186096819 :knowledge-point/id #uuid "9e9c4ef2-0491-5b42-8679-4fe7dfbd7b00" :knowledge-point/title "Finding a Partial Fraction Decomposition With Higher Order Factors"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "00da50d5-06aa-555b-b932-f57f9775becc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186339137} {:answer/id #uuid "0ae0a319-26cd-5696-9948-2ba6df2a5b9b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-10" :db/id #edb/ref 17592186339220} {:answer/id #uuid "0ce2e706-9384-5074-b584-a4c836afe53d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-8" :db/id #edb/ref 17592186339246} {:answer/id #uuid "93c23325-5f41-55c9-a02d-50086fd7d539" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "9" :db/id #edb/ref 17592186340455} {:answer/id #uuid "d35d1d09-7ada-52f3-9bc7-c5c90d509c46" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "12" :db/id #edb/ref 17592186340999}] :answer-field/correct {:answer/id #uuid "00da50d5-06aa-555b-b932-f57f9775becc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186339137} :answer-field/id #uuid "6cf8987e-44ea-5077-b03b-d3da1349f0f2" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186341568}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "9b9b8ee3-9a8d-586a-9eb4-4aa3f12cfa23" :question/math-academy-id "q-73385" :question/problem "Given that \n\n$$\n\\frac{4x-1}{(x-3)^{3}}=\\frac{A}{x-3}+\\frac{B}{(x-3)^{2}}+\\frac{C}{(x-3)^{3}},\n$$\n\nwhere $A$, $B$ and $C$ are real constants, find the value of $A\\cdot B\\cdot C.$" :question/worked-solution "Multiplying both sides of the given equality by $(x-3)^{3}$ gives\n\n$$\n\\begin{aligned}4x-1 & =A(x-3)^{2}+B(x-3)+C.\\end{aligned}\n$$\n\nLetting $x=3$  gives\n\n$$\n\\begin{aligned}4(3)-1 & =A(3-3)^{2}+B(3-3)+C \\\\ 11 & =A(0)+B(0)+C \\\\ C & =11.\\end{aligned}\n$$\n\nLetting $x=0$ and using our value for $C$ gives\n\n$$\n\\begin{aligned}4(0)-1 & =A(0-3)^{2}+B(0-3)+11 \\\\ -1 & =9A-3B+11 \\\\ 0 & =9A-3B+12 \\\\ 0 & =3A-B+4 \\\\ B & =3A+4.\\,\\,(1)\\end{aligned}\n$$\n\nNow, letting $x=2$ and using our value for $C$ gives\n\n$$\n\\begin{aligned}4(2)-1 & =A(2-3)^{2}+B(2-3)+11 \\\\ 7 & =A-B+11 \\\\ 0 & =A-B+4 \\\\ B & =4+A.\\,\\,(2)\\end{aligned}\n$$\n\nFrom $(1)$ and $(2)$ we have\n\n$$\n\\begin{aligned}3A+4 & =4+A \\\\ 2A & =0 \\\\ A & =0.\\end{aligned}\n$$\n\nNow we substitute the value of $A$ into $(2)$  to get the value of $B:$\n\n$$\n\\begin{aligned}B & =4+0=4\\end{aligned}\n$$\n\nFinally,\n\n$$\n\\begin{aligned}A\\cdot B\\cdot C & =0\\cdot 4\\cdot 11=0.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186341962 :knowledge-point/_questions [{:db/id #edb/ref 17592186064244 :knowledge-point/id #uuid "a7d71bc2-c0f0-5504-9f79-a5f5cdb8cd92" :knowledge-point/title "Integrating a Rational Function Whose Denominator Contains a Leading Coefficient"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "35140882-11e0-5a76-9d64-f08dd266e69c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x-2\\operatorname{ln}⁡|x+3|+C" :db/id #edb/ref 17592186339599} {:answer/id #uuid "4c8bfed9-0bc8-5233-87f9-c7240d417e39" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x+2\\operatorname{ln}⁡|x+3|+C" :db/id #edb/ref 17592186339822} {:answer/id #uuid "990af541-0b72-5fb2-9f7c-fb14d5b8e6eb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{x}{2}-4\\operatorname{ln}⁡|x+3|+C" :db/id #edb/ref 17592186340510} {:answer/id #uuid "a5031bc0-b85a-5b9e-a1cd-220f1f9e3edd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{x}{2}-2\\operatorname{ln}⁡|x+3|+C" :db/id #edb/ref 17592186340628} {:answer/id #uuid "ce7b3778-33d4-57fb-856b-9f117e50c76e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{x}{4}+\\operatorname{ln}⁡|x+3|+C" :db/id #edb/ref 17592186340965}] :answer-field/correct {:answer/id #uuid "a5031bc0-b85a-5b9e-a1cd-220f1f9e3edd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{x}{2}-2\\operatorname{ln}⁡|x+3|+C" :db/id #edb/ref 17592186340628} :answer-field/id #uuid "aeabe9ab-2ac1-5399-81bd-fde2f6d5f67b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186341685}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "fa65d5b2-e8fb-51d7-a459-ab2b4f9de38b" :question/math-academy-id "q-73392" :question/problem "Calculate $\\int \\frac{x-1}{2x+6}\\,\\text{d}x.$" :question/worked-solution "First, we pull out the factor of $2$ from the denominator:\n\n$$\n\\begin{aligned}\\int \\frac{x-1}{2x+6}\\,\\text{d}x & =\\int \\frac{x-1}{2(x+3)}\\,\\text{d}x \\\\  & =\\frac{1}{2}\\int \\frac{x-1}{(x+3)}\\,\\text{d}x\\end{aligned}\n$$\n\nThen, we draw up our synthetic division table to decompose the integrand into its quotient and remainder.\n\n$$\n\\begin{aligned} & x & {x}^{0} \\\\ -3 & 1 & -1 \\\\  & ↓ & -3 \\\\  & 1 & -4\\end{aligned}\n$$\n\nSo from the synthetic division, we get that\n\n$$\n\\begin{aligned}\\frac{x-1}{(x+3)} & =1+\\frac{(-4)}{(x+3)} \\\\  & =1-\\frac{4}{(x+3)}\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\int \\frac{x-1}{2x+6}\\,\\text{d}x & =\\frac{1}{2}\\int (1-\\frac{4}{x+3})\\text{d}x \\\\  & =\\frac{1}{2}[\\int \\text{d}x-4\\int \\frac{1}{x+3}\\,\\text{d}x] \\\\  & =\\frac{1}{2}[x-4\\operatorname{ln}⁡|x+3|]+C \\\\  & =\\frac{x}{2}-2\\operatorname{ln}⁡|x+3|+C.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186097349 :knowledge-point/_questions [{:db/id #edb/ref 17592186096673 :knowledge-point/id #uuid "cd47a43f-1e99-5909-aa48-da8690025197" :knowledge-point/title "Solving a 3x3 System of Equations Using Standard Gaussian Elimination with Row Exchanges"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "38b8de74-9b19-5fcb-86d1-d4eb77627541" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$x=4$, $y=6$, and $z=5$" :db/id #edb/ref 17592186339638} {:answer/id #uuid "82fe070f-9ba8-572e-807f-b7e3a637c60e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$x=-1$, $y=2$, and $z=5$" :db/id #edb/ref 17592186340305} {:answer/id #uuid "98a029ca-6087-5b72-9ca2-e3147cdb70a0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$x=4$, $y=-5$, and $z=2$" :db/id #edb/ref 17592186340507} {:answer/id #uuid "d9e3c2ea-d16f-581b-9b65-22d05f5e48ba" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$x=4$, $y=5$, and $z=2$" :db/id #edb/ref 17592186341062} {:answer/id #uuid "e383876d-902d-5a68-82a6-fe6aedf0fd52" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$x=1$, $y=-6$, and $z=-5$" :db/id #edb/ref 17592186341142}] :answer-field/correct {:answer/id #uuid "38b8de74-9b19-5fcb-86d1-d4eb77627541" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$x=4$, $y=6$, and $z=5$" :db/id #edb/ref 17592186339638} :answer-field/id #uuid "18caed8a-a8c5-5f22-b7e0-3310a888fea7" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186341425}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "cdba1d21-3eaf-575a-9b38-07c8181fcd34" :question/math-academy-id "q-73396" :question/problem "Consider the system of linear equations\n\n$$\n\\{\\begin{aligned} & x-y+2z=8 \\\\  & -2x+2y-3z=-11 \\\\  & x+z=9.\\end{aligned}\n$$\n\nUse the standard method of Gaussian elimination to reduce the augmented matrix $M$ of the system to row echelon form, and then solve the linear system." :question/worked-solution "The augmented matrix for this system is\n\n$$\nM=[\\begin{aligned}1 & -1 & 2 & 8 \\\\ -2 & 2 & -3 & -11 \\\\ 1 & 0 & 1 & 9\\end{aligned}].\n$$\n\nReducing $M$ to row echelon form, we have\n\n$$\n\\begin{aligned}M & ∼[\\begin{aligned}1 & -1 & 2 & 8 \\\\ -2 & 2 & -3 & -11 \\\\ 1 & 0 & 1 & 9\\end{aligned}] & {R}_{2} & :={R}_{2}+2{R}_{1} \\\\  & ∼[\\begin{aligned}1 & -1 & 2 & 8 \\\\ 0 & 0 & 1 & 5 \\\\ 1 & 0 & 1 & 9\\end{aligned}] & {R}_{3} & :={R}_{3}+(-1){R}_{1} \\\\  & ∼[\\begin{aligned}1 & -1 & 2 & 8 \\\\ 0 & 0 & 1 & 5 \\\\ 0 & 1 & -1 & 1\\end{aligned}].\\end{aligned}\n$$\n\nNote that we get ${a}_{22}=0.$ Therefore, we swap the $2$nd and $3$rd rows:\n\n$$\n\\begin{aligned} & ∼[\\begin{aligned}1 & -1 & 2 & 8 \\\\ 0 & 0 & 1 & 5 \\\\ 0 & 2 & -1 & 1\\end{aligned}] & {R}_{2} & ↔{R}_{3} \\\\  & ∼[\\begin{aligned}1 & -1 & 2 & 8 \\\\ 0 & 1 & -1 & 1 \\\\ 0 & 0 & 1 & 5\\end{aligned}]\\end{aligned}\n$$\n\nSo, the system is now\n\n$$\n\\{\\begin{aligned}x-y+2z=8 \\\\ y-z=1 \\\\ z=5,\\end{aligned}\n$$\n\nand we can apply back substitution. The third equation $z=5$ tells us the value of $z.$ Substituting this value into the second equation, we get\n\n$$\n\\begin{aligned}y-(5)=1\\,⟹\\,y=6.\\end{aligned}\n$$\n\nNow, substituting $y=6$ and $z=5$ into the first equation, we get\n\n$$\n\\begin{aligned}x-(6)+2(5)=8\\,⟹\\,x=4.\\end{aligned}\n$$\n\nThus, the solution is $x=4$, $y=6$, and $z=5.$"}] [{:db/id #edb/ref 17592186097350 :knowledge-point/_questions [{:db/id #edb/ref 17592186096673 :knowledge-point/id #uuid "cd47a43f-1e99-5909-aa48-da8690025197" :knowledge-point/title "Solving a 3x3 System of Equations Using Standard Gaussian Elimination with Row Exchanges"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "be1e7bb8-9a1e-5458-a964-4b0a507198e1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "M∼\\begin{bmatrix}1 & 2 & 3 & 1 \\\\ 0 & 1 & \\frac{1}{3} & \\frac{7}{3} \\\\ 0 & 0 & 1 & -2\\end{bmatrix}" :db/id #edb/ref 17592186096025} {:answer/id #uuid "f02adf80-ad51-5b77-9de2-17a4ecf16d77" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "M∼\\begin{bmatrix}1 & 2 & 3 & 1 \\\\ 0 & 1 & -\\frac{1}{2} & \\frac{1}{2} \\\\ 0 & 0 & 1 & -5\\end{bmatrix}" :db/id #edb/ref 17592186096026} {:answer/id #uuid "055acce7-97cc-5db6-81ee-578ba34b19f3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "M∼\\begin{bmatrix}1 & 2 & 3 & 1 \\\\ 0 & 1 & 2 & 7 \\\\ 0 & 0 & 1 & 2\\end{bmatrix}" :db/id #edb/ref 17592186096027} {:answer/id #uuid "27935cd7-d828-53cd-bfc0-5f4b23f2869f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "M∼\\begin{bmatrix}1 & 2 & 3 & 1 \\\\ 0 & 1 & \\frac{2}{3} & -\\frac{7}{3} \\\\ 0 & 0 & 1 & 1\\end{bmatrix}" :db/id #edb/ref 17592186096028} {:answer/id #uuid "719ae79d-13da-5b25-8d45-65e4a648f56b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "M∼\\begin{bmatrix}1 & 2 & 3 & 1 \\\\ 0 & 1 & \\frac{1}{2} & -\\frac{1}{2} \\\\ 0 & 0 & 1 & 3\\end{bmatrix}" :db/id #edb/ref 17592186096029}] :answer-field/id #uuid "e780d91d-a5fd-57ae-9a3e-87dfda8e42d0" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186096024} {:answer-field/choices [{:answer/id #uuid "affc0ad4-801a-5399-8a47-b7526facc7d3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "M∼[\\begin{aligned}1 & 2 & 3 & 1 \\\\ 0 & 1 & 2 & 7 \\\\ 0 & 0 & 1 & 2\\end{aligned}]" :db/id #edb/ref 17592186403628} {:answer/id #uuid "ccb21bbb-79ee-5df3-9904-5df560da18c8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "M∼[\\begin{aligned}1 & 2 & 3 & 1 \\\\ 0 & 1 & \\frac{1}{3} & \\frac{7}{3} \\\\ 0 & 0 & 1 & -2\\end{aligned}]" :db/id #edb/ref 17592186403629} {:answer/id #uuid "c5805566-431b-59b1-b5d4-027282fdf8a0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "M∼[\\begin{aligned}1 & 2 & 3 & 1 \\\\ 0 & 1 & \\frac{1}{2} & -\\frac{1}{2} \\\\ 0 & 0 & 1 & 3\\end{aligned}]" :db/id #edb/ref 17592186403630} {:answer/id #uuid "ae4c1b86-80d7-59f5-af00-319d8bf12b68" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "M∼[\\begin{aligned}1 & 2 & 3 & 1 \\\\ 0 & 1 & \\frac{2}{3} & -\\frac{7}{3} \\\\ 0 & 0 & 1 & 1\\end{aligned}]" :db/id #edb/ref 17592186403631} {:answer/id #uuid "76bc4cc9-6acc-5be4-bff8-66f385a06fe3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "M∼[\\begin{aligned}1 & 2 & 3 & 1 \\\\ 0 & 1 & -\\frac{1}{2} & \\frac{1}{2} \\\\ 0 & 0 & 1 & -5\\end{aligned}]" :db/id #edb/ref 17592186403632}] :answer-field/correct {:answer/id #uuid "ae4c1b86-80d7-59f5-af00-319d8bf12b68" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "M∼[\\begin{aligned}1 & 2 & 3 & 1 \\\\ 0 & 1 & \\frac{2}{3} & -\\frac{7}{3} \\\\ 0 & 0 & 1 & 1\\end{aligned}]" :db/id #edb/ref 17592186403631} :answer-field/id #uuid "f15e152b-e602-5625-9a15-cb468ccf6dd8" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186403627}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "e85abf79-3b58-57ed-b3d6-9f31cc3b2817" :question/math-academy-id "q-73397" :question/problem "Consider the augmented matrix $M$ given by\n\n$$\nM=[\\begin{aligned}1 & 2 & 3 & 1 \\\\ 1 & 2 & 5 & 3 \\\\ 2 & 1 & 4 & 9\\end{aligned}].\n$$\n\nUse the standard method of Gaussian elimination to reduce the augmented matrix $M$ of the system to row echelon form." :question/worked-solution "Reducing $M$ to row echelon form, we have\n\n$$\n\\begin{aligned}M & ∼[\\begin{aligned}1 & 2 & 3 & 1 \\\\ 1 & 2 & 5 & 3 \\\\ 2 & 1 & 4 & 9\\end{aligned}] & {R}_{2} & :={R}_{2}+(-1){R}_{1} \\\\  & ∼[\\begin{aligned}1 & 2 & 3 & 1 \\\\ 0 & 0 & 2 & 2 \\\\ 2 & 1 & 4 & 9\\end{aligned}] & {R}_{3} & :={R}_{3}+(-2){R}_{1} \\\\  & ∼[\\begin{aligned}1 & 2 & 3 & 1 \\\\ 0 & 0 & 2 & 2 \\\\ 0 & -3 & -2 & 7\\end{aligned}].\\end{aligned}\n$$\n\nNote that we get ${a}_{22}=0.$ Therefore, we swap the $2$nd and $3$rd rows:\n\n$$\n\\begin{aligned} & ∼[\\begin{aligned}1 & 2 & 3 & 1 \\\\ 0 & 0 & 2 & 2 \\\\ 0 & -3 & -2 & 7\\end{aligned}] & {R}_{2} & ↔{R}_{3} \\\\  & ∼[\\begin{aligned}1 & 2 & 3 & 1 \\\\ 0 & -3 & -2 & 7 \\\\ 0 & 0 & 2 & 2\\end{aligned}]\\end{aligned}\n$$\n\nFinally, we multiply the $2$nd row by $-\\frac{1}{3}$ and the $3$rd row by $\\frac{1}{2}$ to get\n\n$$\n\\begin{aligned} & ∼[\\begin{aligned}1 & 2 & 3 & 1 \\\\ 0 & -3 & -2 & 7 \\\\ 0 & 0 & 2 & 2\\end{aligned}] & {R}_{2} & :=-\\frac{1}{3}{R}_{2} \\\\  & ∼[\\begin{aligned}1 & 2 & 3 & 1 \\\\ 0 & 1 & \\frac{2}{3} & -\\frac{7}{3} \\\\ 0 & 0 & 2 & 2\\end{aligned}] & {R}_{3} & :=\\frac{1}{2}{R}_{3} \\\\  & ∼[\\begin{aligned}1 & 2 & 3 & 1 \\\\ 0 & 1 & \\frac{2}{3} & -\\frac{7}{3} \\\\ 0 & 0 & 1 & 1\\end{aligned}].\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186403633 :knowledge-point/_questions [{:db/id #edb/ref 17592186064273 :knowledge-point/id #uuid "6b5ea4a7-acc4-5825-b6c5-b6c87e6a1674" :knowledge-point/title "Identifying Critical and Stationary Points of a Function Given Its Graph"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "17bd2520-0c4f-54a1-9032-4feba8ac4cd7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$x=6$ only" :db/id #edb/ref 17592186403635} {:answer/id #uuid "bf955400-4c85-5799-a0bb-34bb8034740d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$x=2$ only" :db/id #edb/ref 17592186403636} {:answer/id #uuid "fab62fe8-12aa-52f0-b98d-2406eb0e0b56" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "None" :db/id #edb/ref 17592186403637} {:answer/id #uuid "b01d168e-efd5-5ced-839e-03be5807a102" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$x=2$ and $x=6$ only" :db/id #edb/ref 17592186403638} {:answer/id #uuid "9102896f-bd20-58cb-a6f3-3d67a1deeab9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "All points in the closed interval $[2,6]$" :db/id #edb/ref 17592186403639}] :answer-field/correct {:answer/id #uuid "9102896f-bd20-58cb-a6f3-3d67a1deeab9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "All points in the closed interval $[2,6]$" :db/id #edb/ref 17592186403639} :answer-field/id #uuid "f7a88cb6-2519-5806-b90d-f5beabf35ae2" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186403634}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "6fc62285-d6ad-563b-a202-c3fe4f3d9e71" :question/math-academy-id "q-73409" :question/problem "![](images/7c/7c5bc75101a3bf4b4074bf60c1ab68962f2ed0de559f889365c3807be2fa833c.png)\n\nConsider the function $y=f(x)$ whose graph is shown above. What are the $x$-coordinates of all the critical points?" :question/worked-solution "The critical points of $f(x)$ are the values of $x$ where ${f}^{′}(x)=0$ or ${f}^{′}(x)$ doesn't exist. Graphically, those are the values where the tangent to the graph is horizontal or where the tangent does not exist, respectively.\n\nIn the given graph, we can see that\n\n- at any point between $x=2$ and $x=6$ the tangent to the graph is horizontal, so we have ${f}^{′}(x)=0,$ while\n\n- at $x=2$ and at $x=6$ there are sharp corners, hence ${f}^{′}(2)$ and ${f}^{′}(6)$ don't exist.\n\n![](images/6e/6e4299d762e26ff3de85ae0fd766d28368de937098dfcf232ce9a234fee826e1.png)\n\n  \n\nTherefore, all numbers in the closed interval $[2,6]$ are critical points for $f(x).$"}] [{:db/id #edb/ref 17592186403640 :knowledge-point/_questions [{:db/id #edb/ref 17592186064273 :knowledge-point/id #uuid "6b5ea4a7-acc4-5825-b6c5-b6c87e6a1674" :knowledge-point/title "Identifying Critical and Stationary Points of a Function Given Its Graph"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "cb4d5bbd-8b8e-5b87-b552-49eb950fa340" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$x=3$ only" :db/id #edb/ref 17592186403642} {:answer/id #uuid "25a9ad5d-e3da-5b19-ae3c-1a4da3e2def8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$x=3$, $x=4$, and $x=6$" :db/id #edb/ref 17592186403643} {:answer/id #uuid "4424aa1e-fbe6-5341-b6bf-db50547251d1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "All points in the open interval $(3,4)$" :db/id #edb/ref 17592186403644} {:answer/id #uuid "d8f5049a-410b-5e0f-aa9d-73bdc98cfb29" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$x=4$ only" :db/id #edb/ref 17592186403645} {:answer/id #uuid "ae9b2849-1a87-535e-a5be-0fdab3635438" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$x=3$ and $x=4$ only" :db/id #edb/ref 17592186403646}] :answer-field/correct {:answer/id #uuid "4424aa1e-fbe6-5341-b6bf-db50547251d1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "All points in the open interval $(3,4)$" :db/id #edb/ref 17592186403644} :answer-field/id #uuid "8aaf3855-a51d-5ca4-8c0a-99b3bc89ed52" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186403641}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "a831b1fe-cda9-5ab9-bf01-7acc19edee37" :question/math-academy-id "q-73410" :question/problem "![](images/ea/eab84ed04b86678fb4a8d23c010e9a22beead062595b49818ac95e996c3173e6.png)\n\nConsider the function $y=f(x)$ whose graph is shown above. What are the $x$-coordinates of all the stationary points?" :question/worked-solution "The stationary points of $f(x)$ are the values of $x$ where ${f}^{′}(x)=0.$ Graphically, those are the values where the tangent to the graph is horizontal.\n\nIn the given graph, we can see that at any point between $x=3$ and $x=4$ the tangent to the graph is horizontal, so we have ${f}^{′}(x)=0$ at those points.\n\n![](images/ab/ab200bebf80bbd1abe6e0c43ec124fe359da25f38d4346d25d8741decc88aa26.png)\n\n  \n\nTherefore, the $x$-coordinates of the stationary points of $f(x)$, are all values in the open interval $(3,4).$ \n\n**Note:** At $x=3$ and $x=4$, there are sharp corners, so ${f}^{′}(x)$ doesn't exist at those points. This gives us two more critical points. But they are not stationary points."}] [{:db/id #edb/ref 17592186341968 :knowledge-point/_questions [{:db/id #edb/ref 17592186083382 :knowledge-point/id #uuid "bd32a853-e0ec-5d56-bd6b-1c2e0e3249f8" :knowledge-point/title "Finding the Formula for the Sum of a Geometric Series Given an Arbitrary Term and the Common Ratio"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "25abe7d5-2dd8-5d8d-a859-04a703d90e44" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2({4}^{N}-1)" :db/id #edb/ref 17592186339450} {:answer/id #uuid "2b21d99f-79cb-5289-b29e-a4d290f769db" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{4}^{N}-2" :db/id #edb/ref 17592186339508} {:answer/id #uuid "951935fe-c42c-5840-aeef-c03afd6c1be4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{4}^{N}-1" :db/id #edb/ref 17592186340472} {:answer/id #uuid "ae71199b-ff93-5440-ad6f-dedd27aff1be" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3({4}^{N}-1)" :db/id #edb/ref 17592186340719} {:answer/id #uuid "d96fb042-78e1-5cd4-982c-d7afb9e3da45" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{4}^{N}-3" :db/id #edb/ref 17592186341058}] :answer-field/correct {:answer/id #uuid "25abe7d5-2dd8-5d8d-a859-04a703d90e44" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2({4}^{N}-1)" :db/id #edb/ref 17592186339450} :answer-field/id #uuid "6736a845-19c1-509c-8f33-5afd595ee681" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186341559}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "1393b828-a8fe-50bd-8838-3a6f101af8fc" :question/math-academy-id "q-73425" :question/problem "What is the sum of the first $N$ terms of a geometric series if the $4$th term is $384$ and the common ratio is $4?$" :question/worked-solution "We use the formula for the $n$th term of a geometric sequence to determine ${a}_{1}:$\n\n$$\n\\begin{aligned}{a}_{n} & ={a}_{1}{r}^{n-1} \\\\ 384 & ={a}_{1}\\cdot {4}^{(4-1)} \\\\ 384 & ={a}_{1}\\cdot {4}^{3} \\\\ 384 & =64{a}_{1} \\\\ {a}_{1} & =6\\end{aligned}\n$$\n\nThe sum of the first $N$ terms of a geometric series can be determined by the formula\n\n$$\n{S}_{N}=\\frac{{a}_{1}(1-{r}^{N})}{1-r}.\n$$\n\nIn this case, ${a}_{1}=6$ and $r=4.$ Substituting our values into the formula for ${S}_{N}$ gives:\n\n$$\n\\begin{aligned}{S}_{N} & =\\frac{6(1-{4}^{N})}{1-4} \\\\  & =\\frac{6}{(-3)}(1-{4}^{N}) \\\\  & =-2(1-{4}^{N}) \\\\  & =2({4}^{N}-1)\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186341969 :knowledge-point/_questions [{:db/id #edb/ref 17592186100877 :knowledge-point/id #uuid "4d63e99a-9db4-565e-97c5-ffc3090b0074" :knowledge-point/title "Calculating a Definite Integral of a Rational Function Using Substitution"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1fd377a2-95d6-5fde-b6fb-edd9f6c82895" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}\\operatorname{ln}⁡(\\frac{3}{2})" :db/id #edb/ref 17592186339404} {:answer/id #uuid "3886b9bb-57fc-5b04-9e14-43198654677d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{4}\\operatorname{ln}⁡(\\frac{3}{2})" :db/id #edb/ref 17592186339636} {:answer/id #uuid "a97ece83-bf8e-5d12-9343-39690fdb4170" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{4}\\operatorname{ln}⁡(2)" :db/id #edb/ref 17592186340671} {:answer/id #uuid "ba478bc4-e72f-56ec-9e2c-5aa0ce4151f1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{4}\\operatorname{ln}⁡(\\frac{5}{3})" :db/id #edb/ref 17592186340796} {:answer/id #uuid "ea3a1f4f-8538-5b6c-a02c-9ceb12a2d036" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}\\operatorname{ln}⁡(\\frac{5}{3})" :db/id #edb/ref 17592186341196}] :answer-field/correct {:answer/id #uuid "ea3a1f4f-8538-5b6c-a02c-9ceb12a2d036" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}\\operatorname{ln}⁡(\\frac{5}{3})" :db/id #edb/ref 17592186341196} :answer-field/id #uuid "1d077c61-6966-5590-ac4c-55b42acccc9c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186341432}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "76b52539-5773-539b-aa13-33f834965a19" :question/math-academy-id "q-73432" :question/problem "Calculate the definite integral ${\\int }_{0}^{2}\\frac{{x}^{3}}{{x}^{4}+9}\\,\\text{d}x.$" :question/worked-solution "We start by changing the variable:\n\n$$\n\\begin{aligned}u & ={x}^{4}+9 \\\\ \\frac{\\text{d}u}{\\text{d}x} & =4{x}^{3} \\\\ \\text{d}u & =4{x}^{3}\\,\\text{d}x \\\\ \\frac{1}{4}\\text{d}u & ={x}^{3}\\,\\text{d}x\\end{aligned}\n$$\n\nNext, we create a table for the limits of integration using the rule $u={x}^{4}+9.$ \n\n$$\n\\begin{aligned}x & 0 & 2 \\\\ u & 9 & 25\\end{aligned}\n$$\n\nSo, the integral in terms of the new variable is\n\n$$\n{\\int }_{0}^{2}\\frac{1}{({x}^{4}+9)}\\,{x}^{3}\\,\\text{d}x={\\int }_{9}^{25}\\frac{1}{u}\\cdot \\frac{1}{4}\\text{d}u.\n$$\n\nFinally, we can solve it and get\n\n$$\n\\begin{aligned}{\\int }_{9}^{25}\\frac{1}{u}\\cdot \\frac{1}{4}\\text{d}u & =\\frac{1}{4}{\\int }_{9}^{25}\\frac{1}{u}\\,\\text{d}u \\\\  & =\\frac{1}{4}\\operatorname{ln}⁡(u){|}_{9}^{25} \\\\  & =\\frac{1}{4}(\\operatorname{ln}⁡(25)-\\operatorname{ln}⁡(9)) \\\\  & =\\frac{1}{4}(\\operatorname{ln}⁡({5}^{2})-\\operatorname{ln}⁡({3}^{2})) \\\\  & =\\frac{1}{4}(2\\operatorname{ln}⁡(5)-2\\operatorname{ln}⁡(3)) \\\\  & =\\frac{1}{4}\\cdot 2(\\operatorname{ln}⁡(5)-\\operatorname{ln}⁡(3)) \\\\  & =\\frac{1}{2}\\operatorname{ln}⁡(\\frac{5}{3}).\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186341971 :knowledge-point/_questions [{:db/id #edb/ref 17592186115398 :knowledge-point/id #uuid "b34b7ab4-a17b-5667-bd2b-5ed53e43afb6" :knowledge-point/title "Differentiating Inverse Reciprocal Trigonometric Functions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "574af7f2-928a-5a00-b135-4916a6dec950" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2\\sqrt{x}}-\\frac{1}{|x|\\sqrt{{x}^{2}-1}}" :db/id #edb/ref 17592186339926} {:answer/id #uuid "987816d8-ddea-5472-bfa6-60df165674be" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{\\sqrt{x}}-\\frac{1}{2|x|\\sqrt{{x}^{2}-1}}" :db/id #edb/ref 17592186340500} {:answer/id #uuid "a07504e1-78da-53c1-a071-bf6d07bb482a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{\\sqrt{x}}+\\frac{2}{x\\sqrt{{x}^{2}-1}}" :db/id #edb/ref 17592186340581} {:answer/id #uuid "c71ac88f-b329-53fd-a776-c30ee71c20b3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2\\sqrt{x}}+\\frac{1}{2x\\sqrt{{x}^{2}-1}}" :db/id #edb/ref 17592186340893} {:answer/id #uuid "c94af7b5-9c00-52e6-891e-6dbf2ca55530" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2\\sqrt{x}}+\\frac{2}{|x|\\sqrt{{x}^{2}-1}}" :db/id #edb/ref 17592186340913}] :answer-field/correct {:answer/id #uuid "c94af7b5-9c00-52e6-891e-6dbf2ca55530" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2\\sqrt{x}}+\\frac{2}{|x|\\sqrt{{x}^{2}-1}}" :db/id #edb/ref 17592186340913} :answer-field/id #uuid "47d65433-3d6d-5565-a566-451d9ef6b0e8" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186341504}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "077baa93-9f9f-5780-986d-77a93ca959f7" :question/math-academy-id "q-73437" :question/problem "Calculate ${f}^{′}(x)$ if $f(x)=\\sqrt{x}-2arccscx.$" :question/worked-solution "The formula for the derivative of $arccsc$ is\n\n$$\n\\frac{\\text{d}}{\\text{d}x}(arccscx)=-\\frac{1}{|x|\\sqrt{{x}^{2}-1}}.\n$$\n\nUsing the formula above, we obtain\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}(\\sqrt{x}-2arccscx) \\\\  & =\\frac{1}{2\\sqrt{x}}-2\\cdot \\frac{\\text{d}}{\\text{d}x}(arccscx) \\\\  & =\\frac{1}{2\\sqrt{x}}-2(-\\frac{1}{|x|\\sqrt{{x}^{2}-1}}) \\\\  & =\\frac{1}{2\\sqrt{x}}+\\frac{2}{|x|\\sqrt{{x}^{2}-1}}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186341972 :knowledge-point/_questions [{:db/id #edb/ref 17592186105708 :knowledge-point/id #uuid "a87f2499-6998-587a-930e-65845c94710c" :knowledge-point/title "Determining Intervals on Which the Derivative of a Graphed Function Is Positive or Negative"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "06e849f2-0d82-5073-aa77-cd5d4fb1bd01" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(3,\\infty )" :db/id #edb/ref 17592186339186} {:answer/id #uuid "37148d11-d41c-5d54-9591-32b91a913845" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "No interval exists where ${f}^{′}(x)>0$" :db/id #edb/ref 17592186339622} {:answer/id #uuid "4c1c101c-dbdc-57a2-8a18-47167e8d9e4e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(0,3)" :db/id #edb/ref 17592186339814} {:answer/id #uuid "d6236f73-f858-5893-b8b7-370c02365c0b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-\\infty ,0)" :db/id #edb/ref 17592186341025} {:answer/id #uuid "f42648ec-482a-5a1e-9298-fdf2e942d735" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$(-\\infty ,0)$ and  $(3,\\infty )$" :db/id #edb/ref 17592186341279}] :answer-field/correct {:answer/id #uuid "4c1c101c-dbdc-57a2-8a18-47167e8d9e4e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(0,3)" :db/id #edb/ref 17592186339814} :answer-field/id #uuid "b4025992-9ab0-5f3a-84d8-0c85e13386ca" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186341695}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "e3a5e0d9-46d7-5173-8ba2-2227bb4800c5" :question/math-academy-id "q-73443" :question/problem "![](images/e0/e0adac4b5e6a66f6c6a38af96f2e55c05ec98a87857af736e40d22b31fdf259b.png)\n\nThe graph of the continuous function $y=f(x)$ is shown above. The points $A$ and $B$ lie on the curve and have $x$-coordinates $x=0$ and $x=3.$ Given that ${f}^{′}(x)=0$ at both $A$ and $B,$ find the intervals where ${f}^{′}(x)>0.$" :question/worked-solution "We have ${f}^{′}(x)=0$ at the critical points $A$ and $B.$ Note the following:\n\n- If $f(x)$ is strictly increasing, then ${f}^{′}(x)>0.$\n\n- If $f(x)$ is strictly decreasing, then ${f}^{′}(x)<0.$\n\nThe information about ${f}^{′}(x)$ can be summarized in the following table:\n\n$$\n\\begin{aligned}x & (-\\infty ,0) & 0 & (0,3) & 3 & (3,\\infty ) \\\\ f & ↘ & \\text{min} & ↗ & \\text{max} & ↘ \\\\ {f}^{′} & - & 0 & + & 0 & -\\end{aligned}\n$$\n\nTherefore, ${f}^{′}(x)>0$ on the interval $(0,3).$"}] [{:db/id #edb/ref 17592186341974 :knowledge-point/_questions [{:db/id #edb/ref 17592186115399 :knowledge-point/id #uuid "20a5f15e-8a26-57af-a867-8f8ae02a91c1" :knowledge-point/title "Differentiating Inverse Reciprocal Trigonometric Functions Using the Quotient Rule"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3ed6b8a7-489f-5243-a1ab-0833d4b3659d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{{e}^{3x}|x|\\sqrt{{x}^{2}-1}}-\\frac{{e}^{3x}arccscx}{{e}^{3x}-1}" :db/id #edb/ref 17592186339694} {:answer/id #uuid "72547bb8-80f4-5189-a664-31a103998d0e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{3}{({e}^{3x}-1)|x|\\sqrt{{x}^{2}-1}}+\\frac{{e}^{3x}arccscx}{({e}^{3x}-1)^{2}}" :db/id #edb/ref 17592186340143} {:answer/id #uuid "778014a0-4d28-5cbd-bcfb-226c4ad315c6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{{e}^{3x}-1}{|x|\\sqrt{{x}^{2}-1}}+\\frac{3arccscx}{{e}^{3x}({e}^{3x}-1)}" :db/id #edb/ref 17592186340192} {:answer/id #uuid "de92d6cb-e70b-5bc3-b99c-b1ff038239da" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{({e}^{3x}-1)|x|\\sqrt{{x}^{2}-1}}-\\frac{3{e}^{3x}arccscx}{({e}^{3x}-1)^{2}}" :db/id #edb/ref 17592186341104} {:answer/id #uuid "fb52f006-44ca-5a45-b8f9-20bd82b1abbb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{{e}^{3x}|x|\\sqrt{{x}^{2}-1}}+\\frac{{e}^{3x}arccscx}{{e}^{3x}-1}" :db/id #edb/ref 17592186341348}] :answer-field/correct {:answer/id #uuid "de92d6cb-e70b-5bc3-b99c-b1ff038239da" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{({e}^{3x}-1)|x|\\sqrt{{x}^{2}-1}}-\\frac{3{e}^{3x}arccscx}{({e}^{3x}-1)^{2}}" :db/id #edb/ref 17592186341104} :answer-field/id #uuid "d070584c-5ac5-5571-b148-95c94bd096be" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186341746}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "f1d541e8-a8d8-5346-9cfd-53646530c168" :question/math-academy-id "q-73448" :question/problem "Calculate $\\frac{\\text{d}y}{\\text{d}x}$ for $y=\\frac{arccscx}{{e}^{3x}-1}.$" :question/worked-solution "Here, we let $u(x)=arccscx$ and $v(x)={e}^{3x}-1$, and apply the quotient rule.\n\nWe use the formulae\n\n$$\n{u}^{′}(x)=-\\frac{1}{|x|\\sqrt{{x}^{2}-1}}\\,\\text{and}\\,{v}^{′}(x)=3{e}^{3x}.\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{{u}^{′}(x)\\cdot v(x)-u(x)\\cdot {v}^{′}(x)}{[v(x)]^{2}} \\\\  & =\\frac{-\\frac{1}{|x|\\sqrt{{x}^{2}-1}}\\cdot ({e}^{3x}-1)-arccscx\\cdot 3{e}^{3x}}{({e}^{3x}-1)^{2}} \\\\  & =-\\frac{1}{({e}^{3x}-1)|x|\\sqrt{{x}^{2}-1}}-\\frac{3{e}^{3x}arccscx}{({e}^{3x}-1)^{2}}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186341975 :knowledge-point/_questions [{:db/id #edb/ref 17592186175902 :knowledge-point/id #uuid "205c5518-c67a-5784-8cc7-55b42ce7fb0e" :knowledge-point/title "Determining Whether the Extreme Value Theorem Is Applicable to a Function Given Its Graph"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1f9c9d7d-cafe-5ca3-aeda-6ab3a8844c04" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186339402} {:answer/id #uuid "466f898a-a17d-5ef2-9df7-de21d4467270" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186339753} {:answer/id #uuid "53dd7fea-deec-5659-abd2-913b366a2e31" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186339904} {:answer/id #uuid "71573f37-88c6-5316-841b-9e7cbf18b8f2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186340135} {:answer/id #uuid "9acfcc52-3763-5eb4-9f6b-ab6d62822c30" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186340525}] :answer-field/correct {:answer/id #uuid "53dd7fea-deec-5659-abd2-913b366a2e31" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186339904} :answer-field/id #uuid "8811fa51-bfe6-5509-90af-f31705a35d36" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186341617}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "cbdd6305-e297-593d-89f4-fb7ada8ade14" :question/math-academy-id "q-73455" :question/problem "![](images/de/de39663db59e42565c7d69d8a44a4cb95f14af0f4946b77cfc42eac02f7d2786.png)\n\nConsider the function $y=f(x)$ whose graph is plotted above. On which of the following intervals is the extreme value theorem applicable to $f(x)?$\n\nI. $[-\\pi ,\\pi ]$\n\nII. $[-\\pi ,0)$\n\nIII. $[1,\\pi ]$" :question/worked-solution "Remember that the extreme value theorem is only applicable to closed intervals on which the function is continuous.\n\nWith that in mind, let's take a look at each interval.\n\n- The interval  $[-\\pi ,\\pi ]$ is closed,but the function has a removable discontinuity at $x=0.$ Therefore, the extreme value theorem is not applicable.\n\n- The interval $[-\\pi ,0)$ is not closed, so, the extreme value theorem is not applicable.\n\n- The interval $[1,\\pi ]$ is closed, and the function is continuous on $[1,\\pi ].$ Therefore, the extreme value theorem is applicable.\n\nIn conclusion, the correct answer is \"III only\"."}] [{:db/id #edb/ref 17592186341976 :knowledge-point/_questions [{:db/id #edb/ref 17592186105735 :knowledge-point/id #uuid "7ba6b6b5-ac1d-5a3a-876a-af51fdf50e0a" :knowledge-point/title "Calculating the Scalar Triple Product Using the Definition"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2f5ad400-1475-5884-8d73-aa99d98ec4d6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "16" :db/id #edb/ref 17592186339542} {:answer/id #uuid "57d0a154-1aaa-5696-835d-3eecfa11a6d9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186339929} {:answer/id #uuid "86e1fe55-454a-5121-bac4-46896aa3ba50" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-21" :db/id #edb/ref 17592186340340} {:answer/id #uuid "908c7900-9735-5a67-b556-85b9b49edab0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-9" :db/id #edb/ref 17592186340424} {:answer/id #uuid "f836db60-b44d-5c4b-8a95-1f0a325c7eee" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186341322}] :answer-field/correct {:answer/id #uuid "f836db60-b44d-5c4b-8a95-1f0a325c7eee" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186341322} :answer-field/id #uuid "bd6a14fe-e999-58b2-a558-e4c85c9c9d40" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186341707}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "03c3f067-95a3-5c61-bbcc-2fdbc5e2a97b" :question/math-academy-id "q-73457" :question/problem "Given that $a=⟨1,-3,2⟩,$ $b=⟨2,-1,-1⟩,$ and $c=⟨3,-3,0⟩,$ find $a\\cdot (b\\times c)$ using the definition of the scalar triple product." :question/worked-solution "First, we find the cross product:\n\n$$\n\\begin{aligned}b\\times c & =|\\begin{aligned}i & j & k \\\\ 2 & -1 & -1 \\\\ 3 & -3 & 0\\end{aligned}| \\\\  & =|\\begin{aligned}-1 & -1 \\\\ -3 & 0\\end{aligned}|i-|\\begin{aligned}2 & -1 \\\\ 3 & 0\\end{aligned}|j+|\\begin{aligned}2 & -1 \\\\ 3 & -3\\end{aligned}|k \\\\  & =((-1)\\cdot 0-(-1)\\cdot (-3))i-(2\\cdot 0-(-1)\\cdot 3)j+(2\\cdot (-3)-(-1)\\cdot 3)k \\\\  & =-3i-3j-3k \\\\  & =⟨-3,-3,-3⟩\\end{aligned}\n$$\n\nNow, we can compute the scalar triple product:\n\n$$\n\\begin{aligned}a\\cdot (b\\times c) & =⟨1,-3,2⟩\\cdot ⟨-3,-3,-3⟩ \\\\  & =1\\cdot (-3)+(-3)\\cdot (-3)+2\\cdot (-3) \\\\  & =0.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186341984 :knowledge-point/_questions [{:db/id #edb/ref 17592186175903 :knowledge-point/id #uuid "3bbc6a2d-2078-50d5-9584-c705c19212da" :knowledge-point/title "Identifying Intervals on Which a Given Function Satisfies the Extreme Value Theorem"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0c85ec74-7261-5a84-b268-2cb5156ec3e8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186339237} {:answer/id #uuid "324afc9c-5fc7-5f92-8306-6b5f8eebe2c3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186339570} {:answer/id #uuid "696a6442-ff9a-551c-9da2-c842f797cf3a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186340065} {:answer/id #uuid "85e6b77c-a45a-52cf-b8c9-1652a4b8a948" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186340328} {:answer/id #uuid "facb3de9-0178-54cd-b07c-1c80bbb75fb7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186341346}] :answer-field/correct {:answer/id #uuid "324afc9c-5fc7-5f92-8306-6b5f8eebe2c3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186339570} :answer-field/id #uuid "217a3a4a-e905-59b0-918b-c92be80eb6b7" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186341440}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "122f233b-5382-5fef-8fbd-2b8682266e28" :question/math-academy-id "q-73481" :question/problem "On which of the following intervals can the extreme value theorem be applied to the function $y=\\frac{\\sqrt[4]{x}}{{x}^{2}+1}?$   \n\nI. $[-1,5]$\n\nII. $[0,2]$\n\nIII. $[2,5]$" :question/worked-solution "Remember that the extreme value theorem is only applicable to closed intervals on which the function is continuous. \n\nWith that in mind, let's take a look at each interval.\n\n- The interval $[-1,5]$ is closed, but the function is not continuous on it because $\\sqrt[4]{x}$ is not defined anywhere in the subinterval $[-1,0).$  Therefore, the extreme value theorem is not applicable.\n\n- The intervals $[0,2]$ and $[2,5]$ are closed, and the function is continuous on each of these intervals Therefore, the extreme value theorem is applicable on each $[0,2]$  and $[2,5].$\n\nIn conclusion, the correct answer is \"II and III only\"."}] [{:db/id #edb/ref 17592186341986 :knowledge-point/_questions [{:db/id #edb/ref 17592186175903 :knowledge-point/id #uuid "3bbc6a2d-2078-50d5-9584-c705c19212da" :knowledge-point/title "Identifying Intervals on Which a Given Function Satisfies the Extreme Value Theorem"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0a68717c-3c5f-58a5-9174-e8f45f3e1ef1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186339216} {:answer/id #uuid "336f07da-9df2-582d-80ca-e44d8eb292b0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186339585} {:answer/id #uuid "43af0409-9e51-5d17-a8fb-98b37bd00bec" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186339722} {:answer/id #uuid "72581646-406e-5e01-9bba-7ad77de94142" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186340144} {:answer/id #uuid "8e33f721-3fb7-5e44-8644-c40ab2c07185" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186340406}] :answer-field/correct {:answer/id #uuid "336f07da-9df2-582d-80ca-e44d8eb292b0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186339585} :answer-field/id #uuid "9a35e850-44d5-5740-b0b8-70909d0b180d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186341650}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "5aba1141-c0a4-54c1-bd64-30eb78786676" :question/math-academy-id "q-73484" :question/problem "On which of the following intervals can the extreme value theorem be applied to the function $y=\\sqrt{\\operatorname{cos}⁡x}?$    \n\nI. $[\\frac{\\pi }{2},\\pi ]$\n\nII. $[\\frac{\\pi }{4},\\frac{\\pi }{2})$\n\nIII. $[0,\\frac{\\pi }{2}]$" :question/worked-solution "Remember that the extreme value theorem is only applicable to closed intervals on which the function is continuous. \n\nWith that in mind, let's take a look at each interval.\n\n- The interval $[\\frac{\\pi }{2},\\pi ]$  is closed, but the function is not defined on a part of the interval because $\\operatorname{cos}⁡(x)<0$ for all $x\\in (\\frac{\\pi }{2},\\pi ].$ Therefore, the extreme value theorem is not applicable.\n\n- The interval $[\\frac{\\pi }{4},\\frac{\\pi }{2})$    is not closed, so the extreme value theorem is not applicable.\n\n- The interval $[0,\\frac{\\pi }{2}]$ is  closed, and the function is continuous on $[0,\\frac{\\pi }{2}].$ Therefore, the extreme value theorem is applicable.\n\nIn conclusion, the correct answer is \"III only\"."}] [{:db/id #edb/ref 17592186393292 :knowledge-point/_questions [{:db/id #edb/ref 17592186059754 :knowledge-point/id #uuid "50c01507-99a7-5328-8d74-c9e9bda51330" :knowledge-point/title "Calculating the Inverse of a 3x3 Matrix Using the Matrix of Cofactors"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8f6f82c2-90c5-5b86-9116-e45789f5346b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{12}[\\begin{aligned}0 & -1 & 3 \\\\ 0 & 4 & 18 \\\\ -12 & 0 & -6\\end{aligned}]" :db/id #edb/ref 17592186393294} {:answer/id #uuid "48104ce2-f01f-520d-9994-ff0f604fb955" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "12[\\begin{aligned}0 & 0 & 12 \\\\ 1 & -4 & -18 \\\\ -3 & 0 & 6\\end{aligned}]" :db/id #edb/ref 17592186393295} {:answer/id #uuid "e267455a-8414-553e-ad9e-957e9a3d2a98" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{12}[\\begin{aligned}0 & -1 & 3 \\\\ 0 & 4 & 0 \\\\ -12 & 0 & -6\\end{aligned}]" :db/id #edb/ref 17592186393296} {:answer/id #uuid "792ada25-1920-5890-a2c7-80e2010138b0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[\\begin{aligned}0 & 0 & -1 \\\\ -1 & 4 & 18 \\\\ 3 & 0 & -6\\end{aligned}]" :db/id #edb/ref 17592186393297} {:answer/id #uuid "1506d6fc-6064-5295-a81e-822db7a19957" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{12}[\\begin{aligned}0 & 0 & -12 \\\\ -1 & 4 & 18 \\\\ 3 & 0 & -6\\end{aligned}]" :db/id #edb/ref 17592186393298}] :answer-field/correct {:answer/id #uuid "1506d6fc-6064-5295-a81e-822db7a19957" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{12}[\\begin{aligned}0 & 0 & -12 \\\\ -1 & 4 & 18 \\\\ 3 & 0 & -6\\end{aligned}]" :db/id #edb/ref 17592186393298} :answer-field/id #uuid "14ebbec9-43d1-5641-a2c2-12f7a04b7202" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186393293}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "2d1042ad-eb6e-59f8-9dab-abab5265f662" :question/math-academy-id "q-73485" :question/problem "Find the inverse of the matrix $A=[\\begin{aligned}-2 & 0 & 4 \\\\ 4 & 3 & 1 \\\\ -1 & 0 & 0\\end{aligned}]$\ngiven that $det(A)=12.$" :question/worked-solution "Let's follow the standard five-step procedure.\n\n**Step 1:** We are given the determinant of $A:$\n\n$$\n\\begin{aligned}det(A)=12\\end{aligned}\n$$\n\n**Step 2:** Form the matrix of the minors of $A.$\nTo make this matrix, we replace each entry of $A$ by its minor.\n\n$$\n\\begin{aligned}M & =[\\begin{aligned}|\\begin{aligned}3 & 1 \\\\ 0 & 0\\end{aligned}| & |\\begin{aligned}4 & 1 \\\\ -1 & 0\\end{aligned}| & |\\begin{aligned}4 & 3 \\\\ -1 & 0\\end{aligned}| \\\\ |\\begin{aligned}0 & 4 \\\\ 0 & 0\\end{aligned}| & |\\begin{aligned}-2 & 4 \\\\ -1 & 0\\end{aligned}| & |\\begin{aligned}-2 & 0 \\\\ -1 & 0\\end{aligned}| \\\\ |\\begin{aligned}0 & 4 \\\\ 3 & 1\\end{aligned}| & |\\begin{aligned}-2 & 4 \\\\ 4 & 1\\end{aligned}| & |\\begin{aligned}-2 & 0 \\\\ 4 & 3\\end{aligned}|\\end{aligned}] \\\\  & =[\\begin{aligned}0 & 1 & 3 \\\\ 0 & 4 & 0 \\\\ -12 & -18 & -6\\end{aligned}].\\end{aligned}\n$$\n\n**Step 3:** Create the matrix of cofactors by changing the sign of some of the entries of $M$ according to the rule of alternating signs.\n\n$$\nC=[\\begin{aligned}0 & -1 & 3 \\\\ 0 & 4 & 0 \\\\ -12 & 18 & -6\\end{aligned}].\n$$\n\n**Step 4:** Write down the transpose of the matrix of cofactors.\n\n$$\n{C}^{T}=[\\begin{aligned}0 & 0 & -12 \\\\ -1 & 4 & 18 \\\\ 3 & 0 & -6\\end{aligned}].\n$$\n\n**Step 5:** Use the formula for the inverse of a $3\\times 3$ matrix.\n\n$$\n\\begin{aligned}{A}^{-1} & =\\frac{1}{det(A)}{C}^{T} \\\\  & =\\frac{1}{12}[\\begin{aligned}0 & 0 & -12 \\\\ -1 & 4 & 18 \\\\ 3 & 0 & -6\\end{aligned}].\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186341988 :knowledge-point/_questions [{:db/id #edb/ref 17592186175903 :knowledge-point/id #uuid "3bbc6a2d-2078-50d5-9584-c705c19212da" :knowledge-point/title "Identifying Intervals on Which a Given Function Satisfies the Extreme Value Theorem"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0a506d32-c549-5247-82e3-f237fa06872d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186339215} {:answer/id #uuid "22362652-f0bc-5e3c-afa7-25ce82d78661" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186339421} {:answer/id #uuid "327c0e31-b1ed-5548-81bc-18ff4bca8bd4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186339573} {:answer/id #uuid "87824f92-9edf-52ca-9f8c-b3eeb64b58cd" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186340341} {:answer/id #uuid "a19759de-fa06-5d86-925a-320a7299775b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186340594}] :answer-field/correct {:answer/id #uuid "a19759de-fa06-5d86-925a-320a7299775b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186340594} :answer-field/id #uuid "8a8dae27-98ed-5b9c-b45d-d7007b99d819" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186341622}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "96d14ec6-ae06-5360-8ddd-d401dbb48508" :question/math-academy-id "q-73487" :question/problem "On which of the following intervals can the extreme value theorem be applied to the function $y=\\frac{x}{{2}^{x}-1}?$    \n\nI. $[0,1]$\n\nII. $[0,1)$\n\nIII. $[-2,-1]$" :question/worked-solution "Remember that the extreme value theorem is only applicable to closed intervals on which the function is continuous. \n\nWith that in mind, let's take a look at each interval.\n\n- The interval $[0,1]$ is closed, but the function is not continuous on it because it is not defined at $x=0$ (it makes zero the denominator).   Therefore, the extreme value theorem is not applicable.\n\n- The interval  $[0,1)$   is not closed, so the extreme value theorem is not applicable.\n\n- The interval $[-2,-1]$    is closed, and the function is continuous on $[-2,-1].$   Therefore, the extreme value theorem is applicable.\n\nIn conclusion, the correct answer is \"III only\"."}] [{:db/id #edb/ref 17592186341990 :knowledge-point/_questions [{:db/id #edb/ref 17592186175901 :knowledge-point/id #uuid "eede91c4-9099-55df-a803-f87895d9f51b" :knowledge-point/title "Applying the Extreme Value Theorem to Piecewise Functions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "27cfa7a4-d6c1-5351-99b2-6635044d85f2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186339474} {:answer/id #uuid "65459a76-323b-5a88-8a2f-2e108e43ea11" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186340024} {:answer/id #uuid "88971863-2310-5e3f-ac5d-6e4e1adfb7df" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186340348} {:answer/id #uuid "91912873-03a1-524d-9ad0-7c617923af84" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186340433} {:answer/id #uuid "be62f3bd-2eeb-5b57-889c-ca65dbe099b6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186340825}] :answer-field/correct {:answer/id #uuid "91912873-03a1-524d-9ad0-7c617923af84" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186340433} :answer-field/id #uuid "bcb8b636-417c-59ba-b9cc-599917ded547" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186341706}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "7b9b884e-eb8a-59c7-aa31-49f0025fb47f" :question/math-academy-id "q-73495" :question/problem "Suppose that $f(x)$ is defined as\n\n$$\nf(x)=\\{\\begin{aligned}{2}^{-x}, & x\\ge 0 \\\\ -1, & x<0.\\end{aligned}\n$$\n\nOn which of the following intervals can the extreme value theorem be applied to the function?\n\nI. $[-1,1]$\n\nII. $[\\frac{1}{2},1]$\n\nIII. $[-1,0)$" :question/worked-solution "Remember that the extreme value theorem is only applicable to closed intervals on which the function is continuous.\n\nSo, let's check whether the function is continuous on each of the intervals.\n\n- First, consider $[-1,1].$ In this case, we have\n\n$$\n\\begin{aligned}{lim}_{x\\to {0}^{+}}f(x) & ={lim}_{x\\to 0}({2}^{-x})={2}^{0}=1, \\\\ {lim}_{x\\to {0}^{-}}f(x) & ={lim}_{x\\to 0}(-1)=-1.\\end{aligned}\n$$\n\nSo, the limits from the left and from the right of $x=0$ are not the same. Hence, $f(x)$ has a discontinuity at $x=0.$ Therefore, $f(x)$ is not continuous on the interval $[-1,1],$ and the extreme value theorem is not applicable on this interval.\n\n- Now, consider the interval $[\\frac{1}{2},1].$ In this interval, $f(x)={2}^{-x}$ and so $f(x)$ is continuous on $[\\frac{1}{2},1].$  Therefore, the extreme value theorem is applicable on this interval.\n\n- Finally, the interval $[-1,0)$, is not closed, so the extreme value theorem is not applicable in this case.\n\nIn conclusion, the correct answer is \"II only\"."}] [{:db/id #edb/ref 17592186341991 :knowledge-point/_questions [{:db/id #edb/ref 17592186175901 :knowledge-point/id #uuid "eede91c4-9099-55df-a803-f87895d9f51b" :knowledge-point/title "Applying the Extreme Value Theorem to Piecewise Functions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2ceb0ce8-da1c-5b99-9182-d772be7cec72" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186339520} {:answer/id #uuid "7896c996-e406-5136-a44c-25645e86bbc5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186340203} {:answer/id #uuid "9a19840a-be8c-5757-bad3-4daa8391bbb3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186340517} {:answer/id #uuid "a718fb5b-1dd8-5664-a8f8-13023ada0bfa" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186340646} {:answer/id #uuid "f499afb4-f0c7-5505-912f-71dee8dd2498" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186341285}] :answer-field/correct {:answer/id #uuid "9a19840a-be8c-5757-bad3-4daa8391bbb3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186340517} :answer-field/id #uuid "141d901b-70e2-5398-8913-6c50c5c4a073" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186341416}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "d1eaad6e-884d-57bd-a4ae-a690d3d6abe9" :question/math-academy-id "q-73499" :question/problem "Suppose that $f(x)$ is defined as\n\n$$\nf(x)=\\{\\begin{aligned}\\operatorname{ln}⁡(x-1), & x>1 \\\\ x-1, & x\\le 1.\\end{aligned}\n$$\n\nOn which of the following intervals can the extreme value theorem be applied to the function?\n\nI. $[0,2]$\n\nII. $[-1,0]$\n\nIII. $[-1,2]$" :question/worked-solution "Remember that the extreme value theorem is only applicable to closed intervals on which the function is continuous.\n\nSo, let's check whether the function is continuous on each of the intervals.\n\n- First, consider $[0,2].$ In this case, we have\n\n$$\n\\begin{aligned}{lim}_{x\\to {1}^{+}}f(x) & ={lim}_{x\\to {1}^{+}}\\operatorname{ln}⁡(x-1)=-\\infty .\\end{aligned}\n$$\n\nHence, $f(x)$ has an essential discontinuity at $x=1.$ Therefore, $f(x)$ is not continuous on the interval $[0,2],$ and the extreme value theorem is not applicable on this interval.\n\n- Now, consider the interval $[-1,0].$ In this interval, $f(x)=x-1$ and so $f(x)$ is continuous on $[-1,0].$  Therefore, the extreme value theorem is applicable on this interval.\n\n- Finally, in the interval $[-1,2]$, we also have\n\n$$\n\\begin{aligned}{lim}_{x\\to {1}^{+}}f(x) & ={lim}_{x\\to {1}^{+}}\\operatorname{ln}⁡(x-1)=-\\infty .\\end{aligned}\n$$\n\n \nHence, $f(x)$ is not continuous on $[-1,2]$ and therefore  the extreme value theorem is not applicable on this interval.\n\nIn conclusion, the correct answer is \"II only\"."}] [{:db/id #edb/ref 17592186341995 :knowledge-point/_questions [{:db/id #edb/ref 17592186064368 :knowledge-point/id #uuid "552973a7-4ab5-5918-83f4-15ee0e3ee052" :knowledge-point/title "Differentiating an Inverse Sine Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3627b1da-fd8d-505f-a997-ae807566590b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{9}{\\sqrt{1+{x}^{2}}}" :db/id #edb/ref 17592186339612} {:answer/id #uuid "74b11f6e-134b-5711-a698-784d2b72cfb2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{9\\sqrt{1+{x}^{2}}}" :db/id #edb/ref 17592186340171} {:answer/id #uuid "8273beb7-017b-5ab4-8c6d-2816c8c83351" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{9}{\\sqrt{1-{x}^{2}}}" :db/id #edb/ref 17592186340303} {:answer/id #uuid "c5d32868-fd11-5abe-9361-4ab3f8f960c6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{9}{\\sqrt{1+{x}^{2}}}" :db/id #edb/ref 17592186340881} {:answer/id #uuid "f9927d95-93dd-5fa7-87cf-bd5c9eb69f0e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{9}{\\sqrt{1-{x}^{2}}}" :db/id #edb/ref 17592186341335}] :answer-field/correct {:answer/id #uuid "8273beb7-017b-5ab4-8c6d-2816c8c83351" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{9}{\\sqrt{1-{x}^{2}}}" :db/id #edb/ref 17592186340303} :answer-field/id #uuid "6255bf89-615b-5c1e-8243-e6d10ccab212" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186341552}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "a6055ee2-868a-5c78-ace7-dbe46416f75e" :question/math-academy-id "q-73507" :question/problem "Calculate $\\frac{\\text{d}y}{\\text{d}x}$ for $y=5+9\\operatorname{arcsin}⁡x.$" :question/worked-solution "The formula for the derivative of arcsine is\n\n$$\n\\frac{\\text{d}}{\\text{d}x}(\\operatorname{arcsin}⁡x)=\\frac{1}{\\sqrt{1-{x}^{2}}}.\n$$\n\nUsing the formula above, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}}{\\text{d}x}(5+9\\operatorname{arcsin}⁡x) \\\\  & =0+9\\cdot \\frac{\\text{d}}{\\text{d}x}(\\operatorname{arcsin}⁡x) \\\\  & =0+9\\cdot \\frac{1}{\\sqrt{1-{x}^{2}}} \\\\  & =\\frac{9}{\\sqrt{1-{x}^{2}}}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186341996 :knowledge-point/_questions [{:db/id #edb/ref 17592186064368 :knowledge-point/id #uuid "552973a7-4ab5-5918-83f4-15ee0e3ee052" :knowledge-point/title "Differentiating an Inverse Sine Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2611dcff-8b91-597f-8c5f-f0d7faaed58a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{8{e}^{x}}{\\sqrt{1-{e}^{2x}}}" :db/id #edb/ref 17592186339457} {:answer/id #uuid "7449185b-c303-5b5d-96c0-ee59bef20ffe" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{8{e}^{x}}{\\sqrt{1+{e}^{x}}}" :db/id #edb/ref 17592186340163} {:answer/id #uuid "cd4e2280-4678-5815-8dcd-085f512cb2a0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{8{e}^{2x}}{\\sqrt{1-{e}^{x}}}" :db/id #edb/ref 17592186340949} {:answer/id #uuid "d65f70a2-0557-5c9f-9a19-d989035f25e3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{e}^{x}}{8\\sqrt{1+{e}^{2x}}}" :db/id #edb/ref 17592186341028} {:answer/id #uuid "eeb2dc92-4c99-527c-a276-2f5596bbd1e3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{e}^{x}}{8\\sqrt{1-{e}^{2x}}}" :db/id #edb/ref 17592186341233}] :answer-field/correct {:answer/id #uuid "2611dcff-8b91-597f-8c5f-f0d7faaed58a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{8{e}^{x}}{\\sqrt{1-{e}^{2x}}}" :db/id #edb/ref 17592186339457} :answer-field/id #uuid "29724483-71c4-5205-a1f7-0c0cb6846690" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186341451}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "7e41abc4-5351-5b76-8500-74e3de1b2a5a" :question/math-academy-id "q-73508" :question/problem "Calculate ${f}^{′}(x)$ for $f(x)=8\\operatorname{arcsin}⁡({e}^{x}).$" :question/worked-solution "The formula for the derivative of arcsine is\n\n$$\n\\frac{\\text{d}}{\\text{d}x}(\\operatorname{arcsin}⁡x)=\\frac{1}{\\sqrt{1-{x}^{2}}}.\n$$\n\nUsing the chain rule and the formula above, we get\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}[8\\operatorname{arcsin}⁡({e}^{x})] \\\\  & =8\\cdot \\frac{1}{\\sqrt{1-{({e}^{x})}^{2}}}\\cdot \\frac{\\text{d}}{\\text{d}x}({e}^{x}) \\\\  & =\\frac{8}{\\sqrt{1-{e}^{2x}}}\\cdot {e}^{x} \\\\  & =\\frac{8{e}^{x}}{\\sqrt{1-{e}^{2x}}}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186341997 :knowledge-point/_questions [{:db/id #edb/ref 17592186064367 :knowledge-point/id #uuid "c5582e8b-3870-5a32-b15e-62b8f8306ce6" :knowledge-point/title "Differentiating Inverse Trigonometric Functions Using the Product or Quotient Rule"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5107a3c4-3fbf-5337-9f89-e57141f452ca" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{(5-x)\\operatorname{cos}⁡x}{\\sqrt{1+{(5-x)}^{2}}}-\\operatorname{sin}⁡x\\operatorname{arccos}⁡(5-x)" :db/id #edb/ref 17592186339868} {:answer/id #uuid "949a3a25-4ea0-5db8-ac33-f429809b9743" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{5\\operatorname{cos}⁡x}{\\sqrt{1-{(5-x)}^{2}}}-\\operatorname{sin}⁡x\\operatorname{arcsin}⁡(5-x)" :db/id #edb/ref 17592186340462} {:answer/id #uuid "c813050e-2154-5157-bdbf-7a6cc5929db3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\operatorname{cos}⁡x}{\\sqrt{1+{(5-x)}^{2}}}+\\operatorname{sin}⁡x\\operatorname{arcsin}⁡(5-x)" :db/id #edb/ref 17592186340900} {:answer/id #uuid "da23eb94-e92b-5196-90af-b3e6e60c86f0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5\\operatorname{cos}⁡x}{\\sqrt{1-{(5-x)}^{2}}}+\\operatorname{sin}⁡x\\operatorname{arccos}⁡(5-x)" :db/id #edb/ref 17592186341063} {:answer/id #uuid "ec969a7a-a331-5b85-ae7e-0cf433062a98" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\operatorname{cos}⁡x}{\\sqrt{1-{(5-x)}^{2}}}-\\operatorname{sin}⁡x\\operatorname{arccos}⁡(5-x)" :db/id #edb/ref 17592186341213}] :answer-field/correct {:answer/id #uuid "ec969a7a-a331-5b85-ae7e-0cf433062a98" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\operatorname{cos}⁡x}{\\sqrt{1-{(5-x)}^{2}}}-\\operatorname{sin}⁡x\\operatorname{arccos}⁡(5-x)" :db/id #edb/ref 17592186341213} :answer-field/id #uuid "96dc5de0-fcff-5a01-9b87-28b3beb33641" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186341646}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "25fdd6ba-691e-5f6c-ab57-fe0cafbab12e" :question/math-academy-id "q-73510" :question/problem "Calculate $\\frac{\\text{d}y}{\\text{d}x}$ for $y=\\operatorname{cos}⁡x\\operatorname{arccos}⁡(5-x).$" :question/worked-solution "Applying the product rule, using the formula for the derivative of $\\operatorname{arccos}⁡x$ and applying the chain rule, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}(\\operatorname{cos}⁡x\\operatorname{arccos}⁡(5-x)) & =\\operatorname{arccos}⁡(5-x)\\cdot \\frac{\\text{d}}{\\text{d}x}(\\operatorname{cos}⁡x)+\\operatorname{cos}⁡x\\cdot \\frac{\\text{d}}{\\text{d}x}(\\operatorname{arccos}⁡(5-x)) \\\\  & =\\operatorname{arccos}⁡(5-x)\\cdot (-\\operatorname{sin}⁡x)+\\operatorname{cos}⁡x\\cdot (-\\frac{1}{\\sqrt{1-{(5-x)}^{2}}})\\cdot \\frac{\\text{d}}{\\text{d}x}(5-x) \\\\  & =-\\operatorname{sin}⁡x\\operatorname{arccos}⁡(5-x)-\\frac{\\operatorname{cos}⁡x}{\\sqrt{1-{(5-x)}^{2}}}\\cdot (-1) \\\\  & =\\frac{\\operatorname{cos}⁡x}{\\sqrt{1-{(5-x)}^{2}}}-\\operatorname{sin}⁡x\\operatorname{arccos}⁡(5-x).\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186342003 :knowledge-point/_questions [{:db/id #edb/ref 17592186175901 :knowledge-point/id #uuid "eede91c4-9099-55df-a803-f87895d9f51b" :knowledge-point/title "Applying the Extreme Value Theorem to Piecewise Functions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "085a372e-3d44-5218-8ffc-7245e73f20e6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186339197} {:answer/id #uuid "27bfa14d-cc0f-5a6b-9127-444c2c3cbe94" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186339472} {:answer/id #uuid "5ff1f004-8a24-53f6-8512-8daed863b9af" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186339982} {:answer/id #uuid "807a16d0-c898-5c5a-aa54-af34b1d71126" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186340280} {:answer/id #uuid "9ef8375b-1f86-5526-a7e2-474095047082" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186340564}] :answer-field/correct {:answer/id #uuid "807a16d0-c898-5c5a-aa54-af34b1d71126" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186340280} :answer-field/id #uuid "1167d122-71e9-5a13-8edb-8b2e825eb1e0" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186341410}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "8abc4b9f-caf8-5c94-91da-62ad0ae61b3d" :question/math-academy-id "q-73531" :question/problem "Suppose that $f(x)$ is defined as\n\n$$\nf(x)=\\{\\begin{aligned}\\frac{1}{{2}^{x-1}-1}, & x\\ne 1 \\\\ \\,\\,1, & x=1.\\end{aligned}\n$$\n\nOn which of the following intervals can the extreme value theorem be applied to the function?\n\nI. $[-2,2]$\n\nII. $[-3,1)$\n\nIII. $[1.5,2]$" :question/worked-solution "Remember that the extreme value theorem is only applicable to closed intervals on which the function is continuous.\n\nSo, let's check whether the function is continuous on each of the intervals. \n\n- Let first consider the interval  $[-2,2].$ This is a  closed interval, but we have\n\n$$\n\\begin{aligned}{lim}_{x\\to {1}^{+}}f(x) & ={lim}_{x\\to {1}^{+}}\\frac{1}{{2}^{x-1}-1}=\\infty \\end{aligned}\n$$\n\nand so $f(x)$ has an essential discontinuity at $x=1.$ Therefore, $f(x)$ is not continuous on the interval $[-1,1]$, and the extreme value theorem is not applicable.\n\n- The interval $[-3,1)$ is not closed, so the extreme value theorem is not applicable in this case.\n\n- Finally consider  $[1.5,2].$ The only discontinuity of the function $f(x)$ is at $x=1,$ which is not in the interval  $[1.5,2].$ Therefore, $f(x)$ is continuous on the interval  $[1.5,2]$, and the extreme value theorem is applicable on this interval.\n\nIn conclusion, the correct answer is \"III only\"."}] [{:db/id #edb/ref 17592186342005 :knowledge-point/_questions [{:db/id #edb/ref 17592186129168 :knowledge-point/id #uuid "85335de6-e1dc-5a2f-b30a-806627759030" :knowledge-point/title "Identifying Type II Regions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "06a48b3b-294d-51ac-a382-596eb5e9258b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "D={(x,y)\\,:\\,-\\sqrt{y}+2\\le y\\le -\\frac{y}{2}+3,\\,1\\le x\\le 3}" :db/id #edb/ref 17592186339183} {:answer/id #uuid "1d52fde8-730d-5ea7-bca6-588235ccc0c2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "D={(x,y)\\,:\\,0\\le y\\le 3,\\,-\\sqrt{y}+2\\le x\\le 2.5}" :db/id #edb/ref 17592186339386} {:answer/id #uuid "7065a7a0-e280-5ec2-ba8f-5ee0a498f367" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "D={(x,y)\\,:\\,1\\le y\\le 3,\\,-\\sqrt{y}+2\\le x\\le -\\frac{y}{2}+3}" :db/id #edb/ref 17592186340125} {:answer/id #uuid "77d47f81-e40b-55b4-8f65-e3bdaca1d00f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "D={(x,y)\\,:\\,\\sqrt{y}\\le y\\le \\frac{y}{2},\\,1\\le x\\le 3}" :db/id #edb/ref 17592186340197} {:answer/id #uuid "f5d27761-0dab-5959-ad1e-72477f2fdc2f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "D={(x,y)\\,:\\,1\\le y\\le 3,\\,-\\sqrt{y}+3\\le x\\le \\frac{y}{2}+2}" :db/id #edb/ref 17592186341299}] :answer-field/correct {:answer/id #uuid "7065a7a0-e280-5ec2-ba8f-5ee0a498f367" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "D={(x,y)\\,:\\,1\\le y\\le 3,\\,-\\sqrt{y}+2\\le x\\le -\\frac{y}{2}+3}" :db/id #edb/ref 17592186340125} :answer-field/id #uuid "2dd26fe5-df42-54f1-a759-c32dddc997da" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186341458}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "80f56e91-1777-5d7a-b918-7d315f6b332a" :question/math-academy-id "q-73534" :question/problem "![](images/c3/c316b62d5c1a08c6513413fd87c36c6feb26fb632709909a9c9f761d0806c4af.png)\n\nWhich of the following represents the shaded region above as a type II region in two-dimensional space?" :question/worked-solution "A type II region can be written as\n\n$$\nD={(x,y)\\,:\\,a\\le y\\le b,\\,g(y)\\le x\\le f(y)},\n$$\n\nwhere $f$ and $g$ are continuous functions.\n\nTo express the given region as a type II region, we first rewrite all of the given curves as functions of $y:$\n\n$$\ny=-2(x-3)\\,⟹\\,x=-\\frac{y}{2}+3\n$$\n\nThe function $x=-\\sqrt{y}+2$ is already written as a function of $y.$\n\nNotice that the region lies between the horizontal lines $y=1$ and $y=3.$ So, we have $1\\le y\\le 3.$\n\nWe draw a horizontal arrow through the region to determine the left function $g(y)$ and the right function $f(y).$ A horizontal line should intersect the region in a single interval only for it to be a type II region.\n\n![](images/fb/fb05eec73599c1beb8dd588c478208315f6edaf10af999115eb29fa10d5601e9.png)\n\nThe horizontal line enters the region through the lower function $x=-\\sqrt{y}+2$ and leaves through the upper function $x=-\\frac{y}{2}+3.$ So, we have $-\\sqrt{y}+2\\le x\\le -\\frac{y}{2}+3.$\n\nTherefore, we obtain\n\n$$\nD={(x,y)\\,:\\,1\\le y\\le 3,\\,-\\sqrt{y}+2\\le x\\le -\\frac{y}{2}+3}.\n$$"}] [{:db/id #edb/ref 17592186342006 :knowledge-point/_questions [{:db/id #edb/ref 17592186059755 :knowledge-point/id #uuid "d79fb5d1-22a6-511d-90ca-7d66c540d172" :knowledge-point/title "Calculating the Cofactor Method To Solve for an Unknown Quantity"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "444cd60d-98f8-57c7-9875-93fe9bccf0fb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186339729} {:answer/id #uuid "534e79d6-1a48-52d9-8361-6b5e12a9cdf3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186339897} {:answer/id #uuid "53b60466-c23f-5e4c-9676-8a33e27c13b4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186339902} {:answer/id #uuid "87d00cf2-3923-56f4-a41d-5b87aa3fb375" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186340345} {:answer/id #uuid "da2aff30-bbeb-5d42-9525-3fe5517ebd88" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186341064}] :answer-field/correct {:answer/id #uuid "da2aff30-bbeb-5d42-9525-3fe5517ebd88" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186341064} :answer-field/id #uuid "45ff8668-6658-5885-8426-f8efdc154b15" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186341502}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "4a069e33-ab79-5e52-8347-ee8dc3251c92" :question/math-academy-id "q-73535" :question/problem "The entry ${a}_{33}^{′}$ in the inverse of the matrix\n$A=[\\begin{aligned}1 & 1 & k \\\\ -1 & 2 & 3 \\\\ 0 & -3 & -1\\end{aligned}]$\nequals $\\frac{1}{4}$ and $det(A)=6+3k.$ Find the value of $k.$" :question/worked-solution "First, note that we are given the determinant of $A:$\n\n$$\ndet(A)=6+3k\n$$\n\nSince we want the entry ${a}_{33}^{′}$ in ${A}^{-1},$ we need to know the value of ${c}_{33}$ in the matrix of cofactors. For this, we use the formula to get\n\n$$\n\\begin{aligned}{c}_{33} & =(-1)^{3+3}|\\begin{aligned}1 & 1 \\\\ -1 & 2\\end{aligned}| \\\\  & =|\\begin{aligned}1 & 1 \\\\ -1 & 2\\end{aligned}| \\\\  & =2-(-1) \\\\  & =3\\end{aligned}\n$$\n\nThen, since ${A}^{-1}=\\frac{1}{det(A)}{C}^{T},$ we have\n\n$$\n\\begin{aligned}{a}_{33}^{′} & =\\frac{1}{\\text{det}(A)}{c}_{33} \\\\  & =\\frac{1}{6+3k}\\cdot 3 \\\\  & =\\frac{1}{2+k}.\\end{aligned}\n$$\n\nFinally, since we are told that ${a}_{33}^{′}=\\frac{1}{4}$, we have\n\n$$\n\\begin{aligned}\\frac{1}{4} & =\\frac{1}{2+k} \\\\ 2+k & =4 \\\\ k & =2.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186393299 :knowledge-point/_questions [{:db/id #edb/ref 17592186059776 :knowledge-point/id #uuid "07abc1cc-5794-51a6-bad4-40565eae52be" :knowledge-point/title "Solving a 2x2 System of Equations Using Gaussian Elimination"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "84dcd969-8fc8-57ef-9240-0a47ae01dcdc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "M∼[\\begin{aligned}1 & -\\frac{2}{3} & \\frac{4}{3} \\\\ 0 & 1 & -2\\end{aligned}]" :db/id #edb/ref 17592186393301} {:answer/id #uuid "eeb19591-ba15-5e0e-8983-784d1d68d59d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "M∼[\\begin{aligned}1 & -\\frac{2}{3} & \\frac{4}{3} \\\\ 0 & 1 & -\\frac{3}{2}\\end{aligned}]" :db/id #edb/ref 17592186393302} {:answer/id #uuid "e2f102ba-ebea-5b42-ae75-3e35aaa4dcb9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "M∼[\\begin{aligned}1 & -\\frac{2}{3} & \\frac{4}{3} \\\\ 0 & 1 & 2\\end{aligned}]" :db/id #edb/ref 17592186393303} {:answer/id #uuid "0716f4f7-16c9-5c13-b702-47eba0dfd09b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "M∼[\\begin{aligned}1 & -\\frac{2}{3} & \\frac{4}{3} \\\\ 0 & 1 & \\frac{3}{2}\\end{aligned}]" :db/id #edb/ref 17592186393304} {:answer/id #uuid "d6ec307f-5f81-58e7-8c8e-0f70f0701a1d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "M∼[\\begin{aligned}1 & -\\frac{2}{3} & \\frac{4}{3} \\\\ 0 & 1 & -3\\end{aligned}]" :db/id #edb/ref 17592186393305}] :answer-field/correct {:answer/id #uuid "84dcd969-8fc8-57ef-9240-0a47ae01dcdc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "M∼[\\begin{aligned}1 & -\\frac{2}{3} & \\frac{4}{3} \\\\ 0 & 1 & -2\\end{aligned}]" :db/id #edb/ref 17592186393301} :answer-field/id #uuid "f86bf6ae-95b6-5b45-9f58-e55f64d234d5" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186393300}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "26bbee69-6c8f-5073-bf18-e5b7229f3605" :question/math-academy-id "q-73538" :question/problem "Consider the system of linear equations\n\n$$\n\\{\\begin{aligned} & 3x-2y=4 \\\\  & 2x-y=2.\\end{aligned}\n$$\n\nUse the standard method of Gaussian elimination to reduce the augmented matrix $M$ of the system to row echelon form." :question/worked-solution "The augmented matrix for this system is\n\n$$\nM=[\\begin{aligned}3 & -2 & 4 \\\\ 2 & -1 & 2\\end{aligned}].\n$$\n\nReducing $M$ to row echelon form, we have\n\n$$\n\\begin{aligned}M & ∼[\\begin{aligned}3 & -2 & 4 \\\\ 2 & -1 & 2\\end{aligned}] & {R}_{1} & :=\\frac{1}{3}{R}_{1} \\\\  & ∼[\\begin{aligned}1 & -\\frac{2}{3} & \\frac{4}{3} \\\\ 2 & -1 & 2\\end{aligned}] & {R}_{2} & :={R}_{2}-2{R}_{1} \\\\  & ∼[\\begin{aligned}1 & -\\frac{2}{3} & \\frac{4}{3} \\\\ 0 & \\frac{1}{3} & -\\frac{2}{3}\\end{aligned}] & {R}_{2} & :=3{R}_{2} \\\\  & ∼[\\begin{aligned}1 & -\\frac{2}{3} & \\frac{4}{3} \\\\ 0 & 1 & -2\\end{aligned}].\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186393306 :knowledge-point/_questions [{:db/id #edb/ref 17592186059776 :knowledge-point/id #uuid "07abc1cc-5794-51a6-bad4-40565eae52be" :knowledge-point/title "Solving a 2x2 System of Equations Using Gaussian Elimination"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5c7b08e6-d085-5aaa-8d73-b963955cfc39" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$M∼[\\begin{aligned}1 & -2 & 3 \\\\ 0 & 1 & -1\\end{aligned}],$\n$\\,x=1$ and $y=-1$" :db/id #edb/ref 17592186393308} {:answer/id #uuid "06300e64-ff4a-5f52-b477-8bb88f43f8a1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$M∼[\\begin{aligned}1 & -2 & 3 \\\\ 0 & 1 & -2\\end{aligned}],$\n$\\,x=-1$ and $y=-2$" :db/id #edb/ref 17592186393309} {:answer/id #uuid "af523f5a-739c-5f31-b5eb-464880f8d7fb" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$M∼[\\begin{aligned}1 & -2 & 3 \\\\ 0 & 1 & -4\\end{aligned}],$\n$\\,x=-5$ and $y=-4$" :db/id #edb/ref 17592186393310} {:answer/id #uuid "1b343ef7-3ddf-5c6c-94e7-03e5be9701c9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$M∼[\\begin{aligned}1 & -2 & 3 \\\\ 0 & 1 & 2\\end{aligned}],$\n$\\,x=7$ and $y=2$" :db/id #edb/ref 17592186393311} {:answer/id #uuid "374d0aef-c48a-512b-ba16-2324cb201e02" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$M∼[\\begin{aligned}1 & -2 & 3 \\\\ 0 & 1 & 4\\end{aligned}],$\n$\\,x=11$ and $y=4$" :db/id #edb/ref 17592186393312}] :answer-field/correct {:answer/id #uuid "06300e64-ff4a-5f52-b477-8bb88f43f8a1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$M∼[\\begin{aligned}1 & -2 & 3 \\\\ 0 & 1 & -2\\end{aligned}],$\n$\\,x=-1$ and $y=-2$" :db/id #edb/ref 17592186393309} :answer-field/id #uuid "de9973d7-7169-5172-bb3d-d4ad9a2d6a14" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186393307}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "4e51e1e1-f4ea-594e-af90-cfd7caef02c6" :question/math-academy-id "q-73544" :question/problem "Consider the system of linear equations\n\n$$\n\\{\\begin{aligned} & 2x-4y=6 \\\\  & 4x-7y=10.\\end{aligned}\n$$\n\nUse the standard method of Gaussian elimination to reduce the augmented matrix $M$ of the system to row echelon form, and then solve the linear system." :question/worked-solution "The augmented matrix for this system is\n\n$$\nM=[\\begin{aligned}2 & -4 & 6 \\\\ 4 & -7 & 10\\end{aligned}].\n$$\n\nReducing $M$ to row echelon form, we have\n\n$$\n\\begin{aligned}M & ∼[\\begin{aligned}2 & -4 & 6 \\\\ 4 & -7 & 10\\end{aligned}] & {R}_{1} & :=\\frac{1}{2}{R}_{1} \\\\  & ∼[\\begin{aligned}1 & -2 & 3 \\\\ 4 & -7 & 10\\end{aligned}] & {R}_{2} & :={R}_{2}-4{R}_{1} \\\\  & ∼[\\begin{aligned}1 & -2 & 3 \\\\ 0 & 1 & -2\\end{aligned}].\\end{aligned}\n$$\n\nThe system is now \n\n$$\n\\{\\begin{aligned} & x-2y=3 \\\\  & y=-2,\\end{aligned}\n$$\n\nand we can apply back substitution. The final equation $y=-2$ tells us the value of $y.$ Substituting this value into the first equation, we get\n\n$$\nx-2(-2)=3\\,⇒\\,x=-1.\n$$\n\nThus, the solution is $x=-1$ and $y=-2.$"}] [{:db/id #edb/ref 17592186342010 :knowledge-point/_questions [{:db/id #edb/ref 17592186078488 :knowledge-point/id #uuid "5b9df69a-3072-5131-a5c8-64c1744abcbd" :knowledge-point/title "Evaluating a Limit of a Function Involving the Special Limit With Sine: Advanced Cases"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "38ccfea7-fed5-5b7e-bc09-bcd69091da1e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186339639} {:answer/id #uuid "60022a80-d927-5a41-9b20-e5576e6438cb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186339983} {:answer/id #uuid "89a04548-acfb-5947-b2ac-4e7dff064d97" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186340356} {:answer/id #uuid "afb751a0-88c2-502a-8157-5752b308f317" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186340732} {:answer/id #uuid "b36db622-271e-564e-927d-d6a6763d261f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186340759}] :answer-field/correct {:answer/id #uuid "b36db622-271e-564e-927d-d6a6763d261f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186340759} :answer-field/id #uuid "c3b2bee7-ee63-5f93-be18-3bd951bd1c77" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186341719}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "b53097b6-0795-598d-9c41-894871fbb1f5" :question/math-academy-id "q-73546" :question/problem "Find the value of ${lim}_{\\theta \\to 0}\\,\\frac{{sec}^{2}⁡\\theta -1}{{\\theta }^{2}}.$" :question/worked-solution "First, we can simplify the limit using trigonometric identities, as follows:\n\n$$\n\\begin{aligned}{lim}_{\\theta \\to 0}\\,\\frac{{sec}^{2}⁡\\theta -1}{{\\theta }^{2}} & ={lim}_{\\theta \\to 0}\\,\\frac{{tan}^{2}⁡\\theta }{{\\theta }^{2}} \\\\  & ={lim}_{\\theta \\to 0}\\,\\frac{(\\frac{{sin}^{2}⁡\\theta }{{cos}^{2}⁡\\theta })}{{\\theta }^{2}} \\\\  & ={lim}_{\\theta \\to 0}(\\frac{1}{{\\theta }^{2}}\\cdot \\frac{{sin}^{2}⁡\\theta }{{cos}^{2}⁡\\theta }) \\\\  & ={lim}_{\\theta \\to 0}\\,\\frac{{sin}^{2}⁡\\theta }{{\\theta }^{2}}\\cdot {lim}_{\\theta \\to 0}\\,\\frac{1}{{cos}^{2}⁡\\theta }\\end{aligned}\n$$\n\nLet's now evaluate the limits separately:\n\n- Consider the first limit. Notice that as $\\theta \\to 0,$ both numerator and denominator approach $0.$ \n\nSo, if we attempt to evaluate the limit directly, we get\n\n$$\n{lim}_{\\theta \\to 0}\\,\\frac{{sin}^{2}⁡\\theta }{{\\theta }^{2}}=\\frac{0}{0},\n$$\n\nwhich is an indeterminate form. \n\nRewriting the given limit using the algebra of limits and applying our special limit, we get the following:\n\n$$\n\\begin{aligned}{lim}_{\\theta \\to 0}\\,\\frac{{sin}^{2}⁡\\theta }{{\\theta }^{2}} & ={lim}_{\\theta \\to 0}{(\\frac{\\operatorname{sin}⁡\\theta }{\\theta })}^{2} \\\\  & ={[{lim}_{\\theta \\to 0}\\frac{\\operatorname{sin}⁡\\theta }{\\theta }]}^{2} \\\\  & ={1}^{2} \\\\  & =1\\end{aligned}\n$$\n\n- Consider the second limit. Evaluating it directly, we get\n\n$$\n{lim}_{\\theta \\to 0}\\,\\frac{1}{{cos}^{2}⁡\\theta }=\\frac{1}{{cos}^{2}⁡0}=1.\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}{lim}_{\\theta \\to 0}\\,\\frac{{sin}^{2}⁡\\theta }{{\\theta }^{2}}\\cdot {lim}_{\\theta \\to 0}\\,\\frac{1}{{cos}^{2}⁡\\theta } & =1\\cdot 1=1.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186393313 :knowledge-point/_questions [{:db/id #edb/ref 17592186059776 :knowledge-point/id #uuid "07abc1cc-5794-51a6-bad4-40565eae52be" :knowledge-point/title "Solving a 2x2 System of Equations Using Gaussian Elimination"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "784ffc66-edc8-51a6-ac2b-356c0e08dea7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "M∼[\\begin{aligned}1 & 3 & 2 \\\\ 0 & 1 & 4\\end{aligned}]" :db/id #edb/ref 17592186393315} {:answer/id #uuid "4c7c60c8-ed6d-5540-ba6f-0c6383d28a62" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "M∼[\\begin{aligned}1 & -3 & 2 \\\\ 0 & 1 & 0\\end{aligned}]" :db/id #edb/ref 17592186393316} {:answer/id #uuid "12a340da-e725-5a88-a527-27d71e519f66" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "M∼[\\begin{aligned}1 & -3 & 2 \\\\ 0 & 1 & 4\\end{aligned}]" :db/id #edb/ref 17592186393317} {:answer/id #uuid "335c8f2c-6e1a-56c3-b0b9-94d13c9ad70f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "M∼[\\begin{aligned}1 & -3 & 2 \\\\ 0 & 1 & -1\\end{aligned}]" :db/id #edb/ref 17592186393318} {:answer/id #uuid "0e6a6bdb-d757-58d4-980e-64a7fa142831" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "M∼[\\begin{aligned}1 & -3 & -2 \\\\ 0 & 1 & 1\\end{aligned}]" :db/id #edb/ref 17592186393319}] :answer-field/correct {:answer/id #uuid "4c7c60c8-ed6d-5540-ba6f-0c6383d28a62" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "M∼[\\begin{aligned}1 & -3 & 2 \\\\ 0 & 1 & 0\\end{aligned}]" :db/id #edb/ref 17592186393316} :answer-field/id #uuid "240d40bc-cf1d-5886-b54c-59f3d0b765cd" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186393314}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "08ec22c2-8cd9-5dca-af3f-944499fe851c" :question/math-academy-id "q-73551" :question/problem "Consider the system of linear equations\n\n$$\n\\{\\begin{aligned} & 5x-15y=10 \\\\  & 2x-4y=4.\\end{aligned}\n$$\n\nUse the standard method of Gaussian elimination to reduce the augmented matrix $M$ of the system to row echelon form." :question/worked-solution "The augmented matrix for this system is\n\n$$\nM=[\\begin{aligned}5 & -15 & 10 \\\\ 2 & -4 & 4\\end{aligned}].\n$$\n\nReducing $M$ to row echelon form, we have\n\n$$\n\\begin{aligned}M & ∼[\\begin{aligned}5 & -15 & 10 \\\\ 2 & -4 & 4\\end{aligned}] & {R}_{1} & :=\\frac{1}{5}{R}_{1} \\\\  & ∼[\\begin{aligned}1 & -3 & 2 \\\\ 2 & -4 & 4\\end{aligned}] & {R}_{2} & :={R}_{2}-2{R}_{1} \\\\  & ∼[\\begin{aligned}1 & -3 & 2 \\\\ 0 & 2 & 0\\end{aligned}] & {R}_{2} & :=\\frac{1}{2}{R}_{2} \\\\  & ∼[\\begin{aligned}1 & -3 & 2 \\\\ 0 & 1 & 0\\end{aligned}].\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186342016 :knowledge-point/_questions [{:db/id #edb/ref 17592186115235 :knowledge-point/id #uuid "9923c6c3-e425-54ae-a533-09421d5578cb" :knowledge-point/title "Identifying a True Statement Given a 2x2 Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2121f091-3a66-5690-a210-70cac8d8b961" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186339414} {:answer/id #uuid "641ee5b3-8fa1-5cee-afcc-4789bc026277" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186340016} {:answer/id #uuid "ae19279b-2df0-59ff-8f89-720ecde46013" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186340713} {:answer/id #uuid "e7c9164f-2c54-5305-863c-aac35ca8a133" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186341173} {:answer/id #uuid "e8cc863f-3945-59c2-9bb7-328ec9d3b8ae" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186341179}] :answer-field/correct {:answer/id #uuid "e7c9164f-2c54-5305-863c-aac35ca8a133" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186341173} :answer-field/id #uuid "7b0541d7-b06d-5667-8592-a8a8781d2700" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186341595}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "7b4e1216-e41e-5317-bf20-2acb3db54b81" :question/math-academy-id "q-73565" :question/problem "Let \n$A=[\\begin{aligned}2 & 4 \\\\ 3 & 6\\end{aligned}].$\nWhich of the following statements are true? \n\nI. $det(A)=0$\n\nII. The lines $2x+4y=0$ and $3x+6y=0$ intersect at exactly one point\n\nIII. ${A}^{-1}$ does **not** exist" :question/worked-solution "Recall that given $A=[\\begin{aligned}{a}_{11} & {a}_{12} \\\\ {a}_{21} & {a}_{22}\\end{aligned}]$, then according to the invertible matrix theorem the following statements are equivalent:    \n\n1\\. $A$ is invertible.\n\n2\\. The system $Ax=b$ has exactly one solution for any $2\\times 1$ column vector $b.$\n\n3\\. The system $Ax=0$ has the unique zero solution.\n\n4\\. The lines ${a}_{11}x+{a}_{12}y={b}_{1}$ and ${a}_{21}x+{a}_{22}y={b}_{2}$ intersect at exactly one point.\n\n5\\. $det(A)\\ne 0.$\n\nWith that in mind, let's now check our statements.\n\n- Statement I is true. We have \n\n$$\n\\begin{aligned}det(A) & =det[\\begin{aligned}2 & 4 \\\\ 3 & 6\\end{aligned}] \\\\  & =2\\cdot 6-4\\cdot 3 \\\\  & =0.\\end{aligned}\n$$\n\nNow, since the fifth part of the invertible matrix theorem is false, all the other parts of the theorem are false too. Therefore, according to the theorem: \n\n- Statement II is false by the fourth part of the invertible matrix theorem.\n\n- Statement III is true by the first part of the invertible matrix theorem.\n\nTherefore, only statements I and III are true."}] [{:db/id #edb/ref 17592186377668 :knowledge-point/_questions [{:db/id #edb/ref 17592186115235 :knowledge-point/id #uuid "9923c6c3-e425-54ae-a533-09421d5578cb" :knowledge-point/title "Identifying a True Statement Given a 2x2 Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "cedd946a-0499-50fc-ba16-0a833e8d00a9" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186377670} {:answer/id #uuid "f806dacb-99da-5f7d-b073-bed3efc36928" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186377671} {:answer/id #uuid "fe56c20a-0f38-5c7b-a3fb-f5a9b0a7c7da" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186377672} {:answer/id #uuid "c4acc27d-db09-5869-a82d-b968a4088aac" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186377673} {:answer/id #uuid "318375fd-a989-5bb5-b37b-42a61428b01c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186377674}] :answer-field/correct {:answer/id #uuid "318375fd-a989-5bb5-b37b-42a61428b01c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186377674} :answer-field/id #uuid "6a89f9af-28e6-56d8-9d34-9b6196cc4f17" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186377669}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "aafb0544-5c12-5527-bc2a-2417215aad99" :question/math-academy-id "q-73566" :question/problem "Let \n$A=[\\begin{aligned}2 & -3 \\\\ 2 & -2\\end{aligned}].$\nWhich of the following statements are true?\n\n- $A$ is **not** invertible\n- The lines $2x-3y=1$ and $2x-2y=2$ intersect at exactly one point\n- $Ax=0$ has no solution" :question/worked-solution "Recall that given $A=[\\begin{aligned}{a}_{11} & {a}_{12} \\\\ {a}_{21} & {a}_{22}\\end{aligned}]$, then according to the invertible matrix theorem the following statements are equivalent:    \n\n- $A$ is invertible.\n\n- The system $Ax=b$ has exactly one solution for any $2\\times 1$ column vector $b.$\n\n- The system $Ax=0$ has the unique zero solution.\n\n- The lines ${a}_{11}x+{a}_{12}y={b}_{1}$ and ${a}_{21}x+{a}_{22}y={b}_{2}$ intersect at exactly one point.\n\n- $det(A)\\ne 0.$\n\nNow, we have\n\n$$\n\\begin{aligned}det(A) & =det[\\begin{aligned}2 & -3 \\\\ 2 & -2\\end{aligned}] \\\\  & =2\\cdot (-2)-(-3)\\cdot 2 \\\\  & =2\\ne 0.\\end{aligned}\n$$\n\nNow, since the fifth part of the invertible matrix theorem is true, all the other parts of the theorem are true too. \n\nWith that in mind, let's now check our statements.\n\n- Statement I is false by the first part of the invertible matrix theorem.\n\n- Statement II is true by the fourth part of the invertible matrix theorem.\n\n- Statement III is false since, according to the third part of the invertible matrix theorem, the system $Ax=0$ has the unique zero solution.\n\nTherefore, only statement II is true."}] [{:db/id #edb/ref 17592186342022 :knowledge-point/_questions [{:db/id #edb/ref 17592186096673 :knowledge-point/id #uuid "cd47a43f-1e99-5909-aa48-da8690025197" :knowledge-point/title "Solving a 3x3 System of Equations Using Standard Gaussian Elimination with Row Exchanges"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "08c85a87-f9d3-5992-bd65-769c46e1d92d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨11,-8,0⟩" :db/id #edb/ref 17592186339203} {:answer/id #uuid "0fbe2b87-90d4-5154-8a7b-4cbe5d76ee8f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨39,-28,4⟩" :db/id #edb/ref 17592186339272} {:answer/id #uuid "266e54c3-4543-5283-9017-83d16e10e193" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨25,-18,2⟩" :db/id #edb/ref 17592186339463} {:answer/id #uuid "32af4883-fe55-53ee-8722-a0f084a72e2b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨-3,2,-2⟩" :db/id #edb/ref 17592186339575} {:answer/id #uuid "79208760-a400-5994-ac65-f0b5469feeb8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨-17,12,-4⟩" :db/id #edb/ref 17592186340208}] :answer-field/correct {:answer/id #uuid "0fbe2b87-90d4-5154-8a7b-4cbe5d76ee8f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨39,-28,4⟩" :db/id #edb/ref 17592186339272} :answer-field/id #uuid "c0944fb0-08b1-53ae-b7d8-bc6730da208f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186341713}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "3624bdf6-d1bf-5873-8a2a-1542d72f9250" :question/math-academy-id "q-73584" :question/problem "Consider the augmented matrix $M$ given by\n\n$$\nM=[\\begin{aligned}1 & 1 & -2 & 3 \\\\ -2 & -2 & 5 & -2 \\\\ 3 & 4 & -1 & 1\\end{aligned}].\n$$\n\nUse the standard method of Gaussian elimination to reduce the augmented matrix $M$ of the system to row echelon form, and then solve the linear system." :question/worked-solution "Reducing $M$ to row echelon form, we have\n\n$$\n\\begin{aligned}M & ∼[\\begin{aligned}1 & 1 & -2 & 3 \\\\ -2 & -2 & 5 & -2 \\\\ 3 & 4 & -1 & 1\\end{aligned}] & {R}_{2} & :={R}_{2}+2{R}_{1} \\\\  & ∼[\\begin{aligned}1 & 1 & -2 & 3 \\\\ 0 & 0 & 1 & 4 \\\\ 3 & 4 & -1 & 1\\end{aligned}] & {R}_{3} & :={R}_{3}+(-3){R}_{1} \\\\  & ∼[\\begin{aligned}1 & 1 & -2 & 3 \\\\ 0 & 0 & 1 & 4 \\\\ 0 & 1 & 5 & -8\\end{aligned}].\\end{aligned}\n$$\n\nNote that we get ${a}_{22}=0.$ Therefore, we swap the $2$nd and $3$rd rows:\n\n$$\n\\begin{aligned} & ∼[\\begin{aligned}1 & 1 & -2 & 3 \\\\ 0 & 0 & 1 & 4 \\\\ 0 & 1 & 5 & -8\\end{aligned}] & {R}_{2} & ↔{R}_{3} \\\\  & ∼[\\begin{aligned}1 & 1 & -2 & 3 \\\\ 0 & 1 & 5 & -8 \\\\ 0 & 0 & 1 & 4\\end{aligned}]\\end{aligned}\n$$\n\nSo, the system is now\n\n$$\n\\{\\begin{aligned}x+y-2z=3 \\\\ y+5z=-8 \\\\ z=4,\\end{aligned}\n$$\n\nand we can apply back substitution. The third equation $z=4$ tells us the value of $z.$ Substituting this value into the second equation, we get\n\n$$\n\\begin{aligned}y+5(4)=-8\\,⟹\\,y=-28.\\end{aligned}\n$$\n\nNow, substituting $y=-28$ and $z=4$ into the first equation, we get\n\n$$\n\\begin{aligned}x+(-28)-2(4)=3\\,⟹\\,x=39.\\end{aligned}\n$$\n\nThus, the solution is $x=39$, $y=-28$, and $z=4.$ Or, in vector form $⟨39,-28,4⟩.$"}] [{:db/id #edb/ref 17592186393320 :knowledge-point/_questions [{:db/id #edb/ref 17592186087721 :knowledge-point/id #uuid "e0dc11d5-8eda-52b1-b7b1-42b481813ff4" :knowledge-point/title "Graphing a Curve Defined Parametrically"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c70aaa5a-5e55-5cac-9a6f-6318d6836204" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/d0/d06dfa9b8f6e87944014aa3eb03b6f83bd43e90624ba84d5d93d1d7f4e3beea6.png" :db/id #edb/ref 17592186393322} {:answer/id #uuid "ac220e89-32ea-508e-929a-c803d138ccfe" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/0e/0e7f02989d53152d1f2d5247f7f42d579956e49743694229d409cd266ec33e46.png" :db/id #edb/ref 17592186393323} {:answer/id #uuid "9ee90a69-8fe7-5272-8b17-1772dc5a0e90" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/9c/9c8ed7ce4ee431e67b923ce3028819eb9f6f6b0a52cb892c93e582c31ba9d8af.png" :db/id #edb/ref 17592186393324} {:answer/id #uuid "e95ca3e9-ccf0-585e-a54f-3195d2e34519" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/89/89b88f56878aeb33afe775e083c3775aaa701b6d293ca62e0bd3f2a78923159a.png" :db/id #edb/ref 17592186393325} {:answer/id #uuid "1d979614-76c4-5da3-9edd-dc0cf04890c3" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/1a/1a7c98897aa0c13daff168b3804ac292c7662ee21f313ddd9e631019bcfbb814.png" :db/id #edb/ref 17592186393326}] :answer-field/correct {:answer/id #uuid "ac220e89-32ea-508e-929a-c803d138ccfe" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/0e/0e7f02989d53152d1f2d5247f7f42d579956e49743694229d409cd266ec33e46.png" :db/id #edb/ref 17592186393323} :answer-field/id #uuid "8985fe72-57b1-51f4-bcff-4b1407775690" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186393321}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "b3e6469c-9ac4-59c2-95ba-5849e3955d1f" :question/math-academy-id "q-73602" :question/problem "Determine the graph of the following parametrically defined curve:\n\n$$\nx=2t-1,\\,\\,\\,y=2-{t}^{2},\\,-3\\le t\\le 3.\n$$" :question/worked-solution "We need to create a table of values and then sketch the curve. First, we work out the $x$-values using the formula $x=2t-1.$ This gives\n\n| **$t$** | $-3$ | $-2$ | $-1$ | $0$ | $1$ | $2$ | $3$ |\n| --- | --- | --- | --- | --- | --- | --- | --- |\n| $x$ | $-7$ | $-5$ | $-3$ | $-1$ | $1$ | $3$ | $5$ |\n| $y$ | $$ | $$ | $$ | $$ | $$ | $$ | $$ |\n\n$$\n\n$$\n\nNow, we work out the $y$ values using $y=2-{t}^{2}.$ This gives\n\n| **$t$** | $-3$ | $-2$ | $-1$ | $0$ | $1$ | $2$ | $3$ |\n| --- | --- | --- | --- | --- | --- | --- | --- |\n| $x$ | $-7$ | $-5$ | $-3$ | $-1$ | $1$ | $3$ | $5$ |\n| $y$ | $-7$ | $-2$ | $1$ | $2$ | $1$ | $-2$ | $-7$ |\n\n$$\n\n$$\n\nPlotting these points, we obtain the following curve:\n\n![](images/5c/5cd074670c05cea0c68db75c7e1a57309c017c97556e976f2db4c3bf1b358a85.png)"}] [{:db/id #edb/ref 17592186342029 :knowledge-point/_questions [{:db/id #edb/ref 17592186115236 :knowledge-point/id #uuid "64b2036f-da0f-59de-8a39-6b33e6cbdd04" :knowledge-point/title "Completing a True Statement"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "49f0d947-f7c9-5e28-b318-ebb60ce25335" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$[\\begin{aligned}1 \\\\ k\\end{aligned}]$ is a solution for the system $[\\begin{aligned}1 & 1 \\\\ 1 & k\\end{aligned}][\\begin{aligned}x \\\\ y\\end{aligned}]=[\\begin{aligned}0 \\\\ 0\\end{aligned}]$" :db/id #edb/ref 17592186339794} {:answer/id #uuid "5adce73b-295c-5739-82fa-c3ee4171f952" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "det[\\begin{aligned}1 & 1 \\\\ 1 & k\\end{aligned}]=0" :db/id #edb/ref 17592186339955} {:answer/id #uuid "683aa57a-6da0-5e5b-bb49-7a9b14a713df" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The lines $x+y=0$ and $x+ky=0$ are parallel" :db/id #edb/ref 17592186340058} {:answer/id #uuid "79847df7-1315-5e34-b716-873875e4ee22" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$[\\begin{aligned}1 & 1 \\\\ 1 & k\\end{aligned}][\\begin{aligned}x \\\\ y\\end{aligned}]=[\\begin{aligned}1 \\\\ 1\\end{aligned}]$ has no solution" :db/id #edb/ref 17592186340212} {:answer/id #uuid "93f2b389-1ca6-5535-ba05-5e23607eb465" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The system $[\\begin{aligned}1 & 1 \\\\ 1 & k\\end{aligned}][\\begin{aligned}x \\\\ y\\end{aligned}]=[\\begin{aligned}0 \\\\ 0\\end{aligned}]$ has the unique zero solution" :db/id #edb/ref 17592186340459}] :answer-field/correct {:answer/id #uuid "93f2b389-1ca6-5535-ba05-5e23607eb465" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The system $[\\begin{aligned}1 & 1 \\\\ 1 & k\\end{aligned}][\\begin{aligned}x \\\\ y\\end{aligned}]=[\\begin{aligned}0 \\\\ 0\\end{aligned}]$ has the unique zero solution" :db/id #edb/ref 17592186340459} :answer-field/id #uuid "35101e0e-d5c3-5680-82cf-c57e5604d67b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186341474}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "16a72be1-2bd1-5d5b-86b7-6ea0a4390bbf" :question/math-academy-id "q-73608" :question/problem "Consider the lines $x+y=0$ and $x+ky=0$, where $k$ is a constant. Complete the following statement so that it is true:\n\n*If $k\\ne 1$, then $\\text{__________}\\,.$*" :question/worked-solution "Recall that given $A=[\\begin{aligned}{a}_{11} & {a}_{12} \\\\ {a}_{21} & {a}_{22}\\end{aligned}]$, then according to the invertible matrix theorem the following statements are equivalent:    \n\n1\\. $A$ is invertible.\n\n2\\. The system $Ax=b$ has exactly one solution for any $2\\times 1$ column vector $b.$\n\n3\\. The system $Ax=0$ has the unique zero solution.\n\n4\\. The lines ${a}_{11}x+{a}_{12}y={b}_{1}$ and ${a}_{21}x+{a}_{22}y={b}_{2}$ intersect at exactly one point.\n\n5\\. $det(A)\\ne 0.$\n\nWith that in mind, let's now check our statements.\n\nLet $A=[\\begin{aligned}1 & 1 \\\\ 1 & k\\end{aligned}].$ If $k\\ne 1$, then\n\n$$\ndet(A)=det[\\begin{aligned}1 & 1 \\\\ 1 & k\\end{aligned}]=1-k\\ne 0.\n$$\n\nSo, according to the invertible matrix theorem $A$ is invertible and $[\\begin{aligned}0 \\\\ 0\\end{aligned}]$ is the unique solution of  $Ax=0.$\nAlso, the system \n\n$$\n[\\begin{aligned}1 & 1 \\\\ 1 & k\\end{aligned}][\\begin{aligned}x \\\\ y\\end{aligned}]=[\\begin{aligned}1 \\\\ 1\\end{aligned}]\n$$\n\n \nhas exactly one solution, and the lines $x+y=0$ and $x+ky=0$ intersect at exactly one point. \n\nTherefore, the true statement is as follows:\n\n*If $k\\ne 1$, then the system $[\\begin{aligned}1 & 1 \\\\ 1 & k\\end{aligned}][\\begin{aligned}x \\\\ y\\end{aligned}]=[\\begin{aligned}0 \\\\ 0\\end{aligned}]$ has the unique zero solution.* $\\,✓$"}] [{:db/id #edb/ref 17592186403668 :knowledge-point/_questions [{:db/id #edb/ref 17592186124478 :knowledge-point/id #uuid "a5f0d2e9-1cf6-5fe4-85cc-f401382f39b2" :knowledge-point/title "Finding the Non-Pivot Columns of a Matrix in Row Echelon Form"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0f5d1b21-d0b9-5d69-8355-827e89736e7b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$2$nd and $4$th only" :db/id #edb/ref 17592186403670} {:answer/id #uuid "ae1f6f68-236b-5baf-b98e-ebb13a837d0c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$4$th only" :db/id #edb/ref 17592186403671} {:answer/id #uuid "2d838c13-5fd7-5baf-875a-cbdb0a8f06c4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$2$nd, $3$rd, and $4$th only" :db/id #edb/ref 17592186403672} {:answer/id #uuid "b50399a2-2bb0-5c2b-b2df-c9a80a6714cb" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$2$nd, $4$th, and $5$th only" :db/id #edb/ref 17592186403673} {:answer/id #uuid "e320a2ba-1f1d-5701-ac7a-db08a7b45731" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$2$nd only" :db/id #edb/ref 17592186403674}] :answer-field/correct {:answer/id #uuid "0f5d1b21-d0b9-5d69-8355-827e89736e7b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$2$nd and $4$th only" :db/id #edb/ref 17592186403670} :answer-field/id #uuid "bfd951bf-1101-57d3-9237-a2969bb45e55" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186403669}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "701f0d82-dd3a-58b3-b64b-6042ce1e752a" :question/math-academy-id "q-73612" :question/problem "The row echelon form matrix $B$ is given below. What are its **non**-pivot columns?\n\n$$\nB=[\\begin{aligned}-6 & 2 & 1 & 0 & 4 \\\\ 0 & 0 & -4 & 1 & 1 \\\\ 0 & 0 & 0 & 0 & 3\\end{aligned}]\n$$" :question/worked-solution "Remember that the pivots of a matrix in row echelon form are the first non-zero entries in each row of the matrix.\n\nWe can see that $B$ has $3$ pivots in the $1$st, $3$rd and $5$th columns:\n\n$$\nB=[\\begin{aligned}-6 & 2 & 1 & 0 & 4 \\\\ 0 & 0 & -4 & 1 & 1 \\\\ 0 & 0 & 0 & 0 & 3\\end{aligned}]\n$$\n\nTherefore, the only non-pivot columns are the $2$nd and $4$th columns."}] [{:db/id #edb/ref 17592186342035 :knowledge-point/_questions [{:db/id #edb/ref 17592186124478 :knowledge-point/id #uuid "a5f0d2e9-1cf6-5fe4-85cc-f401382f39b2" :knowledge-point/title "Finding the Non-Pivot Columns of a Matrix in Row Echelon Form"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1d67e28c-a256-5a1d-9e04-f477d00894a8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$5$th only" :db/id #edb/ref 17592186339387} {:answer/id #uuid "260f4b80-53d9-5f26-b97b-2b2e97e88497" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$3$rd, $4$th, and $5$th only" :db/id #edb/ref 17592186339456} {:answer/id #uuid "2def53e1-c883-56b0-9c46-4ebe4d3dbc36" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$2$nd, $3$rd, and $5$th only" :db/id #edb/ref 17592186339534} {:answer/id #uuid "6092a204-0ea0-56e8-9213-ebd6bcdfacc1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$3$rd only" :db/id #edb/ref 17592186339988} {:answer/id #uuid "d76a0d0f-e606-54f1-91c8-3c6c587ad587" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$3$rd and $5$th only" :db/id #edb/ref 17592186341037}] :answer-field/correct {:answer/id #uuid "d76a0d0f-e606-54f1-91c8-3c6c587ad587" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$3$rd and $5$th only" :db/id #edb/ref 17592186341037} :answer-field/id #uuid "72bbb48e-fe4e-545a-9b68-754256645b24" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186341579}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "e5f1860a-14f7-5dde-8785-3643838d3e4f" :question/math-academy-id "q-73620" :question/problem "The row echelon form matrix $A$ is given below. What are its **non**-pivot columns?\n\n$$\nA=[\\begin{aligned}1 & 0 & 3 & 0 & 5 \\\\ 0 & -3 & 0 & 1 & 0 \\\\ 0 & 0 & 0 & -1 & -8 \\\\ 0 & 0 & 0 & 0 & 0\\end{aligned}]\n$$" :question/worked-solution "Remember that the pivots of a matrix in row echelon form are the first non-zero entries in each row of the matrix.\n\nWe can see that $A$ has $3$ pivots in the $1$st, $2$nd and $4$th columns:\n\n$$\nA=[\\begin{aligned}1 & 0 & 3 & 0 & 5 \\\\ 0 & -3 & 0 & 1 & 0 \\\\ 0 & 0 & 0 & -1 & -8 \\\\ 0 & 0 & 0 & 0 & 0\\end{aligned}]\n$$\n\nTherefore, the only non-pivot columns are the $3$rd and $5$th columns."}] [{:db/id #edb/ref 17592186342037 :knowledge-point/_questions [{:db/id #edb/ref 17592186124479 :knowledge-point/id #uuid "1073953e-7e0a-5237-8533-8882b7772741" :knowledge-point/title "Finding the Number of Pivot Columns of a Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "284ded16-4e2b-58c5-a9b3-3bc9411901be" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186339480} {:answer/id #uuid "790fe37d-c34e-5966-9eaf-9d268a97cd85" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186340207} {:answer/id #uuid "932e6098-7ea1-500c-a775-216015f34edc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186340451} {:answer/id #uuid "99f98270-ecaf-5d2c-8a85-811cc5dd4758" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186340515} {:answer/id #uuid "f8f3f51e-ce59-5013-95f2-552286e3b628" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186341331}] :answer-field/correct {:answer/id #uuid "932e6098-7ea1-500c-a775-216015f34edc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186340451} :answer-field/id #uuid "362a3e08-f85f-51f6-a3a7-d6f4324787e8" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186341477}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "949042b7-80c8-5584-b86a-21848d3ca6ef" :question/math-academy-id "q-73625" :question/problem "Determine the number of pivot columns of the matrix $D,$ given by\n\n$$\nD=[\\begin{aligned}0 & -2 & 1 & 0 & 0 \\\\ 0 & 2 & 1 & -1 & 2 \\\\ 0 & -4 & 2 & 8 & 1\\end{aligned}].\n$$" :question/worked-solution "First, we need to convert $D$ to row echelon form:\n\n$$\n\\begin{aligned}D & =[\\begin{aligned}0 & -2 & 1 & 0 & 0 \\\\ 0 & 2 & 1 & -1 & 2 \\\\ 0 & -4 & 2 & 8 & 1\\end{aligned}] & {R}_{2} & :={R}_{2}+{R}_{1} \\\\  & ∼[\\begin{aligned}0 & -2 & 1 & 0 & 0 \\\\ 0 & 0 & 2 & -1 & 2 \\\\ 0 & -4 & 2 & 8 & 1\\end{aligned}] & {R}_{3} & :={R}_{3}+(-2){R}_{1} \\\\  & ∼[\\begin{aligned}0 & -2 & 1 & 0 & 0 \\\\ 0 & 0 & 2 & -1 & 2 \\\\ 0 & 0 & 0 & 8 & 1\\end{aligned}]\\end{aligned}\n$$\n\nLooking at the row echelon form, we see that $D$ has $3$ pivots, and therefore the number of pivot columns is $3.$"}]}
