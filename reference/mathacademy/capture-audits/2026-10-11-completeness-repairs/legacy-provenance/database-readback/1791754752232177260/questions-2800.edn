ledge-point/title "Plotting the Product of a Matrix and an Eigenvector Given its Corresponding Eigenvalue"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8cc9ed2b-5bc1-572f-8712-4696adf52dd2" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/5a/5aeec63c36be20f6d54610d4ad90de8ea047db412fca7851d0267176783bdca3.png" :db/id #edb/ref 17592186393551} {:answer/id #uuid "b08019e9-4e7f-5cff-bd3e-a04f6a3d6b01" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/f3/f3030aa3eb132ccd74991bff510393917e83a6683cce37d2c194c1526bef6e90.png" :db/id #edb/ref 17592186393552} {:answer/id #uuid "75c07700-5db8-5e7b-8993-3c3e2f700a3b" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/c2/c272ff1454ac4ab9825e312f563c9bca08ac2800faa0e95ab45e8a5e827369da.png" :db/id #edb/ref 17592186393553} {:answer/id #uuid "55ce8068-c4b7-5b44-9053-a4d2e193284e" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/9e/9e45156d033da0b7f5cb06d703e6bab2e65fae17f5ae7ae28374fab10f9da906.png" :db/id #edb/ref 17592186393554} {:answer/id #uuid "df9c181d-6c0e-5252-a43e-f6323f81a858" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/8d/8d821e59ee37dfcd4dd5990c74ad7b0978276f55129d9c5fe00db953eadc4604.png" :db/id #edb/ref 17592186393555}] :answer-field/correct {:answer/id #uuid "75c07700-5db8-5e7b-8993-3c3e2f700a3b" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/c2/c272ff1454ac4ab9825e312f563c9bca08ac2800faa0e95ab45e8a5e827369da.png" :db/id #edb/ref 17592186393553} :answer-field/id #uuid "a1a14964-bff6-576b-a596-a58a0a2a58b1" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186393550}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "99c608d5-32f4-5a36-a687-6d8033a11dd5" :question/math-academy-id "q-75735" :question/problem "![](images/61/61ed37aa6a5e67cdc60cca2c93969a47d12e1e36f18edf96f646922877641e79.png)\n\nThe vector $u$ is an eigenvector of a $2\\times 2$ matrix $A$ corresponding to the eigenvalue $\\frac{1}{2}.$ Find the vector $Au.$" :question/worked-solution "The eigenvector $u=[\\begin{aligned}2 \\\\ 0\\end{aligned}]$ corresponds to the eigenvalue $\\lambda =\\frac{1}{2}.$ So, \n\n$$\n\\begin{aligned}Au & =\\frac{1}{2}u.\\end{aligned}\n$$\n\nThus, we have the following picture:\n\n![](images/c2/c272ff1454ac4ab9825e312f563c9bca08ac2800faa0e95ab45e8a5e827369da.png)"}] [{:db/id #edb/ref 17592186393556 :knowledge-point/_questions [{:db/id #edb/ref 17592186105787 :knowledge-point/id #uuid "49c501da-161c-53be-8349-571cc6a07975" :knowledge-point/title "Plotting the Product of a Matrix and an Eigenvector Given its Corresponding Eigenvalue"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "20d82492-3855-57ba-b3fa-259a3e6e9203" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/c0/c0bffb825fa5610288e3c88555a41c8124cf3538b2f75ebe627543a678ca3fba.png" :db/id #edb/ref 17592186393558} {:answer/id #uuid "840f7119-572d-50c5-bbbf-83c0cac108a4" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/c4/c42bc75b2c46989d81d20a9025ee8e487408f06576ec4a00115f20891cf5a824.png" :db/id #edb/ref 17592186393559} {:answer/id #uuid "40d3edc5-becc-58a4-934d-50f6796ae78b" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/09/09b44673879a2991acb4d5cdba4fad6233a87035b51cd9aa090ee9445ba5fa42.png" :db/id #edb/ref 17592186393560} {:answer/id #uuid "95376528-e4b3-531b-86b5-3f2b9c559f52" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/47/47f95dca66badab7adf57a36680877109c2d918210a1a412fd4e6532d973cd61.png" :db/id #edb/ref 17592186393561} {:answer/id #uuid "d5663d4b-636b-5cde-93d7-c48645e55519" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/d4/d4d87620b1b1f7ec62825bbd532998595455f601db2ba7c841e0a0167dff4fb4.png" :db/id #edb/ref 17592186393562}] :answer-field/correct {:answer/id #uuid "20d82492-3855-57ba-b3fa-259a3e6e9203" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/c0/c0bffb825fa5610288e3c88555a41c8124cf3538b2f75ebe627543a678ca3fba.png" :db/id #edb/ref 17592186393558} :answer-field/id #uuid "d944ba04-8e3b-5f93-b26b-2c144908ea48" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186393557}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "9be8ba94-ab90-5127-ba65-2ca25adc7b85" :question/math-academy-id "q-75737" :question/problem "![](images/53/539b08ea12f9af52defd826c0b63c194f36b6de408770c1bc1975bd6ca84724f.png)\n\nThe vector $u$ is an eigenvector of a $2\\times 2$ matrix $B$ corresponding to the eigenvalue $-\\frac{1}{2}.$ Find the vector $Bu.$" :question/worked-solution "The eigenvector $u=[\\begin{aligned}-2 \\\\ -4\\end{aligned}]$ corresponds to the eigenvalue $\\lambda =-\\frac{1}{2}.$ So, \n\n$$\n\\begin{aligned}Bu & =-\\frac{1}{2}u.\\end{aligned}\n$$\n\nTherefore, we have the following picture:\n\n![](images/c0/c0bffb825fa5610288e3c88555a41c8124cf3538b2f75ebe627543a678ca3fba.png)"}] [{:db/id #edb/ref 17592186345133 :knowledge-point/_questions [{:db/id #edb/ref 17592186096635 :knowledge-point/id #uuid "a7eb3fea-e4cf-5537-9a33-06b9d2b35c6b" :knowledge-point/title "Solving a System Containing Fractions in Both Equations Using Elimination"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "703429e4-f6ee-5ae0-b54b-621a3b3aa87c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=-2,\\,y=-12" :db/id #edb/ref 17592186343202} {:answer/id #uuid "a374971b-c760-5d83-adbf-3b1936e47374" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=-1,\\,y=-6" :db/id #edb/ref 17592186343673} {:answer/id #uuid "bbd32382-778d-546c-b434-bc2f6f15182c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=-4,\\,y=-4" :db/id #edb/ref 17592186343889} {:answer/id #uuid "bd80722c-1778-5d31-a005-82a0a1a70cf1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=\\frac{1}{2},\\,y=-3" :db/id #edb/ref 17592186343905} {:answer/id #uuid "f93e23d5-adfb-539c-932c-d93d3f7f5111" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=4,\\,y=4" :db/id #edb/ref 17592186344431}] :answer-field/correct {:answer/id #uuid "bd80722c-1778-5d31-a005-82a0a1a70cf1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=\\frac{1}{2},\\,y=-3" :db/id #edb/ref 17592186343905} :answer-field/id #uuid "0e62a385-bb95-5754-89d7-c5b01db0db60" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186344523}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "263b5643-f9a7-58b5-b4f2-be4d8aef81b1" :question/math-academy-id "q-75862" :question/problem "Find the solution to the  following system of equations:\n\n$$\n\\{\\begin{aligned}2x-\\frac{1}{3}y=2 \\\\ \\frac{1}{2}x-\\frac{1}{4}y=1\\end{aligned}\n$$" :question/worked-solution "To get rid of fractions, we multiply the first equation by $3$ and the second equation by $4,$ as follows:\n\n$$\n\\{\\begin{aligned}2x-\\frac{1}{3}y=2 & |\\times 3 \\\\ \\frac{1}{2}x-\\frac{1}{4}y=1 & |\\times 4\\end{aligned}\\,⟹\\,\\{\\begin{aligned}6x-y=6 \\\\ 2x-y=4\\end{aligned}\n$$\n\nWe will use the elimination method to solve the system. Notice that if we multiply the second equation by $-1,$ then we will get a $y$ term that can cancel with the $-y$ term in the first equation:\n\n$$\n\\{\\begin{aligned}6x-y=6 &  \\\\ 2x-y=4 & |\\,\\times (-1)\\end{aligned}\\,⟹\\,\\{\\begin{aligned}6x-y=6 \\\\ -2x+y=-4\\end{aligned}\n$$\n\nAdding the two equations eliminates the $y$-variable, and allows us to solve for $x:$\n\n$$\n\\begin{aligned}6x-\\cancel{y} & =6 \\\\ -2x+\\cancel{y} & =-4 \\\\ (6x-2x) & =(6-4) \\\\ 4x & =2 \\\\ x & =\\frac{2}{4} \\\\ x & =\\frac{1}{2}\\end{aligned}\n$$\n\nFinally, we substitute $x=\\frac{1}{2}$ into the second equation to solve for $y:$\n\n$$\n\\begin{aligned}2x-y & =4 \\\\ 2(\\frac{1}{2})-y & =4 \\\\ 1-y & =4 \\\\ y & =1-4 \\\\ y & =-3\\end{aligned}\n$$\n\nTherefore, the solution to the system is $x=\\frac{1}{2},\\,y=-3.$"}] [{:db/id #edb/ref 17592186345134 :knowledge-point/_questions [{:db/id #edb/ref 17592186068880 :knowledge-point/id #uuid "b5916154-14b6-5e2d-b33c-176b76293927" :knowledge-point/title "Solving Rational Equations Containing One Distinct Linear Denominator"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "403fead1-28dc-51e8-883e-1ea78fb58c8d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186342768} {:answer/id #uuid "51524fcb-5371-5134-98fd-7bc0b95c2398" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "7" :db/id #edb/ref 17592186342910} {:answer/id #uuid "6d345723-89f4-5351-84cf-b5bdbe44c4c1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186343174} {:answer/id #uuid "bcca82d0-a051-5fde-94e1-fbf46764a754" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "No solution" :db/id #edb/ref 17592186343898} {:answer/id #uuid "dce93094-4d77-5ba6-b201-1d213789909e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186344178}] :answer-field/correct {:answer/id #uuid "6d345723-89f4-5351-84cf-b5bdbe44c4c1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186343174} :answer-field/id #uuid "db497c06-807c-5ce4-a68f-3dd5b362ea6c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186344873}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "19f3a0d4-a9e3-5752-9f3d-c41b8d14446d" :question/math-academy-id "q-75924" :question/problem "Solve for $x$ where $\\frac{x+7}{x}-\\frac{1-x}{x}=4.$" :question/worked-solution "First, we note that $x=0$ is an excluded solution since division by $0$ is undefined. \n\nWe multiply both sides of the equation by $x,$ and simplify: \n\n$$\n\\begin{aligned}\\frac{x+7}{x}-\\frac{1-x}{x} & =4 \\\\ x\\cdot (\\frac{x+7}{x}-\\frac{1-x}{x}) & =x\\cdot 4 \\\\ x\\cdot \\frac{x+7}{x}-x\\cdot \\frac{1-x}{x} & =x\\cdot 4 \\\\ \\cancel{x}\\cdot \\frac{x+7}{\\cancel{x}}-\\cancel{x}\\cdot \\frac{1-x}{\\cancel{x}} & =4x \\\\ x+7-(1-x) & =4x\\end{aligned}\n$$\n\nWe now have a linear equation in $x,$ and we can solve this using the addition and multiplication principles:\n\n$$\n\\begin{aligned}x+7-(1-x) & =4x \\\\ 2x+6 & =4x \\\\ 4x-2x & =6 \\\\ 2x & =6 \\\\ x & =3\\end{aligned}\n$$\n\nFinally, we recall that we cannot allow $x=0$ as a solution. But since $x=3\\ne 0,$ we conclude that the solution is $x=3.$"}] [{:db/id #edb/ref 17592186345135 :knowledge-point/_questions [{:db/id #edb/ref 17592186068880 :knowledge-point/id #uuid "b5916154-14b6-5e2d-b33c-176b76293927" :knowledge-point/title "Solving Rational Equations Containing One Distinct Linear Denominator"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2685fdf5-b2ef-5419-a715-1c74ce9389ff" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{4}" :db/id #edb/ref 17592186342565} {:answer/id #uuid "26c73ff8-7bb1-58f5-b9d4-61756b11ddfe" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{5}{4}" :db/id #edb/ref 17592186342568} {:answer/id #uuid "75251e7a-9236-5e4c-9b53-7cfd86320732" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{2}" :db/id #edb/ref 17592186343251} {:answer/id #uuid "978d082a-57ab-588e-8901-810af078103c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{4}" :db/id #edb/ref 17592186343568} {:answer/id #uuid "9f71a6a2-9c4d-582e-afe9-1afe12b68ba5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{2}" :db/id #edb/ref 17592186343645}] :answer-field/correct {:answer/id #uuid "26c73ff8-7bb1-58f5-b9d4-61756b11ddfe" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{5}{4}" :db/id #edb/ref 17592186342568} :answer-field/id #uuid "4171e3f8-5f6b-53b2-9b4c-3f49129ae323" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186344598}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "dd8936d7-9acb-5f42-aac4-919b57567005" :question/math-academy-id "q-75925" :question/problem "Solve for $x$ where $\\frac{x-2}{5x}=\\frac{3-20x}{5x}+5.$" :question/worked-solution "First, we note that $x=0$ is an excluded solution since division by $0$ is undefined. \n\nWe multiply both sides of the equation by $5x,$ and simplify: \n\n$$\n\\begin{aligned}\\frac{x-2}{5x} & =\\frac{3-20x}{5x}+5 \\\\ 5x\\cdot (\\frac{x-2}{5x}) & =5x\\cdot (\\frac{3-20x}{5x}+5) \\\\ 5x\\cdot \\frac{x-2}{5x} & =5x\\cdot \\frac{3-20x}{5x}+5x\\cdot 5 \\\\ \\cancel{5x}\\cdot \\frac{x-2}{\\cancel{5x}} & =\\cancel{5x}\\cdot \\frac{3-20x}{\\cancel{5x}}+25x \\\\ x-2 & =3-20x+25x\\end{aligned}\n$$\n\nWe now have a linear equation in $x,$ and we can solve this using the addition and multiplication principles:\n\n$$\n\\begin{aligned}x-2 & =3-20x+25x \\\\ x-2 & =3+5x \\\\ 5x-x & =-2-3 \\\\ 4x & =-5 \\\\ x & =-\\frac{5}{4}\\end{aligned}\n$$\n\nFinally, we recall that we cannot allow $x=0$ as a solution. But since $x=-\\frac{5}{4}\\ne 0,$ we conclude that the solution is $x=-\\frac{5}{4}.$"}]}
