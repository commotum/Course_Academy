    "question": {
      "math_academy_id": "q-48571",
      "knowledge_point_id": "2451a654-2255-5867-871d-54340dfeff81",
      "knowledge_point": "Interpreting the Derivative of a Function in a Given Context",
      "problem": "The function $U(t)$ models the number of users of a new mobile phone app, $t$ hours after launching the app. What is the best interpretation of ${U}^{′}(4)=650?$",
      "worked_solution": "The function ${U}^{′}(t)$ represents the rate at which the number of users is changing at the moment $t$ hours after launch. \n\nTherefore, ${U}^{′}(4)=650$ means:\n\n$\\,$ *$4$ hours after the launch, the number of users increased at a rate of $650$ users per hour*",
      "answer_fields": [
        {
          "key": "selection",
          "type": "radio",
          "choices": [
            {
              "type": "text",
              "value": "$4$ hours after the launch, there are exactly $650$ users.",
              "option": "0",
              "source_option": "a"
            },
            {
              "type": "text",
              "value": "$4$ hours after the launch, the number of users decreased at a rate of $650$ users per hour",
              "option": "1",
              "source_option": "b"
            },
            {
              "type": "text",
              "value": "The number of users increased by $650$ during the first $4$ hours",
              "option": "2",
              "source_option": "c"
            },
            {
              "type": "text",
              "value": "$4$ hours after the launch, the number of users increased at a rate of $650$ users per hour",
              "option": "3",
              "source_option": "d"
            },
            {
              "type": "text",
              "value": "The number of users increased at a constant rate of $162.5$ users per hour",
              "option": "4",
              "source_option": "e"
            }
          ]
        }
      ],
      "difficulty": "easy",
      "provenance": {
        "activity_question": "question-48571",
        "kp_title": "Interpreting the Derivative of a Function in a Given Context",
        "kp_href": null
