            {
              "type": "math",
              "value": "-\\frac{1}{2\\sqrt{{x}^{5}}}",
              "option": "1",
              "source_option": "b"
            },
            {
              "type": "math",
              "value": "-\\frac{1}{3\\sqrt{x}}",
              "option": "2",
              "source_option": "c"
            },
            {
              "type": "math",
              "value": "\\frac{1}{3\\sqrt{{x}^{5}}}",
              "option": "3",
