    "question": {
      "math_academy_id": "q-1856",
      "knowledge_point_id": "f8e49a0c-9575-5bd0-af4e-6463495e56b3",
      "knowledge_point": "Differentiating a Sum of Functions With Constant Factors",
      "problem": "Calculate $\\frac{\\text{d}y}{\\text{d}x}$ for $y=\\frac{2}{{x}^{2}}-3{x}^{3/4}.$",
      "worked_solution": "Here, we apply the addition, constant multiple, and power rules:\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}}{\\text{d}x}(\\frac{2}{{x}^{2}}-3{x}^{3/4}) \\\\  & =\\frac{\\text{d}}{\\text{d}x}(2{x}^{-2})-\\frac{\\text{d}}{\\text{d}x}(3{x}^{3/4}) \\\\  & =2\\cdot \\frac{\\text{d}}{\\text{d}x}({x}^{-2})-3\\cdot \\frac{\\text{d}}{\\text{d}x}({x}^{3/4}) \\\\  & =2\\cdot (-2){x}^{(-2-1)}-3\\cdot \\frac{3}{4}{x}^{(3/4-1)} \\\\  & =-4{x}^{-3}-\\frac{9}{4}{x}^{-1/4} \\\\  & =-\\frac{4}{{x}^{3}}-\\frac{9}{4\\sqrt[4]{x}}\\end{aligned}\n$$",
      "answer_fields": [
        {
          "key": "selection",
          "type": "radio",
