  {
    "directory": "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13930198",
    "question": {
      "math_academy_id": "q-48684",
      "knowledge_point_id": "159b4d58-b34d-52cd-aad2-2c058f772ad2",
      "knowledge_point": "Interpreting the Derivative of a Function",
      "problem": "Consider a rectangle such that the height is fixed but its base $b$ can vary. What is the best interpretation of ${A}^{′}(b)$ if $A$ is the area of the rectangle?",
      "worked_solution": "The function $A(b)$ gives the area of a rectangle with base $b.$ So\n\n$$\n{A}^{′}(b)=\\frac{\\text{d}A}{\\text{d}b}=\\frac{\\text{Change in }A}{\\text{Change in }b}.\n$$\n\nTherefore, ${A}^{′}(b)$ is the rate at which the area changes as the base changes.",
      "answer_fields": [
        {
          "key": "selection",
          "type": "radio",
          "choices": [
            {
              "type": "text",
              "value": "The length of the base of the rectangle",
              "option": "0",
              "source_option": "a"
            },
            {
              "type": "text",
              "value": "The rate at which the area changes as the base changes",
              "option": "1",
              "source_option": "b"
            },
            {
              "type": "text",
              "value": "The rate at which the area changes as the height changes",
              "option": "2",
              "source_option": "c"
            },
            {
              "type": "text",
              "value": "The rate at which the height changes as the area changes",
              "option": "3",
              "source_option": "d"
            },
            {
              "type": "text",
              "value": "The area of a rectangle with base $b$",
              "option": "4",
              "source_option": "e"
            }
          ]
        }
      ],
      "difficulty": "moderate",
      "provenance": {
        "activity_question": "question-48684",
        "kp_title": "Interpreting the Derivative of a Function",
        "kp_href": null
      },
