              "type": "text",
              "value": "$10$ hours after launching, the number of visitors increased by a total of $1\\,500$ visitors",
              "option": "3",
              "source_option": "d"
            },
            {
              "type": "text",
              "value": "$10$ hours after launching, the number of visitors decreased at a rate of $1\\,500$ visitors per hour",
              "option": "4",
              "source_option": "e"
            }
