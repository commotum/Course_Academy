            },
            {
              "type": "text",
              "value": "$10$ hours after launching, the number of visitors increased at a rate of $1\\,500$ visitors per hour",
              "option": "1",
              "source_option": "b"
            },
            {
              "type": "text",
              "value": "$10$ hours after launching, the number of visitors increased at a constant rate of $150$ visitors per hour",
              "option": "2",
              "source_option": "c"
