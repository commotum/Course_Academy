              "value": "x<2\\operatorname{ln}⁡5-3",
              "option": "1",
              "source_option": "b"
            },
            {
              "type": "math",
              "value": "x>2\\operatorname{ln}⁡5-3",
              "option": "2",
              "source_option": "c"
            },
            {
              "type": "math",
              "value": "x>\\frac{\\operatorname{ln}⁡5-\\operatorname{ln}⁡2}{2\\operatorname{ln}⁡5}",
              "option": "3",
              "source_option": "d"
            },
            {
              "type": "math",
              "value": "x<5\\operatorname{ln}⁡2+3",
              "option": "4",
