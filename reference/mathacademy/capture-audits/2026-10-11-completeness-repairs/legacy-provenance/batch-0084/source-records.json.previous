              "type": "math",
              "value": "x<\\frac{\\operatorname{ln}⁡5-2\\operatorname{ln}⁡2}{\\operatorname{ln}⁡5-\\operatorname{ln}⁡2}",
              "option": "0",
              "source_option": "a"
            },
            {
