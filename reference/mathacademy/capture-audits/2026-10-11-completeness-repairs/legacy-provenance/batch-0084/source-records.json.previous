            },
            {
              "type": "math",
              "value": "x\\ge \\frac{\\operatorname{ln}⁡3-\\operatorname{ln}⁡4}{3\\operatorname{ln}⁡5-2\\operatorname{ln}⁡4}",
              "option": "1",
              "source_option": "b"
            },
            {
              "type": "math",
              "value": "x\\le \\frac{\\operatorname{ln}⁡3+\\operatorname{ln}⁡5-\\operatorname{ln}⁡4}{\\operatorname{ln}⁡5+2\\operatorname{ln}⁡4}",
              "option": "2",
              "source_option": "c"
            },
            {
              "type": "math",
              "value": "x\\le \\frac{\\operatorname{ln}⁡3+2\\operatorname{ln}⁡5-\\operatorname{ln}⁡4}{3\\operatorname{ln}⁡5-2\\operatorname{ln}⁡4}",
