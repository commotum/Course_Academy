    "question": {
      "math_academy_id": "q-89651",
      "knowledge_point_id": "bca43484-4a4f-57b7-a4c2-23d1db997afd",
      "knowledge_point": "Solving Inequalities Requiring Multiplication by a Positive Factor",
      "problem": "Solve the inequality\n\n$$\n\\frac{2{x}^{4}+3x}{{x}^{4}+2}\\le 2.\n$$",
      "worked_solution": "We know that the denominator ${x}^{4}+2$ is positive for all values of $x.$ So, we can multiply both sides of the inequality by ${x}^{4}+2$ and solve the resulting inequality as follows:\n\n$$\n\\begin{aligned}\\frac{2{x}^{4}+3x}{{x}^{4}+2} & \\le 2 \\\\ ({x}^{4}+2)\\cdot \\frac{2{x}^{4}+3x}{{x}^{4}+2} & \\le ({x}^{4}+2)\\cdot 2 \\\\ 2{x}^{4}+3x & \\le 2{x}^{4}+4 \\\\ 3x & \\le 4 \\\\ x & \\le \\frac{4}{3}\\end{aligned}\n$$",
      "answer_fields": [
        {
          "key": "selection",
          "type": "radio",
          "choices_complete": true,
          "choices": [
            {
              "type": "math",
