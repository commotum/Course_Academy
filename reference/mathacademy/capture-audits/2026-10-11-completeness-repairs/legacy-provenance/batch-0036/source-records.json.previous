            },
            {
              "type": "math",
              "value": "-6",
              "option": "1",
              "source_option": "b"
            },
            {
              "type": "math",
              "value": "\\frac{1}{9}",
              "option": "2",
              "source_option": "c"
            },
            {
              "type": "math",
              "value": "\\frac{1}{6}",
              "option": "3",
              "source_option": "d"
            },
            {
              "type": "math",
              "value": "-9",
              "option": "4",
              "source_option": "e"
            }
          ]
        }
      ],
