            {
              "type": "math",
              "value": "0<{x}^{2}+{y}^{2}<4",
              "option": "2",
              "source_option": "c"
            },
            {
              "type": "math",
              "value": "0<{x}^{2}+{y}^{2}<2",
              "option": "3",
              "source_option": "d"
