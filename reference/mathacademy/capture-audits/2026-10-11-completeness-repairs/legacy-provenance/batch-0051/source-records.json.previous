              "source_option": "a"
            },
            {
              "type": "math",
              "value": "{x}^{2}=-\\frac{16}{3}y",
              "option": "1",
              "source_option": "b"
            },
            {
              "type": "math",
              "value": "{x}^{2}=-\\frac{8}{3}y",
              "option": "2",
              "source_option": "c"
