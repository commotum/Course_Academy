              "type": "math",
              "value": "\\operatorname{arctan}⁡(4)",
              "option": "1",
              "source_option": "b"
            },
            {
              "type": "math",
              "value": "\\operatorname{arctan}⁡(\\frac{3}{2})",
              "option": "2",
              "source_option": "c"
            },
            {
              "type": "math",
              "value": "\\operatorname{arctan}⁡(3)",
              "option": "3",
              "source_option": "d"
            },
            {
              "type": "math",
              "value": "\\operatorname{arctan}⁡(\\frac{5}{2})",
              "option": "4",
              "source_option": "e"
            }
          ]
        }
