              "value": "y=cos⁡(x)",
              "option": "2",
              "source_option": "c"
            },
            {
              "type": "math",
              "value": "y=-cos⁡(x)",
              "option": "3",
              "source_option": "d"
            },
            {
              "type": "math",
              "value": "y=-cos⁡(x+1)-1",
