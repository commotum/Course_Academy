              "type": "math",
              "value": "y=-sin⁡(\\frac{x}{4})",
              "option": "0",
              "source_option": "a"
            },
            {
              "type": "math",
              "value": "y=-sin⁡x-\\frac{1}{4}",
              "option": "1",
              "source_option": "b"
            },
            {
              "type": "math",
              "value": "y=\\frac{1}{4}-sin⁡x",
              "option": "2",
              "source_option": "c"
            },
            {
