#{[{:db/id #edb/ref 17592186250122 :knowledge-point/_questions [{:db/id #edb/ref 17592186096655 :knowledge-point/id #uuid "f4b340f6-0ac6-5bbf-a7d4-0088ca3c4e5e" :knowledge-point/title "Integrating the Exponential Function With a Linear Exponent"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0609bfa0-feaa-5eb6-8746-b749fc1e9ec2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\,{e}^{x-1}+C" :db/id #edb/ref 17592186247477} {:answer/id #uuid "253a16d7-628b-53f9-a7b2-1f6c746a4abb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2\\,{e}^{x/2\\,-\\,1}+C" :db/id #edb/ref 17592186247750} {:answer/id #uuid "2d6d85b6-5dd0-5f4b-aa63-52da5bb8cf45" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\,{e}^{x/2\\,-\\,1}+C" :db/id #edb/ref 17592186247828} {:answer/id #uuid "3bc85c63-a410-59bf-afe3-e5c1937a752b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{e}^{x/2\\,-\\,1}}{2}+C" :db/id #edb/ref 17592186247953} {:answer/id #uuid "42a6cbcd-5218-511c-8178-7959687c4db1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{e}^{x/2\\,-\\,1}+C" :db/id #edb/ref 17592186248018}] :answer-field/correct {:answer/id #uuid "2d6d85b6-5dd0-5f4b-aa63-52da5bb8cf45" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\,{e}^{x/2\\,-\\,1}+C" :db/id #edb/ref 17592186247828} :answer-field/id #uuid "4c624ee9-f981-5550-b705-79dced8e3486" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186249811}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "0dd276ae-ab9b-5d13-9781-196a361b49ac" :question/math-academy-id "q-113833" :question/problem "Calculate $\\int {e}^{x/2\\,-\\,1}\\,\\text{d}x.$" :question/worked-solution "If we let $u=\\frac{x}{2}-1,$ then\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=\\frac{1}{2}\\,⟹\\,2\\,\\text{d}u=\\text{d}x.\n$$\n\nThen, we can write the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}\\int {e}^{x/2\\,-\\,1}\\,\\text{d}x & =\\int {e}^{u}\\cdot 2\\,\\text{d}u \\\\  & =2\\int {e}^{u}\\,\\text{d}u \\\\  & =2\\,{e}^{u}+C \\\\  & =2\\,{e}^{x/2\\,-\\,1}+C\\end{aligned}\n$$"}]}
