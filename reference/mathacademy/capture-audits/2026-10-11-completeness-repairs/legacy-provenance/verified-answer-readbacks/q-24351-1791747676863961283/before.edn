#{[{:db/id #edb/ref 17592186069177 :knowledge-point/_questions [{:db/id #edb/ref 17592186068751 :knowledge-point/id #uuid "5dff5b7c-544a-5fda-a175-51ce4723a135" :knowledge-point/title "Solving a \"Greater Than or Equal To\" Inequality Given the Graph of the Corresponding Parabola"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1383fd97-77d3-5ac2-be23-4b9d7dc8885a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x\\ge 3" :db/id #edb/ref 17592186288167} {:answer/id #uuid "362fcbae-cb89-5509-8424-b1ee7253363f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3\\le x\\le 2" :db/id #edb/ref 17592186288395} {:answer/id #uuid "46d5b3e6-49b1-5f02-8bd8-ebc685df8719" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$x\\le -2$ or $x\\ge 3$" :db/id #edb/ref 17592186288519} {:answer/id #uuid "4881613a-3587-5b83-92d1-c4557759480e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2\\le x\\le 3" :db/id #edb/ref 17592186288534} {:answer/id #uuid "570c0835-b65c-52fe-9f64-104b4ace6481" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x\\le -2" :db/id #edb/ref 17592186288635}] :answer-field/correct {:answer/id #uuid "1383fd97-77d3-5ac2-be23-4b9d7dc8885a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x\\ge 3" :db/id #edb/ref 17592186288167} :answer-field/id #uuid "7a561c7b-ae6b-533f-be16-6d5b7c106d68" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186289999}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "ffe39127-4650-5f93-972b-bb5efc38f550" :question/math-academy-id "q-24351" :question/problem "![](images/09/098189dc8e96b01cb045a198eef3f00ba2df6594fc14675cad81246fc2d25964.png)\n\nGiven the graph above, solve the inequality $(x+2)(x-3)\\ge 0.$" :question/worked-solution "Notice that our inequality\n\n$$\n(x+2)(x-3)\\ge 0\n$$\n\nis a \"*greater than or equal to*\" inequality. Therefore, we need to find the values of $x$ for which the parabola \n\n$$\ny=(x+2)(x-3)\n$$\n\nis *above* the $x$-axis or *touches* this axis. We mark these values of $x$ in blue in the diagram below.\n\n![](images/3e/3e80a6e08ccff87314e5081a08332f0de508f6db02446742d1c93416d41a4b3c.png)\n\nSo, the solution to the inequality is $x\\le -2$ or $x\\ge 3.$"}]}
