#{[{:db/id #edb/ref 17592186292804 :knowledge-point/_questions [{:db/id #edb/ref 17592186064163 :knowledge-point/id #uuid "e901ea71-aeab-5e95-939e-2401558aa708" :knowledge-point/title "Finding the Global Extrema of a Function on a Given Interval"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2225758d-8dde-578c-a547-500b65f253b3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186290778} {:answer/id #uuid "3d7ed184-a058-5189-a723-395001836891" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5}{2}" :db/id #edb/ref 17592186290887} {:answer/id #uuid "5a80c147-1f17-5590-baeb-78228c37c97c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{7}{2}" :db/id #edb/ref 17592186291023} {:answer/id #uuid "7bb02329-a57e-526d-989d-b162a90d0227" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186291154} {:answer/id #uuid "db46b9ef-b0f7-5c48-b877-de4aa36c374a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186291549}] :answer-field/correct {:answer/id #uuid "7bb02329-a57e-526d-989d-b162a90d0227" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186291154} :answer-field/id #uuid "26b8e670-86de-53ef-b5db-4451381e1cb4" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186291869}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "2a126432-a7f1-5215-9a02-985aac25ece8" :question/math-academy-id "q-2751" :question/problem "Find the global maximum value of the function $f(x)=\\sqrt{x}$ on the closed interval $4\\le x\\le 9.$" :question/worked-solution "Let's apply the candidates test step by step.\n\n**Step 1**: We find the critical points. Taking the derivative of $f(x)=\\sqrt{x},$ we get\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{1}{2\\sqrt{x}}.\\end{aligned}\n$$\n\nWe can see that ${f}^{′}(x)>0$ for all $x>0.$ So there is no solution for ${f}^{′}(x)=0.$\n\nSo, the only critical points are the endpoints $x=4,9$ (since the derivative is not defined at the endpoints).\n\n**Step 2**: We evaluate $f(x)$ at the critical points.\n\n$$\n\\begin{aligned}f(4) & =\\sqrt{4}=2 \\\\ f(9) & =\\sqrt{9}=3\\end{aligned}\n$$\n\n**Step 3**: We compare all of the values found in step $2.$\n\n- The greatest value is $f(9)=3,$ so the global maximum is $3.$\n\n- The least value is $f(4)=2,$ so the global minimum is $2.$\n\n![](images/c8/c8badccb8144447b5b57157308b5614293a54569f8247320a358dd20650d91a1.png)"}]}
