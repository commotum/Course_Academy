#{[{:db/id #edb/ref 17592186237878 :knowledge-point/_questions [{:db/id #edb/ref 17592186157286 :knowledge-point/id #uuid "19fb3196-439e-5466-b50c-615c492167b4" :knowledge-point/title "Finding the Complement of a Set Using a Venn Diagram"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "16b049bc-7aca-5687-b38f-971c9aa079bb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{m}" :db/id #edb/ref 17592186235959} {:answer/id #uuid "2c1a6be1-1e2d-5343-ac85-3d5cf60a8602" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{m,n}" :db/id #edb/ref 17592186236093} {:answer/id #uuid "4d6265ad-6faa-5f83-b4b4-f1b5249d68d6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{l,m,n}" :db/id #edb/ref 17592186236312} {:answer/id #uuid "5a326e65-8644-52a3-a8e3-06e250e5ad7a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{n}" :db/id #edb/ref 17592186236381} {:answer/id #uuid "a64b96f2-c629-579c-b5dc-a3da7b5bd670" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{l,m,n,o}" :db/id #edb/ref 17592186236859}] :answer-field/correct {:answer/id #uuid "5a326e65-8644-52a3-a8e3-06e250e5ad7a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{n}" :db/id #edb/ref 17592186236381} :answer-field/id #uuid "b3fb0c0d-1d27-592b-96c1-d094c4cc9822" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186237670}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "5a339fd3-f450-5a9a-b0dd-ff8dba5b4293" :question/math-academy-id "q-102246" :question/problem "![](images/95/95f7caf5956ab22fe5b47d14098730e23332c41a26d58fc8dc0f0e4ca28546ab.png)\n\nLet $U={l,m,n,o}$ be the universal set and let $K={l,m,o}.$ What is $\\overset{―}{K}?$" :question/worked-solution "The complement of $K,$ denoted $\\overset{―}{K},$ consists of all the elements in $U$ that are not in $K.$ To represent $\\overset{―}{K},$ we will shade in all the area of $U$ that is *outside* of $K,$ as follows:\n\n![](images/74/74345aeb2a1028e07d155dd357a9bb412860309c99cee37c62380907b3e1bd37.png)\n\nThe element in the shaded area is $n.$ This is the only element of $U$ that is not in $K.$ Therefore, the complement of $K$ is\n\n$$\n\\overset{―}{K}={n}.\n$$"}] [{:db/id #edb/ref 17592186240999 :knowledge-point/_questions [{:db/id #edb/ref 17592186157287 :knowledge-point/id #uuid "9a55a708-abb0-5e23-8862-153561d022c8" :knowledge-point/title "Finding the Complement of a Set Without a Venn Diagram"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "08b8a25d-b4a8-5505-9edf-f719136b36a9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{2,6,10,14}" :db/id #edb/ref 17592186238146} {:answer/id #uuid "1cd19508-0077-55b3-85d7-4abb4feb7afc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{2,6,10,14,18}" :db/id #edb/ref 17592186238297} {:answer/id #uuid "635c77f2-7281-521c-99f6-c8601943a851" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{0,2,6,10,14,18}" :db/id #edb/ref 17592186238927} {:answer/id #uuid "d11d4c57-5a75-5eb6-a5f2-d8e844d6e98d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{2,6,10,18}" :db/id #edb/ref 17592186239885} {:answer/id #uuid "d374b79e-d5d2-571e-800a-0f04f7a62ca1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{6,10,14,18}" :db/id #edb/ref 17592186239910}] :answer-field/correct {:answer/id #uuid "1cd19508-0077-55b3-85d7-4abb4feb7afc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{2,6,10,14,18}" :db/id #edb/ref 17592186238297} :answer-field/id #uuid "0c294f44-fff5-5b15-a966-35cefb0a5204" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186240345}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "32ae7bbc-249c-5c79-aba5-9c3291b509c7" :question/math-academy-id "q-105179" :question/problem "If $U={2,4,6,8,…,20}$ is the universal set and $B={4,8,12,16,20},$ then the complement of $B$ is" :question/worked-solution "The complement of $B,$ denoted $\\overset{―}{B},$ consists of every element in the universal set $U$ that is not in the set $B.$\n\nThe elements of $U$ that are not in $B$ are $2,$ $6,$ $10,$ $14,$ and $18.$\n\nTherefore, the complement of $B$ is\n\n$$\n\\overset{―}{B}={2,6,10,14,18}.\n$$"}] [{:db/id #edb/ref 17592186241005 :knowledge-point/_questions [{:db/id #edb/ref 17592186157288 :knowledge-point/id #uuid "49251196-c06b-5718-82e6-5ed9450301af" :knowledge-point/title "Finding the Complement of a Set Given Using Ellipsis Notation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "146cb236-a956-558d-bf48-d5a97b6bc955" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{i,j,k,…,z}" :db/id #edb/ref 17592186238224} {:answer/id #uuid "29f3b908-d446-5783-9f29-9f7840808138" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{j,k,l…,z}" :db/id #edb/ref 17592186238424} {:answer/id #uuid "38b3b88c-3757-5488-ada8-3cf3bb37f1aa" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{l,m,n…,z}" :db/id #edb/ref 17592186238544} {:answer/id #uuid "a7b7ad77-d71c-5c7e-a4ee-85817731ed29" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{k,l,m,…,z}" :db/id #edb/ref 17592186239511} {:answer/id #uuid "e0d6ba86-f748-5dda-a617-0c6f1c666b93" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{m,n,o…,z}" :db/id #edb/ref 17592186240027}] :answer-field/correct {:answer/id #uuid "a7b7ad77-d71c-5c7e-a4ee-85817731ed29" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{k,l,m,…,z}" :db/id #edb/ref 17592186239511} :answer-field/id #uuid "969e0b9d-d3d2-5f29-a98a-b20b18e9c6f0" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186240596}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "3aa7531f-69fb-514d-bcea-7f5e2dae1a2a" :question/math-academy-id "q-105188" :question/problem "Let $U={a,b,c,…,z}$ be the universal set and $Y={a,b,c,…,j}$, then $\\overset{―}{Y}=$" :question/worked-solution "The complement of $Y,$ denoted $\\overset{―}{Y},$ consists of every element in the universal set $U$ that is not in the set $Y.$\n\nThe universal set $U$ consists of the letters $a$ through $z,$ while the set $Y$ consists of the letters $a$ through $j.$\n\nSo, the only elements of $U$ that are not in $Y$ are the letters $k$ through $z.$\n\nTherefore, the complement of $Y$ is\n\n$$\n\\overset{―}{Y}={k,l,m,…,z}.\n$$"}] [{:db/id #edb/ref 17592186399685 :knowledge-point/_questions [{:db/id #edb/ref 17592186110653 :knowledge-point/id #uuid "42525832-e186-538f-baf8-bb4418e9820b" :knowledge-point/title "Working With Systems Containing Inequalities Presented in Standard Form"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "84a02541-33c6-5f69-a920-35696f66c170" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\begin{aligned}x+2y\\le -8 \\\\ y\\ge \\frac{1}{2}x+1\\end{aligned}" :db/id #edb/ref 17592186399687} {:answer/id #uuid "5eb29637-b617-5711-9aa5-c2814f5eceb8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\begin{aligned}x+2y>-8 \\\\ y>\\frac{1}{2}x+1\\end{aligned}" :db/id #edb/ref 17592186399688} {:answer/id #uuid "0642a65f-b668-5a8d-b6f2-b2575f8c1362" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\begin{aligned}x+2y\\ge -8 \\\\ y\\ge \\frac{1}{2}x+1\\end{aligned}" :db/id #edb/ref 17592186399689} {:answer/id #uuid "f8ff8a6d-ad42-5c71-989f-6bb5f699155a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\begin{aligned}x+2y\\le -8 \\\\ y\\le \\frac{1}{2}x+1\\end{aligned}" :db/id #edb/ref 17592186399690} {:answer/id #uuid "f8efb9aa-532e-55ae-9077-3bedc400e006" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\begin{aligned}x+2y\\ge -8 \\\\ y\\le \\frac{1}{2}x+1\\end{aligned}" :db/id #edb/ref 17592186399691}] :answer-field/correct {:answer/id #uuid "f8efb9aa-532e-55ae-9077-3bedc400e006" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\begin{aligned}x+2y\\ge -8 \\\\ y\\le \\frac{1}{2}x+1\\end{aligned}" :db/id #edb/ref 17592186399691} :answer-field/id #uuid "fce68956-d8ec-5373-80c1-0576c6b35476" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186399686}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "b9a72356-7e05-5f10-b6ac-a2418c3b4fa6" :question/math-academy-id "q-110078" :question/problem "![](images/39/3905dacc3977857933a48ced329fc245b357f732aec520e67998efc0b5d7cdab.png)\n\nWhich of the following systems of inequalities defines the shaded region shown above?" :question/worked-solution "Consider the line $x+2y=-8.$ Since the line is solid, the inequality is an \"or equal to\" inequality. Writing the equation of this line in slope-intercept form, we have\n\n$$\ny=-\\frac{1}{2}x-4.\n$$\n\nNow, since the shaded region lies *above* the line, the inequality is a \"greater than\" inequality. So the corresponding inequality is\n\n$$\ny\\ge -\\frac{1}{2}x-4,\n$$\n\n    \n\nwhich we can rewrite as\n\n$$\nx+2y\\ge -8.\n$$\n\nNow consider the line $y=\\frac{1}{2}x+1.$ Since the line is solid, the inequality is an \"or equal to\" inequality. Also, since the shaded region lies *below* the line, the inequality is a \"less than\" inequality. So the corresponding inequality is\n\n$$\ny\\le \\frac{1}{2}x+1.\n$$\n\nTherefore, the system of inequalities that defines the shaded region is\n\n$$\n{\\begin{aligned}x+2y\\ge -8 \\\\ y\\le \\frac{1}{2}x+1.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186247383 :knowledge-point/_questions [{:db/id #edb/ref 17592186171957 :knowledge-point/id #uuid "9c976b6a-4523-51e1-a243-27aa8937db25" :knowledge-point/title "Expressing the Relationship Between the Rows of Pascal's Triangle in Terms of Binomial Coefficients"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8b3b1495-fd4e-590e-abf2-f1d01bed44e4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(\\frac{5}{3})" :db/id #edb/ref 17592186245535} {:answer/id #uuid "a6d0e7ca-9cf6-56d2-bd14-35cdeb9caa81" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(\\frac{4}{3})" :db/id #edb/ref 17592186245807} {:answer/id #uuid "c4a33636-8960-5f5f-8599-a5cf57881efe" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(\\frac{6}{5})" :db/id #edb/ref 17592186246060} {:answer/id #uuid "caa06872-b168-58f8-a4a8-ab8168991c78" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(\\frac{5}{5})" :db/id #edb/ref 17592186246113} {:answer/id #uuid "ce63f89f-656b-512a-96b3-aa29379755eb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(\\frac{4}{4})" :db/id #edb/ref 17592186246157}] :answer-field/correct {:answer/id #uuid "8b3b1495-fd4e-590e-abf2-f1d01bed44e4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(\\frac{5}{3})" :db/id #edb/ref 17592186245535} :answer-field/id #uuid "dafab0b3-0ea9-52f1-b23d-e401a912ba3a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186246939}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "b7e46def-b53d-544e-a445-f2ab7d8b4fbc" :question/math-academy-id "q-113611" :question/problem "Which expression is missing in the following equation?\n\n$$\n(\\frac{6}{4})=[]+(\\frac{5}{4})\n$$" :question/worked-solution "To find $(\\frac{6}{4}),$ we need to find the number that is located in row $6$ and position $4$ of Pascal's triangle. \n\n**Important**: When counting the rows and positions in Pascal's triangle, we always start counting from zero! Remember:\n\n- The top row of Pascal's triangle is row $0.$\n\n- The first position of each row (the one of the left) is position number $0.$\n\nThe location of $(\\frac{6}{4})$ in Pascal's triangle is highlighted below.\n\n$$\n\\begin{aligned} &  &  &  &  &  &  &  & (\\frac{0}{0}) \\\\  &  &  &  &  &  &  & (\\frac{1}{0}) &  & (\\frac{1}{1}) \\\\  &  &  &  &  &  & (\\frac{2}{0}) &  & (\\frac{2}{1}) &  & (\\frac{2}{2}) \\\\  &  &  &  &  & (\\frac{3}{0}) &  & (\\frac{3}{1}) &  & (\\frac{3}{2}) &  & (\\frac{3}{3}) \\\\  &  &  &  & (\\frac{4}{0}) &  & (\\frac{4}{1}) &  & (\\frac{4}{2}) &  & (\\frac{4}{3}) &  & (\\frac{4}{4}) \\\\  &  &  & (\\frac{5}{0}) &  & (\\frac{5}{1}) &  & (\\frac{5}{2}) &  & (\\frac{5}{3}) &  & (\\frac{5}{4}) &  & (\\frac{5}{5}) \\\\  &  & (\\frac{6}{0}) &  & (\\frac{6}{1}) &  & (\\frac{6}{2}) &  & (\\frac{6}{3}) &  & (\\frac{6}{4}) &  & (\\frac{6}{5}) &  & (\\frac{6}{6}) \\\\  & ⋮ &  & ⋮ &  & ⋮ &  & ⋮ &  & ⋮ &  & ⋮ &  & ⋮ &  & ⋮\\end{aligned}\n$$\n\nNow, $(\\frac{6}{4})$ is the sum of the two closest numbers located in the previous row. So,\n\n$$\n(\\frac{6}{4})=(\\frac{5}{3})+(\\frac{5}{4})\n$$\n\nTherefore, the missing expression is $(\\frac{5}{3}).$"}] [{:db/id #edb/ref 17592186253272 :knowledge-point/_questions [{:db/id #edb/ref 17592186133937 :knowledge-point/id #uuid "2e675f1c-9093-5f6e-a3b3-112d0bc8e516" :knowledge-point/title "Solving a Factored Higher-Order Polynomial Inequality"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "11e5043a-3f1b-5f5b-bcbc-e166efd4ebcd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x\\in (-\\infty ,-2]\\cup [7,\\infty )" :db/id #edb/ref 17592186250707} {:answer/id #uuid "8a4b2875-f02c-5afa-b32c-36d4cf303e86" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x\\in {-2}\\cup [7,\\infty )" :db/id #edb/ref 17592186251719} {:answer/id #uuid "9ce64a4f-ea12-5a34-9745-a6ee77838e83" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x\\in [-5,7]" :db/id #edb/ref 17592186251907} {:answer/id #uuid "c8e3439e-fc9c-56a7-abef-e1dbb6bcab4c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x\\in (-\\infty ,-5]\\cup [7,\\infty )" :db/id #edb/ref 17592186252329} {:answer/id #uuid "f4cbebeb-2715-5dea-b1bf-de479f36bf25" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x\\in (-\\infty ,-5]\\cup {-2}\\cup [7,\\infty )" :db/id #edb/ref 17592186252697}] :answer-field/correct {:answer/id #uuid "f4cbebeb-2715-5dea-b1bf-de479f36bf25" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x\\in (-\\infty ,-5]\\cup {-2}\\cup [7,\\infty )" :db/id #edb/ref 17592186252697} :answer-field/id #uuid "4480b1db-53d1-58b7-9c5c-51fba18c5921" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186252925}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "6f270ff5-bc17-53a5-be2e-3042a3d54393" :question/math-academy-id "q-116595" :question/problem "Solve the inequality $(x+2)^{4}(x+5)(x-7)\\ge 0.$" :question/worked-solution "First, we define the function $f(x)$ as\n\n$$\nf(x)=(x+2)^{4}(x+5)(x-7).\n$$\n\nSo we're now solving the inequality $f(x)\\ge 0.$\n\nThe solutions to the equation $f(x)=0$ are $x=-5,$ $x=-2,$ and $x=7.$ These roots divide the number line into $4$ subintervals:\n\n$$\n(-\\infty ,-5),\\,(-5,-2),\\,(-2,7),\\,(7,\\infty ).\n$$\n\nNow, we construct a sign table with the list of the intervals on the top and the list of factors on the left. Filling in the sign table using the usual method, we get the following result:\n\n|  | $(-\\infty ,-5)$ | $(-5,-2)$ | $(-2,7)$ | $(7,\\infty )$ |\n| --- | --- | --- | --- | --- |\n| $(x+2)^{4}$ | $+$ | $+$ | $+$ | $+$ |\n| $x+5$ | $-$ | $+$ | $+$ | $+$ |\n| $x-7$ | $-$ | $-$ | $-$ | $+$ |\n| $f(x)$ | $+$ | $-$ | $-$ | $+$ |\n\nFinally, to solve the inequality $f(x)\\ge 0,$ we look at the bottom row to determine where $f(x)$ is positive.\n\nFrom the table, we see that $f(x)$ is positive on the intervals $(-\\infty ,-5)$ and $(7,\\infty ).$\n\nTherefore, remembering that the roots are also solutions, we conclude that $f(x)\\ge 0$ for all $x\\in (-\\infty ,-5]\\cup {-2}\\cup [7,\\infty ).$"}] [{:db/id #edb/ref 17592186253275 :knowledge-point/_questions [{:db/id #edb/ref 17592186133938 :knowledge-point/id #uuid "6bea8139-82a8-5c0a-9d3b-f3a47356773e" :knowledge-point/title "Solving an Expanded Polynomial Inequality"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "82e9a537-35f9-5e3b-ab01-9a35c8a25c58" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x\\in [-7,4]" :db/id #edb/ref 17592186251657} {:answer/id #uuid "a0c2a7c7-94dc-5448-b33b-a91741c663a9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x\\in (-\\infty ,-7]\\cup {0}" :db/id #edb/ref 17592186251941} {:answer/id #uuid "ca0e19d0-9307-5c69-9e89-ae8e019adbf2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x\\in {0}\\cup [4,\\infty )" :db/id #edb/ref 17592186252344} {:answer/id #uuid "cb2e009d-1001-5e69-8ef1-819444c324cb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x\\in (-\\infty ,-7]\\cup [4,\\infty )" :db/id #edb/ref 17592186252353} {:answer/id #uuid "d6bc0ca2-d579-5a1c-98a4-d0d580ba1284" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x\\in (-\\infty ,-7]\\cup {0}\\cup [4,\\infty )" :db/id #edb/ref 17592186252456}] :answer-field/correct {:answer/id #uuid "d6bc0ca2-d579-5a1c-98a4-d0d580ba1284" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x\\in (-\\infty ,-7]\\cup {0}\\cup [4,\\infty )" :db/id #edb/ref 17592186252456} :answer-field/id #uuid "6eea42f5-3c3e-56b9-8e85-3dd91f7a6a1f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186253002}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "a117df1a-bd81-5da6-88f9-198bb5436e1f" :question/math-academy-id "q-116614" :question/problem "Solve the inequality ${x}^{4}+3{x}^{3}-28{x}^{2}\\ge 0.$" :question/worked-solution "First, we factor the polynomial on the left-hand side of the inequality:\n\n$$\n\\begin{aligned}{x}^{4}+3{x}^{3}-28{x}^{2} & ={x}^{2}({x}^{2}+3x-28) \\\\  & ={x}^{2}({x}^{2}+7x-4x-28) \\\\  & ={x}^{2}(x(x+7)-4(x+7)) \\\\  & ={x}^{2}(x-4)(x+7)\\end{aligned}\n$$\n\nThen, we define the function $f(x)$ as\n\n$$\nf(x)={x}^{2}(x-4)(x+7).\n$$\n\nSo we're now solving the inequality $f(x)\\ge 0.$\n\nThe solutions to the equation $f(x)=0$ are $x=-7,$ $x=0,$ and $x=4.$ These roots divide the number line into $4$ subintervals: \n\n$$\n(-\\infty ,-7),\\,(-7,0),\\,(0,4),\\,(4,\\infty ).\n$$\n\nNow, we construct a sign table with the list of the intervals on the top and the list of factors on the left. Filling in the sign table using the usual method, we get the following result:\n\n|  | $(-\\infty ,-7)$ | $(-7,0)$ | $(0,4)$ | $(4,\\infty )$ |\n| --- | --- | --- | --- | --- |\n| $x+7$ | $-$ | $+$ | $+$ | $+$ |\n| ${x}^{2}$ | $+$ | $+$ | $+$ | $+$ |\n| $x-4$ | $-$ | $-$ | $-$ | $+$ |\n| $f(x)$ | $+$ | $-$ | $-$ | $+$ |\n\nFinally, to solve the inequality $f(x)\\ge 0,$ we look at the bottom row to determine where $f(x)$ is positive.\n\nFrom the table, we see that $f(x)$ is positive on the intervals $(-\\infty ,-7),$ and $(4,\\infty ).$\n\nTherefore, remembering that the roots are also solutions, we conclude that $f(x)\\ge 0$ for all $x\\in (-\\infty ,-7]\\cup {0}\\cup [4,\\infty ).$"}] [{:db/id #edb/ref 17592186253546 :knowledge-point/_questions [{:db/id #edb/ref 17592186054630 :knowledge-point/id #uuid "3cbddaef-3828-5454-b892-26a3c6242ddb" :knowledge-point/title "Finding All Subsets of a Given Set"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2138f1f0-b703-55d8-b999-9fe7ae4409d6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{x},{y},{z}" :db/id #edb/ref 17592186250835} {:answer/id #uuid "63d3fd5b-8e22-520b-857a-9f693151fc1d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "∅,{x},{y},{z}{x,y,z}" :db/id #edb/ref 17592186251366} {:answer/id #uuid "91aa803f-ec72-5595-a4ee-8a475037c356" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "∅,{x},{y},{z}" :db/id #edb/ref 17592186251797} {:answer/id #uuid "ece186b0-c804-57e6-911e-0d34398046fb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "∅,{x},{y},{z},{x,y},{x,z},{y,z}" :db/id #edb/ref 17592186252628} {:answer/id #uuid "f98b3b1c-049e-5191-9348-51b28559b11e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "∅,{x},{y},{z},{x,y},{x,z},{y,z},{x,y,z}" :db/id #edb/ref 17592186252739}] :answer-field/correct {:answer/id #uuid "f98b3b1c-049e-5191-9348-51b28559b11e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "∅,{x},{y},{z},{x,y},{x,z},{y,z},{x,y,z}" :db/id #edb/ref 17592186252739} :answer-field/id #uuid "94357139-827d-5170-82dc-cc21ec831009" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186253065}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "4dc7abe5-6826-51d9-82bd-d471faabcb9f" :question/math-academy-id "q-1191" :question/problem "Find all of the subsets of $A={x,y,z}.$" :question/worked-solution "To find every subset of $A,$ we list out every combination of elements within $A.$\n\nWe can use the following diagram to visualize the process:\n\n![](images/1d/1d7c11586a8fff5f63d46d936fd32c7b5fbfc33a406ddf268bfdd934fe787cdf.png)\n\nNote that we must include the empty set since it is a subset of every set.\n\nBy doing this, we get\n\n$$\n∅,{x},{y},{z},{x,y},{x,z},{y,z},{x,y,z}.\n$$"}] [{:db/id #edb/ref 17592186256652 :knowledge-point/_questions [{:db/id #edb/ref 17592186157284 :knowledge-point/id #uuid "d9a9b6de-b0dd-5b38-a32b-378d2b1d86a2" :knowledge-point/title "Finding a Difference of Sets Without a Venn Diagram"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5eb7ccc0-36a1-5f64-909f-01aeeab6d0d0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{1,2}" :db/id #edb/ref 17592186254517} {:answer/id #uuid "697eb32b-6e7b-5b33-b678-ff2fa69f0dbc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "∅" :db/id #edb/ref 17592186254618} {:answer/id #uuid "8d5866d6-d7da-5e88-9272-5ad63dc6f53e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{5,7}" :db/id #edb/ref 17592186254917} {:answer/id #uuid "c8aa2720-62a0-5ab2-9ddf-9ad1bd9e760b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{1,3}" :db/id #edb/ref 17592186255457} {:answer/id #uuid "dff3d5f1-cb40-5b5b-b514-019783505f31" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{2,4}" :db/id #edb/ref 17592186255659}] :answer-field/correct {:answer/id #uuid "dff3d5f1-cb40-5b5b-b514-019783505f31" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{2,4}" :db/id #edb/ref 17592186255659} :answer-field/id #uuid "3fdd8f7f-a798-5a0a-b0d9-7c92641e5e2d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186256038}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "969e2b29-61d2-5f25-8ec9-eef4bb6c965f" :question/math-academy-id "q-1225" :question/problem "If $X={1,3,5,7}$ and $Y={1,2,3,4},$ then $Y-X=$" :question/worked-solution "The set $Y-X$ is the set of all elements belonging to $Y$ but *not* $X.$ Note that the elements $1,3\\in X$ are also in $Y,$ so we must remove them. Therefore, we have\n\n$$\n\\begin{aligned}Y-X & ={1,2,3,4}-{1,3,5,7} \\\\  & ={2,4}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186256677 :knowledge-point/_questions [{:db/id #edb/ref 17592186157284 :knowledge-point/id #uuid "d9a9b6de-b0dd-5b38-a32b-378d2b1d86a2" :knowledge-point/title "Finding a Difference of Sets Without a Venn Diagram"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "66be3383-21b2-590e-a695-b35905404124" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{-3,1}" :db/id #edb/ref 17592186254596} {:answer/id #uuid "a6bfa38e-c657-5802-8ebb-71b0fd6f6195" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{-2,1}" :db/id #edb/ref 17592186255140} {:answer/id #uuid "b3ddca60-9daf-52c1-ade9-56ff43c5060b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{-3,5,10}" :db/id #edb/ref 17592186255255} {:answer/id #uuid "d1f315a4-dff8-5197-a912-ef6379e1e48a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{10}" :db/id #edb/ref 17592186255543} {:answer/id #uuid "eb7fabb4-dd0b-5d3e-a7ec-2c4ad0d8d467" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{-3,5}" :db/id #edb/ref 17592186255729}] :answer-field/correct {:answer/id #uuid "b3ddca60-9daf-52c1-ade9-56ff43c5060b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{-3,5,10}" :db/id #edb/ref 17592186255255} :answer-field/id #uuid "69b8c829-6ae3-5595-acab-b091ccf66bf4" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186256119}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "d25f8686-edb7-5e4c-87dd-c8e109d70794" :question/math-academy-id "q-1226" :question/problem "If $C={-3,-1,0,5,10}$ and $D={-2,-1,0,1}$, then $C∖D=$" :question/worked-solution "The set $C∖D$ is the set of all elements belonging to $C$ but *not* $D.$ Note that the elements $-1,0\\in D$ are also in $C,$ so we must remove them. Therefore, we have\n\n$$\n\\begin{aligned}C∖D & =C-D \\\\  & ={-3,-1,0,5,10}-{-2,-1,0,1} \\\\  & ={-3,5,10}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186262704 :knowledge-point/_questions [{:db/id #edb/ref 17592186124500 :knowledge-point/id #uuid "debd4ccc-de40-55a6-9236-9bf9fff0bdb1" :knowledge-point/title "Finding the Parametric Equations of a Line"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "06f568ab-a709-5bca-88dc-51b139dea190" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\begin{aligned}x=7-3t \\\\ y=-11-2t \\\\ z=4+7t\\end{aligned}" :db/id #edb/ref 17592186259941} {:answer/id #uuid "2d9646e2-26ba-5539-b5b9-a9f710e6f312" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\begin{aligned}x=7+3t \\\\ y=-11+2t \\\\ z=3-7t\\end{aligned}" :db/id #edb/ref 17592186260284} {:answer/id #uuid "a893ca4e-abe1-5c54-8923-2af72867921f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\begin{aligned}x=7+3t \\\\ y=11+2t \\\\ z=3-7t\\end{aligned}" :db/id #edb/ref 17592186261346} {:answer/id #uuid "c3323d37-5851-523c-9118-ccd184deb6cc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\begin{aligned}x=7+3t \\\\ y=11-2t \\\\ z=3+7t\\end{aligned}" :db/id #edb/ref 17592186261598} {:answer/id #uuid "e1f2d66d-9fc7-5bf5-b020-43c58962e2ac" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\begin{aligned}x=7-3t \\\\ y=-11+2t \\\\ z=3+7t\\end{aligned}" :db/id #edb/ref 17592186261866}] :answer-field/correct {:answer/id #uuid "e1f2d66d-9fc7-5bf5-b020-43c58962e2ac" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\begin{aligned}x=7-3t \\\\ y=-11+2t \\\\ z=3+7t\\end{aligned}" :db/id #edb/ref 17592186261866} :answer-field/id #uuid "4c40d077-b693-5acd-b033-066f298637d2" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186262258}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "b0a75f14-5c7e-5e9b-9922-914a01571a2f" :question/math-academy-id "q-127065" :question/problem "Find the parametric equations of the straight line that passes through $P(7,-11,3)$ and is parallel to $v=⟨-3,2,7⟩.$" :question/worked-solution "First, the vector equation of the line is \n\n$$\n\\begin{aligned}r & =p+tv \\\\ r & =[\\begin{aligned}7 \\\\ -11 \\\\ 3\\end{aligned}]+t[\\begin{aligned}-3 \\\\ 2 \\\\ 7\\end{aligned}] \\\\ [\\begin{aligned}x \\\\ y \\\\ z\\end{aligned}] & =[\\begin{aligned}7 \\\\ -11 \\\\ 3\\end{aligned}]+[\\begin{aligned}-3t \\\\ 2t \\\\ 7t\\end{aligned}] \\\\ [\\begin{aligned}x \\\\ y \\\\ z\\end{aligned}] & =[\\begin{aligned}7-3t \\\\ -11+2t \\\\ 3+7t\\end{aligned}],\\end{aligned}\n$$\n\nwhere $t\\in (-\\infty ,\\infty ).$ Therefore, the parametric equations are:\n\n$$\n{\\begin{aligned}x=7-3t \\\\ y=-11+2t \\\\ z=3+7t\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186262707 :knowledge-point/_questions [{:db/id #edb/ref 17592186119826 :knowledge-point/id #uuid "9927bff1-c245-542b-8d5d-fa7d24188b85" :knowledge-point/title "Finding the Vector Equation of a Line Given in Canonical Form"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2c070b4e-1119-5249-a2c8-e71d7f198d79" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\begin{aligned}x=10+7t \\\\ y=-4-8t \\\\ z=-1-11t\\end{aligned}" :db/id #edb/ref 17592186260267} {:answer/id #uuid "39bbb5a2-38e8-5062-9f47-f0665d949811" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\begin{aligned}x=10+7t \\\\ y=8+4t \\\\ z=-1+11t\\end{aligned}" :db/id #edb/ref 17592186260392} {:answer/id #uuid "4f4ad8f1-c7f5-593c-90a3-544567806b6e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\begin{aligned}x=10+7t \\\\ y=-8-4t \\\\ z=-1+11t\\end{aligned}" :db/id #edb/ref 17592186260552} {:answer/id #uuid "5e6cc4d6-7551-537f-b39b-35ad7b229cf6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "None of the listed" :db/id #edb/ref 17592186260686} {:answer/id #uuid "f859b58d-a78c-5318-b953-5318f93065d7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\begin{aligned}x=10+7t \\\\ y=-7-8t \\\\ z=-1+t\\end{aligned}" :db/id #edb/ref 17592186262045}] :answer-field/correct {:answer/id #uuid "4f4ad8f1-c7f5-593c-90a3-544567806b6e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\begin{aligned}x=10+7t \\\\ y=-8-4t \\\\ z=-1+11t\\end{aligned}" :db/id #edb/ref 17592186260552} :answer-field/id #uuid "9a7f67e0-6e06-5a9c-bc07-e96751790a21" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186262402}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "c2f75223-42f3-536a-93af-cb8a85108498" :question/math-academy-id "q-127078" :question/problem "Find the parametric equations of the line $\\frac{x-10}{7}=\\frac{y+8}{-4}=\\frac{z+1}{11}.$" :question/worked-solution "Remember that the Cartesian (canonical) equation of the straight line that passes through the point $P({x}_{0},{y}_{0},{z}_{0})$ and is parallel to the vector $v=⟨{v}_{x},{v}_{y},{v}_{z}⟩$, is given by\n\n$$\n\\frac{x-{x}_{0}}{{v}_{x}}=\\frac{y-{y}_{0}}{{v}_{y}}=\\frac{z-{z}_{0}}{{v}_{z}}=t,\\,t\\in (-\\infty ,\\infty ).\n$$\n\nComparing the above to our given equation\n\n$$\n\\frac{x-10}{7}=\\frac{y-(-8)}{-4}=\\frac{z-(-1)}{11},\n$$\n\nwe find that our line passes through the point $P(10,-8,-1)$ and is parallel to $v=⟨7,-4,11⟩.$ Therefore, its vector equation is\n\n$$\n\\begin{aligned}r & =p+tv \\\\ r & =[\\begin{aligned}10 \\\\ -8 \\\\ -1\\end{aligned}]+t[\\begin{aligned}7 \\\\ -4 \\\\ 11\\end{aligned}],\\,t\\in (-\\infty ,\\infty ).\\end{aligned}\n$$\n\nTherefore, the parametric equations are the following:\n\n$$\n{\\begin{aligned}x=10+7t \\\\ y=-8-4t \\\\ z=-1+11t\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186400380 :knowledge-point/_questions [{:db/id #edb/ref 17592186059769 :knowledge-point/id #uuid "d7c8f4da-c782-51e0-ac51-87a89f31860d" :knowledge-point/title "Finding the System of Equations Associated With an Augmented Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0797499e-e783-54be-aced-9b4448957305" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\begin{aligned}8x+y=6 \\\\ 4x+y=-9\\end{aligned}" :db/id #edb/ref 17592186400382} {:answer/id #uuid "c1420b28-b589-5d19-b520-a72a9e127932" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\begin{aligned}8y=6 \\\\ x+4y=-9\\end{aligned}" :db/id #edb/ref 17592186400383} {:answer/id #uuid "546cfdeb-c0d6-5ee9-82a2-3ed71da7bb60" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\begin{aligned}8y=6 \\\\ x+4y=9\\end{aligned}" :db/id #edb/ref 17592186400384} {:answer/id #uuid "abcc7b85-e3d1-5a27-98b0-3640bc343468" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\begin{aligned}x+8y=6 \\\\ 4x+y=9\\end{aligned}" :db/id #edb/ref 17592186400385} {:answer/id #uuid "e4dfbd84-21e5-577c-ab76-3eea9d55bc8f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\begin{aligned}8y=6 \\\\ 4x+y=-9\\end{aligned}" :db/id #edb/ref 17592186400386}] :answer-field/correct {:answer/id #uuid "e4dfbd84-21e5-577c-ab76-3eea9d55bc8f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\begin{aligned}8y=6 \\\\ 4x+y=-9\\end{aligned}" :db/id #edb/ref 17592186400386} :answer-field/id #uuid "1f8ada74-f43b-5b8f-a0b1-562915c30921" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186400381}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "10f47672-b02f-5835-a498-94f2d2a69a14" :question/math-academy-id "q-129129" :question/problem "What would be the system of equations for the following augmented matrix?\n\n$$\n[\\begin{aligned}0 & 8 & 6 \\\\ 4 & 1 & -9\\end{aligned}]\n$$" :question/worked-solution "The augmented matrix consists of two parts: the coefficient matrix and the column of constants.\n\nThe coefficient matrix represents the coefficients in the linear system, while the column of constants represents the constants on the right-hand sides of the equations.\n\nUsing the variables $x$ and  $y$,  the corresponding system of equations is\n\n$$\n{\\begin{aligned}0x+8y=6 \\\\ 4x+y=-9.\\end{aligned}\n$$\n\nBy simplifying, we obtain\n\n$$\n{\\begin{aligned}8y=6 \\\\ 4x+y=-9.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186400387 :knowledge-point/_questions [{:db/id #edb/ref 17592186059769 :knowledge-point/id #uuid "d7c8f4da-c782-51e0-ac51-87a89f31860d" :knowledge-point/title "Finding the System of Equations Associated With an Augmented Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7ef85a9a-8577-56f3-9309-7a0d80e1788e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\begin{aligned}-8x+4z=-\\frac{7}{4} \\\\ 5x+\\frac{2}{3}z=8 \\\\ \\frac{3}{2}x+\\frac{1}{3}y+4z=6\\end{aligned}" :db/id #edb/ref 17592186400389} {:answer/id #uuid "5972f632-c7f0-561c-8291-df7b2cf33763" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\begin{aligned}x-8y+4z=-\\frac{7}{4} \\\\ x+5y+\\frac{2}{3}z=8 \\\\ \\frac{3}{2}x+\\frac{1}{3}y+4z=6\\end{aligned}" :db/id #edb/ref 17592186400390} {:answer/id #uuid "4f19d347-ca6f-55eb-ae57-68ddc7e649ff" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\begin{aligned}-8y+4z=-\\frac{7}{4} \\\\ 5y+\\frac{2}{3}z=8 \\\\ \\frac{3}{2}x+\\frac{1}{3}y+4z=6\\end{aligned}" :db/id #edb/ref 17592186400391} {:answer/id #uuid "9d58ef96-7cf9-540d-a019-c58cd1073313" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\begin{aligned}-8x+4y=-\\frac{7}{4} \\\\ 5x+\\frac{2}{3}y=8 \\\\ \\frac{3}{2}x+\\frac{1}{3}y+4z=6\\end{aligned}" :db/id #edb/ref 17592186400392} {:answer/id #uuid "e661a476-c350-5554-8dab-dbdbf5cacf83" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\begin{aligned}-8y+4z=\\frac{7}{4} \\\\ 5y+\\frac{2}{3}z=-8 \\\\ \\frac{3}{2}x+\\frac{1}{3}y+4z=-6\\end{aligned}" :db/id #edb/ref 17592186400393}] :answer-field/correct {:answer/id #uuid "4f19d347-ca6f-55eb-ae57-68ddc7e649ff" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\begin{aligned}-8y+4z=-\\frac{7}{4} \\\\ 5y+\\frac{2}{3}z=8 \\\\ \\frac{3}{2}x+\\frac{1}{3}y+4z=6\\end{aligned}" :db/id #edb/ref 17592186400391} :answer-field/id #uuid "a53c95c7-2729-5853-ad5b-f91dbb44a5b7" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186400388}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "f0c417e1-432e-591b-889d-c01227fedeb7" :question/math-academy-id "q-129133" :question/problem "What would be the system of equations for the following augmented matrix?\n\n$$\n[\\begin{aligned}0 & -8 & 4 & -\\frac{7}{4} \\\\ 0 & 5 & \\frac{2}{3} & 8 \\\\ \\frac{3}{2} & \\frac{1}{3} & 4 & 6\\end{aligned}]\n$$" :question/worked-solution "The augmented matrix consists of two parts: the coefficient matrix and the column of constants.\n\nThe coefficient matrix represents the coefficients in the linear system, while the column of constants represents the constants on the right-hand sides of the equations.\n\nUsing the variables $x$, $y$, and $z,$ then, the corresponding system of equations is\n\n$$\n{\\begin{aligned}0x-8y+4z=-\\frac{7}{4} \\\\ 0x+5y+\\frac{2}{3}z=8 \\\\ \\frac{3}{2}x+\\frac{1}{3}y+4z=6.\\end{aligned}\n$$\n\nBy simplifying, we obtain \n\n$$\n{\\begin{aligned}-8y+4z=-\\frac{7}{4} \\\\ 5y+\\frac{2}{3}z=8 \\\\ \\frac{3}{2}x+\\frac{1}{3}y+4z=6.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186265926 :knowledge-point/_questions [{:db/id #edb/ref 17592186115233 :knowledge-point/id #uuid "fe2300a1-f31e-5a24-889a-6f45e1e8647b" :knowledge-point/title "Expressing a Matrix Product as a 2x2 System of Equations"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6e7865c0-26cb-5458-8cb7-a258df943633" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{aligned}{\\begin{aligned}10x+5y=-15 \\\\ 12x+3y=6\\end{aligned}\\end{aligned}" :db/id #edb/ref 17592186263958} {:answer/id #uuid "ba3b0d15-f891-50bd-9ed3-b118a7f0ef62" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{aligned}{\\begin{aligned}10x+25y=-15 \\\\ 12x+6y=3\\end{aligned}\\end{aligned}" :db/id #edb/ref 17592186264614} {:answer/id #uuid "c8b6d4c2-d03d-5337-bcfd-e476361be191" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{aligned}{\\begin{aligned}10x+25y=-15 \\\\ 12x+3y=6\\end{aligned}\\end{aligned}" :db/id #edb/ref 17592186264759} {:answer/id #uuid "e22492d5-d991-5958-b2dd-09b8c2ed281f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{aligned}{\\begin{aligned}2x+5y=15 \\\\ 4x+y=-6\\end{aligned}\\end{aligned}" :db/id #edb/ref 17592186264962} {:answer/id #uuid "e409a37e-e390-5a36-aca6-5945e4270bfa" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{aligned}{\\begin{aligned}2x+5y=3 \\\\ 4x+y=-2\\end{aligned}\\end{aligned}" :db/id #edb/ref 17592186264981}] :answer-field/correct {:answer/id #uuid "e409a37e-e390-5a36-aca6-5945e4270bfa" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{aligned}{\\begin{aligned}2x+5y=3 \\\\ 4x+y=-2\\end{aligned}\\end{aligned}" :db/id #edb/ref 17592186264981} :answer-field/id #uuid "0929e729-c74a-53df-b186-d608a6e127ca" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186265262}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "2e54120f-ad5a-5b0e-97ad-23133523c995" :question/math-academy-id "q-130523" :question/problem "What is the system of equations represented by\n\n$$\n[\\begin{aligned}10 & 25 \\\\ 12 & 3\\end{aligned}][\\begin{aligned}x \\\\ y\\end{aligned}]=[\\begin{aligned}15 \\\\ -6\\end{aligned}]?\n$$" :question/worked-solution "The  $2\\times 2$ matrix represents the coefficients of $x$ and $y,$ while the $2\\times 1$ column vector on the right-hand side represents the constants of the equations. So, we get the following system of equations:\n\n$$\n\\begin{aligned}{\\begin{aligned}10x+25y=15 \\\\ 12x+3y=-6\\end{aligned}\\end{aligned}\n$$\n\nSimplifying both equations in the system, we get\n\n$$\n\\begin{aligned}{\\begin{aligned}2x+5y=3 \\\\ 4x+y=-2.\\end{aligned}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186400485 :knowledge-point/_questions [{:db/id #edb/ref 17592186115233 :knowledge-point/id #uuid "fe2300a1-f31e-5a24-889a-6f45e1e8647b" :knowledge-point/title "Expressing a Matrix Product as a 2x2 System of Equations"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3cfc179d-5b69-5b59-a4e1-203c8dd4bb22" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{aligned}{\\begin{aligned}5y=9 \\\\ x=-1\\end{aligned}\\end{aligned}" :db/id #edb/ref 17592186400487} {:answer/id #uuid "9fb23989-8b95-58e0-be53-600d7e758325" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{aligned}{\\begin{aligned}5y=9 \\\\ x=1\\end{aligned}\\end{aligned}" :db/id #edb/ref 17592186400488} {:answer/id #uuid "46e0ac2a-9f8f-5e38-9016-5ba65e5cde4e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{aligned}{\\begin{aligned}5y=-9 \\\\ x=-1\\end{aligned}\\end{aligned}" :db/id #edb/ref 17592186400489} {:answer/id #uuid "8886eb42-23ce-5d40-8b2f-72b0dcb62859" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{aligned}{\\begin{aligned}x+5y=9 \\\\ x=-1\\end{aligned}\\end{aligned}" :db/id #edb/ref 17592186400490} {:answer/id #uuid "8e8b1051-a221-5a72-b1f6-4fd5bf2c673e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{aligned}{\\begin{aligned}x+5y=9 \\\\ y=-1\\end{aligned}\\end{aligned}" :db/id #edb/ref 17592186400491}] :answer-field/correct {:answer/id #uuid "3cfc179d-5b69-5b59-a4e1-203c8dd4bb22" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{aligned}{\\begin{aligned}5y=9 \\\\ x=-1\\end{aligned}\\end{aligned}" :db/id #edb/ref 17592186400487} :answer-field/id #uuid "0c4d849c-e24c-5150-9286-220ece393a3b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186400486}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "a1162f6f-3b06-5edc-926f-fe3ac4ca244f" :question/math-academy-id "q-130528" :question/problem "What is the system of equations represented by\n\n$$\n[\\begin{aligned}0 & 5 \\\\ 1 & 0\\end{aligned}][\\begin{aligned}x \\\\ y\\end{aligned}]=[\\begin{aligned}9 \\\\ -1\\end{aligned}]?\n$$" :question/worked-solution "The  $2\\times 2$ matrix represents the coefficients of $x$ and $y,$ while the $2\\times 1$ column vector on the right-hand side represents the constants of the equations. So, we get the following system of equations:\n\n$$\n\\begin{aligned}{\\begin{aligned}0x+5y=9 \\\\ x+0y=-1\\end{aligned}\\end{aligned}\n$$\n\nSimplifying both equations in the system, we get\n\n$$\n\\begin{aligned}{\\begin{aligned}5y=9 \\\\ x=-1.\\end{aligned}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186055047 :knowledge-point/_questions [{:db/id #edb/ref 17592186054831 :knowledge-point/id #uuid "3f986c29-111e-5cb3-8104-62ab734f1c47" :knowledge-point/title "Identifying Elements of an Indexed Fam