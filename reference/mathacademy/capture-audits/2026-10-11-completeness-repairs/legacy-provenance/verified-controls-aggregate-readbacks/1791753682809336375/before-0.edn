2(0)-1,-0,1,0+2} \\\\  & ={-1,0,1,2}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186284713 :knowledge-point/_questions [{:db/id #edb/ref 17592186054832 :knowledge-point/id #uuid "957a2f61-61b1-5675-ba84-5348a47af986" :knowledge-point/title "Finding Unions and Intersections of Finite Families of Indexed Sets"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0d72e51e-f963-53d4-96b3-b644ba7e625e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{0,1,2}" :db/id #edb/ref 17592186281811} {:answer/id #uuid "520277c3-872d-57a0-8359-bec38e9b763a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "∅" :db/id #edb/ref 17592186282395} {:answer/id #uuid "b35148f6-fa0e-56e6-91ff-9e1c4ee206a5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[0,1]" :db/id #edb/ref 17592186283245} {:answer/id #uuid "de7c9f2f-75bd-53f9-87a1-21593710a660" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(0,2)" :db/id #edb/ref 17592186283632} {:answer/id #uuid "fa9971aa-094d-544b-b4a0-d838f3c06fef" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[0,2)" :db/id #edb/ref 17592186283880}] :answer-field/correct {:answer/id #uuid "fa9971aa-094d-544b-b4a0-d838f3c06fef" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[0,2)" :db/id #edb/ref 17592186283880} :answer-field/id #uuid "84726de3-f622-5674-a9ec-80a1beadc4b2" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186284157}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "27878d76-ab4b-5705-b5cf-73536ef6aabb" :question/math-academy-id "q-174434" :question/problem "Find ${⋃}_{i\\in I}{S}_{i}$, given that $I={0,1,2},$ and\n\n$$\n\\begin{aligned}{S}_{0}={0},\\,{S}_{1}=(0,1),\\,{S}_{2}=(0,2).\\end{aligned}\n$$" :question/worked-solution "The union of a family of indexed sets is the set containing all elements belonging to *at least one* set in the indexed family:\n\n$$\n{⋃}_{i\\in I}{A}_{i}={x\\in U\\,:\\,x\\in {A}_{i}\\,\\,\\text{for at least one }{A}_{i},\\,\\,i\\in I}\n$$\n\nwhere $U$ is a universal set.\n\nTherefore, in our case, we have \n\n$$\n\\begin{aligned}{⋃}_{i\\in I}{S}_{i} & ={S}_{0}\\cup {S}_{1}\\cup {S}_{2} \\\\  & ={0}\\,\\cup \\,(0,1)\\,\\cup \\,(0,2) \\\\  & =[0,2).\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186284714 :knowledge-point/_questions [{:db/id #edb/ref 17592186054832 :knowledge-point/id #uuid "957a2f61-61b1-5675-ba84-5348a47af986" :knowledge-point/title "Finding Unions and Intersections of Finite Families of Indexed Sets"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0b29817c-fe82-5260-acab-1ea51a72ea60" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[5,8)" :db/id #edb/ref 17592186281793} {:answer/id #uuid "2558b356-25ee-5a75-a6a2-81f9fbcc0d3f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(4,7]" :db/id #edb/ref 17592186282015} {:answer/id #uuid "273333dc-0d40-54de-a421-4b0a52439971" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[5,7]" :db/id #edb/ref 17592186282027} {:answer/id #uuid "2ed73e75-1378-555d-b816-759e2219d709" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[5,7)" :db/id #edb/ref 17592186282105} {:answer/id #uuid "b2bd6a9c-525a-537f-ac0a-8467014d0de0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{5,6,7,8}" :db/id #edb/ref 17592186283241}] :answer-field/correct {:answer/id #uuid "0b29817c-fe82-5260-acab-1ea51a72ea60" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[5,8)" :db/id #edb/ref 17592186281793} :answer-field/id #uuid "d9436f4f-51c3-5193-854a-41d58df1ef65" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186284313}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "8c85214a-dabe-59ba-93a3-34bf866976a6" :question/math-academy-id "q-174435" :question/problem "Find ${⋃}_{i\\in I}{S}_{i}$, given that $I={5,6,7},$ and\n${S}_{i}=[i,\\,i+1).$" :question/worked-solution "The union of a family of indexed sets is the set containing all elements belonging to *at least one* set in the indexed family:\n\n$$\n{⋃}_{i\\in I}{A}_{i}={x\\in U\\,:\\,x\\in {A}_{i}\\,\\,\\text{for at least one }{A}_{i},\\,\\,i\\in I}\n$$\n\nwhere $U$ is a universal set.\n\nTherefore, in our case, we have \n\n$$\n\\begin{aligned}{⋃}_{i\\in I}{S}_{i} & ={S}_{5}\\cup {S}_{6}\\cup {S}_{7} \\\\  & =[5,6)\\,\\cup \\,[6,7)\\,\\cup \\,[7,8) \\\\  & =[5,8).\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186284717 :knowledge-point/_questions [{:db/id #edb/ref 17592186054833 :knowledge-point/id #uuid "c1e93acb-6c0b-5263-9df9-9dcc00680845" :knowledge-point/title "Finding Unions and Intersections of (Countably) Infinite Families of Indexed Sets"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1e1d220f-05ab-5df1-b27a-cad738b2f95f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{i}" :db/id #edb/ref 17592186281957} {:answer/id #uuid "9087b344-e5ec-50f6-ae85-c0dd719c907c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{0}" :db/id #edb/ref 17592186282938} {:answer/id #uuid "cdcbee20-33b5-577d-8511-8ac6e236c738" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{0,\\,1}" :db/id #edb/ref 17592186283488} {:answer/id #uuid "d6dca9a7-091a-512d-b8bc-14fa19aaf80e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "∅" :db/id #edb/ref 17592186283560} {:answer/id #uuid "e7c5bdda-58b8-5b95-a550-b87c858b7f84" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "Z" :db/id #edb/ref 17592186283707}] :answer-field/correct {:answer/id #uuid "d6dca9a7-091a-512d-b8bc-14fa19aaf80e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "∅" :db/id #edb/ref 17592186283560} :answer-field/id #uuid "3f2320a1-6f03-5b22-83a3-274275a86468" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186284037}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "f5b989ff-c36c-5cd1-a2e7-3a722d88ff08" :question/math-academy-id "q-174447" :question/problem "Let $I=Z$ and ${X}_{i}={i-1,\\,i},$ then ${⋂}_{i\\in I}{X}_{i}=$" :question/worked-solution "The intersection of a family of indexed sets ${{A}_{i}}_{i\\in I}$ contains all elements that belong to *all* sets in our family:\n\n$$\n{⋂}_{i\\in I}{A}_{i}={x\\in U\\,:\\,x\\in {A}_{i}\\,\\,\\text{for all }{A}_{i},\\,\\,i\\in I}\n$$\n\nwhere $U$ is a universal set.\n\nLet's now write down a few instances of our indexed sets:\n\n- if $i=-1,$ we have ${X}_{-1}={-2,-1}$\n\n- if $i=0,$ we have ${X}_{0}={-1,0}$\n\n- if $i=1,$ we have ${X}_{1}={0,1}$\n\nand so on. \n\nNotice that there is no element that belongs to all the sets. Therefore,\n\n$$\n\\begin{aligned}{⋂}_{i\\in I}{X}_{i}=∅.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186284719 :knowledge-point/_questions [{:db/id #edb/ref 17592186054833 :knowledge-point/id #uuid "c1e93acb-6c0b-5263-9df9-9dcc00680845" :knowledge-point/title "Finding Unions and Intersections of (Countably) Infinite Families of Indexed Sets"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "404661ce-da4a-56a7-af09-9468baa04dee" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{0}" :db/id #edb/ref 17592186282242} {:answer/id #uuid "5fb3c0c4-5eba-590b-88b3-a96df51c2ff2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "N" :db/id #edb/ref 17592186282497} {:answer/id #uuid "65072086-3678-56be-b5c5-7b82b9a55cda" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "Z" :db/id #edb/ref 17592186282555} {:answer/id #uuid "8249664b-a5d6-5605-85c1-f5a35d97e74e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{-i,0,i}" :db/id #edb/ref 17592186282809} {:answer/id #uuid "aa5f9bc4-0c3f-58f8-b896-dcd30ba8070b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "∅" :db/id #edb/ref 17592186283165}] :answer-field/correct {:answer/id #uuid "65072086-3678-56be-b5c5-7b82b9a55cda" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "Z" :db/id #edb/ref 17592186282555} :answer-field/id #uuid "996fba3c-efa9-5bda-b43d-0e42e45a0f5e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186284197}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "2fd30642-b32d-59fc-bea9-4c1cd84ef2fd" :question/math-academy-id "q-174450" :question/problem "Let $I=N$ and ${X}_{i}={-i,\\,0,\\,i},$ then ${⋃}_{i\\in I}{X}_{i}=$" :question/worked-solution "The union of a family of indexed sets is the set containing all elements belonging to *at least one* set in the indexed family:\n\n$$\n{⋃}_{i\\in I}{A}_{i}={x\\in U\\,:\\,x\\in {A}_{i}\\,\\,\\text{for at least one }{A}_{i},\\,\\,i\\in I}\n$$\n\nwhere $U$ is a universal set.\n\nLet's now write down a few instances of our indexed sets:\n\n- if $i=1,$ we have ${X}_{1}={-1,0,1}$\n\n- if $i=2,$ we have ${X}_{2}={-2,0,2}$\n\n- if $i=3,$ we have ${X}_{3}={-3,0,3}$\n\nand so on. \n\nNotice that all the integers belong to one of the sets.\n\nTherefore, \n\n$$\n\\begin{aligned}{⋃}_{i\\in I}{X}_{i}=Z.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186401928 :knowledge-point/_questions [{:db/id #edb/ref 17592186110652 :knowledge-point/id #uuid "a258070e-5c3c-595e-81d6-3e0f9b9a5daf" :knowledge-point/title "Working With Systems Containing Mixed Inequalities"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c28cb971-d849-577e-9682-a8890d4ae773" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\begin{aligned}y\\le x+2 \\\\ y>-x+1\\end{aligned}" :db/id #edb/ref 17592186401930} {:answer/id #uuid "d4c91422-9ef9-5a21-a3cd-6168971db223" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\begin{aligned}y\\ge x+2 \\\\ y\\ge -x+1\\end{aligned}" :db/id #edb/ref 17592186401931} {:answer/id #uuid "928ea34b-f94c-5914-8894-15d7edbe4d92" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\begin{aligned}y>x+2 \\\\ y\\ge -x+1\\end{aligned}" :db/id #edb/ref 17592186401932} {:answer/id #uuid "129beb51-d7c5-5a45-86b1-53f54c6e7926" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\begin{aligned}y\\ge x+2 \\\\ y<-x+1\\end{aligned}" :db/id #edb/ref 17592186401933} {:answer/id #uuid "1f5ea53c-6d9f-56de-99b0-c8f54f45ac23" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\begin{aligned}y\\le x+2 \\\\ y<-x+1\\end{aligned}" :db/id #edb/ref 17592186401934}] :answer-field/correct {:answer/id #uuid "928ea34b-f94c-5914-8894-15d7edbe4d92" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\begin{aligned}y>x+2 \\\\ y\\ge -x+1\\end{aligned}" :db/id #edb/ref 17592186401932} :answer-field/id #uuid "210acf01-110f-53da-bf3c-8725abe1a7d8" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186401929}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "5cb8229e-2a6a-582b-a6c3-627b88cf6816" :question/math-academy-id "q-29384" :question/problem "![](images/a7/a740aafbb9f74e2681506d3027f848fa92e7eea2bac3e08ccaf3fc7e0acf8fa1.png)\n\nWhich of the following systems of inequalities defines the shaded region shown in the graph above?" :question/worked-solution "Consider the line $y=x+2.$ Since the line is dashed, the inequality is strict. Also, since the shaded region lies *above* the line, the inequality is a \"greater than\" inequality. So the corresponding inequality is\n\n$$\ny>x+2.\n$$\n\n    \n\nNow consider the line $y=-x+1.$ Since the line is solid, the inequality is an \"or equal to\" inequality. Also, since the shaded region lies *above* the line, the inequality is a \"greater than\" inequality. So the corresponding inequality is\n\n$$\ny\\ge -x+1.\n$$\n\nTherefore, the system of inequalities that defines the shaded region is\n\n$$\n{\\begin{aligned}y>x+2 \\\\ y\\ge -x+1.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186302397 :knowledge-point/_questions [{:db/id #edb/ref 17592186124500 :knowledge-point/id #uuid "debd4ccc-de40-55a6-9236-9bf9fff0bdb1" :knowledge-point/title "Finding the Parametric Equations of a Line"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2137033b-a3c6-5399-8de1-6c62af391ee8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\begin{aligned}x=-1+3t \\\\ y=3+t \\\\ z=2+3t\\end{aligned}" :db/id #edb/ref 17592186300121} {:answer/id #uuid "76e9f9be-afee-5c0d-937c-0f3dad104f06" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\begin{aligned}x=3-t \\\\ y=1+3t \\\\ z=3+2t\\end{aligned}" :db/id #edb/ref 17592186300549} {:answer/id #uuid "7fb1958a-34cd-52c1-9c83-11d1786cc343" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\begin{aligned}x=-t \\\\ y=3t \\\\ z=2t\\end{aligned}" :db/id #edb/ref 17592186300596} {:answer/id #uuid "c9ad2a30-8c8a-5d10-9706-7fa4ca3ab143" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\begin{aligned}x=3t \\\\ y=t \\\\ z=3t\\end{aligned}" :db/id #edb/ref 17592186300966} {:answer/id #uuid "e6bddf9a-a799-5c8b-8fce-35dc858cdbc8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\begin{aligned}x=2-t \\\\ y=4+3t \\\\ z=5+2t\\end{aligned}" :db/id #edb/ref 17592186301102}] :answer-field/correct {:answer/id #uuid "2137033b-a3c6-5399-8de1-6c62af391ee8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\begin{aligned}x=-1+3t \\\\ y=3+t \\\\ z=2+3t\\end{aligned}" :db/id #edb/ref 17592186300121} :answer-field/id #uuid "371e7130-c050-59b2-8c27-7a7c79cf3390" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186301402}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "00c48028-299a-590c-8308-e04090d60774" :question/math-academy-id "q-32817" :question/problem "![](images/1f/1ffc0945ea74b1bd467a0b9935ee28b88be004c18b11492d67ecdfec56e1bb09.png)\n\nFind the parametric equations of the line shown in the figure above." :question/worked-solution "We know that the line passes through the points $P(-1,3,2)$ and $Q(2,4,5).$ Now, we need to find a direction vector that is parallel to the given line. We can use the vector $\\overset{\\to }{PQ}$ as follows:\n\n$$\n\\begin{aligned}v & =\\overset{\\to }{PQ} \\\\  & =\\overset{\\to }{OQ}-\\overset{\\to }{OP} \\\\  & =[\\begin{aligned}2 \\\\ 4 \\\\ 5\\end{aligned}]-[\\begin{aligned}-1 \\\\ 3 \\\\ 2\\end{aligned}] \\\\  & =[\\begin{aligned}3 \\\\ 1 \\\\ 3\\end{aligned}]\\end{aligned}\n$$\n\nSo, the vector equation of the line is\n\n$$\n\\begin{aligned}r & =p+tv \\\\ r & =[\\begin{aligned}-1 \\\\ 3 \\\\ 2\\end{aligned}]+t[\\begin{aligned}3 \\\\ 1 \\\\ 3\\end{aligned}] \\\\ [\\begin{aligned}x \\\\ y \\\\ z\\end{aligned}] & =[\\begin{aligned}-1 \\\\ 3 \\\\ 2\\end{aligned}]+[\\begin{aligned}3t \\\\ t \\\\ 3t\\end{aligned}] \\\\ [\\begin{aligned}x \\\\ y \\\\ z\\end{aligned}] & =[\\begin{aligned}-1+3t \\\\ 3+t \\\\ 2+3t\\end{aligned}],\\end{aligned}\n$$\n\nwhere $t\\in (-\\infty ,\\infty ).$ And finally, the parametric equations:\n\n$$\n{\\begin{aligned}x=-1+3t \\\\ y=3+t \\\\ z=2+3t\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186314972 :knowledge-point/_questions [{:db/id #edb/ref 17592186119808 :knowledge-point/id #uuid "aaefbc53-9df9-54a0-a969-66e062553d5c" :knowledge-point/title "Determining Whether a Vector Lies in the Span of Given Vectors"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "077cc4da-3c12-5749-87e3-9136fa56ff18" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186312025} {:answer/id #uuid "39d686df-f396-5c82-92b8-3b075c274d61" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186312445} {:answer/id #uuid "4dd5ec6b-997e-5c4c-82cd-f74e85dcbdf1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186312607} {:answer/id #uuid "7578cf04-a90c-5b5d-ac09-511fd3e57a8d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186312909} {:answer/id #uuid "eced6632-dc68-59a9-a39d-d5b16448d6d4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "b\\notin \\text{Span}{{a}_{1},{a}_{2}}" :db/id #edb/ref 17592186313868}] :answer-field/correct {:answer/id #uuid "7578cf04-a90c-5b5d-ac09-511fd3e57a8d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186312909} :answer-field/id #uuid "901fd7a3-f614-5740-8413-9326f82935f3" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186314396}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "dffa9b37-7313-5190-ae5f-372cf9f5aaea" :question/math-academy-id "q-34058" :question/problem "The vectors ${a}_{1}$, ${a}_{2}$, and $b$ are given below. Determine if $b\\in \\text{Span}{{a}_{1},{a}_{2}}.$ In the affirmative case, find the value of ${x}_{1}\\cdot {x}_{2}$ from the decomposition $b={x}_{1}{a}_{1}+{x}_{2}{a}_{2}.$\n\n$$\n{a}_{1}=[\\begin{aligned}1 \\\\ 0 \\\\ 2\\end{aligned}],\\,{a}_{2}=[\\begin{aligned}-1 \\\\ 1 \\\\ 3\\end{aligned}],\\,b=[\\begin{aligned}1 \\\\ 1 \\\\ 7\\end{aligned}]\n$$" :question/worked-solution "We know that $b\\in \\text{Span}{{a}_{1},{a}_{2}}$ if there exist ${x}_{1}$ and ${x}_{2}$ such that \n\n$$\n\\begin{aligned}{x}_{1}{a}_{1}+{x}_{2}{a}_{2} & =b \\\\ {x}_{1}[\\begin{aligned}1 \\\\ 0 \\\\ 2\\end{aligned}]+{x}_{2}[\\begin{aligned}-1 \\\\ 1 \\\\ 3\\end{aligned}] & =[\\begin{aligned}1 \\\\ 1 \\\\ 7\\end{aligned}].\\end{aligned}\n$$\n\nSo, we have the following system of equations:\n\n$$\n{\\begin{aligned}{x}_{1}-{x}_{2}=1 \\\\ {x}_{2}=1 \\\\ 2{x}_{1}+3{x}_{2}=7\\end{aligned}\n$$\n\nTo solve the system above, we set up and row reduce an augmented matrix:\n\n$$\n\\begin{aligned} & [\\begin{aligned}1 & -1 & 1 \\\\ 0 & 1 & 1 \\\\ 2 & 3 & 7\\end{aligned}] & {R}_{3} & :={R}_{3}-2{R}_{1} \\\\  & ∼[\\begin{aligned}1 & -1 & 1 \\\\ 0 & 1 & 1 \\\\ 0 & 5 & 5\\end{aligned}] & {R}_{3} & :={R}_{3}-5{R}_{2} \\\\  & ∼[\\begin{aligned}1 & -1 & 1 \\\\ 0 & 1 & 1 \\\\ 0 & 0 & 0\\end{aligned}]\\end{aligned}\n$$\n\nNow, we have the system\n\n$$\n{\\begin{aligned}{x}_{1}-{x}_{2}=1 \\\\ {x}_{2}=1 \\\\ 0=0.\\end{aligned}\n$$\n\nFrom the second equation, we get ${x}_{2}=1.$ Substituting into the first equation gives \n\n$$\n{x}_{1}-1=1\\,⟹\\,{x}_{1}=2.\n$$\n\nSince the system has a solution, we can conclude that $b\\in \\text{Span}{{a}_{1},{a}_{2}}.$\n\nMoreover, there is exactly one solution, so we have exactly one way to write $b$ as a linear combination of ${a}_{1}$ and ${a}_{2}:$\n\n$$\n\\begin{aligned}2{a}_{1}+{a}_{2} & =b \\\\ 2\\cdot [\\begin{aligned}1 \\\\ 0 \\\\ 2\\end{aligned}]+[\\begin{aligned}-1 \\\\ 1 \\\\ 3\\end{aligned}] & =[\\begin{aligned}1 \\\\ 1 \\\\ 7\\end{aligned}]\\end{aligned}\n$$\n\nFinally, ${x}_{1}\\cdot {x}_{2}=2\\cdot 1=2.$"}] [{:db/id #edb/ref 17592186317213 :knowledge-point/_questions [{:db/id #edb/ref 17592186119808 :knowledge-point/id #uuid "aaefbc53-9df9-54a0-a969-66e062553d5c" :knowledge-point/title "Determining Whether a Vector Lies in the Span of Given Vectors"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1d12c5f6-3b92-5441-a0fc-3952c1a70749" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-8" :db/id #edb/ref 17592186315285} {:answer/id #uuid "2be071fa-e50f-5e15-af2e-800d12bec8db" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "16" :db/id #edb/ref 17592186315374} {:answer/id #uuid "40c87c4f-e4ad-5573-b56b-bbf8371657d9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-16" :db/id #edb/ref 17592186315491} {:answer/id #uuid "719e49b9-6453-5c6f-ae8b-fb5f2080b954" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186315762} {:answer/id #uuid "a449e927-6b10-5f40-a19c-fccc1dc264eb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "b\\notin \\text{Span}{{a}_{1},{a}_{2},{a}_{3}}" :db/id #edb/ref 17592186316048}] :answer-field/correct {:answer/id #uuid "40c87c4f-e4ad-5573-b56b-bbf8371657d9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-16" :db/id #edb/ref 17592186315491} :answer-field/id #uuid "8429c92b-0897-5b2d-8856-66b5640c1f28" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186316855}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "54dedc31-eea3-5db1-a0e4-025cee199163" :question/math-academy-id "q-34218" :question/problem "The vectors ${a}_{1}$, ${a}_{2}$, ${a}_{3}$, and $b$ are given below. Determine if $b\\in \\text{Span}{{a}_{1},{a}_{2},{a}_{3}}.$ In the affirmative case, find the value of ${x}_{1}\\cdot {x}_{2}\\cdot {x}_{3}$ from the decomposition $b={x}_{1}{a}_{1}+{x}_{2}{a}_{2}+{x}_{3}{a}_{3}.$\n\n$$\n{a}_{1}=[\\begin{aligned}1 \\\\ -3 \\\\ 0\\end{aligned}],\\,{a}_{2}=[\\begin{aligned}0 \\\\ 1 \\\\ -3\\end{aligned}],\\,{a}_{3}=[\\begin{aligned}-2 \\\\ 6 \\\\ 1\\end{aligned}],\\,b=[\\begin{aligned}6 \\\\ -14 \\\\ -14\\end{aligned}]\n$$" :question/worked-solution "We know that $b\\in \\text{Span}{{a}_{1},{a}_{2},{a}_{3}}$ if there exist ${x}_{1}$, ${x}_{2}$ and ${x}_{3}$ such that \n\n$$\n\\begin{aligned}{x}_{1}{a}_{1}+{x}_{2}{a}_{2}+{x}_{3}{a}_{3} & =b \\\\ {x}_{1}[\\begin{aligned}1 \\\\ -3 \\\\ 0\\end{aligned}]+{x}_{2}[\\begin{aligned}0 \\\\ 1 \\\\ -3\\end{aligned}]+{x}_{3}[\\begin{aligned}-2 \\\\ 6 \\\\ 1\\end{aligned}] & =[\\begin{aligned}6 \\\\ -14 \\\\ -14\\end{aligned}]\\end{aligned}\n$$\n\nSo, we have the following system of equations:\n\n$$\n{\\begin{aligned}{x}_{1}-2{x}_{3}=6 \\\\ -3{x}_{1}+{x}_{2}+6{x}_{3}=-14 \\\\ -3{x}_{2}+{x}_{3}=-14\\end{aligned}\n$$\n\nTo solve the system above, we set up and row reduce an augmented matrix:\n\n$$\n\\begin{aligned} & [\\begin{aligned}1 & 0 & -2 & 6 \\\\ -3 & 1 & 6 & -14 \\\\ 0 & -3 & 1 & -14\\end{aligned}] & {R}_{2} & :={R}_{2}+3{R}_{1} \\\\  & ∼[\\begin{aligned}1 & 0 & -2 & 6 \\\\ 0 & 1 & 0 & 4 \\\\ 0 & -3 & 1 & -14\\end{aligned}] & {R}_{3} & :={R}_{3}+3{R}_{2} \\\\  & ∼[\\begin{aligned}1 & 0 & -2 & 6 \\\\ 0 & 1 & 0 & 4 \\\\ 0 & 0 & 1 & -2\\end{aligned}]\\end{aligned}\n$$\n\nNow, we have the system\n\n$$\n{\\begin{aligned}{x}_{1}-2{x}_{3}=6 \\\\ {x}_{2}=4 \\\\ {x}_{3}=-2.\\end{aligned}\n$$\n\nFrom the third equation, we get ${x}_{3}=-2.$ Substituting into the first equation gives \n\n$$\n{x}_{1}-2(-2)=6\\,⟹\\,{x}_{1}=2.\n$$\n\nSince the system has a solution, we can conclude that $b\\in \\text{Span}{{a}_{1},{a}_{2},{a}_{3}}.$\n\nMoreover, there is exactly one solution, so we have exactly one way to write $b$ as a linear combination of ${a}_{1}$, ${a}_{2}$ and ${a}_{3}:$\n\n$$\n\\begin{aligned}2{a}_{1}+4{a}_{2}+(-2){a}_{3} & =b \\\\ 2\\cdot [\\begin{aligned}1 \\\\ -3 \\\\ 0\\end{aligned}]+4\\cdot [\\begin{aligned}0 \\\\ 1 \\\\ -3\\end{aligned}]+(-2)\\cdot [\\begin{aligned}-2 \\\\ 6 \\\\ 1\\end{aligned}] & =[\\begin{aligned}6 \\\\ -14 \\\\ -14\\end{aligned}]\\end{aligned}\n$$\n\nFinally, ${x}_{1}\\cdot {x}_{2}\\cdot {x}_{3}=2\\cdot 4\\cdot (-2)=-16.$"}] [{:db/id #edb/ref 17592186323896 :knowledge-point/_questions [{:db/id #edb/ref 17592186054629 :knowledge-point/id #uuid "b0e5efaa-e624-5045-abdb-cdf8d32ad6cb" :knowledge-point/title "Identifying Subsets of a Given Set"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "109ac02d-edd3-5542-85a6-fe4488ed982c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "B={-1,0,1,2,4,6}" :db/id #edb/ref 17592186321279} {:answer/id #uuid "146cebbe-47c4-5f92-bb21-db3162be426f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "B={1,3,5,7,9}" :db/id #edb/ref 17592186321313} {:answer/id #uuid "23131580-17fd-59eb-a6fc-22211fca432b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "B={2,6,12,14,32}" :db/id #edb/ref 17592186321414} {:answer/id #uuid "ee78ef16-f1f1-5ece-b981-30dd16ac8798" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "B={0,1,2,4,6,8}" :db/id #edb/ref 17592186323026} {:answer/id #uuid "f72afeec-f234-514d-b514-5e3bea13abb5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "B={2,4,6,7}" :db/id #edb/ref 17592186323087}] :answer-field/correct {:answer/id #uuid "23131580-17fd-59eb-a6fc-22211fca432b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "B={2,6,12,14,32}" :db/id #edb/ref 17592186321414} :answer-field/id #uuid "2ced3dc9-18a6-5c14-baa5-67b07af90bd7" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186323263}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "f34c2a60-9466-5441-87ed-4e11996631ca" :question/math-academy-id "q-37265" :question/problem "Which of the following sets is a subset of $A={2n∣n\\in N}?$" :question/worked-solution "First, we must find the elements of the set $A.$ The elements of the set \n$A$ are all the natural even numbers.\n\nSo, we have\n\n$$\nA={2,4,6,8,…}.\n$$\n\nNow, a subset of $A$ is a set whose elements are also elements of the set $A.$\n\nIn our case, $B={2,6,12,14,32}$ is a subset of $A.$\n\nIn the rest of the options, the set $B$ has elements that are not in $A,$ meaning that it is not a subset of $A.$"}] [{:db/id #edb/ref 17592186403037 :knowledge-point/_questions [{:db/id #edb/ref 17592186110658 :knowledge-point/id #uuid "0cd1bb61-2770-5096-83d6-d1e4a7189e9a" :knowledge-point/title "Working With Systems Containing \"Or Equal To\" Inequalities"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c6c66b28-305f-5672-966e-0edbadb3f68b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\begin{aligned}y\\ge 3x+1 \\\\ y\\ge 2\\end{aligned}" :db/id #edb/ref 17592186403039} {:answer/id #uuid "22d57f63-0dab-54f1-a015-47cd4fa3ad27" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\begin{aligned}y\\ge 3x+1 \\\\ y\\le 2\\end{aligned}" :db/id #edb/ref 17592186403040} {:answer/id #uuid "c282cd0f-a1b4-575a-bd8d-6fbc31f00808" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\begin{aligned}y\\ge 3x+1 \\\\ y<2\\end{aligned}" :db/id #edb/ref 17592186403041} {:answer/id #uuid "dcc09857-90e2-5fa6-8e10-a5896664af24" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\begin{aligned}y\\le 3x+1 \\\\ y\\le 2\\end{aligned}" :db/id #edb/ref 17592186403042} {:answer/id #uuid "076f9837-2705-5d0a-9c57-71c316b16391" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\begin{aligned}y\\le 3x+1 \\\\ y\\ge 2\\end{aligned}" :db/id #edb/ref 17592186403043}] :answer-field/correct {:answer/id #uuid "c6c66b28-305f-5672-966e-0edbadb3f68b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\begin{aligned}y\\ge 3x+1 \\\\ y\\ge 2\\end{aligned}" :db/id #edb/ref 17592186403039} :answer-field/id #uuid "6391aa03-c66c-510d-8de3-714552c986fb" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186403038}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "9187138f-ae2f-5a56-952a-6135b67724bf" :question/math-academy-id "q-52413" :question/problem "![](images/75/75a7f3bfae55a97fbc0c05e2e0356d21de6ceabcc82ac3e1c965838a636f5ecc.png)\n\nWhich of the following systems of inequalities defines the shaded region shown above?" :question/worked-solution "Consider the line $y=3x+1.$ Since the line is solid, the inequality is an \"or equal to\" inequality. Also, since the shaded region lies *above* the line, the inequality is a \"greater than\" inequality. So the corresponding inequality is\n\n$$\ny\\ge 3x+1.\n$$\n\n    \n\nNow consider the line $y=2.$ Since the line is solid, the inequality is an \"or equal to\" inequality. Also, since the shaded region lies *above* the line, the inequality is a \"greater than\" inequality. So the corresponding inequality is\n\n$$\ny\\ge 2.\n$$\n\nTherefore, the system of inequalities that defines the shaded region is\n\n$$\n{\\begin{aligned}y\\ge 3x+1 \\\\ y\\ge 2.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186403044 :knowledge-point/_questions [{:db/id #edb/ref 17592186110651 :knowledge-point/id #uuid "fbd52408-5f2f-58c9-9a88-bd992fe8752c" :knowledge-point/title "Working With Systems Containing Strict Inequalities"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "599f73e4-3ca9-5922-b9a5-51c11d904876" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\begin{aligned}y<2x+6 \\\\ y>5\\end{aligned}" :db/id #edb/ref 17592186403046} {:answer/id #uuid "88ca59a7-54b0-51b6-8e85-e1665efeaa4a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\begin{aligned}y<2x+6 \\\\ y<5\\end{aligned}" :db/id #edb/ref 17592186403047} {:answer/id #uuid "cc2ec7bb-7f05-5512-a12e-01138a6573c3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\begin{aligned}y\\le 2x+6 \\\\ y\\le 5\\end{aligned}" :db/id #edb/ref 17592186403048} {:answer/id #uuid "17af44de-3d26-5293-8028-23cd473e2e0b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\begin{aligned}y>2x+6 \\\\ y<5\\end{aligned}" :db/id #edb/ref 17592186403049} {:answer/id #uuid "b7ebc338-a51c-54a2-9008-89b303d45e94" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\begin{aligned}y>2x+6 \\\\ y>5\\end{aligned}" :db/id #edb/ref 17592186403050}] :answer-field/correct {:answer/id #uuid "88ca59a7-54b0-51b6-8e85-e1665efeaa4a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\begin{aligned}y<2x+6 \\\\ y<5\\end{aligned}" :db/id #edb/ref 17592186403047} :answer-field/id #uuid "057029ec-da64-5909-af01-3dd51581c107" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186403045}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "d48a81ca-ca4e-5354-bd11-f73315ba7d7f" :question/math-academy-id "q-52461" :question/problem "![](images/ba/ba01cf5268f2bd62835c925a5eb793c0d98663948899c9e9aba2eeacd37ff30a.png)\n\nWhich of the following systems of inequalities defines the shaded region shown above?" :question/worked-solution "Consider the line $y=2x+6.$ Since the line is dashed, the inequality is strict. Also, since the shaded region lies *below* the line, the inequality is a \"less than\" inequality. So the corresponding inequality is\n\n$$\ny<2x+6.\n$$\n\n    \n\nNow consider the line $y=5.$ Since the line is dashed, the inequality is strict. Also, since the shaded region lies *below* the line, the inequality is a \"less than\" inequality. So the corresponding inequality is\n\n$$\ny<5.\n$$\n\nTherefore, the system of inequalities that defines the shaded region is\n\n$$\n{\\begin{aligned}y<2x+6 \\\\ y<5.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186172596 :knowledge-point/_questions [{:db/id #edb/ref 17592186171957 :knowledge-point/id #uuid "9c976b6a-4523-51e1-a243-27aa8937db25" :knowledge-point/title "Expressing the Relationship Between the Rows of Pascal's Triangle in Terms of Binomial Coefficients"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0764c515-8bca-5fd4-91d0-405b62507b8d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(\\frac{2}{1})" :db/id #edb/ref 17592186333061} {:answer/id #uuid "5e57c96a-894f-5a42-9888-8daa5fefe00b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(\\frac{1}{1})" :db/id #edb/ref 17592186333852} {:answer/id #uuid "c3e20e63-39e0-548b-908a-12e537bb3708" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(\\frac{1}{0})" :db/id #edb/ref 17592186334688} {:answer/id #uuid "e959860f-3de8-5a3c-9c3a-cf7999bb9d04" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(\\frac{2}{0})" :db/id #edb/ref 17592186335029} {:answer/id #uuid "f192f51a-52e9-5d55-a6f8-773a74eea617" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(\\frac{2}{2})" :db/id #edb/ref 17592186335106}] :answer-field/correct {:answer/id #uuid "e959860f-3de8-5a3c-9c3a-cf7999bb9d04" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(\\frac{2}{0})" :db/id #edb/ref 17592186335029} :answer-field/id #uuid "25dbbbbc-4db9-57a7-8794-1b47f6589141" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186335310}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "1afc9131-fb54-545a-abcd-cbf497ee2da8" :question/math-academy-id "q-69669" :question/problem "Which expression is missing in the following equation?\n\n$$\n(\\frac{3}{1})=[]+(\\frac{2}{1})\n$$" :question/worked-solution "To find $(\\frac{3}{1}),$ we need to find the number that is located in row $3$ and position $1$ of Pascal's triangle. \n\n**Important**: When counting the rows and positions in Pascal's triangle, we always start counting from zero! Remember:\n\n- The top row of Pascal's triangle is row $0.$\n\n- The first position of each row (the one of the left) is position number $0.$\n\nThe location of $(\\frac{3}{1})$ in Pascal's triangle is highlighted below.\n\n$$\n\\begin{aligned} &  &  &  &  &  &  & (\\frac{0}{0}) \\\\  &  &  &  &  &  & (\\frac{1}{0}) &  & (\\frac{1}{1}) \\\\  &  &  &  &  & (\\frac{2}{0}) &  & (\\frac{2}{1}) &  & (\\frac{2}{2}) \\\\  &  &  &  & (\\frac{3}{0}) &  & (\\frac{3}{1}) &  & (\\frac{3}{2}) &  & (\\frac{3}{3}) \\\\  &  &  & ⋮ &  & ⋮ &  & ⋮ &  & ⋮ &  & ⋮\\end{aligned}\n$$\n\nNow, $(\\frac{3}{1})$ is the sum of the two closest numbers located in the previous row. So,\n\n$$\n(\\frac{3}{1})=(\\frac{2}{0})+(\\frac{2}{1})\n$$\n\nTherefore, the missing expression is $(\\frac{2}{0}).$"}] [{:db/id #edb/ref 17592186335995 :knowledge-point/_questions [{:db/id #edb/ref 17592186171957 :knowledge-point/id #uuid "9c976b6a-4523-51e1-a243-27aa8937db25" :knowledge-point/title "Expressing the Relationship Between the Rows of Pascal's Triangle in Terms of Binomial Coefficients"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "42eec711-2366-5e9e-b394-97fc17f3a880" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(\\frac{2}{1})" :db/id #edb/ref 17592186333612} {:answer/id #uuid "48cd114b-2976-5998-8aab-6731eae06237" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(\\frac{2}{2})" :db/id #edb/ref 17592186333660} {:answer/id #uuid "56a6c0b8-3c50-57e0-a732-7b6b3ad0a73b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(\\frac{1}{1})" :db/id #edb/ref 17592186333773} {:answer/id #uuid "75f609f8-4a1f-5d10-a85e-5c13f336ab51" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(\\frac{2}{0})" :db/id #edb/ref 17592186334055} {:answer/id #uuid "aace99ba-6af1-5dd7-8bf4-07b6ec0c5a0b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(\\frac{1}{0})" :db/id #edb/ref 17592186334486}] :answer-field/correct {:answer/id #uuid "48cd114b-2976-5998-8aab-6731eae06237" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(\\frac{2}{2})" :db/id #edb/ref 17592186333660} :answer-field/id #uuid "e8ac1b6d-c8df-5a4f-8cb7-7837698f5128" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186335645}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "911738be-601f-52ff-bdd9-bde88253aa9f" :question/math-academy-id "q-69722" :question/problem "Which expression is missing in the following equation?\n\n$$\n(\\frac{3}{2})=(\\frac{2}{1})+[]\n$$" :question/worked-solution "To find $(\\frac{3}{2}),$ we need to find the number that is located in row $3$ and position $2$ of Pascal's triangle. \n\n**Important**: When counting the rows and positions in Pascal's triangle, we always start counting from zero! Remember:\n\n- The top row of Pascal's triangle is row $0.$\n\n- The first position of each row (the one of the left) is position number $0.$\n\nThe location of $(\\frac{3}{2})$ in Pascal's triangle is highlighted below.\n\n$$\n\\begin{aligned} &  &  &  &  &  &  & (\\frac{0}{0}) \\\\  &  &  &  &  &  & (\\frac{1}{0}) &  & (\\frac{1}{1}) \\\\  &  &  &  &  & (\\frac{2}{0}) &  & (\\frac{2}{1}) &  & (\\frac{2}{2}) \\\\  &  &  &  & (\\frac{3}{0}) &  & (\\frac{3}{1}) &  & (\\frac{3}{2}) &  & (\\frac{3}{3}) \\\\  &  &  & ⋮ &  & ⋮ &  & ⋮ &  & ⋮ &  & ⋮\\end{aligned}\n$$\n\nNow, $(\\frac{3}{2})$ is the sum of the two closest numbers located in the previous row. So,\n\n$$\n(\\frac{3}{2})=(\\frac{2}{1})+(\\frac{2}{2})\n$$\n\nTherefore, the missing expression is $(\\frac{2}{2}).$"}] [{:db/id #edb/ref 17592186338838 :knowledge-point/_questions [{:db/id #edb/ref 17592186119826 :knowledge-point/id #uuid "9927bff1-c245-542b-8d5d-fa7d24188b85" :knowledge-point/title "Finding the Vector Equation of a Line Given in Canonical Form"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0208e6c7-524e-5c3c-93df-6287593ea68d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\begin{aligned}x=11-4t \\\\ y=-3+5t \\\\ z=-1+3t\\end{aligned}" :db/id #edb/ref 17592186336048} {:answer/id #uuid "2044812a-86aa-504d-a4fa-133b5cd293d4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\begin{aligned}x=-4+11t \\\\ y=5-3t \\\\ z=3-t\\end{aligned}" :db/id #edb/ref 17592186336335} {:answer/id #uuid "2363ff48-5a2d-52f1-987f-cdb0aa93a664" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\begin{aligned}x=-4t \\\\ y=5t \\\\ z=3t\\end{aligned}" :db/id #edb/ref 17592186336362} {:answer/id #uuid "9435fa56-6ac3-5ce6-85af-c1c549b04ce8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "None of the listed" :db/id #edb/ref 17592186337386} {:answer/id #uuid "dceaada9-5cef-5b34-ae63-71c56f2cbe94" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\begin{aligned}x=-11-4t \\\\ y=3+5t \\\\ z=1+3t\\end{aligned}" :db/id #edb/ref 17592186337953}] :answer-field/correct {:answer/id #uuid "0208e6c7-524e-5c3c-93df-6287593ea68d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\begin{aligned}x=11-4t \\\\ y=-3+5t \\\\ z=-1+3t\\end{aligned}" :db/id #edb/ref 17592186336048} :answer-field/id #uuid "ec3ec4fe-dbef-57ff-9f77-95dfde96d695" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186338687}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "cadd3ac4-4f87-567b-a331-c8cf0c3150d6" :question/math-academy-id "q-70866" :question/problem "Find the parametric equations of the line $\\frac{x-11}{-4}=\\frac{y+3}{5}=\\frac{z+1}{3}.$" :question/worked-solution "Remember that the Cartesian (canonical) equation of the straight line that passes through the point $P({x}_{0},{y}_{0},{z}_{0})$ and is parallel to the vector $v=⟨{v}_{x},{v}_{y},{v}_{z}⟩$, is given by\n\n$$\n\\frac{x-{x}_{0}}{{v}_{x}}=\\frac{y-{y}_{0}}{{v}_{y}}=\\frac{z-{z}_{0}}{{v}_{z}}=t,\\,t\\in (-\\infty ,\\infty ).\n$$\n\nComparing the above to our given equation\n\n$$\n\\frac{x-11}{-4}=\\frac{y-(-3)}{5}=\\frac{z-(-1)}{3},\n$$\n\nwe find that our line passes through the point $P(11,-3,-1)$ and is parallel to $v=⟨-4,5,3⟩.$ Therefore, its vector equation is\n\n$$\n\\begin{aligned}r & =p+tv \\\\ r & =[\\begin{aligned}11 \\\\ -3 \\\\ -1\\end{aligned}]+t[\\begin{aligned}-4 \\\\ 5 \\\\ 3\\end{aligned}],\\,t\\in (-\\infty ,\\infty ).\\end{aligned}\n$$\n\nTherefore, the parametric equations are the following:\n\n$$\n{\\begin{aligned}x=11-4t \\\\ y=-3+5t \\\\ z=-1+3t\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186351158 :knowledge-point/_questions [{:db/id #edb/ref 17592186054630 :knowledge-point/id #uuid "3cbddaef-3828-5454-b892-26a3c6242ddb" :knowledge-point/title "Finding All Subsets of a Given Set"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "00477f65-bd90-5482-90d1-f994a3fbe898" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{-\\pi },{\\pi },{-\\pi ,\\pi }" :db/id #edb/ref 17592186348456} {:answer/id #uuid "30e06cb2-c255-5f11-b691-572f6cb12c62" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{-\\pi },{\\pi }" :db/id #edb/ref 17592186348880} {:answer/id #uuid "3c2d53b9-b908-5cf1-b18e-2f5347d75ad2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "∅,{-\\pi },{\\pi }" :db/id #edb/ref 17592186348990} {:answer/id #uuid "423e2285-a431-5d72-8ff4-f35abed92c27" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "∅,{-\\pi ,\\pi }" :db/id #edb/ref 17592186349047} {:answer/id #uuid "cf751db4-cb59-541e-84ca-ce2c34896ae5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "∅,{-\\pi },{\\pi },{-\\pi ,\\pi }" :db/id #edb/ref 17592186350269}] :answer-field/correct {:answer/id #uuid "cf751db4-cb59-541e-84ca-ce2c34896ae5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "∅,{-\\pi },{\\pi },{-\\pi ,\\pi }" :db/id #edb/ref 17592186350269} :answer-field/id #uuid "ef510875-8ddb-5754-836a-118c96470baf" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186351128}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "5ade80e9-fb10-5f67-9c65-ab5d8d98adbc" :question/math-academy-id "q-80809" :question/problem "Find all of the subsets of $U={-\\pi ,\\pi }.$" :question/worked-solution "To find every subset of $U,$ we list out every combination of elements within $U.$ \n\nWe can use the following diagram to visualize the process:\n\n![](images/b0/b0e483a2d10cba17fb2bd3bf0e78d7b4d2fc07b22dbb5c492564b998bbfce6fc.png)\n\nNote that we must include the empty set since it is a subset of every set.\n\nBy doing this, we get\n\n$$\n∅,{-\\pi },{\\pi },{-\\pi ,\\pi }.\n$$"}] [{:db/id #edb/ref 17592186351176 :knowledge-point/_questions [{:db/id #edb/ref 17592186157285 :knowledge-point/id #uuid "67e90c94-5018-582f-8692-a1155f41f7c7" :knowledge-point/title "Finding Differences of Sets Given Verbally"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "12dc3893-1d36-5fae-adbb-5b4fe020c289" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{10,20,30,40,50,60,70,…}" :db/id #edb/ref 17592186348608} {:answer/id #uuid "2e20a10d-35fc-5711-ba0b-f0e0ba153819" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{5,15,25,35,45,55,65,75,…}" :db/id #edb/ref 17592186348852} {:answer/id #uuid "8b31e15d-1b02-566f-8b12-fec5cc82ae47" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{15,30,45,60,75,…}" :db/id #edb/ref 17592186349707} {:answer/id #uuid "a284a9a8-2c8b-5360-8862-5fa84376ab51" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "∅" :db/id #edb/ref 17592186349897} {:answer/id #uuid "c696f84d-bd3b-5ae2-8fc2-553faaf736d9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{5,10,15,20,25,30,35,40,45,50,55,60,65,70,75,…}" :db/id #edb/ref 17592186350195}] :answer-field/correct {:answer/id #uuid "a284a9a8-2c8b-5360-8862-5fa84376ab51" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "∅" :db/id #edb/ref 17592186349897} :answer-field/id #uuid "adc8c03c-2db7-556e-a6d7-5bf3ef6dc447" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186351004}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "1076728a-78e3-5cde-ae2f-0952fd39a682" :question/math-academy-id "q-80876" :question/problem "Let $C$  be the set of all multiples of $10$ greater than $0$ and let $D$  be the the set of all multiples of $5$ greater than $0.$ What is $C∖D?$" :question/worked-solution "The multiples of $10$ that are greater than $0$ are\n\n$$\nC={10,20,30,40,50,60,70,…}.\n$$\n\nLikewise, multiples of $5$ that are greater than $0$ are\n\n$$\nD={5,10,15,20,25,30,35,40,45,50,55,60,65,70,75,…}.\n$$\n\nNow, $C∖D$ is the *difference* of $C$ and $D,$ which means that we want to find the elements that are in $C$ but *not* in $D.$\n\nThe elements of $C$ that are also in $D$ are $10,20,30,40,$ and so on (i.e. multiples of $10$). So, we must remove these elements from $C.$ Therefore, we have\n\n$$\n\\begin{aligned}C∖D & =C-D \\\\  & ={10,20,30,40,50,60,70,…}-{5,10,15,20,25,30,35,40,45,50,55,60,65,70,75,…} \\\\  & =∅.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186351258 :knowledge-point/_questions [{:db/id #edb/ref 17592186157287 :knowledge-point/id #uuid "9a55a708-abb0-5e23-8862-153561d022c8" :knowledge-point/title "Finding the Complement of a Set Without a Venn Diagram"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1d1b87d6-db9d-5eff-aafd-1bf143dc4504" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{3,5,7,9}" :db/id #edb/ref 17592186348702} {:answer/id #uuid "353acb1b-31e7-5359-ba2d-65df9b7d2367" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{1,3,5,7,9}" :db/id #edb/ref 17592186348928} {:answer/id #uuid "44b15221-3423-5b59-8684-e9d6870a75ab" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{0,3,6,9}" :db/id #edb/ref 17592186349070} {:answer/id #uuid "62ddba07-ac5c-509d-90ad-a5b762f3b380" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{1,3,6,9}" :db/id #edb/ref 17592186349351} {:answer/id #uuid "72a496dd-468a-507a-a4f2-e5e74bcb5ad7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{1,2,3,4,5,6,7,8,9}" :db/id #edb/ref 17592186349502}] :answer-field/correct {:answer/id #uuid "353acb1b-31e7-5359-ba2d-65df9b7d2367" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{1,3,5,7,9}" :db/id #edb/ref 17592186348928} :answer-field/id #uuid "21188bb3-7c29-56d5-bce0-52b90aee9ec7" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186350765}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "35334f88-cecb-5c05-827d-5c2f77f4118a" :question/math-academy-id "q-81203" :question/problem "If $U={1,2,3,…,10}$ is the universal set and $A={2,4,6,8,10},$ then the complement of $A$ is" :question/worked-solution "The complement of $A,$ denoted $\\overset{―}{A},$ consists of every element in the universal set $U$ that is not in the set $A.$\n\nThe elements of $U$ that are not in $A$ are $1,$ $3,$ $5,$ $7,$ and $9.$\n\nTherefore, the complement of $A$ is\n\n$$\n\\overset{―}{A}={1,3,5,7,9}.\n$$"}] [{:db/id #edb/ref 17592186351259 :knowledge-point/_questions [{:db/id #edb/ref 17592186157288 :knowledge-point/id #uuid "49251196-c06b-5718-82e6-5ed9450301af" :knowledge-point/title "Finding the Complement of a Set Given Using Ellipsis Notation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "05eeade3-f464-58a7-aeec-6bc65aa2fb71" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{-20,-16,-12,-8,-4,0,4,8,12,16}" :db/id #edb/ref 17592186348500} {:answer/id #uuid "2e20d839-512b-589a-9d06-c116fa061a30" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{-16,-14,-12,-10,…,16}" :db/id #edb/ref 17592186348853} {:answer/id #uuid "b217f4bc-aa9b-54c6-b71e-d3d1cf839c05" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{-18,-16,-14,-12,…,18}" :db/id #edb/ref 17592186350021} {:answer/id #uuid "e783dd1e-6481-566a-8a08-2ef68f87025d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{-18,-14,-10,-6,-2,2,6,10,14,18}" :db/id #edb/ref 17592186350471} {:answer/id #uuid "f921a980-2ebd-5c23-a6d7-ed61afecdbcc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{-18,-12,-6,0,6,12,18}" :db/id #edb/ref 17592186350635}] :answer-field/correct {:answer/id #uuid "e783dd1e-6481-566a-8a08-2ef68f87025d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{-18,-14,-10,-6,-2,2,6,10,14,18}" :db/id #edb/ref 17592186350471} :answer-field/id #uuid "a2ba48f4-bfb9-53b1-b63c-347212329c4e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186350983}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "99c47e36-6326-59cd-8a70-c88572cc5f54" :question/math-academy-id "q-81205" :question/problem "If $U={-20,-18,-16,-14,…,20}$ is the universal set and $A={-20,-16,-12,-8,…,20},$ then $\\overset{―}{A}=$" :question/worked-solution "The complement of $A,$ denoted $\\overset{―}{A},$ consists of every element in the universal set $U$ that is not in the set $A.$\n\nThe universal set $U$ consists of the even integers $-20$ through $20,$ while the set $A$ consists of the multiples of $4$ from $-20$ through $20.$\n\nSo, the only elements of $U$ that are not in $A$ are the even integers from $-18$ through $18$ that are not multiples of $4.$\n\nTherefore, the complement of $A$ is\n\n$$\n\\overset{―}{A}={-18,-14,-10,-6,-2,2,6,10,14,18}.\n$$"}] [{:db/id #edb/ref 17592186351347 :knowledge-point/_questions [{:db/id #edb/ref 17592186157289 :knowledge-point/id #uuid "4687dcd7-a5ab-5dc6-be6d-89d806a61a02" :knowledge-point/title "Finding a Difference of Sets Using a Venn Diagram"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "661f5dac-b033-5794-a417-f364d53f973c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{t,e,l}" :db/id #edb/ref 17592186349383} {:answer/id #uuid "771c785d-9c83-5caf-8e3b-5ee2e38d279b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{a,s,w,d}" :db/id #edb/ref 17592186349545} {:answer/id #uuid "d51c9e81-356a-5a5b-b763-a78a15c1c16a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{t,e,l,a,s,w,d}" :db/id #edb/ref 17592186350315} {:answer/id #uuid "de431399-1cd8-5b26-8464-8eba13390223" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{p,a,s,t,e,l}" :db/id #edb/ref 17592186350390} {:answer/id #uuid "fe2775e4-ca81-5f86-9926-6487bacc9909" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{p,o,r}" :db/id #edb/ref 17592186350682}] :answer-field/correct {:answer/id #uuid "661f5dac-b033-5794-a417-f364d53f973c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{t,e,l}" :db/id #edb/ref 17592186349383} :answer-field/id #uuid "121ca97a-caf0-5257-b942-d39008348aee" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186350742}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "065e9298-e9b9-5450-a8e3-c9e554981a9b" :question/math-academy-id "q-81695" :question/problem "![](images/3b/3b539190899ca580528fdbf7b5d3ef9925ade29f97f4b2f96b0f1394743f40a8.png)\n\nGiven the sets $S={p,a,s,w,o,r,d}$ and $T={p,o,r,t,e,l},$ find $T∖S.$" :question/worked-solution "The difference $T∖S$ consists of all the elements that are in $T$ but not $S.$ To represent $T∖S,$ we will shade in all the area that is contained in $T$ but not $S.$\n\n![](images/c7/c718918667c5076f8696ea98f453ff17f005d5f7cace87bd863be309fac28d72.png)\n\nThe elements $t,e,$ and $l$ are in $T$ but not $S.$\n\nTherefore, the difference is\n\n$$\nT∖S={t,e,l}.\n$$"}] [{:db/id #edb/ref 17592186351367 :knowledge-point/_questions [{:db/id #edb/ref 17592186157285 :knowledge-point/id #uuid "67e90c94-5018-582f-8692-a1155f41f7c7" :knowledge-point/title "Finding Differences of Sets Given Verbally"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "32bc5cc1-34e7-50a4-90e9-f49d1684a351" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{3,4,6,8,9,15,16,…}" :db/id #edb/ref 17592186348897} {:answer/id #uuid "5c4fc9fd-1369-50a8-a2aa-a07d4f78e83a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{3,6,9,15,18,21,…}" :db/id #edb/ref 17592186349296} {:answer/id #uuid "847e2e23-e20c-5f59-b3cd-d6804f902631" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{12,24…}" :db/id #edb/ref 17592186349656} {:answer/id #uuid "ada53744-a0cb-5c75-a8c8-3ef50251b3f5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{4,8,16,20,…}" :db/id #edb/ref 17592186349983} {:answer/id #uuid "d869349a-7bc5-58c1-92c1-bdbace8cad61" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{0,3,6,9,15,18,21,…}" :db/id #edb/ref 17592186350342}] :answer-field/correct {:answer/id #uuid "ada53744-a0cb-5c75-a8c8-3ef50251b3f5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{4,8,16,20,…}" :db/id #edb/ref 17592186349983} :answer-field/id #uuid "0902a368-1e16-5c70-8a0c-b4b8645ecb9c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186350721}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "08cc3802-c796-53b6-b40f-b3be60f49c05" :question/math-academy-id "q-81766" :question/problem "Let $A$  be the set of all multiples of $3$ greater than $0$ and let $B$  be the set of all multiples of $4$ greater than $0.$ What is $B-A?$" :question/worked-solution "The multiples of $3$ that are greater than $0$ are\n\n$$\nA={3,6,9,12,15,18,21,24,…}.\n$$\n\nLikewise, multiples of $4$ that are greater than $0$ are\n\n$$\nB={4,8,12,16,20,24,…}.\n$$\n\nNow, $B-A$ is the *difference* of $B$ and $A,$ which means that we want to find the elements that are in $B$ but *not* in $A.$\n\nThe elements of $B$ that are also in $A$ are $12,24,$ and so on (i.e. multiples of $12$). So, we must remove these elements from $B.$ Therefore, we have\n\n$$\n\\begin{aligned}B-A & ={4,8,12,16,20,24,…}-{3,6,9,12,15,18,21,24,…} \\\\  & ={4,8,16,20,…}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186354480 :knowledge-point/_questions [{:db/id #edb/ref 17592186157286 :knowledge-point/id #uuid "19fb3196-439e-5466-b50c-615c492167b4" :knowledge-point/title "Finding the Complement of a Set Using a Venn Diagram"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "02b6103e-2899-5523-ac79-862e1c145ba0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{c,40}" :db/id #edb/ref 17592186351589} {:answer/id #uuid "abbc3b00-c996-5b97-b921-3864d994d7b2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{a,b,c}" :db/id #edb/ref 17592186353024} {:answer/id #uuid "d0fcdcdc-3d8d-5311-b4e1-4afbb305c794" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{a,40}" :db/id #edb/ref 17592186353375} {:answer/id #uuid "dc9b526a-7974-59ab-ad15-b76cbc5ee9f0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{20,40}" :db/id #edb/ref 17592186353486} {:answer/id #uuid "e0bf9f25-29a8-5956-9393-39c3b798e6ae" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{a,c}" :db/id #edb/ref 17592186353515}] :answer-field/correct {:answer/id #uuid "e0bf9f25-29a8-5956-9393-39c3b798e6ae" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{a,c}" :db/id #edb/ref 17592186353515} :answer-field/id #uuid "0ea4e7ef-a234-58ac-9208-db95f3628325" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186353842}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "4434ccc8-02d5-5a76-9c36-2b57d531d580" :question/math-academy-id "q-86587" :question/problem "![](images/02/02dabe7099c201f717885a05842e0cb8543bd01cccf0d6c52147f674cde15dce.png)\n\nLet $U={a,b,c,20,40}$ be the universal set and let $R={b,20,40}.$ What is the complement of $R?$" :question/worked-solution "The complement of $R,$ denoted $\\overset{―}{R},$ consists of all the elements in $U$ that are not in $R.$ To represent $\\overset{―}{R},$ we will shade in all the area of $U$ that is *outside* of $R,$ as follows:\n\n![](images/79/79900f22c35570b35cf10664768ecf4460a7953ddf7f91dac1893b3ce81339bf.png)\n\nThe elements in the shaded area are $a$ and $c.$ These are the elements of $U$ that are not in $R.$ Therefore, the complement of $R$ is\n\n$$\n\\overset{―}{R}={a,c}.\n$$"}] [{:db/id #edb/ref 17592186354481 :knowledge-point/_questions [{:db/id #edb/ref 17592186157287 :knowledge-point/id #uuid "9a55a708-abb0-5e23-8862-153561d022c8" :knowledge-point/title "Finding the Complement of a Set Without a Venn Diagram"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "26a74d8b-07c0-55db-b46e-66389d4dcdaa" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{4,8,10,12}" :db/id #edb/ref 17592186351921} {:answer/id #uuid "4517bc04-4712-54c0-8248-faa204808a9c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{4,8,12}" :db/id #edb/ref 17592186352205} {:answer/id #uuid "522e1bfc-bccd-5de7-b10e-e9042e520df7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{2,4,8,12}" :db/id #edb/ref 17592186352303} {:answer/id #uuid "68343722-6293-530a-8788-ffd889564ad8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{4,12}" :db/id #edb/ref 17592186352494} {:answer/id #uuid "9d6b9d6f-693c-5c31-b86a-3174c104b825" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{4,8}" :db/id #edb/ref 17592186352911}] :answer-field/correct {:answer/id #uuid "4517bc04-4712-54c0-8248-faa204808a9c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{4,8,12}" :db/id #edb/ref 17592186352205} :answer-field/id #uuid "a2f9adc9-b73b-54e9-ac8c-1d5f98dfb7ee" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186354100}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "04125aec-6df3-511f-bf67-6f782ff92bbb" :question/math-academy-id "q-86590" :question/problem "If $U={2,4,6,8,10,12}$ is the universal set and $B={2,6,10},$ then the complement of $B$ is" :question/worked-solution "The complement of $B,$ denoted $\\overset{―}{B},$ consists of every element in the universal set $U$ that is not in the set $B.$\n\nThe elements of $U$ that are not in $B$ are $4,$ $8,$   and $12.$\n\nTherefore, the complement of $B$ is\n\n$$\n\\overset{―}{B}={4,8,12}.\n$$"}] [{:db/id #edb/ref 17592186354497 :knowledge-point/_questions [{:db/id #edb/ref 17592186157289 :knowledge-point/id #uuid "4687dcd7-a5ab-5dc6-be6d-89d806a61a02" :knowledge-point/title "Finding a Difference of Sets Using a Venn Diagram"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1dbc40ae-f26c-5818-bfd4-bddc3ecd358a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "∅" :db/id #edb/ref 17592186351832} {:answer/id #uuid "3807ae35-2e4a-5baf-a41e-fb7ec52731be" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{5,7,9}" :db/id #edb/ref 17592186352084} {:answer/id #uuid "594f8225-4e27-5e2a-aaae-c56cf5ba7f1f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{0,1,3}" :db/id #edb/ref 17592186352355} {:answer/id #uuid "97532042-92bf-5e7a-9ee7-9201f227a2d7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{5,7}" :db/id #edb/ref 17592186352872} {:answer/id #uuid "f2311e6e-122d-5596-888c-1887ea611dfd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{0,1,3,5,7,9}" :db/id #edb/ref 17592186353679}] :answer-field/correct {:answer/id #uuid "3807ae35-2e4a-5baf-a41e-fb7ec52731be" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{5,7,9}" :db/id #edb/ref 17592186352084} :answer-field/id #uuid "912b3d79-97df-5c30-a3f5-eec985f87656" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186354073}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "af7efa2c-3ffa-5821-9cbc-8c2275ebe689" :question/math-academy-id "q-86701" :question/problem "![](images/96/96962d11526f30beee45b85aac92808518352d7b79b4b4f2e4a7351ddd9fe17e.png)\n\nGiven the sets $S={5,7,9}$ and $T={0,1,3},$find $S∖T.$" :question/worked-solution "The difference $S∖T$ consists of all the elements that are in $S$ but not $T.$ To represent $S∖T,$ we will shade in all the area that is contained in $S$ but not $T.$\n\n![](images/be/be1caefc99bea5d4dde0ba272a208dd8f587156029ce37df483e40cd5f6121d2.png)\n\nAll elements of $S$ are not in $T.$\n\nTherefore, the difference is\n\n$$\nS∖T={5,7,9}.\n$$"}] [{:db/id #edb/ref 17592186404461 :knowledge-point/_questions [{:db/id #edb/ref 17592186110653 :knowledge-point/id #uuid "42525832-e186-538f-baf8-bb4418e9820b" :knowledge-point/title "Working With Systems Containing Inequalities Presented in Standard Form"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c7c2a5d4-298c-5631-a9d7-aba5b729e118" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\begin{aligned}x+y<3 \\\\ y>2x\\end{aligned}" :db/id #edb/ref 17592186404463} {:answer/id #uuid "01bc8bf9-9741-5be3-bf6c-963968a707d0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\begin{aligned}x+y\\le 3 \\\\ y\\ge 2x\\end{aligned}" :db/id #edb/ref 17592186404464} {:answer/id #uuid "da29e297-529e-5fe2-b38a-d2962daba4be" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\begin{aligned}x+y>3 \\\\ y<2x\\end{aligned}" :db/id #edb/ref 17592186404465} {:answer/id #uuid "2f5ca256-25d0-5c51-b2d0-61bafb216142" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\begin{aligned}x+y<3 \\\\ y<2x\\end{aligned}" :db/id #edb/ref 17592186404466} {:answer/id #uuid "57ca1c9c-b7c8-5c26-8e55-f2e99026a45b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\begin{aligned}x+y>3 \\\\ y>2x\\end{aligned}" :db/id #edb/ref 17592186404467}] :answer-field/correct {:answer/id #uuid "57ca1c9c-b7c8-5c26-8e55-f2e99026a45b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\begin{aligned}x+y>3 \\\\ y>2x\\end{aligned}" :db/id #edb/ref 17592186404467} :answer-field/id #uuid "8c5be21f-60e7-597b-83dc-3c20339aa469" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186404462}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "262609c0-5557-5285-b43c-f82fdb8825a5" :question/math-academy-id "q-90054" :question/problem "![](images/b8/b8c1d5902a76a68e5f8358d4c3668e1be184ec7241184df4ff1363d41995f3aa.png)\n\nWhich of the following systems of inequalities defines the shaded region shown above?" :question/worked-solution "Consider the line $x+y=3.$ Since the line is dashed, the inequality is strict. Writing the equation of this line in slope-intercept form, we have\n\n$$\ny=-x+3.\n$$\n\nNow, since the shaded region lies *above* the line, the inequality is a \"greater than\"  inequality. So the corresponding inequality is\n\n$$\ny>-x+3,\n$$\n\n    \n\nwhich we can rewrite as\n\n$$\nx+y>3.\n$$\n\nNow consider the line $y=2x.$ Since the line is dashed, the inequality is strict.  Also, since the shaded region lies *above* the line, the inequality is a \"greater than\" inequality. So the corresponding inequality is\n\n$$\ny>2x.\n$$\n\nTherefore, the system of inequalities that defines the shaded region is\n\n$$\n{\\begin{aligned}x+y>3 \\\\ y>2x.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186404468 :knowledge-point/_questions [{:db/id #edb/ref 17592186110651 :knowledge-point/id #uuid "fbd52408-5f2f-58c9-9a88-bd992fe8752c" :knowledge-point/title "Working With Systems Containing Strict Inequalities"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "57e3339b-5c2d-5e02-8e56-922ef2cb88bc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\begin{aligned}y\\le 4x+3 \\\\ y>\\frac{1}{4}x-2\\end{aligned}" :db/id #edb/ref 17592186404470} {:answer/id #uuid "b2167803-87c2-5c4e-aa85-d576aac9cc32" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\begin{aligned}y<4x+3 \\\\ y>\\frac{1}{4}x-2\\end{aligned}" :db/id #edb/ref 17592186404471} {:answer/id #uuid "aa93daa1-24f9-58db-9545-6bf0487628c5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\begin{aligned}y>4x+3 \\\\ y\\ge \\frac{1}{4}x-2\\end{aligned}" :db/id #edb/ref 17592186404472} {:answer/id #uuid "ecf061e8-e3ee-5abf-a78a-299067a79064" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\begin{aligned}y>4x+3 \\\\ y<\\frac{1}{4}x-2\\end{aligned}" :db/id #edb/ref 17592186404473} {:answer/id #uuid "6051d13a-7c7c-5804-88c5-53711a5cb6ab" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\begin{aligned}y>4x+3 \\\\ y>\\frac{1}{4}x-2\\end{aligned}" :db/id #edb/ref 17592186404474}] :answer-field/correct {:answer/id #uuid "b2167803-87c2-5c4e-aa85-d576aac9cc32" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\begin{aligned}y<4x+3 \\\\ y>\\frac{1}{4}x-2\\end{aligned}" :db/id #edb/ref 17592186404471} :answer-field/id #uuid "94914b35-e16f-5398-9a50-4baddb153e6e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186404469}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "66b0d8c5-2487-53cc-b840-b06edcc12d56" :question/math-academy-id "q-90323" :question/problem "![](images/e8/e863789ff989ee1cb3d3fe6c22fe0d4daa1dac76d6fbfbebdad801006ca4c969.png)\n\nWhich of the following systems of inequalities defines the shaded region shown above?" :question/worked-solution "Consider the line $y=4x+3.$ Since the line is dashed, the inequality is strict. Also, since the shaded region lies *below* the line, the inequality is a \"less than\" inequality. So the corresponding inequality is\n\n$$\ny<4x+3.\n$$\n\n    \n\nNow consider the line $y=\\frac{1}{4}x-2.$ Since the line is dashed, the inequality is strict. Also, since the shaded region lies *above* the line, the inequality is a \"greater than\" inequality. So the corresponding inequality is\n\n$$\ny>\\frac{1}{4}x-2.\n$$\n\nTherefore, the system of inequalities that defines the shaded region is\n\n$$\n{\\begin{aligned}y<4x+3 \\\\ y>\\frac{1}{4}x-2.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186404475 :knowledge-point/_questions [{:db/id #edb/ref 17592186110652 :knowledge-point/id #uuid "a258070e-5c3c-595e-81d6-3e0f9b9a5daf" :knowledge-point/title "Working With Systems Containing Mixed Inequalities"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "daea2326-2376-5164-b217-f74ca9ead6c8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\begin{aligned}y\\le x+2 \\\\ y\\ge -x+2\\end{aligned}" :db/id #edb/ref 17592186404477} {:answer/id #uuid "8b73faca-4331-5468-aa5b-5f3ece1295f6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\begin{aligned}y>x+2 \\\\ y\\le -x+2\\end{aligned}" :db/id #edb/ref 17592186404478} {:answer/id #uuid "83a1c4b0-cc77-5dcc-8de0-37f06af0e319" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\begin{aligned}y\\le x+2 \\\\ y>-x+2\\end{aligned}" :db/id #edb/ref 17592186404479} {:answer/id #uuid "b45d0b54-a0ec-5724-b49e-549e13b6d4d6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\begin{aligned}y\\ge x+2 \\\\ y<-x+2\\end{aligned}" :db/id #edb/ref 17592186404480} {:answer/id #uuid "3d2a88ff-6f4a-5ac9-a039-72c31f12f559" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\begin{aligned}y<x+2 \\\\ y\\ge -x+2\\end{aligned}" :db/id #edb/ref 17592186404481}] :answer-field/correct {:answer/id #uuid "83a1c4b0-cc77-5dcc-8de0-37f06af0e319" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\begin{aligned}y\\le x+2 \\\\ y>-x+2\\end{aligned}" :db/id #edb/ref 17592186404479} :answer-field/id #uuid "f86fe5f2-d23c-5598-bb24-07f9f597ec1a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186404476}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "3e5e2c49-2afd-5324-972b-43974f8bfdd9" :question/math-academy-id "q-90327" :question/problem "![](images/76/762e53967ddb3ccddfa1c9b7a2aa303d66fc1b761c9be8f409c0b91ecb0201de.png)\n\nWhich of the following systems of inequalities represents the shaded region shown in the graph above?" :question/worked-solution "Consider the line $y=x+2.$ Since the line is solid, the inequality is an \"or equal to\" inequality. Also, since the shaded region lies *below* the line, the inequality is a \"less than\" inequality. So the corresponding inequality is\n\n$$\ny\\le x+2.\n$$\n\n    \n\nNow consider the line $y=-x+2.$ Since the line is dashed, the inequality is strict. Also, since the shaded region lies *above* the line, the inequality is a \"greater than\" inequality. So the corresponding inequality is\n\n$$\ny>-x+2.\n$$\n\nTherefore, the system of inequalities that defines the shaded region is\n\n$$\n{\\begin{aligned}y\\le x+2 \\\\ y>-x+2.\\end{aligned}\n$$"}]}
