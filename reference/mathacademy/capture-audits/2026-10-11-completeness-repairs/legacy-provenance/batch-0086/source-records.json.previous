              "type": "math",
              "value": "[\\frac{1}{2},\\infty )",
              "option": "1",
              "source_option": "b"
            },
            {
              "type": "math",
              "value": "(-\\infty ,-\\frac{1}{2}]",
              "option": "2",
              "source_option": "c"
