417] [17592186335645 #edb/ref 1075 #edb/ref 17592186334055 #edb/ref 17592186045417] [17592186335645 #edb/ref 1075 #edb/ref 17592186334486 #edb/ref 17592186045417] [17592186335645 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186335645 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186335645 #edb/ref 1078 #edb/ref 17592186333660 #edb/ref 17592186045417] [17592186335645 #edb/ref 1079 #uuid "e8ac1b6d-c8df-5a4f-8cb7-7837698f5128" #edb/ref 17592186045417] [17592186335995 #edb/ref 1068 #edb/ref 17592186335645 #edb/ref 17592186045417] [17592186335995 #edb/ref 1069 "q-69722" #edb/ref 17592186045417] [17592186335995 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186335995 #edb/ref 1071 "Which expression is missing in the following equation?\n\n$$\n(\\frac{3}{2})=(\\frac{2}{1})+[]\n$$" #edb/ref 17592186045417] [17592186335995 #edb/ref 1072 #uuid "911738be-601f-52ff-bdd9-bde88253aa9f" #edb/ref 17592186045417] [17592186335995 #edb/ref 1074 "To find $(\\frac{3}{2}),$ we need to find the number that is located in row $3$ and position $2$ of Pascal's triangle. \n\n**Important**: When counting the rows and positions in Pascal's triangle, we always start counting from zero! Remember:\n\n- The top row of Pascal's triangle is row $0.$\n\n- The first position of each row (the one of the left) is position number $0.$\n\nThe location of $(\\frac{3}{2})$ in Pascal's triangle is highlighted below.\n\n$$\n\\begin{aligned} &  &  &  &  &  &  & (\\frac{0}{0}) \\\\  &  &  &  &  &  & (\\frac{1}{0}) &  & (\\frac{1}{1}) \\\\  &  &  &  &  & (\\frac{2}{0}) &  & (\\frac{2}{1}) &  & (\\frac{2}{2}) \\\\  &  &  &  & (\\frac{3}{0}) &  & (\\frac{3}{1}) &  & (\\frac{3}{2}) &  & (\\frac{3}{3}) \\\\  &  &  & ⋮ &  & ⋮ &  & ⋮ &  & ⋮ &  & ⋮\\end{aligned}\n$$\n\nNow, $(\\frac{3}{2})$ is the sum of the two closest numbers located in the previous row. So,\n\n$$\n(\\frac{3}{2})=(\\frac{2}{1})+(\\frac{2}{2})\n$$\n\nTherefore, the missing expression is $(\\frac{2}{2}).$" #edb/ref 17592186045417] [17592186336048 #edb/ref 1080 "{\\begin{aligned}x=11-4t \\\\ y=-3+5t \\\\ z=-1+3t\\end{aligned}" #edb/ref 17592186045417] [17592186336048 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186336048 #edb/ref 1083 #uuid "0208e6c7-524e-5c3c-93df-6287593ea68d" #edb/ref 17592186045417] [17592186336335 #edb/ref 1080 "{\\begin{aligned}x=-4+11t \\\\ y=5-3t \\\\ z=3-t\\end{aligned}" #edb/ref 17592186045417] [17592186336335 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186336335 #edb/ref 1083 #uuid "2044812a-86aa-504d-a4fa-133b5cd293d4" #edb/ref 17592186045417] [17592186336362 #edb/ref 1080 "{\\begin{aligned}x=-4t \\\\ y=5t \\\\ z=3t\\end{aligned}" #edb/ref 17592186045417] [17592186336362 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186336362 #edb/ref 1083 #uuid "2363ff48-5a2d-52f1-987f-cdb0aa93a664" #edb/ref 17592186045417] [17592186337386 #edb/ref 1080 "None of the listed" #edb/ref 17592186045417] [17592186337386 #edb/ref 1082 #edb/ref 17592186045499 #edb/ref 17592186045417] [17592186337386 #edb/ref 1083 #uuid "9435fa56-6ac3-5ce6-85af-c1c549b04ce8" #edb/ref 17592186045417] [17592186337953 #edb/ref 1080 "{\\begin{aligned}x=-11-4t \\\\ y=3+5t \\\\ z=1+3t\\end{aligned}" #edb/ref 17592186045417] [17592186337953 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186337953 #edb/ref 1083 #uuid "dceaada9-5cef-5b34-ae63-71c56f2cbe94" #edb/ref 17592186045417] [17592186338687 #edb/ref 1075 #edb/ref 17592186336048 #edb/ref 17592186045417] [17592186338687 #edb/ref 1075 #edb/ref 17592186336335 #edb/ref 17592186045417] [17592186338687 #edb/ref 1075 #edb/ref 17592186336362 #edb/ref 17592186045417] [17592186338687 #edb/ref 1075 #edb/ref 17592186337386 #edb/ref 17592186045417] [17592186338687 #edb/ref 1075 #edb/ref 17592186337953 #edb/ref 17592186045417] [17592186338687 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186338687 #edb/ref 1077 "selection" #e