db/ident :answer.type/math} :answer/value "\\{-1,0,1,2\\}" :db/id #edb/ref 17592186422921} {:answer/id #uuid "f4e76a38-ddc0-5fb4-a344-3fc62a1db4b1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\{0,1,2,3\\}" :db/id #edb/ref 17592186422922}] :answer-field/correct {:answer/id #uuid "f276f1af-5dd7-5303-864c-e20940278140" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\{-1,0,1,2\\}" :db/id #edb/ref 17592186422921} :answer-field/id #uuid "c484a5bd-db58-5531-80c1-6a2d418c418f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186284282}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "2c511297-a581-5325-971e-3c832a3d5acf" :question/math-academy-id "q-174342" :question/problem "Let ${D}_{i}=\\{2i-1,-i,1,i+2\\},$ where $i\\in \\{0,2,3,5\\}.$ Then, ${D}_{0}=$" :question/worked-solution "To write down the elements of ${D}_{0},$ we substitute $i=0$ into the expression and get\n\n$$\n\\begin{aligned}{D}_{0} & =\\{2(0)-1,-0,1,0+2\\} \\\\  & =\\{-1,0,1,2\\}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186284713 :knowledge-point/_questions [{:db/id #edb/ref 17592186054832 :knowledge-point/id #uuid "957a2f61-61b1-5675-ba84-5348a47af986" :knowledge-point/title "Finding Unions and Intersections of Finite Families of Indexed Sets"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "520277c3-872d-57a0-8359-bec38e9b763a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "∅" :db/id #edb/ref 17592186282395} {:answer/id #uuid "b35148f6-fa0e-56e6-91ff-9e1c4ee206a5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[0,1]" :db/id #edb/ref 17592186283245} {:answer/id #uuid "de7c9f2f-75bd-53f9-87a1-21593710a660" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(0,2)" :db/id #edb/ref 17592186283632} {:answer/id #uuid "fa9971aa-094d-544b-b4a0-d838f3c06fef" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[0,2)" :db/id #edb/ref 17592186283880} {:answer/id #uuid "9f99a0aa-c5bb-5d46-9276-4ffb294c6cb8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\{0,1,2\\}" :db/id #edb/ref 17592186422864}] :answer-field/correct {:answer/id #uuid "fa9971aa-094d-544b-b4a0-d838f3c06fef" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[0,2)" :db/id #edb/ref 17592186283880} :answer-field/id #uuid "84726de3-f622-5674-a9ec-80a1beadc4b2" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186284157}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "27878d76-ab4b-5705-b5cf-73536ef6aabb" :question/math-academy-id "q-174434" :question/problem "Find ${⋃}_{i\\in I}{S}_{i}$, given that $I=\\{0,1,2\\},$ and\n\n$$\n\\begin{aligned}{S}_{0}=\\{0\\},\\,{S}_{1}=(0,1),\\,{S}_{2}=(0,2).\\end{aligned}\n$$" :question/worked-solution "The union of a family of indexed sets is the set containing all elements belonging to *at least one* set in the indexed family:\n\n$$\n{⋃}_{i\\in I}{A}_{i}=\\{x\\in U\\,:\\,x\\in {A}_{i}\\,\\,\\text{for at least one }{A}_{i},\\,\\,i\\in I\\}\n$$\n\nwhere $U$ is a universal set.\n\nTherefore, in our case, we have \n\n$$\n\\begin{aligned}{⋃}_{i\\in I}{S}_{i} & ={S}_{0}\\cup {S}_{1}\\cup {S}_{2} \\\\  & =\\{0\\}\\,\\cup \\,(0,1)\\,\\cup \\,(0,2) \\\\  & =[0,2).\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186284714 :knowledge-point/_questions [{:db/id #edb/ref 17592186054832 :knowledge-point/id #uuid "957a2f61-61b1-5675-ba84-5348a47af986" :knowledge-point/title "Finding Unions and Intersections of Finite Families of Indexed Sets"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0b29817c-fe82-5260-acab-1ea51a72ea60" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[5,8)" :db/id #edb/ref 17592186281793} {:answer/id #uuid "2558b356-25ee-5a75-a6a2-81f9fbcc0d3f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(4,7]" :db/id #edb/ref 17592186282015} {:answer/id #uuid "273333dc-0d40-54de-a421-4b0a52439971" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[5,7]" :db/id #edb/ref 17592186282027} {:answer/id #uuid "2ed73e75-1378-555d-b816-759e2219d709" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[5,7)" :db/id #edb/ref 17592186282105} {:answer/id #uuid "d7818a62-4cb5-5eb4-b4b7-350b8c00b6e0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\{5,6,7,8\\}" :db/id #edb/ref 17592186422906}] :answer-field/correct {:answer/id #uuid "0b29817c-fe82-5260-acab-1ea51a72ea60" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "[5,8)" :db/id #edb/ref 17592186281793} :answer-field/id #uuid "d9436f4f-51c3-5193-854a-41d58df1ef65" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186284313}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "8c85214a-dabe-59ba-93a3-34bf866976a6" :question/math-academy-id "q-174435" :question/problem "Find ${⋃}_{i\\in I}{S}_{i}$, given that $I=\\{5,6,7\\},$ and\n${S}_{i}=[i,\\,i+1).$" :question/worked-solution "The union of a family of indexed sets is the set containing all elements belonging to *at least one* set in the indexed family:\n\n$$\n{⋃}_{i\\in I}{A}_{i}=\\{x\\in U\\,:\\,x\\in {A}_{i}\\,\\,\\text{for at least one }{A}_{i},\\,\\,i\\in I\\}\n$$\n\nwhere $U$ is a universal set.\n\nTherefore, in our case, we have \n\n$$\n\\begin{aligned}{⋃}_{i\\in I}{S}_{i} & ={S}_{5}\\cup {S}_{6}\\cup {S}_{7} \\\\  & =[5,6)\\,\\cup \\,[6,7)\\,\\cup \\,[7,8) \\\\  & =[5,8).\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186284717 :knowledge-point/_questions [{:db/id #edb/ref 17592186054833 :knowledge-point/id #uuid "c1e93acb-6c0b-5263-9df9-9dcc00680845" :knowledge-point/title "Finding Unions and Intersections of (Countably) Infinite Families of Indexed Sets"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d6dca9a7-091a-512d-b8bc-14fa19aaf80e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "∅" :db/id #edb/ref 17592186283560} {:answer/id #uuid "e7c5bdda-58b8-5b95-a550-b87c858b7f84" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "Z" :db/id #edb/ref 17592186283707} {:answer/id #uuid "36833993-965f-54a0-beb6-32d1091dad83" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\{0\\}" :db/id #edb/ref 17592186422776} {:answer/id #uuid "a516d4ae-3251-52cc-a8ed-64a93fa8df47" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\{i\\}" :db/id #edb/ref 17592186422868} {:answer/id #uuid "a626081a-f36d-501c-9940-5206c3ddd566" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\{0,\\,1\\}" :db/id #edb/ref 17592186422870}] :answer-field/correct {:answer/id #uuid "d6dca9a7-091a-512d-b8bc-14fa19aaf80e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "∅" :db/id #edb/ref 17592186283560} :answer-field/id #uuid "3f2320a1-6f03-5b22-83a3-274275a86468" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186284037}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "f5b989ff-c36c-5cd1-a2e7-3a722d88ff08" :question/math-academy-id "q-174447" :question/problem "Let $I=Z$ and ${X}_{i}=\\{i-1,\\,i\\},$ then ${⋂}_{i\\in I}{X}_{i}=$" :question/worked-solution "The intersection of a family of indexed sets $\\{{A}_{i}\\}_{i\\in I}$ contains all elements that belong to *all* sets in our family:\n\n$$\n{⋂}_{i\\in I}{A}_{i}=\\{x\\in U\\,:\\,x\\in {A}_{i}\\,\\,\\text{for all }{A}_{i},\\,\\,i\\in I\\}\n$$\n\nwhere $U$ is a universal set.\n\nLet's now write down a few instances of our indexed sets:\n\n- if $i=-1,$ we have ${X}_{-1}=\\{-2,-1\\}$\n\n- if $i=0,$ we have ${X}_{0}=\\{-1,0\\}$\n\n- if $i=1,$ we have ${X}_{1}=\\{0,1\\}$\n\nand so on. \n\nNotice that there is no element that belongs to all the sets. Therefore,\n\n$$\n\\begin{aligned}{⋂}_{i\\in I}{X}_{i}=∅.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186284719 :knowledge-point/_questions [{:db/id #edb/ref 17592186054833 :knowledge-point/id #uuid "c1e93acb-6c0b-5263-9df9-9dcc00680845" :knowledge-point/title "Finding Unions and Intersections of (Countably) Infinite Families of Indexed Sets"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5fb3c0c4-5eba-590b-88b3-a96df51c2ff2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "N" :db/id #edb/ref 17592186282497} {:answer/id #uuid "65072086-3678-56be-b5c5-7b82b9a55cda" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "Z" :db/id #edb/ref 17592186282555} {:answer/id #uuid "aa5f9bc4-0c3f-58f8-b896-dcd30ba8070b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "∅" :db/id #edb/ref 17592186283165} {:answer/id #uuid "9bdaff7d-07de-5c4b-af33-4a521ade7019" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\{-i,0,i\\}" :db/id #edb/ref 17592186422862} {:answer/id #uuid "f143606f-f740-553e-8764-98a1d092465f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\{0\\}" :db/id #edb/ref 17592186422919}] :answer-field/correct {:answer/id #uuid "65072086-3678-56be-b5c5-7b82b9a55cda" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "Z" :db/id #edb/ref 17592186282555} :answer-field/id #uuid "996fba3c-efa9-5bda-b43d-0e42e45a0f5e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186284197}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "2fd30642-b32d-59fc-bea9-4c1cd84ef2fd" :question/math-academy-id "q-174450" :question/problem "Let $I=N$ and ${X}_{i}=\\{-i,\\,0,\\,i\\},$ then ${⋃}_{i\\in I}{X}_{i}=$" :question/worked-solution "The union of a family of indexed sets is the set containing all elements belonging to *at least one* set in the indexed family:\n\n$$\n{⋃}_{i\\in I}{A}_{i}=\\{x\\in U\\,:\\,x\\in {A}_{i}\\,\\,\\text{for at least one }{A}_{i},\\,\\,i\\in I\\}\n$$\n\nwhere $U$ is a universal set.\n\nLet's now write down a few instances of our indexed sets:\n\n- if $i=1,$ we have ${X}_{1}=\\{-1,0,1\\}$\n\n- if $i=2,$ we have ${X}_{2}=\\{-2,0,2\\}$\n\n- if $i=3,$ we have ${X}_{3}=\\{-3,0,3\\}$\n\nand so on. \n\nNotice that all the integers belong to one of the sets.\n\nTherefore, \n\n$$\n\\begin{aligned}{⋃}_{i\\in I}{X}_{i}=Z.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186401928 :knowledge-point/_questions [{:db/id #edb/ref 17592186110652 :knowledge-point/id #uuid "a258070e-5c3c-595e-81d6-3e0f9b9a5daf" :knowledge-point/title "Working With Systems Containing Mixed Inequalities"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1db0be1f-16b6-5732-b49d-787adfdfd7fa" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\{\\begin{aligned}y\\le x+2 \\\\ y<-x+1\\end{aligned}" :db/id #edb/ref 17592186422753} {:answer/id #uuid "4aa2756b-288f-5a3a-97a1-1d111d7e5d71" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\{\\begin{aligned}y>x+2 \\\\ y\\ge -x+1\\end{aligned}" :db/id #edb/ref 17592186422795} {:answer/id #uuid "740fc491-26cc-5f80-aff8-18126091ad1f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\{\\begin{aligned}y\\ge x+2 \\\\ y<-x+1\\end{aligned}" :db/id #edb/ref 17592186422824} {:answer/id #uuid "7aaafe8c-aa58-54f1-83f8-e9d944adc21d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\{\\begin{aligned}y\\ge x+2 \\\\ y\\ge -x+1\\end{aligned}" :db/id #edb/ref 17592186422828} {:answer/id #uuid "97a3bff2-3169-51e5-adcd-51b59766ae70" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\{\\begin{aligned}y\\le x+2 \\\\ y>-x+1\\end{aligned}" :db/id #edb/ref 17592186422855}] :answer-field/correct {:answer/id #uuid "4aa2756b-288f-5a3a-97a1-1d111d7e5d71" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\{\\begin{aligned}y>x+2 \\\\ y\\ge -x+1\\end{aligned}" :db/id #edb/ref 17592186422795} :answer-field/id #uuid "210acf01-110f-53da-bf3c-8725abe1a7d8" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186401929}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "5cb8229e-2a6a-582b-a6c3-627b88cf6816" :question/math-academy-id "q-29384" :question/problem "![](images/a7/a740aafbb9f74e2681506d3027f848fa92e7eea2bac3e08ccaf3fc7e0acf8fa1.png)\n\nWhich of the following systems of inequalities defines the shaded region shown in the graph above?" :question/worked-solution "Consider the line $y=x+2.$ Since the line is dashed, the inequality is strict. Also, since the shaded region lies *above* the line, the inequality is a \"greater than\" inequality. So the corresponding inequality is\n\n$$\ny>x+2.\n$$\n\n    \n\nNow consider the line $y=-x+1.$ Since the line is solid, the inequality is an \"or equal to\" inequality. Also, since the shaded region lies *above* the line, the inequality is a \"greater than\" inequality. So the corresponding inequality is\n\n$$\ny\\ge -x+1.\n$$\n\nTherefore, the system of inequalities that defines the shaded region is\n\n$$\n\\{\\begin{aligned}y>x+2 \\\\ y\\ge -x+1.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186302397 :knowledge-point/_questions [{:db/id #edb/ref 17592186124500 :knowledge-point/id #uuid "debd4ccc-de40-55a6-9236-9bf9fff0bdb1" :knowledge-point/title "Finding the Parametric Equations of a Line"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "018df1e1-1c2a-53c7-aea3-a1c44c966b71" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\{\\begin{aligned}x=3-t \\\\ y=1+3t \\\\ z=3+2t\\end{aligned}" :db/id #edb/ref 17592186422742} {:answer/id #uuid "483591a0-f429-5fde-9a62-298d56345d72" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\{\\begin{aligned}x=-t \\\\ y=3t \\\\ z=2t\\end{aligned}" :db/id #edb/ref 17592186422790} {:answer/id #uuid "93eb3392-70bf-579f-9f36-4778325e3649" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\{\\begin{aligned}x=2-t \\\\ y=4+3t \\\\ z=5+2t\\end{aligned}" :db/id #edb/ref 17592186422852} {:answer/id #uuid "efdfe867-7324-58f6-9d1c-0ac24a9c3f9a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\{\\begin{aligned}x=3t \\\\ y=t \\\\ z=3t\\end{aligned}" :db/id #edb/ref 17592186422918} {:answer/id #uuid "f81bfe5f-a8ad-53cc-9700-e579155f4409" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\{\\begin{aligned}x=-1+3t \\\\ y=3+t \\\\ z=2+3t\\end{aligned}" :db/id #edb/ref 17592186422924}] :answer-field/correct {:answer/id #uuid "f81bfe5f-a8ad-53cc-9700-e579155f4409" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\{\\begin{aligned}x=-1+3t \\\\ y=3+t \\\\ z=2+3t\\end{aligned}" :db/id #edb/ref 17592186422924} :answer-field/id #uuid "371e7130-c050-59b2-8c27-7a7c79cf3390" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186301402}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "00c48028-299a-590c-8308-e04090d60774" :question/math-academy-id "q-32817" :question/problem "![](images/1f/1ffc0945ea74b1bd467a0b9935ee28b88be004c18b11492d67ecdfec56e1bb09.png)\n\nFind the parametric equations of the line shown in the figure above." :question/worked-solution "We know that the line passes through the points $P(-1,3,2)$ and $Q(2,4,5).$ Now, we need to find a direction vector that is parallel to the given line. We can use the vector $\\overset{\\to }{PQ}$ as follows:\n\n$$\n\\begin{aligned}v & =\\overset{\\to }{PQ} \\\\  & =\\overset{\\to }{OQ}-\\overset{\\to }{OP} \\\\  & =[\\begin{aligned}2 \\\\ 4 \\\\ 5\\end{aligned}]-[\\begin{aligned}-1 \\\\ 3 \\\\ 2\\end{aligned}] \\\\  & =[\\begin{aligned}3 \\\\ 1 \\\\ 3\\end{aligned}]\\end{aligned}\n$$\n\nSo, the vector equation of the line is\n\n$$\n\\begin{aligned}r & =p+tv \\\\ r & =[\\begin{aligned}-1 \\\\ 3 \\\\ 2\\end{aligned}]+t[\\begin{aligned}3 \\\\ 1 \\\\ 3\\end{aligned}] \\\\ [\\begin{aligned}x \\\\ y \\\\ z\\end{aligned}] & =[\\begin{aligned}-1 \\\\ 3 \\\\ 2\\end{aligned}]+[\\begin{aligned}3t \\\\ t \\\\ 3t\\end{aligned}] \\\\ [\\begin{aligned}x \\\\ y \\\\ z\\end{aligned}] & =[\\begin{aligned}-1+3t \\\\ 3+t \\\\ 2+3t\\end{aligned}],\\end{aligned}\n$$\n\nwhere $t\\in (-\\infty ,\\infty ).$ And finally, the parametric equations:\n\n$$\n\\{\\begin{aligned}x=-1+3t \\\\ y=3+t \\\\ z=2+3t\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186314972 :knowledge-point/_questions [{:db/id #edb/ref 17592186119808 :knowledge-point/id #uuid "aaefbc53-9df9-54a0-a969-66e062553d5c" :knowledge-point/title "Determining Whether a Vector Lies in the Span of Given Vectors"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "077cc4da-3c12-5749-87e3-9136fa56ff18" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186312025} {:answer/id #uuid "39d686df-f396-5c82-92b8-3b075c274d61" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186312445} {:answer/id #uuid "4dd5ec6b-997e-5c4c-82cd-f74e85dcbdf1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186312607} {:answer/id #uuid "7578cf04-a90c-5b5d-ac09-511fd3e57a8d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186312909} {:answer/id #uuid "2efb3d59-10d0-57b0-b6f6-06c1b609ee7f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "b\\notin \\text{Span}\\{{a}_{1},{a}_{2}\\}" :db/id #edb/ref 17592186422770}] :answer-field/correct {:answer/id #uuid "7578cf04-a90c-5b5d-ac09-511fd3e57a8d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186312909} :answer-field/id #uuid "901fd7a3-f614-5740-8413-9326f82935f3" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186314396}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "dffa9b37-7313-5190-ae5f-372cf9f5aaea" :question/math-academy-id "q-34058" :question/problem "The vectors ${a}_{1}$, ${a}_{2}$, and $b$ are given below. Determine if $b\\in \\text{Span}\\{{a}_{1},{a}_{2}\\}.$ In the affirmative case, find the value of ${x}_{1}\\cdot {x}_{2}$ from the decomposition $b={x}_{1}{a}_{1}+{x}_{2}{a}_{2}.$\n\n$$\n{a}_{1}=[\\begin{aligned}1 \\\\ 0 \\\\ 2\\end{aligned}],\\,{a}_{2}=[\\begin{aligned}-1 \\\\ 1 \\\\ 3\\end{aligned}],\\,b=[\\begin{aligned}1 \\\\ 1 \\\\ 7\\end{aligned}]\n$$" :question/worked-solution "We know that $b\\in \\text{Span}\\{{a}_{1},{a}_{2}\\}$ if there exist ${x}_{1}$ and ${x}_{2}$ such that \n\n$$\n\\begin{aligned}{x}_{1}{a}_{1}+{x}_{2}{a}_{2} & =b \\\\ {x}_{1}[\\begin{aligned}1 \\\\ 0 \\\\ 2\\end{aligned}]+{x}_{2}[\\begin{aligned}-1 \\\\ 1 \\\\ 3\\end{aligned}] & =[\\begin{aligned}1 \\\\ 1 \\\\ 7\\end{aligned}].\\end{aligned}\n$$\n\nSo, we have the following system of equations:\n\n$$\n\\{\\begin{aligned}{x}_{1}-{x}_{2}=1 \\\\ {x}_{2}=1 \\\\ 2{x}_{1}+3{x}_{2}=7\\end{aligned}\n$$\n\nTo solve the system above, we set up and row reduce an augmented matrix:\n\n$$\n\\begin{aligned} & [\\begin{aligned}1 & -1 & 1 \\\\ 0 & 1 & 1 \\\\ 2 & 3 & 7\\end{aligned}] & {R}_{3} & :={R}_{3}-2{R}_{1} \\\\  & ∼[\\begin{aligned}1 & -1 & 1 \\\\ 0 & 1 & 1 \\\\ 0 & 5 & 5\\end{aligned}] & {R}_{3} & :={R}_{3}-5{R}_{2} \\\\  & ∼[\\begin{aligned}1 & -1 & 1 \\\\ 0 & 1 & 1 \\\\ 0 & 0 & 0\\end{aligned}]\\end{aligned}\n$$\n\nNow, we have the system\n\n$$\n\\{\\begin{aligned}{x}_{1}-{x}_{2}=1 \\\\ {x}_{2}=1 \\\\ 0=0.\\end{aligned}\n$$\n\nFrom the second equation, we get ${x}_{2}=1.$ Substituting into the first equation gives \n\n$$\n{x}_{1}-1=1\\,⟹\\,{x}_{1}=2.\n$$\n\nSince the system has a solution, we can conclude that $b\\in \\text{Span}\\{{a}_{1},{a}_{2}\\}.$\n\nMoreover, there is exactly one solution, so we have exactly one way to write $b$ as a linear combination of ${a}_{1}$ and ${a}_{2}:$\n\n$$\n\\begin{aligned}2{a}_{1}+{a}_{2} & =b \\\\ 2\\cdot [\\begin{aligned}1 \\\\ 0 \\\\ 2\\end{aligned}]+[\\begin{aligned}-1 \\\\ 1 \\\\ 3\\end{aligned}] & =[\\begin{aligned}1 \\\\ 1 \\\\ 7\\end{aligned}]\\end{aligned}\n$$\n\nFinally, ${x}_{1}\\cdot {x}_{2}=2\\cdot 1=2.$"}] [{:db/id #edb/ref 17592186317213 :knowledge-point/_questions [{:db/id #edb/ref 17592186119808 :knowledge-point/id #uuid "aaefbc53-9df9-54a0-a969-66e062553d5c" :knowledge-point/title "Determining Whether a Vector Lies in the Span of Given Vectors"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1d12c5f6-3b92-5441-a0fc-3952c1a70749" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-8" :db/id #edb/ref 17592186315285} {:answer/id #uuid "2be071fa-e50f-5e15-af2e-800d12bec8db" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "16" :db/id #edb/ref 17592186315374} {:answer/id #uuid "40c87c4f-e4ad-5573-b56b-bbf8371657d9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-16" :db/id #edb/ref 17592186315491} {:answer/id #uuid "719e49b9-6453-5c6f-ae8b-fb5f2080b954" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186315762} {:answer/id #uuid "385e50bb-f4df-5245-a484-97539f7d5c09" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "b\\notin \\text{Span}\\{{a}_{1},{a}_{2},{a}_{3}\\}" :db/id #edb/ref 17592186422778}] :answer-field/correct {:answer/id #uuid "40c87c4f-e4ad-5573-b56b-bbf8371657d9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-16" :db/id #edb/ref 17592186315491} :answer-field/id #uuid "8429c92b-0897-5b2d-8856-66b5640c1f28" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186316855}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "54dedc31-eea3-5db1-a0e4-025cee199163" :question/math-academy-id "q-34218" :question/problem "The vectors ${a}_{1}$, ${a}_{2}$, ${a}_{3}$, and $b$ are given below. Determine if $b\\in \\text{Span}\\{{a}_{1},{a}_{2},{a}_{3}\\}.$ In the affirmative case, find the value of ${x}_{1}\\cdot {x}_{2}\\cdot {x}_{3}$ from the decomposition $b={x}_{1}{a}_{1}+{x}_{2}{a}_{2}+{x}_{3}{a}_{3}.$\n\n$$\n{a}_{1}=[\\begin{aligned}1 \\\\ -3 \\\\ 0\\end{aligned}],\\,{a}_{2}=[\\begin{aligned}0 \\\\ 1 \\\\ -3\\end{aligned}],\\,{a}_{3}=[\\begin{aligned}-2 \\\\ 6 \\\\ 1\\end{aligned}],\\,b=[\\begin{aligned}6 \\\\ -14 \\\\ -14\\end{aligned}]\n$$" :question/worked-solution "We know that $b\\in \\text{Span}\\{{a}_{1},{a}_{2},{a}_{3}\\}$ if there exist ${x}_{1}$, ${x}_{2}$ and ${x}_{3}$ such that \n\n$$\n\\begin{aligned}{x}_{1}{a}_{1}+{x}_{2}{a}_{2}+{x}_{3}{a}_{3} & =b \\\\ {x}_{1}[\\begin{aligned}1 \\\\ -3 \\\\ 0\\end{aligned}]+{x}_{2}[\\begin{aligned}0 \\\\ 1 \\\\ -3\\end{aligned}]+{x}_{3}[\\begin{aligned}-2 \\\\ 6 \\\\ 1\\end{aligned}] & =[\\begin{aligned}6 \\\\ -14 \\\\ -14\\end{aligned}]\\end{aligned}\n$$\n\nSo, we have the following system of equations:\n\n$$\n\\{\\begin{aligned}{x}_{1}-2{x}_{3}=6 \\\\ -3{x}_{1}+{x}_{2}+6{x}_{3}=-14 \\\\ -3{x}_{2}+{x}_{3}=-14\\end{aligned}\n$$\n\nTo solve the system above, we set up and row reduce an augmented matrix:\n\n$$\n\\begin{aligned} & [\\begin{aligned}1 & 0 & -2 & 6 \\\\ -3 & 1 & 6 & -14 \\\\ 0 & -3 & 1 & -14\\end{aligned}] & {R}_{2} & :={R}_{2}+3{R}_{1} \\\\  & ∼[\\begin{aligned}1 & 0 & -2 & 6 \\\\ 0 & 1 & 0 & 4 \\\\ 0 & -3 & 1 & -14\\end{aligned}] & {R}_{3} & :={R}_{3}+3{R}_{2} \\\\  & ∼[\\begin{aligned}1 & 0 & -2 & 6 \\\\ 0 & 1 & 0 & 4 \\\\ 0 & 0 & 1 & -2\\end{aligned}]\\end{aligned}\n$$\n\nNow, we have the system\n\n$$\n\\{\\begin{aligned}{x}_{1}-2{x}_{3}=6 \\\\ {x}_{2}=4 \\\\ {x}_{3}=-2.\\end{aligned}\n$$\n\nFrom the third equation, we get ${x}_{3}=-2.$ Substituting into the first equation gives \n\n$$\n{x}_{1}-2(-2)=6\\,⟹\\,{x}_{1}=2.\n$$\n\nSince the system has a solution, we can conclude that $b\\in \\text{Span}\\{{a}_{1},{a}_{2},{a}_{3}\\}.$\n\nMoreover, there is exactly one solution, so we have exactly one way to write $b$ as a linear combination of ${a}_{1}$, ${a}_{2}$ and ${a}_{3}:$\n\n$$\n\\begin{aligned}2{a}_{1}+4{a}_{2}+(-2){a}_{3} & =b \\\\ 2\\cdot [\\begin{aligned}1 \\\\ -3 \\\\ 0\\end{aligned}]+4\\cdot [\\begin{aligned}0 \\\\ 1 \\\\ -3\\end{aligned}]+(-2)\\cdot [\\begin{aligned}-2 \\\\ 6 \\\\ 1\\end{aligned}] & =[\\begin{aligned}6 \\\\ -14 \\\\ -14\\end{aligned}]\\end{aligned}\n$$\n\nFinally, ${x}_{1}\\cdot {x}_{2}\\cdot {x}_{3}=2\\cdot 4\\cdot (-2)=-16.$"}] [{:db/id #edb/ref 17592186323896 :knowledge-point/_questions [{:db/id #edb/ref 17592186054629 :knowledge-point/id #uuid "b0e5efaa-e624-5045-abdb-cdf8d32ad6cb" :knowledge-point/title "Identifying Subsets of a Given Set"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "03d9004d-0842-578f-917c-13763b0367eb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "B=\\{0,1,2,4,6,8\\}" :db/id #edb/ref 17592186422745} {:answer/id #uuid "056924f8-d83e-5c71-afe8-c472d01bfc53" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "B=\\{-1,0,1,2,4,6\\}" :db/id #edb/ref 17592186422746} {:answer/id #uuid "6d8f3138-dcd2-5ecb-a537-7faeb8113b84" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "B=\\{1,3,5,7,9\\}" :db/id #edb/ref 17592186422818} {:answer/id #uuid "9a23dd71-3849-5296-aeae-4e97ffb3e850" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "B=\\{2,4,6,7\\}" :db/id #edb/ref 17592186422858} {:answer/id #uuid "bf4e5029-376f-5549-b5dc-630dc2b81f2a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "B=\\{2,6,12,14,32\\}" :db/id #edb/ref 17592186422889}] :answer-field/correct {:answer/id #uuid "bf4e5029-376f-5549-b5dc-630dc2b81f2a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "B=\\{2,6,12,14,32\\}" :db/id #edb/ref 17592186422889} :answer-field/id #uuid "2ced3dc9-18a6-5c14-baa5-67b07af90bd7" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186323263}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "f34c2a60-9466-5441-87ed-4e11996631ca" :question/math-academy-id "q-37265" :question/problem "Which of the following sets is a subset of $A=\\{2n∣n\\in N\\}?$" :question/worked-solution "First, we must find the elements of the set $A.$ The elements of the set \n$A$ are all the natural even numbers.\n\nSo, we have\n\n$$\nA=\\{2,4,6,8,…\\}.\n$$\n\nNow, a subset of $A$ is a set whose elements are also elements of the set $A.$\n\nIn our case, $B=\\{2,6,12,14,32\\}$ is a subset of $A.$\n\nIn the rest of the options, the set $B$ has elements that are not in $A,$ meaning that it is not a subset of $A.$"}] [{:db/id #edb/ref 17592186403037 :knowledge-point/_questions [{:db/id #edb/ref 17592186110658 :knowledge-point/id #uuid "0cd1bb61-2770-5096-83d6-d1e4a7189e9a" :knowledge-point/title "Working With Systems Containing \"Or Equal To\" Inequalities"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2507c4c0-57e5-598c-863a-a714f06c8cfc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\{\\begin{aligned}y\\ge 3x+1 \\\\ y\\ge 2\\end{aligned}" :db/id #edb/ref 17592186422761} {:answer/id #uuid "2e719e7a-6815-5841-a812-f052fcab11b3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\{\\begin{aligned}y\\le 3x+1 \\\\ y\\ge 2\\end{aligned}" :db/id #edb/ref 17592186422769} {:answer/id #uuid "9ba1a682-eb65-59eb-ad50-274d91174828" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\{\\begin{aligned}y\\ge 3x+1 \\\\ y\\le 2\\end{aligned}" :db/id #edb/ref 17592186422860} {:answer/id #uuid "b97e0003-6589-5fcd-8644-42dd6ffff85a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\{\\begin{aligned}y\\le 3x+1 \\\\ y\\le 2\\end{aligned}" :db/id #edb/ref 17592186422885} {:answer/id #uuid "cfc38a19-2695-5509-a01d-a49c31ad8f14" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\{\\begin{aligned}y\\ge 3x+1 \\\\ y<2\\end{aligned}" :db/id #edb/ref 17592186422899}] :answer-field/correct {:answer/id #uuid "2507c4c0-57e5-598c-863a-a714f06c8cfc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\{\\begin{aligned}y\\ge 3x+1 \\\\ y\\ge 2\\end{aligned}" :db/id #edb/ref 17592186422761} :answer-field/id #uuid "6391aa03-c66c-510d-8de3-714552c986fb" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186403038}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "9187138f-ae2f-5a56-952a-6135b67724bf" :question/math-academy-id "q-52413" :question/problem "![](images/75/75a7f3bfae55a97fbc0c05e2e0356d21de6ceabcc82ac3e1c965838a636f5ecc.png)\n\nWhich of the following systems of inequalities defines the shaded region shown above?" :question/worked-solution "Consider the line $y=3x+1.$ Since the line is solid, the inequality is an \"or equal to\" inequality. Also, since the shaded region lies *above* the line, the inequality is a \"greater than\" inequality. So the corresponding inequality is\n\n$$\ny\\ge 3x+1.\n$$\n\n    \n\nNow consider the line $y=2.$ Since the line is solid, the inequality is an \"or equal to\" inequality. Also, since the shaded region lies *above* the line, the inequality is a \"greater than\" inequality. So the corresponding inequality is\n\n$$\ny\\ge 2.\n$$\n\nTherefore, the system of inequalities that defines the shaded region is\n\n$$\n\\{\\begin{aligned}y\\ge 3x+1 \\\\ y\\ge 2.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186403044 :knowledge-point/_questions [{:db/id #edb/ref 17592186110651 :knowledge-point/id #uuid "fbd52408-5f2f-58c9-9a88-bd992fe8752c" :knowledge-point/title "Working With Systems Containing Strict Inequalities"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3c3c859a-fa1e-5f5c-9ccd-c25912b0662c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\{\\begin{aligned}y\\le 2x+6 \\\\ y\\le 5\\end{aligned}" :db/id #edb/ref 17592186422782} {:answer/id #uuid "45bc28e1-f02c-5435-8e27-a7fbd758f3b8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\{\\begin{aligned}y>2x+6 \\\\ y>5\\end{aligned}" :db/id #edb/ref 17592186422787} {:answer/id #uuid "9185f8e3-ce38-5543-a47b-19be664f85a6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\{\\begin{aligned}y<2x+6 \\\\ y<5\\end{aligned}" :db/id #edb/ref 17592186422849} {:answer/id #uuid "ae8d1241-b069-569c-a2c2-b0ca2c832a9d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\{\\begin{aligned}y<2x+6 \\\\ y>5\\end{aligned}" :db/id #edb/ref 17592186422879} {:answer/id #uuid "fbefe67e-aa24-5aa2-9d7e-b1ec293ead47" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\{\\begin{aligned}y>2x+6 \\\\ y<5\\end{aligned}" :db/id #edb/ref 17592186422927}] :answer-field/correct {:answer/id #uuid "9185f8e3-ce38-5543-a47b-19be664f85a6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\{\\begin{aligned}y<2x+6 \\\\ y<5\\end{aligned}" :db/id #edb/ref 17592186422849} :answer-field/id #uuid "057029ec-da64-5909-af01-3dd51581c107" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186403045}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "d48a81ca-ca4e-5354-bd11-f73315ba7d7f" :question/math-academy-id "q-52461" :question/problem "![](images/ba/ba01cf5268f2bd62835c925a5eb793c0d98663948899c9e9aba2eeacd37ff30a.png)\n\nWhich of the following systems of inequalities defines the shaded region shown above?" :question/worked-solution "Consider the line $y=2x+6.$ Since the line is dashed, the inequality is strict. Also, since the shaded region lies *below* the line, the inequality is a \"less than\" inequality. So the corresponding inequality is\n\n$$\ny<2x+6.\n$$\n\n    \n\nNow consider the line $y=5.$ Since the line is dashed, the inequality is strict. Also, since the shaded region lies *below* the line, the inequality is a \"less than\" inequality. So the corresponding inequality is\n\n$$\ny<5.\n$$\n\nTherefore, the system of inequalities that defines the shaded region is\n\n$$\n\\{\\begin{aligned}y<2x+6 \\\\ y<5.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186172596 :knowledge-point/_questions [{:db/id #edb/ref 17592186171957 :knowledge-point/id #uuid "9c976b6a-4523-51e1-a243-27aa8937db25" :knowledge-point/title "Expressing the Relationship Between the Rows of Pascal's Triangle in Terms of Binomial Coefficients"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "78ddad5a-92bc-5076-b3a4-c6e43df1cb7e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(\\genfrac{}{}{0pt}{}{1}{1})" :db/id #edb/ref 17592186422826} {:answer/id #uuid "805f4e52-0148-5922-8396-e0236216c0d8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(\\genfrac{}{}{0pt}{}{2}{1})" :db/id #edb/ref 17592186422833} {:answer/id #uuid "80b40976-92df-5d2c-86ee-4dc5ee7ca40b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(\\genfrac{}{}{0pt}{}{2}{0})" :db/id #edb/ref 17592186422835} {:answer/id #uuid "9a7a61d3-30ae-5e41-aea0-85e5dcd146d4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(\\genfrac{}{}{0pt}{}{1}{0})" :db/id #edb/ref 17592186422859} {:answer/id #uuid "e61bdf0f-ed23-51fc-a2c4-a20c5b93a968" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(\\genfrac{}{}{0pt}{}{2}{2})" :db/id #edb/ref 17592186422915}] :answer-field/correct {:answer/id #uuid "80b40976-92df-5d2c-86ee-4dc5ee7ca40b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(\\genfrac{}{}{0pt}{}{2}{0})" :db/id #edb/ref 17592186422835} :answer-field/id #uuid "25dbbbbc-4db9-57a7-8794-1b47f6589141" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186335310}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "1afc9131-fb54-545a-abcd-cbf497ee2da8" :question/math-academy-id "q-69669" :question/problem "Which expression is missing in the following equation?\n\n$$\n(\\genfrac{}{}{0pt}{}{3}{1})=[]+(\\genfrac{}{}{0pt}{}{2}{1})\n$$" :question/worked-solution "To find $(\\genfrac{}{}{0pt}{}{3}{1}),$ we need to find the number that is located in row $3$ and position $1$ of Pascal's triangle. \n\n**Important**: When counting the rows and positions in Pascal's triangle, we always start counting from zero! Remember:\n\n- The top row of Pascal's triangle is row $0.$\n\n- The first position of each row (the one of the left) is position number $0.$\n\nThe location of $(\\genfrac{}{}{0pt}{}{3}{1})$ in Pascal's triangle is highlighted below.\n\n$$\n\\begin{aligned} &  &  &  &  &  &  & (\\genfrac{}{}{0pt}{}{0}{0}) \\\\  &  &  &  &  &  & (\\genfrac{}{}{0pt}{}{1}{0}) &  & (\\genfrac{}{}{0pt}{}{1}{1}) \\\\  &  &  &  &  & (\\genfrac{}{}{0pt}{}{2}{0}) &  & (\\genfrac{}{}{0pt}{}{2}{1}) &  & (\\genfrac{}{}{0pt}{}{2}{2}) \\\\  &  &  &  & (\\genfrac{}{}{0pt}{}{3}{0}) &  & (\\genfrac{}{}{0pt}{}{3}{1}) &  & (\\genfrac{}{}{0pt}{}{3}{2}) &  & (\\genfrac{}{}{0pt}{}{3}{3}) \\\\  &  &  & ⋮ &  & ⋮ &  & ⋮ &  & ⋮ &  & ⋮\\end{aligned}\n$$\n\nNow, $(\\genfrac{}{}{0pt}{}{3}{1})$ is the sum of the two closest numbers located in the previous row. So,\n\n$$\n(\\genfrac{}{}{0pt}{}{3}{1})=(\\genfrac{}{}{0pt}{}{2}{0})+(\\genfrac{}{}{0pt}{}{2}{1})\n$$\n\nTherefore, the missing expression is $(\\genfrac{}{}{0pt}{}{2}{0}).$"}] [{:db/id #edb/ref 17592186335995 :knowledge-point/_questions [{:db/id #edb/ref 17592186171957 :knowledge-point/id #uuid "9c976b6a-4523-51e1-a243-27aa8937db25" :knowledge-point/title "Expressing the Relationship Between the Rows of Pascal's Triangle in Terms of Binomial Coefficients"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3d54b2a8-70b8-57d2-b26c-e1b263ac6824" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(\\genfrac{}{}{0pt}{}{1}{1})" :db/id #edb/ref 17592186422784} {:answer/id #uuid "4f61bb02-7c6b-599e-bcda-28faca2378f8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(\\genfrac{}{}{0pt}{}{2}{2})" :db/id #edb/ref 17592186422800} {:answer/id #uuid "7b20281e-3116-5c7a-9362-f88b58a1e766" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(\\genfrac{}{}{0pt}{}{1}{0})" :db/id #edb/ref 17592186422829} {:answer/id #uuid "809103a8-aba5-597f-b3d9-d4ff88026e05" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(\\genfrac{}{}{0pt}{}{2}{0})" :db/id #edb/ref 17592186422834} {:answer/id #uuid "a725e35f-5fa7-5d30-a593-8ae1d44e2785" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(\\genfrac{}{}{0pt}{}{2}{1})" :db/id #edb/ref 17592186422872}] :answer-field/correct {:answer/id #uuid "4f61bb02-7c6b-599e-bcda-28faca2378f8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(\\genfrac{}{}{0pt}{}{2}{2})" :db/id #edb/ref 17592186422800} :answer-field/id #uuid "e8ac1b6d-c8df-5a4f-8cb7-7837698f5128" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186335645}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "911738be-601f-52ff-bdd9-bde88253aa9f" :question/math-academy-id "q-69722" :question/problem "Which expression is missing in the following equation?\n\n$$\n(\\genfrac{}{}{0pt}{}{3}{2})=(\\genfrac{}{}{0pt}{}{2}{1})+[]\n$$" :question/worked-solution "To find $(\\genfrac{}{}{0pt}{}{3}{2}),$ we need to find the number that is located in row $3$ and position $2$ of Pascal's triangle. \n\n**Important**: When counting the rows and positions in Pascal's triangle, we always start counting from zero! Remember:\n\n- The top row of Pascal's triangle is row $0.$\n\n- The first position of each row (the one of the left) is position number $0.$\n\nThe location of $(\\genfrac{}{}{0pt}{}{3}{2})$ in Pascal's triangle is highlighted below.\n\n$$\n\\begin{aligned} &  &  &  &  &  &  & (\\genfrac{}{}{0pt}{}{0}{0}) \\\\  &  &  &  &  &  & (\\genfrac{}{}{0pt}{}{1}{0}) &  & (\\genfrac{}{}{0pt}{}{1}{1}) \\\\  &  &  &  &  & (\\genfrac{}{}{0pt}{}{2}{0}) &  & (\\genfrac{}{}{0pt}{}{2}{1}) &  & (\\genfrac{}{}{0pt}{}{2}{2}) \\\\  &  &  &  & (\\genfrac{}{}{0pt}{}{3}{0}) &  & (\\genfrac{}{}{0pt}{}{3}{1}) &  & (\\genfrac{}{}{0pt}{}{3}{2}) &  & (\\genfrac{}{}{0pt}{}{3}{3}) \\\\  &  &  & ⋮ &  & ⋮ &  & ⋮ &  & ⋮ &  & ⋮\\end{aligned}\n$$\n\nNow, $(\\genfrac{}{}{0pt}{}{3}{2})$ is the sum of the two closest numbers located in the previous row. So,\n\n$$\n(\\genfrac{}{}{0pt}{}{3}{2})=(\\genfrac{}{}{0pt}{}{2}{1})+(\\genfrac{}{}{0pt}{}{2}{2})\n$$\n\nTherefore, the missing expression is $(\\genfrac{}{}{0pt}{}{2}{2}).$"}] [{:db/id #edb/ref 17592186338838 :knowledge-point/_questions [{:db/id #edb/ref 17592186119826 :knowledge-point/id #uuid "9927bff1-c245-542b-8d5d-fa7d24188b85" :knowledge-point/title "Finding the Vector Equation of a Line Given in Canonical Form"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9435fa56-6ac3-5ce6-85af-c1c549b04ce8" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "None of the listed" :db/id #edb/ref 17592186337386} {:answer/id #uuid "2670e300-5558-54cf-aa24-1fbeb9d684b0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\{\\begin{aligned}x=-4+11t \\\\ y=5-3t \\\\ z=3-t\\end{aligned}" :db/id #edb/ref 17592186422763} {:answer/id #uuid "2aad0314-cdde-56d6-9fc9-f1e44fdcf531" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\{\\begin{aligned}x=-11-4t \\\\ y=3+5t \\\\ z=1+3t\\end{aligned}" :db/id #edb/ref 17592186422767} {:answer/id #uuid "4b7409a3-17df-5f35-9a98-53b2b56e27b0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\{\\begin{aligned}x=11-4t \\\\ y=-3+5t \\\\ z=-1+3t\\end{aligned}" :db/id #edb/ref 17592186422796} {:answer/id #uuid "b720935d-3a6b-53b7-8467-e0328c75249f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\{\\begin{aligned}x=-4t \\\\ y=5t \\\\ z=3t\\end{aligned}" :db/id #edb/ref 17592186422883}] :answer-field/correct {:answer/id #uuid "4b7409a3-17df-5f35-9a98-53b2b56e27b0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\{\\begin{aligned}x=11-4t \\\\ y=-3+5t \\\\ z=-1+3t\\end{aligned}" :db/id #edb/ref 17592186422796} :answer-field/id #uuid "ec3ec4fe-dbef-57ff-9f77-95dfde96d695" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186338687}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "cadd3ac4-4f87-567b-a331-c8cf0c3150d6" :question/math-academy-id "q-70866" :question/problem "Find the parametric equations of the line $\\frac{x-11}{-4}=\\frac{y+3}{5}=\\frac{z+1}{3}.$" :question/worked-solution "Remember that the Cartesian (canonical) equation of the straight line that passes through the point $P({x}_{0},{y}_{0},{z}_{0})$ and is parallel to the vector $v=⟨{v}_{x},{v}_{y},{v}_{z}⟩$, is given by\n\n$$\n\\frac{x-{x}_{0}}{{v}_{x}}=\\frac{y-{y}_{0}}{{v}_{y}}=\\frac{z-{z}_{0}}{{v}_{z}}=t,\\,t\\in (-\\infty ,\\infty ).\n$$\n\nComparing the above to our given equation\n\n$$\n\\frac{x-11}{-4}=\\frac{y-(-3)}{5}=\\frac{z-(-1)}{3},\n$$\n\nwe find that our line passes through the point $P(11,-3,-1)$ and is parallel to $v=⟨-4,5,3⟩.$ Therefore, its vector equation is\n\n$$\n\\begin{aligned}r & =p+tv \\\\ r & =[\\begin{aligned}11 \\\\ -3 \\\\ -1\\end{aligned}]+t[\\begin{aligned}-4 \\\\ 5 \\\\ 3\\end{aligned}],\\,t\\in (-\\infty ,\\infty ).\\end{aligned}\n$$\n\nTherefore, the parametric equations are the following:\n\n$$\n\\{\\begin{aligned}x=11-4t \\\\ y=-3+5t \\\\ z=-1+3t\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186351158 :knowledge-point/_questions [{:db/id #edb/ref 17592186054630 :knowledge-point/id #uuid "3cbddaef-3828-5454-b892-26a3c6242ddb" :knowledge-point/title "Finding All Subsets of a Given Set"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8560767a-af4e-5ac9-984b-0d56ecc22cf9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "∅,\\{-\\pi \\},\\{\\pi \\}" :db/id #edb/ref 17592186422838} {:answer/id #uuid "a581296f-1ffd-5680-83b4-0a132fb259d4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "∅,\\{-\\pi \\},\\{\\pi \\},\\{-\\pi ,\\pi \\}" :db/id #edb/ref 17592186422869} {:answer/id #uuid "a7e833ed-7b92-5b0e-ac1a-b54703f7a2bf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\{-\\pi \\},\\{\\pi \\},\\{-\\pi ,\\pi \\}" :db/id #edb/ref 17592186422873} {:answer/id #uuid "cceb7cd8-d3cb-5022-80c1-91cc18c492dd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\{-\\pi \\},\\{\\pi \\}" :db/id #edb/ref 17592186422897} {:answer/id #uuid "d6a266a0-5552-509f-ae6b-32ef2b01771f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "∅,\\{-\\pi ,\\pi \\}" :db/id #edb/ref 17592186422905}] :answer-field/correct {:answer/id #uuid "a581296f-1ffd-5680-83b4-0a132fb259d4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "∅,\\{-\\pi \\},\\{\\pi \\},\\{-\\pi ,\\pi \\}" :db/id #edb/ref 17592186422869} :answer-field/id #uuid "ef510875-8ddb-5754-836a-118c96470baf" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186351128}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "5ade80e9-fb10-5f67-9c65-ab5d8d98adbc" :question/math-academy-id "q-80809" :question/problem "Find all of the subsets of $U=\\{-\\pi ,\\pi \\}.$" :question/worked-solution "To find every subset of $U,$ we list out every combination of elements within $U.$ \n\nWe can use the following diagram to visualize the process:\n\n![](images/b0/b0e483a2d10cba17fb2bd3bf0e78d7b4d2fc07b22dbb5c492564b998bbfce6fc.png)\n\nNote that we must include the empty set since it is a subset of every set.\n\nBy doing this, we get\n\n$$\n∅,\\{-\\pi \\},\\{\\pi \\},\\{-\\pi ,\\pi \\}.\n$$"}] [{:db/id #edb/ref 17592186351176 :knowledge-point/_questions [{:db/id #edb/ref 17592186157285 :knowledge-point/id #uuid "67e90c94-5018-582f-8692-a1155f41f7c7" :knowledge-point/title "Finding Differences of Sets Given Verbally"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a284a9a8-2c8b-5360-8862-5fa84376ab51" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "∅" :db/id #edb/ref 17592186349897} {:answer/id #uuid "1eee49b7-7d23-57d3-be48-80546786725e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\{10,20,30,40,50,60,70,…\\}" :db/id #edb/ref 17592186422755} {:answer/id #uuid "3656c7be-564a-5dca-b523-f1cf8ca9939f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\{5,10,15,20,25,30,35,40,45,50,55,60,65,70,75,…\\}" :db/id #edb/ref 17592186422775} {:answer/id #uuid "d54904e8-c3f4-50ab-b94b-312c9c80dbb1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\{15,30,45,60,75,…\\}" :db/id #edb/ref 17592186422904} {:answer/id #uuid "e8c1a6ce-e81b-50b5-825e-bab71ce12858" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\{5,15,25,35,45,55,65,75,…\\}" :db/id #edb/ref 17592186422916}] :answer-field/correct {:answer/id #uuid "a284a9a8-2c8b-5360-8862-5fa84376ab51" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "∅" :db/id #edb/ref 17592186349897} :answer-field/id #uuid "adc8c03c-2db7-556e-a6d7-5bf3ef6dc447" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186351004}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "1076728a-78e3-5cde-ae2f-0952fd39a682" :question/math-academy-id "q-80876" :question/problem "Let $C$  be the set of all multiples of $10$ greater than $0$ and let $D$  be the the set of all multiples of $5$ greater than $0.$ What is $C∖D?$" :question/worked-solution "The multiples of $10$ that are greater than $0$ are\n\n$$\nC=\\{10,20,30,40,50,60,70,…\\}.\n$$\n\nLikewise, multiples of $5$ that are greater than $0$ are\n\n$$\nD=\\{5,10,15,20,25,30,35,40,45,50,55,60,65,70,75,…\\}.\n$$\n\nNow, $C∖D$ is the *difference* of $C$ and $D,$ which means that we want to find the elements that are in $C$ but *not* in $D.$\n\nThe elements of $C$ that are also in $D$ are $10,20,30,40,$ and so on (i.e. multiples of $10$). So, we must remove these elements from $C.$ Therefore, we have\n\n$$\n\\begin{aligned}C∖D & =C-D \\\\  & =\\{10,20,30,40,50,60,70,…\\}-\\{5,10,15,20,25,30,35,40,45,50,55,60,65,70,75,…\\} \\\\  & =∅.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186351258 :knowledge-point/_questions [{:db/id #edb/ref 17592186157287 :knowledge-point/id #uuid "9a55a708-abb0-5e23-8862-153561d022c8" :knowledge-point/title "Finding the Complement of a Set Without a Venn Diagram"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0ae8da4d-49d1-5d59-b5f2-9ba7fac1a5ce" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\{1,3,6,9\\}" :db/id #edb/ref 17592186422748} {:answer/id #uuid "32175474-2a33-5edd-82d1-ca23fe06b582" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\{1,3,5,7,9\\}" :db/id #edb/ref 17592186422773} {:answer/id #uuid "5b05c18c-16d7-52fb-815b-13f340ae470d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\{1,2,3,4,5,6,7,8,9\\}" :db/id #edb/ref 17592186422809} {:answer/id #uuid "62686a45-f9e0-5352-8bd0-280e32a4a7dd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\{3,5,7,9\\}" :db/id #edb/ref 17592186422811} {:answer/id #uuid "8e2a7810-134a-59c6-95e0-9e32883d711d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\{0,3,6,9\\}" :db/id #edb/ref 17592186422845}] :answer-field/correct {:answer/id #uuid "32175474-2a33-5edd-82d1-ca23fe06b582" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\{1,3,5,7,9\\}" :db/id #edb/ref 17592186422773} :answer-field/id #uuid "21188bb3-7c29-56d5-bce0-52b90aee9ec7" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186350765}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "35334f88-cecb-5c05-827d-5c2f77f4118a" :question/math-academy-id "q-81203" :question/problem "If $U=\\{1,2,3,…,10\\}$ is the universal set and $A=\\{2,4,6,8,10\\},$ then the complement of $A$ is" :question/worked-solution "The complement of $A,$ denoted $\\overset{―}{A},$ consists of every element in the universal set $U$ that is not in the set $A.$\n\nThe elements of $U$ that are not in $A$ are $1,$ $3,$ $5,$ $7,$ and $9.$\n\nTherefore, the complement of $A$ is\n\n$$\n\\overset{―}{A}=\\{1,3,5,7,9\\}.\n$$"}] [{:db/id #edb/ref 17592186351259 :knowledge-point/_questions [{:db/id #edb/ref 17592186157288 :knowledge-point/id #uuid "49251196-c06b-5718-82e6-5ed9450301af" :knowledge-point/title "Finding the Complement of a Set Given Using Ellipsis Notation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "16477003-cf0b-5c83-86c6-010a4fd01ccd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\{-18,-14,-10,-6,-2,2,6,10,14,18\\}" :db/id #edb/ref 17592186422749} {:answer/id #uuid "1f9b53a9-1ace-522a-a982-9f2273e85246" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\{-16,-14,-12,-10,…,16\\}" :db/id #edb/ref 17592186422756} {:answer/id #uuid "3943ae65-9d1c-52ad-ac6f-f19c4854ec2a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\{-18,-16,-14,-12,…,18\\}" :db/id #edb/ref 17592186422779} {:answer/id #uuid "92200749-20dc-58fb-8a4b-402b623d1530" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\{-20,-16,-12,-8,-4,0,4,8,12,16\\}" :db/id #edb/ref 17592186422850} {:answer/id #uuid "aca7987c-36a3-5372-90f4-1bc62f2eb30e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\{-18,-12,-6,0,6,12,18\\}" :db/id #edb/ref 17592186422875}] :answer-field/correct {:answer/id #uuid "16477003-cf0b-5c83-86c6-010a4fd01ccd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\{-18,-14,-10,-6,-2,2,6,10,14,18\\}" :db/id #edb/ref 17592186422749} :answer-field/id #uuid "a2ba48f4-bfb9-53b1-b63c-347212329c4e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186350983}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "99c47e36-6326-59cd-8a70-c88572cc5f54" :question/math-academy-id "q-81205" :question/problem "If $U=\\{-20,-18,-16,-14,…,20\\}$ is the universal set and $A=\\{-20,-16,-12,-8,…,20\\},$ then $\\overset{―}{A}=$" :question/worked-solution "The complement of $A,$ denoted $\\overset{―}{A},$ consists of every element in the universal set $U$ that is not in the set $A.$\n\nThe universal set $U$ consists of the even integers $-20$ through $20,$ while the set $A$ consists of the multiples of $4$ from $-20$ through $20.$\n\nSo, the only elements of $U$ that are not in $A$ are the even integers from $-18$ through $18$ that are not multiples of $4.$\n\nTherefore, the complement of $A$ is\n\n$$\n\\overset{―}{A}=\\{-18,-14,-10,-6,-2,2,6,10,14,18\\}.\n$$"}] [{:db/id #edb/ref 17592186351347 :knowledge-point/_questions [{:db/id #edb/ref 17592186157289 :knowledge-point/id #uuid "4687dcd7-a5ab-5dc6-be6d-89d806a61a02" :knowledge-point/title "Finding a Difference of Sets Using a Venn Diagram"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3e57db84-9532-5a86-b209-39f3021ccc79" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\{t,e,l,a,s,w,d\\}" :db/id #edb/ref 17592186422785} {:answer/id #uuid "44d69e04-701b-532a-8660-e10b61e27da0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\{a,s,w,d\\}" :db/id #edb/ref 17592186422786} {:answer/id #uuid "6386c1eb-6556-5007-86bd-5b23aac19731" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\{p,o,r\\}" :db/id #edb/ref 17592186422812} {:answer/id #uuid "c0ebd0cd-50f3-5d9b-b33d-13fa3b3356f9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\{p,a,s,t,e,l\\}" :db/id #edb/ref 17592186422891} {:answer/id #uuid "cde8a77d-917c-5d32-aebb-5d7a0c324a5d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\{t,e,l\\}" :db/id #edb/ref 17592186422898}] :answer-field/correct {:answer/id #uuid "cde8a77d-917c-5d32-aebb-5d7a0c324a5d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\{t,e,l\\}" :db/id #edb/ref 17592186422898} :answer-field/id #uuid "121ca97a-caf0-5257-b942-d39008348aee" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186350742}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "065e9298-e9b9-5450-a8e3-c9e554981a9b" :question/math-academy-id "q-81695" :question/problem "![](images/3b/3b539190899ca580528fdbf7b5d3ef9925ade29f97f4b2f96b0f1394743f40a8.png)\n\nGiven the sets $S=\\{p,a,s,w,o,r,d\\}$ and $T=\\{p,o,r,t,e,l\\},$ find $T∖S.$" :question/worked-solution "The difference $T∖S$ consists of all the elements that are in $T$ but not $S.$ To represent $T∖S,$ we will shade in all the area that is contained in $T$ but not $S.$\n\n![](images/c7/c718918667c5076f8696ea98f453ff17f005d5f7cace87bd863be309fac28d72.png)\n\nThe elements $t,e,$ and $l$ are in $T$ but not $S.$\n\nTherefore, the difference is\n\n$$\nT∖S=\\{t,e,l\\}.\n$$"}] [{:db/id #edb/ref 17592186351367 :knowledge-point/_questions [{:db/id #edb/ref 17592186157285 :knowledge-point/id #uuid "67e90c94-5018-582f-8692-a1155f41f7c7" :knowledge-point/title "Finding Differences of Sets Given Verbally"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3caf765e-af4f-5636-a6be-d1ba59a6b778" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\{3,4,6,8,9,15,16,…\\}" :db/id #edb/ref 17592186422783} {:answer/id #uuid "469ad4f5-346a-5a0c-a575-a0d28114f6c9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\{3,6,9,15,18,21,…\\}" :db/id #edb/ref 17592186422788} {:answer/id #uuid "59d2bdb8-067c-5558-99a7-7af0349458cd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\{0,3,6,9,15,18,21,…\\}" :db/id #edb/ref 17592186422808} {:answer/id #uuid "8ad10406-2414-5636-81d1-8eab697da0a6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\{12,24…\\}" :db/id #edb/ref 17592186422842} {:answer/id #uuid "b6cb932c-85b3-56d0-b40c-f7eaaf738441" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\{4,8,16,20,…\\}" :db/id #edb/ref 17592186422882}] :answer-field/correct {:answer/id #uuid "b6cb932c-85b3-56d0-b40c-f7eaaf738441" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\{4,8,16,20,…\\}" :db/id #edb/ref 17592186422882} :answer-field/id #uuid "0902a368-1e16-5c70-8a0c-b4b8645ecb9c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186350721}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "08cc3802-c796-53b6-b40f-b3be60f49c05" :question/math-academy-id "q-81766" :question/problem "Let $A$  be the set of all multiples of $3$ greater than $0$ and let $B$  be the set of all multiples of $4$ greater than $0.$ What is $B-A?$" :question/worked-solution "The multiples of $3$ that are greater than $0$ are\n\n$$\nA=\\{3,6,9,12,15,18,21,24,…\\}.\n$$\n\nLikewise, multiples of $4$ that are greater than $0$ are\n\n$$\nB=\\{4,8,12,16,20,24,…\\}.\n$$\n\nNow, $B-A$ is the *difference* of $B$ and $A,$ which means that we want to find the elements that are in $B$ but *not* in $A.$\n\nThe elements of $B$ that are also in $A$ are $12,24,$ and so on (i.e. multiples of $12$). So, we must remove these elements from $B.$ Therefore, we have\n\n$$\n\\begin{aligned}B-A & =\\{4,8,12,16,20,24,…\\}-\\{3,6,9,12,15,18,21,24,…\\} \\\\  & =\\{4,8,16,20,…\\}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186354480 :knowledge-point/_questions [{:db/id #edb/ref 17592186157286 :knowledge-point/id #uuid "19fb3196-439e-5466-b50c-615c492167b4" :knowledge-point/title "Finding the Complement of a Set Using a Venn Diagram"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "22020fe8-3d17-509a-ba0b-2431b2f443de" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\{a,b,c\\}" :db/id #edb/ref 17592186422758} {:answer/id #uuid "5295dfc9-a8d9-5012-aa1a-6489385fb437" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\{a,c\\}" :db/id #edb/ref 17592186422803} {:answer/id #uuid "6aa239f7-6bc9-5d19-a04a-3903bf7b1d89" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\{a,40\\}" :db/id #edb/ref 17592186422815} {:answer/id #uuid "81c96ee9-b80c-53be-8db0-4ae74de56f46" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\{20,40\\}" :db/id #edb/ref 17592186422836} {:answer/id #uuid "da7a201d-4e4b-50a4-a478-467f445ad325" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\{c,40\\}" :db/id #edb/ref 17592186422907}] :answer-field/correct {:answer/id #uuid "5295dfc9-a8d9-5012-aa1a-6489385fb437" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\{a,c\\}" :db/id #edb/ref 17592186422803} :answer-field/id #uuid "0ea4e7ef-a234-58ac-9208-db95f3628325" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186353842}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "4434ccc8-02d5-5a76-9c36-2b57d531d580" :question/math-academy-id "q-86587" :question/problem "![](images/02/02dabe7099c201f717885a05842e0cb8543bd01cccf0d6c52147f674cde15dce.png)\n\nLet $U=\\{a,b,c,20,40\\}$ be the universal set and let $R=\\{b,20,40\\}.$ What is the complement of $R?$" :question/worked-solution "The complement of $R,$ denoted $\\overset{―}{R},$ consists of all the elements in $U$ that are not in $R.$ To represent $\\overset{―}{R},$ we will shade in all the area of $U$ that is *outside* of $R,$ as follows:\n\n![](images/79/79900f22c35570b35cf10664768ecf4460a7953ddf7f91dac1893b3ce81339bf.png)\n\nThe elements in the shaded area are $a$ and $c.$ These are the elements of $U$ that are not in $R.$ Therefore, the complement of $R$ is\n\n$$\n\\overset{―}{R}=\\{a,c\\}.\n$$"}] [{:db/id #edb/ref 17592186354481 :knowledge-point/_questions [{:db/id #edb/ref 17592186157287 :knowledge-point/id #uuid "9a55a708-abb0-5e23-8862-153561d022c8" :knowledge-point/title "Finding the Complement of a Set Without a Venn Diagram"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "35957b83-2a68-58c6-869c-f6146120f1db" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\{4,8,12\\}" :db/id #edb/ref 17592186422774} {:answer/id #uuid "49084c79-d854-50d1-b930-1bc749d78ada" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\{4,8,10,12\\}" :db/id #edb/ref 17592186422791} {:answer/id #uuid "4e158fb2-27a7-51b7-ac36-dee0da33f3b4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\{2,4,8,12\\}" :db/id #edb/ref 17592186422799} {:answer/id #uuid "670ae3f8-93f9-5d03-9ecb-0dfcaa09ffbe" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\{4,12\\}" :db/id #edb/ref 17592186422814} {:answer/id #uuid "71202aab-95d1-5922-b4cf-8610084c1a4c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\{4,8\\}" :db/id #edb/ref 17592186422821}] :answer-field/correct {:answer/id #uuid "35957b83-2a68-58c6-869c-f6146120f1db" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\{4,8,12\\}" :db/id #edb/ref 17592186422774} :answer-field/id #uuid "a2f9adc9-b73b-54e9-ac8c-1d5f98dfb7ee" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186354100}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "04125aec-6df3-511f-bf67-6f782ff92bbb" :question/math-academy-id "q-86590" :question/problem "If $U=\\{2,4,6,8,10,12\\}$ is the universal set and $B=\\{2,6,10\\},$ then the complement of $B$ is" :question/worked-solution "The complement of $B,$ denoted $\\overset{―}{B},$ consists of every element in the universal set $U$ that is not in the set $B.$\n\nThe elements of $U$ that are not in $B$ are $4,$ $8,$   and $12.$\n\nTherefore, the complement of $B$ is\n\n$$\n\\overset{―}{B}=\\{4,8,12\\}.\n$$"}] [{:db/id #edb/ref 17592186354497 :knowledge-point/_questions [{:db/id #edb/ref 17592186157289 :knowledge-point/id #uuid "4687dcd7-a5ab-5dc6-be6d-89d806a61a02" :knowledge-point/title "Finding a Difference of Sets Using a Venn Diagram"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1dbc40ae-f26c-5818-bfd4-bddc3ecd358a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "∅" :db/id #edb/ref 17592186351832} {:answer/id #uuid "1a0f4d4a-32b2-546c-9f78-4d850b9be5a7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\{0,1,3,5,7,9\\}" :db/id #edb/ref 17592186422750} {:answer/id #uuid "62474c25-a7fa-510e-996c-b49c4b498820" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\{5,7\\}" :db/id #edb/ref 17592186422810} {:answer/id #uuid "774c28d2-891a-5484-8cb3-157bc707a2b6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\{0,1,3\\}" :db/id #edb/ref 17592186422825} {:answer/id #uuid "c624021e-1fb1-5744-8539-f9b2fa9ef8eb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\{5,7,9\\}" :db/id #edb/ref 17592186422892}] :answer-field/correct {:answer/id #uuid "c624021e-1fb1-5744-8539-f9b2fa9ef8eb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\{5,7,9\\}" :db/id #edb/ref 17592186422892} :answer-field/id #uuid "912b3d79-97df-5c30-a3f5-eec985f87656" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186354073}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "af7efa2c-3ffa-5821-9cbc-8c2275ebe689" :question/math-academy-id "q-86701" :question/problem "![](images/96/96962d11526f30beee45b85aac92808518352d7b79b4b4f2e4a7351ddd9fe17e.png)\n\nGiven the sets $S=\\{5,7,9\\}$ and $T=\\{0,1,3\\},$find $S∖T.$" :question/worked-solution "The difference $S∖T$ consists of all the elements that are in $S$ but not $T.$ To represent $S∖T,$ we will shade in all the area that is contained in $S$ but not $T.$\n\n![](images/be/be1caefc99bea5d4dde0ba272a208dd8f587156029ce37df483e40cd5f6121d2.png)\n\nAll elements of $S$ are not in $T.$\n\nTherefore, the difference is\n\n$$\nS∖T=\\{5,7,9\\}.\n$$"}] [{:db/id #edb/ref 17592186404461 :knowledge-point/_questions [{:db/id #edb/ref 17592186110653 :knowledge-point/id #uuid "42525832-e186-538f-baf8-bb4418e9820b" :knowledge-point/title "Working With Systems Containing Inequalities Presented in Standard Form"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "27635777-a8dd-5afe-a296-ee402af7fe39" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\{\\begin{aligned}x+y>3 \\\\ y>2x\\end{aligned}" :db/id #edb/ref 17592186422764} {:answer/id #uuid "480417bf-3b78-555e-8194-c8ef38995e34" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\{\\begin{aligned}x+y>3 \\\\ y<2x\\end{aligned}" :db/id #edb/ref 17592186422789} {:answer/id #uuid "6f580ecb-7efc-5512-9398-273631dd1bd9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\{\\begin{aligned}x+y<3 \\\\ y>2x\\end{aligned}" :db/id #edb/ref 17592186422819} {:answer/id #uuid "7fa72215-7cb2-51f3-b5db-2adac83c439f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\{\\begin{aligned}x+y<3 \\\\ y<2x\\end{aligned}" :db/id #edb/ref 17592186422832} {:answer/id #uuid "b0260bc6-012f-5b9c-a80e-93287d27b6c3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\{\\begin{aligned}x+y\\le 3 \\\\ y\\ge 2x\\end{aligned}" :db/id #edb/ref 17592186422880}] :answer-field/correct {:answer/id #uuid "27635777-a8dd-5afe-a296-ee402af7fe39" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\{\\begin{aligned}x+y>3 \\\\ y>2x\\end{aligned}" :db/id #edb/ref 17592186422764} :answer-field/id #uuid "8c5be21f-60e7-597b-83dc-3c20339aa469" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186404462}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "262609c0-5557-5285-b43c-f82fdb8825a5" :question/math-academy-id "q-90054" :question/problem "![](images/b8/b8c1d5902a76a68e5f8358d4c3668e1be184ec7241184df4ff1363d41995f3aa.png)\n\nWhich of the following systems of inequalities defines the shaded region shown above?" :question/worked-solution "Consider the line $x+y=3.$ Since the line is dashed, the inequality is strict. Writing the equation of this line in slope-intercept form, we have\n\n$$\ny=-x+3.\n$$\n\nNow, since the shaded region lies *above* the line, the inequality is a \"greater than\"  inequality. So the corresponding inequality is\n\n$$\ny>-x+3,\n$$\n\n    \n\nwhich we can rewrite as\n\n$$\nx+y>3.\n$$\n\nNow consider the line $y=2x.$ Since the line is dashed, the inequality is strict.  Also, since the shaded region lies *above* the line, the inequality is a \"greater than\" inequality. So the corresponding inequality is\n\n$$\ny>2x.\n$$\n\nTherefore, the system of inequalities that defines the shaded region is\n\n$$\n\\{\\begin{aligned}x+y>3 \\\\ y>2x.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186404468 :knowledge-point/_questions [{:db/id #edb/ref 17592186110651 :knowledge-point/id #uuid "fbd52408-5f2f-58c9-9a88-bd992fe8752c" :knowledge-point/title "Working With Systems Containing Strict Inequalities"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "21f1cf91-2163-5bf5-8bdd-17c06cfb56f3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\{\\begin{aligned}y>4x+3 \\\\ y\\ge \\frac{1}{4}x-2\\end{aligned}" :db/id #edb/ref 17592186422757} {:answer/id #uuid "49247309-afac-5793-a965-e29d26e684cb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\{\\begin{aligned}y\\le 4x+3 \\\\ y>\\frac{1}{4}x-2\\end{aligned}" :db/id #edb/ref 17592186422792} {:answer/id #uuid "8ff44b6f-7f18-5b59-b687-6bfafa9923c1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\{\\begin{aligned}y>4x+3 \\\\ y<\\frac{1}{4}x-2\\end{aligned}" :db/id #edb/ref 17592186422848} {:answer/id #uuid "c6b98254-dc2c-5569-ba7c-775a46563922" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\{\\begin{aligned}y>4x+3 \\\\ y>\\frac{1}{4}x-2\\end{aligned}" :db/id #edb/ref 17592186422893} {:answer/id #uuid "fbeae658-1ad6-5399-b8e3-d95d56f3c62b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\{\\begin{aligned}y<4x+3 \\\\ y>\\frac{1}{4}x-2\\end{aligned}" :db/id #edb/ref 17592186422926}] :answer-field/correct {:answer/id #uuid "fbeae658-1ad6-5399-b8e3-d95d56f3c62b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\{\\begin{aligned}y<4x+3 \\\\ y>\\frac{1}{4}x-2\\end{aligned}" :db/id #edb/ref 17592186422926} :answer-field/id #uuid "94914b35-e16f-5398-9a50-4baddb153e6e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186404469}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "66b0d8c5-2487-53cc-b840-b06edcc12d56" :question/math-academy-id "q-90323" :question/problem "![](images/e8/e863789ff989ee1cb3d3fe6c22fe0d4daa1dac76d6fbfbebdad801006ca4c969.png)\n\nWhich of the following systems of inequalities defines the shaded region shown above?" :question/worked-solution "Consider the line $y=4x+3.$ Since the line is dashed, the inequality is strict. Also, since the shaded region lies *below* the line, the inequality is a \"less than\" inequality. So the corresponding inequality is\n\n$$\ny<4x+3.\n$$\n\n    \n\nNow consider the line $y=\\frac{1}{4}x-2.$ Since the line is dashed, the inequality is strict. Also, since the shaded region lies *above* the line, the inequality is a \"greater than\" inequality. So the corresponding inequality is\n\n$$\ny>\\frac{1}{4}x-2.\n$$\n\nTherefore, the system of inequalities that defines the shaded region is\n\n$$\n\\{\\begin{aligned}y<4x+3 \\\\ y>\\frac{1}{4}x-2.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186404475 :knowledge-point/_questions [{:db/id #edb/ref 17592186110652 :knowledge-point/id #uuid "a258070e-5c3c-595e-81d6-3e0f9b9a5daf" :knowledge-point/title "Working With Systems Containing Mixed Inequalities"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8760f28c-314a-5353-a151-1773d06194c2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\{\\begin{aligned}y>x+2 \\\\ y\\le -x+2\\end{aligned}" :db/id #edb/ref 17592186422840} {:answer/id #uuid "a6ae492d-6998-592e-aad4-9e4158c3d62a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\{\\begin{aligned}y<x+2 \\\\ y\\ge -x+2\\end{aligned}" :db/id #edb/ref 17592186422871} {:answer/id #uuid "d086efec-878a-5d60-959f-69c0d1d6a64c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\{\\begin{aligned}y\\ge x+2 \\\\ y<-x+2\\end{aligned}" :db/id #edb/ref 17592186422900} {:answer/id #uuid "dfc950a4-a4b3-574a-9a32-22ca9de0541d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\{\\begin{aligned}y\\le x+2 \\\\ y\\ge -x+2\\end{aligned}" :db/id #edb/ref 17592186422910} {:answer/id #uuid "ea85fa77-5fe3-59b1-a642-7a3377ab8ed7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\{\\begin{aligned}y\\le x+2 \\\\ y>-x+2\\end{aligned}" :db/id #edb/ref 17592186422917}] :answer-field/correct {:answer/id #uuid "ea85fa77-5fe3-59b1-a642-7a3377ab8ed7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\{\\begin{aligned}y\\le x+2 \\\\ y>-x+2\\end{aligned}" :db/id #edb/ref 17592186422917} :answer-field/id #uuid "f86fe5f2-d23c-5598-bb24-07f9f597ec1a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186404476}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "3e5e2c49-2afd-5324-972b-43974f8bfdd9" :question/math-academy-id "q-90327" :question/problem "![](images/76/762e53967ddb3ccddfa1c9b7a2aa303d66fc1b761c9be8f409c0b91ecb0201de.png)\n\nWhich of the following systems of inequalities represents the shaded region shown in the graph above?" :question/worked-solution "Consider the line $y=x+2.$ Since the line is solid, the inequality is an \"or equal to\" inequality. Also, since the shaded region lies *below* the line, the inequality is a \"less than\" inequality. So the corresponding inequality is\n\n$$\ny\\le x+2.\n$$\n\n    \n\nNow consider the line $y=-x+2.$ Since the line is dashed, the inequality is strict. Also, since the shaded region lies *above* the line, the inequality is a \"greater than\" inequality. So the corresponding inequality is\n\n$$\ny>-x+2.\n$$\n\nTherefore, the system of inequalities that defines the shaded region is\n\n$$\n\\{\\begin{aligned}y\\le x+2 \\\\ y>-x+2.\\end{aligned}\n$$"}]}
