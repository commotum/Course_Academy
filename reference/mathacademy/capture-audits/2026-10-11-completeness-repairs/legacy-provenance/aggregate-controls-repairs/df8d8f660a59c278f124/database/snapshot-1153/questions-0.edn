#{[{:db/id #edb/ref 17592186237878 :knowledge-point/_questions [{:db/id #edb/ref 17592186157286 :knowledge-point/id #uuid "19fb3196-439e-5466-b50c-615c492167b4" :knowledge-point/title "Finding the Complement of a Set Using a Venn Diagram"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "39957d77-14fe-5afa-b55e-fc5c5516d904" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\{m,n\\}" :db/id #edb/ref 17592186422780} {:answer/id #uuid "4a9cf07e-f5b9-520a-9ad5-197f7e218f70" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\{l,m,n,o\\}" :db/id #edb/ref 17592186422794} {:answer/id #uuid "514f2e88-12df-5701-b9d7-b5ac210719ae" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\{m\\}" :db/id #edb/ref 17592186422802} {:answer/id #uuid "64bd11a0-bdcc-5e85-b42d-a6873a171fc8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\{l,m,n\\}" :db/id #edb/ref 17592186422813} {:answer/id #uuid "79ed194c-0f65-59da-943b-f2c0c42ad0b9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\{n\\}" :db/id #edb/ref 17592186422827}] :answer-field/correct {:answer/id #uuid "79ed194c-0f65-59da-943b-f2c0c42ad0b9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\{n\\}" :db/id #edb/ref 17592186422827} :answer-field/id #uuid "b3fb0c0d-1d27-592b-96c1-d094c4cc9822" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186237670}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "5a339fd3-f450-5a9a-b0dd-ff8dba5b4293" :question/math-academy-id "q-102246" :question/problem "![](images/95/95f7caf5956ab22fe5b47d14098730e23332c41a26d58fc8dc0f0e4ca28546ab.png)\n\nLet $U=\\{l,m,n,o\\}$ be the universal set and let $K=\\{l,m,o\\}.$ What is $\\overset{―}{K}?$" :question/worked-solution "The complement of $K,$ denoted $\\overset{―}{K},$ consists of all the elements in $U$ that are not in $K.$ To represent $\\overset{―}{K},$ we will shade in all the area of $U$ that is *outside* of $K,$ as follows:\n\n![](images/74/74345aeb2a1028e07d155dd357a9bb412860309c99cee37c62380907b3e1bd37.png)\n\nThe element in the shaded area is $n.$ This is the only element of $U$ that is not in $K.$ Therefore, the complement of $K$ is\n\n$$\n\\overset{―}{K}=\\{n\\}.\n$$"}] [{:db/id #edb/ref 17592186240999 :knowledge-point/_questions [{:db/id #edb/ref 17592186157287 :knowledge-point/id #uuid "9a55a708-abb0-5e23-8862-153561d022c8" :knowledge-point/title "Finding the Complement of a Set Without a Venn Diagram"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "092d96cc-31d1-57b6-b25f-cb1f645761fb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\{2,6,10,18\\}" :db/id #edb/ref 17592186422747} {:answer/id #uuid "30e9f955-9c5f-5995-8b92-02a7c9a66c34" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\{2,6,10,14\\}" :db/id #edb/ref 17592186422772} {:answer/id #uuid "590e2e96-c4ed-5c5c-bd74-ac6935a254f4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\{0,2,6,10,14,18\\}" :db/id #edb/ref 17592186422807} {:answer/id #uuid "9a07857f-9b04-5e82-82b2-f3b3a50169ba" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\{2,6,10,14,18\\}" :db/id #edb/ref 17592186422857} {:answer/id #uuid "dc7d8ee0-c616-5f34-81ae-9932e04e4685" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\{6,10,14,18\\}" :db/id #edb/ref 17592186422908}] :answer-field/correct {:answer/id #uuid "9a07857f-9b04-5e82-82b2-f3b3a50169ba" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\{2,6,10,14,18\\}" :db/id #edb/ref 17592186422857} :answer-field/id #uuid "0c294f44-fff5-5b15-a966-35cefb0a5204" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186240345}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "32ae7bbc-249c-5c79-aba5-9c3291b509c7" :question/math-academy-id "q-105179" :question/problem "If $U=\\{2,4,6,8,…,20\\}$ is the universal set and $B=\\{4,8,12,16,20\\},$ then the complement of $B$ is" :question/worked-solution "The complement of $B,$ denoted $\\overset{―}{B},$ consists of every element in the universal set $U$ that is not in the set $B.$\n\nThe elements of $U$ that are not in $B$ are $2,$ $6,$ $10,$ $14,$ and $18.$\n\nTherefore, the complement of $B$ is\n\n$$\n\\overset{―}{B}=\\{2,6,10,14,18\\}.\n$$"}] [{:db/id #edb/ref 17592186241005 :knowledge-point/_questions [{:db/id #edb/ref 17592186157288 :knowledge-point/id #uuid "49251196-c06b-5718-82e6-5ed9450301af" :knowledge-point/title "Finding the Complement of a Set Given Using Ellipsis Notation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1bf1ba90-d97e-56e1-8be0-67555fe8bfec" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\{j,k,l…,z\\}" :db/id #edb/ref 17592186422752} {:answer/id #uuid "3b4fe627-d7c1-50a5-a27e-4f77766ccffc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\{i,j,k,…,z\\}" :db/id #edb/ref 17592186422781} {:answer/id #uuid "7c72eb67-dc8d-5199-baad-e8806a1db03d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\{k,l,m,…,z\\}" :db/id #edb/ref 17592186422831} {:answer/id #uuid "84ffc0a6-3416-5aad-a60b-0475613c9718" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\{m,n,o…,z\\}" :db/id #edb/ref 17592186422837} {:answer/id #uuid "d249a876-1cdc-59b3-9cf5-a76a41e27fb1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\{l,m,n…,z\\}" :db/id #edb/ref 17592186422901}] :answer-field/correct {:answer/id #uuid "7c72eb67-dc8d-5199-baad-e8806a1db03d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\{k,l,m,…,z\\}" :db/id #edb/ref 17592186422831} :answer-field/id #uuid "969e0b9d-d3d2-5f29-a98a-b20b18e9c6f0" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186240596}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "3aa7531f-69fb-514d-bcea-7f5e2dae1a2a" :question/math-academy-id "q-105188" :question/problem "Let $U=\\{a,b,c,…,z\\}$ be the universal set and $Y=\\{a,b,c,…,j\\}$, then $\\overset{―}{Y}=$" :question/worked-solution "The complement of $Y,$ denoted $\\overset{―}{Y},$ consists of every element in the universal set $U$ that is not in the set $Y.$\n\nThe universal set $U$ consists of the letters $a$ through $z,$ while the set $Y$ consists of the letters $a$ through $j.$\n\nSo, the only elements of $U$ that are not in $Y$ are the letters $k$ through $z.$\n\nTherefore, the complement of $Y$ is\n\n$$\n\\overset{―}{Y}=\\{k,l,m,…,z\\}.\n$$"}] [{:db/id #edb/ref 17592186399685 :knowledge-point/_questions [{:db/id #edb/ref 17592186110653 :knowledge-point/id #uuid "42525832-e186-538f-baf8-bb4418e9820b" :knowledge-point/title "Working With Systems Containing Inequalities Presented in Standard Form"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2ba7e269-52f8-5419-b3c2-ce59a9e64ef4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\{\\begin{aligned}x+2y\\ge -8 \\\\ y\\ge \\frac{1}{2}x+1\\end{aligned}" :db/id #edb/ref 17592186422768} {:answer/id #uuid "510522b1-69d4-55a5-928c-930d7659e841" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\{\\begin{aligned}x+2y\\le -8 \\\\ y\\ge \\frac{1}{2}x+1\\end{aligned}" :db/id #edb/ref 17592186422801} {:answer/id #uuid "55750735-57ef-5704-978f-016957530d23" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\{\\begin{aligned}x+2y>-8 \\\\ y>\\frac{1}{2}x+1\\end{aligned}" :db/id #edb/ref 17592186422805} {:answer/id #uuid "9cea3798-a1cb-5294-bc97-fc263be948fc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\{\\begin{aligned}x+2y\\le -8 \\\\ y\\le \\frac{1}{2}x+1\\end{aligned}" :db/id #edb/ref 17592186422863} {:answer/id #uuid "e2fad8bd-39bf-566b-87a3-d1e291f8834c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\{\\begin{aligned}x+2y\\ge -8 \\\\ y\\le \\frac{1}{2}x+1\\end{aligned}" :db/id #edb/ref 17592186422914}] :answer-field/correct {:answer/id #uuid "e2fad8bd-39bf-566b-87a3-d1e291f8834c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\{\\begin{aligned}x+2y\\ge -8 \\\\ y\\le \\frac{1}{2}x+1\\end{aligned}" :db/id #edb/ref 17592186422914} :answer-field/id #uuid "fce68956-d8ec-5373-80c1-0576c6b35476" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186399686}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "b9a72356-7e05-5f10-b6ac-a2418c3b4fa6" :question/math-academy-id "q-110078" :question/problem "![](images/39/3905dacc3977857933a48ced329fc245b357f732aec520e67998efc0b5d7cdab.png)\n\nWhich of the following systems of inequalities defines the shaded region shown above?" :question/worked-solution "Consider the line $x+2y=-8.$ Since the line is solid, the inequality is an \"or equal to\" inequality. Writing the equation of this line in slope-intercept form, we have\n\n$$\ny=-\\frac{1}{2}x-4.\n$$\n\nNow, since the shaded region lies *above* the line, the inequality is a \"greater than\" inequality. So the corresponding inequality is\n\n$$\ny\\ge -\\frac{1}{2}x-4,\n$$\n\n    \n\nwhich we can rewrite as\n\n$$\nx+2y\\ge -8.\n$$\n\nNow consider the line $y=\\frac{1}{2}x+1.$ Since the line is solid, the inequality is an \"or equal to\" inequality. Also, since the shaded region lies *below* the line, the inequality is a \"less than\" inequality. So the corresponding inequality is\n\n$$\ny\\le \\frac{1}{2}x+1.\n$$\n\nTherefore, the system of inequalities that defines the shaded region is\n\n$$\n\\{\\begin{aligned}x+2y\\ge -8 \\\\ y\\le \\frac{1}{2}x+1.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186247383 :knowledge-point/_questions [{:db/id #edb/ref 17592186171957 :knowledge-point/id #uuid "9c976b6a-4523-51e1-a243-27aa8937db25" :knowledge-point/title "Expressing the Relationship Between the Rows of Pascal's Triangle in Terms of Binomial Coefficients"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "985886cf-1ac8-5f00-a9b7-a6b8dc16ef03" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(\\genfrac{}{}{0pt}{}{5}{3})" :db/id #edb/ref 17592186422856} {:answer/id #uuid "9bce03e9-173f-5fbc-88bd-7c0cb174aeb3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(\\genfrac{}{}{0pt}{}{5}{5})" :db/id #edb/ref 17592186422861} {:answer/id #uuid "d35036c1-6254-594b-a400-43e7b6389e44" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(\\genfrac{}{}{0pt}{}{4}{4})" :db/id #edb/ref 17592186422902} {:answer/id #uuid "d3565fb0-5bc7-5c88-a552-65f6218044f8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(\\genfrac{}{}{0pt}{}{6}{5})" :db/id #edb/ref 17592186422903} {:answer/id #uuid "fb3123f1-385a-5a7b-84da-6fe907b81043" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(\\genfrac{}{}{0pt}{}{4}{3})" :db/id #edb/ref 17592186422925}] :answer-field/correct {:answer/id #uuid "985886cf-1ac8-5f00-a9b7-a6b8dc16ef03" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(\\genfrac{}{}{0pt}{}{5}{3})" :db/id #edb/ref 17592186422856} :answer-field/id #uuid "dafab0b3-0ea9-52f1-b23d-e401a912ba3a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186246939}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "b7e46def-b53d-544e-a445-f2ab7d8b4fbc" :question/math-academy-id "q-113611" :question/problem "Which expression is missing in the following equation?\n\n$$\n(\\genfrac{}{}{0pt}{}{6}{4})=[]+(\\genfrac{}{}{0pt}{}{5}{4})\n$$" :question/worked-solution "To find $(\\genfrac{}{}{0pt}{}{6}{4}),$ we need to find the number that is located in row $6$ and position $4$ of Pascal's triangle. \n\n**Important**: When counting the rows and positions in Pascal's triangle, we always start counting from zero! Remember:\n\n- The top row of Pascal's triangle is row $0.$\n\n- The first position of each row (the one of the left) is position number $0.$\n\nThe location of $(\\genfrac{}{}{0pt}{}{6}{4})$ in Pascal's triangle is highlighted below.\n\n$$\n\\begin{aligned} &  &  &  &  &  &  &  & (\\genfrac{}{}{0pt}{}{0}{0}) \\\\  &  &  &  &  &  &  & (\\genfrac{}{}{0pt}{}{1}{0}) &  & (\\genfrac{}{}{0pt}{}{1}{1}) \\\\  &  &  &  &  &  & (\\genfrac{}{}{0pt}{}{2}{0}) &  & (\\genfrac{}{}{0pt}{}{2}{1}) &  & (\\genfrac{}{}{0pt}{}{2}{2}) \\\\  &  &  &  &  & (\\genfrac{}{}{0pt}{}{3}{0}) &  & (\\genfrac{}{}{0pt}{}{3}{1}) &  & (\\genfrac{}{}{0pt}{}{3}{2}) &  & (\\genfrac{}{}{0pt}{}{3}{3}) \\\\  &  &  &  & (\\genfrac{}{}{0pt}{}{4}{0}) &  & (\\genfrac{}{}{0pt}{}{4}{1}) &  & (\\genfrac{}{}{0pt}{}{4}{2}) &  & (\\genfrac{}{}{0pt}{}{4}{3}) &  & (\\genfrac{}{}{0pt}{}{4}{4}) \\\\  &  &  & (\\genfrac{}{}{0pt}{}{5}{0}) &  & (\\genfrac{}{}{0pt}{}{5}{1}) &  & (\\genfrac{}{}{0pt}{}{5}{2}) &  & (\\genfrac{}{}{0pt}{}{5}{3}) &  & (\\genfrac{}{}{0pt}{}{5}{4}) &  & (\\genfrac{}{}{0pt}{}{5}{5}) \\\\  &  & (\\genfrac{}{}{0pt}{}{6}{0}) &  & (\\genfrac{}{}{0pt}{}{6}{1}) &  & (\\genfrac{}{}{0pt}{}{6}{2}) &  & (\\genfrac{}{}{0pt}{}{6}{3}) &  & (\\genfrac{}{}{0pt}{}{6}{4}) &  & (\\genfrac{}{}{0pt}{}{6}{5}) &  & (\\genfrac{}{}{0pt}{}{6}{6}) \\\\  & ⋮ &  & ⋮ &  & ⋮ &  & ⋮ &  & ⋮ &  & ⋮ &  & ⋮ &  & ⋮\\end{aligned}\n$$\n\nNow, $(\\genfrac{}{}{0pt}{}{6}{4})$ is the sum of the two closest numbers located in the previous row. So,\n\n$$\n(\\genfrac{}{}{0pt}{}{6}{4})=(\\genfrac{}{}{0pt}{}{5}{3})+(\\genfrac{}{}{0pt}{}{5}{4})\n$$\n\nTherefore, the missing expression is $(\\genfrac{}{}{0pt}{}{5}{3}).$"}] [{:db/id #edb/ref 17592186253272 :knowledge-point/_questions [{:db/id #edb/ref 17592186133937 :knowledge-point/id #uuid "2e675f1c-9093-5f6e-a3b3-112d0bc8e516" :knowledge-point/title "Solving a Factored Higher-Order Polynomial Inequality"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "11e5043a-3f1b-5f5b-bcbc-e166efd4ebcd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x\\in (-\\infty ,-2]\\cup [7,\\infty )" :db/id #edb/ref 17592186250707} {:answer/id #uuid "9ce64a4f-ea12-5a34-9745-a6ee77838e83" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x\\in [-5,7]" :db/id #edb/ref 17592186251907} {:answer/id #uuid "c8e3439e-fc9c-56a7-abef-e1dbb6bcab4c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x\\in (-\\infty ,-5]\\cup [7,\\infty )" :db/id #edb/ref 17592186252329} {:answer/id #uuid "4c47f54b-e89e-5b4f-8218-dda45e7ee776" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x\\in \\{-2\\}\\cup [7,\\infty )" :db/id #edb/ref 17592186422797} {:answer/id #uuid "54ce1c89-ead7-51f7-8d45-c8b886b66b84" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x\\in (-\\infty ,-5]\\cup \\{-2\\}\\cup [7,\\infty )" :db/id #edb/ref 17592186422804}] :answer-field/correct {:answer/id #uuid "54ce1c89-ead7-51f7-8d45-c8b886b66b84" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x\\in (-\\infty ,-5]\\cup \\{-2\\}\\cup [7,\\infty )" :db/id #edb/ref 17592186422804} :answer-field/id #uuid "4480b1db-53d1-58b7-9c5c-51fba18c5921" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186252925}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "6f270ff5-bc17-53a5-be2e-3042a3d54393" :question/math-academy-id "q-116595" :question/problem "Solve the inequality $(x+2)^{4}(x+5)(x-7)\\ge 0.$" :question/worked-solution "First, we define the function $f(x)$ as\n\n$$\nf(x)=(x+2)^{4}(x+5)(x-7).\n$$\n\nSo we're now solving the inequality $f(x)\\ge 0.$\n\nThe solutions to the equation $f(x)=0$ are $x=-5,$ $x=-2,$ and $x=7.$ These roots divide the number line into $4$ subintervals:\n\n$$\n(-\\infty ,-5),\\,(-5,-2),\\,(-2,7),\\,(7,\\infty ).\n$$\n\nNow, we construct a sign table with the list of the intervals on the top and the list of factors on the left. Filling in the sign table using the usual method, we get the following result:\n\n|  | $(-\\infty ,-5)$ | $(-5,-2)$ | $(-2,7)$ | $(7,\\infty )$ |\n| --- | --- | --- | --- | --- |\n| $(x+2)^{4}$ | $+$ | $+$ | $+$ | $+$ |\n| $x+5$ | $-$ | $+$ | $+$ | $+$ |\n| $x-7$ | $-$ | $-$ | $-$ | $+$ |\n| $f(x)$ | $+$ | $-$ | $-$ | $+$ |\n\nFinally, to solve the inequality $f(x)\\ge 0,$ we look at the bottom row to determine where $f(x)$ is positive.\n\nFrom the table, we see that $f(x)$ is positive on the intervals $(-\\infty ,-5)$ and $(7,\\infty ).$\n\nTherefore, remembering that the roots are also solutions, we conclude that $f(x)\\ge 0$ for all $x\\in (-\\infty ,-5]\\cup \\{-2\\}\\cup [7,\\infty ).$"}] [{:db/id #edb/ref 17592186253275 :knowledge-point/_questions [{:db/id #edb/ref 17592186133938 :knowledge-point/id #uuid "6bea8139-82a8-5c0a-9d3b-f3a47356773e" :knowledge-point/title "Solving an Expanded Polynomial Inequality"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "82e9a537-35f9-5e3b-ab01-9a35c8a25c58" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x\\in [-7,4]" :db/id #edb/ref 17592186251657} {:answer/id #uuid "cb2e009d-1001-5e69-8ef1-819444c324cb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x\\in (-\\infty ,-7]\\cup [4,\\infty )" :db/id #edb/ref 17592186252353} {:answer/id #uuid "30a52b11-8598-5077-8a15-643c9fad9ec2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x\\in (-\\infty ,-7]\\cup \\{0\\}" :db/id #edb/ref 17592186422771} {:answer/id #uuid "f5cd511b-8452-59e5-b598-ca1eb9dd99c8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x\\in (-\\infty ,-7]\\cup \\{0\\}\\cup [4,\\infty )" :db/id #edb/ref 17592186422923} {:answer/id #uuid "fc70ad66-635a-5913-b502-a590c621334d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x\\in \\{0\\}\\cup [4,\\infty )" :db/id #edb/ref 17592186422928}] :answer-field/correct {:answer/id #uuid "f5cd511b-8452-59e5-b598-ca1eb9dd99c8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x\\in (-\\infty ,-7]\\cup \\{0\\}\\cup [4,\\infty )" :db/id #edb/ref 17592186422923} :answer-field/id #uuid "6eea42f5-3c3e-56b9-8e85-3dd91f7a6a1f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186253002}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "a117df1a-bd81-5da6-88f9-198bb5436e1f" :question/math-academy-id "q-116614" :question/problem "Solve the inequality ${x}^{4}+3{x}^{3}-28{x}^{2}\\ge 0.$" :question/worked-solution "First, we factor the polynomial on the left-hand side of the inequality:\n\n$$\n\\begin{aligned}{x}^{4}+3{x}^{3}-28{x}^{2} & ={x}^{2}({x}^{2}+3x-28) \\\\  & ={x}^{2}({x}^{2}+7x-4x-28) \\\\  & ={x}^{2}(x(x+7)-4(x+7)) \\\\  & ={x}^{2}(x-4)(x+7)\\end{aligned}\n$$\n\nThen, we define the function $f(x)$ as\n\n$$\nf(x)={x}^{2}(x-4)(x+7).\n$$\n\nSo we're now solving the inequality $f(x)\\ge 0.$\n\nThe solutions to the equation $f(x)=0$ are $x=-7,$ $x=0,$ and $x=4.$ These roots divide the number line into $4$ subintervals: \n\n$$\n(-\\infty ,-7),\\,(-7,0),\\,(0,4),\\,(4,\\infty ).\n$$\n\nNow, we construct a sign table with the list of the intervals on the top and the list of factors on the left. Filling in the sign table using the usual method, we get the following result:\n\n|  | $(-\\infty ,-7)$ | $(-7,0)$ | $(0,4)$ | $(4,\\infty )$ |\n| --- | --- | --- | --- | --- |\n| $x+7$ | $-$ | $+$ | $+$ | $+$ |\n| ${x}^{2}$ | $+$ | $+$ | $+$ | $+$ |\n| $x-4$ | $-$ | $-$ | $-$ | $+$ |\n| $f(x)$ | $+$ | $-$ | $-$ | $+$ |\n\nFinally, to solve the inequality $f(x)\\ge 0,$ we look at the bottom row to determine where $f(x)$ is positive.\n\nFrom the table, we see that $f(x)$ is positive on the intervals $(-\\infty ,-7),$ and $(4,\\infty ).$\n\nTherefore, remembering that the roots are also solutions, we conclude that $f(x)\\ge 0$ for all $x\\in (-\\infty ,-7]\\cup \\{0\\}\\cup [4,\\infty ).$"}] [{:db/id #edb/ref 17592186253546 :knowledge-point/_questions [{:db/id #edb/ref 17592186054630 :knowledge-point/id #uuid "3cbddaef-3828-5454-b892-26a3c6242ddb" :knowledge-point/title "Finding All Subsets of a Given Set"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6b4a3183-69f6-5f5d-a9e1-c1e072a1f24c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "∅,\\{x\\},\\{y\\},\\{z\\}\\{x,y,z\\}" :db/id #edb/ref 17592186422817} {:answer/id #uuid "6ff14b5d-188a-55a7-affd-519f5a9ab5e3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "∅,\\{x\\},\\{y\\},\\{z\\},\\{x,y\\},\\{x,z\\},\\{y,z\\}" :db/id #edb/ref 17592186422820} {:answer/id #uuid "73b56506-163b-5f00-81f1-df59bf19d5ac" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "∅,\\{x\\},\\{y\\},\\{z\\}" :db/id #edb/ref 17592186422823} {:answer/id #uuid "8dba51cf-7500-588f-9ddc-13c1238ad685" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "∅,\\{x\\},\\{y\\},\\{z\\},\\{x,y\\},\\{x,z\\},\\{y,z\\},\\{x,y,z\\}" :db/id #edb/ref 17592186422844} {:answer/id #uuid "adaade65-0ace-5c85-9f33-9af310f49494" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\{x\\},\\{y\\},\\{z\\}" :db/id #edb/ref 17592186422876}] :answer-field/correct {:answer/id #uuid "8dba51cf-7500-588f-9ddc-13c1238ad685" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "∅,\\{x\\},\\{y\\},\\{z\\},\\{x,y\\},\\{x,z\\},\\{y,z\\},\\{x,y,z\\}" :db/id #edb/ref 17592186422844} :answer-field/id #uuid "94357139-827d-5170-82dc-cc21ec831009" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186253065}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "4dc7abe5-6826-51d9-82bd-d471faabcb9f" :question/math-academy-id "q-1191" :question/problem "Find all of the subsets of $A=\\{x,y,z\\}.$" :question/worked-solution "To find every subset of $A,$ we list out every combination of elements within $A.$\n\nWe can use the following diagram to visualize the process:\n\n![](images/1d/1d7c11586a8fff5f63d46d936fd32c7b5fbfc33a406ddf268bfdd934fe787cdf.png)\n\nNote that we must include the empty set since it is a subset of every set.\n\nBy doing this, we get\n\n$$\n∅,\\{x\\},\\{y\\},\\{z\\},\\{x,y\\},\\{x,z\\},\\{y,z\\},\\{x,y,z\\}.\n$$"}] [{:db/id #edb/ref 17592186256652 :knowledge-point/_questions [{:db/id #edb/ref 17592186157284 :knowledge-point/id #uuid "d9a9b6de-b0dd-5b38-a32b-378d2b1d86a2" :knowledge-point/title "Finding a Difference of Sets Without a Venn Diagram"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "697eb32b-6e7b-5b33-b678-ff2fa69f0dbc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "∅" :db/id #edb/ref 17592186254618} {:answer/id #uuid "29657c78-3578-5c43-b610-e9899615e5fc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\{5,7\\}" :db/id #edb/ref 17592186422765} {:answer/id #uuid "4d5e7a16-b51c-53c2-b72a-1588ec864b90" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\{2,4\\}" :db/id #edb/ref 17592186422798} {:answer/id #uuid "a0801ea7-2e7f-5757-8040-e50f93761a64" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\{1,3\\}" :db/id #edb/ref 17592186422865} {:answer/id #uuid "a931d3ce-a37a-5e87-8376-8cdddafbd1e0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\{1,2\\}" :db/id #edb/ref 17592186422874}] :answer-field/correct {:answer/id #uuid "4d5e7a16-b51c-53c2-b72a-1588ec864b90" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\{2,4\\}" :db/id #edb/ref 17592186422798} :answer-field/id #uuid "3fdd8f7f-a798-5a0a-b0d9-7c92641e5e2d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186256038}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "969e2b29-61d2-5f25-8ec9-eef4bb6c965f" :question/math-academy-id "q-1225" :question/problem "If $X=\\{1,3,5,7\\}$ and $Y=\\{1,2,3,4\\},$ then $Y-X=$" :question/worked-solution "The set $Y-X$ is the set of all elements belonging to $Y$ but *not* $X.$ Note that the elements $1,3\\in X$ are also in $Y,$ so we must remove them. Therefore, we have\n\n$$\n\\begin{aligned}Y-X & =\\{1,2,3,4\\}-\\{1,3,5,7\\} \\\\  & =\\{2,4\\}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186256677 :knowledge-point/_questions [{:db/id #edb/ref 17592186157284 :knowledge-point/id #uuid "d9a9b6de-b0dd-5b38-a32b-378d2b1d86a2" :knowledge-point/title "Finding a Difference of Sets Without a Venn Diagram"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2987d072-93a7-5265-bd24-21d4a5023733" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\{10\\}" :db/id #edb/ref 17592186422766} {:answer/id #uuid "bd760fde-6a8f-5d98-9d4c-4d18e213cd8b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\{-3,1\\}" :db/id #edb/ref 17592186422886} {:answer/id #uuid "cab4fd57-f8a1-5eea-9750-91ba3eea2e75" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\{-3,5\\}" :db/id #edb/ref 17592186422895} {:answer/id #uuid "e222de57-32d1-57f9-b8e5-e327cccbb0a8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\{-3,5,10\\}" :db/id #edb/ref 17592186422912} {:answer/id #uuid "e2571f68-6cbd-5767-bbb1-d285a269424b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\{-2,1\\}" :db/id #edb/ref 17592186422913}] :answer-field/correct {:answer/id #uuid "e222de57-32d1-57f9-b8e5-e327cccbb0a8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\{-3,5,10\\}" :db/id #edb/ref 17592186422912} :answer-field/id #uuid "69b8c829-6ae3-5595-acab-b091ccf66bf4" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186256119}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "d25f8686-edb7-5e4c-87dd-c8e109d70794" :question/math-academy-id "q-1226" :question/problem "If $C=\\{-3,-1,0,5,10\\}$ and $D=\\{-2,-1,0,1\\}$, then $C∖D=$" :question/worked-solution "The set $C∖D$ is the set of all elements belonging to $C$ but *not* $D.$ Note that the elements $-1,0\\in D$ are also in $C,$ so we must remove them. Therefore, we have\n\n$$\n\\begin{aligned}C∖D & =C-D \\\\  & =\\{-3,-1,0,5,10\\}-\\{-2,-1,0,1\\} \\\\  & =\\{-3,5,10\\}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186262704 :knowledge-point/_questions [{:db/id #edb/ref 17592186124500 :knowledge-point/id #uuid "debd4ccc-de40-55a6-9236-9bf9fff0bdb1" :knowledge-point/title "Finding the Parametric Equations of a Line"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7b303939-05de-583e-8174-21d10e301064" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\{\\begin{aligned}x=7+3t \\\\ y=11+2t \\\\ z=3-7t\\end{aligned}" :db/id #edb/ref 17592186422830} {:answer/id #uuid "8e7b1f0e-6aee-53a0-9934-d5d64d9aadef" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\{\\begin{aligned}x=7+3t \\\\ y=-11+2t \\\\ z=3-7t\\end{aligned}" :db/id #edb/ref 17592186422846} {:answer/id #uuid "bddffa79-df45-5156-a1ce-3514e6387fb3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\{\\begin{aligned}x=7-3t \\\\ y=-11+2t \\\\ z=3+7t\\end{aligned}" :db/id #edb/ref 17592186422887} {:answer/id #uuid "cabd9719-aff1-5cd5-b54b-f9260764be67" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\{\\begin{aligned}x=7+3t \\\\ y=11-2t \\\\ z=3+7t\\end{aligned}" :db/id #edb/ref 17592186422896} {:answer/id #uuid "df58bcd8-8519-5abd-864a-5386206d78bc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\{\\begin{aligned}x=7-3t \\\\ y=-11-2t \\\\ z=4+7t\\end{aligned}" :db/id #edb/ref 17592186422909}] :answer-field/correct {:answer/id #uuid "bddffa79-df45-5156-a1ce-3514e6387fb3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\{\\begin{aligned}x=7-3t \\\\ y=-11+2t \\\\ z=3+7t\\end{aligned}" :db/id #edb/ref 17592186422887} :answer-field/id #uuid "4c40d077-b693-5acd-b033-066f298637d2" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186262258}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "b0a75f14-5c7e-5e9b-9922-914a01571a2f" :question/math-academy-id "q-127065" :question/problem "Find the parametric equations of the straight line that passes through $P(7,-11,3)$ and is parallel to $v=⟨-3,2,7⟩.$" :question/worked-solution "First, the vector equation of the line is \n\n$$\n\\begin{aligned}r & =p+tv \\\\ r & =[\\begin{aligned}7 \\\\ -11 \\\\ 3\\end{aligned}]+t[\\begin{aligned}-3 \\\\ 2 \\\\ 7\\end{aligned}] \\\\ [\\begin{aligned}x \\\\ y \\\\ z\\end{aligned}] & =[\\begin{aligned}7 \\\\ -11 \\\\ 3\\end{aligned}]+[\\begin{aligned}-3t \\\\ 2t \\\\ 7t\\end{aligned}] \\\\ [\\begin{aligned}x \\\\ y \\\\ z\\end{aligned}] & =[\\begin{aligned}7-3t \\\\ -11+2t \\\\ 3+7t\\end{aligned}],\\end{aligned}\n$$\n\nwhere $t\\in (-\\infty ,\\infty ).$ Therefore, the parametric equations are:\n\n$$\n\\{\\begin{aligned}x=7-3t \\\\ y=-11+2t \\\\ z=3+7t\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186262707 :knowledge-point/_questions [{:db/id #edb/ref 17592186119826 :knowledge-point/id #uuid "9927bff1-c245-542b-8d5d-fa7d24188b85" :knowledge-point/title "Finding the Vector Equation of a Line Given in Canonical Form"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5e6cc4d6-7551-537f-b39b-35ad7b229cf6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "None of the listed" :db/id #edb/ref 17592186260686} {:answer/id #uuid "020acfa4-543c-54b8-8b22-7b878f6d0d45" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\{\\begin{aligned}x=10+7t \\\\ y=-4-8t \\\\ z=-1-11t\\end{aligned}" :db/id #edb/ref 17592186422743} {:answer/id #uuid "49fbf7a6-3fac-5080-8363-be5656606e0c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\{\\begin{aligned}x=10+7t \\\\ y=-8-4t \\\\ z=-1+11t\\end{aligned}" :db/id #edb/ref 17592186422793} {:answer/id #uuid "6aeab917-03af-5aaa-807f-606ae765d324" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\{\\begin{aligned}x=10+7t \\\\ y=-7-8t \\\\ z=-1+t\\end{aligned}" :db/id #edb/ref 17592186422816} {:answer/id #uuid "9256b135-afaa-56c0-87dd-9ef764465aa3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\{\\begin{aligned}x=10+7t \\\\ y=8+4t \\\\ z=-1+11t\\end{aligned}" :db/id #edb/ref 17592186422851}] :answer-field/correct {:answer/id #uuid "49fbf7a6-3fac-5080-8363-be5656606e0c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\{\\begin{aligned}x=10+7t \\\\ y=-8-4t \\\\ z=-1+11t\\end{aligned}" :db/id #edb/ref 17592186422793} :answer-field/id #uuid "9a7f67e0-6e06-5a9c-bc07-e96751790a21" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186262402}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "c2f75223-42f3-536a-93af-cb8a85108498" :question/math-academy-id "q-127078" :question/problem "Find the parametric equations of the line $\\frac{x-10}{7}=\\frac{y+8}{-4}=\\frac{z+1}{11}.$" :question/worked-solution "Remember that the Cartesian (canonical) equation of the straight line that passes through the point $P({x}_{0},{y}_{0},{z}_{0})$ and is parallel to the vector $v=⟨{v}_{x},{v}_{y},{v}_{z}⟩$, is given by\n\n$$\n\\frac{x-{x}_{0}}{{v}_{x}}=\\frac{y-{y}_{0}}{{v}_{y}}=\\frac{z-{z}_{0}}{{v}_{z}}=t,\\,t\\in (-\\infty ,\\infty ).\n$$\n\nComparing the above to our given equation\n\n$$\n\\frac{x-10}{7}=\\frac{y-(-8)}{-4}=\\frac{z-(-1)}{11},\n$$\n\nwe find that our line passes through the point $P(10,-8,-1)$ and is parallel to $v=⟨7,-4,11⟩.$ Therefore, its vector equation is\n\n$$\n\\begin{aligned}r & =p+tv \\\\ r & =[\\begin{aligned}10 \\\\ -8 \\\\ -1\\end{aligned}]+t[\\begin{aligned}7 \\\\ -4 \\\\ 11\\end{aligned}],\\,t\\in (-\\infty ,\\infty ).\\end{aligned}\n$$\n\nTherefore, the parametric equations are the following:\n\n$$\n\\{\\begin{aligned}x=10+7t \\\\ y=-8-4t \\\\ z=-1+11t\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186400380 :knowledge-point/_questions [{:db/id #edb/ref 17592186059769 :knowledge-point/id #uuid "d7c8f4da-c782-51e0-ac51-87a89f31860d" :knowledge-point/title "Finding the System of Equations Associated With an Augmented Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "24490954-ab21-5051-9c79-0188676572bd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\{\\begin{aligned}8x+y=6 \\\\ 4x+y=-9\\end{aligned}" :db/id #edb/ref 17592186422759} {:answer/id #uuid "38120e62-d95b-502d-9288-454ec459aba2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\{\\begin{aligned}8y=6 \\\\ 4x+y=-9\\end{aligned}" :db/id #edb/ref 17592186422777} {:answer/id #uuid "57c2694f-57f8-54fb-b264-a6f49a025275" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\{\\begin{aligned}x+8y=6 \\\\ 4x+y=9\\end{aligned}" :db/id #edb/ref 17592186422806} {:answer/id #uuid "b0af48a4-a01a-5ac1-a551-44dbb13e7334" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\{\\begin{aligned}8y=6 \\\\ x+4y=9\\end{aligned}" :db/id #edb/ref 17592186422881} {:answer/id #uuid "ca1fb4a7-0229-50a8-b462-cf1f3e49f409" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\{\\begin{aligned}8y=6 \\\\ x+4y=-9\\end{aligned}" :db/id #edb/ref 17592186422894}] :answer-field/correct {:answer/id #uuid "38120e62-d95b-502d-9288-454ec459aba2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\{\\begin{aligned}8y=6 \\\\ 4x+y=-9\\end{aligned}" :db/id #edb/ref 17592186422777} :answer-field/id #uuid "1f8ada74-f43b-5b8f-a0b1-562915c30921" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186400381}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "10f47672-b02f-5835-a498-94f2d2a69a14" :question/math-academy-id "q-129129" :question/problem "What would be the system of equations for the following augmented matrix?\n\n$$\n[\\begin{aligned}0 & 8 & 6 \\\\ 4 & 1 & -9\\end{aligned}]\n$$" :question/worked-solution "The augmented matrix consists of two parts: the coefficient matrix and the column of constants.\n\nThe coefficient matrix represents the coefficients in the linear system, while the column of constants represents the constants on the right-hand sides of the equations.\n\nUsing the variables $x$ and  $y$,  the corresponding system of equations is\n\n$$\n\\{\\begin{aligned}0x+8y=6 \\\\ 4x+y=-9.\\end{aligned}\n$$\n\nBy simplifying, we obtain\n\n$$\n\\{\\begin{aligned}8y=6 \\\\ 4x+y=-9.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186400387 :knowledge-point/_questions [{:db/id #edb/ref 17592186059769 :knowledge-point/id #uuid "d7c8f4da-c782-51e0-ac51-87a89f31860d" :knowledge-point/title "Finding the System of Equations Associated With an Augmented Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1a9caf8a-d772-5659-bb2a-8be8cd0f8959" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\{\\begin{aligned}-8y+4z=\\frac{7}{4} \\\\ 5y+\\frac{2}{3}z=-8 \\\\ \\frac{3}{2}x+\\frac{1}{3}y+4z=-6\\end{aligned}" :db/id #edb/ref 17592186422751} {:answer/id #uuid "8eff0c23-deb0-5661-9618-e2d13de4135f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\{\\begin{aligned}-8y+4z=-\\frac{7}{4} \\\\ 5y+\\frac{2}{3}z=8 \\\\ \\frac{3}{2}x+\\frac{1}{3}y+4z=6\\end{aligned}" :db/id #edb/ref 17592186422847} {:answer/id #uuid "a2737fea-cf8b-54fe-91e0-1cf224081a91" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\{\\begin{aligned}-8x+4y=-\\frac{7}{4} \\\\ 5x+\\frac{2}{3}y=8 \\\\ \\frac{3}{2}x+\\frac{1}{3}y+4z=6\\end{aligned}" :db/id #edb/ref 17592186422867} {:answer/id #uuid "ae1e650f-ec05-53f2-94db-39a6135a9924" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\{\\begin{aligned}-8x+4z=-\\frac{7}{4} \\\\ 5x+\\frac{2}{3}z=8 \\\\ \\frac{3}{2}x+\\frac{1}{3}y+4z=6\\end{aligned}" :db/id #edb/ref 17592186422878} {:answer/id #uuid "f24f2595-42ba-5741-b8c8-86e447fb2e49" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\{\\begin{aligned}x-8y+4z=-\\frac{7}{4} \\\\ x+5y+\\frac{2}{3}z=8 \\\\ \\frac{3}{2}x+\\frac{1}{3}y+4z=6\\end{aligned}" :db/id #edb/ref 17592186422920}] :answer-field/correct {:answer/id #uuid "8eff0c23-deb0-5661-9618-e2d13de4135f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\{\\begin{aligned}-8y+4z=-\\frac{7}{4} \\\\ 5y+\\frac{2}{3}z=8 \\\\ \\frac{3}{2}x+\\frac{1}{3}y+4z=6\\end{aligned}" :db/id #edb/ref 17592186422847} :answer-field/id #uuid "a53c95c7-2729-5853-ad5b-f91dbb44a5b7" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186400388}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "f0c417e1-432e-591b-889d-c01227fedeb7" :question/math-academy-id "q-129133" :question/problem "What would be the system of equations for the following augmented matrix?\n\n$$\n[\\begin{aligned}0 & -8 & 4 & -\\frac{7}{4} \\\\ 0 & 5 & \\frac{2}{3} & 8 \\\\ \\frac{3}{2} & \\frac{1}{3} & 4 & 6\\end{aligned}]\n$$" :question/worked-solution "The augmented matrix consists of two parts: the coefficient matrix and the column of constants.\n\nThe coefficient matrix represents the coefficients in the linear system, while the column of constants represents the constants on the right-hand sides of the equations.\n\nUsing the variables $x$, $y$, and $z,$ then, the corresponding system of equations is\n\n$$\n\\{\\begin{aligned}0x-8y+4z=-\\frac{7}{4} \\\\ 0x+5y+\\frac{2}{3}z=8 \\\\ \\frac{3}{2}x+\\frac{1}{3}y+4z=6.\\end{aligned}\n$$\n\nBy simplifying, we obtain \n\n$$\n\\{\\begin{aligned}-8y+4z=-\\frac{7}{4} \\\\ 5y+\\frac{2}{3}z=8 \\\\ \\frac{3}{2}x+\\frac{1}{3}y+4z=6.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186265926 :knowledge-point/_questions [{:db/id #edb/ref 17592186115233 :knowledge-point/id #uuid "fe2300a1-f31e-5a24-889a-6f45e1e8647b" :knowledge-point/title "Expressing a Matrix Product as a 2x2 System of Equations"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1dcde906-c5fb-5fc0-b6a8-8961649a59ba" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{aligned}\\{\\begin{aligned}10x+25y=-15 \\\\ 12x+6y=3\\end{aligned}\\end{aligned}" :db/id #edb/ref 17592186422754} {:answer/id #uuid "727892e1-58ea-5d36-b86b-82b51a10eb55" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{aligned}\\{\\begin{aligned}2x+5y=3 \\\\ 4x+y=-2\\end{aligned}\\end{aligned}" :db/id #edb/ref 17592186422822} {:answer/id #uuid "a12e8848-d478-59a6-a4bb-c9297a758c18" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{aligned}\\{\\begin{aligned}10x+25y=-15 \\\\ 12x+3y=6\\end{aligned}\\end{aligned}" :db/id #edb/ref 17592186422866} {:answer/id #uuid "b92215d8-8706-55a2-9e83-085b95ecb6b9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{aligned}\\{\\begin{aligned}10x+5y=-15 \\\\ 12x+3y=6\\end{aligned}\\end{aligned}" :db/id #edb/ref 17592186422884} {:answer/id #uuid "e1575aa2-a070-55bb-b7a7-08d8f4d81a38" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{aligned}\\{\\begin{aligned}2x+5y=15 \\\\ 4x+y=-6\\end{aligned}\\end{aligned}" :db/id #edb/ref 17592186422911}] :answer-field/correct {:answer/id #uuid "727892e1-58ea-5d36-b86b-82b51a10eb55" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{aligned}\\{\\begin{aligned}2x+5y=3 \\\\ 4x+y=-2\\end{aligned}\\end{aligned}" :db/id #edb/ref 17592186422822} :answer-field/id #uuid "0929e729-c74a-53df-b186-d608a6e127ca" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186265262}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "2e54120f-ad5a-5b0e-97ad-23133523c995" :question/math-academy-id "q-130523" :question/problem "What is the system of equations represented by\n\n$$\n[\\begin{aligned}10 & 25 \\\\ 12 & 3\\end{aligned}][\\begin{aligned}x \\\\ y\\end{aligned}]=[\\begin{aligned}15 \\\\ -6\\end{aligned}]?\n$$" :question/worked-solution "The  $2\\times 2$ matrix represents the coefficients of $x$ and $y,$ while the $2\\times 1$ column vector on the right-hand side represents the constants of the equations. So, we get the following system of equations:\n\n$$\n\\begin{aligned}\\{\\begin{aligned}10x+25y=15 \\\\ 12x+3y=-6\\end{aligned}\\end{aligned}\n$$\n\nSimplifying both equations in the system, we get\n\n$$\n\\begin{aligned}\\{\\begin{aligned}2x+5y=3 \\\\ 4x+y=-2.\\end{aligned}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186400485 :knowledge-point/_questions [{:db/id #edb/ref 17592186115233 :knowledge-point/id #uuid "fe2300a1-f31e-5a24-889a-6f45e1e8647b" :knowledge-point/title "Expressing a Matrix Product as a 2x2 System of Equations"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "02b3cd2b-284b-5242-a0fd-852bf0b1881c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{aligned}\\{\\begin{aligned}5y=-9 \\\\ x=-1\\end{aligned}\\end{aligned}" :db/id #edb/ref 17592186422744} {:answer/id #uuid "2540c038-f7ff-526e-8623-0b2eb9995f47" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{aligned}\\{\\begin{aligned}5y=9 \\\\ x=1\\end{aligned}\\end{aligned}" :db/id #edb/ref 17592186422762} {:answer/id #uuid "86106155-653b-5126-ac12-f97cdb674767" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{aligned}\\{\\begin{aligned}x+5y=9 \\\\ x=-1\\end{aligned}\\end{aligned}" :db/id #edb/ref 17592186422839} {:answer/id #uuid "9560da06-25ad-5721-bc24-046715bc8034" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{aligned}\\{\\begin{aligned}5y=9 \\\\ x=-1\\end{aligned}\\end{aligned}" :db/id #edb/ref 17592186422854} {:answer/id #uuid "be15d0f0-70f8-5910-afd6-1af63be69956" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{aligned}\\{\\begin{aligned}x+5y=9 \\\\ y=-1\\end{aligned}\\end{aligned}" :db/id #edb/ref 17592186422888}] :answer-field/correct {:answer/id #uuid "9560da06-25ad-5721-bc24-046715bc8034" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{aligned}\\{\\begin{aligned}5y=9 \\\\ x=-1\\end{aligned}\\end{aligned}" :db/id #edb/ref 17592186422854} :answer-field/id #uuid "0c4d849c-e24c-5150-9286-220ece393a3b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186400486}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "a1162f6f-3b06-5edc-926f-fe3ac4ca244f" :question/math-academy-id "q-130528" :question/problem "What is the system of equations represented by\n\n$$\n[\\begin{aligned}0 & 5 \\\\ 1 & 0\\end{aligned}][\\begin{aligned}x \\\\ y\\end{aligned}]=[\\begin{aligned}9 \\\\ -1\\end{aligned}]?\n$$" :question/worked-solution "The  $2\\times 2$ matrix represents the coefficients of $x$ and $y,$ while the $2\\times 1$ column vector on the right-hand side represents the constants of the equations. So, we get the following system of equations:\n\n$$\n\\begin{aligned}\\{\\begin{aligned}0x+5y=9 \\\\ x+0y=-1\\end{aligned}\\end{aligned}\n$$\n\nSimplifying both equations in the system, we get\n\n$$\n\\begin{aligned}\\{\\begin{aligned}5y=9 \\\\ x=-1.\\end{aligned}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186055047 :knowledge-point/_questions [{:db/id #edb/ref 17592186054831 :knowledge-point/id #uuid "3f986c29-111e-5cb3-8104-62ab734f1c47" :knowledge-point/title "Identifying Elements of an Indexed Family"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d69f7a79-8b21-5c91-90dd-ae837a8be39e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "∅" :db/id #edb/ref 17592186283557} {:answer/id #uuid "2506c61d-1801-5a64-a80f-0d19c71642d9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\{1,2,3,4\\}" :db/id #edb/ref 17592186422760} {:answer/id #uuid "8c60dbcb-cc1b-53d5-9316-a943261ba035" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\{1,2,3,4,5\\}" :db/id #edb/ref 17592186422843} {:answer/id #uuid "9441c077-faf1-5bd0-870b-cef8d5a959ed" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\{-5,-4,…,4,5\\}" :db/id #edb/ref 17592186422853} {:answer/id #uuid "c021623c-4824-596d-bf9c-c8149509df99" :answer/type {:db/id #edb/ref 17592