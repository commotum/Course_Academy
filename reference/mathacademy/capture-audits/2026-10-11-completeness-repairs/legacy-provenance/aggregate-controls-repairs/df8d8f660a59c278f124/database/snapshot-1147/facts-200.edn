#edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186240345 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186240345 #edb/ref 1078 #edb/ref 17592186238297 #edb/ref 17592186045417] [17592186240345 #edb/ref 1079 #uuid "0c294f44-fff5-5b15-a966-35cefb0a5204" #edb/ref 17592186045417] [17592186240596 #edb/ref 1075 #edb/ref 17592186238224 #edb/ref 17592186045417] [17592186240596 #edb/ref 1075 #edb/ref 17592186238424 #edb/ref 17592186045417] [17592186240596 #edb/ref 1075 #edb/ref 17592186238544 #edb/ref 17592186045417] [17592186240596 #edb/ref 1075 #edb/ref 17592186239511 #edb/ref 17592186045417] [17592186240596 #edb/ref 1075 #edb/ref 17592186240027 #edb/ref 17592186045417] [17592186240596 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186240596 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186240596 #edb/ref 1078 #edb/ref 17592186239511 #edb/ref 17592186045417] [17592186240596 #edb/ref 1079 #uuid "969e0b9d-d3d2-5f29-a98a-b20b18e9c6f0" #edb/ref 17592186045417] [17592186240999 #edb/ref 1068 #edb/ref 17592186240345 #edb/ref 17592186045417] [17592186240999 #edb/ref 1069 "q-105179" #edb/ref 17592186045417] [17592186240999 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186240999 #edb/ref 1071 "If $U={2,4,6,8,…,20}$ is the universal set and $B={4,8,12,16,20},$ then the complement of $B$ is" #edb/ref 17592186045417] [17592186240999 #edb/ref 1072 #uuid "32ae7bbc-249c-5c79-aba5-9c3291b509c7" #edb/ref 17592186045417] [17592186240999 #edb/ref 1074 "The complement of $B,$ denoted $\\overset{―}{B},$ consists of every element in the universal set $U$ that is not in the set $B.$\n\nThe elements of $U$ that are not in $B$ are $2,$ $6,$ $10,$ $14,$ and $18.$\n\nTherefore, the complement of $B$ is\n\n$$\n\\overset{―}{B}={2,6,10,14,18}.\n$$" #edb/ref 17592186045417] [17592186241005 #edb/ref 1068 #edb/ref 17592186240596 #edb/ref 17592186045417] [17592186241005 #edb/ref 1069 "q-105188" #edb/ref 17592186045417] [17592186241005 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186241005 #edb/ref 1071 "Let $U={a,b,c,…,z}$ be the universal set and $Y={a,b,c,…,j}$, then $\\overset{―}{Y}=$" #edb/ref 17592186045417] [17592186241005 #edb/ref 1072 #uuid "3aa7531f-69fb-514d-bcea-7f5e2dae1a2a" #edb/ref 17592186045417] [17592186241005 #edb/ref 1074 "The complement of $Y,$ denoted $\\overset{―}{Y},$ consists of every element in the universal set $U$ that is not in the set $Y.$\n\nThe universal set $U$ consists of the letters $a$ through $z,$ while the set $Y$ consists of the letters $a$ through $j.$\n\nSo, the only elements of $U$ that are not in $Y$ are the letters $k$ through $z.$\n\nTherefore, the complement of $Y$ is\n\n$$\n\\overset{―}{Y}={k,l,m,…,z}.\n$$" #edb/ref 17592186045417] [17592186245535 #edb/ref 1080 "(\\frac{5}{3})" #edb/ref 17592186045417] [17592186245535 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186245535 #edb/ref 1083 #uuid "8b3b1495-fd4e-590e-abf2-f1d01bed44e4" #edb/ref 17592186045417] [17592186245807 #edb/ref 1080 "(\\frac{4}{3})" #edb/ref 17592186045417] [17592186245807 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186245807 #edb/ref 1083 #uuid "a6d0e7ca-9cf6-56d2-bd14-35cdeb9caa81" #edb/ref 17592186045417] [17592186246060 #edb/ref 1080 "(\\frac{6}{5})" #edb/ref 17592186045417] [17592186246060 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186246060 #edb/ref 1083 #uuid "c4a33636-8960-5f5f-8599-a5cf57881efe" #edb/ref 17592186045417] [17592186246113 #edb/ref 1080 "(\\frac{5}{5})" #edb/ref 17592186045417] [17592186246113 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186246113 #edb/ref 1083 #uuid "caa06872-b168-58f8-a4a8-ab8168991c78" #edb/ref 17592186045417] [17592186246157 #edb/ref 1080 "(\\frac{4}{4})" #edb/ref 17592186045417] [17592186246157 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186246157 #edb/ref 1083 #uuid "ce63f89f-656b-512a-96b3-aa29379755eb" #edb/ref 17592186045417] [17592186246939 #edb/ref 1075 #edb/ref 17592186245535 #edb/ref 17592186045417] [17592186246939 #edb/ref 1075 #edb/ref 17592186245807 #edb/ref 17592186045417] [17592186246939 #edb/ref 1075 #edb/ref 17592186246060 #edb/ref 17592186045417] [17592186246939 #edb/ref 1075 #edb/ref 17592186246113 #edb/ref 17592186045417] [17592186246939 #edb/ref 1075 #edb/ref 17592186246157 #edb/ref 17592186045417] [17592186246939 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186246939 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186246939 #edb/ref 1078 #edb/ref 17592186245535 #edb/ref 17592186045417] [17592186246939 #edb/ref 1079 #uuid "dafab0b3-0ea9-52f1-b23d-e401a912ba3a" #edb/ref 17592186045417] [17592186247383 #edb/ref 1068 #edb/ref 17592186246939 #edb/ref 17592186045417] [17592186247383 #edb/ref 1069 "q-113611" #edb/ref 17592186045417] [17592186247383 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186247383 #edb/ref 1071 "Which expression is missing in the following equation?\n\n$$\n(\\frac{6}{4})=[]+(\\frac{5}{4})\n$$" #edb/ref 17592186045417] [17592186247383 #edb/ref 1072 #uuid "b7e46def-b53d-544e-a445-f2ab7d8b4fbc" #edb/ref 17592186045417] [17592186247383 #edb/ref 1074 "To find $(\\frac{6}{4}),$ we need to find the number that is located in row $6$ and position $4$ of Pascal's triangle. \n\n**Important**: When counting the rows and positions in Pascal's triangle, we always start counting from zero! Remember:\n\n- The top row of Pascal's triangle is row $0.$\n\n- The first position of each row (the one of the left) is position number $0.$\n\nThe location of $(\\frac{6}{4})$ in Pascal's triangle is highlighted below.\n\n$$\n\\begin{aligned} &  &  &  &  &  &  &  & (\\frac{0}{0}) \\\\  &  &  &  &  &  &  & (\\frac{1}{0}) &  & (\\frac{1}{1}) \\\\  &  &  &  &  &  & (\\frac{2}{0}) &  & (\\frac{2}{1}) &  & (\\frac{2}{2}) \\\\  &  &  &  &  & (\\frac{3}{0}) &  & (\\frac{3}{1}) &  & (\\frac{3}{2}) &  & (\\frac{3}{3}) \\\\  &  &  &  & (\\frac{4}{0}) &  & (\\frac{4}{1}) &  & (\\frac{4}{2}) &  & (\\frac{4}{3}) &  & (\\frac{4}{4}) \\\\  &  &  & (\\frac{5}{0}) &  & (\\frac{5}{1}) &  & (\\frac{5}{2}) &  & (\\frac{5}{3}) &  & (\\frac{5}{4}) &  & (\\frac{5}{5}) \\\\  &  & (\\frac{6}{0}) &  & (\\frac{6}{1}) &  & (\\frac{6}{2}) &  & (\\frac{6}{3}) &  & (\\frac{6}{4}) &  & (\\frac{6}{5}) &  & (\\frac{6}{6}) \\\\  & ⋮ &  & ⋮ &  & ⋮ &  & ⋮ &  & ⋮ &  & ⋮ &  & ⋮ &  & ⋮\\end{aligned}\n$$\n\nNow, $(\\frac{6}{4})$ is the sum of the two closest numbers located in the previous row. So,\n\n$$\n(\\frac{6}{4})=(\\frac{5}{3})+(\\frac{5}{4})\n$$\n\nTherefore, the missing expression is $(\\frac{5}{3}).$" #edb/ref 17592186045417] [17592186250707 #edb/ref 1080 "x\\in (-\\infty ,-2]\\cup [7,\\infty )" #edb/ref 17592186045417] [17592186250707 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186250707 #edb/ref 1083 #uuid "11e5043a-3f1b-5f5b-bcbc-e166efd4ebcd" #edb/ref 17592186045417] [17592186250835 #edb/ref 1080 "{x},{y},{z}" #edb/ref 17592186045417] [17592186250835 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186250835 #edb/ref 1083 #uuid "2138f1f0-b703-55d8-b999-9fe7ae4409d6" #edb/ref 17592186045417] [17592186251366 #edb/ref 1080 "∅,{x},{y},{z}{x,y,z}" #edb/ref 17592186045417] [17592186251366 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186251366 #edb/ref 1083 #uuid "63d3fd5b-8e22-520b-857a-9f693151fc1d" #edb/ref 17592186045417] [17592186251657 #edb/ref 1080 "x\\in [-7,4]" #edb/ref 17592186045417] [17592186251657 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186251657 #edb/ref 1083 #uuid "82e9a537-35f9-5e3b-ab01-9a35c8a25c58" #edb/ref 17592186045417] [17592186251719 #edb/ref 1080 "x\\in {-2}\\cup [7,\\infty )" #edb/ref 17592186045417] [17592186251719 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186251719 #edb/ref 1083 #uuid "8a4b2875-f02c-5afa-b32c-36d4cf303e86"