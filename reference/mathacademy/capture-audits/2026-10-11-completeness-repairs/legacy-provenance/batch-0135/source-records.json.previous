            },
            {
              "type": "math",
              "value": "\\frac{2\\sqrt[3]{(z+4)^{2}}}{3}+\\frac{1}{2\\sqrt{z+4}}+C",
              "option": "1",
              "source_option": "b"
            },
            {
              "type": "math",
              "value": "\\frac{2\\sqrt{(z+4)^{3}}}{3}+2\\sqrt{z+4}+C",
              "option": "2",
              "source_option": "c"
            },
            {
              "type": "math",
              "value": "\\frac{\\sqrt[3]{(z+4)^{2}}}{3}+2\\sqrt{z+4}+C",
              "option": "3",
              "source_option": "d"
            },
            {
              "type": "math",
