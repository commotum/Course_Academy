  {
    "directory": "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14099948",
    "question": {
      "math_academy_id": "q-129197",
      "knowledge_point_id": "5165085e-ffa9-533a-ab7c-c03304fc1489",
      "knowledge_point": "Describing a Level Surface of a Function",
      "problem": "Which of the following describes the level surfaces of the function $f(x,y,z)=\\frac{3z}{x+6y}?$",
      "worked_solution": "The level surfaces of the function $f(x,y,z)$ are given by the following equation:\n\n$$\n\\begin{aligned}f(x,y,z) & =c \\\\ \\frac{3z}{x+6y} & =c \\\\ 3z & =c(x+6y) \\\\ 3z & =cx+6cy \\\\ z & =\\frac{c}{3}x+2cy\\end{aligned}\n$$\n\nTherefore, we get a family of planes:\n\n$$\nz=\\frac{c}{3}x+2cy,\\,c\\in (-\\infty ,\\infty )\n$$",
      "answer_fields": [
        {
          "key": "selection",
          "type": "radio",
          "choices_complete": true,
          "choices": [
            {
              "type": "text",
              "value": "A family of planes: $z=\\frac{c}{3}x+\\frac{c}{2}y$",
              "option": "0",
              "source_option": "a"
            },
            {
              "type": "text",
              "value": "A family of planes: $z=\\frac{c}{3}x+2cy$",
              "option": "1",
              "source_option": "b"
            },
            {
              "type": "text",
              "value": "A family of surfaces: $z=\\frac{3c}{x+6y}$",
              "option": "2",
              "source_option": "c"
            },
            {
              "type": "text",
              "value": "A family of planes: $z=3cx+\\frac{c}{2}y$",
              "option": "3",
              "source_option": "d"
            },
            {
              "type": "text",
              "value": "A family of surfaces: $z=\\frac{c}{3(x+6y)}$",
              "option": "4",
              "source_option": "e"
            }
          ]
        }
      ],
      "source_answer_policy": {
        "version": "revealed-ma-answer-v1",
        "feedback_sha256": "6e2a20710f7d2ce79f6f9753a2c2b579e52a12b5887c0f6b4f1097fb4952e314"
      },
      "difficulty": "moderate",
