              "type": "math",
              "value": "{∬}_{(1,2)\\times (1,2)}\\frac{{x}^{2}}{{y}^{2}}\\,\\text{d}A+{∬}_{(1,2)\\times (2,4)}\\frac{y+1}{1+{x}^{2}}\\,\\text{d}A",
              "option": "0",
              "source_option": "a"
            },
            {
              "type": "math",
              "value": "{∬}_{(1,2)\\times (1,4)}\\frac{{x}^{2}(y+1)}{{y}^{2}(1+{x}^{2})}\\,\\text{d}A",
              "option": "1",
              "source_option": "b"
            },
            {
              "type": "math",
              "value": "{∬}_{(1,2)\\times (1,2)}\\frac{y+1}{1+{x}^{2}}\\,\\text{d}A+{∬}_{(1,2)\\times (2,4)}\\frac{{x}^{2}}{{y}^{2}}\\,\\text{d}A",
              "option": "2",
              "source_option": "c"
            },
            {
              "type": "math",
              "value": "{∬}_{(1,2)\\times (1,2)}\\frac{y+1}{1+{x}^{2}}\\,\\text{d}A+{∬}_{(2,4)\\times (2,4)}\\frac{{x}^{2}}{{y}^{2}}\\,\\text{d}A",
              "option": "3",
              "source_option": "d"
            },
            {
