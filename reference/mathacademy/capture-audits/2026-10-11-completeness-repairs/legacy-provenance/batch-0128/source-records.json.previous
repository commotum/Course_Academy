              "value": "p=\\frac{2}{5},q=-\\frac{1}{2}",
              "option": "3",
              "source_option": "d"
            },
            {
              "type": "math",
              "value": "p=\\frac{3}{2},q=-\\frac{1}{2}",
              "option": "4",
              "source_option": "e"
            }
          ]
        }
      ],
      "difficulty": "moderate",
