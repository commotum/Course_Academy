              "value": "⟨0,\\frac{2}{\\sqrt{5}},\\frac{4}{\\sqrt{5}}⟩",
              "option": "0",
              "source_option": "a"
            },
            {
              "type": "math",
              "value": "⟨0,-\\frac{1}{\\sqrt{5}},\\frac{2}{\\sqrt{5}}⟩",
              "option": "1",
              "source_option": "b"
            },
            {
