            },
            {
              "type": "math",
              "value": "\\frac{4}{(x-3)}-\\frac{2}{(x-1)}+\\frac{2}{(x+5)}",
              "option": "2",
              "source_option": "c"
            },
            {
              "type": "math",
              "value": "\\frac{3}{(x-3)}+\\frac{3}{(x-1)}+\\frac{2}{(x+5)}",
