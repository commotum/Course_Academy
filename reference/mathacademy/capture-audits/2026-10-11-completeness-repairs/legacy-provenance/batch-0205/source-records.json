    "question": {
      "math_academy_id": "q-158559",
      "knowledge_point_id": "0e593685-f5ca-5501-94bf-7cb4d49e935b",
      "knowledge_point": "The Domain of a Function Involving Reciprocals and Radicals",
      "problem": "Find the domain of the function $z=\\frac{{x}^{2}+3y}{\\sqrt{x+2}}.$",
      "worked_solution": "The function is well-defined at all points $(x,y)$ for which the following conditions are satisfied:\n\n- The expression in the denominator is not equal to zero, and\n\n- the expression under the square root is non-negative.\n\nAs a result, the points in the domain must satisfy the following inequality:\n\n$$\nx+2>0\\,⟹\\,x>-2\n$$\n\nTherefore, the domain is\n\n$$\n\\{(x,y)\\in {R}^{2}\\,:\\,x>-2\\}.\n$$",
      "answer_fields": [
        {
          "key": "selection",
          "type": "radio",
          "choices_complete": true,
          "choices": [
            {
              "type": "math",
              "value": "\\{(x,y)\\in {R}^{2}\\,:\\,x>-2\\}",
              "option": "0",
              "source_option": "a"
            },
            {
              "type": "math",
              "value": "\\{(x,y)\\in {R}^{2}\\,:\\,x>-2,\\,y=0\\}",
              "option": "1",
              "source_option": "b"
            },
            {
              "type": "math",
              "value": "\\{(x,y)\\in {R}^{2}\\,:\\,x\\ne -2\\}",
              "option": "2",
              "source_option": "c"
            },
            {
              "type": "text",
              "value": "The domain is the entire $xy-$plane",
              "option": "3",
              "source_option": "d"
            },
            {
              "type": "math",
              "value": "\\{(x,y)\\in {R}^{2}\\,:\\,x\\ge -2\\}",
              "option": "4",
              "source_option": "e"
            }
          ]
        }
      ],
