            },
            {
              "type": "math",
              "value": "\\{(x,y)\\in {R}^{2}\\,:\\,y\\ge -2,\\,y>2{x}^{3}\\}",
              "option": "2",
              "source_option": "c"
            },
            {
              "type": "math",
              "value": "\\{(x,y)\\in {R}^{2}\\,:\\,y\\ge -2,\\,y\\ne 2{x}^{3}\\}",
              "option": "3",
              "source_option": "d"
            },
            {
              "type": "math",
              "value": "\\{(x,y)\\in {R}^{2}\\,:\\,y\\ge 2,\\,y>2{x}^{3}\\}",
