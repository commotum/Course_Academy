              "value": "x+1=2t,\\,\\,y-2=\\frac{1}{2}{t}^{2}",
              "option": "3",
              "source_option": "d"
            },
            {
              "type": "math",
              "value": "x+1=t,\\,\\,y-2=\\frac{1}{2}{t}^{2}",
