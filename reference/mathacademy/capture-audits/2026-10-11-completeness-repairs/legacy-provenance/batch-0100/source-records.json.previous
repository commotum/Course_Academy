              "value": "-{sec}^{2}⁡x+C",
              "option": "3",
              "source_option": "d"
            },
            {
              "type": "math",
              "value": "-\\operatorname{csc}⁡x+C",
              "option": "4",
              "source_option": "e"
            }
          ]
        }
      ],
