                "type": "math",
                "value": "⟨2\\operatorname{sec}⁡t\\operatorname{tan}⁡t,\\,\\operatorname{sec}⁡t({tan}^{2}⁡t+{sec}^{2}⁡t)⟩",
                "option": "0",
                "source_option": "a"
