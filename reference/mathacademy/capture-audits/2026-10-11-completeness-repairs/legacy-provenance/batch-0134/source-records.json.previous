              "type": "text",
              "value": "$(-4,-1)$ and $(2,0)$",
              "option": "1",
              "source_option": "b"
            },
            {
              "type": "text",
              "value": "$(-3,-1)$ and $(2,0)$",
              "option": "2",
              "source_option": "c"
            },
            {
              "type": "text",
              "value": "$(-3,-1)$ and $(1,0)$",
              "option": "3",
              "source_option": "d"
            },
            {
              "type": "text",
              "value": "$(-4,-2)$ and $(2,0)$",
              "option": "4",
              "source_option": "e"
            }
          ]
        }
      ],
      "difficulty": "hard",
