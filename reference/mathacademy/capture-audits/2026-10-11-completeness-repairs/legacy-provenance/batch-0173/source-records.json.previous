  {
    "directory": "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14076277",
    "question": {
      "math_academy_id": "q-19779",
      "knowledge_point_id": "733eab11-2a26-5402-8df5-bba50c9beaf9",
      "knowledge_point": "Calculating the Cross Product Using Determinants",
      "problem": "Let $a=⟨1,0,3⟩$ and $b=⟨2,5,3⟩.$ Find $a\\times b.$",
      "worked_solution": "Using the determinant formula, we get\n\n$$\n\\begin{aligned}a\\times b & =|\\begin{aligned}i & j & k \\\\ 1 & 0 & 3 \\\\ 2 & 5 & 3\\end{aligned}| \\\\  & =|\\begin{aligned}0 & 3 \\\\ 5 & 3\\end{aligned}|i-|\\begin{aligned}1 & 3 \\\\ 2 & 3\\end{aligned}|j+|\\begin{aligned}1 & 0 \\\\ 2 & 5\\end{aligned}|k \\\\  & =(0\\cdot 3-3\\cdot 5)i-(1\\cdot 3-2\\cdot 3)j+(1\\cdot 5-2\\cdot 0)k \\\\  & =(0-15)i-(3-6)j+(5-0)k \\\\  & =⟨-15,3,5⟩.\\end{aligned}\n$$",
      "answer_fields": [
