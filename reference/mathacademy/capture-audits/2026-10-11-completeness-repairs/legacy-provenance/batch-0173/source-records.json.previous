    "question": {
      "math_academy_id": "q-1405",
      "knowledge_point_id": "733eab11-2a26-5402-8df5-bba50c9beaf9",
      "knowledge_point": "Calculating the Cross Product Using Determinants",
      "problem": "Let $u=⟨-3,10,4⟩$ and $v=⟨4,7,1⟩.$ Find $u\\times v.$",
      "worked_solution": "Using the determinant formula, we get\n\n$$\n\\begin{aligned}u\\times v & =|\\begin{aligned}i & j & k \\\\ -3 & 10 & 4 \\\\ 4 & 7 & 1\\end{aligned}| \\\\  & =|\\begin{aligned}10 & 4 \\\\ 7 & 1\\end{aligned}|i-|\\begin{aligned}-3 & 4 \\\\ 4 & 1\\end{aligned}|j+|\\begin{aligned}-3 & 10 \\\\ 4 & 7\\end{aligned}|k \\\\  & =(10\\cdot 1-4\\cdot 7)i-((-3)\\cdot 1-4\\cdot 4)j+((-3)\\cdot 7-10\\cdot 4)k \\\\  & =(10-28)i-(-3-16)j+(-21-40)k \\\\  & =-18i+19j-61k \\\\  & =⟨-18,19,-61⟩.\\end{aligned}\n$$",
      "answer_fields": [
        {
          "key": "selection",
          "type": "radio",
          "choices_complete": true,
          "choices": [
