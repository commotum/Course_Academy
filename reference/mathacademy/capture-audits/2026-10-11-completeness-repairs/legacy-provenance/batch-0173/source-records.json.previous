            },
            {
              "type": "math",
              "value": "[\\begin{aligned}0 & 0 & 1 \\\\ 1 & 0 & 0 \\\\ 0 & 1 & 0\\end{aligned}]",
              "option": "1",
              "source_option": "b"
            },
            {
              "type": "math",
              "value": "[\\begin{aligned}0 & 1 & 0 \\\\ 0 & 0 & 1 \\\\ 1 & 0 & 0\\end{aligned}]",
              "option": "2",
              "source_option": "c"
            },
            {
              "type": "math",
              "value": "[\\begin{aligned}0 & 0 & -1 \\\\ -1 & 0 & 0 \\\\ 0 & -1 & 0\\end{aligned}]",
