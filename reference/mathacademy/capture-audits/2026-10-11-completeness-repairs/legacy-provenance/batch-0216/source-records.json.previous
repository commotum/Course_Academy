              "type": "math",
              "value": "e\\,i+2j",
              "option": "1",
              "source_option": "b"
            },
            {
              "type": "math",
              "value": "i-2e\\,k",
              "option": "2",
              "source_option": "c"
            },
            {
              "type": "math",
              "value": "i-2j+2e\\,k",
              "option": "3",
              "source_option": "d"
            },
            {
              "type": "math",
              "value": "e\\,k",
              "option": "4",
              "source_option": "e"
            }
          ]
        }
      ],
      "source_answer_policy": {
