              "value": "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14100214/assets/2132ac0140fb0b96a876fd04a1069d6922662c72d4d8f4b8880eacae458f8181.png",
              "option": "1",
              "source_option": "b"
            },
            {
