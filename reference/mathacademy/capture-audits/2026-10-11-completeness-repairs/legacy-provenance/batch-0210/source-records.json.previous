      "assets": [
        {
          "path": "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14100385/assets/da7778322523d0d18a5d5e24af075709958d329fc0053c836fd6637aa912752d.png",
          "sha256": "da7778322523d0d18a5d5e24af075709958d329fc0053c836fd6637aa912752d"
