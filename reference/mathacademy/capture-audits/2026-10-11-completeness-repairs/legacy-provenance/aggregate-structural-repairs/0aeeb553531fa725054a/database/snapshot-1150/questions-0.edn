#{[{:db/id #edb/ref 17592186129481 :knowledge-point/_questions [{:db/id #edb/ref 17592186129252 :knowledge-point/id #uuid "93d45138-b681-55c0-8910-1400bdf717c5" :knowledge-point/title "Finding the Time when a Particle Reaches a Particular Velocity"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "71811c86-dfc1-5f5a-a4b3-51b613597427" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "t=3\\,\\text{s}" :db/id #edb/ref 17592186400738} {:answer/id #uuid "14045dd5-56a2-56b3-8a1b-32ff353cc995" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "t=1\\,\\text{s}" :db/id #edb/ref 17592186400739} {:answer/id #uuid "9dfea80d-d958-5442-ae1c-80f233864941" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "No solution" :db/id #edb/ref 17592186400740} {:answer/id #uuid "61d086d5-f1b1-5ae6-a501-43af3ee40f2b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "t=6\\,\\text{s}" :db/id #edb/ref 17592186400741} {:answer/id #uuid "30c355e9-d6a5-5ca6-8952-9e4063f7db10" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "t=2\\,\\text{s}" :db/id #edb/ref 17592186400742}] :answer-field/correct {:answer/id #uuid "71811c86-dfc1-5f5a-a4b3-51b613597427" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "t=3\\,\\text{s}" :db/id #edb/ref 17592186400738} :answer-field/id #uuid "2bdb9de5-d1fb-5bbe-8ab8-96d3464f5245" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186400737}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "7c82e497-5ec7-5624-8331-c5c43f9eb1a8" :question/math-academy-id "q-136291" :question/problem "A particle moves with a constant acceleration of $(3i+2j)\\,{\\text{m/s}}^{2}.$ The velocity of the particle is $(-7i-6j)\\,\\text{m/s}$ when $t=0\\,\\text{s}.$ Find the time when the velocity of the particle equals $2i\\,\\text{m/s}.$" :question/worked-solution "Recall that when a particle moves with constant acceleration, the velocity vector at time $t$ can be found using\n\n$$\nv=u+at,\n$$\n\nwhere $u$ is the initial velocity, and $a$ is the acceleration of the particle.\n\nSubstituting \n\n$$\na=3i+2j,\\,u=-7i-6j,\\,v=2i\n$$\n\ninto the equation above, we can solve for $t,$ as follows:\n\n$$\n\\begin{aligned}v & =u+at \\\\ 2i & =(-7i-6j)+(3i+2j)t \\\\ 9i+6j & =(3i+2j)t \\\\ 9i+6j & =3ti+2tj\\end{aligned}\n$$\n\nEquating the $i$ and $j$ components in the last equation, we obtain\n\n$$\n\\{\\begin{aligned}9=3t \\\\ 6=2t\\end{aligned}\\,⟹\\,t=3\\,\\text{s}.\n$$"}] [{:db/id #edb/ref 17592186198778 :knowledge-point/_questions [{:db/id #edb/ref 17592186198273 :knowledge-point/id #uuid "e2aee319-68d6-54f7-8023-b24d32610bc4" :knowledge-point/title "Sketching Cartesian Products of Special Sets in the Coordinate Plane"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "eaa5394f-664d-516c-a7ca-0034c1aac434" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/17/179fea73a29a658124583602bf26485b25ba70f66ca8187c47d745f46de25e1d.png" :db/id #edb/ref 17592186389890} {:answer/id #uuid "cc7583ed-df6d-5be7-bfdd-4f5596ff6fe8" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/89/89ac9e71d8152097657f0c01daecf2b894dc142db4ba27fbfadcb8ded6e9cb19.png" :db/id #edb/ref 17592186389891} {:answer/id #uuid "eb3bbeb0-b786-56a0-af4c-ce843e2f2a0d" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/b8/b8a268a69a978e7f9a14afd83c7c14735d797d4359826ae86f84873e53635363.png" :db/id #edb/ref 17592186389892} {:answer/id #uuid "df54159c-0862-5afe-bf76-a3155b444d65" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/ac/acccce074e5dee93bbca149c16c5f7794dce17d1cd16432d25b0132382d877f8.png" :db/id #edb/ref 17592186389893} {:answer/id #uuid "a8c9bb19-93d6-5bb3-b166-5ed944544ba3" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/0a/0a03f883f977e67b9299d52e1572e484ed6010dc4f2555c7cbc2048f193dbc7f.png" :db/id #edb/ref 17592186389894}] :answer-field/correct {:answer/id #uuid "eb3bbeb0-b786-56a0-af4c-ce843e2f2a0d" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/b8/b8a268a69a978e7f9a14afd83c7c14735d797d4359826ae86f84873e53635363.png" :db/id #edb/ref 17592186389892} :answer-field/id #uuid "21c822ca-1685-5918-acdb-d7b9f7059651" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186389889}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "2bbd8412-3c29-5dd3-ab23-10004aeed05b" :question/math-academy-id "q-181303" :question/problem "Which of the following is a representation of the set $S=R\\times N$ in the Cartesian plane?" :question/worked-solution "The Cartesian product $A\\times B$ consists of all ordered pairs whose first coordinate belongs to $A$ and whose second coordinate belongs to $B.$\n\n$$\nA\\times B=\\{(a,b)\\,:\\,a\\in A,\\,b\\in B\\}\n$$\n\nIn this case, the set \n\n$$\nS=R\\times N\n$$\n\n \ncontains every point in ${R}^{2}$ whose $x$-coordinate is a real number and whose $y$-coordinate is a natural number.\n\n$$\nS=\\{(x,y)\\,:\\,x\\in R,\\,y\\in N\\}\n$$\n\nTo visualize $S,$ consider ${S}_{1}⊂S$ containing all points whose $x$-coordinate is any real number and whose $y$-coordinate equals $1.$\n\n$$\n{S}_{1}=\\{(x,1)\\,:\\,x\\in R\\}\n$$\n\nWe can represent ${S}_{1}$ in the plane as follows:\n\n![](images/f8/f8808e4c35775c754dab0bf328a8d129e423009e18ec5f4b962461eba2afcea2.png)\n\nNext, consider ${S}_{2}⊂S$ containing all points whose $x$-coordinate is any real number and whose $y$-coordinate equals $2.$\n\n$$\n{S}_{2}=\\{(x,2)\\,:\\,x\\in R\\}.\n$$\n\nWe can represent ${S}_{2}$ in the plane as follows:\n\n![](images/a5/a51fe9dc5bf7c55b01f72a45d4b88bde4653f0d3da85c1231b0d54c76a6e8c81.png)\n\nWe can create the subsets ${S}_{3},{S}_{4},{S}_{5},…$ similarly. Our Cartesian product consists of the *union* of these subsets:\n\n$$\n\\begin{aligned}R\\times N & ={S}_{1}\\cup {S}_{2}\\cup {S}_{3}\\cup … \\\\  & ={⋃}_{i\\in N}{S}_{i}\\end{aligned}\n$$\n\nTherefore, we can visualize $R\\times N$ as the set of horizontal lines shown in the diagram below.\n\n![](images/7a/7ae3c488e60d3dcda304649e575a7d2efc54be7262a54d0455550af420c39b68.png)"}] [{:db/id #edb/ref 17592186069334 :knowledge-point/_questions [{:db/id #edb/ref 17592186068885 :knowledge-point/id #uuid "05669abb-838d-5b1c-b97f-833a28b1d413" :knowledge-point/title "Finding the Intersection Points in the Case of One or No Solutions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "962a836e-7e7f-5b74-b466-74f9bd961b9e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "Undefined because the curve and the line do not intersect." :db/id #edb/ref 17592186402751} {:answer/id #uuid "77e775d2-5c5f-53ca-8556-acf6dc6fb1d2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186402752} {:answer/id #uuid "a16d7da4-393e-5805-87b6-3a9b82bafe2f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186402753} {:answer/id #uuid "123f0263-f92c-574c-8223-205921ca12c8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186402754} {:answer/id #uuid "5842cb4f-dfe1-5bcd-a5d1-aca7e442c719" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186402755}] :answer-field/correct {:answer/id #uuid "962a836e-7e7f-5b74-b466-74f9bd961b9e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "Undefined because the curve and the line do not intersect." :db/id #edb/ref 17592186402751} :answer-field/id #uuid "5d28ac66-acba-540c-ab94-2ffd038f2893" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186402750}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "801b9317-386e-554f-9207-4d232469922d" :question/math-academy-id "q-41957" :question/problem "If the line $y=-2x+3$ and the curve $y=\\frac{2}{x-2}+1$ intersect at the point $(p,q),$ then $p+q=$" :question/worked-solution "We need to solve the following system of equations:\n\n$$\n\\{\\begin{aligned}y=-2x+3 &  \\\\ y=\\frac{2}{x-2}+1\\end{aligned}\n$$\n\nSetting the equations equal to one another and solving, we get a quadratic equation:\n\n$$\n\\begin{aligned}-2x+3 & =\\frac{2}{x-2}+1 \\\\ -2x+2 & =\\frac{2}{x-2} \\\\ (-2x+2)(x-2) & =2 \\\\ 2(-x+1)(x-2) & =2 \\\\ (-x+1)(x-2) & =1 \\\\ -{x}^{2}+3x-2 & =1 \\\\ {x}^{2}-3x+3 & =0\\end{aligned}\n$$\n\nThen, we use the quadratic formula:\n\n$$\n\\begin{aligned}x & =\\frac{-3\\pm \\sqrt{{3}^{2}-4(1)(3)}}{2(1)} \\\\  & =\\frac{-3\\pm \\sqrt{9-12}}{2} \\\\  & =\\frac{-3\\pm \\sqrt{-3}}{2}\\end{aligned}\n$$\n\nThe square root of a negative number is not a real number, so there are no real solutions. Consequently, the line $y=-2x+3$ does not intersect the hyperbola $y=\\frac{2}{x-2}+1.$\n\nA sketch of the situation is shown below.\n\n![](images/41/41fee04552a47d93f1dbd788e69e12c4b58e377ec4c0b63c3ed55c712d337f94.png)"}] [{:db/id #edb/ref 17592186064888 :knowledge-point/_questions [{:db/id #edb/ref 17592186064317 :knowledge-point/id #uuid "fa1ddb40-3494-541c-b23e-b15dd98bf669" :knowledge-point/title "Identifying the Reason for a Discontinuity"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f4b4b7f1-de87-51e2-9ed4-2f2cacacaf29" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$f(x)$ is a piecewise function" :db/id #edb/ref 17592186403019} {:answer/id #uuid "84f08e7a-96c7-57e5-8318-9498325cc5c0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{lim}_{x\\to -{1}^{-}}f(x)\\ne {lim}_{x\\to -{1}^{+}}f(x)" :db/id #edb/ref 17592186403020} {:answer/id #uuid "de5ec02c-27a2-5d7d-8fe3-b0875d4201ba" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$f(-1)$ does not exist" :db/id #edb/ref 17592186403021} {:answer/id #uuid "60166612-0904-52f0-96ae-69b9e3a2f0dd" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "${lim}_{x\\to -{1}^{+}}f(x)$ does not exist" :db/id #edb/ref 17592186403022} {:answer/id #uuid "3265516b-d79e-586e-a42e-0a19b7a4fb6b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{lim}_{x\\to -1}f(x)\\ne f(-1)" :db/id #edb/ref 17592186403023}] :answer-field/correct {:answer/id #uuid "84f08e7a-96c7-57e5-8318-9498325cc5c0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{lim}_{x\\to -{1}^{-}}f(x)\\ne {lim}_{x\\to -{1}^{+}}f(x)" :db/id #edb/ref 17592186403020} :answer-field/id #uuid "5c9ecb96-b0c8-577b-ba89-04233ae88d06" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186403018}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "ca98ec7d-0763-558c-b634-f1da93c05079" :question/math-academy-id "q-51054" :question/problem "For what reason does the function $f(x)$ below have a discontinuity at $x=-1?$ \n\n$$\nf(x)=\\{\\begin{aligned}{x}^{3}+x, & x<-1 \\\\ {x}^{2}+1, & x\\ge -1\\end{aligned}\n$$" :question/worked-solution "Let's check the conditions necessary for $f(x)$ to be continuous at $x=2.$\n\n- $f(-1)=(-1)^{2}+1=2,$ so $f(-1)$ exists. $✓$\n\n- We calculate the one-sided limits and check if they coincide:\n\n$$\n\\begin{aligned}{lim}_{x\\to (-1)^{-}}f(x) & ={lim}_{x\\to (-1)^{-}}({x}^{3}+x) \\\\  & =(-1)^{3}+(-1) \\\\  & =-2, \\\\ {lim}_{x\\to (-1)^{+}}f(x) & ={lim}_{x\\to (-1)^{+}}({x}^{2}+1) \\\\  & =(-1)^{2}+1 \\\\  & =2.\\end{aligned}\n$$\n\nSo, the one-sided limits exist but are not equal. $\\,\\,\\times $ $\\,\\,\\,$\n\nTherefore, the function $f(x)$ has a discontinuity at $x=-1$ because ${lim}_{x\\to (-1)^{-}}f(x)\\ne {lim}_{x\\to (-1)^{+}}f(x).$"}]}
