7592186045493} :db/id #edb/ref 17592186420091}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "b8302ddf-29cf-570b-b7dd-dab545b3b824" :question/math-academy-id "q-162647" :question/problem "The domain of the vector-valued function $f(t)=\\operatorname{sec}⁡(t+\\frac{\\pi }{4})\\,i+{e}^{t-1}\\,j+{t}^{2}\\,k$ is \n\n$$\nt\\in (-\\infty ,\\infty ),\\,t\\ne .\n$$\n\nWhat is the missing expression? You may assume that $n$ is an integer." :question/worked-solution "To find the domain of $f$, we need the intersection of the domains of the individual components.\n\n- The domain of the 1st component $\\operatorname{sec}⁡(t+\\frac{\\pi }{4})$ is $t\\in (-\\infty ,\\infty ),$ except for the values of $t$ for which\n\n$$\nt+\\frac{\\pi }{4}=\\frac{\\pi }{2}+\\pi n\\,⟹\\,t=\\frac{\\pi }{4}+\\pi n,\n$$\n\nwhere $n$ is an integer.\n\n- The domain of the 2nd component ${e}^{t-1}$ is $t\\in (-\\infty ,\\infty ).$\n\n- The domain of the 3rd component ${t}^{2}$ is $t\\in (-\\infty ,\\infty ).$\n\nTherefore, the domain of the vector-valued function $f(t)$ is \n\n$$\nt\\in (-\\infty ,\\infty ),\\,t\\ne \\frac{\\pi }{4}+\\pi n,\n$$\n\nwhere $n$ is an integer."} :step/id #uuid "0dbe3293-2708-527b-b605-9fe12b6e37f9" :step/next {:db/id #edb/ref 17592186420098}} {:db/id #edb/ref 17592186420095 :step/content {:db/id #edb/ref 17592186420092 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1000e325-da05-5f3a-9e1d-24312518777d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "t\\in (-1,0)\\cup (0,\\infty )" :db/id #edb/ref 17592186420080} {:answer/id #uuid "2478ad2d-b6eb-59d1-b76b-abe7a69ec247" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "t\\in (-\\infty ,0)" :db/id #edb/ref 17592186420081} {:answer/id #uuid "691ebfd7-4000-5575-996f-d102ad66730b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "t\\in (-1,\\infty )" :db/id #edb/ref 17592186420084} {:answer/id #uuid "94b764b3-edc6-585d-9049-19b093287871" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "t\\in (-1,0)" :db/id #edb/ref 17592186420086} {:answer/id #uuid "b312f764-3451-5f4e-9cfb-871263b18b8d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "t\\in (0,1)\\cup (1,\\infty )" :db/id #edb/ref 17592186420088}] :answer-field/correct {:db/id #edb/ref 17592186420080} :answer-field/id #uuid "02381afc-745d-58f1-8f0d-9b55ea92ca31" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186420090}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "7a104075-f533-58ab-b79b-2a5e66b667e2" :question/math-academy-id "q-162660" :question/problem "Find the domain of the vector-valued function $f(t)=⟨{e}^{-t},\\,\\frac{1}{t},\\,\\operatorname{ln}⁡(t+1)⟩.$" :question/worked-solution "To find the domain of $f$, we need the intersection of the domains of the individual components.\n\n- The domain of the 1st component ${e}^{-t}$ is $t\\in (-\\infty ,\\infty ).$\n\n- The domain of the 2nd component $\\frac{1}{t}$ is $t\\in (-\\infty ,0)\\cup (0,\\infty ).$\n\n- The domain of the 3rd component $\\operatorname{ln}⁡(t+1)$ is $t\\in (-1,\\infty ).$\n\nThe intersection is illustrated in the diagram below.\n\n![](images/a5/a55ef2c927b26c9beba9b44f669c817cf749b79de163b4bf0505d15c6ec31630.png)\n\nTherefore, the domain of the vector-valued function $f(t)$ is $t\\in (-1,0)\\cup (0,\\infty ).$"} :step/id #uuid "69b7e384-7af7-55ae-bcb8-73eecb04e14a"} {:db/id #edb/ref 17592186420096 :step/content {:db/id #edb/ref 17592186115513 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "590ce956-fa57-52c8-b676-c7a081a32b28" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "s\\in (-1,1)" :db/id #edb/ref 17592186276280} {:answer/id #uuid "8d377bcc-370f-51f9-b994-f8649f51617b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "s\\in (-\\infty ,1)" :db/id #edb/ref 17592186276755} {:answer/id #uuid "928012b6-5d37-57e3-ab1c-585b2c67c370" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "s\\in (0,1)" :db/id #edb/ref 17592186276802} {:answer/id #uuid "c07039d3-aec7-5e92-9950-c14bc1351f86" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "s\\in (-1,0)" :db/id #edb/ref 17592186277186} {:answer/id #uuid "eee05247-e752-5968-abb0-796894121233" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "s\\in (-1,\\infty )" :db/id #edb/ref 17592186277576}] :answer-field/correct {:db/id #edb/ref 17592186276280} :answer-field/id #uuid "2c4c6d8a-57de-5558-ae04-0e3791190f90" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186277797}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "56023ec9-5ce1-5f4b-8f47-3c4d6d6b2dd7" :question/math-academy-id "q-160789" :question/problem "Find the domain of the vector-valued function $f(s)=⟨\\operatorname{ln}⁡(1+s),\\,\\operatorname{ln}⁡(1-s),\\,\\frac{1}{1+s}⟩.$" :question/worked-solution "To find the domain of $f$, we need the intersection of the domains of the individual components. \n\n- The domain of $\\operatorname{ln}⁡(1+s)$ is $s\\in (-1,\\infty )$ .\n\n- The domain of $\\operatorname{ln}⁡(1-s)$ is $s\\in (-\\infty ,1).$\n\n- The domain of $\\frac{1}{1+s}$ is  $s\\in (-\\infty ,-1)\\cup (-1,\\infty ).$\n\nThe intersection is illustrated in the diagram below.\n\n![](images/3a/3ac2933afc460e42ad5bffb8b01b9fc3ff9275ab3bcf2ac3ab710a8094b36637.png)\n\nTherefore, the domain of the vector-valued function $f(s)$ is\n\n$\\,$ $s\\in (-1,1).$"} :step/id #uuid "743b0666-1b94-5795-b0db-227efb4df31d" :step/next {:db/id #edb/ref 17592186420097}} {:db/id #edb/ref 17592186420097 :step/content {:db/id #edb/ref 17592186281514 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "138b2176-ecc6-57f2-bc6d-f1652a33636a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\pi }{6}+\\pi n" :db/id #edb/ref 17592186278767} {:answer/id #uuid "2444e896-56b2-5fe6-9c12-ded17b4df5eb" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\pi }{2}+\\frac{\\pi n}{3}" :db/id #edb/ref 17592186278916} {:answer/id #uuid "5fb99ab6-2b20-5f51-ac07-2107a5729fb6" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\pi }{3}+\\frac{\\pi n}{2}" :db/id #edb/ref 17592186279469} {:answer/id #uuid "9484619f-2ead-592d-844c-a164a8fc5f1f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{2\\pi n}{3}" :db/id #edb/ref 17592186279912} {:answer/id #uuid "d1436dab-1fe3-50c6-a9d0-651b17cd161f" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{\\pi n}{6}" :db/id #edb/ref 17592186280437}] :answer-field/correct {:db/id #edb/ref 17592186278767} :answer-field/id #uuid "064586b1-f0a2-55e9-ab4f-1edb28541b5f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186280841}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "355588e1-74ab-5c1c-9491-56bf772d1b60" :question/math-academy-id "q-162645" :question/problem "The domain of the vector-valued function $f(t)={t}^{3}\\,i+\\operatorname{sec}⁡(t+\\frac{\\pi }{3})\\,j+\\sqrt{2{t}^{2}+1}\\,k$ is \n\n$$\nt\\in (-\\infty ,\\infty ),\\,t\\ne .\n$$\n\nWhat is the missing expression? You may assume that $n$ is an integer." :question/worked-solution "To find the domain of $f$, we need the intersection of the domains of the individual components.\n\n- The domain of the 1st component ${t}^{3}$ is $t\\in (-\\infty ,\\infty ).$\n\n- The domain of the 2nd component $\\operatorname{sec}⁡(t+\\frac{\\pi }{3})$ is $t\\in (-\\infty ,\\infty ),$ except for the values of $t$ for which\n\n$$\nt+\\frac{\\pi }{3}=\\frac{\\pi }{2}+\\pi n\\,⟹\\,t=\\frac{\\pi }{6}+\\pi n,\n$$\n\nwhere $n$ is an integer.\n\n- The domain of the 3rd component $\\sqrt{2{t}^{2}+1}$ is $t\\in (-\\infty ,\\infty ).$\n\nTherefore, the domain of the vector-valued function $f(t)$ is \n\n$$\nt\\in (-\\infty ,\\infty ),\\,t\\ne \\frac{\\pi }{6}+\\pi n,\n$$\n\nwhere $n$ is an integer."} :step/id #uuid "85c58b22-fe0d-57c2-b692-2346cf29a3ec" :step/next {:db/id #edb/ref 17592186420094}} {:db/id #edb/ref 17592186420098 :step/content {:db/id #edb/ref 17592186281522 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "172da4c2-2750-5a8d-a86a-b97c9604fbad" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "s\\in (1,2)" :db/id #edb/ref 17592186278799} {:answer/id #uuid "7684847d-5d27-5cac-b143-1ec0db86e152" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "s\\in [0,\\infty )" :db/id #edb/ref 17592186279647} {:answer/id #uuid "9ea5e2b2-027e-5a73-b7b3-004b4999d8bd" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "s\\in [0,2)\\cup (2,\\infty )" :db/id #edb/ref 17592186279999} {:answer/id #uuid "9fec719b-cb40-5f1c-9f1f-fe5c3833e5f9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "s\\in (-\\infty ,2)" :db/id #edb/ref 17592186280014} {:answer/id #uuid "f1ac898a-8049-5e2b-8b24-531f56c455b1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "s\\in [0,2)" :db/id #edb/ref 17592186280697}] :answer-field/correct {:db/id #edb/ref 17592186280697} :answer-field/id #uuid "951bda09-c9a0-55cd-9b45-dcd0ac3017cf" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186281101}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "86e56d87-8f7f-5aac-9c51-653244b0266e" :question/math-academy-id "q-162659" :question/problem "Find the domain of the vector-valued function $f(s)=⟨\\sqrt{s},\\,\\operatorname{ln}⁡(2-s),\\,\\sqrt{3}⟩.$" :question/worked-solution "To find the domain of $f$, we need the intersection of the domains of the individual components.\n\n- The domain of the 1st component $\\sqrt{s}$ is $s\\in [0,\\infty ).$\n\n- The domain of the 2nd component $\\operatorname{ln}⁡(2-s)$ is $s\\in (-\\infty ,2).$\n\n- The domain of the 3rd component $\\sqrt{3}$ is $s\\in (-\\infty ,\\infty ).$\n\nThe intersection is illustrated in the diagram below.\n\n![](images/80/808abeaa59d7bcea3b24e741fde5296791de32b4170d60f05f2a5af203c20ba2.png)\n\nTherefore, the domain of the vector-valued function $f(s)$ is $s\\in [0,2).$"} :step/id #uuid "e7ce2d54-5c14-540f-93a3-4a8f924d9288" :step/next {:db/id #edb/ref 17592186420095}}] :activity/title "The Domain of a Vector-Valued Function" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186420079}] [{:activity/first-step {:db/id #edb/ref 17592186092995} :activity/id #uuid "95d8fd9f-fddb-5a11-8670-194ad28cdab0" :activity/scope {:db/id #edb/ref 17592186049392 :topic/id #uuid "f1031f6b-01e9-5ea8-af71-27bacc9d53b8" :topic/math-academy-id 1023} :activity/steps [{:db/id #edb/ref 17592186092995 :step/content {:db/id #edb/ref 17592186093403 :tutorial/content "We know that we can write a system of three linear equations in three variables in the form $A\\mathbf{x}=\\mathbf{b},$ where\n\n- $A$ is the $3\\times 3$ coefficient matrix,\n\n- $\\mathbf{x}$ is the column vector of variables, and\n\n- $\\mathbf{b}$ is the column vector of constants.\n\nIf the $3\\times 3$ matrix $A$ is invertible, then we can find a solution to the system $A\\mathbf{x} = \\mathbf{b}$ by \"pre-multiplying\" both sides of the equation by $A^{-1}{:}$\n\n$$\n\\begin{aligned}Ax & =b \\\\ {A}^{-1}Ax & ={A}^{-1}b \\\\ {I}_{3}x & ={A}^{-1}b \\\\ x & ={A}^{-1}b\\end{aligned}\n$$\n\nSo, to find the solution of $A\\mathbf{x}=\\mathbf{b},$ we simply calculate $\\mathbf{x}= A^{-1}\\mathbf{b}.$\n\nLet's see how this works for a particular system in the next example." :tutorial/id #uuid "4c0fe954-2cf5-5eb6-b58f-c6963f5be7f2" :tutorial/math-academy-id 3054 :tutorial/title "Introduction"} :step/id #uuid "8e9e60d9-ca5d-5380-9aad-e2eb767f920e" :step/math-academy-id 16484 :step/next {:db/id #edb/ref 17592186092996}} {:db/id #edb/ref 17592186092996 :step/content {:db/id #edb/ref 17592186092185 :knowledge-point/canonical-example {:db/id #edb/ref 17592186092025 :question/id #uuid "2737e6bc-5372-50a0-bf2f-59a91f571a57" :question/math-academy-id "e-4520"} :knowledge-point/id #uuid "12637b1d-ca03-568f-b1fc-6a626eec88de" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049151} {:db/id #edb/ref 17592186050825}] :knowledge-point/questions [{:db/id #edb/ref 17592186092817} {:db/id #edb/ref 17592186092818} {:db/id #edb/ref 17592186292892} {:db/id #edb/ref 17592186348080} {:db/id #edb/ref 17592186348093} {:db/id #edb/ref 17592186348094} {:db/id #edb/ref 17592186348095} {:db/id #edb/ref 17592186348096} {:db/id #edb/ref 17592186393877} {:db/id #edb/ref 17592186393884}] :knowledge-point/title "Solving a 3x3 System of Equations Given the Inverse of the Coefficient Matrix"} :step/id #uuid "e317b6ac-3382-5ce2-962a-936c0a5dc928" :step/math-academy-id 16485 :step/next {:db/id #edb/ref 17592186092997}} {:db/id #edb/ref 17592186092997 :step/content {:db/id #edb/ref 17592186092186 :knowledge-point/canonical-example {:db/id #edb/ref 17592186092026 :question/id #uuid "d32f2604-fc3f-5e80-8085-483e6fd9a3ad" :question/math-academy-id "e-4521"} :knowledge-point/id #uuid "4ad1721d-26a4-5459-bc81-297ff0e4d678" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049043}] :knowledge-point/questions [{:db/id #edb/ref 17592186092709} {:db/id #edb/ref 17592186092937} {:db/id #edb/ref 17592186237787} {:db/id #edb/ref 17592186237803} {:db/id #edb/ref 17592186237804} {:db/id #edb/ref 17592186237805} {:db/id #edb/ref 17592186237810} {:db/id #edb/ref 17592186237812} {:db/id #edb/ref 17592186237814} {:db/id #edb/ref 17592186240893} {:db/id #edb/ref 17592186240894} {:db/id #edb/ref 17592186240895} {:db/id #edb/ref 17592186292893} {:db/id #edb/ref 17592186415690}] :knowledge-point/title "Solving a 3x3 System of Equations By Calculating the Inverse of the Coefficient Matrix"} :step/id #uuid "fbf465d4-96d6-52f9-879f-09f247f27b80" :step/math-academy-id 16486 :step/next {:db/id #edb/ref 17592186092999}} {:db/id #edb/ref 17592186092999 :step/content {:db/id #edb/ref 17592186092187 :knowledge-point/canonical-example {:db/id #edb/ref 17592186092027 :question/id #uuid "06a50eb4-4976-55fd-aa44-6509b27eccb9" :question/math-academy-id "e-4604"} :knowledge-point/id #uuid "5d0cda54-4a4b-5255-b375-ce5e7b604dff" :knowledge-point/questions [{:db/id #edb/ref 17592186092813} {:db/id #edb/ref 17592186092819} {:db/id #edb/ref 17592186299656} {:db/id #edb/ref 17592186348097} {:db/id #edb/ref 17592186348098} {:db/id #edb/ref 17592186348099} {:db/id #edb/ref 17592186348100} {:db/id #edb/ref 17592186393856} {:db/id #edb/ref 17592186393891} {:db/id #edb/ref 17592186393898} {:db/id #edb/ref 17592186393905} {:db/id #edb/ref 17592186403947} {:db/id #edb/ref 17592186403954}] :knowledge-point/title "Solving a Matrix Equation Using Algebraic Manipulation"} :step/id #uuid "9a3ebe3d-7f48-57e9-995c-5652343c5b4a" :step/math-academy-id 16759}] :activity/title "Solving Systems of Equations Using Inverse Matrices" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186092406}] [{:activity/course {:db/id #edb/ref 17592186046673} :activity/first-step {:db/id #edb/ref 17592186415691} :activity/id #uuid "19f27baf-34c3-5e03-bcb6-d2509997eb57" :activity/scope {:db/id #edb/ref 17592186049392 :topic/id #uuid "f1031f6b-01e9-5ea8-af71-27bacc9d53b8" :topic/math-academy-id 1023} :activity/steps [{:db/id #edb/ref 17592186415691 :step/content {:db/id #edb/ref 17592186415690 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "546c8e95-b26b-5ff9-83d6-638b399b687a" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x=-\\frac{5}{2},y=9,z=-\\frac{9}{2}" :db/id #edb/ref 17592186415684} {:answer/id #uuid "854c87f7-583e-578a-92c5-d3db59792427" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x=\\frac{5}{2},y=9,z=\\frac{9}{2}" :db/id #edb/ref 17592186415685} {:answer/id #uuid "92176233-f61a-5a1f-a96a-0e59d129daf0" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x=-\\frac{5}{2},y=-9,z=-\\frac{9}{2}" :db/id #edb/ref 17592186415686} {:answer/id #uuid "922397fb-a6df-5cdc-b3c4-40ed001f749e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x=-5,y=18,z=-9" :db/id #edb/ref 17592186415687} {:answer/id #uuid "d2d344f8-2327-5d63-96e1-0bdf947cb05c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x=-5,y=-18,z=-9" :db/id #edb/ref 17592186415688}] :answer-field/correct {:db/id #edb/ref 17592186415684} :answer-field/id #uuid "e7180735-62b0-5917-9dd2-0f45d066402b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186415689}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "2997dd93-b478-5bad-935c-182c80540138" :question/math-academy-id "q-10091" :question/problem "Solve the following system of linear equations by finding the inverse of the coefficient matrix:\n\n$$\n\\begin{aligned}{\\begin{aligned}y+2z=0 \\\\ x+2y+3z=2 \\\\ 3x+y+z=-3\\end{aligned}\\end{aligned}\n$$" :question/worked-solution "We wish to write this system in the form $Ax=b$, where $A$ is a $3\\times 3$ matrix and $x$ and $b$ are $3\\times 1$ column vectors. We can do this as follows:\n\n$$\n[\\begin{aligned}0 & 1 & 2 \\\\ 1 & 2 & 3 \\\\ 3 & 1 & 1\\end{aligned}][\\begin{aligned}x \\\\ y \\\\ z\\end{aligned}]=[\\begin{aligned}0 \\\\ 2 \\\\ -3\\end{aligned}].\n$$\n\nNow, the solution to $Ax=b$ is given by $x={A}^{-1}b.$ So, we compute ${A}^{-1}$ as follows:\n\n*Step 1:*\n\n$$\n\\begin{aligned}det(A) & =|\\begin{aligned}0 & 1 & 2 \\\\ 1 & 2 & 3 \\\\ 3 & 1 & 1\\end{aligned}| \\\\  & =0|\\begin{aligned}2 & 3 \\\\ 1 & 1\\end{aligned}|-1|\\begin{aligned}1 & 3 \\\\ 3 & 1\\end{aligned}|+2|\\begin{aligned}1 & 2 \\\\ 3 & 1\\end{aligned}| \\\\  & =0-1(1-9)+2(1-6) \\\\  & =+8-10 \\\\  & =-2.\\end{aligned}\n$$\n\n*Step 2:*\n\n$$\n\\begin{aligned}M & =[\\begin{aligned}|\\begin{aligned}2 & 3 \\\\ 1 & 1\\end{aligned}| & |\\begin{aligned}1 & 3 \\\\ 3 & 1\\end{aligned}| & |\\begin{aligned}1 & 2 \\\\ 3 & 1\\end{aligned}| \\\\ |\\begin{aligned}1 & 2 \\\\ 1 & 1\\end{aligned}| & |\\begin{aligned}0 & 2 \\\\ 3 & 1\\end{aligned}| & |\\begin{aligned}0 & 1 \\\\ 3 & 1\\end{aligned}| \\\\ |\\begin{aligned}1 & 2 \\\\ 2 & 3\\end{aligned}| & |\\begin{aligned}0 & 2 \\\\ 1 & 3\\end{aligned}| & |\\begin{aligned}0 & 1 \\\\ 1 & 2\\end{aligned}|\\end{aligned}] \\\\  & =[\\begin{aligned}-1 & -8 & -5 \\\\ -1 & -6 & -3 \\\\ -1 & -2 & -1\\end{aligned}].\\end{aligned}\n$$\n\n*Step 3:*\n\n$$\nC=[\\begin{aligned}-1 & 8 & -5 \\\\ 1 & -6 & 3 \\\\ -1 & 2 & -1\\end{aligned}].\n$$\n\n*Step 4:*\n\n$$\n{C}^{T}=[\\begin{aligned}-1 & 1 & -1 \\\\ 8 & -6 & 2 \\\\ -5 & 3 & -1\\end{aligned}].\n$$\n\n*Step 5:*\n\n$$\n{A}^{-1}=\\frac{1}{det(A)}{C}^{T}=-\\frac{1}{2}[\\begin{aligned}-1 & 1 & -1 \\\\ 8 & -6 & 2 \\\\ -5 & 3 & -1\\end{aligned}]=\\frac{1}{2}[\\begin{aligned}1 & -1 & 1 \\\\ -8 & 6 & -2 \\\\ 5 & -3 & 1\\end{aligned}].\n$$\n\nHence\n\n$$\n\\begin{aligned}x & ={A}^{-1}b \\\\  & =\\frac{1}{2}[\\begin{aligned}1 & -1 & 1 \\\\ -8 & 6 & -2 \\\\ 5 & -3 & 1\\end{aligned}][\\begin{aligned}0 \\\\ 2 \\\\ -3\\end{aligned}] \\\\  & =[\\begin{aligned}-\\frac{5}{2} \\\\ 9 \\\\ -\\frac{9}{2}\\end{aligned}].\\end{aligned}\n$$\n\nHence the solution is $x=-\\frac{5}{2},y=9,z=-\\frac{9}{2}.$"} :step/id #uuid "100a637e-a49a-5d4a-80d2-e88a9e19ca4c" :step/next {:db/id #edb/ref 17592186415693}} {:db/id #edb/ref 17592186415692 :step/content {:db/id #edb/ref 17592186348099 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6788781d-31d5-5bd7-b27b-68afaa4d9325" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x=B\\,d\\,A" :db/id #edb/ref 17592186346254} {:answer/id #uuid "9bded5b5-b83d-570e-9629-cd29113e20b5" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x=B\\,d\\,{A}^{-1}" :db/id #edb/ref 17592186346708} {:answer/id #uuid "a4a497d7-ea8a-5a5f-b4fd-1d8c483ff5a2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x={A}^{-1}B\\,d" :db/id #edb/ref 17592186346783} {:answer/id #uuid "b6d2cc68-86a2-5604-8401-931a07c9e6b8" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x=BA\\,d" :db/id #edb/ref 17592186346945} {:answer/id #uuid "e304282a-e8e7-5d48-b8b7-fb2bbc3eab5d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "x=AB\\,d" :db/id #edb/ref 17592186347347}] :answer-field/correct {:db/id #edb/ref 17592186347347} :answer-field/id #uuid "b4e01459-2873-55b9-8f7c-c4fb473002de" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186347921}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "5f0cd9e3-58c9-5ff5-838e-38f22a6e88cb" :question/math-academy-id "q-78570" :question/problem "Consider a matrix equation ${A}^{-1}\\,x=B\\,d,$ where $A$ and $B$ are $7\\times 7$ non-singular matrices, while $x$ and $d$ are $7\\times 1$ column vectors. Solve the equation for $x.$" :question/worked-solution "Pre-multiplying both sides of the equation ${A}^{-1}\\,x=B\\,d$ by $A,$ we obtain\n\n$$\n\\begin{aligned}{A}^{-1}\\,x & =B\\,d \\\\ A{A}^{-1}\\,x & =AB\\,d \\\\ {I}_{7}\\,x & =AB\\,d \\\\ x & =AB\\,d.\\end{aligned}\n$$"} :step/id #uuid "227ec066-022a-52e9-9829-1a29de29e8db"} {:db/id #edb/ref 17592186415693 :step/content {:db/id #edb/ref 17592186403947 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "53d8f566-865b-5d1d-968f-ffc7aeaaf0b3" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "${D}^{-1}$ and ${I}_{n}$" :db/id #edb/ref 17592186403949} {:answer/id #uuid "6898f8cf-ef60-599d-b703-aeb35e14e141" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$D$ and ${I}_{n}$" :db/id #edb/ref 17592186403950} {:answer/id #uuid "0329ed6f-dee9-5205-b238-18984ed73972" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "${D}^{-1}$ and $D$" :db/id #edb/ref 17592186403951} {:answer/id #uuid "a15466de-3c65-5970-8e36-5b25e21ca209" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "${D}^{-1}$ and ${D}^{-1}$" :db/id #edb/ref 17592186403952} {:answer/id #uuid "daabc2d4-f4ce-50f8-9f41-a9e7585ac6e4" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$D$ and $z$" :db/id #edb/ref 17592186403953}] :answer-field/correct {:db/id #edb/ref 17592186403949} :answer-field/id #uuid "4cf7d7a2-cf8f-5d79-a5a3-2c7fb6abb055" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186403948}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "863bd08e-01cd-5a69-b3ce-bacc176f8b4b" :question/math-academy-id "q-78559" :question/problem "Consider a system of $n$ linear equations in $n$ variables, written in matrix form as $D\\,z=c.$ Here, $D$ is the non-singular coefficient matrix of the system, $z$ is the column vector containing the variables, and $c$ is the column vector containing the constants. The unique solution of the system can be found using the method shown below:\n\n$$\n\\begin{aligned}D\\,z & =c \\\\ {D}^{-1}D\\,z & =c \\\\ z & ={D}^{-1}\\,c \\\\ z & ={D}^{-1}\\,c\\end{aligned}\n$$\n\nFrom top to bottom and right to left, what are the missing parts of the derivation?" :question/worked-solution "Since $D$ is not singular, it must have an inverse ${D}^{-1}.$ Now, pre-multiplying both sides of the equation $D\\,z=c$ by ${D}^{-1},$ we obtain the following:\n\n$$\n\\begin{aligned}D\\,z & =c \\\\ {D}^{-1}D\\,z & ={D}^{-1}c \\\\ {I}_{n}\\,z & ={D}^{-1}\\,c \\\\ z & ={D}^{-1}\\,c\\end{aligned}\n$$\n\nTherefore, the missing parts are ${D}^{-1}$ and ${I}_{n}.$"} :step/id #uuid "42e8894e-d466-5fe7-9f98-3286e55d0c47" :step/next {:db/id #edb/ref 17592186415692}}] :activity/title "Solving Systems of Equations Using Inverse Matrices" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186415683}] [{:activity/first-step {:db/id #edb/ref 17592186176647} :activity/id #uuid "ba3db0d1-9e59-54ba-8333-7b4d2704786c" :activity/scope {:db/id #edb/ref 17592186050439 :topic/id #uuid "49438055-681b-5fc6-9557-4dc26eb4d02a" :topic/math-academy-id 3653} :activity/steps [{:db/id #edb/ref 17592186176647 :step/content {:db/id #edb/ref 17592186176972 :tutorial/content "The fundamental theorem of algebra tells us that any cubic polynomial with real coefficients has precisely three roots. \n\nMoreover, since complex roots always come in complex conjugate pairs, it follows that all cubic polynomials with real coefficients must have at least one *real* root.\n\nTherefore, if $p(x)$ is a cubic polynomial with real coefficients, we must have one of the following two cases:\n\n- $p(x)$ has $3$ real roots (some of which might be repeated).\n\n- $p(x)$ has $1$ real root and $2$ complex conjugate roots.\n\nWe already know how to deal with the first case. In this lesson, we will focus on the second case." :tutorial/id #uuid "1e4fb1e1-2a4f-5820-a1bb-030b54f54307" :tutorial/math-academy-id 3742 :tutorial/title "Introduction"} :step/id #uuid "c3b35516-9050-5de9-9956-de4d3d5d96fd" :step/math-academy-id 21003 :step/next {:db/id #edb/ref 17592186176648}} {:db/id #edb/ref 17592186176648 :step/content {:db/id #edb/ref 17592186175932 :knowledge-point/canonical-example {:db/id #edb/ref 17592186175787 :question/id #uuid "a6d40e97-c5d4-55e1-8a4c-56be1fc2d731" :question/math-academy-id "e-5794"} :knowledge-point/id #uuid "3f10a926-3cfd-5575-ae19-59f95cdca45f" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049645} {:db/id #edb/ref 17592186049695}] :knowledge-point/questions [{:db/id #edb/ref 17592186176206} {:db/id #edb/ref 17592186176578} {:db/id #edb/ref 17592186240890} {:db/id #edb/ref 17592186244075} {:db/id #edb/ref 17592186284700} {:db/id #edb/ref 17592186299665}] :knowledge-point/title "Finding the Roots of a Cubic Equation With Complex Roots Given One Real Root"} :step/id #uuid "82b36c18-ba6d-5831-a60e-2e47debf0739" :step/math-academy-id 21007 :step/next {:db/id #edb/ref 17592186176697}} {:db/id #edb/ref 17592186176697 :step/content {:db/id #edb/ref 17592186175963 :knowledge-point/canonical-example {:db/id #edb/ref 17592186175812 :question/id #uuid "054cbbc8-22ef-585d-bf8a-849eabdc09a2" :question/math-academy-id "e-8800"} :knowledge-point/id #uuid "9dc69a9e-6344-5a92-beb7-0c9fef8171d3" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186050117} {:db/id #edb/ref 17592186050384}] :knowledge-point/questions [{:db/id #edb/ref 17592186176176} {:db/id #edb/ref 17592186176210} {:db/id #edb/ref 17592186240891} {:db/id #edb/ref 17592186240892} {:db/id #edb/ref 17592186244076} {:db/id #edb/ref 17592186299666}] :knowledge-point/title "Finding the Roots of a Cubic Equation With Complex Roots Given One Complex Root"} :step/id #uuid "9b7b39ab-620f-56b3-bbab-cce8c9155e9d" :step/math-academy-id 32877}] :activity/title "Solving Cubic Equations With Complex Roots" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186176164}] [{:activity/first-step {:db/id #edb/ref 17592186199027} :activity/id #uuid "bd6ad418-e22b-5009-b330-e1172a694c56" :activity/scope {:db/id #edb/ref 17592186050536 :topic/id #uuid "51d6809f-cbef-5f23-be22-3c2d79930c37" :topic/math-academy-id 4218} :activity/steps [{:db/id #edb/ref 17592186199027 :step/content {:db/id #edb/ref 17592186199508 :tutorial/content "We can use differentiation to find the shortest distance between a point and a curve. \n\nFor example, let's find the smallest distance between the curve $y=\\sqrt{2x}+1$ and the point $(5,1),$ shown below.\n\n![](images/dc/dc1f5b350025a0fd0530531cfc887c148459194afe209e472701054c128f1079.png)\n\nTo solve this problem, we follow three steps:\n\n**Step 1.** Use the distance formula to create a function $S(x,y)$ representing the *squared* distance between $(5,1)$ and a general point $P(x, y){:}$\n\n$$\nS = (x-5)^2 + (y-1)^2\n$$\n\nWe require that the point $P$ lies on the curve $y=\\sqrt{2x}+1.$ Substituting this into the above gives\n\n$$\n\\begin{aligned}S(x) & =(x-5)^{2}+(y-1)^{2} \\\\  & =(x-5)^{2}+(\\sqrt{2x}+1-1)^{2} \\\\  & =(x-5)^{2}+(\\sqrt{2x})^{2} \\\\  & =(x-5)^{2}+2x \\\\  & ={x}^{2}-10x+25+2x \\\\  & ={x}^{2}-8x+25.\\end{aligned}\n$$\n\n**Step 2.** Calculate the first derivative $S'(x)$ and solve $S'(x) = 0$ to find the stationary point(s).\n\nComputing the derivative $S'(x),$ we get\n\n$$\n\\begin{aligned}{S}^{'}(x) & =2x-8.\\end{aligned}\n$$\n\nThe stationary points of $S(x)$ are the points where $S'(x) = 0.$ Solving this equation, we get\n\n$$\n\\begin{aligned}{S}^{'}(x) & =0 \\\\ 2x-8 & =0 \\\\ x & =4.\\end{aligned}\n$$\n\n**Step 3.** Use the first or second derivative tests to confirm that the stationary point minimizes the squared distance.\n\nComputing the second derivative, we have\n\n$$\nS''(4) = 2.\n$$\n\nSince $S''(4) > 0,$ the point $x=4$ is a minimum of $S(x)$ by the second derivative test.\n\nTherefore, we conclude that the squared distance (and therefore the actual distance) reaches a minimum when $x = 4.$ \n\nFinally, since $S$ gives the squared distance between the two points, the actual distance $d$ between the two points when $x=4$ is given by\n\n$$\n\\begin{aligned}d & =\\sqrt{S(4)} \\\\  & =\\sqrt{(4)^{2}-8(4)+25} \\\\  & =\\sqrt{9} \\\\  & =3.\\end{aligned}\n$$" :tutorial/id #uuid "ef45dd95-3bca-5734-a692-3cebc9f37432" :tutorial/math-academy-id 7893 :tutorial/title "Introduction"} :step/id #uuid "25198a50-d410-5851-a1cc-00f60435537f" :step/math-academy-id 119264 :step/next {:db/id #edb/ref 17592186199028}} {:db/id #edb/ref 17592186199028 :step/content {:db/id #edb/ref 17592186198246 :knowledge-point/canonical-example {:db/id #edb/ref 17592186198079 :question/id #uuid "39ffb646-57fa-5d6d-a81f-286948f66d83" :question/math-academy-id "e-12596"} :knowledge-point/id #uuid "38bfb48e-9b66-58a8-966a-fb6938e08073" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186050952}] :knowledge-point/questions [{:db/id #edb/ref 17592186198555} {:db/id #edb/ref 17592186198982} {:db/id #edb/ref 17592186253477} {:db/id #edb/ref 17592186332656} {:db/id #edb/ref 17592186332657} {:db/id #edb/ref 17592186399982} {:db/id #edb/ref 17592186403011}] :knowledge-point/title "Finding an Equation That Determines a Minimum Distance"} :step/id #uuid "e07168c9-fa86-5a07-b2f0-b9f7aade6c3b" :step/math-academy-id 119265 :step/next {:db/id #edb/ref 17592186199029}} {:db/id #edb/ref 17592186199029 :step/content {:db/id #edb/ref 17592186199507 :tutorial/content "If the squared distance function has multiple stationary points, we must use the candidates test for *global* extrema to identify which stationary point corresponds to the smallest distance.\n\nTo do that, we evaluate the squared distance at each stationary point and compare the results.\n\nMultiple critical points may correspond to the same squared distance. In such cases, like that shown in the graph below, there would be multiple points of minimum distance.\n\n![](images/de/dea83b2804a816eef505810237940e2d9bb8547ffe77549f833ac04823fa6d30.png)" :tutorial/id #uuid "c98fb0ba-d8a2-5069-b3c5-04961452caa3" :tutorial/math-academy-id 7889 :tutorial/title "The Candidates Test For Multiple Stationary Points"} :step/id #uuid "eff95439-12b9-5276-a8f1-b3b4ee7e96f1" :step/math-academy-id 119268 :step/next {:db/id #edb/ref 17592186199030}} {:db/id #edb/ref 17592186199030 :step/content {:db/id #edb/ref 17592186198247 :knowledge-point/canonical-example {:db/id #edb/ref 17592186198080 :question/id #uuid "4b55bd03-c8ad-55b2-a51e-7f875d382627" :question/math-academy-id "e-12597"} :knowledge-point/id #uuid "cbd4e2eb-d2c8-5447-9a28-4d7da6744712" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048162}] :knowledge-point/questions [{:db/id #edb/ref 17592186198683} {:db/id #edb/ref 17592186198901} {:db/id #edb/ref 17592186284674} {:db/id #edb/ref 17592186290282} {:db/id #edb/ref 17592186290283} {:db/id #edb/ref 17592186317547} {:db/id #edb/ref 17592186317549}] :knowledge-point/title "Determining the Closest Points on a Curve to a Point"} :step/id #uuid "97876c5f-6760-51ef-a427-274559dccac4" :step/math-academy-id 119269 :step/next {:db/id #edb/ref 17592186199031}} {:db/id #edb/ref 17592186199031 :step/content {:db/id #edb/ref 17592186198248 :knowledge-point/canonical-example {:db/id #edb/ref 17592186198083 :question/id #uuid "2bf999cc-9733-5f29-90e6-20d297efe352" :question/math-academy-id "e-12606"} :knowledge-point/id #uuid "2a7dfacc-de7b-555f-b83a-7b2c6faf69df" :knowledge-point/questions [{:db/id #edb/ref 17592186198913} {:db/id #edb/ref 17592186198944} {:db/id #edb/ref 17592186290284} {:db/id #edb/ref 17592186297424} {:db/id #edb/ref 17592186317552} {:db/id #edb/ref 17592186317555} {:db/id #edb/ref 17592186317556}] :knowledge-point/title "Determining the Smallest Distance From a Point to a Curve"} :step/id #uuid "798c8ee2-b4c9-57b8-b340-831e2641810f" :step/math-academy-id 119272}] :activity/title "Optimizing Distances to Curves" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186198506}]}
