b/ref 17592186045493 #edb/ref 17592186045417] [17592186362154 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186362154 #edb/ref 1078 #edb/ref 17592186361894 #edb/ref 17592186045417] [17592186362154 #edb/ref 1079 #uuid "bd6feca6-76ee-5295-b8ca-70efe4a6b0da" #edb/ref 17592186045417] [17592186362207 #edb/ref 1075 #edb/ref 17592186360845 #edb/ref 17592186045417] [17592186362207 #edb/ref 1075 #edb/ref 17592186360849 #edb/ref 17592186045417] [17592186362207 #edb/ref 1075 #edb/ref 17592186361050 #edb/ref 17592186045417] [17592186362207 #edb/ref 1075 #edb/ref 17592186361109 #edb/ref 17592186045417] [17592186362207 #edb/ref 1075 #edb/ref 17592186361677 #edb/ref 17592186045417] [17592186362207 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186362207 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186362207 #edb/ref 1078 #edb/ref 17592186361109 #edb/ref 17592186045417] [17592186362207 #edb/ref 1079 #uuid "fd49cbaa-d57f-5e0e-9cec-db71bf257efe" #edb/ref 17592186045417] [17592186362209 #edb/ref 1068 #edb/ref 17592186362122 #edb/ref 17592186045417] [17592186362209 #edb/ref 1069 "q-97519" #edb/ref 17592186045417] [17592186362209 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186362209 #edb/ref 1071 "Given $X∼B(7,0.9),$ compute $P(5\\le X\\le 6).$ Round your final answer to $4$ decimal places." #edb/ref 17592186045417] [17592186362209 #edb/ref 1072 #uuid "00ca7976-03b9-5638-95d5-695719b36e13" #edb/ref 17592186045417] [17592186362209 #edb/ref 1074 "For a binomial random variable $X∼B(n,p),$ where $n$ is the number of trials, and $p$ is the probability of success on each trial,  we have the following probability mass function:\n\n$$\nf(x)=(\\genfrac{}{}{0pt}{}{n}{x}){p}^{x}(1-p)^{n-x}\n$$\n\nHere, we have $X∼B(7,0.9),$ so $X$ has the probability mass function\n\n$$\nf(x)=(\\genfrac{}{}{0pt}{}{7}{x})(0.9)^{x}(0.1)^{7-x}.\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}P(5\\le X\\le 6) & =P(X\\in {5,6}) \\\\  & =f(5)+f(6) \\\\  & =(\\genfrac{}{}{0pt}{}{7}{5})(0.9)^{5}(0.1)^{7-5}+(\\genfrac{}{}{0pt}{}{7}{6})(0.9)^{6}(0.1)^{7-6} \\\\  & =21(0.9)^{5}(0.1)^{2}+7(0.9)^{6}(0.1) \\\\  & ≈0.4960\\end{aligned}\n$$\n\nto $4$ decimal places." #edb/ref 17592186045417] [17592186362210 #edb/ref 1068 #edb/ref 17592186362154 #edb/ref 17592186045417] [17592186362210 #edb/ref 1069 "q-97521" #edb/ref 17592186045417] [17592186362210 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186362210 #edb/ref 1071 "Given that $X∼B(7,0.5),$ compute $P(X\\le 6).$ Round your final answer to $4$ decimal places." #edb/ref 17592186045417] [17592186362210 #edb/ref 1072 #uuid "cd0fa54f-0d49-5cf3-b205-811b4116ac34" #edb/ref 17592186045417] [17592186362210 #edb/ref 1074 "For a binomial random variable $X∼B(n,p),$ we have the following probability mass function:\n\n$$\nf(x)=(\\genfrac{}{}{0pt}{}{n}{x}){p}^{x}(1-p)^{n-x}\n$$\n\nHere, we have $X∼B(7,0.5),$ so $X$ has the probability mass function\n\n$$\nf(x)=(\\genfrac{}{}{0pt}{}{7}{x})(0.5)^{x}(0.5)^{7-x}.\n$$\n\nComputing $P(X\\le 6)$ will require us to compute $f(x)$ at $x=0,1,2,…,6.$ However, if we compute the complement $P(X>6)$ instead, then we will only have to compute $f(x)$ at $x=7,$ which will result in a much faster computation.\n\nComputing $P(X>6),$ we get\n\n$$\n\\begin{aligned}P(X>6) & =P(X\\in {7}) \\\\  & =f(7) \\\\  & =(\\genfrac{}{}{0pt}{}{7}{7})(0.5)^{7}(0.5)^{7-7} \\\\  & =(0.5)^{7} \\\\  & ≈0.0078\\end{aligned}\n$$\n\nrounded to $4$ decimal places.\n\nTherefore, we have\n\n$$\n\\begin{aligned}P(X\\le 6) & =1-P(X>6) \\\\  & ≈1-0.0078 \\\\  & =0.9922\\end{aligned}\n$$\n\nrounded to $4$ decimal places." #edb/ref 17592186045417] [17592186362313 #edb/ref 1068 #edb/ref 17592186362004 #edb/ref 17592186045417] [17592186362313 #edb/ref 1069 "q-98700" #edb/ref 17592186045417] [17592186362313 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186362313 #edb/ref 1071 "![](images/4c/4c4ef140c85eb91bd01688cc2a447f13a21c2a51964c6d101887d15045cee95d.png)\n\nA particular autonomous differential equation has the phase line shown above. Which of the following statements are true?\n\n- $y=-2$ is a sink\n- $y=-2$ is a source\n- $y=2$ is a node" #edb/ref 17592186045417] [17592186362313 #edb/ref 1072 #uuid "dd0fe6f6-6555-578d-880a-04a4380b3213" #edb/ref 17592186045417] [17592186362313 #edb/ref 1074 "We can classify the equilibrium solutions of an autonomous ODE ${y}^{′}=f(y)$ by examining its phase line.\n\n- An equilibrium solution is a *sink* if the arrows directly above and below it on the phase line both point *toward* the equilibrium solution.\n\n- An equilibrium solution is a *source* if the arrows directly above and below it on the phase line both point *away* from the equilibrium solution.\n\n- An equilibrium solution is a *node* if the arrows directly above and below it on the phase line point in the same direction.\n\nLet's check each statement:\n\n- Statement I is true, while statement II is false. Notice that the arrow just above the point $y=-2$ points downward, and the arrow just below it points upward. In other words, both arrows point *toward* the point $y=-2.$This means that $y=-2$ is a sink.\n\n- Statement III is true. Notice that the arrow just above the point $y=2$ points downward, and the arrow just below it points downward too. In other words, both arrows point in the *same* direction on either side of $y=2.$ This means that $y=2$ is a node.\n\nTherefore, the correct answer is \"I and III only\"." #edb/ref 17592186045417] [17592186362319 #edb/ref 1068 #edb/ref 17592186361997 #edb/ref 17592186045417] [17592186362319 #edb/ref 1069 "q-98715" #edb/ref 17592186045417] [17592186362319 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186362319 #edb/ref 1071 "![](images/4a/4a2c0103fb348883b05692721162ffba17758beb0e6f944deb328a506fed8d21.png)\n\nConsiderer the differential equation $\\frac{\\text{d}y}{\\text{d}x}=f(y)$ where the graph of $f(y)$ is shown above. Which of the following statements are true?\n\n- $y=4$ is a source.\n- $y=2$ is a node.\n- $y=-1$ is a sink." #edb/ref 17592186045417] [17592186362319 #edb/ref 1072 #uuid "d67a28ee-e52e-5e0c-b902-450c792552a6" #edb/ref 17592186045417] [17592186362319 #edb/ref 1074 "We can classify the equilibrium solutions of an autonomous ODE ${y}^{′}=f(y)$ by examining its phase line.\n\n- An equilibrium solution is a *sink* if the arrows directly above and below it on the phase line both point *toward* the equilibrium solution.\n\n- An equilibrium solution is a *source* if the arrows directly above and below it on the phase line both point *away* from the equilibrium solution.\n\n- An equilibrium solution is a *node* if the arrows directly above and below it on the phase line point in the same direction.\n\nThe phase line that corresponds to the given graph is as follows:\n\n![](images/df/df340c40982e6d22ef8a815bf043f84fd78b43b4ddc1763845d03d4b2c793aee.png)\n\nTherefore, we have:\n\n- Statement I is false. From the phase line, we see that $y=4$ is a sink.\n\n- Statement II is false. From the phase line, we see that $y=2$ is a source.\n\n- Statement III is true. From the phase line, we see that $y=-1$ is a sink.\n\nTherefore, the correct answer is \"III only\"." #edb/ref 17592186045417] [17592186362322 #edb/ref 1068 #edb/ref 17592186362044 #edb/ref 17592186045417] [17592186362322 #edb/ref 1069 "q-98752" #edb/ref 17592186045417] [17592186362322 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186362322 #edb/ref 1071 "![](images/31/3114d1c94b63a2506a66e701346bc7367b901659b78a2cf7c191648c96a716dc.png)\n\nConsider the differential equation $\\frac{\\text{d}y}{\\text{d}x}=f(y)$ where the graph of $f(y)$ is shown above. Which of the following statements are true?\n\n- $y=3$ is a node.\n- $y=-1$ is a sink.\n- $y=-1$ is a source." #edb/ref 17592186045417] [17592186362322 #edb/ref 1072 #uuid "99cb8df0-a236-544f-967a-a702cdee4d6f" #edb/ref 17592186045417] [17592186362322 #edb/ref 1074 "We can classify the equilibrium solutions of an autonomous ODE ${y}^{′}=f(y)$ by examining its phase line.\n\n- An equilibrium solution is a *sink* if the arrows directly above and below it on the phase line both point *toward* the equilibrium solution.\n\n- An equilibrium solution is a *source* if the arrows directly above and below it on the phase line both point *away* from the equilibrium solution.\n\n- An equilibrium solution is a *node* if the arrows directly above and below it on the phase line point in the same direction.\n\nThe phase line that corresponds to the given graph is as follows:\n\n![](images/f7/f72f89ecad74cc708b5950763002757d9d012d3859c7a5bd5eb19ae60fc54e55.png)\n\nTherefore, we have:\n\n- Statement I is false. From the phase line, we see that $y=3$ is a sink.\n\n- Statement II is false while statement III is true. From the phase line, we see that $y=-1$ is a source.\n\nTherefore, the correct answer is \"III only\"." #edb/ref 17592186045417] [17592186362399 #edb/ref 1068 #edb/ref 17592186361984 #edb/ref 17592186045417] [17592186362399 #edb/ref 1069 "q-99961" #edb/ref 17592186045417] [17592186362399 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186362399 #edb/ref 1071 "For the piecewise function \n\n$$\nf(x)={\\begin{aligned}-x\\, & \\text{ for }\\,x\\le -1 \\\\ x+c\\, & \\text{ for }\\,x>-1\\end{aligned}\n$$\n\nit is known that ${lim}_{x\\to -1}f(x)=1.$ What is the value of the constant $c?$" #edb/ref 17592186045417] [17592186362399 #edb/ref 1072 #uuid "91708f0d-366e-5441-a87d-7b80b150a761" #edb/ref 17592186045417] [17592186362399 #edb/ref 1074 "In order for ${lim}_{x\\to -1}f(x)$ to be equal to $1,$ the left and right-sided limits must both exist and be equal to $1.$\n\n- Approaching from the left, we have $x<-1,$ so we use the expression $f(x)=-x.$ We get \n\n$$\n\\begin{aligned}{lim}_{x\\to (-1)^{-}}f(x) & ={lim}_{x\\to (-1)^{-}}(-x) \\\\  & =-(-1) \\\\  & =1.\\end{aligned}\n$$\n\n- Approaching from the right, we have $x>-1,$ so we use the expression $f(x)=x+c.$ We get\n\n$$\n\\begin{aligned}{lim}_{x\\to (-1)^{+}}f(x) & ={lim}_{x\\to (-1)^{+}}(x+c) \\\\  & =-1+c.\\end{aligned}\n$$\n\nFinally, since the left and right-sided limits must be equal, we have\n\n$$\n\\begin{aligned}{lim}_{x\\to (-1)^{-}}f(x) & ={lim}_{x\\to (-1)^{+}}f(x) \\\\ 1 & =-1+c \\\\ c & =2.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186370954 #edb/ref 1075 #edb/ref 17592186370955 #edb/ref 17592186045417] [17592186370954 #edb/ref 1075 #edb/ref 17592186370956 #edb/ref 17592186045417] [17592186370954 #edb/ref 1075 #edb/ref 17592186370957 #edb/ref 17592186045417] [17592186370954 #edb/ref 1075 #edb/ref 17592186370958 #edb/ref 17592186045417] [17592186370954 #edb/ref 1075 #edb/ref 17592186370959 #edb/ref 17592186045417] [17592186370954 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186370954 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186370954 #edb/ref 1078 #edb/ref 17592186370955 #edb/ref 17592186045417] [17592186370954 #edb/ref 1079 #uuid "59058239-7698-5829-8ac2-6fc0b1fe2dc4" #edb/ref 17592186045417] [17592186370955 #edb/ref 1080 "-9" #edb/ref 17592186045417] [17592186370955 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186370955 #edb/ref 1083 #uuid "f91b8ff9-f8eb-51b8-b52f-289c02818338" #edb/ref 17592186045417] [17592186370956 #edb/ref 1080 "9" #edb/ref 17592186045417] [17592186370956 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186370956 #edb/ref 1083 #uuid "f3e4a327-ea8e-530f-89f9-a4e243adc7d9" #edb/ref 17592186045417] [17592186370957 #edb/ref 1080 "-8" #edb/ref 17592186045417] [17592186370957 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186370957 #edb/ref 1083 #uuid "e926e6d7-8c6a-52a4-b903-1e9338a6f201" #edb/ref 17592186045417] [17592186370958 #edb/ref 1080 "11" #edb/ref 17592186045417] [17592186370958 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186370958 #edb/ref 10