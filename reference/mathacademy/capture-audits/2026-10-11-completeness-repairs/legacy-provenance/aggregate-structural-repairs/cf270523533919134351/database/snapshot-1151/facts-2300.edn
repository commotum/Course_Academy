493 #edb/ref 17592186045417] [17592186277931 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186277931 #edb/ref 1078 #edb/ref 17592186275520 #edb/ref 17592186045417] [17592186277931 #edb/ref 1079 #uuid "7489f911-b3ed-5658-95a0-34d33dc19d87" #edb/ref 17592186045417] [17592186277964 #edb/ref 1075 #edb/ref 17592186275588 #edb/ref 17592186045417] [17592186277964 #edb/ref 1075 #edb/ref 17592186276112 #edb/ref 17592186045417] [17592186277964 #edb/ref 1075 #edb/ref 17592186276587 #edb/ref 17592186045417] [17592186277964 #edb/ref 1075 #edb/ref 17592186276662 #edb/ref 17592186045417] [17592186277964 #edb/ref 1075 #edb/ref 17592186276909 #edb/ref 17592186045417] [17592186277964 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186277964 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186277964 #edb/ref 1078 #edb/ref 17592186276587 #edb/ref 17592186045417] [17592186277964 #edb/ref 1079 #uuid "86517bcb-97bd-5ba9-8706-7572bc681126" #edb/ref 17592186045417] [17592186278191 #edb/ref 1068 #edb/ref 17592186277964 #edb/ref 17592186045417] [17592186278191 #edb/ref 1069 "q-158447" #edb/ref 17592186045417] [17592186278191 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186278191 #edb/ref 1071 "Solve for $k$ given that the following function is a probability density function:\n\n$$\nf(x)=\\{\\begin{aligned}\\frac{{x}^{2}+1}{k},\\, & 1<x<4, \\\\ 0,\\, & \\text{otherwise.}\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186278191 #edb/ref 1072 #uuid "c1741b28-dd7a-521f-bff9-3881fb7d5bb4" #edb/ref 17592186045417] [17592186278191 #edb/ref 1074 "For a function $f(x)$ to be a valid probability density function on a set $S,$ it must satisfy the following conditions:\n\n- $f(x)\\ge 0$ for all $x\\in S$\n\n- ${\\int }_{S}f(x)\\,\\text{d}x=1$\n\nFor the given function, the second condition states that\n\n$$\n{\\int }_{1}^{4}\\frac{{x}^{2}+1}{k}\\,\\text{d}x=1.\n$$\n\nComputing the integral on the left-hand side, we get\n\n$$\n\\begin{aligned}{\\int }_{1}^{4}\\frac{{x}^{2}+1}{k}\\,\\text{d}x & =\\frac{1}{k}{\\int }_{1}^{4}({x}^{2}+1)\\,\\text{d}x \\\\  & =\\frac{1}{k}{[\\frac{{x}^{3}}{3}+x]}_{1}^{4} \\\\  & =\\frac{1}{k}([\\frac{64}{3}+4]-[\\frac{1}{3}+1]) \\\\  & =\\frac{1}{k}(21+3) \\\\  & =\\frac{24}{k}.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\frac{24}{k}=1\\,⟹\\,k=24.\n$$" #edb/ref 17592186045417] [17592186278322 #edb/ref 1068 #edb/ref 17592186277931 #edb/ref 17592186045417] [17592186278322 #edb/ref 1069 "q-160619" #edb/ref 17592186045417] [17592186278322 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186278322 #edb/ref 1071 "![](images/f3/f3e31d1c15a97adea32790eafe75ad1bc9f70c854b516b98de6648ec8d7bcb87.png)\n\nConsider the vector $v$ shown above. Find the vector $Av$ given that \n\n$$\nA=[\\begin{aligned}-1 & 0 \\\\ 0 & -1\\end{aligned}].\n$$" #edb/ref 17592186045417] [17592186278322 #edb/ref 1072 #uuid "ecda41b1-c814-51d0-b755-d1273a4b443b" #edb/ref 17592186045417] [17592186278322 #edb/ref 1074 "Consider the standard basis $\\{i,j\\}$ of the Euclidean plane ${R}^{2}$ and the unit square spanned by the vectors. Computing the images of $\\{i,j\\}$ under $A$, we get the following:\n\n$$\n\\begin{aligned}{i}^{′} & =A(i)=[\\begin{aligned}-1 & 0 \\\\ 0 & -1\\end{aligned}][\\begin{aligned}1 \\\\ 0\\end{aligned}]=[\\begin{aligned}-1 \\\\ 0\\end{aligned}]=-i \\\\ {j}^{′} & =A(j)=[\\begin{aligned}-1 & 0 \\\\ 0 & -1\\end{aligned}][\\begin{aligned}0 \\\\ 1\\end{aligned}]=[\\begin{aligned}0 \\\\ -1\\end{aligned}]=-j\\end{aligned}\n$$\n\nAs a result, we obtain the following diagram:\n\n![](images/9f/9fae3ec0ada3008937d88e4e76374a56da4369b1821cfee072c90d88b562df46.png)\n\nSo, the matrix represents a rotation of $\\pi $ radians (counterclockwise or clockwise) about the origin.\n\nTherefore, in order to find $Av$, we need to rotate $v$ (counterclockwise or clockwise) by an angle of $\\pi $ radians, as shown below.\n\n![](images/ae/ae800b271848948b5f60f5cd7c1cecd163c2aa7399e9a87e2a52d15885