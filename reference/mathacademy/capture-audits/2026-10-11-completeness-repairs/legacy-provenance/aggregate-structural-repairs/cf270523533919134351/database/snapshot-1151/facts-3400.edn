}{3}\\,j+\\frac{1}{3}\\,k\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186391618 #edb/ref 1075 #edb/ref 17592186391619 #edb/ref 17592186045417] [17592186391618 #edb/ref 1075 #edb/ref 17592186391620 #edb/ref 17592186045417] [17592186391618 #edb/ref 1075 #edb/ref 17592186391621 #edb/ref 17592186045417] [17592186391618 #edb/ref 1075 #edb/ref 17592186391622 #edb/ref 17592186045417] [17592186391618 #edb/ref 1075 #edb/ref 17592186391623 #edb/ref 17592186045417] [17592186391618 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186391618 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186391618 #edb/ref 1078 #edb/ref 17592186391620 #edb/ref 17592186045417] [17592186391618 #edb/ref 1079 #uuid "3d43ad92-b445-5432-aa1f-111fa6dcfbd4" #edb/ref 17592186045417] [17592186391619 #edb/ref 1080 "\\frac{1}{\\sqrt{6}}\\,i+\\frac{2}{\\sqrt{6}}\\,j+\\frac{1}{\\sqrt{6}}\\,k" #edb/ref 17592186045417] [17592186391619 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186391619 #edb/ref 1083 #uuid "9f60c71f-f1a0-5dc9-bc85-bc53e3b5d9e8" #edb/ref 17592186045417] [17592186391620 #edb/ref 1080 "\\frac{2}{3}\\,i+\\frac{2}{3}\\,j+\\frac{1}{3}\\,k" #edb/ref 17592186045417] [17592186391620 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186391620 #edb/ref 1083 #uuid "2f82adaf-7d79-546e-b51a-3d2064321d15" #edb/ref 17592186045417] [17592186391621 #edb/ref 1080 "\\frac{\\sqrt{2}}{2}\\,i+\\frac{\\sqrt{2}}{2}\\,j" #edb/ref 17592186045417] [17592186391621 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186391621 #edb/ref 1083 #uuid "10b01e1d-27d8-5784-b829-e7428d99b479" #edb/ref 17592186045417] [17592186391622 #edb/ref 1080 "\\frac{2}{\\sqrt{6}}\\,i+\\frac{1}{\\sqrt{6}}\\,j+\\frac{1}{\\sqrt{6}}\\,k" #edb/ref 17592186045417] [17592186391622 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186391622 #edb/ref 1083 #uuid "8b39b63d-e746-538f-8858-f3d5381d09d5" #edb/ref 17592186045417] [17592186391623