4 #edb/ref 1068 #edb/ref 17592186388245 #edb/ref 17592186045417] [17592186388244 #edb/ref 1069 "q-131647" #edb/ref 17592186045417] [17592186388244 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186388244 #edb/ref 1071 "Consider the following system of linear equations:\n\n$$\n{\\begin{aligned}-x-2y+4z=-3 \\\\ 2x+4y-8z=6 \\\\ -3x-6y+12z=-9\\end{aligned}\n$$\n\nUse the standard Gauss-Jordan method to reduce the augmented matrix $M$ of the system to reduced row echelon form." #edb/ref 17592186045417] [17592186388244 #edb/ref 1072 #uuid "a8d65526-b4d7-57ad-a261-aa1d872fa9f6" #edb/ref 17592186045417] [17592186388244 #edb/ref 1074 "The augmented matrix for this system is\n\n$$\nM=[\\begin{aligned}-1 & -2 & 4 & -3 \\\\ 2 & 4 & -8 & 6 \\\\ -3 & -6 & 12 & -9\\end{aligned}].\n$$\n\nTransforming $M$ to reduced row echelon form, we have\n\n$$\n\\begin{aligned}M & ∼[\\begin{aligned}-1 & -2 & 4 & -3 \\\\ 2 & 4 & -8 & 6 \\\\ -3 & -6 & 12 & -9\\end{aligned}] & {R}_{1} & :=-{R}_{1} \\\\  & ∼[\\begin{aligned}1 & 2 & -4 & 3 \\\\ 2 & 4 & -8 & 6 \\\\ -3 & -6 & 12 & -9\\end{aligned}] & {R}_{2} & :={R}_{2}-2{R}_{1} \\\\  & ∼[\\begin{aligned}1 & 2 & -4 & 3 \\\\ 0 & 0 & 0 & 0 \\\\ -3 & -6 & 12 & -9\\end{aligned}] & {R}_{3} & :={R}_{3}+3{R}_{1} \\\\  & ∼[\\begin{aligned}1 & 2 & -4 & 3 \\\\ 0 & 0 & 0 & 0 \\\\ 0 & 0 & 0 & 0\\end{aligned}].\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186388245 #edb/ref 1075 #edb/ref 17592186388246 #edb/ref 17592186045417] [17592186388245 #edb/ref 1075 #edb/ref 17592186388247 #edb/ref 17592186045417] [17592186388245 #edb/ref 1075 #edb/ref 17592186388248 #edb/ref 17592186045417] [17592186388245 #edb/ref 1075 #edb/ref 17592186388249 #edb/ref 17592186045417] [17592186388245 #edb/ref 1075 #edb/ref 17592186388250 #edb/ref 17592186045417] [17592186388245 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186388245 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186388245 #edb/ref 1078 #edb/ref 17592186388246 #edb/