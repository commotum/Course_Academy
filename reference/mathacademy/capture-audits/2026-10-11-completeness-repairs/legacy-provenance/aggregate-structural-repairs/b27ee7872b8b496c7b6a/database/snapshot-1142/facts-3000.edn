\text{otherwise}.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}P(3<X<7) & =P(X\\in {4,5,6}) \\\\  & =P(X=4)+P(X=5)+P(X=6) \\\\  & =f(4)+f(5)+f(6) \\\\  & ={(0.77)}^{3}(0.23)+{(0.77)}^{4}(0.23)+{(0.77)}^{5}(0.23) \\\\  & ≈0.2481.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186360845 #edb/ref 1080 "images/31/31519aa878fd6a9b450296552afd9bbf628e30db68a2d7c6dc6b02a48ae28b06.png" #edb/ref 17592186045417] [17592186360845 #edb/ref 1082 #edb/ref 17592186045497 #edb/ref 17592186045417] [17592186360845 #edb/ref 1083 #uuid "037a7d4f-c46b-5ef5-9f12-e499f543ede1" #edb/ref 17592186045417] [17592186360849 #edb/ref 1080 "images/a3/a375a537b104f5bcdd8f5951277bce2494d8861a7212772a7d7050fa14091cb9.png" #edb/ref 17592186045417] [17592186360849 #edb/ref 1082 #edb/ref 17592186045497 #edb/ref 17592186045417] [17592186360849 #edb/ref 1083 #uuid "0562a68a-9113-579a-9191-136bc8b91243" #edb/ref 17592186045417] [17592186360922 #edb/ref 1080 "II and III only" #edb/ref 17592186045417] [17592186360922 #edb/ref 1082 #edb/ref 17592186045499 #edb/ref 17592186045417] [17592186360922 #edb/ref 1083 #uuid "159d1b6f-bc88-5e81-930b-1feb13f58e60" #edb/ref 17592186045417] [17592186360924 #edb/ref 1080 "II only" #edb/ref 17592186045417] [17592186360924 #edb/ref 1082 #edb/ref 17592186045499 #edb/ref 17592186045417] [17592186360924 #edb/ref 1083 #uuid "15c32191-765d-58f7-8e7d-323f392118cb" #edb/ref 17592186045417] [17592186361042 #edb/ref 1080 "0.3254" #edb/ref 17592186045417] [17592186361042 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186361042 #edb/ref 1083 #uuid "2de3a430-9ad7-57d6-816e-0fdc57ed5566" #edb/ref 17592186045417] [17592186361050 #edb/ref 1080 "images/d7/d72110682c1959f10546b6fa49d6e4ebedf6b6d5557639c772f28a920f306df5.png" #edb/ref 17592186045417] [17592186361050 #edb/ref 1082 #edb/ref 17592186045497 #edb/ref 17592186045417] [17592186361050 #edb/ref 1083 #uuid "2f9fb8ad-c027-5308-86ad-a2260380cc77" #edb/ref 17592186045417] [17592186361066 #edb/ref 1080 "-1