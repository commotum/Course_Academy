 17592186045417] [17592186129375 #edb/ref 1049 #edb/ref 17592186050270 #edb/ref 17592186045417] [17592186129375 #edb/ref 1053 #uuid "b8fd4e1c-748f-577d-b086-ba515ee43c96" #edb/ref 17592186045417] [17592186129395 #edb/ref 1043 #edb/ref 17592186129938 #edb/ref 17592186045417] [17592186129395 #edb/ref 1043 #edb/ref 17592186129939 #edb/ref 17592186045417] [17592186129395 #edb/ref 1043 #edb/ref 17592186129940 #edb/ref 17592186045417] [17592186129395 #edb/ref 1043 #edb/ref 17592186129941 #edb/ref 17592186045417] [17592186129395 #edb/ref 1043 #edb/ref 17592186130041 #edb/ref 17592186045417] [17592186129395 #edb/ref 1043 #edb/ref 17592186130042 #edb/ref 17592186045417] [17592186129395 #edb/ref 1044 #edb/ref 17592186045463 #edb/ref 17592186045417] [17592186129395 #edb/ref 1045 "Row Echelon Form" #edb/ref 17592186045417] [17592186129395 #edb/ref 1046 #edb/ref 17592186129938 #edb/ref 17592186045417] [17592186129395 #edb/ref 1049 #edb/ref 17592186048980 #edb/ref 17592186045417] [17592186129395 #edb/ref 1050 420.0 #edb/ref 17592186045417] [17592186129395 #edb/ref 1053 #uuid "5f586b25-2c9f-53c9-8c70-a938202d5eda" #edb/ref 17592186045417] [17592186129481 #edb/ref 1068 #edb/ref 17592186126386 #edb/ref 17592186045417] [17592186129481 #edb/ref 1068 #edb/ref 17592186400737 #edb/ref 17592186045417] [17592186129481 #edb/ref 1069 "q-136291" #edb/ref 17592186045417] [17592186129481 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186129481 #edb/ref 1071 "A particle moves with a constant acceleration of $(3i+2j)\\,{\\text{m/s}}^{2}.$ The velocity of the particle is $(-7i-6j)\\,\\text{m/s}$ when $t=0\\,\\text{s}.$ Find the time when the velocity of the particle equals $2i\\,\\text{m/s}.$" #edb/ref 17592186045417] [17592186129481 #edb/ref 1072 #uuid "7c82e497-5ec7-5624-8331-c5c43f9eb1a8" #edb/ref 17592186045417] [17592186129481 #edb/ref 1074 "Recall that when a particle moves with constant acceleration, the velocity vector at time $t$ can be found using\n\n$$\nv=u+at,\n$$\n\nwhere $u$ is the initial velocity, and $a$ is the acceleration of the particle.\n\nSubstituting \n\n$$\na=3i+2j,\\,u=-7i-6j,\\,v=2i\n$$\n\ninto the equation above, we can solve for $t,$ as follows:\n\n$$\n\\begin{aligned}v & =u+at \\\\ 2i & =(-7i-6j)+(3i+2j)t \\\\ 9i+6j & =(3i+2j)t \\\\ 9i+6j & =3ti+2tj\\end{aligned}\n$$\n\nEquating the $i$ and $j$ components in the last equation, we obtain\n\n$$\n{\\begin{aligned}9=3t \\\\ 6=2t\\end{aligned}\\,⟹\\,t=3\\,\\text{s}.\n$$" #edb/ref 17592186045417] [17592186129938 #edb/ref 1058 #edb/ref 17592186130042 #edb/ref 17592186045417] [17592186129938 #edb/ref 1061 17175 #edb/ref 17592186045417] [17592186129938 #edb/ref 1062 #uuid "5cf43dee-1fef-5d4c-9775-65a5c7ed9dc1" #edb/ref 17592186045417] [17592186129938 #edb/ref 1063 #edb/ref 17592186130339 #edb/ref 17592186045417] [17592186129939 #edb/ref 1058 #edb/ref 17592186129941 #edb/ref 17592186045417] [17592186129939 #edb/ref 1061 17176 #edb/ref 17592186045417] [17592186129939 #edb/ref 1062 #uuid "9da7e60b-1218-59ef-a17a-68019b1df9c5" #edb/ref 17592186045417] [17592186129939 #edb/ref 1063 #edb/ref 17592186129113 #edb/ref 17592186045417] [17592186129940 #edb/ref 1058 #edb/ref 17592186129939 #edb/ref 17592186045417] [17592186129940 #edb/ref 1061 17177 #edb/ref 17592186045417] [17592186129940 #edb/ref 1062 #uuid "d00efb7b-6c6d-5f75-a839-fd2c4b29adfc" #edb/ref 17592186045417] [17592186129940 #edb/ref 1063 #edb/ref 17592186129114 #edb/ref 17592186045417] [17592186129941 #edb/ref 1061 17178 #edb/ref 17592186045417] [17592186129941 #edb/ref 1062 #uuid "ed25462b-dcf5-53b8-af91-93afa32dea4c" #edb/ref 17592186045417] [17592186129941 #edb/ref 1063 #edb/ref 17592186129115 #edb/ref 17592186045417] [17592186130041 #edb/ref 1058 #edb/ref 17592186129940 #edb/ref 17592186045417] [17592186130041 #edb/ref 1061 23024 #edb/ref 17592186045417] [17592186130041 #edb/ref 1062 #uuid "1430eddc-7fc0-5265-81de-85b9a44bbf70" #edb/ref 17592186045417] [17592186130041 #edb/ref 1063 #edb/ref 17592186130380 #edb/ref 17592186045417] [17592186130042 #edb/ref 1058 #edb/ref 17592186130041 #edb/ref 17592186045417] [17592186130042 #edb/ref 1061 23025 #edb/ref 17592186045417] [17592186130042 #edb/ref 1062 #uuid "f062c6b3-17e0-57cb-a070-e9edcc0af6c8" #edb/ref 17592186045417] [17592186130042 #edb/ref 1063 #edb/ref 17592186129176 #edb/ref 17592186045417] [17592186130176 #edb/ref 1058 #edb/ref 17592186130177 #edb/ref 17592186045417] [17592186130176 #edb/ref 1061 36897 #edb/ref 17592186045417] [17592186130176 #edb/ref 1062 #uuid "0f2baea5-8b66-5b0e-b2d7-72a64c3d40a3" #edb/ref 17592186045417] [17592186130176 #edb/ref 1063 #edb/ref 17592186130445 #edb/ref 17592186045417] [17592186130177 #edb/ref 1058 #edb/ref 17592186130178 #edb/ref 17592186045417] [17592186130177 #edb/ref 1061 36898 #edb/ref 17592186045417] [17592186130177 #edb/ref 1062 #uuid "bb3ae2a7-8c5a-5ef2-97b6-41dc1c9886bc" #edb/ref 17592186045417] [17592186130177 #edb/ref 1063 #edb/ref 17592186129249 #edb/ref 17592186045417] [17592186130178 #edb/ref 1058 #edb/ref 17592186130180 #edb/ref 17592186045417] [17592186130178 #edb/ref 1061 36900 #edb/ref 17592186045417] [17592186130178 #edb/ref 1062 #uuid "2d22baec-c09f-5f9f-b2ee-f15b2c144f57" #edb/ref 17592186045417] [17592186130178 #edb/ref 1063 #edb/ref 17592186130446 #edb/ref 17592186045417] [17592186130179 #edb/ref 1058 #edb/ref 17592186130181 #edb/ref 17592186045417] [17592186130179 #edb/ref 1061 36901 #edb/ref 17592186045417] [17592186130179 #edb/ref 1062 #uuid "4f365715-3ac5-589f-a774-e29ae44744a9" #edb/ref 17592186045417] [17592186130179 #edb/ref 1063 #edb/ref 17592186129250 #edb/ref 17592186045417] [17592186130180 #edb/ref 1058 #edb/ref 17592186130179 #edb/ref 17592186045417] [17592186130180 #edb/ref 1061 36902 #edb/ref 17592186045417] [17592186130180 #edb/ref 1062 #uuid "6eef6463-e817-5063-b678-359ac680a832" #edb/ref 17592186045417] [17592186130180 #edb/ref 1063 #edb/ref 17592186129251 #edb/ref 17592186045417] [17592186130181 #edb/ref 1061 36906 #edb/ref 17592186045417] [17592186130181 #edb/ref 1062 #uuid "2334ada5-75ed-5eef-a510-caabce5c0ae4" #edb/ref 17592186045417] [17592186130181 #edb/ref 1063 #edb/ref 17592186129252 #edb/ref 17592186045417] [17592186130339 #edb/ref 1064 "Consider the following matrices:\n![](images/10/1074870d255109821b5f36eb517f22531efbd8f5069f05c3de3f111b38befd02.svg)\n\nThe first non-zero entry on each row (from left to right) is called the **leading entry** of that row.\n\n- In the matrix $A,$ the leading entries are $a_{11}=2,$ $a_{22}=3,$ $a_{32}=1,$ and $a_{43}=5.$\n\n- In the matrix $B,$ the leading entries are $b_{11}=1,$ $b_{22}=3,$ $b_{33}=-2,$ and $b_{44}=2.$ The $5$th row has no leading entry.\n\nThe leading entries are highlighted below.\n\n![](images/6b/6b1d99269c847f7c6bc0558da347fb300dba5fa6caf373cd1ed5cc5ebacb1649.svg)" #edb/ref 17592186045417] [17592186130339 #edb/ref 1065 3148 #edb/ref 17592186045417] [17592186130339 #edb/ref 1066 #uuid "24451a80-db9f-5a0f-a591-41500a69774c" #edb/ref 17592186045417] [17592186130339 #edb/ref 1067 "Introduction" #edb/ref 17592186045417] [17592186130380 #edb/ref 1064 "Let's consider our matrices $A$ and $B$ once more, with the leading entries highlighted.\n\n![](images/af/af61f32297e248ab9989ba59ea6c9bda2f99efe19d25df525fef916617843a32.svg)\n\nWe say that a matrix is in **row echelon form** if it satisfies the following conditions:\n\n- All the zero rows (rows with only zeros), if any, are placed at the *bottom* of the matrix.\n\n- Each leading entry of a row is in a column *to the right* of the leading entry of the row above it.\n\nHere, $B$ is in row echelon form since both conditions are satisfied. However, $A$ is not in row echelon form since condition II is violated: the leading entry of the third row $(a_{32}={\\color{red}1})$ is placed just below the leading entry of the second row $(a_{22}=3).$\n\nGenerally speaking, row echelon form means that we have *stairs* where each step (represented by a leading entry $\\bbox[lightgray, 3pt]{\\large\\ast}$) has a height of $1.$\n\n![](images/67/67f83c454e59d16ae80cf67a19b19f968182251a2e5d1b405e2c422e0313d5b7.png)\n\nFinally, an *augmented* matrix is in row echelon form if the coefficient matrix (i.e., the part that is to the left of the vertical bar) is in row echelon form." #edb/ref 17592186045417] [17592186130380 #edb/ref 1065 3896 #edb/ref 17592186045417] [17592186130380 #edb/ref 1066 #uuid "137b0909-9a5e-5edf-8019-24e803307903" #edb/ref 17592186045417] [17592186130380 #edb/ref 1067 "Row Echelon Form" #edb/ref 17592186045417] [17592186130445 #edb/ref 1064 "We can describe the **velocity** of a particle moving in the $xy$-plane using a **velocity vector.** The velocity vector tells us the magnitude and direction at which the particle moves. We denote the velocity vector of a particle as $\\mathbf u.$\n\nAs an example, consider the particle $P$ shown below.\n\n![](images/88/8895fcf01aa16812144379c5ae004df694451d6e0a11a2b62e4dd62516f57316.png)\n\nIn this case, the velocity vector is given by \n\n$$\n\\mathbf{u} = (3\\,\\mathbf{i} + 2\\,\\mathbf{j}) \\: \\textrm{m/s}.\n$$\n\nWe should think of the particle's velocity as being made up of two components: \n\n- a *horizontal* component of $3 \\: \\textrm{m/s}$ (moving to the right), and\n\n- a *vertical* component of $2 \\: \\textrm{m/s}$ (moving upward).\n\nIn other words, the particle moves $3$ meters to the right and $2$ units up every second. Also, since the horizontal and vertical components are constants, we say that the particle moves with **constant velocity.**\n\nThe magnitude of the velocity vector gives the **speed** of the particle. Therefore, in our example, the speed of the particle is\n\n$$\n\\begin{aligned}|u| & =|3i+2j| \\\\  & =\\sqrt{{3}^{2}+{2}^{2}} \\\\  & =\\sqrt{9+4} \\\\  & =\\sqrt{13}\\,\\text{m/s}.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186130445 #edb/ref 1065 6062 #edb/ref 17592186045417] [17592186130445 #edb/ref 1066 #uuid "d6f4c5c9-7add-589a-a0ea-d52f3d02e40a" #edb/ref 17592186045417] [17592186130445 #edb/ref 1067 "Introduction" #edb/ref 17592186045417] [17592186130446 #edb/ref 1064 "The acceleration of a particle tells us the rate at which its velocity changes over time. We can use vectors to model the acceleration of a particle moving in the $xy$-plane. \n\nFor example, consider a particle $P$ whose acceleration vector $\\mathbf a$ is given by\n\n$$\n\\mathbf a = (3\\mathbf{i}+4\\mathbf{j})\\,\\textrm{m/s}^2.\n$$\n\nWe should think of this particle's acceleration as being made up of two components: \n\n- a *horizontal* component of $3 \\: \\textrm{m/s}^2$ (to the right), and\n\n- a *vertical* component of $4 \\: \\textrm{m/s}^2$ (upward).\n\nIn other words,\n\n- the horizontal component of the velocity increases by $3\\,\\textrm{m/s}$ every second, and\n\n- the vertical component of the velocity increases by $4\\,\\textrm{m/s}$ every second.\n\nAlso, since both components are constants, we say that this particle moves with **constant acceleration**.\n\nIf a particle is moving with constant acceleration, the velocity vector $\\mathbf v$ at time $t$ can be found using\n\n$$\n\\mathbf{v} = \\mathbf{u} + \\mathbf{a}t,\n$$\n\nwhere $\\mathbf{u}$ is the velocity of the particle when $t=0$ (i.e., the **initial velocity**).\n\nFor example, suppose that the initial velocity of our particle is given by $\\mathbf{u} = (2\\mathbf{i} + 3\\mathbf{j}) \\, \\textrm{m/s}.$ What is the particle's velocity when $t=2 \\, \\textrm{s}?$\n\nSubstituting our data into the formula above, we obtain that the velocity of the particle will be\n\n$$\n\\begin{aligned}v & =u+at \\\\  & =(2i+3j)+(3i+4j)(2) \\\\  & =(2i+3j)+(6i+8j) \\\\  & =(8i+11j)\\,\\text{m/s}.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186130446 #edb/ref 1065 6063 #edb/ref 17592186045417] [17592186130446 #edb/ref 1066 #uuid "e71afcde-f4ec-52b0-bc4b-041b528e32f6" #edb/ref 17592186045417] [17592186130446 #edb/ref 1067 "Relating Velocity and Acceleration" #edb/ref 17592186045417] [17592186133832 #edb/ref 1037 #edb/ref 17592186050574 #edb/ref 17592186045417] [17592186133832 #edb/ref 1038 #edb/ref 17592186134476 #edb/ref 17592186045417] [17592186133832 #edb/ref 1038 #edb/ref 17592186134477 #edb/ref 17592186045417] [17592186133832 #edb/ref 1038 #edb/ref 17592186241091 #edb/ref 17592186045417] [17592186133832 #edb/ref 1038 #edb/ref 17592186329880 #edb/ref 17592186045417] [17592186133832 #edb/ref 1038 #edb/ref 17592186329881 #edb/ref 17592186045417] [17592186133832 #edb/ref 1038 #edb/ref 17592186329884 #edb/ref 17592186045417] [17592186133832 #edb/ref 1038 #edb/ref 17592186329885 #edb/ref 17592186045417] [17592186133832 #edb/ref 1039 "Completing a Statement On the Intermediate Value Theorem" #edb/ref 17592186045417] [17592186133832 #edb/ref 1041 #edb/ref 17592186133647 #edb/ref 17592186045417] [17592186133832 #edb/ref 1042 #uuid "7d01d143-68f2-534a-8be6-4f63f9ab0d40" #edb/ref 17592186045417] [17592186133955 #edb/ref 1038 #edb/ref 17592186134471 #edb/ref 17592186045417] [17592186133955 #edb/ref 1038 #edb/ref 17592186134474 #edb/ref 17592186045417] [17592186133955 #edb/ref 1038 #edb/ref 17592186241105 #edb/ref 17592186045417] [17592186133955 #edb/ref 1038 #edb/ref 17592186348086 #edb/ref 17592186045417] [17592186133955 #edb/ref 1038 #edb/ref 17592186397801 #edb/ref 17592186045417] [17592186133955 #edb/ref 1038 #edb/ref 17592186398841 #edb/ref 17592186045417] [17592186133955 #edb/ref 1039 "Selecting a Specific Value For Which a Solution Is Guaranteed" #edb/ref 17592186045417] [17592186133955 #edb/ref 1041 #edb/ref 17592186133477 #edb/ref 17592186045417] [17592186133955 #edb/ref 1042 #uuid "6388d315-340b-56a0-bc93-e380bfbf6ed3" #edb/ref 17592186045417] [17592186133956 #edb/ref 1038 #edb/ref 17592186134470 #edb/ref 17592186045417] [17592186133956 #edb/ref 1038 #edb/ref 17592186134516 #edb/ref 17592186045417] [17592186133956 #edb/ref 1038 #edb/ref 17592186317540 #edb/ref 17592186045417] [17592186133956 #edb/ref 1038 #edb/ref 17592186329804 #edb/ref 17592186045417] [17592186133956 #