6163158 #edb/ref 17592186045417] [17592186162186 #edb/ref 1043 #edb/ref 17592186163159 #edb/ref 17592186045417] [17592186162186 #edb/ref 1044 #edb/ref 17592186045463 #edb/ref 17592186045417] [17592186162186 #edb/ref 1045 "Independence of Discrete Random Variables" #edb/ref 17592186045417] [17592186162186 #edb/ref 1046 #edb/ref 17592186163156 #edb/ref 17592186045417] [17592186162186 #edb/ref 1049 #edb/ref 17592186050835 #edb/ref 17592186045417] [17592186162186 #edb/ref 1053 #uuid "4373edc4-1d40-5e9a-bfe9-ecc0845c2651" #edb/ref 17592186045417] [17592186162281 #edb/ref 1068 #edb/ref 17592186243668 #edb/ref 17592186045417] [17592186162281 #edb/ref 1069 "q-109335" #edb/ref 17592186045417] [17592186162281 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186162281 #edb/ref 1071 "|  | $Y=2$ | $Y=4$ | $Y=6$ |\n| --- | --- | --- | --- |\n| $X=1$ | $0.1$ | $0.25$ | $0.25$ |\n| $X=2$ | $0.05$ | $0.15$ | $0.2$ |\n\nCompute $P((X,Y)\\in {(1,4),(1,6),(2,6)})$ given that the random variables $X$ and $Y$ have the joint probability mass function $f(x,y)$ shown in the table above." #edb/ref 17592186045417] [17592186162281 #edb/ref 1072 #uuid "982b31fd-731a-56a2-a3eb-b1749eaecfdc" #edb/ref 17592186045417] [17592186162281 #edb/ref 1074 "Using the values in the table, we have\n\n$$\n\\begin{aligned}P((X,Y)\\in {(1,4),(1,6),(2,6)}) & =P((X,Y)=(1,4)) \\\\  & +P((X,Y)=(1,6)) \\\\  & +P((X,Y)=(2,6)) \\\\  & =f(1,4)+f(1,6)+f(2,6) \\\\  & =0.25+0.25+0.2 \\\\  & =0.7.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186162304 #edb/ref 1068 #edb/ref 17592186246776 #edb/ref 17592186045417] [17592186162304 #edb/ref 1069 "q-110385" #edb/ref 17592186045417] [17592186162304 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186162304 #edb/ref 1071 "The marginal mass functions of the independent discrete random variables $X$ and $Y$ are shown below. Given that the corresponding joint probability mass function is $f(x,y),$ find $f(3,1).$\n\n| | $x$ | $1$ | $2$ | $3$ |\n| --- | --- | --- | --- |\n| ${f}_{X}(x)$ | $0.2$ | $0.3$ | $0.5$ | |  | | $y$ | $1$ | $2$ |\n| --- | --- | --- |\n| ${f}_{Y}(y)$ | $0.25$ | $0.75$ | |  |\n| --- | --- | --- | --- |\n| $x$ | $1$ | $2$ | $3$ |\n| ${f}_{X}(x)$ | $0.2$ | $0.3$ | $0.5$ |\n| $y$ | $1$ | $2$ |  |\n| ${f}_{Y}(y)$ | $0.25$ | $0.75$ |  |" #edb/ref 17592186045417] [17592186162304 #edb/ref 1072 #uuid "d3006b2b-d3f6-5ddf-b811-934181f67f97" #edb/ref 17592186045417] [17592186162304 #edb/ref 1073 true #edb/ref 17592186045417] [17592186162304 #edb/ref 1074 "Two discrete random variables $X$ and $Y$ with joint probability mass function $f(x,y)$ are independent if and only if \n\n$$\nf(x,y)={f}_{X}(x)\\cdot {f}_{Y}(y)\n$$\n\n \n\nfor all possible values $x$ and $y,$ where ${f}_{X}(x)$ and ${f}_{Y}(y)$ are the marginal probability mass functions for $X$ and $Y,$ respectively.\n\nTherefore, since our discrete random variables are independent, we obtain\n\n$$\n\\begin{aligned}f(3,1) & ={f}_{X}(3)\\cdot {f}_{Y}(1) \\\\  & =0.5\\cdot 0.25 \\\\  & =0.125.\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186162750 #edb/ref 1058 #edb/ref 17592186162829 #edb/ref 17592186045417] [17592186162750 #edb/ref 1061 218771 #edb/ref 17592186045417] [17592186162750 #edb/ref 1062 #uuid "ce002306-ea12-5d28-8c26-a1710d2f4327" #edb/ref 17592186045417] [17592186162750 #edb/ref 1063 #edb/ref 17592186163179 #edb/ref 17592186045417] [17592186162825 #edb/ref 1058 #edb/ref 17592186162828 #edb/ref 17592186045417] [17592186162825 #edb/ref 1061 30052 #edb/ref 17592186045417] [17592186162825 #edb/ref 1062 #uuid "b68078fb-1628-5a76-bb97-1c1261f6641d" #edb/ref 17592186045417] [17592186162825 #edb/ref 1063 #edb/ref 17592186163214 #edb/ref 17592186045417] [17592186162826 #edb/ref 1058 #edb/ref 17592186162750 #edb/ref 17592186045417] [17592186162826 #edb/ref 1061 30053 #edb/ref 17592186045417] [17592186162826 #edb/ref 1062 #uuid "8918fe56-d9e1-5eae-97d1-dfc810e443e6" #edb/ref 17592186045417] [17592186162826 #edb/ref 1063 #edb/ref 1