 -2 \\\\ 0 & 3 & -6\\end{aligned}] & {R}_{3} & :={R}_{3}+(-3){R}_{2} \\\\  & ∼[\\begin{aligned}1 & -2 & 3 \\\\ 0 & 1 & -2 \\\\ 0 & 0 & 0\\end{aligned}]\\end{aligned}\n$$\n\nNow, we have the system\n\n$$\n\\{\\begin{aligned}s-2t=3 \\\\ t=-2 \\\\ 0=0.\\end{aligned}\n$$\n\nFrom the second equation, we get\n\n$$\nt=-2.\n$$\n\nSubstituting into the first equation, we get\n\n$$\n\\begin{aligned}s-2t & =3 \\\\ s-2(-2) & =3 \\\\ s+4 & =3 \\\\ s & =-1.\\end{aligned}\n$$\n\nSince we found a solution $s=-1,\\,t=-2,$ we conclude that $u$ does indeed lie on the plane $Π.$ In fact, we have\n\n$$\nu=-b-2c.\n$$\n\nFinally, $s\\cdot t=(-1)\\cdot (-2)=2.$" 13194139534456 17592186045417 true] [17592186241024 1074 "By definition, $u\\in Π$ if there exist $t$ and $s$ such that\n\n$$\n\\begin{aligned}sb+tc & =u \\\\ s[\\begin{aligned}1 \\\\ -1 \\\\ 3\\end{aligned}]+t[\\begin{aligned}-2 \\\\ 4 \\\\ -3\\end{aligned}] & =[\\begin{aligned}3 \\\\ -7 \\\\ 3\\end{aligned}].\\end{aligned}\n$$\n\nSo, we have the following system of equations:\n\n$$\n{\\begin{aligned}s-2t=3 \\\\ -s+4t=-7 \\\\ 3s-3t=3\\end{aligned}\n$$\n\nTo solve the system above, we set up and row reduce an augmented matrix:\n\n$$\n\\begin{aligned} & [\\begin{aligned}1 & -2 & 3 \\\\ -1 & 4 & -7 \\\\ 3 & -3 & 3\\end{aligned}] & {R}_{2} & :={R}_{2}+{R}_{1} \\\\  & ∼[\\begin{aligned}1 & -2 & 3 \\\\ 0 & 2 & -4 \\\\ 3 & -3 & 3\\end{aligned}] & {R}_{3} & :={R}_{3}+(-3){R}_{1} \\\\  & ∼[\\begin{aligned}1 & -2 & 3 \\\\ 0 & 2 & -4 \\\\ 0 & 3 & -6\\end{aligned}] & {R}_{2} & :=-\\frac{1}{2}{R}_{2} \\\\  & ∼[\\begin{aligned}1 & -2 & 3 \\\\ 0 & 1 & -2 \\\\ 0 & 3 & -6\\end{aligned}] & {R}_{3} & :={R}_{3}+(-3){R}_{2} \\\\  & ∼[\\begin{aligned}1 & -2 & 3 \\\\ 0 & 1 & -2 \\\\ 0 & 0 & 0\\end{aligned}]\\end{aligned}\n$$\n\nNow, we have the system\n\n$$\n{\\begin{aligned}s-2t=3 \\\\ t=-2 \\\\ 0=0.\\end{aligned}\n$$\n\nFrom the second equation, we get\n\n$$\nt=-2.\n$$\n\nSubstituting into the first equation, we get\n\n$$\n\\begin{aligned}s-2t & =3 \\\\ s-2(-2) & =3 \\\\ s+4 & =3 \\\\ s & =-1.\\end{aligned}\n$$\n\nSince we found a solution $s=-1,\\,t=-2,$ we conclude that $u$ does indeed lie on the plane $Π.$ In fact, we have\n\n$$\nu=-b-2c.\n$$\n\nFinally, $s\\cdot t=(-1)\\cdot (-2)=2.$" 13194139534456 17592186045417 false] [17592186241036 1071 "Consider the following vectors:\n\n$$\n{a}_{1}=[\\begin{aligned}-3 \\\\ 9 \\\\ 0\\end{aligned}],\\,{a}_{2}=[\\begin{aligned}2 \\\\ -5 \\\\ -2\\end{aligned}],\\,{a}_{3}=[\\begin{aligned}5 \\\\ -12 \\\\ -4\\end{aligned}].\n$$\n\n \n\nAssume that ${x}_{1},{x}_{2},$ and ${x}_{3}$ are real numbers. Which of the following statements are true?\n\n- The vectors ${a}_{1},{a}_{2},$ and ${a}_{3}$ are linearly dependent.\n- The vectors ${a}_{1},{a}_{2},$ and ${a}_{3}$ are linearly independent.\n- The equation ${x}_{1}{a}_{1}+{x}_{2}{a}_{2}+{x}_{3}{a}_{3}=0$ has only the trivial solution ${x}_{1}={x}_{2}={x}_{3}=0.$" 13194139534456 17592186045417 false] [17592186241036 1071 "Consider the following vectors:\n\n$$\n{a}_{1}=[\\begin{aligned}-3 \\\\ 9 \\\\ 0\\end{aligned}],\\,{a}_{2}=[\\begin{aligned}2 \\\\ -5 \\\\ -2\\end{aligned}],\\,{a}_{3}=[\\begin{aligned}5 \\\\ -12 \\\\ -4\\end{aligned}].\n$$\n\n \n\nAssume that ${x}_{1},{x}_{2},$ and ${x}_{3}$ are real numbers. Which of the following statements are true?\n\nI. The vectors ${a}_{1},{a}_{2},$ and ${a}_{3}$ are linearly dependent.\n\nII. The vectors ${a}_{1},{a}_{2},$ and ${a}_{3}$ are linearly independent.\n\nIII. The equation ${x}_{1}{a}_{1}+{x}_{2}{a}_{2}+{x}_{3}{a}_{3}=0$ has only the trivial solution ${x}_{1}={x}_{2}={x}_{3}=0.$" 13194139534456 17592186045417 true] [17592186241036 1074 "We say that three vectors ${v}_{1},{v}_{2},$ and ${v}_{3}$ are *linearly independent* if the only solution to the equation\n\n$$\n{x}_{1}{v}_{1}+{x}_{2}{v}_{2}+{x}_{3}{v}_{3}=0\n$$\n\nis ${x}_{1}={x}_{2}={x}_{3}=0.$ Otherwise, the vectors are *linearly dependent*.\n\nWith that in mind, let's examine our statements.\n\nThe equation ${x}_{1}{a}_{1}+{x}_{2}{a}_{2}+{x}_{3}{a}_{3}=0$ corresponds to the system \n\n$$\n\\{\\begin{aligned}-3{x}_{1}+2{x}_{2}+5{x}_{3}=0 \\\\ 9{x}_{1}-5{x}_{2}-12{x}_{3}=0 \\\\ -2{x}_{2}-4{x}_{3}=0.\\end{aligned}\n$$\n\nTo solve the system, we create its augmented matrix and reduce it using Gaussian elimination:\n\n$$\n\\begin{aligned}M & =[\\begin{aligned}-3 & 2 & 5 & 0 \\\\ 9 & -5 & -12 & 0 \\\\ 0 & -2 & -4 & 0\\end{aligned}] & {R}_{2} & :={R}_{2}+3{R}_{1} \\\\  & ∼[\\begin{aligned}-3 & 2 & 5 & 0 \\\\ 0 & 1 & 3 & 0 \\\\ 0 & -2 & -4 & 0\\end{aligned}] & {R}_{3} & :={R}_{3}+2{R}_{2} \\\\  & ∼[\\begin{aligned}-3 & 2 & 5 & 0 \\\\ 0 & 1 & 3 & 0 \\\\ 0 & 0 & 2 & 0\\end{aligned}]\\end{aligned}\n$$\n\nSo, the system is now\n\n$$\n\\{\\begin{aligned}-3{x}_{1}+2{x}_{2}+5{x}_{3}=0 \\\\ {x}_{2}+3{x}_{3}=0 \\\\ 2{x}_{3}=0.\\end{aligned}\n$$\n\nFrom the third equation, we get ${x}_{3}=0.$ Substituting this into the second equation, we get\n\n$$\n{x}_{2}+3(0)=0\\,⟹\\,{x}_{2}=0\n$$\n\nand, substituting this into the first equation, we obtain\n\n$$\n-3{x}_{1}+2(0)+5(0)=0\\,⟹\\,{x}_{1}=0.\n$$\n\nSince ${x}_{1}={x}_{2}={x}_{3}=0$, we get that the set $\\{{a}_{1},{a}_{2},{a}_{3}\\}$ is linearly independent.\n\nTherefore, statements II and III are true, while statement I is false." 13194139534456 17592186045417 true] [17592186241036 1074 "We say that three vectors ${v}_{1},{v}_{2},$ and ${v}_{3}$ are *linearly independent* if the only solution to the equation\n\n$$\n{x}_{1}{v}_{1}+{x}_{2}{v}_{2}+{x}_{3}{v}_{3}=0\n$$\n\nis ${x}_{1}={x}_{2}={x}_{3}=0.$ Otherwise, the vectors are *linearly dependent*.\n\nWith that in mind, let's examine our statements.\n\nThe equation ${x}_{1}{a}_{1}+{x}_{2}{a}_{2}+{x}_{3}{a}_{3}=0$ corresponds to the system \n\n$$\n{\\begin{aligned}-3{x}_{1}+2{x}_{2}+5{x}_{3}=0 \\\\ 9{x}_{1}-5{x}_{2}-12{x}_{3}=0 \\\\ -2{x}_{2}-4{x}_{3}=0.\\end{aligned}\n$$\n\nTo solve the system, we create its augmented matrix and reduce it using Gaussian elimination:\n\n$$\n\\begin{aligned}M & =[\\begin{aligned}-3 & 2 & 5 & 0 \\\\ 9 & -5 & -12 & 0 \\\\ 0 & -2 & -4 & 0\\end{aligned}] & {R}_{2} & :={R}_{2}+3{R}_{1} \\\\  & ∼[\\begin{aligned}-3 & 2 & 5 & 0 \\\\ 0 & 1 & 3 & 0 \\\\ 0 & -2 & -4 & 0\\end{aligned}] & {R}_{3} & :={R}_{3}+2{R}_{2} \\\\  & ∼[\\begin{aligned}-3 & 2 & 5 & 0 \\\\ 0 & 1 & 3 & 0 \\\\ 0 & 0 & 2 & 0\\end{aligned}]\\end{aligned}\n$$\n\nSo, the system is now\n\n$$\n{\\begin{aligned}-3{x}_{1}+2{x}_{2}+5{x}_{3}=0 \\\\ {x}_{2}+3{x}_{3}=0 \\\\ 2{x}_{3}=0.\\end{aligned}\n$$\n\nFrom the third equation, we get ${x}_{3}=0.$ Substituting this into the second equation, we get\n\n$$\n{x}_{2}+3(0)=0\\,⟹\\,{x}_{2}=0\n$$\n\nand, substituting this into the first equation, we obtain\n\n$$\n-3{x}_{1}+2(0)+5(0)=0\\,⟹\\,{x}_{1}=0.\n$$\n\nSince ${x}_{1}={x}_{2}={x}_{3}=0$, we get that the set ${{a}_{1},{a}_{2},{a}_{3}}$ is linearly independent.\n\nTherefore, statements II and III are true, while statement I is false." 13194139534456 17592186045417 false] [17592186241132 1071 "What is the cardinality of $M\\times N$ for $M=\\{a,b,c,d,e,f,g\\}$ and $N=\\{a,b,c,d,e,f\\}?$" 13194139534456 17592186045417 true] [17592186241132 1071 "What is the cardinality of $M\\times N$ for $M={a,b,c,d,e,f,g}$ and $N={a,b,c,d,e,f}?$" 13194139534456 17592186045417 false] [17592186241137 1074 "Reducing $M$ to row echelon form, we have\n\n$$\n\\begin{aligned}M & ∼[\\begin{aligned}1 & 1 & 8 \\\\ -1 & -2 & 3\\end{aligned}] & {R}_{2} & :={R}_{2}+1\\cdot {R}_{1} \\\\  & ∼[\\begin{aligned}1 & 1 & 8 \\\\ 0 & -1 & 11\\end{aligned}] & {R}_{2} & :=-1\\cdot {R}_{2} \\\\  & ∼[\\begin{aligned}1 & 1 & 8 \\\\ 0 & 1 & -11\\end{aligned}].\\end{aligned}\n$$\n\nThe system is now\n\n$$\n\\{\\begin{aligned} & x+y=8 \\\\  & y=-11,\\end{aligned}\n$$\n\nand we can apply back substitution. The final equation $y=-11$ tells us the value of $y.$ Substituting this value into the first equation, we get\n\n$$\nx+(-11)=8\\,⇒\\,x=8+11=19.\n$$\n\nTherefore, the solution is $x=19$ and $y=-11.$" 13194139534456 17592186045417 tru