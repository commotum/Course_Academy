 \\\\ 7 \\\\ 18\\end{aligned}] & =[\\begin{aligned}-12 \\\\ -10 \\\\ k\\end{aligned}].\\end{aligned}\n$$\n\nSo, we have the following system of equations:\n\n$$\n\\{\\begin{aligned}-3{x}_{1}+9{x}_{2}=-12 \\\\ -2{x}_{1}+7{x}_{2}=-10 \\\\ -6{x}_{1}+18{x}_{2}=k\\end{aligned}\n$$\n\nTo solve the system above, we set up and row reduce an augmented matrix:\n\n$$\n\\begin{aligned} & [\\begin{aligned}-3 & 9 & -12 \\\\ -2 & 7 & -10 \\\\ -6 & 18 & k\\end{aligned}] & {R}_{1} & :=-\\frac{1}{3}{R}_{1} \\\\  & ∼[\\begin{aligned}1 & -3 & 4 \\\\ -2 & 7 & -10 \\\\ -6 & 18 & k\\end{aligned}] & {R}_{2} & :={R}_{2}+2{R}_{1} \\\\  & ∼[\\begin{aligned}1 & -3 & 4 \\\\ 0 & 1 & -2 \\\\ -6 & 18 & k\\end{aligned}] & {R}_{3} & :={R}_{3}+6{R}_{1} \\\\  & ∼[\\begin{aligned}1 & -3 & 4 \\\\ 0 & 1 & -2 \\\\ 0 & 0 & k+24\\end{aligned}]\\end{aligned}\n$$\n\nThe third row of the augmented matrix now corresponds to the equation $0{x}_{1}+0{x}_{2}=k+24.$ Therefore, the system has a solution only if\n\n$$\n0=k+24\\,⇒\\,k=-24.\n$$" 13194139534456 17592186045417 true] [17592186120516 1074 "We know that $b\\in \\text{Span}{{a}_{1},{a}_{2}}$ if there exist ${x}_{1}$ and ${x}_{2}$ such that \n\n$$\n\\begin{aligned}{x}_{1}{a}_{1}+{x}_{2}{a}_{2} & =b \\\\ {x}_{1}[\\begin{aligned}-3 \\\\ -2 \\\\ -6\\end{aligned}]+{x}_{2}[\\begin{aligned}9 \\\\ 7 \\\\ 18\\end{aligned}] & =[\\begin{aligned}-12 \\\\ -10 \\\\ k\\end{aligned}].\\end{aligned}\n$$\n\nSo, we have the following system of equations:\n\n$$\n{\\begin{aligned}-3{x}_{1}+9{x}_{2}=-12 \\\\ -2{x}_{1}+7{x}_{2}=-10 \\\\ -6{x}_{1}+18{x}_{2}=k\\end{aligned}\n$$\n\nTo solve the system above, we set up and row reduce an augmented matrix:\n\n$$\n\\begin{aligned} & [\\begin{aligned}-3 & 9 & -12 \\\\ -2 & 7 & -10 \\\\ -6 & 18 & k\\end{aligned}] & {R}_{1} & :=-\\frac{1}{3}{R}_{1} \\\\  & ∼[\\begin{aligned}1 & -3 & 4 \\\\ -2 & 7 & -10 \\\\ -6 & 18 & k\\end{aligned}] & {R}_{2} & :={R}_{2}+2{R}_{1} \\\\  & ∼[\\begin{aligned}1 & -3 & 4 \\\\ 0 & 1 & -2 \\\\ -6 & 18 & k\\end{aligned}] & {R}_{3} & :={R}_{3}+6{R}_{1} \\\\  & ∼[\\begin{aligned}1 & -3 & 4 \\\\ 0 & 1 & -2 \\\\ 0 & 0 & k+24\\end{aligned}]\\end{aligned}\n$$\n\nThe third row of the augmented matrix now corresponds to the equation $0{x}_{1}+0{x}_{2}=k+24.$ Therefore, the system has a solution only if\n\n$$\n0=k+24\\,⇒\\,k=-24.\n$$" 13194139534456 17592186045417 false] [17592186124949 1071 "Consider the straight line given by the following parametric equations:\n\n$$\n\\{\\begin{aligned}x=5 \\\\ y=4t \\\\ z=7\\end{aligned}\n$$\n\nWhat would be the vector equation of the line?" 13194139534456 17592186045417 true] [17592186124949 1071 "Consider the straight line given by the following parametric equations:\n\n$$\n{\\begin{aligned}x=5 \\\\ y=4t \\\\ z=7\\end{aligned}\n$$\n\nWhat would be the vector equation of the line?" 13194139534456 17592186045417 false] [17592186124951 1071 "![](images/93/936cea1e20ef7bbc1eb66acf9dd564c61476f5bb68ee05e553b00aaf3f970dc3.png)\n\nOn which of the following intervals is the function $f(x)$ (shown above) invertible? \n\n- $x\\in [-4,0]$\n- $x\\in (-4,-2]$\n- $x\\in (-3,1)$" 13194139534456 17592186045417 false] [17592186124951 1071 "![](images/93/936cea1e20ef7bbc1eb66acf9dd564c61476f5bb68ee05e553b00aaf3f970dc3.png)\n\nOn which of the following intervals is the function $f(x)$ (shown above) invertible? \n\nI. $x\\in [-4,0]$\n\nII. $x\\in (-4,-2]$\n\nIII. $x\\in (-3,1)$" 13194139534456 17592186045417 true] [17592186129481 1068 #edb/ref 17592186126386 13194139534456 17592186045417 false] [17592186129481 1074 "Recall that when a particle moves with constant acceleration, the velocity vector at time $t$ can be found using\n\n$$\nv=u+at,\n$$\n\nwhere $u$ is the initial velocity, and $a$ is the acceleration of the particle.\n\nSubstituting \n\n$$\na=3i+2j,\\,u=-7i-6j,\\,v=2i\n$$\n\ninto the equation above, we can solve for $t,$ as follows:\n\n$$\n\\begin{aligned}v & =u+at \\\\ 2i & =(-7i-6j)+(3i+2j)t \\\\ 9i+6j & =(3i+2j)t \\\\ 9i+6j & =3ti+2tj\\end{aligned}\n$