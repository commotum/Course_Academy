5417] [17592186392107 #edb/ref 1083 #uuid "8a29317f-e4cb-5886-99c5-3539d5b2e238" #edb/ref 17592186045417] [17592186392128 #edb/ref 1068 #edb/ref 17592186392129 #edb/ref 17592186045417] [17592186392128 #edb/ref 1069 "q-37649" #edb/ref 17592186045417] [17592186392128 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186392128 #edb/ref 1071 "Consider the system\n\n$$\n{\\begin{aligned}{x}_{1}-2{x}_{3}=-2 \\\\ -2{x}_{1}+{x}_{2}+4{x}_{3}=2 \\\\ 3{x}_{1}-6{x}_{3}=-6.\\end{aligned}\n$$\n\nUse the standard method of Gaussian elimination to reduce the augmented matrix $M$ of the system to row echelon form." #edb/ref 17592186045417] [17592186392128 #edb/ref 1072 #uuid "7bafb401-a99c-58a5-8622-a9ebf82083bc" #edb/ref 17592186045417] [17592186392128 #edb/ref 1074 "The augmented matrix for this system is\n\n$$\nM=[\\begin{aligned}1 & 0 & -2 & -2 \\\\ -2 & 1 & 4 & 2 \\\\ 3 & 0 & -6 & -6\\end{aligned}].\n$$\n\nReducing $M$ to echelon form, we have\n\n$$\n\\begin{aligned}M & ∼[\\begin{aligned}1 & 0 & -2 & -2 \\\\ -2 & 1 & 4 & 2 \\\\ 3 & 0 & -6 & -6\\end{aligned}] & {R}_{2} & :={R}_{2}+2{R}_{1} \\\\  & ∼[\\begin{aligned}1 & 0 & -2 & -2 \\\\ 0 & 1 & 0 & -2 \\\\ 3 & 0 & -6 & -6\\end{aligned}] & {R}_{3} & :={R}_{3}+(-3){R}_{1} \\\\  & ∼[\\begin{aligned}1 & 0 & -2 & -2 \\\\ 0 & 1 & 0 & -2 \\\\ 0 & 0 & 0 & 0\\end{aligned}].\\end{aligned}\n$$" #edb/ref 17592186045417] [17592186392129 #edb/ref 1075 #edb/ref 17592186392130 #edb/ref 17592186045417] [17592186392129 #edb/ref 1075 #edb/ref 17592186392131 #edb/ref 17592186045417] [17592186392129 #edb/ref 1075 #edb/ref 17592186392132 #edb/ref 17592186045417] [17592186392129 #edb/ref 1075 #edb/ref 17592186392133 #edb/ref 17592186045417] [17592186392129 #edb/ref 1075 #edb/ref 17592186392134 #edb/ref 17592186045417] [17592186392129 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186392129 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186392129 #edb/ref 1078 #edb/ref 17592186392133 #edb/ref 1759218604