#{[{:activity/first-step {:db/id #edb/ref 17592186148392} :activity/id #uuid "0d7d228b-78f0-507d-898b-cc2078977de4" :activity/scope {:db/id #edb/ref 17592186048131 :topic/id #uuid "81e52842-e868-5110-93ce-65b6024b5770" :topic/math-academy-id 2533} :activity/steps [{:db/id #edb/ref 17592186148392 :step/content {:db/id #edb/ref 17592186148771 :tutorial/content "There are three types of equilibrium solutions for an *autonomous* differential equation of the form\n\n$$\n\\dfrac{\\mathrm{d}y}{\\mathrm{d}x} = f(y),\n$$\n\nwhere the right-hand side doesn't depend explicitly on $x.$\nWe can classify each using the differential equation's phase line.\n\nLet's see each type, and classify the equilibrium solutions for the differential equation whose phase line is shown below.\n\n![](images/c6/c6fc21e9c83b98e055751ebd4062a3019687a885e2561191ec2d0bfd9de36a85.png)\n\n- An equilibrium solution is a **sink** if the arrows directly above and below it on the phase line both point *toward* the equilibrium solution.\nFor the phase line above, $y=2$ is a sink.\n\n- An equilibrium solution is a **source** if the arrows directly above and below it on the phase line both point *away* from the equilibrium solution. \nFor the phase line above, $y=0$ is a source.\n\n- An equilibrium solution is a **node** if the arrows directly above and below it on the phase line point in the same direction.\nFor the phase line above, $y=-2$ is a node since the arrows above and below it both point downward." :tutorial/id #uuid "2f2f0bc9-a043-5c8e-92aa-88135e4033a9" :tutorial/math-academy-id 5572 :tutorial/title "Introduction"} :step/id #uuid "2e343aa9-f699-5b3e-a382-effdfef6dd15" :step/math-academy-id 594276 :step/next {:db/id #edb/ref 17592186148393}} {:db/id #edb/ref 17592186148393 :step/content {:db/id #edb/ref 17592186147494 :knowledge-point/canonical-example {:db/id #edb/ref 17592186147389 :question/id #uuid "bb252f4f-ef82-52bc-a485-f88f0de96173" :question/math-academy-id "e-8650"} :knowledge-point/id #uuid "680a42fd-9b70-5fb2-916c-d10b71b11d82" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049741}] :knowledge-point/questions [{:db/id #edb/ref 17592186148222} {:db/id #edb/ref 17592186148227} {:db/id #edb/ref 17592186314815} {:db/id #edb/ref 17592186362313} {:db/id #edb/ref 17592186362314} {:db/id #edb/ref 17592186362315} {:db/id #edb/ref 17592186362316} {:db/id #edb/ref 17592186395535}] :knowledge-point/title "Classifying Equilibrium Points Using Phase Lines"} :step/id #uuid "29698ec0-1dda-5f69-bb67-f92175c1a371" :step/math-academy-id 594277 :step/next {:db/id #edb/ref 17592186148394}} {:db/id #edb/ref 17592186148394 :step/content {:db/id #edb/ref 17592186147495 :knowledge-point/canonical-example {:db/id #edb/ref 17592186147387 :question/id #uuid "7aa0a0a8-05d4-532c-a830-f1df43514fdf" :question/math-academy-id "e-8538"} :knowledge-point/id #uuid "4535b48e-a33f-5f62-95d3-a5c0991c1f6d" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049905}] :knowledge-point/questions [{:db/id #edb/ref 17592186148223} {:db/id #edb/ref 17592186148228} {:db/id #edb/ref 17592186314829} {:db/id #edb/ref 17592186314830} {:db/id #edb/ref 17592186314831} {:db/id #edb/ref 17592186314832} {:db/id #edb/ref 17592186362318} {:db/id #edb/ref 17592186362319} {:db/id #edb/ref 17592186362322} {:db/id #edb/ref 17592186375611}] :knowledge-point/title "Classifying Equilibrium Points Using a Graph"} :step/id #uuid "f7615658-7aa8-5de3-95ff-2d74b5889e16" :step/math-academy-id 594280 :step/next {:db/id #edb/ref 17592186148395}} {:db/id #edb/ref 17592186148395 :step/content {:db/id #edb/ref 17592186147496 :knowledge-point/canonical-example {:db/id #edb/ref 17592186147385 :question/id #uuid "eed50b24-e97c-51c9-b625-3327783b6374" :question/math-academy-id "e-8536"} :knowledge-point/id #uuid "b114a373-697f-5005-bb1b-46202547a905" :knowledge-point/questions [{:db/id #edb/ref 17592186148220} {:db/id #edb/ref 17592186148229} {:db/id #edb/ref 17592186314936} {:db/id #edb/ref 17592186360683} {:db/id #edb/ref 17592186362323} {:db/id #edb/ref 17592186362324} {:db/id #edb/ref 17592186362325} {:db/id #edb/ref 17592186362326} {:db/id #edb/ref 17592186362327} {:db/id #edb/ref 17592186362328} {:db/id #edb/ref 17592186362329} {:db/id #edb/ref 17592186374986}] :knowledge-point/title "Classifying the Equilibrium Points of a Given Differential Equation"} :step/id #uuid "060c8c47-3b5f-5a36-b80e-757102d6f065" :step/math-academy-id 594283 :step/next {:db/id #edb/ref 17592186148396}} {:db/id #edb/ref 17592186148396 :step/content {:db/id #edb/ref 17592186147497 :knowledge-point/canonical-example {:db/id #edb/ref 17592186147386 :question/id #uuid "dba1deed-4311-54fe-a690-8d89d4cb9592" :question/math-academy-id "e-8537"} :knowledge-point/id #uuid "b58b04cc-da5e-5c51-a583-0663d783c697" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049722}] :knowledge-point/questions [{:db/id #edb/ref 17592186148221} {:db/id #edb/ref 17592186148230} {:db/id #edb/ref 17592186314938} {:db/id #edb/ref 17592186362330} {:db/id #edb/ref 17592186362331} {:db/id #edb/ref 17592186362332} {:db/id #edb/ref 17592186391755} {:db/id #edb/ref 17592186395542} {:db/id #edb/ref 17592186395549} {:db/id #edb/ref 17592186395556} {:db/id #edb/ref 17592186395563} {:db/id #edb/ref 17592186414153}] :knowledge-point/title "Identifying Slope Fields Corresponding to Some Equilibrium Point Classifications"} :step/id #uuid "5b0fcd37-0446-59cb-b89e-24c477e9a1cc" :step/math-academy-id 594286}] :activity/title "Classifying Equilibrium Solutions of First-Order ODEs" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186147712}] [{:activity/course {:db/id #edb/ref 17592186046660} :activity/first-step {:db/id #edb/ref 17592186414157} :activity/id #uuid "8f67b1d8-cc12-5be2-bedd-7d8ea39d1438" :activity/scope {:db/id #edb/ref 17592186048131 :topic/id #uuid "81e52842-e868-5110-93ce-65b6024b5770" :topic/math-academy-id 2533} :activity/steps [{:db/id #edb/ref 17592186414154 :step/content {:db/id #edb/ref 17592186314831 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "28ce5dc1-3ad1-5783-b204-8bdf6241851e" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "III only" :db/id #edb/ref 17592186312284} {:answer/id #uuid "2d61944a-2c9c-57a5-889e-9eebe6233da6" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "I and III only" :db/id #edb/ref 17592186312332} {:answer/id #uuid "55b50611-292b-5b43-be49-4298a1c8b4dc" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "II only" :db/id #edb/ref 17592186312663} {:answer/id #uuid "710c17b1-dce6-52ad-ab8a-e1595333c2e2" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "I and II only" :db/id #edb/ref 17592186312864} {:answer/id #uuid "8c772e93-19a4-564e-a239-51cd6da30785" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "I only" :db/id #edb/ref 17592186313099}] :answer-field/correct {:db/id #edb/ref 17592186312284} :answer-field/id #uuid "7167d3ef-020b-5c26-98b0-e6af7ebfa802" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186314318}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "a963a554-e172-5944-b345-2fca4048d858" :question/math-academy-id "q-339709" :question/problem "![](images/78/78c4fafeaa4015c98d2a1817e47556957e00c87e265ca934c361a5f5941b6419.png)\n\nConsider the differential equation $\\frac{\\text{d}y}{\\text{d}x}=f(y)$ where the graph of $f(y)$ is shown above. Which of the following statements are true?\n\n- $y=2$ is a node.\n- $y=-2$ is a sink.\n- $y=-2$ is a source." :question/worked-solution "We can classify the equilibrium solutions of an autonomous ODE ${y}^{′}=f(y)$ by examining its phase line.\n\n- An equilibrium solution is a *sink* if the arrows directly above and below it on the phase line both point *toward* the equilibrium solution.\n\n- An equilibrium solution is a *source* if the arrows directly above and below it on the phase line both point *away* from the equilibrium solution.\n\n- An equilibrium solution is a *node* if the arrows directly above and below it on the phase line point in the same direction.\n\nThe phase line that corresponds to the given graph is as follows:\n\n![](images/90/9003cc9588b0838527f018463e2077d2d81bb5930ab70c1e3c713832e207bd99.png)\n\nTherefore, we have:\n\n- Statement I is false. From the phase line, we see that $y=2$ is a sink.\n\n- Statement II is false, while statement III is true. From the phase line, we see that $y=-2$ is a source.\n\nTherefore, the correct answer is \"III only\"."} :step/id #uuid "4301353b-f307-5ad7-9fa6-573ee6bd3b91"} {:db/id #edb/ref 17592186414155 :step/content {:db/id #edb/ref 17592186414153 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1a8a7f75-ccd9-5462-8bb7-2c7b1be60406" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/b5/b5e7a0272bb45b9d83ec8864f58cf3b96cbb6399d079f23d168d8de5416a1c23.png" :db/id #edb/ref 17592186414141} {:answer/id #uuid "5bd318dd-9201-58a9-b18d-379eb2818d97" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/8d/8d608e5ab231af991d4c55ca863e95557faae55bf44ad0e8e99f7cd0417531f2.png" :db/id #edb/ref 17592186414142} {:answer/id #uuid "80ba1f07-d31e-5ece-ad1d-7de624148041" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/3e/3ed74c49c2218d24dd5235f6a2f6df948d14a58edd6872ccef17ea0434c41c2b.png" :db/id #edb/ref 17592186414146} {:answer/id #uuid "b82bf18a-7b1c-5303-9140-3233520ff812" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/9a/9a24e2ecc59eb8d152790c6850403f74fe9193cc9e3dd9f3d6ff6f38e494752d.png" :db/id #edb/ref 17592186414148} {:answer/id #uuid "bb6b5c8a-efde-53a2-864f-7808884654c5" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/ae/ae926b04f1a8bb8c22cd72208b6416aa443e864083dbe4d8c2c737c049ead4f8.png" :db/id #edb/ref 17592186414149}] :answer-field/correct {:db/id #edb/ref 17592186414141} :answer-field/id #uuid "1c0eb52d-5859-5f17-a2af-047313c84ebc" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186414151}] :question/difficulty {:db/id #edb/ref 17592186045486} :question/id #uuid "57d5be79-8453-52cc-b08d-ee25cf4792e4" :question/math-academy-id "q-98812" :question/problem "A particular autonomous differential equation has the following properties:\n\n- $y=-3$ is a sink\n\n- $y=0$ is a source\n\n- $y=3$ is a sink\n\nWhich of the following could be the slope field of the differential equation?" :question/worked-solution "We can classify the equilibrium solutions of an autonomous ODE ${y}^{′}=f(y)$ by examining its phase line.\n\n- An equilibrium solution is a *sink* if the arrows directly above and below it on the phase line both point *toward* the equilibrium solution.\n\n- An equilibrium solution is a *source* if the arrows directly above and below it on the phase line both point *away* from the equilibrium solution.\n\n- An equilibrium solution is a *node* if the arrows directly above and below it on the phase line point in the same direction.\n\nFirst, we draw the phase line with the given information. \n\nNote that there are $3$ equilibrium points, $y=-3,$ $y=0,$ and $y=3.$\n\n- We're given that $y=-3$ is a sink. We represent this on the phase line by drawing a downward-pointing arrow just above $y=-3$ and an upward-pointing arrow just below it.\n\n- We're given that $y=0$ is a source. We represent this on the phase line by drawing an upward-pointing arrow just above $y=-2$ and a downward-pointing arrow just below it (already drawn by the above property).\n\n- We're given that $y=3$ is a sink. We represent this on the phase line by drawing a downward-pointing arrow just above $y=3$ and an upward-pointing arrow just below it (already drawn by the above property).\n\n![](images/a4/a4d0e0f44f77e0d29d6d226b058806e947b38f4784dc61ea609ac1040b73d7dd.png)\n\nOf the given options, the only slope field that correspond with this phase line is the following:\n\n![](images/b5/b5e7a0272bb45b9d83ec8864f58cf3b96cbb6399d079f23d168d8de5416a1c23.png)\n\nNote that:\n\n- The slope field is horizontal at $y=-3,$ $y=0,$ and $y=3.$\n\n- The slopes near $y=-3$ appear to converge toward this line.\n\n- The slopes near $y=0$ appear to diverge away from this line.\n\n- The slopes near $y=3$ appear to converge toward this line."} :step/id #uuid "4bcfd21f-7077-56a5-b180-c56af3baefcb" :step/next {:db/id #edb/ref 17592186414154}} {:db/id #edb/ref 17592186414156 :step/content {:db/id #edb/ref 17592186362326 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3c7472dd-4374-53b0-ab00-c75e67df452a" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$y=3$ is a sink" :db/id #edb/ref 17592186361116} {:answer/id #uuid "7a5472b2-d6d6-52ea-a044-09bb2a1127bf" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$y=3$ is a node" :db/id #edb/ref 17592186361376} {:answer/id #uuid "858d2406-7a62-530d-b3f3-7ae4483ae919" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$y=3$ is a source" :db/id #edb/ref 17592186361434} {:answer/id #uuid "880f5f32-2604-52b9-a6aa-0210178b0d4d" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$y=3$ is a source and $y=-3$ is a sink" :db/id #edb/ref 17592186361442} {:answer/id #uuid "94cbc50d-4636-5057-ad39-889859bff52e" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$y=3$ is a sink and $y=-3$ is a source" :db/id #edb/ref 17592186361497}] :answer-field/correct {:db/id #edb/ref 17592186361434} :answer-field/id #uuid "431fc151-9f48-50ea-8f92-91e1f1278462" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186362043}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "f9765a7a-f1b5-599a-907d-e5751bd4bc1b" :question/math-academy-id "q-98761" :question/problem "Which of the following statements is true regarding the equilibrium solutions of ${y}^{′}=(y-3)({y}^{2}+3y+9)?$" :question/worked-solution "We can classify the equilibrium solutions of an autonomous ODE ${y}^{′}=f(y)$ by examining its phase line.\n\n- An equilibrium solution is a *sink* if the arrows directly above and below it on the phase line both point *toward* the equilibrium solution.\n\n- An equilibrium solution is a *source* if the arrows directly above and below it on the phase line both point *away* from the equilibrium solution.\n\n- An equilibrium solution is a *node* if the arrows directly above and below it on the phase line point in the same direction.\n\nFirst, we need to find the equilibrium solutions. So, we solve $f(y)=0:$\n\n$$\n\\begin{aligned}f(y) & =0 \\\\ (y-3)({y}^{2}+3y+9) & =0\\end{aligned}\n$$\n\nSo, the equilibrium solution is $y=3.$ \n\nNow, we analyze the sign of $f(y)$ using a sign table, as follows:\n\n|  | $(-\\infty ,3)$ | $(3,\\infty )$ |\n| --- | --- | --- |\n| $y-3$ | $-$ | $+$ |\n| ${y}^{2}+3y+9$ | $+$ | $+$ |\n| $f(y)$ | $-$ | $+$ |\n\nSo, we have that $f(y)$ is positive for $y\\in (3,\\infty ),$ and negative for $y\\in (-\\infty ,3).$\n\nWe can now draw the phase line for this equation.\n\n![](images/24/244a46b17ad69e8d7cc3ae4f3d9c3c46c1d6e6a7ea154b849946f8ece6030071.png)\n\nFinally, we classify the equilibrium solution:\n\n- $y=3$ is a source because the nearby solutions diverge away from this point.\n\nTherefore, the correct answer is \"$y=3$ is a source\"."} :step/id #uuid "4cca875a-cd23-5293-b9eb-53796fc6ca53" :step/next {:db/id #edb/ref 17592186414158}} {:db/id #edb/ref 17592186414157 :step/content {:db/id #edb/ref 17592186148223 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "61206ccb-548f-5100-91ee-609c064a5202" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "I only" :db/id #edb/ref 17592186414143} {:answer/id #uuid "69c30199-4328-5a15-bfcf-b46f5467a96f" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "None of these listed" :db/id #edb/ref 17592186414144} {:answer/id #uuid "6a4eb0a3-0396-53b2-9786-1fe15d9dc42d" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "II only" :db/id #edb/ref 17592186414145} {:answer/id #uuid "9cf91e35-e89f-544d-aac8-8bed29bb7a2b" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "I and III only" :db/id #edb/ref 17592186414147} {:answer/id #uuid "ec014581-93eb-5649-9c32-a31c943ef63c" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "II and III only" :db/id #edb/ref 17592186414150}] :answer-field/correct {:db/id #edb/ref 17592186414145} :answer-field/id #uuid "d80f5512-0801-5f44-8705-04bc06235191" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186414152}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "68af5d21-8052-5193-93c5-650cda389ee6" :question/math-academy-id "q-96560" :question/problem "![](images/93/936d303dcc89c5c27e77fa3d7cfc8b63643284d9e203f176c9e0c5588c27e049.png)\n\nConsiderer the differential equation $\\frac{\\text{d}y}{\\text{d}x}=f(y)$ where the graph of $f(y)$ is shown above. Which of the following statements are true?\n\n- $y=1$ is a node.\n- $y=-2$ is a sink.\n- $y=3$ is a source." :question/worked-solution "We can classify the equilibrium solutions of an autonomous ODE ${y}^{′}=f(y)$ by examining its phase line.\n\n- An equilibrium solution is a *sink* if the arrows directly above and below it on the phase line both point *toward* the equilibrium solution.\n\n- An equilibrium solution is a *source* if the arrows directly above and below it on the phase line both point *away* from the equilibrium solution.\n\n- An equilibrium solution is a *node* if the arrows directly above and below it on the phase line point in the same direction.\n\nThe phase line that corresponds to the given graph is as follows:\n\n![](images/69/69e895d4091075f6d50eb9e44dc027c342d1fe7ca0269224c9b6a019ab312c77.png)\n\nTherefore, we have:\n\n- Statement I is false. From the phase line, we see that $y=1$ is a source.\n\n- Statement II is true. From the phase line, we see that $y=-2$ is a sink.\n\n- Statement III is false. From the phase line, we see that $y=3$ is a sink.\n\nTherefore, the correct answer is \"II only\"."} :step/id #uuid "d28d673b-fc35-5482-abfa-3f1e7616614a" :step/next {:db/id #edb/ref 17592186414156}} {:db/id #edb/ref 17592186414158 :step/content {:db/id #edb/ref 17592186362330 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "037a7d4f-c46b-5ef5-9f12-e499f543ede1" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/31/31519aa878fd6a9b450296552afd9bbf628e30db68a2d7c6dc6b02a48ae28b06.png" :db/id #edb/ref 17592186360845} {:answer/id #uuid "0562a68a-9113-579a-9191-136bc8b91243" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/a3/a375a537b104f5bcdd8f5951277bce2494d8861a7212772a7d7050fa14091cb9.png" :db/id #edb/ref 17592186360849} {:answer/id #uuid "2f9fb8ad-c027-5308-86ad-a2260380cc77" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/d7/d72110682c1959f10546b6fa49d6e4ebedf6b6d5557639c772f28a920f306df5.png" :db/id #edb/ref 17592186361050} {:answer/id #uuid "3b5da285-1e73-5eac-bb63-ee605aca7f27" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/41/41f32a097325dbe2a278da2abe4ef93b13d058ffe49431882fade3bc40bc0f48.png" :db/id #edb/ref 17592186361109} {:answer/id #uuid "bc463e5f-25db-5272-b846-75dffcfba6f4" :answer/type {:db/id #edb/ref 17592186045497} :answer/value "images/c7/c7895d3f3db254736c4e20ff30dbe92fb7c0786291b1198ed3f727971268be31.png" :db/id #edb/ref 17592186361677}] :answer-field/correct {:db/id #edb/ref 17592186361109} :answer-field/id #uuid "fd49cbaa-d57f-5e0e-9cec-db71bf257efe" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186362207}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "a2a6368a-0d2f-5f5f-a7f7-7f9694dc9333" :question/math-academy-id "q-98774" :question/problem "A particular autonomous differential equation has the following properties:\n\n- $y=0$ is a source\n\n- $y=-4$ is a sink\n\nWhich of the following could be the slope field of the differential equation?" :question/worked-solution "We can classify the equilibrium solutions of an autonomous ODE ${y}^{′}=f(y)$ by examining its phase line.\n\n- An equilibrium solution is a *sink* if the arrows directly above and below it on the phase line both point *toward* the equilibrium solution.\n\n- An equilibrium solution is a *source* if the arrows directly above and below it on the phase line both point *away* from the equilibrium solution.\n\n- An equilibrium solution is a *node* if the arrows directly above and below it on the phase line point in the same direction.\n\nFirst, we draw the phase line with the given information. \n\nNote that there are $2$ equilibrium points, $y=0$ and $y=-4.$\n\n- We're given that $y=0$ is a source. We represent this on the phase line by drawing an upward-pointing arrow just above $y=0$ and a downward-pointing arrow just below it.\n\n- We're given that $y=-4$ is a sink. We represent this on the phase line by drawing a downward-pointing arrow just above $y=-4$ (already drawn by the above property) and an upward-pointing arrow just below it.\n\n![](images/e5/e5ba765b9caffab904f07c5086d3206f72e36e66cb018673ce7ed44d79d19e88.png)\n\nOf the given options, the only slope field that correspond with this phase line is the following:\n\n![](images/41/41f32a097325dbe2a278da2abe4ef93b13d058ffe49431882fade3bc40bc0f48.png)\n\nNote that:\n\n- The slope field is horizontal at $y=0$ and $y=-4.$\n\n- The slopes near $y=0$ appear to diverge away from this line.\n\n- The slopes near $y=-4$ appear to converge toward this line."} :step/id #uuid "dc1c1dd6-77b7-596c-aadc-9bd547e58f0f" :step/next {:db/id #edb/ref 17592186414155}}] :activity/title "Classifying Equilibrium Solutions of First-Order ODEs" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186414140}] [{:activity/expected-seconds 960.0 :activity/first-step {:db/id #edb/ref 17592186120676} :activity/id #uuid "045805f2-d7d9-501d-8e4b-541e2bb65e50" :activity/scope {:db/id #edb/ref 17592186048315 :topic/id #uuid "93e6a7ce-2e63-5dea-bbbb-a00575db5770" :topic/math-academy-id 1852} :activity/steps [{:db/id #edb/ref 17592186120676 :step/content {:db/id #edb/ref 17592186121035 :tutorial/content "Given two vectors $\\mathbf{a}_1$ and $\\mathbf{a}_2,$ the set of all possible linear combinations of $\\mathbf{a}_1$ and $\\mathbf{a}_2$ is\n\n$$\nU = \\left\\{ x_1 \\mathbf{a}_1 + x_2 \\mathbf{a}_2 \\: : \\: x_1,x_2\\in\\mathbb{R} \\right\\}.\n$$\n\nThe set $U$ is also called the **linear span** of $\\mathbf{a}_1$ and $\\mathbf{a}_2,$ and is denoted by $\\textrm{Span}\\{ \\mathbf{a}_1, \\mathbf{a}_2 \\}.$ We say that $\\mathbf{a}_1$ and $\\mathbf{a}_2$ are the **generators** of $\\textrm{Span}\\{ \\mathbf{a}_1, \\mathbf{a}_2 \\}.$\n\nFor example, let's find the linear span generated by the following vectors:\n![](images/55/55c749dccc54c252b9120f148e383f395c09fb4cd4bec0e1cce8ed441ecb6199.svg)\n\nFrom the definition of linear span, we know that if $\\mathbf{b} \\in \\textrm{Span}\\{ \\mathbf{a}_1, \\mathbf{a}_2 \\},$ then $\\mathbf{b}$ must take the form\n\n$$\n\\mathbf{b} = x_1\\mathbf{a_1} + x_2\\mathbf{a_2}\n$$\n\n for some $x_1,x_2\\in\\mathbb{R}.$ So, we have\n\n$$\n\\begin{aligned}b & ={x}_{1}{a}_{1}+{x}_{2}{a}_{2} \\\\  & ={x}_{1}[\\begin{aligned}-1 \\\\ 1 \\\\ 0\\end{aligned}]+{x}_{2}[\\begin{aligned}3 \\\\ 2 \\\\ -1\\end{aligned}] \\\\  & =[\\begin{aligned}-{x}_{1} \\\\ {x}_{1} \\\\ 0\\end{aligned}]+[\\begin{aligned}3{x}_{2} \\\\ 2{x}_{2} \\\\ -{x}_{2}\\end{aligned}] \\\\  & =[\\begin{aligned}-{x}_{1}+3{x}_{2} \\\\ {x}_{1}+2{x}_{2} \\\\ -{x}_{2}\\end{aligned}].\\end{aligned}\n$$\n\nTherefore the linear span of $\\mathbf{a}_1$ and $\\mathbf{a}_2$ is\n![](images/21/2181b471f34906eeaea7889abbba37c797a2f9624cee455b43b00fc048247cd1.svg)\n\nGeometrically, $\\textrm{Span}\\{ \\mathbf{a}_1, \\mathbf{a}_2 \\}$ can be viewed as the plane $\\Pi$ that passes through the origin and is parallel to the vectors $\\mathbf{a}_1$ and $\\mathbf{a}_2,$ as shown below.\n\n![](images/d5/d5b202475e0bc3ebb07df1f07bab72e9e74b13a99196c2a8a5adb624a7534a03.png)" :tutorial/id #uuid "c4e2e270-f1fb-5633-9239-4696e8f0a25b" :tutorial/math-academy-id 3193 :tutorial/title "Introduction"} :step/id #uuid "05c77385-415b-5833-b935-9be3a2038c69" :step/math-academy-id 17469 :step/next {:db/id #edb/ref 17592186120677}} {:db/id #edb/ref 17592186120677 :step/content {:db/id #edb/ref 17592186119808 :knowledge-point/canonical-example {:db/id #edb/ref 17592186119619 :question/id #uuid "d5a81b39-421e-55c3-90de-d9f4e6489cd5" :question/math-academy-id "e-4795"} :knowledge-point/id #uuid "aaefbc53-9df9-54a0-a969-66e062553d5c" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048445} {:db/id #edb/ref 17592186048499}] :knowledge-point/questions [{:db/id #edb/ref 17592186120303} {:db/id #edb/ref 17592186120355} {:db/id #edb/ref 17592186241011} {:db/id #edb/ref 17592186314972} {:db/id #edb/ref 17592186315058} {:db/id #edb/ref 17592186315059} {:db/id #edb/ref 17592186317213} {:db/id #edb/ref 17592186342223} {:db/id #edb/ref 17592186421529} {:db/id #edb/ref 17592186421530}] :knowledge-point/title "Determining Whether a Vector Lies in the Span of Given Vectors"} :step/id #uuid "74f8be2d-0f86-52de-8277-fd7db395c80d" :step/math-academy-id 17471 :step/next {:db/id #edb/ref 17592186120750}} {:db/id #edb/ref 17592186120678 :step/content {:db/id #edb/ref 17592186121036 :tutorial/content "The linear span of vectors can be interpreted geometrically as the points in space that can be reached by adding multiples of those vectors.\n\n- The span of a single nonzero vector is a *line* through the origin. More precisely, if $\\mathbf{a} \\neq \\mathbf{0},$ then $\\textrm{Span}\\{ \\mathbf{a} \\}$ determines the *line* with direction vector $\\mathbf{a}$ that passes through the origin. For instance, if\n![](images/dd/ddef437718d3a11811da02a17e2207d75e2d1852eeada67ab494af45b2a655e2.svg)\nthen $\\textrm{Span}\\{ \\mathbf{a} \\}$ represents the line $l$ *spanned* by $\\mathbf{a}\\mathbin{:}$\n\n![](images/08/080aa6203494e915e28c491a3d86176f7ba634bcbdfe40b094c07d85fb29bb69.png)\n\n- The span of two non-parallel vectors is a *plane* through the origin. More precisely, if $\\mathbf{a} \\not\\parallel \\mathbf{b}$ ($\\mathbf{a}$ and $\\mathbf{b}$ are not parallel), then $\\textrm{Span}\\{ \\mathbf{a}, \\mathbf{b} \\}$ determines the *plane* with direction vectors $\\mathbf{a}$ and $\\mathbf{b}$ that passes through the origin. For instance, if\n![](images/1f/1f92378ff1d1409f0928caa4b3ce98861784d0f2aa51dd1eda30e8877a0134ff.svg)\nthen $\\textrm{Span}\\{ \\mathbf{a}, \\mathbf{b} \\}$  represents the plane $\\Pi$ *spanned* by $\\mathbf{a}$ and $\\mathbf{b}\\mathbin{:}$\n\n![](images/56/5606535bd91eb35745a9852ceb451720339105f5a97fb66ccfcb1164ecd55ffd.png)" :tutorial/id #uuid "c50c93be-7bf2-5511-b456-c60478a53270" :tutorial/math-academy-id 3194 :tutorial/title "Geometric Interpretation of the Linear Span"} :step/id #uuid "15713f7b-cd11-55c3-93fd-8040ac62d36f" :step/math-academy-id 17477 :step/next {:db/id #edb/ref 17592186120679}} {:db/id #edb/ref 17592186120679 :step/content {:db/id #edb/ref 17592186119809 :knowledge-point/canonical-example {:db/id #edb/ref 17592186119620 :question/id #uuid "94a17888-dcef-58e0-8147-0dec3745f136" :question/math-academy-id "e-4799"} :knowledge-point/id #uuid "a04b551f-3323-5b91-b01e-941912cc92be" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186050308}] :knowledge-point/questions [{:db/id #edb/ref 17592186120304} {:db/id #edb/ref 17592186120306} {:db/id #edb/ref 17592186241021} {:db/id #edb/ref 17592186241023} {:db/id #edb/ref 17592186241024} {:db/id #edb/ref 17592186241025} {:db/id #edb/ref 17592186317208} {:db/id #edb/ref 17592186342240} {:db/id #edb/ref 17592186342241} {:db/id #edb/ref 17592186342243} {:db/id #edb/ref 17592186344944} {:db/id #edb/ref 17592186393417} {:db/id #edb/ref 17592186399461} {:db/id #edb/ref 17592186403766} {:db/id #edb/ref 17592186421528}] :knowledge-point/title "Determining Whether a Vector Lies on a Plane"} :step/id #uuid "33abdb88-235d-550f-b5bb-06946454437c" :step/math-academy-id 17478} {:db/id #edb/ref 17592186120750 :step/content {:db/id #edb/ref 17592186119856 :knowledge-point/canonical-example {:db/id #edb/ref 17592186119671 :question/id #uuid "21a6808a-5b1c-5b1d-9bd4-da605fb6d920" :question/math-academy-id "e-6218"} :knowledge-point/id #uuid "fac58a79-2d3f-5ad3-b1ab-c5ce279c4ebe" :knowledge-point/questions [{:db/id #edb/ref 17592186120294} {:db/id #edb/ref 17592186120516} {:db/id #edb/ref 17592186241017} {:db/id #edb/ref 17592186241019} {:db/id #edb/ref 17592186342228} {:db/id #edb/ref 17592186342229} {:db/id #edb/ref 17592186342230} {:db/id #edb/ref 17592186342231} {:db/id #edb/ref 17592186342237} {:db/id #edb/ref 17592186342238} {:db/id #edb/ref 17592186342239} {:db/id #edb/ref 17592186421531} {:db/id #edb/ref 17592186421532}] :knowledge-point/title "Finding the Value of an Unknown Such That a Vector Lies in the Span of Given Vectors"} :step/id #uuid "5cca50af-2a48-5696-bc3a-fc57e95232b0" :step/math-academy-id 23264 :step/next {:db/id #edb/ref 17592186120678}}] :activity/title "Linear Span of Vectors in N-Dimensional Euclidean Space" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186120046}] [{:activity/first-step {:db/id #edb/ref 17592186162990} :activity/id #uuid "2698ccf6-18f8-573f-9adf-9c8bdcc0f6e7" :activity/scope {:db/id #edb/ref 17592186048325 :topic/id #uuid "95207fcf-4f1f-5c3f-a008-9c15baaebacc" :topic/math-academy-id 3002} :activity/steps [{:db/id #edb/ref 17592186162990 :step/content {:db/id #edb/ref 17592186163281 :tutorial/content "The joint PMF $f(x,y)$ of two discrete random variables $X$ and $Y$ tells us all possible events $(X, Y)$ and the probabilities associated with each event. However, suppose we wish to determine the probability mass function for $X$ only. How can this be deduced from the joint PMF?\n\nLet's build some intuition by considering an example.\n\nConsider the joint probability mass function $f(x,y)$ for the discrete random variables $X$ and $Y,$ shown below.\n\n| $f$ | $Y=1$ | $Y=2$ |\n| --- | --- | --- |\n| $X={\\color{blue}{1}}$ | $0.05$ | $0.15$ |\n| $X={\\color{red}{2}}$ | $0.7$ | $0.1$ |\n\nThe support of $X$ is $S_X = \\{{\\color{blue}{1}},{\\color{red}{2}}\\}.$ Let's now deduce the probabilities associated with each value of $X$ in $S_X\\mathbin{:}$\n\n- According to the law of total probability, we can deduce $P(X=1)$ by summing the values in the first row of the table, as follows:\n\n$$\n\\begin{aligned}P(X=1) & =P(X=1,Y=1)+P(X=1,Y=2) \\\\  & =0.05+0.15 \\\\  & =0.2\\end{aligned}\n$$\n\nNotice that we summed over all possible values of $Y$ associated with $X=1.$\n\n- Similarly, by summing the values in the second row in the table, we have\n\n$$\n\\begin{aligned}P(X=2) & =P(X=2,Y=1)+P(X=2,Y=2) \\\\  & =0.7+0.1 \\\\  & =0.8.\\end{aligned}\n$$\n\nNotice that we summed over all possible values of $Y$ associated with $X=2.$\n\nTherefore, the probability mass function for $X$ is as follows:\n\n| $x$ | $\\color{blue}1$ | $\\color{red}2$ |\n| --- | --- | --- |\n| $f_X(x)$ | $0.2$ | $0.8$ |\n\nNotice that we have used the notation $f_X(x).$ Since $f_X(x)$ was deduced from the joint probability mass function $f(x,y),$ we call $f_X(x)$ the **marginal mass function** for $X.$" :tutorial/id #uuid "0281a245-2f6d-5a89-8ea7-5d77bf3dca4f" :tutorial/math-academy-id 5469 :tutorial/title "Introduction"} :step/id #uuid "0dce6d66-b5fe-52cc-ae58-8918d96eb144" :step/math-academy-id 34052 :step/next {:db/id #edb/ref 17592186163082}} {:db/id #edb/ref 17592186162997 :step/content {:db/id #edb/ref 17592186162071 :knowledge-point/canonical-example {:db/id #edb/ref 17592186161871 :question/id #uuid "da693f0e-db20-5a7f-9737-3f26d5d6581c" :question/math-academy-id "e-9189"} :knowledge-point/id #uuid "96760d15-5e56-529b-a5da-1697dc782031" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048368} {:db/id #edb/ref 17592186051001}] :knowledge-point/questions [{:db/id #edb/ref 17592186162306} {:db/id #edb/ref 17592186162308} {:db/id #edb/ref 17592186272355} {:db/id #edb/ref 17592186272356} {:db/id #edb/ref 17592186272357} {:db/id #edb/ref 17592186272358} {:db/id #edb/ref 17592186272359}] :knowledge-point/title "Finding a Marginal Probability"} :step/id #uuid "b36fe44c-1d35-5f90-8f95-9d5746329173" :step/math-academy-id 34274 :step/next {:db/id #edb/ref 17592186163063}} {:db/id #edb/ref 17592186162998 :step/content {:db/id #edb/ref 17592186162072 :knowledge-point/canonical-example {:db/id #edb/ref 17592186161872 :question/id #uuid "e99dc081-a5d6-5770-a0ea-da172b0d37f5" :question/math-academy-id "e-9190"} :knowledge-point/id #uuid "96473ec4-67f8-5614-b187-0961062aac29" :knowledge-point/questions [{:db/id #edb/ref 17592186162309} {:db/id #edb/ref 17592186162375} {:db/id #edb/ref 17592186272360} {:db/id #edb/ref 17592186272361} {:db/id #edb/ref 17592186272363} {:db/id #edb/ref 17592186272364} {:db/id #edb/ref 17592186272365}] :knowledge-point/title "Finding a Cumulative Probability Given a Joint Distribution"} :step/id #uuid "6e2655db-a7c3-5298-b5ab-6b47cfe4c0e4" :step/math-academy-id 34277} {:db/id #edb/ref 17592186163063 :step/content {:db/id #edb/ref 17592186162102 :knowledge-point/canonical-example {:db/id #edb/ref 17592186161668 :question/id #uuid "162ebeba-e9ee-5588-8d79-659754a77548" :question/math-academy-id "e-10044"} :knowledge-point/id #uuid "ac80eed8-d801-5275-9bd1-73ba43fadb38" :knowledge-point/questions [{:db/id #edb/ref 17592186162307} {:db/id #edb/ref 17592186162369} {:db/id #edb/ref 17592186272372} {:db/id #edb/ref 17592186272374} {:db/id #edb/ref 17592186272376} {:db/id #edb/ref 17592186272377} {:db/id #edb/ref 17592186272379}] :knowledge-point/title "Finding a Marginal Probability Distribution"} :step/id #uuid "f514a8f7-d466-5f40-8ce4-7fcfebb6e28c" :step/math-academy-id 37907 :step/next {:db/id #edb/ref 17592186162998}} {:db/id #edb/ref 17592186163082 :step/content {:db/id #edb/ref 17592186163331 :tutorial/content "Let's go back to the last example for the random variables $X$ and $Y.$\n\n| $f$ | $Y=1$ | $Y=2$ |\n| --- | --- | --- |\n| $X=1$ | $0.05$ | $0.15$ |\n| $X=2$ | $0.7$ | $0.1$ |\n\nWe saw that the marginal mass function $f_X$ for $X$ is found by summing the rows in the table. So let's add the sum of each row to our table:\n\n| $f$ | $Y=1$ | $Y=2$ | $f_X$ |\n| --- | --- | --- | --- |\n| $X=1$ | $0.05$ | $0.15$ | $\\bbox[2pt,Gainsboro]{\\color{blue}0.2}$ |\n| $X=2$ | $0.7$ | $0.1$ | $\\bbox[2pt,Gainsboro]{\\color{blue}0.8}$ |\n\nNotice how we wrote the values of the *marginal* mass function in the right *margin* of the table.\n\nFrom here, we can immediately deduce that \n\n$$\nP(X=1) = f_X(1) = 0.2, \\qquad P(X=2) = f_X(2) = 0.8.\n$$\n\nSimilarly, we can compute the marginal mass function of $Y,$ denoted $f_Y(y),$ by summing the columns. Adding these totals to our table, we get the following:\n\n| $f$ | $Y={\\color{blue}{1}}$ | $Y={\\color{red}{2}}$ | $f_X$ |\n| --- | --- | --- | --- |\n| $X=1$ | $0.05$ | $0.15$ | $0.2$ |\n| $X=2$ | $0.7$ | $0.1$ | $0.8$ |\n| $f_Y$ | $\\bbox[2pt,Gainsboro]{\\color{blue}0.75}$ | $\\bbox[2pt,Gainsboro]{\\color{blue}0.25}$ | $1$ |\n\nAgain, notice how we wrote the values of the *marginal* mass function in the bottom *margin* of the table.\n\nFrom here, we can immediately deduce that \n\n$$\nP(Y={\\color{blue}{1}}) = f_Y({\\color{blue}{1}}) = 0.75, \\qquad P(Y={\\color{red}{2}}) = f_Y({\\color{red}{2}}) = 0.25.\n$$\n\nFinally, the marginal mass function $f_Y(y)$ of $Y$ is as follows:\n\n| $y$ | $\\color{blue}1$ | $\\color{red}2$ |\n| --- | --- | --- |\n| $f_Y(y)$ | $0.75$ | $0.25$ |" :tutorial/id #uuid "a1c9ecf8-619b-58b7-899f-b179dca8ae45" :tutorial/math-academy-id 6290 :tutorial/title "Deducing the Marginal Mass Function for Y"} :step/id #uuid "83e1320a-f77b-5173-bedf-f02c9d400247" :step/math-academy-id 38105 :step/next {:db/id #edb/ref 17592186163083}} {:db/id #edb/ref 17592186163083 :step/content {:db/id #edb/ref 17592186163332 :tutorial/content "Now that we've built some intuition, let's define the marginal mass functions formally.\n\nLet $f(x,y)$ be the joint PMF of the discrete random variables $X$ and $Y$ with supports $S_X$ and $S_Y$, respectively.\n\n- The **marginal mass function ** of $X,$ denoted $f_X(x),$ is defined as\n\n$$\nf_X(x) = P(X=x)  = \\displaystyle \\sum\\limits_{y \\in S_Y} f(x,y).\n$$\n\n- The **marginal mass function ** of $Y,$ denoted $f_Y(y),$ is defined as\n\n$$\nf_Y(y)= P(Y=y)  = \\displaystyle \\sum\\limits_{x \\in S_X} f(x,y).\n$$\n\nWe can relate these definitions to our previous intuition:\n\n- The first definition states that, to compute $P(X=x)$ for some particular value $x,$ we sum all possible values of $Y$ in the row corresponding to $X=x.$\n\n- The second definition states that, to compute $P(Y=y)$ for some particular value $y,$ we sum all possible values of $X$ in the column corresponding to $Y=y.$\n\nFinally, note that marginal mass functions are sometimes called **marginal probability mass functions**, **marginal PMFs**, or (less formally) **marginal distributions**." :tutorial/id #uuid "ddca7e0f-a315-5567-97d7-f5b40876617b" :tutorial/math-academy-id 6291 :tutorial/title "A Formal Definition of the Marginal Mass Function"} :step/id #uuid "97117126-1ac4-57aa-9c23-c3e882c06372" :step/math-academy-id 38106 :step/next {:db/id #edb/ref 17592186162997}}] :activity/title "Marginal Distributions for Discrete Random Variables" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186162163}] [{:activity/first-step {:db/id #edb/ref 17592186120913} :activity/id #uuid "7247ca88-471f-5303-aa77-7e868bf58346" :activity/scope {:db/id #edb/ref 17592186048377 :topic/id #uuid "9a5bcec0-860b-5cc9-83b6-331b8b7e1d13" :topic/math-academy-id 1792} :activity/steps [{:db/id #edb/ref 17592186120913 :step/content {:db/id #edb/ref 17592186121135 :tutorial/content "Consider the curve $C$ parametrized by the vector-valued function \n\n$$\n\\mathbf f(t) = \\langle t+1, \\: t^2 +1\\rangle, \\qquad t \\in (-\\infty, \\infty).\n$$\n\nDifferentiating this function, we get\n\n$$\n\\mathbf f'(t) = \\langle 1, \\: 2t\\rangle.\n$$\n\nEvaluating this function and its derivative at $t=0,$ we get the following pair of vectors:\n\n$$\n\\mathbf f(0)  =  \\left\\langle 1, 1 \\right\\rangle, \\qquad \\mathbf f'(0)  =  \\left\\langle 1, 0 \\right\\rangle\n$$\n\nIf we view $\\mathbf{f}'(0)$ as a vector attached to the tip of the position vector $\\mathbf f(0),$ then it will be tangent to the curve $C,$ as shown below.\n\n![](images/85/854d16c788836f784d739f73063354fa3ca2ad233f03cce53b99e5764449f585.png)\n\nSince $\\mathbf f'(0) \\neq \\mathbf{0},$ it serves as a direction vector for the tangent line to the curve at $\\mathbf f(0).$ The equation of this line is given by\n\n$$\n\\begin{aligned}R(u) & =f(0)+u{f}^{'}(0) \\\\  & =⟨1,1⟩+u⟨1,0⟩ \\\\  & =⟨1+u,\\,1⟩\\end{aligned}\n$$\n\nwhere $u \\in (-\\infty, \\infty).$\n\nIn general, if a curve $C$ is parametrized by a vector function $\\mathbf f(t),$ then the vector $\\mathbf f'(t)$ gives a **tangent vector** to $C$ at $\\mathbf{f} (t),$ provided that $\\mathbf f'(t)\\neq \\mathbf{0}.$\n\nFor a fixed $t$ in the domain of $\\mathbf{f}(t),$ the equation of the corresponding tangent line is\n\n$$\n\\mathbf{R}(u) = \\mathbf{f}(t) + u\\mathbf{f}'(t), \\qquad u \\in (-\\infty, \\infty).\n$$\n\nFurthermore, the vector $\\mathbf f'(t)$ always points in the direction that the curve $C$ is oriented. In our example above, as $t$ increases and passes through the point $(1,1),$ the curve is transversed from left to right, and the direction of the vector $\\mathbf{f}'(0)$ is also from left to right." :tutorial/id #uuid "dbd32d96-f4fc-5f66-861c-fc1b9746be10" :tutorial/math-academy-id 7864 :tutorial/title "Introduction"} :step/id #uuid "2d2f798c-9ffb-57a0-aea4-4212795c1dcc" :step/math-academy-id 45344 :step/next {:db/id #edb/ref 17592186120914}} {:db/id #edb/ref 17592186120914 :step/content {:db/id #edb/ref 17592186119943 :knowledge-point/canonical-example {:db/id #edb/ref 17592186119513 :question/id #uuid "7d93dd10-5319-58e7-9106-f8c675dc9e65" :question/math-academy-id "e-12567"} :knowledge-point/id #uuid "a9c2fbd5-33cf-51fb-b95d-cf5277f3e4ae" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048999}] :knowledge-point/questions [{:db/id #edb/ref 17592186120212} {:db/id #edb/ref 17592186120214} {:db/id #edb/ref 17592186262642} {:db/id #edb/ref 17592186262643} {:db/id #edb/ref 17592186262644} {:db/id #edb/ref 17592186262645} {:db/id #edb/ref 17592186345043} {:db/id #edb/ref 17592186345044} {:db/id #edb/ref 17592186345045}] :knowledge-point/title "Finding a Tangent Vector"} :step/id #uuid "989791d3-66ad-598a-a711-f5c1c0da6f59" :step/math-academy-id 45345 :step/next {:db/id #edb/ref 17592186120915}} {:db/id #edb/ref 17592186120915 :step/content {:db/id #edb/ref 17592186119944 :knowledge-point/canonical-example {:db/id #edb/ref 17592186119514 :question/id #uuid "42109de0-eb59-53f9-982e-1433f630b067" :question/math-academy-id "e-12568"} :knowledge-point/id #uuid "60e28b26-0eb7-51ed-bcf9-2660b98a6028" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049485}] :knowledge-point/questions [{:db/id #edb/ref 17592186120108} {:db/id #edb/ref 17592186120215} {:db/id #edb/ref 17592186262656} {:db/id #edb/ref 17592186262657} {:db/id #edb/ref 17592186304794} {:db/id #edb/ref 17592186308635} {:db/id #edb/ref 17592186308643} {:db/id #edb/ref 17592186308650} {:db/id #edb/ref 17592186308704} {:db/id #edb/ref 17592186345046} {:db/id #edb/ref 17592186363010} {:db/id #edb/ref 17592186400240} {:db/id #edb/ref 17592186400247} {:db/id #edb/ref 17592186405125}] :knowledge-point/title "Finding a Tangent Line to a Curve"} :step/id #uuid "e0c03cce-2d21-571e-98fe-f72a42288e4a" :step/math-academy-id 45348 :step/next {:db/id #edb/ref 17592186120917}} {:db/id #edb/ref 17592186120916 :step/content {:db/id #edb/ref 17592186119945 :knowledge-point/canonical-example {:db/id #edb/ref 17592186119515 :question/id #uuid "26c3579b-5b24-5e84-9024-5b2597856d20" :question/math-academy-id "e-12569"} :knowledge-point/id #uuid "b4636870-89db-5bf9-8a04-777407957e33" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186049715}] :knowledge-point/questions [{:db/id #edb/ref 17592186120109} {:db/id #edb/ref 17592186120216} {:db/id #edb/ref 17592186262664} {:db/id #edb/ref 17592186284532} {:db/id #edb/ref 17592186284533} {:db/id #edb/ref 17592186284534} {:db/id #edb/ref 17592186284535} {:db/id #edb/ref 17592186284536} {:db/id #edb/ref 17592186308725} {:db/id #edb/ref 17592186311545} {:db/id #edb/ref 17592186363527} {:db/id #edb/ref 17592186398604} {:db/id #edb/ref 17592186410824}] :knowledge-point/title "Finding Points Where a Tangent Vector is Parallel to Another Vector"} :step/id #uuid "74ac7b94-509d-54d2-9176-80fb0b50e930" :step/math-academy-id 45351} {:db/id #edb/ref 17592186120917 :step/content {:db/id #edb/ref 17592186119946 :knowledge-point/canonical-example {:db/id #edb/ref 17592186119516 :question/id #uuid "e8c24f26-7658-5251-922a-4b34043a71d4" :question/math-academy-id "e-12580"} :knowledge-point/id #uuid "297a4812-a87a-592a-818a-8c8d3d3f7868" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048954}] :knowledge-point/questions [{:db/id #edb/ref 17592186120253} {:db/id #edb/ref 17592186120522} {:db/id #edb/ref 17592186262662} {:db/id #edb/ref 17592186262663} {:db/id #edb/ref 17592186284525} {:db/id #edb/ref 17592186284526} {:db/id #edb/ref 17592186284527} {:db/id #edb/ref 17592186284528} {:db/id #edb/ref 17592186284529} {:db/id #edb/ref 17592186345047} {:db/id #edb/ref 17592186345102} {:db/id #edb/ref 17592186345103}] :knowledge-point/title "Finding Points Where a Tangent Vector is Perpendicular to Another Vector"} :step/id #uuid "ad5a98da-8ea4-5205-9db2-94f0f8b668ab" :step/math-academy-id 45392 :step/next {:db/id #edb/ref 17592186120916}}] :activity/title "Tangent Vectors and Tangent Lines to Curves" :activity/type {:db/id #edb/ref 17592186045463 :db/ident :activity.type/lesson} :db/id #edb/ref 17592186120011}] [{:activity/course {:db/id #edb/ref 17592186046659} :activity/first-step {:db/id #edb/ref 17592186410826} :activity/id #uuid "27a4662b-38f4-5da4-a14f-0ae0dbfbda48" :activity/scope {:db/id #edb/ref 17592186048377 :topic/id #uuid "9a5bcec0-860b-5cc9-83b6-331b8b7e1d13" :topic/math-academy-id 1792} :activity/steps [{:db/id #edb/ref 17592186410825 :step/content {:db/id #edb/ref 17592186410824 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "38f7dbd3-9ac6-59ba-822d-baee2e1a48d2" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(3,-5)" :db/id #edb/ref 17592186410818} {:answer/id #uuid "4ad7606a-78cf-5b5a-aad3-516d0783136b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(-1,3)" :db/id #edb/ref 17592186410819} {:answer/id #uuid "6e2a15f9-1731-51c6-a7aa-e028d3d2c84e" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(0,7)" :db/id #edb/ref 17592186410820} {:answer/id #uuid "b2e66482-ad5e-56f0-ab9c-0187ad900545" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(0,-1)" :db/id #edb/ref 17592186410821} {:answer/id #uuid "c15d36f2-d954-5b67-a997-5ab2ddb7afaa" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(8,-9)" :db/id #edb/ref 17592186410822}] :answer-field/correct {:db/id #edb/ref 17592186410818} :answer-field/id #uuid "236f2410-bb87-524a-b10a-c030da587949" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186410823}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "eb19afc5-d677-5f22-bac0-92428e650b61" :question/math-academy-id "q-126900" :question/problem "Given the curve $r(t)=⟨{t}^{2}-2t,4t-1⟩,$ find the point at which the tangent to the curve is parallel to the vector $⟨-1,1⟩.$" :question/worked-solution "First, we calculate the derivative of $r(t):$\n\n$$\n\\begin{aligned}{r}^{′}(t) & =⟨\\frac{\\text{d}}{\\text{d}t}({t}^{2}-2t),\\,\\frac{\\text{d}}{\\text{d}t}(4t-1)⟩ \\\\  & =⟨2t-2,4⟩\\end{aligned}\n$$\n\nThe vectors ${r}^{′}(t)$ and $⟨-1\\,,\\,1⟩$ are parallel for some specific value ${t}_{0}$ of the parameter $t$ if and only if there exists a constant $c$ such that ${r}^{′}({t}_{0})=c⟨-1,1⟩.$ So, we have\n\n$$\n\\begin{aligned}{r}^{′}(t) & =c⟨-1,1⟩ \\\\ ⟨2t-2,4⟩ & =c⟨-1,1⟩ \\\\ ⟨2t-2,4⟩ & =⟨-c,c⟩.\\end{aligned}\n$$\n\nEquating the components gives:\n\n$$\n{\\begin{aligned}2t-2=-c \\\\ 4=c\\end{aligned}\n$$\n\nFrom the second equation, we obtain that $c=4.$ Substituting $c=4$ into the first equation, we get $t=-1.$ \n\nTherefore, $⟨-1,1⟩$ and ${r}^{′}$ are parallel only at the point corresponding to $t=-1.$\n\nFinally, since\n\n$$\n\\begin{aligned}r(-1) & =⟨(-1)^{2}-2(-1),4(-1)-1⟩ \\\\  & =⟨3,-5⟩,\\end{aligned}\n$$\n\nwe conclude that $⟨-1,1⟩$ and ${r}^{′}(t)$ are parallel at the point $(3,-5).$"} :step/id #uuid "25cc0c4b-5364-577c-92a1-008375ee5f34" :step/next {:db/id #edb/ref 17592186410828}} {:db/id #edb/ref 17592186410826 :step/content {:db/id #edb/ref 17592186345046 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3bdb4010-1e08-5378-a110-856c1b0d31e9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "⟨0,\\,1,\\,1⟩+u⟨1,\\,1,\\,-1⟩,\\,u\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186342732} {:answer/id #uuid "8844755e-17ca-5997-8087-0445418bac62" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "⟨0,\\,1,\\,1⟩+u⟨-1,\\,-1,\\,-1⟩,\\,u\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186343418} {:answer/id #uuid "97e8fdd1-1609-5108-82df-e53e59510619" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "⟨0,\\,1,1⟩+u⟨1,\\,0,\\,1⟩,\\,u\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186343570} {:answer/id #uuid "d3b6012c-303d-5b23-b10c-010c9c93ca49" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "⟨0,\\,1,1⟩+u⟨1,\\,-1,0⟩,\\,u\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186344097} {:answer/id #uuid "fd335b51-418d-5e75-99ad-992ab400d4c9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "⟨0,\\,1,\\,1⟩+u⟨0,\\,-1,\\,1⟩,\\,u\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186344464}] :answer-field/correct {:db/id #edb/ref 17592186342732} :answer-field/id #uuid "c171024e-4b6d-5601-9cbd-861fac1471b4" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186344833}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "a928b0be-2c4b-5a25-9350-6790b8cc0365" :question/math-academy-id "q-75203" :question/problem "Which of the following gives the equation of the tangent to the curve $r(t)=⟨t,\\,{e}^{t},\\,{e}^{-t}⟩$ at the point where $t=0,$  valid for all  real values of $u?$" :question/worked-solution "At the point where $t=0$,  the vector ${r}^{′}(0)$ is tangent to the curve, so the tangent line to the curve at $P$ can be parametrized as\n\n \n\n$$\nR(u)=r(0)+u{r}^{′}(0),\\,u\\in (-\\infty ,\\infty )\n$$\n\n \n\nFirst, we find $r(0):$\n\n$$\n\\begin{aligned}r(0) & =⟨0,\\,{e}^{0},\\,{e}^{-0}⟩ \\\\  & =⟨0,\\,1,\\,1⟩\\end{aligned}\n$$\n\n   \n\nNow, we calculate ${r}^{′}(t):$ \n\n$$\n\\begin{aligned}{r}^{′}(t) & =⟨\\frac{\\text{d}}{\\text{d}t}(t),\\,\\frac{\\text{d}}{\\text{d}t}({e}^{t}),\\,\\frac{\\text{d}}{\\text{d}t}({e}^{-t})⟩ \\\\  & =⟨1,\\,{e}^{t},\\,-{e}^{-t}⟩\\end{aligned}\n$$\n\nThen, we evaluate ${r}^{′}(t)$ at $t=0:$\n\n$$\n\\begin{aligned}{r}^{′}(0) & =⟨1,\\,{e}^{0},\\,-{e}^{-0}⟩ \\\\  & =⟨1,\\,1,\\,-1⟩\\end{aligned}\n$$\n\nFinally, the tangent line to the given curve at the point \n where $t=0$ is\n\n$$\nR(u)=⟨0,\\,1,\\,1⟩+u⟨1,\\,1,\\,-1⟩,\\,u\\in (-\\infty ,\\infty ).\n$$"} :step/id #uuid "588c5c9a-8d3d-51b8-8b90-dff365fed144" :step/next {:db/id #edb/ref 17592186410825}} {:db/id #edb/ref 17592186410827 :step/content {:db/id #edb/ref 17592186284525 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6a91054f-adf7-5f56-83c2-fa3119dc478c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(\\frac{1}{16},-\\frac{7}{4})" :db/id #edb/ref 17592186282606} {:answer/id #uuid "88ea9708-0042-5422-b8c9-124b38c78848" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$(64,2)$ and $(\\frac{1}{16},-\\frac{7}{4})$" :db/id #edb/ref 17592186282871} {:answer/id #uuid "cbc619de-3849-50d7-a032-ed5d0fa3212b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(64,2)" :db/id #edb/ref 17592186283469} {:answer/id #uuid "dc37b06f-ca47-55ac-9f76-e24057ce58fc" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(2\\,,\\,-1)" :db/id #edb/ref 17592186283609} {:answer/id #uuid "f38a4e4e-a50c-5a8c-9c70-c08d603abc61" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$(2,-1)$ and $(\\frac{1}{16},-\\frac{7}{4})$" :db/id #edb/ref 17592186283818}] :answer-field/correct {:db/id #edb/ref 17592186283609} :answer-field/id #uuid "109ae18e-4733-5298-895a-59e0b555d56b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186283966}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "854e79dd-e49f-5d57-896b-a1669e5ffce7" :question/math-academy-id "q-164833" :question/problem "Given the curve $r(t)=⟨2{t}^{5}\\,,\\,{t}^{2}-2⟩,$ $t\\in (0,\\infty ),$ find all of the points at which the tangent to the curve is perpendicular to the vector $⟨1\\,,\\,-5⟩.$" :question/worked-solution "First, we calculate the derivative of $r(t):$\n\n$$\n\\begin{aligned}{r}^{′}(t) & =⟨\\frac{\\text{d}}{\\text{d}t}(2{t}^{5})\\,,\\,\\frac{\\text{d}}{\\text{d}t}({t}^{2}-2)⟩ \\\\  & =⟨10{t}^{4}\\,,\\,2t⟩\\end{aligned}\n$$\n\nThe vectors  $⟨1\\,,\\,-5⟩$ and ${r}^{′}(t)$ are perpendicular for some value of the parameter $t$ if and only if $⟨1\\,,\\,-5⟩\\cdot {r}^{′}(t)=0.$ So, we have\n\n$$\n\\begin{aligned}⟨1\\,,\\,-5⟩\\cdot {r}^{′}(t) & =0 \\\\ ⟨1\\,,\\,-5⟩\\cdot ⟨10{t}^{4}\\,,\\,2t⟩ & =0 \\\\ 1\\cdot 10{t}^{4}+(-5)\\cdot 2t & =0 \\\\ 10{t}^{4}-10t & =0 \\\\ 10t({t}^{3}-1) & =0.\\end{aligned}\n$$\n\nSince $t\\in (0,\\infty )$, the only solution is $t=1.$\n\nFinally, since\n\n$$\n\\begin{aligned}r(1) & =⟨2(1)^{5}\\,,\\,(1)^{2}-2⟩=⟨2\\,,\\,-1⟩,\\end{aligned}\n$$\n\n we conclude that $⟨1\\,,\\,-5⟩$ and ${r}^{′}(t)$ are perpendicular at the point $(2\\,,\\,-1).$"} :step/id #uuid "677b5852-f95c-533d-b31c-e87dce9ad2d7" :step/next {:db/id #edb/ref 17592186410829}} {:db/id #edb/ref 17592186410828 :step/content {:db/id #edb/ref 17592186120109 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8311c425-96db-50b4-bda2-7afc21298e5d" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(0,5)" :db/id #edb/ref 17592186261013} {:answer/id #uuid "970d51ce-6cc7-567e-b921-0a5f575739b7" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(10,-7)" :db/id #edb/ref 17592186261184} {:answer/id #uuid "aed5ed6e-37c8-5e3c-ae55-c95e30ce3202" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(6,-7)" :db/id #edb/ref 17592186261416} {:answer/id #uuid "bc52c38c-023f-560d-827e-ce988bae6a2c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(1,2)" :db/id #edb/ref 17592186261533} {:answer/id #uuid "c912ae60-77c2-546c-be59-6f64006178e1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(3,2)" :db/id #edb/ref 17592186261652}] :answer-field/correct {:db/id #edb/ref 17592186261533} :answer-field/id #uuid "0c61931c-b6de-57e6-b862-b7df723296cc" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186262146}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "22d6e6f4-daf0-5645-a375-f0c335545e70" :question/math-academy-id "q-126902" :question/problem "Given the curve $r(t)=⟨2{t}^{2}-t,5-3{t}^{2}⟩,$ find the point at which the tangent to the curve is parallel to the vector $⟨-1,2⟩.$" :question/worked-solution "First, we calculate the derivative of $r(t):$\n\n$$\n\\begin{aligned}{r}^{′}(t) & =⟨\\frac{\\text{d}}{\\text{d}t}(2{t}^{2}-t),\\,\\frac{\\text{d}}{\\text{d}t}(5-3{t}^{2})⟩ \\\\  & =⟨4t-1,-6t⟩\\end{aligned}\n$$\n\nThe vectors ${r}^{′}(t)$ and $⟨-1\\,,\\,2⟩$ are parallel for some specific value ${t}_{0}$ of the parameter $t$ if and only if there exists a constant $c$ such that ${r}^{′}({t}_{0})=c⟨-1,2⟩.$ So, we have\n\n$$\n\\begin{aligned}{r}^{′}(t) & =c⟨-1,2⟩ \\\\ ⟨4t-1,-6t⟩ & =c⟨-1,2⟩ \\\\ ⟨4t-1,-6t⟩ & =⟨-c,2c⟩.\\end{aligned}\n$$\n\nEquating the components gives:\n\n$$\n{\\begin{aligned}4t-1=-c \\\\ -6t=2c\\end{aligned}\n$$\n\nFrom the first equation, we obtain that $c=-4t+1.$ Substituting $c=-4t+1$ into the second equation, we get\n\n$$\n\\begin{aligned}-6t & =2(-4t+1) \\\\ -6t & =-8t+2 \\\\ 2t & =2 \\\\ t & =1.\\end{aligned}\n$$\n\nTherefore, $⟨-1,2⟩$ and ${r}^{′}$ are parallel only at the point corresponding to $t=1.$\n\nFinally, since\n\n$$\n\\begin{aligned}r(1) & =⟨2(1)^{2}-1,5-3(1)^{2}⟩=⟨1,2⟩,\\end{aligned}\n$$\n\nwe conclude that $⟨-1,2⟩$ and ${r}^{′}(t)$ are parallel at the point $(1,2).$"} :step/id #uuid "881f99cb-89c3-507b-a7a0-8ef265378f7b" :step/next {:db/id #edb/ref 17592186410827}} {:db/id #edb/ref 17592186410829 :step/content {:db/id #edb/ref 17592186284532 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "580c3843-6361-5a93-8e93-aa4eecc3f021" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(24,26)" :db/id #edb/ref 17592186282438} {:answer/id #uuid "95ec2ae6-b848-5b2c-9e73-71480e6476c7" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(-9,-4)" :db/id #edb/ref 17592186282983} {:answer/id #uuid "9978da76-99f6-51aa-835d-d6470ba9b397" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "(-7,-4)" :db/id #edb/ref 17592186283023} {:answer/id #uuid "c39a49da-d2c5-5e18-8270-20d823e49792" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$(-9,-4)$ and $(-8,-6)$" :db/id #edb/ref 17592186283395} {:answer/id #uuid "ca04d778-71e9-52fd-ba77-a58b5aaf9a03" :answer/type {:db/id #edb/ref 17592186045499} :answer/value "$(-7,-4)$ and $(24,26)$" :db/id #edb/ref 17592186283453}] :answer-field/correct {:db/id #edb/ref 17592186282438} :answer-field/id #uuid "543918ac-60ea-556f-87e9-9fe723e51c77" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186284072}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "5a127c57-e392-5180-8b85-86041bead0c2" :question/math-academy-id "q-165038" :question/problem "Given the curve $r(t)=⟨{t}^{5}-8,2{t}^{4}-6⟩,$ $t\\in (0,\\infty )$, find the point at which the tangent to the curve is parallel to the vector $⟨1,\\frac{4}{5}⟩.$" :question/worked-solution "First, we calculate the derivative of $r(t):$\n\n$$\n\\begin{aligned}{r}^{′}(t) & =⟨\\frac{\\text{d}}{\\text{d}t}({t}^{5}-8),\\,\\frac{\\text{d}}{\\text{d}t}(2{t}^{4}-6)⟩ \\\\  & =⟨5{t}^{4},8{t}^{3}⟩\\end{aligned}\n$$\n\nThe vectors ${r}^{′}(t)$ and $⟨1,\\frac{4}{5}⟩$ are parallel for some specific value ${t}_{0}$ of the parameter $t$ if and only if there exists a constant $c$ such that ${r}^{′}({t}_{0})=c⟨1,\\frac{4}{5}⟩.$ So, we have\n\n$$\n\\begin{aligned}{r}^{′}(t) & =c⟨1,\\frac{4}{5}⟩ \\\\ ⟨5{t}^{4},8{t}^{3}⟩ & =c⟨1,\\frac{4}{5}⟩ \\\\ ⟨5{t}^{4},8{t}^{3}⟩ & =⟨c,\\frac{4c}{5}⟩.\\end{aligned}\n$$\n\nEquating the components gives:\n\n$$\n{\\begin{aligned}5{t}^{4}=c \\\\ 8{t}^{3}=\\frac{4c}{5}\\end{aligned}\n$$\n\nFrom the first equation, we obtain that $c=5{t}^{4}.$ Substituting $c=5{t}^{4}$ into the second equation, we get\n\n$$\n\\begin{aligned}8{t}^{3} & =\\frac{4(5{t}^{4})}{5} \\\\ 8{t}^{3}-4{t}^{4} & =0 \\\\ 4{t}^{3}(2-t) & =0.\\end{aligned}\n$$\n\nSince $t\\in (0,\\infty )$, the only solution is $t=2.$ \n\nFinally, since\n\n$$\n\\begin{aligned}r(2) & =⟨(2)^{5}-8,2(2)^{4}-6⟩=⟨24,26⟩,\\end{aligned}\n$$\n\nwe conclude that $⟨1,\\frac{4}{5}⟩$ and ${r}^{′}(t)$ are parallel at the point $(24,26).$"} :step/id #uuid "c80e8392-766a-5d4f-9dc1-c5ef5cb2463f"}] :activity/title "Tangent Vectors and Tangent Lines to Curves" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186410817}] [{:activity/expected-seconds 960.0 :activity/first-step {:db/id #edb/ref 17592186120672} :activity/id #uuid "6ede3e68-1ff6-5e3c-afed-499bb387f9a1" :activity/scope {:db/id #edb/ref 17592186048499 :topic/id #uuid "a4bbeec2-7e3f-58f1-87d1-563d58d73752" :topic/math-academy-id 1851} :activity/steps [{:db/id #edb/ref 17592186120672 :step/content {:db/id #edb/ref 17592186121034 :tutorial/content "Consider a vector $\\mathbf{u}$ which is given in terms of the vectors $\\mathbf{v_1}$ and $\\mathbf{v_2}$ as follows:\n\n$$\n{\\color{red}3}{\\color{blue}\\mathbf{v_1}}+({\\color{red}-2}){\\color{blue}\\mathbf{v_2}} = \\mathbf{u}\n$$\n\nHere, we say that $\\mathbf{u}$ is a **linear combination** of the vectors ${\\color{blue}\\mathbf{v_1}}$ and ${\\color{blue}\\mathbf{v_2}}$ with coefficients ${\\color{red}3}$ and ${\\color{red}-2}$ respectively. \n\nIn general, a linear combination of $n$ vectors $\\mathbf{v_1},\\mathbf{v_2},\\dots,\\mathbf{v_n}$ is the *weighted sum*\n\n$$\n{\\color{red}x_1}\\mathbf{\\color{blue}v_1}+{\\color{red}x_2}\\mathbf{\\color{blue}v_2}+\\cdots + {\\color{red}x_n}\\mathbf{\\color{blue}v_n} = \\mathbf{u},\n$$\n\nwhere ${\\color{red}x_1},{\\color{red}x_2},\\dots,{\\color{red}x_n}\\in\\mathbb{R}.$ We say that $\\mathbf{u}$ is a linear combination of the vectors $\\mathbf{\\color{blue}v_1},\\mathbf{\\color{blue}v_2},\\dots,\\mathbf{\\color{blue}v_n}$ with coefficients (or *weights*) ${\\color{red}x_1},{\\color{red}x_2},\\dots,{\\color{red}x_n},$ respectively.\n\nFor instance, \n![](images/ff/ff71636b9b5a34fec4de37b5e924c1c6bc3765c1ee823b325f5b0e01c0dc472a.svg)\nis the linear combination of vectors $\\mathbf{\\color{blue}v_1},\\mathbf{\\color{blue}v_2},\\mathbf{\\color{blue}v_3}$ with coefficients ${\\color{red}2}, {\\color{red}0}, {\\color{red}\\dfrac{1}{2}},$ respectively." :tutorial/id #uuid "229ae855-226b-5f95-b050-b98257747800" :tutorial/math-academy-id 3186 :tutorial/title "Introduction"} :step/id #uuid "b14c637b-1418-59f5-9ac3-37a07d6ad580" :step/math-academy-id 17456 :step/next {:db/id #edb/ref 17592186120673}} {:db/id #edb/ref 17592186120673 :step/content {:db/id #edb/ref 17592186119805 :knowledge-point/canonical-example {:db/id #edb/ref 17592186119616 :question/id #uuid "fd3cb5b1-f16e-5a52-82e4-25bbbd1c4fe7" :question/math-academy-id "e-4789"} :knowledge-point/id #uuid "33586620-e110-5a37-874f-a92103c5e9fb" :knowledge-point/key-prerequisites [{:db/id #edb/ref 17592186048673} {:db/id #edb/ref 17592186049814}] :knowledge-point/questions [{:db/id #edb/ref 17592186120311} {:db/id #edb/ref 17592186120312} {:db/id #edb/ref 17592186240984} {:db/id #edb/ref 17592186240985} {:db/id #edb/ref 17592186314967} {:db/id #edb/ref 17592186317257} {:db/id #edb/ref 17592186319044} {:db/id #edb/ref 17592186319045} {:db/id #edb/ref 17592186319047} {:db/id #edb/ref 17592186419107}] :knowledge-point/title "Solving for One Coefficient in a Linear Combination"} :step/id #uuid "c7323a52-d0b1-55ea-81f4-41623766b9db" :step/math-academy-id 17458 :step/next {:db/id #edb/ref 17592186120674}} {:db/id #edb/ref 17592186120674 :step/content {:db/id #edb/ref 17592186119806 :knowledge-point/canonical-example {:db/id #edb/ref 17592186119617 :question/id #uuid "548ef945-392b-5e75-9b60-14f4e2de6261" :question/math-academy-id "e-4790"} :knowledge-point/id #uuid "590953b8-2533-5a4b-bf4f-f002b0367919" :knowledge-point/questions [{:db/id #edb/ref 17592186120310} {:db/id #edb/ref 17592186120351} {:db/id #edb/ref 17592186240986} {:db/id #edb/ref 17592186240987} {:db/id #edb/ref 17592186240988} {:db/id #edb/ref 17592186314969} {:db/id #edb/ref 17592186319046} {:db/id #edb/ref 17592186342110} {:db/id #edb/ref 175