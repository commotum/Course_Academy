84f08e7a-96c7-57e5-8318-9498325cc5c0" #edb/ref 17592186045417] [17592186403021 #edb/ref 1080 "$f(-1)$ does not exist" #edb/ref 17592186045417] [17592186403021 #edb/ref 1082 #edb/ref 17592186045499 #edb/ref 17592186045417] [17592186403021 #edb/ref 1083 #uuid "de5ec02c-27a2-5d7d-8fe3-b0875d4201ba" #edb/ref 17592186045417] [17592186403022 #edb/ref 1080 "${lim}_{x\\to -{1}^{+}}f(x)$ does not exist" #edb/ref 17592186045417] [17592186403022 #edb/ref 1082 #edb/ref 17592186045499 #edb/ref 17592186045417] [17592186403022 #edb/ref 1083 #uuid "60166612-0904-52f0-96ae-69b9e3a2f0dd" #edb/ref 17592186045417] [17592186403023 #edb/ref 1080 "{lim}_{x\\to -1}f(x)\\ne f(-1)" #edb/ref 17592186045417] [17592186403023 #edb/ref 1082 #edb/ref 17592186045498 #edb/ref 17592186045417] [17592186403023 #edb/ref 1083 #uuid "3265516b-d79e-586e-a42e-0a19b7a4fb6b" #edb/ref 17592186045417] [17592186403223 #edb/ref 1068 #edb/ref 17592186403224 #edb/ref 17592186045417] [17592186403223 #edb/ref 1069 "q-66005" #edb/ref 17592186045417] [17592186403223 #edb/ref 1070 #edb/ref 17592186045487 #edb/ref 17592186045417] [17592186403223 #edb/ref 1071 "Which of the following equations has no solutions for $0\\le x<2\\pi ?$\n\nI. $4\\operatorname{csc}⁡x+1=\\operatorname{csc}⁡x$\nII. $\\operatorname{csc}⁡x+10=2\\operatorname{csc}⁡x$\nIII. $\\operatorname{csc}⁡x=2\\operatorname{csc}⁡x-6$" #edb/ref 17592186045417] [17592186403223 #edb/ref 1072 #uuid "28fa7313-ebe9-5114-aa43-a48667cbf78a" #edb/ref 17592186045417] [17592186403223 #edb/ref 1074 "We first simplify the given equations, and get\n\n- $\\operatorname{csc}⁡x=-\\frac{1}{3}$\n- $\\operatorname{csc}⁡x=10$\n- $\\operatorname{csc}⁡x=6$\n\nNow, recall that the range of $\\operatorname{csc}⁡x$ for $0\\le x<2\\pi $ is given by\n\n$$\n\\operatorname{csc}⁡x\\in (-\\infty ,-1]\\cup [1,\\infty ).\n$$\n\nSo, the equation $\\operatorname{csc}⁡x=k$ has no solutions for $k\\in (-1,1).$ \n\nTherefore, of the given equations, only equation I has no solutions." #edb/ref 17592186045417] [17592186403224 #edb/ref 1075 #edb/ref 17592186403225 #edb/ref 17592186045417] [17592186403224 #edb/ref 1075 #edb/ref 17592186403226 #edb/ref 17592186045417] [17592186403224 #edb/ref 1075 #edb/ref 17592186403227 #edb/ref 17592186045417] [17592186403224 #edb/ref 1075 #edb/ref 17592186403228 #edb/ref 17592186045417] [17592186403224 #edb/ref 1075 #edb/ref 17592186403229 #edb/ref 17592186045417] [17592186403224 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186403224 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186403224 #edb/ref 1078 #edb/ref 17592186403227 #edb/ref 17592186045417] [17592186403224 #edb/ref 1079 #uuid "8ca79eb9-6a7d-56ad-a7b2-6517a75087f4" #edb/ref 17592186045417] [17592186403225 #edb/ref 1080 "II and III only" #edb/ref 17592186045417] [17592186403225 #edb/ref 1082 #edb/ref 17592186045499 #edb/ref 17592186045417] [17592186403225 #edb/ref 1083 #uuid "36f640cb-1d0e-55cf-82bf-2bc2df4f2cbd" #edb/ref 17592186045417] [17592186403226 #edb/ref 1080 "I and III only" #edb/ref 17592186045417] [17592186403226 #edb/ref 1082 #edb/ref 17592186045499 #edb/ref 17592186045417] [17592186403226 #edb/ref 1083 #uuid "2f4fdfad-f0bb-539a-b3dd-5135ecf4149a" #edb/ref 17592186045417] [17592186403227 #edb/ref 1080 "I only" #edb/ref 17592186045417] [17592186403227 #edb/ref 1082 #edb/ref 17592186045499 #edb/ref 17592186045417] [17592186403227 #edb/ref 1083 #uuid "de09ab34-6244-5de9-adc0-7d2808c13ffa" #edb/ref 17592186045417] [17592186403228 #edb/ref 1080 "III only" #edb/ref 17592186045417] [17592186403228 #edb/ref 1082 #edb/ref 17592186045499 #edb/ref 17592186045417] [17592186403228 #edb/ref 1083 #uuid "a347e69f-18e6-5a4a-896e-70ebdae9cbe6" #edb/ref 17592186045417] [17592186403229 #edb/ref 1080 "II only" #edb/ref 17592186045417] [17592186403229 #edb/ref 1082 #edb/ref 17592186045499 #edb/ref 17592186045417] [17592186403229 #edb/ref 1083 #uuid "87a5d244-0e82-5176-9600-2dd50bb45515" #edb/ref 17592186045417] [17592186403578 #edb/ref 1068 #edb/ref 17592186403579 #edb/ref 17592186045417] [17592186403578 #edb/ref 1069 "q-72491" #edb/ref 17592186045417] [17592186403578 #edb/ref 1070 #edb/ref 17592186045485 #edb/ref 17592186045417] [17592186403578 #edb/ref 1071 "Which of the following matrices are **not** in row echelon form?\n\n$$\nA=[\\begin{aligned}6 & 0 & 3 & 0 \\\\ 0 & 0 & 3 & 1 \\\\ 0 & 0 & 0 & 2 \\\\ 0 & 0 & 6 & 0 \\\\ 0 & 0 & 0 & 0\\end{aligned}],\\,B=[\\begin{aligned}1 & 0 & 5 & 1 & -5 \\\\ 0 & 0 & 2 & 1 & 0 \\\\ 0 & 0 & 0 & 0 & 4\\end{aligned}],\\,C=[\\begin{aligned}5 & 5 & 3 & 4 \\\\ 0 & 1 & 5 & 3 \\\\ 0 & 2 & 2 & 2 \\\\ 0 & 0 & -7 & 4\\end{aligned}].\n$$" #edb/ref 17592186045417] [17592186403578 #edb/ref 1072 #uuid "307a31ed-3320-5bc6-9033-1067b69032de" #edb/ref 17592186045417] [17592186403578 #edb/ref 1074 "Remember that a matrix is in row echelon form if it satisfies the following conditions:\n\n- All the zero rows (rows with only zeros), if any, are placed at the *bottom* of the matrix.\n- Each leading entry of a row is in a column *to the right* of the leading entry of the row above it.\n\nWith that in mind, let's look at each matrix in turn.\n\n- The matrix $A$ is not in row echelon form since the leading entry ${a}_{43}\\ne 0$ (condition II is violated). \n\n$$\nA=[\\begin{aligned}6 & 0 & 3 & 0 \\\\ 0 & 0 & 3 & 1 \\\\ 0 & 0 & 0 & 2 \\\\ 0 & 0 & 6 & 0 \\\\ 0 & 0 & 0 & 0\\end{aligned}]\n$$\n\n- The matrix $B$ is in row echelon form (both conditions are satisfied).\n\n$$\nB=[\\begin{aligned}1 & 0 & 5 & 1 & -5 \\\\ 0 & 0 & 2 & 1 & 0 \\\\ 0 & 0 & 0 & 0 & 4\\end{aligned}]\n$$\n\n- The matrix $C$ is not in row echelon form since the leading entry ${c}_{32}\\ne 0$ (condition II is violated). \n\n$$\nC=[\\begin{aligned}5 & 5 & 3 & 4 \\\\ 0 & 1 & 5 & 3 \\\\ 0 & 2 & 2 & 2 \\\\ 0 & 0 & -7 & 4\\end{aligned}]\n$$\n\nTherefore, only $A$ and $C$ are **not** in row echelon form." #edb/ref 17592186045417] [17592186403579 #edb/ref 1075 #edb/ref 17592186403580 #edb/ref 17592186045417] [17592186403579 #edb/ref 1075 #edb/ref 17592186403581 #edb/ref 17592186045417] [17592186403579 #edb/ref 1075 #edb/ref 17592186403582 #edb/ref 17592186045417] [17592186403579 #edb/ref 1075 #edb/ref 17592186403583 #edb/ref 17592186045417] [17592186403579 #edb/ref 1075 #edb/ref 17592186403584 #edb/ref 17592186045417] [17592186403579 #edb/ref 1076 #edb/ref 17592186045493 #edb/ref 17592186045417] [17592186403579 #edb/ref 1077 "selection" #edb/ref 17592186045417] [17592186403579 #edb/ref 1078 #edb/ref 17592186403580 #edb/ref 17592186045417] [17592186403579 #edb/ref 1079 #uuid "d8c3e5f4-9bc1-505b-a784-0a6ba8cc7e8a" #edb/ref 17592186045417] [17592186403580 #edb/ref 1080 "$A$ and $C$ only" #edb/ref 17592186045417] [17592186403580 #edb/ref 1082 #edb/ref 17592186045499 #edb/ref 17592186045417] [17592186403580 #edb/ref 1083 #uuid "037eeb73-f010-5239-b320-397bc7facb77" #edb/ref 17592186045417] [17592186403581 #edb/ref 1080 "$A$ only" #edb/ref 17592186045417] [17592186403581 #edb/ref 1082 #edb/ref 17592186045499 #edb/ref 17592186045417] [17592186403581 #edb/ref 1083 #uuid "48b44963-1902-5c0d-9522-c534c3678776" #edb/ref 17592186045417] [17592186403582 #edb/ref 1080 "$B$ and $C$ only" #edb/ref 17592186045417] [17592186403582 #edb/ref 1082 #edb/ref 17592186045499 #edb/ref 17592186045417] [17592186403582 #edb/ref 1083 #uuid "0eeb9a23-f447-585f-9585-f82e287918e0" #edb/ref 17592186045417] [17592186403583 #edb/ref 1080 "$A$ and $B$ only" #edb/ref 17592186045417] [17592186403583 #edb/ref 1082 #edb/ref 17592186045499 #edb/ref 17592186045417] [17592186403583 #edb/ref 1083 #uuid "c1989825-0208-5721-8305-7b2993765c83" #edb/ref 17592186045417]}
