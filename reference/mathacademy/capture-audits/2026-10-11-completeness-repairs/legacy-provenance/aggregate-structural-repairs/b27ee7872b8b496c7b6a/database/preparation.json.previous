                "value": "\\frac{6}{7}",
                "option": "1",
                "source_option": "b"
              },
              {
                "type": "math",
                "value": "\\frac{2}{7}",
                "option": "2",
                "source_option": "c"
              },
              {
                "type": "math",
                "value": "\\frac{5}{7}",
                "option": "3",
                "source_option": "d"
              },
              {
                "type": "math",
                "value": "1",
                "option": "4",
                "source_option": "e"
              }
            ],
            "correct_value": "\\frac{5}{7}",
            "value_type": "math",
            "correct_type": "math",
