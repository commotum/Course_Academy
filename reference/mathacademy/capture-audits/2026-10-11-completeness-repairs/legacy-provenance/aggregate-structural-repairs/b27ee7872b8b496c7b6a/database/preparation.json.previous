                "option": "2",
                "source_option": "c"
              },
              {
                "type": "text",
                "value": "I only",
                "option": "3",
                "source_option": "d"
              },
              {
                "type": "text",
                "value": "II and III only",
                "option": "4",
                "source_option": "e"
              }
            ],
            "correct_value": "II and III only",
            "value_type": "text",
            "correct_type": "text",
