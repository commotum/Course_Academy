                "source_option": "a"
              },
              {
                "type": "math",
                "value": "27",
                "option": "1",
                "source_option": "b"
              },
              {
                "type": "math",
                "value": "25.5",
                "option": "2",
                "source_option": "c"
              },
              {
                "type": "math",
                "value": "26",
                "option": "3",
                "source_option": "d"
              },
              {
                "type": "math",
                "value": "26.5",
                "option": "4",
                "source_option": "e"
              }
            ],
            "correct_value": "25.5",
            "value_type": "math",
            "correct_type": "math",
            "evidence": {
