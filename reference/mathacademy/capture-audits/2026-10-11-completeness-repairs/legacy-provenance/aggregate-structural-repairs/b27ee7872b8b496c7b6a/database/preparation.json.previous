              "value": "-5",
              "source_file": "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13962041/state.json",
              "solution_quote": "\\begin{aligned}\\text{Cov}(x,y) & =\\frac{1}{n}{\\sum }_{i=1}^{n}({x}_{i}-\\overset{―}{x})({y}_{i}-\\overset{―}{y}) \\\\  & =\\frac{1}{4}[(4-2)(-7-0)+(-2-2)(5-0)+(5-2)(4-0)+(1-2)(-2-0)] \\\\  & =\\frac{1}{4}[(2)(-7)+(-4)(5)+(3)(4)+(-1)(-2)] \\\\  & =\\frac{1}{4}[-14-20+12+2] \\\\  & =\\frac{1}{4}\\cdot (-20) \\\\  & =-5.\\end{aligned}",
              "matches_worked_solution": true,
              "choice_present": true
            }
          }
        ],
