                "type": "text",
                "value": "II only",
                "option": "1",
                "source_option": "b"
              },
              {
                "type": "text",
                "value": "I and III only",
                "option": "2",
                "source_option": "c"
              },
              {
                "type": "text",
                "value": "III only",
                "option": "3",
                "source_option": "d"
              },
              {
                "type": "text",
