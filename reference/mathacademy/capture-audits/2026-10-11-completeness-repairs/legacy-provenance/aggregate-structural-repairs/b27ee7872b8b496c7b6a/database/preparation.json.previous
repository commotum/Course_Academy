                "type": "math",
                "value": "[\\begin{aligned}2 \\\\ 0 \\\\ 0\\end{aligned}]+y[\\begin{aligned}-7 \\\\ 1 \\\\ 0\\end{aligned}]+z[\\begin{aligned}9 \\\\ 0 \\\\ 1\\end{aligned}],\\,y,z\\in (-\\infty ,\\infty )",
                "option": "4",
