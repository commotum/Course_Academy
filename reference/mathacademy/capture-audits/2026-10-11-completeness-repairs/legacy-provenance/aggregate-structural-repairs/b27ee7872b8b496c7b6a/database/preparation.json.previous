          {
            "path": "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14072804/assets/db4bea7c2f08abb66318443c88a0504bbfdc3d9597b3f42a8808795ebc78b172.png",
            "sha256": "db4bea7c2f08abb66318443c88a0504bbfdc3d9597b3f42a8808795ebc78b172"
