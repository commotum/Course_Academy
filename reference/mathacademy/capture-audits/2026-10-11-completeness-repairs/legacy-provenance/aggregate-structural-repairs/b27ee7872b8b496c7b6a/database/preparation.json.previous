            "correct_value": "[\\begin{aligned}-9 \\\\ 0 \\\\ 0\\end{aligned}]+y[\\begin{aligned}2 \\\\ 1 \\\\ 0\\end{aligned}]+z[\\begin{aligned}-7 \\\\ 0 \\\\ 1\\end{aligned}],\\,y,z\\in (-\\infty ,\\infty )",
            "value_type": "math",
