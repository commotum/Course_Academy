                "source_option": "e"
              }
            ],
            "correct_value": "II only",
            "value_type": "text",
            "correct_type": "text",
            "evidence": {
              "kind": "worked_solution",
              "value": "II only",
              "source_file": "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13933873/state.json",
              "solution_quote": "- Statement I is false. The function $y=tan⁡x$ has asymptotes at $x=\\frac{\\pi }{2}+\\pi n.$\n\n- Statement II is true. The function has period $\\pi .$ So, $tan⁡(x+2n\\pi )=tan⁡(x+n\\pi +n\\pi )=tan⁡(x+n\\pi )=tan⁡(x).$\n\n- Statement III is false. The range of $y=tan⁡x$ is $(-\\infty ,+\\infty ).$",
              "matches_worked_solution": true,
              "choice_present": true
            }
          }
        ],
        "difficulty": "hard",
