                "option": "0",
                "source_option": "a"
              },
              {
                "type": "math",
                "value": "[\\begin{aligned}3 & 4 \\\\ 0 & -1\\end{aligned}][\\begin{aligned}x \\\\ y\\end{aligned}]=[\\begin{aligned}0 \\\\ -3\\end{aligned}]",
                "option": "1",
                "source_option": "b"
              },
              {
