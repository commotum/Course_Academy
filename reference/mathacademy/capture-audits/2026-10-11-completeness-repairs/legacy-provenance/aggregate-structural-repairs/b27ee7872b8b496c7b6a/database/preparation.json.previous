                "source_option": "c"
              },
              {
                "type": "math",
                "value": "[\\begin{aligned}2 & -4 \\\\ 0 & -1\\end{aligned}][\\begin{aligned}x \\\\ y\\end{aligned}]=[\\begin{aligned}-1 \\\\ 4\\end{aligned}]",
