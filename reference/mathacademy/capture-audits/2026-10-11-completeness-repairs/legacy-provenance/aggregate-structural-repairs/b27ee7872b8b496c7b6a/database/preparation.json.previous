              "source_file": "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14069917/state.json",
              "solution_quote": "\\begin{aligned}P(X\\le 5) & =P(X\\in \\{1,2,3,4,5\\}) \\\\  & =f(1)+f(2)+f(3)+f(4)+f(5) \\\\  & =(0.5)^{1-1}(0.5)+(0.5)^{2-1}(0.5)+(0.5)^{3-1}(0.5)+(0.5)^{4-1}(0.5)+(0.5)^{5-1}(0.5) \\\\  & =(0.5)+(0.5)(0.5)+(0.5)^{2}(0.5)+(0.5)^{3}(0.5)+(0.5)^{4}(0.5) \\\\  & =[1+0.5+(0.5)^{2}+(0.5)^{3}+(0.5)^{4}](0.5) \\\\  & ≈0.969\\end{aligned}",
              "matches_worked_solution": true,
