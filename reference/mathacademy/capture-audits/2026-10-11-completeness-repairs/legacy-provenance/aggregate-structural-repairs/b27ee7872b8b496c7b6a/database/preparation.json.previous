              "value": "[\\begin{aligned}-9 \\\\ 0 \\\\ 0\\end{aligned}]+y[\\begin{aligned}2 \\\\ 1 \\\\ 0\\end{aligned}]+z[\\begin{aligned}-7 \\\\ 0 \\\\ 1\\end{aligned}],\\,y,z\\in (-\\infty ,\\infty )",
              "source_file": "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14078399/state.json",
              "solution_quote": "\\begin{aligned}[\\begin{aligned}x \\\\ y \\\\ z\\end{aligned}]=[\\begin{aligned}-9+2y-7z \\\\ y \\\\ z\\end{aligned}]=[\\begin{aligned}-9 \\\\ 0 \\\\ 0\\end{aligned}]+y[\\begin{aligned}2 \\\\ 1 \\\\ 0\\end{aligned}]+z[\\begin{aligned}-7 \\\\ 0 \\\\ 1\\end{aligned}],\\,y,z\\in (-\\infty ,\\infty ).\\end{aligned}",
