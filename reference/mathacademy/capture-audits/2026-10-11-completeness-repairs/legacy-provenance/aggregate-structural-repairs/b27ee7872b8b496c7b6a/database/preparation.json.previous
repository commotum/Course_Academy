                "option": "2",
                "source_option": "c"
              },
              {
                "type": "math",
                "value": "2",
                "option": "3",
                "source_option": "d"
              },
              {
                "type": "math",
                "value": "-3",
                "option": "4",
                "source_option": "e"
              }
            ],
            "correct_value": "2",
            "value_type": "math",
            "correct_type": "math",
            "evidence": {
              "kind": "worked_solution",
              "value": "2",
              "source_file": "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14069078/state.json",
              "solution_quote": "\\begin{aligned}\\text{Cov}(x,y) & =\\frac{1}{n}{\\sum }_{i=1}^{n}({x}_{i}-\\overset{―}{x})({y}_{i}-\\overset{―}{y}) \\\\  & =\\frac{1}{4}[(6-6)(4-9)+(4-6)(7-9)+(8-6)(11-9)+(6-6)(14-9)] \\\\  & =\\frac{1}{4}[(0)(-5)+(-2)(-2)+(2)(2)+(0)(5)] \\\\  & =\\frac{1}{4}[0+4+4+0] \\\\  & =\\frac{1}{4}\\cdot 8 \\\\  & =2.\\end{aligned}",
              "matches_worked_solution": true,
