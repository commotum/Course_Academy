                "value": "$f(-1)$ does not exist",
                "option": "1",
                "source_option": "b"
              },
              {
                "type": "text",
                "value": "${lim}_{x\\to (-1)^{+}}f(x)$ does not exist",
                "option": "2",
                "source_option": "c"
              },
