                "source_option": "a"
              },
              {
                "type": "text",
                "value": "III only",
                "option": "1",
                "source_option": "b"
              },
              {
                "type": "text",
                "value": "II only",
                "option": "2",
                "source_option": "c"
              },
              {
                "type": "text",
                "value": "I only",
                "option": "3",
                "source_option": "d"
              },
              {
                "type": "text",
                "value": "I and II only",
                "option": "4",
