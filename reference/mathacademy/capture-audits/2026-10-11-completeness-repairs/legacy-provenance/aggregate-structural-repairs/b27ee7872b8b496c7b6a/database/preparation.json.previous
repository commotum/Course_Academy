              }
            ],
            "correct_value": "[\\begin{aligned}-8-10{x}_{3} \\\\ 6+6{x}_{3} \\\\ {x}_{3}\\end{aligned}],\\,{x}_{3}\\in (-\\infty ,\\infty )",
            "value_type": "math",
