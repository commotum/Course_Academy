              }
            ],
            "correct_value": "The system $[\\begin{aligned}1 & 1 \\\\ 1 & k\\end{aligned}][\\begin{aligned}x \\\\ y\\end{aligned}]=[\\begin{aligned}0 \\\\ 0\\end{aligned}]$ has the unique zero solution",
            "value_type": "text",
