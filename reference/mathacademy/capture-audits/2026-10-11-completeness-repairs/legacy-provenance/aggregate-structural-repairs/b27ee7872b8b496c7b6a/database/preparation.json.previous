                "type": "math",
                "value": "\\frac{3}{2}",
                "option": "1",
                "source_option": "b"
              },
              {
                "type": "math",
                "value": "2",
                "option": "2",
                "source_option": "c"
              },
              {
                "type": "math",
                "value": "1",
                "option": "3",
                "source_option": "d"
