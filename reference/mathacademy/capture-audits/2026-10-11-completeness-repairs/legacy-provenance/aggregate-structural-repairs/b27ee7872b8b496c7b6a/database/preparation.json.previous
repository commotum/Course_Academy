              "solution_quote": "\\begin{aligned}x & ={A}^{-1}b \\\\  & =\\frac{1}{2}[\\begin{aligned}-3 & -2 \\\\ -2 & -2\\end{aligned}][\\begin{aligned}1 \\\\ -2\\end{aligned}]\\end{aligned}",
              "matches_worked_solution": true,
