              }
            ],
            "correct_value": "[\\begin{aligned}-7z-3 \\\\ 2z+2 \\\\ z\\end{aligned}],\\,z\\in (-\\infty ,\\infty )",
            "value_type": "math",
            "correct_type": "math",
