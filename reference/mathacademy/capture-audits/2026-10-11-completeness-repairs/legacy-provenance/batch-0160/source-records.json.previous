            {
              "type": "math",
              "value": "\\frac{\\text{d}y}{\\text{d}x}+(4\\operatorname{sin}⁡x)y=1+3\\operatorname{cos}⁡x",
              "option": "2",
              "source_option": "c"
            },
            {
              "type": "math",
              "value": "\\frac{\\text{d}y}{\\text{d}x}+\\frac{1+3\\operatorname{cos}⁡x}{2}=(2\\operatorname{sin}⁡x)y",
              "option": "3",
              "source_option": "d"
            },
            {
              "type": "math",
              "value": "\\frac{\\text{d}y}{\\text{d}x}+(4\\operatorname{cos}⁡x)y=1+3\\operatorname{sin}⁡x",
