  {
    "directory": "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13979915",
    "question": {
      "math_academy_id": "q-40081",
      "knowledge_point_id": "5ad95b4e-e367-5e26-800c-1a87a537ca83",
      "knowledge_point": "Finding the Intervals on Which a Trigonometric Function Is Continuous",
      "problem": "The interval $I$ consists of all real numbers $x$ such that $-\\pi \\le x\\le \\pi .$ What is the largest subset of $I$ on which the function $g(x)=\\operatorname{csc}⁡(x)-\\operatorname{cos}⁡(x)$ is continuous?",
      "worked_solution": "Trigonometric functions are continuous at all points in their respective domains.\n\nThe function $\\operatorname{cos}⁡x$ is continuous over the entire interval $[-\\pi ,\\pi ],$ but the function $\\operatorname{csc}⁡x$ is not defined at $x=-\\pi ,0,\\pi .$ \n\nTherefore, the domain of $g(x)$ consists of the union of the intervals $(-\\pi ,0)$ and $(0,\\pi ),$ namely\n\n$$\n(-\\pi ,0)\\cup (0,\\pi )\n$$\n\nand the function is also continuous on this union of intervals.",
      "answer_fields": [
        {
          "key": "selection",
          "type": "radio",
          "choices_complete": true,
          "choices": [
            {
              "type": "math",
              "value": "[-\\pi ,0)",
              "option": "0",
              "source_option": "a"
            },
            {
              "type": "math",
              "value": "[-\\pi ,0)\\cup (0,\\pi ]",
              "option": "1",
              "source_option": "b"
            },
            {
              "type": "math",
              "value": "(-\\pi ,0)\\cup (0,\\pi )",
              "option": "2",
              "source_option": "c"
            },
            {
              "type": "math",
              "value": "(0,\\pi ]",
              "option": "3",
              "source_option": "d"
            },
            {
              "type": "math",
              "value": "(-\\pi ,\\pi )",
              "option": "4",
              "source_option": "e"
            }
          ]
        }
      ],
      "difficulty": "moderate",
      "provenance": {
        "activity_question": "question-40081",
        "kp_title": "Finding the Intervals on Which a Trigonometric Function Is Continuous",
