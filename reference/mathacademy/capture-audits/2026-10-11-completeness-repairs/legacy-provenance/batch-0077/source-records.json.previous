    "question": {
      "math_academy_id": "q-136312",
      "knowledge_point_id": "0118bf72-c730-59f1-b722-85ed779f96c7",
      "knowledge_point": "Calculating the Speed of a Particle Given Its Velocity",
      "problem": "A particle moves with a constant velocity of $u=(i+4j)\\,\\text{km/h}.$ Find the speed of the particle, rounding your answer to two decimal places.",
      "worked_solution": "The speed of a particle equals the magnitude of its velocity.\n\nTherefore, the speed of the particle is\n\n$$\n\\begin{aligned}|u| & =|i+4j| \\\\  & =\\sqrt{{1}^{2}+{4}^{2}} \\\\  & =\\sqrt{1+16} \\\\  & =\\sqrt{17} \\\\  & ≈4.12\\,\\text{km/h}\\end{aligned}\n$$\n\nrounded to two decimal places.",
      "answer_fields": [
        {
          "key": "selection",
          "type": "radio",
          "choices_complete": true,
          "choices": [
            {
              "type": "math",
              "value": "3.18\\,\\text{km/h}",
              "option": "0",
              "source_option": "a"
            },
            {
              "type": "math",
              "value": "2.24\\,\\text{km/h}",
              "option": "1",
              "source_option": "b"
            },
            {
              "type": "math",
              "value": "3.87\\,\\text{km/h}",
              "option": "2",
              "source_option": "c"
            },
            {
              "type": "math",
              "value": "4.12\\,\\text{km/h}",
              "option": "3",
              "source_option": "d"
            },
            {
              "type": "math",
              "value": "4.68\\,\\text{km/h}",
              "option": "4",
