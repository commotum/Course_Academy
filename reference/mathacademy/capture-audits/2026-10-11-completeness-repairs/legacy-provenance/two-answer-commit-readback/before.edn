#{[{:db/id #edb/ref 17592186269103 :knowledge-point/_questions [{:db/id #edb/ref 17592186083306 :knowledge-point/id #uuid "a75b47ec-8d5a-545e-b915-daca92320322" :knowledge-point/title "Identifying Non-Roots of a Polynomial Using the Rational Roots Theorem"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1482f361-3b1e-543f-870b-a26dcf92d2ca" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186266319} {:answer/id #uuid "2870d2f6-a4e4-5d62-a218-0e3e5a8a8827" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186266504} {:answer/id #uuid "447ea00c-4d69-5351-8ae6-7fb524a5e59a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "10" :db/id #edb/ref 17592186266757} {:answer/id #uuid "ab240971-126a-51ed-95e8-caf2152e97e6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{3}" :db/id #edb/ref 17592186267690} {:answer/id #uuid "fda09780-5082-5dc7-9e43-74a04e529440" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186268378}] :answer-field/correct {:answer/id #uuid "447ea00c-4d69-5351-8ae6-7fb524a5e59a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "10" :db/id #edb/ref 17592186266757} :answer-field/id #uuid "466acc84-20e7-58f4-bf70-73eea0fa85ba" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186268526}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "54404730-020a-547b-8cd2-8751476ed4d0" :question/math-academy-id "q-13613" :question/problem "According to the rational roots theorem, which of the following **cannot** be a root of the polynomial $f(x)=3{x}^{3}+10{x}^{2}-23x+10?$" :question/worked-solution "Given a polynomial with integer coefficients, the rational roots theorem states that any rational roots of the polynomial must take the form\n\n$$\n\\pm \\frac{\\text{factor of the constant term}}{\\text{factor of the leading coefficient}}.\n$$\n\nFor the given polynomial $f(x),$ the constant term is $10$ and the leading coefficient is $3.$ So, any rational roots of $f(x)$ must take the form\n\n$$\n\\pm \\frac{\\text{factor of }10}{\\text{factor of }3}.\n$$\n\nOf the given answer choices, only $3$ does not take the above form. The value $3$ can be interpreted as a fraction $\\frac{3}{1},$ and the numerator $(3)$ is not a factor of $10.$"}] [{:db/id #edb/ref 17592186284784 :knowledge-point/_questions [{:db/id #edb/ref 17592186083219 :knowledge-point/id #uuid "74677256-e307-5d49-b7e0-c3f4e79cf818" :knowledge-point/title "Calculating the Number of Ways That N Objects Can Be Arranged"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "08737316-aa20-5df6-851c-dce808b637e9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "120" :db/id #edb/ref 17592186281762} {:answer/id #uuid "18fd45dc-1ede-51cf-9585-369b367a8961" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "25" :db/id #edb/ref 17592186281914} {:answer/id #uuid "82a108e9-b949-5ec3-82d9-001193cc0c6f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "95" :db/id #edb/ref 17592186282820} {:answer/id #uuid "b939e1e9-b6b5-5e42-8a94-194f830d95e7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186283290} {:answer/id #uuid "ea97fa87-edd6-5cc7-984b-14ae7f4f6d7e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "115" :db/id #edb/ref 17592186283739}] :answer-field/correct {:answer/id #uuid "b939e1e9-b6b5-5e42-8a94-194f830d95e7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186283290} :answer-field/id #uuid "6814504a-adfe-5300-8bd4-6599a98f28d0" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186284106}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "53fbad36-9779-558b-839c-131c419555eb" :question/math-academy-id "q-1804" :question/problem "Suppose that $5$ pictures are to be hung from left to right in a hallway. In how many possible ways can they be hung?" :question/worked-solution "There are $n=5$ pictures, so the number of possible arrangements is\n\n$$\n\\begin{aligned}5! & =5\\times 4\\times 3\\times 2\\times 1 \\\\  & =120.\\end{aligned}\n$$\n\nTherefore, there are $120$ ways of arranging the $5$ pictures."}]}
