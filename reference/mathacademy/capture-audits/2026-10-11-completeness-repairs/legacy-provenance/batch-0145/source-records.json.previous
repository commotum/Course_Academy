              "type": "math",
              "value": "{v}_{\\text{max}}=37.5\\,\\text{m}/\\text{s},\\,t=5\\,\\text{s}",
              "option": "0",
              "source_option": "a"
            },
            {
              "type": "math",
              "value": "{v}_{\\text{max}}=75\\,\\text{m}/\\text{s},\\,t=5\\,\\text{s}",
              "option": "1",
              "source_option": "b"
            },
            {
