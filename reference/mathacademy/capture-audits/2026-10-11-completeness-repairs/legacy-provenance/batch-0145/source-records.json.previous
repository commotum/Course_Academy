              "option": "1",
              "source_option": "b"
            },
            {
              "type": "math",
              "value": "y=\\pm 4x",
              "option": "2",
              "source_option": "c"
            },
            {
              "type": "math",
              "value": "y=\\pm 2x",
              "option": "3",
              "source_option": "d"
            },
            {
              "type": "math",
              "value": "y=\\pm \\frac{1}{4}x",
              "option": "4",
              "source_option": "e"
            }
          ]
        }
      ],
