              "type": "text",
              "value": "A rotation of $\\frac{\\pi }{6}$ radians counterclockwise about the origin.",
              "option": "1",
              "source_option": "b"
            },
            {
              "type": "text",
              "value": "A rotation of $\\frac{\\pi }{6}$ radians clockwise about the origin.",
              "option": "2",
              "source_option": "c"
            },
            {
              "type": "text",
              "value": "A rotation of $\\frac{\\pi }{3}$ radians clockwise about the origin.",
              "option": "3",
              "source_option": "d"
            },
            {
              "type": "text",
              "value": "A rotation of $\\frac{\\pi }{3}$ radians counterclockwise about the origin.",
              "option": "4",
