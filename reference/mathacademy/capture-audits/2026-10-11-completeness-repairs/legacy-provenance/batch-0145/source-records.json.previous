              "value": "{v}_{\\text{max}}=38\\,\\text{m}/\\text{s},\\,t=5\\,\\text{s}",
              "option": "2",
              "source_option": "c"
            },
            {
              "type": "math",
              "value": "{v}_{\\text{max}}=24.5\\,\\text{m}/\\text{s},\\,t=2\\,\\text{s}",
              "option": "3",
              "source_option": "d"
            },
            {
              "type": "math",
              "value": "{v}_{\\text{max}}=14\\,\\text{m}/\\text{s},\\,t=1\\,\\text{s}",
