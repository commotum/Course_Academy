              "value": "[\\begin{aligned}x \\\\ y\\end{aligned}]=[\\begin{aligned}1-3y \\\\ y\\end{aligned}],\\,y\\in (-\\infty ,\\infty )",
              "option": "1",
              "source_option": "b"
            },
            {
              "type": "math",
              "value": "[\\begin{aligned}x \\\\ y\\end{aligned}]=[\\begin{aligned}2+3y \\\\ y\\end{aligned}],\\,y\\in (-\\infty ,\\infty )",
              "option": "2",
              "source_option": "c"
            },
            {
              "type": "text",
              "value": "No solution",
