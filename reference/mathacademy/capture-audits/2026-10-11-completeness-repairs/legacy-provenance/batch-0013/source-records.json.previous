    "question": {
      "math_academy_id": "q-7026",
      "knowledge_point_id": "15cd299b-c720-5bf6-814c-2bef2c839e48",
      "knowledge_point": "Finding the Inverse of a Linear Function",
      "problem": "For the function $f(x)$ defined by $f(x)=-4x+5,$ find ${f}^{-1}(x).$",
      "worked_solution": "To find the inverse of a function, we follow these steps:\n\n**Step 1:** Replace $f(x)$ with $y$:\n\n$$\ny=-4x+5\n$$\n\n**Step 2:** Swap $x$ and $y$:\n\n$$\nx=-4y+5\n$$\n\n**Step 3:** Solve for $y$:\n\n$$\n\\begin{aligned}x & =-4y+5 \\\\ 4y & =-x+5 \\\\ y & =\\frac{-x+5}{4}\\end{aligned}\n$$\n\n**Step 4:** Replace $y$ with ${f}^{-1}(x)$:\n\n$$\n{f}^{-1}(x)=\\frac{-x+5}{4}\n$$",
      "answer_fields": [
        {
          "key": "selection",
          "type": "radio",
          "choices": [
            {
              "type": "math",
              "value": "{f}^{-1}(x)=\\frac{-x+3}{2}",
