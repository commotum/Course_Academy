              "value": "4\\cdot |\\begin{aligned}2 & -1 & 4 \\\\ -1 & 2 & 3 \\\\ -3 & -2 & 5\\end{aligned}|-2\\cdot |\\begin{aligned}2 & -1 & 4 \\\\ 3 & 1 & 2 \\\\ -1 & 2 & 3\\end{aligned}|",
              "option": "0",
