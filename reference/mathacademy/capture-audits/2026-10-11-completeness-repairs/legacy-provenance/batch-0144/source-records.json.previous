  {
    "directory": "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14063519",
    "question": {
      "math_academy_id": "q-107075",
      "knowledge_point_id": "68ba4c5d-8b91-57bc-b98b-0e9f8d8f1f67",
      "knowledge_point": "Determining the Vertical Asymptotes for the Sum of Two Rational Functions",
      "problem": "Find the vertical asymptotes of $f(x)=\\frac{5}{2x}+\\frac{3}{4x}.$",
      "worked_solution": "First, let's put the two terms over a common denominator:\n\n$$\n\\begin{aligned}\\frac{5}{2x}+\\frac{3}{4x} & =\\frac{5(2)+3}{4x}=\\frac{13}{4x}\\end{aligned}\n$$\n\nThere are no common factors in the numerator and denominator, so we proceed to set the denominator equal to zero and get\n\n$$\n4x=0\\,⟹\\,x=0.\n$$\n\nTherefore, the vertical asymptotes are at $x=0.$",
      "answer_fields": [
        {
          "key": "selection",
          "type": "radio",
          "choices_complete": true,
          "choices": [
            {
              "type": "math",
              "value": "x=\\frac{1}{2}",
              "option": "0",
              "source_option": "a"
            },
            {
              "type": "text",
              "value": "$x=0$ and $x=1$",
              "option": "1",
              "source_option": "b"
            },
            {
              "type": "text",
              "value": "No vertical asymptotes",
              "option": "2",
              "source_option": "c"
            },
            {
              "type": "math",
              "value": "x=0",
              "option": "3",
              "source_option": "d"
            },
            {
              "type": "math",
              "value": "x=1",
              "option": "4",
              "source_option": "e"
            }
          ]
        }
      ],
      "knowledge_point_source_id": 87,
      "difficulty": "moderate",
      "provenance": {
        "activity_question": "question-107075",
        "kp_title": "Determining the Vertical Asymptotes for the Sum of Two Rational Functions",
        "kp_href": "/topics/1815#87"
      },
      "topic_id": 1815,
