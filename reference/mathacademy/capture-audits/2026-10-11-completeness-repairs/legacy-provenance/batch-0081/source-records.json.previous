              "type": "math",
              "value": "{e}^{2\\pi \\text{i}/7}",
              "option": "1",
              "source_option": "b"
            },
            {
              "type": "math",
              "value": "{e}^{3\\pi \\text{i}/14}",
              "option": "2",
