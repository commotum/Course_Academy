            },
            {
              "type": "math",
              "value": "\\sqrt{8}\\operatorname{cos}⁡(x-\\frac{\\pi }{2})",
              "option": "2",
              "source_option": "c"
            },
            {
              "type": "math",
              "value": "\\sqrt{2}\\operatorname{cos}⁡(8x-\\frac{\\pi }{4})",
              "option": "3",
              "source_option": "d"
