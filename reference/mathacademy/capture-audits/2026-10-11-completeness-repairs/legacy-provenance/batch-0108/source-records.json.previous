        {
          "path": "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14013841/assets/bf79cec9c1ede4a95b3e20415fbf37224ca8616426e8530043fa4a4b54780bab.png",
          "sha256": "bf79cec9c1ede4a95b3e20415fbf37224ca8616426e8530043fa4a4b54780bab"
