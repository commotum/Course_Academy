6412516}] :answer-field/correct {:answer/id #uuid "20f84432-78dc-5a46-a75e-b370d85ffe16" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "even" :db/id #edb/ref 17592186412510} :answer-field/id #uuid "d5fedbdb-836a-5ee4-a0da-26b933ce8c11" :answer-field/key "field-8" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186412622} {:answer-field/choices [{:answer/id #uuid "27fb4a02-a55b-590c-8dd5-f511d2fd12c6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "even" :db/id #edb/ref 17592186412511} {:answer/id #uuid "e1a2be26-815c-5129-8dd4-0a0e224f9c9a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "odd" :db/id #edb/ref 17592186412581}] :answer-field/correct {:answer/id #uuid "27fb4a02-a55b-590c-8dd5-f511d2fd12c6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "even" :db/id #edb/ref 17592186412511} :answer-field/id #uuid "f28e58e2-4175-5117-9b69-4f36deb6b8ca" :answer-field/key "field-4" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186412627}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "7927d3cc-3f03-52c6-bf05-98c129843c5c" :question/math-academy-id "q-221701" :question/problem "Disprove the following statement:\n\n$5n+2$ is odd for any $n\\in Z.$\n\nTo {{field-1}} a universal statement, it's sufficient to find a {{field-2}}. \nIn other words, we need to show that {{field-3}} \n$5n+2$ is {{field-4}}.\n\nNotice that by substituting $n=$ {{field-5}} into the expression, we obtain\n\n$$\n\\begin{aligned}5n+2 & =5({{field-6}})+2 \\\\  & ={{field-7}}\\end{aligned}\n$$\n\nwhich is {{field-8}}. \n\nSo, $n=$ {{field-9}} is our counterexample. Therefore, the given statement is false." :question/worked-solution "Our statement can be written as\n\n$$\n∀n\\in Z,\\,5n+2\\text{ is odd}.\n$$\n\nWe want to disprove this statement. In other words, we must show that its negation is true:\n\n$$\n¬(∀n\\in Z,\\,5n+2\\text{ is odd})\\,≡\\,∃n\\in Z,\\,5n+2\\text{ is even}\n$$\n\nSo, we begin as follows:\n\nTo disprove a universal statement, it's sufficient to find a counterexample. In other words, we need to show that there exists an integer $n$ such that $5n+2$ is even.\n\nFinding a counterexample is sometimes a nontrivial task, but we only need one. In this case, substituting $n=0$ suffices:\n\nNotice that by substituting $n=0$ into the expression, we obtain\n\n$$\n\\begin{aligned}5n+2 & =5(0)+2 \\\\  & =2\\end{aligned}\n$$\n\nwhich is even. \n\nFinally, we state our conclusion:\n\nSo, $n=0$ is our counterexample. Therefore, the given statement is false."}] [{:db/id #edb/ref 17592186412631 :knowledge-point/_questions [{:db/id #edb/ref 17592186171930 :knowledge-point/id #uuid "8fffe685-2f1e-5f0c-ab6a-db5786f40143" :knowledge-point/title "Disproving Parity and Divisibility Statements"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "14636d7c-818e-5692-8f6f-3fb7e7a22eb1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "not divisible" :db/id #edb/ref 17592186412503} {:answer/id #uuid "2ea91716-687e-5920-b491-b99a0e733edf" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "divisible" :db/id #edb/ref 17592186412515}] :answer-field/correct {:answer/id #uuid "14636d7c-818e-5692-8f6f-3fb7e7a22eb1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "not divisible" :db/id #edb/ref 17592186412503} :answer-field/id #uuid "1cfb41f4-65b1-590a-a841-7a4aea9b39fd" :answer-field/key "field-8" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186412597} {:answer-field/choices [{:answer/id #uuid "5b6b7348-a1ae-5619-8f5e-48488f993fe4" :answe