\infty ,0]=0.\n$$"}] [{:db/id #edb/ref 17592186198800 :knowledge-point/_questions [{:db/id #edb/ref 17592186198307 :knowledge-point/id #uuid "8f45befc-412b-58aa-8901-d10e63858b52" :knowledge-point/title "Explaining the Existence of a Maximum or Minimum"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7fad1521-dfbd-5265-982c-7b7c157f9ce2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-100<-99" :db/id #edb/ref 17592186406725} {:answer/id #uuid "e1876dca-da76-5eea-91b7-83af53c9a541" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-98>-99" :db/id #edb/ref 17592186406738}] :answer-field/correct {:answer/id #uuid "7fad1521-dfbd-5265-982c-7b7c157f9ce2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-100<-99" :db/id #edb/ref 17592186406725} :answer-field/id #uuid "99039e60-7de1-5d9d-b8f4-2651c775bf65" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186406747} {:answer-field/choices [{:answer/id #uuid "106308fa-5eec-5b5e-9112-5046f7d48c2d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-98\\in S" :db/id #edb/ref 17592186406716} {:answer/id #uuid "526f7123-1cb1-5222-8fbb-b07e7a7830b4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-98\\notin S" :db/id #edb/ref 17592186406720} {:answer/id #uuid "7b679ef8-3836-516f-bb46-5750bdb78d1d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-100\\in S" :db/id #edb/ref 17592186406723} {:answer/id #uuid "7c4ec8f4-07b7-5fea-87ce-69a2fb045c4c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-100\\notin S" :db/id #edb/ref 17592186406724}] :answer-field/correct {:answer/id #uuid "7b679ef8-3836-516f-bb46-5750bdb78d1d" :answer/type {:db/id #edb/ref 1