"3da542b6-6241-507b-b5cf-4407cf246f06" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186407459} {:answer-field/choices [{:answer/id #uuid "31f0f491-34b1-5530-a024-3825e4b3d982" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2=8k" :db/id #edb/ref 17592186407358} {:answer/id #uuid "71e37387-8240-5416-b926-95f8a7fdddbb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8=2k" :db/id #edb/ref 17592186407383}] :answer-field/correct {:answer/id #uuid "71e37387-8240-5416-b926-95f8a7fdddbb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8=2k" :db/id #edb/ref 17592186407383} :answer-field/id #uuid "5bf59a80-d7ae-5e3b-8dc2-84bf3d16481f" :answer-field/key "field-3" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186407465}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "1062095b-125d-5701-81d9-4b57bb308f4f" :question/math-academy-id "q-221899" :question/problem "Select the correct options in the reasoning below.\n\nThe notation $2∣8$ means {{field-1}}. It is equivalent to the statement that there exists {{field-2}} $k$ such that {{field-3}}." :question/worked-solution "The notation $a∣b$ means $a$ divides $b.$ So, $2∣8$ means $2\\text{ divides }8.$\n\nAccording to the definition of integer divisibility, the fact that $a$ divides $b$ means that there exists an integer $k$ such that \n\n$$\nb=ak.\n$$\n\n \n\nTherefore, $2∣8$ is equivalent to the statement that there exists $\\text{an integer}$ $k$ such that $8=2k.$"}] [{:db/id #edb/ref 17592186407504 :knowledge-point/_questions [{:db/id #edb/ref 17592186161917 :knowledge-point/id #uuid "d0e960a4-872c-55c0-8439-60426671f5cf" :knowledge-point/title "Stating the Definition of Integer Divisibility"}] :