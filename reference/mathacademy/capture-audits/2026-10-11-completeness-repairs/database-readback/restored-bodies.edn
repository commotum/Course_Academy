09530} :answer-field/id #uuid "5ea8a2d7-9fc6-5058-876a-d88758ec7e84" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186409534} {:answer-field/choices [{:answer/id #uuid "785be389-2c7e-5e32-bac1-d9b8c6fc0bda" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "n" :db/id #edb/ref 17592186409520} {:answer/id #uuid "7b1b243b-3cfe-5281-a9ad-388d6c710076" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{n}^{2}-6n+8" :db/id #edb/ref 17592186409521}] :answer-field/correct {:answer/id #uuid "7b1b243b-3cfe-5281-a9ad-388d6c710076" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{n}^{2}-6n+8" :db/id #edb/ref 17592186409521} :answer-field/id #uuid "e15076e4-97d2-5f65-acea-378081c4d44a" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186409536}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "22d71c4d-b3cd-5679-8624-1ff129268ef3" :question/math-academy-id "q-185001" :question/problem "Consider the following false statement.\n\n${n}^{2}-6n+8\\ge 0$ for any $n\\in N.$\n\nA counterexample for the above statement would be an integer $n$ such that \n\n$$\n{{field-1}}{{field-2}}{{field-3}}.\n$$" :question/worked-solution "Our statement can be written as\n\n$$\n∀n\\in Z,\\,{n}^{2}-6n+8\\ge 0.\n$$\n\nSince this statement is false, its negation is true. \n\nA *counterexample* is a particular case that disproves the statement. Equivalently, it's a case that proves the negation is true. \n\nThe negation of our statement is\n\n$$\n¬(∀n\\in Z,\\,{n}^{2}-6n+8\\ge 0)\\,≡\\,∃n\\in Z,\\,{n}^{2}-6n+8<0.\n$$\n\nTherefore, we have the following:\n\nA counterexample for the above statement would be an integer $n$ such that \n\n$$\n{n}^{2}-6n+8<0.\n$$"}] [{:db/id #edb/ref 17592186409537 :knowledge-point/_questions [{:db/id #edb/ref 17592186171929 :knowledge-point/id #uuid "18ffc9f1-9524-50c2-8ae8-e01236f453b4" :knowledge-point/title "Stating Counterexample Conditions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "84993c3c-9066-53b6-92d8-9f77ef13102d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "n" :db/id #edb/ref 17592186409522} {:answer/id #uuid "d8205af2-6ecd-55f3-8489-17a62e4ae515" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "9n-4" :db/id #edb/ref 17592186409526}] :answer-field/correct {:answer/id #uuid "d8205af2-6ecd-55f3-8489-17a62e4ae515" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "9n-4" :db/id #edb/ref 17592186409526} :answer-field/id #uuid "3aa78bb9-b187-5d4c-8bbf-7bbaca9dd68f" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186409532} {:answer-field/choices [{:answer/id #uuid "46255983-63bd-5575-a696-22f606d6b1dd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "9n-4" :db/id #edb/ref 17592186409517} {:answer/id #uuid "f669ffe5-88ca-5b07-91ce-5e49a9167938" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "n" :db/id #edb/ref 17592186409529}] :answer-field/correct {:answer/id #uuid "f669ffe5-88ca-5b07-91ce-5e49a9167938" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "n" :db/id #edb/ref 17592186409529} :answer-field/id #uuid "543c8dd4-cd46-5d7b-b872-28f5e756c28c" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186409533} {:answer-field/choices [{:answer/id #uuid "045b7395-71a2-554c-828d-fd5ca75abab2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "even" :db/id #edb/ref 17592186409516} {:answer/id #uuid "cfbbb7fe-3550-5cd8-9e28-5b776f3b0385" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "odd" :db/id #edb/ref 17592186409525}] :answer-field/correct {:answer/id #uuid "cfbbb7fe-3550-5cd8-9e28-5b776f3b0385" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "odd" :db/id #edb/ref 17592186409525} :answer-field/id #uuid "af4dda1c-b105-5306-9c38-4d8775dc52b2" :answer-field/key "field-3" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186409535}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "e3db273a-c488-5a82-8422-fe1e9221beaa" :question/math-academy-id "q-221691" :question/problem "Consider the following false statement.\n\n$9n-4$ is even for any $n\\in Z$\n\nA counterexample for this statement would be an integer {{field-1}} such that {{field-2}} is {{field-3}}." :question/worked-solution "Our statement can be written as\n\n$$\n∀n\\in Z,\\,9n-4\\text{ is even}.\n$$\n\nSince this statement is false, its negation is true. \n\nA *counterexample* is a particular case that disproves the statement. Equivalently, it's a case that proves the negation is true. \n\nThe negation of our statement is\n\n$$\n¬(∀n\\in Z,\\,9n-4\\text{ is even})\\,≡\\,∃n\\in Z,\\,9n-4\\text{ is odd}.\n$$\n\nTherefore, we have the following:\n\nA counterexample for the above statement would be an integer $n$ such that $9n-4$ is $\\text{odd}.$"}] [{:db/id #edb/ref 17592186412630 :knowledge-point/_questions [{:db/id #edb/ref 17592186171930 :knowledge-point/id #uuid "8fffe685-2f1e-5f0c-ab6a-db5786f40143" :knowledge-point/title "Disproving Parity and Divisibility Statements"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "11bd9aea-6dd5-5da7-b922-5b80f9878937" :answer/type {:db/id #edb/ref 1759218604549