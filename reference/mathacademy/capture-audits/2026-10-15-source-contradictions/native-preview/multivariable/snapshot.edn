c-5309-b97f-14fd566c17b5" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "-2x^{2}+x+11" :db/id 17592186533391} :answer-field/id #uuid "8d713dab-487c-57b4-848a-8f859a772276" :answer-field/key "field-1" :answer-field/type {:db/id 17592186045492 :db/ident :answer-field.type/blank} :db/id 17592186533887}] :question/difficulty {:db/id 17592186045486 :db/ident :question.difficulty/hard} :question/problem "Given that $y=\\frac{(x-2)^{5}}{{e}^{{x}^{2}+3x}},$ find ${y}^{′}.$\n\n${y}^{′}=\\frac{(x-2)^{4}}{{e}^{{x}^{2}+3x}}[$\n{{field-1}}$]$" :question/worked-solution "We have the function \n\n$$\ny=\\frac{(x-2)^{5}}{{e}^{{x}^{2}+3x}}.\n$$\n\nFirst, we find the natural logarithm of both sides and use the quotient and power rules for logarithms:\n\n$$\n\\begin{aligned}\\operatorname{ln}⁡y & =\\operatorname{ln}⁡(\\frac{(x-2)^{5}}{{e}^{{x}^{2}+3x}}) \\\\ \\operatorname{ln}⁡y & =\\operatorname{ln}⁡((x-2)^{5})-\\operatorname{ln}⁡({e}^{{x}^{2}+3x}) \\\\ \\operatorname{ln}⁡y & =5\\operatorname{ln}⁡(x-2)-({x}^{2}+3x)\\end{aligned}\n$$\n\nNext, we differentiate both sides with respect to $x:$\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}(\\operatorname{ln}⁡y) & =\\frac{\\text{d}}{\\text{d}x}(5\\operatorname{ln}⁡(x-2)-({x}^{2}+3x)) \\\\ \\frac{1}{y}\\cdot {y}^{′} & =5\\cdot \\frac{1}{x-2}-(2x+3) \\\\ \\frac{{y}^{′}}{y} & =\\frac{5}{x-2}-(2x+3)\\end{aligned}\n$$\n\nNow, we solve for ${y}^{′}:$\n\n$$\n\\begin{aligned}{y}^{′} & =y[\\frac{5}{x-2}-(2x+3)]\\end{aligned}\n$$\n\nFinally, we substitute $y=\\frac{(x-2)^{5}}{{e}^{{x}^{2}+3x}}:$\n\n$$\n\\begin{aligned}{y}^{′} & =\\frac{(x-2)^{5}}{{e}^{{x}^{2}+3x}}[\\frac{5}{x-2}-(2x+3)] \\\\  & =\\frac{(x-2)^{5}}{{e}^{{x}^{2}+3x}}[\\frac{5-(x-2)(2x+3)}{x-2}] \\\\  & =\\frac{(x-2)^{4}}{{e}^{{x}^{2}+3x}}[5-(x-2)(2x+3)] \\\\  & =\\frac{(x-2)^{4}}{{e}^{{x}^{2}+3x}}[5-(2{x}^{2}-x-6)] \\\\  & =\\frac{(x-2)^{4}}{{e}^{{x}^{2}+3x}}[11+x-2{x}^{2}]\\end{aligned}\n$$"} {:db/id 17592186534079 :question/id #uuid "deb7ada4-14d9-5457-acd5-ef77477a4e36" :question/math-academy-id "q-138832" :knowledge-point/_questions [{:db/id 17592186064310 :knowledge-point/id #uuid "71dd9228-4b05-54d9-aeb2-3bdabf89e0e9" :knowledge-point/title "Differentiating a Quotient"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2f947482-c2c6-568d-82f0-29af6bfba254" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "2{x}^{4}+8{x}^{3}+x+5" :db/id 17592186533253} {:answer/id #uuid "3e350aae-2cd2-5f81-8e5d-74dec200744b" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "{x}^{4}+8{x}^{3}+x+5" :db/id 17592186533284} {:answer/id #uuid "67b07a11-17f0-5c4c-a4ca-8e59d532b7ae" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "2{x}^{4}+16{x}^{3}+x+5" :db/id 17592186533382} {:answer/id #uuid "89588797-26b1-5b42-8b21-2029da27dbba" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "{x}^{4}+16{x}^{3}+2x+8" :db/id 17592186533468} {:answer/id #uuid "b35826d5-c07d-51fb-931e-4b0d6ab4dd47" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "2{x}^{4}+16{x}^{3}+2x+8" :db/id 17592186533574}] :answer-field/correct {:answer/id #uuid "67b07a11-17f0-5c4c-a4ca-8e59d532b7ae" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "2{x}^{4}+16{x}^{3}+x+5" :db/id 17592186533382} :answer-field/id #uuid "0d94c7c1-de0e-5fb5-af87-71126c21e380" :answer-field/key "selection" :answer-field/type {:db/id 17592186045493 :db/ident :answer-field.type/radio} :db/id 17592186533784}] :question/difficulty {:db/id 17592186045486 :db/ident :question.difficulty/hard} :question/problem "Consider the function $y=\\frac{{e}^{{x}^{4}+2x}}{(x+8)^{6}}.$  The derivative of this function is given by\n\n$$\n{y}^{′}=\\frac{2{e}^{{x}^{4}+2x}g(x)}{(x+8)^{7}}.\n$$\n\nFind the function $g(x).$" :question/worked-solution "We have the function \n\n$$\ny=\\frac{{e}^{{x}^{4}+2x}}{(x+8)^{6}}.\n$$\n\nFirst, we take the natural logarithm of both sides and use the quotient and power rules for logarithms:\n\n$$\n\\begin{aligned}\\operatorname{ln}⁡y & =\\operatorname{ln}⁡(\\frac{{e}^{{x}^{4}+2x}}{(x+8)^{6}}) \\\\ \\operatorname{ln}⁡y & =\\operatorname{ln}⁡({e}^{{x}^{4}+2x})-\\operatorname{ln}⁡((x+8)^{6}) \\\\ \\operatorname{ln}⁡y & ={x}^{4}+2x-6\\operatorname{ln}⁡(x+8)\\end{aligned}\n$$\n\nNext, we differentiate both sides with respect to $x:$\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}(\\operatorname{ln}⁡y) & =\\frac{\\text{d}}{\\text{d}x}({x}^{4}+2x-6\\operatorname{ln}⁡(x+8)) \\\\ \\frac{1}{y}\\cdot {y}^{′} & =4{x}^{3}+2-6\\cdot \\frac{1}{x+8} \\\\ \\frac{{y}^{′}}{y} & =4{x}^{3}+2-\\frac{6}{x+8}\\end{aligned}\n$$\n\nNow, we solve for ${y}^{′}:$\n\n$$\n\\begin{aligned}{y}^{′} & =y(4{x}^{3}+2-\\frac{6}{x+8})\\end{aligned}\n$$\n\nFinally, we substitute $y=\\frac{{e}^{{x}^{4}+2x}}{(x+8)^{6}}:$ \n\n$$\n\\begin{aligned}{y}^{′} & =\\frac{{e}^{{x}^{4}+2x}}{(x+8)^{6}}(4{x}^{3}+2-\\frac{6}{x+8}) \\\\  & =\\frac{{e}^{{x}^{4}+2x}}{(x+8)^{6}}(\\frac{(4{x}^{3}+2)(x+8)-6}{x+8}) \\\\  & =\\frac{{e}^{{x}^{4}+2x}}{(x+8)^{7}}((4{x}^{3}+2)(x+8)-6) \\\\  & =\\frac{{e}^{{x}^{4}+2x}}{(x+8)^{7}}(4{x}^{4}+32{x}^{3}+2x+16-6) \\\\  & =\\frac{2{e}^{{x}^{4}+2x}(2{x}^{4}+16{x}^{3}+x+5)}{(x+8)^{7}}\\end{aligned}\n$$\n\n \n\nTherefore,\n\n$$\ng(x)=2{x}^{4}+16{x}^{3}+x+5.\n$$"} {:db/id 17592186534090 :question/id #uuid "f3859b1c-a23b-517a-bfe5-a836f749be10" :question/math-academy-id "q-138834" :knowledge-point/_questions [{:db/id 17592186064310 :knowledge-point/id #uuid "71dd9228-4b05-54d9-aeb2-3bdabf89e0e9" :knowledge-point/title "Differentiating a Quotient"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "42e00fa1-2d53-53c2-91c2-dbaf97414222" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "17{x}^{2}-6{x}^{3}+15" :db/id 17592186533296} {:answer/id #uuid "84e65e07-d407-5744-b09c-1d7419c5f733" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "15{x}^{2}-3{x}^{3}+15" :db/id 17592186533452} {:answer/id #uuid "949b2307-7470-54c1-a231-4a7923ae08c1" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "15{x}^{2}+3{x}^{3}+15" :db/id 17592186533499} {:answer/id #uuid "9f5538e4-cb5c-53d2-8282-324285197339" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "17{x}^{2}+3{x}^{3}+15" :db/id 17592186533525} {:answer/id #uuid "cffa59f6-f8b3-5069-84a6-83cd2e84beae" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "5{x}^{2}-6{x}^{3}+15" :db/id 17592186533646}] :answer-field/correct {:answer/id #uuid "42e00fa1-2d53-53c2-91c2-dbaf97414222" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "17{x}^{2}-6{x}^{3}+15" :db/id 17592186533296} :answer-field/id #uuid "f81d8766-b273-5742-81e1-135f6f4971d0" :answer-field/key "selection" :answer-field/type {:db/id 17592186045493 :db/ident :answer-field.type/radio} :db/id 17592186533963}] :question/difficulty {:db/id 17592186045486 :db/ident :question.difficulty/hard} :question/problem "Consider the function $y=\\frac{({x}^{2}+1)^{x}}{(1-3x)^{5}}.$ The derivative of this function is given by\n\n$$\n{y}^{′}=\\frac{({x}^{2}+1)^{x-1}}{(1-3x)^{6}}g(x)+\\frac{({x}^{2}+1)^{x}}{(1-3x)^{5}}\\operatorname{ln}⁡({x}^{2}+1).\n$$\n\nFind the function $g(x).$" :question/worked-solution "We have the function \n\n$$\ny=\\frac{({x}^{2}+1)^{x}}{(1-3x)^{5}}.\n$$\n\nFirst, we find the natural logarithm of both sides and use the quotient and power rules for logarithms:\n\n$$\n\\begin{aligned}\\operatorname{ln}⁡y & =\\operatorname{ln}⁡(\\frac{({x}^{2}+1)^{x}}{(1-3x)^{5}}) \\\\ \\operatorname{ln}⁡y & =\\operatorname{ln}⁡(({x}^{2}+1)^{x})-\\operatorname{ln}⁡((1-3x)^{5}) \\\\ \\operatorname{ln}⁡y & =x\\operatorname{ln}⁡({x}^{2}+1)-5\\operatorname{ln}⁡(1-3x)\\end{aligned}\n$$\n\nNext, we differentiate both sides with respect to $x:$\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}(\\operatorname{ln}⁡y) & =\\frac{\\text{d}}{\\text{d}x}(x\\operatorname{ln}⁡({x}^{2}+1)-5\\operatorname{ln}⁡(1-3x)) \\\\ \\frac{1}{y}\\cdot {y}^{′} & =\\operatorname{ln}⁡({x}^{2}+1)+x\\cdot \\frac{1}{{x}^{2}+1}\\cdot (2x)-5\\cdot \\frac{1}{1-3x}\\cdot (-3) \\\\ \\frac{{y}^{′}}{y} & =\\operatorname{ln}⁡({x}^{2}+1)+\\frac{2{x}^{2}}{{x}^{2}+1}+\\frac{15}{1-3x}\\end{aligned}\n$$\n\nNow, we solve for ${y}^{′}:$ \n\n$$\n\\begin{aligned}{y}^{′} & =y(\\operatorname{ln}⁡({x}^{2}+1)+\\frac{2{x}^{2}}{{x}^{2}+1}+\\frac{15}{1-3x})\\end{aligned}\n$$\n\nFinally, we substitute $y=\\frac{({x}^{2}+1)^{x}}{(1-3x)^{5}}:$\n\n$$\n\\begin{aligned}{y}^{′} & =\\frac{({x}^{2}+1)^{x}}{(1-3x)^{5}}(\\operatorname{ln}⁡({x}^{2}+1)+\\frac{2{x}^{2}}{{x}^{2}+1}+\\frac{15}{1-3x}) \\\\  & =\\frac{({x}^{2}+1)^{x}}{(1-3x)^{5}}(\\frac{2{x}^{2}}{{x}^{2}+1}+\\frac{15}{1-3x})+\\frac{({x}^{2}+1)^{x}}{(1-3x)^{5}}\\operatorname{ln}⁡({x}^{2}+1) \\\\  & =\\frac{({x}^{2}+1)^{x}}{(1-3x)^{5}}(\\frac{2{x}^{2}(1-3x)+15({x}^{2}+1)}{({x}^{2}+1)(1-3x)})+\\frac{({x}^{2}+1)^{x}}{(1-3x)^{5}}\\operatorname{ln}⁡({x}^{2}+1) \\\\  & =\\frac{({x}^{2}+1)^{x}}{(1-3x)^{5}}(\\frac{17{x}^{2}-6{x}^{3}+15}{({x}^{2}+1)(1-3x)})+\\frac{({x}^{2}+1)^{x}}{(1-3x)^{5}}\\operatorname{ln}⁡({x}^{2}+1) \\\\  & =\\frac{({x}^{2}+1)^{x-1}}{(1-3x)^{6}}(17{x}^{2}-6{x}^{3}+15)+\\frac{({x}^{2}+1)^{x}}{(1-3x)^{5}}\\operatorname{ln}⁡({x}^{2}+1)\\end{aligned}\n$$\n\nTherefore,\n\n$$\ng(x)=17{x}^{2}-6{x}^{3}+15.\n$$"} {:db/id 17592186064311 :knowledge-point/canonical-example {:db/id 17592186064148 :question/id #uuid "e0cec84d-96cf-5fed-ba05-a5cfc57841a1" :question/math-academy-id "e-9847"} :knowledge-point/id #uuid "c6005f9a-3eba-5f8d-909d-894d9cd24d12" :knowledge-point/key-prerequisites [{:db/id 17592186050208} {:db/id 17592186050496} {:db/id 17592186050887} {:db/id 17592186050894}] :knowledge-point/questions [{:db/id 17592186064652 :question/id #uuid "27e870f5-3e1e-55e7-9174-58f13ed02354" :question/math-academy-id "q-2536"} {:db/i