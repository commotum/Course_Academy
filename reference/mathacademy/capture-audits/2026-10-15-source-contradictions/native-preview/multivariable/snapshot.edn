742aa98a2b" :question/math-academy-id "q-138849"} {:db/id 17592186506582 :question/id #uuid "bc8a78e5-ffc8-5ad6-abfc-11fb82c73f1a" :question/math-academy-id "q-138865"} {:db/id 17592186534067 :question/id #uuid "cc13fb5c-5303-5c81-bafe-333779ced9ca" :question/math-academy-id "q-138854" :knowledge-point/_questions [{:db/id 17592186064311 :knowledge-point/id #uuid "c6005f9a-3eba-5f8d-909d-894d9cd24d12" :knowledge-point/title "Differentiating a Radical Expression"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1c61cfcf-a787-550b-810a-38a9ae04f7fe" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "2x-6" :db/id 17592186533208} {:answer/id #uuid "9411358e-dbc0-567a-a1c3-e8fae0dff5ca" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "3x" :db/id 17592186533497} {:answer/id #uuid "96e9100a-3748-5dd5-ad4e-9a90375f9d8f" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "6x" :db/id 17592186533508} {:answer/id #uuid "c744d1de-7757-5a26-ac48-bc584e98ec52" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "6x+6" :db/id 17592186533617} {:answer/id #uuid "d6c60272-837e-5905-b5bf-1a14841fc162" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "3x-3" :db/id 17592186533662}] :answer-field/correct {:answer/id #uuid "96e9100a-3748-5dd5-ad4e-9a90375f9d8f" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "6x" :db/id 17592186533508} :answer-field/id #uuid "52f2bc75-08e1-5592-986f-bf5ac47ce09a" :answer-field/key "selection" :answer-field/type {:db/id 17592186045493 :db/ident :answer-field.type/radio} :db/id 17592186533847}] :question/difficulty {:db/id 17592186045486 :db/ident :question.difficulty/hard} :question/problem "Consider the function $y=\\sqrt{\\frac{({x}^{2}+4)^{3}}{\\operatorname{sin}⁡x}}.$ The derivative of this function is given by\n\n$$\n{y}^{′}=\\frac{1}{2}(g(x)-({x}^{2}+4)\\operatorname{cot}⁡x)\\sqrt{({x}^{2}+4)\\operatorname{csc}⁡x}.\n$$\n\nFind the function $g(x).$" :question/worked-solution "Our function can be written as\n\n$$\n\\begin{aligned}y & =\\sqrt{\\frac{({x}^{2}+4)^{3}}{\\operatorname{sin}⁡x}} \\\\  & =\\frac{\\sqrt{({x}^{2}+4)^{3}}}{\\sqrt{\\operatorname{sin}⁡x}} \\\\  & =\\frac{({x}^{2}+4)^{3/2}}{(\\operatorname{sin}⁡x)^{1/2}}.\\end{aligned}\n$$\n\nFirst, we take the natural logarithm of both sides and use the quotient and power rules for logarithms:\n\n$$\n\\begin{aligned}\\operatorname{ln}⁡y & =\\operatorname{ln}⁡(\\frac{({x}^{2}+4)^{3/2}}{(\\operatorname{sin}⁡x)^{1/2}}) \\\\ \\operatorname{ln}⁡y & =\\operatorname{ln}⁡(({x}^{2}+4)^{3/2})-\\operatorname{ln}⁡((\\operatorname{sin}⁡x)^{1/2}) \\\\ \\operatorname{ln}⁡y & =\\frac{3}{2}\\operatorname{ln}⁡({x}^{2}+4)-\\frac{1}{2}\\operatorname{ln}⁡(\\operatorname{sin}⁡x)\\end{aligned}\n$$\n\nNext, we differentiate both sides with respect to $x:$\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}(\\operatorname{ln}⁡y) & =\\frac{\\text{d}}{\\text{d}x}(\\frac{3}{2}\\operatorname{ln}⁡({x}^{2}+4)-\\frac{1}{2}\\operatorname{ln}⁡(\\operatorname{sin}⁡x)) \\\\ \\frac{1}{y}\\cdot {y}^{′} & =\\frac{3}{2}\\cdot \\frac{1}{{x}^{2}+4}\\cdot 2x-\\frac{1}{2}\\cdot \\frac{1}{\\operatorname{sin}⁡x}\\cdot \\operatorname{cos}⁡x \\\\ \\frac{{y}^{′}}{y} & =\\frac{3x}{{x}^{2}+4}-\\frac{\\operatorname{cot}⁡x}{2}\\end{aligned}\n$$\n\n \n\nNow, we solve for ${y}^{′}:$\n\n$$\n\\begin{aligned}{y}^{′} & =y(\\frac{3x}{{x}^{2}+4}-\\frac{\\operatorname{cot}⁡x}{2})\\end{aligned}\n$$\n\nFinally, we substitute $y=\\sqrt{\\frac{({x}^{2}+4)^{3}}{\\operatorname{sin}⁡x}}:$\n\n$$\n\\begin{aligned}{y}^{′} & =\\sqrt{\\frac{({x}^{2}+4)^{3}}{\\operatorname{sin}⁡x}}(\\frac{3x}{{x}^{2}+4}-\\frac{\\operatorname{cot}⁡x}{2}) \\\\  & =\\sqrt{\\frac{({x}^{2}+4)^{3}}{\\operatorname{sin}⁡x}}(\\frac{6x-({x}^{2}+4)\\operatorname{cot}⁡x}{2({x}^{2}+4)}) \\\\  & =\\sqrt{\\frac{{x}^{2}+4}{\\operatorname{sin}⁡x}}(\\frac{6x-({x}^{2}+4)\\operatorname{cot}⁡x}{2}) \\\\  & =\\frac{1}{2}(6x-({x}^{2}+4)\\operatorname{cot}⁡x)\\sqrt{({x}^{2}+4)\\operatorname{csc}⁡x}\\end{aligned}\n$$\n\n \n\nTherefore,\n\n$$\ng(x)=6x.\n$$"} {:answer-field/choices [{:answer/id #uuid "2f947482-c2c6-568d-82f0-29af6bfba254" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "2{x}^{4}+8{x}^{3}+x+5" :db/id 17592186533253} {:answer/id #uuid "3e350aae-2cd2-5f81-8e5d-74dec200744b" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "{x}^{4}+8{x}^{3}+x+5" :db/id 17592186533284} {:answer/id #uuid "67b07a11-17f0-5c4c-a4ca-8e59d532b7ae" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "2{x}^{4}+16{x}^{3}+x+5" :db/id 17592186533382} {:answer/id #uuid "89588797-26b1-5b42-8b21-2029da27dbba" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "{x}^{4}+16{x}^{3}+2x+8" :db/id 17592186533468} {:answer/id #uuid "b35826d5-c07d-51fb-931e-4b0d6ab4dd47" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "2{x}^{4}+16{x}^{3}+2x+8" :db/id 17592186533574}] :answer-field/correct {:answer/id #uuid "67b07a11-17f0-5c4c-a4ca-8e59d532b7ae" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "2{x}^{4}+16{x}^{3}+x+5" :db/id 17592186533382} :answer-field/id #uuid "0d94c7c1-de0e-5fb5-af87-71126c21e380" :answer-field/key "selection" :answer-field/type {:db/id 17592186045493 :db/ident :answer-field.type/radio} :db/id 17592186533784} {:answer/id #uuid "2f947482-c2c6-568d-82f0-29af6bfba254" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "2{x}^{4}+8{x}^{3}+x+5" :db/id 17592186533253} {:db/id 17592186045498 :db/ident :answer.type/math} {:answer/id #uuid "3e350aae-2cd2-5f81-8e5d-74dec200744b" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "{x}^{4}+8{x}^{3}+x+5" :db/id 17592186533284} {:answer/id #uuid "67b07a11-17f0-5c4c-a4ca-8e59d532b7ae" :ans