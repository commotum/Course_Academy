r/value "\\frac{1}{4}" :db/id 17592186313922} {:db/id 17592186526142 :step/content {:db/id 17592186526085 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3b761040-6bc5-5857-9c79-db2a13d27611" :answer/type {:db/id 17592186045499} :answer/value "are not orthogonal" :db/id 17592186525349} {:answer/id #uuid "edaa6194-fdee-5a52-85e0-2ed9f495bf4a" :answer/type {:db/id 17592186045499} :answer/value "are orthogonal" :db/id 17592186525797}] :answer-field/correct {:db/id 17592186525797} :answer-field/id #uuid "55543445-1727-5019-a16d-94fb1228f51e" :answer-field/key "field-2" :answer-field/type {:db/id 17592186045494} :db/id 17592186525890} {:answer-field/choices [{:answer/id #uuid "0c5912f1-7503-5114-bd94-c09318d2aa64" :answer/type {:db/id 17592186045498} :answer/value "-1" :db/id 17592186525231} {:answer/id #uuid "bf39a84a-5b39-5bb5-8f67-5b65a043baf3" :answer/type {:db/id 17592186045498} :answer/value "\\pi " :db/id 17592186525695} {:answer/id #uuid "ed84a8fc-5d46-52dc-beb9-dfab6973e8cd" :answer/type {:db/id 17592186045498} :answer/value "1" :db/id 17592186525796} {:answer/id #uuid "fea342fe-4c4d-5c10-87ec-9f65ac0a4202" :answer/type {:db/id 17592186045498} :answer/value "0" :db/id 17592186525840}] :answer-field/correct {:db/id 17592186525840} :answer-field/id #uuid "f22a4739-c628-52a9-ae16-699a277e6c24" :answer-field/key "field-1" :answer-field/type {:db/id 17592186045494} :db/id 17592186525971}] :question/difficulty {:db/id 17592186045485} :question/id #uuid "d85f2141-c945-5a8d-a74b-f86923a41441" :question/math-academy-id "q-340668" :question/problem "$$\n⟨f(x),g(x)⟩={\\int }_{-\\pi }^{\\pi }f(x)g(x)\\,\\text{d}x\n$$\n\nGiven the inner product on the set of continuous functions over $x\\in [-\\pi ,\\pi ]$ defined above, select the correct options below.\n\n$\\,$\n$⟨\\operatorname{cos}⁡(5x),1⟩=$ \n{{field-1}}\n\n$\\,$\nThe functions $f(x)=\\operatorname{cos}⁡(5x)$ and $g(x)=1$ \n{{field-2}}." :question/worked-solution "Evaluating the inner product, we obtain\n\n$$\n\\begin{aligned}⟨\\operatorname{cos}⁡(5x),1⟩ & ={\\int }_{-\\pi }^{\\pi }\\operatorname{cos}⁡(5x)\\,\\text{d}x \\\\  & ={[\\frac{1}{5}\\operatorname{sin}⁡(5x)]}_{-\\pi }^{\\pi } \\\\  & =\\frac{1}{5}(\\operatorname{sin}⁡(5\\pi )-\\operatorname{sin}⁡(-5\\pi )) \\\\  & =\\frac{1}{5}(0-0) \\\\  & =0.\\end{aligned}\n$$\n\nTherefore, $f(x)=\\operatorname{cos}⁡(5x)$ and $g(x)=1$ $\\text{are orthogonal}$ with respect to the inner product."} :step/id #uuid "c775e9dd-c091-5db8-8cc4-86b9ae65888c" :step/next {:db/id 17592186526146}} {:db/id 17592186526146 :step/content {:db/id 17592186315082 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "067f1f01-946a-508e-8cd3-212922a30cb6" :answer/type {:db/id 17592186045498} :answer/value "\\frac{1}{2}" :db/id 17592186312018} {:answer/id #uuid "1c9ff7e5-36fe-5003-9799-45faaef030fe" :answer/type {:db/id 17592186045498} :answer/value "\\frac{1}{2\\pi }" :db/id 17592186312189} {:answer/id #uuid "7a6042f8-3d6d-5360-9b00-ffce5586d196" :answer/type {:db/id 17592186045498} :answer/value "\\frac{2}{\\pi }" :db/id 17592186312954} {:answer/id #uuid "9d043cac-3ffa-5f03-90e2-e0c96f5392e5" :answer/type {:db/id 17592186045498} :answer/value "\\frac{1}{\\pi }" :db/id 17592186313218} {:answer/id #uuid "e3d8c3cb-4ca0-5236-8d59-7a3088019974" :answer/type {:db/id 17592186045498} :answer/value "\\frac{\\pi }{2}" :db/id 17592186313774}] :answer-field/correct {:db/id 17592186313218} :answer-field/id #uuid "47c8bc7b-4cd5-5227-9be1-4358ff24b62e" :answer-field/key "field-2" :answer-field/type {:db/id 17592186045494} :db/id 17592186314211} {:answer-field/choices [{:answer/id #uuid "5ffdb817-1342-5108-9142-29c41b65bfb6" :answer/type {:db/id 17592186045498} :answer/value "{\\int }_{0}^{\\infty }({x}^{3}-2{x}^{2})\\,\\text{d}x" :db/id 17592186312744} {:answer/id #uuid "65761c3a-2090-56c5-acc5-a7f5ae659917" :answer/type {:db/id 17592186045498} :answer/value "{\\int }_{-\\pi }^{\\pi }({x}^{3}-2{x}^{2})\\,\\text{d}x" :db/id 17592186312774} {:answer/id #uuid "821891c1-b858-5bda-9626-34240d7900c4" :answer/type {:db/id 17592186045498} :answer/value "{\\int }_{0}^{2\\pi }({x}^{3}-2{x}^{2})\\operatorname{cos}⁡(x)\\,\\text{d}x" :db/id 17592186313023} {:answer/id #uuid "832cde4d-8aee-5316-8503-fd0c2df797ea" :answer/type {:db/id 17592186045498} :answer/value "{\\int }_{0}^{2\\pi }({x}^{3}-2{x}^{2})\\operatorname{sin}⁡(x)\\,\\text{d}x" :db/id 17592186313031} {:answer/id #uuid "f1ae89cc-5e23-5a8d-aa64-bd8dbd7a3313" :answer/type {:db/id 17592186045498} :answer/value "{\\int }_{0}^{2\\pi }({x}^{3}-2{x}^{2})\\,\\text{d}x" :db/id 17592186313912}] :answer-field/correct {:db/id 17592186313912} :answer-field/id #uuid "82f86a36-0a17-52e0-b0d0-d33c3e50f91e" :answer-field/key "field-3" :answer-field/type {:db/id 17592186045494} :db/id 17592186314358} {:answer-field/choices [{:answer/id #uuid "0ec31f7d-80af-523d-b38f-294b8ad028bb" :answer/type {:db/id 17592186045498} :answer/value "\\frac{⟨1,1⟩}{⟨f(x),1⟩}" :db/id 17592186312081} {:answer/id #uuid "0f14e142-4150-51d0-8ede-ebf4f1bd28f2" :answer/type {:db/id 17592186045498} :answer/value "\\frac{⟨f(x),\\operatorname{sin}⁡(x)⟩}{⟨\\operatorname{sin}⁡(x),\\operatorname{sin}⁡(x)⟩}" :db/id 17592186312085} {:answer/id #uuid "114b3cdc-ae09-538f-94d9-f5c3e4392e2b" :answer/type {:db/id 17592186045498} :answer/value "\\frac{2⟨f(x),1⟩}{⟨1,1⟩}" :db/id 17592186312098} {:answer/id #uuid "992303bc-e624-5324-b23d-d78df9b645e2" :answer/type {:db/id 17592186045498} :answer/value "\\frac{⟨f(x),\\operatorname{cos}⁡(x)⟩}{⟨\\operatorname{cos}⁡(x),\\operatorname{cos}⁡(x)⟩}" :db/id 17592186313189} {:answer/id #uuid "dd23267e-19c8-5ea7-b897-d3089e3d52ca" :answer/type {:db/id 17592186045498} :answer/value "\\frac{⟨f(x),1⟩}{⟨1,1⟩}" :db/id 17592186313714}] :answer-field/correct {:db/id 17592186312098} :answer-field/id #uuid "c0b3226d-31b8-5280-8683-73d653641be2" :answer-field/key "field-1" :answer-field/type {:db/id 17592186045494} :db/id 17592186314547}] :question/difficulty {:db/id 17592186045485} :question/id #uuid "a5448f9e-c9df-59b5-abdc-33e558c56456" :question/math-academy-id "q-341309" :question/problem "Let $F(x)={x}^{3}-2{x}^{2}$ for $x\\in R,$ and let $f(x)$ be the $2\\pi $-periodic extension of $F$ from $x\\in [0,2\\pi )$ to $x\\in R.$ The Fourier series of $f$ is given by\n\n$$\nf(x)∼\\frac{{a}_{0}}{2}+{\\sum }_{n=1}^{\\infty }({a}_{n}\\operatorname{cos}⁡(nx)+{b}_{n}\\operatorname{sin}⁡(nx)).\n$$\n\nSelect the correct options in the expression for the coefficient ${a}_{0}$ below, where $⟨\\,,⟩$ denotes the usual inner product on functions over $[0,2\\pi ).$\n\n$$\n\\begin{aligned}{a}_{0} & ={{field-1}} \\\\  & ={{field-2}}\\,\\cdot \\,{{field-3}}\\end{aligned}\n$$" :question/worked-solution "The usual inner product of functions $f$ and $g$ over $x\\in [0,2\\pi )$ is given by\n\n$$\n⟨f(x),g(x)⟩={\\int }_{0}^{2\\pi }f(x)g(x)\\,\\text{d}x.\n$$\n\nFor a $2\\pi $-periodic function $f(x)$ that's piecewise continuous over $x\\in [0,2\\pi ),$ the Fourier series of $f$ is given by \n\n$$\nf(x)∼\\frac{{a}_{0}}{2}+{\\sum }_{n=1}^{\\infty }({a}_{n}\\operatorname{cos}⁡(nx)+{b}_{n}\\operatorname{sin}⁡(nx)),\n$$\n\nwhere ${a}_{0},$ ${a}_{n},$ and ${b}_{n}$ are constants to be determined. \n\nNow, we find the inner product of $f(x)$ with $1:$\n\n$$\n\\begin{aligned}⟨f(x),1⟩ & = \\\\ ⟨\\frac{{a}_{0}}{2}+{\\sum }_{n=1}^{\\infty }({a}_{n}\\operatorname{cos}⁡(nx)+{b}_{n}\\operatorname{sin}⁡(nx)),1⟩ & = \\\\ ⟨\\frac{{a}_{0}}{2},1⟩+{\\sum }_{n=1}^{\\infty }⟨{a}_{n}\\operatorname{cos}⁡(nx),1⟩+{\\sum }_{n=1}^{\\infty }⟨{b}_{n}\\operatorname{sin}⁡(nx),1⟩ & = \\\\ \\frac{{a}_{0}}{2}⟨1,1⟩+{\\sum }_{n=1}^{\\infty }{a}_{n}⟨\\operatorname{cos}⁡(nx),1⟩+{\\sum }_{n=1}^{\\infty }{b}_{n}⟨\\operatorname{sin}⁡(nx),1⟩\\end{aligned}\n$$\n\nSince the functions\n$1,\\operatorname{sin}⁡(x),\\operatorname{cos}⁡(x),\\operatorname{sin}⁡(2x),\\operatorname{cos}⁡(2x),…$\nare orthogonal with respect to the defined inner product, the only nonzero term in the final expression above is\n\n$$\n\\frac{{a}_{0}}{2}⟨1,1⟩.\n$$\n\nComputing the inner product, we have\n\n$$\n\\begin{aligned}⟨1,1⟩ & ={\\int }_{0}^{2\\pi }1\\,\\text{d}x \\\\  & ={[x]}_{0}^{2\\pi } \\\\  & =2\\pi .\\end{aligned}\n$$\n\nFinally, we obtain that\n\n$$\n\\begin{aligned}⟨f(x),1⟩ & =\\frac{{a}_{0}}{2}⟨1,1⟩ \\\\ {a}_{0} & =\\frac{2⟨f(x),1⟩}{⟨1,1⟩} \\\\ {a}_{0} & =\\frac{1}{\\pi }{\\int }_{0}^{2\\pi }f(x)\\,\\text{d}x \\\\  & =\\frac{1}{\\pi }\\cdot {\\int }_{0}^{2\\pi }({x}^{3}-2{x}^{2})\\,\\text{d}x.\\end{aligned}\n$$"} :step/id #uuid "e117ceb3-8a58-58f9-8d3a-2b451769283b"} {:answer-field/choices [{:answer/id #uuid "067f1f01-946a-508e-8cd3-212922a30cb6" :answer/type {:db/id 17592186045498} :answer/value "\\frac{1}{2}" :db/id 17592186312018} {:answer/id #uuid "1c9ff7e5-36fe-5003-9799-45faaef030fe" :answer/type {:db/id 17592186045498} :answer/value "\\frac{1}{2\\pi }" :db/id 17592186312189} {:answer/id #uuid "7a6042f8-3d6d-5360-9b00-ffce5586d196" :answer/type {:db/id 17592186045498} :answer/value "\\frac{2}{\\pi }" :db/id 17592186312954} {:answer/id #uuid "9d043cac-3ffa-5f03-90e2-e0c96f5392e5" :answer/type {:db/id 17592186045498} :answer/value "\\frac{1}{\\pi }" :db/id 17592186313218} {:answer/id #uuid "e3d8c3cb-4ca0-5236-8d59-7a3088019974" :answer/type {:db/id 17592186045498} :answer/value "\\frac{\\pi }{2}" :db/id 17592186313774}] :answer-field/correct {:db/id 17592186313218} :answer-field/id #uuid "47c8bc7b-4cd5-5227-9be1-4358ff24b62e" :answer-field/key "field-2" :answer-field/type {:db/id 17592186045494} :db/id 17592186314211} {:answer/id #uuid "067f1f01-946a-508e-8cd3-212922a30cb6" :answer/type {:db/id 17592186045498} :answer/value "\\frac{1}{2}" :db/id 17592186312018} {:answer/id #uuid "1c9ff7e5-36fe-5003-9799-45faaef030fe" :answer/type {:db/id 17592186045498} :answer/value "\\frac{1}{2\\pi }" :db/id 17592186312189} {:answer/id #uuid "7a6042f8-3d6d-5360-9b00-ffce5586d196" :answer/type {:db/id 17592186045498} :answer/value "\\frac{2}{\\pi }" :db/id 17592186312954} {:answer/id #uuid "9d043cac