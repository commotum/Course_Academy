948-5e9f-9176-a7c91f104c4c" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "are orthogonal" :db/id 17592186413358} :answer-field/id #uuid "db85f0d1-90c6-55e8-8218-c8897868d5ec" :answer-field/key "field-2" :answer-field/type {:db/id 17592186045494 :db/ident :answer-field.type/select} :db/id 17592186413391}] :question/difficulty {:db/id 17592186045486 :db/ident :question.difficulty/hard} :question/problem "$$\n⟨f(x),g(x)⟩={\\int }_{-\\pi }^{\\pi }f(x)g(x)\\,\\text{d}x\n$$\n\nGiven the inner product on the set of continuous functions over $x\\in [-\\pi ,\\pi )$ defined above, select the correct options below.\n\n$\\,$\n$⟨\\operatorname{sin}⁡(2x),\\operatorname{cos}⁡(5x)⟩=$\n{{field-1}}\n\n$\\,$\nThe functions $f(x)=\\operatorname{sin}⁡(2x)$ and $g(x)=\\operatorname{cos}⁡(5x)$ \n{{field-2}}." :question/worked-solution "We begin by using the product-to-sum identity\n\n$$\n\\operatorname{sin}⁡(2x)\\operatorname{cos}⁡(5x)=\\frac{1}{2}(\\operatorname{sin}⁡(7x)-\\operatorname{sin}⁡(3x)).\n$$\n\nSubstituting this into the integral gives\n\n$$\n\\begin{aligned}⟨\\operatorname{sin}⁡(2x),\\operatorname{cos}⁡(5x)⟩ & ={\\int }_{-\\pi }^{\\pi }\\operatorname{sin}⁡(2x)\\operatorname{cos}⁡(5x)\\,\\text{d}x \\\\  & ={\\int }_{-\\pi }^{\\pi }\\frac{1}{2}\\operatorname{sin}⁡(7x)-\\frac{1}{2}\\operatorname{sin}⁡(3x)\\,\\text{d}x \\\\  & ={[-\\frac{1}{14}\\operatorname{cos}⁡(7x)+\\frac{1}{6}\\operatorname{cos}⁡(3x)]}_{-\\pi }^{\\pi } \\\\  & =-\\frac{1}{14}(\\operatorname{cos}⁡(7\\pi )-\\operatorname{cos}⁡(-7\\pi ))+\\frac{1}{6}(\\operatorname{cos}⁡(3\\pi )-\\operatorname{cos}⁡(-3\\pi )) \\\\  & =-\\frac{1}{14}(-1-(-1))+\\frac{1}{6}(-1-(-1)) \\\\  & =0.\\end{aligned}\n$$\n\nTherefore, $f(x)=\\operatorname{sin}⁡(2x)$ and $g(x)=\\operatorname{cos}⁡(5x)$ $\\text{are orthogonal}$ with respect to the inner product."} {:db/id 17592186526085 :question/id #uuid "d85f2141-c945-5a8d-a74b-f86923a41441" :question/math-academy-id "q-340668" :knowledge-point/_questions [{:db/id 17592186166963 :knowledge-point/id #uuid "fadf4f64-3569-56b2-98e1-f6681892054a" :knowledge-point/title "Checking Orthogonality of Sines and Cosines"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3b761040-6bc5-5857-9c79-db2a13d27611" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "are not orthogonal" :db/id 17592186525349} {:answer/id #uuid "edaa6194-fdee-5a52-85e0-2ed9f495bf4a" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "are orthogonal" :db/id 17592186525797}] :answer-field/correct {:answer/id #uuid "edaa6194-fdee-5a52-85e0-2ed9f495bf4a" :answer/type {:db/id 17592186045499 :db/ident :answer.type/text} :answer/value "are orthogonal" :db/id 17592186525797} :answer-field/id #uuid "55543445-1727-5019-a16d-94fb1228f51e" :answer-field/key "field-2" :answer-field/type {:db/id 17592186045494 :db/ident :answer-field.type/select} :db/id 17592186525890} {:answer-field/choices [{:answer/id #uuid "0c5912f1-7503-5114-bd94-c09318d2aa64" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id 17592186525231} {:answer/id #uuid "bf39a84a-5b39-5bb5-8f67-5b65a043baf3" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "\\pi " :db/id 17592186525695} {:answer/id #uuid "ed84a8fc-5d46-52dc-beb9-dfab6973e8cd" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id 17592186525796} {:answer/id #uuid "fea342fe-4c4d-5c10-87ec-9f65ac0a4202" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id 17592186525840}] :answer-field/correct {:answer/id #uuid "fea342fe-4c4d-5c10-87ec-9f65ac0a4202" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id 17592186525840} :answer-field/id #uuid "f22a4739-c628-52a9-ae16-699a277e6c24" :answer-field/key "field-1" :answer-field/type {:db/id 17592186045494 :db/ident :answer-field.type/select} :db/id 17592186525971}] :question/difficulty {:db/id 17592186045485 :db/ident :question.difficulty/easy} :question/problem "$$\n⟨f(x),g(x)⟩={\\int }_{-\\pi }^{\\pi }f(x)g(x)\\,\\text{d}x\n$$\n\nGiven the inner product on the set of continuous functions over $x\\in [-\\pi ,\\pi ]$ defined above, select the correct options below.\n\n$\\,$\n$⟨\\operatorname{cos}⁡(5x),1⟩=$ \n{{field-1}}\n\n$\\,$\nThe functions $f(x)=\\operatorname{cos}⁡(5x)$ and $g(x)=1$ \n{{field-2}}." :question/worked-solution "Evaluating the inner product, we obtain\n\n$$\n\\begin{aligned}⟨\\operatorname{cos}⁡(5x),1⟩ & ={\\int }_{-\\pi }^{\\pi }\\operatorname{cos}⁡(5x)\\,\\text{d}x \\\\  & ={[\\frac{1}{5}\\operatorname{sin}⁡(5x)]}_{-\\pi }^{\\pi } \\\\  & =\\frac{1}{5}(\\operatorname{sin}⁡(5\\pi )-\\operatorname{sin}⁡(-5\\pi )) \\\\  & =\\frac{1}{5}(0-0) \\\\  & =0.\\end{aligned}\n$$\n\nTherefore, $f(x)=\\operatorname{cos}⁡(5x)$ and $g(x)=1$ $\\text{are orthogonal}$ with respect to the inner product."} {:db/id 17592186166964 :knowledge-point/canonical-example {:db/id 17592186166564 :question/id #uuid "d2127a8e-14bb-5574-a542-852333fe4cca" :question/math-academy-id "e-21789"} :knowledge-point/id #uuid "304c015d-cbb6-5989-a102-d6f0f5f38604" :knowledge-point/key-prerequisites [{:db/id 17592186048169} {:db/id 17592186050841}] :knowledge-point/questions [{:db/id 17592186167282 :question/id #uuid "aa20d8e3-c4d9-5112-bd9c-ec30f6aaa6fe" :question/math-academy-id "q-340418"} {:db/id 17592186167291 :question/id #uuid "5082df1a-d560-5493-a305-43900a17419a" :question/math-academy-id "q-341306"} {:db/id 17592186314985 :question/id #uuid "189f6686-0cc6-5c02-8e21-1097f02fd5af" :question/math-academy-id "q-340628"} {:db/id 17592186314987 :question/id #uuid "0dea1a3b-78f2-5704-9965-e3fb9de63bfa" :question/math-academy-id "q-340647"} {:db/id 17592186314988 :question/id #uuid "b8b54f2c-8781-54b8-a107-16250836e9fb" :question/math-academy-id "q-340648"} {:db/id 17592186314989 :question/id #uuid "c36e0e36-a227-5df1-b273-538c9f56de6b" :question/math-academy-id "q-340652"} {:db/id 17592186314991 :question/id #uuid "dc60bc57-5b9c-5f88-9bc5-5ecffd1981e9" :question/math-academy-id "q-340662"} {:db/id 17592186315082 :question/id #uuid "a5448f9e-c9df-59b5-abdc-33e558c56456" :question/math-academy-id "q-341309"} {:db/id 17592186397418 :question/id #uuid "df849e8a-df1b-5b2f-bbc1-5b6e2ad9aeb2" :question/math-academy-id "q-340638"} {:db/id 17592186397438 :question/id #uuid "13f82e1b-2f3e-536a-8bb2-1fc6ddf6b76a" :question/math-academy-id "q-340645"} {:db/id 17592186397539 :question/id #uuid "73b220ad-78ed-5227-b775-ed2065f7b0fd" :question/math-academy-id "q-341308"} {:db/id 17592186547996 :question/id #uuid "3db32c22-3de8-5264-9b28-9916a3aeb5f2" :question/math-academy-id "q-340659"} {:db/id 17592186548063 :question/id #uuid "dc02bcc8-5f0f-5f17-99b3-d1e75d3135c1" :question/math-academy-id "q-340658"}] :knowledge-point/title "Determining Expressions For Fourier Coefficients"} {:db/id 17592186166564 :question/id #uuid "d2127a8e-14bb-5574-a542-852333fe4cca" :question/math-academy-id "e-21789" :knowledge-point/_canonical-example [{:db/id 17592186166964 :knowledge-point/id #uuid "304c015d-cbb6-5989-a102-d6f0f5f38604" :knowledge-point/title "Determining Expressions For Fourier Coefficients"}] :question/problem "Let $F(x) = 2x^2+5$ for $x\\in\\mathbb R,$ and let $f(x)$ be the $2\\pi$-periodic extension of $F$ from $x\\in [0,2\\pi)$ to $x\\in \\mathbb R.$ The Fourier series of $f$ is given by\n\n$$\nf(x) \\sim \\dfrac{a_0}{2} + \\sum_{n=1}^\\infty \\left(a_n \\cos(nx) + b_n \\sin(nx)\\right).\n$$\n\nDetermine the integral expression for the coefficient $a_4.$" :question/worked-solution "The usual inner product of functions $f$ and $g$ over $x\\in [0,2\\pi)$ is given by\n\n$$\n\\langle f(x),g(x) \\rangle = \\int_{0}^{2\\pi} f(x)g(x)\\,\\textrm{d}x.\n$$\n\nFor a $2\\pi$-periodic function $f(x)$ that is piecewise continuous over $x\\in [0,2\\pi),$ the Fourier series of $f$ is given by \n\n$$\nf(x) \\sim \\dfrac{a_0}{2}+\\sum_{n=1}^{\\infty}\\left( a_n\\cos(nx)+b_n\\sin(nx)\\right),\n$$\n\nwhere $a_0,$ $a_n,$ and $b_n$ are constants to be determined. \n\nNow, we find the inner product of $f(x)$ with $\\cos(4x){:}$\n\n$$\n\\begin{aligned}⟨f(x),\\operatorname{cos}⁡(4x)⟩ & = \\\\ ⟨\\frac{{a}_{0}}{2}+{\\sum }_{n=1}^{\\infty }({a}_{n}\\operatorname{cos}⁡(nx)+{b}_{n}\\operatorname{sin}⁡(nx)),\\operatorname{cos}⁡(4x)⟩ & = \\\\ ⟨\\frac{{a}_{0}}{2},\\operatorname{cos}⁡(4x)⟩+{\\sum }_{n=1}^{\\infty }⟨{a}_{n}\\operatorname{cos}⁡(nx),\\operatorname{cos}⁡(4x)⟩+{\\sum }_{n=1}^{\\infty }⟨{b}_{n}\\operatorname{sin}⁡(nx),\\operatorname{cos}⁡(4x)⟩ & = \\\\ \\frac{{a}_{0}}{2}⟨1,\\operatorname{cos}⁡(4x)⟩+{\\sum }_{n=1}^{\\infty }{a}_{n}⟨\\operatorname{cos}⁡(nx),\\operatorname{cos}⁡(4x)⟩+{\\sum }_{n=1}^{\\infty }{b}_{n}⟨\\operatorname{sin}⁡(nx),\\operatorname{cos}⁡(4x)⟩\\end{aligned}\n$$\n\nSince the functions\n$1, \\sin(x), \\cos(x), \\sin(2x), \\cos(2x), \\ldots$\nare orthogonal with respect to the defined inner product, the only nonzero term in the final expression above is\n\n$$\na_4 \\left\\langle \\cos(4x), \\cos(4x) \\right\\rangle.\n$$\n\nComputing the inner product, we have\n\n$$\n\\begin{aligned}⟨\\operatorname{cos}⁡(4x),\\operatorname{cos}⁡(4x)⟩ & ={\\int }_{0}^{2\\pi }{cos}^{2}⁡(4x)\\,\\text{d}x \\\\  & ={\\int }_{0}^{2\\pi }\\frac{1}{2}+\\frac{1}{2}\\operatorname{cos}⁡(8x)\\,\\text{d}x \\\\  & ={[\\frac{1}{2}x+\\frac{1}{16}\\operatorname{sin}⁡(8x)]}_{0}^{2\\pi } \\\\  & =\\frac{1}{2}(2\\pi -0)-\\frac{1}{16}(\\operatorname{sin}⁡(16\\pi )-\\operatorname{sin}⁡(0)) \\\\  & =\\pi .\\end{aligned}\n$$\n\nFinally, we obtain that\n\n$$\n\\begin{aligned}⟨f(x),\\operatorname{cos}⁡(4x)⟩ & ={a}_{4}⟨\\operatorname{cos}⁡(4x),\\operatorname{cos}⁡(4x)⟩ \\\\ {a}_{4} & =\\frac{⟨f(x),\\operatorname{cos}⁡(4x)⟩}{⟨\\operatorname{cos}⁡(4x),\\operatorname{cos}⁡(4x)⟩} \\\\ {a}_{4} & =\\frac{1}{\\pi }{\\int }_{0}^{2\\pi }f(x)\\operatorname{cos}⁡(4x)\\,\\text{d}x \\\\  & =\\frac{1}{\\pi }\\cdot {\\int }_{0}^{2\\pi }(2{x}^{2}+5)\\operatorname{cos}⁡(4x)\\,\\text{d}x.\\end{aligned}\n$$"} {:db/id 17592186048169} {:db/id 17592186050841} {:db/id 17592186167282 :question/id #uuid "aa20d8e3-c4d9-5112-bd9c-ec30f6aaa6fe" :question/math-academy-id "q-340418"} {:db/id 17592186167291 :question/id #uuid "5082df1a-d560-5493-a305-43900a17419a" :question/math-academy-id "q-341306" :knowledge-point/_questions [{:db/id 17592186166964 :knowledge-point/id #uuid "304c015d-cbb6-5989-a102-d6f0f5f38604" :knowledge-point/title "Determining Expressions For Fourier Coefficients"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4ef2209e-3d8f-5297-ad7a-edc869e85aa5" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "{\\int }_{-\\pi }^{\\pi }({x}^{2}+9x)\\operatorname{cos}⁡(x)\\,\\text{d}x" :db/id 17592186413355} {:answer/id #uuid "5ed25c1f-08d5-5b38-8bf8-b0a0bfd412ea" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "{\\int }_{-\\pi }^{\\pi }({x}^{2}+9x)\\,\\text{d}x" :db/id 17592186413357} {:answer/id #uuid "88d440e0-29f7-5376-a757-92d36791c9cd" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "{\\int }_{0}^{2\\pi }({x}^{2}+9x)\\,\\text{d}x" :db/id 17592186413364} {:answer/id #uuid "c052414d-62b2-5ddf-8d38-b8519a51bb8d" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "{\\int }_{0}^{\\infty }({x}^{2}+9x)\\,\\text{d}x" :db/id 17592186413371} {:answer/id #uuid "f2ac8e7f-277f-5ca0-83dd-f93b1ee8e219" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "{\\int }_{-\\pi }^{\\pi }({x}^{2}+9x)\\operatorname{sin}⁡(x)\\,\\text{d}x" :db/id 17592186413380}] :answer-field/correct {:answer/id #uuid "5ed25c1f-08d5-5b38-8bf8-b0a0bfd412ea" :answer/type {:db/id 17592186045498 :db/ident :answer.type/math} :answer/value "{\\int }_{-\\pi }^{\\pi }({x}^{2}+9x)\\,\\text{d}x" :db/id 17592186413357} :answer-field/id #uuid "5a51accb-bbae-52f7-8c5d-2c3c83aae97b" :